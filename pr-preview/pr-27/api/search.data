"Otros modelos",[],{"_3805":12,"_26541":11,"_22543":39380,"_5":26803,"_10604":11,"_1869":39381},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3805":13,"_26541":11,"_5":26808,"_22543":39383,"_10604":39384,"_1869":39385},[],"/docs/pr-preview/pr-27/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3805":14,"_26541":11,"_5":26808,"_22543":39387,"_10604":39388,"_1869":39389},[],"/docs/pr-preview/pr-27/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3805":15,"_26541":11,"_5":26808,"_22543":39391,"_10604":39392,"_1869":39393},[],"/docs/pr-preview/pr-27/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3805":16,"_26541":11,"_5":26808,"_22543":39395,"_10604":39396,"_1869":39397},[],"/docs/pr-preview/pr-27/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3805":17,"_26541":11,"_5":26808,"_22543":39399,"_10604":39400,"_1869":39401},[],"/docs/pr-preview/pr-27/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3805":18,"_26541":11,"_5":26808,"_22543":39403,"_10604":39404,"_1869":39405},[],"/docs/pr-preview/pr-27/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3805":19,"_26541":11,"_5":26808,"_22543":39407,"_10604":39408,"_1869":39409},[],"/docs/pr-preview/pr-27/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3805":20,"_26541":11,"_22543":39411,"_5":26803,"_10604":11,"_1869":39412},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3805":21,"_26541":11,"_22543":39414,"_5":26803,"_10604":39384,"_1869":39415},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3805":22,"_26541":11,"_22543":39417,"_5":26803,"_10604":39384,"_1869":39418},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3805":23,"_26541":11,"_22543":39420,"_5":26803,"_10604":39384,"_1869":39421},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3805":24,"_26541":11,"_22543":39423,"_5":26803,"_10604":39388,"_1869":39424},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3805":25,"_26541":11,"_22543":39426,"_5":26803,"_10604":39388,"_1869":39427},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3805":26,"_26541":11,"_22543":39429,"_5":26803,"_10604":39388,"_1869":39430},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3805":27,"_26541":11,"_22543":39432,"_5":26803,"_10604":39392,"_1869":39433},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3805":28,"_26541":11,"_22543":39435,"_5":26803,"_10604":39396,"_1869":39436},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3805":29,"_26541":11,"_22543":39438,"_5":26803,"_10604":39400,"_1869":39439},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3805":30,"_26541":11,"_22543":39441,"_5":26803,"_10604":39404,"_1869":39442},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3805":31,"_26541":11,"_22543":39444,"_5":26803,"_10604":39408,"_1869":39445},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3805":32,"_26541":32,"_5":26798,"_1869":39447,"_26811":39448,"_22543":39449,"_10604":32},"Despliega Lamassu",[39375,39376],[],{"_3805":33,"_26541":32,"_22543":39451,"_5":26803,"_10604":32,"_1869":39452},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3805":34,"_26541":32,"_5":26808,"_22543":39454,"_10604":39455,"_1869":39456},[],"/docs/pr-preview/pr-27/deployment/overview#elige-un-modelo","Elige un modelo",{"_3805":35,"_26541":32,"_5":26808,"_22543":39458,"_10604":39459,"_1869":39460},[],"/docs/pr-preview/pr-27/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3805":36,"_26541":32,"_5":26808,"_22543":39462,"_10604":39463,"_1869":39464},[],"/docs/pr-preview/pr-27/deployment/overview#después-del-despliegue","Después del despliegue",{"_3805":37,"_26541":32,"_22543":39466,"_5":26803,"_10604":32,"_1869":39467},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3805":38,"_26541":32,"_22543":39469,"_5":26803,"_10604":39455,"_1869":39470},[],"Modelo",{"_3805":39,"_26541":32,"_22543":39472,"_5":26803,"_10604":39455,"_1869":39473},[],"Recomendado para",{"_3805":40,"_26541":32,"_22543":39475,"_5":26803,"_10604":39455,"_1869":39476},[],"Quién opera la infraestructura",{"_3805":41,"_26541":32,"_22543":39478,"_5":26803,"_10604":39455,"_1869":39479},[],"Punto de partida",{"_3805":42,"_26541":32,"_22543":39481,"_5":26803,"_10604":39455,"_1869":39482},[],"Kubernetes self-managed",{"_3805":43,"_26541":32,"_22543":39484,"_5":26803,"_10604":39455,"_1869":39485},[],"Producción, entornos regulados y despliegues personalizados",{"_3805":44,"_26541":32,"_22543":39487,"_5":26803,"_10604":39455,"_1869":39488},[],"Tu equipo",{"_3805":45,"_26541":32,"_22543":39490,"_5":26803,"_10604":39455,"_1869":39491},[],"Helm o Fastlane",{"_3805":46,"_26541":32,"_22543":39493,"_5":26803,"_10604":39455,"_1869":39494},[],"AWS Marketplace",{"_3805":47,"_26541":32,"_22543":39496,"_5":26803,"_10604":39455,"_1869":39497},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3805":48,"_26541":32,"_22543":39499,"_5":26803,"_10604":39455,"_1869":39488},[],{"_3805":49,"_26541":32,"_22543":39501,"_5":26803,"_10604":39455,"_1869":39502},[],"Imagen preconfigurada en EC2",{"_3805":50,"_26541":32,"_22543":39504,"_5":26803,"_10604":39455,"_1869":39505},[],"SaaS",{"_3805":51,"_26541":32,"_22543":39507,"_5":26803,"_10604":39455,"_1869":39508},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3805":52,"_26541":32,"_22543":39510,"_5":26803,"_10604":39455,"_1869":39511},[],"Lamassu",{"_3805":53,"_26541":32,"_22543":39513,"_5":26803,"_10604":39455,"_1869":39514},[],"Suscripción gestionada",{"_3805":54,"_26541":32,"_22543":39516,"_5":26803,"_10604":39455,"_1869":39517},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3805":55,"_26541":32,"_22543":39519,"_5":26803,"_10604":39455,"_1869":39520},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3805":56,"_26541":32,"_22543":39522,"_5":26803,"_10604":39455,"_1869":39523},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3805":57,"_26541":32,"_22543":39525,"_5":26803,"_10604":39459,"_1869":39526},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3805":58,"_26541":32,"_22543":39528,"_5":26803,"_10604":39463,"_1869":39529},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3805":59,"_26541":59,"_5":26798,"_1869":39531,"_26811":39532,"_22543":39533,"_10604":59},"Utiliza Lamassu como SaaS",[39375,39376,39377],[],{"_3805":60,"_26541":59,"_22543":39535,"_5":26803,"_10604":59,"_1869":39536},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3805":61,"_26541":59,"_5":26808,"_22543":39538,"_10604":39539,"_1869":39540},[],"/docs/pr-preview/pr-27/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3805":62,"_26541":59,"_5":26808,"_22543":39542,"_10604":39543,"_1869":39544},[],"/docs/pr-preview/pr-27/deployment/saas#planes","Planes",{"_3805":63,"_26541":59,"_5":26808,"_22543":39546,"_10604":39547,"_1869":39548},[],"/docs/pr-preview/pr-27/deployment/saas#solicita-acceso","Solicita acceso",{"_3805":64,"_26541":59,"_22543":39550,"_5":26803,"_10604":59,"_1869":39551},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3805":65,"_26541":59,"_22543":39553,"_5":26803,"_10604":39539,"_1869":39554},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3805":66,"_26541":59,"_22543":39556,"_5":26803,"_10604":39539,"_1869":39557},[],"Copias de seguridad automáticas.",{"_3805":67,"_26541":59,"_22543":39559,"_5":26803,"_10604":39539,"_1869":39560},[],"Actualizaciones de versión.",{"_3805":68,"_26541":59,"_22543":39562,"_5":26803,"_10604":39539,"_1869":39563},[],"Soporte técnico y SLA según el plan contratado.",{"_3805":69,"_26541":59,"_22543":39565,"_5":26803,"_10604":39543,"_1869":39566},[],"Plan",{"_3805":70,"_26541":59,"_22543":39568,"_5":26803,"_10604":39543,"_1869":39569},[],"Dispositivos",{"_3805":71,"_26541":59,"_22543":39571,"_5":26803,"_10604":39543,"_1869":39572},[],"Soporte",{"_3805":72,"_26541":59,"_22543":39574,"_5":26803,"_10604":39543,"_1869":39575},[],"SLA",{"_3805":73,"_26541":59,"_22543":39577,"_5":26803,"_10604":39543,"_1869":39578},[],"Starter",{"_3805":74,"_26541":59,"_22543":39580,"_5":26803,"_10604":39543,"_1869":39581},[],"Hasta 1.000",{"_3805":75,"_26541":59,"_22543":39583,"_5":26803,"_10604":39543,"_1869":39584},[],"Email",{"_3805":76,"_26541":59,"_22543":39586,"_5":26803,"_10604":39543,"_1869":39587},[],"99,5 %",{"_3805":77,"_26541":59,"_22543":39589,"_5":26803,"_10604":39543,"_1869":39590},[],"Professional",{"_3805":78,"_26541":59,"_22543":39592,"_5":26803,"_10604":39543,"_1869":39593},[],"Hasta 10.000",{"_3805":79,"_26541":59,"_22543":39595,"_5":26803,"_10604":39543,"_1869":39596},[],"Email y chat",{"_3805":80,"_26541":59,"_22543":39598,"_5":26803,"_10604":39543,"_1869":39599},[],"99,9 %",{"_3805":81,"_26541":59,"_22543":39601,"_5":26803,"_10604":39543,"_1869":39602},[],"Enterprise",{"_3805":82,"_26541":59,"_22543":39604,"_5":26803,"_10604":39543,"_1869":39605},[],"Ilimitados",{"_3805":83,"_26541":59,"_22543":39607,"_5":26803,"_10604":39543,"_1869":39608},[],"Dedicado",{"_3805":84,"_26541":59,"_22543":39610,"_5":26803,"_10604":39543,"_1869":39611},[],"99,99 %",{"_3805":85,"_26541":59,"_22543":39613,"_5":26803,"_10604":39547,"_1869":39614},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3805":86,"_26541":59,"_22543":39616,"_5":26803,"_10604":39547,"_1869":39617},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3805":87,"_26541":87,"_5":26798,"_1869":39619,"_26811":39620,"_22543":39621,"_10604":87},"Fastlane",[39375,39376,39482],[],{"_3805":88,"_26541":87,"_22543":39623,"_5":26803,"_10604":87,"_1869":39624},[],"Referencia del script scripts/lamassu-fast-lane.sh para desplegar Lamassu PKI de forma automatizada en Kubernetes",{"_3805":89,"_26541":87,"_5":26808,"_22543":39626,"_10604":39627,"_1869":39628},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#fastlane---despliegue-automatizado-en-kubernetes","Fastlane - Despliegue automatizado en Kubernetes",{"_3805":90,"_26541":87,"_5":26808,"_22543":39630,"_10604":39631,"_1869":39632},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#flags-de-línea-de-comandos","Flags de línea de comandos",{"_3805":91,"_26541":87,"_5":26808,"_22543":39634,"_10604":39635,"_1869":39636},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#detección-de-distribución-kubernetes","Detección de distribución Kubernetes",{"_3805":92,"_26541":87,"_5":26808,"_22543":39638,"_10604":39639,"_1869":39640},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#verificación-de-dependencias","Verificación de dependencias",{"_3805":93,"_26541":87,"_5":26808,"_22543":39642,"_10604":39643,"_1869":39644},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#addons-obligatorios-en-microk8s","Addons obligatorios en MicroK8s",{"_3805":94,"_26541":87,"_5":26808,"_22543":39646,"_10604":39647,"_1869":39648},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#modo-interactivo-vs-no-interactivo","Modo interactivo vs no interactivo",{"_3805":95,"_26541":87,"_5":26808,"_22543":39650,"_10604":39651,"_1869":39652},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#modo-interactivo-por-defecto","Modo interactivo (por defecto)",{"_3805":96,"_26541":87,"_5":26808,"_22543":39654,"_10604":39655,"_1869":39656},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#modo-no-interactivo--n","Modo no interactivo (`-n`)",{"_3805":97,"_26541":87,"_5":26808,"_22543":39658,"_10604":39659,"_1869":39660},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#modo-online-vs-offline","Modo online vs offline",{"_3805":98,"_26541":87,"_5":26808,"_22543":39662,"_10604":39663,"_1869":39664},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#modo-online-por-defecto","Modo online (por defecto)",{"_3805":99,"_26541":87,"_5":26808,"_22543":39666,"_10604":39667,"_1869":39668},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#modo-offline","Modo offline",{"_3805":100,"_26541":87,"_5":26808,"_22543":39670,"_10604":39671,"_1869":39672},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#instalación-de-componentes","Instalación de componentes",{"_3805":101,"_26541":87,"_5":26808,"_22543":39674,"_10604":39675,"_1869":39676},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#postgresql-install_postgresql","PostgreSQL (`install_postgresql`)",{"_3805":102,"_26541":87,"_5":26808,"_22543":39678,"_10604":39679,"_1869":39680},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#keycloak-install_keycloak","Keycloak (`install_keycloak`)",{"_3805":103,"_26541":87,"_5":26808,"_22543":39682,"_10604":39683,"_1869":39684},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#rabbitmq-install_rabbitmq","RabbitMQ (`install_rabbitmq`)",{"_3805":104,"_26541":87,"_5":26808,"_22543":39686,"_10604":39687,"_1869":39688},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#lamassu-install_lamassu","Lamassu (`install_lamassu`)",{"_3805":105,"_26541":87,"_5":26808,"_22543":39690,"_10604":39691,"_1869":39692},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#configuración-tls","Configuración TLS",{"_3805":106,"_26541":87,"_5":26808,"_22543":39694,"_10604":39695,"_1869":39696},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#certificado-externo","Certificado externo",{"_3805":107,"_26541":87,"_5":26808,"_22543":39698,"_10604":39699,"_1869":39700},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#certificado-gestionado-por-cert-manager","Certificado gestionado por cert-manager",{"_3805":108,"_26541":87,"_5":26808,"_22543":39702,"_10604":39703,"_1869":39704},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#salida-tras-la-instalación","Salida tras la instalación",{"_3805":109,"_26541":87,"_5":26808,"_22543":39706,"_10604":39707,"_1869":39708},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#uso-en-ci","Uso en CI",{"_3805":110,"_26541":87,"_5":26808,"_22543":39710,"_10604":39711,"_1869":39712},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#ejemplo-rápido","Ejemplo rápido",{"_3805":111,"_26541":87,"_5":26808,"_22543":39714,"_10604":39715,"_1869":39716},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#resumen","Resumen",{"_3805":112,"_26541":87,"_22543":39718,"_5":26803,"_10604":39627,"_1869":39719},[],"Esta sección documenta el script `scripts/lamassu-fast-lane.sh`, cuyo objetivo es desplegar de forma automatizada una pila completa de Lamassu PKI sobre un clúster Kubernetes ya existente, con intervención manual mínima.",{"_3805":113,"_26541":87,"_22543":39721,"_5":26803,"_10604":39627,"_1869":39722},[],"La instalación incluye:",{"_3805":114,"_26541":87,"_22543":39724,"_5":26803,"_10604":39627,"_1869":39725},[],"PostgreSQL",{"_3805":115,"_26541":87,"_22543":39727,"_5":26803,"_10604":39627,"_1869":39728},[],"Keycloak",{"_3805":116,"_26541":87,"_22543":39730,"_5":26803,"_10604":39627,"_1869":39731},[],"RabbitMQ",{"_3805":117,"_26541":87,"_22543":39733,"_5":26803,"_10604":39627,"_1869":39734},[],"Chart Helm de Lamassu",{"_3805":118,"_26541":87,"_22543":39736,"_5":26803,"_10604":39631,"_1869":39737},[],"Todos los parámetros son procesados por la función `process_flags`.",{"_3805":119,"_26541":87,"_22543":39739,"_5":26803,"_10604":39631,"_1869":39740},[],"Flag",{"_3805":120,"_26541":87,"_22543":39742,"_5":26803,"_10604":39631,"_1869":39743},[],"Valor por defecto",{"_3805":121,"_26541":87,"_22543":39745,"_5":26803,"_10604":39631,"_1869":39746},[],"Descripción",{"_3805":122,"_26541":87,"_22543":39748,"_5":26803,"_10604":39631,"_1869":39749},[],"`-h`, `--help`",{"_3805":123,"_26541":87,"_22543":39751,"_5":26803,"_10604":39631,"_1869":3751},[],{"_3805":124,"_26541":87,"_22543":39753,"_5":26803,"_10604":39631,"_1869":39754},[],"Muestra la ayuda y finaliza",{"_3805":125,"_26541":87,"_22543":39756,"_5":26803,"_10604":39631,"_1869":39757},[],"`-n`, `--non-interactive`",{"_3805":126,"_26541":87,"_22543":39759,"_5":26803,"_10604":39631,"_1869":39760},[],"`false`",{"_3805":127,"_26541":87,"_22543":39762,"_5":26803,"_10604":39631,"_1869":39763},[],"Omite prompts y genera/usa credenciales por defecto",{"_3805":128,"_26541":87,"_22543":39765,"_5":26803,"_10604":39631,"_1869":39766},[],"`-ns`, `--namespace`",{"_3805":129,"_26541":87,"_22543":39768,"_5":26803,"_10604":39631,"_1869":39769},[],"`lamassu-dev`",{"_3805":130,"_26541":87,"_22543":39771,"_5":26803,"_10604":39631,"_1869":39772},[],"Namespace Kubernetes donde se despliegan los recursos",{"_3805":131,"_26541":87,"_22543":39774,"_5":26803,"_10604":39631,"_1869":39775},[],"`-d`, `--domain`",{"_3805":132,"_26541":87,"_22543":39777,"_5":26803,"_10604":39631,"_1869":39778},[],"`dev.lamassu.io`",{"_3805":133,"_26541":87,"_22543":39780,"_5":26803,"_10604":39631,"_1869":39781},[],"Dominio usado para endpoint y certificados TLS",{"_3805":134,"_26541":87,"_22543":39783,"_5":26803,"_10604":39631,"_1869":39784},[],"`-v`, `--version`",{"_3805":135,"_26541":87,"_22543":39786,"_5":26803,"_10604":39631,"_1869":39787},[],"`latest`",{"_3805":136,"_26541":87,"_22543":39789,"_5":26803,"_10604":39631,"_1869":39790},[],"Versión del chart Helm de Lamassu",{"_3805":137,"_26541":87,"_22543":39792,"_5":26803,"_10604":39631,"_1869":39793},[],"`--https-port`",{"_3805":138,"_26541":87,"_22543":39795,"_5":26803,"_10604":39631,"_1869":39796},[],"`443`",{"_3805":139,"_26541":87,"_22543":39798,"_5":26803,"_10604":39631,"_1869":39799},[],"Puerto HTTPS del gateway",{"_3805":140,"_26541":87,"_22543":39801,"_5":26803,"_10604":39631,"_1869":39802},[],"`--http-port`",{"_3805":141,"_26541":87,"_22543":39804,"_5":26803,"_10604":39631,"_1869":39805},[],"`80`",{"_3805":142,"_26541":87,"_22543":39807,"_5":26803,"_10604":39631,"_1869":39808},[],"Puerto HTTP del gateway",{"_3805":143,"_26541":87,"_22543":39810,"_5":26803,"_10604":39631,"_1869":39811},[],"`--offline`",{"_3805":144,"_26541":87,"_22543":39813,"_5":26803,"_10604":39631,"_1869":39760},[],{"_3805":145,"_26541":87,"_22543":39815,"_5":26803,"_10604":39631,"_1869":39816},[],"Activa modo offline",{"_3805":146,"_26541":87,"_22543":39818,"_5":26803,"_10604":39631,"_1869":39819},[],"`--tls-crt`",{"_3805":147,"_26541":87,"_22543":39821,"_5":26803,"_10604":39631,"_1869":3751},[],{"_3805":148,"_26541":87,"_22543":39823,"_5":26803,"_10604":39631,"_1869":39824},[],"Ruta al certificado TLS (PEM)",{"_3805":149,"_26541":87,"_22543":39826,"_5":26803,"_10604":39631,"_1869":39827},[],"`--tls-key`",{"_3805":150,"_26541":87,"_22543":39829,"_5":26803,"_10604":39631,"_1869":3751},[],{"_3805":151,"_26541":87,"_22543":39831,"_5":26803,"_10604":39631,"_1869":39832},[],"Ruta a la clave privada TLS (PEM)",{"_3805":152,"_26541":87,"_22543":39834,"_5":26803,"_10604":39631,"_1869":39835},[],"`--helm-chart-lamassu`",{"_3805":153,"_26541":87,"_22543":39837,"_5":26803,"_10604":39631,"_1869":3751},[],{"_3805":154,"_26541":87,"_22543":39839,"_5":26803,"_10604":39631,"_1869":39840},[],"Ruta a chart local Lamassu (`.tgz`)",{"_3805":155,"_26541":87,"_22543":39842,"_5":26803,"_10604":39631,"_1869":39843},[],"`--helm-chart-postgres`",{"_3805":156,"_26541":87,"_22543":39845,"_5":26803,"_10604":39631,"_1869":3751},[],{"_3805":157,"_26541":87,"_22543":39847,"_5":26803,"_10604":39631,"_1869":39848},[],"Ruta a chart local PostgreSQL (`.tgz`)",{"_3805":158,"_26541":87,"_22543":39850,"_5":26803,"_10604":39631,"_1869":39851},[],"`--helm-chart-keycloak`",{"_3805":159,"_26541":87,"_22543":39853,"_5":26803,"_10604":39631,"_1869":3751},[],{"_3805":160,"_26541":87,"_22543":39855,"_5":26803,"_10604":39631,"_1869":39856},[],"Ruta a chart local Keycloak (`.tgz`)",{"_3805":161,"_26541":87,"_22543":39858,"_5":26803,"_10604":39631,"_1869":39859},[],"`--helm-chart-rabbitmq`",{"_3805":162,"_26541":87,"_22543":39861,"_5":26803,"_10604":39631,"_1869":3751},[],{"_3805":163,"_26541":87,"_22543":39863,"_5":26803,"_10604":39631,"_1869":39864},[],"Ruta a chart local RabbitMQ (`.tgz`)",{"_3805":164,"_26541":87,"_22543":39866,"_5":26803,"_10604":39631,"_1869":39867},[],"`-l`, `--local-chart-path`",{"_3805":165,"_26541":87,"_22543":39869,"_5":26803,"_10604":39631,"_1869":3751},[],{"_3805":166,"_26541":87,"_22543":39871,"_5":26803,"_10604":39631,"_1869":39872},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_3805":167,"_26541":87,"_22543":39874,"_5":26803,"_10604":39635,"_1869":39875},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_3805":168,"_26541":87,"_22543":39877,"_5":26803,"_10604":39635,"_1869":39878},[],"`microk8s`",{"_3805":169,"_26541":87,"_22543":39880,"_5":26803,"_10604":39635,"_1869":39881},[],"`k3s`",{"_3805":170,"_26541":87,"_22543":39883,"_5":26803,"_10604":39635,"_1869":39884},[],"`kind`",{"_3805":171,"_26541":87,"_22543":39886,"_5":26803,"_10604":39635,"_1869":39887},[],"Kubernetes estándar",{"_3805":172,"_26541":87,"_22543":39889,"_5":26803,"_10604":39635,"_1869":39890},[],"Comportamientos específicos:",{"_3805":173,"_26541":87,"_22543":39892,"_5":26803,"_10604":39635,"_1869":39893},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_3805":174,"_26541":87,"_22543":39895,"_5":26803,"_10604":39635,"_1869":39896},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_3805":175,"_26541":87,"_22543":39898,"_5":26803,"_10604":39639,"_1869":39899},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_3805":176,"_26541":87,"_22543":39901,"_5":26803,"_10604":39639,"_1869":39902},[],"Requisitos generales:",{"_3805":177,"_26541":87,"_22543":39904,"_5":26803,"_10604":39639,"_1869":39905},[],"`yq`",{"_3805":178,"_26541":87,"_22543":39907,"_5":26803,"_10604":39639,"_1869":39908},[],"CLI de la distribución detectada",{"_3805":179,"_26541":87,"_22543":39910,"_5":26803,"_10604":39639,"_1869":39911},[],"Los requisitos específicos dependen de la distribución: `k3s` necesita `kubectl` y `helm`, mientras que `microk8s` utiliza `microk8s kubectl` y `microk8s helm`.",{"_3805":180,"_26541":87,"_22543":39913,"_5":26803,"_10604":39643,"_1869":39914},[],"Se valida que estén habilitados:",{"_3805":181,"_26541":87,"_22543":39916,"_5":26803,"_10604":39643,"_1869":39917},[],"`helm`",{"_3805":182,"_26541":87,"_22543":39919,"_5":26803,"_10604":39643,"_1869":39920},[],"`hostpath-storage`",{"_3805":183,"_26541":87,"_22543":39922,"_5":26803,"_10604":39643,"_1869":39923},[],"`dns`",{"_3805":184,"_26541":87,"_22543":39925,"_5":26803,"_10604":39643,"_1869":39926},[],"`cert-manager`",{"_3805":185,"_26541":87,"_22543":39928,"_5":26803,"_10604":39643,"_1869":39929},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_3805":186,"_26541":87,"_22543":39931,"_5":26803,"_10604":39651,"_1869":39932},[],"La función `request_config_data` solicita:",{"_3805":187,"_26541":87,"_22543":39934,"_5":26803,"_10604":39651,"_1869":39935},[],"Dominio Lamassu",{"_3805":188,"_26541":87,"_22543":39937,"_5":26803,"_10604":39651,"_1869":39938},[],"Usuario y contraseña admin PostgreSQL",{"_3805":189,"_26541":87,"_22543":39940,"_5":26803,"_10604":39651,"_1869":39941},[],"Usuario y contraseña admin RabbitMQ",{"_3805":190,"_26541":87,"_22543":39943,"_5":26803,"_10604":39651,"_1869":39944},[],"Usuario y contraseña admin Keycloak",{"_3805":191,"_26541":87,"_22543":39946,"_5":26803,"_10604":39651,"_1869":39947},[],"Namespace Kubernetes",{"_3805":192,"_26541":87,"_22543":39949,"_5":26803,"_10604":39655,"_1869":39950},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_3805":193,"_26541":87,"_22543":39952,"_5":26803,"_10604":39655,"_1869":39953},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_3805":194,"_26541":87,"_22543":39955,"_5":26803,"_10604":39659,"_1869":39956},[],"El script admite dos estrategias para obtener charts Helm.",{"_3805":195,"_26541":87,"_22543":39958,"_5":26803,"_10604":39663,"_1869":39959},[],"Los charts se descargan desde repositorios remotos.",{"_3805":196,"_26541":87,"_22543":39961,"_5":26803,"_10604":39667,"_1869":39962},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_3805":197,"_26541":87,"_22543":39964,"_5":26803,"_10604":39667,"_1869":39835},[],{"_3805":198,"_26541":87,"_22543":39966,"_5":26803,"_10604":39667,"_1869":39843},[],{"_3805":199,"_26541":87,"_22543":39968,"_5":26803,"_10604":39667,"_1869":39851},[],{"_3805":200,"_26541":87,"_22543":39970,"_5":26803,"_10604":39667,"_1869":39859},[],{"_3805":201,"_26541":87,"_22543":39972,"_5":26803,"_10604":39667,"_1869":39973},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_3805":202,"_26541":87,"_22543":39975,"_5":26803,"_10604":39667,"_1869":39976},[],"En este modo se fuerza:",{"_3805":203,"_26541":87,"_22543":39978,"_5":26803,"_10604":39675,"_1869":39979},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_3805":204,"_26541":87,"_22543":39981,"_5":26803,"_10604":39675,"_1869":39982},[],"Versión del chart: `0.19.0`",{"_3805":205,"_26541":87,"_22543":39984,"_5":26803,"_10604":39675,"_1869":39985},[],"Release: `postgres`",{"_3805":206,"_26541":87,"_22543":39987,"_5":26803,"_10604":39675,"_1869":39988},[],"`fullnameOverride: \"postgresql\"`",{"_3805":207,"_26541":87,"_22543":39990,"_5":26803,"_10604":39675,"_1869":39991},[],"El script SQL de inicialización crea una base de datos por servicio: `auth` para Keycloak, `alerts` para Alerts, `ca` para CA, `va` para VA, `cloudproxy` para Cloud Proxy, `devicemanager` para Device Manager, `dmsmanager` para DMS Manager y `kms` para KMS.",{"_3805":208,"_26541":87,"_22543":39993,"_5":26803,"_10604":39679,"_1869":39994},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_3805":209,"_26541":87,"_22543":39996,"_5":26803,"_10604":39679,"_1869":39997},[],"Versión del chart: `0.20.0`",{"_3805":210,"_26541":87,"_22543":39999,"_5":26803,"_10604":39679,"_1869":40000},[],"Release: `auth`",{"_3805":211,"_26541":87,"_22543":40002,"_5":26803,"_10604":39679,"_1869":40003},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_3805":212,"_26541":87,"_22543":40005,"_5":26803,"_10604":39679,"_1869":40006},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_3805":213,"_26541":87,"_22543":40008,"_5":26803,"_10604":39679,"_1869":40009},[],"`httpRelativePath: /auth/`",{"_3805":214,"_26541":87,"_22543":40011,"_5":26803,"_10604":39679,"_1869":40012},[],"`proxyHeaders: xforwarded`",{"_3805":215,"_26541":87,"_22543":40014,"_5":26803,"_10604":39679,"_1869":40015},[],"Configuración automática del realm `lamassu`:",{"_3805":216,"_26541":87,"_22543":40017,"_5":26803,"_10604":39679,"_1869":40018},[],"Rol: `pki-admin`",{"_3805":217,"_26541":87,"_22543":40020,"_5":26803,"_10604":39679,"_1869":40021},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_3805":218,"_26541":87,"_22543":40023,"_5":26803,"_10604":39679,"_1869":40024},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_3805":219,"_26541":87,"_22543":40026,"_5":26803,"_10604":39679,"_1869":40027},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_3805":220,"_26541":87,"_22543":40029,"_5":26803,"_10604":39679,"_1869":40030},[],"`github.com/lamassuiot/keycloak-theme`",{"_3805":221,"_26541":87,"_22543":40032,"_5":26803,"_10604":39683,"_1869":40033},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_3805":222,"_26541":87,"_22543":40035,"_5":26803,"_10604":39683,"_1869":39997},[],{"_3805":223,"_26541":87,"_22543":40037,"_5":26803,"_10604":39683,"_1869":40038},[],"Release: `rabbitmq`",{"_3805":224,"_26541":87,"_22543":40040,"_5":26803,"_10604":39683,"_1869":40041},[],"`fullnameOverride: \"rabbitmq\"`",{"_3805":225,"_26541":87,"_22543":40043,"_5":26803,"_10604":39683,"_1869":40044},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_3805":226,"_26541":87,"_22543":40046,"_5":26803,"_10604":39687,"_1869":40047},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_3805":227,"_26541":87,"_22543":40049,"_5":26803,"_10604":39687,"_1869":40050},[],"Configuraciones principales:",{"_3805":228,"_26541":87,"_22543":40052,"_5":26803,"_10604":39687,"_1869":40053},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_3805":229,"_26541":87,"_22543":40055,"_5":26803,"_10604":39687,"_1869":40056},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_3805":230,"_26541":87,"_22543":40058,"_5":26803,"_10604":39687,"_1869":40059},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_3805":231,"_26541":87,"_22543":40061,"_5":26803,"_10604":39687,"_1869":40062},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_3805":232,"_26541":87,"_22543":40064,"_5":26803,"_10604":39687,"_1869":40065},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_3805":233,"_26541":87,"_22543":40067,"_5":26803,"_10604":39687,"_1869":40068},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_3805":234,"_26541":87,"_22543":40070,"_5":26803,"_10604":39687,"_1869":40071},[],"Dominios CA: valor de `--domain`",{"_3805":235,"_26541":87,"_22543":40073,"_5":26803,"_10604":39687,"_1869":40074},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_3805":236,"_26541":87,"_22543":40076,"_5":26803,"_10604":39687,"_1869":40077},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_3805":237,"_26541":87,"_22543":40079,"_5":26803,"_10604":39687,"_1869":40080},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_3805":238,"_26541":87,"_22543":40082,"_5":26803,"_10604":39695,"_1869":40083},[],"Si se proporcionan:",{"_3805":239,"_26541":87,"_22543":40085,"_5":26803,"_10604":39695,"_1869":39819},[],{"_3805":240,"_26541":87,"_22543":40087,"_5":26803,"_10604":39695,"_1869":39827},[],{"_3805":241,"_26541":87,"_22543":40089,"_5":26803,"_10604":39695,"_1869":40090},[],"Se crea un secret Kubernetes:",{"_3805":242,"_26541":87,"_22543":40092,"_5":26803,"_10604":39695,"_1869":40093},[],"`downstream-provided-crt`",{"_3805":243,"_26541":87,"_22543":40095,"_5":26803,"_10604":39695,"_1869":40096},[],"Y se configura:",{"_3805":244,"_26541":87,"_22543":40098,"_5":26803,"_10604":39699,"_1869":40099},[],"Si no se proporciona certificado:",{"_3805":245,"_26541":87,"_22543":40101,"_5":26803,"_10604":39699,"_1869":40102},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_3805":246,"_26541":87,"_22543":40104,"_5":26803,"_10604":39699,"_1869":40105},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_3805":247,"_26541":87,"_22543":40107,"_5":26803,"_10604":39703,"_1869":40108},[],"En caso de éxito, se muestra:",{"_3805":248,"_26541":87,"_22543":40110,"_5":26803,"_10604":39703,"_1869":40111},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_3805":249,"_26541":87,"_22543":40113,"_5":26803,"_10604":39703,"_1869":40114},[],"Credenciales iniciales: `lamassu / lamassu`",{"_3805":250,"_26541":87,"_22543":40116,"_5":26803,"_10604":39703,"_1869":40117},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_3805":251,"_26541":87,"_22543":40119,"_5":26803,"_10604":39703,"_1869":40120},[],"Credenciales admin de Keycloak",{"_3805":252,"_26541":87,"_22543":40122,"_5":26803,"_10604":39703,"_1869":40123},[],"El usuario `lamassu` se crea con:",{"_3805":253,"_26541":87,"_22543":40125,"_5":26803,"_10604":39703,"_1869":40126},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_3805":254,"_26541":87,"_22543":40128,"_5":26803,"_10604":39703,"_1869":40129},[],"Fastlane también provisiona un principal de autorización `oidc:lamassu` que coincide con el claim `preferred_username=lamassu` y le concede la política `SUPER ADMIN`. Si activas los datos de ejemplo, crea además un principal independiente para la cuenta de servicio correspondiente.",{"_3805":255,"_26541":87,"_22543":40131,"_5":26803,"_10604":39703,"_1869":40132},[],"Este bootstrap está pensado para laboratorio, demos y CI. En producción, sustituye el principal por un rol o grupo administrado en tu proveedor OIDC y sigue Control de acceso.",{"_3805":256,"_26541":87,"_22543":40134,"_5":26803,"_10604":39707,"_1869":40135},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_3805":257,"_26541":87,"_22543":40137,"_5":26803,"_10604":39707,"_1869":40138},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_3805":258,"_26541":87,"_22543":40140,"_5":26803,"_10604":39707,"_1869":40141},[],"Ejemplo:",{"_3805":259,"_26541":87,"_22543":40143,"_5":26803,"_10604":39707,"_1869":40144},[],"En este escenario:",{"_3805":260,"_26541":87,"_22543":40146,"_5":26803,"_10604":39707,"_1869":40147},[],"`-n`: modo no interactivo",{"_3805":261,"_26541":87,"_22543":40149,"_5":26803,"_10604":39707,"_1869":40150},[],"`-ns`: namespace específico",{"_3805":262,"_26541":87,"_22543":40152,"_5":26803,"_10604":39707,"_1869":40153},[],"`-d`: dominio de CI",{"_3805":263,"_26541":87,"_22543":40155,"_5":26803,"_10604":39707,"_1869":40156},[],"`-l`: chart local",{"_3805":264,"_26541":87,"_22543":40158,"_5":26803,"_10604":39715,"_1869":40159},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_3805":265,"_26541":87,"_22543":40161,"_5":26803,"_10604":39715,"_1869":40162},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_3805":266,"_26541":266,"_5":26798,"_1869":39482,"_26811":40164,"_22543":40165,"_10604":266},[39375,39376,39482],[],{"_3805":267,"_26541":266,"_22543":40167,"_5":26803,"_10604":266,"_1869":40168},[],"Despliega Lamassu en tu propio clúster Kubernetes con Helm o Fastlane.",{"_3805":268,"_26541":266,"_5":26808,"_22543":40170,"_10604":40171,"_1869":40172},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3805":269,"_26541":266,"_5":26808,"_22543":40174,"_10604":40175,"_1869":40176},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#quickstart","Quickstart",{"_3805":270,"_26541":266,"_5":26808,"_22543":40178,"_10604":40179,"_1869":40180},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#qué-se-despliega","Qué se despliega",{"_3805":271,"_26541":266,"_5":26808,"_22543":40182,"_10604":40183,"_1869":40184},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#requisitos-previos","Requisitos previos",{"_3805":272,"_26541":266,"_5":26808,"_22543":40186,"_10604":40187,"_1869":40188},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#opciones-de-despliegue","Opciones de despliegue",{"_3805":273,"_26541":266,"_5":26808,"_22543":40190,"_10604":40191,"_1869":40192},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_3805":274,"_26541":266,"_5":26808,"_22543":40194,"_10604":40195,"_1869":40196},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_3805":275,"_26541":266,"_5":26808,"_22543":40198,"_10604":40199,"_1869":40200},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#arquitectura","Arquitectura",{"_3805":276,"_26541":266,"_5":26808,"_22543":40202,"_10604":40203,"_1869":40204},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#instalación-manual-con-helm","Instalación manual con Helm",{"_3805":277,"_26541":266,"_5":26808,"_22543":40206,"_10604":40207,"_1869":40208},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_3805":278,"_26541":266,"_5":26808,"_22543":40210,"_10604":40211,"_1869":40212},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3805":279,"_26541":266,"_5":26808,"_22543":40214,"_10604":40215,"_1869":40216},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_3805":280,"_26541":266,"_5":26808,"_22543":40218,"_10604":40219,"_1869":40220},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#verificación-del-despliegue","Verificación del despliegue",{"_3805":281,"_26541":266,"_5":26808,"_22543":40222,"_10604":40223,"_1869":40224},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#repositorio-helm","Repositorio Helm",{"_3805":282,"_26541":266,"_5":26808,"_22543":40226,"_10604":40227,"_1869":40228},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_3805":283,"_26541":266,"_5":26808,"_22543":40230,"_10604":40231,"_1869":40232},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#versionado-y-migraciones","Versionado y migraciones",{"_3805":284,"_26541":266,"_22543":40234,"_5":26803,"_10604":40171,"_1869":40235},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_3805":285,"_26541":266,"_22543":40237,"_5":26803,"_10604":40171,"_1869":40238},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_3805":286,"_26541":266,"_22543":40240,"_5":26803,"_10604":40171,"_1869":40241},[],"el chart principal de Lamassu",{"_3805":287,"_26541":266,"_22543":40243,"_5":26803,"_10604":40171,"_1869":40244},[],"un chart auxiliar de SoftHSM",{"_3805":288,"_26541":266,"_22543":40246,"_5":26803,"_10604":40171,"_1869":40247},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_3805":289,"_26541":266,"_22543":40249,"_5":26803,"_10604":40175,"_1869":40250},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_3805":290,"_26541":266,"_22543":40252,"_5":26803,"_10604":40175,"_1869":40253},[],"Ese flujo:",{"_3805":291,"_26541":266,"_22543":40255,"_5":26803,"_10604":40175,"_1869":40256},[],"crea o reutiliza el namespace indicado",{"_3805":292,"_26541":266,"_22543":40258,"_5":26803,"_10604":40175,"_1869":40259},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_3805":293,"_26541":266,"_22543":40261,"_5":26803,"_10604":40175,"_1869":40262},[],"despliega el chart de Lamassu",{"_3805":294,"_26541":266,"_22543":40264,"_5":26803,"_10604":40175,"_1869":40265},[],"deja la UI expuesta en `https://<dominio>`",{"_3805":295,"_26541":266,"_22543":40267,"_5":26803,"_10604":40175,"_1869":40268},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_3805":296,"_26541":266,"_22543":40270,"_5":26803,"_10604":40179,"_1869":40271},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_3805":297,"_26541":266,"_22543":40273,"_5":26803,"_10604":40179,"_1869":40274},[],"`ui`",{"_3805":298,"_26541":266,"_22543":40276,"_5":26803,"_10604":40179,"_1869":40277},[],"`ca`",{"_3805":299,"_26541":266,"_22543":40279,"_5":26803,"_10604":40179,"_1869":40280},[],"`va`",{"_3805":300,"_26541":266,"_22543":40282,"_5":26803,"_10604":40179,"_1869":40283},[],"`kms`",{"_3805":301,"_26541":266,"_22543":40285,"_5":26803,"_10604":40179,"_1869":40286},[],"`device-manager`",{"_3805":302,"_26541":266,"_22543":40288,"_5":26803,"_10604":40179,"_1869":40289},[],"`dms-manager`",{"_3805":303,"_26541":266,"_22543":40291,"_5":26803,"_10604":40179,"_1869":40292},[],"`alerts`",{"_3805":304,"_26541":266,"_22543":40294,"_5":26803,"_10604":40179,"_1869":40295},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_3805":305,"_26541":266,"_22543":40297,"_5":26803,"_10604":40179,"_1869":40298},[],"job de migraciones de base de datos",{"_3805":306,"_26541":266,"_22543":40300,"_5":26803,"_10604":40183,"_1869":40301},[],"Clúster Kubernetes `1.19+`",{"_3805":307,"_26541":266,"_22543":40303,"_5":26803,"_10604":40183,"_1869":40304},[],"`kubectl` configurado con acceso al clúster",{"_3805":308,"_26541":266,"_22543":40306,"_5":26803,"_10604":40183,"_1869":40307},[],"Helm `3.2.0+`",{"_3805":309,"_26541":266,"_22543":40309,"_5":26803,"_10604":40183,"_1869":40310},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_3805":310,"_26541":266,"_22543":40312,"_5":26803,"_10604":40183,"_1869":40313},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_3805":311,"_26541":266,"_22543":40315,"_5":26803,"_10604":40183,"_1869":40316},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_3805":312,"_26541":266,"_22543":40318,"_5":26803,"_10604":40183,"_1869":40319},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_3805":313,"_26541":266,"_22543":40321,"_5":26803,"_10604":40187,"_1869":40322},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_3805":314,"_26541":266,"_22543":40324,"_5":26803,"_10604":40191,"_1869":40325},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_3805":315,"_26541":266,"_22543":40327,"_5":26803,"_10604":40195,"_1869":40328},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_3805":316,"_26541":266,"_22543":40330,"_5":26803,"_10604":40199,"_1869":40331},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_3805":317,"_26541":266,"_22543":40333,"_5":26803,"_10604":40199,"_1869":40334},[],"Dependencias externas requeridas por el chart principal:",{"_3805":318,"_26541":266,"_22543":40336,"_5":26803,"_10604":40199,"_1869":39725},[],{"_3805":319,"_26541":266,"_22543":40338,"_5":26803,"_10604":40199,"_1869":39731},[],{"_3805":320,"_26541":266,"_22543":40340,"_5":26803,"_10604":40199,"_1869":40341},[],"proveedor OIDC, típicamente Keycloak",{"_3805":321,"_26541":266,"_22543":40343,"_5":26803,"_10604":40199,"_1869":40344},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_3805":322,"_26541":266,"_22543":40346,"_5":26803,"_10604":40203,"_1869":40347},[],"Agregar el repositorio Helm:",{"_3805":323,"_26541":266,"_22543":40349,"_5":26803,"_10604":40203,"_1869":40350},[],"O instalar desde una copia local del repositorio:",{"_3805":324,"_26541":266,"_22543":40352,"_5":26803,"_10604":40207,"_1869":40353},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_3805":325,"_26541":266,"_22543":40355,"_5":26803,"_10604":40207,"_1869":40356},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_3805":326,"_26541":266,"_22543":40358,"_5":26803,"_10604":40207,"_1869":40359},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_3805":327,"_26541":266,"_22543":40361,"_5":26803,"_10604":40207,"_1869":40362},[],"`auth.oidc.frontend.authority`",{"_3805":328,"_26541":266,"_22543":40364,"_5":26803,"_10604":40207,"_1869":40365},[],"`auth.oidc.apiGateway.jwks`",{"_3805":329,"_26541":266,"_22543":40367,"_5":26803,"_10604":40207,"_1869":40368},[],"`services.authz.jwkUrl` y un principal de bootstrap que coincida con un administrador real",{"_3805":330,"_26541":266,"_22543":40370,"_5":26803,"_10604":40207,"_1869":40371},[],"`services.ca.domains`",{"_3805":331,"_26541":266,"_22543":40373,"_5":26803,"_10604":40207,"_1869":40374},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_3805":332,"_26541":266,"_22543":40376,"_5":26803,"_10604":40207,"_1869":40377},[],"`tls.*` según se use `certManager` o certificado externo",{"_3805":333,"_26541":266,"_22543":40379,"_5":26803,"_10604":40207,"_1869":40380},[],"Ejemplo base:",{"_3805":334,"_26541":266,"_22543":40382,"_5":26803,"_10604":40211,"_1869":40383},[],"No hay un superusuario implícito. Antes de instalar, crea el rol `pki-admin` en el proveedor OIDC y asígnalo al grupo que administrará Lamassu. El principal del ejemplo concede la política `SUPER ADMIN` a cualquier token que contenga ese rol.",{"_3805":335,"_26541":266,"_22543":40385,"_5":26803,"_10604":40211,"_1869":40386},[],"El Job `pre-install` y `pre-upgrade` prepara las bases de datos, ejecuta las migraciones de authz, precarga las políticas y aplica `services.authz.bootstrap` antes de que arranquen los Deployments. El bootstrap es idempotente: conserva los principales existentes y añade únicamente los grants que falten.",{"_3805":336,"_26541":266,"_22543":40388,"_5":26803,"_10604":40211,"_1869":40389},[],"Si ningún token coincide con un principal activo, nadie podrá administrar la PKI. Prueba una identidad autorizada y otra denegada, y conserva un procedimiento de recuperación.",{"_3805":337,"_26541":266,"_22543":40391,"_5":26803,"_10604":40211,"_1869":40392},[],"Consulta Control de acceso para diseñar principales y políticas.",{"_3805":338,"_26541":266,"_22543":40394,"_5":26803,"_10604":40215,"_1869":40395},[],"**TLS:** `tls.type`, `tls.certManagerOptions.*` y `tls.externalOptions.secretName` controlan el certificado *downstream* del Gateway.",{"_3805":339,"_26541":266,"_22543":40397,"_5":26803,"_10604":40215,"_1869":40398},[],"**Gateway:** `gateway.addresses`, `gateway.ports.*` y `gateway.extraRouting` publican la UI y las APIs mediante Envoy Gateway.",{"_3805":340,"_26541":266,"_22543":40400,"_5":26803,"_10604":40215,"_1869":40401},[],"**Persistencia:** `postgres.*` define la conexión a PostgreSQL.",{"_3805":341,"_26541":266,"_22543":40403,"_5":26803,"_10604":40215,"_1869":40404},[],"**Mensajería:** `amqp.*` configura la conexión a RabbitMQ.",{"_3805":342,"_26541":266,"_22543":40406,"_5":26803,"_10604":40215,"_1869":40407},[],"**Identidad y autorización:** `auth.oidc.*`, `services.authz.jwkUrl` y `services.authz.bootstrap` configuran login, validación JWT y permisos iniciales.",{"_3805":343,"_26541":266,"_22543":40409,"_5":26803,"_10604":40215,"_1869":40410},[],"**Autoridades:** `services.ca.domains` establece los dominios autorizados para CA y certificados.",{"_3805":344,"_26541":266,"_22543":40412,"_5":26803,"_10604":40215,"_1869":40413},[],"**Claves:** `services.kms.cryptoEngines.*` configura los motores criptográficos y su almacenamiento.",{"_3805":345,"_26541":266,"_22543":40415,"_5":26803,"_10604":40215,"_1869":40416},[],"**Alertas:** `services.alerts.smtp_server.*` prepara el envío de correo.",{"_3805":346,"_26541":266,"_22543":40418,"_5":26803,"_10604":40219,"_1869":40419},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_3805":347,"_26541":266,"_22543":40421,"_5":26803,"_10604":40219,"_1869":40422},[],"La prueba comprueba al menos:",{"_3805":348,"_26541":266,"_22543":40424,"_5":26803,"_10604":40219,"_1869":40425},[],"salud de `ca`",{"_3805":349,"_26541":266,"_22543":40427,"_5":26803,"_10604":40219,"_1869":40428},[],"salud de `dms-manager`",{"_3805":350,"_26541":266,"_22543":40430,"_5":26803,"_10604":40219,"_1869":40431},[],"salud de `device-manager`",{"_3805":351,"_26541":266,"_22543":40433,"_5":26803,"_10604":40219,"_1869":40434},[],"salud de `va`",{"_3805":352,"_26541":266,"_22543":40436,"_5":26803,"_10604":40219,"_1869":40437},[],"respuesta HTML esperada del servicio `ui`",{"_3805":353,"_26541":266,"_22543":40439,"_5":26803,"_10604":40223,"_1869":40440},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_3805":354,"_26541":266,"_22543":40442,"_5":26803,"_10604":40223,"_1869":40443},[],"`charts/lamassu`: chart principal de Lamassu",{"_3805":355,"_26541":266,"_22543":40445,"_5":26803,"_10604":40223,"_1869":40446},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_3805":356,"_26541":266,"_22543":40448,"_5":26803,"_10604":40223,"_1869":40449},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_3805":357,"_26541":266,"_22543":40451,"_5":26803,"_10604":40227,"_1869":40452},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_3805":358,"_26541":266,"_22543":40454,"_5":26803,"_10604":40231,"_1869":40455},[],"La versión actual del chart en el repositorio es `3.8.0`. Para upgrades entre versiones, consulta las guías de `charts/lamassu/CHANGELOG/` y revisa especialmente las migraciones de base de datos y el bootstrap de authz.",{"_3805":359,"_26541":359,"_5":26798,"_1869":40457,"_26811":40458,"_22543":40461,"_10604":359},"Control de acceso",[39375,40459,40460],"Plataforma","Administrar Lamassu",[],{"_3805":360,"_26541":359,"_22543":40463,"_5":26803,"_10604":359,"_1869":40464},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3805":361,"_26541":359,"_5":26808,"_22543":40466,"_10604":40467,"_1869":40468},[],"/docs/pr-preview/pr-27/platform/pki/access-control#conceptos-esenciales","Conceptos esenciales",{"_3805":362,"_26541":359,"_5":26808,"_22543":40470,"_10604":40471,"_1869":40472},[],"/docs/pr-preview/pr-27/platform/pki/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3805":363,"_26541":359,"_5":26808,"_22543":40474,"_10604":40475,"_1869":40476},[],"/docs/pr-preview/pr-27/platform/pki/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3805":364,"_26541":359,"_5":26808,"_22543":40478,"_10604":40479,"_1869":40480},[],"/docs/pr-preview/pr-27/platform/pki/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3805":365,"_26541":359,"_5":26808,"_22543":40482,"_10604":40483,"_1869":40484},[],"/docs/pr-preview/pr-27/platform/pki/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3805":366,"_26541":359,"_5":26808,"_22543":40486,"_10604":40487,"_1869":40488},[],"/docs/pr-preview/pr-27/platform/pki/access-control#principales-oidc","Principales OIDC",{"_3805":367,"_26541":359,"_5":26808,"_22543":40490,"_10604":40491,"_1869":40492},[],"/docs/pr-preview/pr-27/platform/pki/access-control#principales-x509","Principales X.509",{"_3805":368,"_26541":359,"_5":26808,"_22543":40494,"_10604":40495,"_1869":40496},[],"/docs/pr-preview/pr-27/platform/pki/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3805":369,"_26541":359,"_5":26808,"_22543":40498,"_10604":40499,"_1869":40500},[],"/docs/pr-preview/pr-27/platform/pki/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3805":370,"_26541":359,"_5":26808,"_22543":40502,"_10604":40503,"_1869":40504},[],"/docs/pr-preview/pr-27/platform/pki/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3805":371,"_26541":359,"_5":26808,"_22543":40506,"_10604":40507,"_1869":40508},[],"/docs/pr-preview/pr-27/platform/pki/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3805":372,"_26541":359,"_5":26808,"_22543":40510,"_10604":40511,"_1869":40512},[],"/docs/pr-preview/pr-27/platform/pki/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3805":373,"_26541":359,"_5":26808,"_22543":40514,"_10604":40515,"_1869":40516},[],"/docs/pr-preview/pr-27/platform/pki/access-control#reglas-http","Reglas HTTP",{"_3805":374,"_26541":359,"_5":26808,"_22543":40518,"_10604":40519,"_1869":40520},[],"/docs/pr-preview/pr-27/platform/pki/access-control#políticas-incluidas","Políticas incluidas",{"_3805":375,"_26541":359,"_5":26808,"_22543":40522,"_10604":40523,"_1869":40212},[],"/docs/pr-preview/pr-27/platform/pki/access-control#provisiona-el-primer-administrador",{"_3805":376,"_26541":359,"_5":26808,"_22543":40525,"_10604":40526,"_1869":40527},[],"/docs/pr-preview/pr-27/platform/pki/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3805":377,"_26541":359,"_5":26808,"_22543":40529,"_10604":40530,"_1869":40531},[],"/docs/pr-preview/pr-27/platform/pki/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_3805":378,"_26541":359,"_5":26808,"_22543":40533,"_10604":40534,"_1869":40535},[],"/docs/pr-preview/pr-27/platform/pki/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3805":379,"_26541":359,"_5":26808,"_22543":40537,"_10604":40538,"_1869":40539},[],"/docs/pr-preview/pr-27/platform/pki/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3805":380,"_26541":359,"_5":26808,"_22543":40541,"_10604":40542,"_1869":40543},[],"/docs/pr-preview/pr-27/platform/pki/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3805":381,"_26541":359,"_5":26808,"_22543":40545,"_10604":40546,"_1869":40547},[],"/docs/pr-preview/pr-27/platform/pki/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3805":382,"_26541":359,"_5":26808,"_22543":40549,"_10604":40550,"_1869":40551},[],"/docs/pr-preview/pr-27/platform/pki/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3805":383,"_26541":359,"_5":26808,"_22543":40553,"_10604":40554,"_1869":40555},[],"/docs/pr-preview/pr-27/platform/pki/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3805":384,"_26541":359,"_5":26808,"_22543":40557,"_10604":40558,"_1869":40559},[],"/docs/pr-preview/pr-27/platform/pki/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3805":385,"_26541":359,"_5":26808,"_22543":40561,"_10604":40562,"_1869":40563},[],"/docs/pr-preview/pr-27/platform/pki/access-control#diagnóstico","Diagnóstico",{"_3805":386,"_26541":359,"_5":26808,"_22543":40565,"_10604":40566,"_1869":40567},[],"/docs/pr-preview/pr-27/platform/pki/access-control#la-respuesta-es-401","La respuesta es 401",{"_3805":387,"_26541":359,"_5":26808,"_22543":40569,"_10604":40570,"_1869":40571},[],"/docs/pr-preview/pr-27/platform/pki/access-control#la-respuesta-es-403","La respuesta es 403",{"_3805":388,"_26541":359,"_5":26808,"_22543":40573,"_10604":40574,"_1869":40575},[],"/docs/pr-preview/pr-27/platform/pki/access-control#todo-devuelve-403","Todo devuelve 403",{"_3805":389,"_26541":359,"_5":26808,"_22543":40577,"_10604":40578,"_1869":40579},[],"/docs/pr-preview/pr-27/platform/pki/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3805":390,"_26541":359,"_22543":40581,"_5":26803,"_10604":359,"_1869":40582},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3805":391,"_26541":359,"_22543":40584,"_5":26803,"_10604":359,"_1869":40585},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3805":392,"_26541":359,"_22543":40587,"_5":26803,"_10604":359,"_1869":40588},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3805":393,"_26541":359,"_22543":40590,"_5":26803,"_10604":40467,"_1869":40591},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3805":394,"_26541":359,"_22543":40593,"_5":26803,"_10604":40467,"_1869":40594},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3805":395,"_26541":359,"_22543":40596,"_5":26803,"_10604":40467,"_1869":40597},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3805":396,"_26541":359,"_22543":40599,"_5":26803,"_10604":40467,"_1869":40600},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3805":397,"_26541":359,"_22543":40602,"_5":26803,"_10604":40467,"_1869":40603},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3805":398,"_26541":359,"_22543":40605,"_5":26803,"_10604":40467,"_1869":40606},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y alguna de sus políticas debe permitir la operación solicitada.",{"_3805":399,"_26541":359,"_22543":40608,"_5":26803,"_10604":40471,"_1869":40609},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3805":400,"_26541":359,"_22543":40611,"_5":26803,"_10604":40471,"_1869":40612},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3805":401,"_26541":359,"_22543":40614,"_5":26803,"_10604":40475,"_1869":40615},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3805":402,"_26541":359,"_22543":40617,"_5":26803,"_10604":40475,"_1869":40618},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3805":403,"_26541":359,"_22543":40620,"_5":26803,"_10604":40475,"_1869":40621},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3805":404,"_26541":359,"_22543":40623,"_5":26803,"_10604":40475,"_1869":40624},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3805":405,"_26541":359,"_22543":40626,"_5":26803,"_10604":40475,"_1869":40627},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3805":406,"_26541":359,"_22543":40629,"_5":26803,"_10604":40475,"_1869":40630},[],"Carga por separado las políticas concedidas a cada principal.",{"_3805":407,"_26541":359,"_22543":40632,"_5":26803,"_10604":40475,"_1869":40633},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3805":408,"_26541":359,"_22543":40635,"_5":26803,"_10604":40475,"_1869":40636},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3805":409,"_26541":359,"_22543":40638,"_5":26803,"_10604":40475,"_1869":40639},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política.",{"_3805":410,"_26541":359,"_22543":40641,"_5":26803,"_10604":40475,"_1869":40642},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3805":411,"_26541":359,"_22543":40644,"_5":26803,"_10604":40475,"_1869":40645},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3805":412,"_26541":359,"_22543":40647,"_5":26803,"_10604":40475,"_1869":40648},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, el esquema debe declarar una restricción que relacione un valor de la petición con un atributo normalizado del principal.",{"_3805":413,"_26541":359,"_22543":40650,"_5":26803,"_10604":40479,"_1869":40651},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3805":414,"_26541":359,"_22543":40653,"_5":26803,"_10604":40479,"_1869":40654},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3805":415,"_26541":359,"_22543":40656,"_5":26803,"_10604":40479,"_1869":40657},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3805":416,"_26541":359,"_22543":40659,"_5":26803,"_10604":40479,"_1869":40660},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3805":417,"_26541":359,"_22543":40662,"_5":26803,"_10604":40479,"_1869":40663},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3805":418,"_26541":359,"_22543":40665,"_5":26803,"_10604":40479,"_1869":40666},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3805":419,"_26541":359,"_22543":40668,"_5":26803,"_10604":40479,"_1869":40669},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3805":420,"_26541":359,"_22543":40671,"_5":26803,"_10604":40479,"_1869":40672},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3805":421,"_26541":359,"_22543":40674,"_5":26803,"_10604":40479,"_1869":40675},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3805":422,"_26541":359,"_22543":40677,"_5":26803,"_10604":40479,"_1869":40678},[],"Las acciones se dividen en dos grupos:",{"_3805":423,"_26541":359,"_22543":40680,"_5":26803,"_10604":40479,"_1869":40681},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3805":424,"_26541":359,"_22543":40683,"_5":26803,"_10604":40479,"_1869":40684},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3805":425,"_26541":359,"_22543":40686,"_5":26803,"_10604":40479,"_1869":40687},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3805":426,"_26541":359,"_22543":40689,"_5":26803,"_10604":40483,"_1869":40690},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3805":427,"_26541":359,"_22543":40692,"_5":26803,"_10604":40483,"_1869":40693},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3805":428,"_26541":359,"_22543":40695,"_5":26803,"_10604":40483,"_1869":40696},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega. Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3805":429,"_26541":359,"_22543":40698,"_5":26803,"_10604":40487,"_1869":40699},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3805":430,"_26541":359,"_22543":40701,"_5":26803,"_10604":40487,"_1869":40702},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3805":431,"_26541":359,"_22543":40704,"_5":26803,"_10604":40487,"_1869":40705},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3805":432,"_26541":359,"_22543":40707,"_5":26803,"_10604":40487,"_1869":40708},[],"Los operadores implementados son:",{"_3805":433,"_26541":359,"_22543":40710,"_5":26803,"_10604":40487,"_1869":40711},[],"`equals`, para igualdad exacta;",{"_3805":434,"_26541":359,"_22543":40713,"_5":26803,"_10604":40487,"_1869":40714},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3805":435,"_26541":359,"_22543":40716,"_5":26803,"_10604":40487,"_1869":40717},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3805":436,"_26541":359,"_22543":40719,"_5":26803,"_10604":40487,"_1869":40720},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3805":437,"_26541":359,"_22543":40722,"_5":26803,"_10604":40491,"_1869":40723},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3805":438,"_26541":359,"_22543":40725,"_5":26803,"_10604":40491,"_1869":40726},[],"Los modos disponibles son:",{"_3805":439,"_26541":359,"_22543":40728,"_5":26803,"_10604":40491,"_1869":40729},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3805":440,"_26541":359,"_22543":40731,"_5":26803,"_10604":40491,"_1869":40732},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3805":441,"_26541":359,"_22543":40734,"_5":26803,"_10604":40491,"_1869":40735},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3805":442,"_26541":359,"_22543":40737,"_5":26803,"_10604":40491,"_1869":40738},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3805":443,"_26541":359,"_22543":40740,"_5":26803,"_10604":40491,"_1869":40741},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3805":444,"_26541":359,"_22543":40743,"_5":26803,"_10604":40491,"_1869":40744},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3805":445,"_26541":359,"_22543":40746,"_5":26803,"_10604":40495,"_1869":40747},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3805":446,"_26541":359,"_22543":40749,"_5":26803,"_10604":40495,"_1869":40750},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3805":447,"_26541":359,"_22543":40752,"_5":26803,"_10604":40495,"_1869":40753},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3805":448,"_26541":359,"_22543":40755,"_5":26803,"_10604":40495,"_1869":40756},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3805":449,"_26541":359,"_22543":40758,"_5":26803,"_10604":40503,"_1869":40759},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3805":450,"_26541":359,"_22543":40761,"_5":26803,"_10604":40503,"_1869":40762},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3805":451,"_26541":359,"_22543":40764,"_5":26803,"_10604":40507,"_1869":40765},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3805":452,"_26541":359,"_22543":40767,"_5":26803,"_10604":40507,"_1869":40768},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3805":453,"_26541":359,"_22543":40770,"_5":26803,"_10604":40511,"_1869":40771},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3805":454,"_26541":359,"_22543":40773,"_5":26803,"_10604":40511,"_1869":40774},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3805":455,"_26541":359,"_22543":40776,"_5":26803,"_10604":40511,"_1869":40777},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3805":456,"_26541":359,"_22543":40779,"_5":26803,"_10604":40515,"_1869":40780},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3805":457,"_26541":359,"_22543":40782,"_5":26803,"_10604":40515,"_1869":40783},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3805":458,"_26541":359,"_22543":40785,"_5":26803,"_10604":40515,"_1869":40786},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3805":459,"_26541":359,"_22543":40788,"_5":26803,"_10604":40519,"_1869":40789},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3805":460,"_26541":359,"_22543":40791,"_5":26803,"_10604":40519,"_1869":40792},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3805":461,"_26541":359,"_22543":40794,"_5":26803,"_10604":40519,"_1869":40795},[],"acceso completo y de solo lectura a KMS;",{"_3805":462,"_26541":359,"_22543":40797,"_5":26803,"_10604":40519,"_1869":40798},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3805":463,"_26541":359,"_22543":40800,"_5":26803,"_10604":40519,"_1869":40801},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3805":464,"_26541":359,"_22543":40803,"_5":26803,"_10604":40519,"_1869":40804},[],"acceso a la interfaz;",{"_3805":465,"_26541":359,"_22543":40806,"_5":26803,"_10604":40519,"_1869":40807},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3805":466,"_26541":359,"_22543":40809,"_5":26803,"_10604":40519,"_1869":40810},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3805":467,"_26541":359,"_22543":40812,"_5":26803,"_10604":40519,"_1869":40813},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3805":468,"_26541":359,"_22543":40815,"_5":26803,"_10604":40523,"_1869":40816},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3805":469,"_26541":359,"_22543":40818,"_5":26803,"_10604":40523,"_1869":40819},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3805":470,"_26541":359,"_22543":40821,"_5":26803,"_10604":40523,"_1869":40822},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3805":471,"_26541":359,"_22543":40824,"_5":26803,"_10604":40526,"_1869":40825},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3805":472,"_26541":359,"_22543":40827,"_5":26803,"_10604":40530,"_1869":40828},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_3805":473,"_26541":359,"_22543":40830,"_5":26803,"_10604":40534,"_1869":40831},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3805":474,"_26541":359,"_22543":40833,"_5":26803,"_10604":40538,"_1869":40834},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3805":475,"_26541":359,"_22543":40836,"_5":26803,"_10604":40542,"_1869":40837},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3805":476,"_26541":359,"_22543":40839,"_5":26803,"_10604":40546,"_1869":40840},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3805":477,"_26541":359,"_22543":40842,"_5":26803,"_10604":40546,"_1869":40843},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3805":478,"_26541":359,"_22543":40845,"_5":26803,"_10604":40550,"_1869":40846},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3805":479,"_26541":359,"_22543":40848,"_5":26803,"_10604":40550,"_1869":40849},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3805":480,"_26541":359,"_22543":40851,"_5":26803,"_10604":40550,"_1869":40852},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3805":481,"_26541":359,"_22543":40854,"_5":26803,"_10604":40550,"_1869":40855},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3805":482,"_26541":359,"_22543":40857,"_5":26803,"_10604":40550,"_1869":40858},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3805":483,"_26541":359,"_22543":40860,"_5":26803,"_10604":40550,"_1869":40861},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3805":484,"_26541":359,"_22543":40863,"_5":26803,"_10604":40550,"_1869":40864},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3805":485,"_26541":359,"_22543":40866,"_5":26803,"_10604":40550,"_1869":40867},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3805":486,"_26541":359,"_22543":40869,"_5":26803,"_10604":40554,"_1869":40870},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3805":487,"_26541":359,"_22543":40872,"_5":26803,"_10604":40554,"_1869":40873},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3805":488,"_26541":359,"_22543":40875,"_5":26803,"_10604":40554,"_1869":40876},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3805":489,"_26541":359,"_22543":40878,"_5":26803,"_10604":40558,"_1869":40879},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3805":490,"_26541":359,"_22543":40881,"_5":26803,"_10604":40558,"_1869":40882},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3805":491,"_26541":359,"_22543":40884,"_5":26803,"_10604":40558,"_1869":40885},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3805":492,"_26541":359,"_22543":40887,"_5":26803,"_10604":40558,"_1869":40888},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3805":493,"_26541":359,"_22543":40890,"_5":26803,"_10604":40558,"_1869":40891},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3805":494,"_26541":359,"_22543":40893,"_5":26803,"_10604":40558,"_1869":40894},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3805":495,"_26541":359,"_22543":40896,"_5":26803,"_10604":40558,"_1869":40897},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3805":496,"_26541":359,"_22543":40899,"_5":26803,"_10604":40566,"_1869":40900},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3805":497,"_26541":359,"_22543":40902,"_5":26803,"_10604":40570,"_1869":40903},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3805":498,"_26541":359,"_22543":40905,"_5":26803,"_10604":40570,"_1869":40906},[],"que exista un principal activo del tipo correcto;",{"_3805":499,"_26541":359,"_22543":40908,"_5":26803,"_10604":40570,"_1869":40909},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3805":500,"_26541":359,"_22543":40911,"_5":26803,"_10604":40570,"_1869":40912},[],"que todas las condiciones del principal se cumplan;",{"_3805":501,"_26541":359,"_22543":40914,"_5":26803,"_10604":40570,"_1869":40915},[],"que el principal tenga concedida la política esperada;",{"_3805":502,"_26541":359,"_22543":40917,"_5":26803,"_10604":40570,"_1869":40918},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3805":503,"_26541":359,"_22543":40920,"_5":26803,"_10604":40570,"_1869":40921},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3805":504,"_26541":359,"_22543":40923,"_5":26803,"_10604":40570,"_1869":40924},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos.",{"_3805":505,"_26541":359,"_22543":40926,"_5":26803,"_10604":40574,"_1869":40927},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3805":506,"_26541":359,"_22543":40929,"_5":26803,"_10604":40578,"_1869":40930},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3805":507,"_26541":359,"_22543":40932,"_5":26803,"_10604":40578,"_1869":40933},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3805":508,"_26541":508,"_5":26798,"_1869":40935,"_26811":40936,"_22543":40938,"_10604":508},"Alertas y suscripciones",[39375,40459,40937],"Operar Lamassu",[],{"_3805":509,"_26541":508,"_22543":40940,"_5":26803,"_10604":508,"_1869":40941},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3805":510,"_26541":508,"_5":26808,"_22543":40943,"_10604":40944,"_1869":40945},[],"/docs/pr-preview/pr-27/platform/pki/alerts#cómo-funciona","Cómo funciona",{"_3805":511,"_26541":508,"_5":26808,"_22543":40947,"_10604":40948,"_1869":40949},[],"/docs/pr-preview/pr-27/platform/pki/alerts#canales-disponibles","Canales disponibles",{"_3805":512,"_26541":508,"_5":26808,"_22543":40951,"_10604":40952,"_1869":40953},[],"/docs/pr-preview/pr-27/platform/pki/alerts#crea-una-suscripción","Crea una suscripción",{"_3805":513,"_26541":508,"_5":26808,"_22543":40955,"_10604":40956,"_1869":40957},[],"/docs/pr-preview/pr-27/platform/pki/alerts#elige-el-evento","Elige el evento",{"_3805":514,"_26541":508,"_5":26808,"_22543":40959,"_10604":40960,"_1869":40961},[],"/docs/pr-preview/pr-27/platform/pki/alerts#configura-el-destino","Configura el destino",{"_3805":515,"_26541":508,"_5":26808,"_22543":40963,"_10604":40964,"_1869":40965},[],"/docs/pr-preview/pr-27/platform/pki/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3805":516,"_26541":508,"_5":26808,"_22543":40967,"_10604":40968,"_1869":40969},[],"/docs/pr-preview/pr-27/platform/pki/alerts#revisa-y-activa","Revisa y activa",{"_3805":517,"_26541":508,"_5":26808,"_22543":40971,"_10604":40972,"_1869":40973},[],"/docs/pr-preview/pr-27/platform/pki/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3805":518,"_26541":508,"_5":26808,"_22543":40975,"_10604":40976,"_1869":40977},[],"/docs/pr-preview/pr-27/platform/pki/alerts#familias-de-eventos","Familias de eventos",{"_3805":519,"_26541":508,"_22543":40979,"_5":26803,"_10604":508,"_1869":40980},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3805":520,"_26541":508,"_22543":40982,"_5":26803,"_10604":40944,"_1869":40983},[],"Un servicio publica un evento de dominio.",{"_3805":521,"_26541":508,"_22543":40985,"_5":26803,"_10604":40944,"_1869":40986},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3805":522,"_26541":508,"_22543":40988,"_5":26803,"_10604":40944,"_1869":40989},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3805":523,"_26541":508,"_22543":40991,"_5":26803,"_10604":40944,"_1869":40992},[],"Lamassu entrega el evento al canal configurado.",{"_3805":524,"_26541":508,"_22543":40994,"_5":26803,"_10604":40944,"_1869":40995},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3805":525,"_26541":508,"_22543":40997,"_5":26803,"_10604":40948,"_1869":40998},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino.",{"_3805":526,"_26541":508,"_22543":41000,"_5":26803,"_10604":40948,"_1869":41001},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3805":527,"_26541":508,"_22543":41003,"_5":26803,"_10604":40948,"_1869":41004},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3805":528,"_26541":508,"_22543":41006,"_5":26803,"_10604":40956,"_1869":41007},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3805":529,"_26541":508,"_22543":41009,"_5":26803,"_10604":40960,"_1869":41010},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3805":530,"_26541":508,"_22543":41012,"_5":26803,"_10604":40964,"_1869":41013},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3805":531,"_26541":508,"_22543":41015,"_5":26803,"_10604":40964,"_1869":41016},[],"**None** notifica todas las instancias del evento.",{"_3805":532,"_26541":508,"_22543":41018,"_5":26803,"_10604":40964,"_1869":41019},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3805":533,"_26541":508,"_22543":41021,"_5":26803,"_10604":40964,"_1869":41022},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3805":534,"_26541":508,"_22543":41024,"_5":26803,"_10604":40964,"_1869":41025},[],"**JavaScript** permite expresar lógica personalizada.",{"_3805":535,"_26541":508,"_22543":41027,"_5":26803,"_10604":40964,"_1869":41028},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3805":536,"_26541":508,"_22543":41030,"_5":26803,"_10604":40968,"_1869":41031},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3805":537,"_26541":508,"_22543":41033,"_5":26803,"_10604":40972,"_1869":41034},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3805":538,"_26541":508,"_22543":41036,"_5":26803,"_10604":40976,"_1869":41037},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3805":539,"_26541":508,"_22543":41039,"_5":26803,"_10604":40976,"_1869":41040},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3805":540,"_26541":508,"_22543":41042,"_5":26803,"_10604":40976,"_1869":41043},[],"**Perfiles:** `profile.create`, `profile.update` y `profile.delete`.",{"_3805":541,"_26541":508,"_22543":41045,"_5":26803,"_10604":40976,"_1869":41046},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3805":542,"_26541":508,"_22543":41048,"_5":26803,"_10604":40976,"_1869":41049},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3805":543,"_26541":508,"_22543":41051,"_5":26803,"_10604":40976,"_1869":41052},[],"**Validación:** `va.role.crl.create`.",{"_3805":544,"_26541":508,"_22543":41054,"_5":26803,"_10604":40976,"_1869":41055},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign.message` y `kms.delete`.",{"_3805":545,"_26541":508,"_22543":41057,"_5":26803,"_10604":40976,"_1869":41058},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3805":546,"_26541":546,"_5":26798,"_1869":41060,"_26811":41061,"_22543":41062,"_10604":546},"Registros de auditoría",[39375,40459,40460],[],{"_3805":547,"_26541":546,"_22543":41064,"_5":26803,"_10604":546,"_1869":41065},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3805":548,"_26541":546,"_5":26808,"_22543":41067,"_10604":41068,"_1869":41069},[],"/docs/pr-preview/pr-27/platform/pki/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3805":549,"_26541":546,"_5":26808,"_22543":41071,"_10604":41072,"_1869":41073},[],"/docs/pr-preview/pr-27/platform/pki/audit-logs#cobertura","Cobertura",{"_3805":550,"_26541":546,"_5":26808,"_22543":41075,"_10604":41076,"_1869":41077},[],"/docs/pr-preview/pr-27/platform/pki/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3805":551,"_26541":546,"_5":26808,"_22543":41079,"_10604":41080,"_1869":41081},[],"/docs/pr-preview/pr-27/platform/pki/audit-logs#datos-sensibles","Datos sensibles",{"_3805":552,"_26541":546,"_5":26808,"_22543":41083,"_10604":41084,"_1869":41085},[],"/docs/pr-preview/pr-27/platform/pki/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3805":553,"_26541":546,"_5":26808,"_22543":41087,"_10604":41088,"_1869":41089},[],"/docs/pr-preview/pr-27/platform/pki/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3805":554,"_26541":546,"_5":26808,"_22543":41091,"_10604":41092,"_1869":41093},[],"/docs/pr-preview/pr-27/platform/pki/audit-logs#identifica-la-operación","Identifica la operación",{"_3805":555,"_26541":546,"_5":26808,"_22543":41095,"_10604":41096,"_1869":41097},[],"/docs/pr-preview/pr-27/platform/pki/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3805":556,"_26541":546,"_5":26808,"_22543":41099,"_10604":41100,"_1869":41101},[],"/docs/pr-preview/pr-27/platform/pki/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3805":557,"_26541":546,"_5":26808,"_22543":41103,"_10604":41104,"_1869":41105},[],"/docs/pr-preview/pr-27/platform/pki/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3805":558,"_26541":546,"_5":26808,"_22543":41107,"_10604":41108,"_1869":41109},[],"/docs/pr-preview/pr-27/platform/pki/audit-logs#verificación-periódica","Verificación periódica",{"_3805":559,"_26541":546,"_22543":41111,"_5":26803,"_10604":546,"_1869":41112},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3805":560,"_26541":546,"_22543":41114,"_5":26803,"_10604":41068,"_1869":41115},[],"El cuerpo de auditoría incluye:",{"_3805":561,"_26541":546,"_22543":41117,"_5":26803,"_10604":41068,"_1869":41118},[],"input: datos recibidos por la operación;",{"_3805":562,"_26541":546,"_22543":41120,"_5":26803,"_10604":41068,"_1869":41121},[],"has\\_error: indica si el servicio devolvió un error;",{"_3805":563,"_26541":546,"_22543":41123,"_5":26803,"_10604":41068,"_1869":41124},[],"output: resultado producido o mensaje de error;",{"_3805":564,"_26541":546,"_22543":41126,"_5":26803,"_10604":41068,"_1869":41127},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3805":565,"_26541":546,"_22543":41129,"_5":26803,"_10604":41068,"_1869":41130},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3805":566,"_26541":546,"_22543":41132,"_5":26803,"_10604":41068,"_1869":41133},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3805":567,"_26541":546,"_22543":41135,"_5":26803,"_10604":41072,"_1869":41136},[],"El backend aplica auditoría a mutaciones de:",{"_3805":568,"_26541":546,"_22543":41138,"_5":26803,"_10604":41072,"_1869":41139},[],"autoridades, certificados y perfiles de emisión;",{"_3805":569,"_26541":546,"_22543":41141,"_5":26803,"_10604":41072,"_1869":41142},[],"claves y motores KMS;",{"_3805":570,"_26541":546,"_22543":41144,"_5":26803,"_10604":41072,"_1869":41145},[],"dispositivos e identidades;",{"_3805":571,"_26541":546,"_22543":41147,"_5":26803,"_10604":41072,"_1869":41148},[],"DMS y operaciones de enrolamiento;",{"_3805":572,"_26541":546,"_22543":41150,"_5":26803,"_10604":41072,"_1869":41151},[],"funciones de validación y CRL;",{"_3805":573,"_26541":546,"_22543":41153,"_5":26803,"_10604":41072,"_1869":41154},[],"principales, políticas y concesiones de autorización.",{"_3805":574,"_26541":546,"_22543":41156,"_5":26803,"_10604":41072,"_1869":41157},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3805":575,"_26541":546,"_22543":41159,"_5":26803,"_10604":41076,"_1869":41160},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3805":576,"_26541":546,"_22543":41162,"_5":26803,"_10604":41076,"_1869":41163},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3805":577,"_26541":546,"_22543":41165,"_5":26803,"_10604":41076,"_1869":41166},[],"Diseña el consumidor para:",{"_3805":578,"_26541":546,"_22543":41168,"_5":26803,"_10604":41076,"_1869":41169},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3805":579,"_26541":546,"_22543":41171,"_5":26803,"_10604":41076,"_1869":41172},[],"conservar el CloudEvent completo sin modificar;",{"_3805":580,"_26541":546,"_22543":41174,"_5":26803,"_10604":41076,"_1869":41175},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3805":581,"_26541":546,"_22543":41177,"_5":26803,"_10604":41076,"_1869":41178},[],"cifrar en tránsito y en reposo;",{"_3805":582,"_26541":546,"_22543":41180,"_5":26803,"_10604":41076,"_1869":41181},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3805":583,"_26541":546,"_22543":41183,"_5":26803,"_10604":41076,"_1869":41184},[],"aplicar una política explícita de retención y legal hold;",{"_3805":584,"_26541":546,"_22543":41186,"_5":26803,"_10604":41076,"_1869":41187},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3805":585,"_26541":546,"_22543":41189,"_5":26803,"_10604":41080,"_1869":41190},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3805":586,"_26541":546,"_22543":41192,"_5":26803,"_10604":41080,"_1869":41193},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3805":587,"_26541":546,"_22543":41195,"_5":26803,"_10604":41088,"_1869":41196},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3805":588,"_26541":546,"_22543":41198,"_5":26803,"_10604":41092,"_1869":41199},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3805":589,"_26541":546,"_22543":41201,"_5":26803,"_10604":41096,"_1869":41202},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3805":590,"_26541":546,"_22543":41204,"_5":26803,"_10604":41100,"_1869":41205},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3805":591,"_26541":546,"_22543":41207,"_5":26803,"_10604":41104,"_1869":41208},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3805":592,"_26541":546,"_22543":41210,"_5":26803,"_10604":41108,"_1869":41211},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3805":593,"_26541":546,"_22543":41213,"_5":26803,"_10604":41108,"_1869":41214},[],"aparece un evento de auditoría correcto;",{"_3805":594,"_26541":546,"_22543":41216,"_5":26803,"_10604":41108,"_1869":41217},[],"el principal coincide con la identidad utilizada;",{"_3805":595,"_26541":546,"_22543":41219,"_5":26803,"_10604":41108,"_1869":41220},[],"el consumidor lo persiste una sola vez;",{"_3805":596,"_26541":546,"_22543":41222,"_5":26803,"_10604":41108,"_1869":41223},[],"puede recuperarse por recurso, actor y periodo;",{"_3805":597,"_26541":546,"_22543":41225,"_5":26803,"_10604":41108,"_1869":41226},[],"una interrupción del consumidor produce una alerta.",{"_3805":598,"_26541":546,"_22543":41228,"_5":26803,"_10604":41108,"_1869":41229},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3805":599,"_26541":599,"_5":26798,"_1869":41231,"_26811":41232,"_22543":41233,"_10604":599},"Jerarquía y rotación de CAs",[39375,40459,40937],[],{"_3805":600,"_26541":599,"_22543":41235,"_5":26803,"_10604":599,"_1869":41236},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3805":601,"_26541":599,"_5":26808,"_22543":41238,"_10604":41239,"_1869":41240},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3805":602,"_26541":599,"_5":26808,"_22543":41242,"_10604":41243,"_1869":41244},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3805":603,"_26541":599,"_5":26808,"_22543":41246,"_10604":41247,"_1869":41248},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3805":604,"_26541":599,"_5":26808,"_22543":41250,"_10604":41251,"_1869":41252},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3805":605,"_26541":599,"_5":26808,"_22543":41254,"_10604":41255,"_1869":41256},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3805":606,"_26541":599,"_5":26808,"_22543":41258,"_10604":41259,"_1869":41260},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3805":607,"_26541":599,"_5":26808,"_22543":41262,"_10604":41263,"_1869":41264},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3805":608,"_26541":599,"_5":26808,"_22543":41266,"_10604":41267,"_1869":41268},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3805":609,"_26541":599,"_5":26808,"_22543":41270,"_10604":41271,"_1869":41272},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3805":610,"_26541":599,"_5":26808,"_22543":41274,"_10604":41275,"_1869":41276},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3805":611,"_26541":599,"_5":26808,"_22543":41278,"_10604":41279,"_1869":41280},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3805":612,"_26541":599,"_5":26808,"_22543":41282,"_10604":41283,"_1869":41284},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3805":613,"_26541":599,"_22543":41286,"_5":26803,"_10604":599,"_1869":41287},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3805":614,"_26541":599,"_22543":41289,"_5":26803,"_10604":41239,"_1869":41290},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3805":615,"_26541":599,"_22543":41292,"_5":26803,"_10604":41239,"_1869":41293},[],"entorno, como producción y preproducción;",{"_3805":616,"_26541":599,"_22543":41295,"_5":26803,"_10604":41239,"_1869":41296},[],"propietario o equipo operador;",{"_3805":617,"_26541":599,"_22543":41298,"_5":26803,"_10604":41239,"_1869":41299},[],"familia de dispositivos o proceso de fabricación;",{"_3805":618,"_26541":599,"_22543":41301,"_5":26803,"_10604":41239,"_1869":41302},[],"región o requisito regulatorio;",{"_3805":619,"_26541":599,"_22543":41304,"_5":26803,"_10604":41239,"_1869":41305},[],"motor criptográfico o política de clave;",{"_3805":620,"_26541":599,"_22543":41307,"_5":26803,"_10604":41239,"_1869":41308},[],"ventana de mantenimiento y ritmo de renovación.",{"_3805":621,"_26541":599,"_22543":41310,"_5":26803,"_10604":41239,"_1869":41311},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3805":622,"_26541":599,"_22543":41313,"_5":26803,"_10604":41239,"_1869":41314},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3805":623,"_26541":599,"_22543":41316,"_5":26803,"_10604":41243,"_1869":41317},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3805":624,"_26541":599,"_22543":41319,"_5":26803,"_10604":41243,"_1869":41320},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3805":625,"_26541":599,"_22543":41322,"_5":26803,"_10604":41243,"_1869":41323},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3805":626,"_26541":599,"_22543":41325,"_5":26803,"_10604":41247,"_1869":41326},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3805":627,"_26541":599,"_22543":41328,"_5":26803,"_10604":41247,"_1869":41329},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3805":628,"_26541":599,"_22543":41331,"_5":26803,"_10604":41247,"_1869":41332},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3805":629,"_26541":599,"_22543":41334,"_5":26803,"_10604":41247,"_1869":41335},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3805":630,"_26541":599,"_22543":41337,"_5":26803,"_10604":41255,"_1869":41338},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3805":631,"_26541":599,"_22543":41340,"_5":26803,"_10604":41259,"_1869":41341},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3805":632,"_26541":599,"_22543":41343,"_5":26803,"_10604":41263,"_1869":41344},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. En un DMS, utiliza las CAs gestionadas de `/cacerts` para mantener temporalmente las cadenas antigua y nueva.",{"_3805":633,"_26541":599,"_22543":41346,"_5":26803,"_10604":41267,"_1869":41347},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_3805":634,"_26541":599,"_22543":41349,"_5":26803,"_10604":41271,"_1869":41350},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3805":635,"_26541":599,"_22543":41352,"_5":26803,"_10604":41275,"_1869":41353},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_3805":636,"_26541":599,"_22543":41355,"_5":26803,"_10604":41279,"_1869":41356},[],"Al revocar una CA, Lamassu actualiza también sus CAs hijas y certificados emitidos a `REVOKED` con razón `CessationOfOperation`. Las revocaciones de las hijas propagan el efecto a sus propias ramas.",{"_3805":637,"_26541":599,"_22543":41358,"_5":26803,"_10604":41279,"_1869":41359},[],"Esto protege la coherencia de la jerarquía, pero convierte la revocación en una acción de gran impacto. No la utilices como mecanismo ordinario para dejar de emitir: primero completa la migración y elimina la CA de los flujos operativos.",{"_3805":638,"_26541":599,"_22543":41361,"_5":26803,"_10604":41283,"_1869":41362},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3805":639,"_26541":599,"_22543":41364,"_5":26803,"_10604":41283,"_1869":41365},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3805":640,"_26541":599,"_22543":41367,"_5":26803,"_10604":41283,"_1869":41368},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3805":641,"_26541":599,"_22543":41370,"_5":26803,"_10604":41283,"_1869":41371},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3805":642,"_26541":599,"_22543":41373,"_5":26803,"_10604":41283,"_1869":41374},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3805":643,"_26541":599,"_22543":41376,"_5":26803,"_10604":41283,"_1869":41377},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3805":644,"_26541":599,"_22543":41379,"_5":26803,"_10604":41283,"_1869":41380},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3805":645,"_26541":645,"_5":26798,"_1869":41382,"_26811":41383,"_22543":41384,"_10604":645},"Autoridades de certificación",[39375,40459,40937],[],{"_3805":646,"_26541":645,"_22543":41386,"_5":26803,"_10604":645,"_1869":41387},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3805":647,"_26541":645,"_5":26808,"_22543":41389,"_10604":41390,"_1869":41391},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3805":648,"_26541":645,"_5":26808,"_22543":41393,"_10604":41394,"_1869":41395},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3805":649,"_26541":645,"_5":26808,"_22543":41397,"_10604":41398,"_1869":39385},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#antes-de-empezar",{"_3805":650,"_26541":645,"_5":26808,"_22543":41400,"_10604":41401,"_1869":41402},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3805":651,"_26541":645,"_5":26808,"_22543":41404,"_10604":41405,"_1869":41406},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3805":652,"_26541":645,"_5":26808,"_22543":41408,"_10604":41409,"_1869":41410},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3805":653,"_26541":645,"_5":26808,"_22543":41412,"_10604":41413,"_1869":41414},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3805":654,"_26541":645,"_5":26808,"_22543":41416,"_10604":41417,"_1869":41418},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3805":655,"_26541":645,"_5":26808,"_22543":41420,"_10604":41421,"_1869":41422},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3805":656,"_26541":645,"_5":26808,"_22543":41424,"_10604":41425,"_1869":41426},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3805":657,"_26541":645,"_5":26808,"_22543":41428,"_10604":41429,"_1869":41430},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3805":658,"_26541":645,"_5":26808,"_22543":41432,"_10604":41433,"_1869":41434},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3805":659,"_26541":645,"_5":26808,"_22543":41436,"_10604":41437,"_1869":41438},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3805":660,"_26541":645,"_5":26808,"_22543":41440,"_10604":41441,"_1869":41442},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3805":661,"_26541":645,"_5":26808,"_22543":41444,"_10604":41445,"_1869":41446},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3805":662,"_26541":645,"_5":26808,"_22543":41448,"_10604":41449,"_1869":41450},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3805":663,"_26541":645,"_5":26808,"_22543":41452,"_10604":41453,"_1869":41454},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3805":664,"_26541":645,"_5":26808,"_22543":41456,"_10604":41457,"_1869":41458},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3805":665,"_26541":645,"_5":26808,"_22543":41460,"_10604":41461,"_1869":41462},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3805":666,"_26541":645,"_5":26808,"_22543":41464,"_10604":41465,"_1869":41466},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3805":667,"_26541":645,"_5":26808,"_22543":41468,"_10604":41469,"_1869":41470},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3805":668,"_26541":645,"_5":26808,"_22543":41472,"_10604":41473,"_1869":41474},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3805":669,"_26541":645,"_22543":41476,"_5":26803,"_10604":645,"_1869":41477},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3805":670,"_26541":645,"_22543":41479,"_5":26803,"_10604":645,"_1869":41480},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3805":671,"_26541":645,"_22543":41482,"_5":26803,"_10604":41390,"_1869":41483},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3805":672,"_26541":645,"_22543":41485,"_5":26803,"_10604":41390,"_1869":41486},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3805":673,"_26541":645,"_22543":41488,"_5":26803,"_10604":41390,"_1869":41489},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3805":674,"_26541":645,"_22543":41491,"_5":26803,"_10604":41390,"_1869":41492},[],"**Importar solo el certificado:** añade una autoridad para construir cadenas y validar, pero no para emitir.",{"_3805":675,"_26541":645,"_22543":41494,"_5":26803,"_10604":41390,"_1869":41495},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3805":676,"_26541":645,"_22543":41497,"_5":26803,"_10604":41398,"_1869":41498},[],"Decide si la CA será raíz o intermedia.",{"_3805":677,"_26541":645,"_22543":41500,"_5":26803,"_10604":41398,"_1869":41501},[],"Elige el motor que custodiará la clave.",{"_3805":678,"_26541":645,"_22543":41503,"_5":26803,"_10604":41398,"_1869":41504},[],"Define una validez superior a la de los certificados que emitirá.",{"_3805":679,"_26541":645,"_22543":41506,"_5":26803,"_10604":41398,"_1869":41507},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3805":680,"_26541":645,"_22543":41509,"_5":26803,"_10604":41401,"_1869":41510},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3805":681,"_26541":645,"_22543":41512,"_5":26803,"_10604":41405,"_1869":41513},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3805":682,"_26541":645,"_22543":41515,"_5":26803,"_10604":41405,"_1869":41516},[],"Para RSA puedes elegir 1024, 2048, 3072 o 4096 bits. Para EC están disponibles las curvas P-256, P-384 y P-521.",{"_3805":683,"_26541":645,"_22543":41518,"_5":26803,"_10604":41409,"_1869":41519},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3805":684,"_26541":645,"_22543":41521,"_5":26803,"_10604":41413,"_1869":41522},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3805":685,"_26541":645,"_22543":41524,"_5":26803,"_10604":41413,"_1869":41525},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3805":686,"_26541":645,"_22543":41527,"_5":26803,"_10604":41413,"_1869":41528},[],"`ST`: estado o provincia.",{"_3805":687,"_26541":645,"_22543":41530,"_5":26803,"_10604":41413,"_1869":41531},[],"`L`: localidad.",{"_3805":688,"_26541":645,"_22543":41533,"_5":26803,"_10604":41413,"_1869":41534},[],"`O`: organización.",{"_3805":689,"_26541":645,"_22543":41536,"_5":26803,"_10604":41413,"_1869":41537},[],"`OU`: unidad organizativa.",{"_3805":690,"_26541":645,"_22543":41539,"_5":26803,"_10604":41413,"_1869":41540},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3805":691,"_26541":645,"_22543":41542,"_5":26803,"_10604":41417,"_1869":41543},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3805":692,"_26541":645,"_22543":41545,"_5":26803,"_10604":41417,"_1869":41546},[],"Selecciona un perfil de emisión existente o configura los `Key Usage` y `Extended Key Usage` en el formulario. Si no eliges un perfil, Lamassu aplica los usos básicos predeterminados.",{"_3805":693,"_26541":645,"_22543":41548,"_5":26803,"_10604":41421,"_1869":41549},[],"Confirma el formulario. La CA debe aparecer en el inventario con su certificado PEM, estado, fecha de expiración y relación de certificados emitidos.",{"_3805":694,"_26541":645,"_22543":41551,"_5":26803,"_10604":41421,"_1869":41552},[],"Una CA no puede emitir certificados que superen su propia fecha de expiración. Deja margen suficiente para renovar o sustituir la autoridad sin interrumpir a los consumidores.",{"_3805":695,"_26541":645,"_22543":41554,"_5":26803,"_10604":41425,"_1869":41555},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3805":696,"_26541":645,"_22543":41557,"_5":26803,"_10604":41425,"_1869":41558},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3805":697,"_26541":645,"_22543":41560,"_5":26803,"_10604":41429,"_1869":41561},[],"La importación conserva una autoridad creada fuera de Lamassu.",{"_3805":698,"_26541":645,"_22543":41563,"_5":26803,"_10604":41433,"_1869":41564},[],"Elige el motor que custodiará la clave importada.",{"_3805":699,"_26541":645,"_22543":41566,"_5":26803,"_10604":41437,"_1869":41567},[],"Proporciona el certificado de CA y la clave privada en formato PEM. Para una CA subordinada, añade opcionalmente la cadena de validación.",{"_3805":700,"_26541":645,"_22543":41569,"_5":26803,"_10604":41441,"_1869":41570},[],"Configura la validez que recibirán los certificados finales cuando una solicitud no indique otra duración.",{"_3805":701,"_26541":645,"_22543":41572,"_5":26803,"_10604":41445,"_1869":41573},[],"Lamassu comprueba que el certificado pertenece a una CA y que el material es coherente antes de registrarlo.",{"_3805":702,"_26541":645,"_22543":41575,"_5":26803,"_10604":41445,"_1869":41576},[],"Si no dispones de la clave privada, importa únicamente el certificado. La autoridad podrá formar parte de cadenas de confianza y procesos de validación, pero no podrá emitir certificados desde Lamassu.",{"_3805":703,"_26541":645,"_22543":41578,"_5":26803,"_10604":41449,"_1869":41579},[],"Abre una CA desde el inventario para consultar:",{"_3805":704,"_26541":645,"_22543":41581,"_5":26803,"_10604":41449,"_1869":41582},[],"Estado y periodo de validez.",{"_3805":705,"_26541":645,"_22543":41584,"_5":26803,"_10604":41449,"_1869":41585},[],"Certificado y cadena en formato PEM.",{"_3805":706,"_26541":645,"_22543":41587,"_5":26803,"_10604":41449,"_1869":41588},[],"Número de certificados activos, expirados y revocados.",{"_3805":707,"_26541":645,"_22543":41590,"_5":26803,"_10604":41449,"_1869":41591},[],"Certificados emitidos en **Issued Certificates**.",{"_3805":708,"_26541":645,"_22543":41593,"_5":26803,"_10604":41449,"_1869":41594},[],"CRL vinculada a la autoridad.",{"_3805":709,"_26541":645,"_22543":41596,"_5":26803,"_10604":41449,"_1869":41597},[],"Metadatos y motor criptográfico asociado.",{"_3805":710,"_26541":645,"_22543":41599,"_5":26803,"_10604":41449,"_1869":41600},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3805":711,"_26541":645,"_22543":41602,"_5":26803,"_10604":41453,"_1869":41603},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3805":712,"_26541":645,"_22543":41605,"_5":26803,"_10604":41453,"_1869":41606},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3805":713,"_26541":645,"_22543":41608,"_5":26803,"_10604":41453,"_1869":41609},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3805":714,"_26541":645,"_22543":41611,"_5":26803,"_10604":41453,"_1869":41612},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3805":715,"_26541":645,"_22543":41614,"_5":26803,"_10604":41457,"_1869":41615},[],"Revocar una CA invalida la confianza en los certificados que ha emitido y puede interrumpir dispositivos y servicios. La acción es irreversible.",{"_3805":716,"_26541":645,"_22543":41617,"_5":26803,"_10604":41461,"_1869":41618},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3805":717,"_26541":645,"_22543":41620,"_5":26803,"_10604":41465,"_1869":41621},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3805":718,"_26541":645,"_22543":41623,"_5":26803,"_10604":41469,"_1869":41624},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3805":719,"_26541":645,"_22543":41626,"_5":26803,"_10604":41473,"_1869":41627},[],"El estado debe cambiar a **REVOKED** y la CRL debe reflejar la nueva información. La CA deja de poder emitir certificados.",{"_3805":720,"_26541":645,"_22543":41629,"_5":26803,"_10604":41473,"_1869":41630},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3805":721,"_26541":721,"_5":26798,"_1869":41632,"_26811":41633,"_22543":41634,"_10604":721},"Perfiles de certificado",[39375,40459,40937],[],{"_3805":722,"_26541":721,"_22543":41636,"_5":26803,"_10604":721,"_1869":41637},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3805":723,"_26541":721,"_5":26808,"_22543":41639,"_10604":41640,"_1869":41641},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3805":724,"_26541":721,"_5":26808,"_22543":41643,"_10604":41644,"_1869":41645},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#validez","Validez",{"_3805":725,"_26541":721,"_5":26808,"_22543":41647,"_10604":41648,"_1869":41649},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3805":726,"_26541":721,"_5":26808,"_22543":41651,"_10604":41652,"_1869":41653},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3805":727,"_26541":721,"_5":26808,"_22543":41655,"_10604":41656,"_1869":41657},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3805":728,"_26541":721,"_5":26808,"_22543":41659,"_10604":41660,"_1869":41661},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3805":729,"_26541":721,"_5":26808,"_22543":41663,"_10604":41664,"_1869":41665},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3805":730,"_26541":721,"_5":26808,"_22543":41667,"_10604":41668,"_1869":41669},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3805":731,"_26541":721,"_5":26808,"_22543":41671,"_10604":41672,"_1869":41673},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3805":732,"_26541":721,"_5":26808,"_22543":41675,"_10604":41676,"_1869":41677},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3805":733,"_26541":721,"_5":26808,"_22543":41679,"_10604":41680,"_1869":41681},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3805":734,"_26541":721,"_5":26808,"_22543":41683,"_10604":41684,"_1869":41685},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3805":735,"_26541":721,"_5":26808,"_22543":41687,"_10604":41688,"_1869":41689},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3805":736,"_26541":721,"_5":26808,"_22543":41691,"_10604":41692,"_1869":41693},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3805":737,"_26541":721,"_5":26808,"_22543":41695,"_10604":41696,"_1869":41697},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3805":738,"_26541":721,"_5":26808,"_22543":41699,"_10604":41700,"_1869":41701},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3805":739,"_26541":721,"_22543":41703,"_5":26803,"_10604":721,"_1869":41704},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3805":740,"_26541":721,"_22543":41706,"_5":26803,"_10604":41644,"_1869":41707},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3805":741,"_26541":721,"_22543":41709,"_5":26803,"_10604":41644,"_1869":41710},[],"La fecha final nunca debe superar la de la CA emisora.",{"_3805":742,"_26541":721,"_22543":41712,"_5":26803,"_10604":41648,"_1869":41713},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3805":743,"_26541":721,"_22543":41715,"_5":26803,"_10604":41652,"_1869":41716},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3805":744,"_26541":721,"_22543":41718,"_5":26803,"_10604":41652,"_1869":41719},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3805":745,"_26541":721,"_22543":41721,"_5":26803,"_10604":41652,"_1869":41722},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3805":746,"_26541":721,"_22543":41724,"_5":26803,"_10604":41656,"_1869":41725},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3805":747,"_26541":721,"_22543":41727,"_5":26803,"_10604":41660,"_1869":41728},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3805":748,"_26541":721,"_22543":41730,"_5":26803,"_10604":41660,"_1869":41731},[],"Este comportamiento permite aceptar DNS, IP, correo o URI como identidades alternativas sin aceptar extensiones arbitrarias.",{"_3805":749,"_26541":721,"_22543":41733,"_5":26803,"_10604":41664,"_1869":41734},[],"La aplicación criptográfica puede:",{"_3805":750,"_26541":721,"_22543":41736,"_5":26803,"_10604":41664,"_1869":41737},[],"permitir o bloquear claves RSA;",{"_3805":751,"_26541":721,"_22543":41739,"_5":26803,"_10604":41664,"_1869":41740},[],"limitar los tamaños RSA admitidos;",{"_3805":752,"_26541":721,"_22543":41742,"_5":26803,"_10604":41664,"_1869":41743},[],"permitir o bloquear claves ECDSA;",{"_3805":753,"_26541":721,"_22543":41745,"_5":26803,"_10604":41664,"_1869":41746},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3805":754,"_26541":721,"_22543":41748,"_5":26803,"_10604":41664,"_1869":41749},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3805":755,"_26541":721,"_22543":41751,"_5":26803,"_10604":41668,"_1869":41752},[],"En operaciones que admiten varias fuentes, Lamassu resuelve el perfil en este orden:",{"_3805":756,"_26541":721,"_22543":41754,"_5":26803,"_10604":41668,"_1869":41755},[],"Perfil enviado dentro de la operación.",{"_3805":757,"_26541":721,"_22543":41757,"_5":26803,"_10604":41668,"_1869":41758},[],"Identificador de perfil enviado en la operación.",{"_3805":758,"_26541":721,"_22543":41760,"_5":26803,"_10604":41668,"_1869":41761},[],"Perfil predeterminado asociado a la CA.",{"_3805":759,"_26541":721,"_22543":41763,"_5":26803,"_10604":41668,"_1869":41764},[],"Un DMS también puede referenciar su propio perfil de emisión. De este modo, varias flotas pueden usar la misma CA con políticas distintas.",{"_3805":760,"_26541":721,"_22543":41766,"_5":26803,"_10604":41676,"_1869":41767},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3805":761,"_26541":721,"_22543":41769,"_5":26803,"_10604":41680,"_1869":41770},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3805":762,"_26541":721,"_22543":41772,"_5":26803,"_10604":41684,"_1869":41773},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3805":763,"_26541":721,"_22543":41775,"_5":26803,"_10604":41688,"_1869":41776},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3805":764,"_26541":721,"_22543":41778,"_5":26803,"_10604":41692,"_1869":41779},[],"Asocia el perfil a una CA o DMS. Emite un certificado de prueba y comprueba sujeto, SAN, KU, EKU, restricciones básicas y fechas con una herramienta X.509 independiente.",{"_3805":765,"_26541":721,"_22543":41781,"_5":26803,"_10604":41696,"_1869":41782},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3805":766,"_26541":721,"_22543":41784,"_5":26803,"_10604":41696,"_1869":41785},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3805":767,"_26541":721,"_22543":41787,"_5":26803,"_10604":41696,"_1869":41788},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3805":768,"_26541":721,"_22543":41790,"_5":26803,"_10604":41696,"_1869":41791},[],"Son patrones de partida, no una política universal. Verifica siempre los requisitos del protocolo, del consumidor y del marco regulatorio aplicable.",{"_3805":769,"_26541":721,"_22543":41793,"_5":26803,"_10604":41700,"_1869":41794},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3805":770,"_26541":721,"_22543":41796,"_5":26803,"_10604":41700,"_1869":41797},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3805":771,"_26541":771,"_5":26798,"_1869":41799,"_26811":41800,"_22543":41801,"_10604":771},"Validación de certificados",[39375,40459,40937],[],{"_3805":772,"_26541":771,"_22543":41803,"_5":26803,"_10604":771,"_1869":41804},[],"Publica el estado de las identidades mediante OCSP y CRL.",{"_3805":773,"_26541":771,"_5":26808,"_22543":41806,"_10604":41807,"_1869":41808},[],"/docs/pr-preview/pr-27/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3805":774,"_26541":771,"_22543":41810,"_5":26803,"_10604":771,"_1869":41811},[],"La emisión demuestra quién firmó un certificado; la validación permite saber si todavía debe aceptarse. Lamassu publica el estado mediante dos mecanismos complementarios.",{"_3805":775,"_26541":771,"_22543":41813,"_5":26803,"_10604":41807,"_1869":41814},[],"Usa **OCSP** cuando el consumidor esté conectado y necesite consultar el estado más reciente de un certificado concreto.",{"_3805":776,"_26541":771,"_22543":41816,"_5":26803,"_10604":41807,"_1869":41817},[],"Usa una **CRL** cuando la validación deba realizarse localmente, sin conexión o sobre un volumen elevado de certificados. El consumidor descarga periódicamente una lista firmada y la conserva hasta la siguiente actualización.",{"_3805":777,"_26541":771,"_22543":41819,"_5":26803,"_10604":41807,"_1869":41820},[],"Muchos entornos utilizan ambos: OCSP como comprobación primaria y CRL como mecanismo local o de respaldo.",{"_3805":778,"_26541":771,"_22543":41822,"_5":26803,"_10604":41807,"_1869":41823},[],"<Card title=\"Validación online con OCSP\" description=\"Consulta estados Good, Revoked y Unknown en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_3805":779,"_26541":771,"_22543":41825,"_5":26803,"_10604":41807,"_1869":41826},[],"<Card title=\"Listas de revocación\" description=\"Genera, publica y distribuye CRLs por autoridad.\" href=\"/docs/platform/pki/crl\" />",{"_3805":780,"_26541":780,"_5":26798,"_1869":41828,"_26811":41829,"_22543":41830,"_10604":780},"Certificados",[39375,40459,40937],[],{"_3805":781,"_26541":780,"_22543":41832,"_5":26803,"_10604":780,"_1869":41833},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3805":782,"_26541":780,"_5":26808,"_22543":41835,"_10604":41836,"_1869":41837},[],"/docs/pr-preview/pr-27/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3805":783,"_26541":780,"_5":26808,"_22543":41839,"_10604":41840,"_1869":41841},[],"/docs/pr-preview/pr-27/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3805":784,"_26541":780,"_5":26808,"_22543":41843,"_10604":41844,"_1869":41845},[],"/docs/pr-preview/pr-27/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3805":785,"_26541":780,"_5":26808,"_22543":41847,"_10604":41848,"_1869":41849},[],"/docs/pr-preview/pr-27/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3805":786,"_26541":780,"_5":26808,"_22543":41851,"_10604":41852,"_1869":41853},[],"/docs/pr-preview/pr-27/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3805":787,"_26541":780,"_5":26808,"_22543":41855,"_10604":41856,"_1869":41857},[],"/docs/pr-preview/pr-27/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3805":788,"_26541":780,"_5":26808,"_22543":41859,"_10604":41860,"_1869":41861},[],"/docs/pr-preview/pr-27/platform/pki/certificates#continúa","Continúa",{"_3805":789,"_26541":780,"_22543":41863,"_5":26803,"_10604":780,"_1869":41864},[],"El inventario de certificados ofrece una vista global de las identidades emitidas por todas las autoridades. También puedes abrir **Issued Certificates** dentro de una CA para limitar la vista a ese emisor.",{"_3805":790,"_26541":780,"_22543":41866,"_5":26803,"_10604":41836,"_1869":41867},[],"Abre **Certificates** y filtra por:",{"_3805":791,"_26541":780,"_22543":41869,"_5":26803,"_10604":41836,"_1869":41870},[],"`Common Name` del sujeto.",{"_3805":792,"_26541":780,"_22543":41872,"_5":26803,"_10604":41836,"_1869":41873},[],"Número de serie.",{"_3805":793,"_26541":780,"_22543":41875,"_5":26803,"_10604":41836,"_1869":41876},[],"Estado.",{"_3805":794,"_26541":780,"_22543":41878,"_5":26803,"_10604":41836,"_1869":41879},[],"Autoridad emisora.",{"_3805":795,"_26541":780,"_22543":41881,"_5":26803,"_10604":41836,"_1869":41882},[],"Utiliza **Quick Inspect** para una comprobación rápida o **View Details** para ver el sujeto, SANs, usos, cadena, periodo de validez y metadatos completos.",{"_3805":796,"_26541":780,"_22543":41884,"_5":26803,"_10604":41840,"_1869":41885},[],"La acción de descarga entrega el certificado en formato PEM. Si el certificado se emitió mediante un CSR externo, la clave privada permanece en el sistema que generó ese CSR. Si se generó en el navegador, la clave solo estuvo disponible al finalizar la emisión.",{"_3805":797,"_26541":780,"_22543":41887,"_5":26803,"_10604":41844,"_1869":41888},[],"Revoca una identidad cuando la clave se haya comprometido, el sujeto ya no esté autorizado o el certificado deba dejar de aceptarse antes de expirar.",{"_3805":798,"_26541":780,"_22543":41890,"_5":26803,"_10604":41848,"_1869":41891},[],"En el inventario o la vista de detalle, selecciona **Revoke Certificate**.",{"_3805":799,"_26541":780,"_22543":41893,"_5":26803,"_10604":41852,"_1869":41894},[],"Selecciona la razón que represente el incidente. Esta información se publica en OCSP y en la CRL.",{"_3805":800,"_26541":780,"_22543":41896,"_5":26803,"_10604":41856,"_1869":41897},[],"Confirma la operación y comprueba que el estado sea **Revoked**. Si la CA regenera la CRL al revocar, verifica también que exista una versión nueva.",{"_3805":801,"_26541":780,"_22543":41899,"_5":26803,"_10604":41856,"_1869":41900},[],"Una revocación con la razón `CertificateHold` puede reactivarse. Las demás razones producen una revocación definitiva.",{"_3805":802,"_26541":780,"_22543":41902,"_5":26803,"_10604":41860,"_1869":41903},[],"<Card title=\"Validar con OCSP\" description=\"Consulta el estado de un certificado en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_3805":803,"_26541":780,"_22543":41905,"_5":26803,"_10604":41860,"_1869":41906},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación offline.\" href=\"/docs/platform/pki/crl\" />",{"_3805":804,"_26541":804,"_5":26798,"_1869":41908,"_26811":41909,"_22543":41911,"_10604":804},"Arquitectura de la plataforma",[39375,40459,41910],"Conceptos",[],{"_3805":805,"_26541":804,"_22543":41913,"_5":26803,"_10604":804,"_1869":41914},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3805":806,"_26541":804,"_5":26808,"_22543":41916,"_10604":41917,"_1869":41918},[],"/docs/pr-preview/pr-27/platform/pki/concepts/architecture#plano-de-control","Plano de control",{"_3805":807,"_26541":804,"_5":26808,"_22543":41920,"_10604":41921,"_1869":41922},[],"/docs/pr-preview/pr-27/platform/pki/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3805":808,"_26541":804,"_5":26808,"_22543":41924,"_10604":41925,"_1869":41926},[],"/docs/pr-preview/pr-27/platform/pki/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3805":809,"_26541":804,"_5":26808,"_22543":41928,"_10604":41929,"_1869":41930},[],"/docs/pr-preview/pr-27/platform/pki/concepts/architecture#estado-y-validación","Estado y validación",{"_3805":810,"_26541":804,"_5":26808,"_22543":41932,"_10604":41933,"_1869":41934},[],"/docs/pr-preview/pr-27/platform/pki/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3805":811,"_26541":804,"_22543":41936,"_5":26803,"_10604":804,"_1869":41937},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3805":812,"_26541":804,"_22543":41939,"_5":26803,"_10604":41917,"_1869":41940},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3805":813,"_26541":804,"_22543":41942,"_5":26803,"_10604":41921,"_1869":41943},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3805":814,"_26541":804,"_22543":41945,"_5":26803,"_10604":41925,"_1869":41946},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3805":815,"_26541":804,"_22543":41948,"_5":26803,"_10604":41929,"_1869":41949},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3805":816,"_26541":804,"_22543":41951,"_5":26803,"_10604":41933,"_1869":41952},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3805":817,"_26541":817,"_5":26798,"_1869":41954,"_26811":41955,"_22543":41956,"_10604":817},"Ciclo de vida de un certificado",[39375,40459,41910],[],{"_3805":818,"_26541":817,"_22543":41958,"_5":26803,"_10604":817,"_1869":41959},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3805":819,"_26541":817,"_5":26808,"_22543":41961,"_10604":41962,"_1869":41963},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3805":820,"_26541":817,"_5":26808,"_22543":41965,"_10604":41966,"_1869":41967},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3805":821,"_26541":817,"_5":26808,"_22543":41969,"_10604":41970,"_1869":41971},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3805":822,"_26541":817,"_5":26808,"_22543":41973,"_10604":41974,"_1869":41975},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3805":823,"_26541":817,"_5":26808,"_22543":41977,"_10604":41978,"_1869":41979},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3805":824,"_26541":817,"_5":26808,"_22543":41981,"_10604":41982,"_1869":41983},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3805":825,"_26541":817,"_5":26808,"_22543":41985,"_10604":41986,"_1869":41987},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3805":826,"_26541":817,"_5":26808,"_22543":41989,"_10604":41990,"_1869":41991},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3805":827,"_26541":817,"_5":26808,"_22543":41993,"_10604":41994,"_1869":41995},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3805":828,"_26541":817,"_5":26808,"_22543":41997,"_10604":41998,"_1869":41999},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3805":829,"_26541":817,"_22543":42001,"_5":26803,"_10604":817,"_1869":42002},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3805":830,"_26541":817,"_22543":42004,"_5":26803,"_10604":41966,"_1869":42005},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3805":831,"_26541":817,"_22543":42007,"_5":26803,"_10604":41970,"_1869":42008},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3805":832,"_26541":817,"_22543":42010,"_5":26803,"_10604":41974,"_1869":42011},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3805":833,"_26541":817,"_22543":42013,"_5":26803,"_10604":41978,"_1869":42014},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3805":834,"_26541":817,"_22543":42016,"_5":26803,"_10604":41982,"_1869":42017},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3805":835,"_26541":817,"_22543":42019,"_5":26803,"_10604":41986,"_1869":42020},[],"Lamassu persiste cuatro estados X.509:",{"_3805":836,"_26541":817,"_22543":42022,"_5":26803,"_10604":41986,"_1869":42023},[],"**`ACTIVE`**: el certificado está habilitado y dentro de su periodo de validez.",{"_3805":837,"_26541":817,"_22543":42025,"_5":26803,"_10604":41986,"_1869":42026},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3805":838,"_26541":817,"_22543":42028,"_5":26803,"_10604":41986,"_1869":42029},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3805":839,"_26541":817,"_22543":42031,"_5":26803,"_10604":41986,"_1869":42032},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3805":840,"_26541":817,"_22543":42034,"_5":26803,"_10604":41986,"_1869":42035},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3805":841,"_26541":817,"_22543":42037,"_5":26803,"_10604":41990,"_1869":42038},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3805":842,"_26541":817,"_22543":42040,"_5":26803,"_10604":41990,"_1869":42041},[],"Solo una revocación con razón `CertificateHold` puede revertirse. Una revocación con cualquier otra razón es definitiva en Lamassu.",{"_3805":843,"_26541":817,"_22543":42043,"_5":26803,"_10604":41990,"_1869":42044},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3805":844,"_26541":817,"_22543":42046,"_5":26803,"_10604":41994,"_1869":42047},[],"Revocar una CA es una operación en cascada. Lamassu revoca sus CAs hijas y los certificados que ha emitido con la razón `CessationOfOperation`. La propagación continúa por la jerarquía.",{"_3805":845,"_26541":817,"_22543":42049,"_5":26803,"_10604":41994,"_1869":42050},[],"Antes de confirmar:",{"_3805":846,"_26541":817,"_22543":42052,"_5":26803,"_10604":41994,"_1869":42053},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3805":847,"_26541":817,"_22543":42055,"_5":26803,"_10604":41994,"_1869":42056},[],"Distribuye la nueva cadena de confianza.",{"_3805":848,"_26541":817,"_22543":42058,"_5":26803,"_10604":41994,"_1869":42059},[],"Reemite las identidades necesarias.",{"_3805":849,"_26541":817,"_22543":42061,"_5":26803,"_10604":41994,"_1869":42062},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3805":850,"_26541":817,"_22543":42064,"_5":26803,"_10604":41994,"_1869":42065},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3805":851,"_26541":817,"_22543":42067,"_5":26803,"_10604":41994,"_1869":42068},[],"Dar de baja un dispositivo revoca sus certificados y le impide obtener nuevas identidades. Utiliza esta acción únicamente cuando el dispositivo se retire de forma permanente.",{"_3805":852,"_26541":817,"_22543":42070,"_5":26803,"_10604":41998,"_1869":42071},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3805":853,"_26541":817,"_22543":42073,"_5":26803,"_10604":41998,"_1869":42074},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3805":854,"_26541":817,"_22543":42076,"_5":26803,"_10604":41998,"_1869":42077},[],"Cambios de estado y razones de revocación.",{"_3805":855,"_26541":817,"_22543":42079,"_5":26803,"_10604":41998,"_1869":42080},[],"Publicación y vigencia de OCSP y CRLs.",{"_3805":856,"_26541":817,"_22543":42082,"_5":26803,"_10604":41998,"_1869":42083},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3805":857,"_26541":817,"_22543":42085,"_5":26803,"_10604":41998,"_1869":42086},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3805":858,"_26541":858,"_5":26798,"_1869":42088,"_26811":42089,"_22543":42090,"_10604":858},"Glosario",[39375,40459,41910],[],{"_3805":859,"_26541":858,"_22543":42092,"_5":26803,"_10604":858,"_1869":42093},[],"Términos de PKI, certificados y gestión de identidades usados en Lamassu.",{"_3805":860,"_26541":858,"_5":26808,"_22543":42095,"_10604":42096,"_1869":42097},[],"/docs/pr-preview/pr-27/platform/pki/concepts/glossary#ac","A–C",{"_3805":861,"_26541":858,"_5":26808,"_22543":42099,"_10604":42100,"_1869":42101},[],"/docs/pr-preview/pr-27/platform/pki/concepts/glossary#dk","D–K",{"_3805":862,"_26541":858,"_5":26808,"_22543":42103,"_10604":42104,"_1869":42105},[],"/docs/pr-preview/pr-27/platform/pki/concepts/glossary#mr","M–R",{"_3805":863,"_26541":858,"_5":26808,"_22543":42107,"_10604":42108,"_1869":42109},[],"/docs/pr-preview/pr-27/platform/pki/concepts/glossary#sz","S–Z",{"_3805":864,"_26541":858,"_22543":42111,"_5":26803,"_10604":42096,"_1869":42112},[],"**AKI (Authority Key Identifier)**\\\nIdentificador de la clave pública de la autoridad que firmó un certificado. Ayuda a construir la cadena hacia el emisor correcto.",{"_3805":865,"_26541":858,"_22543":42114,"_5":26803,"_10604":42096,"_1869":42115},[],"**Ancla de confianza**\\\nCertificado, normalmente de una CA raíz, que un consumidor acepta de forma explícita como punto final de una cadena.",{"_3805":866,"_26541":858,"_22543":42117,"_5":26803,"_10604":42096,"_1869":42118},[],"**CA (Certification Authority)**\\\nAutoridad que firma certificados y vincula una identidad con una clave pública.",{"_3805":867,"_26541":858,"_22543":42120,"_5":26803,"_10604":42096,"_1869":42121},[],"**CA intermedia**\\\nCA firmada por otra autoridad. Se utiliza para emitir sin exponer la raíz a la operación diaria.",{"_3805":868,"_26541":858,"_22543":42123,"_5":26803,"_10604":42096,"_1869":42124},[],"**CA raíz**\\\nCA autofirmada que inicia una jerarquía de confianza.",{"_3805":869,"_26541":858,"_22543":42126,"_5":26803,"_10604":42096,"_1869":42127},[],"**Certificado X.509**\\\nDocumento firmado que contiene una clave pública, un sujeto, un emisor, un periodo de validez y extensiones que delimitan su uso.",{"_3805":870,"_26541":858,"_22543":42129,"_5":26803,"_10604":42096,"_1869":42130},[],"**CRL (Certificate Revocation List)**\\\nLista firmada de certificados revocados publicada por una CA.",{"_3805":871,"_26541":858,"_22543":42132,"_5":26803,"_10604":42096,"_1869":42133},[],"**CSR (Certificate Signing Request)**\\\nSolicitud PKCS#10 que contiene una clave pública y atributos solicitados. La firma de la CSR demuestra posesión de la clave privada correspondiente.",{"_3805":872,"_26541":858,"_22543":42135,"_5":26803,"_10604":42100,"_1869":42136},[],"**DMS (Device Management Service)**\\\nConfiguración que agrupa reglas de registro, enrolamiento, re-enrolamiento, emisión y distribución de CAs para una flota.",{"_3805":873,"_26541":858,"_22543":42138,"_5":26803,"_10604":42100,"_1869":42139},[],"**Distinguished Name (DN)**\\\nConjunto de atributos del sujeto o emisor, como `CN`, `O`, `OU`, `C`, `ST` y `L`.",{"_3805":874,"_26541":858,"_22543":42141,"_5":26803,"_10604":42100,"_1869":42142},[],"**EST (Enrollment over Secure Transport)**\\\nProtocolo definido en RFC 7030 para obtener CAs, enrolar y re-enrolar certificados sobre HTTPS.",{"_3805":875,"_26541":858,"_22543":42144,"_5":26803,"_10604":42100,"_1869":42145},[],"**Extended Key Usage (EKU)**\\\nExtensión que acota finalidades como autenticación de cliente, autenticación de servidor, firma de código u OCSP.",{"_3805":876,"_26541":858,"_22543":42147,"_5":26803,"_10604":42100,"_1869":42148},[],"**Identidad de dispositivo**\\\nRelación entre un dispositivo y uno de sus certificados. Un dispositivo puede conservar un historial de identidades.",{"_3805":877,"_26541":858,"_22543":42150,"_5":26803,"_10604":42100,"_1869":42151},[],"**Identity slot**\\\nPosición lógica en un dispositivo donde Lamassu vincula una identidad activa o histórica.",{"_3805":878,"_26541":858,"_22543":42153,"_5":26803,"_10604":42100,"_1869":42154},[],"**JITP (Just-in-Time Provisioning)**\\\nRegistro automático de un dispositivo cuando completa correctamente su primer enrolamiento.",{"_3805":879,"_26541":858,"_22543":42156,"_5":26803,"_10604":42100,"_1869":42157},[],"**KMS (Key Management Service)**\\\nServicio de Lamassu que normaliza generación, importación y uso de claves sobre distintos motores criptográficos.",{"_3805":880,"_26541":858,"_22543":42159,"_5":26803,"_10604":42100,"_1869":42160},[],"**Key Usage**\\\nExtensión X.509 que permite operaciones básicas como firma digital, cifrado de clave o firma de certificados.",{"_3805":881,"_26541":858,"_22543":42162,"_5":26803,"_10604":42104,"_1869":42163},[],"**mTLS (Mutual TLS)**\\\nTLS donde cliente y servidor presentan certificados. Un DMS puede usar el certificado cliente como método de autenticación.",{"_3805":882,"_26541":858,"_22543":42165,"_5":26803,"_10604":42104,"_1869":42166},[],"**OCSP (Online Certificate Status Protocol)**\\\nProtocolo para consultar en línea si un certificado está vigente, revocado o es desconocido.",{"_3805":883,"_26541":858,"_22543":42168,"_5":26803,"_10604":42104,"_1869":42169},[],"**Perfil de emisión**\\\nPolítica reutilizable que define cómo Lamassu construye un certificado y qué claves acepta.",{"_3805":884,"_26541":858,"_22543":42171,"_5":26803,"_10604":42104,"_1869":42172},[],"**Principal**\\\nIdentidad de operador o cliente de API reconocida por el servicio de autorización. Lamassu admite principales OIDC y X.509.",{"_3805":885,"_26541":858,"_22543":42174,"_5":26803,"_10604":42104,"_1869":42175},[],"**Política**\\\nConjunto de permisos asignable a uno o varios principales.",{"_3805":886,"_26541":858,"_22543":42177,"_5":26803,"_10604":42104,"_1869":42178},[],"**RA (Registration Authority)**\\\nComponente que verifica al solicitante antes de pedir a una CA que emita. El DMS cumple este papel en los flujos de enrolamiento de dispositivos.",{"_3805":887,"_26541":858,"_22543":42180,"_5":26803,"_10604":42104,"_1869":42181},[],"**Relying party**\\\nSistema consumidor que decide si acepta un certificado presentado.",{"_3805":888,"_26541":858,"_22543":42183,"_5":26803,"_10604":42104,"_1869":42184},[],"**Revocación**\\\nInvalidación de un certificado antes de su fecha de expiración.",{"_3805":889,"_26541":858,"_22543":42186,"_5":26803,"_10604":42108,"_1869":42187},[],"**SAN (Subject Alternative Name)**\\\nExtensión que añade identidades como nombres DNS, direcciones IP, correos o URIs.",{"_3805":890,"_26541":858,"_22543":42189,"_5":26803,"_10604":42108,"_1869":42190},[],"**SKI (Subject Key Identifier)**\\\nIdentificador derivado de la clave pública del propio certificado.",{"_3805":891,"_26541":858,"_22543":42192,"_5":26803,"_10604":42108,"_1869":42193},[],"**VA (Validation Authority)**\\\nServicio de Lamassu responsable de las respuestas OCSP y la generación o publicación de CRLs.",{"_3805":892,"_26541":858,"_22543":42195,"_5":26803,"_10604":42108,"_1869":42196},[],"**Ventana de renovación**\\\nPeriodo anterior a la expiración durante el que un dispositivo puede o debe solicitar otra identidad.",{"_3805":893,"_26541":858,"_22543":42198,"_5":26803,"_10604":42108,"_1869":42199},[],"¿Falta un término operativo? Consulta primero Cómo funciona Lamassu y el Modelo de confianza, donde estos conceptos aparecen conectados.",{"_3805":894,"_26541":894,"_5":26798,"_1869":42201,"_26811":42202,"_22543":42203,"_10604":894},"Cómo funciona Lamassu",[39375,40459,41910],[],{"_3805":895,"_26541":894,"_22543":42205,"_5":26803,"_10604":894,"_1869":42206},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3805":896,"_26541":894,"_5":26808,"_22543":42208,"_10604":42209,"_1869":42210},[],"/docs/pr-preview/pr-27/platform/pki/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3805":897,"_26541":894,"_5":26808,"_22543":42212,"_10604":42213,"_1869":42214},[],"/docs/pr-preview/pr-27/platform/pki/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3805":898,"_26541":894,"_22543":42216,"_5":26803,"_10604":894,"_1869":42217},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3805":899,"_26541":894,"_22543":42219,"_5":26803,"_10604":42209,"_1869":42220},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3805":900,"_26541":894,"_22543":42222,"_5":26803,"_10604":42209,"_1869":42223},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3805":901,"_26541":894,"_22543":42225,"_5":26803,"_10604":42209,"_1869":42226},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3805":902,"_26541":894,"_22543":42228,"_5":26803,"_10604":42209,"_1869":42229},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3805":903,"_26541":894,"_22543":42231,"_5":26803,"_10604":42209,"_1869":42232},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3805":904,"_26541":894,"_22543":42234,"_5":26803,"_10604":42213,"_1869":42235},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3805":905,"_26541":894,"_22543":42237,"_5":26803,"_10604":42213,"_1869":42238},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3805":906,"_26541":894,"_22543":42240,"_5":26803,"_10604":42213,"_1869":42241},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3805":907,"_26541":894,"_22543":42243,"_5":26803,"_10604":42213,"_1869":42244},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3805":908,"_26541":894,"_22543":42246,"_5":26803,"_10604":42213,"_1869":42247},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3805":909,"_26541":894,"_22543":42249,"_5":26803,"_10604":42213,"_1869":42250},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/pki/concepts/architecture\" />",{"_3805":910,"_26541":894,"_22543":42252,"_5":26803,"_10604":42213,"_1869":42253},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3805":911,"_26541":911,"_5":26798,"_1869":42255,"_26811":42256,"_22543":42257,"_10604":911},"Modelo de confianza",[39375,40459,41910],[],{"_3805":912,"_26541":911,"_22543":42259,"_5":26803,"_10604":911,"_1869":42260},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3805":913,"_26541":911,"_5":26808,"_22543":42262,"_10604":42263,"_1869":42264},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3805":914,"_26541":911,"_5":26808,"_22543":42266,"_10604":42267,"_1869":42268},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3805":915,"_26541":911,"_5":26808,"_22543":42270,"_10604":42271,"_1869":42272},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3805":916,"_26541":911,"_5":26808,"_22543":42274,"_10604":42275,"_1869":42276},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3805":917,"_26541":911,"_5":26808,"_22543":42278,"_10604":42279,"_1869":42280},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3805":918,"_26541":911,"_5":26808,"_22543":42282,"_10604":42283,"_1869":42284},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3805":919,"_26541":911,"_5":26808,"_22543":42286,"_10604":42287,"_1869":42288},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3805":920,"_26541":911,"_5":26808,"_22543":42290,"_10604":42291,"_1869":42292},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3805":921,"_26541":911,"_5":26808,"_22543":42294,"_10604":42295,"_1869":42296},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3805":922,"_26541":911,"_5":26808,"_22543":42298,"_10604":42299,"_1869":42300},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3805":923,"_26541":911,"_22543":42302,"_5":26803,"_10604":911,"_1869":42303},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3805":924,"_26541":911,"_22543":42305,"_5":26803,"_10604":42267,"_1869":42306},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3805":925,"_26541":911,"_22543":42308,"_5":26803,"_10604":42271,"_1869":42309},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3805":926,"_26541":911,"_22543":42311,"_5":26803,"_10604":42275,"_1869":42312},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3805":927,"_26541":911,"_22543":42314,"_5":26803,"_10604":42279,"_1869":42315},[],"El servicio o dispositivo consumidor mantiene su propio almacén de confianza. Lamassu puede distribuir la CA del sistema, la CA de enrolamiento y otras CAs gestionadas mediante `/cacerts`, pero el consumidor decide cuáles instala y cómo aplica la validación.",{"_3805":928,"_26541":911,"_22543":42317,"_5":26803,"_10604":42283,"_1869":42318},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3805":929,"_26541":911,"_22543":42320,"_5":26803,"_10604":42283,"_1869":42321},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3805":930,"_26541":911,"_22543":42323,"_5":26803,"_10604":42283,"_1869":42324},[],"La CA aplica el perfil y firma sin recibir la clave privada del dispositivo.",{"_3805":931,"_26541":911,"_22543":42326,"_5":26803,"_10604":42283,"_1869":42327},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3805":932,"_26541":911,"_22543":42329,"_5":26803,"_10604":42283,"_1869":42330},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3805":933,"_26541":911,"_22543":42332,"_5":26803,"_10604":42283,"_1869":42333},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3805":934,"_26541":911,"_22543":42335,"_5":26803,"_10604":42287,"_1869":42336},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3805":935,"_26541":911,"_22543":42338,"_5":26803,"_10604":42287,"_1869":42339},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3805":936,"_26541":911,"_22543":42341,"_5":26803,"_10604":42287,"_1869":42342},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_3805":937,"_26541":911,"_22543":42344,"_5":26803,"_10604":42287,"_1869":42345},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir la CA del sistema, la CA de enrolamiento y una lista de CAs gestionadas.",{"_3805":938,"_26541":911,"_22543":42347,"_5":26803,"_10604":42287,"_1869":42348},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3805":939,"_26541":911,"_22543":42350,"_5":26803,"_10604":42291,"_1869":42351},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3805":940,"_26541":911,"_22543":42353,"_5":26803,"_10604":42291,"_1869":42354},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3805":941,"_26541":911,"_22543":42356,"_5":26803,"_10604":42291,"_1869":42357},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3805":942,"_26541":911,"_22543":42359,"_5":26803,"_10604":42291,"_1869":42360},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3805":943,"_26541":911,"_22543":42362,"_5":26803,"_10604":42291,"_1869":42363},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3805":944,"_26541":911,"_22543":42365,"_5":26803,"_10604":42291,"_1869":42366},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3805":945,"_26541":911,"_22543":42368,"_5":26803,"_10604":42295,"_1869":42369},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3805":946,"_26541":911,"_22543":42371,"_5":26803,"_10604":42299,"_1869":42372},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3805":947,"_26541":911,"_22543":42374,"_5":26803,"_10604":42299,"_1869":42375},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3805":948,"_26541":911,"_22543":42377,"_5":26803,"_10604":42299,"_1869":42378},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3805":949,"_26541":911,"_22543":42380,"_5":26803,"_10604":42299,"_1869":42381},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3805":950,"_26541":911,"_22543":42383,"_5":26803,"_10604":42299,"_1869":42384},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3805":951,"_26541":911,"_22543":42386,"_5":26803,"_10604":42299,"_1869":42387},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3805":952,"_26541":911,"_22543":42389,"_5":26803,"_10604":42299,"_1869":42390},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3805":953,"_26541":953,"_5":26798,"_1869":42392,"_26811":42393,"_22543":42394,"_10604":953},"Listas de revocación (CRL)",[39375,40459,40937],[],{"_3805":954,"_26541":953,"_22543":42396,"_5":26803,"_10604":953,"_1869":42397},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3805":955,"_26541":953,"_5":26808,"_22543":42399,"_10604":42400,"_1869":42401},[],"/docs/pr-preview/pr-27/platform/pki/crl#servicio-crl","Servicio CRL",{"_3805":956,"_26541":953,"_5":26808,"_22543":42403,"_10604":42404,"_1869":42405},[],"/docs/pr-preview/pr-27/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3805":957,"_26541":953,"_5":26808,"_22543":42407,"_10604":42408,"_1869":42409},[],"/docs/pr-preview/pr-27/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3805":958,"_26541":953,"_5":26808,"_22543":42411,"_10604":42412,"_1869":42413},[],"/docs/pr-preview/pr-27/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3805":959,"_26541":953,"_5":26808,"_22543":42415,"_10604":42416,"_1869":42417},[],"/docs/pr-preview/pr-27/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3805":960,"_26541":953,"_5":26808,"_22543":42419,"_10604":42420,"_1869":42421},[],"/docs/pr-preview/pr-27/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3805":961,"_26541":953,"_5":26808,"_22543":42423,"_10604":42424,"_1869":42425},[],"/docs/pr-preview/pr-27/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3805":962,"_26541":953,"_5":26808,"_22543":42427,"_10604":42428,"_1869":42429},[],"/docs/pr-preview/pr-27/platform/pki/crl#referencias","Referencias",{"_3805":963,"_26541":953,"_22543":42431,"_5":26803,"_10604":42400,"_1869":42432},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_3805":964,"_26541":953,"_22543":42434,"_5":26803,"_10604":42400,"_1869":42435},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_3805":965,"_26541":953,"_22543":42437,"_5":26803,"_10604":42404,"_1869":42438},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_3805":966,"_26541":953,"_22543":42440,"_5":26803,"_10604":42404,"_1869":42441},[],"Los parámetros principales son:",{"_3805":967,"_26541":953,"_22543":42443,"_5":26803,"_10604":42404,"_1869":42444},[],"**`validity`** define el periodo de validez reflejado en `nextUpdate`. Su valor predeterminado es 7 días.",{"_3805":968,"_26541":953,"_22543":42446,"_5":26803,"_10604":42404,"_1869":42447},[],"**`refresh_interval`** establece el intervalo mínimo entre regeneraciones programadas. Por defecto es aproximadamente 6 días y 23 horas.",{"_3805":969,"_26541":953,"_22543":42449,"_5":26803,"_10604":42404,"_1869":42450},[],"**`regenerate_on_revoke`** ordena publicar una versión nueva inmediatamente después de una revocación. Está activo por defecto.",{"_3805":970,"_26541":953,"_22543":42452,"_5":26803,"_10604":42404,"_1869":42453},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_3805":971,"_26541":953,"_22543":42455,"_5":26803,"_10604":42404,"_1869":42456},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_3805":972,"_26541":953,"_22543":42458,"_5":26803,"_10604":42408,"_1869":42459},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_3805":973,"_26541":953,"_22543":42461,"_5":26803,"_10604":42408,"_1869":42462},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_3805":974,"_26541":953,"_22543":42464,"_5":26803,"_10604":42412,"_1869":42465},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_3805":975,"_26541":953,"_22543":42467,"_5":26803,"_10604":42412,"_1869":42468},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_3805":976,"_26541":953,"_22543":42470,"_5":26803,"_10604":42416,"_1869":42471},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_3805":977,"_26541":953,"_22543":42473,"_5":26803,"_10604":42416,"_1869":42474},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_3805":978,"_26541":953,"_22543":42476,"_5":26803,"_10604":42420,"_1869":42477},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_3805":979,"_26541":953,"_22543":42479,"_5":26803,"_10604":42420,"_1869":42480},[],"Método",{"_3805":980,"_26541":953,"_22543":42482,"_5":26803,"_10604":42420,"_1869":42483},[],"Ruta",{"_3805":981,"_26541":953,"_22543":42485,"_5":26803,"_10604":42420,"_1869":39746},[],{"_3805":982,"_26541":953,"_22543":42487,"_5":26803,"_10604":42420,"_1869":42488},[],"`GET`",{"_3805":983,"_26541":953,"_22543":42490,"_5":26803,"_10604":42420,"_1869":42491},[],"`/v1/roles/{ca-ski}`",{"_3805":984,"_26541":953,"_22543":42493,"_5":26803,"_10604":42420,"_1869":42494},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_3805":985,"_26541":953,"_22543":42496,"_5":26803,"_10604":42420,"_1869":42497},[],"`PUT`",{"_3805":986,"_26541":953,"_22543":42499,"_5":26803,"_10604":42420,"_1869":42491},[],{"_3805":987,"_26541":953,"_22543":42501,"_5":26803,"_10604":42420,"_1869":42502},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_3805":988,"_26541":953,"_22543":42504,"_5":26803,"_10604":42420,"_1869":42505},[],"Ejemplo de consulta del rol VA:",{"_3805":989,"_26541":953,"_22543":42507,"_5":26803,"_10604":42420,"_1869":42508},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_3805":990,"_26541":953,"_22543":42510,"_5":26803,"_10604":42424,"_1869":42511},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_3805":991,"_26541":953,"_22543":42513,"_5":26803,"_10604":42428,"_1869":42514},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_3805":992,"_26541":953,"_22543":42516,"_5":26803,"_10604":42428,"_1869":42517},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3805":993,"_26541":953,"_22543":42519,"_5":26803,"_10604":42428,"_1869":42520},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3805":994,"_26541":994,"_5":26798,"_1869":42522,"_26811":42523,"_22543":42524,"_10604":994},"Device Management Service",[39375,40459,40937],[],{"_3805":995,"_26541":994,"_22543":42526,"_5":26803,"_10604":994,"_1869":42527},[],"Define cómo una flota recibe, renueva y utiliza sus identidades.",{"_3805":996,"_26541":994,"_5":26808,"_22543":42529,"_10604":42530,"_1869":39385},[],"/docs/pr-preview/pr-27/platform/pki/device-enrollment#antes-de-empezar",{"_3805":997,"_26541":994,"_5":26808,"_22543":42532,"_10604":42533,"_1869":42534},[],"/docs/pr-preview/pr-27/platform/pki/device-enrollment#configura-un-dms","Configura un DMS",{"_3805":998,"_26541":994,"_5":26808,"_22543":42536,"_10604":42537,"_1869":42538},[],"/docs/pr-preview/pr-27/platform/pki/device-enrollment#identifica-la-flota","Identifica la flota",{"_3805":999,"_26541":994,"_5":26808,"_22543":42540,"_10604":42541,"_1869":42542},[],"/docs/pr-preview/pr-27/platform/pki/device-enrollment#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3805":1000,"_26541":994,"_5":26808,"_22543":42544,"_10604":42545,"_1869":42546},[],"/docs/pr-preview/pr-27/platform/pki/device-enrollment#configura-est","Configura EST",{"_3805":1001,"_26541":994,"_5":26808,"_22543":42548,"_10604":42549,"_1869":42550},[],"/docs/pr-preview/pr-27/platform/pki/device-enrollment#distribuye-la-confianza","Distribuye la confianza",{"_3805":1002,"_26541":994,"_5":26808,"_22543":42552,"_10604":42553,"_1869":42554},[],"/docs/pr-preview/pr-27/platform/pki/device-enrollment#verifica-los-endpoints","Verifica los endpoints",{"_3805":1003,"_26541":994,"_5":26808,"_22543":42556,"_10604":42557,"_1869":42558},[],"/docs/pr-preview/pr-27/platform/pki/device-enrollment#distribución-de-confianza","Distribución de confianza",{"_3805":1004,"_26541":994,"_5":26808,"_22543":42560,"_10604":42561,"_1869":42562},[],"/docs/pr-preview/pr-27/platform/pki/device-enrollment#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3805":1005,"_26541":994,"_5":26808,"_22543":42564,"_10604":42565,"_1869":42566},[],"/docs/pr-preview/pr-27/platform/pki/device-enrollment#integra-los-dispositivos","Integra los dispositivos",{"_3805":1006,"_26541":994,"_22543":42568,"_5":26803,"_10604":994,"_1869":42569},[],"Un &#x2A;*Device Management Service (DMS)** actúa como autoridad de registro frente a una flota. Recibe solicitudes, aplica la política de autenticación y encarga la emisión a la CA configurada.",{"_3805":1007,"_26541":994,"_22543":42571,"_5":26803,"_10604":994,"_1869":42572},[],"Cada DMS es un límite operativo independiente: puede representar una línea de producto, un entorno o un tipo de dispositivo con su propia CA, reglas de autenticación, confianza distribuida y ventana de renovación.",{"_3805":1008,"_26541":994,"_22543":42574,"_5":26803,"_10604":42530,"_1869":42575},[],"Crea o importa al menos una CA activa.",{"_3805":1009,"_26541":994,"_22543":42577,"_5":26803,"_10604":42530,"_1869":42578},[],"Decide cómo se autenticarán los dispositivos durante el primer enrolamiento.",{"_3805":1010,"_26541":994,"_22543":42580,"_5":26803,"_10604":42530,"_1869":42581},[],"Define qué autoridades debe recibir el dispositivo como anclas de confianza.",{"_3805":1011,"_26541":994,"_22543":42583,"_5":26803,"_10604":42530,"_1869":42584},[],"Asegúrate de tener permisos para administrar DMS.",{"_3805":1012,"_26541":994,"_22543":42586,"_5":26803,"_10604":42537,"_1869":42587},[],"Asigna al DMS un nombre que describa su alcance, por ejemplo una familia de dispositivos o un entorno.",{"_3805":1013,"_26541":994,"_22543":42589,"_5":26803,"_10604":42541,"_1869":42590},[],"Elige la autoridad que emitirá las identidades. Su política y periodo de validez condicionan los certificados que podrá obtener la flota.",{"_3805":1014,"_26541":994,"_22543":42592,"_5":26803,"_10604":42545,"_1869":42593},[],"Define la autenticación de `enroll`, la política de `reenroll`, la ventana de renovación y, si se necesita, `serverkeygen`.",{"_3805":1015,"_26541":994,"_22543":42595,"_5":26803,"_10604":42549,"_1869":42596},[],"Configura **CA Distribution** para controlar la respuesta del endpoint `cacerts`.",{"_3805":1016,"_26541":994,"_22543":42598,"_5":26803,"_10604":42553,"_1869":42599},[],"Desde el menú del DMS, abre &#x2A;*EST (RFC-7030)** y comprueba la URL base y los ejemplos de invocación antes de integrar el firmware.",{"_3805":1017,"_26541":994,"_22543":42601,"_5":26803,"_10604":42557,"_1869":42602},[],"**Include Lamassu System CA** distribuye el certificado TLS del servidor Lamassu, útil para *pinning*. No representa una CA de emisión.",{"_3805":1018,"_26541":994,"_22543":42604,"_5":26803,"_10604":42557,"_1869":42605},[],"**Include Enrollment CA** añade la autoridad configurada para emitir las identidades del DMS.",{"_3805":1019,"_26541":994,"_22543":42607,"_5":26803,"_10604":42557,"_1869":42608},[],"**Managed CAs** permite incluir autoridades adicionales que el dispositivo debe considerar de confianza.",{"_3805":1020,"_26541":994,"_22543":42610,"_5":26803,"_10604":42561,"_1869":42611},[],"**Edit** modifica la política del DMS.",{"_3805":1021,"_26541":994,"_22543":42613,"_5":26803,"_10604":42561,"_1869":42614},[],"**Go to DMS owned devices** abre únicamente los dispositivos de esa flota.",{"_3805":1022,"_26541":994,"_22543":42616,"_5":26803,"_10604":42561,"_1869":42617},[],"**Show/Edit Metadata** permite gestionar configuración avanzada y datos de integraciones.",{"_3805":1023,"_26541":994,"_22543":42619,"_5":26803,"_10604":42561,"_1869":42620},[],"**EST (RFC-7030)** muestra los endpoints y ejemplos específicos del DMS.",{"_3805":1024,"_26541":994,"_22543":42622,"_5":26803,"_10604":42561,"_1869":42623},[],"**Delete** elimina el DMS y su configuración. La acción es irreversible.",{"_3805":1025,"_26541":994,"_22543":42625,"_5":26803,"_10604":42565,"_1869":42626},[],"<Card title=\"Enrolamiento EST\" description=\"Configura autenticación, endpoints y flujos para firmware.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_3805":1026,"_26541":994,"_22543":42628,"_5":26803,"_10604":42565,"_1869":42629},[],"<Card title=\"Dispositivos e identidades\" description=\"Consulta estados, historial y acciones operativas.\" href=\"/docs/platform/pki/device-management\" />",{"_3805":1027,"_26541":1027,"_5":26798,"_1869":42631,"_26811":42632,"_22543":42633,"_10604":1027},"Dispositivos e identidades",[39375,40459,40937],[],{"_3805":1028,"_26541":1027,"_22543":42635,"_5":26803,"_10604":1027,"_1869":42636},[],"Registra dispositivos y controla sus identidades durante todo el ciclo de vida.",{"_3805":1029,"_26541":1027,"_5":26808,"_22543":42638,"_10604":42639,"_1869":42640},[],"/docs/pr-preview/pr-27/platform/pki/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3805":1030,"_26541":1027,"_5":26808,"_22543":42642,"_10604":42643,"_1869":42644},[],"/docs/pr-preview/pr-27/platform/pki/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3805":1031,"_26541":1027,"_5":26808,"_22543":42646,"_10604":42647,"_1869":42648},[],"/docs/pr-preview/pr-27/platform/pki/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3805":1032,"_26541":1027,"_5":26808,"_22543":42650,"_10604":42651,"_1869":42652},[],"/docs/pr-preview/pr-27/platform/pki/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3805":1033,"_26541":1027,"_5":26808,"_22543":42654,"_10604":42655,"_1869":42656},[],"/docs/pr-preview/pr-27/platform/pki/device-management#define-su-pertenencia","Define su pertenencia",{"_3805":1034,"_26541":1027,"_5":26808,"_22543":42658,"_10604":42659,"_1869":42660},[],"/docs/pr-preview/pr-27/platform/pki/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3805":1035,"_26541":1027,"_5":26808,"_22543":42662,"_10604":42663,"_1869":42664},[],"/docs/pr-preview/pr-27/platform/pki/device-management#verifica-el-alta","Verifica el alta",{"_3805":1036,"_26541":1027,"_5":26808,"_22543":42666,"_10604":42667,"_1869":42668},[],"/docs/pr-preview/pr-27/platform/pki/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3805":1037,"_26541":1027,"_5":26808,"_22543":42670,"_10604":42671,"_1869":42672},[],"/docs/pr-preview/pr-27/platform/pki/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3805":1038,"_26541":1027,"_5":26808,"_22543":42674,"_10604":42675,"_1869":42676},[],"/docs/pr-preview/pr-27/platform/pki/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3805":1039,"_26541":1027,"_5":26808,"_22543":42678,"_10604":42679,"_1869":42680},[],"/docs/pr-preview/pr-27/platform/pki/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3805":1040,"_26541":1027,"_22543":42682,"_5":26803,"_10604":1027,"_1869":42683},[],"Un dispositivo gestionado representa una entidad de tu flota y conserva el historial de los certificados que ha utilizado. Lamassu separa el dispositivo de su identidad actual para que puedas renovar o sustituir certificados sin perder trazabilidad.",{"_3805":1041,"_26541":1027,"_22543":42685,"_5":26803,"_10604":42639,"_1869":42686},[],"**Active** indica que el dispositivo tiene una identidad válida.",{"_3805":1042,"_26541":1027,"_22543":42688,"_5":26803,"_10604":42639,"_1869":42689},[],"**No Identity** aparece cuando está registrado, pero todavía no tiene un certificado asociado.",{"_3805":1043,"_26541":1027,"_22543":42691,"_5":26803,"_10604":42639,"_1869":42692},[],"**Renewal Pending** señala que ha entrado en la ventana de renovación.",{"_3805":1044,"_26541":1027,"_22543":42694,"_5":26803,"_10604":42639,"_1869":42695},[],"**Expiring Soon** advierte que el certificado está próximo a expirar.",{"_3805":1045,"_26541":1027,"_22543":42697,"_5":26803,"_10604":42639,"_1869":42698},[],"**Expired** indica que la identidad ha superado su fecha de validez.",{"_3805":1046,"_26541":1027,"_22543":42700,"_5":26803,"_10604":42639,"_1869":42701},[],"**Revoked** identifica un certificado invalidado antes de su expiración.",{"_3805":1047,"_26541":1027,"_22543":42703,"_5":26803,"_10604":42639,"_1869":42704},[],"**Decommissioned** corresponde a un dispositivo retirado de forma permanente.",{"_3805":1048,"_26541":1027,"_22543":42706,"_5":26803,"_10604":42639,"_1869":42707},[],"El inventario permite filtrar por `Device ID`, etiquetas y estado.",{"_3805":1049,"_26541":1027,"_22543":42709,"_5":26803,"_10604":42643,"_1869":42710},[],"La vista de detalle separa dos perspectivas:",{"_3805":1050,"_26541":1027,"_22543":42712,"_5":26803,"_10604":42643,"_1869":42713},[],"**Certificate History** conserva todos los certificados asociados, con su número de serie, emisor, estado y periodo de validez.",{"_3805":1051,"_26541":1027,"_22543":42715,"_5":26803,"_10604":42643,"_1869":42716},[],"**Device Event Timeline** ordena cronológicamente registros, enrolamientos, renovaciones y cambios de estado.",{"_3805":1052,"_26541":1027,"_22543":42718,"_5":26803,"_10604":42643,"_1869":42719},[],"Utiliza el historial para auditoría y la línea de tiempo para reconstruir un incidente o diagnosticar una transición inesperada.",{"_3805":1053,"_26541":1027,"_22543":42721,"_5":26803,"_10604":42647,"_1869":42722},[],"El registro previo es útil cuando la política exige que el dispositivo exista antes de solicitar su primer certificado.",{"_3805":1054,"_26541":1027,"_22543":42724,"_5":26803,"_10604":42651,"_1869":42725},[],"Desde **Managed Devices**, abre el formulario de registro.",{"_3805":1055,"_26541":1027,"_22543":42727,"_5":26803,"_10604":42655,"_1869":42728},[],"Introduce un **Device ID** único y selecciona el DMS que aplicará las políticas de enrolamiento y renovación.",{"_3805":1056,"_26541":1027,"_22543":42730,"_5":26803,"_10604":42659,"_1869":42731},[],"Añade un icono y etiquetas si necesitas agruparlo por modelo, ubicación, entorno u otro criterio operativo.",{"_3805":1057,"_26541":1027,"_22543":42733,"_5":26803,"_10604":42663,"_1869":42734},[],"El dispositivo debe aparecer con estado **No Identity** hasta que complete el enrolamiento o reciba una identidad manual.",{"_3805":1058,"_26541":1027,"_22543":42736,"_5":26803,"_10604":42667,"_1869":42737},[],"La acción **Assign Identity** está disponible mientras el dispositivo permanece en **No Identity**.",{"_3805":1059,"_26541":1027,"_22543":42739,"_5":26803,"_10604":42667,"_1869":42740},[],"Abre el dispositivo y selecciona **Assign Identity**.",{"_3805":1060,"_26541":1027,"_22543":42742,"_5":26803,"_10604":42667,"_1869":42743},[],"Elige un certificado activo cuyo `Common Name` coincida con el `Device ID`.",{"_3805":1061,"_26541":1027,"_22543":42745,"_5":26803,"_10604":42667,"_1869":42746},[],"Si no existe, selecciona **Issue New Instead** y elige una CA vinculada al DMS.",{"_3805":1062,"_26541":1027,"_22543":42748,"_5":26803,"_10604":42667,"_1869":42749},[],"Confirma la asignación.",{"_3805":1063,"_26541":1027,"_22543":42751,"_5":26803,"_10604":42667,"_1869":42752},[],"El dispositivo debe cambiar a **Active** y el certificado debe aparecer en su historial.",{"_3805":1064,"_26541":1027,"_22543":42754,"_5":26803,"_10604":42671,"_1869":42755},[],"En **Device Event Timeline**, localiza el último certificado activo y selecciona **Revoke**. Elige una razón conforme a tu política y confirma la operación.",{"_3805":1065,"_26541":1027,"_22543":42757,"_5":26803,"_10604":42671,"_1869":42758},[],"La revocación invalida el certificado, pero no elimina el dispositivo. Puedes restaurar su operación asignándole una identidad nueva. `CertificateHold` permite reactivar el certificado retenido; el resto de razones son definitivas.",{"_3805":1066,"_26541":1027,"_22543":42760,"_5":26803,"_10604":42675,"_1869":42761},[],"Esta acción revoca todos los certificados del dispositivo e impide que vuelva a obtener una identidad.",{"_3805":1067,"_26541":1027,"_22543":42763,"_5":26803,"_10604":42675,"_1869":42764},[],"Usa **Decommission** únicamente cuando el dispositivo haya dejado de operar o ya no sea fiable. Tras confirmar, Lamassu revoca la identidad activa con `CessationOfOperation` y cambia el estado a **Decommissioned**.",{"_3805":1068,"_26541":1027,"_22543":42766,"_5":26803,"_10604":42679,"_1869":42767},[],"<Card title=\"Configura un DMS\" description=\"Define la CA, confianza y políticas de la flota.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_3805":1069,"_26541":1027,"_22543":42769,"_5":26803,"_10604":42679,"_1869":42770},[],"<Card title=\"Integra EST\" description=\"Permite que el dispositivo solicite y renueve su identidad.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_3805":1070,"_26541":1070,"_5":26798,"_1869":42772,"_26811":42773,"_22543":42774,"_10604":1070},"Enrolamiento de dispositivos con EST",[39375,40459,40937],[],{"_3805":1071,"_26541":1070,"_22543":42776,"_5":26803,"_10604":1070,"_1869":42777},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_3805":1072,"_26541":1070,"_5":26808,"_22543":42779,"_10604":42780,"_1869":42781},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#est-enrollment-over-secure-transport","EST: Enrollment over Secure Transport",{"_3805":1073,"_26541":1070,"_5":26808,"_22543":42783,"_10604":42784,"_1869":42785},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#configuración-del-dms","Configuración del DMS",{"_3805":1074,"_26541":1070,"_5":26808,"_22543":42787,"_10604":42788,"_1869":40184},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#requisitos-previos",{"_3805":1075,"_26541":1070,"_5":26808,"_22543":42790,"_10604":42791,"_1869":42792},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#configuración-de-enrollment","Configuración de enrollment",{"_3805":1076,"_26541":1070,"_5":26808,"_22543":42794,"_10604":42795,"_1869":42796},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-device-registration","Enrollment Device Registration",{"_3805":1077,"_26541":1070,"_5":26808,"_22543":42798,"_10604":42799,"_1869":42800},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-settings","Enrollment Settings",{"_3805":1078,"_26541":1070,"_5":26808,"_22543":42802,"_10604":42803,"_1869":42804},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#perfil-de-emisión","Perfil de emisión",{"_3805":1079,"_26541":1070,"_5":26808,"_22543":42806,"_10604":42807,"_1869":42808},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3805":1080,"_26541":1070,"_5":26808,"_22543":42810,"_10604":42811,"_1869":42812},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_3805":1081,"_26541":1070,"_5":26808,"_22543":42814,"_10604":42815,"_1869":42816},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#verificar-la-configuración","Verificar la configuración",{"_3805":1082,"_26541":1070,"_5":26808,"_22543":42818,"_10604":42819,"_1869":42820},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#integración-de-dispositivos","Integración de dispositivos",{"_3805":1083,"_26541":1070,"_5":26808,"_22543":42822,"_10604":42823,"_1869":39385},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#antes-de-empezar",{"_3805":1084,"_26541":1070,"_5":26808,"_22543":42825,"_10604":42826,"_1869":42827},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#resumen-del-flujo","Resumen del flujo",{"_3805":1085,"_26541":1070,"_5":26808,"_22543":42829,"_10604":42830,"_1869":42831},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_3805":1086,"_26541":1070,"_5":26808,"_22543":42833,"_10604":42834,"_1869":42835},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#referencia-de-endpoints","Referencia de endpoints",{"_3805":1087,"_26541":1070,"_5":26808,"_22543":42837,"_10604":42838,"_1869":42839},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#cacerts","`/cacerts`",{"_3805":1088,"_26541":1070,"_5":26808,"_22543":42841,"_10604":42842,"_1869":42843},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simpleenroll","`/simpleenroll`",{"_3805":1089,"_26541":1070,"_5":26808,"_22543":42845,"_10604":42846,"_1869":42847},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simplereenroll","`/simplereenroll`",{"_3805":1090,"_26541":1070,"_5":26808,"_22543":42849,"_10604":42850,"_1869":42851},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#serverkeygen","`/serverkeygen`",{"_3805":1091,"_26541":1070,"_5":26808,"_22543":42853,"_10604":42854,"_1869":42855},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#flujos-completos","Flujos completos",{"_3805":1092,"_26541":1070,"_5":26808,"_22543":42857,"_10604":42858,"_1869":42859},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_3805":1093,"_26541":1070,"_5":26808,"_22543":42861,"_10604":42862,"_1869":42863},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_3805":1094,"_26541":1070,"_5":26808,"_22543":42865,"_10604":42866,"_1869":42867},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_3805":1095,"_26541":1070,"_5":26808,"_22543":42869,"_10604":42870,"_1869":42871},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3805":1096,"_26541":1070,"_5":26808,"_22543":42873,"_10604":42874,"_1869":42875},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3805":1097,"_26541":1070,"_5":26808,"_22543":42877,"_10604":42878,"_1869":42879},[],"/docs/pr-preview/pr-27/platform/pki/est-enrollment#notas-de-compatibilidad","Notas de compatibilidad",{"_3805":1098,"_26541":1070,"_22543":42881,"_5":26803,"_10604":42780,"_1869":42882},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación. Así, actúa como autoridad de registro (RA) frente al cliente.",{"_3805":1099,"_26541":1070,"_22543":42884,"_5":26803,"_10604":42780,"_1869":42885},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_3805":1100,"_26541":1070,"_22543":42887,"_5":26803,"_10604":42780,"_1869":42888},[],"Esta guía está dividida en dos partes:",{"_3805":1101,"_26541":1070,"_22543":42890,"_5":26803,"_10604":42780,"_1869":42891},[],"Configuración del DMS, para el administrador PKI.",{"_3805":1102,"_26541":1070,"_22543":42893,"_5":26803,"_10604":42780,"_1869":42894},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_3805":1103,"_26541":1070,"_22543":42896,"_5":26803,"_10604":42780,"_1869":42897},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_3805":1104,"_26541":1070,"_22543":42899,"_5":26803,"_10604":42780,"_1869":42900},[],"**Administrador PKI:** empiece por Configuración del DMS y termine con Diagnóstico y compatibilidad.",{"_3805":1105,"_26541":1070,"_22543":42902,"_5":26803,"_10604":42780,"_1869":42903},[],"**Integrador de dispositivos:** empiece por Antes de empezar y continúe con `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo que vaya a implementar.",{"_3805":1106,"_26541":1070,"_22543":42905,"_5":26803,"_10604":42788,"_1869":42906},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_3805":1107,"_26541":1070,"_22543":42908,"_5":26803,"_10604":42788,"_1869":42909},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_3805":1108,"_26541":1070,"_22543":42911,"_5":26803,"_10604":42788,"_1869":42912},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_3805":1109,"_26541":1070,"_22543":42914,"_5":26803,"_10604":42788,"_1869":42915},[],"Conviene separar cuatro bloques de configuración:",{"_3805":1110,"_26541":1070,"_22543":42917,"_5":26803,"_10604":42788,"_1869":42918},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_3805":1111,"_26541":1070,"_22543":42920,"_5":26803,"_10604":42788,"_1869":42921},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_3805":1112,"_26541":1070,"_22543":42923,"_5":26803,"_10604":42788,"_1869":42924},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_3805":1113,"_26541":1070,"_22543":42926,"_5":26803,"_10604":42788,"_1869":42927},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_3805":1114,"_26541":1070,"_22543":42929,"_5":26803,"_10604":42795,"_1869":42930},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_3805":1115,"_26541":1070,"_22543":42932,"_5":26803,"_10604":42795,"_1869":42933},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_3805":1116,"_26541":1070,"_22543":42935,"_5":26803,"_10604":42795,"_1869":42936},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_3805":1117,"_26541":1070,"_22543":42938,"_5":26803,"_10604":42795,"_1869":42939},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_3805":1118,"_26541":1070,"_22543":42941,"_5":26803,"_10604":42799,"_1869":42942},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_3805":1119,"_26541":1070,"_22543":42944,"_5":26803,"_10604":42799,"_1869":42945},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_3805":1120,"_26541":1070,"_22543":42947,"_5":26803,"_10604":42799,"_1869":42948},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_3805":1121,"_26541":1070,"_22543":42950,"_5":26803,"_10604":42799,"_1869":42951},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Puede exigir un certificado mTLS (`CLIENT_CERTIFICATE`), delegar la autorización en un webhook (`EXTERNAL_WEBHOOK`), combinar ambos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) o aceptar solicitudes sin autenticación (`NO_AUTH`). Este último modo debe limitarse a laboratorios o redes de aprovisionamiento aisladas.",{"_3805":1122,"_26541":1070,"_22543":42953,"_5":26803,"_10604":42799,"_1869":42954},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_3805":1123,"_26541":1070,"_22543":42956,"_5":26803,"_10604":42799,"_1869":42957},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_3805":1124,"_26541":1070,"_22543":42959,"_5":26803,"_10604":42799,"_1869":42960},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_3805":1125,"_26541":1070,"_22543":42962,"_5":26803,"_10604":42799,"_1869":42963},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_3805":1126,"_26541":1070,"_22543":42965,"_5":26803,"_10604":42799,"_1869":42966},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_3805":1127,"_26541":1070,"_22543":42968,"_5":26803,"_10604":42799,"_1869":42969},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_3805":1128,"_26541":1070,"_22543":42971,"_5":26803,"_10604":42799,"_1869":42972},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_3805":1129,"_26541":1070,"_22543":42974,"_5":26803,"_10604":42799,"_1869":42975},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_3805":1130,"_26541":1070,"_22543":42977,"_5":26803,"_10604":42799,"_1869":42978},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_3805":1131,"_26541":1070,"_22543":42980,"_5":26803,"_10604":42799,"_1869":42981},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_3805":1132,"_26541":1070,"_22543":42983,"_5":26803,"_10604":42803,"_1869":42984},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_3805":1133,"_26541":1070,"_22543":42986,"_5":26803,"_10604":42803,"_1869":42987},[],"**`HonorSubject`** controla si el subject del CSR se traslada literalmente al certificado. Si está desactivado, la CA aplica la plantilla del perfil e ignora el subject recibido.",{"_3805":1134,"_26541":1070,"_22543":42989,"_5":26803,"_10604":42803,"_1869":42990},[],"**`HonorKeyUsage`** decide si se respeta el `KeyUsage` del CSR o se sustituye por el definido en la plantilla.",{"_3805":1135,"_26541":1070,"_22543":42992,"_5":26803,"_10604":42803,"_1869":42993},[],"**`HonorExtendedKeyUsages`** aplica la misma regla a `ExtKeyUsage`.",{"_3805":1136,"_26541":1070,"_22543":42995,"_5":26803,"_10604":42803,"_1869":42996},[],"**`HonorExtensions`** controla si el resto de extensiones del CSR, como SAN o CDP, se incluyen en el certificado.",{"_3805":1137,"_26541":1070,"_22543":42998,"_5":26803,"_10604":42803,"_1869":42999},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_3805":1138,"_26541":1070,"_22543":43001,"_5":26803,"_10604":42807,"_1869":43002},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_3805":1139,"_26541":1070,"_22543":43004,"_5":26803,"_10604":42807,"_1869":43005},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_3805":1140,"_26541":1070,"_22543":43007,"_5":26803,"_10604":42807,"_1869":43008},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_3805":1141,"_26541":1070,"_22543":43010,"_5":26803,"_10604":42807,"_1869":43011},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_3805":1142,"_26541":1070,"_22543":43013,"_5":26803,"_10604":42807,"_1869":43014},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_3805":1143,"_26541":1070,"_22543":43016,"_5":26803,"_10604":42807,"_1869":43017},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_3805":1144,"_26541":1070,"_22543":43019,"_5":26803,"_10604":42807,"_1869":43020},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_3805":1145,"_26541":1070,"_22543":43022,"_5":26803,"_10604":42811,"_1869":43023},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_3805":1146,"_26541":1070,"_22543":43025,"_5":26803,"_10604":42811,"_1869":43026},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_3805":1147,"_26541":1070,"_22543":43028,"_5":26803,"_10604":42811,"_1869":43029},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_3805":1148,"_26541":1070,"_22543":43031,"_5":26803,"_10604":42811,"_1869":43032},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_3805":1149,"_26541":1070,"_22543":43034,"_5":26803,"_10604":42815,"_1869":43035},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_3805":1150,"_26541":1070,"_22543":43037,"_5":26803,"_10604":42815,"_1869":43038},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_3805":1151,"_26541":1070,"_22543":43040,"_5":26803,"_10604":42815,"_1869":43041},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_3805":1152,"_26541":1070,"_22543":43043,"_5":26803,"_10604":42815,"_1869":43044},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_3805":1153,"_26541":1070,"_22543":43046,"_5":26803,"_10604":42819,"_1869":43047},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_3805":1154,"_26541":1070,"_22543":43049,"_5":26803,"_10604":42819,"_1869":43050},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_3805":1155,"_26541":1070,"_22543":43052,"_5":26803,"_10604":42819,"_1869":43053},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_3805":1156,"_26541":1070,"_22543":43055,"_5":26803,"_10604":42823,"_1869":43056},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_3805":1157,"_26541":1070,"_22543":43058,"_5":26803,"_10604":42823,"_1869":43059},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_3805":1158,"_26541":1070,"_22543":43061,"_5":26803,"_10604":42823,"_1869":43062},[],"**La URL del host EST**, por ejemplo `https://est.lamassu.example`, proporcionada por el administrador PKI.",{"_3805":1159,"_26541":1070,"_22543":43064,"_5":26803,"_10604":42823,"_1869":43065},[],"**El ancla de confianza del servidor** (`lamassu-trust.pem`), raíz o intermedia, con la que el cliente validará el TLS de Lamassu.",{"_3805":1160,"_26541":1070,"_22543":43067,"_5":26803,"_10604":42823,"_1869":43068},[],"**El certificado bootstrap y su clave privada** si el DMS usa `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Esta identidad debe proceder de una de las `ValidationCAs` configuradas, normalmente una CA de aprovisionamiento distinta de la CA de enrolamiento.",{"_3805":1161,"_26541":1070,"_22543":43070,"_5":26803,"_10604":42823,"_1869":43071},[],"**El ID del DMS** (`{aps}`), que debe aparecer en todas las rutas EST.",{"_3805":1162,"_26541":1070,"_22543":43073,"_5":26803,"_10604":42826,"_1869":43074},[],"**Descargue la confianza con `/cacerts`:** el cliente valida el TLS del servidor y recibe los certificados en PKCS#7 o PEM.",{"_3805":1163,"_26541":1070,"_22543":43076,"_5":26803,"_10604":42826,"_1869":43077},[],"**Realice el alta inicial con `/simpleenroll`:** presente el certificado bootstrap o la credencial definida por `AuthMode` para obtener el certificado del dispositivo.",{"_3805":1164,"_26541":1070,"_22543":43079,"_5":26803,"_10604":42826,"_1869":43080},[],"**Renueve con `/simplereenroll`:** autentíquese con el certificado actual del dispositivo para obtener uno nuevo.",{"_3805":1165,"_26541":1070,"_22543":43082,"_5":26803,"_10604":42826,"_1869":43083},[],"**Use `/serverkeygen` solo si necesita generación de claves en servidor:** aplica la misma autenticación que `/simpleenroll` y devuelve la clave privada PKCS#8 junto con el certificado.",{"_3805":1166,"_26541":1070,"_22543":43085,"_5":26803,"_10604":42830,"_1869":43086},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_3805":1167,"_26541":1070,"_22543":43088,"_5":26803,"_10604":42830,"_1869":43089},[],"Modo (`AuthMode`)",{"_3805":1168,"_26541":1070,"_22543":43091,"_5":26803,"_10604":42830,"_1869":39746},[],{"_3805":1169,"_26541":1070,"_22543":43093,"_5":26803,"_10604":42830,"_1869":43094},[],"Credencial esperada",{"_3805":1170,"_26541":1070,"_22543":43096,"_5":26803,"_10604":42830,"_1869":43097},[],"Aplica en enroll",{"_3805":1171,"_26541":1070,"_22543":43099,"_5":26803,"_10604":42830,"_1869":43100},[],"Aplica en reenroll",{"_3805":1172,"_26541":1070,"_22543":43102,"_5":26803,"_10604":42830,"_1869":43103},[],"`CLIENT_CERTIFICATE`",{"_3805":1173,"_26541":1070,"_22543":43105,"_5":26803,"_10604":42830,"_1869":43106},[],"mTLS con certificado X.509",{"_3805":1174,"_26541":1070,"_22543":43108,"_5":26803,"_10604":42830,"_1869":43109},[],"Certificado y clave privada cliente",{"_3805":1175,"_26541":1070,"_22543":43111,"_5":26803,"_10604":42830,"_1869":43112},[],"Sí",{"_3805":1176,"_26541":1070,"_22543":43114,"_5":26803,"_10604":42830,"_1869":43115},[],"Sí (con el certificado en vigor)",{"_3805":1177,"_26541":1070,"_22543":43117,"_5":26803,"_10604":42830,"_1869":43118},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3805":1178,"_26541":1070,"_22543":43120,"_5":26803,"_10604":42830,"_1869":43121},[],"mTLS más validación por webhook",{"_3805":1179,"_26541":1070,"_22543":43123,"_5":26803,"_10604":42830,"_1869":43124},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_3805":1180,"_26541":1070,"_22543":43126,"_5":26803,"_10604":42830,"_1869":43112},[],{"_3805":1181,"_26541":1070,"_22543":43128,"_5":26803,"_10604":42830,"_1869":43129},[],"No como combinación; en reenroll no mantiene ambos controles",{"_3805":1182,"_26541":1070,"_22543":43131,"_5":26803,"_10604":42830,"_1869":43132},[],"`EXTERNAL_WEBHOOK`",{"_3805":1183,"_26541":1070,"_22543":43134,"_5":26803,"_10604":42830,"_1869":43135},[],"Webhook externo de autorización",{"_3805":1184,"_26541":1070,"_22543":43137,"_5":26803,"_10604":42830,"_1869":43138},[],"Ninguna en el canal TLS",{"_3805":1185,"_26541":1070,"_22543":43140,"_5":26803,"_10604":42830,"_1869":43112},[],{"_3805":1186,"_26541":1070,"_22543":43142,"_5":26803,"_10604":42830,"_1869":43143},[],"No, degrada a `NO_AUTH`",{"_3805":1187,"_26541":1070,"_22543":43145,"_5":26803,"_10604":42830,"_1869":43146},[],"`NO_AUTH`",{"_3805":1188,"_26541":1070,"_22543":43148,"_5":26803,"_10604":42830,"_1869":43149},[],"Sin autenticación",{"_3805":1189,"_26541":1070,"_22543":43151,"_5":26803,"_10604":42830,"_1869":43152},[],"Ninguna",{"_3805":1190,"_26541":1070,"_22543":43154,"_5":26803,"_10604":42830,"_1869":43155},[],"Sí (uso restringido)",{"_3805":1191,"_26541":1070,"_22543":43157,"_5":26803,"_10604":42830,"_1869":43155},[],{"_3805":1192,"_26541":1070,"_22543":43159,"_5":26803,"_10604":42830,"_1869":43160},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_3805":1193,"_26541":1070,"_22543":43162,"_5":26803,"_10604":42830,"_1869":43163},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_3805":1194,"_26541":1070,"_22543":43165,"_5":26803,"_10604":42830,"_1869":43166},[],"Sus parámetros principales son `ValidationCAs`, la lista de CAs que pueden validar el certificado bootstrap o el certificado en vigor; `AllowExpired`, que permite aceptar certificados cliente caducados; y `ChainLevelValidation`, que limita la profundidad de la cadena cuando su valor es mayor que cero.",{"_3805":1195,"_26541":1070,"_22543":43168,"_5":26803,"_10604":42830,"_1869":43169},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_3805":1196,"_26541":1070,"_22543":43171,"_5":26803,"_10604":42830,"_1869":43172},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_3805":1197,"_26541":1070,"_22543":43174,"_5":26803,"_10604":42830,"_1869":43175},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll`. El cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_3805":1198,"_26541":1070,"_22543":43177,"_5":26803,"_10604":42830,"_1869":43178},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_3805":1199,"_26541":1070,"_22543":43180,"_5":26803,"_10604":42834,"_1869":43181},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_3805":1200,"_26541":1070,"_22543":43183,"_5":26803,"_10604":42834,"_1869":43184},[],"`/cacerts`: descarga de la cadena de confianza.",{"_3805":1201,"_26541":1070,"_22543":43186,"_5":26803,"_10604":42834,"_1869":43187},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_3805":1202,"_26541":1070,"_22543":43189,"_5":26803,"_10604":42834,"_1869":43190},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_3805":1203,"_26541":1070,"_22543":43192,"_5":26803,"_10604":42834,"_1869":43193},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_3805":1204,"_26541":1070,"_22543":43195,"_5":26803,"_10604":42838,"_1869":43196},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_3805":1205,"_26541":1070,"_22543":43198,"_5":26803,"_10604":42838,"_1869":43199},[],"`CADistributionSettings` permite decidir qué se publica:",{"_3805":1206,"_26541":1070,"_22543":43201,"_5":26803,"_10604":42838,"_1869":43202},[],"**`IncludeLamassuSystemCA`** añade el certificado *downstream* del servidor Lamassu. Es la hoja TLS que el cliente puede usar para anclar la conexión, no una CA.",{"_3805":1207,"_26541":1070,"_22543":43204,"_5":26803,"_10604":42838,"_1869":43205},[],"**`IncludeEnrollmentCA`** añade la CA emisora del DMS, responsable de firmar los certificados de dispositivo.",{"_3805":1208,"_26541":1070,"_22543":43207,"_5":26803,"_10604":42838,"_1869":43208},[],"**`ManagedCAs`** publica CAs adicionales como anclas de confianza.",{"_3805":1209,"_26541":1070,"_22543":43210,"_5":26803,"_10604":42838,"_1869":43211},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_3805":1210,"_26541":1070,"_22543":43213,"_5":26803,"_10604":42838,"_1869":43214},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_3805":1211,"_26541":1070,"_22543":43216,"_5":26803,"_10604":42838,"_1869":43217},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_3805":1212,"_26541":1070,"_22543":43219,"_5":26803,"_10604":42838,"_1869":43220},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_3805":1213,"_26541":1070,"_22543":43222,"_5":26803,"_10604":42842,"_1869":43223},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_3805":1214,"_26541":1070,"_22543":43225,"_5":26803,"_10604":42842,"_1869":43226},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_3805":1215,"_26541":1070,"_22543":43228,"_5":26803,"_10604":42842,"_1869":43229},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos:",{"_3805":1216,"_26541":1070,"_22543":43231,"_5":26803,"_10604":42842,"_1869":43232},[],"**`EnrollmentSettings.RegistrationMode`** decide si el dispositivo se crea durante la primera inscripción (`JITP`) o debe existir previamente (`PRE_REGISTRATION`).",{"_3805":1217,"_26541":1070,"_22543":43234,"_5":26803,"_10604":42842,"_1869":43235},[],"**`EnrollmentSettings.EnableReplaceableEnrollment`** permite repetir `/simpleenroll` para un dispositivo ya enrolado. Al hacerlo, revoca el certificado anterior como `superseded`; si está desactivado, el servidor responde con `forbiddenNewEnrollment`.",{"_3805":1218,"_26541":1070,"_22543":43237,"_5":26803,"_10604":42842,"_1869":43238},[],"**`EnrollmentSettings.VerifyCSRSignature`** valida que quien envía el CSR controla la clave privada declarada. Para flotas IoT en redes abiertas debe estar activo.",{"_3805":1219,"_26541":1070,"_22543":43240,"_5":26803,"_10604":42842,"_1869":43241},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_3805":1220,"_26541":1070,"_22543":43243,"_5":26803,"_10604":42846,"_1869":43244},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_3805":1221,"_26541":1070,"_22543":43246,"_5":26803,"_10604":42846,"_1869":43247},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_3805":1222,"_26541":1070,"_22543":43249,"_5":26803,"_10604":42846,"_1869":43250},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_3805":1223,"_26541":1070,"_22543":43252,"_5":26803,"_10604":42846,"_1869":43253},[],"**`ReEnrollmentDelta`** abre la ventana de renovación en `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_3805":1224,"_26541":1070,"_22543":43255,"_5":26803,"_10604":42846,"_1869":43256},[],"**`EnableExpiredRenewal`** permite usar un certificado ya caducado como prueba de identidad; si está desactivado, el servidor responde con `expired certificate`.",{"_3805":1225,"_26541":1070,"_22543":43258,"_5":26803,"_10604":42846,"_1869":43259},[],"**`RevokeOnReEnrollment`** revoca el certificado anterior como `superseded` después de emitir el nuevo.",{"_3805":1226,"_26541":1070,"_22543":43261,"_5":26803,"_10604":42846,"_1869":43262},[],"**`AdditionalValidationCAs`** añade emisores válidos para el certificado actual, además de la CA de enrolamiento del DMS.",{"_3805":1227,"_26541":1070,"_22543":43264,"_5":26803,"_10604":42846,"_1869":43265},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_3805":1228,"_26541":1070,"_22543":43267,"_5":26803,"_10604":42846,"_1869":43268},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_3805":1229,"_26541":1070,"_22543":43270,"_5":26803,"_10604":42850,"_1869":43271},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_3805":1230,"_26541":1070,"_22543":43273,"_5":26803,"_10604":42850,"_1869":43274},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_3805":1231,"_26541":1070,"_22543":43276,"_5":26803,"_10604":42850,"_1869":43277},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_3805":1232,"_26541":1070,"_22543":43279,"_5":26803,"_10604":42850,"_1869":43280},[],"**RSA** admite cualquier tamaño aceptado por `crypto/rsa`; los valores habituales son 2048, 3072 y 4096 bits. Un valor no válido hace fallar la generación con un error `500`.",{"_3805":1233,"_26541":1070,"_22543":43282,"_5":26803,"_10604":42850,"_1869":43283},[],"**ECDSA** admite 224, 256, 384 y 521 bits, equivalentes a P-224, P-256 (`prime256v1`), P-384 y P-521. Cualquier otro valor degrada **silenciosamente** a P-256 y solo deja un aviso en el log: el cliente no recibe un error y puede obtener una curva distinta de la esperada.",{"_3805":1234,"_26541":1070,"_22543":43285,"_5":26803,"_10604":42850,"_1869":43286},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_3805":1235,"_26541":1070,"_22543":43288,"_5":26803,"_10604":42850,"_1869":43289},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_3805":1236,"_26541":1070,"_22543":43291,"_5":26803,"_10604":42850,"_1869":43292},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_3805":1237,"_26541":1070,"_22543":43294,"_5":26803,"_10604":42850,"_1869":43295},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_3805":1238,"_26541":1070,"_22543":43297,"_5":26803,"_10604":42850,"_1869":43298},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_3805":1239,"_26541":1070,"_22543":43300,"_5":26803,"_10604":42850,"_1869":43301},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_3805":1240,"_26541":1070,"_22543":43303,"_5":26803,"_10604":42850,"_1869":43304},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_3805":1241,"_26541":1070,"_22543":43306,"_5":26803,"_10604":42854,"_1869":43307},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_3805":1242,"_26541":1070,"_22543":43309,"_5":26803,"_10604":42858,"_1869":43310},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_3805":1243,"_26541":1070,"_22543":43312,"_5":26803,"_10604":42862,"_1869":43313},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_3805":1244,"_26541":1070,"_22543":43315,"_5":26803,"_10604":42866,"_1869":43316},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_3805":1245,"_26541":1070,"_22543":43318,"_5":26803,"_10604":42866,"_1869":43319},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_3805":1246,"_26541":1070,"_22543":43321,"_5":26803,"_10604":42866,"_1869":43322},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_3805":1247,"_26541":1070,"_22543":43324,"_5":26803,"_10604":42866,"_1869":43325},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_3805":1248,"_26541":1070,"_22543":43327,"_5":26803,"_10604":42874,"_1869":43328},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_3805":1249,"_26541":1070,"_22543":43330,"_5":26803,"_10604":42874,"_1869":43331},[],"HTTP",{"_3805":1250,"_26541":1070,"_22543":43333,"_5":26803,"_10604":42874,"_1869":43334},[],"Mensaje",{"_3805":1251,"_26541":1070,"_22543":43336,"_5":26803,"_10604":42874,"_1869":43337},[],"Causa",{"_3805":1252,"_26541":1070,"_22543":43339,"_5":26803,"_10604":42874,"_1869":43340},[],"Acción del integrador",{"_3805":1253,"_26541":1070,"_22543":43342,"_5":26803,"_10604":42874,"_1869":24838},[],{"_3805":1254,"_26541":1070,"_22543":43344,"_5":26803,"_10604":42874,"_1869":43345},[],"`Field validation for 'APS' failed`",{"_3805":1255,"_26541":1070,"_22543":43347,"_5":26803,"_10604":42874,"_1869":43348},[],"El segmento `{aps}` falta en la URL.",{"_3805":1256,"_26541":1070,"_22543":43350,"_5":26803,"_10604":42874,"_1869":43351},[],"Incluir el ID del DMS en la ruta.",{"_3805":1257,"_26541":1070,"_22543":43353,"_5":26803,"_10604":42874,"_1869":24838},[],{"_3805":1258,"_26541":1070,"_22543":43355,"_5":26803,"_10604":42874,"_1869":43356},[],"`content-type must be application/pkcs10`",{"_3805":1259,"_26541":1070,"_22543":43358,"_5":26803,"_10604":42874,"_1869":43359},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_3805":1260,"_26541":1070,"_22543":43361,"_5":26803,"_10604":42874,"_1869":43362},[],"Fijar `Content-Type: application/pkcs10`.",{"_3805":1261,"_26541":1070,"_22543":43364,"_5":26803,"_10604":42874,"_1869":24838},[],{"_3805":1262,"_26541":1070,"_22543":43366,"_5":26803,"_10604":42874,"_1869":43367},[],"`body payload must be base64 encoded`",{"_3805":1263,"_26541":1070,"_22543":43369,"_5":26803,"_10604":42874,"_1869":43370},[],"El cuerpo no es base64 válido.",{"_3805":1264,"_26541":1070,"_22543":43372,"_5":26803,"_10604":42874,"_1869":43373},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_3805":1265,"_26541":1070,"_22543":43375,"_5":26803,"_10604":42874,"_1869":24284},[],{"_3805":1266,"_26541":1070,"_22543":43377,"_5":26803,"_10604":42874,"_1869":43378},[],"`DMS not found`",{"_3805":1267,"_26541":1070,"_22543":43380,"_5":26803,"_10604":42874,"_1869":43381},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_3805":1268,"_26541":1070,"_22543":43383,"_5":26803,"_10604":42874,"_1869":43384},[],"Verificar el identificador con el administrador PKI.",{"_3805":1269,"_26541":1070,"_22543":43386,"_5":26803,"_10604":42874,"_1869":24284},[],{"_3805":1270,"_26541":1070,"_22543":43388,"_5":26803,"_10604":42874,"_1869":43389},[],"`invalid certificate`",{"_3805":1271,"_26541":1070,"_22543":43391,"_5":26803,"_10604":42874,"_1869":43392},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_3805":1272,"_26541":1070,"_22543":43394,"_5":26803,"_10604":42874,"_1869":43395},[],"Comprobar la cadena del certificado bootstrap.",{"_3805":1273,"_26541":1070,"_22543":43397,"_5":26803,"_10604":42874,"_1869":24284},[],{"_3805":1274,"_26541":1070,"_22543":43399,"_5":26803,"_10604":42874,"_1869":43400},[],"`certificate is revoked`",{"_3805":1275,"_26541":1070,"_22543":43402,"_5":26803,"_10604":42874,"_1869":43403},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_3805":1276,"_26541":1070,"_22543":43405,"_5":26803,"_10604":42874,"_1869":43406},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_3805":1277,"_26541":1070,"_22543":43408,"_5":26803,"_10604":42874,"_1869":24284},[],{"_3805":1278,"_26541":1070,"_22543":43410,"_5":26803,"_10604":42874,"_1869":43411},[],"`revoked certificate`",{"_3805":1279,"_26541":1070,"_22543":43413,"_5":26803,"_10604":42874,"_1869":43414},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_3805":1280,"_26541":1070,"_22543":43416,"_5":26803,"_10604":42874,"_1869":43417},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_3805":1281,"_26541":1070,"_22543":43419,"_5":26803,"_10604":42874,"_1869":24284},[],{"_3805":1282,"_26541":1070,"_22543":43421,"_5":26803,"_10604":42874,"_1869":43422},[],"`expired certificate`",{"_3805":1283,"_26541":1070,"_22543":43424,"_5":26803,"_10604":42874,"_1869":43425},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_3805":1284,"_26541":1070,"_22543":43427,"_5":26803,"_10604":42874,"_1869":43428},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_3805":1285,"_26541":1070,"_22543":43430,"_5":26803,"_10604":42874,"_1869":24284},[],{"_3805":1286,"_26541":1070,"_22543":43432,"_5":26803,"_10604":42874,"_1869":43433},[],"`forbiddenNewEnrollment`",{"_3805":1287,"_26541":1070,"_22543":43435,"_5":26803,"_10604":42874,"_1869":43436},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_3805":1288,"_26541":1070,"_22543":43438,"_5":26803,"_10604":42874,"_1869":43439},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_3805":1289,"_26541":1070,"_22543":43441,"_5":26803,"_10604":42874,"_1869":24284},[],{"_3805":1290,"_26541":1070,"_22543":43443,"_5":26803,"_10604":42874,"_1869":43444},[],"`device not preregistered`",{"_3805":1291,"_26541":1070,"_22543":43446,"_5":26803,"_10604":42874,"_1869":43447},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_3805":1292,"_26541":1070,"_22543":43449,"_5":26803,"_10604":42874,"_1869":43450},[],"Registrar el dispositivo antes de inscribirlo.",{"_3805":1293,"_26541":1070,"_22543":43452,"_5":26803,"_10604":42874,"_1869":24284},[],{"_3805":1294,"_26541":1070,"_22543":43454,"_5":26803,"_10604":42874,"_1869":43455},[],"`invalid reenroll window`",{"_3805":1295,"_26541":1070,"_22543":43457,"_5":26803,"_10604":42874,"_1869":43458},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_3805":1296,"_26541":1070,"_22543":43460,"_5":26803,"_10604":42874,"_1869":43461},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_3805":1297,"_26541":1070,"_22543":43463,"_5":26803,"_10604":42874,"_1869":24284},[],{"_3805":1298,"_26541":1070,"_22543":43465,"_5":26803,"_10604":42874,"_1869":43466},[],"`invalid RawSubject bytes`",{"_3805":1299,"_26541":1070,"_22543":43468,"_5":26803,"_10604":42874,"_1869":43469},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_3805":1300,"_26541":1070,"_22543":43471,"_5":26803,"_10604":42874,"_1869":43472},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_3805":1301,"_26541":1070,"_22543":43474,"_5":26803,"_10604":42874,"_1869":24284},[],{"_3805":1302,"_26541":1070,"_22543":43476,"_5":26803,"_10604":42874,"_1869":43477},[],"`external webhook denied enrollment`",{"_3805":1303,"_26541":1070,"_22543":43479,"_5":26803,"_10604":42874,"_1869":43480},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_3805":1304,"_26541":1070,"_22543":43482,"_5":26803,"_10604":42874,"_1869":43483},[],"Revisar los logs del servicio webhook.",{"_3805":1305,"_26541":1070,"_22543":43485,"_5":26803,"_10604":42874,"_1869":24284},[],{"_3805":1306,"_26541":1070,"_22543":43487,"_5":26803,"_10604":42874,"_1869":43488},[],"`server key generation not enabled`",{"_3805":1307,"_26541":1070,"_22543":43490,"_5":26803,"_10604":42874,"_1869":43491},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_3805":1308,"_26541":1070,"_22543":43493,"_5":26803,"_10604":42874,"_1869":43494},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_3805":1309,"_26541":1070,"_22543":43496,"_5":26803,"_10604":42874,"_1869":43497},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_3805":1310,"_26541":1070,"_22543":43499,"_5":26803,"_10604":42878,"_1869":43500},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_3805":1311,"_26541":1070,"_22543":43502,"_5":26803,"_10604":42878,"_1869":43503},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_3805":1312,"_26541":1070,"_22543":43505,"_5":26803,"_10604":42878,"_1869":43506},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_3805":1313,"_26541":1070,"_22543":43508,"_5":26803,"_10604":42878,"_1869":43509},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_3805":1314,"_26541":1070,"_22543":43511,"_5":26803,"_10604":42878,"_1869":43512},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_3805":1315,"_26541":1070,"_22543":43514,"_5":26803,"_10604":42878,"_1869":43515},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_3805":1316,"_26541":1070,"_22543":43517,"_5":26803,"_10604":42878,"_1869":43518},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_3805":1317,"_26541":1070,"_22543":43520,"_5":26803,"_10604":42878,"_1869":43521},[],"<Card title=\"Visión general del DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_3805":1318,"_26541":1070,"_22543":43523,"_5":26803,"_10604":42878,"_1869":43524},[],"<Card title=\"Validación OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3805":1319,"_26541":1070,"_22543":43526,"_5":26803,"_10604":42878,"_1869":43527},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/platform/pki/device-management\" />",{"_3805":1320,"_26541":1320,"_5":26798,"_1869":43529,"_26811":43530,"_22543":43532,"_10604":1320},"AWS IoT Core",[39375,40459,43531],"Integraciones",[],{"_3805":1321,"_26541":1320,"_22543":43534,"_5":26803,"_10604":1320,"_1869":43535},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3805":1322,"_26541":1320,"_5":26808,"_22543":43537,"_10604":43538,"_1869":43539},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3805":1323,"_26541":1320,"_5":26808,"_22543":43541,"_10604":43542,"_1869":43543},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3805":1324,"_26541":1320,"_5":26808,"_22543":43545,"_10604":43546,"_1869":43547},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3805":1325,"_26541":1320,"_5":26808,"_22543":43549,"_10604":43550,"_1869":43551},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3805":1326,"_26541":1320,"_5":26808,"_22543":43553,"_10604":43554,"_1869":43555},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3805":1327,"_26541":1320,"_5":26808,"_22543":43557,"_10604":43558,"_1869":43559},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3805":1328,"_26541":1320,"_5":26808,"_22543":43561,"_10604":43562,"_1869":43563},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#primary-account","Primary Account",{"_3805":1329,"_26541":1320,"_5":26808,"_22543":43565,"_10604":43566,"_1869":43567},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3805":1330,"_26541":1320,"_5":26808,"_22543":43569,"_10604":43570,"_1869":42785},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#configuración-del-dms",{"_3805":1331,"_26541":1320,"_5":26808,"_22543":43572,"_10604":43573,"_1869":43574},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#modo-none","Modo `none`",{"_3805":1332,"_26541":1320,"_5":26808,"_22543":43576,"_10604":43577,"_1869":43578},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3805":1333,"_26541":1320,"_5":26808,"_22543":43580,"_10604":43581,"_1869":43582},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3805":1334,"_26541":1320,"_5":26808,"_22543":43584,"_10604":43585,"_1869":43586},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3805":1335,"_26541":1320,"_5":26808,"_22543":43588,"_10604":43589,"_1869":43590},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3805":1336,"_26541":1320,"_5":26808,"_22543":43592,"_10604":43593,"_1869":43594},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3805":1337,"_26541":1320,"_5":26808,"_22543":43596,"_10604":43597,"_1869":43598},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3805":1338,"_26541":1320,"_5":26808,"_22543":43600,"_10604":43601,"_1869":43602},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3805":1339,"_26541":1320,"_5":26808,"_22543":43604,"_10604":43605,"_1869":43606},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3805":1340,"_26541":1320,"_5":26808,"_22543":43608,"_10604":43609,"_1869":43610},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3805":1341,"_26541":1320,"_5":26808,"_22543":43612,"_10604":43613,"_1869":43614},[],"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3805":1342,"_26541":1320,"_22543":43616,"_5":26803,"_10604":1320,"_1869":43617},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3805":1343,"_26541":1320,"_22543":43619,"_5":26803,"_10604":1320,"_1869":43620},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3805":1344,"_26541":1320,"_22543":43622,"_5":26803,"_10604":1320,"_1869":43623},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3805":1345,"_26541":1320,"_22543":43625,"_5":26803,"_10604":43538,"_1869":43626},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3805":1346,"_26541":1320,"_22543":43628,"_5":26803,"_10604":43538,"_1869":43629},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3805":1347,"_26541":1320,"_22543":43631,"_5":26803,"_10604":43538,"_1869":43632},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3805":1348,"_26541":1320,"_22543":43634,"_5":26803,"_10604":43538,"_1869":43635},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3805":1349,"_26541":1320,"_22543":43637,"_5":26803,"_10604":43542,"_1869":43638},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3805":1350,"_26541":1320,"_22543":43640,"_5":26803,"_10604":43546,"_1869":43641},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3805":1351,"_26541":1320,"_22543":43643,"_5":26803,"_10604":43546,"_1869":43644},[],"Acción IAM",{"_3805":1352,"_26541":1320,"_22543":43646,"_5":26803,"_10604":43546,"_1869":43647},[],"Propósito",{"_3805":1353,"_26541":1320,"_22543":43649,"_5":26803,"_10604":43546,"_1869":43650},[],"`iot:GetRegistrationCode`",{"_3805":1354,"_26541":1320,"_22543":43652,"_5":26803,"_10604":43546,"_1869":43653},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3805":1355,"_26541":1320,"_22543":43655,"_5":26803,"_10604":43546,"_1869":43656},[],"`iot:RegisterCACertificate`",{"_3805":1356,"_26541":1320,"_22543":43658,"_5":26803,"_10604":43546,"_1869":43659},[],"Registrar la CA en AWS IoT",{"_3805":1357,"_26541":1320,"_22543":43661,"_5":26803,"_10604":43546,"_1869":43662},[],"`iot:DescribeCACertificate`",{"_3805":1358,"_26541":1320,"_22543":43664,"_5":26803,"_10604":43546,"_1869":43665},[],"Consultar el estado del registro de la CA",{"_3805":1359,"_26541":1320,"_22543":43667,"_5":26803,"_10604":43546,"_1869":43668},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3805":1360,"_26541":1320,"_22543":43670,"_5":26803,"_10604":43546,"_1869":43671},[],"Crear o actualizar Things en IoT Core",{"_3805":1361,"_26541":1320,"_22543":43673,"_5":26803,"_10604":43546,"_1869":43674},[],"`iot:RegisterThing`",{"_3805":1362,"_26541":1320,"_22543":43676,"_5":26803,"_10604":43546,"_1869":43677},[],"Aprovisionar Things mediante plantilla",{"_3805":1363,"_26541":1320,"_22543":43679,"_5":26803,"_10604":43546,"_1869":43680},[],"`iot:RegisterCertificate`",{"_3805":1364,"_26541":1320,"_22543":43682,"_5":26803,"_10604":43546,"_1869":43683},[],"Registrar certificados de dispositivo",{"_3805":1365,"_26541":1320,"_22543":43685,"_5":26803,"_10604":43546,"_1869":43686},[],"`iot:UpdateCertificate`",{"_3805":1366,"_26541":1320,"_22543":43688,"_5":26803,"_10604":43546,"_1869":43689},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3805":1367,"_26541":1320,"_22543":43691,"_5":26803,"_10604":43546,"_1869":43692},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3805":1368,"_26541":1320,"_22543":43694,"_5":26803,"_10604":43546,"_1869":43695},[],"Crear y adjuntar políticas IoT",{"_3805":1369,"_26541":1320,"_22543":43697,"_5":26803,"_10604":43546,"_1869":43698},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3805":1370,"_26541":1320,"_22543":43700,"_5":26803,"_10604":43546,"_1869":43701},[],"Gestionar grupos de Things",{"_3805":1371,"_26541":1320,"_22543":43703,"_5":26803,"_10604":43546,"_1869":43704},[],"`iot:CreateProvisioningTemplate`",{"_3805":1372,"_26541":1320,"_22543":43706,"_5":26803,"_10604":43546,"_1869":43707},[],"Crear plantillas JITP",{"_3805":1373,"_26541":1320,"_22543":43709,"_5":26803,"_10604":43546,"_1869":43710},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3805":1374,"_26541":1320,"_22543":43712,"_5":26803,"_10604":43546,"_1869":43713},[],"Leer y escribir el Device Shadow",{"_3805":1375,"_26541":1320,"_22543":43715,"_5":26803,"_10604":43546,"_1869":43716},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3805":1376,"_26541":1320,"_22543":43718,"_5":26803,"_10604":43550,"_1869":43719},[],"Parámetro",{"_3805":1377,"_26541":1320,"_22543":43721,"_5":26803,"_10604":43550,"_1869":43722},[],"Tipo",{"_3805":1378,"_26541":1320,"_22543":43724,"_5":26803,"_10604":43550,"_1869":43725},[],"Requerido",{"_3805":1379,"_26541":1320,"_22543":43727,"_5":26803,"_10604":43550,"_1869":39746},[],{"_3805":1380,"_26541":1320,"_22543":43729,"_5":26803,"_10604":43550,"_1869":43730},[],"`connector_id`",{"_3805":1381,"_26541":1320,"_22543":43732,"_5":26803,"_10604":43550,"_1869":22180},[],{"_3805":1382,"_26541":1320,"_22543":43734,"_5":26803,"_10604":43550,"_1869":43112},[],{"_3805":1383,"_26541":1320,"_22543":43736,"_5":26803,"_10604":43550,"_1869":43737},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3805":1384,"_26541":1320,"_22543":43739,"_5":26803,"_10604":43550,"_1869":43740},[],"`aws_config.region`",{"_3805":1385,"_26541":1320,"_22543":43742,"_5":26803,"_10604":43550,"_1869":22180},[],{"_3805":1386,"_26541":1320,"_22543":43744,"_5":26803,"_10604":43550,"_1869":43112},[],{"_3805":1387,"_26541":1320,"_22543":43746,"_5":26803,"_10604":43550,"_1869":43747},[],"Región AWS donde opera el conector.",{"_3805":1388,"_26541":1320,"_22543":43749,"_5":26803,"_10604":43550,"_1869":43750},[],"`aws_config.auth_method`",{"_3805":1389,"_26541":1320,"_22543":43752,"_5":26803,"_10604":43550,"_1869":22180},[],{"_3805":1390,"_26541":1320,"_22543":43754,"_5":26803,"_10604":43550,"_1869":43112},[],{"_3805":1391,"_26541":1320,"_22543":43756,"_5":26803,"_10604":43550,"_1869":43757},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3805":1392,"_26541":1320,"_22543":43759,"_5":26803,"_10604":43550,"_1869":43760},[],"`aws_config.access_key_id`",{"_3805":1393,"_26541":1320,"_22543":43762,"_5":26803,"_10604":43550,"_1869":22180},[],{"_3805":1394,"_26541":1320,"_22543":43764,"_5":26803,"_10604":43550,"_1869":43765},[],"Solo con `auth_method=static`",{"_3805":1395,"_26541":1320,"_22543":43767,"_5":26803,"_10604":43550,"_1869":43768},[],"Clave de acceso AWS.",{"_3805":1396,"_26541":1320,"_22543":43770,"_5":26803,"_10604":43550,"_1869":43771},[],"`aws_config.secret_access_key`",{"_3805":1397,"_26541":1320,"_22543":43773,"_5":26803,"_10604":43550,"_1869":22180},[],{"_3805":1398,"_26541":1320,"_22543":43775,"_5":26803,"_10604":43550,"_1869":43765},[],{"_3805":1399,"_26541":1320,"_22543":43777,"_5":26803,"_10604":43550,"_1869":43778},[],"Clave secreta AWS.",{"_3805":1400,"_26541":1320,"_22543":43780,"_5":26803,"_10604":43550,"_1869":43781},[],"`aws_config.session_token`",{"_3805":1401,"_26541":1320,"_22543":43783,"_5":26803,"_10604":43550,"_1869":22180},[],{"_3805":1402,"_26541":1320,"_22543":43785,"_5":26803,"_10604":43550,"_1869":43786},[],"No",{"_3805":1403,"_26541":1320,"_22543":43788,"_5":26803,"_10604":43550,"_1869":43789},[],"Token de sesión (con `auth_method=static`).",{"_3805":1404,"_26541":1320,"_22543":43791,"_5":26803,"_10604":43550,"_1869":43792},[],"`aws_config.role_arn`",{"_3805":1405,"_26541":1320,"_22543":43794,"_5":26803,"_10604":43550,"_1869":22180},[],{"_3805":1406,"_26541":1320,"_22543":43796,"_5":26803,"_10604":43550,"_1869":43797},[],"Solo con `auth_method=role`",{"_3805":1407,"_26541":1320,"_22543":43799,"_5":26803,"_10604":43550,"_1869":43800},[],"ARN del rol a asumir.",{"_3805":1408,"_26541":1320,"_22543":43802,"_5":26803,"_10604":43550,"_1869":43803},[],"`aws_config.endpoint_url`",{"_3805":1409,"_26541":1320,"_22543":43805,"_5":26803,"_10604":43550,"_1869":22180},[],{"_3805":1410,"_26541":1320,"_22543":43807,"_5":26803,"_10604":43550,"_1869":43786},[],{"_3805":1411,"_26541":1320,"_22543":43809,"_5":26803,"_10604":43550,"_1869":43810},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3805":1412,"_26541":1320,"_22543":43812,"_5":26803,"_10604":43550,"_1869":43813},[],"`subscriber_event_bus`",{"_3805":1413,"_26541":1320,"_22543":43815,"_5":26803,"_10604":43550,"_1869":17170},[],{"_3805":1414,"_26541":1320,"_22543":43817,"_5":26803,"_10604":43550,"_1869":43112},[],{"_3805":1415,"_26541":1320,"_22543":43819,"_5":26803,"_10604":43550,"_1869":43820},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3805":1416,"_26541":1320,"_22543":43822,"_5":26803,"_10604":43550,"_1869":43823},[],"`dms_manager_client`",{"_3805":1417,"_26541":1320,"_22543":43825,"_5":26803,"_10604":43550,"_1869":22180},[],{"_3805":1418,"_26541":1320,"_22543":43827,"_5":26803,"_10604":43550,"_1869":43112},[],{"_3805":1419,"_26541":1320,"_22543":43829,"_5":26803,"_10604":43550,"_1869":43830},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3805":1420,"_26541":1320,"_22543":43832,"_5":26803,"_10604":43550,"_1869":43833},[],"`device_manager_client`",{"_3805":1421,"_26541":1320,"_22543":43835,"_5":26803,"_10604":43550,"_1869":22180},[],{"_3805":1422,"_26541":1320,"_22543":43837,"_5":26803,"_10604":43550,"_1869":43112},[],{"_3805":1423,"_26541":1320,"_22543":43839,"_5":26803,"_10604":43550,"_1869":43840},[],"URL HTTP del Device Manager de Lamassu.",{"_3805":1424,"_26541":1320,"_22543":43842,"_5":26803,"_10604":43550,"_1869":43843},[],"`ca_client`",{"_3805":1425,"_26541":1320,"_22543":43845,"_5":26803,"_10604":43550,"_1869":22180},[],{"_3805":1426,"_26541":1320,"_22543":43847,"_5":26803,"_10604":43550,"_1869":43112},[],{"_3805":1427,"_26541":1320,"_22543":43849,"_5":26803,"_10604":43550,"_1869":43850},[],"URL HTTP del servicio de CA de Lamassu.",{"_3805":1428,"_26541":1320,"_22543":43852,"_5":26803,"_10604":43554,"_1869":43853},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3805":1429,"_26541":1320,"_22543":43855,"_5":26803,"_10604":43558,"_1869":43856},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3805":1430,"_26541":1320,"_22543":43858,"_5":26803,"_10604":43558,"_1869":43859},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3805":1431,"_26541":1320,"_22543":43861,"_5":26803,"_10604":43562,"_1869":43862},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3805":1432,"_26541":1320,"_22543":43864,"_5":26803,"_10604":43562,"_1869":43865},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3805":1433,"_26541":1320,"_22543":43867,"_5":26803,"_10604":43562,"_1869":43868},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3805":1434,"_26541":1320,"_22543":43870,"_5":26803,"_10604":43562,"_1869":43871},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3805":1435,"_26541":1320,"_22543":43873,"_5":26803,"_10604":43562,"_1869":43874},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3805":1436,"_26541":1320,"_22543":43876,"_5":26803,"_10604":43562,"_1869":43877},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3805":1437,"_26541":1320,"_22543":43879,"_5":26803,"_10604":43566,"_1869":43880},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3805":1438,"_26541":1320,"_22543":43882,"_5":26803,"_10604":43570,"_1869":43883},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3805":1439,"_26541":1320,"_22543":43885,"_5":26803,"_10604":43570,"_1869":43886},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3805":1440,"_26541":1320,"_22543":43888,"_5":26803,"_10604":43573,"_1869":43889},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3805":1441,"_26541":1320,"_22543":43891,"_5":26803,"_10604":43577,"_1869":43892},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3805":1442,"_26541":1320,"_22543":43894,"_5":26803,"_10604":43577,"_1869":43895},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3805":1443,"_26541":1320,"_22543":43897,"_5":26803,"_10604":43577,"_1869":43898},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3805":1444,"_26541":1320,"_22543":43900,"_5":26803,"_10604":43577,"_1869":43901},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3805":1445,"_26541":1320,"_22543":43903,"_5":26803,"_10604":43577,"_1869":43904},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3805":1446,"_26541":1320,"_22543":43906,"_5":26803,"_10604":43577,"_1869":43907},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3805":1447,"_26541":1320,"_22543":43909,"_5":26803,"_10604":43581,"_1869":43910},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3805":1448,"_26541":1320,"_22543":43912,"_5":26803,"_10604":43581,"_1869":43913},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3805":1449,"_26541":1320,"_22543":43915,"_5":26803,"_10604":43581,"_1869":43916},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3805":1450,"_26541":1320,"_22543":43918,"_5":26803,"_10604":43585,"_1869":43919},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3805":1451,"_26541":1320,"_22543":43921,"_5":26803,"_10604":43585,"_1869":43922},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3805":1452,"_26541":1320,"_22543":43924,"_5":26803,"_10604":43585,"_1869":43925},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3805":1453,"_26541":1320,"_22543":43927,"_5":26803,"_10604":43589,"_1869":43928},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3805":1454,"_26541":1320,"_22543":43930,"_5":26803,"_10604":43589,"_1869":43931},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3805":1455,"_26541":1320,"_22543":43933,"_5":26803,"_10604":43589,"_1869":43934},[],"Para que el flujo JITP funcione correctamente:",{"_3805":1456,"_26541":1320,"_22543":43936,"_5":26803,"_10604":43589,"_1869":43937},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3805":1457,"_26541":1320,"_22543":43939,"_5":26803,"_10604":43589,"_1869":43940},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3805":1458,"_26541":1320,"_22543":43942,"_5":26803,"_10604":43589,"_1869":43943},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3805":1459,"_26541":1320,"_22543":43945,"_5":26803,"_10604":43589,"_1869":43946},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3805":1460,"_26541":1320,"_22543":43948,"_5":26803,"_10604":43593,"_1869":43949},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3805":1461,"_26541":1320,"_22543":43951,"_5":26803,"_10604":43593,"_1869":43952},[],"Estado en Lamassu",{"_3805":1462,"_26541":1320,"_22543":43954,"_5":26803,"_10604":43593,"_1869":43955},[],"Razón de revocación",{"_3805":1463,"_26541":1320,"_22543":43957,"_5":26803,"_10604":43593,"_1869":43958},[],"Estado en AWS IoT Core",{"_3805":1464,"_26541":1320,"_22543":43960,"_5":26803,"_10604":43593,"_1869":43961},[],"`Active`",{"_3805":1465,"_26541":1320,"_22543":43963,"_5":26803,"_10604":43593,"_1869":43152},[],{"_3805":1466,"_26541":1320,"_22543":43965,"_5":26803,"_10604":43593,"_1869":43966},[],"`ACTIVE`",{"_3805":1467,"_26541":1320,"_22543":43968,"_5":26803,"_10604":43593,"_1869":43969},[],"`Revoked`",{"_3805":1468,"_26541":1320,"_22543":43971,"_5":26803,"_10604":43593,"_1869":43972},[],"`certificateHold`",{"_3805":1469,"_26541":1320,"_22543":43974,"_5":26803,"_10604":43593,"_1869":43975},[],"`INACTIVE`",{"_3805":1470,"_26541":1320,"_22543":43977,"_5":26803,"_10604":43593,"_1869":43969},[],{"_3805":1471,"_26541":1320,"_22543":43979,"_5":26803,"_10604":43593,"_1869":43980},[],"Cualquier otra razón",{"_3805":1472,"_26541":1320,"_22543":43982,"_5":26803,"_10604":43593,"_1869":43983},[],"`REVOKED`",{"_3805":1473,"_26541":1320,"_22543":43985,"_5":26803,"_10604":43593,"_1869":43986},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3805":1474,"_26541":1320,"_22543":43988,"_5":26803,"_10604":43597,"_1869":43989},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3805":1475,"_26541":1320,"_22543":43991,"_5":26803,"_10604":43597,"_1869":43992},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3805":1476,"_26541":1320,"_22543":43994,"_5":26803,"_10604":43597,"_1869":43995},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3805":1477,"_26541":1320,"_22543":43997,"_5":26803,"_10604":43601,"_1869":43998},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3805":1478,"_26541":1320,"_22543":44000,"_5":26803,"_10604":43601,"_1869":44001},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3805":1479,"_26541":1320,"_22543":44003,"_5":26803,"_10604":43605,"_1869":44004},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3805":1480,"_26541":1320,"_22543":44006,"_5":26803,"_10604":43605,"_1869":44007},[],"Existen dos tipos de acciones:",{"_3805":1481,"_26541":1320,"_22543":44009,"_5":26803,"_10604":43605,"_1869":44010},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3805":1482,"_26541":1320,"_22543":44012,"_5":26803,"_10604":43605,"_1869":44013},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3805":1483,"_26541":1320,"_22543":44015,"_5":26803,"_10604":43605,"_1869":44016},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3805":1484,"_26541":1320,"_22543":44018,"_5":26803,"_10604":43609,"_1869":44019},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3805":1485,"_26541":1320,"_22543":44021,"_5":26803,"_10604":43609,"_1869":44022},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3805":1486,"_26541":1320,"_22543":44024,"_5":26803,"_10604":43609,"_1869":44025},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3805":1487,"_26541":1320,"_22543":44027,"_5":26803,"_10604":43613,"_1869":44028},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3805":1488,"_26541":1320,"_22543":44030,"_5":26803,"_10604":43613,"_1869":44031},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3805":1489,"_26541":1320,"_22543":44033,"_5":26803,"_10604":43613,"_1869":44034},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3805":1490,"_26541":1320,"_22543":44036,"_5":26803,"_10604":43613,"_1869":44037},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3805":1491,"_26541":1320,"_22543":44039,"_5":26803,"_10604":43613,"_1869":44040},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3805":1492,"_26541":1320,"_22543":44042,"_5":26803,"_10604":43613,"_1869":44043},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3805":1493,"_26541":1320,"_22543":44045,"_5":26803,"_10604":43613,"_1869":44046},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3805":1494,"_26541":1320,"_22543":44048,"_5":26803,"_10604":43613,"_1869":44049},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3805":1495,"_26541":1320,"_22543":44051,"_5":26803,"_10604":43613,"_1869":44052},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3805":1496,"_26541":1320,"_22543":44054,"_5":26803,"_10604":43613,"_1869":44055},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3805":1497,"_26541":1320,"_22543":44057,"_5":26803,"_10604":43613,"_1869":44058},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3805":1498,"_26541":1320,"_22543":44060,"_5":26803,"_10604":43613,"_1869":44061},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3805":1499,"_26541":1320,"_22543":44063,"_5":26803,"_10604":43613,"_1869":44064},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3805":1500,"_26541":1320,"_22543":44066,"_5":26803,"_10604":43613,"_1869":44067},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3805":1501,"_26541":1320,"_22543":44069,"_5":26803,"_10604":43613,"_1869":44070},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3805":1502,"_26541":1320,"_22543":44072,"_5":26803,"_10604":43613,"_1869":44073},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3805":1503,"_26541":1320,"_22543":44075,"_5":26803,"_10604":43613,"_1869":44076},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3805":1504,"_26541":1320,"_22543":44078,"_5":26803,"_10604":43613,"_1869":44079},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3805":1505,"_26541":1320,"_22543":44081,"_5":26803,"_10604":43613,"_1869":44082},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_3805":1506,"_26541":1320,"_22543":44084,"_5":26803,"_10604":43613,"_1869":44085},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_3805":1507,"_26541":1320,"_22543":44087,"_5":26803,"_10604":43613,"_1869":44088},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3805":1508,"_26541":1508,"_5":26798,"_1869":44090,"_26811":44091,"_22543":44092,"_10604":1508},"Claves y motores criptográficos",[39375,40459,40937],[],{"_3805":1509,"_26541":1508,"_22543":44094,"_5":26803,"_10604":1508,"_1869":44095},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3805":1510,"_26541":1508,"_5":26808,"_22543":44097,"_10604":44098,"_1869":44099},[],"/docs/pr-preview/pr-27/platform/pki/key-management#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_3805":1511,"_26541":1508,"_5":26808,"_22543":44101,"_10604":44102,"_1869":44103},[],"/docs/pr-preview/pr-27/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3805":1512,"_26541":1508,"_5":26808,"_22543":44105,"_10604":44106,"_1869":44107},[],"/docs/pr-preview/pr-27/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3805":1513,"_26541":1508,"_5":26808,"_22543":44109,"_10604":44110,"_1869":44111},[],"/docs/pr-preview/pr-27/platform/pki/key-management#file-system","File System",{"_3805":1514,"_26541":1508,"_5":26808,"_22543":44113,"_10604":44114,"_1869":44115},[],"/docs/pr-preview/pr-27/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3805":1515,"_26541":1508,"_5":26808,"_22543":44117,"_10604":44118,"_1869":44119},[],"/docs/pr-preview/pr-27/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3805":1516,"_26541":1508,"_5":26808,"_22543":44121,"_10604":44122,"_1869":44123},[],"/docs/pr-preview/pr-27/platform/pki/key-management#aws-kms","AWS KMS",{"_3805":1517,"_26541":1508,"_5":26808,"_22543":44125,"_10604":44126,"_1869":44127},[],"/docs/pr-preview/pr-27/platform/pki/key-management#pkcs11","PKCS#11",{"_3805":1518,"_26541":1508,"_5":26808,"_22543":44129,"_10604":44130,"_1869":44131},[],"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3805":1519,"_26541":1508,"_5":26808,"_22543":44133,"_10604":44134,"_1869":44135},[],"/docs/pr-preview/pr-27/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3805":1520,"_26541":1508,"_5":26808,"_22543":44137,"_10604":44138,"_1869":44139},[],"/docs/pr-preview/pr-27/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3805":1521,"_26541":1508,"_5":26808,"_22543":44141,"_10604":44142,"_1869":44143},[],"/docs/pr-preview/pr-27/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3805":1522,"_26541":1508,"_5":26808,"_22543":44145,"_10604":44146,"_1869":44147},[],"/docs/pr-preview/pr-27/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3805":1523,"_26541":1508,"_5":26808,"_22543":44149,"_10604":44150,"_1869":44151},[],"/docs/pr-preview/pr-27/platform/pki/key-management#ver-detalles","Ver detalles",{"_3805":1524,"_26541":1508,"_5":26808,"_22543":44153,"_10604":44154,"_1869":44155},[],"/docs/pr-preview/pr-27/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3805":1525,"_26541":1508,"_5":26808,"_22543":44157,"_10604":44158,"_1869":44159},[],"/docs/pr-preview/pr-27/platform/pki/key-management#sign","Sign",{"_3805":1526,"_26541":1508,"_5":26808,"_22543":44161,"_10604":44162,"_1869":44163},[],"/docs/pr-preview/pr-27/platform/pki/key-management#verify","Verify",{"_3805":1527,"_26541":1508,"_5":26808,"_22543":44165,"_10604":44166,"_1869":44167},[],"/docs/pr-preview/pr-27/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3805":1528,"_26541":1508,"_5":26808,"_22543":44169,"_10604":44170,"_1869":44171},[],"/docs/pr-preview/pr-27/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3805":1529,"_26541":1508,"_22543":44173,"_5":26803,"_10604":44098,"_1869":44174},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3805":1530,"_26541":1508,"_22543":44176,"_5":26803,"_10604":44098,"_1869":44177},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3805":1531,"_26541":1508,"_22543":44179,"_5":26803,"_10604":44102,"_1869":44180},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3805":1532,"_26541":1508,"_22543":44182,"_5":26803,"_10604":44102,"_1869":44183},[],"En la práctica, permite:",{"_3805":1533,"_26541":1508,"_22543":44185,"_5":26803,"_10604":44102,"_1869":44186},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3805":1534,"_26541":1508,"_22543":44188,"_5":26803,"_10604":44102,"_1869":44189},[],"Importar claves creadas externamente.",{"_3805":1535,"_26541":1508,"_22543":44191,"_5":26803,"_10604":44102,"_1869":44192},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3805":1536,"_26541":1508,"_22543":44194,"_5":26803,"_10604":44102,"_1869":44195},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3805":1537,"_26541":1508,"_22543":44197,"_5":26803,"_10604":44106,"_1869":44198},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3805":1538,"_26541":1508,"_22543":44200,"_5":26803,"_10604":44106,"_1869":44201},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3805":1539,"_26541":1508,"_22543":44203,"_5":26803,"_10604":44106,"_1869":44204},[],"Actualmente, Lamassu soporta cinco tipos de motor. Elige según el nivel de aislamiento que necesites y quién debe poder acceder al material privado.",{"_3805":1540,"_26541":1508,"_22543":44206,"_5":26803,"_10604":44110,"_1869":44207},[],"Genera las claves con las librerías criptográficas de Go y delega su protección en el sistema de archivos. Funciona tanto on-premise como en cloud, pero no evita la extracción de la clave y no está recomendado para producción.",{"_3805":1541,"_26541":1508,"_22543":44209,"_5":26803,"_10604":44114,"_1869":44210},[],"Protege las claves en reposo y puede ejecutarse on-premise o en cloud. Un administrador con permisos suficientes todavía puede visualizar el material privado, por lo que conviene limitar el acceso administrativo y custodiar las claves de *unseal*.",{"_3805":1542,"_26541":1508,"_22543":44212,"_5":26803,"_10604":44118,"_1869":44213},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3805":1543,"_26541":1508,"_22543":44215,"_5":26803,"_10604":44122,"_1869":44216},[],"Genera las claves con entropía hardware y no expone la clave privada. Las operaciones se ejecutan dentro del servicio. Aun así, una identidad con permisos suficientes podría utilizar la clave para firmar, por lo que la política IAM sigue siendo crítica.",{"_3805":1544,"_26541":1508,"_22543":44218,"_5":26803,"_10604":44126,"_1869":44219},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3805":1545,"_26541":1508,"_22543":44221,"_5":26803,"_10604":44126,"_1869":44222},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_3805":1546,"_26541":1508,"_22543":44224,"_5":26803,"_10604":44126,"_1869":44225},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3805":1547,"_26541":1508,"_22543":44227,"_5":26803,"_10604":44126,"_1869":44228},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3805":1548,"_26541":1508,"_22543":44230,"_5":26803,"_10604":44130,"_1869":44231},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3805":1549,"_26541":1508,"_22543":44233,"_5":26803,"_10604":44130,"_1869":44234},[],"La tabla incluye los siguientes campos:",{"_3805":1550,"_26541":1508,"_22543":44236,"_5":26803,"_10604":44130,"_1869":44237},[],"**Name**: nombre descriptivo de la clave.",{"_3805":1551,"_26541":1508,"_22543":44239,"_5":26803,"_10604":44130,"_1869":44240},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3805":1552,"_26541":1508,"_22543":44242,"_5":26803,"_10604":44130,"_1869":44243},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3805":1553,"_26541":1508,"_22543":44245,"_5":26803,"_10604":44130,"_1869":44246},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3805":1554,"_26541":1508,"_22543":44248,"_5":26803,"_10604":44130,"_1869":44249},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3805":1555,"_26541":1508,"_22543":44251,"_5":26803,"_10604":44130,"_1869":44252},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3805":1556,"_26541":1508,"_22543":44254,"_5":26803,"_10604":44130,"_1869":44255},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3805":1557,"_26541":1508,"_22543":44257,"_5":26803,"_10604":44130,"_1869":44258},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3805":1558,"_26541":1508,"_22543":44260,"_5":26803,"_10604":44130,"_1869":44261},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3805":1559,"_26541":1508,"_22543":44263,"_5":26803,"_10604":44130,"_1869":44264},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3805":1560,"_26541":1508,"_22543":44266,"_5":26803,"_10604":44130,"_1869":44267},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3805":1561,"_26541":1508,"_22543":44269,"_5":26803,"_10604":44130,"_1869":44270},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3805":1562,"_26541":1508,"_22543":44272,"_5":26803,"_10604":44130,"_1869":44273},[],"**Delete Key** para eliminar la clave del sistema.",{"_3805":1563,"_26541":1508,"_22543":44275,"_5":26803,"_10604":44134,"_1869":44276},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_3805":1564,"_26541":1508,"_22543":44278,"_5":26803,"_10604":44138,"_1869":44279},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3805":1565,"_26541":1508,"_22543":44281,"_5":26803,"_10604":44138,"_1869":44282},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_3805":1566,"_26541":1508,"_22543":44284,"_5":26803,"_10604":44138,"_1869":44285},[],"**Key Name**: nombre único y descriptivo.",{"_3805":1567,"_26541":1508,"_22543":44287,"_5":26803,"_10604":44138,"_1869":44288},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3805":1568,"_26541":1508,"_22543":44290,"_5":26803,"_10604":44138,"_1869":44291},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3805":1569,"_26541":1508,"_22543":44293,"_5":26803,"_10604":44138,"_1869":44294},[],"**Tags**: metadatos para clasificar la clave.",{"_3805":1570,"_26541":1508,"_22543":44296,"_5":26803,"_10604":44138,"_1869":44297},[],"**Metadata**: información adicional para usos avanzados.",{"_3805":1571,"_26541":1508,"_22543":44299,"_5":26803,"_10604":44142,"_1869":44300},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3805":1572,"_26541":1508,"_22543":44302,"_5":26803,"_10604":44142,"_1869":44303},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_3805":1573,"_26541":1508,"_22543":44305,"_5":26803,"_10604":44142,"_1869":44306},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3805":1574,"_26541":1508,"_22543":44308,"_5":26803,"_10604":44142,"_1869":44309},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3805":1575,"_26541":1508,"_22543":44311,"_5":26803,"_10604":44142,"_1869":44312},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_3805":1576,"_26541":1508,"_22543":44314,"_5":26803,"_10604":44142,"_1869":44315},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3805":1577,"_26541":1508,"_22543":44317,"_5":26803,"_10604":44142,"_1869":44318},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3805":1578,"_26541":1508,"_22543":44320,"_5":26803,"_10604":44142,"_1869":44321},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3805":1579,"_26541":1508,"_22543":44323,"_5":26803,"_10604":44142,"_1869":44324},[],"**Metadata**: información adicional opcional.",{"_3805":1580,"_26541":1508,"_22543":44326,"_5":26803,"_10604":44142,"_1869":44327},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3805":1581,"_26541":1508,"_22543":44329,"_5":26803,"_10604":44142,"_1869":44330},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_3805":1582,"_26541":1508,"_22543":44332,"_5":26803,"_10604":44146,"_1869":44333},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3805":1583,"_26541":1508,"_22543":44335,"_5":26803,"_10604":44150,"_1869":44336},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3805":1584,"_26541":1508,"_22543":44338,"_5":26803,"_10604":44150,"_1869":44339},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3805":1585,"_26541":1508,"_22543":44341,"_5":26803,"_10604":44150,"_1869":44342},[],"**Key Name**: nombre descriptivo.",{"_3805":1586,"_26541":1508,"_22543":44344,"_5":26803,"_10604":44150,"_1869":44345},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3805":1587,"_26541":1508,"_22543":44347,"_5":26803,"_10604":44150,"_1869":44348},[],"**Tags**: etiquetas asociadas.",{"_3805":1588,"_26541":1508,"_22543":44350,"_5":26803,"_10604":44150,"_1869":44351},[],"**Aliases**: nombres alternativos.",{"_3805":1589,"_26541":1508,"_22543":44353,"_5":26803,"_10604":44150,"_1869":44354},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3805":1590,"_26541":1508,"_22543":44356,"_5":26803,"_10604":44150,"_1869":44357},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3805":1591,"_26541":1508,"_22543":44359,"_5":26803,"_10604":44150,"_1869":44360},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3805":1592,"_26541":1508,"_22543":44362,"_5":26803,"_10604":44150,"_1869":44363},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_3805":1593,"_26541":1508,"_22543":44365,"_5":26803,"_10604":44154,"_1869":44366},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3805":1594,"_26541":1508,"_22543":44368,"_5":26803,"_10604":44154,"_1869":44369},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3805":1595,"_26541":1508,"_22543":44371,"_5":26803,"_10604":44158,"_1869":44372},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3805":1596,"_26541":1508,"_22543":44374,"_5":26803,"_10604":44158,"_1869":44375},[],"Campos principales:",{"_3805":1597,"_26541":1508,"_22543":44377,"_5":26803,"_10604":44158,"_1869":44378},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3805":1598,"_26541":1508,"_22543":44380,"_5":26803,"_10604":44158,"_1869":44381},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3805":1599,"_26541":1508,"_22543":44383,"_5":26803,"_10604":44158,"_1869":44384},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3805":1600,"_26541":1508,"_22543":44386,"_5":26803,"_10604":44158,"_1869":44387},[],"**Message**: contenido que se va a firmar.",{"_3805":1601,"_26541":1508,"_22543":44389,"_5":26803,"_10604":44158,"_1869":44390},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3805":1602,"_26541":1508,"_22543":44392,"_5":26803,"_10604":44162,"_1869":44393},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3805":1603,"_26541":1508,"_22543":44395,"_5":26803,"_10604":44162,"_1869":44375},[],{"_3805":1604,"_26541":1508,"_22543":44397,"_5":26803,"_10604":44162,"_1869":44398},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3805":1605,"_26541":1508,"_22543":44400,"_5":26803,"_10604":44162,"_1869":44401},[],"**Message Type**: `Raw` o `Digest`.",{"_3805":1606,"_26541":1508,"_22543":44403,"_5":26803,"_10604":44162,"_1869":44404},[],"**Payload Encoding**: codificación del mensaje.",{"_3805":1607,"_26541":1508,"_22543":44406,"_5":26803,"_10604":44162,"_1869":44407},[],"**Message**: mensaje original o hash.",{"_3805":1608,"_26541":1508,"_22543":44409,"_5":26803,"_10604":44162,"_1869":44410},[],"**Signature**: firma que se desea comprobar.",{"_3805":1609,"_26541":1508,"_22543":44412,"_5":26803,"_10604":44162,"_1869":44413},[],"**Result**: indicador del resultado de la validación.",{"_3805":1610,"_26541":1508,"_22543":44415,"_5":26803,"_10604":44166,"_1869":44416},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3805":1611,"_26541":1508,"_22543":44418,"_5":26803,"_10604":44166,"_1869":44419},[],"Este flujo es útil para:",{"_3805":1612,"_26541":1508,"_22543":44421,"_5":26803,"_10604":44166,"_1869":44422},[],"Solicitar certificados a una CA externa.",{"_3805":1613,"_26541":1508,"_22543":44424,"_5":26803,"_10604":44166,"_1869":44425},[],"Renovar una identidad manteniendo la misma clave.",{"_3805":1614,"_26541":1508,"_22543":44427,"_5":26803,"_10604":44166,"_1869":44428},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3805":1615,"_26541":1508,"_22543":44430,"_5":26803,"_10604":44166,"_1869":44431},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3805":1616,"_26541":1508,"_22543":44433,"_5":26803,"_10604":44166,"_1869":44434},[],"**Organization (O)**: organización o empresa.",{"_3805":1617,"_26541":1508,"_22543":44436,"_5":26803,"_10604":44166,"_1869":44437},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3805":1618,"_26541":1508,"_22543":44439,"_5":26803,"_10604":44166,"_1869":44440},[],"**Country (C)**: código de país de dos letras.",{"_3805":1619,"_26541":1508,"_22543":44442,"_5":26803,"_10604":44166,"_1869":44443},[],"**State / Province (ST)**: estado o provincia.",{"_3805":1620,"_26541":1508,"_22543":44445,"_5":26803,"_10604":44166,"_1869":44446},[],"**Locality (L)**: ciudad o localidad.",{"_3805":1621,"_26541":1508,"_22543":44448,"_5":26803,"_10604":44166,"_1869":44449},[],"**Email Address**: correo de contacto.",{"_3805":1622,"_26541":1508,"_22543":44451,"_5":26803,"_10604":44166,"_1869":44452},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3805":1623,"_26541":1508,"_22543":44454,"_5":26803,"_10604":44166,"_1869":44455},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_3805":1624,"_26541":1508,"_22543":44457,"_5":26803,"_10604":44170,"_1869":44458},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3805":1625,"_26541":1508,"_22543":44460,"_5":26803,"_10604":44170,"_1869":44461},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_3805":1626,"_26541":1626,"_5":26798,"_1869":44463,"_26811":44464,"_22543":44465,"_10604":1626},"Validación online con OCSP",[39375,40459,40937],[],{"_3805":1627,"_26541":1626,"_22543":44467,"_5":26803,"_10604":1626,"_1869":44468},[],"Consulta en tiempo real si un certificado sigue vigente o se ha revocado.",{"_3805":1628,"_26541":1626,"_5":26808,"_22543":44470,"_10604":44471,"_1869":44472},[],"/docs/pr-preview/pr-27/platform/pki/ocsp#servicio-ocsp","Servicio OCSP",{"_3805":1629,"_26541":1626,"_5":26808,"_22543":44474,"_10604":44475,"_1869":44476},[],"/docs/pr-preview/pr-27/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3805":1630,"_26541":1626,"_5":26808,"_22543":44478,"_10604":44479,"_1869":44480},[],"/docs/pr-preview/pr-27/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3805":1631,"_26541":1626,"_5":26808,"_22543":44482,"_10604":44483,"_1869":44484},[],"/docs/pr-preview/pr-27/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3805":1632,"_26541":1626,"_5":26808,"_22543":44486,"_10604":44487,"_1869":44488},[],"/docs/pr-preview/pr-27/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3805":1633,"_26541":1626,"_5":26808,"_22543":44490,"_10604":44491,"_1869":42429},[],"/docs/pr-preview/pr-27/platform/pki/ocsp#referencias",{"_3805":1634,"_26541":1626,"_22543":44493,"_5":26803,"_10604":44471,"_1869":44494},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_3805":1635,"_26541":1626,"_22543":44496,"_5":26803,"_10604":44471,"_1869":44497},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_3805":1636,"_26541":1626,"_22543":44499,"_5":26803,"_10604":44475,"_1869":44500},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_3805":1637,"_26541":1626,"_22543":44502,"_5":26803,"_10604":44475,"_1869":44503},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_3805":1638,"_26541":1626,"_22543":44505,"_5":26803,"_10604":44475,"_1869":44506},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_3805":1639,"_26541":1626,"_22543":44508,"_5":26803,"_10604":44475,"_1869":44509},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_3805":1640,"_26541":1626,"_22543":44511,"_5":26803,"_10604":44475,"_1869":44512},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_3805":1641,"_26541":1626,"_22543":44514,"_5":26803,"_10604":44475,"_1869":44515},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_3805":1642,"_26541":1626,"_22543":44517,"_5":26803,"_10604":44479,"_1869":44518},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_3805":1643,"_26541":1626,"_22543":44520,"_5":26803,"_10604":44483,"_1869":44521},[],"El respondedor acepta los dos formatos definidos en RFC 6960:",{"_3805":1644,"_26541":1626,"_22543":44523,"_5":26803,"_10604":44483,"_1869":44524},[],"`GET /ocsp/{ocsp_request}` incluye la petición OCSP codificada en Base64url dentro de la propia URL.",{"_3805":1645,"_26541":1626,"_22543":44526,"_5":26803,"_10604":44483,"_1869":44527},[],"`POST /ocsp` envía la petición en el cuerpo con `Content-Type: application/ocsp-request`.",{"_3805":1646,"_26541":1626,"_22543":44529,"_5":26803,"_10604":44483,"_1869":44530},[],"Ejemplo de consulta con `curl` mediante POST:",{"_3805":1647,"_26541":1626,"_22543":44532,"_5":26803,"_10604":44483,"_1869":44533},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_3805":1648,"_26541":1626,"_22543":44535,"_5":26803,"_10604":44487,"_1869":44536},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_3805":1649,"_26541":1626,"_22543":44538,"_5":26803,"_10604":44491,"_1869":44539},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_3805":1650,"_26541":1626,"_22543":44541,"_5":26803,"_10604":44491,"_1869":44542},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_3805":1651,"_26541":1626,"_22543":44544,"_5":26803,"_10604":44491,"_1869":44545},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3805":1652,"_26541":1626,"_22543":44547,"_5":26803,"_10604":44491,"_1869":42520},[],{"_3805":1653,"_26541":1653,"_5":26798,"_1869":44549,"_26811":44550,"_22543":44551,"_10604":1653},"Plataforma Lamassu IoT",[39375,40459],[],{"_3805":1654,"_26541":1653,"_22543":44553,"_5":26803,"_10604":1653,"_1869":44554},[],"Gestiona la PKI y las identidades digitales de tus dispositivos desde una única plataforma.",{"_3805":1655,"_26541":1653,"_5":26808,"_22543":44556,"_10604":44557,"_1869":44558},[],"/docs/pr-preview/pr-27/platform/pki/overview#empieza-aquí","Empieza aquí",{"_3805":1656,"_26541":1653,"_5":26808,"_22543":44560,"_10604":44561,"_1869":44562},[],"/docs/pr-preview/pr-27/platform/pki/overview#capacidades-principales","Capacidades principales",{"_3805":1657,"_26541":1653,"_5":26808,"_22543":44564,"_10604":44565,"_1869":44566},[],"/docs/pr-preview/pr-27/platform/pki/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3805":1658,"_26541":1653,"_5":26808,"_22543":44568,"_10604":44569,"_1869":44570},[],"/docs/pr-preview/pr-27/platform/pki/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3805":1659,"_26541":1653,"_5":26808,"_22543":44572,"_10604":44573,"_1869":44574},[],"/docs/pr-preview/pr-27/platform/pki/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3805":1660,"_26541":1653,"_5":26808,"_22543":44576,"_10604":44577,"_1869":44578},[],"/docs/pr-preview/pr-27/platform/pki/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3805":1661,"_26541":1653,"_5":26808,"_22543":44580,"_10604":44581,"_1869":44582},[],"/docs/pr-preview/pr-27/platform/pki/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3805":1662,"_26541":1653,"_5":26808,"_22543":44584,"_10604":44585,"_1869":44586},[],"/docs/pr-preview/pr-27/platform/pki/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3805":1663,"_26541":1653,"_5":26808,"_22543":44588,"_10604":44589,"_1869":44590},[],"/docs/pr-preview/pr-27/platform/pki/overview#elige-tu-recorrido","Elige tu recorrido",{"_3805":1664,"_26541":1653,"_5":26808,"_22543":44592,"_10604":44593,"_1869":44594},[],"/docs/pr-preview/pr-27/platform/pki/overview#referencia-operativa","Referencia operativa",{"_3805":1665,"_26541":1653,"_22543":44596,"_5":26803,"_10604":1653,"_1869":44597},[],"Lamassu IoT centraliza la emisión, distribución, renovación y revocación de identidades X.509 para dispositivos conectados. Puedes construir una PKI privada, proteger sus claves y automatizar el enrolamiento de una flota sin perder visibilidad sobre cada certificado.",{"_3805":1666,"_26541":1653,"_22543":44599,"_5":26803,"_10604":44557,"_1869":44600},[],"<Card title=\"Primeros pasos\" description=\"Crea una CA, emite un certificado y registra tu primer dispositivo.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3805":1667,"_26541":1653,"_22543":44602,"_5":26803,"_10604":44557,"_1869":44603},[],"<Card title=\"Cómo funciona Lamassu\" description=\"Construye el modelo mental de autoridades, claves, identidades y validación.\" href=\"/docs/platform/pki/concepts/overview\" />",{"_3805":1668,"_26541":1653,"_22543":44605,"_5":26803,"_10604":44565,"_1869":44606},[],"Crea autoridades raíz e intermedias o importa una PKI existente. Define qué autoridad puede emitir cada identidad y conserva la cadena de confianza completa.",{"_3805":1669,"_26541":1653,"_22543":44608,"_5":26803,"_10604":44569,"_1869":44609},[],"Genera y custodia claves mediante motores software, HSMs PKCS#11 o servicios cloud. Lamassu desacopla las operaciones de la ubicación física de la clave.",{"_3805":1670,"_26541":1653,"_22543":44611,"_5":26803,"_10604":44573,"_1869":44612},[],"Emite certificados desde la consola o a partir de un CSR, consulta su estado y revócalos cuando dejan de ser fiables.",{"_3805":1671,"_26541":1653,"_22543":44614,"_5":26803,"_10604":44577,"_1869":44615},[],"Define políticas de enrolamiento mediante un Device Management Service (DMS) y deja que los dispositivos soliciten o renueven su identidad a través de EST.",{"_3805":1672,"_26541":1653,"_22543":44617,"_5":26803,"_10604":44581,"_1869":44618},[],"Ofrece validación online mediante OCSP y distribuye CRLs para consumidores que necesitan comprobar certificados sin conexión.",{"_3805":1673,"_26541":1653,"_22543":44620,"_5":26803,"_10604":44585,"_1869":44621},[],"Suscríbete a cambios del ciclo de vida y envía notificaciones por correo, Microsoft Teams o webhooks.",{"_3805":1674,"_26541":1653,"_22543":44623,"_5":26803,"_10604":44589,"_1869":44624},[],"<Card title=\"Administro la PKI\" description=\"Configura motores, autoridades, emisión y validación.\" href=\"/docs/platform/pki/key-management\" />",{"_3805":1675,"_26541":1653,"_22543":44626,"_5":26803,"_10604":44589,"_1869":44627},[],"<Card title=\"Integro un dispositivo\" description=\"Configura el DMS y usa EST para obtener una identidad.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_3805":1676,"_26541":1653,"_22543":44629,"_5":26803,"_10604":44589,"_1869":44630},[],"<Card title=\"Opero la plataforma\" description=\"Despliega Lamassu y prepara sus dependencias.\" href=\"/docs/deployment/overview\" />",{"_3805":1677,"_26541":1653,"_22543":44632,"_5":26803,"_10604":44589,"_1869":44633},[],"<Card title=\"Integro otro sistema\" description=\"Conecta Lamassu con AWS IoT Core y otros destinos.\" href=\"/docs/platform/pki/integrations/aws-iot-core\" />",{"_3805":1678,"_26541":1653,"_22543":44635,"_5":26803,"_10604":44593,"_1869":44636},[],"<Card title=\"Perfiles de certificado\" description=\"Convierte la política de emisión en restricciones reutilizables.\" href=\"/docs/platform/pki/certificate-profiles\" />",{"_3805":1679,"_26541":1653,"_22543":44638,"_5":26803,"_10604":44593,"_1869":44639},[],"<Card title=\"Jerarquía y rotación\" description=\"Sustituye certificados o claves de CA sin romper la confianza.\" href=\"/docs/platform/pki/ca-hierarchy-and-rotation\" />",{"_3805":1680,"_26541":1653,"_22543":44641,"_5":26803,"_10604":44593,"_1869":44642},[],"<Card title=\"Control de acceso\" description=\"Configura principales, políticas y el primer administrador.\" href=\"/docs/platform/pki/access-control\" />",{"_3805":1681,"_26541":1653,"_22543":44644,"_5":26803,"_10604":44593,"_1869":44645},[],"<Card title=\"Resolución de problemas\" description=\"Diagnostica Gateway, servicios, emisión y enrolamiento.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3805":1682,"_26541":1682,"_5":26798,"_1869":44647,"_26811":44648,"_22543":44650,"_10604":1682},"Crea tu primera CA",[39375,40459,44649],"Primeros pasos",[],{"_3805":1683,"_26541":1682,"_22543":44652,"_5":26803,"_10604":1682,"_1869":44653},[],"Crea una autoridad raíz y comprueba que está preparada para emitir certificados.",{"_3805":1684,"_26541":1682,"_5":26808,"_22543":44655,"_10604":44656,"_1869":39385},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3805":1685,"_26541":1682,"_5":26808,"_22543":44658,"_10604":44659,"_1869":44660},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3805":1686,"_26541":1682,"_5":26808,"_22543":44662,"_10604":44663,"_1869":44664},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3805":1687,"_26541":1682,"_5":26808,"_22543":44666,"_10604":44667,"_1869":44668},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3805":1688,"_26541":1682,"_5":26808,"_22543":44670,"_10604":44671,"_1869":44672},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3805":1689,"_26541":1682,"_5":26808,"_22543":44674,"_10604":44675,"_1869":44676},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3805":1690,"_26541":1682,"_5":26808,"_22543":44678,"_10604":44679,"_1869":39409},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3805":1691,"_26541":1682,"_22543":44681,"_5":26803,"_10604":1682,"_1869":44682},[],"En este quickstart crearás una autoridad de certificación raíz con un nuevo par de claves. Al terminar tendrás una CA activa que podrás usar en el siguiente quickstart.",{"_3805":1692,"_26541":1682,"_22543":44684,"_5":26803,"_10604":44656,"_1869":44685},[],"Acceso a la consola con permisos para gestionar autoridades.",{"_3805":1693,"_26541":1682,"_22543":44687,"_5":26803,"_10604":44656,"_1869":44688},[],"Al menos un motor criptográfico disponible.",{"_3805":1694,"_26541":1682,"_22543":44690,"_5":26803,"_10604":44656,"_1869":44691},[],"Un nombre que identifique el propósito de la CA, por ejemplo `Acme Device Root CA`.",{"_3805":1695,"_26541":1682,"_22543":44693,"_5":26803,"_10604":44656,"_1869":44694},[],"Una CA raíz se autofirma y actúa como ancla de confianza. Para producción suele ser preferible mantener la raíz más protegida y emitir desde una CA intermedia.",{"_3805":1696,"_26541":1682,"_22543":44696,"_5":26803,"_10604":44659,"_1869":44697},[],"En el menú lateral, abre **Certification Authorities** y selecciona **Create New CA**.",{"_3805":1697,"_26541":1682,"_22543":44699,"_5":26803,"_10604":44659,"_1869":44700},[],"Elige crear una CA con un par de claves nuevo. Si ya tienes la clave en el KMS, usa &#x2A;*Create New CA (Existing Key)**.",{"_3805":1698,"_26541":1682,"_22543":44702,"_5":26803,"_10604":44663,"_1869":44703},[],"Elige el motor criptográfico que custodiará la clave y configura el algoritmo. Para una primera CA puedes usar **EC P-384**, siempre que sea compatible con tus consumidores.",{"_3805":1699,"_26541":1682,"_22543":44705,"_5":26803,"_10604":44663,"_1869":44706},[],"La clave privada permanecerá bajo el control del motor seleccionado.",{"_3805":1700,"_26541":1682,"_22543":44708,"_5":26803,"_10604":44667,"_1869":44709},[],"Selecciona **Root CA** y completa:",{"_3805":1701,"_26541":1682,"_22543":44711,"_5":26803,"_10604":44667,"_1869":44712},[],"**CA Name**: un nombre único y reconocible.",{"_3805":1702,"_26541":1682,"_22543":44714,"_5":26803,"_10604":44667,"_1869":44715},[],"**Subject**: al menos la organización y el país que identificarán a la autoridad.",{"_3805":1703,"_26541":1682,"_22543":44717,"_5":26803,"_10604":44667,"_1869":44718},[],"**CA Certificate Expiration**: una validez mayor que la de los certificados que emitirá.",{"_3805":1704,"_26541":1682,"_22543":44720,"_5":26803,"_10604":44667,"_1869":44721},[],"**Default End-Entity Certificate Issuance Expiration**: la validez predeterminada de los certificados finales.",{"_3805":1705,"_26541":1682,"_22543":44723,"_5":26803,"_10604":44667,"_1869":44724},[],"El nombre de la CA se utilizará como `Common Name` del certificado.",{"_3805":1706,"_26541":1682,"_22543":44726,"_5":26803,"_10604":44671,"_1869":44727},[],"Comprueba el algoritmo, el sujeto y las fechas antes de confirmar. Estos valores definen el ancla de confianza y no deberían elegirse como simples datos de prueba en un entorno productivo.",{"_3805":1707,"_26541":1682,"_22543":44729,"_5":26803,"_10604":44675,"_1869":44730},[],"Abre la nueva CA desde el listado. Debe aparecer activa y mostrar su certificado PEM, la fecha de expiración y la pestaña **Issued Certificates**.",{"_3805":1708,"_26541":1682,"_22543":44732,"_5":26803,"_10604":44679,"_1869":44733},[],"Usa la autoridad para emitir tu primer certificado, o consulta la guía completa de autoridades para crear una CA intermedia, importar una CA o definir perfiles avanzados.",{"_3805":1709,"_26541":1709,"_5":26798,"_1869":44735,"_26811":44736,"_22543":44737,"_10604":1709},"Emite tu primer certificado",[39375,40459,44649],[],{"_3805":1710,"_26541":1709,"_22543":44739,"_5":26803,"_10604":1709,"_1869":44740},[],"Emite una identidad X.509 desde la consola y verifica el resultado.",{"_3805":1711,"_26541":1709,"_5":26808,"_22543":44742,"_10604":44743,"_1869":39385},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3805":1712,"_26541":1709,"_5":26808,"_22543":44745,"_10604":44746,"_1869":44747},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3805":1713,"_26541":1709,"_5":26808,"_22543":44749,"_10604":44750,"_1869":44751},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3805":1714,"_26541":1709,"_5":26808,"_22543":44753,"_10604":44754,"_1869":44755},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3805":1715,"_26541":1709,"_5":26808,"_22543":44757,"_10604":44758,"_1869":44759},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3805":1716,"_26541":1709,"_5":26808,"_22543":44761,"_10604":44762,"_1869":44763},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3805":1717,"_26541":1709,"_5":26808,"_22543":44765,"_10604":44766,"_1869":44676},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3805":1718,"_26541":1709,"_5":26808,"_22543":44768,"_10604":44769,"_1869":39409},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3805":1719,"_26541":1709,"_22543":44771,"_5":26803,"_10604":1709,"_1869":44772},[],"En este quickstart Lamassu generará la clave y el CSR en el navegador, y la CA emitirá el certificado. Al terminar descargarás el certificado y su clave privada.",{"_3805":1720,"_26541":1709,"_22543":44774,"_5":26803,"_10604":44743,"_1869":44775},[],"Una CA activa con permiso para emitir certificados.",{"_3805":1721,"_26541":1709,"_22543":44777,"_5":26803,"_10604":44743,"_1869":44778},[],"Un nombre para la identidad, por ejemplo `device-001.example.internal`.",{"_3805":1722,"_26541":1709,"_22543":44780,"_5":26803,"_10604":44743,"_1869":44781},[],"Un lugar seguro en el que custodiar la clave privada descargada.",{"_3805":1723,"_26541":1709,"_22543":44783,"_5":26803,"_10604":44743,"_1869":44784},[],"En este flujo la clave se genera en el navegador y Lamassu no la almacena. Descárgala y protégela antes de cerrar el resultado de la operación.",{"_3805":1724,"_26541":1709,"_22543":44786,"_5":26803,"_10604":44746,"_1869":44787},[],"Abre la CA creada en el quickstart anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3805":1725,"_26541":1709,"_22543":44789,"_5":26803,"_10604":44750,"_1869":44790},[],"Selecciona **Generate Key & CSR in Browser**. Usa **Upload Existing CSR** cuando la clave privada deba generarse y permanecer en el sistema de destino.",{"_3805":1726,"_26541":1709,"_22543":44792,"_5":26803,"_10604":44754,"_1869":44793},[],"Introduce el `Common Name` y, si corresponde, la organización, unidad organizativa y ubicación. Añade SANs para cada nombre DNS, dirección IP, correo o URI con el que se vaya a validar la identidad.",{"_3805":1727,"_26541":1709,"_22543":44795,"_5":26803,"_10604":44758,"_1869":44796},[],"Elige RSA o ECDSA, define la validez y selecciona los usos de clave. Para una identidad de dispositivo que usa mTLS, habilita **Digital Signature** y **Client Authentication**.",{"_3805":1728,"_26541":1709,"_22543":44798,"_5":26803,"_10604":44758,"_1869":44799},[],"La validez no puede superar la fecha de expiración de la CA emisora.",{"_3805":1729,"_26541":1709,"_22543":44801,"_5":26803,"_10604":44762,"_1869":44802},[],"Confirma la emisión y descarga inmediatamente el certificado y la clave privada en formato PEM.",{"_3805":1730,"_26541":1709,"_22543":44804,"_5":26803,"_10604":44766,"_1869":44805},[],"El certificado debe aparecer en **Issued Certificates** con estado activo. Comprueba su sujeto, SANs, emisor, usos y periodo de validez.",{"_3805":1731,"_26541":1709,"_22543":44807,"_5":26803,"_10604":44769,"_1869":44808},[],"Registra tu primer dispositivo para asociar la identidad a una entidad gestionada, o consulta la gestión de certificados.",{"_3805":1732,"_26541":1732,"_5":26798,"_1869":44649,"_26811":44810,"_22543":44811,"_10604":1732},[39375,40459,44649],[],{"_3805":1733,"_26541":1732,"_22543":44813,"_5":26803,"_10604":1732,"_1869":44814},[],"Obtén un primer resultado con Lamassu y continúa desde una base funcional.",{"_3805":1734,"_26541":1732,"_5":26808,"_22543":44816,"_10604":44817,"_1869":44818},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3805":1735,"_26541":1732,"_5":26808,"_22543":44820,"_10604":44821,"_1869":39385},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/overview#antes-de-empezar",{"_3805":1736,"_26541":1732,"_22543":44823,"_5":26803,"_10604":1732,"_1869":44824},[],"Los quickstarts te llevan desde una instancia preparada hasta una identidad de dispositivo activa. Cada guía produce un resultado verificable y enlaza la explicación detallada cuando necesitas ir más allá.",{"_3805":1737,"_26541":1732,"_22543":44826,"_5":26803,"_10604":44817,"_1869":44827},[],"<Card title=\"1. Crea tu primera CA\" description=\"Establece una raíz de confianza capaz de emitir certificados.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3805":1738,"_26541":1732,"_22543":44829,"_5":26803,"_10604":44817,"_1869":44830},[],"<Card title=\"2. Emite un certificado\" description=\"Crea una identidad X.509 y verifica su contenido.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3805":1739,"_26541":1732,"_22543":44832,"_5":26803,"_10604":44817,"_1869":44833},[],"<Card title=\"3. Registra un dispositivo\" description=\"Añade un dispositivo y asígnale su primera identidad.\" href=\"/docs/platform/pki/quickstarts/register-device\" />",{"_3805":1740,"_26541":1732,"_22543":44835,"_5":26803,"_10604":44821,"_1869":44836},[],"Necesitas acceso a la consola de Lamassu IoT y permisos para administrar claves, autoridades y dispositivos. La instancia debe tener al menos un motor criptográfico configurado.",{"_3805":1741,"_26541":1732,"_22543":44838,"_5":26803,"_10604":44821,"_1869":44839},[],"Si todavía no tienes una instancia, elige primero un modelo de despliegue.",{"_3805":1742,"_26541":1742,"_5":26798,"_1869":44841,"_26811":44842,"_22543":44843,"_10604":1742},"Registra tu primer dispositivo",[39375,40459,44649],[],{"_3805":1743,"_26541":1742,"_22543":44845,"_5":26803,"_10604":1742,"_1869":44846},[],"Añade un dispositivo a Lamassu y asígnale una identidad activa.",{"_3805":1744,"_26541":1742,"_5":26808,"_22543":44848,"_10604":44849,"_1869":39385},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/register-device#antes-de-empezar",{"_3805":1745,"_26541":1742,"_5":26808,"_22543":44851,"_10604":44852,"_1869":44853},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3805":1746,"_26541":1742,"_5":26808,"_22543":44855,"_10604":44856,"_1869":44857},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3805":1747,"_26541":1742,"_5":26808,"_22543":44859,"_10604":44860,"_1869":44861},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3805":1748,"_26541":1742,"_5":26808,"_22543":44863,"_10604":44864,"_1869":44865},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3805":1749,"_26541":1742,"_5":26808,"_22543":44867,"_10604":44868,"_1869":44869},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3805":1750,"_26541":1742,"_22543":44871,"_5":26803,"_10604":1742,"_1869":44872},[],"En este quickstart registrarás manualmente un dispositivo y le asignarás su primer certificado. Es el recorrido más corto para entender cómo Lamassu relaciona una entidad física con su historial de identidades.",{"_3805":1751,"_26541":1742,"_22543":44874,"_5":26803,"_10604":44849,"_1869":44875},[],"Un DMS configurado.",{"_3805":1752,"_26541":1742,"_22543":44877,"_5":26803,"_10604":44849,"_1869":44878},[],"Una CA asociada al DMS.",{"_3805":1753,"_26541":1742,"_22543":44880,"_5":26803,"_10604":44849,"_1869":44881},[],"Un identificador único para el dispositivo.",{"_3805":1754,"_26541":1742,"_22543":44883,"_5":26803,"_10604":44852,"_1869":44884},[],"Abre **Managed Devices**, selecciona la acción para registrar un dispositivo y completa:",{"_3805":1755,"_26541":1742,"_22543":44886,"_5":26803,"_10604":44852,"_1869":44887},[],"**Device ID**: identificador único del dispositivo.",{"_3805":1756,"_26541":1742,"_22543":44889,"_5":26803,"_10604":44852,"_1869":44890},[],"**Registration Authority**: DMS que aplicará las políticas de enrolamiento.",{"_3805":1757,"_26541":1742,"_22543":44892,"_5":26803,"_10604":44852,"_1869":44893},[],"**Icon** y **Tags**: clasificación opcional para localizarlo después.",{"_3805":1758,"_26541":1742,"_22543":44895,"_5":26803,"_10604":44856,"_1869":44896},[],"Abre el dispositivo recién creado. Debe aparecer con estado **No Identity**: existe en el inventario, pero todavía no tiene un certificado asociado.",{"_3805":1759,"_26541":1742,"_22543":44898,"_5":26803,"_10604":44860,"_1869":44899},[],"Selecciona **Assign Identity**. Lamassu buscará certificados activos cuyo `Common Name` coincida con el `Device ID`.",{"_3805":1760,"_26541":1742,"_22543":44901,"_5":26803,"_10604":44860,"_1869":44902},[],"Selecciona un certificado existente o usa **Issue New Instead** para emitir uno desde una CA vinculada al DMS.",{"_3805":1761,"_26541":1742,"_22543":44904,"_5":26803,"_10604":44864,"_1869":44905},[],"Tras confirmar, el estado debe cambiar a **Active**. Revisa **Certificate History** para comprobar la identidad asociada y **Device Event Timeline** para ver el evento de asignación.",{"_3805":1762,"_26541":1742,"_22543":44907,"_5":26803,"_10604":44868,"_1869":44908},[],"El registro manual ayuda a entender el modelo, pero una flota debe usar enrolamiento automatizado. Continúa con Device Management Service y la integración EST.",{"_3805":1763,"_26541":1763,"_5":26798,"_1869":44910,"_26811":44911,"_22543":44912,"_10604":1763},"Resolución de problemas",[39375,40459,40460],[],{"_3805":1764,"_26541":1763,"_22543":44914,"_5":26803,"_10604":1763,"_1869":44915},[],"Diagnostica acceso, salud, emisión, enrolamiento y dependencias en un despliegue de Lamassu.",{"_3805":1765,"_26541":1763,"_5":26808,"_22543":44917,"_10604":44918,"_1869":44919},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3805":1766,"_26541":1763,"_5":26808,"_22543":44921,"_10604":44922,"_1869":44923},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3805":1767,"_26541":1763,"_5":26808,"_22543":44925,"_10604":44926,"_1869":44927},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3805":1768,"_26541":1763,"_5":26808,"_22543":44929,"_10604":44930,"_1869":44931},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3805":1769,"_26541":1763,"_5":26808,"_22543":44933,"_10604":44934,"_1869":44935},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3805":1770,"_26541":1763,"_5":26808,"_22543":44937,"_10604":44938,"_1869":44939},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3805":1771,"_26541":1763,"_5":26808,"_22543":44941,"_10604":44942,"_1869":44943},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3805":1772,"_26541":1763,"_5":26808,"_22543":44945,"_10604":44946,"_1869":44947},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3805":1773,"_26541":1763,"_5":26808,"_22543":44949,"_10604":44950,"_1869":44951},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3805":1774,"_26541":1763,"_5":26808,"_22543":44953,"_10604":44954,"_1869":44955},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3805":1775,"_26541":1763,"_5":26808,"_22543":44957,"_10604":44958,"_1869":44959},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3805":1776,"_26541":1763,"_5":26808,"_22543":44961,"_10604":44962,"_1869":44963},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3805":1777,"_26541":1763,"_5":26808,"_22543":44965,"_10604":44966,"_1869":44967},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3805":1778,"_26541":1763,"_5":26808,"_22543":44969,"_10604":44970,"_1869":44971},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3805":1779,"_26541":1763,"_5":26808,"_22543":44973,"_10604":44974,"_1869":44975},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#observabilidad","Observabilidad",{"_3805":1780,"_26541":1763,"_22543":44977,"_5":26803,"_10604":1763,"_1869":44978},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway, un pod no preparado y una emisión rechazada pueden parecer el mismo problema desde la consola, pero requieren evidencias distintas.",{"_3805":1781,"_26541":1763,"_22543":44980,"_5":26803,"_10604":44922,"_1869":44981},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3805":1782,"_26541":1763,"_22543":44983,"_5":26803,"_10604":44926,"_1869":44984},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3805":1783,"_26541":1763,"_22543":44986,"_5":26803,"_10604":44930,"_1869":44987},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3805":1784,"_26541":1763,"_22543":44989,"_5":26803,"_10604":44934,"_1869":44990},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3805":1785,"_26541":1763,"_22543":44992,"_5":26803,"_10604":44938,"_1869":44993},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3805":1786,"_26541":1763,"_22543":44995,"_5":26803,"_10604":44942,"_1869":44996},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3805":1787,"_26541":1763,"_22543":44998,"_5":26803,"_10604":44942,"_1869":44999},[],"Ejecuta también la prueba de conectividad del chart:",{"_3805":1788,"_26541":1763,"_22543":45001,"_5":26803,"_10604":44942,"_1869":45002},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3805":1789,"_26541":1763,"_22543":45004,"_5":26803,"_10604":44942,"_1869":45005},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3805":1790,"_26541":1763,"_22543":45007,"_5":26803,"_10604":44946,"_1869":45008},[],"Si recibes un 401:",{"_3805":1791,"_26541":1763,"_22543":45010,"_5":26803,"_10604":44946,"_1869":45011},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3805":1792,"_26541":1763,"_22543":45013,"_5":26803,"_10604":44946,"_1869":45014},[],"verifica emisor, audiencia y expiración del token;",{"_3805":1793,"_26541":1763,"_22543":45016,"_5":26803,"_10604":44946,"_1869":45017},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3805":1794,"_26541":1763,"_22543":45019,"_5":26803,"_10604":44946,"_1869":45020},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3805":1795,"_26541":1763,"_22543":45022,"_5":26803,"_10604":44946,"_1869":45023},[],"Si el login termina pero las APIs devuelven 403:",{"_3805":1796,"_26541":1763,"_22543":45025,"_5":26803,"_10604":44946,"_1869":45026},[],"inspecciona los claims reales del token;",{"_3805":1797,"_26541":1763,"_22543":45028,"_5":26803,"_10604":44946,"_1869":45029},[],"confirma que coinciden con un principal activo;",{"_3805":1798,"_26541":1763,"_22543":45031,"_5":26803,"_10604":44946,"_1869":45032},[],"revisa las políticas concedidas al principal;",{"_3805":1799,"_26541":1763,"_22543":45034,"_5":26803,"_10604":44946,"_1869":45035},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3805":1800,"_26541":1763,"_22543":45037,"_5":26803,"_10604":44946,"_1869":45038},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3805":1801,"_26541":1763,"_22543":45040,"_5":26803,"_10604":44950,"_1869":45041},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3805":1802,"_26541":1763,"_22543":45043,"_5":26803,"_10604":44950,"_1869":45044},[],"Localiza el pod y Service de authz.",{"_3805":1803,"_26541":1763,"_22543":45046,"_5":26803,"_10604":44950,"_1869":45047},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3805":1804,"_26541":1763,"_22543":45049,"_5":26803,"_10604":44950,"_1869":45050},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3805":1805,"_26541":1763,"_22543":45052,"_5":26803,"_10604":44950,"_1869":45053},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3805":1806,"_26541":1763,"_22543":45055,"_5":26803,"_10604":44950,"_1869":45056},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3805":1807,"_26541":1763,"_22543":45058,"_5":26803,"_10604":44954,"_1869":45059},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3805":1808,"_26541":1763,"_22543":45061,"_5":26803,"_10604":44954,"_1869":45062},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3805":1809,"_26541":1763,"_22543":45064,"_5":26803,"_10604":44954,"_1869":45065},[],"volumen persistente sin enlazar;",{"_3805":1810,"_26541":1763,"_22543":45067,"_5":26803,"_10604":44954,"_1869":45068},[],"imagen inaccesible o política de pull incorrecta;",{"_3805":1811,"_26541":1763,"_22543":45070,"_5":26803,"_10604":44954,"_1869":45071},[],"configuración inválida del motor criptográfico;",{"_3805":1812,"_26541":1763,"_22543":45073,"_5":26803,"_10604":44954,"_1869":45074},[],"límites de CPU o memoria demasiado bajos;",{"_3805":1813,"_26541":1763,"_22543":45076,"_5":26803,"_10604":44954,"_1869":45077},[],"migración previa incompleta.",{"_3805":1814,"_26541":1763,"_22543":45079,"_5":26803,"_10604":44954,"_1869":45080},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3805":1815,"_26541":1763,"_22543":45082,"_5":26803,"_10604":44954,"_1869":45083},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3805":1816,"_26541":1763,"_22543":45085,"_5":26803,"_10604":44958,"_1869":45086},[],"Acota el error siguiendo este orden:",{"_3805":1817,"_26541":1763,"_22543":45088,"_5":26803,"_10604":44958,"_1869":45089},[],"La CA existe, está activa y no ha expirado.",{"_3805":1818,"_26541":1763,"_22543":45091,"_5":26803,"_10604":44958,"_1869":45092},[],"La CA tiene una clave privada utilizable y el motor está disponible.",{"_3805":1819,"_26541":1763,"_22543":45094,"_5":26803,"_10604":44958,"_1869":45095},[],"La CSR tiene una firma válida.",{"_3805":1820,"_26541":1763,"_22543":45097,"_5":26803,"_10604":44958,"_1869":45098},[],"El perfil permite el tipo y tamaño de clave.",{"_3805":1821,"_26541":1763,"_22543":45100,"_5":26803,"_10604":44958,"_1869":45101},[],"La validez solicitada cabe dentro de la vigencia de la CA.",{"_3805":1822,"_26541":1763,"_22543":45103,"_5":26803,"_10604":44958,"_1869":45104},[],"KU, EKU, sujeto y extensiones cumplen el perfil.",{"_3805":1823,"_26541":1763,"_22543":45106,"_5":26803,"_10604":44958,"_1869":45107},[],"Si la reemisión de una CA falla, recuerda que no se admite para una CA revocada o ya expirada. Para cambiar su clave, sigue Jerarquía y rotación de CAs.",{"_3805":1824,"_26541":1763,"_22543":45109,"_5":26803,"_10604":44962,"_1869":45110},[],"Comprueba:",{"_3805":1825,"_26541":1763,"_22543":45112,"_5":26803,"_10604":44962,"_1869":45113},[],"el identificador del DMS en el path EST;",{"_3805":1826,"_26541":1763,"_22543":45115,"_5":26803,"_10604":44962,"_1869":45116},[],"el método de autenticación configurado;",{"_3805":1827,"_26541":1763,"_22543":45118,"_5":26803,"_10604":44962,"_1869":45119},[],"la cadena presentada por el cliente;",{"_3805":1828,"_26541":1763,"_22543":45121,"_5":26803,"_10604":44962,"_1869":45122},[],"las CAs de validación y el límite de niveles;",{"_3805":1829,"_26541":1763,"_22543":45124,"_5":26803,"_10604":44962,"_1869":45125},[],"el estado de revocación del certificado cliente;",{"_3805":1830,"_26541":1763,"_22543":45127,"_5":26803,"_10604":44962,"_1869":45128},[],"la firma de la CSR;",{"_3805":1831,"_26541":1763,"_22543":45130,"_5":26803,"_10604":44962,"_1869":45131},[],"la CA y el perfil usados para emitir;",{"_3805":1832,"_26541":1763,"_22543":45133,"_5":26803,"_10604":44962,"_1869":45134},[],"la ventana de re-enrolamiento.",{"_3805":1833,"_26541":1763,"_22543":45136,"_5":26803,"_10604":44962,"_1869":45137},[],"En re-enrolamiento, Lamassu intenta validar primero con la CA de enrolamiento y después con las CAs adicionales. Durante una migración, conserva la CA anterior en ese segundo conjunto hasta terminar el solapamiento.",{"_3805":1834,"_26541":1763,"_22543":45139,"_5":26803,"_10604":44966,"_1869":45140},[],"Confirma que la revocación quedó persistida y tiene razón y timestamp.",{"_3805":1835,"_26541":1763,"_22543":45142,"_5":26803,"_10604":44966,"_1869":45143},[],"Revisa la configuración y logs de VA.",{"_3805":1836,"_26541":1763,"_22543":45145,"_5":26803,"_10604":44966,"_1869":45146},[],"Comprueba la periodicidad y próxima actualización de la CRL.",{"_3805":1837,"_26541":1763,"_22543":45148,"_5":26803,"_10604":44966,"_1869":45149},[],"Descarta cachés intermedias en proxy y cliente.",{"_3805":1838,"_26541":1763,"_22543":45151,"_5":26803,"_10604":44966,"_1869":45152},[],"Verifica que el certificado apunta al endpoint que estás consultando.",{"_3805":1839,"_26541":1763,"_22543":45154,"_5":26803,"_10604":44966,"_1869":45155},[],"Consulta por número de serie y emisor correctos.",{"_3805":1840,"_26541":1763,"_22543":45157,"_5":26803,"_10604":44970,"_1869":45158},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3805":1841,"_26541":1763,"_22543":45160,"_5":26803,"_10604":44970,"_1869":45161},[],"verifica que esté habilitado en el servicio emisor;",{"_3805":1842,"_26541":1763,"_22543":45163,"_5":26803,"_10604":44970,"_1869":45164},[],"comprueba conectividad y credenciales AMQP;",{"_3805":1843,"_26541":1763,"_22543":45166,"_5":26803,"_10604":44970,"_1869":45167},[],"revisa exchange, routing key, colas y consumidores;",{"_3805":1844,"_26541":1763,"_22543":45169,"_5":26803,"_10604":44970,"_1869":45170},[],"inspecciona dead-letter queues;",{"_3805":1845,"_26541":1763,"_22543":45172,"_5":26803,"_10604":44970,"_1869":45173},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3805":1846,"_26541":1763,"_22543":45175,"_5":26803,"_10604":44970,"_1869":45176},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3805":1847,"_26541":1763,"_22543":45178,"_5":26803,"_10604":44974,"_1869":45179},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3805":1848,"_26541":1763,"_22543":45181,"_5":26803,"_10604":44974,"_1869":45182},[],"Antes de cerrar una incidencia, guarda:",{"_3805":1849,"_26541":1763,"_22543":45184,"_5":26803,"_10604":44974,"_1869":45185},[],"causa confirmada;",{"_3805":1850,"_26541":1763,"_22543":45187,"_5":26803,"_10604":44974,"_1869":45188},[],"alcance temporal y recursos afectados;",{"_3805":1851,"_26541":1763,"_22543":45190,"_5":26803,"_10604":44974,"_1869":45191},[],"comandos o consultas utilizados;",{"_3805":1852,"_26541":1763,"_22543":45193,"_5":26803,"_10604":44974,"_1869":45194},[],"cambio aplicado y forma de revertirlo;",{"_3805":1853,"_26541":1763,"_22543":45196,"_5":26803,"_10604":44974,"_1869":45197},[],"validación desde un consumidor;",{"_3805":1854,"_26541":1763,"_22543":45199,"_5":26803,"_10604":44974,"_1869":45200},[],"acción preventiva y propietario.",{"_3805":1855,"_26541":1855,"_5":26798,"_1869":45202,"_22543":45203,"_10604":1855},"Test",[],{"_3805":1856,"_26541":1855,"_22543":45205,"_5":26803,"_10604":1855,"_1869":45206},[],"A document to test Fumadocs",{"_3805":1857,"_26541":1855,"_5":26808,"_22543":45208,"_10604":45209,"_1869":45210},[],"/docs/pr-preview/pr-27/test#cards","Cards",{"_3805":1858,"_26541":1855,"_5":26808,"_22543":45212,"_10604":45213,"_1869":45214},[],"/docs/pr-preview/pr-27/test#codeblock","CodeBlock",{"_3805":1859,"_26541":1855,"_5":26808,"_22543":45216,"_10604":45217,"_1869":45218},[],"/docs/pr-preview/pr-27/test#list","List",{"_3805":1860,"_26541":1855,"_22543":45220,"_5":26803,"_10604":1855,"_1869":45221},[],"Hey there!",{"_3805":1861,"_26541":1855,"_22543":45223,"_5":26803,"_10604":45209,"_1869":45224},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_3805":1862,"_26541":1855,"_22543":45226,"_5":26803,"_10604":45209,"_1869":45227},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_3805":1863,"_26541":1855,"_22543":45229,"_5":26803,"_10604":45217,"_1869":45230},[],"Hello",{"_3805":1864,"_26541":1855,"_22543":45232,"_5":26803,"_10604":45217,"_1869":45233},[],"World","count","sorting",{"_45237":45238,"_45239":45240,"_45241":45242,"_45243":45244,"_8763":1886,"_52675":1886},"language","english","sortableProperties",[1869,26541,5,10604],"sortablePropertiesWithTypes",{"_1869":22180,"_26541":22180,"_5":22180,"_10604":22180},"sorts",{"_1869":45245,"_26541":47104,"_5":48961,"_10604":50818},{"_4663":45246,"_45248":45249,"_5":22180},{"_14139":2198,"_8790":3675,"_14252":3256,"_24299":3308,"_14239":2056,"_24306":11904,"_14132":3292,"_10480":24291,"_24278":2602,"_25972":3288,"_25997":2495,"_24347":5670,"_30055":3314,"_25992":7844,"_30060":5333,"_30063":26077,"_30065":2057,"_30068":2571,"_25987":10314,"_26245":2392,"_30075":8323,"_30078":2199,"_26270":2297,"_14248":16710,"_30083":1901,"_26265":16859,"_26596":2521,"_26003":5394,"_26275":3594,"_26219":20717,"_30091":3003,"_30093":8326,"_30095":20173,"_30098":4166,"_30100":4002,"_30102":2095,"_30104":21670,"_30106":2623,"_30108":2386,"_24817":3311,"_