93":92483,"_22829":55749},"Despliega desde AWS Marketplace",[39337,92481,92482],"Despliegue","Otros modelos",[],{"_2783":55750,"_24069":55749,"_16893":92485,"_5":16788,"_22829":55749,"_2311":92486},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2783":55751,"_24069":55749,"_5":24402,"_16893":92488,"_22829":92489,"_2311":92490},[],"/docs/pr-preview/pr-27/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2783":55752,"_24069":55749,"_5":24402,"_16893":92492,"_22829":92493,"_2311":92494},[],"/docs/pr-preview/pr-27/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2783":55753,"_24069":55749,"_5":24402,"_16893":92496,"_22829":92497,"_2311":92498},[],"/docs/pr-preview/pr-27/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2783":55754,"_24069":55749,"_5":24402,"_16893":92500,"_22829":92501,"_2311":92502},[],"/docs/pr-preview/pr-27/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2783":55755,"_24069":55749,"_5":24402,"_16893":92504,"_22829":92505,"_2311":92506},[],"/docs/pr-preview/pr-27/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2783":55756,"_24069":55749,"_5":24402,"_16893":92508,"_22829":92509,"_2311":92510},[],"/docs/pr-preview/pr-27/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2783":55757,"_24069":55749,"_5":24402,"_16893":92512,"_22829":92513,"_2311":92514},[],"/docs/pr-preview/pr-27/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2783":55758,"_24069":55749,"_16893":92516,"_5":16788,"_22829":55749,"_2311":92517},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2783":55759,"_24069":55749,"_16893":92519,"_5":16788,"_22829":92489,"_2311":92520},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2783":55760,"_24069":55749,"_16893":92522,"_5":16788,"_22829":92489,"_2311":92523},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2783":55761,"_24069":55749,"_16893":92525,"_5":16788,"_22829":92489,"_2311":92526},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2783":55762,"_24069":55749,"_16893":92528,"_5":16788,"_22829":92493,"_2311":92529},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2783":55763,"_24069":55749,"_16893":92531,"_5":16788,"_22829":92493,"_2311":92532},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2783":55764,"_24069":55749,"_16893":92534,"_5":16788,"_22829":92493,"_2311":92535},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2783":55765,"_24069":55749,"_16893":92537,"_5":16788,"_22829":92497,"_2311":92538},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2783":55766,"_24069":55749,"_16893":92540,"_5":16788,"_22829":92501,"_2311":92541},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2783":55767,"_24069":55749,"_16893":92543,"_5":16788,"_22829":92505,"_2311":92544},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2783":55768,"_24069":55749,"_16893":92546,"_5":16788,"_22829":92509,"_2311":92547},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2783":55769,"_24069":55749,"_16893":92549,"_5":16788,"_22829":92513,"_2311":92550},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2783":55770,"_24069":55770,"_5":11891,"_2311":92552,"_24405":92553,"_16893":92554,"_22829":55770},"Despliega Lamassu",[39337,92481],[],{"_2783":55771,"_24069":55770,"_16893":92556,"_5":16788,"_22829":55770,"_2311":92557},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2783":55772,"_24069":55770,"_5":24402,"_16893":92559,"_22829":92560,"_2311":92561},[],"/docs/pr-preview/pr-27/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2783":55773,"_24069":55770,"_5":24402,"_16893":92563,"_22829":92564,"_2311":92565},[],"/docs/pr-preview/pr-27/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2783":55774,"_24069":55770,"_5":24402,"_16893":92567,"_22829":92568,"_2311":92569},[],"/docs/pr-preview/pr-27/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2783":55775,"_24069":55770,"_16893":92571,"_5":16788,"_22829":55770,"_2311":92572},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2783":55776,"_24069":55770,"_16893":92574,"_5":16788,"_22829":92560,"_2311":92575},[],"Modelo",{"_2783":55777,"_24069":55770,"_16893":92577,"_5":16788,"_22829":92560,"_2311":92578},[],"Recomendado para",{"_2783":55778,"_24069":55770,"_16893":92580,"_5":16788,"_22829":92560,"_2311":92581},[],"Quién opera la infraestructura",{"_2783":55779,"_24069":55770,"_16893":92583,"_5":16788,"_22829":92560,"_2311":92584},[],"Punto de partida",{"_2783":55780,"_24069":55770,"_16893":92586,"_5":16788,"_22829":92560,"_2311":39444},[],{"_2783":55781,"_24069":55770,"_16893":92588,"_5":16788,"_22829":92560,"_2311":92589},[],"Producción, entornos regulados y despliegues personalizados",{"_2783":55782,"_24069":55770,"_16893":92591,"_5":16788,"_22829":92560,"_2311":92592},[],"Tu equipo",{"_2783":55783,"_24069":55770,"_16893":92594,"_5":16788,"_22829":92560,"_2311":92595},[],"Helm o Fastlane",{"_2783":55784,"_24069":55770,"_16893":92597,"_5":16788,"_22829":92560,"_2311":39456},[],{"_2783":55785,"_24069":55770,"_16893":92599,"_5":16788,"_22829":92560,"_2311":92600},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2783":55786,"_24069":55770,"_16893":92602,"_5":16788,"_22829":92560,"_2311":92592},[],{"_2783":55787,"_24069":55770,"_16893":92604,"_5":16788,"_22829":92560,"_2311":92605},[],"Imagen preconfigurada en EC2",{"_2783":55788,"_24069":55770,"_16893":92607,"_5":16788,"_22829":92560,"_2311":39467},[],{"_2783":55789,"_24069":55770,"_16893":92609,"_5":16788,"_22829":92560,"_2311":92610},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2783":55790,"_24069":55770,"_16893":92612,"_5":16788,"_22829":92560,"_2311":39473},[],{"_2783":55791,"_24069":55770,"_16893":92614,"_5":16788,"_22829":92560,"_2311":92615},[],"Suscripción gestionada",{"_2783":55792,"_24069":55770,"_16893":92617,"_5":16788,"_22829":92560,"_2311":92618},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2783":55793,"_24069":55770,"_16893":92620,"_5":16788,"_22829":92560,"_2311":92621},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2783":55794,"_24069":55770,"_16893":92623,"_5":16788,"_22829":92560,"_2311":92624},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2783":55795,"_24069":55770,"_16893":92626,"_5":16788,"_22829":92564,"_2311":92627},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2783":55796,"_24069":55770,"_16893":92629,"_5":16788,"_22829":92568,"_2311":92630},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2783":55797,"_24069":55797,"_5":11891,"_2311":92632,"_24405":92633,"_16893":92634,"_22829":55797},"Utiliza Lamassu como SaaS",[39337,92481,92482],[],{"_2783":55798,"_24069":55797,"_16893":92636,"_5":16788,"_22829":55797,"_2311":92637},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2783":55799,"_24069":55797,"_5":24402,"_16893":92639,"_22829":92640,"_2311":92641},[],"/docs/pr-preview/pr-27/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2783":55800,"_24069":55797,"_5":24402,"_16893":92643,"_22829":92644,"_2311":92645},[],"/docs/pr-preview/pr-27/es/deployment/saas#planes","Planes",{"_2783":55801,"_24069":55797,"_5":24402,"_16893":92647,"_22829":92648,"_2311":92649},[],"/docs/pr-preview/pr-27/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2783":55802,"_24069":55797,"_16893":92651,"_5":16788,"_22829":55797,"_2311":92652},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2783":55803,"_24069":55797,"_16893":92654,"_5":16788,"_22829":92640,"_2311":92655},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2783":55804,"_24069":55797,"_16893":92657,"_5":16788,"_22829":92640,"_2311":92658},[],"Copias de seguridad automáticas.",{"_2783":55805,"_24069":55797,"_16893":92660,"_5":16788,"_22829":92640,"_2311":92661},[],"Actualizaciones de versión.",{"_2783":55806,"_24069":55797,"_16893":92663,"_5":16788,"_22829":92640,"_2311":92664},[],"Soporte técnico y SLA según el plan contratado.",{"_2783":55807,"_24069":55797,"_16893":92666,"_5":16788,"_22829":92644,"_2311":39528},[],{"_2783":55808,"_24069":55797,"_16893":92668,"_5":16788,"_22829":92644,"_2311":92669},[],"Dispositivos",{"_2783":55809,"_24069":55797,"_16893":92671,"_5":16788,"_22829":92644,"_2311":92672},[],"Soporte",{"_2783":55810,"_24069":55797,"_16893":92674,"_5":16788,"_22829":92644,"_2311":39537},[],{"_2783":55811,"_24069":55797,"_16893":92676,"_5":16788,"_22829":92644,"_2311":39540},[],{"_2783":55812,"_24069":55797,"_16893":92678,"_5":16788,"_22829":92644,"_2311":92679},[],"Hasta 1.000",{"_2783":55813,"_24069":55797,"_16893":92681,"_5":16788,"_22829":92644,"_2311":39546},[],{"_2783":55814,"_24069":55797,"_16893":92683,"_5":16788,"_22829":92644,"_2311":92684},[],"99,5 %",{"_2783":55815,"_24069":55797,"_16893":92686,"_5":16788,"_22829":92644,"_2311":39552},[],{"_2783":55816,"_24069":55797,"_16893":92688,"_5":16788,"_22829":92644,"_2311":92689},[],"Hasta 10.000",{"_2783":55817,"_24069":55797,"_16893":92691,"_5":16788,"_22829":92644,"_2311":92692},[],"Email y chat",{"_2783":55818,"_24069":55797,"_16893":92694,"_5":16788,"_22829":92644,"_2311":92695},[],"99,9 %",{"_2783":55819,"_24069":55797,"_16893":92697,"_5":16788,"_22829":92644,"_2311":39564},[],{"_2783":55820,"_24069":55797,"_16893":92699,"_5":16788,"_22829":92644,"_2311":92700},[],"Ilimitados",{"_2783":55821,"_24069":55797,"_16893":92702,"_5":16788,"_22829":92644,"_2311":92703},[],"Dedicado",{"_2783":55822,"_24069":55797,"_16893":92705,"_5":16788,"_22829":92644,"_2311":92706},[],"99,99 %",{"_2783":55823,"_24069":55797,"_16893":92708,"_5":16788,"_22829":92648,"_2311":92709},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2783":55824,"_24069":55797,"_16893":92711,"_5":16788,"_22829":92648,"_2311":92712},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2783":55825,"_24069":55825,"_5":11891,"_2311":39581,"_24405":92714,"_16893":92716,"_22829":55825},[39337,92481,92715],"Kubernetes autogestionado",[],{"_2783":55826,"_24069":55825,"_16893":92718,"_5":16788,"_22829":55825,"_2311":92719},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2783":55827,"_24069":55825,"_5":24402,"_16893":92721,"_22829":92722,"_2311":92723},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2783":55828,"_24069":55825,"_5":24402,"_16893":92725,"_22829":92726,"_2311":92727},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2783":55829,"_24069":55825,"_5":24402,"_16893":92729,"_22829":92730,"_2311":92731},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2783":55830,"_24069":55825,"_5":24402,"_16893":92733,"_22829":92734,"_2311":92735},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2783":55831,"_24069":55825,"_5":24402,"_16893":92737,"_22829":92738,"_2311":92739},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2783":55832,"_24069":55825,"_5":24402,"_16893":92741,"_22829":92742,"_2311":92743},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2783":55833,"_24069":55825,"_5":24402,"_16893":92745,"_22829":92746,"_2311":92747},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2783":55834,"_24069":55825,"_5":24402,"_16893":92749,"_22829":92750,"_2311":92751},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2783":55835,"_24069":55825,"_5":24402,"_16893":92753,"_22829":92754,"_2311":92755},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2783":55836,"_24069":55825,"_5":24402,"_16893":92757,"_22829":92758,"_2311":92759},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2783":55837,"_24069":55825,"_16893":92761,"_5":16788,"_22829":92722,"_2311":92762},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2783":55838,"_24069":55825,"_16893":92764,"_5":16788,"_22829":92722,"_2311":92765},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2783":55839,"_24069":55825,"_16893":92767,"_5":16788,"_22829":92726,"_2311":92768},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2783":55840,"_24069":55825,"_16893":92770,"_5":16788,"_22829":92726,"_2311":92771},[],"Fastlane instala o configura",{"_2783":55841,"_24069":55825,"_16893":92773,"_5":16788,"_22829":92726,"_2311":92774},[],"Tú sigues proporcionando",{"_2783":55842,"_24069":55825,"_16893":92776,"_5":16788,"_22829":92726,"_2311":92777},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2783":55843,"_24069":55825,"_16893":92779,"_5":16788,"_22829":92726,"_2311":92780},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2783":55844,"_24069":55825,"_16893":92782,"_5":16788,"_22829":92726,"_2311":92783},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2783":55845,"_24069":55825,"_16893":92785,"_5":16788,"_22829":92726,"_2311":92786},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2783":55846,"_24069":55825,"_16893":92788,"_5":16788,"_22829":92726,"_2311":92789},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2783":55847,"_24069":55825,"_16893":92791,"_5":16788,"_22829":92726,"_2311":92792},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2783":55848,"_24069":55825,"_16893":92794,"_5":16788,"_22829":92726,"_2311":92795},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2783":55849,"_24069":55825,"_16893":92797,"_5":16788,"_22829":92726,"_2311":92798},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2783":55850,"_24069":55825,"_16893":92800,"_5":16788,"_22829":92726,"_2311":92801},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2783":55851,"_24069":55825,"_16893":92803,"_5":16788,"_22829":92730,"_2311":92804},[],"Necesitas:",{"_2783":55852,"_24069":55825,"_16893":92806,"_5":16788,"_22829":92730,"_2311":92807},[],"un clúster Kubernetes existente",{"_2783":55853,"_24069":55825,"_16893":92809,"_5":16788,"_22829":92730,"_2311":92810},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2783":55854,"_24069":55825,"_16893":92812,"_5":16788,"_22829":92730,"_2311":39679},[],{"_2783":55855,"_24069":55825,"_16893":92814,"_5":16788,"_22829":92730,"_2311":19088},[],{"_2783":55856,"_24069":55825,"_16893":92816,"_5":16788,"_22829":92730,"_2311":92817},[],"`jq` solo si usas `--sample-data`",{"_2783":55857,"_24069":55825,"_16893":92819,"_5":16788,"_22829":92730,"_2311":92820},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2783":55858,"_24069":55825,"_16893":92822,"_5":16788,"_22829":92730,"_2311":92823},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2783":55859,"_24069":55825,"_16893":92825,"_5":16788,"_22829":92730,"_2311":92826},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2783":55860,"_24069":55825,"_16893":92828,"_5":16788,"_22829":92734,"_2311":92829},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2783":55861,"_24069":55825,"_16893":92831,"_5":16788,"_22829":92734,"_2311":92832},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2783":55862,"_24069":55825,"_16893":92834,"_5":16788,"_22829":92738,"_2311":92835},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2783":55863,"_24069":55825,"_16893":92837,"_5":16788,"_22829":92738,"_2311":92838},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2783":55864,"_24069":55825,"_16893":92840,"_5":16788,"_22829":92738,"_2311":92841},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2783":55865,"_24069":55825,"_16893":92843,"_5":16788,"_22829":92738,"_2311":92844},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2783":55866,"_24069":55825,"_16893":92846,"_5":16788,"_22829":92742,"_2311":92847},[],"Opción",{"_2783":55867,"_24069":55825,"_16893":92849,"_5":16788,"_22829":92742,"_2311":92850},[],"Valor predeterminado",{"_2783":55868,"_24069":55825,"_16893":92852,"_5":16788,"_22829":92742,"_2311":92853},[],"Propósito",{"_2783":55869,"_24069":55825,"_16893":92855,"_5":16788,"_22829":92742,"_2311":39723},[],{"_2783":55870,"_24069":55825,"_16893":92857,"_5":16788,"_22829":92742,"_2311":39726},[],{"_2783":55871,"_24069":55825,"_16893":92859,"_5":16788,"_22829":92742,"_2311":92860},[],"Muestra la ayuda",{"_2783":55872,"_24069":55825,"_16893":92862,"_5":16788,"_22829":92742,"_2311":39732},[],{"_2783":55873,"_24069":55825,"_16893":92864,"_5":16788,"_22829":92742,"_2311":92865},[],"contexto actual",{"_2783":55874,"_24069":55825,"_16893":92867,"_5":16788,"_22829":92742,"_2311":92868},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2783":55875,"_24069":55825,"_16893":92870,"_5":16788,"_22829":92742,"_2311":39741},[],{"_2783":55876,"_24069":55825,"_16893":92872,"_5":16788,"_22829":92742,"_2311":5183},[],{"_2783":55877,"_24069":55825,"_16893":92874,"_5":16788,"_22829":92742,"_2311":92875},[],"Omite prompts y genera credenciales para las dependencias",{"_2783":55878,"_24069":55825,"_16893":92877,"_5":16788,"_22829":92742,"_2311":39749},[],{"_2783":55879,"_24069":55825,"_16893":92879,"_5":16788,"_22829":92742,"_2311":39752},[],{"_2783":55880,"_24069":55825,"_16893":92881,"_5":16788,"_22829":92742,"_2311":92882},[],"Namespace de la instalación",{"_2783":55881,"_24069":55825,"_16893":92884,"_5":16788,"_22829":92742,"_2311":39758},[],{"_2783":55882,"_24069":55825,"_16893":92886,"_5":16788,"_22829":92742,"_2311":39761},[],{"_2783":55883,"_24069":55825,"_16893":92888,"_5":16788,"_22829":92742,"_2311":92889},[],"Dominio usado por la UI, OIDC y el certificado",{"_2783":55884,"_24069":55825,"_16893":92891,"_5":16788,"_22829":92742,"_2311":39767},[],{"_2783":55885,"_24069":55825,"_16893":92893,"_5":16788,"_22829":92742,"_2311":12106},[],{"_2783":55886,"_24069":55825,"_16893":92895,"_5":16788,"_22829":92742,"_2311":92896},[],"Versión del chart de Lamassu",{"_2783":55887,"_24069":55825,"_16893":92898,"_5":16788,"_22829":92742,"_2311":39775},[],{"_2783":55888,"_24069":55825,"_16893":92900,"_5":16788,"_22829":92742,"_2311":39778},[],{"_2783":55889,"_24069":55825,"_16893":92902,"_5":16788,"_22829":92742,"_2311":92903},[],"Puerto del listener HTTPS",{"_2783":55890,"_24069":55825,"_16893":92905,"_5":16788,"_22829":92742,"_2311":39784},[],{"_2783":55891,"_24069":55825,"_16893":92907,"_5":16788,"_22829":92742,"_2311":39787},[],{"_2783":55892,"_24069":55825,"_16893":92909,"_5":16788,"_22829":92742,"_2311":92910},[],"Puerto del listener HTTP",{"_2783":55893,"_24069":55825,"_16893":92912,"_5":16788,"_22829":92742,"_2311":39793},[],{"_2783":55894,"_24069":55825,"_16893":92914,"_5":16788,"_22829":92742,"_2311":39726},[],{"_2783":55895,"_24069":55825,"_16893":92916,"_5":16788,"_22829":92742,"_2311":92917},[],"Certificado PEM para TLS downstream",{"_2783":55896,"_24069":55825,"_16893":92919,"_5":16788,"_22829":92742,"_2311":39801},[],{"_2783":55897,"_24069":55825,"_16893":92921,"_5":16788,"_22829":92742,"_2311":39726},[],{"_2783":55898,"_24069":55825,"_16893":92923,"_5":16788,"_22829":92742,"_2311":92924},[],"Clave privada PEM para TLS downstream",{"_2783":55899,"_24069":55825,"_16893":92926,"_5":16788,"_22829":92742,"_2311":39809},[],{"_2783":55900,"_24069":55825,"_16893":92928,"_5":16788,"_22829":92742,"_2311":92929},[],"chart del repositorio",{"_2783":55901,"_24069":55825,"_16893":92931,"_5":16788,"_22829":92742,"_2311":92932},[],"Usa un chart local de Lamassu sin empaquetar",{"_2783":55902,"_24069":55825,"_16893":92934,"_5":16788,"_22829":92742,"_2311":39818},[],{"_2783":55903,"_24069":55825,"_16893":92936,"_5":16788,"_22829":92742,"_2311":92937},[],"detección automática",{"_2783":55904,"_24069":55825,"_16893":92939,"_5":16788,"_22829":92742,"_2311":92940},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2783":55905,"_24069":55825,"_16893":92942,"_5":16788,"_22829":92742,"_2311":39826},[],{"_2783":55906,"_24069":55825,"_16893":92944,"_5":16788,"_22829":92742,"_2311":5183},[],{"_2783":55907,"_24069":55825,"_16893":92946,"_5":16788,"_22829":92742,"_2311":92947},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2783":55908,"_24069":55825,"_16893":92949,"_5":16788,"_22829":92742,"_2311":39834},[],{"_2783":55909,"_24069":55825,"_16893":92951,"_5":16788,"_22829":92742,"_2311":5183},[],{"_2783":55910,"_24069":55825,"_16893":92953,"_5":16788,"_22829":92742,"_2311":92954},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2783":55911,"_24069":55825,"_16893":92956,"_5":16788,"_22829":92742,"_2311":39842},[],{"_2783":55912,"_24069":55825,"_16893":92958,"_5":16788,"_22829":92742,"_2311":5183},[],{"_2783":55913,"_24069":55825,"_16893":92960,"_5":16788,"_22829":92742,"_2311":92961},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2783":55914,"_24069":55825,"_16893":92963,"_5":16788,"_22829":92742,"_2311":39850},[],{"_2783":55915,"_24069":55825,"_16893":92965,"_5":16788,"_22829":92742,"_2311":39853},[],{"_2783":55916,"_24069":55825,"_16893":92967,"_5":16788,"_22829":92742,"_2311":92968},[],"Usa otro chart local de SoftHSM",{"_2783":55917,"_24069":55825,"_16893":92970,"_5":16788,"_22829":92742,"_2311":92971},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2783":55918,"_24069":55825,"_16893":92973,"_5":16788,"_22829":92746,"_2311":39862},[],{"_2783":55919,"_24069":55825,"_16893":92975,"_5":16788,"_22829":92746,"_2311":92976},[],"valida las herramientas locales y el clúster seleccionado",{"_2783":55920,"_24069":55825,"_16893":92978,"_5":16788,"_22829":92746,"_2311":92979},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2783":55921,"_24069":55825,"_16893":92981,"_5":16788,"_22829":92746,"_2311":92982},[],"crea el namespace",{"_2783":55922,"_24069":55825,"_16893":92984,"_5":16788,"_22829":92746,"_2311":92985},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2783":55923,"_24069":55825,"_16893":92987,"_5":16788,"_22829":92746,"_2311":92988},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2783":55924,"_24069":55825,"_16893":92990,"_5":16788,"_22829":92746,"_2311":92991},[],"instala RabbitMQ",{"_2783":55925,"_24069":55825,"_16893":92993,"_5":16788,"_22829":92746,"_2311":92994},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2783":55926,"_24069":55825,"_16893":92996,"_5":16788,"_22829":92746,"_2311":92997},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2783":55927,"_24069":55825,"_16893":92999,"_5":16788,"_22829":92746,"_2311":93000},[],"carga datos de ejemplo opcionalmente",{"_2783":55928,"_24069":55825,"_16893":93002,"_5":16788,"_22829":92746,"_2311":93003},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2783":55929,"_24069":55825,"_16893":93005,"_5":16788,"_22829":92750,"_2311":93006},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2783":55930,"_24069":55825,"_16893":93008,"_5":16788,"_22829":92750,"_2311":93009},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2783":55931,"_24069":55825,"_16893":93011,"_5":16788,"_22829":92754,"_2311":93012},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2783":55932,"_24069":55825,"_16893":93014,"_5":16788,"_22829":92754,"_2311":93015},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2783":55933,"_24069":55825,"_16893":93017,"_5":16788,"_22829":92754,"_2311":93018},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2783":55934,"_24069":55825,"_16893":93020,"_5":16788,"_22829":92758,"_2311":93021},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2783":55935,"_24069":55935,"_5":11891,"_2311":93023,"_24405":93024,"_16893":93025,"_22829":55935},"Instala con Helm",[39337,92481,92715],[],{"_2783":55936,"_24069":55935,"_16893":93027,"_5":16788,"_22829":55935,"_2311":93028},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2783":55937,"_24069":55935,"_5":24402,"_16893":93030,"_22829":93031,"_2311":93032},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2783":55938,"_24069":55935,"_5":24402,"_16893":93034,"_22829":93035,"_2311":92731},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2783":55939,"_24069":55935,"_5":24402,"_16893":93037,"_22829":93038,"_2311":93039},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2783":55940,"_24069":55935,"_5":24402,"_16893":93041,"_22829":93042,"_2311":93043},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2783":55941,"_24069":55935,"_5":24402,"_16893":93045,"_22829":93046,"_2311":93047},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2783":55942,"_24069":55935,"_5":24402,"_16893":93049,"_22829":93050,"_2311":93051},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2783":55943,"_24069":55935,"_5":24402,"_16893":93053,"_22829":93054,"_2311":93055},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2783":55944,"_24069":55935,"_5":24402,"_16893":93057,"_22829":93058,"_2311":93059},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2783":55945,"_24069":55935,"_5":24402,"_16893":93061,"_22829":93062,"_2311":93063},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2783":55946,"_24069":55935,"_16893":93065,"_5":16788,"_22829":93031,"_2311":93066},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2783":55947,"_24069":55935,"_16893":93068,"_5":16788,"_22829":93035,"_2311":93069},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2783":55948,"_24069":55935,"_16893":93071,"_5":16788,"_22829":93035,"_2311":93072},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2783":55949,"_24069":55935,"_16893":93074,"_5":16788,"_22829":93035,"_2311":93075},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2783":55950,"_24069":55935,"_16893":93077,"_5":16788,"_22829":93035,"_2311":93078},[],"un broker RabbitMQ accesible y sus credenciales",{"_2783":55951,"_24069":55935,"_16893":93080,"_5":16788,"_22829":93035,"_2311":93081},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2783":55952,"_24069":55935,"_16893":93083,"_5":16788,"_22829":93035,"_2311":93084},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2783":55953,"_24069":55935,"_16893":93086,"_5":16788,"_22829":93035,"_2311":93087},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2783":55954,"_24069":55935,"_16893":93089,"_5":16788,"_22829":93035,"_2311":93090},[],"una StorageClass y un diseño de tráfico externo",{"_2783":55955,"_24069":55935,"_16893":93092,"_5":16788,"_22829":93035,"_2311":93093},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2783":55956,"_24069":55935,"_16893":93095,"_5":16788,"_22829":93035,"_2311":93096},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2783":55957,"_24069":55935,"_16893":93098,"_5":16788,"_22829":93035,"_2311":93099},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2783":55958,"_24069":55935,"_16893":93101,"_5":16788,"_22829":93038,"_2311":93102},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2783":55959,"_24069":55935,"_16893":93104,"_5":16788,"_22829":93038,"_2311":93105},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2783":55960,"_24069":55935,"_16893":93107,"_5":16788,"_22829":93038,"_2311":93108},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2783":55961,"_24069":55935,"_16893":93110,"_5":16788,"_22829":93042,"_2311":93111},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2783":55962,"_24069":55935,"_16893":93113,"_5":16788,"_22829":93042,"_2311":93114},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2783":55963,"_24069":55935,"_16893":93116,"_5":16788,"_22829":93042,"_2311":93117},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2783":55964,"_24069":55935,"_16893":93119,"_5":16788,"_22829":93046,"_2311":93120},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2783":55965,"_24069":55935,"_16893":93122,"_5":16788,"_22829":93050,"_2311":93123},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2783":55966,"_24069":55935,"_16893":93125,"_5":16788,"_22829":93050,"_2311":93126},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2783":55967,"_24069":55935,"_16893":93128,"_5":16788,"_22829":93050,"_2311":93129},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2783":55968,"_24069":55935,"_16893":93131,"_5":16788,"_22829":93050,"_2311":93132},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2783":55969,"_24069":55935,"_16893":93134,"_5":16788,"_22829":93054,"_2311":93135},[],"Para instalar un checkout local:",{"_2783":55970,"_24069":55935,"_16893":93137,"_5":16788,"_22829":93058,"_2311":93138},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2783":55971,"_24069":55935,"_16893":93140,"_5":16788,"_22829":93058,"_2311":93141},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2783":55972,"_24069":55935,"_16893":93143,"_5":16788,"_22829":93062,"_2311":93144},[],"Antes de pasar a producción, revisa:",{"_2783":55973,"_24069":55935,"_16893":93146,"_5":16788,"_22829":93062,"_2311":93147},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2783":55974,"_24069":55935,"_16893":93149,"_5":16788,"_22829":93062,"_2311":93150},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2783":55975,"_24069":55935,"_16893":93152,"_5":16788,"_22829":93062,"_2311":93153},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2783":55976,"_24069":55935,"_16893":93155,"_5":16788,"_22829":93062,"_2311":93156},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2783":55977,"_24069":55935,"_16893":93158,"_5":16788,"_22829":93062,"_2311":93159},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2783":55978,"_24069":55935,"_16893":93161,"_5":16788,"_22829":93062,"_2311":93162},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2783":55979,"_24069":55935,"_16893":93164,"_5":16788,"_22829":93062,"_2311":93165},[],"SMTP, observabilidad y entrega de alertas",{"_2783":55980,"_24069":55935,"_16893":93167,"_5":16788,"_22829":93062,"_2311":93168},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2783":55981,"_24069":55935,"_16893":93170,"_5":16788,"_22829":93062,"_2311":93171},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2783":55982,"_24069":55982,"_5":11891,"_2311":93173,"_24405":93174,"_16893":93175,"_22829":55982},"Expón el Gateway",[39337,92481,92715],[],{"_2783":55983,"_24069":55982,"_16893":93177,"_5":16788,"_22829":55982,"_2311":93178},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2783":55984,"_24069":55982,"_5":24402,"_16893":93180,"_22829":93181,"_2311":93182},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2783":55985,"_24069":55982,"_5":24402,"_16893":93184,"_22829":93185,"_2311":93186},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2783":55986,"_24069":55982,"_5":24402,"_16893":93188,"_22829":93189,"_2311":93190},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2783":55987,"_24069":55982,"_5":24402,"_16893":93192,"_22829":93193,"_2311":40083},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#k3s",{"_2783":55988,"_24069":55982,"_5":24402,"_16893":93195,"_22829":93196,"_2311":93197},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2783":55989,"_24069":55982,"_5":24402,"_16893":93199,"_22829":93200,"_2311":93201},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2783":55990,"_24069":55982,"_5":24402,"_16893":93203,"_22829":93204,"_2311":93205},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2783":55991,"_24069":55982,"_5":24402,"_16893":93207,"_22829":93208,"_2311":93209},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2783":55992,"_24069":55982,"_5":24402,"_16893":93211,"_22829":93212,"_2311":93213},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2783":55993,"_24069":55982,"_16893":93215,"_5":16788,"_22829":93181,"_2311":93216},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2783":55994,"_24069":55982,"_16893":93218,"_5":16788,"_22829":93181,"_2311":93219},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2783":55995,"_24069":55982,"_16893":93221,"_5":16788,"_22829":93185,"_2311":93222},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2783":55996,"_24069":55982,"_16893":93224,"_5":16788,"_22829":93185,"_2311":93225},[],"Defínelo únicamente cuando:",{"_2783":55997,"_24069":55982,"_16893":93227,"_5":16788,"_22829":93185,"_2311":93228},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2783":55998,"_24069":55982,"_16893":93230,"_5":16788,"_22829":93185,"_2311":93231},[],"esa dirección está asignada a este Gateway",{"_2783":55999,"_24069":55982,"_16893":93233,"_5":16788,"_22829":93185,"_2311":93234},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2783":56000,"_24069":55982,"_16893":93236,"_5":16788,"_22829":93185,"_2311":93237},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2783":56001,"_24069":55982,"_16893":93239,"_5":16788,"_22829":93185,"_2311":93240},[],"No confundas estos valores:",{"_2783":56002,"_24069":55982,"_16893":93242,"_5":16788,"_22829":93185,"_2311":93243},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2783":56003,"_24069":55982,"_16893":93245,"_5":16788,"_22829":93185,"_2311":93246},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2783":56004,"_24069":55982,"_16893":93248,"_5":16788,"_22829":93185,"_2311":93249},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2783":56005,"_24069":55982,"_16893":93251,"_5":16788,"_22829":93189,"_2311":93252},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2783":56006,"_24069":55982,"_16893":93254,"_5":16788,"_22829":93189,"_2311":93255},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2783":56007,"_24069":55982,"_16893":93257,"_5":16788,"_22829":93193,"_2311":93258},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2783":56008,"_24069":55982,"_16893":93260,"_5":16788,"_22829":93193,"_2311":93261},[],"Para el diseño recomendado:",{"_2783":56009,"_24069":55982,"_16893":93263,"_5":16788,"_22829":93193,"_2311":93264},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2783":56010,"_24069":55982,"_16893":93266,"_5":16788,"_22829":93193,"_2311":93267},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2783":56011,"_24069":55982,"_16893":93269,"_5":16788,"_22829":93193,"_2311":93270},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2783":56012,"_24069":55982,"_16893":93272,"_5":16788,"_22829":93193,"_2311":93273},[],"Apunta DNS a la dirección accesible de la VM.",{"_2783":56013,"_24069":55982,"_16893":93275,"_5":16788,"_22829":93193,"_2311":93276},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2783":56014,"_24069":55982,"_16893":93278,"_5":16788,"_22829":93196,"_2311":93279},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2783":56015,"_24069":55982,"_16893":93281,"_5":16788,"_22829":93200,"_2311":93282},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2783":56016,"_24069":55982,"_16893":93284,"_5":16788,"_22829":93200,"_2311":93285},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2783":56017,"_24069":55982,"_16893":93287,"_5":16788,"_22829":93204,"_2311":93288},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2783":56018,"_24069":55982,"_16893":93290,"_5":16788,"_22829":93204,"_2311":93291},[],"Requisito",{"_2783":56019,"_24069":55982,"_16893":93293,"_5":16788,"_22829":93204,"_2311":93294},[],"Diseño recomendado",{"_2783":56020,"_24069":55982,"_16893":93296,"_5":16788,"_22829":93204,"_2311":93297},[],"Consecuencia",{"_2783":56021,"_24069":55982,"_16893":93299,"_5":16788,"_22829":93204,"_2311":93300},[],"Varias URL o servicios de Lamassu",{"_2783":56022,"_24069":55982,"_16893":93302,"_5":16788,"_22829":93204,"_2311":93303},[],"Un Gateway con varias rutas",{"_2783":56023,"_24069":55982,"_16893":93305,"_5":16788,"_22829":93204,"_2311":93306},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2783":56024,"_24069":55982,"_16893":93308,"_5":16788,"_22829":93204,"_2311":93309},[],"Gateways independientes e IP externas distintas",{"_2783":56025,"_24069":55982,"_16893":93311,"_5":16788,"_22829":93204,"_2311":93312},[],"Una VIP por Gateway",{"_2783":56026,"_24069":55982,"_16893":93314,"_5":16788,"_22829":93204,"_2311":93315},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2783":56027,"_24069":55982,"_16893":93317,"_5":16788,"_22829":93204,"_2311":93318},[],"Gateways independientes, un nodo y una IP",{"_2783":56028,"_24069":55982,"_16893":93320,"_5":16788,"_22829":93204,"_2311":93321},[],"Puertos externos diferentes",{"_2783":56029,"_24069":55982,"_16893":93323,"_5":16788,"_22829":93204,"_2311":93324},[],"Los clientes deben indicar puertos no estándar",{"_2783":56030,"_24069":55982,"_16893":93326,"_5":16788,"_22829":93204,"_2311":93327},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2783":56031,"_24069":55982,"_16893":93329,"_5":16788,"_22829":93204,"_2311":93330},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2783":56032,"_24069":55982,"_16893":93332,"_5":16788,"_22829":93204,"_2311":93333},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2783":56033,"_24069":55982,"_16893":93335,"_5":16788,"_22829":93204,"_2311":93336},[],"Recursos Gateway separados pero proxy compartido",{"_2783":56034,"_24069":55982,"_16893":93338,"_5":16788,"_22829":93204,"_2311":93339},[],"Modo merged Gateway de Envoy",{"_2783":56035,"_24069":55982,"_16893":93341,"_5":16788,"_22829":93204,"_2311":93342},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2783":56036,"_24069":55982,"_16893":93344,"_5":16788,"_22829":93204,"_2311":93345},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2783":56037,"_24069":55982,"_16893":93347,"_5":16788,"_22829":93204,"_2311":93348},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2783":56038,"_24069":55982,"_16893":93350,"_5":16788,"_22829":93204,"_2311":93351},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2783":56039,"_24069":55982,"_16893":93353,"_5":16788,"_22829":93204,"_2311":93354},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2783":56040,"_24069":55982,"_16893":93356,"_5":16788,"_22829":93208,"_2311":93357},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2783":56041,"_24069":55982,"_16893":93359,"_5":16788,"_22829":93208,"_2311":93360},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2783":56042,"_24069":55982,"_16893":93362,"_5":16788,"_22829":93208,"_2311":93363},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2783":56043,"_24069":55982,"_16893":93365,"_5":16788,"_22829":93208,"_2311":93366},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2783":56044,"_24069":55982,"_16893":93368,"_5":16788,"_22829":93208,"_2311":93369},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2783":56045,"_24069":55982,"_16893":93371,"_5":16788,"_22829":93212,"_2311":93372},[],"Comprueba, en orden:",{"_2783":56046,"_24069":55982,"_16893":93374,"_5":16788,"_22829":93212,"_2311":93375},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2783":56047,"_24069":55982,"_16893":93377,"_5":16788,"_22829":93212,"_2311":93378},[],"Su estado contiene la dirección esperada.",{"_2783":56048,"_24069":55982,"_16893":93380,"_5":16788,"_22829":93212,"_2311":93381},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2783":56049,"_24069":55982,"_16893":93383,"_5":16788,"_22829":93212,"_2311":93384},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2783":56050,"_24069":55982,"_16893":93386,"_5":16788,"_22829":93212,"_2311":93387},[],"DNS resuelve al endpoint accesible externamente.",{"_2783":56051,"_24069":55982,"_16893":93389,"_5":16788,"_22829":93212,"_2311":93390},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2783":56052,"_24069":55982,"_16893":93392,"_5":16788,"_22829":93212,"_2311":93393},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2783":56053,"_24069":56053,"_5":11891,"_2311":39444,"_24405":93395,"_16893":93396,"_22829":56053},[39337,92481,92715],[],{"_2783":56054,"_24069":56053,"_16893":93398,"_5":16788,"_22829":56053,"_2311":93399},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2783":56055,"_24069":56053,"_5":24402,"_16893":93401,"_22829":93402,"_2311":93403},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2783":56056,"_24069":56053,"_5":24402,"_16893":93405,"_22829":93406,"_2311":93407},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2783":56057,"_24069":56053,"_5":24402,"_16893":93409,"_22829":93410,"_2311":93411},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2783":56058,"_24069":56053,"_5":24402,"_16893":93413,"_22829":93414,"_2311":93415},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2783":56059,"_24069":56053,"_5":24402,"_16893":93417,"_22829":93418,"_2311":93419},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2783":56060,"_24069":56053,"_5":24402,"_16893":93421,"_22829":93422,"_2311":93423},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2783":56061,"_24069":56053,"_16893":93425,"_5":16788,"_22829":93402,"_2311":93426},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2783":56062,"_24069":56053,"_16893":93428,"_5":16788,"_22829":93406,"_2311":93429},[],"Flujo",{"_2783":56063,"_24069":56053,"_16893":93431,"_5":16788,"_22829":93406,"_2311":93432},[],"Úsalo para",{"_2783":56064,"_24069":56053,"_16893":93434,"_5":16788,"_22829":93406,"_2311":93435},[],"Qué instala",{"_2783":56065,"_24069":56053,"_16893":93437,"_5":16788,"_22829":93406,"_2311":40328},[],{"_2783":56066,"_24069":56053,"_16893":93439,"_5":16788,"_22829":93406,"_2311":93440},[],"Producción y entornos controlados",{"_2783":56067,"_24069":56053,"_16893":93442,"_5":16788,"_22829":93406,"_2311":93443},[],"Servicios de Lamassu y recursos de Gateway API",{"_2783":56068,"_24069":56053,"_16893":93445,"_5":16788,"_22829":93406,"_2311":39581},[],{"_2783":56069,"_24069":56053,"_16893":93447,"_5":16788,"_22829":93406,"_2311":93448},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2783":56070,"_24069":56053,"_16893":93450,"_5":16788,"_22829":93406,"_2311":93451},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2783":56071,"_24069":56053,"_16893":93453,"_5":16788,"_22829":93410,"_2311":93454},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2783":56072,"_24069":56053,"_16893":93456,"_5":16788,"_22829":93410,"_2311":93457},[],"Área",{"_2783":56073,"_24069":56053,"_16893":93459,"_5":16788,"_22829":93410,"_2311":93460},[],"El chart de Lamassu proporciona",{"_2783":56074,"_24069":56053,"_16893":93462,"_5":16788,"_22829":93410,"_2311":93463},[],"Tú proporcionas",{"_2783":56075,"_24069":56053,"_16893":93465,"_5":16788,"_22829":93410,"_2311":93466},[],"Aplicaciones Lamassu",{"_2783":56076,"_24069":56053,"_16893":93468,"_5":16788,"_22829":93410,"_2311":93469},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2783":56077,"_24069":56053,"_16893":93471,"_5":16788,"_22829":93410,"_2311":93472},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2783":56078,"_24069":56053,"_16893":93474,"_5":16788,"_22829":93410,"_2311":93475},[],"Datos PostgreSQL",{"_2783":56079,"_24069":56053,"_16893":93477,"_5":16788,"_22829":93410,"_2311":93478},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2783":56080,"_24069":56053,"_16893":93480,"_5":16788,"_22829":93410,"_2311":93481},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2783":56081,"_24069":56053,"_16893":93483,"_5":16788,"_22829":93410,"_2311":93484},[],"Mensajería",{"_2783":56082,"_24069":56053,"_16893":93486,"_5":16788,"_22829":93410,"_2311":93487},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2783":56083,"_24069":56053,"_16893":93489,"_5":16788,"_22829":93410,"_2311":93490},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2783":56084,"_24069":56053,"_16893":93492,"_5":16788,"_22829":93410,"_2311":93493},[],"Identidad",{"_2783":56085,"_24069":56053,"_16893":93495,"_5":16788,"_22829":93410,"_2311":93496},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2783":56086,"_24069":56053,"_16893":93498,"_5":16788,"_22829":93410,"_2311":93499},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2783":56087,"_24069":56053,"_16893":93501,"_5":16788,"_22829":93410,"_2311":93502},[],"Enrutamiento externo",{"_2783":56088,"_24069":56053,"_16893":93504,"_5":16788,"_22829":93410,"_2311":93505},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2783":56089,"_24069":56053,"_16893":93507,"_5":16788,"_22829":93410,"_2311":93508},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2783":56090,"_24069":56053,"_16893":93510,"_5":16788,"_22829":93410,"_2311":40402},[],{"_2783":56091,"_24069":56053,"_16893":93512,"_5":16788,"_22829":93410,"_2311":93513},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2783":56092,"_24069":56053,"_16893":93515,"_5":16788,"_22829":93410,"_2311":93516},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2783":56093,"_24069":56053,"_16893":93518,"_5":16788,"_22829":93410,"_2311":93519},[],"Datos persistentes de la aplicación",{"_2783":56094,"_24069":56053,"_16893":93521,"_5":16788,"_22829":93410,"_2311":93522},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2783":56095,"_24069":56053,"_16893":93524,"_5":16788,"_22829":93410,"_2311":93525},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2783":56096,"_24069":56053,"_16893":93527,"_5":16788,"_22829":93410,"_2311":93528},[],"Integraciones opcionales",{"_2783":56097,"_24069":56053,"_16893":93530,"_5":16788,"_22829":93410,"_2311":93531},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2783":56098,"_24069":56053,"_16893":93533,"_5":16788,"_22829":93410,"_2311":93534},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2783":56099,"_24069":56053,"_16893":93536,"_5":16788,"_22829":93410,"_2311":93537},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2783":56100,"_24069":56053,"_16893":93539,"_5":16788,"_22829":93410,"_2311":93540},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2783":56101,"_24069":56053,"_16893":93542,"_5":16788,"_22829":93414,"_2311":93543},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2783":56102,"_24069":56053,"_16893":93545,"_5":16788,"_22829":93414,"_2311":93546},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2783":56103,"_24069":56053,"_16893":93548,"_5":16788,"_22829":93418,"_2311":93549},[],"Kubernetes 1.24 o posterior",{"_2783":56104,"_24069":56053,"_16893":93551,"_5":16788,"_22829":93418,"_2311":93552},[],"Helm 3.2 o posterior",{"_2783":56105,"_24069":56053,"_16893":93554,"_5":16788,"_22829":93418,"_2311":93555},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2783":56106,"_24069":56053,"_16893":93557,"_5":16788,"_22829":93418,"_2311":93558},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2783":56107,"_24069":56053,"_16893":93560,"_5":16788,"_22829":93418,"_2311":93561},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2783":56108,"_24069":56053,"_16893":93563,"_5":16788,"_22829":93418,"_2311":93564},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2783":56109,"_24069":56053,"_16893":93566,"_5":16788,"_22829":93418,"_2311":93567},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2783":56110,"_24069":56053,"_16893":93569,"_5":16788,"_22829":93422,"_2311":93570},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2783":56111,"_24069":56053,"_16893":93572,"_5":16788,"_22829":93422,"_2311":93573},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2783":56112,"_24069":56053,"_16893":93575,"_5":16788,"_22829":93422,"_2311":93576},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2783":56113,"_24069":56113,"_5":11891,"_2311":93578,"_24405":93579,"_16893":93581,"_22829":56113},"Resolución de problemas de despliegue",[39337,92481,93580],"Operación",[],{"_2783":56114,"_24069":56113,"_16893":93583,"_5":16788,"_22829":56113,"_2311":93584},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2783":56115,"_24069":56113,"_5":24402,"_16893":93586,"_22829":93587,"_2311":93588},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2783":56116,"_24069":56113,"_5":24402,"_16893":93590,"_22829":93591,"_2311":93592},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2783":56117,"_24069":56113,"_5":24402,"_16893":93594,"_22829":93595,"_2311":93596},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2783":56118,"_24069":56113,"_5":24402,"_16893":93598,"_22829":93599,"_2311":93600},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2783":56119,"_24069":56113,"_5":24402,"_16893":93602,"_22829":93603,"_2311":93604},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2783":56120,"_24069":56113,"_5":24402,"_16893":93606,"_22829":93607,"_2311":93608},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2783":56121,"_24069":56113,"_5":24402,"_16893":93610,"_22829":93611,"_2311":93612},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2783":56122,"_24069":56113,"_5":24402,"_16893":93614,"_22829":93615,"_2311":93616},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2783":56123,"_24069":56113,"_5":24402,"_16893":93618,"_22829":93619,"_2311":93620},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2783":56124,"_24069":56113,"_5":24402,"_16893":93622,"_22829":93623,"_2311":93624},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2783":56125,"_24069":56113,"_5":24402,"_16893":93626,"_22829":93627,"_2311":93628},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2783":56126,"_24069":56113,"_5":24402,"_16893":93630,"_22829":93631,"_2311":93632},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2783":56127,"_24069":56113,"_16893":93634,"_5":16788,"_22829":56113,"_2311":93635},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2783":56128,"_24069":56113,"_16893":93637,"_5":16788,"_22829":93591,"_2311":93638},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2783":56129,"_24069":56113,"_16893":93640,"_5":16788,"_22829":93595,"_2311":93641},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2783":56130,"_24069":56113,"_16893":93643,"_5":16788,"_22829":93599,"_2311":93644},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2783":56131,"_24069":56113,"_16893":93646,"_5":16788,"_22829":93603,"_2311":93647},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2783":56132,"_24069":56113,"_16893":93649,"_5":16788,"_22829":93607,"_2311":93650},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2783":56133,"_24069":56113,"_16893":93652,"_5":16788,"_22829":93611,"_2311":93653},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2783":56134,"_24069":56113,"_16893":93655,"_5":16788,"_22829":93611,"_2311":93656},[],"Ejecuta también la prueba de conectividad del chart:",{"_2783":56135,"_24069":56113,"_16893":93658,"_5":16788,"_22829":93611,"_2311":93659},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2783":56136,"_24069":56113,"_16893":93661,"_5":16788,"_22829":93611,"_2311":93662},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2783":56137,"_24069":56113,"_16893":93664,"_5":16788,"_22829":93615,"_2311":93665},[],"Si recibes un 401:",{"_2783":56138,"_24069":56113,"_16893":93667,"_5":16788,"_22829":93615,"_2311":93668},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2783":56139,"_24069":56113,"_16893":93670,"_5":16788,"_22829":93615,"_2311":93671},[],"verifica emisor, audiencia y expiración del token;",{"_2783":56140,"_24069":56113,"_16893":93673,"_5":16788,"_22829":93615,"_2311":93674},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2783":56141,"_24069":56113,"_16893":93676,"_5":16788,"_22829":93615,"_2311":93677},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2783":56142,"_24069":56113,"_16893":93679,"_5":16788,"_22829":93615,"_2311":93680},[],"Si el login termina pero las APIs devuelven 403:",{"_2783":56143,"_24069":56113,"_16893":93682,"_5":16788,"_22829":93615,"_2311":93683},[],"inspecciona los claims reales del token;",{"_2783":56144,"_24069":56113,"_16893":93685,"_5":16788,"_22829":93615,"_2311":93686},[],"confirma que coinciden con un principal activo;",{"_2783":56145,"_24069":56113,"_16893":93688,"_5":16788,"_22829":93615,"_2311":93689},[],"revisa las políticas concedidas al principal;",{"_2783":56146,"_24069":56113,"_16893":93691,"_5":16788,"_22829":93615,"_2311":93692},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2783":56147,"_24069":56113,"_16893":93694,"_5":16788,"_22829":93615,"_2311":93695},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2783":56148,"_24069":56113,"_16893":93697,"_5":16788,"_22829":93619,"_2311":93698},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2783":56149,"_24069":56113,"_16893":93700,"_5":16788,"_22829":93619,"_2311":93701},[],"Localiza el pod y Service de authz.",{"_2783":56150,"_24069":56113,"_16893":93703,"_5":16788,"_22829":93619,"_2311":93704},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2783":56151,"_24069":56113,"_16893":93706,"_5":16788,"_22829":93619,"_2311":93707},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2783":56152,"_24069":56113,"_16893":93709,"_5":16788,"_22829":93619,"_2311":93710},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2783":56153,"_24069":56113,"_16893":93712,"_5":16788,"_22829":93619,"_2311":93713},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2783":56154,"_24069":56113,"_16893":93715,"_5":16788,"_22829":93623,"_2311":93716},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2783":56155,"_24069":56113,"_16893":93718,"_5":16788,"_22829":93623,"_2311":93719},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2783":56156,"_24069":56113,"_16893":93721,"_5":16788,"_22829":93623,"_2311":93722},[],"volumen persistente sin enlazar;",{"_2783":56157,"_24069":56113,"_16893":93724,"_5":16788,"_22829":93623,"_2311":93725},[],"imagen inaccesible o política de pull incorrecta;",{"_2783":56158,"_24069":56113,"_16893":93727,"_5":16788,"_22829":93623,"_2311":93728},[],"configuración inválida del motor criptográfico;",{"_2783":56159,"_24069":56113,"_16893":93730,"_5":16788,"_22829":93623,"_2311":93731},[],"límites de CPU o memoria demasiado bajos;",{"_2783":56160,"_24069":56113,"_16893":93733,"_5":16788,"_22829":93623,"_2311":93734},[],"migración previa incompleta.",{"_2783":56161,"_24069":56113,"_16893":93736,"_5":16788,"_22829":93623,"_2311":93737},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2783":56162,"_24069":56113,"_16893":93739,"_5":16788,"_22829":93623,"_2311":93740},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2783":56163,"_24069":56113,"_16893":93742,"_5":16788,"_22829":93627,"_2311":93743},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2783":56164,"_24069":56113,"_16893":93745,"_5":16788,"_22829":93627,"_2311":93746},[],"verifica que esté habilitado en el servicio emisor;",{"_2783":56165,"_24069":56113,"_16893":93748,"_5":16788,"_22829":93627,"_2311":93749},[],"comprueba conectividad y credenciales AMQP;",{"_2783":56166,"_24069":56113,"_16893":93751,"_5":16788,"_22829":93627,"_2311":93752},[],"revisa exchange, routing key, colas y consumidores;",{"_2783":56167,"_24069":56113,"_16893":93754,"_5":16788,"_22829":93627,"_2311":93755},[],"inspecciona dead-letter queues;",{"_2783":56168,"_24069":56113,"_16893":93757,"_5":16788,"_22829":93627,"_2311":93758},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2783":56169,"_24069":56113,"_16893":93760,"_5":16788,"_22829":93627,"_2311":93761},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2783":56170,"_24069":56113,"_16893":93763,"_5":16788,"_22829":93631,"_2311":93764},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2783":56171,"_24069":56113,"_16893":93766,"_5":16788,"_22829":93631,"_2311":93767},[],"Antes de cerrar una incidencia, guarda:",{"_2783":56172,"_24069":56113,"_16893":93769,"_5":16788,"_22829":93631,"_2311":93770},[],"causa confirmada;",{"_2783":56173,"_24069":56113,"_16893":93772,"_5":16788,"_22829":93631,"_2311":93773},[],"alcance temporal y recursos afectados;",{"_2783":56174,"_24069":56113,"_16893":93775,"_5":16788,"_22829":93631,"_2311":93776},[],"comandos o consultas utilizados;",{"_2783":56175,"_24069":56113,"_16893":93778,"_5":16788,"_22829":93631,"_2311":93779},[],"cambio aplicado y forma de revertirlo;",{"_2783":56176,"_24069":56113,"_16893":93781,"_5":16788,"_22829":93631,"_2311":93782},[],"validación desde un consumidor;",{"_2783":56177,"_24069":56113,"_16893":93784,"_5":16788,"_22829":93631,"_2311":93785},[],"acción preventiva y propietario.",{"_2783":56178,"_24069":56178,"_5":11891,"_2311":93787,"_24405":93788,"_16893":93791,"_22829":56178},"Control de acceso",[39337,93789,93790],"Plataforma","Administración",[],{"_2783":56179,"_24069":56178,"_16893":93793,"_5":16788,"_22829":56178,"_2311":93794},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2783":56180,"_24069":56178,"_5":24402,"_16893":93796,"_22829":93797,"_2311":93798},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2783":56181,"_24069":56178,"_5":24402,"_16893":93800,"_22829":93801,"_2311":93802},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2783":56182,"_24069":56178,"_5":24402,"_16893":93804,"_22829":93805,"_2311":93806},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2783":56183,"_24069":56178,"_5":24402,"_16893":93808,"_22829":93809,"_2311":93810},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2783":56184,"_24069":56178,"_5":24402,"_16893":93812,"_22829":93813,"_2311":93814},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2783":56185,"_24069":56178,"_5":24402,"_16893":93816,"_22829":93817,"_2311":93818},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2783":56186,"_24069":56178,"_5":24402,"_16893":93820,"_22829":93821,"_2311":93822},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2783":56187,"_24069":56178,"_5":24402,"_16893":93824,"_22829":93825,"_2311":93826},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2783":56188,"_24069":56178,"_5":24402,"_16893":93828,"_22829":93829,"_2311":93830},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2783":56189,"_24069":56178,"_5":24402,"_16893":93832,"_22829":93833,"_2311":93834},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2783":56190,"_24069":56178,"_5":24402,"_16893":93836,"_22829":93837,"_2311":93838},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2783":56191,"_24069":56178,"_5":24402,"_16893":93840,"_22829":93841,"_2311":93842},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2783":56192,"_24069":56178,"_5":24402,"_16893":93844,"_22829":93845,"_2311":93846},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2783":56193,"_24069":56178,"_5":24402,"_16893":93848,"_22829":93849,"_2311":93850},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2783":56194,"_24069":56178,"_5":24402,"_16893":93852,"_22829":93853,"_2311":93051},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2783":56195,"_24069":56178,"_5":24402,"_16893":93855,"_22829":93856,"_2311":93857},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2783":56196,"_24069":56178,"_5":24402,"_16893":93859,"_22829":93860,"_2311":93861},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2783":56197,"_24069":56178,"_5":24402,"_16893":93863,"_22829":93864,"_2311":93865},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2783":56198,"_24069":56178,"_5":24402,"_16893":93867,"_22829":93868,"_2311":93869},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2783":56199,"_24069":56178,"_5":24402,"_16893":93871,"_22829":93872,"_2311":93873},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2783":56200,"_24069":56178,"_5":24402,"_16893":93875,"_22829":93876,"_2311":93877},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2783":56201,"_24069":56178,"_5":24402,"_16893":93879,"_22829":93880,"_2311":93881},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2783":56202,"_24069":56178,"_5":24402,"_16893":93883,"_22829":93884,"_2311":93885},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2783":56203,"_24069":56178,"_5":24402,"_16893":93887,"_22829":93888,"_2311":93889},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2783":56204,"_24069":56178,"_5":24402,"_16893":93891,"_22829":93892,"_2311":93893},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2783":56205,"_24069":56178,"_5":24402,"_16893":93895,"_22829":93896,"_2311":93897},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2783":56206,"_24069":56178,"_5":24402,"_16893":93899,"_22829":93900,"_2311":93901},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2783":56207,"_24069":56178,"_5":24402,"_16893":93903,"_22829":93904,"_2311":93905},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2783":56208,"_24069":56178,"_5":24402,"_16893":93907,"_22829":93908,"_2311":93909},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2783":56209,"_24069":56178,"_16893":93911,"_5":16788,"_22829":56178,"_2311":93912},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2783":56210,"_24069":56178,"_16893":93914,"_5":16788,"_22829":56178,"_2311":93915},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2783":56211,"_24069":56178,"_16893":93917,"_5":16788,"_22829":56178,"_2311":93918},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2783":56212,"_24069":56178,"_16893":93920,"_5":16788,"_22829":93797,"_2311":93921},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2783":56213,"_24069":56178,"_16893":93923,"_5":16788,"_22829":93797,"_2311":93924},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2783":56214,"_24069":56178,"_16893":93926,"_5":16788,"_22829":93797,"_2311":93927},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2783":56215,"_24069":56178,"_16893":93929,"_5":16788,"_22829":93797,"_2311":93930},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2783":56216,"_24069":56178,"_16893":93932,"_5":16788,"_22829":93797,"_2311":93933},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2783":56217,"_24069":56178,"_16893":93935,"_5":16788,"_22829":93797,"_2311":93936},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y alguna de sus políticas debe permitir la operación solicitada.",{"_2783":56218,"_24069":56178,"_16893":93938,"_5":16788,"_22829":93801,"_2311":93939},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2783":56219,"_24069":56178,"_16893":93941,"_5":16788,"_22829":93801,"_2311":93942},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2783":56220,"_24069":56178,"_16893":93944,"_5":16788,"_22829":93805,"_2311":93945},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2783":56221,"_24069":56178,"_16893":93947,"_5":16788,"_22829":93805,"_2311":93948},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2783":56222,"_24069":56178,"_16893":93950,"_5":16788,"_22829":93805,"_2311":93951},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2783":56223,"_24069":56178,"_16893":93953,"_5":16788,"_22829":93805,"_2311":93954},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2783":56224,"_24069":56178,"_16893":93956,"_5":16788,"_22829":93805,"_2311":93957},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2783":56225,"_24069":56178,"_16893":93959,"_5":16788,"_22829":93805,"_2311":93960},[],"Carga por separado las políticas concedidas a cada principal.",{"_2783":56226,"_24069":56178,"_16893":93962,"_5":16788,"_22829":93805,"_2311":93963},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2783":56227,"_24069":56178,"_16893":93965,"_5":16788,"_22829":93805,"_2311":93966},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2783":56228,"_24069":56178,"_16893":93968,"_5":16788,"_22829":93805,"_2311":93969},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política.",{"_2783":56229,"_24069":56178,"_16893":93971,"_5":16788,"_22829":93805,"_2311":93972},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2783":56230,"_24069":56178,"_16893":93974,"_5":16788,"_22829":93805,"_2311":93975},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2783":56231,"_24069":56178,"_16893":93977,"_5":16788,"_22829":93805,"_2311":93978},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, el esquema debe declarar una restricción que relacione un valor de la petición con un atributo normalizado del principal.",{"_2783":56232,"_24069":56178,"_16893":93980,"_5":16788,"_22829":93809,"_2311":93981},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2783":56233,"_24069":56178,"_16893":93983,"_5":16788,"_22829":93809,"_2311":93984},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2783":56234,"_24069":56178,"_16893":93986,"_5":16788,"_22829":93809,"_2311":93987},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2783":56235,"_24069":56178,"_16893":93989,"_5":16788,"_22829":93809,"_2311":93990},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2783":56236,"_24069":56178,"_16893":93992,"_5":16788,"_22829":93809,"_2311":93993},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2783":56237,"_24069":56178,"_16893":93995,"_5":16788,"_22829":93809,"_2311":93996},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2783":56238,"_24069":56178,"_16893":93998,"_5":16788,"_22829":93809,"_2311":93999},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2783":56239,"_24069":56178,"_16893":94001,"_5":16788,"_22829":93809,"_2311":94002},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2783":56240,"_24069":56178,"_16893":94004,"_5":16788,"_22829":93809,"_2311":94005},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2783":56241,"_24069":56178,"_16893":94007,"_5":16788,"_22829":93809,"_2311":94008},[],"Las acciones se dividen en dos grupos:",{"_2783":56242,"_24069":56178,"_16893":94010,"_5":16788,"_22829":93809,"_2311":94011},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2783":56243,"_24069":56178,"_16893":94013,"_5":16788,"_22829":93809,"_2311":94014},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2783":56244,"_24069":56178,"_16893":94016,"_5":16788,"_22829":93809,"_2311":94017},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2783":56245,"_24069":56178,"_16893":94019,"_5":16788,"_22829":93813,"_2311":94020},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2783":56246,"_24069":56178,"_16893":94022,"_5":16788,"_22829":93813,"_2311":94023},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2783":56247,"_24069":56178,"_16893":94025,"_5":16788,"_22829":93813,"_2311":94026},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega. Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2783":56248,"_24069":56178,"_16893":94028,"_5":16788,"_22829":93817,"_2311":94029},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2783":56249,"_24069":56178,"_16893":94031,"_5":16788,"_22829":93817,"_2311":94032},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2783":56250,"_24069":56178,"_16893":94034,"_5":16788,"_22829":93817,"_2311":94035},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2783":56251,"_24069":56178,"_16893":94037,"_5":16788,"_22829":93817,"_2311":94038},[],"Los operadores implementados son:",{"_2783":56252,"_24069":56178,"_16893":94040,"_5":16788,"_22829":93817,"_2311":94041},[],"`equals`, para igualdad exacta;",{"_2783":56253,"_24069":56178,"_16893":94043,"_5":16788,"_22829":93817,"_2311":94044},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2783":56254,"_24069":56178,"_16893":94046,"_5":16788,"_22829":93817,"_2311":94047},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2783":56255,"_24069":56178,"_16893":94049,"_5":16788,"_22829":93817,"_2311":94050},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2783":56256,"_24069":56178,"_16893":94052,"_5":16788,"_22829":93821,"_2311":94053},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2783":56257,"_24069":56178,"_16893":94055,"_5":16788,"_22829":93821,"_2311":94056},[],"Los modos disponibles son:",{"_2783":56258,"_24069":56178,"_16893":94058,"_5":16788,"_22829":93821,"_2311":94059},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2783":56259,"_24069":56178,"_16893":94061,"_5":16788,"_22829":93821,"_2311":94062},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2783":56260,"_24069":56178,"_16893":94064,"_5":16788,"_22829":93821,"_2311":94065},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2783":56261,"_24069":56178,"_16893":94067,"_5":16788,"_22829":93821,"_2311":94068},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2783":56262,"_24069":56178,"_16893":94070,"_5":16788,"_22829":93821,"_2311":94071},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2783":56263,"_24069":56178,"_16893":94073,"_5":16788,"_22829":93821,"_2311":94074},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2783":56264,"_24069":56178,"_16893":94076,"_5":16788,"_22829":93825,"_2311":94077},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2783":56265,"_24069":56178,"_16893":94079,"_5":16788,"_22829":93825,"_2311":94080},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2783":56266,"_24069":56178,"_16893":94082,"_5":16788,"_22829":93825,"_2311":94083},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2783":56267,"_24069":56178,"_16893":94085,"_5":16788,"_22829":93825,"_2311":94086},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2783":56268,"_24069":56178,"_16893":94088,"_5":16788,"_22829":93833,"_2311":94089},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2783":56269,"_24069":56178,"_16893":94091,"_5":16788,"_22829":93833,"_2311":94092},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2783":56270,"_24069":56178,"_16893":94094,"_5":16788,"_22829":93837,"_2311":94095},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2783":56271,"_24069":56178,"_16893":94097,"_5":16788,"_22829":93837,"_2311":94098},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2783":56272,"_24069":56178,"_16893":94100,"_5":16788,"_22829":93841,"_2311":94101},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2783":56273,"_24069":56178,"_16893":94103,"_5":16788,"_22829":93841,"_2311":94104},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2783":56274,"_24069":56178,"_16893":94106,"_5":16788,"_22829":93841,"_2311":94107},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2783":56275,"_24069":56178,"_16893":94109,"_5":16788,"_22829":93845,"_2311":94110},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2783":56276,"_24069":56178,"_16893":94112,"_5":16788,"_22829":93845,"_2311":94113},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2783":56277,"_24069":56178,"_16893":94115,"_5":16788,"_22829":93845,"_2311":94116},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2783":56278,"_24069":56178,"_16893":94118,"_5":16788,"_22829":93849,"_2311":94119},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2783":56279,"_24069":56178,"_16893":94121,"_5":16788,"_22829":93849,"_2311":94122},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2783":56280,"_24069":56178,"_16893":94124,"_5":16788,"_22829":93849,"_2311":94125},[],"acceso completo y de solo lectura a KMS;",{"_2783":56281,"_24069":56178,"_16893":94127,"_5":16788,"_22829":93849,"_2311":94128},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2783":56282,"_24069":56178,"_16893":94130,"_5":16788,"_22829":93849,"_2311":94131},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2783":56283,"_24069":56178,"_16893":94133,"_5":16788,"_22829":93849,"_2311":94134},[],"acceso a la interfaz;",{"_2783":56284,"_24069":56178,"_16893":94136,"_5":16788,"_22829":93849,"_2311":94137},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2783":56285,"_24069":56178,"_16893":94139,"_5":16788,"_22829":93849,"_2311":94140},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2783":56286,"_24069":56178,"_16893":94142,"_5":16788,"_22829":93849,"_2311":94143},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2783":56287,"_24069":56178,"_16893":94145,"_5":16788,"_22829":93853,"_2311":94146},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2783":56288,"_24069":56178,"_16893":94148,"_5":16788,"_22829":93853,"_2311":94149},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2783":56289,"_24069":56178,"_16893":94151,"_5":16788,"_22829":93853,"_2311":94152},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2783":56290,"_24069":56178,"_16893":94154,"_5":16788,"_22829":93856,"_2311":94155},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2783":56291,"_24069":56178,"_16893":94157,"_5":16788,"_22829":93860,"_2311":94158},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2783":56292,"_24069":56178,"_16893":94160,"_5":16788,"_22829":93864,"_2311":94161},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2783":56293,"_24069":56178,"_16893":94163,"_5":16788,"_22829":93868,"_2311":94164},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2783":56294,"_24069":56178,"_16893":94166,"_5":16788,"_22829":93872,"_2311":94167},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2783":56295,"_24069":56178,"_16893":94169,"_5":16788,"_22829":93876,"_2311":94170},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2783":56296,"_24069":56178,"_16893":94172,"_5":16788,"_22829":93876,"_2311":94173},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2783":56297,"_24069":56178,"_16893":94175,"_5":16788,"_22829":93880,"_2311":94176},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2783":56298,"_24069":56178,"_16893":94178,"_5":16788,"_22829":93880,"_2311":94179},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2783":56299,"_24069":56178,"_16893":94181,"_5":16788,"_22829":93880,"_2311":94182},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2783":56300,"_24069":56178,"_16893":94184,"_5":16788,"_22829":93880,"_2311":94185},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2783":56301,"_24069":56178,"_16893":94187,"_5":16788,"_22829":93880,"_2311":94188},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2783":56302,"_24069":56178,"_16893":94190,"_5":16788,"_22829":93880,"_2311":94191},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2783":56303,"_24069":56178,"_16893":94193,"_5":16788,"_22829":93880,"_2311":94194},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2783":56304,"_24069":56178,"_16893":94196,"_5":16788,"_22829":93880,"_2311":94197},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2783":56305,"_24069":56178,"_16893":94199,"_5":16788,"_22829":93884,"_2311":94200},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2783":56306,"_24069":56178,"_16893":94202,"_5":16788,"_22829":93884,"_2311":94203},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2783":56307,"_24069":56178,"_16893":94205,"_5":16788,"_22829":93884,"_2311":94206},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2783":56308,"_24069":56178,"_16893":94208,"_5":16788,"_22829":93888,"_2311":94209},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2783":56309,"_24069":56178,"_16893":94211,"_5":16788,"_22829":93888,"_2311":94212},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2783":56310,"_24069":56178,"_16893":94214,"_5":16788,"_22829":93888,"_2311":94215},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2783":56311,"_24069":56178,"_16893":94217,"_5":16788,"_22829":93888,"_2311":94218},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2783":56312,"_24069":56178,"_16893":94220,"_5":16788,"_22829":93888,"_2311":94221},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2783":56313,"_24069":56178,"_16893":94223,"_5":16788,"_22829":93888,"_2311":94224},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2783":56314,"_24069":56178,"_16893":94226,"_5":16788,"_22829":93888,"_2311":94227},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2783":56315,"_24069":56178,"_16893":94229,"_5":16788,"_22829":93896,"_2311":94230},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2783":56316,"_24069":56178,"_16893":94232,"_5":16788,"_22829":93900,"_2311":94233},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2783":56317,"_24069":56178,"_16893":94235,"_5":16788,"_22829":93900,"_2311":94236},[],"que exista un principal activo del tipo correcto;",{"_2783":56318,"_24069":56178,"_16893":94238,"_5":16788,"_22829":93900,"_2311":94239},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2783":56319,"_24069":56178,"_16893":94241,"_5":16788,"_22829":93900,"_2311":94242},[],"que todas las condiciones del principal se cumplan;",{"_2783":56320,"_24069":56178,"_16893":94244,"_5":16788,"_22829":93900,"_2311":94245},[],"que el principal tenga concedida la política esperada;",{"_2783":56321,"_24069":56178,"_16893":94247,"_5":16788,"_22829":93900,"_2311":94248},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2783":56322,"_24069":56178,"_16893":94250,"_5":16788,"_22829":93900,"_2311":94251},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2783":56323,"_24069":56178,"_16893":94253,"_5":16788,"_22829":93900,"_2311":94254},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos.",{"_2783":56324,"_24069":56178,"_16893":94256,"_5":16788,"_22829":93904,"_2311":94257},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2783":56325,"_24069":56178,"_16893":94259,"_5":16788,"_22829":93908,"_2311":94260},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2783":56326,"_24069":56178,"_16893":94262,"_5":16788,"_22829":93908,"_2311":94263},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2783":56327,"_24069":56327,"_5":11891,"_2311":94265,"_24405":94266,"_16893":94267,"_22829":56327},"Alertas y suscripciones",[39337,93789,93790],[],{"_2783":56328,"_24069":56327,"_16893":94269,"_5":16788,"_22829":56327,"_2311":94270},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2783":56329,"_24069":56327,"_5":24402,"_16893":94272,"_22829":94273,"_2311":94274},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2783":56330,"_24069":56327,"_5":24402,"_16893":94276,"_22829":94277,"_2311":94278},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2783":56331,"_24069":56327,"_5":24402,"_16893":94280,"_22829":94281,"_2311":94282},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2783":56332,"_24069":56327,"_5":24402,"_16893":94284,"_22829":94285,"_2311":94286},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2783":56333,"_24069":56327,"_5":24402,"_16893":94288,"_22829":94289,"_2311":94290},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2783":56334,"_24069":56327,"_5":24402,"_16893":94292,"_22829":94293,"_2311":94294},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2783":56335,"_24069":56327,"_5":24402,"_16893":94296,"_22829":94297,"_2311":94298},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2783":56336,"_24069":56327,"_5":24402,"_16893":94300,"_22829":94301,"_2311":94302},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2783":56337,"_24069":56327,"_5":24402,"_16893":94304,"_22829":94305,"_2311":94306},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2783":56338,"_24069":56327,"_16893":94308,"_5":16788,"_22829":56327,"_2311":94309},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2783":56339,"_24069":56327,"_16893":94311,"_5":16788,"_22829":94273,"_2311":94312},[],"Un servicio publica un evento de dominio.",{"_2783":56340,"_24069":56327,"_16893":94314,"_5":16788,"_22829":94273,"_2311":94315},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2783":56341,"_24069":56327,"_16893":94317,"_5":16788,"_22829":94273,"_2311":94318},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2783":56342,"_24069":56327,"_16893":94320,"_5":16788,"_22829":94273,"_2311":94321},[],"Lamassu entrega el evento al canal configurado.",{"_2783":56343,"_24069":56327,"_16893":94323,"_5":16788,"_22829":94273,"_2311":94324},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2783":56344,"_24069":56327,"_16893":94326,"_5":16788,"_22829":94277,"_2311":94327},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino.",{"_2783":56345,"_24069":56327,"_16893":94329,"_5":16788,"_22829":94277,"_2311":94330},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2783":56346,"_24069":56327,"_16893":94332,"_5":16788,"_22829":94277,"_2311":94333},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2783":56347,"_24069":56327,"_16893":94335,"_5":16788,"_22829":94285,"_2311":94336},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2783":56348,"_24069":56327,"_16893":94338,"_5":16788,"_22829":94289,"_2311":94339},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2783":56349,"_24069":56327,"_16893":94341,"_5":16788,"_22829":94293,"_2311":94342},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2783":56350,"_24069":56327,"_16893":94344,"_5":16788,"_22829":94293,"_2311":94345},[],"**None** notifica todas las instancias del evento.",{"_2783":56351,"_24069":56327,"_16893":94347,"_5":16788,"_22829":94293,"_2311":94348},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2783":56352,"_24069":56327,"_16893":94350,"_5":16788,"_22829":94293,"_2311":94351},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2783":56353,"_24069":56327,"_16893":94353,"_5":16788,"_22829":94293,"_2311":94354},[],"**JavaScript** permite expresar lógica personalizada.",{"_2783":56354,"_24069":56327,"_16893":94356,"_5":16788,"_22829":94293,"_2311":94357},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2783":56355,"_24069":56327,"_16893":94359,"_5":16788,"_22829":94297,"_2311":94360},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2783":56356,"_24069":56327,"_16893":94362,"_5":16788,"_22829":94301,"_2311":94363},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2783":56357,"_24069":56327,"_16893":94365,"_5":16788,"_22829":94305,"_2311":94366},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2783":56358,"_24069":56327,"_16893":94368,"_5":16788,"_22829":94305,"_2311":94369},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2783":56359,"_24069":56327,"_16893":94371,"_5":16788,"_22829":94305,"_2311":94372},[],"**Perfiles:** `profile.create`, `profile.update` y `profile.delete`.",{"_2783":56360,"_24069":56327,"_16893":94374,"_5":16788,"_22829":94305,"_2311":94375},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2783":56361,"_24069":56327,"_16893":94377,"_5":16788,"_22829":94305,"_2311":94378},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2783":56362,"_24069":56327,"_16893":94380,"_5":16788,"_22829":94305,"_2311":94381},[],"**Validación:** `va.role.crl.create`.",{"_2783":56363,"_24069":56327,"_16893":94383,"_5":16788,"_22829":94305,"_2311":94384},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign.message` y `kms.delete`.",{"_2783":56364,"_24069":56327,"_16893":94386,"_5":16788,"_22829":94305,"_2311":94387},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2783":56365,"_24069":56365,"_5":11891,"_2311":94389,"_24405":94390,"_16893":94391,"_22829":56365},"Registros de auditoría",[39337,93789,93790],[],{"_2783":56366,"_24069":56365,"_16893":94393,"_5":16788,"_22829":56365,"_2311":94394},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2783":56367,"_24069":56365,"_5":24402,"_16893":94396,"_22829":94397,"_2311":94398},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2783":56368,"_24069":56365,"_5":24402,"_16893":94400,"_22829":94401,"_2311":94402},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2783":56369,"_24069":56365,"_5":24402,"_16893":94404,"_22829":94405,"_2311":94406},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2783":56370,"_24069":56365,"_5":24402,"_16893":94408,"_22829":94409,"_2311":94410},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2783":56371,"_24069":56365,"_5":24402,"_16893":94412,"_22829":94413,"_2311":94414},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2783":56372,"_24069":56365,"_5":24402,"_16893":94416,"_22829":94417,"_2311":94418},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2783":56373,"_24069":56365,"_5":24402,"_16893":94420,"_22829":94421,"_2311":94422},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2783":56374,"_24069":56365,"_5":24402,"_16893":94424,"_22829":94425,"_2311":94426},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2783":56375,"_24069":56365,"_5":24402,"_16893":94428,"_22829":94429,"_2311":94430},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2783":56376,"_24069":56365,"_5":24402,"_16893":94432,"_22829":94433,"_2311":94434},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2783":56377,"_24069":56365,"_5":24402,"_16893":94436,"_22829":94437,"_2311":94438},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2783":56378,"_24069":56365,"_16893":94440,"_5":16788,"_22829":56365,"_2311":94441},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2783":56379,"_24069":56365,"_16893":94443,"_5":16788,"_22829":94397,"_2311":94444},[],"El cuerpo de auditoría incluye:",{"_2783":56380,"_24069":56365,"_16893":94446,"_5":16788,"_22829":94397,"_2311":94447},[],"input: datos recibidos por la operación;",{"_2783":56381,"_24069":56365,"_16893":94449,"_5":16788,"_22829":94397,"_2311":94450},[],"has\\_error: indica si el servicio devolvió un error;",{"_2783":56382,"_24069":56365,"_16893":94452,"_5":16788,"_22829":94397,"_2311":94453},[],"output: resultado producido o mensaje de error;",{"_2783":56383,"_24069":56365,"_16893":94455,"_5":16788,"_22829":94397,"_2311":94456},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2783":56384,"_24069":56365,"_16893":94458,"_5":16788,"_22829":94397,"_2311":94459},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2783":56385,"_24069":56365,"_16893":94461,"_5":16788,"_22829":94397,"_2311":94462},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2783":56386,"_24069":56365,"_16893":94464,"_5":16788,"_22829":94401,"_2311":94465},[],"El backend aplica auditoría a mutaciones de:",{"_2783":56387,"_24069":56365,"_16893":94467,"_5":16788,"_22829":94401,"_2311":94468},[],"autoridades, certificados y perfiles de emisión;",{"_2783":56388,"_24069":56365,"_16893":94470,"_5":16788,"_22829":94401,"_2311":94471},[],"claves y motores KMS;",{"_2783":56389,"_24069":56365,"_16893":94473,"_5":16788,"_22829":94401,"_2311":94474},[],"dispositivos e identidades;",{"_2783":56390,"_24069":56365,"_16893":94476,"_5":16788,"_22829":94401,"_2311":94477},[],"DMS y operaciones de enrolamiento;",{"_2783":56391,"_24069":56365,"_16893":94479,"_5":16788,"_22829":94401,"_2311":94480},[],"funciones de validación y CRL;",{"_2783":56392,"_24069":56365,"_16893":94482,"_5":16788,"_22829":94401,"_2311":94483},[],"principales, políticas y concesiones de autorización.",{"_2783":56393,"_24069":56365,"_16893":94485,"_5":16788,"_22829":94401,"_2311":94486},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2783":56394,"_24069":56365,"_16893":94488,"_5":16788,"_22829":94405,"_2311":94489},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2783":56395,"_24069":56365,"_16893":94491,"_5":16788,"_22829":94405,"_2311":94492},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2783":56396,"_24069":56365,"_16893":94494,"_5":16788,"_22829":94405,"_2311":94495},[],"Diseña el consumidor para:",{"_2783":56397,"_24069":56365,"_16893":94497,"_5":16788,"_22829":94405,"_2311":94498},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2783":56398,"_24069":56365,"_16893":94500,"_5":16788,"_22829":94405,"_2311":94501},[],"conservar el CloudEvent completo sin modificar;",{"_2783":56399,"_24069":56365,"_16893":94503,"_5":16788,"_22829":94405,"_2311":94504},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2783":56400,"_24069":56365,"_16893":94506,"_5":16788,"_22829":94405,"_2311":94507},[],"cifrar en tránsito y en reposo;",{"_2783":56401,"_24069":56365,"_16893":94509,"_5":16788,"_22829":94405,"_2311":94510},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2783":56402,"_24069":56365,"_16893":94512,"_5":16788,"_22829":94405,"_2311":94513},[],"aplicar una política explícita de retención y legal hold;",{"_2783":56403,"_24069":56365,"_16893":94515,"_5":16788,"_22829":94405,"_2311":94516},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2783":56404,"_24069":56365,"_16893":94518,"_5":16788,"_22829":94409,"_2311":94519},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2783":56405,"_24069":56365,"_16893":94521,"_5":16788,"_22829":94409,"_2311":94522},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2783":56406,"_24069":56365,"_16893":94524,"_5":16788,"_22829":94417,"_2311":94525},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2783":56407,"_24069":56365,"_16893":94527,"_5":16788,"_22829":94421,"_2311":94528},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2783":56408,"_24069":56365,"_16893":94530,"_5":16788,"_22829":94425,"_2311":94531},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2783":56409,"_24069":56365,"_16893":94533,"_5":16788,"_22829":94429,"_2311":94534},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2783":56410,"_24069":56365,"_16893":94536,"_5":16788,"_22829":94433,"_2311":94537},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2783":56411,"_24069":56365,"_16893":94539,"_5":16788,"_22829":94437,"_2311":94540},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2783":56412,"_24069":56365,"_16893":94542,"_5":16788,"_22829":94437,"_2311":94543},[],"aparece un evento de auditoría correcto;",{"_2783":56413,"_24069":56365,"_16893":94545,"_5":16788,"_22829":94437,"_2311":94546},[],"el principal coincide con la identidad utilizada;",{"_2783":56414,"_24069":56365,"_16893":94548,"_5":16788,"_22829":94437,"_2311":94549},[],"el consumidor lo persiste una sola vez;",{"_2783":56415,"_24069":56365,"_16893":94551,"_5":16788,"_22829":94437,"_2311":94552},[],"puede recuperarse por recurso, actor y periodo;",{"_2783":56416,"_24069":56365,"_16893":94554,"_5":16788,"_22829":94437,"_2311":94555},[],"una interrupción del consumidor produce una alerta.",{"_2783":56417,"_24069":56365,"_16893":94557,"_5":16788,"_22829":94437,"_2311":94558},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2783":56418,"_24069":56418,"_5":11891,"_2311":94560,"_24405":94561,"_16893":94562,"_22829":56418},"Arquitectura de la plataforma",[39337,93789],[],{"_2783":56419,"_24069":56418,"_16893":94564,"_5":16788,"_22829":56418,"_2311":94565},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2783":56420,"_24069":56418,"_5":24402,"_16893":94567,"_22829":94568,"_2311":94569},[],"/docs/pr-preview/pr-27/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2783":56421,"_24069":56418,"_5":24402,"_16893":94571,"_22829":94572,"_2311":94573},[],"/docs/pr-preview/pr-27/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2783":56422,"_24069":56418,"_5":24402,"_16893":94575,"_22829":94576,"_2311":94577},[],"/docs/pr-preview/pr-27/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2783":56423,"_24069":56418,"_5":24402,"_16893":94579,"_22829":94580,"_2311":94581},[],"/docs/pr-preview/pr-27/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2783":56424,"_24069":56418,"_5":24402,"_16893":94583,"_22829":94584,"_2311":94585},[],"/docs/pr-preview/pr-27/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2783":56425,"_24069":56418,"_16893":94587,"_5":16788,"_22829":56418,"_2311":94588},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2783":56426,"_24069":56418,"_16893":94590,"_5":16788,"_22829":56418,"_2311":94591},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2783":56427,"_24069":56418,"_16893":94593,"_5":16788,"_22829":94568,"_2311":94594},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2783":56428,"_24069":56418,"_16893":94596,"_5":16788,"_22829":94572,"_2311":94597},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2783":56429,"_24069":56418,"_16893":94599,"_5":16788,"_22829":94576,"_2311":94600},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2783":56430,"_24069":56418,"_16893":94602,"_5":16788,"_22829":94580,"_2311":94603},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2783":56431,"_24069":56418,"_16893":94605,"_5":16788,"_22829":94584,"_2311":94606},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2783":56432,"_24069":56432,"_5":11891,"_2311":94608,"_24405":94609,"_16893":94610,"_22829":56432},"Cómo funciona Lamassu",[39337,93789],[],{"_2783":56433,"_24069":56432,"_16893":94612,"_5":16788,"_22829":56432,"_2311":94613},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2783":56434,"_24069":56432,"_5":24402,"_16893":94615,"_22829":94616,"_2311":94617},[],"/docs/pr-preview/pr-27/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2783":56435,"_24069":56432,"_5":24402,"_16893":94619,"_22829":94620,"_2311":94621},[],"/docs/pr-preview/pr-27/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2783":56436,"_24069":56432,"_16893":94623,"_5":16788,"_22829":56432,"_2311":94624},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2783":56437,"_24069":56432,"_16893":94626,"_5":16788,"_22829":94616,"_2311":94627},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2783":56438,"_24069":56432,"_16893":94629,"_5":16788,"_22829":94616,"_2311":94630},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2783":56439,"_24069":56432,"_16893":94632,"_5":16788,"_22829":94616,"_2311":94633},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2783":56440,"_24069":56432,"_16893":94635,"_5":16788,"_22829":94616,"_2311":94636},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2783":56441,"_24069":56432,"_16893":94638,"_5":16788,"_22829":94616,"_2311":94639},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2783":56442,"_24069":56432,"_16893":94641,"_5":16788,"_22829":94620,"_2311":94642},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2783":56443,"_24069":56432,"_16893":94644,"_5":16788,"_22829":94620,"_2311":94645},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2783":56444,"_24069":56432,"_16893":94647,"_5":16788,"_22829":94620,"_2311":94648},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2783":56445,"_24069":56432,"_16893":94650,"_5":16788,"_22829":94620,"_2311":94651},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2783":56446,"_24069":56432,"_16893":94653,"_5":16788,"_22829":94620,"_2311":94654},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2783":56447,"_24069":56432,"_16893":94656,"_5":16788,"_22829":94620,"_2311":94657},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2783":56448,"_24069":56432,"_16893":94659,"_5":16788,"_22829":94620,"_2311":94660},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2783":56449,"_24069":56449,"_5":11891,"_2311":94662,"_24405":94663,"_16893":94664,"_22829":56449},"Dispositivos e identidades",[39337,93789,41556,94662],[],{"_2783":56450,"_24069":56449,"_16893":94666,"_5":16788,"_22829":56449,"_2311":94667},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2783":56451,"_24069":56449,"_5":24402,"_16893":94669,"_22829":94670,"_2311":94671},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2783":56452,"_24069":56449,"_5":24402,"_16893":94673,"_22829":94674,"_2311":94675},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2783":56453,"_24069":56449,"_5":24402,"_16893":94677,"_22829":94678,"_2311":94679},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2783":56454,"_24069":56449,"_5":24402,"_16893":94681,"_22829":94682,"_2311":94683},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2783":56455,"_24069":56449,"_5":24402,"_16893":94685,"_22829":94686,"_2311":94687},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2783":56456,"_24069":56449,"_5":24402,"_16893":94689,"_22829":94690,"_2311":94691},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2783":56457,"_24069":56449,"_5":24402,"_16893":94693,"_22829":94694,"_2311":94695},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2783":56458,"_24069":56449,"_5":24402,"_16893":94697,"_22829":94698,"_2311":94699},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2783":56459,"_24069":56449,"_5":24402,"_16893":94701,"_22829":94702,"_2311":94703},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2783":56460,"_24069":56449,"_5":24402,"_16893":94705,"_22829":94706,"_2311":94707},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2783":56461,"_24069":56449,"_5":24402,"_16893":94709,"_22829":94710,"_2311":94711},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2783":56462,"_24069":56449,"_16893":94713,"_5":16788,"_22829":56449,"_2311":94714},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2783":56463,"_24069":56449,"_16893":94716,"_5":16788,"_22829":56449,"_2311":94717},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2783":56464,"_24069":56449,"_16893":94719,"_5":16788,"_22829":94670,"_2311":94720},[],"Vista operativa",{"_2783":56465,"_24069":56449,"_16893":94722,"_5":16788,"_22829":94670,"_2311":94723},[],"Interpretación",{"_2783":56466,"_24069":56449,"_16893":94725,"_5":16788,"_22829":94670,"_2311":41619},[],{"_2783":56467,"_24069":56449,"_16893":94727,"_5":16788,"_22829":94670,"_2311":94728},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2783":56468,"_24069":56449,"_16893":94730,"_5":16788,"_22829":94670,"_2311":41625},[],{"_2783":56469,"_24069":56449,"_16893":94732,"_5":16788,"_22829":94670,"_2311":94733},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2783":56470,"_24069":56449,"_16893":94735,"_5":16788,"_22829":94670,"_2311":41631},[],{"_2783":56471,"_24069":56449,"_16893":94737,"_5":16788,"_22829":94670,"_2311":94738},[],"La identidad está en la ventana operativa de renovación.",{"_2783":56472,"_24069":56449,"_16893":94740,"_5":16788,"_22829":94670,"_2311":41637},[],{"_2783":56473,"_24069":56449,"_16893":94742,"_5":16788,"_22829":94670,"_2311":94743},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2783":56474,"_24069":56449,"_16893":94745,"_5":16788,"_22829":94670,"_2311":41643},[],{"_2783":56475,"_24069":56449,"_16893":94747,"_5":16788,"_22829":94670,"_2311":94748},[],"La identidad ha vencido.",{"_2783":56476,"_24069":56449,"_16893":94750,"_5":16788,"_22829":94670,"_2311":41649},[],{"_2783":56477,"_24069":56449,"_16893":94752,"_5":16788,"_22829":94670,"_2311":94753},[],"La identidad está marcada como revocada.",{"_2783":56478,"_24069":56449,"_16893":94755,"_5":16788,"_22829":94670,"_2311":41655},[],{"_2783":56479,"_24069":56449,"_16893":94757,"_5":16788,"_22829":94670,"_2311":94758},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2783":56480,"_24069":56449,"_16893":94760,"_5":16788,"_22829":94670,"_2311":94761},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2783":56481,"_24069":56449,"_16893":94763,"_5":16788,"_22829":94674,"_2311":94764},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2783":56482,"_24069":56449,"_16893":94766,"_5":16788,"_22829":94674,"_2311":94767},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2783":56483,"_24069":56449,"_16893":94769,"_5":16788,"_22829":94674,"_2311":94770},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2783":56484,"_24069":56449,"_16893":94772,"_5":16788,"_22829":94674,"_2311":94773},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2783":56485,"_24069":56449,"_16893":94775,"_5":16788,"_22829":94678,"_2311":94776},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2783":56486,"_24069":56449,"_16893":94778,"_5":16788,"_22829":94682,"_2311":94779},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2783":56487,"_24069":56449,"_16893":94781,"_5":16788,"_22829":94686,"_2311":94782},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2783":56488,"_24069":56449,"_16893":94784,"_5":16788,"_22829":94690,"_2311":94785},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2783":56489,"_24069":56449,"_16893":94787,"_5":16788,"_22829":94694,"_2311":94788},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2783":56490,"_24069":56449,"_16893":94790,"_5":16788,"_22829":94694,"_2311":94791},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2783":56491,"_24069":56449,"_16893":94793,"_5":16788,"_22829":94698,"_2311":94794},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2783":56492,"_24069":56449,"_16893":94796,"_5":16788,"_22829":94698,"_2311":94797},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2783":56493,"_24069":56449,"_16893":94799,"_5":16788,"_22829":94698,"_2311":94800},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2783":56494,"_24069":56449,"_16893":94802,"_5":16788,"_22829":94698,"_2311":94803},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2783":56495,"_24069":56449,"_16893":94805,"_5":16788,"_22829":94698,"_2311":94806},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2783":56496,"_24069":56449,"_16893":94808,"_5":16788,"_22829":94698,"_2311":94809},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2783":56497,"_24069":56449,"_16893":94811,"_5":16788,"_22829":94702,"_2311":94812},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2783":56498,"_24069":56449,"_16893":94814,"_5":16788,"_22829":94702,"_2311":94815},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2783":56499,"_24069":56449,"_16893":94817,"_5":16788,"_22829":94706,"_2311":94818},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2783":56500,"_24069":56449,"_16893":94820,"_5":16788,"_22829":94706,"_2311":94821},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2783":56501,"_24069":56449,"_16893":94823,"_5":16788,"_22829":94706,"_2311":94824},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2783":56502,"_24069":56449,"_16893":94826,"_5":16788,"_22829":94706,"_2311":94827},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2783":56503,"_24069":56449,"_16893":94829,"_5":16788,"_22829":94710,"_2311":94830},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2783":56504,"_24069":56449,"_16893":94832,"_5":16788,"_22829":94710,"_2311":94833},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2783":56505,"_24069":56505,"_5":11891,"_2311":94835,"_24405":94836,"_16893":94838,"_22829":56505},"Identidad inicial y autenticación",[39337,93789,41556,94662,94837],"Enrolamiento con PKI",[],{"_2783":56506,"_24069":56505,"_16893":94840,"_5":16788,"_22829":56505,"_2311":94841},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2783":56507,"_24069":56505,"_5":24402,"_16893":94843,"_22829":94844,"_2311":94845},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2783":56508,"_24069":56505,"_5":24402,"_16893":94847,"_22829":94848,"_2311":94849},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2783":56509,"_24069":56505,"_5":24402,"_16893":94851,"_22829":94852,"_2311":94853},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2783":56510,"_24069":56505,"_5":24402,"_16893":94855,"_22829":94856,"_2311":94857},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2783":56511,"_24069":56505,"_5":24402,"_16893":94859,"_22829":94860,"_2311":94861},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2783":56512,"_24069":56505,"_16893":94863,"_5":16788,"_22829":56505,"_2311":94864},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2783":56513,"_24069":56505,"_16893":94866,"_5":16788,"_22829":94844,"_2311":94867},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2783":56514,"_24069":56505,"_16893":94869,"_5":16788,"_22829":94844,"_2311":94870},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2783":56515,"_24069":56505,"_16893":94872,"_5":16788,"_22829":94848,"_2311":94873},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2783":56516,"_24069":56505,"_16893":94875,"_5":16788,"_22829":94848,"_2311":94876},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2783":56517,"_24069":56505,"_16893":94878,"_5":16788,"_22829":94848,"_2311":94879},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2783":56518,"_24069":56505,"_16893":94881,"_5":16788,"_22829":94852,"_2311":94882},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2783":56519,"_24069":56505,"_16893":94884,"_5":16788,"_22829":94852,"_2311":94885},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2783":56520,"_24069":56505,"_16893":94887,"_5":16788,"_22829":94856,"_2311":94888},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado.",{"_2783":56521,"_24069":56505,"_16893":94890,"_5":16788,"_22829":94856,"_2311":94891},[],"Ejemplo de cuerpo:",{"_2783":56522,"_24069":56505,"_16893":94893,"_5":16788,"_22829":94856,"_2311":94894},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2783":56523,"_24069":56505,"_16893":94896,"_5":16788,"_22829":94856,"_2311":94897},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2783":56524,"_24069":56505,"_16893":94899,"_5":16788,"_22829":94856,"_2311":94900},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2783":56525,"_24069":56505,"_16893":94902,"_5":16788,"_22829":94856,"_2311":94903},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2783":56526,"_24069":56505,"_16893":94905,"_5":16788,"_22829":94860,"_2311":94906},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2783":56527,"_24069":56505,"_16893":94908,"_5":16788,"_22829":94860,"_2311":94909},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2783":56528,"_24069":56528,"_5":11891,"_2311":94911,"_24405":94912,"_16893":94913,"_22829":56528},"Configura y opera el DMS",[39337,93789,41556,94662,94837],[],{"_2783":56529,"_24069":56528,"_16893":94915,"_5":16788,"_22829":56528,"_2311":94916},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2783":56530,"_24069":56528,"_5":24402,"_16893":94918,"_22829":94919,"_2311":92490},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2783":56531,"_24069":56528,"_5":24402,"_16893":94921,"_22829":94922,"_2311":94923},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2783":56532,"_24069":56528,"_5":24402,"_16893":94925,"_22829":94926,"_2311":94927},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2783":56533,"_24069":56528,"_5":24402,"_16893":94929,"_22829":94930,"_2311":94931},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2783":56534,"_24069":56528,"_5":24402,"_16893":94933,"_22829":94934,"_2311":94935},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2783":56535,"_24069":56528,"_5":24402,"_16893":94937,"_22829":94938,"_2311":94939},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2783":56536,"_24069":56528,"_5":24402,"_16893":94941,"_22829":94942,"_2311":94943},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2783":56537,"_24069":56528,"_5":24402,"_16893":94945,"_22829":94946,"_2311":94947},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2783":56538,"_24069":56528,"_5":24402,"_16893":94949,"_22829":94950,"_2311":41851},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2783":56539,"_24069":56528,"_5":24402,"_16893":94952,"_22829":94953,"_2311":41855},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2783":56540,"_24069":56528,"_5":24402,"_16893":94955,"_22829":94956,"_2311":94957},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2783":56541,"_24069":56528,"_5":24402,"_16893":94959,"_22829":94960,"_2311":94961},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2783":56542,"_24069":56528,"_5":24402,"_16893":94963,"_22829":94964,"_2311":94965},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2783":56543,"_24069":56528,"_5":24402,"_16893":94967,"_22829":94968,"_2311":41871},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2783":56544,"_24069":56528,"_5":24402,"_16893":94970,"_22829":94971,"_2311":94972},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2783":56545,"_24069":56528,"_5":24402,"_16893":94974,"_22829":94975,"_2311":94976},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2783":56546,"_24069":56528,"_5":24402,"_16893":94978,"_22829":94979,"_2311":94980},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2783":56547,"_24069":56528,"_16893":94982,"_5":16788,"_22829":56528,"_2311":94983},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2783":56548,"_24069":56528,"_16893":94985,"_5":16788,"_22829":94919,"_2311":94986},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2783":56549,"_24069":56528,"_16893":94988,"_5":16788,"_22829":94919,"_2311":94989},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2783":56550,"_24069":56528,"_16893":94991,"_5":16788,"_22829":94926,"_2311":94992},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2783":56551,"_24069":56528,"_16893":94994,"_5":16788,"_22829":94930,"_2311":94995},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2783":56552,"_24069":56528,"_16893":94997,"_5":16788,"_22829":94934,"_2311":94998},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2783":56553,"_24069":56528,"_16893":95000,"_5":16788,"_22829":94938,"_2311":95001},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2783":56554,"_24069":56528,"_16893":95003,"_5":16788,"_22829":94942,"_2311":95004},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2783":56555,"_24069":56528,"_16893":95006,"_5":16788,"_22829":94950,"_2311":95007},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2783":56556,"_24069":56528,"_16893":95009,"_5":16788,"_22829":94950,"_2311":95010},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2783":56557,"_24069":56528,"_16893":95012,"_5":16788,"_22829":94953,"_2311":95013},[],"Campo de `settings.enrollment_settings`",{"_2783":56558,"_24069":56528,"_16893":95015,"_5":16788,"_22829":94953,"_2311":95016},[],"Decisión",{"_2783":56559,"_24069":56528,"_16893":95018,"_5":16788,"_22829":94953,"_2311":41922},[],{"_2783":56560,"_24069":56528,"_16893":95020,"_5":16788,"_22829":94953,"_2311":95021},[],"`EST_RFC7030` para estas operaciones.",{"_2783":56561,"_24069":56528,"_16893":95023,"_5":16788,"_22829":94953,"_2311":41928},[],{"_2783":56562,"_24069":56528,"_16893":95025,"_5":16788,"_22829":94953,"_2311":95026},[],"ID de la CA que firmará.",{"_2783":56563,"_24069":56528,"_16893":95028,"_5":16788,"_22829":94953,"_2311":41934},[],{"_2783":56564,"_24069":56528,"_16893":95030,"_5":16788,"_22829":94953,"_2311":95031},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2783":56565,"_24069":56528,"_16893":95033,"_5":16788,"_22829":94953,"_2311":41940},[],{"_2783":56566,"_24069":56528,"_16893":95035,"_5":16788,"_22829":94953,"_2311":95036},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2783":56567,"_24069":56528,"_16893":95038,"_5":16788,"_22829":94953,"_2311":41946},[],{"_2783":56568,"_24069":56528,"_16893":95040,"_5":16788,"_22829":94953,"_2311":95041},[],"Uno de los cuatro modos de autenticación.",{"_2783":56569,"_24069":56528,"_16893":95043,"_5":16788,"_22829":94953,"_2311":95044},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2783":56570,"_24069":56528,"_16893":95046,"_5":16788,"_22829":94956,"_2311":95047},[],"Los bloques son independientes:",{"_2783":56571,"_24069":56528,"_16893":95049,"_5":16788,"_22829":94956,"_2311":95050},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2783":56572,"_24069":56528,"_16893":95052,"_5":16788,"_22829":94956,"_2311":95053},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2783":56573,"_24069":56528,"_16893":95055,"_5":16788,"_22829":94956,"_2311":41964},[],{"_2783":56574,"_24069":56528,"_16893":95057,"_5":16788,"_22829":94956,"_2311":95058},[],"Control aplicado en la operación configurada",{"_2783":56575,"_24069":56528,"_16893":95060,"_5":16788,"_22829":94956,"_2311":41970},[],{"_2783":56576,"_24069":56528,"_16893":95062,"_5":16788,"_22829":94956,"_2311":95063},[],"Validación del certificado presentado.",{"_2783":56577,"_24069":56528,"_16893":95065,"_5":16788,"_22829":94956,"_2311":41976},[],{"_2783":56578,"_24069":56528,"_16893":95067,"_5":16788,"_22829":94956,"_2311":95068},[],"Autorización del webhook configurado.",{"_2783":56579,"_24069":56528,"_16893":95070,"_5":16788,"_22829":94956,"_2311":41982},[],{"_2783":56580,"_24069":56528,"_16893":95072,"_5":16788,"_22829":94956,"_2311":95073},[],"Validación del certificado y, después, aprobación del webhook.",{"_2783":56581,"_24069":56528,"_16893":95075,"_5":16788,"_22829":94956,"_2311":41988},[],{"_2783":56582,"_24069":56528,"_16893":95077,"_5":16788,"_22829":94956,"_2311":95078},[],"Sin autenticación del solicitante por el DMS.",{"_2783":56583,"_24069":56528,"_16893":95080,"_5":16788,"_22829":94956,"_2311":95081},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2783":56584,"_24069":56528,"_16893":95083,"_5":16788,"_22829":94956,"_2311":95084},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2783":56585,"_24069":56528,"_16893":95086,"_5":16788,"_22829":94956,"_2311":95087},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2783":56586,"_24069":56528,"_16893":95089,"_5":16788,"_22829":94956,"_2311":95090},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2783":56587,"_24069":56528,"_16893":95092,"_5":16788,"_22829":94956,"_2311":95093},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2783":56588,"_24069":56528,"_16893":95095,"_5":16788,"_22829":94960,"_2311":95096},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2783":56589,"_24069":56528,"_16893":95098,"_5":16788,"_22829":94964,"_2311":95099},[],"Campo de `settings.reenrollment_settings`",{"_2783":56590,"_24069":56528,"_16893":95101,"_5":16788,"_22829":94964,"_2311":95102},[],"Función",{"_2783":56591,"_24069":56528,"_16893":95104,"_5":16788,"_22829":94964,"_2311":42017},[],{"_2783":56592,"_24069":56528,"_16893":95106,"_5":16788,"_22829":94964,"_2311":95107},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2783":56593,"_24069":56528,"_16893":95109,"_5":16788,"_22829":94964,"_2311":42023},[],{"_2783":56594,"_24069":56528,"_16893":95111,"_5":16788,"_22829":94964,"_2311":95112},[],"Umbral operativo preventivo de monitorización.",{"_2783":56595,"_24069":56528,"_16893":95114,"_5":16788,"_22829":94964,"_2311":42029},[],{"_2783":56596,"_24069":56528,"_16893":95116,"_5":16788,"_22829":94964,"_2311":95117},[],"Umbral operativo crítico de monitorización.",{"_2783":56597,"_24069":56528,"_16893":95119,"_5":16788,"_22829":94964,"_2311":42035},[],{"_2783":56598,"_24069":56528,"_16893":95121,"_5":16788,"_22829":94964,"_2311":95122},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2783":56599,"_24069":56528,"_16893":95124,"_5":16788,"_22829":94964,"_2311":42041},[],{"_2783":56600,"_24069":56528,"_16893":95126,"_5":16788,"_22829":94964,"_2311":95127},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2783":56601,"_24069":56528,"_16893":95129,"_5":16788,"_22829":94964,"_2311":42047},[],{"_2783":56602,"_24069":56528,"_16893":95131,"_5":16788,"_22829":94964,"_2311":95132},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2783":56603,"_24069":56528,"_16893":95134,"_5":16788,"_22829":94964,"_2311":95135},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2783":56604,"_24069":56528,"_16893":95137,"_5":16788,"_22829":94968,"_2311":95138},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2783":56605,"_24069":56528,"_16893":95140,"_5":16788,"_22829":94971,"_2311":92847},[],{"_2783":56606,"_24069":56528,"_16893":95142,"_5":16788,"_22829":94971,"_2311":95143},[],"Qué publica",{"_2783":56607,"_24069":56528,"_16893":95145,"_5":16788,"_22829":94971,"_2311":42064},[],{"_2783":56608,"_24069":56528,"_16893":95147,"_5":16788,"_22829":94971,"_2311":95148},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2783":56609,"_24069":56528,"_16893":95150,"_5":16788,"_22829":94971,"_2311":42070},[],{"_2783":56610,"_24069":56528,"_16893":95152,"_5":16788,"_22829":94971,"_2311":95153},[],"Certificado de la CA emisora seleccionada.",{"_2783":56611,"_24069":56528,"_16893":95155,"_5":16788,"_22829":94971,"_2311":42076},[],{"_2783":56612,"_24069":56528,"_16893":95157,"_5":16788,"_22829":94971,"_2311":95158},[],"Certificados de las CAs elegidas explícitamente.",{"_2783":56613,"_24069":56528,"_16893":95160,"_5":16788,"_22829":94971,"_2311":95161},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2783":56614,"_24069":56528,"_16893":95163,"_5":16788,"_22829":94975,"_2311":95164},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2783":56615,"_24069":56528,"_16893":95166,"_5":16788,"_22829":94975,"_2311":95167},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2783":56616,"_24069":56528,"_16893":95169,"_5":16788,"_22829":94975,"_2311":95170},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2783":56617,"_24069":56528,"_16893":95172,"_5":16788,"_22829":94979,"_2311":95173},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2783":56618,"_24069":56618,"_5":11891,"_2311":95175,"_24405":95176,"_16893":95177,"_22829":56618},"Integra el cliente EST",[39337,93789,41556,94662,94837],[],{"_2783":56619,"_24069":56618,"_16893":95179,"_5":16788,"_22829":56618,"_2311":95180},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2783":56620,"_24069":56618,"_5":24402,"_16893":95182,"_22829":95183,"_2311":92490},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2783":56621,"_24069":56618,"_5":24402,"_16893":95185,"_22829":95186,"_2311":95187},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2783":56622,"_24069":56618,"_5":24402,"_16893":95189,"_22829":95190,"_2311":95191},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2783":56623,"_24069":56618,"_5":24402,"_16893":95193,"_22829":95194,"_2311":95195},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2783":56624,"_24069":56618,"_5":24402,"_16893":95197,"_22829":95198,"_2311":95199},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2783":56625,"_24069":56618,"_5":24402,"_16893":95201,"_22829":95202,"_2311":95203},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2783":56626,"_24069":56618,"_16893":95205,"_5":16788,"_22829":56618,"_2311":95206},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2783":56627,"_24069":56618,"_16893":95208,"_5":16788,"_22829":95183,"_2311":95209},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2783":56628,"_24069":56618,"_16893":95211,"_5":16788,"_22829":95183,"_2311":95212},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2783":56629,"_24069":56618,"_16893":95214,"_5":16788,"_22829":95183,"_2311":95215},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2783":56630,"_24069":56618,"_16893":95217,"_5":16788,"_22829":95186,"_2311":95218},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2783":56631,"_24069":56618,"_16893":95220,"_5":16788,"_22829":95186,"_2311":95221},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2783":56632,"_24069":56618,"_16893":95223,"_5":16788,"_22829":95190,"_2311":95224},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2783":56633,"_24069":56618,"_16893":95226,"_5":16788,"_22829":95190,"_2311":95227},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2783":56634,"_24069":56618,"_16893":95229,"_5":16788,"_22829":95194,"_2311":95230},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2783":56635,"_24069":56618,"_16893":95232,"_5":16788,"_22829":95194,"_2311":95233},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2783":56636,"_24069":56618,"_16893":95235,"_5":16788,"_22829":95198,"_2311":95236},[],"Para el caso de una raíz que emite directamente:",{"_2783":56637,"_24069":56618,"_16893":95238,"_5":16788,"_22829":95198,"_2311":95239},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2783":56638,"_24069":56618,"_16893":95241,"_5":16788,"_22829":95198,"_2311":95242},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2783":56639,"_24069":56618,"_16893":95244,"_5":16788,"_22829":95202,"_2311":95245},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2783":56640,"_24069":56640,"_5":11891,"_2311":95247,"_24405":95248,"_16893":95249,"_22829":56640},"Referencia EST",[39337,93789,41556,94662,94837],[],{"_2783":56641,"_24069":56640,"_16893":95251,"_5":16788,"_22829":56640,"_2311":95252},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2783":56642,"_24069":56640,"_5":24402,"_16893":95254,"_22829":95255,"_2311":95256},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2783":56643,"_24069":56640,"_5":24402,"_16893":95258,"_22829":95259,"_2311":18303},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2783":56644,"_24069":56640,"_5":24402,"_16893":95261,"_22829":95262,"_2311":20997},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2783":56645,"_24069":56640,"_5":24402,"_16893":95264,"_22829":95265,"_2311":21004},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2783":56646,"_24069":56640,"_5":24402,"_16893":95267,"_22829":95268,"_2311":20373},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2783":56647,"_24069":56640,"_5":24402,"_16893":95270,"_22829":95271,"_2311":95272},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2783":56648,"_24069":56640,"_5":24402,"_16893":95274,"_22829":95275,"_2311":95276},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2783":56649,"_24069":56640,"_5":24402,"_16893":95278,"_22829":95279,"_2311":95280},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2783":56650,"_24069":56640,"_16893":95282,"_5":16788,"_22829":56640,"_2311":95283},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2783":56651,"_24069":56640,"_16893":95285,"_5":16788,"_22829":95255,"_2311":95286},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2783":56652,"_24069":56640,"_16893":95288,"_5":16788,"_22829":95255,"_2311":93580},[],{"_2783":56653,"_24069":56640,"_16893":95290,"_5":16788,"_22829":95255,"_2311":95291},[],"Método",{"_2783":56654,"_24069":56640,"_16893":95293,"_5":16788,"_22829":95255,"_2311":95294},[],"Autenticación y condición",{"_2783":56655,"_24069":56640,"_16893":95296,"_5":16788,"_22829":95255,"_2311":42219},[],{"_2783":56656,"_24069":56640,"_16893":95298,"_5":16788,"_22829":95255,"_2311":42222},[],{"_2783":56657,"_24069":56640,"_16893":95300,"_5":16788,"_22829":95255,"_2311":95301},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2783":56658,"_24069":56640,"_16893":95303,"_5":16788,"_22829":95255,"_2311":42228},[],{"_2783":56659,"_24069":56640,"_16893":95305,"_5":16788,"_22829":95255,"_2311":42231},[],{"_2783":56660,"_24069":56640,"_16893":95307,"_5":16788,"_22829":95255,"_2311":95308},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2783":56661,"_24069":56640,"_16893":95310,"_5":16788,"_22829":95255,"_2311":42237},[],{"_2783":56662,"_24069":56640,"_16893":95312,"_5":16788,"_22829":95255,"_2311":42231},[],{"_2783":56663,"_24069":56640,"_16893":95314,"_5":16788,"_22829":95255,"_2311":95315},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2783":56664,"_24069":56640,"_16893":95317,"_5":16788,"_22829":95255,"_2311":42245},[],{"_2783":56665,"_24069":56640,"_16893":95319,"_5":16788,"_22829":95255,"_2311":42231},[],{"_2783":56666,"_24069":56640,"_16893":95321,"_5":16788,"_22829":95255,"_2311":95322},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2783":56667,"_24069":56640,"_16893":95324,"_5":16788,"_22829":95255,"_2311":95325},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2783":56668,"_24069":56640,"_16893":95327,"_5":16788,"_22829":95259,"_2311":95328},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2783":56669,"_24069":56640,"_16893":95330,"_5":16788,"_22829":95259,"_2311":95331},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2783":56670,"_24069":56640,"_16893":95333,"_5":16788,"_22829":95262,"_2311":95334},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2783":56671,"_24069":56640,"_16893":95336,"_5":16788,"_22829":95262,"_2311":95337},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2783":56672,"_24069":56640,"_16893":95339,"_5":16788,"_22829":95265,"_2311":95340},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2783":56673,"_24069":56640,"_16893":95342,"_5":16788,"_22829":95265,"_2311":95343},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2783":56674,"_24069":56640,"_16893":95345,"_5":16788,"_22829":95268,"_2311":95346},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2783":56675,"_24069":56640,"_16893":95348,"_5":16788,"_22829":95268,"_2311":95349},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2783":56676,"_24069":56640,"_16893":95351,"_5":16788,"_22829":95271,"_2311":95352},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2783":56677,"_24069":56640,"_16893":95354,"_5":16788,"_22829":95271,"_2311":95355},[],"Parte",{"_2783":56678,"_24069":56640,"_16893":95357,"_5":16788,"_22829":95271,"_2311":95358},[],"Contenido tras decodificar su Base64",{"_2783":56679,"_24069":56640,"_16893":95360,"_5":16788,"_22829":95271,"_2311":42289},[],{"_2783":56680,"_24069":56640,"_16893":95362,"_5":16788,"_22829":95271,"_2311":95363},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2783":56681,"_24069":56640,"_16893":95365,"_5":16788,"_22829":95271,"_2311":42295},[],{"_2783":56682,"_24069":56640,"_16893":95367,"_5":16788,"_22829":95271,"_2311":95368},[],"PKCS#7 DER con el certificado emitido.",{"_2783":56683,"_24069":56640,"_16893":95370,"_5":16788,"_22829":95271,"_2311":95371},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2783":56684,"_24069":56640,"_16893":95373,"_5":16788,"_22829":95275,"_2311":95374},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2783":56685,"_24069":56640,"_16893":95376,"_5":16788,"_22829":95275,"_2311":95377},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2783":56686,"_24069":56640,"_16893":95379,"_5":16788,"_22829":95275,"_2311":95380},[],"Convierte y comprueba el resultado:",{"_2783":56687,"_24069":56640,"_16893":95382,"_5":16788,"_22829":95275,"_2311":95383},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2783":56688,"_24069":56640,"_16893":95385,"_5":16788,"_22829":95279,"_2311":95386},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2783":56689,"_24069":56640,"_16893":95388,"_5":16788,"_22829":95279,"_2311":95389},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2783":56690,"_24069":56690,"_5":11891,"_2311":94837,"_24405":95391,"_16893":95392,"_22829":56690},[39337,93789,41556,94662,94837],[],{"_2783":56691,"_24069":56690,"_16893":95394,"_5":16788,"_22829":56690,"_2311":95395},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2783":56692,"_24069":56690,"_5":24402,"_16893":95397,"_22829":95398,"_2311":95399},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2783":56693,"_24069":56690,"_5":24402,"_16893":95401,"_22829":95402,"_2311":95403},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2783":56694,"_24069":56690,"_5":24402,"_16893":95405,"_22829":95406,"_2311":95407},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2783":56695,"_24069":56690,"_5":24402,"_16893":95409,"_22829":95410,"_2311":95411},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2783":56696,"_24069":56690,"_16893":95413,"_5":16788,"_22829":56690,"_2311":95414},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2783":56697,"_24069":56690,"_16893":95416,"_5":16788,"_22829":95398,"_2311":95417},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2783":56698,"_24069":56690,"_16893":95419,"_5":16788,"_22829":95398,"_2311":95420},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2783":56699,"_24069":56690,"_16893":95422,"_5":16788,"_22829":95398,"_2311":95423},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2783":56700,"_24069":56690,"_16893":95425,"_5":16788,"_22829":95398,"_2311":95426},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2783":56701,"_24069":56690,"_16893":95428,"_5":16788,"_22829":95398,"_2311":95429},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2783":56702,"_24069":56690,"_16893":95431,"_5":16788,"_22829":95398,"_2311":95432},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2783":56703,"_24069":56690,"_16893":95434,"_5":16788,"_22829":95402,"_2311":95435},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2783":56704,"_24069":56690,"_16893":95437,"_5":16788,"_22829":95402,"_2311":95438},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2783":56705,"_24069":56690,"_16893":95440,"_5":16788,"_22829":95402,"_2311":95441},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2783":56706,"_24069":56690,"_16893":95443,"_5":16788,"_22829":95402,"_2311":95444},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2783":56707,"_24069":56690,"_16893":95446,"_5":16788,"_22829":95406,"_2311":95447},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2783":56708,"_24069":56690,"_16893":95449,"_5":16788,"_22829":95406,"_2311":95450},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2783":56709,"_24069":56690,"_16893":95452,"_5":16788,"_22829":95406,"_2311":95453},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2783":56710,"_24069":56690,"_16893":95455,"_5":16788,"_22829":95406,"_2311":95456},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2783":56711,"_24069":56690,"_16893":95458,"_5":16788,"_22829":95410,"_2311":95459},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2783":56712,"_24069":56690,"_16893":95461,"_5":16788,"_22829":95410,"_2311":95462},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2783":56713,"_24069":56713,"_5":11891,"_2311":95464,"_24405":95465,"_16893":95466,"_22829":56713},"Estrategias de aprovisionamiento",[39337,93789,41556,94662,94837],[],{"_2783":56714,"_24069":56713,"_16893":95468,"_5":16788,"_22829":56713,"_2311":95469},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2783":56715,"_24069":56713,"_5":24402,"_16893":95471,"_22829":95472,"_2311":95473},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2783":56716,"_24069":56713,"_5":24402,"_16893":95475,"_22829":95476,"_2311":95477},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2783":56717,"_24069":56713,"_5":24402,"_16893":95479,"_22829":95480,"_2311":95481},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2783":56718,"_24069":56713,"_5":24402,"_16893":95483,"_22829":95484,"_2311":95485},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2783":56719,"_24069":56713,"_5":24402,"_16893":95487,"_22829":95488,"_2311":95489},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2783":56720,"_24069":56713,"_16893":95491,"_5":16788,"_22829":56713,"_2311":95492},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2783":56721,"_24069":56713,"_16893":95494,"_5":16788,"_22829":95472,"_2311":95495},[],"Recorrido",{"_2783":56722,"_24069":56713,"_16893":95497,"_5":16788,"_22829":95472,"_2311":95498},[],"Cuándo existe el dispositivo",{"_2783":56723,"_24069":56713,"_16893":95500,"_5":16788,"_22829":95472,"_2311":95501},[],"Qué compruebas",{"_2783":56724,"_24069":56713,"_16893":95503,"_5":16788,"_22829":95472,"_2311":95504},[],"Asignación manual",{"_2783":56725,"_24069":56713,"_16893":95506,"_5":16788,"_22829":95472,"_2311":95507},[],"El operador lo crea antes de asociar un certificado.",{"_2783":56726,"_24069":56713,"_16893":95509,"_5":16788,"_22829":95472,"_2311":95510},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2783":56727,"_24069":56713,"_16893":95512,"_5":16788,"_22829":95472,"_2311":95513},[],"EST con `JITP`",{"_2783":56728,"_24069":56713,"_16893":95515,"_5":16788,"_22829":95472,"_2311":95516},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2783":56729,"_24069":56713,"_16893":95518,"_5":16788,"_22829":95472,"_2311":95519},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2783":56730,"_24069":56713,"_16893":95521,"_5":16788,"_22829":95472,"_2311":95522},[],"EST con `PRE_REGISTRATION`",{"_2783":56731,"_24069":56713,"_16893":95524,"_5":16788,"_22829":95472,"_2311":95525},[],"Debe existir antes de `/simpleenroll`.",{"_2783":56732,"_24069":56713,"_16893":95527,"_5":16788,"_22829":95472,"_2311":95528},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2783":56733,"_24069":56713,"_16893":95530,"_5":16788,"_22829":95472,"_2311":95531},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2783":56734,"_24069":56713,"_16893":95533,"_5":16788,"_22829":95472,"_2311":95534},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2783":56735,"_24069":56713,"_16893":95536,"_5":16788,"_22829":95476,"_2311":95537},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2783":56736,"_24069":56713,"_16893":95539,"_5":16788,"_22829":95476,"_2311":95540},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2783":56737,"_24069":56713,"_16893":95542,"_5":16788,"_22829":95476,"_2311":95543},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2783":56738,"_24069":56713,"_16893":95545,"_5":16788,"_22829":95480,"_2311":95546},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2783":56739,"_24069":56713,"_16893":95548,"_5":16788,"_22829":95480,"_2311":95549},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2783":56740,"_24069":56713,"_16893":95551,"_5":16788,"_22829":95480,"_2311":95552},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2783":56741,"_24069":56713,"_16893":95554,"_5":16788,"_22829":95480,"_2311":95555},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2783":56742,"_24069":56713,"_16893":95557,"_5":16788,"_22829":95480,"_2311":95558},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2783":56743,"_24069":56713,"_16893":95560,"_5":16788,"_22829":95480,"_2311":95561},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2783":56744,"_24069":56713,"_16893":95563,"_5":16788,"_22829":95484,"_2311":92847},[],{"_2783":56745,"_24069":56713,"_16893":95565,"_5":16788,"_22829":95484,"_2311":95566},[],"Material que atraviesa EST",{"_2783":56746,"_24069":56713,"_16893":95568,"_5":16788,"_22829":95484,"_2311":95569},[],"Clave generada por el dispositivo",{"_2783":56747,"_24069":56713,"_16893":95571,"_5":16788,"_22829":95484,"_2311":95572},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2783":56748,"_24069":56713,"_16893":95574,"_5":16788,"_22829":95484,"_2311":95575},[],"Clave ya disponible en el dispositivo",{"_2783":56749,"_24069":56713,"_16893":95577,"_5":16788,"_22829":95484,"_2311":95578},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2783":56750,"_24069":56713,"_16893":95580,"_5":16788,"_22829":95484,"_2311":41871},[],{"_2783":56751,"_24069":56713,"_16893":95582,"_5":16788,"_22829":95484,"_2311":95583},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2783":56752,"_24069":56713,"_16893":95585,"_5":16788,"_22829":95484,"_2311":95586},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2783":56753,"_24069":56713,"_16893":95588,"_5":16788,"_22829":95488,"_2311":95589},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2783":56754,"_24069":56754,"_5":11891,"_2311":95591,"_24405":95592,"_16893":95593,"_22829":56754},"Renovación y recuperación",[39337,93789,41556,94662,94837],[],{"_2783":56755,"_24069":56754,"_16893":95595,"_5":16788,"_22829":56754,"_2311":95596},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2783":56756,"_24069":56754,"_5":24402,"_16893":95598,"_22829":95599,"_2311":95600},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2783":56757,"_24069":56754,"_5":24402,"_16893":95602,"_22829":95603,"_2311":95604},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2783":56758,"_24069":56754,"_5":24402,"_16893":95606,"_22829":95607,"_2311":95608},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2783":56759,"_24069":56754,"_5":24402,"_16893":95610,"_22829":95611,"_2311":95612},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2783":56760,"_24069":56754,"_5":24402,"_16893":95614,"_22829":95615,"_2311":95616},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2783":56761,"_24069":56754,"_16893":95618,"_5":16788,"_22829":56754,"_2311":95619},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2783":56762,"_24069":56754,"_16893":95621,"_5":16788,"_22829":95599,"_2311":95622},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2783":56763,"_24069":56754,"_16893":95624,"_5":16788,"_22829":95599,"_2311":95625},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2783":56764,"_24069":56754,"_16893":95627,"_5":16788,"_22829":95599,"_2311":95628},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2783":56765,"_24069":56754,"_16893":95630,"_5":16788,"_22829":95599,"_2311":95631},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2783":56766,"_24069":56754,"_16893":95633,"_5":16788,"_22829":95603,"_2311":95634},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2783":56767,"_24069":56754,"_16893":95636,"_5":16788,"_22829":95603,"_2311":95637},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2783":56768,"_24069":56754,"_16893":95639,"_5":16788,"_22829":95607,"_2311":95640},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2783":56769,"_24069":56754,"_16893":95642,"_5":16788,"_22829":95607,"_2311":95643},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2783":56770,"_24069":56754,"_16893":95645,"_5":16788,"_22829":95607,"_2311":95646},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2783":56771,"_24069":56754,"_16893":95648,"_5":16788,"_22829":95611,"_2311":95649},[],"Situación",{"_2783":56772,"_24069":56754,"_16893":95651,"_5":16788,"_22829":95611,"_2311":95652},[],"Procedimiento",{"_2783":56773,"_24069":56754,"_16893":95654,"_5":16788,"_22829":95611,"_2311":95655},[],"Certificado vigente, fuera de ventana",{"_2783":56774,"_24069":56754,"_16893":95657,"_5":16788,"_22829":95611,"_2311":95658},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2783":56775,"_24069":56754,"_16893":95660,"_5":16788,"_22829":95611,"_2311":95661},[],"Certificado vencido, clave disponible",{"_2783":56776,"_24069":56754,"_16893":95663,"_5":16788,"_22829":95611,"_2311":95664},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2783":56777,"_24069":56754,"_16893":95666,"_5":16788,"_22829":95611,"_2311":95667},[],"Renovación por webhook o `NO_AUTH`",{"_2783":56778,"_24069":56754,"_16893":95669,"_5":16788,"_22829":95611,"_2311":95670},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2783":56779,"_24069":56754,"_16893":95672,"_5":16788,"_22829":95611,"_2311":95673},[],"Clave perdida o inaccesible",{"_2783":56780,"_24069":56754,"_16893":95675,"_5":16788,"_22829":95611,"_2311":95676},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2783":56781,"_24069":56754,"_16893":95678,"_5":16788,"_22829":95611,"_2311":95679},[],"Identidad actual revocada",{"_2783":56782,"_24069":56754,"_16893":95681,"_5":16788,"_22829":95611,"_2311":95682},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2783":56783,"_24069":56754,"_16893":95684,"_5":16788,"_22829":95611,"_2311":95685},[],"Dispositivo sin identidad",{"_2783":56784,"_24069":56754,"_16893":95687,"_5":16788,"_22829":95611,"_2311":95688},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2783":56785,"_24069":56754,"_16893":95690,"_5":16788,"_22829":95611,"_2311":95691},[],"Dispositivo retirado",{"_2783":56786,"_24069":56754,"_16893":95693,"_5":16788,"_22829":95611,"_2311":95694},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2783":56787,"_24069":56754,"_16893":95696,"_5":16788,"_22829":95611,"_2311":95697},[],"Timeout, HTTP 500 o fallo de instalación",{"_2783":56788,"_24069":56754,"_16893":95699,"_5":16788,"_22829":95611,"_2311":95700},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2783":56789,"_24069":56754,"_16893":95702,"_5":16788,"_22829":95615,"_2311":95703},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2783":56790,"_24069":56754,"_16893":95705,"_5":16788,"_22829":95615,"_2311":95706},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2783":56791,"_24069":56791,"_5":11891,"_2311":95708,"_24405":95709,"_16893":95710,"_22829":56791},"Diagnóstico de enrolamiento",[39337,93789,41556,94662,94837],[],{"_2783":56792,"_24069":56791,"_16893":95712,"_5":16788,"_22829":56791,"_2311":95713},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2783":56793,"_24069":56791,"_5":24402,"_16893":95715,"_22829":95716,"_2311":95717},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2783":56794,"_24069":56791,"_5":24402,"_16893":95719,"_22829":95720,"_2311":95721},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2783":56795,"_24069":56791,"_5":24402,"_16893":95723,"_22829":95724,"_2311":95280},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2783":56796,"_24069":56791,"_5":24402,"_16893":95726,"_22829":95727,"_2311":95728},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2783":56797,"_24069":56791,"_16893":95730,"_5":16788,"_22829":56791,"_2311":95731},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2783":56798,"_24069":56791,"_16893":95733,"_5":16788,"_22829":95720,"_2311":95734},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2783":56799,"_24069":56791,"_16893":95736,"_5":16788,"_22829":95720,"_2311":95737},[],"Síntoma o mensaje",{"_2783":56800,"_24069":56791,"_16893":95739,"_5":16788,"_22829":95720,"_2311":95740},[],"Qué revisar",{"_2783":56801,"_24069":56791,"_16893":95742,"_5":16788,"_22829":95720,"_2311":95743},[],"curl rechaza TLS, nombre o emisor",{"_2783":56802,"_24069":56791,"_16893":95745,"_5":16788,"_22829":95720,"_2311":95746},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2783":56803,"_24069":56791,"_16893":95748,"_5":16788,"_22829":95720,"_2311":95749},[],"404 o APS ausente",{"_2783":56804,"_24069":56791,"_16893":95751,"_5":16788,"_22829":95720,"_2311":95752},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2783":56805,"_24069":56791,"_16893":95754,"_5":16788,"_22829":95720,"_2311":95755},[],"400, error de CSR o formato",{"_2783":56806,"_24069":56791,"_16893":95757,"_5":16788,"_22829":95720,"_2311":95758},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2783":56807,"_24069":56791,"_16893":95760,"_5":16788,"_22829":95720,"_2311":95761},[],"Credencial ausente o certificado no válido",{"_2783":56808,"_24069":56791,"_16893":95763,"_5":16788,"_22829":95720,"_2311":95764},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2783":56809,"_24069":56791,"_16893":95766,"_5":16788,"_22829":95720,"_2311":95767},[],"Webhook deniega, expira o responde sin autorización",{"_2783":56810,"_24069":56791,"_16893":95769,"_5":16788,"_22829":95720,"_2311":95770},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2783":56811,"_24069":56791,"_16893":95772,"_5":16788,"_22829":95720,"_2311":42702},[],{"_2783":56812,"_24069":56791,"_16893":95774,"_5":16788,"_22829":95720,"_2311":95775},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2783":56813,"_24069":56791,"_16893":95777,"_5":16788,"_22829":95720,"_2311":42708},[],{"_2783":56814,"_24069":56791,"_16893":95779,"_5":16788,"_22829":95720,"_2311":95780},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2783":56815,"_24069":56791,"_16893":95782,"_5":16788,"_22829":95720,"_2311":95783},[],"DMS propietario distinto",{"_2783":56816,"_24069":56791,"_16893":95785,"_5":16788,"_22829":95720,"_2311":95786},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2783":56817,"_24069":56791,"_16893":95788,"_5":16788,"_22829":95720,"_2311":42720},[],{"_2783":56818,"_24069":56791,"_16893":95790,"_5":16788,"_22829":95720,"_2311":95791},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2783":56819,"_24069":56791,"_16893":95793,"_5":16788,"_22829":95720,"_2311":42726},[],{"_2783":56820,"_24069":56791,"_16893":95795,"_5":16788,"_22829":95720,"_2311":95796},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2783":56821,"_24069":56791,"_16893":95798,"_5":16788,"_22829":95720,"_2311":95799},[],"Certificado actual revocado",{"_2783":56822,"_24069":56791,"_16893":95801,"_5":16788,"_22829":95720,"_2311":95802},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2783":56823,"_24069":56791,"_16893":95804,"_5":16788,"_22829":95720,"_2311":95805},[],"Error de CA, perfil o firma",{"_2783":56824,"_24069":56791,"_16893":95807,"_5":16788,"_22829":95720,"_2311":95808},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2783":56825,"_24069":56791,"_16893":95810,"_5":16788,"_22829":95720,"_2311":95811},[],"HTTP 200 sin conexión del dispositivo",{"_2783":56826,"_24069":56791,"_16893":95813,"_5":16788,"_22829":95720,"_2311":95814},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2783":56827,"_24069":56791,"_16893":95816,"_5":16788,"_22829":95720,"_2311":95817},[],"Timeout o error después de emitir",{"_2783":56828,"_24069":56791,"_16893":95819,"_5":16788,"_22829":95720,"_2311":95820},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2783":56829,"_24069":56791,"_16893":95822,"_5":16788,"_22829":95724,"_2311":95823},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2783":56830,"_24069":56791,"_16893":95825,"_5":16788,"_22829":95724,"_2311":95826},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2783":56831,"_24069":56791,"_16893":95828,"_5":16788,"_22829":95727,"_2311":95829},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2783":56832,"_24069":56791,"_16893":95831,"_5":16788,"_22829":95727,"_2311":95832},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2783":56833,"_24069":56791,"_16893":95834,"_5":16788,"_22829":95727,"_2311":95835},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2783":56834,"_24069":56791,"_16893":95837,"_5":16788,"_22829":95727,"_2311":95838},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2783":56835,"_24069":56791,"_16893":95840,"_5":16788,"_22829":95727,"_2311":95841},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2783":56836,"_24069":56791,"_16893":95843,"_5":16788,"_22829":95727,"_2311":95844},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2783":56837,"_24069":56791,"_16893":95846,"_5":16788,"_22829":95727,"_2311":95847},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2783":56838,"_24069":56838,"_5":11891,"_2311":95849,"_24405":95850,"_16893":95851,"_22829":56838},"Distribución y actualización de confianza",[39337,93789,41556,94662,94837],[],{"_2783":56839,"_24069":56838,"_16893":95853,"_5":16788,"_22829":56838,"_2311":95854},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2783":56840,"_24069":56838,"_5":24402,"_16893":95856,"_22829":95857,"_2311":95858},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2783":56841,"_24069":56838,"_5":24402,"_16893":95860,"_22829":95861,"_2311":95862},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2783":56842,"_24069":56838,"_5":24402,"_16893":95864,"_22829":95865,"_2311":95866},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2783":56843,"_24069":56838,"_5":24402,"_16893":95868,"_22829":95869,"_2311":95870},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2783":56844,"_24069":56838,"_5":24402,"_16893":95872,"_22829":95873,"_2311":95874},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2783":56845,"_24069":56838,"_16893":95876,"_5":16788,"_22829":56838,"_2311":95877},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2783":56846,"_24069":56838,"_16893":95879,"_5":16788,"_22829":95857,"_2311":95880},[],"Relación",{"_2783":56847,"_24069":56838,"_16893":95882,"_5":16788,"_22829":95857,"_2311":95883},[],"Material que prepara el responsable",{"_2783":56848,"_24069":56838,"_16893":95885,"_5":16788,"_22829":95857,"_2311":95886},[],"Dispositivo → servidor EST",{"_2783":56849,"_24069":56838,"_16893":95888,"_5":16788,"_22829":95857,"_2311":95889},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2783":56850,"_24069":56838,"_16893":95891,"_5":16788,"_22829":95857,"_2311":95892},[],"DMS → solicitante",{"_2783":56851,"_24069":56838,"_16893":95894,"_5":16788,"_22829":95857,"_2311":95895},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2783":56852,"_24069":56838,"_16893":95897,"_5":16788,"_22829":95857,"_2311":95898},[],"Consumidor → dispositivo",{"_2783":56853,"_24069":56838,"_16893":95900,"_5":16788,"_22829":95857,"_2311":95901},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2783":56854,"_24069":56838,"_16893":95903,"_5":16788,"_22829":95857,"_2311":95904},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2783":56855,"_24069":56838,"_16893":95906,"_5":16788,"_22829":95861,"_2311":95907},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2783":56856,"_24069":56838,"_16893":95909,"_5":16788,"_22829":95861,"_2311":95910},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2783":56857,"_24069":56838,"_16893":95912,"_5":16788,"_22829":95865,"_2311":95913},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2783":56858,"_24069":56838,"_16893":95915,"_5":16788,"_22829":95865,"_2311":95916},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2783":56859,"_24069":56838,"_16893":95918,"_5":16788,"_22829":95865,"_2311":95919},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2783":56860,"_24069":56838,"_16893":95921,"_5":16788,"_22829":95865,"_2311":95922},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2783":56861,"_24069":56838,"_16893":95924,"_5":16788,"_22829":95865,"_2311":95925},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2783":56862,"_24069":56838,"_16893":95927,"_5":16788,"_22829":95865,"_2311":95928},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2783":56863,"_24069":56838,"_16893":95930,"_5":16788,"_22829":95869,"_2311":95931},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2783":56864,"_24069":56838,"_16893":95933,"_5":16788,"_22829":95869,"_2311":95934},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2783":56865,"_24069":56838,"_16893":95936,"_5":16788,"_22829":95869,"_2311":95937},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2783":56866,"_24069":56838,"_16893":95939,"_5":16788,"_22829":95873,"_2311":95940},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2783":56867,"_24069":56867,"_5":11891,"_2311":42875,"_24405":95942,"_16893":95944,"_22829":56867},[39337,93789,41556,94662,95943],"Integraciones",[],{"_2783":56868,"_24069":56867,"_16893":95946,"_5":16788,"_22829":56867,"_2311":95947},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2783":56869,"_24069":56867,"_5":24402,"_16893":95949,"_22829":95950,"_2311":95951},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2783":56870,"_24069":56867,"_5":24402,"_16893":95953,"_22829":95954,"_2311":95955},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2783":56871,"_24069":56867,"_5":24402,"_16893":95957,"_22829":95958,"_2311":95959},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2783":56872,"_24069":56867,"_5":24402,"_16893":95961,"_22829":95962,"_2311":95963},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2783":56873,"_24069":56867,"_5":24402,"_16893":95965,"_22829":95966,"_2311":95967},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2783":56874,"_24069":56867,"_5":24402,"_16893":95969,"_22829":95970,"_2311":95971},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2783":56875,"_24069":56867,"_5":24402,"_16893":95973,"_22829":95974,"_2311":42909},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2783":56876,"_24069":56867,"_5":24402,"_16893":95976,"_22829":95977,"_2311":42913},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2783":56877,"_24069":56867,"_5":24402,"_16893":95979,"_22829":95980,"_2311":95981},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2783":56878,"_24069":56867,"_5":24402,"_16893":95983,"_22829":95984,"_2311":95985},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2783":56879,"_24069":56867,"_5":24402,"_16893":95987,"_22829":95988,"_2311":95989},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2783":56880,"_24069":56867,"_5":24402,"_16893":95991,"_22829":95992,"_2311":95993},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2783":56881,"_24069":56867,"_5":24402,"_16893":95995,"_22829":95996,"_2311":95997},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2783":56882,"_24069":56867,"_5":24402,"_16893":95999,"_22829":96000,"_2311":96001},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2783":56883,"_24069":56867,"_5":24402,"_16893":96003,"_22829":96004,"_2311":96005},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2783":56884,"_24069":56867,"_5":24402,"_16893":96007,"_22829":96008,"_2311":96009},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2783":56885,"_24069":56867,"_5":24402,"_16893":96011,"_22829":96012,"_2311":96013},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2783":56886,"_24069":56867,"_5":24402,"_16893":96015,"_22829":96016,"_2311":96017},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2783":56887,"_24069":56867,"_5":24402,"_16893":96019,"_22829":96020,"_2311":96021},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2783":56888,"_24069":56867,"_5":24402,"_16893":96023,"_22829":96024,"_2311":96025},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2783":56889,"_24069":56867,"_16893":96027,"_5":16788,"_22829":56867,"_2311":96028},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2783":56890,"_24069":56867,"_16893":96030,"_5":16788,"_22829":56867,"_2311":96031},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2783":56891,"_24069":56867,"_16893":96033,"_5":16788,"_22829":56867,"_2311":96034},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2783":56892,"_24069":56867,"_16893":96036,"_5":16788,"_22829":95950,"_2311":96037},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2783":56893,"_24069":56867,"_16893":96039,"_5":16788,"_22829":95950,"_2311":96040},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2783":56894,"_24069":56867,"_16893":96042,"_5":16788,"_22829":95950,"_2311":96043},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2783":56895,"_24069":56867,"_16893":96045,"_5":16788,"_22829":95950,"_2311":96046},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2783":56896,"_24069":56867,"_16893":96048,"_5":16788,"_22829":95954,"_2311":96049},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2783":56897,"_24069":56867,"_16893":96051,"_5":16788,"_22829":95958,"_2311":96052},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2783":56898,"_24069":56867,"_16893":96054,"_5":16788,"_22829":95958,"_2311":96055},[],"Acción IAM",{"_2783":56899,"_24069":56867,"_16893":96057,"_5":16788,"_22829":95958,"_2311":92853},[],{"_2783":56900,"_24069":56867,"_16893":96059,"_5":16788,"_22829":95958,"_2311":42996},[],{"_2783":56901,"_24069":56867,"_16893":96061,"_5":16788,"_22829":95958,"_2311":96062},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2783":56902,"_24069":56867,"_16893":96064,"_5":16788,"_22829":95958,"_2311":43002},[],{"_2783":56903,"_24069":56867,"_16893":96066,"_5":16788,"_22829":95958,"_2311":96067},[],"Registrar la CA en AWS IoT",{"_2783":56904,"_24069":56867,"_16893":96069,"_5":16788,"_22829":95958,"_2311":43008},[],{"_2783":56905,"_24069":56867,"_16893":96071,"_5":16788,"_22829":95958,"_2311":96072},[],"Consultar el estado del registro de la CA",{"_2783":56906,"_24069":56867,"_16893":96074,"_5":16788,"_22829":95958,"_2311":43014},[],{"_2783":56907,"_24069":56867,"_16893":96076,"_5":16788,"_22829":95958,"_2311":96077},[],"Crear o actualizar Things en IoT Core",{"_2783":56908,"_24069":56867,"_16893":96079,"_5":16788,"_22829":95958,"_2311":43020},[],{"_2783":56909,"_24069":56867,"_16893":96081,"_5":16788,"_22829":95958,"_2311":96082},[],"Aprovisionar Things mediante plantilla",{"_2783":56910,"_24069":56867,"_16893":96084,"_5":16788,"_22829":95958,"_2311":43026},[],{"_2783":56911,"_24069":56867,"_16893":96086,"_5":16788,"_22829":95958,"_2311":96087},[],"Registrar certificados de dispositivo",{"_2783":56912,"_24069":56867,"_16893":96089,"_5":16788,"_22829":95958,"_2311":43032},[],{"_2783":56913,"_24069":56867,"_16893":96091,"_5":16788,"_22829":95958,"_2311":96092},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2783":56914,"_24069":56867,"_16893":96094,"_5":16788,"_22829":95958,"_2311":43038},[],{"_2783":56915,"_24069":56867,"_16893":96096,"_5":16788,"_22829":95958,"_2311":96097},[],"Crear y adjuntar políticas IoT",{"_2783":56916,"_24069":56867,"_16893":96099,"_5":16788,"_22829":95958,"_2311":43044},[],{"_2783":56917,"_24069":56867,"_16893":96101,"_5":16788,"_22829":95958,"_2311":96102},[],"Gestionar grupos de Things",{"_2783":56918,"_24069":56867,"_16893":96104,"_5":16788,"_22829":95958,"_2311":43050},[],{"_2783":56919,"_24069":56867,"_16893":96106,"_5":16788,"_22829":95958,"_2311":96107},[],"Crear plantillas JITP",{"_2783":56920,"_24069":56867,"_16893":96109,"_5":16788,"_22829":95958,"_2311":43056},[],{"_2783":56921,"_24069":56867,"_16893":96111,"_5":16788,"_22829":95958,"_2311":96112},[],"Leer y escribir el Device Shadow",{"_2783":56922,"_24069":56867,"_16893":96114,"_5":16788,"_22829":95958,"_2311":96115},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2783":56923,"_24069":56867,"_16893":96117,"_5":16788,"_22829":95962,"_2311":96118},[],"Parámetro",{"_2783":56924,"_24069":56867,"_16893":96120,"_5":16788,"_22829":95962,"_2311":96121},[],"Tipo",{"_2783":56925,"_24069":56867,"_16893":96123,"_5":16788,"_22829":95962,"_2311":96124},[],"Requerido",{"_2783":56926,"_24069":56867,"_16893":96126,"_5":16788,"_22829":95962,"_2311":96127},[],"Descripción",{"_2783":56927,"_24069":56867,"_16893":96129,"_5":16788,"_22829":95962,"_2311":43077},[],{"_2783":56928,"_24069":56867,"_16893":96131,"_5":16788,"_22829":95962,"_2311":20125},[],{"_2783":56929,"_24069":56867,"_16893":96133,"_5":16788,"_22829":95962,"_2311":96134},[],"Sí",{"_2783":56930,"_24069":56867,"_16893":96136,"_5":16788,"_22829":95962,"_2311":96137},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2783":56931,"_24069":56867,"_16893":96139,"_5":16788,"_22829":95962,"_2311":43088},[],{"_2783":56932,"_24069":56867,"_16893":96141,"_5":16788,"_22829":95962,"_2311":20125},[],{"_2783":56933,"_24069":56867,"_16893":96143,"_5":16788,"_22829":95962,"_2311":96134},[],{"_2783":56934,"_24069":56867,"_16893":96145,"_5":16788,"_22829":95962,"_2311":96146},[],"Región AWS donde opera el conector.",{"_2783":56935,"_24069":56867,"_16893":96148,"_5":16788,"_22829":95962,"_2311":43098},[],{"_2783":56936,"_24069":56867,"_16893":96150,"_5":16788,"_22829":95962,"_2311":20125},[],{"_2783":56937,"_24069":56867,"_16893":96152,"_5":16788,"_22829":95962,"_2311":96134},[],{"_2783":56938,"_24069":56867,"_16893":96154,"_5":16788,"_22829":95962,"_2311":96155},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2783":56939,"_24069":56867,"_16893":96157,"_5":16788,"_22829":95962,"_2311":43108},[],{"_2783":56940,"_24069":56867,"_16893":96159,"_5":16788,"_22829":95962,"_2311":20125},[],{"_2783":56941,"_24069":56867,"_16893":96161,"_5":16788,"_22829":95962,"_2311":96162},[],"Solo con `auth_method=static`",{"_2783":56942,"_24069":56867,"_16893":96164,"_5":16788,"_22829":95962,"_2311":96165},[],"Clave de acceso AWS.",{"_2783":56943,"_24069":56867,"_16893":96167,"_5":16788,"_22829":95962,"_2311":43119},[],{"_2783":56944,"_24069":56867,"_16893":96169,"_5":16788,"_22829":95962,"_2311":20125},[],{"_2783":56945,"_24069":56867,"_16893":96171,"_5":16788,"_22829":95962,"_2311":96162},[],{"_2783":56946,"_24069":56867,"_16893":96173,"_5":16788,"_22829":95962,"_2311":96174},[],"Clave secreta AWS.",{"_2783":56947,"_24069":56867,"_16893":96176,"_5":16788,"_22829":95962,"_2311":43129},[],{"_2783":56948,"_24069":56867,"_16893":96178,"_5":16788,"_22829":95962,"_2311":20125},[],{"_2783":56949,"_24069":56867,"_16893":96180,"_5":16788,"_22829":95962,"_2311":43134},[],{"_2783":56950,"_24069":56867,"_16893":96182,"_5":16788,"_22829":95962,"_2311":96183},[],"Token de sesión (con `auth_method=static`).",{"_2783":56951,"_24069":56867,"_16893":96185,"_5":16788,"_22829":95962,"_2311":43140},[],{"_2783":56952,"_24069":56867,"_16893":96187,"_5":16788,"_22829":95962,"_2311":20125},[],{"_2783":56953,"_24069":56867,"_16893":96189,"_5":16788,"_22829":95962,"_2311":96190},[],"Solo con `auth_method=role`",{"_2783":56954,"_24069":56867,"_16893":96192,"_5":16788,"_22829":95962,"_2311":96193},[],"ARN del rol a asumir.",{"_2783":56955,"_24069":56867,"_16893":96195,"_5":16788,"_22829":95962,"_2311":43151},[],{"_2783":56956,"_24069":56867,"_16893":96197,"_5":16788,"_22829":95962,"_2311":20125},[],{"_2783":56957,"_24069":56867,"_16893":96199,"_5":16788,"_22829":95962,"_2311":43134},[],{"_2783":56958,"_24069":56867,"_16893":96201,"_5":16788,"_22829":95962,"_2311":96202},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2783":56959,"_24069":56867,"_16893":96204,"_5":16788,"_22829":95962,"_2311":43161},[],{"_2783":56960,"_24069":56867,"_16893":96206,"_5":16788,"_22829":95962,"_2311":14212},[],{"_2783":56961,"_24069":56867,"_16893":96208,"_5":16788,"_22829":95962,"_2311":96134},[],{"_2783":56962,"_24069":56867,"_16893":96210,"_5":16788,"_22829":95962,"_2311":96211},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2783":56963,"_24069":56867,"_16893":96213,"_5":16788,"_22829":95962,"_2311":43171},[],{"_2783":56964,"_24069":56867,"_16893":96215,"_5":16788,"_22829":95962,"_2311":20125},[],{"_2783":56965,"_24069":56867,"_16893":96217,"_5":16788,"_22829":95962,"_2311":96134},[],{"_2783":56966,"_24069":56867,"_16893":96219,"_5":16788,"_22829":95962,"_2311":96220},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2783":56967,"_24069":56867,"_16893":96222,"_5":16788,"_22829":95962,"_2311":43181},[],{"_2783":56968,"_24069":56867,"_16893":96224,"_5":16788,"_22829":95962,"_2311":20125},[],{"_2783":56969,"_24069":56867,"_16893":96226,"_5":16788,"_22829":95962,"_2311":96134},[],{"_2783":56970,"_24069":56867,"_16893":96228,"_5":16788,"_22829":95962,"_2311":96229},[],"URL HTTP del Device Manager de Lamassu.",{"_2783":56971,"_24069":56867,"_16893":96231,"_5":16788,"_22829":95962,"_2311":43191},[],{"_2783":56972,"_24069":56867,"_16893":96233,"_5":16788,"_22829":95962,"_2311":20125},[],{"_2783":56973,"_24069":56867,"_16893":96235,"_5":16788,"_22829":95962,"_2311":96134},[],{"_2783":56974,"_24069":56867,"_16893":96237,"_5":16788,"_22829":95962,"_2311":96238},[],"URL HTTP del servicio de CA de Lamassu.",{"_2783":56975,"_24069":56867,"_16893":96240,"_5":16788,"_22829":95966,"_2311":96241},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2783":56976,"_24069":56867,"_16893":96243,"_5":16788,"_22829":95970,"_2311":96244},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2783":56977,"_24069":56867,"_16893":96246,"_5":16788,"_22829":95970,"_2311":96247},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2783":56978,"_24069":56867,"_16893":96249,"_5":16788,"_22829":95974,"_2311":96250},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2783":56979,"_24069":56867,"_16893":96252,"_5":16788,"_22829":95974,"_2311":96253},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2783":56980,"_24069":56867,"_16893":96255,"_5":16788,"_22829":95974,"_2311":96256},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2783":56981,"_24069":56867,"_16893":96258,"_5":16788,"_22829":95974,"_2311":96259},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2783":56982,"_24069":56867,"_16893":96261,"_5":16788,"_22829":95974,"_2311":96262},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2783":56983,"_24069":56867,"_16893":96264,"_5":16788,"_22829":95974,"_2311":96265},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2783":56984,"_24069":56867,"_16893":96267,"_5":16788,"_22829":95977,"_2311":96268},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2783":56985,"_24069":56867,"_16893":96270,"_5":16788,"_22829":95980,"_2311":96271},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2783":56986,"_24069":56867,"_16893":96273,"_5":16788,"_22829":95980,"_2311":96274},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2783":56987,"_24069":56867,"_16893":96276,"_5":16788,"_22829":95984,"_2311":96277},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2783":56988,"_24069":56867,"_16893":96279,"_5":16788,"_22829":95988,"_2311":96280},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2783":56989,"_24069":56867,"_16893":96282,"_5":16788,"_22829":95988,"_2311":96283},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2783":56990,"_24069":56867,"_16893":96285,"_5":16788,"_22829":95988,"_2311":96286},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2783":56991,"_24069":56867,"_16893":96288,"_5":16788,"_22829":95988,"_2311":96289},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2783":56992,"_24069":56867,"_16893":96291,"_5":16788,"_22829":95988,"_2311":96292},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2783":56993,"_24069":56867,"_16893":96294,"_5":16788,"_22829":95988,"_2311":96295},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2783":56994,"_24069":56867,"_16893":96297,"_5":16788,"_22829":95992,"_2311":96298},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2783":56995,"_24069":56867,"_16893":96300,"_5":16788,"_22829":95992,"_2311":96301},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2783":56996,"_24069":56867,"_16893":96303,"_5":16788,"_22829":95992,"_2311":96304},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2783":56997,"_24069":56867,"_16893":96306,"_5":16788,"_22829":95996,"_2311":96307},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2783":56998,"_24069":56867,"_16893":96309,"_5":16788,"_22829":95996,"_2311":96310},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2783":56999,"_24069":56867,"_16893":96312,"_5":16788,"_22829":95996,"_2311":96313},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2783":57000,"_24069":56867,"_16893":96315,"_5":16788,"_22829":96000,"_2311":96316},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2783":57001,"_24069":56867,"_16893":96318,"_5":16788,"_22829":96000,"_2311":96319},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2783":57002,"_24069":56867,"_16893":96321,"_5":16788,"_22829":96000,"_2311":96322},[],"Para que el flujo JITP funcione correctamente:",{"_2783":57003,"_24069":56867,"_16893":96324,"_5":16788,"_22829":96000,"_2311":96325},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2783":57004,"_24069":56867,"_16893":96327,"_5":16788,"_22829":96000,"_2311":96328},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2783":57005,"_24069":56867,"_16893":96330,"_5":16788,"_22829":96000,"_2311":96331},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2783":57006,"_24069":56867,"_16893":96333,"_5":16788,"_22829":96000,"_2311":96334},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2783":57007,"_24069":56867,"_16893":96336,"_5":16788,"_22829":96004,"_2311":96337},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2783":57008,"_24069":56867,"_16893":96339,"_5":16788,"_22829":96004,"_2311":96340},[],"Estado en Lamassu",{"_2783":57009,"_24069":56867,"_16893":96342,"_5":16788,"_22829":96004,"_2311":96343},[],"Razón de revocación",{"_2783":57010,"_24069":56867,"_16893":96345,"_5":16788,"_22829":96004,"_2311":96346},[],"Estado en AWS IoT Core",{"_2783":57011,"_24069":56867,"_16893":96348,"_5":16788,"_22829":96004,"_2311":43312},[],{"_2783":57012,"_24069":56867,"_16893":96350,"_5":16788,"_22829":96004,"_2311":96351},[],"Ninguna",{"_2783":57013,"_24069":56867,"_16893":96353,"_5":16788,"_22829":96004,"_2311":43318},[],{"_2783":57014,"_24069":56867,"_16893":96355,"_5":16788,"_22829":96004,"_2311":43321},[],{"_2783":57015,"_24069":56867,"_16893":96357,"_5":16788,"_22829":96004,"_2311":43324},[],{"_2783":57016,"_24069":56867,"_16893":96359,"_5":16788,"_22829":96004,"_2311":43327},[],{"_2783":57017,"_24069":56867,"_16893":96361,"_5":16788,"_22829":96004,"_2311":43321},[],{"_2783":57018,"_24069":56867,"_16893":96363,"_5":16788,"_22829":96004,"_2311":96364},[],"Cualquier otra razón",{"_2783":57019,"_24069":56867,"_16893":96366,"_5":16788,"_22829":96004,"_2311":43335},[],{"_2783":57020,"_24069":56867,"_16893":96368,"_5":16788,"_22829":96004,"_2311":96369},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2783":57021,"_24069":56867,"_16893":96371,"_5":16788,"_22829":96008,"_2311":96372},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2783":57022,"_24069":56867,"_16893":96374,"_5":16788,"_22829":96008,"_2311":96375},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2783":57023,"_24069":56867,"_16893":96377,"_5":16788,"_22829":96008,"_2311":96378},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2783":57024,"_24069":56867,"_16893":96380,"_5":16788,"_22829":96012,"_2311":96381},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2783":57025,"_24069":56867,"_16893":96383,"_5":16788,"_22829":96012,"_2311":96384},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2783":57026,"_24069":56867,"_16893":96386,"_5":16788,"_22829":96016,"_2311":96387},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2783":57027,"_24069":56867,"_16893":96389,"_5":16788,"_22829":96016,"_2311":96390},[],"Existen dos tipos de acciones:",{"_2783":57028,"_24069":56867,"_16893":96392,"_5":16788,"_22829":96016,"_2311":96393},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2783":57029,"_24069":56867,"_16893":96395,"_5":16788,"_22829":96016,"_2311":96396},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2783":57030,"_24069":56867,"_16893":96398,"_5":16788,"_22829":96016,"_2311":96399},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2783":57031,"_24069":56867,"_16893":96401,"_5":16788,"_22829":96020,"_2311":96402},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2783":57032,"_24069":56867,"_16893":96404,"_5":16788,"_22829":96020,"_2311":96405},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2783":57033,"_24069":56867,"_16893":96407,"_5":16788,"_22829":96020,"_2311":96408},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2783":57034,"_24069":56867,"_16893":96410,"_5":16788,"_22829":96024,"_2311":96411},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2783":57035,"_24069":56867,"_16893":96413,"_5":16788,"_22829":96024,"_2311":96414},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2783":57036,"_24069":56867,"_16893":96416,"_5":16788,"_22829":96024,"_2311":96417},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2783":57037,"_24069":56867,"_16893":96419,"_5":16788,"_22829":96024,"_2311":96420},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2783":57038,"_24069":56867,"_16893":96422,"_5":16788,"_22829":96024,"_2311":96423},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2783":57039,"_24069":56867,"_16893":96425,"_5":16788,"_22829":96024,"_2311":96426},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2783":57040,"_24069":56867,"_16893":96428,"_5":16788,"_22829":96024,"_2311":96429},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2783":57041,"_24069":56867,"_16893":96431,"_5":16788,"_22829":96024,"_2311":96432},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2783":57042,"_24069":56867,"_16893":96434,"_5":16788,"_22829":96024,"_2311":96435},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2783":57043,"_24069":56867,"_16893":96437,"_5":16788,"_22829":96024,"_2311":96438},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2783":57044,"_24069":56867,"_16893":96440,"_5":16788,"_22829":96024,"_2311":96441},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2783":57045,"_24069":56867,"_16893":96443,"_5":16788,"_22829":96024,"_2311":96444},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2783":57046,"_24069":56867,"_16893":96446,"_5":16788,"_22829":96024,"_2311":96447},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2783":57047,"_24069":56867,"_16893":96449,"_5":16788,"_22829":96024,"_2311":96450},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2783":57048,"_24069":56867,"_16893":96452,"_5":16788,"_22829":96024,"_2311":96453},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2783":57049,"_24069":56867,"_16893":96455,"_5":16788,"_22829":96024,"_2311":96456},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2783":57050,"_24069":56867,"_16893":96458,"_5":16788,"_22829":96024,"_2311":96459},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2783":57051,"_24069":56867,"_16893":96461,"_5":16788,"_22829":96024,"_2311":96462},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2783":57052,"_24069":56867,"_16893":96464,"_5":16788,"_22829":96024,"_2311":96465},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2783":57053,"_24069":56867,"_16893":96467,"_5":16788,"_22829":96024,"_2311":96468},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2783":57054,"_24069":56867,"_16893":96470,"_5":16788,"_22829":96024,"_2311":96471},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2783":57055,"_24069":57055,"_5":11891,"_2311":41556,"_24405":96473,"_16893":96474,"_22829":57055},[39337,93789,41556],[],{"_2783":57056,"_24069":57055,"_16893":96476,"_5":16788,"_22829":57055,"_2311":96477},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2783":57057,"_24069":57055,"_5":24402,"_16893":96479,"_22829":96480,"_2311":96481},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2783":57058,"_24069":57055,"_5":24402,"_16893":96483,"_22829":96484,"_2311":94662},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2783":57059,"_24069":57055,"_5":24402,"_16893":96486,"_22829":96487,"_2311":94837},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2783":57060,"_24069":57055,"_5":24402,"_16893":96489,"_22829":96490,"_2311":95943},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/overview#integraciones",{"_2783":57061,"_24069":57055,"_5":24402,"_16893":96492,"_22829":96493,"_2311":96494},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2783":57062,"_24069":57055,"_16893":96496,"_5":16788,"_22829":57055,"_2311":96497},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2783":57063,"_24069":57055,"_16893":96499,"_5":16788,"_22829":96480,"_2311":96500},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2783":57064,"_24069":57055,"_16893":96502,"_5":16788,"_22829":96480,"_2311":96503},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2783":57065,"_24069":57055,"_16893":96505,"_5":16788,"_22829":96484,"_2311":96506},[],"Recurso",{"_2783":57066,"_24069":57055,"_16893":96508,"_5":16788,"_22829":96484,"_2311":96509},[],"Qué representa",{"_2783":57067,"_24069":57055,"_16893":96511,"_5":16788,"_22829":96484,"_2311":96512},[],"**Dispositivo**",{"_2783":57068,"_24069":57055,"_16893":96514,"_5":16788,"_22829":96484,"_2311":96515},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2783":57069,"_24069":57055,"_16893":96517,"_5":16788,"_22829":96484,"_2311":96518},[],"**Identidad**",{"_2783":57070,"_24069":57055,"_16893":96520,"_5":16788,"_22829":96484,"_2311":96521},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2783":57071,"_24069":57055,"_16893":96523,"_5":16788,"_22829":96484,"_2311":43493},[],{"_2783":57072,"_24069":57055,"_16893":96525,"_5":16788,"_22829":96484,"_2311":96526},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2783":57073,"_24069":57055,"_16893":96528,"_5":16788,"_22829":96484,"_2311":96529},[],"**Flota**",{"_2783":57074,"_24069":57055,"_16893":96531,"_5":16788,"_22829":96484,"_2311":96532},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2783":57075,"_24069":57055,"_16893":96534,"_5":16788,"_22829":96484,"_2311":96535},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2783":57076,"_24069":57055,"_16893":96537,"_5":16788,"_22829":96484,"_2311":96538},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2783":57077,"_24069":57055,"_16893":96540,"_5":16788,"_22829":96487,"_2311":96541},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2783":57078,"_24069":57055,"_16893":96543,"_5":16788,"_22829":96487,"_2311":96544},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2783":57079,"_24069":57055,"_16893":96546,"_5":16788,"_22829":96487,"_2311":96547},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2783":57080,"_24069":57055,"_16893":96549,"_5":16788,"_22829":96487,"_2311":96550},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2783":57081,"_24069":57055,"_16893":96552,"_5":16788,"_22829":96487,"_2311":96553},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2783":57082,"_24069":57055,"_16893":96555,"_5":16788,"_22829":96487,"_2311":96556},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2783":57083,"_24069":57055,"_16893":96558,"_5":16788,"_22829":96487,"_2311":96559},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2783":57084,"_24069":57055,"_16893":96561,"_5":16788,"_22829":96487,"_2311":96562},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2783":57085,"_24069":57055,"_16893":96564,"_5":16788,"_22829":96490,"_2311":96565},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2783":57086,"_24069":57055,"_16893":96567,"_5":16788,"_22829":96490,"_2311":96568},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2783":57087,"_24069":57055,"_16893":96570,"_5":16788,"_22829":96493,"_2311":96571},[],"Participante",{"_2783":57088,"_24069":57055,"_16893":96573,"_5":16788,"_22829":96493,"_2311":96574},[],"Responsabilidad",{"_2783":57089,"_24069":57055,"_16893":96576,"_5":16788,"_22829":96493,"_2311":96577},[],"Administrador PKI",{"_2783":57090,"_24069":57055,"_16893":96579,"_5":16788,"_22829":96493,"_2311":96580},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2783":57091,"_24069":57055,"_16893":96582,"_5":16788,"_22829":96493,"_2311":96583},[],"Administrador del aprovisionamiento",{"_2783":57092,"_24069":57055,"_16893":96585,"_5":16788,"_22829":96493,"_2311":96586},[],"DMS, admisión, autenticación por operación e inventario.",{"_2783":57093,"_24069":57055,"_16893":96588,"_5":16788,"_22829":96493,"_2311":96589},[],"Integrador del dispositivo",{"_2783":57094,"_24069":57055,"_16893":96591,"_5":16788,"_22829":96493,"_2311":96592},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2783":57095,"_24069":57055,"_16893":96594,"_5":16788,"_22829":96493,"_2311":96595},[],"Integrador del consumidor",{"_2783":57096,"_24069":57055,"_16893":96597,"_5":16788,"_22829":96493,"_2311":96598},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2783":57097,"_24069":57055,"_16893":96600,"_5":16788,"_22829":96493,"_2311":96601},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2783":57098,"_24069":57098,"_5":11891,"_2311":96603,"_24405":96604,"_16893":96606,"_22829":57098},"Enrola y conecta tu primer dispositivo",[39337,93789,41556,96605],"Primeros pasos",[],{"_2783":57099,"_24069":57098,"_16893":96608,"_5":16788,"_22829":57098,"_2311":96609},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2783":57100,"_24069":57098,"_5":24402,"_16893":96611,"_22829":96612,"_2311":92490},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2783":57101,"_24069":57098,"_5":24402,"_16893":96614,"_22829":96615,"_2311":96616},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2783":57102,"_24069":57098,"_5":24402,"_16893":96618,"_22829":96619,"_2311":96620},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2783":57103,"_24069":57098,"_5":24402,"_16893":96622,"_22829":96623,"_2311":96624},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2783":57104,"_24069":57098,"_5":24402,"_16893":96626,"_22829":96627,"_2311":96628},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2783":57105,"_24069":57098,"_5":24402,"_16893":96630,"_22829":96631,"_2311":96632},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2783":57106,"_24069":57098,"_5":24402,"_16893":96634,"_22829":96635,"_2311":96636},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2783":57107,"_24069":57098,"_5":24402,"_16893":96638,"_22829":96639,"_2311":96640},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2783":57108,"_24069":57098,"_16893":96642,"_5":16788,"_22829":57098,"_2311":96643},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2783":57109,"_24069":57098,"_16893":96645,"_5":16788,"_22829":96612,"_2311":96646},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2783":57110,"_24069":57098,"_16893":96648,"_5":16788,"_22829":96612,"_2311":96649},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2783":57111,"_24069":57098,"_16893":96651,"_5":16788,"_22829":96612,"_2311":96652},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2783":57112,"_24069":57098,"_16893":96654,"_5":16788,"_22829":96612,"_2311":96655},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2783":57113,"_24069":57098,"_16893":96657,"_5":16788,"_22829":96612,"_2311":96658},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2783":57114,"_24069":57098,"_16893":96660,"_5":16788,"_22829":96615,"_2311":96661},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2783":57115,"_24069":57098,"_16893":96663,"_5":16788,"_22829":96615,"_2311":96664},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2783":57116,"_24069":57098,"_16893":96666,"_5":16788,"_22829":96619,"_2311":96667},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2783":57117,"_24069":57098,"_16893":96669,"_5":16788,"_22829":96619,"_2311":96670},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2783":57118,"_24069":57098,"_16893":96672,"_5":16788,"_22829":96619,"_2311":96673},[],"Ajuste",{"_2783":57119,"_24069":57098,"_16893":96675,"_5":16788,"_22829":96619,"_2311":96676},[],"Valor de evaluación",{"_2783":57120,"_24069":57098,"_16893":96678,"_5":16788,"_22829":96619,"_2311":43649},[],{"_2783":57121,"_24069":57098,"_16893":96680,"_5":16788,"_22829":96619,"_2311":96681},[],"Raíz emisora de `device-root.pem`.",{"_2783":57122,"_24069":57098,"_16893":96683,"_5":16788,"_22829":96619,"_2311":94961},[],{"_2783":57123,"_24069":57098,"_16893":96685,"_5":16788,"_22829":96619,"_2311":96686},[],"Perfil final de 1 hora que acabas de preparar.",{"_2783":57124,"_24069":57098,"_16893":96688,"_5":16788,"_22829":96619,"_2311":43660},[],{"_2783":57125,"_24069":57098,"_16893":96690,"_5":16788,"_22829":96619,"_2311":43663},[],{"_2783":57126,"_24069":57098,"_16893":96692,"_5":16788,"_22829":96619,"_2311":43666},[],{"_2783":57127,"_24069":57098,"_16893":96694,"_5":16788,"_22829":96619,"_2311":96695},[],"Habilitado.",{"_2783":57128,"_24069":57098,"_16893":96697,"_5":16788,"_22829":96619,"_2311":43672},[],{"_2783":57129,"_24069":57098,"_16893":96699,"_5":16788,"_22829":96619,"_2311":96700},[],"Deshabilitado; el ID debe ser nuevo.",{"_2783":57130,"_24069":57098,"_16893":96702,"_5":16788,"_22829":96619,"_2311":96703},[],"Autenticación inicial",{"_2783":57131,"_24069":57098,"_16893":96705,"_5":16788,"_22829":96619,"_2311":96706},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2783":57132,"_24069":57098,"_16893":96708,"_5":16788,"_22829":96619,"_2311":96709},[],"Autenticación de renovación",{"_2783":57133,"_24069":57098,"_16893":96711,"_5":16788,"_22829":96619,"_2311":96712},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2783":57134,"_24069":57098,"_16893":96714,"_5":16788,"_22829":96619,"_2311":43690},[],{"_2783":57135,"_24069":57098,"_16893":96716,"_5":16788,"_22829":96619,"_2311":96717},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2783":57136,"_24069":57098,"_16893":96719,"_5":16788,"_22829":96619,"_2311":43696},[],{"_2783":57137,"_24069":57098,"_16893":96721,"_5":16788,"_22829":96619,"_2311":96722},[],"1 hora.",{"_2783":57138,"_24069":57098,"_16893":96724,"_5":16788,"_22829":96619,"_2311":43702},[],{"_2783":57139,"_24069":57098,"_16893":96726,"_5":16788,"_22829":96619,"_2311":96727},[],"30 minutos / 10 minutos.",{"_2783":57140,"_24069":57098,"_16893":96729,"_5":16788,"_22829":96619,"_2311":43708},[],{"_2783":57141,"_24069":57098,"_16893":96731,"_5":16788,"_22829":96619,"_2311":96732},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2783":57142,"_24069":57098,"_16893":96734,"_5":16788,"_22829":96619,"_2311":41871},[],{"_2783":57143,"_24069":57098,"_16893":96736,"_5":16788,"_22829":96619,"_2311":96737},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2783":57144,"_24069":57098,"_16893":96739,"_5":16788,"_22829":96619,"_2311":43719},[],{"_2783":57145,"_24069":57098,"_16893":96741,"_5":16788,"_22829":96619,"_2311":96742},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2783":57146,"_24069":57098,"_16893":96744,"_5":16788,"_22829":96619,"_2311":96745},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2783":57147,"_24069":57098,"_16893":96747,"_5":16788,"_22829":96623,"_2311":96748},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2783":57148,"_24069":57098,"_16893":96750,"_5":16788,"_22829":96623,"_2311":96751},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2783":57149,"_24069":57098,"_16893":96753,"_5":16788,"_22829":96627,"_2311":96754},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2783":57150,"_24069":57098,"_16893":96756,"_5":16788,"_22829":96627,"_2311":96757},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2783":57151,"_24069":57098,"_16893":96759,"_5":16788,"_22829":96627,"_2311":96760},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2783":57152,"_24069":57098,"_16893":96762,"_5":16788,"_22829":96631,"_2311":96763},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2783":57153,"_24069":57098,"_16893":96765,"_5":16788,"_22829":96631,"_2311":96766},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2783":57154,"_24069":57098,"_16893":96768,"_5":16788,"_22829":96635,"_2311":96769},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2783":57155,"_24069":57098,"_16893":96771,"_5":16788,"_22829":96635,"_2311":96772},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2783":57156,"_24069":57098,"_16893":96774,"_5":16788,"_22829":96635,"_2311":96775},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2783":57157,"_24069":57098,"_16893":96777,"_5":16788,"_22829":96635,"_2311":96778},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2783":57158,"_24069":57098,"_16893":96780,"_5":16788,"_22829":96635,"_2311":96781},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2783":57159,"_24069":57098,"_16893":96783,"_5":16788,"_22829":96639,"_2311":96784},[],"Comprobación",{"_2783":57160,"_24069":57098,"_16893":96786,"_5":16788,"_22829":96639,"_2311":96787},[],"Resultado esperado",{"_2783":57161,"_24069":57098,"_16893":96789,"_5":16788,"_22829":96639,"_2311":96790},[],"Registro",{"_2783":57162,"_24069":57098,"_16893":96792,"_5":16788,"_22829":96639,"_2311":96793},[],"ID creado automáticamente y DMS correcto.",{"_2783":57163,"_24069":57098,"_16893":96795,"_5":16788,"_22829":96639,"_2311":96796},[],"Certificado",{"_2783":57164,"_24069":57098,"_16893":96798,"_5":16788,"_22829":96639,"_2311":96799},[],"CN, perfil, serie y clave verificados.",{"_2783":57165,"_24069":57098,"_16893":96801,"_5":16788,"_22829":96639,"_2311":96802},[],"Inventario",{"_2783":57166,"_24069":57098,"_16893":96804,"_5":16788,"_22829":96639,"_2311":96805},[],"Serie recibida visible como identidad actual y en el historial.",{"_2783":57167,"_24069":57098,"_16893":96807,"_5":16788,"_22829":96639,"_2311":96808},[],"Consumidor",{"_2783":57168,"_24069":57098,"_16893":96810,"_5":16788,"_22829":96639,"_2311":96811},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2783":57169,"_24069":57098,"_16893":96813,"_5":16788,"_22829":96639,"_2311":96814},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2783":57170,"_24069":57098,"_16893":96816,"_5":16788,"_22829":96639,"_2311":96817},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2783":57171,"_24069":57171,"_5":11891,"_2311":94679,"_24405":96819,"_16893":96820,"_22829":57171},[39337,93789,41556,96605],[],{"_2783":57172,"_24069":57171,"_16893":96822,"_5":16788,"_22829":57171,"_2311":96823},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2783":57173,"_24069":57171,"_5":24402,"_16893":96825,"_22829":96826,"_2311":92490},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2783":57174,"_24069":57171,"_5":24402,"_16893":96828,"_22829":96829,"_2311":96830},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2783":57175,"_24069":57171,"_5":24402,"_16893":96832,"_22829":96833,"_2311":96834},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2783":57176,"_24069":57171,"_5":24402,"_16893":96836,"_22829":96837,"_2311":96838},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2783":57177,"_24069":57171,"_5":24402,"_16893":96840,"_22829":96841,"_2311":96842},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2783":57178,"_24069":57171,"_5":24402,"_16893":96844,"_22829":96845,"_2311":96846},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2783":57179,"_24069":57171,"_5":24402,"_16893":96848,"_22829":96849,"_2311":96787},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2783":57180,"_24069":57171,"_5":24402,"_16893":96851,"_22829":96852,"_2311":96853},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2783":57181,"_24069":57171,"_5":24402,"_16893":96855,"_22829":96856,"_2311":96857},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2783":57182,"_24069":57171,"_16893":96859,"_5":16788,"_22829":57171,"_2311":96860},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2783":57183,"_24069":57171,"_16893":96862,"_5":16788,"_22829":57171,"_2311":96863},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2783":57184,"_24069":57171,"_16893":96865,"_5":16788,"_22829":96826,"_2311":96866},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2783":57185,"_24069":57171,"_16893":96868,"_5":16788,"_22829":96826,"_2311":96869},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2783":57186,"_24069":57171,"_16893":96871,"_5":16788,"_22829":96826,"_2311":96872},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2783":57187,"_24069":57171,"_16893":96874,"_5":16788,"_22829":96826,"_2311":96875},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2783":57188,"_24069":57171,"_16893":96877,"_5":16788,"_22829":96829,"_2311":96878},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2783":57189,"_24069":57171,"_16893":96880,"_5":16788,"_22829":96829,"_2311":96881},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2783":57190,"_24069":57171,"_16893":96883,"_5":16788,"_22829":96829,"_2311":96884},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2783":57191,"_24069":57171,"_16893":96886,"_5":16788,"_22829":96829,"_2311":96887},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2783":57192,"_24069":57171,"_16893":96889,"_5":16788,"_22829":96829,"_2311":96890},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2783":57193,"_24069":57171,"_16893":96892,"_5":16788,"_22829":96829,"_2311":96893},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2783":57194,"_24069":57171,"_16893":96895,"_5":16788,"_22829":96829,"_2311":96896},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2783":57195,"_24069":57171,"_16893":96898,"_5":16788,"_22829":96829,"_2311":96899},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2783":57196,"_24069":57171,"_16893":96901,"_5":16788,"_22829":96833,"_2311":96902},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2783":57197,"_24069":57171,"_16893":96904,"_5":16788,"_22829":96833,"_2311":43885},[],{"_2783":57198,"_24069":57171,"_16893":96906,"_5":16788,"_22829":96833,"_2311":96907},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2783":57199,"_24069":57171,"_16893":96909,"_5":16788,"_22829":96833,"_2311":96910},[],"**Icon** y **Tags**: clasificación opcional.",{"_2783":57200,"_24069":57171,"_16893":96912,"_5":16788,"_22829":96833,"_2311":96913},[],"Confirma el registro.",{"_2783":57201,"_24069":57171,"_16893":96915,"_5":16788,"_22829":96837,"_2311":96916},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2783":57202,"_24069":57171,"_16893":96918,"_5":16788,"_22829":96837,"_2311":96919},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2783":57203,"_24069":57171,"_16893":96921,"_5":16788,"_22829":96841,"_2311":96922},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2783":57204,"_24069":57171,"_16893":96924,"_5":16788,"_22829":96841,"_2311":96925},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2783":57205,"_24069":57171,"_16893":96927,"_5":16788,"_22829":96845,"_2311":96928},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2783":57206,"_24069":57171,"_16893":96930,"_5":16788,"_22829":96845,"_2311":96931},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2783":57207,"_24069":57171,"_16893":96933,"_5":16788,"_22829":96849,"_2311":96784},[],{"_2783":57208,"_24069":57171,"_16893":96935,"_5":16788,"_22829":96849,"_2311":96936},[],"Resultado",{"_2783":57209,"_24069":57171,"_16893":96938,"_5":16788,"_22829":96849,"_2311":96939},[],"Dispositivo",{"_2783":57210,"_24069":57171,"_16893":96941,"_5":16788,"_22829":96849,"_2311":96942},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2783":57211,"_24069":57171,"_16893":96944,"_5":16788,"_22829":96849,"_2311":96945},[],"Identidad actual",{"_2783":57212,"_24069":57171,"_16893":96947,"_5":16788,"_22829":96849,"_2311":96948},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2783":57213,"_24069":57171,"_16893":96950,"_5":16788,"_22829":96849,"_2311":96951},[],"Historial",{"_2783":57214,"_24069":57171,"_16893":96953,"_5":16788,"_22829":96849,"_2311":96954},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2783":57215,"_24069":57171,"_16893":96956,"_5":16788,"_22829":96849,"_2311":96957},[],"Clave y certificado",{"_2783":57216,"_24069":57171,"_16893":96959,"_5":16788,"_22829":96849,"_2311":96960},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2783":57217,"_24069":57171,"_16893":96962,"_5":16788,"_22829":96852,"_2311":96963},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2783":57218,"_24069":57171,"_16893":96965,"_5":16788,"_22829":96852,"_2311":96966},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2783":57219,"_24069":57171,"_16893":96968,"_5":16788,"_22829":96852,"_2311":96969},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2783":57220,"_24069":57171,"_16893":96971,"_5":16788,"_22829":96852,"_2311":96972},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2783":57221,"_24069":57171,"_16893":96974,"_5":16788,"_22829":96856,"_2311":96975},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2783":57222,"_24069":57171,"_16893":96977,"_5":16788,"_22829":96856,"_2311":96978},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2783":57223,"_24069":57171,"_16893":96980,"_5":16788,"_22829":96856,"_2311":96981},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2783":57224,"_24069":57224,"_5":11891,"_2311":96983,"_24405":96984,"_16893":96985,"_22829":57224},"Plataforma Lamassu IoT",[39337,93789],[],{"_2783":57225,"_24069":57224,"_16893":96987,"_5":16788,"_22829":57224,"_2311":96988},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2783":57226,"_24069":57224,"_5":24402,"_16893":96990,"_22829":96991,"_2311":96481},[],"/docs/pr-preview/pr-27/es/platform/overview#empieza-aquí",{"_2783":57227,"_24069":57224,"_5":24402,"_16893":96993,"_22829":96994,"_2311":96995},[],"/docs/pr-preview/pr-27/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2783":57228,"_24069":57224,"_5":24402,"_16893":96997,"_22829":96998,"_2311":96999},[],"/docs/pr-preview/pr-27/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2783":57229,"_24069":57224,"_5":24402,"_16893":97001,"_22829":97002,"_2311":97003},[],"/docs/pr-preview/pr-27/es/platform/overview#capacidades-principales","Capacidades principales",{"_2783":57230,"_24069":57224,"_5":24402,"_16893":97005,"_22829":97006,"_2311":97007},[],"/docs/pr-preview/pr-27/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2783":57231,"_24069":57224,"_5":24402,"_16893":97009,"_22829":97010,"_2311":97011},[],"/docs/pr-preview/pr-27/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2783":57232,"_24069":57224,"_5":24402,"_16893":97013,"_22829":97014,"_2311":97015},[],"/docs/pr-preview/pr-27/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2783":57233,"_24069":57224,"_5":24402,"_16893":97017,"_22829":97018,"_2311":97019},[],"/docs/pr-preview/pr-27/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2783":57234,"_24069":57224,"_5":24402,"_16893":97021,"_22829":97022,"_2311":97023},[],"/docs/pr-preview/pr-27/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2783":57235,"_24069":57224,"_5":24402,"_16893":97025,"_22829":97026,"_2311":97027},[],"/docs/pr-preview/pr-27/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2783":57236,"_24069":57224,"_5":24402,"_16893":97029,"_22829":97030,"_2311":97031},[],"/docs/pr-preview/pr-27/es/platform/overview#referencia-operativa","Referencia operativa",{"_2783":57237,"_24069":57224,"_16893":97033,"_5":16788,"_22829":57224,"_2311":97034},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2783":57238,"_24069":57224,"_16893":97036,"_5":16788,"_22829":96991,"_2311":97037},[],"Elige el resultado que necesitas obtener:",{"_2783":57239,"_24069":57224,"_16893":97039,"_5":16788,"_22829":96991,"_2311":97040},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2783":57240,"_24069":57224,"_16893":97042,"_5":16788,"_22829":96991,"_2311":97043},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2783":57241,"_24069":57224,"_16893":97045,"_5":16788,"_22829":96991,"_2311":97046},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2783":57242,"_24069":57224,"_16893":97048,"_5":16788,"_22829":96994,"_2311":97049},[],"Bloque",{"_2783":57243,"_24069":57224,"_16893":97051,"_5":16788,"_22829":96994,"_2311":97052},[],"Qué gestionas",{"_2783":57244,"_24069":57224,"_16893":97054,"_5":16788,"_22829":96994,"_2311":97055},[],"Punto de entrada",{"_2783":57245,"_24069":57224,"_16893":97057,"_5":16788,"_22829":96994,"_2311":44039},[],{"_2783":57246,"_24069":57224,"_16893":97059,"_5":16788,"_22829":96994,"_2311":97060},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2783":57247,"_24069":57224,"_16893":97062,"_5":16788,"_22829":96994,"_2311":97063},[],"Visión general de PKI",{"_2783":57248,"_24069":57224,"_16893":97065,"_5":16788,"_22829":96994,"_2311":44048},[],{"_2783":57249,"_24069":57224,"_16893":97067,"_5":16788,"_22829":96994,"_2311":97068},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2783":57250,"_24069":57224,"_16893":97070,"_5":16788,"_22829":96994,"_2311":97071},[],"Visión general de IoT Fleets",{"_2783":57251,"_24069":57224,"_16893":97073,"_5":16788,"_22829":96994,"_2311":97074},[],"**Administración**",{"_2783":57252,"_24069":57224,"_16893":97076,"_5":16788,"_22829":96994,"_2311":97077},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2783":57253,"_24069":57224,"_16893":97079,"_5":16788,"_22829":96994,"_2311":93787},[],{"_2783":57254,"_24069":57224,"_16893":97081,"_5":16788,"_22829":96994,"_2311":97082},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2783":57255,"_24069":57224,"_16893":97084,"_5":16788,"_22829":96998,"_2311":97085},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2783":57256,"_24069":57224,"_16893":97087,"_5":16788,"_22829":96998,"_2311":97088},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2783":57257,"_24069":57224,"_16893":97090,"_5":16788,"_22829":96998,"_2311":97091},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2783":57258,"_24069":57224,"_16893":97093,"_5":16788,"_22829":96998,"_2311":97094},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2783":57259,"_24069":57224,"_16893":97096,"_5":16788,"_22829":96998,"_2311":97097},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2783":57260,"_24069":57224,"_16893":97099,"_5":16788,"_22829":96998,"_2311":97100},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2783":57261,"_24069":57224,"_16893":97102,"_5":16788,"_22829":97006,"_2311":97103},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2783":57262,"_24069":57224,"_16893":97105,"_5":16788,"_22829":97010,"_2311":97106},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2783":57263,"_24069":57224,"_16893":97108,"_5":16788,"_22829":97014,"_2311":97109},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2783":57264,"_24069":57224,"_16893":97111,"_5":16788,"_22829":97018,"_2311":97112},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2783":57265,"_24069":57224,"_16893":97114,"_5":16788,"_22829":97022,"_2311":97115},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2783":57266,"_24069":57224,"_16893":97117,"_5":16788,"_22829":97026,"_2311":97118},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2783":57267,"_24069":57224,"_16893":97120,"_5":16788,"_22829":97030,"_2311":96574},[],{"_2783":57268,"_24069":57224,"_16893":97122,"_5":16788,"_22829":97030,"_2311":97123},[],"Qué prepara o comprueba",{"_2783":57269,"_24069":57224,"_16893":97125,"_5":16788,"_22829":97030,"_2311":96577},[],{"_2783":57270,"_24069":57224,"_16893":97127,"_5":16788,"_22829":97030,"_2311":97128},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2783":57271,"_24069":57224,"_16893":97130,"_5":16788,"_22829":97030,"_2311":97131},[],"Administrador de la flota",{"_2783":57272,"_24069":57224,"_16893":97133,"_5":16788,"_22829":97030,"_2311":97134},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2783":57273,"_24069":57224,"_16893":97136,"_5":16788,"_22829":97030,"_2311":96589},[],{"_2783":57274,"_24069":57224,"_16893":97138,"_5":16788,"_22829":97030,"_2311":97139},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2783":57275,"_24069":57224,"_16893":97141,"_5":16788,"_22829":97030,"_2311":96595},[],{"_2783":57276,"_24069":57224,"_16893":97143,"_5":16788,"_22829":97030,"_2311":97144},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2783":57277,"_24069":57224,"_16893":97146,"_5":16788,"_22829":97030,"_2311":97147},[],"Operador de infraestructura",{"_2783":57278,"_24069":57224,"_16893":97149,"_5":16788,"_22829":97030,"_2311":97150},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2783":57279,"_24069":57224,"_16893":97152,"_5":16788,"_22829":97030,"_2311":97153},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2783":57280,"_24069":57280,"_5":11891,"_2311":97155,"_24405":97156,"_16893":97158,"_22829":57280},"Jerarquía y rotación de CAs",[39337,93789,44140,97157],"Claves, autoridades y certificados",[],{"_2783":57281,"_24069":57280,"_16893":97160,"_5":16788,"_22829":57280,"_2311":97161},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2783":57282,"_24069":57280,"_5":24402,"_16893":97163,"_22829":97164,"_2311":97165},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2783":57283,"_24069":57280,"_5":24402,"_16893":97167,"_22829":97168,"_2311":97169},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2783":57284,"_24069":57280,"_5":24402,"_16893":97171,"_22829":97172,"_2311":97173},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2783":57285,"_24069":57280,"_5":24402,"_16893":97175,"_22829":97176,"_2311":97177},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2783":57286,"_24069":57280,"_5":24402,"_16893":97179,"_22829":97180,"_2311":97181},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2783":57287,"_24069":57280,"_5":24402,"_16893":97183,"_22829":97184,"_2311":97185},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2783":57288,"_24069":57280,"_5":24402,"_16893":97187,"_22829":97188,"_2311":97189},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2783":57289,"_24069":57280,"_5":24402,"_16893":97191,"_22829":97192,"_2311":97193},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2783":57290,"_24069":57280,"_5":24402,"_16893":97195,"_22829":97196,"_2311":97197},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2783":57291,"_24069":57280,"_5":24402,"_16893":97199,"_22829":97200,"_2311":97201},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2783":57292,"_24069":57280,"_5":24402,"_16893":97203,"_22829":97204,"_2311":97205},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2783":57293,"_24069":57280,"_5":24402,"_16893":97207,"_22829":97208,"_2311":97209},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2783":57294,"_24069":57280,"_16893":97211,"_5":16788,"_22829":57280,"_2311":97212},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2783":57295,"_24069":57280,"_16893":97214,"_5":16788,"_22829":57280,"_2311":97215},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2783":57296,"_24069":57280,"_16893":97217,"_5":16788,"_22829":97164,"_2311":97218},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2783":57297,"_24069":57280,"_16893":97220,"_5":16788,"_22829":97164,"_2311":97221},[],"entorno, como producción y preproducción;",{"_2783":57298,"_24069":57280,"_16893":97223,"_5":16788,"_22829":97164,"_2311":97224},[],"propietario o equipo operador;",{"_2783":57299,"_24069":57280,"_16893":97226,"_5":16788,"_22829":97164,"_2311":97227},[],"familia de dispositivos o proceso de fabricación;",{"_2783":57300,"_24069":57280,"_16893":97229,"_5":16788,"_22829":97164,"_2311":97230},[],"región o requisito regulatorio;",{"_2783":57301,"_24069":57280,"_16893":97232,"_5":16788,"_22829":97164,"_2311":97233},[],"motor criptográfico o política de clave;",{"_2783":57302,"_24069":57280,"_16893":97235,"_5":16788,"_22829":97164,"_2311":97236},[],"ventana de mantenimiento y ritmo de renovación.",{"_2783":57303,"_24069":57280,"_16893":97238,"_5":16788,"_22829":97164,"_2311":97239},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2783":57304,"_24069":57280,"_16893":97241,"_5":16788,"_22829":97164,"_2311":97242},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2783":57305,"_24069":57280,"_16893":97244,"_5":16788,"_22829":97168,"_2311":97245},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2783":57306,"_24069":57280,"_16893":97247,"_5":16788,"_22829":97168,"_2311":97248},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2783":57307,"_24069":57280,"_16893":97250,"_5":16788,"_22829":97168,"_2311":97251},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2783":57308,"_24069":57280,"_16893":97253,"_5":16788,"_22829":97172,"_2311":97254},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2783":57309,"_24069":57280,"_16893":97256,"_5":16788,"_22829":97172,"_2311":97257},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2783":57310,"_24069":57280,"_16893":97259,"_5":16788,"_22829":97172,"_2311":97260},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2783":57311,"_24069":57280,"_16893":97262,"_5":16788,"_22829":97172,"_2311":97263},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2783":57312,"_24069":57280,"_16893":97265,"_5":16788,"_22829":97180,"_2311":97266},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2783":57313,"_24069":57280,"_16893":97268,"_5":16788,"_22829":97184,"_2311":97269},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2783":57314,"_24069":57280,"_16893":97271,"_5":16788,"_22829":97188,"_2311":97272},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2783":57315,"_24069":57280,"_16893":97274,"_5":16788,"_22829":97192,"_2311":97275},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2783":57316,"_24069":57280,"_16893":97277,"_5":16788,"_22829":97196,"_2311":97278},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2783":57317,"_24069":57280,"_16893":97280,"_5":16788,"_22829":97200,"_2311":97281},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2783":57318,"_24069":57280,"_16893":97283,"_5":16788,"_22829":97204,"_2311":97284},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2783":57319,"_24069":57280,"_16893":97286,"_5":16788,"_22829":97204,"_2311":97287},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2783":57320,"_24069":57280,"_16893":97289,"_5":16788,"_22829":97204,"_2311":97290},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2783":57321,"_24069":57280,"_16893":97292,"_5":16788,"_22829":97204,"_2311":97293},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2783":57322,"_24069":57280,"_16893":97295,"_5":16788,"_22829":97208,"_2311":97296},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2783":57323,"_24069":57280,"_16893":97298,"_5":16788,"_22829":97208,"_2311":97299},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2783":57324,"_24069":57280,"_16893":97301,"_5":16788,"_22829":97208,"_2311":97302},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2783":57325,"_24069":57280,"_16893":97304,"_5":16788,"_22829":97208,"_2311":97305},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2783":57326,"_24069":57280,"_16893":97307,"_5":16788,"_22829":97208,"_2311":97308},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2783":57327,"_24069":57280,"_16893":97310,"_5":16788,"_22829":97208,"_2311":97311},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2783":57328,"_24069":57280,"_16893":97313,"_5":16788,"_22829":97208,"_2311":97314},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2783":57329,"_24069":57329,"_5":11891,"_2311":97316,"_24405":97317,"_16893":97318,"_22829":57329},"Autoridades de certificación",[39337,93789,44140,97157],[],{"_2783":57330,"_24069":57329,"_16893":97320,"_5":16788,"_22829":57329,"_2311":97321},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2783":57331,"_24069":57329,"_5":24402,"_16893":97323,"_22829":97324,"_2311":97325},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2783":57332,"_24069":57329,"_5":24402,"_16893":97327,"_22829":97328,"_2311":97329},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2783":57333,"_24069":57329,"_5":24402,"_16893":97331,"_22829":97332,"_2311":92490},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2783":57334,"_24069":57329,"_5":24402,"_16893":97334,"_22829":97335,"_2311":97336},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2783":57335,"_24069":57329,"_5":24402,"_16893":97338,"_22829":97339,"_2311":97340},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2783":57336,"_24069":57329,"_5":24402,"_16893":97342,"_22829":97343,"_2311":97344},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2783":57337,"_24069":57329,"_5":24402,"_16893":97346,"_22829":97347,"_2311":97348},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2783":57338,"_24069":57329,"_5":24402,"_16893":97350,"_22829":97351,"_2311":97352},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2783":57339,"_24069":57329,"_5":24402,"_16893":97354,"_22829":97355,"_2311":97356},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2783":57340,"_24069":57329,"_5":24402,"_16893":97358,"_22829":97359,"_2311":97360},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2783":57341,"_24069":57329,"_5":24402,"_16893":97362,"_22829":97363,"_2311":97364},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2783":57342,"_24069":57329,"_5":24402,"_16893":97366,"_22829":97367,"_2311":97368},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2783":57343,"_24069":57329,"_5":24402,"_16893":97370,"_22829":97371,"_2311":97372},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2783":57344,"_24069":57329,"_5":24402,"_16893":97374,"_22829":97375,"_2311":97376},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2783":57345,"_24069":57329,"_5":24402,"_16893":97378,"_22829":97379,"_2311":97380},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2783":57346,"_24069":57329,"_5":24402,"_16893":97382,"_22829":97383,"_2311":97384},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2783":57347,"_24069":57329,"_5":24402,"_16893":97386,"_22829":97387,"_2311":97388},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2783":57348,"_24069":57329,"_5":24402,"_16893":97390,"_22829":97391,"_2311":97392},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2783":57349,"_24069":57329,"_5":24402,"_16893":97394,"_22829":97395,"_2311":97396},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2783":57350,"_24069":57329,"_5":24402,"_16893":97398,"_22829":97399,"_2311":97400},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2783":57351,"_24069":57329,"_5":24402,"_16893":97402,"_22829":97403,"_2311":97404},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2783":57352,"_24069":57329,"_5":24402,"_16893":97406,"_22829":97407,"_2311":97408},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2783":57353,"_24069":57329,"_16893":97410,"_5":16788,"_22829":57329,"_2311":97411},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2783":57354,"_24069":57329,"_16893":97413,"_5":16788,"_22829":57329,"_2311":97414},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2783":57355,"_24069":57329,"_16893":97416,"_5":16788,"_22829":57329,"_2311":97417},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2783":57356,"_24069":57329,"_16893":97419,"_5":16788,"_22829":97324,"_2311":97420},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2783":57357,"_24069":57329,"_16893":97422,"_5":16788,"_22829":97324,"_2311":97423},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2783":57358,"_24069":57329,"_16893":97425,"_5":16788,"_22829":97324,"_2311":97426},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2783":57359,"_24069":57329,"_16893":97428,"_5":16788,"_22829":97324,"_2311":97429},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2783":57360,"_24069":57329,"_16893":97431,"_5":16788,"_22829":97324,"_2311":97432},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2783":57361,"_24069":57329,"_16893":97434,"_5":16788,"_22829":97332,"_2311":97435},[],"Decide si la CA será raíz o intermedia.",{"_2783":57362,"_24069":57329,"_16893":97437,"_5":16788,"_22829":97332,"_2311":97438},[],"Elige el motor que custodiará la clave.",{"_2783":57363,"_24069":57329,"_16893":97440,"_5":16788,"_22829":97332,"_2311":97441},[],"Define una validez superior a la de los certificados que emitirá.",{"_2783":57364,"_24069":57329,"_16893":97443,"_5":16788,"_22829":97332,"_2311":97444},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2783":57365,"_24069":57329,"_16893":97446,"_5":16788,"_22829":97335,"_2311":97447},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2783":57366,"_24069":57329,"_16893":97449,"_5":16788,"_22829":97339,"_2311":97450},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2783":57367,"_24069":57329,"_16893":97452,"_5":16788,"_22829":97339,"_2311":97453},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2783":57368,"_24069":57329,"_16893":97455,"_5":16788,"_22829":97343,"_2311":97456},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2783":57369,"_24069":57329,"_16893":97458,"_5":16788,"_22829":97347,"_2311":97459},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2783":57370,"_24069":57329,"_16893":97461,"_5":16788,"_22829":97347,"_2311":97462},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2783":57371,"_24069":57329,"_16893":97464,"_5":16788,"_22829":97347,"_2311":97465},[],"`ST`: estado o provincia.",{"_2783":57372,"_24069":57329,"_16893":97467,"_5":16788,"_22829":97347,"_2311":97468},[],"`L`: localidad.",{"_2783":57373,"_24069":57329,"_16893":97470,"_5":16788,"_22829":97347,"_2311":97471},[],"`O`: organización.",{"_2783":57374,"_24069":57329,"_16893":97473,"_5":16788,"_22829":97347,"_2311":97474},[],"`OU`: unidad organizativa.",{"_2783":57375,"_24069":57329,"_16893":97476,"_5":16788,"_22829":97347,"_2311":97477},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2783":57376,"_24069":57329,"_16893":97479,"_5":16788,"_22829":97351,"_2311":97480},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2783":57377,"_24069":57329,"_16893":97482,"_5":16788,"_22829":97351,"_2311":97483},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2783":57378,"_24069":57329,"_16893":97485,"_5":16788,"_22829":97355,"_2311":97486},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2783":57379,"_24069":57329,"_16893":97488,"_5":16788,"_22829":97355,"_2311":97489},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2783":57380,"_24069":57329,"_16893":97491,"_5":16788,"_22829":97359,"_2311":97492},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2783":57381,"_24069":57329,"_16893":97494,"_5":16788,"_22829":97359,"_2311":97495},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2783":57382,"_24069":57329,"_16893":97497,"_5":16788,"_22829":97363,"_2311":97498},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2783":57383,"_24069":57329,"_16893":97500,"_5":16788,"_22829":97367,"_2311":97501},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2783":57384,"_24069":57329,"_16893":97503,"_5":16788,"_22829":97371,"_2311":97504},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2783":57385,"_24069":57329,"_16893":97506,"_5":16788,"_22829":97375,"_2311":97507},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2783":57386,"_24069":57329,"_16893":97509,"_5":16788,"_22829":97379,"_2311":97510},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2783":57387,"_24069":57329,"_16893":97512,"_5":16788,"_22829":97379,"_2311":97513},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2783":57388,"_24069":57329,"_16893":97515,"_5":16788,"_22829":97383,"_2311":97516},[],"Abre una CA desde el inventario para consultar:",{"_2783":57389,"_24069":57329,"_16893":97518,"_5":16788,"_22829":97383,"_2311":97519},[],"Estado y periodo de validez.",{"_2783":57390,"_24069":57329,"_16893":97521,"_5":16788,"_22829":97383,"_2311":97522},[],"Certificado y cadena en formato PEM.",{"_2783":57391,"_24069":57329,"_16893":97524,"_5":16788,"_22829":97383,"_2311":97525},[],"Número de certificados activos, expirados y revocados.",{"_2783":57392,"_24069":57329,"_16893":97527,"_5":16788,"_22829":97383,"_2311":97528},[],"Certificados emitidos en **Issued Certificates**.",{"_2783":57393,"_24069":57329,"_16893":97530,"_5":16788,"_22829":97383,"_2311":97531},[],"CRL vinculada a la autoridad.",{"_2783":57394,"_24069":57329,"_16893":97533,"_5":16788,"_22829":97383,"_2311":97534},[],"Metadatos y motor criptográfico asociado.",{"_2783":57395,"_24069":57329,"_16893":97536,"_5":16788,"_22829":97383,"_2311":97537},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2783":57396,"_24069":57329,"_16893":97539,"_5":16788,"_22829":97387,"_2311":97540},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2783":57397,"_24069":57329,"_16893":97542,"_5":16788,"_22829":97387,"_2311":97543},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2783":57398,"_24069":57329,"_16893":97545,"_5":16788,"_22829":97387,"_2311":97546},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2783":57399,"_24069":57329,"_16893":97548,"_5":16788,"_22829":97387,"_2311":97549},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2783":57400,"_24069":57329,"_16893":97551,"_5":16788,"_22829":97391,"_2311":97552},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2783":57401,"_24069":57329,"_16893":97554,"_5":16788,"_22829":97395,"_2311":97555},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2783":57402,"_24069":57329,"_16893":97557,"_5":16788,"_22829":97399,"_2311":97558},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2783":57403,"_24069":57329,"_16893":97560,"_5":16788,"_22829":97403,"_2311":97561},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2783":57404,"_24069":57329,"_16893":97563,"_5":16788,"_22829":97407,"_2311":97564},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2783":57405,"_24069":57329,"_16893":97566,"_5":16788,"_22829":97407,"_2311":97567},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2783":57406,"_24069":57406,"_5":11891,"_2311":97569,"_24405":97570,"_16893":97571,"_22829":57406},"Perfiles de certificado",[39337,93789,44140,97157],[],{"_2783":57407,"_24069":57406,"_16893":97573,"_5":16788,"_22829":57406,"_2311":97574},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2783":57408,"_24069":57406,"_5":24402,"_16893":97576,"_22829":97577,"_2311":97578},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2783":57409,"_24069":57406,"_5":24402,"_16893":97580,"_22829":97581,"_2311":97582},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#validez","Validez",{"_2783":57410,"_24069":57406,"_5":24402,"_16893":97584,"_22829":97585,"_2311":97586},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2783":57411,"_24069":57406,"_5":24402,"_16893":97588,"_22829":97589,"_2311":97590},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2783":57412,"_24069":57406,"_5":24402,"_16893":97592,"_22829":97593,"_2311":97594},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2783":57413,"_24069":57406,"_5":24402,"_16893":97596,"_22829":97597,"_2311":97598},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2783":57414,"_24069":57406,"_5":24402,"_16893":97600,"_22829":97601,"_2311":97602},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2783":57415,"_24069":57406,"_5":24402,"_16893":97604,"_22829":97605,"_2311":97606},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2783":57416,"_24069":57406,"_5":24402,"_16893":97608,"_22829":97609,"_2311":97610},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2783":57417,"_24069":57406,"_5":24402,"_16893":97612,"_22829":97613,"_2311":97614},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2783":57418,"_24069":57406,"_5":24402,"_16893":97616,"_22829":97617,"_2311":97618},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2783":57419,"_24069":57406,"_5":24402,"_16893":97620,"_22829":97621,"_2311":97622},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2783":57420,"_24069":57406,"_5":24402,"_16893":97624,"_22829":97625,"_2311":97626},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2783":57421,"_24069":57406,"_5":24402,"_16893":97628,"_22829":97629,"_2311":97630},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2783":57422,"_24069":57406,"_5":24402,"_16893":97632,"_22829":97633,"_2311":97634},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2783":57423,"_24069":57406,"_5":24402,"_16893":97636,"_22829":97637,"_2311":97638},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2783":57424,"_24069":57406,"_16893":97640,"_5":16788,"_22829":57406,"_2311":97641},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2783":57425,"_24069":57406,"_16893":97643,"_5":16788,"_22829":57406,"_2311":97644},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2783":57426,"_24069":57406,"_16893":97646,"_5":16788,"_22829":97581,"_2311":97647},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2783":57427,"_24069":57406,"_16893":97649,"_5":16788,"_22829":97581,"_2311":97650},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2783":57428,"_24069":57406,"_16893":97652,"_5":16788,"_22829":97585,"_2311":97653},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2783":57429,"_24069":57406,"_16893":97655,"_5":16788,"_22829":97589,"_2311":97656},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2783":57430,"_24069":57406,"_16893":97658,"_5":16788,"_22829":97589,"_2311":97659},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2783":57431,"_24069":57406,"_16893":97661,"_5":16788,"_22829":97589,"_2311":97662},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2783":57432,"_24069":57406,"_16893":97664,"_5":16788,"_22829":97593,"_2311":97665},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2783":57433,"_24069":57406,"_16893":97667,"_5":16788,"_22829":97597,"_2311":97668},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2783":57434,"_24069":57406,"_16893":97670,"_5":16788,"_22829":97597,"_2311":97671},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2783":57435,"_24069":57406,"_16893":97673,"_5":16788,"_22829":97601,"_2311":97674},[],"La aplicación criptográfica puede:",{"_2783":57436,"_24069":57406,"_16893":97676,"_5":16788,"_22829":97601,"_2311":97677},[],"permitir o bloquear claves RSA;",{"_2783":57437,"_24069":57406,"_16893":97679,"_5":16788,"_22829":97601,"_2311":97680},[],"limitar los tamaños RSA admitidos;",{"_2783":57438,"_24069":57406,"_16893":97682,"_5":16788,"_22829":97601,"_2311":97683},[],"permitir o bloquear claves ECDSA;",{"_2783":57439,"_24069":57406,"_16893":97685,"_5":16788,"_22829":97601,"_2311":97686},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2783":57440,"_24069":57406,"_16893":97688,"_5":16788,"_22829":97601,"_2311":97689},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2783":57441,"_24069":57406,"_16893":97691,"_5":16788,"_22829":97605,"_2311":97692},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2783":57442,"_24069":57406,"_16893":97694,"_5":16788,"_22829":97605,"_2311":93580},[],{"_2783":57443,"_24069":57406,"_16893":97696,"_5":16788,"_22829":97605,"_2311":97697},[],"Primera opción",{"_2783":57444,"_24069":57406,"_16893":97699,"_5":16788,"_22829":97605,"_2311":97700},[],"Segunda opción",{"_2783":57445,"_24069":57406,"_16893":97702,"_5":16788,"_22829":97605,"_2311":97703},[],"Si no hay ninguna",{"_2783":57446,"_24069":57406,"_16893":97705,"_5":16788,"_22829":97605,"_2311":97706},[],"Firma directa con una CA",{"_2783":57447,"_24069":57406,"_16893":97708,"_5":16788,"_22829":97605,"_2311":97709},[],"`issuance_profile` incluido en la solicitud",{"_2783":57448,"_24069":57406,"_16893":97711,"_5":16788,"_22829":97605,"_2311":97712},[],"`issuance_profile_id` de la solicitud",{"_2783":57449,"_24069":57406,"_16893":97714,"_5":16788,"_22829":97605,"_2311":97715},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2783":57450,"_24069":57406,"_16893":97717,"_5":16788,"_22829":97605,"_2311":97718},[],"Emisión mediante DMS",{"_2783":57451,"_24069":57406,"_16893":97720,"_5":16788,"_22829":97605,"_2311":44705},[],{"_2783":57452,"_24069":57406,"_16893":97722,"_5":16788,"_22829":97605,"_2311":97723},[],"`settings.issuance_profile` incluido en el DMS",{"_2783":57453,"_24069":57406,"_16893":97725,"_5":16788,"_22829":97605,"_2311":97726},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2783":57454,"_24069":57406,"_16893":97728,"_5":16788,"_22829":97605,"_2311":97729},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2783":57455,"_24069":57406,"_16893":97731,"_5":16788,"_22829":97605,"_2311":97732},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2783":57456,"_24069":57406,"_16893":97734,"_5":16788,"_22829":97613,"_2311":97735},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2783":57457,"_24069":57406,"_16893":97737,"_5":16788,"_22829":97617,"_2311":97738},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2783":57458,"_24069":57406,"_16893":97740,"_5":16788,"_22829":97621,"_2311":97741},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2783":57459,"_24069":57406,"_16893":97743,"_5":16788,"_22829":97625,"_2311":97744},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2783":57460,"_24069":57406,"_16893":97746,"_5":16788,"_22829":97629,"_2311":97747},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2783":57461,"_24069":57406,"_16893":97749,"_5":16788,"_22829":97629,"_2311":97750},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2783":57462,"_24069":57406,"_16893":97752,"_5":16788,"_22829":97633,"_2311":97753},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2783":57463,"_24069":57406,"_16893":97755,"_5":16788,"_22829":97633,"_2311":97756},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2783":57464,"_24069":57406,"_16893":97758,"_5":16788,"_22829":97633,"_2311":97759},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2783":57465,"_24069":57406,"_16893":97761,"_5":16788,"_22829":97633,"_2311":97762},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2783":57466,"_24069":57406,"_16893":97764,"_5":16788,"_22829":97637,"_2311":97765},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2783":57467,"_24069":57406,"_16893":97767,"_5":16788,"_22829":97637,"_2311":97768},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2783":57468,"_24069":57468,"_5":11891,"_2311":97770,"_24405":97771,"_16893":97773,"_22829":57468},"Validación de certificados",[39337,93789,44140,97772],"Validación",[],{"_2783":57469,"_24069":57468,"_16893":97775,"_5":16788,"_22829":57468,"_2311":97776},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2783":57470,"_24069":57468,"_5":24402,"_16893":97778,"_22829":97779,"_2311":97780},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2783":57471,"_24069":57468,"_5":24402,"_16893":97782,"_22829":97783,"_2311":97784},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2783":57472,"_24069":57468,"_5":24402,"_16893":97786,"_22829":97787,"_2311":97788},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2783":57473,"_24069":57468,"_16893":97790,"_5":16788,"_22829":57468,"_2311":97791},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2783":57474,"_24069":57468,"_16893":97793,"_5":16788,"_22829":97779,"_2311":97794},[],"Verifica estos criterios juntos:",{"_2783":57475,"_24069":57468,"_16893":97796,"_5":16788,"_22829":97779,"_2311":96784},[],{"_2783":57476,"_24069":57468,"_16893":97798,"_5":16788,"_22829":97779,"_2311":97799},[],"Resultado necesario",{"_2783":57477,"_24069":57468,"_16893":97801,"_5":16788,"_22829":97779,"_2311":97802},[],"Cadena y firma",{"_2783":57478,"_24069":57468,"_16893":97804,"_5":16788,"_22829":97779,"_2311":97805},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2783":57479,"_24069":57468,"_16893":97807,"_5":16788,"_22829":97779,"_2311":97808},[],"Fechas",{"_2783":57480,"_24069":57468,"_16893":97810,"_5":16788,"_22829":97779,"_2311":97811},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2783":57481,"_24069":57468,"_16893":97813,"_5":16788,"_22829":97779,"_2311":93493},[],{"_2783":57482,"_24069":57468,"_16893":97815,"_5":16788,"_22829":97779,"_2311":97816},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2783":57483,"_24069":57468,"_16893":97818,"_5":16788,"_22829":97779,"_2311":97819},[],"Uso",{"_2783":57484,"_24069":57468,"_16893":97821,"_5":16788,"_22829":97779,"_2311":97822},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2783":57485,"_24069":57468,"_16893":97824,"_5":16788,"_22829":97779,"_2311":97825},[],"Revocación",{"_2783":57486,"_24069":57468,"_16893":97827,"_5":16788,"_22829":97779,"_2311":97828},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2783":57487,"_24069":57468,"_16893":97830,"_5":16788,"_22829":97779,"_2311":97831},[],"Autorización",{"_2783":57488,"_24069":57468,"_16893":97833,"_5":16788,"_22829":97779,"_2311":97834},[],"La aplicación permite la acción a esa identidad.",{"_2783":57489,"_24069":57468,"_16893":97836,"_5":16788,"_22829":97779,"_2311":97837},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2783":57490,"_24069":57468,"_16893":97839,"_5":16788,"_22829":97783,"_2311":97840},[],"Mecanismo",{"_2783":57491,"_24069":57468,"_16893":97842,"_5":16788,"_22829":97783,"_2311":97843},[],"Cuándo utilizarlo",{"_2783":57492,"_24069":57468,"_16893":97845,"_5":16788,"_22829":97783,"_2311":97846},[],"Qué debes mantener",{"_2783":57493,"_24069":57468,"_16893":97848,"_5":16788,"_22829":97783,"_2311":44833},[],{"_2783":57494,"_24069":57468,"_16893":97850,"_5":16788,"_22829":97783,"_2311":97851},[],"Consulta del estado de un certificado concreto.",{"_2783":57495,"_24069":57468,"_16893":97853,"_5":16788,"_22829":97783,"_2311":97854},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2783":57496,"_24069":57468,"_16893":97856,"_5":16788,"_22829":97783,"_2311":44842},[],{"_2783":57497,"_24069":57468,"_16893":97858,"_5":16788,"_22829":97783,"_2311":97859},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2783":57498,"_24069":57468,"_16893":97861,"_5":16788,"_22829":97783,"_2311":97862},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2783":57499,"_24069":57468,"_16893":97864,"_5":16788,"_22829":97783,"_2311":97865},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2783":57500,"_24069":57468,"_16893":97867,"_5":16788,"_22829":97783,"_2311":97868},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2783":57501,"_24069":57468,"_16893":97870,"_5":16788,"_22829":97787,"_2311":97871},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2783":57502,"_24069":57468,"_16893":97873,"_5":16788,"_22829":97787,"_2311":97874},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2783":57503,"_24069":57468,"_16893":97876,"_5":16788,"_22829":97787,"_2311":97877},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2783":57504,"_24069":57468,"_16893":97879,"_5":16788,"_22829":97787,"_2311":97880},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2783":57505,"_24069":57468,"_16893":97882,"_5":16788,"_22829":97787,"_2311":97883},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2783":57506,"_24069":57468,"_16893":97885,"_5":16788,"_22829":97787,"_2311":97886},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2783":57507,"_24069":57468,"_16893":97888,"_5":16788,"_22829":97787,"_2311":97889},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2783":57508,"_24069":57468,"_16893":97891,"_5":16788,"_22829":97787,"_2311":97892},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2783":57509,"_24069":57468,"_16893":97894,"_5":16788,"_22829":97787,"_2311":97895},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2783":57510,"_24069":57510,"_5":11891,"_2311":97897,"_24405":97898,"_16893":97899,"_22829":57510},"Certificados",[39337,93789,44140,97157],[],{"_2783":57511,"_24069":57510,"_16893":97901,"_5":16788,"_22829":57510,"_2311":97902},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2783":57512,"_24069":57510,"_5":24402,"_16893":97904,"_22829":97905,"_2311":97906},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2783":57513,"_24069":57510,"_5":24402,"_16893":97908,"_22829":97909,"_2311":97910},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2783":57514,"_24069":57510,"_5":24402,"_16893":97912,"_22829":97913,"_2311":97914},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2783":57515,"_24069":57510,"_5":24402,"_16893":97916,"_22829":97917,"_2311":97918},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2783":57516,"_24069":57510,"_5":24402,"_16893":97920,"_22829":97921,"_2311":97922},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2783":57517,"_24069":57510,"_5":24402,"_16893":97924,"_22829":97925,"_2311":97926},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2783":57518,"_24069":57510,"_5":24402,"_16893":97928,"_22829":97929,"_2311":97930},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2783":57519,"_24069":57510,"_5":24402,"_16893":97932,"_22829":97933,"_2311":97934},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2783":57520,"_24069":57510,"_5":24402,"_16893":97936,"_22829":97937,"_2311":97938},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#continúa","Continúa",{"_2783":57521,"_24069":57510,"_16893":97940,"_5":16788,"_22829":57510,"_2311":97941},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2783":57522,"_24069":57510,"_16893":97943,"_5":16788,"_22829":97905,"_2311":97944},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2783":57523,"_24069":57510,"_16893":97946,"_5":16788,"_22829":97905,"_2311":97947},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2783":57524,"_24069":57510,"_16893":97949,"_5":16788,"_22829":97909,"_2311":97950},[],"Descarga el PEM e inspecciónalo:",{"_2783":57525,"_24069":57510,"_16893":97952,"_5":16788,"_22829":97909,"_2311":97953},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2783":57526,"_24069":57510,"_16893":97955,"_5":16788,"_22829":97913,"_2311":97956},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2783":57527,"_24069":57510,"_16893":97958,"_5":16788,"_22829":97913,"_2311":97959},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2783":57528,"_24069":57510,"_16893":97961,"_5":16788,"_22829":97913,"_2311":97962},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2783":57529,"_24069":57510,"_16893":97964,"_5":16788,"_22829":97913,"_2311":97965},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2783":57530,"_24069":57510,"_16893":97967,"_5":16788,"_22829":97913,"_2311":97968},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2783":57531,"_24069":57510,"_16893":97970,"_5":16788,"_22829":97913,"_2311":97971},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2783":57532,"_24069":57510,"_16893":97973,"_5":16788,"_22829":97913,"_2311":97974},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2783":57533,"_24069":57510,"_16893":97976,"_5":16788,"_22829":97917,"_2311":97977},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2783":57534,"_24069":57510,"_16893":97979,"_5":16788,"_22829":97921,"_2311":97980},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2783":57535,"_24069":57510,"_16893":97982,"_5":16788,"_22829":97925,"_2311":97983},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2783":57536,"_24069":57510,"_16893":97985,"_5":16788,"_22829":97929,"_2311":97986},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2783":57537,"_24069":57510,"_16893":97988,"_5":16788,"_22829":97929,"_2311":97989},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2783":57538,"_24069":57510,"_16893":97991,"_5":16788,"_22829":97929,"_2311":97992},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2783":57539,"_24069":57510,"_16893":97994,"_5":16788,"_22829":97933,"_2311":97995},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2783":57540,"_24069":57510,"_16893":97997,"_5":16788,"_22829":97933,"_2311":97998},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2783":57541,"_24069":57510,"_16893":98000,"_5":16788,"_22829":97933,"_2311":98001},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2783":57542,"_24069":57510,"_16893":98003,"_5":16788,"_22829":97937,"_2311":98004},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2783":57543,"_24069":57510,"_16893":98006,"_5":16788,"_22829":97937,"_2311":98007},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2783":57544,"_24069":57544,"_5":11891,"_2311":98009,"_24405":98010,"_16893":98012,"_22829":57544},"Ciclo de vida de un certificado",[39337,93789,44140,98011],"Conceptos",[],{"_2783":57545,"_24069":57544,"_16893":98014,"_5":16788,"_22829":57544,"_2311":98015},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2783":57546,"_24069":57544,"_5":24402,"_16893":98017,"_22829":98018,"_2311":98019},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2783":57547,"_24069":57544,"_5":24402,"_16893":98021,"_22829":98022,"_2311":98023},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2783":57548,"_24069":57544,"_5":24402,"_16893":98025,"_22829":98026,"_2311":98027},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2783":57549,"_24069":57544,"_5":24402,"_16893":98029,"_22829":98030,"_2311":98031},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2783":57550,"_24069":57544,"_5":24402,"_16893":98033,"_22829":98034,"_2311":98035},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2783":57551,"_24069":57544,"_5":24402,"_16893":98037,"_22829":98038,"_2311":98039},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2783":57552,"_24069":57544,"_5":24402,"_16893":98041,"_22829":98042,"_2311":98043},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2783":57553,"_24069":57544,"_5":24402,"_16893":98045,"_22829":98046,"_2311":98047},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2783":57554,"_24069":57544,"_5":24402,"_16893":98049,"_22829":98050,"_2311":98051},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2783":57555,"_24069":57544,"_5":24402,"_16893":98053,"_22829":98054,"_2311":98055},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2783":57556,"_24069":57544,"_16893":98057,"_5":16788,"_22829":57544,"_2311":98058},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2783":57557,"_24069":57544,"_16893":98060,"_5":16788,"_22829":98022,"_2311":98061},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2783":57558,"_24069":57544,"_16893":98063,"_5":16788,"_22829":98026,"_2311":98064},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2783":57559,"_24069":57544,"_16893":98066,"_5":16788,"_22829":98030,"_2311":98067},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2783":57560,"_24069":57544,"_16893":98069,"_5":16788,"_22829":98034,"_2311":98070},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2783":57561,"_24069":57544,"_16893":98072,"_5":16788,"_22829":98038,"_2311":98073},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2783":57562,"_24069":57544,"_16893":98075,"_5":16788,"_22829":98042,"_2311":98076},[],"Lamassu persiste cuatro estados X.509:",{"_2783":57563,"_24069":57544,"_16893":98078,"_5":16788,"_22829":98042,"_2311":98079},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2783":57564,"_24069":57544,"_16893":98081,"_5":16788,"_22829":98042,"_2311":98082},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2783":57565,"_24069":57544,"_16893":98084,"_5":16788,"_22829":98042,"_2311":98085},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2783":57566,"_24069":57544,"_16893":98087,"_5":16788,"_22829":98042,"_2311":98088},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2783":57567,"_24069":57544,"_16893":98090,"_5":16788,"_22829":98042,"_2311":98091},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2783":57568,"_24069":57544,"_16893":98093,"_5":16788,"_22829":98046,"_2311":98094},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2783":57569,"_24069":57544,"_16893":98096,"_5":16788,"_22829":98046,"_2311":98097},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2783":57570,"_24069":57544,"_16893":98099,"_5":16788,"_22829":98046,"_2311":98100},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2783":57571,"_24069":57544,"_16893":98102,"_5":16788,"_22829":98050,"_2311":98103},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2783":57572,"_24069":57544,"_16893":98105,"_5":16788,"_22829":98050,"_2311":98106},[],"Antes de confirmar:",{"_2783":57573,"_24069":57544,"_16893":98108,"_5":16788,"_22829":98050,"_2311":98109},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2783":57574,"_24069":57544,"_16893":98111,"_5":16788,"_22829":98050,"_2311":98112},[],"Distribuye la nueva cadena de confianza.",{"_2783":57575,"_24069":57544,"_16893":98114,"_5":16788,"_22829":98050,"_2311":98115},[],"Reemite las identidades necesarias.",{"_2783":57576,"_24069":57544,"_16893":98117,"_5":16788,"_22829":98050,"_2311":98118},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2783":57577,"_24069":57544,"_16893":98120,"_5":16788,"_22829":98050,"_2311":98121},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2783":57578,"_24069":57544,"_16893":98123,"_5":16788,"_22829":98050,"_2311":98124},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2783":57579,"_24069":57544,"_16893":98126,"_5":16788,"_22829":98054,"_2311":98127},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2783":57580,"_24069":57544,"_16893":98129,"_5":16788,"_22829":98054,"_2311":98130},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2783":57581,"_24069":57544,"_16893":98132,"_5":16788,"_22829":98054,"_2311":98133},[],"Cambios de estado y razones de revocación.",{"_2783":57582,"_24069":57544,"_16893":98135,"_5":16788,"_22829":98054,"_2311":98136},[],"Publicación y vigencia de OCSP y CRLs.",{"_2783":57583,"_24069":57544,"_16893":98138,"_5":16788,"_22829":98054,"_2311":98139},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2783":57584,"_24069":57544,"_16893":98141,"_5":16788,"_22829":98054,"_2311":98142},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2783":57585,"_24069":57585,"_5":11891,"_2311":98144,"_24405":98145,"_16893":98146,"_22829":57585},"Modelo de confianza",[39337,93789,44140,98011],[],{"_2783":57586,"_24069":57585,"_16893":98148,"_5":16788,"_22829":57585,"_2311":98149},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2783":57587,"_24069":57585,"_5":24402,"_16893":98151,"_22829":98152,"_2311":98153},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2783":57588,"_24069":57585,"_5":24402,"_16893":98155,"_22829":98156,"_2311":98157},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2783":57589,"_24069":57585,"_5":24402,"_16893":98159,"_22829":98160,"_2311":98161},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2783":57590,"_24069":57585,"_5":24402,"_16893":98163,"_22829":98164,"_2311":98165},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2783":57591,"_24069":57585,"_5":24402,"_16893":98167,"_22829":98168,"_2311":98169},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2783":57592,"_24069":57585,"_5":24402,"_16893":98171,"_22829":98172,"_2311":98173},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2783":57593,"_24069":57585,"_5":24402,"_16893":98175,"_22829":98176,"_2311":98177},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2783":57594,"_24069":57585,"_5":24402,"_16893":98179,"_22829":98180,"_2311":98181},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2783":57595,"_24069":57585,"_5":24402,"_16893":98183,"_22829":98184,"_2311":98185},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2783":57596,"_24069":57585,"_5":24402,"_16893":98187,"_22829":98188,"_2311":98189},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2783":57597,"_24069":57585,"_16893":98191,"_5":16788,"_22829":57585,"_2311":98192},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2783":57598,"_24069":57585,"_16893":98194,"_5":16788,"_22829":98156,"_2311":98195},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2783":57599,"_24069":57585,"_16893":98197,"_5":16788,"_22829":98160,"_2311":98198},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2783":57600,"_24069":57585,"_16893":98200,"_5":16788,"_22829":98164,"_2311":98201},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2783":57601,"_24069":57585,"_16893":98203,"_5":16788,"_22829":98168,"_2311":98204},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2783":57602,"_24069":57585,"_16893":98206,"_5":16788,"_22829":98172,"_2311":98207},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2783":57603,"_24069":57585,"_16893":98209,"_5":16788,"_22829":98172,"_2311":98210},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2783":57604,"_24069":57585,"_16893":98212,"_5":16788,"_22829":98172,"_2311":98213},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2783":57605,"_24069":57585,"_16893":98215,"_5":16788,"_22829":98172,"_2311":98216},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2783":57606,"_24069":57585,"_16893":98218,"_5":16788,"_22829":98172,"_2311":98219},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2783":57607,"_24069":57585,"_16893":98221,"_5":16788,"_22829":98172,"_2311":98222},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2783":57608,"_24069":57585,"_16893":98224,"_5":16788,"_22829":98176,"_2311":98225},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2783":57609,"_24069":57585,"_16893":98227,"_5":16788,"_22829":98176,"_2311":98228},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2783":57610,"_24069":57585,"_16893":98230,"_5":16788,"_22829":98176,"_2311":98231},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2783":57611,"_24069":57585,"_16893":98233,"_5":16788,"_22829":98176,"_2311":98234},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2783":57612,"_24069":57585,"_16893":98236,"_5":16788,"_22829":98176,"_2311":98237},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2783":57613,"_24069":57585,"_16893":98239,"_5":16788,"_22829":98180,"_2311":98240},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2783":57614,"_24069":57585,"_16893":98242,"_5":16788,"_22829":98180,"_2311":98243},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2783":57615,"_24069":57585,"_16893":98245,"_5":16788,"_22829":98180,"_2311":98246},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2783":57616,"_24069":57585,"_16893":98248,"_5":16788,"_22829":98180,"_2311":98249},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2783":57617,"_24069":57585,"_16893":98251,"_5":16788,"_22829":98180,"_2311":98252},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2783":57618,"_24069":57585,"_16893":98254,"_5":16788,"_22829":98180,"_2311":98255},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2783":57619,"_24069":57585,"_16893":98257,"_5":16788,"_22829":98180,"_2311":98258},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2783":57620,"_24069":57585,"_16893":98260,"_5":16788,"_22829":98184,"_2311":98261},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2783":57621,"_24069":57585,"_16893":98263,"_5":16788,"_22829":98188,"_2311":98264},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2783":57622,"_24069":57585,"_16893":98266,"_5":16788,"_22829":98188,"_2311":98267},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2783":57623,"_24069":57585,"_16893":98269,"_5":16788,"_22829":98188,"_2311":98270},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2783":57624,"_24069":57585,"_16893":98272,"_5":16788,"_22829":98188,"_2311":98273},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2783":57625,"_24069":57585,"_16893":98275,"_5":16788,"_22829":98188,"_2311":98276},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2783":57626,"_24069":57585,"_16893":98278,"_5":16788,"_22829":98188,"_2311":98279},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2783":57627,"_24069":57585,"_16893":98281,"_5":16788,"_22829":98188,"_2311":98282},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2783":57628,"_24069":57628,"_5":11891,"_2311":98284,"_24405":98285,"_16893":98286,"_22829":57628},"Listas de revocación (CRL)",[39337,93789,44140,97772],[],{"_2783":57629,"_24069":57628,"_16893":98288,"_5":16788,"_22829":57628,"_2311":98289},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2783":57630,"_24069":57628,"_5":24402,"_16893":98291,"_22829":98292,"_2311":98293},[],"/docs/pr-preview/pr-27/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2783":57631,"_24069":57628,"_5":24402,"_16893":98295,"_22829":98296,"_2311":98297},[],"/docs/pr-preview/pr-27/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2783":57632,"_24069":57628,"_5":24402,"_16893":98299,"_22829":98300,"_2311":98301},[],"/docs/pr-preview/pr-27/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2783":57633,"_24069":57628,"_5":24402,"_16893":98303,"_22829":98304,"_2311":98305},[],"/docs/pr-preview/pr-27/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2783":57634,"_24069":57628,"_5":24402,"_16893":98307,"_22829":98308,"_2311":98309},[],"/docs/pr-preview/pr-27/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2783":57635,"_24069":57628,"_5":24402,"_16893":98311,"_22829":98312,"_2311":98313},[],"/docs/pr-preview/pr-27/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2783":57636,"_24069":57628,"_5":24402,"_16893":98315,"_22829":98316,"_2311":98317},[],"/docs/pr-preview/pr-27/es/platform/pki/crl#referencias","Referencias",{"_2783":57637,"_24069":57628,"_16893":98319,"_5":16788,"_22829":57628,"_2311":98320},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2783":57638,"_24069":57628,"_16893":98322,"_5":16788,"_22829":98292,"_2311":98323},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2783":57639,"_24069":57628,"_16893":98325,"_5":16788,"_22829":98292,"_2311":98326},[],"Campo de `crl_options`",{"_2783":57640,"_24069":57628,"_16893":98328,"_5":16788,"_22829":98292,"_2311":95102},[],{"_2783":57641,"_24069":57628,"_16893":98330,"_5":16788,"_22829":98292,"_2311":98331},[],"Valor inicial del backend",{"_2783":57642,"_24069":57628,"_16893":98333,"_5":16788,"_22829":98292,"_2311":45320},[],{"_2783":57643,"_24069":57628,"_16893":98335,"_5":16788,"_22829":98292,"_2311":98336},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2783":57644,"_24069":57628,"_16893":98338,"_5":16788,"_22829":98292,"_2311":98339},[],"7 días.",{"_2783":57645,"_24069":57628,"_16893":98341,"_5":16788,"_22829":98292,"_2311":45329},[],{"_2783":57646,"_24069":57628,"_16893":98343,"_5":16788,"_22829":98292,"_2311":98344},[],"Plazo desde la publicación que activa la renovación programada.",{"_2783":57647,"_24069":57628,"_16893":98346,"_5":16788,"_22829":98292,"_2311":98347},[],"6 días y 23 horas.",{"_2783":57648,"_24069":57628,"_16893":98349,"_5":16788,"_22829":98292,"_2311":45338},[],{"_2783":57649,"_24069":57628,"_16893":98351,"_5":16788,"_22829":98292,"_2311":98352},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2783":57650,"_24069":57628,"_16893":98354,"_5":16788,"_22829":98292,"_2311":45344},[],{"_2783":57651,"_24069":57628,"_16893":98356,"_5":16788,"_22829":98292,"_2311":45347},[],{"_2783":57652,"_24069":57628,"_16893":98358,"_5":16788,"_22829":98292,"_2311":98359},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2783":57653,"_24069":57628,"_16893":98361,"_5":16788,"_22829":98292,"_2311":98362},[],"SKI de la CA.",{"_2783":57654,"_24069":57628,"_16893":98364,"_5":16788,"_22829":98292,"_2311":98365},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2783":57655,"_24069":57628,"_16893":98367,"_5":16788,"_22829":98292,"_2311":98368},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2783":57656,"_24069":57628,"_16893":98370,"_5":16788,"_22829":98296,"_2311":98371},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2783":57657,"_24069":57628,"_16893":98373,"_5":16788,"_22829":98296,"_2311":98374},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2783":57658,"_24069":57628,"_16893":98376,"_5":16788,"_22829":98296,"_2311":98377},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2783":57659,"_24069":57628,"_16893":98379,"_5":16788,"_22829":98300,"_2311":98380},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2783":57660,"_24069":57628,"_16893":98382,"_5":16788,"_22829":98300,"_2311":98383},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2783":57661,"_24069":57628,"_16893":98385,"_5":16788,"_22829":98304,"_2311":98386},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2783":57662,"_24069":57628,"_16893":98388,"_5":16788,"_22829":98304,"_2311":98389},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2783":57663,"_24069":57628,"_16893":98391,"_5":16788,"_22829":98304,"_2311":98392},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2783":57664,"_24069":57628,"_16893":98394,"_5":16788,"_22829":98304,"_2311":98395},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2783":57665,"_24069":57628,"_16893":98397,"_5":16788,"_22829":98304,"_2311":98398},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2783":57666,"_24069":57628,"_16893":98400,"_5":16788,"_22829":98308,"_2311":98401},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2783":57667,"_24069":57628,"_16893":98403,"_5":16788,"_22829":98308,"_2311":95291},[],{"_2783":57668,"_24069":57628,"_16893":98405,"_5":16788,"_22829":98308,"_2311":98406},[],"Path relativo",{"_2783":57669,"_24069":57628,"_16893":98408,"_5":16788,"_22829":98308,"_2311":93580},[],{"_2783":57670,"_24069":57628,"_16893":98410,"_5":16788,"_22829":98308,"_2311":45402},[],{"_2783":57671,"_24069":57628,"_16893":98412,"_5":16788,"_22829":98308,"_2311":45405},[],{"_2783":57672,"_24069":57628,"_16893":98414,"_5":16788,"_22829":98308,"_2311":98415},[],"Consultar `crl_options` y `latest_crl`.",{"_2783":57673,"_24069":57628,"_16893":98417,"_5":16788,"_22829":98308,"_2311":45411},[],{"_2783":57674,"_24069":57628,"_16893":98419,"_5":16788,"_22829":98308,"_2311":45405},[],{"_2783":57675,"_24069":57628,"_16893":98421,"_5":16788,"_22829":98308,"_2311":98422},[],"Sustituir la configuración de CRL.",{"_2783":57676,"_24069":57628,"_16893":98424,"_5":16788,"_22829":98308,"_2311":98425},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2783":57677,"_24069":57628,"_16893":98427,"_5":16788,"_22829":98308,"_2311":98428},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2783":57678,"_24069":57628,"_16893":98430,"_5":16788,"_22829":98312,"_2311":98431},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2783":57679,"_24069":57628,"_16893":98433,"_5":16788,"_22829":98316,"_2311":98434},[],"RFC 5280: perfil X.509 y CRL.",{"_2783":57680,"_24069":57628,"_16893":98436,"_5":16788,"_22829":98316,"_2311":45431},[],{"_2783":57681,"_24069":57628,"_16893":98438,"_5":16788,"_22829":98316,"_2311":45434},[],{"_2783":57682,"_24069":57628,"_16893":98440,"_5":16788,"_22829":98316,"_2311":98441},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2783":57683,"_24069":57628,"_16893":98443,"_5":16788,"_22829":98316,"_2311":98444},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2783":57684,"_24069":57684,"_5":11891,"_2311":98446,"_24405":98447,"_16893":98448,"_22829":57684},"Claves y motores criptográficos",[39337,93789,44140,97157],[],{"_2783":57685,"_24069":57684,"_16893":98450,"_5":16788,"_22829":57684,"_2311":98451},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2783":57686,"_24069":57684,"_5":24402,"_16893":98453,"_22829":98454,"_2311":98455},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2783":57687,"_24069":57684,"_5":24402,"_16893":98457,"_22829":98458,"_2311":98459},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2783":57688,"_24069":57684,"_5":24402,"_16893":98461,"_22829":98462,"_2311":45459},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#file-system",{"_2783":57689,"_24069":57684,"_5":24402,"_16893":98464,"_22829":98465,"_2311":45463},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#hashicorp-vault",{"_2783":57690,"_24069":57684,"_5":24402,"_16893":98467,"_22829":98468,"_2311":45467},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#aws-secrets-manager",{"_2783":57691,"_24069":57684,"_5":24402,"_16893":98470,"_22829":98471,"_2311":45471},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#aws-kms",{"_2783":57692,"_24069":57684,"_5":24402,"_16893":98473,"_22829":98474,"_2311":45475},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#pkcs11",{"_2783":57693,"_24069":57684,"_5":24402,"_16893":98476,"_22829":98477,"_2311":45479},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#azure-key-vault",{"_2783":57694,"_24069":57684,"_5":24402,"_16893":98479,"_22829":98480,"_2311":98481},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2783":57695,"_24069":57684,"_5":24402,"_16893":98483,"_22829":98484,"_2311":98485},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2783":57696,"_24069":57684,"_5":24402,"_16893":98487,"_22829":98488,"_2311":98489},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2783":57697,"_24069":57684,"_5":24402,"_16893":98491,"_22829":98492,"_2311":98493},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2783":57698,"_24069":57684,"_5":24402,"_16893":98495,"_22829":98496,"_2311":98497},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2783":57699,"_24069":57684,"_5":24402,"_16893":98499,"_22829":98500,"_2311":98501},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2783":57700,"_24069":57684,"_5":24402,"_16893":98503,"_22829":98504,"_2311":98505},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2783":57701,"_24069":57684,"_5":24402,"_16893":98507,"_22829":98508,"_2311":45511},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#sign",{"_2783":57702,"_24069":57684,"_5":24402,"_16893":98510,"_22829":98511,"_2311":45515},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#verify",{"_2783":57703,"_24069":57684,"_5":24402,"_16893":98513,"_22829":98514,"_2311":98515},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2783":57704,"_24069":57684,"_5":24402,"_16893":98517,"_22829":98518,"_2311":98519},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2783":57705,"_24069":57684,"_5":24402,"_16893":98521,"_22829":98522,"_2311":98523},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2783":57706,"_24069":57684,"_16893":98525,"_5":16788,"_22829":57684,"_2311":98526},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2783":57707,"_24069":57684,"_16893":98528,"_5":16788,"_22829":57684,"_2311":98529},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2783":57708,"_24069":57684,"_16893":98531,"_5":16788,"_22829":98454,"_2311":98532},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2783":57709,"_24069":57684,"_16893":98534,"_5":16788,"_22829":98454,"_2311":98535},[],"En la práctica, permite:",{"_2783":57710,"_24069":57684,"_16893":98537,"_5":16788,"_22829":98454,"_2311":98538},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2783":57711,"_24069":57684,"_16893":98540,"_5":16788,"_22829":98454,"_2311":98541},[],"Importar claves creadas externamente.",{"_2783":57712,"_24069":57684,"_16893":98543,"_5":16788,"_22829":98454,"_2311":98544},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2783":57713,"_24069":57684,"_16893":98546,"_5":16788,"_22829":98454,"_2311":98547},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2783":57714,"_24069":57684,"_16893":98549,"_5":16788,"_22829":98458,"_2311":98550},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2783":57715,"_24069":57684,"_16893":98552,"_5":16788,"_22829":98458,"_2311":98553},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2783":57716,"_24069":57684,"_16893":98555,"_5":16788,"_22829":98458,"_2311":98556},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2783":57717,"_24069":57684,"_16893":98558,"_5":16788,"_22829":98462,"_2311":98559},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2783":57718,"_24069":57684,"_16893":98561,"_5":16788,"_22829":98465,"_2311":98562},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2783":57719,"_24069":57684,"_16893":98564,"_5":16788,"_22829":98468,"_2311":98565},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2783":57720,"_24069":57684,"_16893":98567,"_5":16788,"_22829":98471,"_2311":98568},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2783":57721,"_24069":57684,"_16893":98570,"_5":16788,"_22829":98474,"_2311":98571},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2783":57722,"_24069":57684,"_16893":98573,"_5":16788,"_22829":98477,"_2311":98574},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2783":57723,"_24069":57684,"_16893":98576,"_5":16788,"_22829":98477,"_2311":98577},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2783":57724,"_24069":57684,"_16893":98579,"_5":16788,"_22829":98477,"_2311":98580},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2783":57725,"_24069":57684,"_16893":98582,"_5":16788,"_22829":98477,"_2311":98583},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2783":57726,"_24069":57684,"_16893":98585,"_5":16788,"_22829":98480,"_2311":98586},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2783":57727,"_24069":57684,"_16893":98588,"_5":16788,"_22829":98480,"_2311":98589},[],"La tabla incluye los siguientes campos:",{"_2783":57728,"_24069":57684,"_16893":98591,"_5":16788,"_22829":98480,"_2311":98592},[],"**Name**: nombre descriptivo de la clave.",{"_2783":57729,"_24069":57684,"_16893":98594,"_5":16788,"_22829":98480,"_2311":98595},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2783":57730,"_24069":57684,"_16893":98597,"_5":16788,"_22829":98480,"_2311":98598},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2783":57731,"_24069":57684,"_16893":98600,"_5":16788,"_22829":98480,"_2311":98601},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2783":57732,"_24069":57684,"_16893":98603,"_5":16788,"_22829":98480,"_2311":98604},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2783":57733,"_24069":57684,"_16893":98606,"_5":16788,"_22829":98480,"_2311":98607},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2783":57734,"_24069":57684,"_16893":98609,"_5":16788,"_22829":98480,"_2311":98610},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2783":57735,"_24069":57684,"_16893":98612,"_5":16788,"_22829":98480,"_2311":98613},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2783":57736,"_24069":57684,"_16893":98615,"_5":16788,"_22829":98480,"_2311":98616},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2783":57737,"_24069":57684,"_16893":98618,"_5":16788,"_22829":98480,"_2311":98619},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2783":57738,"_24069":57684,"_16893":98621,"_5":16788,"_22829":98480,"_2311":98622},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2783":57739,"_24069":57684,"_16893":98624,"_5":16788,"_22829":98480,"_2311":98625},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2783":57740,"_24069":57684,"_16893":98627,"_5":16788,"_22829":98480,"_2311":98628},[],"**Delete Key** para eliminar la clave del sistema.",{"_2783":57741,"_24069":57684,"_16893":98630,"_5":16788,"_22829":98484,"_2311":98631},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2783":57742,"_24069":57684,"_16893":98633,"_5":16788,"_22829":98488,"_2311":98634},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2783":57743,"_24069":57684,"_16893":98636,"_5":16788,"_22829":98488,"_2311":98637},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2783":57744,"_24069":57684,"_16893":98639,"_5":16788,"_22829":98488,"_2311":98640},[],"**Key Name**: nombre único y descriptivo.",{"_2783":57745,"_24069":57684,"_16893":98642,"_5":16788,"_22829":98488,"_2311":98643},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2783":57746,"_24069":57684,"_16893":98645,"_5":16788,"_22829":98488,"_2311":98646},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2783":57747,"_24069":57684,"_16893":98648,"_5":16788,"_22829":98488,"_2311":98649},[],"**Tags**: metadatos para clasificar la clave.",{"_2783":57748,"_24069":57684,"_16893":98651,"_5":16788,"_22829":98488,"_2311":98652},[],"**Metadata**: información adicional para usos avanzados.",{"_2783":57749,"_24069":57684,"_16893":98654,"_5":16788,"_22829":98492,"_2311":98655},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2783":57750,"_24069":57684,"_16893":98657,"_5":16788,"_22829":98492,"_2311":98658},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2783":57751,"_24069":57684,"_16893":98660,"_5":16788,"_22829":98492,"_2311":98661},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2783":57752,"_24069":57684,"_16893":98663,"_5":16788,"_22829":98492,"_2311":98664},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2783":57753,"_24069":57684,"_16893":98666,"_5":16788,"_22829":98492,"_2311":98667},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2783":57754,"_24069":57684,"_16893":98669,"_5":16788,"_22829":98492,"_2311":98670},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2783":57755,"_24069":57684,"_16893":98672,"_5":16788,"_22829":98492,"_2311":98673},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2783":57756,"_24069":57684,"_16893":98675,"_5":16788,"_22829":98492,"_2311":98676},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2783":57757,"_24069":57684,"_16893":98678,"_5":16788,"_22829":98492,"_2311":98679},[],"**Metadata**: información adicional opcional.",{"_2783":57758,"_24069":57684,"_16893":98681,"_5":16788,"_22829":98492,"_2311":98682},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2783":57759,"_24069":57684,"_16893":98684,"_5":16788,"_22829":98492,"_2311":98685},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2783":57760,"_24069":57684,"_16893":98687,"_5":16788,"_22829":98496,"_2311":98688},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2783":57761,"_24069":57684,"_16893":98690,"_5":16788,"_22829":98500,"_2311":98691},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2783":57762,"_24069":57684,"_16893":98693,"_5":16788,"_22829":98500,"_2311":98694},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2783":57763,"_24069":57684,"_16893":98696,"_5":16788,"_22829":98500,"_2311":98697},[],"**Key Name**: nombre descriptivo.",{"_2783":57764,"_24069":57684,"_16893":98699,"_5":16788,"_22829":98500,"_2311":98700},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2783":57765,"_24069":57684,"_16893":98702,"_5":16788,"_22829":98500,"_2311":98703},[],"**Tags**: etiquetas asociadas.",{"_2783":57766,"_24069":57684,"_16893":98705,"_5":16788,"_22829":98500,"_2311":98706},[],"**Aliases**: nombres alternativos.",{"_2783":57767,"_24069":57684,"_16893":98708,"_5":16788,"_22829":98500,"_2311":98709},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2783":57768,"_24069":57684,"_16893":98711,"_5":16788,"_22829":98500,"_2311":98712},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2783":57769,"_24069":57684,"_16893":98714,"_5":16788,"_22829":98500,"_2311":98715},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2783":57770,"_24069":57684,"_16893":98717,"_5":16788,"_22829":98500,"_2311":98718},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2783":57771,"_24069":57684,"_16893":98720,"_5":16788,"_22829":98504,"_2311":98721},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2783":57772,"_24069":57684,"_16893":98723,"_5":16788,"_22829":98504,"_2311":98724},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2783":57773,"_24069":57684,"_16893":98726,"_5":16788,"_22829":98504,"_2311":98727},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2783":57774,"_24069":57684,"_16893":98729,"_5":16788,"_22829":98508,"_2311":98730},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2783":57775,"_24069":57684,"_16893":98732,"_5":16788,"_22829":98508,"_2311":98733},[],"Campos principales:",{"_2783":57776,"_24069":57684,"_16893":98735,"_5":16788,"_22829":98508,"_2311":98736},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2783":57777,"_24069":57684,"_16893":98738,"_5":16788,"_22829":98508,"_2311":98739},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2783":57778,"_24069":57684,"_16893":98741,"_5":16788,"_22829":98508,"_2311":98742},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2783":57779,"_24069":57684,"_16893":98744,"_5":16788,"_22829":98508,"_2311":98745},[],"**Message**: contenido que se va a firmar.",{"_2783":57780,"_24069":57684,"_16893":98747,"_5":16788,"_22829":98508,"_2311":98748},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2783":57781,"_24069":57684,"_16893":98750,"_5":16788,"_22829":98511,"_2311":98751},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2783":57782,"_24069":57684,"_16893":98753,"_5":16788,"_22829":98511,"_2311":98733},[],{"_2783":57783,"_24069":57684,"_16893":98755,"_5":16788,"_22829":98511,"_2311":98756},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2783":57784,"_24069":57684,"_16893":98758,"_5":16788,"_22829":98511,"_2311":98759},[],"**Message Type**: `Raw` o `Digest`.",{"_2783":57785,"_24069":57684,"_16893":98761,"_5":16788,"_22829":98511,"_2311":98762},[],"**Payload Encoding**: codificación del mensaje.",{"_2783":57786,"_24069":57684,"_16893":98764,"_5":16788,"_22829":98511,"_2311":98765},[],"**Message**: mensaje original o hash.",{"_2783":57787,"_24069":57684,"_16893":98767,"_5":16788,"_22829":98511,"_2311":98768},[],"**Signature**: firma que se desea comprobar.",{"_2783":57788,"_24069":57684,"_16893":98770,"_5":16788,"_22829":98511,"_2311":98771},[],"**Result**: indicador del resultado de la validación.",{"_2783":57789,"_24069":57684,"_16893":98773,"_5":16788,"_22829":98514,"_2311":98774},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2783":57790,"_24069":57684,"_16893":98776,"_5":16788,"_22829":98514,"_2311":98777},[],"Este flujo es útil para:",{"_2783":57791,"_24069":57684,"_16893":98779,"_5":16788,"_22829":98514,"_2311":98780},[],"Solicitar certificados a una CA externa.",{"_2783":57792,"_24069":57684,"_16893":98782,"_5":16788,"_22829":98514,"_2311":98783},[],"Renovar una identidad manteniendo la misma clave.",{"_2783":57793,"_24069":57684,"_16893":98785,"_5":16788,"_22829":98514,"_2311":98786},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2783":57794,"_24069":57684,"_16893":98788,"_5":16788,"_22829":98514,"_2311":98789},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2783":57795,"_24069":57684,"_16893":98791,"_5":16788,"_22829":98514,"_2311":98792},[],"**Organization (O)**: organización o empresa.",{"_2783":57796,"_24069":57684,"_16893":98794,"_5":16788,"_22829":98514,"_2311":98795},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2783":57797,"_24069":57684,"_16893":98797,"_5":16788,"_22829":98514,"_2311":98798},[],"**Country (C)**: código de país de dos letras.",{"_2783":57798,"_24069":57684,"_16893":98800,"_5":16788,"_22829":98514,"_2311":98801},[],"**State / Province (ST)**: estado o provincia.",{"_2783":57799,"_24069":57684,"_16893":98803,"_5":16788,"_22829":98514,"_2311":98804},[],"**Locality (L)**: ciudad o localidad.",{"_2783":57800,"_24069":57684,"_16893":98806,"_5":16788,"_22829":98514,"_2311":98807},[],"**Email Address**: correo de contacto.",{"_2783":57801,"_24069":57684,"_16893":98809,"_5":16788,"_22829":98514,"_2311":98810},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2783":57802,"_24069":57684,"_16893":98812,"_5":16788,"_22829":98514,"_2311":98813},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2783":57803,"_24069":57684,"_16893":98815,"_5":16788,"_22829":98518,"_2311":98816},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2783":57804,"_24069":57684,"_16893":98818,"_5":16788,"_22829":98518,"_2311":45823},[],{"_2783":57805,"_24069":57684,"_16893":98820,"_5":16788,"_22829":98522,"_2311":98821},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2783":57806,"_24069":57806,"_5":11891,"_2311":98823,"_24405":98824,"_16893":98825,"_22829":57806},"Validación online con OCSP",[39337,93789,44140,97772],[],{"_2783":57807,"_24069":57806,"_16893":98827,"_5":16788,"_22829":57806,"_2311":98828},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2783":57808,"_24069":57806,"_5":24402,"_16893":98830,"_22829":98831,"_2311":98832},[],"/docs/pr-preview/pr-27/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2783":57809,"_24069":57806,"_5":24402,"_16893":98834,"_22829":98835,"_2311":98836},[],"/docs/pr-preview/pr-27/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2783":57810,"_24069":57806,"_5":24402,"_16893":98838,"_22829":98839,"_2311":98840},[],"/docs/pr-preview/pr-27/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2783":57811,"_24069":57806,"_5":24402,"_16893":98842,"_22829":98843,"_2311":98844},[],"/docs/pr-preview/pr-27/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2783":57812,"_24069":57806,"_5":24402,"_16893":98846,"_22829":98847,"_2311":98848},[],"/docs/pr-preview/pr-27/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2783":57813,"_24069":57806,"_5":24402,"_16893":98850,"_22829":98851,"_2311":98317},[],"/docs/pr-preview/pr-27/es/platform/pki/ocsp#referencias",{"_2783":57814,"_24069":57806,"_16893":98853,"_5":16788,"_22829":57806,"_2311":98854},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2783":57815,"_24069":57806,"_16893":98856,"_5":16788,"_22829":98831,"_2311":98857},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2783":57816,"_24069":57806,"_16893":98859,"_5":16788,"_22829":98831,"_2311":98860},[],"Estado del registro",{"_2783":57817,"_24069":57806,"_16893":98862,"_5":16788,"_22829":98831,"_2311":98863},[],"Respuesta firmada",{"_2783":57818,"_24069":57806,"_16893":98865,"_5":16788,"_22829":98831,"_2311":43318},[],{"_2783":57819,"_24069":57806,"_16893":98867,"_5":16788,"_22829":98831,"_2311":45873},[],{"_2783":57820,"_24069":57806,"_16893":98869,"_5":16788,"_22829":98831,"_2311":43335},[],{"_2783":57821,"_24069":57806,"_16893":98871,"_5":16788,"_22829":98831,"_2311":98872},[],"`Revoked`, con razón y fecha de revocación.",{"_2783":57822,"_24069":57806,"_16893":98874,"_5":16788,"_22829":98831,"_2311":98875},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2783":57823,"_24069":57806,"_16893":98877,"_5":16788,"_22829":98831,"_2311":98878},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2783":57824,"_24069":57806,"_16893":98880,"_5":16788,"_22829":98831,"_2311":98881},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2783":57825,"_24069":57806,"_16893":98883,"_5":16788,"_22829":98831,"_2311":98884},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2783":57826,"_24069":57806,"_16893":98886,"_5":16788,"_22829":98831,"_2311":98887},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2783":57827,"_24069":57806,"_16893":98889,"_5":16788,"_22829":98835,"_2311":98890},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2783":57828,"_24069":57806,"_16893":98892,"_5":16788,"_22829":98835,"_2311":98893},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2783":57829,"_24069":57806,"_16893":98895,"_5":16788,"_22829":98839,"_2311":98896},[],"El servicio acepta:",{"_2783":57830,"_24069":57806,"_16893":98898,"_5":16788,"_22829":98839,"_2311":95291},[],{"_2783":57831,"_24069":57806,"_16893":98900,"_5":16788,"_22829":98839,"_2311":98901},[],"Ruta del servicio VA",{"_2783":57832,"_24069":57806,"_16893":98903,"_5":16788,"_22829":98839,"_2311":98904},[],"Formato",{"_2783":57833,"_24069":57806,"_16893":98906,"_5":16788,"_22829":98839,"_2311":45913},[],{"_2783":57834,"_24069":57806,"_16893":98908,"_5":16788,"_22829":98839,"_2311":45916},[],{"_2783":57835,"_24069":57806,"_16893":98910,"_5":16788,"_22829":98839,"_2311":98911},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2783":57836,"_24069":57806,"_16893":98913,"_5":16788,"_22829":98839,"_2311":45402},[],{"_2783":57837,"_24069":57806,"_16893":98915,"_5":16788,"_22829":98839,"_2311":45924},[],{"_2783":57838,"_24069":57806,"_16893":98917,"_5":16788,"_22829":98839,"_2311":98918},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2783":57839,"_24069":57806,"_16893":98920,"_5":16788,"_22829":98839,"_2311":98921},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2783":57840,"_24069":57806,"_16893":98923,"_5":16788,"_22829":98843,"_2311":98924},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2783":57841,"_24069":57806,"_16893":98926,"_5":16788,"_22829":98843,"_2311":98927},[],"Genera la solicitud:",{"_2783":57842,"_24069":57806,"_16893":98929,"_5":16788,"_22829":98843,"_2311":98930},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2783":57843,"_24069":57806,"_16893":98932,"_5":16788,"_22829":98843,"_2311":98933},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2783":57844,"_24069":57806,"_16893":98935,"_5":16788,"_22829":98843,"_2311":98936},[],"Verifica el DER recibido:",{"_2783":57845,"_24069":57806,"_16893":98938,"_5":16788,"_22829":98843,"_2311":98939},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2783":57846,"_24069":57806,"_16893":98941,"_5":16788,"_22829":98847,"_2311":98942},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2783":57847,"_24069":57806,"_16893":98944,"_5":16788,"_22829":98847,"_2311":98945},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2783":57848,"_24069":57806,"_16893":98947,"_5":16788,"_22829":98851,"_2311":45957},[],{"_2783":57849,"_24069":57806,"_16893":98949,"_5":16788,"_22829":98851,"_2311":45960},[],{"_2783":57850,"_24069":57806,"_16893":98951,"_5":16788,"_22829":98851,"_2311":98952},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2783":57851,"_24069":57806,"_16893":98954,"_5":16788,"_22829":98851,"_2311":98444},[],{"_2783":57852,"_24069":57852,"_5":11891,"_2311":44140,"_24405":98956,"_16893":98957,"_22829":57852},[39337,93789,44140],[],{"_2783":57853,"_24069":57852,"_16893":98959,"_5":16788,"_22829":57852,"_2311":98960},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2783":57854,"_24069":57852,"_5":24402,"_16893":98962,"_22829":98963,"_2311":96481},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#empieza-aquí",{"_2783":57855,"_24069":57852,"_5":24402,"_16893":98965,"_22829":98966,"_2311":98967},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2783":57856,"_24069":57852,"_5":24402,"_16893":98969,"_22829":98970,"_2311":97003},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#capacidades-principales",{"_2783":57857,"_24069":57852,"_5":24402,"_16893":98972,"_22829":98973,"_2311":97007},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2783":57858,"_24069":57852,"_5":24402,"_16893":98975,"_22829":98976,"_2311":97011},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2783":57859,"_24069":57852,"_5":24402,"_16893":98978,"_22829":98979,"_2311":97015},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#emite-y-controla-certificados",{"_2783":57860,"_24069":57852,"_5":24402,"_16893":98981,"_22829":98982,"_2311":97023},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#publica-el-estado-de-validación",{"_2783":57861,"_24069":57852,"_5":24402,"_16893":98984,"_22829":98985,"_2311":98986},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2783":57862,"_24069":57852,"_5":24402,"_16893":98988,"_22829":98989,"_2311":97938},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#continúa",{"_2783":57863,"_24069":57852,"_16893":98991,"_5":16788,"_22829":57852,"_2311":98992},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2783":57864,"_24069":57852,"_16893":98994,"_5":16788,"_22829":98963,"_2311":98995},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2783":57865,"_24069":57852,"_16893":98997,"_5":16788,"_22829":98963,"_2311":98998},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2783":57866,"_24069":57852,"_16893":99000,"_5":16788,"_22829":98966,"_2311":99001},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2783":57867,"_24069":57852,"_16893":99003,"_5":16788,"_22829":98966,"_2311":99004},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2783":57868,"_24069":57852,"_16893":99006,"_5":16788,"_22829":98966,"_2311":99007},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2783":57869,"_24069":57852,"_16893":99009,"_5":16788,"_22829":98966,"_2311":99010},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2783":57870,"_24069":57852,"_16893":99012,"_5":16788,"_22829":98966,"_2311":99013},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2783":57871,"_24069":57852,"_16893":99015,"_5":16788,"_22829":98973,"_2311":99016},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2783":57872,"_24069":57852,"_16893":99018,"_5":16788,"_22829":98976,"_2311":99019},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2783":57873,"_24069":57852,"_16893":99021,"_5":16788,"_22829":98979,"_2311":99022},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2783":57874,"_24069":57852,"_16893":99024,"_5":16788,"_22829":98982,"_2311":99025},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2783":57875,"_24069":57852,"_16893":99027,"_5":16788,"_22829":98985,"_2311":99028},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2783":57876,"_24069":57852,"_16893":99030,"_5":16788,"_22829":98985,"_2311":99031},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2783":57877,"_24069":57852,"_16893":99033,"_5":16788,"_22829":98985,"_2311":99034},[],"su clave pública corresponda a la clave privada del cliente;",{"_2783":57878,"_24069":57852,"_16893":99036,"_5":16788,"_22829":98985,"_2311":99037},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2783":57879,"_24069":57852,"_16893":99039,"_5":16788,"_22829":98985,"_2311":99040},[],"sus fechas y usos permitan la operación;",{"_2783":57880,"_24069":57852,"_16893":99042,"_5":16788,"_22829":98985,"_2311":99043},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2783":57881,"_24069":57852,"_16893":99045,"_5":16788,"_22829":98985,"_2311":99046},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2783":57882,"_24069":57852,"_16893":99048,"_5":16788,"_22829":98989,"_2311":99049},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2783":57883,"_24069":57852,"_16893":99051,"_5":16788,"_22829":98989,"_2311":99052},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2783":57884,"_24069":57852,"_16893":99054,"_5":16788,"_22829":98989,"_2311":99055},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2783":57885,"_24069":57885,"_5":11891,"_2311":99057,"_24405":99058,"_16893":99059,"_22829":57885},"Crea tu primera CA",[39337,93789,44140,96605],[],{"_2783":57886,"_24069":57885,"_16893":99061,"_5":16788,"_22829":57885,"_2311":99062},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2783":57887,"_24069":57885,"_5":24402,"_16893":99064,"_22829":99065,"_2311":92490},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2783":57888,"_24069":57885,"_5":24402,"_16893":99067,"_22829":99068,"_2311":99069},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2783":57889,"_24069":57885,"_5":24402,"_16893":99071,"_22829":99072,"_2311":99073},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2783":57890,"_24069":57885,"_5":24402,"_16893":99075,"_22829":99076,"_2311":99077},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2783":57891,"_24069":57885,"_5":24402,"_16893":99079,"_22829":99080,"_2311":99081},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2783":57892,"_24069":57885,"_5":24402,"_16893":99083,"_22829":99084,"_2311":99085},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2783":57893,"_24069":57885,"_5":24402,"_16893":99087,"_22829":99088,"_2311":99089},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2783":57894,"_24069":57885,"_5":24402,"_16893":99091,"_22829":99092,"_2311":96853},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2783":57895,"_24069":57885,"_5":24402,"_16893":99094,"_22829":99095,"_2311":92514},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2783":57896,"_24069":57885,"_16893":99097,"_5":16788,"_22829":57885,"_2311":99098},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2783":57897,"_24069":57885,"_16893":99100,"_5":16788,"_22829":99065,"_2311":99101},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2783":57898,"_24069":57885,"_16893":99103,"_5":16788,"_22829":99065,"_2311":99104},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2783":57899,"_24069":57885,"_16893":99106,"_5":16788,"_22829":99065,"_2311":99107},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2783":57900,"_24069":57885,"_16893":99109,"_5":16788,"_22829":99065,"_2311":99110},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2783":57901,"_24069":57885,"_16893":99112,"_5":16788,"_22829":99068,"_2311":99113},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2783":57902,"_24069":57885,"_16893":99115,"_5":16788,"_22829":99068,"_2311":99116},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2783":57903,"_24069":57885,"_16893":99118,"_5":16788,"_22829":99072,"_2311":99119},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2783":57904,"_24069":57885,"_16893":99121,"_5":16788,"_22829":99072,"_2311":99122},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2783":57905,"_24069":57885,"_16893":99124,"_5":16788,"_22829":99076,"_2311":99125},[],"Selecciona **Root CA** y completa:",{"_2783":57906,"_24069":57885,"_16893":99127,"_5":16788,"_22829":99076,"_2311":46139},[],{"_2783":57907,"_24069":57885,"_16893":99129,"_5":16788,"_22829":99076,"_2311":99130},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2783":57908,"_24069":57885,"_16893":99132,"_5":16788,"_22829":99076,"_2311":99133},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2783":57909,"_24069":57885,"_16893":99135,"_5":16788,"_22829":99076,"_2311":99136},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2783":57910,"_24069":57885,"_16893":99138,"_5":16788,"_22829":99076,"_2311":99139},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2783":57911,"_24069":57885,"_16893":99141,"_5":16788,"_22829":99080,"_2311":99142},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2783":57912,"_24069":57885,"_16893":99144,"_5":16788,"_22829":99084,"_2311":99145},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2783":57913,"_24069":57885,"_16893":99147,"_5":16788,"_22829":99084,"_2311":99148},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2783":57914,"_24069":57885,"_16893":99150,"_5":16788,"_22829":99088,"_2311":99151},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2783":57915,"_24069":57885,"_16893":99153,"_5":16788,"_22829":99088,"_2311":99154},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2783":57916,"_24069":57885,"_16893":99156,"_5":16788,"_22829":99088,"_2311":99157},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2783":57917,"_24069":57885,"_16893":99159,"_5":16788,"_22829":99092,"_2311":99160},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2783":57918,"_24069":57885,"_16893":99162,"_5":16788,"_22829":99092,"_2311":99163},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2783":57919,"_24069":57885,"_16893":99165,"_5":16788,"_22829":99092,"_2311":99166},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2783":57920,"_24069":57885,"_16893":99168,"_5":16788,"_22829":99092,"_2311":99169},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2783":57921,"_24069":57885,"_16893":99171,"_5":16788,"_22829":99095,"_2311":99172},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2783":57922,"_24069":57922,"_5":11891,"_2311":99174,"_24405":99175,"_16893":99176,"_22829":57922},"Emite y verifica un certificado",[39337,93789,44140,96605],[],{"_2783":57923,"_24069":57922,"_16893":99178,"_5":16788,"_22829":57922,"_2311":99179},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2783":57924,"_24069":57922,"_5":24402,"_16893":99181,"_22829":99182,"_2311":92490},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2783":57925,"_24069":57922,"_5":24402,"_16893":99184,"_22829":99185,"_2311":99186},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2783":57926,"_24069":57922,"_5":24402,"_16893":99188,"_22829":99189,"_2311":99190},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2783":57927,"_24069":57922,"_5":24402,"_16893":99192,"_22829":99193,"_2311":99194},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2783":57928,"_24069":57922,"_5":24402,"_16893":99196,"_22829":99197,"_2311":99198},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2783":57929,"_24069":57922,"_5":24402,"_16893":99200,"_22829":99201,"_2311":99202},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2783":57930,"_24069":57922,"_5":24402,"_16893":99204,"_22829":99205,"_2311":99085},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2783":57931,"_24069":57922,"_5":24402,"_16893":99207,"_22829":99208,"_2311":99209},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2783":57932,"_24069":57922,"_5":24402,"_16893":99211,"_22829":99212,"_2311":99213},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2783":57933,"_24069":57922,"_5":24402,"_16893":99215,"_22829":99216,"_2311":99217},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2783":57934,"_24069":57922,"_5":24402,"_16893":99219,"_22829":99220,"_2311":96853},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2783":57935,"_24069":57922,"_5":24402,"_16893":99222,"_22829":99223,"_2311":92514},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2783":57936,"_24069":57922,"_16893":99225,"_5":16788,"_22829":57922,"_2311":99226},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2783":57937,"_24069":57922,"_16893":99228,"_5":16788,"_22829":99182,"_2311":99229},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2783":57938,"_24069":57922,"_16893":99231,"_5":16788,"_22829":99182,"_2311":99232},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2783":57939,"_24069":57922,"_16893":99234,"_5":16788,"_22829":99182,"_2311":99235},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2783":57940,"_24069":57922,"_16893":99237,"_5":16788,"_22829":99182,"_2311":99238},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2783":57941,"_24069":57922,"_16893":99240,"_5":16788,"_22829":99182,"_2311":99241},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2783":57942,"_24069":57922,"_16893":99243,"_5":16788,"_22829":99185,"_2311":99244},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2783":57943,"_24069":57922,"_16893":99246,"_5":16788,"_22829":99189,"_2311":99247},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2783":57944,"_24069":57922,"_16893":99249,"_5":16788,"_22829":99189,"_2311":99250},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2783":57945,"_24069":57922,"_16893":99252,"_5":16788,"_22829":99193,"_2311":99253},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2783":57946,"_24069":57922,"_16893":99255,"_5":16788,"_22829":99193,"_2311":99256},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2783":57947,"_24069":57922,"_16893":99258,"_5":16788,"_22829":99197,"_2311":99259},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2783":57948,"_24069":57922,"_16893":99261,"_5":16788,"_22829":99197,"_2311":99262},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2783":57949,"_24069":57922,"_16893":99264,"_5":16788,"_22829":99201,"_2311":99265},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2783":57950,"_24069":57922,"_16893":99267,"_5":16788,"_22829":99205,"_2311":99268},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2783":57951,"_24069":57922,"_16893":99270,"_5":16788,"_22829":99208,"_2311":99271},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2783":57952,"_24069":57922,"_16893":99273,"_5":16788,"_22829":99212,"_2311":99274},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2783":57953,"_24069":57922,"_16893":99276,"_5":16788,"_22829":99212,"_2311":99277},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2783":57954,"_24069":57922,"_16893":99279,"_5":16788,"_22829":99212,"_2311":99280},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2783":57955,"_24069":57922,"_16893":99282,"_5":16788,"_22829":99216,"_2311":99283},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2783":57956,"_24069":57922,"_16893":99285,"_5":16788,"_22829":99216,"_2311":99286},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2783":57957,"_24069":57922,"_16893":99288,"_5":16788,"_22829":99216,"_2311":99289},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2783":57958,"_24069":57922,"_16893":99291,"_5":16788,"_22829":99220,"_2311":96936},[],{"_2783":57959,"_24069":57922,"_16893":99293,"_5":16788,"_22829":99220,"_2311":95740},[],{"_2783":57960,"_24069":57922,"_16893":99295,"_5":16788,"_22829":99220,"_2311":99296},[],"La CA rechaza la emisión",{"_2783":57961,"_24069":57922,"_16893":99298,"_5":16788,"_22829":99220,"_2311":99299},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2783":57962,"_24069":57922,"_16893":99301,"_5":16788,"_22829":99220,"_2311":99302},[],"Sujeto o usos diferentes",{"_2783":57963,"_24069":57922,"_16893":99304,"_5":16788,"_22829":99220,"_2311":99305},[],"Perfil aplicado y valores solicitados.",{"_2783":57964,"_24069":57922,"_16893":99307,"_5":16788,"_22829":99220,"_2311":99308},[],"No se encuentra el emisor",{"_2783":57965,"_24069":57922,"_16893":99310,"_5":16788,"_22829":99220,"_2311":99311},[],"CA descargada y cadena intermedia necesaria.",{"_2783":57966,"_24069":57922,"_16893":99313,"_5":16788,"_22829":99220,"_2311":99314},[],"Falla la vigencia",{"_2783":57967,"_24069":57922,"_16893":99316,"_5":16788,"_22829":99220,"_2311":99317},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2783":57968,"_24069":57922,"_16893":99319,"_5":16788,"_22829":99220,"_2311":99320},[],"Los resúmenes de clave difieren",{"_2783":57969,"_24069":57922,"_16893":99322,"_5":16788,"_22829":99220,"_2311":99323},[],"Archivos de certificado y clave de la misma emisión.",{"_2783":57970,"_24069":57922,"_16893":99325,"_5":16788,"_22829":99220,"_2311":99326},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2783":57971,"_24069":57922,"_16893":99328,"_5":16788,"_22829":99223,"_2311":99329},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2783":57972,"_24069":57922,"_16893":99331,"_5":16788,"_22829":99223,"_2311":99332},[],"Gestionar certificados para inspección, estado y revocación.",{"_2783":57973,"_24069":57922,"_16893":99334,"_5":16788,"_22829":99223,"_2311":99335},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2783":57974,"_24069":57922,"_16893":99337,"_5":16788,"_22829":99223,"_2311":99338},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2783":57975,"_24069":57922,"_16893":99340,"_5":16788,"_22829":99223,"_2311":99341},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2783":57976,"_24069":57976,"_5":11891,"_2311":99343,"_24405":99344,"_16893":99345,"_22829":57976},"Primeros pasos de PKI",[39337,93789,44140,96605],[],{"_2783":57977,"_24069":57976,"_16893":99347,"_5":16788,"_22829":57976,"_2311":99348},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2783":57978,"_24069":57976,"_5":24402,"_16893":99350,"_22829":99351,"_2311":92490},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2783":57979,"_24069":57976,"_5":24402,"_16893":99353,"_22829":99354,"_2311":99355},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2783":57980,"_24069":57976,"_5":24402,"_16893":99357,"_22829":99358,"_2311":96787},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2783":57981,"_24069":57976,"_5":24402,"_16893":99360,"_22829":99361,"_2311":99362},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2783":57982,"_24069":57976,"_16893":99364,"_5":16788,"_22829":57976,"_2311":99365},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2783":57983,"_24069":57976,"_16893":99367,"_5":16788,"_22829":99351,"_2311":99368},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2783":57984,"_24069":57976,"_16893":99370,"_5":16788,"_22829":99351,"_2311":99371},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2783":57985,"_24069":57976,"_16893":99373,"_5":16788,"_22829":99351,"_2311":99374},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2783":57986,"_24069":57976,"_16893":99376,"_5":16788,"_22829":99351,"_2311":99377},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2783":57987,"_24069":57976,"_16893":99379,"_5":16788,"_22829":99351,"_2311":99380},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2783":57988,"_24069":57976,"_16893":99382,"_5":16788,"_22829":99354,"_2311":99383},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2783":57989,"_24069":57976,"_16893":99385,"_5":16788,"_22829":99354,"_2311":99386},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2783":57990,"_24069":57976,"_16893":99388,"_5":16788,"_22829":99354,"_2311":99389},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2783":57991,"_24069":57976,"_16893":99391,"_5":16788,"_22829":99354,"_2311":99392},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2783":57992,"_24069":57976,"_16893":99394,"_5":16788,"_22829":99358,"_2311":99395},[],"Archivo o recurso",{"_2783":57993,"_24069":57976,"_16893":99397,"_5":16788,"_22829":99358,"_2311":96784},[],{"_2783":57994,"_24069":57976,"_16893":99399,"_5":16788,"_22829":99358,"_2311":99400},[],"CA raíz activa y `ca.pem`",{"_2783":57995,"_24069":57976,"_16893":99402,"_5":16788,"_22829":99358,"_2311":99403},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2783":57996,"_24069":57976,"_16893":99405,"_5":16788,"_22829":99358,"_2311":99406},[],"Certificado final y `device.crt`",{"_2783":57997,"_24069":57976,"_16893":99408,"_5":16788,"_22829":99358,"_2311":99409},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2783":57998,"_24069":57976,"_16893":99411,"_5":16788,"_22829":99358,"_2311":99412},[],"Clave privada `device.key`",{"_2783":57999,"_24069":57976,"_16893":99414,"_5":16788,"_22829":99358,"_2311":99415},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2783":58000,"_24069":57976,"_16893":99417,"_5":16788,"_22829":99358,"_2311":99418},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2783":58001,"_24069":57976,"_16893":99420,"_5":16788,"_22829":99361,"_2311":99421},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2783":58002,"_24069":57976,"_16893":99423,"_5":16788,"_22829":99361,"_2311":99424},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2783":58003,"_24069":57976,"_16893":99426,"_5":16788,"_22829":99361,"_2311":99427},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2783":58004,"_24069":58004,"_5":11891,"_2311":99429,"_24405":99430,"_16893":99432,"_22829":58004},"Resolución de problemas PKI",[39337,93789,44140,99431],"Resolución de problemas",[],{"_2783":58005,"_24069":58004,"_16893":99434,"_5":16788,"_22829":58004,"_2311":99435},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2783":58006,"_24069":58004,"_5":24402,"_16893":99437,"_22829":99438,"_2311":99439},[],"/docs/pr-preview/pr-27/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2783":58007,"_24069":58004,"_5":24402,"_16893":99441,"_22829":99442,"_2311":99443},[],"/docs/pr-preview/pr-27/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2783":58008,"_24069":58004,"_5":24402,"_16893":99445,"_22829":99446,"_2311":99447},[],"/docs/pr-preview/pr-27/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2783":58009,"_24069":58004,"_16893":99449,"_5":16788,"_22829":58004,"_2311":99450},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2783":58010,"_24069":58004,"_16893":99452,"_5":16788,"_22829":58004,"_2311":99453},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2783":58011,"_24069":58004,"_16893":99455,"_5":16788,"_22829":99438,"_2311":96784},[],{"_2783":58012,"_24069":58004,"_16893":99457,"_5":16788,"_22829":99438,"_2311":95740},[],{"_2783":58013,"_24069":58004,"_16893":99459,"_5":16788,"_22829":99438,"_2311":92514},[],{"_2783":58014,"_24069":58004,"_16893":99461,"_5":16788,"_22829":99438,"_2311":46475},[],{"_2783":58015,"_24069":58004,"_16893":99463,"_5":16788,"_22829":99438,"_2311":99464},[],"Existe, está activa y sus fechas son utilizables.",{"_2783":58016,"_24069":58004,"_16893":99466,"_5":16788,"_22829":99438,"_2311":99467},[],"Autoridades.",{"_2783":58017,"_24069":58004,"_16893":99469,"_5":16788,"_22829":99438,"_2311":99470},[],"Clave",{"_2783":58018,"_24069":58004,"_16893":99472,"_5":16788,"_22829":99438,"_2311":99473},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2783":58019,"_24069":58004,"_16893":99475,"_5":16788,"_22829":99438,"_2311":99476},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2783":58020,"_24069":58004,"_16893":99478,"_5":16788,"_22829":99438,"_2311":46493},[],{"_2783":58021,"_24069":58004,"_16893":99480,"_5":16788,"_22829":99438,"_2311":99481},[],"PEM correcto y firma verificable.",{"_2783":58022,"_24069":58004,"_16893":99483,"_5":16788,"_22829":99438,"_2311":46499},[],{"_2783":58023,"_24069":58004,"_16893":99485,"_5":16788,"_22829":99438,"_2311":99486},[],"Perfil",{"_2783":58024,"_24069":58004,"_16893":99488,"_5":16788,"_22829":99438,"_2311":99489},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2783":58025,"_24069":58004,"_16893":99491,"_5":16788,"_22829":99438,"_2311":99492},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2783":58026,"_24069":58004,"_16893":99494,"_5":16788,"_22829":99438,"_2311":96936},[],{"_2783":58027,"_24069":58004,"_16893":99496,"_5":16788,"_22829":99438,"_2311":99497},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2783":58028,"_24069":58004,"_16893":99499,"_5":16788,"_22829":99438,"_2311":99500},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2783":58029,"_24069":58004,"_16893":99502,"_5":16788,"_22829":99438,"_2311":99503},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2783":58030,"_24069":58004,"_16893":99505,"_5":16788,"_22829":99438,"_2311":99506},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2783":58031,"_24069":58004,"_16893":99508,"_5":16788,"_22829":99442,"_2311":99509},[],"Revisa cada frontera por separado:",{"_2783":58032,"_24069":58004,"_16893":99511,"_5":16788,"_22829":99442,"_2311":99512},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2783":58033,"_24069":58004,"_16893":99514,"_5":16788,"_22829":99442,"_2311":99515},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2783":58034,"_24069":58004,"_16893":99517,"_5":16788,"_22829":99442,"_2311":99518},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2783":58035,"_24069":58004,"_16893":99520,"_5":16788,"_22829":99442,"_2311":99521},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2783":58036,"_24069":58004,"_16893":99523,"_5":16788,"_22829":99442,"_2311":99524},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2783":58037,"_24069":58004,"_16893":99526,"_5":16788,"_22829":99442,"_2311":99527},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2783":58038,"_24069":58004,"_16893":99529,"_5":16788,"_22829":99446,"_2311":99530},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2783":58039,"_24069":58004,"_16893":99532,"_5":16788,"_22829":99446,"_2311":99533},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_46553":99535,"_46555":99536,"_46557":99537,"_46559":99538,"_14693":2333,"_55742":2333},"spanish",[2311,24069,5,22829],{"_2311":20125,"_24069":20125,"_5":20125,"_22829":20125},{"_2311":99539,"_24069":101833,"_5":104127,"_22829":106421},{"_3710":99540,"_46563":99541,"_5":20125},{"_11654":3674,"_11974":4834,"_11981":4568,"_23326":9158,"_22912":4476,"_16026":6035,"_11675":11703,"_11682":18390,"_23288":4525,"_23627":18389,"_23637":14778,"_23301":4531,"_27826":5720,"_23648":2453,"_27831":4942,"_27834":24082,"_27837":9094,"_27840":3521,"_27843":3766,"_23949":3713,"_27848":9174,"_27850":2574,"_23985":9182,"_23939":16440,"_27854":12651,"_27857":5122,"_24127":5313,"_23666":2474,"_23944":6113,"_24003":4028,"_27863":4766,"_27865":2751,"_27867":4763,"_27869":5979,"_27871":2631,"_27873":4719,"_27875":20130,"_27877":5568,"_27879":4977,"_23339":5606,"_27882":2609,"_27884":2669,"_23333":3820,"_27887":5488,"_27889":10709,"_27891":3967,"_27894":3906,"_23369":3672,"_27898":5808,"_23279":2738,"_27901":9787,"_23306":8479,"_27904":4069,"_27906":2840,"_27909":13456,"_23980":5803,"_27912":2531,"_27914":6128,"_27917":4424,"_27919":2742,"_27921":9187,"_27923":10750,"_27925":6129,"_16029":9186,"_27928":7307,"_27930":3969,"_27932":3879,"_23660":5530,"_27935":4093,"_27937":3757,"_27939":10416,"_27941":2639,"_27943":2567,"_27945":13966,"_27947":2546,"_24055":4080,"_23687":4747,"_27951":5956,"_27953":3771,"_23317":3532,"_27956":5023,"_27958":19962,"_27960":3194,"_23998":4625,"_27963":3696,"_27965":5881,"_27967":17237,"_27969":5581,"_27971":5599,"_23415":3878,"_27976":14203,"_23654":20135,"_27979":5569,"_27981":2652,"_27983":3221,"_27985":7978,"_27987":2536,"_27989":19228,"_23409":6032,"_23632":12157,"_27993":9875,"_27995":2805,"_27998":2760,"_28000":5980,"_28002":4964,"_28004":3050,"_28006":3844,"_28