"_5":11891,"_2311":92480,"_24406":92481,"_16893":92484,"_22829":55750},"Despliega desde AWS Marketplace",[39338,92482,92483],"Despliegue","Otros modelos",[],{"_2783":55751,"_24070":55750,"_16893":92486,"_5":16788,"_22829":55750,"_2311":92487},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2783":55752,"_24070":55750,"_5":24403,"_16893":92489,"_22829":92490,"_2311":92491},[],"/docs/pr-preview/pr-27/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2783":55753,"_24070":55750,"_5":24403,"_16893":92493,"_22829":92494,"_2311":92495},[],"/docs/pr-preview/pr-27/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2783":55754,"_24070":55750,"_5":24403,"_16893":92497,"_22829":92498,"_2311":92499},[],"/docs/pr-preview/pr-27/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2783":55755,"_24070":55750,"_5":24403,"_16893":92501,"_22829":92502,"_2311":92503},[],"/docs/pr-preview/pr-27/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2783":55756,"_24070":55750,"_5":24403,"_16893":92505,"_22829":92506,"_2311":92507},[],"/docs/pr-preview/pr-27/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2783":55757,"_24070":55750,"_5":24403,"_16893":92509,"_22829":92510,"_2311":92511},[],"/docs/pr-preview/pr-27/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2783":55758,"_24070":55750,"_5":24403,"_16893":92513,"_22829":92514,"_2311":92515},[],"/docs/pr-preview/pr-27/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2783":55759,"_24070":55750,"_16893":92517,"_5":16788,"_22829":55750,"_2311":92518},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2783":55760,"_24070":55750,"_16893":92520,"_5":16788,"_22829":92490,"_2311":92521},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2783":55761,"_24070":55750,"_16893":92523,"_5":16788,"_22829":92490,"_2311":92524},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2783":55762,"_24070":55750,"_16893":92526,"_5":16788,"_22829":92490,"_2311":92527},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2783":55763,"_24070":55750,"_16893":92529,"_5":16788,"_22829":92494,"_2311":92530},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2783":55764,"_24070":55750,"_16893":92532,"_5":16788,"_22829":92494,"_2311":92533},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2783":55765,"_24070":55750,"_16893":92535,"_5":16788,"_22829":92494,"_2311":92536},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2783":55766,"_24070":55750,"_16893":92538,"_5":16788,"_22829":92498,"_2311":92539},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2783":55767,"_24070":55750,"_16893":92541,"_5":16788,"_22829":92502,"_2311":92542},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2783":55768,"_24070":55750,"_16893":92544,"_5":16788,"_22829":92506,"_2311":92545},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2783":55769,"_24070":55750,"_16893":92547,"_5":16788,"_22829":92510,"_2311":92548},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2783":55770,"_24070":55750,"_16893":92550,"_5":16788,"_22829":92514,"_2311":92551},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2783":55771,"_24070":55771,"_5":11891,"_2311":92553,"_24406":92554,"_16893":92555,"_22829":55771},"Despliega Lamassu",[39338,92482],[],{"_2783":55772,"_24070":55771,"_16893":92557,"_5":16788,"_22829":55771,"_2311":92558},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2783":55773,"_24070":55771,"_5":24403,"_16893":92560,"_22829":92561,"_2311":92562},[],"/docs/pr-preview/pr-27/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2783":55774,"_24070":55771,"_5":24403,"_16893":92564,"_22829":92565,"_2311":92566},[],"/docs/pr-preview/pr-27/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2783":55775,"_24070":55771,"_5":24403,"_16893":92568,"_22829":92569,"_2311":92570},[],"/docs/pr-preview/pr-27/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2783":55776,"_24070":55771,"_16893":92572,"_5":16788,"_22829":55771,"_2311":92573},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2783":55777,"_24070":55771,"_16893":92575,"_5":16788,"_22829":92561,"_2311":92576},[],"Modelo",{"_2783":55778,"_24070":55771,"_16893":92578,"_5":16788,"_22829":92561,"_2311":92579},[],"Recomendado para",{"_2783":55779,"_24070":55771,"_16893":92581,"_5":16788,"_22829":92561,"_2311":92582},[],"Quién opera la infraestructura",{"_2783":55780,"_24070":55771,"_16893":92584,"_5":16788,"_22829":92561,"_2311":92585},[],"Punto de partida",{"_2783":55781,"_24070":55771,"_16893":92587,"_5":16788,"_22829":92561,"_2311":39445},[],{"_2783":55782,"_24070":55771,"_16893":92589,"_5":16788,"_22829":92561,"_2311":92590},[],"Producción, entornos regulados y despliegues personalizados",{"_2783":55783,"_24070":55771,"_16893":92592,"_5":16788,"_22829":92561,"_2311":92593},[],"Tu equipo",{"_2783":55784,"_24070":55771,"_16893":92595,"_5":16788,"_22829":92561,"_2311":92596},[],"Helm o Fastlane",{"_2783":55785,"_24070":55771,"_16893":92598,"_5":16788,"_22829":92561,"_2311":39457},[],{"_2783":55786,"_24070":55771,"_16893":92600,"_5":16788,"_22829":92561,"_2311":92601},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2783":55787,"_24070":55771,"_16893":92603,"_5":16788,"_22829":92561,"_2311":92593},[],{"_2783":55788,"_24070":55771,"_16893":92605,"_5":16788,"_22829":92561,"_2311":92606},[],"Imagen preconfigurada en EC2",{"_2783":55789,"_24070":55771,"_16893":92608,"_5":16788,"_22829":92561,"_2311":39468},[],{"_2783":55790,"_24070":55771,"_16893":92610,"_5":16788,"_22829":92561,"_2311":92611},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2783":55791,"_24070":55771,"_16893":92613,"_5":16788,"_22829":92561,"_2311":39474},[],{"_2783":55792,"_24070":55771,"_16893":92615,"_5":16788,"_22829":92561,"_2311":92616},[],"Suscripción gestionada",{"_2783":55793,"_24070":55771,"_16893":92618,"_5":16788,"_22829":92561,"_2311":92619},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2783":55794,"_24070":55771,"_16893":92621,"_5":16788,"_22829":92561,"_2311":92622},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2783":55795,"_24070":55771,"_16893":92624,"_5":16788,"_22829":92561,"_2311":92625},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2783":55796,"_24070":55771,"_16893":92627,"_5":16788,"_22829":92565,"_2311":92628},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2783":55797,"_24070":55771,"_16893":92630,"_5":16788,"_22829":92569,"_2311":92631},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2783":55798,"_24070":55798,"_5":11891,"_2311":92633,"_24406":92634,"_16893":92635,"_22829":55798},"Utiliza Lamassu como SaaS",[39338,92482,92483],[],{"_2783":55799,"_24070":55798,"_16893":92637,"_5":16788,"_22829":55798,"_2311":92638},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2783":55800,"_24070":55798,"_5":24403,"_16893":92640,"_22829":92641,"_2311":92642},[],"/docs/pr-preview/pr-27/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2783":55801,"_24070":55798,"_5":24403,"_16893":92644,"_22829":92645,"_2311":92646},[],"/docs/pr-preview/pr-27/es/deployment/saas#planes","Planes",{"_2783":55802,"_24070":55798,"_5":24403,"_16893":92648,"_22829":92649,"_2311":92650},[],"/docs/pr-preview/pr-27/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2783":55803,"_24070":55798,"_16893":92652,"_5":16788,"_22829":55798,"_2311":92653},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2783":55804,"_24070":55798,"_16893":92655,"_5":16788,"_22829":92641,"_2311":92656},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2783":55805,"_24070":55798,"_16893":92658,"_5":16788,"_22829":92641,"_2311":92659},[],"Copias de seguridad automáticas.",{"_2783":55806,"_24070":55798,"_16893":92661,"_5":16788,"_22829":92641,"_2311":92662},[],"Actualizaciones de versión.",{"_2783":55807,"_24070":55798,"_16893":92664,"_5":16788,"_22829":92641,"_2311":92665},[],"Soporte técnico y SLA según el plan contratado.",{"_2783":55808,"_24070":55798,"_16893":92667,"_5":16788,"_22829":92645,"_2311":39529},[],{"_2783":55809,"_24070":55798,"_16893":92669,"_5":16788,"_22829":92645,"_2311":92670},[],"Dispositivos",{"_2783":55810,"_24070":55798,"_16893":92672,"_5":16788,"_22829":92645,"_2311":92673},[],"Soporte",{"_2783":55811,"_24070":55798,"_16893":92675,"_5":16788,"_22829":92645,"_2311":39538},[],{"_2783":55812,"_24070":55798,"_16893":92677,"_5":16788,"_22829":92645,"_2311":39541},[],{"_2783":55813,"_24070":55798,"_16893":92679,"_5":16788,"_22829":92645,"_2311":92680},[],"Hasta 1.000",{"_2783":55814,"_24070":55798,"_16893":92682,"_5":16788,"_22829":92645,"_2311":39547},[],{"_2783":55815,"_24070":55798,"_16893":92684,"_5":16788,"_22829":92645,"_2311":92685},[],"99,5 %",{"_2783":55816,"_24070":55798,"_16893":92687,"_5":16788,"_22829":92645,"_2311":39553},[],{"_2783":55817,"_24070":55798,"_16893":92689,"_5":16788,"_22829":92645,"_2311":92690},[],"Hasta 10.000",{"_2783":55818,"_24070":55798,"_16893":92692,"_5":16788,"_22829":92645,"_2311":92693},[],"Email y chat",{"_2783":55819,"_24070":55798,"_16893":92695,"_5":16788,"_22829":92645,"_2311":92696},[],"99,9 %",{"_2783":55820,"_24070":55798,"_16893":92698,"_5":16788,"_22829":92645,"_2311":39565},[],{"_2783":55821,"_24070":55798,"_16893":92700,"_5":16788,"_22829":92645,"_2311":92701},[],"Ilimitados",{"_2783":55822,"_24070":55798,"_16893":92703,"_5":16788,"_22829":92645,"_2311":92704},[],"Dedicado",{"_2783":55823,"_24070":55798,"_16893":92706,"_5":16788,"_22829":92645,"_2311":92707},[],"99,99 %",{"_2783":55824,"_24070":55798,"_16893":92709,"_5":16788,"_22829":92649,"_2311":92710},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2783":55825,"_24070":55798,"_16893":92712,"_5":16788,"_22829":92649,"_2311":92713},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2783":55826,"_24070":55826,"_5":11891,"_2311":39582,"_24406":92715,"_16893":92717,"_22829":55826},[39338,92482,92716],"Kubernetes autogestionado",[],{"_2783":55827,"_24070":55826,"_16893":92719,"_5":16788,"_22829":55826,"_2311":92720},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2783":55828,"_24070":55826,"_5":24403,"_16893":92722,"_22829":92723,"_2311":92724},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2783":55829,"_24070":55826,"_5":24403,"_16893":92726,"_22829":92727,"_2311":92728},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2783":55830,"_24070":55826,"_5":24403,"_16893":92730,"_22829":92731,"_2311":92732},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2783":55831,"_24070":55826,"_5":24403,"_16893":92734,"_22829":92735,"_2311":92736},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2783":55832,"_24070":55826,"_5":24403,"_16893":92738,"_22829":92739,"_2311":92740},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2783":55833,"_24070":55826,"_5":24403,"_16893":92742,"_22829":92743,"_2311":92744},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2783":55834,"_24070":55826,"_5":24403,"_16893":92746,"_22829":92747,"_2311":92748},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2783":55835,"_24070":55826,"_5":24403,"_16893":92750,"_22829":92751,"_2311":92752},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2783":55836,"_24070":55826,"_5":24403,"_16893":92754,"_22829":92755,"_2311":92756},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2783":55837,"_24070":55826,"_5":24403,"_16893":92758,"_22829":92759,"_2311":92760},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2783":55838,"_24070":55826,"_16893":92762,"_5":16788,"_22829":92723,"_2311":92763},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2783":55839,"_24070":55826,"_16893":92765,"_5":16788,"_22829":92723,"_2311":92766},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2783":55840,"_24070":55826,"_16893":92768,"_5":16788,"_22829":92727,"_2311":92769},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2783":55841,"_24070":55826,"_16893":92771,"_5":16788,"_22829":92727,"_2311":92772},[],"Fastlane instala o configura",{"_2783":55842,"_24070":55826,"_16893":92774,"_5":16788,"_22829":92727,"_2311":92775},[],"Tú sigues proporcionando",{"_2783":55843,"_24070":55826,"_16893":92777,"_5":16788,"_22829":92727,"_2311":92778},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2783":55844,"_24070":55826,"_16893":92780,"_5":16788,"_22829":92727,"_2311":92781},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2783":55845,"_24070":55826,"_16893":92783,"_5":16788,"_22829":92727,"_2311":92784},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2783":55846,"_24070":55826,"_16893":92786,"_5":16788,"_22829":92727,"_2311":92787},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2783":55847,"_24070":55826,"_16893":92789,"_5":16788,"_22829":92727,"_2311":92790},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2783":55848,"_24070":55826,"_16893":92792,"_5":16788,"_22829":92727,"_2311":92793},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2783":55849,"_24070":55826,"_16893":92795,"_5":16788,"_22829":92727,"_2311":92796},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2783":55850,"_24070":55826,"_16893":92798,"_5":16788,"_22829":92727,"_2311":92799},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2783":55851,"_24070":55826,"_16893":92801,"_5":16788,"_22829":92727,"_2311":92802},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2783":55852,"_24070":55826,"_16893":92804,"_5":16788,"_22829":92731,"_2311":92805},[],"Necesitas:",{"_2783":55853,"_24070":55826,"_16893":92807,"_5":16788,"_22829":92731,"_2311":92808},[],"un clúster Kubernetes existente",{"_2783":55854,"_24070":55826,"_16893":92810,"_5":16788,"_22829":92731,"_2311":92811},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2783":55855,"_24070":55826,"_16893":92813,"_5":16788,"_22829":92731,"_2311":39680},[],{"_2783":55856,"_24070":55826,"_16893":92815,"_5":16788,"_22829":92731,"_2311":19088},[],{"_2783":55857,"_24070":55826,"_16893":92817,"_5":16788,"_22829":92731,"_2311":92818},[],"`jq` solo si usas `--sample-data`",{"_2783":55858,"_24070":55826,"_16893":92820,"_5":16788,"_22829":92731,"_2311":92821},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2783":55859,"_24070":55826,"_16893":92823,"_5":16788,"_22829":92731,"_2311":92824},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2783":55860,"_24070":55826,"_16893":92826,"_5":16788,"_22829":92731,"_2311":92827},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2783":55861,"_24070":55826,"_16893":92829,"_5":16788,"_22829":92735,"_2311":92830},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2783":55862,"_24070":55826,"_16893":92832,"_5":16788,"_22829":92735,"_2311":92833},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2783":55863,"_24070":55826,"_16893":92835,"_5":16788,"_22829":92739,"_2311":92836},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2783":55864,"_24070":55826,"_16893":92838,"_5":16788,"_22829":92739,"_2311":92839},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2783":55865,"_24070":55826,"_16893":92841,"_5":16788,"_22829":92739,"_2311":92842},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2783":55866,"_24070":55826,"_16893":92844,"_5":16788,"_22829":92739,"_2311":92845},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2783":55867,"_24070":55826,"_16893":92847,"_5":16788,"_22829":92743,"_2311":92848},[],"Opción",{"_2783":55868,"_24070":55826,"_16893":92850,"_5":16788,"_22829":92743,"_2311":92851},[],"Valor predeterminado",{"_2783":55869,"_24070":55826,"_16893":92853,"_5":16788,"_22829":92743,"_2311":92854},[],"Propósito",{"_2783":55870,"_24070":55826,"_16893":92856,"_5":16788,"_22829":92743,"_2311":39724},[],{"_2783":55871,"_24070":55826,"_16893":92858,"_5":16788,"_22829":92743,"_2311":39727},[],{"_2783":55872,"_24070":55826,"_16893":92860,"_5":16788,"_22829":92743,"_2311":92861},[],"Muestra la ayuda",{"_2783":55873,"_24070":55826,"_16893":92863,"_5":16788,"_22829":92743,"_2311":39733},[],{"_2783":55874,"_24070":55826,"_16893":92865,"_5":16788,"_22829":92743,"_2311":92866},[],"contexto actual",{"_2783":55875,"_24070":55826,"_16893":92868,"_5":16788,"_22829":92743,"_2311":92869},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2783":55876,"_24070":55826,"_16893":92871,"_5":16788,"_22829":92743,"_2311":39742},[],{"_2783":55877,"_24070":55826,"_16893":92873,"_5":16788,"_22829":92743,"_2311":5183},[],{"_2783":55878,"_24070":55826,"_16893":92875,"_5":16788,"_22829":92743,"_2311":92876},[],"Omite prompts y genera credenciales para las dependencias",{"_2783":55879,"_24070":55826,"_16893":92878,"_5":16788,"_22829":92743,"_2311":39750},[],{"_2783":55880,"_24070":55826,"_16893":92880,"_5":16788,"_22829":92743,"_2311":39753},[],{"_2783":55881,"_24070":55826,"_16893":92882,"_5":16788,"_22829":92743,"_2311":92883},[],"Namespace de la instalación",{"_2783":55882,"_24070":55826,"_16893":92885,"_5":16788,"_22829":92743,"_2311":39759},[],{"_2783":55883,"_24070":55826,"_16893":92887,"_5":16788,"_22829":92743,"_2311":39762},[],{"_2783":55884,"_24070":55826,"_16893":92889,"_5":16788,"_22829":92743,"_2311":92890},[],"Dominio usado por la UI, OIDC y el certificado",{"_2783":55885,"_24070":55826,"_16893":92892,"_5":16788,"_22829":92743,"_2311":39768},[],{"_2783":55886,"_24070":55826,"_16893":92894,"_5":16788,"_22829":92743,"_2311":12106},[],{"_2783":55887,"_24070":55826,"_16893":92896,"_5":16788,"_22829":92743,"_2311":92897},[],"Versión del chart de Lamassu",{"_2783":55888,"_24070":55826,"_16893":92899,"_5":16788,"_22829":92743,"_2311":39776},[],{"_2783":55889,"_24070":55826,"_16893":92901,"_5":16788,"_22829":92743,"_2311":39779},[],{"_2783":55890,"_24070":55826,"_16893":92903,"_5":16788,"_22829":92743,"_2311":92904},[],"Puerto del listener HTTPS",{"_2783":55891,"_24070":55826,"_16893":92906,"_5":16788,"_22829":92743,"_2311":39785},[],{"_2783":55892,"_24070":55826,"_16893":92908,"_5":16788,"_22829":92743,"_2311":39788},[],{"_2783":55893,"_24070":55826,"_16893":92910,"_5":16788,"_22829":92743,"_2311":92911},[],"Puerto del listener HTTP",{"_2783":55894,"_24070":55826,"_16893":92913,"_5":16788,"_22829":92743,"_2311":39794},[],{"_2783":55895,"_24070":55826,"_16893":92915,"_5":16788,"_22829":92743,"_2311":39727},[],{"_2783":55896,"_24070":55826,"_16893":92917,"_5":16788,"_22829":92743,"_2311":92918},[],"Certificado PEM para TLS downstream",{"_2783":55897,"_24070":55826,"_16893":92920,"_5":16788,"_22829":92743,"_2311":39802},[],{"_2783":55898,"_24070":55826,"_16893":92922,"_5":16788,"_22829":92743,"_2311":39727},[],{"_2783":55899,"_24070":55826,"_16893":92924,"_5":16788,"_22829":92743,"_2311":92925},[],"Clave privada PEM para TLS downstream",{"_2783":55900,"_24070":55826,"_16893":92927,"_5":16788,"_22829":92743,"_2311":39810},[],{"_2783":55901,"_24070":55826,"_16893":92929,"_5":16788,"_22829":92743,"_2311":92930},[],"chart del repositorio",{"_2783":55902,"_24070":55826,"_16893":92932,"_5":16788,"_22829":92743,"_2311":92933},[],"Usa un chart local de Lamassu sin empaquetar",{"_2783":55903,"_24070":55826,"_16893":92935,"_5":16788,"_22829":92743,"_2311":39819},[],{"_2783":55904,"_24070":55826,"_16893":92937,"_5":16788,"_22829":92743,"_2311":92938},[],"detección automática",{"_2783":55905,"_24070":55826,"_16893":92940,"_5":16788,"_22829":92743,"_2311":92941},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2783":55906,"_24070":55826,"_16893":92943,"_5":16788,"_22829":92743,"_2311":39827},[],{"_2783":55907,"_24070":55826,"_16893":92945,"_5":16788,"_22829":92743,"_2311":5183},[],{"_2783":55908,"_24070":55826,"_16893":92947,"_5":16788,"_22829":92743,"_2311":92948},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2783":55909,"_24070":55826,"_16893":92950,"_5":16788,"_22829":92743,"_2311":39835},[],{"_2783":55910,"_24070":55826,"_16893":92952,"_5":16788,"_22829":92743,"_2311":5183},[],{"_2783":55911,"_24070":55826,"_16893":92954,"_5":16788,"_22829":92743,"_2311":92955},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2783":55912,"_24070":55826,"_16893":92957,"_5":16788,"_22829":92743,"_2311":39843},[],{"_2783":55913,"_24070":55826,"_16893":92959,"_5":16788,"_22829":92743,"_2311":5183},[],{"_2783":55914,"_24070":55826,"_16893":92961,"_5":16788,"_22829":92743,"_2311":92962},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2783":55915,"_24070":55826,"_16893":92964,"_5":16788,"_22829":92743,"_2311":39851},[],{"_2783":55916,"_24070":55826,"_16893":92966,"_5":16788,"_22829":92743,"_2311":39854},[],{"_2783":55917,"_24070":55826,"_16893":92968,"_5":16788,"_22829":92743,"_2311":92969},[],"Usa otro chart local de SoftHSM",{"_2783":55918,"_24070":55826,"_16893":92971,"_5":16788,"_22829":92743,"_2311":92972},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2783":55919,"_24070":55826,"_16893":92974,"_5":16788,"_22829":92747,"_2311":39863},[],{"_2783":55920,"_24070":55826,"_16893":92976,"_5":16788,"_22829":92747,"_2311":92977},[],"valida las herramientas locales y el clúster seleccionado",{"_2783":55921,"_24070":55826,"_16893":92979,"_5":16788,"_22829":92747,"_2311":92980},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2783":55922,"_24070":55826,"_16893":92982,"_5":16788,"_22829":92747,"_2311":92983},[],"crea el namespace",{"_2783":55923,"_24070":55826,"_16893":92985,"_5":16788,"_22829":92747,"_2311":92986},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2783":55924,"_24070":55826,"_16893":92988,"_5":16788,"_22829":92747,"_2311":92989},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2783":55925,"_24070":55826,"_16893":92991,"_5":16788,"_22829":92747,"_2311":92992},[],"instala RabbitMQ",{"_2783":55926,"_24070":55826,"_16893":92994,"_5":16788,"_22829":92747,"_2311":92995},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2783":55927,"_24070":55826,"_16893":92997,"_5":16788,"_22829":92747,"_2311":92998},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2783":55928,"_24070":55826,"_16893":93000,"_5":16788,"_22829":92747,"_2311":93001},[],"carga datos de ejemplo opcionalmente",{"_2783":55929,"_24070":55826,"_16893":93003,"_5":16788,"_22829":92747,"_2311":93004},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2783":55930,"_24070":55826,"_16893":93006,"_5":16788,"_22829":92751,"_2311":93007},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2783":55931,"_24070":55826,"_16893":93009,"_5":16788,"_22829":92751,"_2311":93010},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2783":55932,"_24070":55826,"_16893":93012,"_5":16788,"_22829":92755,"_2311":93013},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2783":55933,"_24070":55826,"_16893":93015,"_5":16788,"_22829":92755,"_2311":93016},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2783":55934,"_24070":55826,"_16893":93018,"_5":16788,"_22829":92755,"_2311":93019},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2783":55935,"_24070":55826,"_16893":93021,"_5":16788,"_22829":92759,"_2311":93022},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2783":55936,"_24070":55936,"_5":11891,"_2311":93024,"_24406":93025,"_16893":93026,"_22829":55936},"Instala con Helm",[39338,92482,92716],[],{"_2783":55937,"_24070":55936,"_16893":93028,"_5":16788,"_22829":55936,"_2311":93029},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2783":55938,"_24070":55936,"_5":24403,"_16893":93031,"_22829":93032,"_2311":93033},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2783":55939,"_24070":55936,"_5":24403,"_16893":93035,"_22829":93036,"_2311":92732},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2783":55940,"_24070":55936,"_5":24403,"_16893":93038,"_22829":93039,"_2311":93040},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2783":55941,"_24070":55936,"_5":24403,"_16893":93042,"_22829":93043,"_2311":93044},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2783":55942,"_24070":55936,"_5":24403,"_16893":93046,"_22829":93047,"_2311":93048},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2783":55943,"_24070":55936,"_5":24403,"_16893":93050,"_22829":93051,"_2311":93052},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2783":55944,"_24070":55936,"_5":24403,"_16893":93054,"_22829":93055,"_2311":93056},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2783":55945,"_24070":55936,"_5":24403,"_16893":93058,"_22829":93059,"_2311":93060},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2783":55946,"_24070":55936,"_5":24403,"_16893":93062,"_22829":93063,"_2311":93064},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2783":55947,"_24070":55936,"_16893":93066,"_5":16788,"_22829":93032,"_2311":93067},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2783":55948,"_24070":55936,"_16893":93069,"_5":16788,"_22829":93036,"_2311":93070},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2783":55949,"_24070":55936,"_16893":93072,"_5":16788,"_22829":93036,"_2311":93073},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2783":55950,"_24070":55936,"_16893":93075,"_5":16788,"_22829":93036,"_2311":93076},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2783":55951,"_24070":55936,"_16893":93078,"_5":16788,"_22829":93036,"_2311":93079},[],"un broker RabbitMQ accesible y sus credenciales",{"_2783":55952,"_24070":55936,"_16893":93081,"_5":16788,"_22829":93036,"_2311":93082},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2783":55953,"_24070":55936,"_16893":93084,"_5":16788,"_22829":93036,"_2311":93085},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2783":55954,"_24070":55936,"_16893":93087,"_5":16788,"_22829":93036,"_2311":93088},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2783":55955,"_24070":55936,"_16893":93090,"_5":16788,"_22829":93036,"_2311":93091},[],"una StorageClass y un diseño de tráfico externo",{"_2783":55956,"_24070":55936,"_16893":93093,"_5":16788,"_22829":93036,"_2311":93094},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2783":55957,"_24070":55936,"_16893":93096,"_5":16788,"_22829":93036,"_2311":93097},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2783":55958,"_24070":55936,"_16893":93099,"_5":16788,"_22829":93036,"_2311":93100},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2783":55959,"_24070":55936,"_16893":93102,"_5":16788,"_22829":93039,"_2311":93103},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2783":55960,"_24070":55936,"_16893":93105,"_5":16788,"_22829":93039,"_2311":93106},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2783":55961,"_24070":55936,"_16893":93108,"_5":16788,"_22829":93039,"_2311":93109},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2783":55962,"_24070":55936,"_16893":93111,"_5":16788,"_22829":93043,"_2311":93112},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2783":55963,"_24070":55936,"_16893":93114,"_5":16788,"_22829":93043,"_2311":93115},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2783":55964,"_24070":55936,"_16893":93117,"_5":16788,"_22829":93043,"_2311":93118},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2783":55965,"_24070":55936,"_16893":93120,"_5":16788,"_22829":93047,"_2311":93121},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2783":55966,"_24070":55936,"_16893":93123,"_5":16788,"_22829":93051,"_2311":93124},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2783":55967,"_24070":55936,"_16893":93126,"_5":16788,"_22829":93051,"_2311":93127},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2783":55968,"_24070":55936,"_16893":93129,"_5":16788,"_22829":93051,"_2311":93130},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2783":55969,"_24070":55936,"_16893":93132,"_5":16788,"_22829":93051,"_2311":93133},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2783":55970,"_24070":55936,"_16893":93135,"_5":16788,"_22829":93055,"_2311":93136},[],"Para instalar un checkout local:",{"_2783":55971,"_24070":55936,"_16893":93138,"_5":16788,"_22829":93059,"_2311":93139},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2783":55972,"_24070":55936,"_16893":93141,"_5":16788,"_22829":93059,"_2311":93142},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2783":55973,"_24070":55936,"_16893":93144,"_5":16788,"_22829":93063,"_2311":93145},[],"Antes de pasar a producción, revisa:",{"_2783":55974,"_24070":55936,"_16893":93147,"_5":16788,"_22829":93063,"_2311":93148},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2783":55975,"_24070":55936,"_16893":93150,"_5":16788,"_22829":93063,"_2311":93151},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2783":55976,"_24070":55936,"_16893":93153,"_5":16788,"_22829":93063,"_2311":93154},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2783":55977,"_24070":55936,"_16893":93156,"_5":16788,"_22829":93063,"_2311":93157},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2783":55978,"_24070":55936,"_16893":93159,"_5":16788,"_22829":93063,"_2311":93160},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2783":55979,"_24070":55936,"_16893":93162,"_5":16788,"_22829":93063,"_2311":93163},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2783":55980,"_24070":55936,"_16893":93165,"_5":16788,"_22829":93063,"_2311":93166},[],"SMTP, observabilidad y entrega de alertas",{"_2783":55981,"_24070":55936,"_16893":93168,"_5":16788,"_22829":93063,"_2311":93169},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2783":55982,"_24070":55936,"_16893":93171,"_5":16788,"_22829":93063,"_2311":93172},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2783":55983,"_24070":55983,"_5":11891,"_2311":93174,"_24406":93175,"_16893":93176,"_22829":55983},"Expón el Gateway",[39338,92482,92716],[],{"_2783":55984,"_24070":55983,"_16893":93178,"_5":16788,"_22829":55983,"_2311":93179},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2783":55985,"_24070":55983,"_5":24403,"_16893":93181,"_22829":93182,"_2311":93183},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2783":55986,"_24070":55983,"_5":24403,"_16893":93185,"_22829":93186,"_2311":93187},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2783":55987,"_24070":55983,"_5":24403,"_16893":93189,"_22829":93190,"_2311":93191},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2783":55988,"_24070":55983,"_5":24403,"_16893":93193,"_22829":93194,"_2311":40084},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#k3s",{"_2783":55989,"_24070":55983,"_5":24403,"_16893":93196,"_22829":93197,"_2311":93198},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2783":55990,"_24070":55983,"_5":24403,"_16893":93200,"_22829":93201,"_2311":93202},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2783":55991,"_24070":55983,"_5":24403,"_16893":93204,"_22829":93205,"_2311":93206},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2783":55992,"_24070":55983,"_5":24403,"_16893":93208,"_22829":93209,"_2311":93210},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2783":55993,"_24070":55983,"_5":24403,"_16893":93212,"_22829":93213,"_2311":93214},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2783":55994,"_24070":55983,"_16893":93216,"_5":16788,"_22829":93182,"_2311":93217},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2783":55995,"_24070":55983,"_16893":93219,"_5":16788,"_22829":93182,"_2311":93220},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2783":55996,"_24070":55983,"_16893":93222,"_5":16788,"_22829":93186,"_2311":93223},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2783":55997,"_24070":55983,"_16893":93225,"_5":16788,"_22829":93186,"_2311":93226},[],"Defínelo únicamente cuando:",{"_2783":55998,"_24070":55983,"_16893":93228,"_5":16788,"_22829":93186,"_2311":93229},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2783":55999,"_24070":55983,"_16893":93231,"_5":16788,"_22829":93186,"_2311":93232},[],"esa dirección está asignada a este Gateway",{"_2783":56000,"_24070":55983,"_16893":93234,"_5":16788,"_22829":93186,"_2311":93235},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2783":56001,"_24070":55983,"_16893":93237,"_5":16788,"_22829":93186,"_2311":93238},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2783":56002,"_24070":55983,"_16893":93240,"_5":16788,"_22829":93186,"_2311":93241},[],"No confundas estos valores:",{"_2783":56003,"_24070":55983,"_16893":93243,"_5":16788,"_22829":93186,"_2311":93244},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2783":56004,"_24070":55983,"_16893":93246,"_5":16788,"_22829":93186,"_2311":93247},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2783":56005,"_24070":55983,"_16893":93249,"_5":16788,"_22829":93186,"_2311":93250},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2783":56006,"_24070":55983,"_16893":93252,"_5":16788,"_22829":93190,"_2311":93253},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2783":56007,"_24070":55983,"_16893":93255,"_5":16788,"_22829":93190,"_2311":93256},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2783":56008,"_24070":55983,"_16893":93258,"_5":16788,"_22829":93194,"_2311":93259},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2783":56009,"_24070":55983,"_16893":93261,"_5":16788,"_22829":93194,"_2311":93262},[],"Para el diseño recomendado:",{"_2783":56010,"_24070":55983,"_16893":93264,"_5":16788,"_22829":93194,"_2311":93265},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2783":56011,"_24070":55983,"_16893":93267,"_5":16788,"_22829":93194,"_2311":93268},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2783":56012,"_24070":55983,"_16893":93270,"_5":16788,"_22829":93194,"_2311":93271},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2783":56013,"_24070":55983,"_16893":93273,"_5":16788,"_22829":93194,"_2311":93274},[],"Apunta DNS a la dirección accesible de la VM.",{"_2783":56014,"_24070":55983,"_16893":93276,"_5":16788,"_22829":93194,"_2311":93277},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2783":56015,"_24070":55983,"_16893":93279,"_5":16788,"_22829":93197,"_2311":93280},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2783":56016,"_24070":55983,"_16893":93282,"_5":16788,"_22829":93201,"_2311":93283},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2783":56017,"_24070":55983,"_16893":93285,"_5":16788,"_22829":93201,"_2311":93286},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2783":56018,"_24070":55983,"_16893":93288,"_5":16788,"_22829":93205,"_2311":93289},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2783":56019,"_24070":55983,"_16893":93291,"_5":16788,"_22829":93205,"_2311":93292},[],"Requisito",{"_2783":56020,"_24070":55983,"_16893":93294,"_5":16788,"_22829":93205,"_2311":93295},[],"Diseño recomendado",{"_2783":56021,"_24070":55983,"_16893":93297,"_5":16788,"_22829":93205,"_2311":93298},[],"Consecuencia",{"_2783":56022,"_24070":55983,"_16893":93300,"_5":16788,"_22829":93205,"_2311":93301},[],"Varias URL o servicios de Lamassu",{"_2783":56023,"_24070":55983,"_16893":93303,"_5":16788,"_22829":93205,"_2311":93304},[],"Un Gateway con varias rutas",{"_2783":56024,"_24070":55983,"_16893":93306,"_5":16788,"_22829":93205,"_2311":93307},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2783":56025,"_24070":55983,"_16893":93309,"_5":16788,"_22829":93205,"_2311":93310},[],"Gateways independientes e IP externas distintas",{"_2783":56026,"_24070":55983,"_16893":93312,"_5":16788,"_22829":93205,"_2311":93313},[],"Una VIP por Gateway",{"_2783":56027,"_24070":55983,"_16893":93315,"_5":16788,"_22829":93205,"_2311":93316},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2783":56028,"_24070":55983,"_16893":93318,"_5":16788,"_22829":93205,"_2311":93319},[],"Gateways independientes, un nodo y una IP",{"_2783":56029,"_24070":55983,"_16893":93321,"_5":16788,"_22829":93205,"_2311":93322},[],"Puertos externos diferentes",{"_2783":56030,"_24070":55983,"_16893":93324,"_5":16788,"_22829":93205,"_2311":93325},[],"Los clientes deben indicar puertos no estándar",{"_2783":56031,"_24070":55983,"_16893":93327,"_5":16788,"_22829":93205,"_2311":93328},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2783":56032,"_24070":55983,"_16893":93330,"_5":16788,"_22829":93205,"_2311":93331},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2783":56033,"_24070":55983,"_16893":93333,"_5":16788,"_22829":93205,"_2311":93334},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2783":56034,"_24070":55983,"_16893":93336,"_5":16788,"_22829":93205,"_2311":93337},[],"Recursos Gateway separados pero proxy compartido",{"_2783":56035,"_24070":55983,"_16893":93339,"_5":16788,"_22829":93205,"_2311":93340},[],"Modo merged Gateway de Envoy",{"_2783":56036,"_24070":55983,"_16893":93342,"_5":16788,"_22829":93205,"_2311":93343},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2783":56037,"_24070":55983,"_16893":93345,"_5":16788,"_22829":93205,"_2311":93346},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2783":56038,"_24070":55983,"_16893":93348,"_5":16788,"_22829":93205,"_2311":93349},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2783":56039,"_24070":55983,"_16893":93351,"_5":16788,"_22829":93205,"_2311":93352},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2783":56040,"_24070":55983,"_16893":93354,"_5":16788,"_22829":93205,"_2311":93355},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2783":56041,"_24070":55983,"_16893":93357,"_5":16788,"_22829":93209,"_2311":93358},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2783":56042,"_24070":55983,"_16893":93360,"_5":16788,"_22829":93209,"_2311":93361},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2783":56043,"_24070":55983,"_16893":93363,"_5":16788,"_22829":93209,"_2311":93364},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2783":56044,"_24070":55983,"_16893":93366,"_5":16788,"_22829":93209,"_2311":93367},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2783":56045,"_24070":55983,"_16893":93369,"_5":16788,"_22829":93209,"_2311":93370},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2783":56046,"_24070":55983,"_16893":93372,"_5":16788,"_22829":93213,"_2311":93373},[],"Comprueba, en orden:",{"_2783":56047,"_24070":55983,"_16893":93375,"_5":16788,"_22829":93213,"_2311":93376},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2783":56048,"_24070":55983,"_16893":93378,"_5":16788,"_22829":93213,"_2311":93379},[],"Su estado contiene la dirección esperada.",{"_2783":56049,"_24070":55983,"_16893":93381,"_5":16788,"_22829":93213,"_2311":93382},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2783":56050,"_24070":55983,"_16893":93384,"_5":16788,"_22829":93213,"_2311":93385},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2783":56051,"_24070":55983,"_16893":93387,"_5":16788,"_22829":93213,"_2311":93388},[],"DNS resuelve al endpoint accesible externamente.",{"_2783":56052,"_24070":55983,"_16893":93390,"_5":16788,"_22829":93213,"_2311":93391},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2783":56053,"_24070":55983,"_16893":93393,"_5":16788,"_22829":93213,"_2311":93394},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2783":56054,"_24070":56054,"_5":11891,"_2311":39445,"_24406":93396,"_16893":93397,"_22829":56054},[39338,92482,92716],[],{"_2783":56055,"_24070":56054,"_16893":93399,"_5":16788,"_22829":56054,"_2311":93400},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2783":56056,"_24070":56054,"_5":24403,"_16893":93402,"_22829":93403,"_2311":93404},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2783":56057,"_24070":56054,"_5":24403,"_16893":93406,"_22829":93407,"_2311":93408},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2783":56058,"_24070":56054,"_5":24403,"_16893":93410,"_22829":93411,"_2311":93412},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2783":56059,"_24070":56054,"_5":24403,"_16893":93414,"_22829":93415,"_2311":93416},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2783":56060,"_24070":56054,"_5":24403,"_16893":93418,"_22829":93419,"_2311":93420},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2783":56061,"_24070":56054,"_5":24403,"_16893":93422,"_22829":93423,"_2311":93424},[],"/docs/pr-preview/pr-27/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2783":56062,"_24070":56054,"_16893":93426,"_5":16788,"_22829":93403,"_2311":93427},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2783":56063,"_24070":56054,"_16893":93429,"_5":16788,"_22829":93407,"_2311":93430},[],"Flujo",{"_2783":56064,"_24070":56054,"_16893":93432,"_5":16788,"_22829":93407,"_2311":93433},[],"Úsalo para",{"_2783":56065,"_24070":56054,"_16893":93435,"_5":16788,"_22829":93407,"_2311":93436},[],"Qué instala",{"_2783":56066,"_24070":56054,"_16893":93438,"_5":16788,"_22829":93407,"_2311":40329},[],{"_2783":56067,"_24070":56054,"_16893":93440,"_5":16788,"_22829":93407,"_2311":93441},[],"Producción y entornos controlados",{"_2783":56068,"_24070":56054,"_16893":93443,"_5":16788,"_22829":93407,"_2311":93444},[],"Servicios de Lamassu y recursos de Gateway API",{"_2783":56069,"_24070":56054,"_16893":93446,"_5":16788,"_22829":93407,"_2311":39582},[],{"_2783":56070,"_24070":56054,"_16893":93448,"_5":16788,"_22829":93407,"_2311":93449},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2783":56071,"_24070":56054,"_16893":93451,"_5":16788,"_22829":93407,"_2311":93452},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2783":56072,"_24070":56054,"_16893":93454,"_5":16788,"_22829":93411,"_2311":93455},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2783":56073,"_24070":56054,"_16893":93457,"_5":16788,"_22829":93411,"_2311":93458},[],"Área",{"_2783":56074,"_24070":56054,"_16893":93460,"_5":16788,"_22829":93411,"_2311":93461},[],"El chart de Lamassu proporciona",{"_2783":56075,"_24070":56054,"_16893":93463,"_5":16788,"_22829":93411,"_2311":93464},[],"Tú proporcionas",{"_2783":56076,"_24070":56054,"_16893":93466,"_5":16788,"_22829":93411,"_2311":93467},[],"Aplicaciones Lamassu",{"_2783":56077,"_24070":56054,"_16893":93469,"_5":16788,"_22829":93411,"_2311":93470},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2783":56078,"_24070":56054,"_16893":93472,"_5":16788,"_22829":93411,"_2311":93473},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2783":56079,"_24070":56054,"_16893":93475,"_5":16788,"_22829":93411,"_2311":93476},[],"Datos PostgreSQL",{"_2783":56080,"_24070":56054,"_16893":93478,"_5":16788,"_22829":93411,"_2311":93479},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2783":56081,"_24070":56054,"_16893":93481,"_5":16788,"_22829":93411,"_2311":93482},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2783":56082,"_24070":56054,"_16893":93484,"_5":16788,"_22829":93411,"_2311":93485},[],"Mensajería",{"_2783":56083,"_24070":56054,"_16893":93487,"_5":16788,"_22829":93411,"_2311":93488},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2783":56084,"_24070":56054,"_16893":93490,"_5":16788,"_22829":93411,"_2311":93491},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2783":56085,"_24070":56054,"_16893":93493,"_5":16788,"_22829":93411,"_2311":93494},[],"Identidad",{"_2783":56086,"_24070":56054,"_16893":93496,"_5":16788,"_22829":93411,"_2311":93497},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2783":56087,"_24070":56054,"_16893":93499,"_5":16788,"_22829":93411,"_2311":93500},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2783":56088,"_24070":56054,"_16893":93502,"_5":16788,"_22829":93411,"_2311":93503},[],"Enrutamiento externo",{"_2783":56089,"_24070":56054,"_16893":93505,"_5":16788,"_22829":93411,"_2311":93506},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2783":56090,"_24070":56054,"_16893":93508,"_5":16788,"_22829":93411,"_2311":93509},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2783":56091,"_24070":56054,"_16893":93511,"_5":16788,"_22829":93411,"_2311":40403},[],{"_2783":56092,"_24070":56054,"_16893":93513,"_5":16788,"_22829":93411,"_2311":93514},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2783":56093,"_24070":56054,"_16893":93516,"_5":16788,"_22829":93411,"_2311":93517},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2783":56094,"_24070":56054,"_16893":93519,"_5":16788,"_22829":93411,"_2311":93520},[],"Datos persistentes de la aplicación",{"_2783":56095,"_24070":56054,"_16893":93522,"_5":16788,"_22829":93411,"_2311":93523},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2783":56096,"_24070":56054,"_16893":93525,"_5":16788,"_22829":93411,"_2311":93526},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2783":56097,"_24070":56054,"_16893":93528,"_5":16788,"_22829":93411,"_2311":93529},[],"Integraciones opcionales",{"_2783":56098,"_24070":56054,"_16893":93531,"_5":16788,"_22829":93411,"_2311":93532},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2783":56099,"_24070":56054,"_16893":93534,"_5":16788,"_22829":93411,"_2311":93535},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2783":56100,"_24070":56054,"_16893":93537,"_5":16788,"_22829":93411,"_2311":93538},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2783":56101,"_24070":56054,"_16893":93540,"_5":16788,"_22829":93411,"_2311":93541},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2783":56102,"_24070":56054,"_16893":93543,"_5":16788,"_22829":93415,"_2311":93544},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2783":56103,"_24070":56054,"_16893":93546,"_5":16788,"_22829":93415,"_2311":93547},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2783":56104,"_24070":56054,"_16893":93549,"_5":16788,"_22829":93419,"_2311":93550},[],"Kubernetes 1.24 o posterior",{"_2783":56105,"_24070":56054,"_16893":93552,"_5":16788,"_22829":93419,"_2311":93553},[],"Helm 3.2 o posterior",{"_2783":56106,"_24070":56054,"_16893":93555,"_5":16788,"_22829":93419,"_2311":93556},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2783":56107,"_24070":56054,"_16893":93558,"_5":16788,"_22829":93419,"_2311":93559},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2783":56108,"_24070":56054,"_16893":93561,"_5":16788,"_22829":93419,"_2311":93562},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2783":56109,"_24070":56054,"_16893":93564,"_5":16788,"_22829":93419,"_2311":93565},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2783":56110,"_24070":56054,"_16893":93567,"_5":16788,"_22829":93419,"_2311":93568},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2783":56111,"_24070":56054,"_16893":93570,"_5":16788,"_22829":93423,"_2311":93571},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2783":56112,"_24070":56054,"_16893":93573,"_5":16788,"_22829":93423,"_2311":93574},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2783":56113,"_24070":56054,"_16893":93576,"_5":16788,"_22829":93423,"_2311":93577},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2783":56114,"_24070":56114,"_5":11891,"_2311":93579,"_24406":93580,"_16893":93582,"_22829":56114},"Resolución de problemas de despliegue",[39338,92482,93581],"Operación",[],{"_2783":56115,"_24070":56114,"_16893":93584,"_5":16788,"_22829":56114,"_2311":93585},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2783":56116,"_24070":56114,"_5":24403,"_16893":93587,"_22829":93588,"_2311":93589},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2783":56117,"_24070":56114,"_5":24403,"_16893":93591,"_22829":93592,"_2311":93593},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2783":56118,"_24070":56114,"_5":24403,"_16893":93595,"_22829":93596,"_2311":93597},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2783":56119,"_24070":56114,"_5":24403,"_16893":93599,"_22829":93600,"_2311":93601},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2783":56120,"_24070":56114,"_5":24403,"_16893":93603,"_22829":93604,"_2311":93605},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2783":56121,"_24070":56114,"_5":24403,"_16893":93607,"_22829":93608,"_2311":93609},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2783":56122,"_24070":56114,"_5":24403,"_16893":93611,"_22829":93612,"_2311":93613},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2783":56123,"_24070":56114,"_5":24403,"_16893":93615,"_22829":93616,"_2311":93617},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2783":56124,"_24070":56114,"_5":24403,"_16893":93619,"_22829":93620,"_2311":93621},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2783":56125,"_24070":56114,"_5":24403,"_16893":93623,"_22829":93624,"_2311":93625},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2783":56126,"_24070":56114,"_5":24403,"_16893":93627,"_22829":93628,"_2311":93629},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2783":56127,"_24070":56114,"_5":24403,"_16893":93631,"_22829":93632,"_2311":93633},[],"/docs/pr-preview/pr-27/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2783":56128,"_24070":56114,"_16893":93635,"_5":16788,"_22829":56114,"_2311":93636},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2783":56129,"_24070":56114,"_16893":93638,"_5":16788,"_22829":93592,"_2311":93639},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2783":56130,"_24070":56114,"_16893":93641,"_5":16788,"_22829":93596,"_2311":93642},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2783":56131,"_24070":56114,"_16893":93644,"_5":16788,"_22829":93600,"_2311":93645},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2783":56132,"_24070":56114,"_16893":93647,"_5":16788,"_22829":93604,"_2311":93648},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2783":56133,"_24070":56114,"_16893":93650,"_5":16788,"_22829":93608,"_2311":93651},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2783":56134,"_24070":56114,"_16893":93653,"_5":16788,"_22829":93612,"_2311":93654},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2783":56135,"_24070":56114,"_16893":93656,"_5":16788,"_22829":93612,"_2311":93657},[],"Ejecuta también la prueba de conectividad del chart:",{"_2783":56136,"_24070":56114,"_16893":93659,"_5":16788,"_22829":93612,"_2311":93660},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2783":56137,"_24070":56114,"_16893":93662,"_5":16788,"_22829":93612,"_2311":93663},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2783":56138,"_24070":56114,"_16893":93665,"_5":16788,"_22829":93616,"_2311":93666},[],"Si recibes un 401:",{"_2783":56139,"_24070":56114,"_16893":93668,"_5":16788,"_22829":93616,"_2311":93669},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2783":56140,"_24070":56114,"_16893":93671,"_5":16788,"_22829":93616,"_2311":93672},[],"verifica emisor, audiencia y expiración del token;",{"_2783":56141,"_24070":56114,"_16893":93674,"_5":16788,"_22829":93616,"_2311":93675},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2783":56142,"_24070":56114,"_16893":93677,"_5":16788,"_22829":93616,"_2311":93678},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2783":56143,"_24070":56114,"_16893":93680,"_5":16788,"_22829":93616,"_2311":93681},[],"Si el login termina pero las APIs devuelven 403:",{"_2783":56144,"_24070":56114,"_16893":93683,"_5":16788,"_22829":93616,"_2311":93684},[],"inspecciona los claims reales del token;",{"_2783":56145,"_24070":56114,"_16893":93686,"_5":16788,"_22829":93616,"_2311":93687},[],"confirma que coinciden con un principal activo;",{"_2783":56146,"_24070":56114,"_16893":93689,"_5":16788,"_22829":93616,"_2311":93690},[],"revisa las políticas concedidas al principal;",{"_2783":56147,"_24070":56114,"_16893":93692,"_5":16788,"_22829":93616,"_2311":93693},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2783":56148,"_24070":56114,"_16893":93695,"_5":16788,"_22829":93616,"_2311":93696},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2783":56149,"_24070":56114,"_16893":93698,"_5":16788,"_22829":93620,"_2311":93699},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2783":56150,"_24070":56114,"_16893":93701,"_5":16788,"_22829":93620,"_2311":93702},[],"Localiza el pod y Service de authz.",{"_2783":56151,"_24070":56114,"_16893":93704,"_5":16788,"_22829":93620,"_2311":93705},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2783":56152,"_24070":56114,"_16893":93707,"_5":16788,"_22829":93620,"_2311":93708},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2783":56153,"_24070":56114,"_16893":93710,"_5":16788,"_22829":93620,"_2311":93711},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2783":56154,"_24070":56114,"_16893":93713,"_5":16788,"_22829":93620,"_2311":93714},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2783":56155,"_24070":56114,"_16893":93716,"_5":16788,"_22829":93624,"_2311":93717},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2783":56156,"_24070":56114,"_16893":93719,"_5":16788,"_22829":93624,"_2311":93720},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2783":56157,"_24070":56114,"_16893":93722,"_5":16788,"_22829":93624,"_2311":93723},[],"volumen persistente sin enlazar;",{"_2783":56158,"_24070":56114,"_16893":93725,"_5":16788,"_22829":93624,"_2311":93726},[],"imagen inaccesible o política de pull incorrecta;",{"_2783":56159,"_24070":56114,"_16893":93728,"_5":16788,"_22829":93624,"_2311":93729},[],"configuración inválida del motor criptográfico;",{"_2783":56160,"_24070":56114,"_16893":93731,"_5":16788,"_22829":93624,"_2311":93732},[],"límites de CPU o memoria demasiado bajos;",{"_2783":56161,"_24070":56114,"_16893":93734,"_5":16788,"_22829":93624,"_2311":93735},[],"migración previa incompleta.",{"_2783":56162,"_24070":56114,"_16893":93737,"_5":16788,"_22829":93624,"_2311":93738},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2783":56163,"_24070":56114,"_16893":93740,"_5":16788,"_22829":93624,"_2311":93741},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2783":56164,"_24070":56114,"_16893":93743,"_5":16788,"_22829":93628,"_2311":93744},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2783":56165,"_24070":56114,"_16893":93746,"_5":16788,"_22829":93628,"_2311":93747},[],"verifica que esté habilitado en el servicio emisor;",{"_2783":56166,"_24070":56114,"_16893":93749,"_5":16788,"_22829":93628,"_2311":93750},[],"comprueba conectividad y credenciales AMQP;",{"_2783":56167,"_24070":56114,"_16893":93752,"_5":16788,"_22829":93628,"_2311":93753},[],"revisa exchange, routing key, colas y consumidores;",{"_2783":56168,"_24070":56114,"_16893":93755,"_5":16788,"_22829":93628,"_2311":93756},[],"inspecciona dead-letter queues;",{"_2783":56169,"_24070":56114,"_16893":93758,"_5":16788,"_22829":93628,"_2311":93759},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2783":56170,"_24070":56114,"_16893":93761,"_5":16788,"_22829":93628,"_2311":93762},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2783":56171,"_24070":56114,"_16893":93764,"_5":16788,"_22829":93632,"_2311":93765},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2783":56172,"_24070":56114,"_16893":93767,"_5":16788,"_22829":93632,"_2311":93768},[],"Antes de cerrar una incidencia, guarda:",{"_2783":56173,"_24070":56114,"_16893":93770,"_5":16788,"_22829":93632,"_2311":93771},[],"causa confirmada;",{"_2783":56174,"_24070":56114,"_16893":93773,"_5":16788,"_22829":93632,"_2311":93774},[],"alcance temporal y recursos afectados;",{"_2783":56175,"_24070":56114,"_16893":93776,"_5":16788,"_22829":93632,"_2311":93777},[],"comandos o consultas utilizados;",{"_2783":56176,"_24070":56114,"_16893":93779,"_5":16788,"_22829":93632,"_2311":93780},[],"cambio aplicado y forma de revertirlo;",{"_2783":56177,"_24070":56114,"_16893":93782,"_5":16788,"_22829":93632,"_2311":93783},[],"validación desde un consumidor;",{"_2783":56178,"_24070":56114,"_16893":93785,"_5":16788,"_22829":93632,"_2311":93786},[],"acción preventiva y propietario.",{"_2783":56179,"_24070":56179,"_5":11891,"_2311":93788,"_24406":93789,"_16893":93792,"_22829":56179},"Control de acceso",[39338,93790,93791],"Plataforma","Administración",[],{"_2783":56180,"_24070":56179,"_16893":93794,"_5":16788,"_22829":56179,"_2311":93795},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2783":56181,"_24070":56179,"_5":24403,"_16893":93797,"_22829":93798,"_2311":93799},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2783":56182,"_24070":56179,"_5":24403,"_16893":93801,"_22829":93802,"_2311":93803},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2783":56183,"_24070":56179,"_5":24403,"_16893":93805,"_22829":93806,"_2311":93807},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2783":56184,"_24070":56179,"_5":24403,"_16893":93809,"_22829":93810,"_2311":93811},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2783":56185,"_24070":56179,"_5":24403,"_16893":93813,"_22829":93814,"_2311":93815},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2783":56186,"_24070":56179,"_5":24403,"_16893":93817,"_22829":93818,"_2311":93819},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2783":56187,"_24070":56179,"_5":24403,"_16893":93821,"_22829":93822,"_2311":93823},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2783":56188,"_24070":56179,"_5":24403,"_16893":93825,"_22829":93826,"_2311":93827},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2783":56189,"_24070":56179,"_5":24403,"_16893":93829,"_22829":93830,"_2311":93831},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2783":56190,"_24070":56179,"_5":24403,"_16893":93833,"_22829":93834,"_2311":93835},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2783":56191,"_24070":56179,"_5":24403,"_16893":93837,"_22829":93838,"_2311":93839},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2783":56192,"_24070":56179,"_5":24403,"_16893":93841,"_22829":93842,"_2311":93843},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2783":56193,"_24070":56179,"_5":24403,"_16893":93845,"_22829":93846,"_2311":93847},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2783":56194,"_24070":56179,"_5":24403,"_16893":93849,"_22829":93850,"_2311":93851},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2783":56195,"_24070":56179,"_5":24403,"_16893":93853,"_22829":93854,"_2311":93052},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2783":56196,"_24070":56179,"_5":24403,"_16893":93856,"_22829":93857,"_2311":93858},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2783":56197,"_24070":56179,"_5":24403,"_16893":93860,"_22829":93861,"_2311":93862},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2783":56198,"_24070":56179,"_5":24403,"_16893":93864,"_22829":93865,"_2311":93866},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2783":56199,"_24070":56179,"_5":24403,"_16893":93868,"_22829":93869,"_2311":93870},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2783":56200,"_24070":56179,"_5":24403,"_16893":93872,"_22829":93873,"_2311":93874},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2783":56201,"_24070":56179,"_5":24403,"_16893":93876,"_22829":93877,"_2311":93878},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2783":56202,"_24070":56179,"_5":24403,"_16893":93880,"_22829":93881,"_2311":93882},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2783":56203,"_24070":56179,"_5":24403,"_16893":93884,"_22829":93885,"_2311":93886},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2783":56204,"_24070":56179,"_5":24403,"_16893":93888,"_22829":93889,"_2311":93890},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2783":56205,"_24070":56179,"_5":24403,"_16893":93892,"_22829":93893,"_2311":93894},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2783":56206,"_24070":56179,"_5":24403,"_16893":93896,"_22829":93897,"_2311":93898},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2783":56207,"_24070":56179,"_5":24403,"_16893":93900,"_22829":93901,"_2311":93902},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2783":56208,"_24070":56179,"_5":24403,"_16893":93904,"_22829":93905,"_2311":93906},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2783":56209,"_24070":56179,"_5":24403,"_16893":93908,"_22829":93909,"_2311":93910},[],"/docs/pr-preview/pr-27/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2783":56210,"_24070":56179,"_16893":93912,"_5":16788,"_22829":56179,"_2311":93913},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2783":56211,"_24070":56179,"_16893":93915,"_5":16788,"_22829":56179,"_2311":93916},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2783":56212,"_24070":56179,"_16893":93918,"_5":16788,"_22829":56179,"_2311":93919},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2783":56213,"_24070":56179,"_16893":93921,"_5":16788,"_22829":93798,"_2311":93922},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2783":56214,"_24070":56179,"_16893":93924,"_5":16788,"_22829":93798,"_2311":93925},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2783":56215,"_24070":56179,"_16893":93927,"_5":16788,"_22829":93798,"_2311":93928},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2783":56216,"_24070":56179,"_16893":93930,"_5":16788,"_22829":93798,"_2311":93931},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2783":56217,"_24070":56179,"_16893":93933,"_5":16788,"_22829":93798,"_2311":93934},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2783":56218,"_24070":56179,"_16893":93936,"_5":16788,"_22829":93798,"_2311":93937},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y alguna de sus políticas debe permitir la operación solicitada.",{"_2783":56219,"_24070":56179,"_16893":93939,"_5":16788,"_22829":93802,"_2311":93940},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2783":56220,"_24070":56179,"_16893":93942,"_5":16788,"_22829":93802,"_2311":93943},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2783":56221,"_24070":56179,"_16893":93945,"_5":16788,"_22829":93806,"_2311":93946},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2783":56222,"_24070":56179,"_16893":93948,"_5":16788,"_22829":93806,"_2311":93949},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2783":56223,"_24070":56179,"_16893":93951,"_5":16788,"_22829":93806,"_2311":93952},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2783":56224,"_24070":56179,"_16893":93954,"_5":16788,"_22829":93806,"_2311":93955},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2783":56225,"_24070":56179,"_16893":93957,"_5":16788,"_22829":93806,"_2311":93958},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2783":56226,"_24070":56179,"_16893":93960,"_5":16788,"_22829":93806,"_2311":93961},[],"Carga por separado las políticas concedidas a cada principal.",{"_2783":56227,"_24070":56179,"_16893":93963,"_5":16788,"_22829":93806,"_2311":93964},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2783":56228,"_24070":56179,"_16893":93966,"_5":16788,"_22829":93806,"_2311":93967},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2783":56229,"_24070":56179,"_16893":93969,"_5":16788,"_22829":93806,"_2311":93970},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política.",{"_2783":56230,"_24070":56179,"_16893":93972,"_5":16788,"_22829":93806,"_2311":93973},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2783":56231,"_24070":56179,"_16893":93975,"_5":16788,"_22829":93806,"_2311":93976},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2783":56232,"_24070":56179,"_16893":93978,"_5":16788,"_22829":93806,"_2311":93979},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, el esquema debe declarar una restricción que relacione un valor de la petición con un atributo normalizado del principal.",{"_2783":56233,"_24070":56179,"_16893":93981,"_5":16788,"_22829":93810,"_2311":93982},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2783":56234,"_24070":56179,"_16893":93984,"_5":16788,"_22829":93810,"_2311":93985},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2783":56235,"_24070":56179,"_16893":93987,"_5":16788,"_22829":93810,"_2311":93988},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2783":56236,"_24070":56179,"_16893":93990,"_5":16788,"_22829":93810,"_2311":93991},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2783":56237,"_24070":56179,"_16893":93993,"_5":16788,"_22829":93810,"_2311":93994},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2783":56238,"_24070":56179,"_16893":93996,"_5":16788,"_22829":93810,"_2311":93997},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2783":56239,"_24070":56179,"_16893":93999,"_5":16788,"_22829":93810,"_2311":94000},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2783":56240,"_24070":56179,"_16893":94002,"_5":16788,"_22829":93810,"_2311":94003},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2783":56241,"_24070":56179,"_16893":94005,"_5":16788,"_22829":93810,"_2311":94006},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2783":56242,"_24070":56179,"_16893":94008,"_5":16788,"_22829":93810,"_2311":94009},[],"Las acciones se dividen en dos grupos:",{"_2783":56243,"_24070":56179,"_16893":94011,"_5":16788,"_22829":93810,"_2311":94012},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2783":56244,"_24070":56179,"_16893":94014,"_5":16788,"_22829":93810,"_2311":94015},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2783":56245,"_24070":56179,"_16893":94017,"_5":16788,"_22829":93810,"_2311":94018},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2783":56246,"_24070":56179,"_16893":94020,"_5":16788,"_22829":93814,"_2311":94021},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2783":56247,"_24070":56179,"_16893":94023,"_5":16788,"_22829":93814,"_2311":94024},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2783":56248,"_24070":56179,"_16893":94026,"_5":16788,"_22829":93814,"_2311":94027},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega. Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2783":56249,"_24070":56179,"_16893":94029,"_5":16788,"_22829":93818,"_2311":94030},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2783":56250,"_24070":56179,"_16893":94032,"_5":16788,"_22829":93818,"_2311":94033},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2783":56251,"_24070":56179,"_16893":94035,"_5":16788,"_22829":93818,"_2311":94036},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2783":56252,"_24070":56179,"_16893":94038,"_5":16788,"_22829":93818,"_2311":94039},[],"Los operadores implementados son:",{"_2783":56253,"_24070":56179,"_16893":94041,"_5":16788,"_22829":93818,"_2311":94042},[],"`equals`, para igualdad exacta;",{"_2783":56254,"_24070":56179,"_16893":94044,"_5":16788,"_22829":93818,"_2311":94045},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2783":56255,"_24070":56179,"_16893":94047,"_5":16788,"_22829":93818,"_2311":94048},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2783":56256,"_24070":56179,"_16893":94050,"_5":16788,"_22829":93818,"_2311":94051},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2783":56257,"_24070":56179,"_16893":94053,"_5":16788,"_22829":93822,"_2311":94054},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2783":56258,"_24070":56179,"_16893":94056,"_5":16788,"_22829":93822,"_2311":94057},[],"Los modos disponibles son:",{"_2783":56259,"_24070":56179,"_16893":94059,"_5":16788,"_22829":93822,"_2311":94060},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2783":56260,"_24070":56179,"_16893":94062,"_5":16788,"_22829":93822,"_2311":94063},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2783":56261,"_24070":56179,"_16893":94065,"_5":16788,"_22829":93822,"_2311":94066},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2783":56262,"_24070":56179,"_16893":94068,"_5":16788,"_22829":93822,"_2311":94069},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2783":56263,"_24070":56179,"_16893":94071,"_5":16788,"_22829":93822,"_2311":94072},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2783":56264,"_24070":56179,"_16893":94074,"_5":16788,"_22829":93822,"_2311":94075},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2783":56265,"_24070":56179,"_16893":94077,"_5":16788,"_22829":93826,"_2311":94078},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2783":56266,"_24070":56179,"_16893":94080,"_5":16788,"_22829":93826,"_2311":94081},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2783":56267,"_24070":56179,"_16893":94083,"_5":16788,"_22829":93826,"_2311":94084},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2783":56268,"_24070":56179,"_16893":94086,"_5":16788,"_22829":93826,"_2311":94087},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2783":56269,"_24070":56179,"_16893":94089,"_5":16788,"_22829":93834,"_2311":94090},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2783":56270,"_24070":56179,"_16893":94092,"_5":16788,"_22829":93834,"_2311":94093},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2783":56271,"_24070":56179,"_16893":94095,"_5":16788,"_22829":93838,"_2311":94096},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2783":56272,"_24070":56179,"_16893":94098,"_5":16788,"_22829":93838,"_2311":94099},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2783":56273,"_24070":56179,"_16893":94101,"_5":16788,"_22829":93842,"_2311":94102},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2783":56274,"_24070":56179,"_16893":94104,"_5":16788,"_22829":93842,"_2311":94105},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2783":56275,"_24070":56179,"_16893":94107,"_5":16788,"_22829":93842,"_2311":94108},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2783":56276,"_24070":56179,"_16893":94110,"_5":16788,"_22829":93846,"_2311":94111},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2783":56277,"_24070":56179,"_16893":94113,"_5":16788,"_22829":93846,"_2311":94114},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2783":56278,"_24070":56179,"_16893":94116,"_5":16788,"_22829":93846,"_2311":94117},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2783":56279,"_24070":56179,"_16893":94119,"_5":16788,"_22829":93850,"_2311":94120},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2783":56280,"_24070":56179,"_16893":94122,"_5":16788,"_22829":93850,"_2311":94123},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2783":56281,"_24070":56179,"_16893":94125,"_5":16788,"_22829":93850,"_2311":94126},[],"acceso completo y de solo lectura a KMS;",{"_2783":56282,"_24070":56179,"_16893":94128,"_5":16788,"_22829":93850,"_2311":94129},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2783":56283,"_24070":56179,"_16893":94131,"_5":16788,"_22829":93850,"_2311":94132},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2783":56284,"_24070":56179,"_16893":94134,"_5":16788,"_22829":93850,"_2311":94135},[],"acceso a la interfaz;",{"_2783":56285,"_24070":56179,"_16893":94137,"_5":16788,"_22829":93850,"_2311":94138},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2783":56286,"_24070":56179,"_16893":94140,"_5":16788,"_22829":93850,"_2311":94141},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2783":56287,"_24070":56179,"_16893":94143,"_5":16788,"_22829":93850,"_2311":94144},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2783":56288,"_24070":56179,"_16893":94146,"_5":16788,"_22829":93854,"_2311":94147},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2783":56289,"_24070":56179,"_16893":94149,"_5":16788,"_22829":93854,"_2311":94150},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2783":56290,"_24070":56179,"_16893":94152,"_5":16788,"_22829":93854,"_2311":94153},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2783":56291,"_24070":56179,"_16893":94155,"_5":16788,"_22829":93857,"_2311":94156},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2783":56292,"_24070":56179,"_16893":94158,"_5":16788,"_22829":93861,"_2311":94159},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2783":56293,"_24070":56179,"_16893":94161,"_5":16788,"_22829":93865,"_2311":94162},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2783":56294,"_24070":56179,"_16893":94164,"_5":16788,"_22829":93869,"_2311":94165},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2783":56295,"_24070":56179,"_16893":94167,"_5":16788,"_22829":93873,"_2311":94168},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2783":56296,"_24070":56179,"_16893":94170,"_5":16788,"_22829":93877,"_2311":94171},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2783":56297,"_24070":56179,"_16893":94173,"_5":16788,"_22829":93877,"_2311":94174},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2783":56298,"_24070":56179,"_16893":94176,"_5":16788,"_22829":93881,"_2311":94177},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2783":56299,"_24070":56179,"_16893":94179,"_5":16788,"_22829":93881,"_2311":94180},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2783":56300,"_24070":56179,"_16893":94182,"_5":16788,"_22829":93881,"_2311":94183},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2783":56301,"_24070":56179,"_16893":94185,"_5":16788,"_22829":93881,"_2311":94186},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2783":56302,"_24070":56179,"_16893":94188,"_5":16788,"_22829":93881,"_2311":94189},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2783":56303,"_24070":56179,"_16893":94191,"_5":16788,"_22829":93881,"_2311":94192},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2783":56304,"_24070":56179,"_16893":94194,"_5":16788,"_22829":93881,"_2311":94195},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2783":56305,"_24070":56179,"_16893":94197,"_5":16788,"_22829":93881,"_2311":94198},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2783":56306,"_24070":56179,"_16893":94200,"_5":16788,"_22829":93885,"_2311":94201},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2783":56307,"_24070":56179,"_16893":94203,"_5":16788,"_22829":93885,"_2311":94204},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2783":56308,"_24070":56179,"_16893":94206,"_5":16788,"_22829":93885,"_2311":94207},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2783":56309,"_24070":56179,"_16893":94209,"_5":16788,"_22829":93889,"_2311":94210},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2783":56310,"_24070":56179,"_16893":94212,"_5":16788,"_22829":93889,"_2311":94213},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2783":56311,"_24070":56179,"_16893":94215,"_5":16788,"_22829":93889,"_2311":94216},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2783":56312,"_24070":56179,"_16893":94218,"_5":16788,"_22829":93889,"_2311":94219},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2783":56313,"_24070":56179,"_16893":94221,"_5":16788,"_22829":93889,"_2311":94222},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2783":56314,"_24070":56179,"_16893":94224,"_5":16788,"_22829":93889,"_2311":94225},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2783":56315,"_24070":56179,"_16893":94227,"_5":16788,"_22829":93889,"_2311":94228},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2783":56316,"_24070":56179,"_16893":94230,"_5":16788,"_22829":93897,"_2311":94231},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2783":56317,"_24070":56179,"_16893":94233,"_5":16788,"_22829":93901,"_2311":94234},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2783":56318,"_24070":56179,"_16893":94236,"_5":16788,"_22829":93901,"_2311":94237},[],"que exista un principal activo del tipo correcto;",{"_2783":56319,"_24070":56179,"_16893":94239,"_5":16788,"_22829":93901,"_2311":94240},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2783":56320,"_24070":56179,"_16893":94242,"_5":16788,"_22829":93901,"_2311":94243},[],"que todas las condiciones del principal se cumplan;",{"_2783":56321,"_24070":56179,"_16893":94245,"_5":16788,"_22829":93901,"_2311":94246},[],"que el principal tenga concedida la política esperada;",{"_2783":56322,"_24070":56179,"_16893":94248,"_5":16788,"_22829":93901,"_2311":94249},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2783":56323,"_24070":56179,"_16893":94251,"_5":16788,"_22829":93901,"_2311":94252},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2783":56324,"_24070":56179,"_16893":94254,"_5":16788,"_22829":93901,"_2311":94255},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos.",{"_2783":56325,"_24070":56179,"_16893":94257,"_5":16788,"_22829":93905,"_2311":94258},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2783":56326,"_24070":56179,"_16893":94260,"_5":16788,"_22829":93909,"_2311":94261},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2783":56327,"_24070":56179,"_16893":94263,"_5":16788,"_22829":93909,"_2311":94264},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2783":56328,"_24070":56328,"_5":11891,"_2311":94266,"_24406":94267,"_16893":94268,"_22829":56328},"Alertas y suscripciones",[39338,93790,93791],[],{"_2783":56329,"_24070":56328,"_16893":94270,"_5":16788,"_22829":56328,"_2311":94271},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2783":56330,"_24070":56328,"_5":24403,"_16893":94273,"_22829":94274,"_2311":94275},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2783":56331,"_24070":56328,"_5":24403,"_16893":94277,"_22829":94278,"_2311":94279},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2783":56332,"_24070":56328,"_5":24403,"_16893":94281,"_22829":94282,"_2311":94283},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2783":56333,"_24070":56328,"_5":24403,"_16893":94285,"_22829":94286,"_2311":94287},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2783":56334,"_24070":56328,"_5":24403,"_16893":94289,"_22829":94290,"_2311":94291},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2783":56335,"_24070":56328,"_5":24403,"_16893":94293,"_22829":94294,"_2311":94295},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2783":56336,"_24070":56328,"_5":24403,"_16893":94297,"_22829":94298,"_2311":94299},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2783":56337,"_24070":56328,"_5":24403,"_16893":94301,"_22829":94302,"_2311":94303},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2783":56338,"_24070":56328,"_5":24403,"_16893":94305,"_22829":94306,"_2311":94307},[],"/docs/pr-preview/pr-27/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2783":56339,"_24070":56328,"_16893":94309,"_5":16788,"_22829":56328,"_2311":94310},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2783":56340,"_24070":56328,"_16893":94312,"_5":16788,"_22829":94274,"_2311":94313},[],"Un servicio publica un evento de dominio.",{"_2783":56341,"_24070":56328,"_16893":94315,"_5":16788,"_22829":94274,"_2311":94316},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2783":56342,"_24070":56328,"_16893":94318,"_5":16788,"_22829":94274,"_2311":94319},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2783":56343,"_24070":56328,"_16893":94321,"_5":16788,"_22829":94274,"_2311":94322},[],"Lamassu entrega el evento al canal configurado.",{"_2783":56344,"_24070":56328,"_16893":94324,"_5":16788,"_22829":94274,"_2311":94325},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2783":56345,"_24070":56328,"_16893":94327,"_5":16788,"_22829":94278,"_2311":94328},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino.",{"_2783":56346,"_24070":56328,"_16893":94330,"_5":16788,"_22829":94278,"_2311":94331},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2783":56347,"_24070":56328,"_16893":94333,"_5":16788,"_22829":94278,"_2311":94334},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2783":56348,"_24070":56328,"_16893":94336,"_5":16788,"_22829":94286,"_2311":94337},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2783":56349,"_24070":56328,"_16893":94339,"_5":16788,"_22829":94290,"_2311":94340},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2783":56350,"_24070":56328,"_16893":94342,"_5":16788,"_22829":94294,"_2311":94343},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2783":56351,"_24070":56328,"_16893":94345,"_5":16788,"_22829":94294,"_2311":94346},[],"**None** notifica todas las instancias del evento.",{"_2783":56352,"_24070":56328,"_16893":94348,"_5":16788,"_22829":94294,"_2311":94349},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2783":56353,"_24070":56328,"_16893":94351,"_5":16788,"_22829":94294,"_2311":94352},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2783":56354,"_24070":56328,"_16893":94354,"_5":16788,"_22829":94294,"_2311":94355},[],"**JavaScript** permite expresar lógica personalizada.",{"_2783":56355,"_24070":56328,"_16893":94357,"_5":16788,"_22829":94294,"_2311":94358},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2783":56356,"_24070":56328,"_16893":94360,"_5":16788,"_22829":94298,"_2311":94361},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2783":56357,"_24070":56328,"_16893":94363,"_5":16788,"_22829":94302,"_2311":94364},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2783":56358,"_24070":56328,"_16893":94366,"_5":16788,"_22829":94306,"_2311":94367},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2783":56359,"_24070":56328,"_16893":94369,"_5":16788,"_22829":94306,"_2311":94370},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2783":56360,"_24070":56328,"_16893":94372,"_5":16788,"_22829":94306,"_2311":94373},[],"**Perfiles:** `profile.create`, `profile.update` y `profile.delete`.",{"_2783":56361,"_24070":56328,"_16893":94375,"_5":16788,"_22829":94306,"_2311":94376},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2783":56362,"_24070":56328,"_16893":94378,"_5":16788,"_22829":94306,"_2311":94379},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2783":56363,"_24070":56328,"_16893":94381,"_5":16788,"_22829":94306,"_2311":94382},[],"**Validación:** `va.role.crl.create`.",{"_2783":56364,"_24070":56328,"_16893":94384,"_5":16788,"_22829":94306,"_2311":94385},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign.message` y `kms.delete`.",{"_2783":56365,"_24070":56328,"_16893":94387,"_5":16788,"_22829":94306,"_2311":94388},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2783":56366,"_24070":56366,"_5":11891,"_2311":94390,"_24406":94391,"_16893":94392,"_22829":56366},"Registros de auditoría",[39338,93790,93791],[],{"_2783":56367,"_24070":56366,"_16893":94394,"_5":16788,"_22829":56366,"_2311":94395},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2783":56368,"_24070":56366,"_5":24403,"_16893":94397,"_22829":94398,"_2311":94399},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2783":56369,"_24070":56366,"_5":24403,"_16893":94401,"_22829":94402,"_2311":94403},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2783":56370,"_24070":56366,"_5":24403,"_16893":94405,"_22829":94406,"_2311":94407},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2783":56371,"_24070":56366,"_5":24403,"_16893":94409,"_22829":94410,"_2311":94411},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2783":56372,"_24070":56366,"_5":24403,"_16893":94413,"_22829":94414,"_2311":94415},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2783":56373,"_24070":56366,"_5":24403,"_16893":94417,"_22829":94418,"_2311":94419},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2783":56374,"_24070":56366,"_5":24403,"_16893":94421,"_22829":94422,"_2311":94423},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2783":56375,"_24070":56366,"_5":24403,"_16893":94425,"_22829":94426,"_2311":94427},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2783":56376,"_24070":56366,"_5":24403,"_16893":94429,"_22829":94430,"_2311":94431},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2783":56377,"_24070":56366,"_5":24403,"_16893":94433,"_22829":94434,"_2311":94435},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2783":56378,"_24070":56366,"_5":24403,"_16893":94437,"_22829":94438,"_2311":94439},[],"/docs/pr-preview/pr-27/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2783":56379,"_24070":56366,"_16893":94441,"_5":16788,"_22829":56366,"_2311":94442},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2783":56380,"_24070":56366,"_16893":94444,"_5":16788,"_22829":94398,"_2311":94445},[],"El cuerpo de auditoría incluye:",{"_2783":56381,"_24070":56366,"_16893":94447,"_5":16788,"_22829":94398,"_2311":94448},[],"input: datos recibidos por la operación;",{"_2783":56382,"_24070":56366,"_16893":94450,"_5":16788,"_22829":94398,"_2311":94451},[],"has\\_error: indica si el servicio devolvió un error;",{"_2783":56383,"_24070":56366,"_16893":94453,"_5":16788,"_22829":94398,"_2311":94454},[],"output: resultado producido o mensaje de error;",{"_2783":56384,"_24070":56366,"_16893":94456,"_5":16788,"_22829":94398,"_2311":94457},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2783":56385,"_24070":56366,"_16893":94459,"_5":16788,"_22829":94398,"_2311":94460},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2783":56386,"_24070":56366,"_16893":94462,"_5":16788,"_22829":94398,"_2311":94463},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2783":56387,"_24070":56366,"_16893":94465,"_5":16788,"_22829":94402,"_2311":94466},[],"El backend aplica auditoría a mutaciones de:",{"_2783":56388,"_24070":56366,"_16893":94468,"_5":16788,"_22829":94402,"_2311":94469},[],"autoridades, certificados y perfiles de emisión;",{"_2783":56389,"_24070":56366,"_16893":94471,"_5":16788,"_22829":94402,"_2311":94472},[],"claves y motores KMS;",{"_2783":56390,"_24070":56366,"_16893":94474,"_5":16788,"_22829":94402,"_2311":94475},[],"dispositivos e identidades;",{"_2783":56391,"_24070":56366,"_16893":94477,"_5":16788,"_22829":94402,"_2311":94478},[],"DMS y operaciones de enrolamiento;",{"_2783":56392,"_24070":56366,"_16893":94480,"_5":16788,"_22829":94402,"_2311":94481},[],"funciones de validación y CRL;",{"_2783":56393,"_24070":56366,"_16893":94483,"_5":16788,"_22829":94402,"_2311":94484},[],"principales, políticas y concesiones de autorización.",{"_2783":56394,"_24070":56366,"_16893":94486,"_5":16788,"_22829":94402,"_2311":94487},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2783":56395,"_24070":56366,"_16893":94489,"_5":16788,"_22829":94406,"_2311":94490},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2783":56396,"_24070":56366,"_16893":94492,"_5":16788,"_22829":94406,"_2311":94493},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2783":56397,"_24070":56366,"_16893":94495,"_5":16788,"_22829":94406,"_2311":94496},[],"Diseña el consumidor para:",{"_2783":56398,"_24070":56366,"_16893":94498,"_5":16788,"_22829":94406,"_2311":94499},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2783":56399,"_24070":56366,"_16893":94501,"_5":16788,"_22829":94406,"_2311":94502},[],"conservar el CloudEvent completo sin modificar;",{"_2783":56400,"_24070":56366,"_16893":94504,"_5":16788,"_22829":94406,"_2311":94505},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2783":56401,"_24070":56366,"_16893":94507,"_5":16788,"_22829":94406,"_2311":94508},[],"cifrar en tránsito y en reposo;",{"_2783":56402,"_24070":56366,"_16893":94510,"_5":16788,"_22829":94406,"_2311":94511},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2783":56403,"_24070":56366,"_16893":94513,"_5":16788,"_22829":94406,"_2311":94514},[],"aplicar una política explícita de retención y legal hold;",{"_2783":56404,"_24070":56366,"_16893":94516,"_5":16788,"_22829":94406,"_2311":94517},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2783":56405,"_24070":56366,"_16893":94519,"_5":16788,"_22829":94410,"_2311":94520},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2783":56406,"_24070":56366,"_16893":94522,"_5":16788,"_22829":94410,"_2311":94523},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2783":56407,"_24070":56366,"_16893":94525,"_5":16788,"_22829":94418,"_2311":94526},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2783":56408,"_24070":56366,"_16893":94528,"_5":16788,"_22829":94422,"_2311":94529},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2783":56409,"_24070":56366,"_16893":94531,"_5":16788,"_22829":94426,"_2311":94532},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2783":56410,"_24070":56366,"_16893":94534,"_5":16788,"_22829":94430,"_2311":94535},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2783":56411,"_24070":56366,"_16893":94537,"_5":16788,"_22829":94434,"_2311":94538},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2783":56412,"_24070":56366,"_16893":94540,"_5":16788,"_22829":94438,"_2311":94541},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2783":56413,"_24070":56366,"_16893":94543,"_5":16788,"_22829":94438,"_2311":94544},[],"aparece un evento de auditoría correcto;",{"_2783":56414,"_24070":56366,"_16893":94546,"_5":16788,"_22829":94438,"_2311":94547},[],"el principal coincide con la identidad utilizada;",{"_2783":56415,"_24070":56366,"_16893":94549,"_5":16788,"_22829":94438,"_2311":94550},[],"el consumidor lo persiste una sola vez;",{"_2783":56416,"_24070":56366,"_16893":94552,"_5":16788,"_22829":94438,"_2311":94553},[],"puede recuperarse por recurso, actor y periodo;",{"_2783":56417,"_24070":56366,"_16893":94555,"_5":16788,"_22829":94438,"_2311":94556},[],"una interrupción del consumidor produce una alerta.",{"_2783":56418,"_24070":56366,"_16893":94558,"_5":16788,"_22829":94438,"_2311":94559},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2783":56419,"_24070":56419,"_5":11891,"_2311":94561,"_24406":94562,"_16893":94563,"_22829":56419},"Arquitectura de la plataforma",[39338,93790],[],{"_2783":56420,"_24070":56419,"_16893":94565,"_5":16788,"_22829":56419,"_2311":94566},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2783":56421,"_24070":56419,"_5":24403,"_16893":94568,"_22829":94569,"_2311":94570},[],"/docs/pr-preview/pr-27/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2783":56422,"_24070":56419,"_5":24403,"_16893":94572,"_22829":94573,"_2311":94574},[],"/docs/pr-preview/pr-27/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2783":56423,"_24070":56419,"_5":24403,"_16893":94576,"_22829":94577,"_2311":94578},[],"/docs/pr-preview/pr-27/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2783":56424,"_24070":56419,"_5":24403,"_16893":94580,"_22829":94581,"_2311":94582},[],"/docs/pr-preview/pr-27/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2783":56425,"_24070":56419,"_5":24403,"_16893":94584,"_22829":94585,"_2311":94586},[],"/docs/pr-preview/pr-27/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2783":56426,"_24070":56419,"_16893":94588,"_5":16788,"_22829":56419,"_2311":94589},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2783":56427,"_24070":56419,"_16893":94591,"_5":16788,"_22829":56419,"_2311":94592},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2783":56428,"_24070":56419,"_16893":94594,"_5":16788,"_22829":94569,"_2311":94595},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2783":56429,"_24070":56419,"_16893":94597,"_5":16788,"_22829":94573,"_2311":94598},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2783":56430,"_24070":56419,"_16893":94600,"_5":16788,"_22829":94577,"_2311":94601},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2783":56431,"_24070":56419,"_16893":94603,"_5":16788,"_22829":94581,"_2311":94604},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2783":56432,"_24070":56419,"_16893":94606,"_5":16788,"_22829":94585,"_2311":94607},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2783":56433,"_24070":56433,"_5":11891,"_2311":94609,"_24406":94610,"_16893":94611,"_22829":56433},"Cómo funciona Lamassu",[39338,93790],[],{"_2783":56434,"_24070":56433,"_16893":94613,"_5":16788,"_22829":56433,"_2311":94614},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2783":56435,"_24070":56433,"_5":24403,"_16893":94616,"_22829":94617,"_2311":94618},[],"/docs/pr-preview/pr-27/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2783":56436,"_24070":56433,"_5":24403,"_16893":94620,"_22829":94621,"_2311":94622},[],"/docs/pr-preview/pr-27/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2783":56437,"_24070":56433,"_16893":94624,"_5":16788,"_22829":56433,"_2311":94625},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2783":56438,"_24070":56433,"_16893":94627,"_5":16788,"_22829":94617,"_2311":94628},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2783":56439,"_24070":56433,"_16893":94630,"_5":16788,"_22829":94617,"_2311":94631},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2783":56440,"_24070":56433,"_16893":94633,"_5":16788,"_22829":94617,"_2311":94634},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2783":56441,"_24070":56433,"_16893":94636,"_5":16788,"_22829":94617,"_2311":94637},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2783":56442,"_24070":56433,"_16893":94639,"_5":16788,"_22829":94617,"_2311":94640},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2783":56443,"_24070":56433,"_16893":94642,"_5":16788,"_22829":94621,"_2311":94643},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2783":56444,"_24070":56433,"_16893":94645,"_5":16788,"_22829":94621,"_2311":94646},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2783":56445,"_24070":56433,"_16893":94648,"_5":16788,"_22829":94621,"_2311":94649},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2783":56446,"_24070":56433,"_16893":94651,"_5":16788,"_22829":94621,"_2311":94652},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2783":56447,"_24070":56433,"_16893":94654,"_5":16788,"_22829":94621,"_2311":94655},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2783":56448,"_24070":56433,"_16893":94657,"_5":16788,"_22829":94621,"_2311":94658},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2783":56449,"_24070":56433,"_16893":94660,"_5":16788,"_22829":94621,"_2311":94661},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2783":56450,"_24070":56450,"_5":11891,"_2311":94663,"_24406":94664,"_16893":94665,"_22829":56450},"Dispositivos e identidades",[39338,93790,41557,94663],[],{"_2783":56451,"_24070":56450,"_16893":94667,"_5":16788,"_22829":56450,"_2311":94668},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2783":56452,"_24070":56450,"_5":24403,"_16893":94670,"_22829":94671,"_2311":94672},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2783":56453,"_24070":56450,"_5":24403,"_16893":94674,"_22829":94675,"_2311":94676},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2783":56454,"_24070":56450,"_5":24403,"_16893":94678,"_22829":94679,"_2311":94680},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2783":56455,"_24070":56450,"_5":24403,"_16893":94682,"_22829":94683,"_2311":94684},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2783":56456,"_24070":56450,"_5":24403,"_16893":94686,"_22829":94687,"_2311":94688},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2783":56457,"_24070":56450,"_5":24403,"_16893":94690,"_22829":94691,"_2311":94692},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2783":56458,"_24070":56450,"_5":24403,"_16893":94694,"_22829":94695,"_2311":94696},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2783":56459,"_24070":56450,"_5":24403,"_16893":94698,"_22829":94699,"_2311":94700},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2783":56460,"_24070":56450,"_5":24403,"_16893":94702,"_22829":94703,"_2311":94704},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2783":56461,"_24070":56450,"_5":24403,"_16893":94706,"_22829":94707,"_2311":94708},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2783":56462,"_24070":56450,"_5":24403,"_16893":94710,"_22829":94711,"_2311":94712},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2783":56463,"_24070":56450,"_16893":94714,"_5":16788,"_22829":56450,"_2311":94715},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2783":56464,"_24070":56450,"_16893":94717,"_5":16788,"_22829":56450,"_2311":94718},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2783":56465,"_24070":56450,"_16893":94720,"_5":16788,"_22829":94671,"_2311":94721},[],"Vista operativa",{"_2783":56466,"_24070":56450,"_16893":94723,"_5":16788,"_22829":94671,"_2311":94724},[],"Interpretación",{"_2783":56467,"_24070":56450,"_16893":94726,"_5":16788,"_22829":94671,"_2311":41620},[],{"_2783":56468,"_24070":56450,"_16893":94728,"_5":16788,"_22829":94671,"_2311":94729},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2783":56469,"_24070":56450,"_16893":94731,"_5":16788,"_22829":94671,"_2311":41626},[],{"_2783":56470,"_24070":56450,"_16893":94733,"_5":16788,"_22829":94671,"_2311":94734},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2783":56471,"_24070":56450,"_16893":94736,"_5":16788,"_22829":94671,"_2311":41632},[],{"_2783":56472,"_24070":56450,"_16893":94738,"_5":16788,"_22829":94671,"_2311":94739},[],"La identidad está en la ventana operativa de renovación.",{"_2783":56473,"_24070":56450,"_16893":94741,"_5":16788,"_22829":94671,"_2311":41638},[],{"_2783":56474,"_24070":56450,"_16893":94743,"_5":16788,"_22829":94671,"_2311":94744},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2783":56475,"_24070":56450,"_16893":94746,"_5":16788,"_22829":94671,"_2311":41644},[],{"_2783":56476,"_24070":56450,"_16893":94748,"_5":16788,"_22829":94671,"_2311":94749},[],"La identidad ha vencido.",{"_2783":56477,"_24070":56450,"_16893":94751,"_5":16788,"_22829":94671,"_2311":41650},[],{"_2783":56478,"_24070":56450,"_16893":94753,"_5":16788,"_22829":94671,"_2311":94754},[],"La identidad está marcada como revocada.",{"_2783":56479,"_24070":56450,"_16893":94756,"_5":16788,"_22829":94671,"_2311":41656},[],{"_2783":56480,"_24070":56450,"_16893":94758,"_5":16788,"_22829":94671,"_2311":94759},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2783":56481,"_24070":56450,"_16893":94761,"_5":16788,"_22829":94671,"_2311":94762},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2783":56482,"_24070":56450,"_16893":94764,"_5":16788,"_22829":94675,"_2311":94765},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2783":56483,"_24070":56450,"_16893":94767,"_5":16788,"_22829":94675,"_2311":94768},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2783":56484,"_24070":56450,"_16893":94770,"_5":16788,"_22829":94675,"_2311":94771},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2783":56485,"_24070":56450,"_16893":94773,"_5":16788,"_22829":94675,"_2311":94774},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2783":56486,"_24070":56450,"_16893":94776,"_5":16788,"_22829":94679,"_2311":94777},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2783":56487,"_24070":56450,"_16893":94779,"_5":16788,"_22829":94683,"_2311":94780},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2783":56488,"_24070":56450,"_16893":94782,"_5":16788,"_22829":94687,"_2311":94783},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2783":56489,"_24070":56450,"_16893":94785,"_5":16788,"_22829":94691,"_2311":94786},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2783":56490,"_24070":56450,"_16893":94788,"_5":16788,"_22829":94695,"_2311":94789},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2783":56491,"_24070":56450,"_16893":94791,"_5":16788,"_22829":94695,"_2311":94792},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2783":56492,"_24070":56450,"_16893":94794,"_5":16788,"_22829":94699,"_2311":94795},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2783":56493,"_24070":56450,"_16893":94797,"_5":16788,"_22829":94699,"_2311":94798},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2783":56494,"_24070":56450,"_16893":94800,"_5":16788,"_22829":94699,"_2311":94801},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2783":56495,"_24070":56450,"_16893":94803,"_5":16788,"_22829":94699,"_2311":94804},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2783":56496,"_24070":56450,"_16893":94806,"_5":16788,"_22829":94699,"_2311":94807},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2783":56497,"_24070":56450,"_16893":94809,"_5":16788,"_22829":94699,"_2311":94810},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2783":56498,"_24070":56450,"_16893":94812,"_5":16788,"_22829":94703,"_2311":94813},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2783":56499,"_24070":56450,"_16893":94815,"_5":16788,"_22829":94703,"_2311":94816},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2783":56500,"_24070":56450,"_16893":94818,"_5":16788,"_22829":94707,"_2311":94819},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2783":56501,"_24070":56450,"_16893":94821,"_5":16788,"_22829":94707,"_2311":94822},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2783":56502,"_24070":56450,"_16893":94824,"_5":16788,"_22829":94707,"_2311":94825},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2783":56503,"_24070":56450,"_16893":94827,"_5":16788,"_22829":94707,"_2311":94828},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2783":56504,"_24070":56450,"_16893":94830,"_5":16788,"_22829":94711,"_2311":94831},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2783":56505,"_24070":56450,"_16893":94833,"_5":16788,"_22829":94711,"_2311":94834},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2783":56506,"_24070":56506,"_5":11891,"_2311":94836,"_24406":94837,"_16893":94839,"_22829":56506},"Identidad inicial y autenticación",[39338,93790,41557,94663,94838],"Enrolamiento con PKI",[],{"_2783":56507,"_24070":56506,"_16893":94841,"_5":16788,"_22829":56506,"_2311":94842},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2783":56508,"_24070":56506,"_5":24403,"_16893":94844,"_22829":94845,"_2311":94846},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2783":56509,"_24070":56506,"_5":24403,"_16893":94848,"_22829":94849,"_2311":94850},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2783":56510,"_24070":56506,"_5":24403,"_16893":94852,"_22829":94853,"_2311":94854},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2783":56511,"_24070":56506,"_5":24403,"_16893":94856,"_22829":94857,"_2311":94858},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2783":56512,"_24070":56506,"_5":24403,"_16893":94860,"_22829":94861,"_2311":94862},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2783":56513,"_24070":56506,"_16893":94864,"_5":16788,"_22829":56506,"_2311":94865},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2783":56514,"_24070":56506,"_16893":94867,"_5":16788,"_22829":94845,"_2311":94868},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2783":56515,"_24070":56506,"_16893":94870,"_5":16788,"_22829":94845,"_2311":94871},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2783":56516,"_24070":56506,"_16893":94873,"_5":16788,"_22829":94849,"_2311":94874},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2783":56517,"_24070":56506,"_16893":94876,"_5":16788,"_22829":94849,"_2311":94877},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2783":56518,"_24070":56506,"_16893":94879,"_5":16788,"_22829":94849,"_2311":94880},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2783":56519,"_24070":56506,"_16893":94882,"_5":16788,"_22829":94853,"_2311":94883},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2783":56520,"_24070":56506,"_16893":94885,"_5":16788,"_22829":94853,"_2311":94886},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2783":56521,"_24070":56506,"_16893":94888,"_5":16788,"_22829":94857,"_2311":94889},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado.",{"_2783":56522,"_24070":56506,"_16893":94891,"_5":16788,"_22829":94857,"_2311":94892},[],"Ejemplo de cuerpo:",{"_2783":56523,"_24070":56506,"_16893":94894,"_5":16788,"_22829":94857,"_2311":94895},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2783":56524,"_24070":56506,"_16893":94897,"_5":16788,"_22829":94857,"_2311":94898},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2783":56525,"_24070":56506,"_16893":94900,"_5":16788,"_22829":94857,"_2311":94901},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2783":56526,"_24070":56506,"_16893":94903,"_5":16788,"_22829":94857,"_2311":94904},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2783":56527,"_24070":56506,"_16893":94906,"_5":16788,"_22829":94861,"_2311":94907},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2783":56528,"_24070":56506,"_16893":94909,"_5":16788,"_22829":94861,"_2311":94910},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2783":56529,"_24070":56529,"_5":11891,"_2311":94912,"_24406":94913,"_16893":94914,"_22829":56529},"Configura y opera el DMS",[39338,93790,41557,94663,94838],[],{"_2783":56530,"_24070":56529,"_16893":94916,"_5":16788,"_22829":56529,"_2311":94917},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2783":56531,"_24070":56529,"_5":24403,"_16893":94919,"_22829":94920,"_2311":92491},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2783":56532,"_24070":56529,"_5":24403,"_16893":94922,"_22829":94923,"_2311":94924},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2783":56533,"_24070":56529,"_5":24403,"_16893":94926,"_22829":94927,"_2311":94928},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2783":56534,"_24070":56529,"_5":24403,"_16893":94930,"_22829":94931,"_2311":94932},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2783":56535,"_24070":56529,"_5":24403,"_16893":94934,"_22829":94935,"_2311":94936},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2783":56536,"_24070":56529,"_5":24403,"_16893":94938,"_22829":94939,"_2311":94940},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2783":56537,"_24070":56529,"_5":24403,"_16893":94942,"_22829":94943,"_2311":94944},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2783":56538,"_24070":56529,"_5":24403,"_16893":94946,"_22829":94947,"_2311":94948},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2783":56539,"_24070":56529,"_5":24403,"_16893":94950,"_22829":94951,"_2311":41852},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2783":56540,"_24070":56529,"_5":24403,"_16893":94953,"_22829":94954,"_2311":41856},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2783":56541,"_24070":56529,"_5":24403,"_16893":94956,"_22829":94957,"_2311":94958},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2783":56542,"_24070":56529,"_5":24403,"_16893":94960,"_22829":94961,"_2311":94962},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2783":56543,"_24070":56529,"_5":24403,"_16893":94964,"_22829":94965,"_2311":94966},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2783":56544,"_24070":56529,"_5":24403,"_16893":94968,"_22829":94969,"_2311":41872},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2783":56545,"_24070":56529,"_5":24403,"_16893":94971,"_22829":94972,"_2311":94973},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2783":56546,"_24070":56529,"_5":24403,"_16893":94975,"_22829":94976,"_2311":94977},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2783":56547,"_24070":56529,"_5":24403,"_16893":94979,"_22829":94980,"_2311":94981},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2783":56548,"_24070":56529,"_16893":94983,"_5":16788,"_22829":56529,"_2311":94984},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2783":56549,"_24070":56529,"_16893":94986,"_5":16788,"_22829":94920,"_2311":94987},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2783":56550,"_24070":56529,"_16893":94989,"_5":16788,"_22829":94920,"_2311":94990},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2783":56551,"_24070":56529,"_16893":94992,"_5":16788,"_22829":94927,"_2311":94993},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2783":56552,"_24070":56529,"_16893":94995,"_5":16788,"_22829":94931,"_2311":94996},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2783":56553,"_24070":56529,"_16893":94998,"_5":16788,"_22829":94935,"_2311":94999},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2783":56554,"_24070":56529,"_16893":95001,"_5":16788,"_22829":94939,"_2311":95002},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2783":56555,"_24070":56529,"_16893":95004,"_5":16788,"_22829":94943,"_2311":95005},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2783":56556,"_24070":56529,"_16893":95007,"_5":16788,"_22829":94951,"_2311":95008},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2783":56557,"_24070":56529,"_16893":95010,"_5":16788,"_22829":94951,"_2311":95011},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2783":56558,"_24070":56529,"_16893":95013,"_5":16788,"_22829":94954,"_2311":95014},[],"Campo de `settings.enrollment_settings`",{"_2783":56559,"_24070":56529,"_16893":95016,"_5":16788,"_22829":94954,"_2311":95017},[],"Decisión",{"_2783":56560,"_24070":56529,"_16893":95019,"_5":16788,"_22829":94954,"_2311":41923},[],{"_2783":56561,"_24070":56529,"_16893":95021,"_5":16788,"_22829":94954,"_2311":95022},[],"`EST_RFC7030` para estas operaciones.",{"_2783":56562,"_24070":56529,"_16893":95024,"_5":16788,"_22829":94954,"_2311":41929},[],{"_2783":56563,"_24070":56529,"_16893":95026,"_5":16788,"_22829":94954,"_2311":95027},[],"ID de la CA que firmará.",{"_2783":56564,"_24070":56529,"_16893":95029,"_5":16788,"_22829":94954,"_2311":41935},[],{"_2783":56565,"_24070":56529,"_16893":95031,"_5":16788,"_22829":94954,"_2311":95032},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2783":56566,"_24070":56529,"_16893":95034,"_5":16788,"_22829":94954,"_2311":41941},[],{"_2783":56567,"_24070":56529,"_16893":95036,"_5":16788,"_22829":94954,"_2311":95037},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2783":56568,"_24070":56529,"_16893":95039,"_5":16788,"_22829":94954,"_2311":41947},[],{"_2783":56569,"_24070":56529,"_16893":95041,"_5":16788,"_22829":94954,"_2311":95042},[],"Uno de los cuatro modos de autenticación.",{"_2783":56570,"_24070":56529,"_16893":95044,"_5":16788,"_22829":94954,"_2311":95045},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2783":56571,"_24070":56529,"_16893":95047,"_5":16788,"_22829":94957,"_2311":95048},[],"Los bloques son independientes:",{"_2783":56572,"_24070":56529,"_16893":95050,"_5":16788,"_22829":94957,"_2311":95051},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2783":56573,"_24070":56529,"_16893":95053,"_5":16788,"_22829":94957,"_2311":95054},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2783":56574,"_24070":56529,"_16893":95056,"_5":16788,"_22829":94957,"_2311":41965},[],{"_2783":56575,"_24070":56529,"_16893":95058,"_5":16788,"_22829":94957,"_2311":95059},[],"Control aplicado en la operación configurada",{"_2783":56576,"_24070":56529,"_16893":95061,"_5":16788,"_22829":94957,"_2311":41971},[],{"_2783":56577,"_24070":56529,"_16893":95063,"_5":16788,"_22829":94957,"_2311":95064},[],"Validación del certificado presentado.",{"_2783":56578,"_24070":56529,"_16893":95066,"_5":16788,"_22829":94957,"_2311":41977},[],{"_2783":56579,"_24070":56529,"_16893":95068,"_5":16788,"_22829":94957,"_2311":95069},[],"Autorización del webhook configurado.",{"_2783":56580,"_24070":56529,"_16893":95071,"_5":16788,"_22829":94957,"_2311":41983},[],{"_2783":56581,"_24070":56529,"_16893":95073,"_5":16788,"_22829":94957,"_2311":95074},[],"Validación del certificado y, después, aprobación del webhook.",{"_2783":56582,"_24070":56529,"_16893":95076,"_5":16788,"_22829":94957,"_2311":41989},[],{"_2783":56583,"_24070":56529,"_16893":95078,"_5":16788,"_22829":94957,"_2311":95079},[],"Sin autenticación del solicitante por el DMS.",{"_2783":56584,"_24070":56529,"_16893":95081,"_5":16788,"_22829":94957,"_2311":95082},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2783":56585,"_24070":56529,"_16893":95084,"_5":16788,"_22829":94957,"_2311":95085},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2783":56586,"_24070":56529,"_16893":95087,"_5":16788,"_22829":94957,"_2311":95088},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2783":56587,"_24070":56529,"_16893":95090,"_5":16788,"_22829":94957,"_2311":95091},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2783":56588,"_24070":56529,"_16893":95093,"_5":16788,"_22829":94957,"_2311":95094},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2783":56589,"_24070":56529,"_16893":95096,"_5":16788,"_22829":94961,"_2311":95097},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2783":56590,"_24070":56529,"_16893":95099,"_5":16788,"_22829":94965,"_2311":95100},[],"Campo de `settings.reenrollment_settings`",{"_2783":56591,"_24070":56529,"_16893":95102,"_5":16788,"_22829":94965,"_2311":95103},[],"Función",{"_2783":56592,"_24070":56529,"_16893":95105,"_5":16788,"_22829":94965,"_2311":42018},[],{"_2783":56593,"_24070":56529,"_16893":95107,"_5":16788,"_22829":94965,"_2311":95108},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2783":56594,"_24070":56529,"_16893":95110,"_5":16788,"_22829":94965,"_2311":42024},[],{"_2783":56595,"_24070":56529,"_16893":95112,"_5":16788,"_22829":94965,"_2311":95113},[],"Umbral operativo preventivo de monitorización.",{"_2783":56596,"_24070":56529,"_16893":95115,"_5":16788,"_22829":94965,"_2311":42030},[],{"_2783":56597,"_24070":56529,"_16893":95117,"_5":16788,"_22829":94965,"_2311":95118},[],"Umbral operativo crítico de monitorización.",{"_2783":56598,"_24070":56529,"_16893":95120,"_5":16788,"_22829":94965,"_2311":42036},[],{"_2783":56599,"_24070":56529,"_16893":95122,"_5":16788,"_22829":94965,"_2311":95123},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2783":56600,"_24070":56529,"_16893":95125,"_5":16788,"_22829":94965,"_2311":42042},[],{"_2783":56601,"_24070":56529,"_16893":95127,"_5":16788,"_22829":94965,"_2311":95128},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2783":56602,"_24070":56529,"_16893":95130,"_5":16788,"_22829":94965,"_2311":42048},[],{"_2783":56603,"_24070":56529,"_16893":95132,"_5":16788,"_22829":94965,"_2311":95133},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2783":56604,"_24070":56529,"_16893":95135,"_5":16788,"_22829":94965,"_2311":95136},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2783":56605,"_24070":56529,"_16893":95138,"_5":16788,"_22829":94969,"_2311":95139},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2783":56606,"_24070":56529,"_16893":95141,"_5":16788,"_22829":94972,"_2311":92848},[],{"_2783":56607,"_24070":56529,"_16893":95143,"_5":16788,"_22829":94972,"_2311":95144},[],"Qué publica",{"_2783":56608,"_24070":56529,"_16893":95146,"_5":16788,"_22829":94972,"_2311":42065},[],{"_2783":56609,"_24070":56529,"_16893":95148,"_5":16788,"_22829":94972,"_2311":95149},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2783":56610,"_24070":56529,"_16893":95151,"_5":16788,"_22829":94972,"_2311":42071},[],{"_2783":56611,"_24070":56529,"_16893":95153,"_5":16788,"_22829":94972,"_2311":95154},[],"Certificado de la CA emisora seleccionada.",{"_2783":56612,"_24070":56529,"_16893":95156,"_5":16788,"_22829":94972,"_2311":42077},[],{"_2783":56613,"_24070":56529,"_16893":95158,"_5":16788,"_22829":94972,"_2311":95159},[],"Certificados de las CAs elegidas explícitamente.",{"_2783":56614,"_24070":56529,"_16893":95161,"_5":16788,"_22829":94972,"_2311":95162},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2783":56615,"_24070":56529,"_16893":95164,"_5":16788,"_22829":94976,"_2311":95165},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2783":56616,"_24070":56529,"_16893":95167,"_5":16788,"_22829":94976,"_2311":95168},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2783":56617,"_24070":56529,"_16893":95170,"_5":16788,"_22829":94976,"_2311":95171},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2783":56618,"_24070":56529,"_16893":95173,"_5":16788,"_22829":94980,"_2311":95174},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2783":56619,"_24070":56619,"_5":11891,"_2311":95176,"_24406":95177,"_16893":95178,"_22829":56619},"Integra el cliente EST",[39338,93790,41557,94663,94838],[],{"_2783":56620,"_24070":56619,"_16893":95180,"_5":16788,"_22829":56619,"_2311":95181},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2783":56621,"_24070":56619,"_5":24403,"_16893":95183,"_22829":95184,"_2311":92491},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2783":56622,"_24070":56619,"_5":24403,"_16893":95186,"_22829":95187,"_2311":95188},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2783":56623,"_24070":56619,"_5":24403,"_16893":95190,"_22829":95191,"_2311":95192},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2783":56624,"_24070":56619,"_5":24403,"_16893":95194,"_22829":95195,"_2311":95196},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2783":56625,"_24070":56619,"_5":24403,"_16893":95198,"_22829":95199,"_2311":95200},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2783":56626,"_24070":56619,"_5":24403,"_16893":95202,"_22829":95203,"_2311":95204},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2783":56627,"_24070":56619,"_16893":95206,"_5":16788,"_22829":56619,"_2311":95207},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2783":56628,"_24070":56619,"_16893":95209,"_5":16788,"_22829":95184,"_2311":95210},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2783":56629,"_24070":56619,"_16893":95212,"_5":16788,"_22829":95184,"_2311":95213},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2783":56630,"_24070":56619,"_16893":95215,"_5":16788,"_22829":95184,"_2311":95216},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2783":56631,"_24070":56619,"_16893":95218,"_5":16788,"_22829":95187,"_2311":95219},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2783":56632,"_24070":56619,"_16893":95221,"_5":16788,"_22829":95187,"_2311":95222},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2783":56633,"_24070":56619,"_16893":95224,"_5":16788,"_22829":95191,"_2311":95225},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2783":56634,"_24070":56619,"_16893":95227,"_5":16788,"_22829":95191,"_2311":95228},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2783":56635,"_24070":56619,"_16893":95230,"_5":16788,"_22829":95195,"_2311":95231},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2783":56636,"_24070":56619,"_16893":95233,"_5":16788,"_22829":95195,"_2311":95234},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2783":56637,"_24070":56619,"_16893":95236,"_5":16788,"_22829":95199,"_2311":95237},[],"Para el caso de una raíz que emite directamente:",{"_2783":56638,"_24070":56619,"_16893":95239,"_5":16788,"_22829":95199,"_2311":95240},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2783":56639,"_24070":56619,"_16893":95242,"_5":16788,"_22829":95199,"_2311":95243},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2783":56640,"_24070":56619,"_16893":95245,"_5":16788,"_22829":95203,"_2311":95246},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2783":56641,"_24070":56641,"_5":11891,"_2311":95248,"_24406":95249,"_16893":95250,"_22829":56641},"Referencia EST",[39338,93790,41557,94663,94838],[],{"_2783":56642,"_24070":56641,"_16893":95252,"_5":16788,"_22829":56641,"_2311":95253},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2783":56643,"_24070":56641,"_5":24403,"_16893":95255,"_22829":95256,"_2311":95257},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2783":56644,"_24070":56641,"_5":24403,"_16893":95259,"_22829":95260,"_2311":18303},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2783":56645,"_24070":56641,"_5":24403,"_16893":95262,"_22829":95263,"_2311":20997},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2783":56646,"_24070":56641,"_5":24403,"_16893":95265,"_22829":95266,"_2311":21004},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2783":56647,"_24070":56641,"_5":24403,"_16893":95268,"_22829":95269,"_2311":20373},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2783":56648,"_24070":56641,"_5":24403,"_16893":95271,"_22829":95272,"_2311":95273},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2783":56649,"_24070":56641,"_5":24403,"_16893":95275,"_22829":95276,"_2311":95277},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2783":56650,"_24070":56641,"_5":24403,"_16893":95279,"_22829":95280,"_2311":95281},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2783":56651,"_24070":56641,"_16893":95283,"_5":16788,"_22829":56641,"_2311":95284},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2783":56652,"_24070":56641,"_16893":95286,"_5":16788,"_22829":95256,"_2311":95287},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2783":56653,"_24070":56641,"_16893":95289,"_5":16788,"_22829":95256,"_2311":93581},[],{"_2783":56654,"_24070":56641,"_16893":95291,"_5":16788,"_22829":95256,"_2311":95292},[],"Método",{"_2783":56655,"_24070":56641,"_16893":95294,"_5":16788,"_22829":95256,"_2311":95295},[],"Autenticación y condición",{"_2783":56656,"_24070":56641,"_16893":95297,"_5":16788,"_22829":95256,"_2311":42220},[],{"_2783":56657,"_24070":56641,"_16893":95299,"_5":16788,"_22829":95256,"_2311":42223},[],{"_2783":56658,"_24070":56641,"_16893":95301,"_5":16788,"_22829":95256,"_2311":95302},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2783":56659,"_24070":56641,"_16893":95304,"_5":16788,"_22829":95256,"_2311":42229},[],{"_2783":56660,"_24070":56641,"_16893":95306,"_5":16788,"_22829":95256,"_2311":42232},[],{"_2783":56661,"_24070":56641,"_16893":95308,"_5":16788,"_22829":95256,"_2311":95309},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2783":56662,"_24070":56641,"_16893":95311,"_5":16788,"_22829":95256,"_2311":42238},[],{"_2783":56663,"_24070":56641,"_16893":95313,"_5":16788,"_22829":95256,"_2311":42232},[],{"_2783":56664,"_24070":56641,"_16893":95315,"_5":16788,"_22829":95256,"_2311":95316},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2783":56665,"_24070":56641,"_16893":95318,"_5":16788,"_22829":95256,"_2311":42246},[],{"_2783":56666,"_24070":56641,"_16893":95320,"_5":16788,"_22829":95256,"_2311":42232},[],{"_2783":56667,"_24070":56641,"_16893":95322,"_5":16788,"_22829":95256,"_2311":95323},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2783":56668,"_24070":56641,"_16893":95325,"_5":16788,"_22829":95256,"_2311":95326},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2783":56669,"_24070":56641,"_16893":95328,"_5":16788,"_22829":95260,"_2311":95329},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2783":56670,"_24070":56641,"_16893":95331,"_5":16788,"_22829":95260,"_2311":95332},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2783":56671,"_24070":56641,"_16893":95334,"_5":16788,"_22829":95263,"_2311":95335},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2783":56672,"_24070":56641,"_16893":95337,"_5":16788,"_22829":95263,"_2311":95338},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2783":56673,"_24070":56641,"_16893":95340,"_5":16788,"_22829":95266,"_2311":95341},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2783":56674,"_24070":56641,"_16893":95343,"_5":16788,"_22829":95266,"_2311":95344},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2783":56675,"_24070":56641,"_16893":95346,"_5":16788,"_22829":95269,"_2311":95347},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2783":56676,"_24070":56641,"_16893":95349,"_5":16788,"_22829":95269,"_2311":95350},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2783":56677,"_24070":56641,"_16893":95352,"_5":16788,"_22829":95272,"_2311":95353},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2783":56678,"_24070":56641,"_16893":95355,"_5":16788,"_22829":95272,"_2311":95356},[],"Parte",{"_2783":56679,"_24070":56641,"_16893":95358,"_5":16788,"_22829":95272,"_2311":95359},[],"Contenido tras decodificar su Base64",{"_2783":56680,"_24070":56641,"_16893":95361,"_5":16788,"_22829":95272,"_2311":42290},[],{"_2783":56681,"_24070":56641,"_16893":95363,"_5":16788,"_22829":95272,"_2311":95364},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2783":56682,"_24070":56641,"_16893":95366,"_5":16788,"_22829":95272,"_2311":42296},[],{"_2783":56683,"_24070":56641,"_16893":95368,"_5":16788,"_22829":95272,"_2311":95369},[],"PKCS#7 DER con el certificado emitido.",{"_2783":56684,"_24070":56641,"_16893":95371,"_5":16788,"_22829":95272,"_2311":95372},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2783":56685,"_24070":56641,"_16893":95374,"_5":16788,"_22829":95276,"_2311":95375},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2783":56686,"_24070":56641,"_16893":95377,"_5":16788,"_22829":95276,"_2311":95378},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2783":56687,"_24070":56641,"_16893":95380,"_5":16788,"_22829":95276,"_2311":95381},[],"Convierte y comprueba el resultado:",{"_2783":56688,"_24070":56641,"_16893":95383,"_5":16788,"_22829":95276,"_2311":95384},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2783":56689,"_24070":56641,"_16893":95386,"_5":16788,"_22829":95280,"_2311":95387},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2783":56690,"_24070":56641,"_16893":95389,"_5":16788,"_22829":95280,"_2311":95390},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2783":56691,"_24070":56691,"_5":11891,"_2311":94838,"_24406":95392,"_16893":95393,"_22829":56691},[39338,93790,41557,94663,94838],[],{"_2783":56692,"_24070":56691,"_16893":95395,"_5":16788,"_22829":56691,"_2311":95396},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2783":56693,"_24070":56691,"_5":24403,"_16893":95398,"_22829":95399,"_2311":95400},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2783":56694,"_24070":56691,"_5":24403,"_16893":95402,"_22829":95403,"_2311":95404},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2783":56695,"_24070":56691,"_5":24403,"_16893":95406,"_22829":95407,"_2311":95408},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2783":56696,"_24070":56691,"_5":24403,"_16893":95410,"_22829":95411,"_2311":95412},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2783":56697,"_24070":56691,"_16893":95414,"_5":16788,"_22829":56691,"_2311":95415},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2783":56698,"_24070":56691,"_16893":95417,"_5":16788,"_22829":95399,"_2311":95418},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2783":56699,"_24070":56691,"_16893":95420,"_5":16788,"_22829":95399,"_2311":95421},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2783":56700,"_24070":56691,"_16893":95423,"_5":16788,"_22829":95399,"_2311":95424},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2783":56701,"_24070":56691,"_16893":95426,"_5":16788,"_22829":95399,"_2311":95427},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2783":56702,"_24070":56691,"_16893":95429,"_5":16788,"_22829":95399,"_2311":95430},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2783":56703,"_24070":56691,"_16893":95432,"_5":16788,"_22829":95399,"_2311":95433},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2783":56704,"_24070":56691,"_16893":95435,"_5":16788,"_22829":95403,"_2311":95436},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2783":56705,"_24070":56691,"_16893":95438,"_5":16788,"_22829":95403,"_2311":95439},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2783":56706,"_24070":56691,"_16893":95441,"_5":16788,"_22829":95403,"_2311":95442},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2783":56707,"_24070":56691,"_16893":95444,"_5":16788,"_22829":95403,"_2311":95445},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2783":56708,"_24070":56691,"_16893":95447,"_5":16788,"_22829":95407,"_2311":95448},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2783":56709,"_24070":56691,"_16893":95450,"_5":16788,"_22829":95407,"_2311":95451},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2783":56710,"_24070":56691,"_16893":95453,"_5":16788,"_22829":95407,"_2311":95454},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2783":56711,"_24070":56691,"_16893":95456,"_5":16788,"_22829":95407,"_2311":95457},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2783":56712,"_24070":56691,"_16893":95459,"_5":16788,"_22829":95411,"_2311":95460},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2783":56713,"_24070":56691,"_16893":95462,"_5":16788,"_22829":95411,"_2311":95463},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2783":56714,"_24070":56714,"_5":11891,"_2311":95465,"_24406":95466,"_16893":95467,"_22829":56714},"Estrategias de aprovisionamiento",[39338,93790,41557,94663,94838],[],{"_2783":56715,"_24070":56714,"_16893":95469,"_5":16788,"_22829":56714,"_2311":95470},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2783":56716,"_24070":56714,"_5":24403,"_16893":95472,"_22829":95473,"_2311":95474},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2783":56717,"_24070":56714,"_5":24403,"_16893":95476,"_22829":95477,"_2311":95478},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2783":56718,"_24070":56714,"_5":24403,"_16893":95480,"_22829":95481,"_2311":95482},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2783":56719,"_24070":56714,"_5":24403,"_16893":95484,"_22829":95485,"_2311":95486},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2783":56720,"_24070":56714,"_5":24403,"_16893":95488,"_22829":95489,"_2311":95490},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2783":56721,"_24070":56714,"_16893":95492,"_5":16788,"_22829":56714,"_2311":95493},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2783":56722,"_24070":56714,"_16893":95495,"_5":16788,"_22829":95473,"_2311":95496},[],"Recorrido",{"_2783":56723,"_24070":56714,"_16893":95498,"_5":16788,"_22829":95473,"_2311":95499},[],"Cuándo existe el dispositivo",{"_2783":56724,"_24070":56714,"_16893":95501,"_5":16788,"_22829":95473,"_2311":95502},[],"Qué compruebas",{"_2783":56725,"_24070":56714,"_16893":95504,"_5":16788,"_22829":95473,"_2311":95505},[],"Asignación manual",{"_2783":56726,"_24070":56714,"_16893":95507,"_5":16788,"_22829":95473,"_2311":95508},[],"El operador lo crea antes de asociar un certificado.",{"_2783":56727,"_24070":56714,"_16893":95510,"_5":16788,"_22829":95473,"_2311":95511},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2783":56728,"_24070":56714,"_16893":95513,"_5":16788,"_22829":95473,"_2311":95514},[],"EST con `JITP`",{"_2783":56729,"_24070":56714,"_16893":95516,"_5":16788,"_22829":95473,"_2311":95517},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2783":56730,"_24070":56714,"_16893":95519,"_5":16788,"_22829":95473,"_2311":95520},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2783":56731,"_24070":56714,"_16893":95522,"_5":16788,"_22829":95473,"_2311":95523},[],"EST con `PRE_REGISTRATION`",{"_2783":56732,"_24070":56714,"_16893":95525,"_5":16788,"_22829":95473,"_2311":95526},[],"Debe existir antes de `/simpleenroll`.",{"_2783":56733,"_24070":56714,"_16893":95528,"_5":16788,"_22829":95473,"_2311":95529},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2783":56734,"_24070":56714,"_16893":95531,"_5":16788,"_22829":95473,"_2311":95532},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2783":56735,"_24070":56714,"_16893":95534,"_5":16788,"_22829":95473,"_2311":95535},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2783":56736,"_24070":56714,"_16893":95537,"_5":16788,"_22829":95477,"_2311":95538},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2783":56737,"_24070":56714,"_16893":95540,"_5":16788,"_22829":95477,"_2311":95541},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2783":56738,"_24070":56714,"_16893":95543,"_5":16788,"_22829":95477,"_2311":95544},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2783":56739,"_24070":56714,"_16893":95546,"_5":16788,"_22829":95481,"_2311":95547},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2783":56740,"_24070":56714,"_16893":95549,"_5":16788,"_22829":95481,"_2311":95550},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2783":56741,"_24070":56714,"_16893":95552,"_5":16788,"_22829":95481,"_2311":95553},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2783":56742,"_24070":56714,"_16893":95555,"_5":16788,"_22829":95481,"_2311":95556},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2783":56743,"_24070":56714,"_16893":95558,"_5":16788,"_22829":95481,"_2311":95559},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2783":56744,"_24070":56714,"_16893":95561,"_5":16788,"_22829":95481,"_2311":95562},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2783":56745,"_24070":56714,"_16893":95564,"_5":16788,"_22829":95485,"_2311":92848},[],{"_2783":56746,"_24070":56714,"_16893":95566,"_5":16788,"_22829":95485,"_2311":95567},[],"Material que atraviesa EST",{"_2783":56747,"_24070":56714,"_16893":95569,"_5":16788,"_22829":95485,"_2311":95570},[],"Clave generada por el dispositivo",{"_2783":56748,"_24070":56714,"_16893":95572,"_5":16788,"_22829":95485,"_2311":95573},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2783":56749,"_24070":56714,"_16893":95575,"_5":16788,"_22829":95485,"_2311":95576},[],"Clave ya disponible en el dispositivo",{"_2783":56750,"_24070":56714,"_16893":95578,"_5":16788,"_22829":95485,"_2311":95579},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2783":56751,"_24070":56714,"_16893":95581,"_5":16788,"_22829":95485,"_2311":41872},[],{"_2783":56752,"_24070":56714,"_16893":95583,"_5":16788,"_22829":95485,"_2311":95584},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2783":56753,"_24070":56714,"_16893":95586,"_5":16788,"_22829":95485,"_2311":95587},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2783":56754,"_24070":56714,"_16893":95589,"_5":16788,"_22829":95489,"_2311":95590},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2783":56755,"_24070":56755,"_5":11891,"_2311":95592,"_24406":95593,"_16893":95594,"_22829":56755},"Renovación y recuperación",[39338,93790,41557,94663,94838],[],{"_2783":56756,"_24070":56755,"_16893":95596,"_5":16788,"_22829":56755,"_2311":95597},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2783":56757,"_24070":56755,"_5":24403,"_16893":95599,"_22829":95600,"_2311":95601},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2783":56758,"_24070":56755,"_5":24403,"_16893":95603,"_22829":95604,"_2311":95605},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2783":56759,"_24070":56755,"_5":24403,"_16893":95607,"_22829":95608,"_2311":95609},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2783":56760,"_24070":56755,"_5":24403,"_16893":95611,"_22829":95612,"_2311":95613},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2783":56761,"_24070":56755,"_5":24403,"_16893":95615,"_22829":95616,"_2311":95617},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2783":56762,"_24070":56755,"_16893":95619,"_5":16788,"_22829":56755,"_2311":95620},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2783":56763,"_24070":56755,"_16893":95622,"_5":16788,"_22829":95600,"_2311":95623},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2783":56764,"_24070":56755,"_16893":95625,"_5":16788,"_22829":95600,"_2311":95626},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2783":56765,"_24070":56755,"_16893":95628,"_5":16788,"_22829":95600,"_2311":95629},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2783":56766,"_24070":56755,"_16893":95631,"_5":16788,"_22829":95600,"_2311":95632},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2783":56767,"_24070":56755,"_16893":95634,"_5":16788,"_22829":95604,"_2311":95635},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2783":56768,"_24070":56755,"_16893":95637,"_5":16788,"_22829":95604,"_2311":95638},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2783":56769,"_24070":56755,"_16893":95640,"_5":16788,"_22829":95608,"_2311":95641},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2783":56770,"_24070":56755,"_16893":95643,"_5":16788,"_22829":95608,"_2311":95644},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2783":56771,"_24070":56755,"_16893":95646,"_5":16788,"_22829":95608,"_2311":95647},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2783":56772,"_24070":56755,"_16893":95649,"_5":16788,"_22829":95612,"_2311":95650},[],"Situación",{"_2783":56773,"_24070":56755,"_16893":95652,"_5":16788,"_22829":95612,"_2311":95653},[],"Procedimiento",{"_2783":56774,"_24070":56755,"_16893":95655,"_5":16788,"_22829":95612,"_2311":95656},[],"Certificado vigente, fuera de ventana",{"_2783":56775,"_24070":56755,"_16893":95658,"_5":16788,"_22829":95612,"_2311":95659},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2783":56776,"_24070":56755,"_16893":95661,"_5":16788,"_22829":95612,"_2311":95662},[],"Certificado vencido, clave disponible",{"_2783":56777,"_24070":56755,"_16893":95664,"_5":16788,"_22829":95612,"_2311":95665},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2783":56778,"_24070":56755,"_16893":95667,"_5":16788,"_22829":95612,"_2311":95668},[],"Renovación por webhook o `NO_AUTH`",{"_2783":56779,"_24070":56755,"_16893":95670,"_5":16788,"_22829":95612,"_2311":95671},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2783":56780,"_24070":56755,"_16893":95673,"_5":16788,"_22829":95612,"_2311":95674},[],"Clave perdida o inaccesible",{"_2783":56781,"_24070":56755,"_16893":95676,"_5":16788,"_22829":95612,"_2311":95677},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2783":56782,"_24070":56755,"_16893":95679,"_5":16788,"_22829":95612,"_2311":95680},[],"Identidad actual revocada",{"_2783":56783,"_24070":56755,"_16893":95682,"_5":16788,"_22829":95612,"_2311":95683},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2783":56784,"_24070":56755,"_16893":95685,"_5":16788,"_22829":95612,"_2311":95686},[],"Dispositivo sin identidad",{"_2783":56785,"_24070":56755,"_16893":95688,"_5":16788,"_22829":95612,"_2311":95689},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2783":56786,"_24070":56755,"_16893":95691,"_5":16788,"_22829":95612,"_2311":95692},[],"Dispositivo retirado",{"_2783":56787,"_24070":56755,"_16893":95694,"_5":16788,"_22829":95612,"_2311":95695},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2783":56788,"_24070":56755,"_16893":95697,"_5":16788,"_22829":95612,"_2311":95698},[],"Timeout, HTTP 500 o fallo de instalación",{"_2783":56789,"_24070":56755,"_16893":95700,"_5":16788,"_22829":95612,"_2311":95701},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2783":56790,"_24070":56755,"_16893":95703,"_5":16788,"_22829":95616,"_2311":95704},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2783":56791,"_24070":56755,"_16893":95706,"_5":16788,"_22829":95616,"_2311":95707},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2783":56792,"_24070":56792,"_5":11891,"_2311":95709,"_24406":95710,"_16893":95711,"_22829":56792},"Diagnóstico de enrolamiento",[39338,93790,41557,94663,94838],[],{"_2783":56793,"_24070":56792,"_16893":95713,"_5":16788,"_22829":56792,"_2311":95714},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2783":56794,"_24070":56792,"_5":24403,"_16893":95716,"_22829":95717,"_2311":95718},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2783":56795,"_24070":56792,"_5":24403,"_16893":95720,"_22829":95721,"_2311":95722},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2783":56796,"_24070":56792,"_5":24403,"_16893":95724,"_22829":95725,"_2311":95281},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2783":56797,"_24070":56792,"_5":24403,"_16893":95727,"_22829":95728,"_2311":95729},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2783":56798,"_24070":56792,"_16893":95731,"_5":16788,"_22829":56792,"_2311":95732},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2783":56799,"_24070":56792,"_16893":95734,"_5":16788,"_22829":95721,"_2311":95735},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2783":56800,"_24070":56792,"_16893":95737,"_5":16788,"_22829":95721,"_2311":95738},[],"Síntoma o mensaje",{"_2783":56801,"_24070":56792,"_16893":95740,"_5":16788,"_22829":95721,"_2311":95741},[],"Qué revisar",{"_2783":56802,"_24070":56792,"_16893":95743,"_5":16788,"_22829":95721,"_2311":95744},[],"curl rechaza TLS, nombre o emisor",{"_2783":56803,"_24070":56792,"_16893":95746,"_5":16788,"_22829":95721,"_2311":95747},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2783":56804,"_24070":56792,"_16893":95749,"_5":16788,"_22829":95721,"_2311":95750},[],"404 o APS ausente",{"_2783":56805,"_24070":56792,"_16893":95752,"_5":16788,"_22829":95721,"_2311":95753},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2783":56806,"_24070":56792,"_16893":95755,"_5":16788,"_22829":95721,"_2311":95756},[],"400, error de CSR o formato",{"_2783":56807,"_24070":56792,"_16893":95758,"_5":16788,"_22829":95721,"_2311":95759},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2783":56808,"_24070":56792,"_16893":95761,"_5":16788,"_22829":95721,"_2311":95762},[],"Credencial ausente o certificado no válido",{"_2783":56809,"_24070":56792,"_16893":95764,"_5":16788,"_22829":95721,"_2311":95765},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2783":56810,"_24070":56792,"_16893":95767,"_5":16788,"_22829":95721,"_2311":95768},[],"Webhook deniega, expira o responde sin autorización",{"_2783":56811,"_24070":56792,"_16893":95770,"_5":16788,"_22829":95721,"_2311":95771},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2783":56812,"_24070":56792,"_16893":95773,"_5":16788,"_22829":95721,"_2311":42703},[],{"_2783":56813,"_24070":56792,"_16893":95775,"_5":16788,"_22829":95721,"_2311":95776},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2783":56814,"_24070":56792,"_16893":95778,"_5":16788,"_22829":95721,"_2311":42709},[],{"_2783":56815,"_24070":56792,"_16893":95780,"_5":16788,"_22829":95721,"_2311":95781},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2783":56816,"_24070":56792,"_16893":95783,"_5":16788,"_22829":95721,"_2311":95784},[],"DMS propietario distinto",{"_2783":56817,"_24070":56792,"_16893":95786,"_5":16788,"_22829":95721,"_2311":95787},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2783":56818,"_24070":56792,"_16893":95789,"_5":16788,"_22829":95721,"_2311":42721},[],{"_2783":56819,"_24070":56792,"_16893":95791,"_5":16788,"_22829":95721,"_2311":95792},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2783":56820,"_24070":56792,"_16893":95794,"_5":16788,"_22829":95721,"_2311":42727},[],{"_2783":56821,"_24070":56792,"_16893":95796,"_5":16788,"_22829":95721,"_2311":95797},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2783":56822,"_24070":56792,"_16893":95799,"_5":16788,"_22829":95721,"_2311":95800},[],"Certificado actual revocado",{"_2783":56823,"_24070":56792,"_16893":95802,"_5":16788,"_22829":95721,"_2311":95803},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2783":56824,"_24070":56792,"_16893":95805,"_5":16788,"_22829":95721,"_2311":95806},[],"Error de CA, perfil o firma",{"_2783":56825,"_24070":56792,"_16893":95808,"_5":16788,"_22829":95721,"_2311":95809},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2783":56826,"_24070":56792,"_16893":95811,"_5":16788,"_22829":95721,"_2311":95812},[],"HTTP 200 sin conexión del dispositivo",{"_2783":56827,"_24070":56792,"_16893":95814,"_5":16788,"_22829":95721,"_2311":95815},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2783":56828,"_24070":56792,"_16893":95817,"_5":16788,"_22829":95721,"_2311":95818},[],"Timeout o error después de emitir",{"_2783":56829,"_24070":56792,"_16893":95820,"_5":16788,"_22829":95721,"_2311":95821},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2783":56830,"_24070":56792,"_16893":95823,"_5":16788,"_22829":95725,"_2311":95824},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2783":56831,"_24070":56792,"_16893":95826,"_5":16788,"_22829":95725,"_2311":95827},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2783":56832,"_24070":56792,"_16893":95829,"_5":16788,"_22829":95728,"_2311":95830},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2783":56833,"_24070":56792,"_16893":95832,"_5":16788,"_22829":95728,"_2311":95833},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2783":56834,"_24070":56792,"_16893":95835,"_5":16788,"_22829":95728,"_2311":95836},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2783":56835,"_24070":56792,"_16893":95838,"_5":16788,"_22829":95728,"_2311":95839},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2783":56836,"_24070":56792,"_16893":95841,"_5":16788,"_22829":95728,"_2311":95842},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2783":56837,"_24070":56792,"_16893":95844,"_5":16788,"_22829":95728,"_2311":95845},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2783":56838,"_24070":56792,"_16893":95847,"_5":16788,"_22829":95728,"_2311":95848},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2783":56839,"_24070":56839,"_5":11891,"_2311":95850,"_24406":95851,"_16893":95852,"_22829":56839},"Distribución y actualización de confianza",[39338,93790,41557,94663,94838],[],{"_2783":56840,"_24070":56839,"_16893":95854,"_5":16788,"_22829":56839,"_2311":95855},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2783":56841,"_24070":56839,"_5":24403,"_16893":95857,"_22829":95858,"_2311":95859},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2783":56842,"_24070":56839,"_5":24403,"_16893":95861,"_22829":95862,"_2311":95863},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2783":56843,"_24070":56839,"_5":24403,"_16893":95865,"_22829":95866,"_2311":95867},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2783":56844,"_24070":56839,"_5":24403,"_16893":95869,"_22829":95870,"_2311":95871},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2783":56845,"_24070":56839,"_5":24403,"_16893":95873,"_22829":95874,"_2311":95875},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2783":56846,"_24070":56839,"_16893":95877,"_5":16788,"_22829":56839,"_2311":95878},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2783":56847,"_24070":56839,"_16893":95880,"_5":16788,"_22829":95858,"_2311":95881},[],"Relación",{"_2783":56848,"_24070":56839,"_16893":95883,"_5":16788,"_22829":95858,"_2311":95884},[],"Material que prepara el responsable",{"_2783":56849,"_24070":56839,"_16893":95886,"_5":16788,"_22829":95858,"_2311":95887},[],"Dispositivo → servidor EST",{"_2783":56850,"_24070":56839,"_16893":95889,"_5":16788,"_22829":95858,"_2311":95890},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2783":56851,"_24070":56839,"_16893":95892,"_5":16788,"_22829":95858,"_2311":95893},[],"DMS → solicitante",{"_2783":56852,"_24070":56839,"_16893":95895,"_5":16788,"_22829":95858,"_2311":95896},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2783":56853,"_24070":56839,"_16893":95898,"_5":16788,"_22829":95858,"_2311":95899},[],"Consumidor → dispositivo",{"_2783":56854,"_24070":56839,"_16893":95901,"_5":16788,"_22829":95858,"_2311":95902},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2783":56855,"_24070":56839,"_16893":95904,"_5":16788,"_22829":95858,"_2311":95905},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2783":56856,"_24070":56839,"_16893":95907,"_5":16788,"_22829":95862,"_2311":95908},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2783":56857,"_24070":56839,"_16893":95910,"_5":16788,"_22829":95862,"_2311":95911},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2783":56858,"_24070":56839,"_16893":95913,"_5":16788,"_22829":95866,"_2311":95914},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2783":56859,"_24070":56839,"_16893":95916,"_5":16788,"_22829":95866,"_2311":95917},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2783":56860,"_24070":56839,"_16893":95919,"_5":16788,"_22829":95866,"_2311":95920},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2783":56861,"_24070":56839,"_16893":95922,"_5":16788,"_22829":95866,"_2311":95923},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2783":56862,"_24070":56839,"_16893":95925,"_5":16788,"_22829":95866,"_2311":95926},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2783":56863,"_24070":56839,"_16893":95928,"_5":16788,"_22829":95866,"_2311":95929},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2783":56864,"_24070":56839,"_16893":95931,"_5":16788,"_22829":95870,"_2311":95932},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2783":56865,"_24070":56839,"_16893":95934,"_5":16788,"_22829":95870,"_2311":95935},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2783":56866,"_24070":56839,"_16893":95937,"_5":16788,"_22829":95870,"_2311":95938},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2783":56867,"_24070":56839,"_16893":95940,"_5":16788,"_22829":95874,"_2311":95941},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2783":56868,"_24070":56868,"_5":11891,"_2311":42876,"_24406":95943,"_16893":95945,"_22829":56868},[39338,93790,41557,94663,95944],"Integraciones",[],{"_2783":56869,"_24070":56868,"_16893":95947,"_5":16788,"_22829":56868,"_2311":95948},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2783":56870,"_24070":56868,"_5":24403,"_16893":95950,"_22829":95951,"_2311":95952},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2783":56871,"_24070":56868,"_5":24403,"_16893":95954,"_22829":95955,"_2311":95956},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2783":56872,"_24070":56868,"_5":24403,"_16893":95958,"_22829":95959,"_2311":95960},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2783":56873,"_24070":56868,"_5":24403,"_16893":95962,"_22829":95963,"_2311":95964},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2783":56874,"_24070":56868,"_5":24403,"_16893":95966,"_22829":95967,"_2311":95968},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2783":56875,"_24070":56868,"_5":24403,"_16893":95970,"_22829":95971,"_2311":95972},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2783":56876,"_24070":56868,"_5":24403,"_16893":95974,"_22829":95975,"_2311":42910},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2783":56877,"_24070":56868,"_5":24403,"_16893":95977,"_22829":95978,"_2311":42914},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2783":56878,"_24070":56868,"_5":24403,"_16893":95980,"_22829":95981,"_2311":95982},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2783":56879,"_24070":56868,"_5":24403,"_16893":95984,"_22829":95985,"_2311":95986},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2783":56880,"_24070":56868,"_5":24403,"_16893":95988,"_22829":95989,"_2311":95990},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2783":56881,"_24070":56868,"_5":24403,"_16893":95992,"_22829":95993,"_2311":95994},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2783":56882,"_24070":56868,"_5":24403,"_16893":95996,"_22829":95997,"_2311":95998},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2783":56883,"_24070":56868,"_5":24403,"_16893":96000,"_22829":96001,"_2311":96002},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2783":56884,"_24070":56868,"_5":24403,"_16893":96004,"_22829":96005,"_2311":96006},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2783":56885,"_24070":56868,"_5":24403,"_16893":96008,"_22829":96009,"_2311":96010},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2783":56886,"_24070":56868,"_5":24403,"_16893":96012,"_22829":96013,"_2311":96014},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2783":56887,"_24070":56868,"_5":24403,"_16893":96016,"_22829":96017,"_2311":96018},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2783":56888,"_24070":56868,"_5":24403,"_16893":96020,"_22829":96021,"_2311":96022},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2783":56889,"_24070":56868,"_5":24403,"_16893":96024,"_22829":96025,"_2311":96026},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2783":56890,"_24070":56868,"_16893":96028,"_5":16788,"_22829":56868,"_2311":96029},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2783":56891,"_24070":56868,"_16893":96031,"_5":16788,"_22829":56868,"_2311":96032},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2783":56892,"_24070":56868,"_16893":96034,"_5":16788,"_22829":56868,"_2311":96035},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2783":56893,"_24070":56868,"_16893":96037,"_5":16788,"_22829":95951,"_2311":96038},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2783":56894,"_24070":56868,"_16893":96040,"_5":16788,"_22829":95951,"_2311":96041},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2783":56895,"_24070":56868,"_16893":96043,"_5":16788,"_22829":95951,"_2311":96044},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2783":56896,"_24070":56868,"_16893":96046,"_5":16788,"_22829":95951,"_2311":96047},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2783":56897,"_24070":56868,"_16893":96049,"_5":16788,"_22829":95955,"_2311":96050},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2783":56898,"_24070":56868,"_16893":96052,"_5":16788,"_22829":95959,"_2311":96053},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2783":56899,"_24070":56868,"_16893":96055,"_5":16788,"_22829":95959,"_2311":96056},[],"Acción IAM",{"_2783":56900,"_24070":56868,"_16893":96058,"_5":16788,"_22829":95959,"_2311":92854},[],{"_2783":56901,"_24070":56868,"_16893":96060,"_5":16788,"_22829":95959,"_2311":42997},[],{"_2783":56902,"_24070":56868,"_16893":96062,"_5":16788,"_22829":95959,"_2311":96063},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2783":56903,"_24070":56868,"_16893":96065,"_5":16788,"_22829":95959,"_2311":43003},[],{"_2783":56904,"_24070":56868,"_16893":96067,"_5":16788,"_22829":95959,"_2311":96068},[],"Registrar la CA en AWS IoT",{"_2783":56905,"_24070":56868,"_16893":96070,"_5":16788,"_22829":95959,"_2311":43009},[],{"_2783":56906,"_24070":56868,"_16893":96072,"_5":16788,"_22829":95959,"_2311":96073},[],"Consultar el estado del registro de la CA",{"_2783":56907,"_24070":56868,"_16893":96075,"_5":16788,"_22829":95959,"_2311":43015},[],{"_2783":56908,"_24070":56868,"_16893":96077,"_5":16788,"_22829":95959,"_2311":96078},[],"Crear o actualizar Things en IoT Core",{"_2783":56909,"_24070":56868,"_16893":96080,"_5":16788,"_22829":95959,"_2311":43021},[],{"_2783":56910,"_24070":56868,"_16893":96082,"_5":16788,"_22829":95959,"_2311":96083},[],"Aprovisionar Things mediante plantilla",{"_2783":56911,"_24070":56868,"_16893":96085,"_5":16788,"_22829":95959,"_2311":43027},[],{"_2783":56912,"_24070":56868,"_16893":96087,"_5":16788,"_22829":95959,"_2311":96088},[],"Registrar certificados de dispositivo",{"_2783":56913,"_24070":56868,"_16893":96090,"_5":16788,"_22829":95959,"_2311":43033},[],{"_2783":56914,"_24070":56868,"_16893":96092,"_5":16788,"_22829":95959,"_2311":96093},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2783":56915,"_24070":56868,"_16893":96095,"_5":16788,"_22829":95959,"_2311":43039},[],{"_2783":56916,"_24070":56868,"_16893":96097,"_5":16788,"_22829":95959,"_2311":96098},[],"Crear y adjuntar políticas IoT",{"_2783":56917,"_24070":56868,"_16893":96100,"_5":16788,"_22829":95959,"_2311":43045},[],{"_2783":56918,"_24070":56868,"_16893":96102,"_5":16788,"_22829":95959,"_2311":96103},[],"Gestionar grupos de Things",{"_2783":56919,"_24070":56868,"_16893":96105,"_5":16788,"_22829":95959,"_2311":43051},[],{"_2783":56920,"_24070":56868,"_16893":96107,"_5":16788,"_22829":95959,"_2311":96108},[],"Crear plantillas JITP",{"_2783":56921,"_24070":56868,"_16893":96110,"_5":16788,"_22829":95959,"_2311":43057},[],{"_2783":56922,"_24070":56868,"_16893":96112,"_5":16788,"_22829":95959,"_2311":96113},[],"Leer y escribir el Device Shadow",{"_2783":56923,"_24070":56868,"_16893":96115,"_5":16788,"_22829":95959,"_2311":96116},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2783":56924,"_24070":56868,"_16893":96118,"_5":16788,"_22829":95963,"_2311":96119},[],"Parámetro",{"_2783":56925,"_24070":56868,"_16893":96121,"_5":16788,"_22829":95963,"_2311":96122},[],"Tipo",{"_2783":56926,"_24070":56868,"_16893":96124,"_5":16788,"_22829":95963,"_2311":96125},[],"Requerido",{"_2783":56927,"_24070":56868,"_16893":96127,"_5":16788,"_22829":95963,"_2311":96128},[],"Descripción",{"_2783":56928,"_24070":56868,"_16893":96130,"_5":16788,"_22829":95963,"_2311":43078},[],{"_2783":56929,"_24070":56868,"_16893":96132,"_5":16788,"_22829":95963,"_2311":20125},[],{"_2783":56930,"_24070":56868,"_16893":96134,"_5":16788,"_22829":95963,"_2311":96135},[],"Sí",{"_2783":56931,"_24070":56868,"_16893":96137,"_5":16788,"_22829":95963,"_2311":96138},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2783":56932,"_24070":56868,"_16893":96140,"_5":16788,"_22829":95963,"_2311":43089},[],{"_2783":56933,"_24070":56868,"_16893":96142,"_5":16788,"_22829":95963,"_2311":20125},[],{"_2783":56934,"_24070":56868,"_16893":96144,"_5":16788,"_22829":95963,"_2311":96135},[],{"_2783":56935,"_24070":56868,"_16893":96146,"_5":16788,"_22829":95963,"_2311":96147},[],"Región AWS donde opera el conector.",{"_2783":56936,"_24070":56868,"_16893":96149,"_5":16788,"_22829":95963,"_2311":43099},[],{"_2783":56937,"_24070":56868,"_16893":96151,"_5":16788,"_22829":95963,"_2311":20125},[],{"_2783":56938,"_24070":56868,"_16893":96153,"_5":16788,"_22829":95963,"_2311":96135},[],{"_2783":56939,"_24070":56868,"_16893":96155,"_5":16788,"_22829":95963,"_2311":96156},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2783":56940,"_24070":56868,"_16893":96158,"_5":16788,"_22829":95963,"_2311":43109},[],{"_2783":56941,"_24070":56868,"_16893":96160,"_5":16788,"_22829":95963,"_2311":20125},[],{"_2783":56942,"_24070":56868,"_16893":96162,"_5":16788,"_22829":95963,"_2311":96163},[],"Solo con `auth_method=static`",{"_2783":56943,"_24070":56868,"_16893":96165,"_5":16788,"_22829":95963,"_2311":96166},[],"Clave de acceso AWS.",{"_2783":56944,"_24070":56868,"_16893":96168,"_5":16788,"_22829":95963,"_2311":43120},[],{"_2783":56945,"_24070":56868,"_16893":96170,"_5":16788,"_22829":95963,"_2311":20125},[],{"_2783":56946,"_24070":56868,"_16893":96172,"_5":16788,"_22829":95963,"_2311":96163},[],{"_2783":56947,"_24070":56868,"_16893":96174,"_5":16788,"_22829":95963,"_2311":96175},[],"Clave secreta AWS.",{"_2783":56948,"_24070":56868,"_16893":96177,"_5":16788,"_22829":95963,"_2311":43130},[],{"_2783":56949,"_24070":56868,"_16893":96179,"_5":16788,"_22829":95963,"_2311":20125},[],{"_2783":56950,"_24070":56868,"_16893":96181,"_5":16788,"_22829":95963,"_2311":43135},[],{"_2783":56951,"_24070":56868,"_16893":96183,"_5":16788,"_22829":95963,"_2311":96184},[],"Token de sesión (con `auth_method=static`).",{"_2783":56952,"_24070":56868,"_16893":96186,"_5":16788,"_22829":95963,"_2311":43141},[],{"_2783":56953,"_24070":56868,"_16893":96188,"_5":16788,"_22829":95963,"_2311":20125},[],{"_2783":56954,"_24070":56868,"_16893":96190,"_5":16788,"_22829":95963,"_2311":96191},[],"Solo con `auth_method=role`",{"_2783":56955,"_24070":56868,"_16893":96193,"_5":16788,"_22829":95963,"_2311":96194},[],"ARN del rol a asumir.",{"_2783":56956,"_24070":56868,"_16893":96196,"_5":16788,"_22829":95963,"_2311":43152},[],{"_2783":56957,"_24070":56868,"_16893":96198,"_5":16788,"_22829":95963,"_2311":20125},[],{"_2783":56958,"_24070":56868,"_16893":96200,"_5":16788,"_22829":95963,"_2311":43135},[],{"_2783":56959,"_24070":56868,"_16893":96202,"_5":16788,"_22829":95963,"_2311":96203},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2783":56960,"_24070":56868,"_16893":96205,"_5":16788,"_22829":95963,"_2311":43162},[],{"_2783":56961,"_24070":56868,"_16893":96207,"_5":16788,"_22829":95963,"_2311":14212},[],{"_2783":56962,"_24070":56868,"_16893":96209,"_5":16788,"_22829":95963,"_2311":96135},[],{"_2783":56963,"_24070":56868,"_16893":96211,"_5":16788,"_22829":95963,"_2311":96212},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2783":56964,"_24070":56868,"_16893":96214,"_5":16788,"_22829":95963,"_2311":43172},[],{"_2783":56965,"_24070":56868,"_16893":96216,"_5":16788,"_22829":95963,"_2311":20125},[],{"_2783":56966,"_24070":56868,"_16893":96218,"_5":16788,"_22829":95963,"_2311":96135},[],{"_2783":56967,"_24070":56868,"_16893":96220,"_5":16788,"_22829":95963,"_2311":96221},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2783":56968,"_24070":56868,"_16893":96223,"_5":16788,"_22829":95963,"_2311":43182},[],{"_2783":56969,"_24070":56868,"_16893":96225,"_5":16788,"_22829":95963,"_2311":20125},[],{"_2783":56970,"_24070":56868,"_16893":96227,"_5":16788,"_22829":95963,"_2311":96135},[],{"_2783":56971,"_24070":56868,"_16893":96229,"_5":16788,"_22829":95963,"_2311":96230},[],"URL HTTP del Device Manager de Lamassu.",{"_2783":56972,"_24070":56868,"_16893":96232,"_5":16788,"_22829":95963,"_2311":43192},[],{"_2783":56973,"_24070":56868,"_16893":96234,"_5":16788,"_22829":95963,"_2311":20125},[],{"_2783":56974,"_24070":56868,"_16893":96236,"_5":16788,"_22829":95963,"_2311":96135},[],{"_2783":56975,"_24070":56868,"_16893":96238,"_5":16788,"_22829":95963,"_2311":96239},[],"URL HTTP del servicio de CA de Lamassu.",{"_2783":56976,"_24070":56868,"_16893":96241,"_5":16788,"_22829":95967,"_2311":96242},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2783":56977,"_24070":56868,"_16893":96244,"_5":16788,"_22829":95971,"_2311":96245},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2783":56978,"_24070":56868,"_16893":96247,"_5":16788,"_22829":95971,"_2311":96248},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2783":56979,"_24070":56868,"_16893":96250,"_5":16788,"_22829":95975,"_2311":96251},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2783":56980,"_24070":56868,"_16893":96253,"_5":16788,"_22829":95975,"_2311":96254},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2783":56981,"_24070":56868,"_16893":96256,"_5":16788,"_22829":95975,"_2311":96257},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2783":56982,"_24070":56868,"_16893":96259,"_5":16788,"_22829":95975,"_2311":96260},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2783":56983,"_24070":56868,"_16893":96262,"_5":16788,"_22829":95975,"_2311":96263},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2783":56984,"_24070":56868,"_16893":96265,"_5":16788,"_22829":95975,"_2311":96266},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2783":56985,"_24070":56868,"_16893":96268,"_5":16788,"_22829":95978,"_2311":96269},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2783":56986,"_24070":56868,"_16893":96271,"_5":16788,"_22829":95981,"_2311":96272},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2783":56987,"_24070":56868,"_16893":96274,"_5":16788,"_22829":95981,"_2311":96275},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2783":56988,"_24070":56868,"_16893":96277,"_5":16788,"_22829":95985,"_2311":96278},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2783":56989,"_24070":56868,"_16893":96280,"_5":16788,"_22829":95989,"_2311":96281},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2783":56990,"_24070":56868,"_16893":96283,"_5":16788,"_22829":95989,"_2311":96284},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2783":56991,"_24070":56868,"_16893":96286,"_5":16788,"_22829":95989,"_2311":96287},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2783":56992,"_24070":56868,"_16893":96289,"_5":16788,"_22829":95989,"_2311":96290},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2783":56993,"_24070":56868,"_16893":96292,"_5":16788,"_22829":95989,"_2311":96293},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2783":56994,"_24070":56868,"_16893":96295,"_5":16788,"_22829":95989,"_2311":96296},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2783":56995,"_24070":56868,"_16893":96298,"_5":16788,"_22829":95993,"_2311":96299},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2783":56996,"_24070":56868,"_16893":96301,"_5":16788,"_22829":95993,"_2311":96302},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2783":56997,"_24070":56868,"_16893":96304,"_5":16788,"_22829":95993,"_2311":96305},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2783":56998,"_24070":56868,"_16893":96307,"_5":16788,"_22829":95997,"_2311":96308},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2783":56999,"_24070":56868,"_16893":96310,"_5":16788,"_22829":95997,"_2311":96311},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2783":57000,"_24070":56868,"_16893":96313,"_5":16788,"_22829":95997,"_2311":96314},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2783":57001,"_24070":56868,"_16893":96316,"_5":16788,"_22829":96001,"_2311":96317},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2783":57002,"_24070":56868,"_16893":96319,"_5":16788,"_22829":96001,"_2311":96320},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2783":57003,"_24070":56868,"_16893":96322,"_5":16788,"_22829":96001,"_2311":96323},[],"Para que el flujo JITP funcione correctamente:",{"_2783":57004,"_24070":56868,"_16893":96325,"_5":16788,"_22829":96001,"_2311":96326},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2783":57005,"_24070":56868,"_16893":96328,"_5":16788,"_22829":96001,"_2311":96329},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2783":57006,"_24070":56868,"_16893":96331,"_5":16788,"_22829":96001,"_2311":96332},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2783":57007,"_24070":56868,"_16893":96334,"_5":16788,"_22829":96001,"_2311":96335},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2783":57008,"_24070":56868,"_16893":96337,"_5":16788,"_22829":96005,"_2311":96338},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2783":57009,"_24070":56868,"_16893":96340,"_5":16788,"_22829":96005,"_2311":96341},[],"Estado en Lamassu",{"_2783":57010,"_24070":56868,"_16893":96343,"_5":16788,"_22829":96005,"_2311":96344},[],"Razón de revocación",{"_2783":57011,"_24070":56868,"_16893":96346,"_5":16788,"_22829":96005,"_2311":96347},[],"Estado en AWS IoT Core",{"_2783":57012,"_24070":56868,"_16893":96349,"_5":16788,"_22829":96005,"_2311":43313},[],{"_2783":57013,"_24070":56868,"_16893":96351,"_5":16788,"_22829":96005,"_2311":96352},[],"Ninguna",{"_2783":57014,"_24070":56868,"_16893":96354,"_5":16788,"_22829":96005,"_2311":43319},[],{"_2783":57015,"_24070":56868,"_16893":96356,"_5":16788,"_22829":96005,"_2311":43322},[],{"_2783":57016,"_24070":56868,"_16893":96358,"_5":16788,"_22829":96005,"_2311":43325},[],{"_2783":57017,"_24070":56868,"_16893":96360,"_5":16788,"_22829":96005,"_2311":43328},[],{"_2783":57018,"_24070":56868,"_16893":96362,"_5":16788,"_22829":96005,"_2311":43322},[],{"_2783":57019,"_24070":56868,"_16893":96364,"_5":16788,"_22829":96005,"_2311":96365},[],"Cualquier otra razón",{"_2783":57020,"_24070":56868,"_16893":96367,"_5":16788,"_22829":96005,"_2311":43336},[],{"_2783":57021,"_24070":56868,"_16893":96369,"_5":16788,"_22829":96005,"_2311":96370},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2783":57022,"_24070":56868,"_16893":96372,"_5":16788,"_22829":96009,"_2311":96373},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2783":57023,"_24070":56868,"_16893":96375,"_5":16788,"_22829":96009,"_2311":96376},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2783":57024,"_24070":56868,"_16893":96378,"_5":16788,"_22829":96009,"_2311":96379},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2783":57025,"_24070":56868,"_16893":96381,"_5":16788,"_22829":96013,"_2311":96382},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2783":57026,"_24070":56868,"_16893":96384,"_5":16788,"_22829":96013,"_2311":96385},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2783":57027,"_24070":56868,"_16893":96387,"_5":16788,"_22829":96017,"_2311":96388},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2783":57028,"_24070":56868,"_16893":96390,"_5":16788,"_22829":96017,"_2311":96391},[],"Existen dos tipos de acciones:",{"_2783":57029,"_24070":56868,"_16893":96393,"_5":16788,"_22829":96017,"_2311":96394},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2783":57030,"_24070":56868,"_16893":96396,"_5":16788,"_22829":96017,"_2311":96397},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2783":57031,"_24070":56868,"_16893":96399,"_5":16788,"_22829":96017,"_2311":96400},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2783":57032,"_24070":56868,"_16893":96402,"_5":16788,"_22829":96021,"_2311":96403},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2783":57033,"_24070":56868,"_16893":96405,"_5":16788,"_22829":96021,"_2311":96406},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2783":57034,"_24070":56868,"_16893":96408,"_5":16788,"_22829":96021,"_2311":96409},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2783":57035,"_24070":56868,"_16893":96411,"_5":16788,"_22829":96025,"_2311":96412},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2783":57036,"_24070":56868,"_16893":96414,"_5":16788,"_22829":96025,"_2311":96415},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2783":57037,"_24070":56868,"_16893":96417,"_5":16788,"_22829":96025,"_2311":96418},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2783":57038,"_24070":56868,"_16893":96420,"_5":16788,"_22829":96025,"_2311":96421},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2783":57039,"_24070":56868,"_16893":96423,"_5":16788,"_22829":96025,"_2311":96424},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2783":57040,"_24070":56868,"_16893":96426,"_5":16788,"_22829":96025,"_2311":96427},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2783":57041,"_24070":56868,"_16893":96429,"_5":16788,"_22829":96025,"_2311":96430},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2783":57042,"_24070":56868,"_16893":96432,"_5":16788,"_22829":96025,"_2311":96433},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2783":57043,"_24070":56868,"_16893":96435,"_5":16788,"_22829":96025,"_2311":96436},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2783":57044,"_24070":56868,"_16893":96438,"_5":16788,"_22829":96025,"_2311":96439},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2783":57045,"_24070":56868,"_16893":96441,"_5":16788,"_22829":96025,"_2311":96442},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2783":57046,"_24070":56868,"_16893":96444,"_5":16788,"_22829":96025,"_2311":96445},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2783":57047,"_24070":56868,"_16893":96447,"_5":16788,"_22829":96025,"_2311":96448},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2783":57048,"_24070":56868,"_16893":96450,"_5":16788,"_22829":96025,"_2311":96451},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2783":57049,"_24070":56868,"_16893":96453,"_5":16788,"_22829":96025,"_2311":96454},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2783":57050,"_24070":56868,"_16893":96456,"_5":16788,"_22829":96025,"_2311":96457},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2783":57051,"_24070":56868,"_16893":96459,"_5":16788,"_22829":96025,"_2311":96460},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2783":57052,"_24070":56868,"_16893":96462,"_5":16788,"_22829":96025,"_2311":96463},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2783":57053,"_24070":56868,"_16893":96465,"_5":16788,"_22829":96025,"_2311":96466},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2783":57054,"_24070":56868,"_16893":96468,"_5":16788,"_22829":96025,"_2311":96469},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2783":57055,"_24070":56868,"_16893":96471,"_5":16788,"_22829":96025,"_2311":96472},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2783":57056,"_24070":57056,"_5":11891,"_2311":41557,"_24406":96474,"_16893":96475,"_22829":57056},[39338,93790,41557],[],{"_2783":57057,"_24070":57056,"_16893":96477,"_5":16788,"_22829":57056,"_2311":96478},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2783":57058,"_24070":57056,"_5":24403,"_16893":96480,"_22829":96481,"_2311":96482},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2783":57059,"_24070":57056,"_5":24403,"_16893":96484,"_22829":96485,"_2311":94663},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2783":57060,"_24070":57056,"_5":24403,"_16893":96487,"_22829":96488,"_2311":94838},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2783":57061,"_24070":57056,"_5":24403,"_16893":96490,"_22829":96491,"_2311":95944},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/overview#integraciones",{"_2783":57062,"_24070":57056,"_5":24403,"_16893":96493,"_22829":96494,"_2311":96495},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2783":57063,"_24070":57056,"_16893":96497,"_5":16788,"_22829":57056,"_2311":96498},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2783":57064,"_24070":57056,"_16893":96500,"_5":16788,"_22829":96481,"_2311":96501},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2783":57065,"_24070":57056,"_16893":96503,"_5":16788,"_22829":96481,"_2311":96504},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2783":57066,"_24070":57056,"_16893":96506,"_5":16788,"_22829":96485,"_2311":96507},[],"Recurso",{"_2783":57067,"_24070":57056,"_16893":96509,"_5":16788,"_22829":96485,"_2311":96510},[],"Qué representa",{"_2783":57068,"_24070":57056,"_16893":96512,"_5":16788,"_22829":96485,"_2311":96513},[],"**Dispositivo**",{"_2783":57069,"_24070":57056,"_16893":96515,"_5":16788,"_22829":96485,"_2311":96516},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2783":57070,"_24070":57056,"_16893":96518,"_5":16788,"_22829":96485,"_2311":96519},[],"**Identidad**",{"_2783":57071,"_24070":57056,"_16893":96521,"_5":16788,"_22829":96485,"_2311":96522},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2783":57072,"_24070":57056,"_16893":96524,"_5":16788,"_22829":96485,"_2311":43494},[],{"_2783":57073,"_24070":57056,"_16893":96526,"_5":16788,"_22829":96485,"_2311":96527},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2783":57074,"_24070":57056,"_16893":96529,"_5":16788,"_22829":96485,"_2311":96530},[],"**Flota**",{"_2783":57075,"_24070":57056,"_16893":96532,"_5":16788,"_22829":96485,"_2311":96533},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2783":57076,"_24070":57056,"_16893":96535,"_5":16788,"_22829":96485,"_2311":96536},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2783":57077,"_24070":57056,"_16893":96538,"_5":16788,"_22829":96485,"_2311":96539},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2783":57078,"_24070":57056,"_16893":96541,"_5":16788,"_22829":96488,"_2311":96542},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2783":57079,"_24070":57056,"_16893":96544,"_5":16788,"_22829":96488,"_2311":96545},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2783":57080,"_24070":57056,"_16893":96547,"_5":16788,"_22829":96488,"_2311":96548},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2783":57081,"_24070":57056,"_16893":96550,"_5":16788,"_22829":96488,"_2311":96551},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2783":57082,"_24070":57056,"_16893":96553,"_5":16788,"_22829":96488,"_2311":96554},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2783":57083,"_24070":57056,"_16893":96556,"_5":16788,"_22829":96488,"_2311":96557},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2783":57084,"_24070":57056,"_16893":96559,"_5":16788,"_22829":96488,"_2311":96560},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2783":57085,"_24070":57056,"_16893":96562,"_5":16788,"_22829":96488,"_2311":96563},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2783":57086,"_24070":57056,"_16893":96565,"_5":16788,"_22829":96491,"_2311":96566},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2783":57087,"_24070":57056,"_16893":96568,"_5":16788,"_22829":96491,"_2311":96569},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2783":57088,"_24070":57056,"_16893":96571,"_5":16788,"_22829":96494,"_2311":96572},[],"Participante",{"_2783":57089,"_24070":57056,"_16893":96574,"_5":16788,"_22829":96494,"_2311":96575},[],"Responsabilidad",{"_2783":57090,"_24070":57056,"_16893":96577,"_5":16788,"_22829":96494,"_2311":96578},[],"Administrador PKI",{"_2783":57091,"_24070":57056,"_16893":96580,"_5":16788,"_22829":96494,"_2311":96581},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2783":57092,"_24070":57056,"_16893":96583,"_5":16788,"_22829":96494,"_2311":96584},[],"Administrador del aprovisionamiento",{"_2783":57093,"_24070":57056,"_16893":96586,"_5":16788,"_22829":96494,"_2311":96587},[],"DMS, admisión, autenticación por operación e inventario.",{"_2783":57094,"_24070":57056,"_16893":96589,"_5":16788,"_22829":96494,"_2311":96590},[],"Integrador del dispositivo",{"_2783":57095,"_24070":57056,"_16893":96592,"_5":16788,"_22829":96494,"_2311":96593},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2783":57096,"_24070":57056,"_16893":96595,"_5":16788,"_22829":96494,"_2311":96596},[],"Integrador del consumidor",{"_2783":57097,"_24070":57056,"_16893":96598,"_5":16788,"_22829":96494,"_2311":96599},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2783":57098,"_24070":57056,"_16893":96601,"_5":16788,"_22829":96494,"_2311":96602},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2783":57099,"_24070":57099,"_5":11891,"_2311":96604,"_24406":96605,"_16893":96607,"_22829":57099},"Enrola y conecta tu primer dispositivo",[39338,93790,41557,96606],"Primeros pasos",[],{"_2783":57100,"_24070":57099,"_16893":96609,"_5":16788,"_22829":57099,"_2311":96610},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2783":57101,"_24070":57099,"_5":24403,"_16893":96612,"_22829":96613,"_2311":92491},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2783":57102,"_24070":57099,"_5":24403,"_16893":96615,"_22829":96616,"_2311":96617},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2783":57103,"_24070":57099,"_5":24403,"_16893":96619,"_22829":96620,"_2311":96621},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2783":57104,"_24070":57099,"_5":24403,"_16893":96623,"_22829":96624,"_2311":96625},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2783":57105,"_24070":57099,"_5":24403,"_16893":96627,"_22829":96628,"_2311":96629},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2783":57106,"_24070":57099,"_5":24403,"_16893":96631,"_22829":96632,"_2311":96633},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2783":57107,"_24070":57099,"_5":24403,"_16893":96635,"_22829":96636,"_2311":96637},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2783":57108,"_24070":57099,"_5":24403,"_16893":96639,"_22829":96640,"_2311":96641},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2783":57109,"_24070":57099,"_16893":96643,"_5":16788,"_22829":57099,"_2311":96644},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2783":57110,"_24070":57099,"_16893":96646,"_5":16788,"_22829":96613,"_2311":96647},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2783":57111,"_24070":57099,"_16893":96649,"_5":16788,"_22829":96613,"_2311":96650},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2783":57112,"_24070":57099,"_16893":96652,"_5":16788,"_22829":96613,"_2311":96653},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2783":57113,"_24070":57099,"_16893":96655,"_5":16788,"_22829":96613,"_2311":96656},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2783":57114,"_24070":57099,"_16893":96658,"_5":16788,"_22829":96613,"_2311":96659},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2783":57115,"_24070":57099,"_16893":96661,"_5":16788,"_22829":96616,"_2311":96662},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2783":57116,"_24070":57099,"_16893":96664,"_5":16788,"_22829":96616,"_2311":96665},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2783":57117,"_24070":57099,"_16893":96667,"_5":16788,"_22829":96620,"_2311":96668},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2783":57118,"_24070":57099,"_16893":96670,"_5":16788,"_22829":96620,"_2311":96671},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2783":57119,"_24070":57099,"_16893":96673,"_5":16788,"_22829":96620,"_2311":96674},[],"Ajuste",{"_2783":57120,"_24070":57099,"_16893":96676,"_5":16788,"_22829":96620,"_2311":96677},[],"Valor de evaluación",{"_2783":57121,"_24070":57099,"_16893":96679,"_5":16788,"_22829":96620,"_2311":43650},[],{"_2783":57122,"_24070":57099,"_16893":96681,"_5":16788,"_22829":96620,"_2311":96682},[],"Raíz emisora de `device-root.pem`.",{"_2783":57123,"_24070":57099,"_16893":96684,"_5":16788,"_22829":96620,"_2311":94962},[],{"_2783":57124,"_24070":57099,"_16893":96686,"_5":16788,"_22829":96620,"_2311":96687},[],"Perfil final de 1 hora que acabas de preparar.",{"_2783":57125,"_24070":57099,"_16893":96689,"_5":16788,"_22829":96620,"_2311":43661},[],{"_2783":57126,"_24070":57099,"_16893":96691,"_5":16788,"_22829":96620,"_2311":43664},[],{"_2783":57127,"_24070":57099,"_16893":96693,"_5":16788,"_22829":96620,"_2311":43667},[],{"_2783":57128,"_24070":57099,"_16893":96695,"_5":16788,"_22829":96620,"_2311":96696},[],"Habilitado.",{"_2783":57129,"_24070":57099,"_16893":96698,"_5":16788,"_22829":96620,"_2311":43673},[],{"_2783":57130,"_24070":57099,"_16893":96700,"_5":16788,"_22829":96620,"_2311":96701},[],"Deshabilitado; el ID debe ser nuevo.",{"_2783":57131,"_24070":57099,"_16893":96703,"_5":16788,"_22829":96620,"_2311":96704},[],"Autenticación inicial",{"_2783":57132,"_24070":57099,"_16893":96706,"_5":16788,"_22829":96620,"_2311":96707},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2783":57133,"_24070":57099,"_16893":96709,"_5":16788,"_22829":96620,"_2311":96710},[],"Autenticación de renovación",{"_2783":57134,"_24070":57099,"_16893":96712,"_5":16788,"_22829":96620,"_2311":96713},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2783":57135,"_24070":57099,"_16893":96715,"_5":16788,"_22829":96620,"_2311":43691},[],{"_2783":57136,"_24070":57099,"_16893":96717,"_5":16788,"_22829":96620,"_2311":96718},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2783":57137,"_24070":57099,"_16893":96720,"_5":16788,"_22829":96620,"_2311":43697},[],{"_2783":57138,"_24070":57099,"_16893":96722,"_5":16788,"_22829":96620,"_2311":96723},[],"1 hora.",{"_2783":57139,"_24070":57099,"_16893":96725,"_5":16788,"_22829":96620,"_2311":43703},[],{"_2783":57140,"_24070":57099,"_16893":96727,"_5":16788,"_22829":96620,"_2311":96728},[],"30 minutos / 10 minutos.",{"_2783":57141,"_24070":57099,"_16893":96730,"_5":16788,"_22829":96620,"_2311":43709},[],{"_2783":57142,"_24070":57099,"_16893":96732,"_5":16788,"_22829":96620,"_2311":96733},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2783":57143,"_24070":57099,"_16893":96735,"_5":16788,"_22829":96620,"_2311":41872},[],{"_2783":57144,"_24070":57099,"_16893":96737,"_5":16788,"_22829":96620,"_2311":96738},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2783":57145,"_24070":57099,"_16893":96740,"_5":16788,"_22829":96620,"_2311":43720},[],{"_2783":57146,"_24070":57099,"_16893":96742,"_5":16788,"_22829":96620,"_2311":96743},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2783":57147,"_24070":57099,"_16893":96745,"_5":16788,"_22829":96620,"_2311":96746},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2783":57148,"_24070":57099,"_16893":96748,"_5":16788,"_22829":96624,"_2311":96749},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2783":57149,"_24070":57099,"_16893":96751,"_5":16788,"_22829":96624,"_2311":96752},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2783":57150,"_24070":57099,"_16893":96754,"_5":16788,"_22829":96628,"_2311":96755},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2783":57151,"_24070":57099,"_16893":96757,"_5":16788,"_22829":96628,"_2311":96758},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2783":57152,"_24070":57099,"_16893":96760,"_5":16788,"_22829":96628,"_2311":96761},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2783":57153,"_24070":57099,"_16893":96763,"_5":16788,"_22829":96632,"_2311":96764},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2783":57154,"_24070":57099,"_16893":96766,"_5":16788,"_22829":96632,"_2311":96767},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2783":57155,"_24070":57099,"_16893":96769,"_5":16788,"_22829":96636,"_2311":96770},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2783":57156,"_24070":57099,"_16893":96772,"_5":16788,"_22829":96636,"_2311":96773},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2783":57157,"_24070":57099,"_16893":96775,"_5":16788,"_22829":96636,"_2311":96776},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2783":57158,"_24070":57099,"_16893":96778,"_5":16788,"_22829":96636,"_2311":96779},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2783":57159,"_24070":57099,"_16893":96781,"_5":16788,"_22829":96636,"_2311":96782},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2783":57160,"_24070":57099,"_16893":96784,"_5":16788,"_22829":96640,"_2311":96785},[],"Comprobación",{"_2783":57161,"_24070":57099,"_16893":96787,"_5":16788,"_22829":96640,"_2311":96788},[],"Resultado esperado",{"_2783":57162,"_24070":57099,"_16893":96790,"_5":16788,"_22829":96640,"_2311":96791},[],"Registro",{"_2783":57163,"_24070":57099,"_16893":96793,"_5":16788,"_22829":96640,"_2311":96794},[],"ID creado automáticamente y DMS correcto.",{"_2783":57164,"_24070":57099,"_16893":96796,"_5":16788,"_22829":96640,"_2311":96797},[],"Certificado",{"_2783":57165,"_24070":57099,"_16893":96799,"_5":16788,"_22829":96640,"_2311":96800},[],"CN, perfil, serie y clave verificados.",{"_2783":57166,"_24070":57099,"_16893":96802,"_5":16788,"_22829":96640,"_2311":96803},[],"Inventario",{"_2783":57167,"_24070":57099,"_16893":96805,"_5":16788,"_22829":96640,"_2311":96806},[],"Serie recibida visible como identidad actual y en el historial.",{"_2783":57168,"_24070":57099,"_16893":96808,"_5":16788,"_22829":96640,"_2311":96809},[],"Consumidor",{"_2783":57169,"_24070":57099,"_16893":96811,"_5":16788,"_22829":96640,"_2311":96812},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2783":57170,"_24070":57099,"_16893":96814,"_5":16788,"_22829":96640,"_2311":96815},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2783":57171,"_24070":57099,"_16893":96817,"_5":16788,"_22829":96640,"_2311":96818},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2783":57172,"_24070":57172,"_5":11891,"_2311":94680,"_24406":96820,"_16893":96821,"_22829":57172},[39338,93790,41557,96606],[],{"_2783":57173,"_24070":57172,"_16893":96823,"_5":16788,"_22829":57172,"_2311":96824},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2783":57174,"_24070":57172,"_5":24403,"_16893":96826,"_22829":96827,"_2311":92491},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2783":57175,"_24070":57172,"_5":24403,"_16893":96829,"_22829":96830,"_2311":96831},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2783":57176,"_24070":57172,"_5":24403,"_16893":96833,"_22829":96834,"_2311":96835},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2783":57177,"_24070":57172,"_5":24403,"_16893":96837,"_22829":96838,"_2311":96839},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2783":57178,"_24070":57172,"_5":24403,"_16893":96841,"_22829":96842,"_2311":96843},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2783":57179,"_24070":57172,"_5":24403,"_16893":96845,"_22829":96846,"_2311":96847},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2783":57180,"_24070":57172,"_5":24403,"_16893":96849,"_22829":96850,"_2311":96788},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2783":57181,"_24070":57172,"_5":24403,"_16893":96852,"_22829":96853,"_2311":96854},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2783":57182,"_24070":57172,"_5":24403,"_16893":96856,"_22829":96857,"_2311":96858},[],"/docs/pr-preview/pr-27/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2783":57183,"_24070":57172,"_16893":96860,"_5":16788,"_22829":57172,"_2311":96861},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2783":57184,"_24070":57172,"_16893":96863,"_5":16788,"_22829":57172,"_2311":96864},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2783":57185,"_24070":57172,"_16893":96866,"_5":16788,"_22829":96827,"_2311":96867},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2783":57186,"_24070":57172,"_16893":96869,"_5":16788,"_22829":96827,"_2311":96870},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2783":57187,"_24070":57172,"_16893":96872,"_5":16788,"_22829":96827,"_2311":96873},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2783":57188,"_24070":57172,"_16893":96875,"_5":16788,"_22829":96827,"_2311":96876},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2783":57189,"_24070":57172,"_16893":96878,"_5":16788,"_22829":96830,"_2311":96879},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2783":57190,"_24070":57172,"_16893":96881,"_5":16788,"_22829":96830,"_2311":96882},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2783":57191,"_24070":57172,"_16893":96884,"_5":16788,"_22829":96830,"_2311":96885},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2783":57192,"_24070":57172,"_16893":96887,"_5":16788,"_22829":96830,"_2311":96888},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2783":57193,"_24070":57172,"_16893":96890,"_5":16788,"_22829":96830,"_2311":96891},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2783":57194,"_24070":57172,"_16893":96893,"_5":16788,"_22829":96830,"_2311":96894},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2783":57195,"_24070":57172,"_16893":96896,"_5":16788,"_22829":96830,"_2311":96897},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2783":57196,"_24070":57172,"_16893":96899,"_5":16788,"_22829":96830,"_2311":96900},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2783":57197,"_24070":57172,"_16893":96902,"_5":16788,"_22829":96834,"_2311":96903},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2783":57198,"_24070":57172,"_16893":96905,"_5":16788,"_22829":96834,"_2311":43886},[],{"_2783":57199,"_24070":57172,"_16893":96907,"_5":16788,"_22829":96834,"_2311":96908},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2783":57200,"_24070":57172,"_16893":96910,"_5":16788,"_22829":96834,"_2311":96911},[],"**Icon** y **Tags**: clasificación opcional.",{"_2783":57201,"_24070":57172,"_16893":96913,"_5":16788,"_22829":96834,"_2311":96914},[],"Confirma el registro.",{"_2783":57202,"_24070":57172,"_16893":96916,"_5":16788,"_22829":96838,"_2311":96917},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2783":57203,"_24070":57172,"_16893":96919,"_5":16788,"_22829":96838,"_2311":96920},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2783":57204,"_24070":57172,"_16893":96922,"_5":16788,"_22829":96842,"_2311":96923},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2783":57205,"_24070":57172,"_16893":96925,"_5":16788,"_22829":96842,"_2311":96926},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2783":57206,"_24070":57172,"_16893":96928,"_5":16788,"_22829":96846,"_2311":96929},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2783":57207,"_24070":57172,"_16893":96931,"_5":16788,"_22829":96846,"_2311":96932},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2783":57208,"_24070":57172,"_16893":96934,"_5":16788,"_22829":96850,"_2311":96785},[],{"_2783":57209,"_24070":57172,"_16893":96936,"_5":16788,"_22829":96850,"_2311":96937},[],"Resultado",{"_2783":57210,"_24070":57172,"_16893":96939,"_5":16788,"_22829":96850,"_2311":96940},[],"Dispositivo",{"_2783":57211,"_24070":57172,"_16893":96942,"_5":16788,"_22829":96850,"_2311":96943},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2783":57212,"_24070":57172,"_16893":96945,"_5":16788,"_22829":96850,"_2311":96946},[],"Identidad actual",{"_2783":57213,"_24070":57172,"_16893":96948,"_5":16788,"_22829":96850,"_2311":96949},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2783":57214,"_24070":57172,"_16893":96951,"_5":16788,"_22829":96850,"_2311":96952},[],"Historial",{"_2783":57215,"_24070":57172,"_16893":96954,"_5":16788,"_22829":96850,"_2311":96955},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2783":57216,"_24070":57172,"_16893":96957,"_5":16788,"_22829":96850,"_2311":96958},[],"Clave y certificado",{"_2783":57217,"_24070":57172,"_16893":96960,"_5":16788,"_22829":96850,"_2311":96961},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2783":57218,"_24070":57172,"_16893":96963,"_5":16788,"_22829":96853,"_2311":96964},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2783":57219,"_24070":57172,"_16893":96966,"_5":16788,"_22829":96853,"_2311":96967},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2783":57220,"_24070":57172,"_16893":96969,"_5":16788,"_22829":96853,"_2311":96970},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2783":57221,"_24070":57172,"_16893":96972,"_5":16788,"_22829":96853,"_2311":96973},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2783":57222,"_24070":57172,"_16893":96975,"_5":16788,"_22829":96857,"_2311":96976},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2783":57223,"_24070":57172,"_16893":96978,"_5":16788,"_22829":96857,"_2311":96979},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2783":57224,"_24070":57172,"_16893":96981,"_5":16788,"_22829":96857,"_2311":96982},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2783":57225,"_24070":57225,"_5":11891,"_2311":96984,"_24406":96985,"_16893":96986,"_22829":57225},"Plataforma Lamassu IoT",[39338,93790],[],{"_2783":57226,"_24070":57225,"_16893":96988,"_5":16788,"_22829":57225,"_2311":96989},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2783":57227,"_24070":57225,"_5":24403,"_16893":96991,"_22829":96992,"_2311":96482},[],"/docs/pr-preview/pr-27/es/platform/overview#empieza-aquí",{"_2783":57228,"_24070":57225,"_5":24403,"_16893":96994,"_22829":96995,"_2311":96996},[],"/docs/pr-preview/pr-27/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2783":57229,"_24070":57225,"_5":24403,"_16893":96998,"_22829":96999,"_2311":97000},[],"/docs/pr-preview/pr-27/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2783":57230,"_24070":57225,"_5":24403,"_16893":97002,"_22829":97003,"_2311":97004},[],"/docs/pr-preview/pr-27/es/platform/overview#capacidades-principales","Capacidades principales",{"_2783":57231,"_24070":57225,"_5":24403,"_16893":97006,"_22829":97007,"_2311":97008},[],"/docs/pr-preview/pr-27/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2783":57232,"_24070":57225,"_5":24403,"_16893":97010,"_22829":97011,"_2311":97012},[],"/docs/pr-preview/pr-27/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2783":57233,"_24070":57225,"_5":24403,"_16893":97014,"_22829":97015,"_2311":97016},[],"/docs/pr-preview/pr-27/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2783":57234,"_24070":57225,"_5":24403,"_16893":97018,"_22829":97019,"_2311":97020},[],"/docs/pr-preview/pr-27/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2783":57235,"_24070":57225,"_5":24403,"_16893":97022,"_22829":97023,"_2311":97024},[],"/docs/pr-preview/pr-27/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2783":57236,"_24070":57225,"_5":24403,"_16893":97026,"_22829":97027,"_2311":97028},[],"/docs/pr-preview/pr-27/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2783":57237,"_24070":57225,"_5":24403,"_16893":97030,"_22829":97031,"_2311":97032},[],"/docs/pr-preview/pr-27/es/platform/overview#referencia-operativa","Referencia operativa",{"_2783":57238,"_24070":57225,"_16893":97034,"_5":16788,"_22829":57225,"_2311":97035},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2783":57239,"_24070":57225,"_16893":97037,"_5":16788,"_22829":96992,"_2311":97038},[],"Elige el resultado que necesitas obtener:",{"_2783":57240,"_24070":57225,"_16893":97040,"_5":16788,"_22829":96992,"_2311":97041},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2783":57241,"_24070":57225,"_16893":97043,"_5":16788,"_22829":96992,"_2311":97044},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2783":57242,"_24070":57225,"_16893":97046,"_5":16788,"_22829":96992,"_2311":97047},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2783":57243,"_24070":57225,"_16893":97049,"_5":16788,"_22829":96995,"_2311":97050},[],"Bloque",{"_2783":57244,"_24070":57225,"_16893":97052,"_5":16788,"_22829":96995,"_2311":97053},[],"Qué gestionas",{"_2783":57245,"_24070":57225,"_16893":97055,"_5":16788,"_22829":96995,"_2311":97056},[],"Punto de entrada",{"_2783":57246,"_24070":57225,"_16893":97058,"_5":16788,"_22829":96995,"_2311":44040},[],{"_2783":57247,"_24070":57225,"_16893":97060,"_5":16788,"_22829":96995,"_2311":97061},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2783":57248,"_24070":57225,"_16893":97063,"_5":16788,"_22829":96995,"_2311":97064},[],"Visión general de PKI",{"_2783":57249,"_24070":57225,"_16893":97066,"_5":16788,"_22829":96995,"_2311":44049},[],{"_2783":57250,"_24070":57225,"_16893":97068,"_5":16788,"_22829":96995,"_2311":97069},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2783":57251,"_24070":57225,"_16893":97071,"_5":16788,"_22829":96995,"_2311":97072},[],"Visión general de IoT Fleets",{"_2783":57252,"_24070":57225,"_16893":97074,"_5":16788,"_22829":96995,"_2311":97075},[],"**Administración**",{"_2783":57253,"_24070":57225,"_16893":97077,"_5":16788,"_22829":96995,"_2311":97078},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2783":57254,"_24070":57225,"_16893":97080,"_5":16788,"_22829":96995,"_2311":93788},[],{"_2783":57255,"_24070":57225,"_16893":97082,"_5":16788,"_22829":96995,"_2311":97083},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2783":57256,"_24070":57225,"_16893":97085,"_5":16788,"_22829":96999,"_2311":97086},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2783":57257,"_24070":57225,"_16893":97088,"_5":16788,"_22829":96999,"_2311":97089},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2783":57258,"_24070":57225,"_16893":97091,"_5":16788,"_22829":96999,"_2311":97092},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2783":57259,"_24070":57225,"_16893":97094,"_5":16788,"_22829":96999,"_2311":97095},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2783":57260,"_24070":57225,"_16893":97097,"_5":16788,"_22829":96999,"_2311":97098},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2783":57261,"_24070":57225,"_16893":97100,"_5":16788,"_22829":96999,"_2311":97101},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2783":57262,"_24070":57225,"_16893":97103,"_5":16788,"_22829":97007,"_2311":97104},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2783":57263,"_24070":57225,"_16893":97106,"_5":16788,"_22829":97011,"_2311":97107},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2783":57264,"_24070":57225,"_16893":97109,"_5":16788,"_22829":97015,"_2311":97110},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2783":57265,"_24070":57225,"_16893":97112,"_5":16788,"_22829":97019,"_2311":97113},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2783":57266,"_24070":57225,"_16893":97115,"_5":16788,"_22829":97023,"_2311":97116},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2783":57267,"_24070":57225,"_16893":97118,"_5":16788,"_22829":97027,"_2311":97119},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2783":57268,"_24070":57225,"_16893":97121,"_5":16788,"_22829":97031,"_2311":96575},[],{"_2783":57269,"_24070":57225,"_16893":97123,"_5":16788,"_22829":97031,"_2311":97124},[],"Qué prepara o comprueba",{"_2783":57270,"_24070":57225,"_16893":97126,"_5":16788,"_22829":97031,"_2311":96578},[],{"_2783":57271,"_24070":57225,"_16893":97128,"_5":16788,"_22829":97031,"_2311":97129},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2783":57272,"_24070":57225,"_16893":97131,"_5":16788,"_22829":97031,"_2311":97132},[],"Administrador de la flota",{"_2783":57273,"_24070":57225,"_16893":97134,"_5":16788,"_22829":97031,"_2311":97135},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2783":57274,"_24070":57225,"_16893":97137,"_5":16788,"_22829":97031,"_2311":96590},[],{"_2783":57275,"_24070":57225,"_16893":97139,"_5":16788,"_22829":97031,"_2311":97140},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2783":57276,"_24070":57225,"_16893":97142,"_5":16788,"_22829":97031,"_2311":96596},[],{"_2783":57277,"_24070":57225,"_16893":97144,"_5":16788,"_22829":97031,"_2311":97145},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2783":57278,"_24070":57225,"_16893":97147,"_5":16788,"_22829":97031,"_2311":97148},[],"Operador de infraestructura",{"_2783":57279,"_24070":57225,"_16893":97150,"_5":16788,"_22829":97031,"_2311":97151},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2783":57280,"_24070":57225,"_16893":97153,"_5":16788,"_22829":97031,"_2311":97154},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2783":57281,"_24070":57281,"_5":11891,"_2311":97156,"_24406":97157,"_16893":97159,"_22829":57281},"Jerarquía y rotación de CAs",[39338,93790,44141,97158],"Claves, autoridades y certificados",[],{"_2783":57282,"_24070":57281,"_16893":97161,"_5":16788,"_22829":57281,"_2311":97162},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2783":57283,"_24070":57281,"_5":24403,"_16893":97164,"_22829":97165,"_2311":97166},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2783":57284,"_24070":57281,"_5":24403,"_16893":97168,"_22829":97169,"_2311":97170},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2783":57285,"_24070":57281,"_5":24403,"_16893":97172,"_22829":97173,"_2311":97174},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2783":57286,"_24070":57281,"_5":24403,"_16893":97176,"_22829":97177,"_2311":97178},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2783":57287,"_24070":57281,"_5":24403,"_16893":97180,"_22829":97181,"_2311":97182},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2783":57288,"_24070":57281,"_5":24403,"_16893":97184,"_22829":97185,"_2311":97186},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2783":57289,"_24070":57281,"_5":24403,"_16893":97188,"_22829":97189,"_2311":97190},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2783":57290,"_24070":57281,"_5":24403,"_16893":97192,"_22829":97193,"_2311":97194},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2783":57291,"_24070":57281,"_5":24403,"_16893":97196,"_22829":97197,"_2311":97198},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2783":57292,"_24070":57281,"_5":24403,"_16893":97200,"_22829":97201,"_2311":97202},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2783":57293,"_24070":57281,"_5":24403,"_16893":97204,"_22829":97205,"_2311":97206},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2783":57294,"_24070":57281,"_5":24403,"_16893":97208,"_22829":97209,"_2311":97210},[],"/docs/pr-preview/pr-27/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2783":57295,"_24070":57281,"_16893":97212,"_5":16788,"_22829":57281,"_2311":97213},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2783":57296,"_24070":57281,"_16893":97215,"_5":16788,"_22829":57281,"_2311":97216},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2783":57297,"_24070":57281,"_16893":97218,"_5":16788,"_22829":97165,"_2311":97219},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2783":57298,"_24070":57281,"_16893":97221,"_5":16788,"_22829":97165,"_2311":97222},[],"entorno, como producción y preproducción;",{"_2783":57299,"_24070":57281,"_16893":97224,"_5":16788,"_22829":97165,"_2311":97225},[],"propietario o equipo operador;",{"_2783":57300,"_24070":57281,"_16893":97227,"_5":16788,"_22829":97165,"_2311":97228},[],"familia de dispositivos o proceso de fabricación;",{"_2783":57301,"_24070":57281,"_16893":97230,"_5":16788,"_22829":97165,"_2311":97231},[],"región o requisito regulatorio;",{"_2783":57302,"_24070":57281,"_16893":97233,"_5":16788,"_22829":97165,"_2311":97234},[],"motor criptográfico o política de clave;",{"_2783":57303,"_24070":57281,"_16893":97236,"_5":16788,"_22829":97165,"_2311":97237},[],"ventana de mantenimiento y ritmo de renovación.",{"_2783":57304,"_24070":57281,"_16893":97239,"_5":16788,"_22829":97165,"_2311":97240},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2783":57305,"_24070":57281,"_16893":97242,"_5":16788,"_22829":97165,"_2311":97243},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2783":57306,"_24070":57281,"_16893":97245,"_5":16788,"_22829":97169,"_2311":97246},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2783":57307,"_24070":57281,"_16893":97248,"_5":16788,"_22829":97169,"_2311":97249},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2783":57308,"_24070":57281,"_16893":97251,"_5":16788,"_22829":97169,"_2311":97252},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2783":57309,"_24070":57281,"_16893":97254,"_5":16788,"_22829":97173,"_2311":97255},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2783":57310,"_24070":57281,"_16893":97257,"_5":16788,"_22829":97173,"_2311":97258},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2783":57311,"_24070":57281,"_16893":97260,"_5":16788,"_22829":97173,"_2311":97261},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2783":57312,"_24070":57281,"_16893":97263,"_5":16788,"_22829":97173,"_2311":97264},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2783":57313,"_24070":57281,"_16893":97266,"_5":16788,"_22829":97181,"_2311":97267},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2783":57314,"_24070":57281,"_16893":97269,"_5":16788,"_22829":97185,"_2311":97270},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2783":57315,"_24070":57281,"_16893":97272,"_5":16788,"_22829":97189,"_2311":97273},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2783":57316,"_24070":57281,"_16893":97275,"_5":16788,"_22829":97193,"_2311":97276},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2783":57317,"_24070":57281,"_16893":97278,"_5":16788,"_22829":97197,"_2311":97279},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2783":57318,"_24070":57281,"_16893":97281,"_5":16788,"_22829":97201,"_2311":97282},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2783":57319,"_24070":57281,"_16893":97284,"_5":16788,"_22829":97205,"_2311":97285},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2783":57320,"_24070":57281,"_16893":97287,"_5":16788,"_22829":97205,"_2311":97288},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2783":57321,"_24070":57281,"_16893":97290,"_5":16788,"_22829":97205,"_2311":97291},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2783":57322,"_24070":57281,"_16893":97293,"_5":16788,"_22829":97205,"_2311":97294},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2783":57323,"_24070":57281,"_16893":97296,"_5":16788,"_22829":97209,"_2311":97297},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2783":57324,"_24070":57281,"_16893":97299,"_5":16788,"_22829":97209,"_2311":97300},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2783":57325,"_24070":57281,"_16893":97302,"_5":16788,"_22829":97209,"_2311":97303},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2783":57326,"_24070":57281,"_16893":97305,"_5":16788,"_22829":97209,"_2311":97306},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2783":57327,"_24070":57281,"_16893":97308,"_5":16788,"_22829":97209,"_2311":97309},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2783":57328,"_24070":57281,"_16893":97311,"_5":16788,"_22829":97209,"_2311":97312},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2783":57329,"_24070":57281,"_16893":97314,"_5":16788,"_22829":97209,"_2311":97315},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2783":57330,"_24070":57330,"_5":11891,"_2311":97317,"_24406":97318,"_16893":97319,"_22829":57330},"Autoridades de certificación",[39338,93790,44141,97158],[],{"_2783":57331,"_24070":57330,"_16893":97321,"_5":16788,"_22829":57330,"_2311":97322},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2783":57332,"_24070":57330,"_5":24403,"_16893":97324,"_22829":97325,"_2311":97326},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2783":57333,"_24070":57330,"_5":24403,"_16893":97328,"_22829":97329,"_2311":97330},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2783":57334,"_24070":57330,"_5":24403,"_16893":97332,"_22829":97333,"_2311":92491},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2783":57335,"_24070":57330,"_5":24403,"_16893":97335,"_22829":97336,"_2311":97337},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2783":57336,"_24070":57330,"_5":24403,"_16893":97339,"_22829":97340,"_2311":97341},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2783":57337,"_24070":57330,"_5":24403,"_16893":97343,"_22829":97344,"_2311":97345},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2783":57338,"_24070":57330,"_5":24403,"_16893":97347,"_22829":97348,"_2311":97349},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2783":57339,"_24070":57330,"_5":24403,"_16893":97351,"_22829":97352,"_2311":97353},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2783":57340,"_24070":57330,"_5":24403,"_16893":97355,"_22829":97356,"_2311":97357},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2783":57341,"_24070":57330,"_5":24403,"_16893":97359,"_22829":97360,"_2311":97361},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2783":57342,"_24070":57330,"_5":24403,"_16893":97363,"_22829":97364,"_2311":97365},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2783":57343,"_24070":57330,"_5":24403,"_16893":97367,"_22829":97368,"_2311":97369},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2783":57344,"_24070":57330,"_5":24403,"_16893":97371,"_22829":97372,"_2311":97373},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2783":57345,"_24070":57330,"_5":24403,"_16893":97375,"_22829":97376,"_2311":97377},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2783":57346,"_24070":57330,"_5":24403,"_16893":97379,"_22829":97380,"_2311":97381},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2783":57347,"_24070":57330,"_5":24403,"_16893":97383,"_22829":97384,"_2311":97385},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2783":57348,"_24070":57330,"_5":24403,"_16893":97387,"_22829":97388,"_2311":97389},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2783":57349,"_24070":57330,"_5":24403,"_16893":97391,"_22829":97392,"_2311":97393},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2783":57350,"_24070":57330,"_5":24403,"_16893":97395,"_22829":97396,"_2311":97397},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2783":57351,"_24070":57330,"_5":24403,"_16893":97399,"_22829":97400,"_2311":97401},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2783":57352,"_24070":57330,"_5":24403,"_16893":97403,"_22829":97404,"_2311":97405},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2783":57353,"_24070":57330,"_5":24403,"_16893":97407,"_22829":97408,"_2311":97409},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2783":57354,"_24070":57330,"_16893":97411,"_5":16788,"_22829":57330,"_2311":97412},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2783":57355,"_24070":57330,"_16893":97414,"_5":16788,"_22829":57330,"_2311":97415},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2783":57356,"_24070":57330,"_16893":97417,"_5":16788,"_22829":57330,"_2311":97418},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2783":57357,"_24070":57330,"_16893":97420,"_5":16788,"_22829":97325,"_2311":97421},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2783":57358,"_24070":57330,"_16893":97423,"_5":16788,"_22829":97325,"_2311":97424},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2783":57359,"_24070":57330,"_16893":97426,"_5":16788,"_22829":97325,"_2311":97427},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2783":57360,"_24070":57330,"_16893":97429,"_5":16788,"_22829":97325,"_2311":97430},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2783":57361,"_24070":57330,"_16893":97432,"_5":16788,"_22829":97325,"_2311":97433},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2783":57362,"_24070":57330,"_16893":97435,"_5":16788,"_22829":97333,"_2311":97436},[],"Decide si la CA será raíz o intermedia.",{"_2783":57363,"_24070":57330,"_16893":97438,"_5":16788,"_22829":97333,"_2311":97439},[],"Elige el motor que custodiará la clave.",{"_2783":57364,"_24070":57330,"_16893":97441,"_5":16788,"_22829":97333,"_2311":97442},[],"Define una validez superior a la de los certificados que emitirá.",{"_2783":57365,"_24070":57330,"_16893":97444,"_5":16788,"_22829":97333,"_2311":97445},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2783":57366,"_24070":57330,"_16893":97447,"_5":16788,"_22829":97336,"_2311":97448},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2783":57367,"_24070":57330,"_16893":97450,"_5":16788,"_22829":97340,"_2311":97451},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2783":57368,"_24070":57330,"_16893":97453,"_5":16788,"_22829":97340,"_2311":97454},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2783":57369,"_24070":57330,"_16893":97456,"_5":16788,"_22829":97344,"_2311":97457},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2783":57370,"_24070":57330,"_16893":97459,"_5":16788,"_22829":97348,"_2311":97460},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2783":57371,"_24070":57330,"_16893":97462,"_5":16788,"_22829":97348,"_2311":97463},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2783":57372,"_24070":57330,"_16893":97465,"_5":16788,"_22829":97348,"_2311":97466},[],"`ST`: estado o provincia.",{"_2783":57373,"_24070":57330,"_16893":97468,"_5":16788,"_22829":97348,"_2311":97469},[],"`L`: localidad.",{"_2783":57374,"_24070":57330,"_16893":97471,"_5":16788,"_22829":97348,"_2311":97472},[],"`O`: organización.",{"_2783":57375,"_24070":57330,"_16893":97474,"_5":16788,"_22829":97348,"_2311":97475},[],"`OU`: unidad organizativa.",{"_2783":57376,"_24070":57330,"_16893":97477,"_5":16788,"_22829":97348,"_2311":97478},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2783":57377,"_24070":57330,"_16893":97480,"_5":16788,"_22829":97352,"_2311":97481},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2783":57378,"_24070":57330,"_16893":97483,"_5":16788,"_22829":97352,"_2311":97484},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2783":57379,"_24070":57330,"_16893":97486,"_5":16788,"_22829":97356,"_2311":97487},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2783":57380,"_24070":57330,"_16893":97489,"_5":16788,"_22829":97356,"_2311":97490},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2783":57381,"_24070":57330,"_16893":97492,"_5":16788,"_22829":97360,"_2311":97493},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2783":57382,"_24070":57330,"_16893":97495,"_5":16788,"_22829":97360,"_2311":97496},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2783":57383,"_24070":57330,"_16893":97498,"_5":16788,"_22829":97364,"_2311":97499},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2783":57384,"_24070":57330,"_16893":97501,"_5":16788,"_22829":97368,"_2311":97502},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2783":57385,"_24070":57330,"_16893":97504,"_5":16788,"_22829":97372,"_2311":97505},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2783":57386,"_24070":57330,"_16893":97507,"_5":16788,"_22829":97376,"_2311":97508},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2783":57387,"_24070":57330,"_16893":97510,"_5":16788,"_22829":97380,"_2311":97511},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2783":57388,"_24070":57330,"_16893":97513,"_5":16788,"_22829":97380,"_2311":97514},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2783":57389,"_24070":57330,"_16893":97516,"_5":16788,"_22829":97384,"_2311":97517},[],"Abre una CA desde el inventario para consultar:",{"_2783":57390,"_24070":57330,"_16893":97519,"_5":16788,"_22829":97384,"_2311":97520},[],"Estado y periodo de validez.",{"_2783":57391,"_24070":57330,"_16893":97522,"_5":16788,"_22829":97384,"_2311":97523},[],"Certificado y cadena en formato PEM.",{"_2783":57392,"_24070":57330,"_16893":97525,"_5":16788,"_22829":97384,"_2311":97526},[],"Número de certificados activos, expirados y revocados.",{"_2783":57393,"_24070":57330,"_16893":97528,"_5":16788,"_22829":97384,"_2311":97529},[],"Certificados emitidos en **Issued Certificates**.",{"_2783":57394,"_24070":57330,"_16893":97531,"_5":16788,"_22829":97384,"_2311":97532},[],"CRL vinculada a la autoridad.",{"_2783":57395,"_24070":57330,"_16893":97534,"_5":16788,"_22829":97384,"_2311":97535},[],"Metadatos y motor criptográfico asociado.",{"_2783":57396,"_24070":57330,"_16893":97537,"_5":16788,"_22829":97384,"_2311":97538},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2783":57397,"_24070":57330,"_16893":97540,"_5":16788,"_22829":97388,"_2311":97541},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2783":57398,"_24070":57330,"_16893":97543,"_5":16788,"_22829":97388,"_2311":97544},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2783":57399,"_24070":57330,"_16893":97546,"_5":16788,"_22829":97388,"_2311":97547},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2783":57400,"_24070":57330,"_16893":97549,"_5":16788,"_22829":97388,"_2311":97550},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2783":57401,"_24070":57330,"_16893":97552,"_5":16788,"_22829":97392,"_2311":97553},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2783":57402,"_24070":57330,"_16893":97555,"_5":16788,"_22829":97396,"_2311":97556},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2783":57403,"_24070":57330,"_16893":97558,"_5":16788,"_22829":97400,"_2311":97559},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2783":57404,"_24070":57330,"_16893":97561,"_5":16788,"_22829":97404,"_2311":97562},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2783":57405,"_24070":57330,"_16893":97564,"_5":16788,"_22829":97408,"_2311":97565},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2783":57406,"_24070":57330,"_16893":97567,"_5":16788,"_22829":97408,"_2311":97568},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2783":57407,"_24070":57407,"_5":11891,"_2311":97570,"_24406":97571,"_16893":97572,"_22829":57407},"Perfiles de certificado",[39338,93790,44141,97158],[],{"_2783":57408,"_24070":57407,"_16893":97574,"_5":16788,"_22829":57407,"_2311":97575},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2783":57409,"_24070":57407,"_5":24403,"_16893":97577,"_22829":97578,"_2311":97579},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2783":57410,"_24070":57407,"_5":24403,"_16893":97581,"_22829":97582,"_2311":97583},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#validez","Validez",{"_2783":57411,"_24070":57407,"_5":24403,"_16893":97585,"_22829":97586,"_2311":97587},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2783":57412,"_24070":57407,"_5":24403,"_16893":97589,"_22829":97590,"_2311":97591},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2783":57413,"_24070":57407,"_5":24403,"_16893":97593,"_22829":97594,"_2311":97595},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2783":57414,"_24070":57407,"_5":24403,"_16893":97597,"_22829":97598,"_2311":97599},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2783":57415,"_24070":57407,"_5":24403,"_16893":97601,"_22829":97602,"_2311":97603},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2783":57416,"_24070":57407,"_5":24403,"_16893":97605,"_22829":97606,"_2311":97607},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2783":57417,"_24070":57407,"_5":24403,"_16893":97609,"_22829":97610,"_2311":97611},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2783":57418,"_24070":57407,"_5":24403,"_16893":97613,"_22829":97614,"_2311":97615},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2783":57419,"_24070":57407,"_5":24403,"_16893":97617,"_22829":97618,"_2311":97619},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2783":57420,"_24070":57407,"_5":24403,"_16893":97621,"_22829":97622,"_2311":97623},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2783":57421,"_24070":57407,"_5":24403,"_16893":97625,"_22829":97626,"_2311":97627},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2783":57422,"_24070":57407,"_5":24403,"_16893":97629,"_22829":97630,"_2311":97631},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2783":57423,"_24070":57407,"_5":24403,"_16893":97633,"_22829":97634,"_2311":97635},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2783":57424,"_24070":57407,"_5":24403,"_16893":97637,"_22829":97638,"_2311":97639},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2783":57425,"_24070":57407,"_16893":97641,"_5":16788,"_22829":57407,"_2311":97642},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2783":57426,"_24070":57407,"_16893":97644,"_5":16788,"_22829":57407,"_2311":97645},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2783":57427,"_24070":57407,"_16893":97647,"_5":16788,"_22829":97582,"_2311":97648},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2783":57428,"_24070":57407,"_16893":97650,"_5":16788,"_22829":97582,"_2311":97651},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2783":57429,"_24070":57407,"_16893":97653,"_5":16788,"_22829":97586,"_2311":97654},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2783":57430,"_24070":57407,"_16893":97656,"_5":16788,"_22829":97590,"_2311":97657},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2783":57431,"_24070":57407,"_16893":97659,"_5":16788,"_22829":97590,"_2311":97660},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2783":57432,"_24070":57407,"_16893":97662,"_5":16788,"_22829":97590,"_2311":97663},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2783":57433,"_24070":57407,"_16893":97665,"_5":16788,"_22829":97594,"_2311":97666},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2783":57434,"_24070":57407,"_16893":97668,"_5":16788,"_22829":97598,"_2311":97669},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2783":57435,"_24070":57407,"_16893":97671,"_5":16788,"_22829":97598,"_2311":97672},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2783":57436,"_24070":57407,"_16893":97674,"_5":16788,"_22829":97602,"_2311":97675},[],"La aplicación criptográfica puede:",{"_2783":57437,"_24070":57407,"_16893":97677,"_5":16788,"_22829":97602,"_2311":97678},[],"permitir o bloquear claves RSA;",{"_2783":57438,"_24070":57407,"_16893":97680,"_5":16788,"_22829":97602,"_2311":97681},[],"limitar los tamaños RSA admitidos;",{"_2783":57439,"_24070":57407,"_16893":97683,"_5":16788,"_22829":97602,"_2311":97684},[],"permitir o bloquear claves ECDSA;",{"_2783":57440,"_24070":57407,"_16893":97686,"_5":16788,"_22829":97602,"_2311":97687},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2783":57441,"_24070":57407,"_16893":97689,"_5":16788,"_22829":97602,"_2311":97690},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2783":57442,"_24070":57407,"_16893":97692,"_5":16788,"_22829":97606,"_2311":97693},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2783":57443,"_24070":57407,"_16893":97695,"_5":16788,"_22829":97606,"_2311":93581},[],{"_2783":57444,"_24070":57407,"_16893":97697,"_5":16788,"_22829":97606,"_2311":97698},[],"Primera opción",{"_2783":57445,"_24070":57407,"_16893":97700,"_5":16788,"_22829":97606,"_2311":97701},[],"Segunda opción",{"_2783":57446,"_24070":57407,"_16893":97703,"_5":16788,"_22829":97606,"_2311":97704},[],"Si no hay ninguna",{"_2783":57447,"_24070":57407,"_16893":97706,"_5":16788,"_22829":97606,"_2311":97707},[],"Firma directa con una CA",{"_2783":57448,"_24070":57407,"_16893":97709,"_5":16788,"_22829":97606,"_2311":97710},[],"`issuance_profile` incluido en la solicitud",{"_2783":57449,"_24070":57407,"_16893":97712,"_5":16788,"_22829":97606,"_2311":97713},[],"`issuance_profile_id` de la solicitud",{"_2783":57450,"_24070":57407,"_16893":97715,"_5":16788,"_22829":97606,"_2311":97716},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2783":57451,"_24070":57407,"_16893":97718,"_5":16788,"_22829":97606,"_2311":97719},[],"Emisión mediante DMS",{"_2783":57452,"_24070":57407,"_16893":97721,"_5":16788,"_22829":97606,"_2311":44706},[],{"_2783":57453,"_24070":57407,"_16893":97723,"_5":16788,"_22829":97606,"_2311":97724},[],"`settings.issuance_profile` incluido en el DMS",{"_2783":57454,"_24070":57407,"_16893":97726,"_5":16788,"_22829":97606,"_2311":97727},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2783":57455,"_24070":57407,"_16893":97729,"_5":16788,"_22829":97606,"_2311":97730},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2783":57456,"_24070":57407,"_16893":97732,"_5":16788,"_22829":97606,"_2311":97733},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2783":57457,"_24070":57407,"_16893":97735,"_5":16788,"_22829":97614,"_2311":97736},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2783":57458,"_24070":57407,"_16893":97738,"_5":16788,"_22829":97618,"_2311":97739},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2783":57459,"_24070":57407,"_16893":97741,"_5":16788,"_22829":97622,"_2311":97742},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2783":57460,"_24070":57407,"_16893":97744,"_5":16788,"_22829":97626,"_2311":97745},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2783":57461,"_24070":57407,"_16893":97747,"_5":16788,"_22829":97630,"_2311":97748},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2783":57462,"_24070":57407,"_16893":97750,"_5":16788,"_22829":97630,"_2311":97751},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2783":57463,"_24070":57407,"_16893":97753,"_5":16788,"_22829":97634,"_2311":97754},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2783":57464,"_24070":57407,"_16893":97756,"_5":16788,"_22829":97634,"_2311":97757},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2783":57465,"_24070":57407,"_16893":97759,"_5":16788,"_22829":97634,"_2311":97760},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2783":57466,"_24070":57407,"_16893":97762,"_5":16788,"_22829":97634,"_2311":97763},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2783":57467,"_24070":57407,"_16893":97765,"_5":16788,"_22829":97638,"_2311":97766},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2783":57468,"_24070":57407,"_16893":97768,"_5":16788,"_22829":97638,"_2311":97769},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2783":57469,"_24070":57469,"_5":11891,"_2311":97771,"_24406":97772,"_16893":97774,"_22829":57469},"Validación de certificados",[39338,93790,44141,97773],"Validación",[],{"_2783":57470,"_24070":57469,"_16893":97776,"_5":16788,"_22829":57469,"_2311":97777},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2783":57471,"_24070":57469,"_5":24403,"_16893":97779,"_22829":97780,"_2311":97781},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2783":57472,"_24070":57469,"_5":24403,"_16893":97783,"_22829":97784,"_2311":97785},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2783":57473,"_24070":57469,"_5":24403,"_16893":97787,"_22829":97788,"_2311":97789},[],"/docs/pr-preview/pr-27/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2783":57474,"_24070":57469,"_16893":97791,"_5":16788,"_22829":57469,"_2311":97792},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2783":57475,"_24070":57469,"_16893":97794,"_5":16788,"_22829":97780,"_2311":97795},[],"Verifica estos criterios juntos:",{"_2783":57476,"_24070":57469,"_16893":97797,"_5":16788,"_22829":97780,"_2311":96785},[],{"_2783":57477,"_24070":57469,"_16893":97799,"_5":16788,"_22829":97780,"_2311":97800},[],"Resultado necesario",{"_2783":57478,"_24070":57469,"_16893":97802,"_5":16788,"_22829":97780,"_2311":97803},[],"Cadena y firma",{"_2783":57479,"_24070":57469,"_16893":97805,"_5":16788,"_22829":97780,"_2311":97806},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2783":57480,"_24070":57469,"_16893":97808,"_5":16788,"_22829":97780,"_2311":97809},[],"Fechas",{"_2783":57481,"_24070":57469,"_16893":97811,"_5":16788,"_22829":97780,"_2311":97812},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2783":57482,"_24070":57469,"_16893":97814,"_5":16788,"_22829":97780,"_2311":93494},[],{"_2783":57483,"_24070":57469,"_16893":97816,"_5":16788,"_22829":97780,"_2311":97817},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2783":57484,"_24070":57469,"_16893":97819,"_5":16788,"_22829":97780,"_2311":97820},[],"Uso",{"_2783":57485,"_24070":57469,"_16893":97822,"_5":16788,"_22829":97780,"_2311":97823},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2783":57486,"_24070":57469,"_16893":97825,"_5":16788,"_22829":97780,"_2311":97826},[],"Revocación",{"_2783":57487,"_24070":57469,"_16893":97828,"_5":16788,"_22829":97780,"_2311":97829},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2783":57488,"_24070":57469,"_16893":97831,"_5":16788,"_22829":97780,"_2311":97832},[],"Autorización",{"_2783":57489,"_24070":57469,"_16893":97834,"_5":16788,"_22829":97780,"_2311":97835},[],"La aplicación permite la acción a esa identidad.",{"_2783":57490,"_24070":57469,"_16893":97837,"_5":16788,"_22829":97780,"_2311":97838},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2783":57491,"_24070":57469,"_16893":97840,"_5":16788,"_22829":97784,"_2311":97841},[],"Mecanismo",{"_2783":57492,"_24070":57469,"_16893":97843,"_5":16788,"_22829":97784,"_2311":97844},[],"Cuándo utilizarlo",{"_2783":57493,"_24070":57469,"_16893":97846,"_5":16788,"_22829":97784,"_2311":97847},[],"Qué debes mantener",{"_2783":57494,"_24070":57469,"_16893":97849,"_5":16788,"_22829":97784,"_2311":44834},[],{"_2783":57495,"_24070":57469,"_16893":97851,"_5":16788,"_22829":97784,"_2311":97852},[],"Consulta del estado de un certificado concreto.",{"_2783":57496,"_24070":57469,"_16893":97854,"_5":16788,"_22829":97784,"_2311":97855},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2783":57497,"_24070":57469,"_16893":97857,"_5":16788,"_22829":97784,"_2311":44843},[],{"_2783":57498,"_24070":57469,"_16893":97859,"_5":16788,"_22829":97784,"_2311":97860},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2783":57499,"_24070":57469,"_16893":97862,"_5":16788,"_22829":97784,"_2311":97863},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2783":57500,"_24070":57469,"_16893":97865,"_5":16788,"_22829":97784,"_2311":97866},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2783":57501,"_24070":57469,"_16893":97868,"_5":16788,"_22829":97784,"_2311":97869},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2783":57502,"_24070":57469,"_16893":97871,"_5":16788,"_22829":97788,"_2311":97872},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2783":57503,"_24070":57469,"_16893":97874,"_5":16788,"_22829":97788,"_2311":97875},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2783":57504,"_24070":57469,"_16893":97877,"_5":16788,"_22829":97788,"_2311":97878},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2783":57505,"_24070":57469,"_16893":97880,"_5":16788,"_22829":97788,"_2311":97881},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2783":57506,"_24070":57469,"_16893":97883,"_5":16788,"_22829":97788,"_2311":97884},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2783":57507,"_24070":57469,"_16893":97886,"_5":16788,"_22829":97788,"_2311":97887},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2783":57508,"_24070":57469,"_16893":97889,"_5":16788,"_22829":97788,"_2311":97890},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2783":57509,"_24070":57469,"_16893":97892,"_5":16788,"_22829":97788,"_2311":97893},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2783":57510,"_24070":57469,"_16893":97895,"_5":16788,"_22829":97788,"_2311":97896},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2783":57511,"_24070":57511,"_5":11891,"_2311":97898,"_24406":97899,"_16893":97900,"_22829":57511},"Certificados",[39338,93790,44141,97158],[],{"_2783":57512,"_24070":57511,"_16893":97902,"_5":16788,"_22829":57511,"_2311":97903},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2783":57513,"_24070":57511,"_5":24403,"_16893":97905,"_22829":97906,"_2311":97907},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2783":57514,"_24070":57511,"_5":24403,"_16893":97909,"_22829":97910,"_2311":97911},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2783":57515,"_24070":57511,"_5":24403,"_16893":97913,"_22829":97914,"_2311":97915},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2783":57516,"_24070":57511,"_5":24403,"_16893":97917,"_22829":97918,"_2311":97919},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2783":57517,"_24070":57511,"_5":24403,"_16893":97921,"_22829":97922,"_2311":97923},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2783":57518,"_24070":57511,"_5":24403,"_16893":97925,"_22829":97926,"_2311":97927},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2783":57519,"_24070":57511,"_5":24403,"_16893":97929,"_22829":97930,"_2311":97931},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2783":57520,"_24070":57511,"_5":24403,"_16893":97933,"_22829":97934,"_2311":97935},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2783":57521,"_24070":57511,"_5":24403,"_16893":97937,"_22829":97938,"_2311":97939},[],"/docs/pr-preview/pr-27/es/platform/pki/certificates#continúa","Continúa",{"_2783":57522,"_24070":57511,"_16893":97941,"_5":16788,"_22829":57511,"_2311":97942},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2783":57523,"_24070":57511,"_16893":97944,"_5":16788,"_22829":97906,"_2311":97945},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2783":57524,"_24070":57511,"_16893":97947,"_5":16788,"_22829":97906,"_2311":97948},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2783":57525,"_24070":57511,"_16893":97950,"_5":16788,"_22829":97910,"_2311":97951},[],"Descarga el PEM e inspecciónalo:",{"_2783":57526,"_24070":57511,"_16893":97953,"_5":16788,"_22829":97910,"_2311":97954},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2783":57527,"_24070":57511,"_16893":97956,"_5":16788,"_22829":97914,"_2311":97957},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2783":57528,"_24070":57511,"_16893":97959,"_5":16788,"_22829":97914,"_2311":97960},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2783":57529,"_24070":57511,"_16893":97962,"_5":16788,"_22829":97914,"_2311":97963},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2783":57530,"_24070":57511,"_16893":97965,"_5":16788,"_22829":97914,"_2311":97966},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2783":57531,"_24070":57511,"_16893":97968,"_5":16788,"_22829":97914,"_2311":97969},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2783":57532,"_24070":57511,"_16893":97971,"_5":16788,"_22829":97914,"_2311":97972},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2783":57533,"_24070":57511,"_16893":97974,"_5":16788,"_22829":97914,"_2311":97975},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2783":57534,"_24070":57511,"_16893":97977,"_5":16788,"_22829":97918,"_2311":97978},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2783":57535,"_24070":57511,"_16893":97980,"_5":16788,"_22829":97922,"_2311":97981},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2783":57536,"_24070":57511,"_16893":97983,"_5":16788,"_22829":97926,"_2311":97984},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2783":57537,"_24070":57511,"_16893":97986,"_5":16788,"_22829":97930,"_2311":97987},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2783":57538,"_24070":57511,"_16893":97989,"_5":16788,"_22829":97930,"_2311":97990},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2783":57539,"_24070":57511,"_16893":97992,"_5":16788,"_22829":97930,"_2311":97993},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2783":57540,"_24070":57511,"_16893":97995,"_5":16788,"_22829":97934,"_2311":97996},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2783":57541,"_24070":57511,"_16893":97998,"_5":16788,"_22829":97934,"_2311":97999},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2783":57542,"_24070":57511,"_16893":98001,"_5":16788,"_22829":97934,"_2311":98002},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2783":57543,"_24070":57511,"_16893":98004,"_5":16788,"_22829":97938,"_2311":98005},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2783":57544,"_24070":57511,"_16893":98007,"_5":16788,"_22829":97938,"_2311":98008},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2783":57545,"_24070":57545,"_5":11891,"_2311":98010,"_24406":98011,"_16893":98013,"_22829":57545},"Ciclo de vida de un certificado",[39338,93790,44141,98012],"Conceptos",[],{"_2783":57546,"_24070":57545,"_16893":98015,"_5":16788,"_22829":57545,"_2311":98016},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2783":57547,"_24070":57545,"_5":24403,"_16893":98018,"_22829":98019,"_2311":98020},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2783":57548,"_24070":57545,"_5":24403,"_16893":98022,"_22829":98023,"_2311":98024},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2783":57549,"_24070":57545,"_5":24403,"_16893":98026,"_22829":98027,"_2311":98028},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2783":57550,"_24070":57545,"_5":24403,"_16893":98030,"_22829":98031,"_2311":98032},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2783":57551,"_24070":57545,"_5":24403,"_16893":98034,"_22829":98035,"_2311":98036},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2783":57552,"_24070":57545,"_5":24403,"_16893":98038,"_22829":98039,"_2311":98040},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2783":57553,"_24070":57545,"_5":24403,"_16893":98042,"_22829":98043,"_2311":98044},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2783":57554,"_24070":57545,"_5":24403,"_16893":98046,"_22829":98047,"_2311":98048},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2783":57555,"_24070":57545,"_5":24403,"_16893":98050,"_22829":98051,"_2311":98052},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2783":57556,"_24070":57545,"_5":24403,"_16893":98054,"_22829":98055,"_2311":98056},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2783":57557,"_24070":57545,"_16893":98058,"_5":16788,"_22829":57545,"_2311":98059},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2783":57558,"_24070":57545,"_16893":98061,"_5":16788,"_22829":98023,"_2311":98062},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2783":57559,"_24070":57545,"_16893":98064,"_5":16788,"_22829":98027,"_2311":98065},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2783":57560,"_24070":57545,"_16893":98067,"_5":16788,"_22829":98031,"_2311":98068},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2783":57561,"_24070":57545,"_16893":98070,"_5":16788,"_22829":98035,"_2311":98071},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2783":57562,"_24070":57545,"_16893":98073,"_5":16788,"_22829":98039,"_2311":98074},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2783":57563,"_24070":57545,"_16893":98076,"_5":16788,"_22829":98043,"_2311":98077},[],"Lamassu persiste cuatro estados X.509:",{"_2783":57564,"_24070":57545,"_16893":98079,"_5":16788,"_22829":98043,"_2311":98080},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2783":57565,"_24070":57545,"_16893":98082,"_5":16788,"_22829":98043,"_2311":98083},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2783":57566,"_24070":57545,"_16893":98085,"_5":16788,"_22829":98043,"_2311":98086},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2783":57567,"_24070":57545,"_16893":98088,"_5":16788,"_22829":98043,"_2311":98089},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2783":57568,"_24070":57545,"_16893":98091,"_5":16788,"_22829":98043,"_2311":98092},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2783":57569,"_24070":57545,"_16893":98094,"_5":16788,"_22829":98047,"_2311":98095},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2783":57570,"_24070":57545,"_16893":98097,"_5":16788,"_22829":98047,"_2311":98098},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2783":57571,"_24070":57545,"_16893":98100,"_5":16788,"_22829":98047,"_2311":98101},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2783":57572,"_24070":57545,"_16893":98103,"_5":16788,"_22829":98051,"_2311":98104},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2783":57573,"_24070":57545,"_16893":98106,"_5":16788,"_22829":98051,"_2311":98107},[],"Antes de confirmar:",{"_2783":57574,"_24070":57545,"_16893":98109,"_5":16788,"_22829":98051,"_2311":98110},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2783":57575,"_24070":57545,"_16893":98112,"_5":16788,"_22829":98051,"_2311":98113},[],"Distribuye la nueva cadena de confianza.",{"_2783":57576,"_24070":57545,"_16893":98115,"_5":16788,"_22829":98051,"_2311":98116},[],"Reemite las identidades necesarias.",{"_2783":57577,"_24070":57545,"_16893":98118,"_5":16788,"_22829":98051,"_2311":98119},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2783":57578,"_24070":57545,"_16893":98121,"_5":16788,"_22829":98051,"_2311":98122},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2783":57579,"_24070":57545,"_16893":98124,"_5":16788,"_22829":98051,"_2311":98125},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2783":57580,"_24070":57545,"_16893":98127,"_5":16788,"_22829":98055,"_2311":98128},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2783":57581,"_24070":57545,"_16893":98130,"_5":16788,"_22829":98055,"_2311":98131},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2783":57582,"_24070":57545,"_16893":98133,"_5":16788,"_22829":98055,"_2311":98134},[],"Cambios de estado y razones de revocación.",{"_2783":57583,"_24070":57545,"_16893":98136,"_5":16788,"_22829":98055,"_2311":98137},[],"Publicación y vigencia de OCSP y CRLs.",{"_2783":57584,"_24070":57545,"_16893":98139,"_5":16788,"_22829":98055,"_2311":98140},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2783":57585,"_24070":57545,"_16893":98142,"_5":16788,"_22829":98055,"_2311":98143},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2783":57586,"_24070":57586,"_5":11891,"_2311":98145,"_24406":98146,"_16893":98147,"_22829":57586},"Modelo de confianza",[39338,93790,44141,98012],[],{"_2783":57587,"_24070":57586,"_16893":98149,"_5":16788,"_22829":57586,"_2311":98150},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2783":57588,"_24070":57586,"_5":24403,"_16893":98152,"_22829":98153,"_2311":98154},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2783":57589,"_24070":57586,"_5":24403,"_16893":98156,"_22829":98157,"_2311":98158},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2783":57590,"_24070":57586,"_5":24403,"_16893":98160,"_22829":98161,"_2311":98162},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2783":57591,"_24070":57586,"_5":24403,"_16893":98164,"_22829":98165,"_2311":98166},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2783":57592,"_24070":57586,"_5":24403,"_16893":98168,"_22829":98169,"_2311":98170},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2783":57593,"_24070":57586,"_5":24403,"_16893":98172,"_22829":98173,"_2311":98174},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2783":57594,"_24070":57586,"_5":24403,"_16893":98176,"_22829":98177,"_2311":98178},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2783":57595,"_24070":57586,"_5":24403,"_16893":98180,"_22829":98181,"_2311":98182},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2783":57596,"_24070":57586,"_5":24403,"_16893":98184,"_22829":98185,"_2311":98186},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2783":57597,"_24070":57586,"_5":24403,"_16893":98188,"_22829":98189,"_2311":98190},[],"/docs/pr-preview/pr-27/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2783":57598,"_24070":57586,"_16893":98192,"_5":16788,"_22829":57586,"_2311":98193},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2783":57599,"_24070":57586,"_16893":98195,"_5":16788,"_22829":98157,"_2311":98196},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2783":57600,"_24070":57586,"_16893":98198,"_5":16788,"_22829":98161,"_2311":98199},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2783":57601,"_24070":57586,"_16893":98201,"_5":16788,"_22829":98165,"_2311":98202},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2783":57602,"_24070":57586,"_16893":98204,"_5":16788,"_22829":98169,"_2311":98205},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2783":57603,"_24070":57586,"_16893":98207,"_5":16788,"_22829":98173,"_2311":98208},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2783":57604,"_24070":57586,"_16893":98210,"_5":16788,"_22829":98173,"_2311":98211},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2783":57605,"_24070":57586,"_16893":98213,"_5":16788,"_22829":98173,"_2311":98214},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2783":57606,"_24070":57586,"_16893":98216,"_5":16788,"_22829":98173,"_2311":98217},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2783":57607,"_24070":57586,"_16893":98219,"_5":16788,"_22829":98173,"_2311":98220},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2783":57608,"_24070":57586,"_16893":98222,"_5":16788,"_22829":98173,"_2311":98223},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2783":57609,"_24070":57586,"_16893":98225,"_5":16788,"_22829":98177,"_2311":98226},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2783":57610,"_24070":57586,"_16893":98228,"_5":16788,"_22829":98177,"_2311":98229},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2783":57611,"_24070":57586,"_16893":98231,"_5":16788,"_22829":98177,"_2311":98232},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2783":57612,"_24070":57586,"_16893":98234,"_5":16788,"_22829":98177,"_2311":98235},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2783":57613,"_24070":57586,"_16893":98237,"_5":16788,"_22829":98177,"_2311":98238},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2783":57614,"_24070":57586,"_16893":98240,"_5":16788,"_22829":98181,"_2311":98241},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2783":57615,"_24070":57586,"_16893":98243,"_5":16788,"_22829":98181,"_2311":98244},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2783":57616,"_24070":57586,"_16893":98246,"_5":16788,"_22829":98181,"_2311":98247},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2783":57617,"_24070":57586,"_16893":98249,"_5":16788,"_22829":98181,"_2311":98250},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2783":57618,"_24070":57586,"_16893":98252,"_5":16788,"_22829":98181,"_2311":98253},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2783":57619,"_24070":57586,"_16893":98255,"_5":16788,"_22829":98181,"_2311":98256},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2783":57620,"_24070":57586,"_16893":98258,"_5":16788,"_22829":98181,"_2311":98259},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2783":57621,"_24070":57586,"_16893":98261,"_5":16788,"_22829":98185,"_2311":98262},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2783":57622,"_24070":57586,"_16893":98264,"_5":16788,"_22829":98189,"_2311":98265},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2783":57623,"_24070":57586,"_16893":98267,"_5":16788,"_22829":98189,"_2311":98268},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2783":57624,"_24070":57586,"_16893":98270,"_5":16788,"_22829":98189,"_2311":98271},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2783":57625,"_24070":57586,"_16893":98273,"_5":16788,"_22829":98189,"_2311":98274},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2783":57626,"_24070":57586,"_16893":98276,"_5":16788,"_22829":98189,"_2311":98277},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2783":57627,"_24070":57586,"_16893":98279,"_5":16788,"_22829":98189,"_2311":98280},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2783":57628,"_24070":57586,"_16893":98282,"_5":16788,"_22829":98189,"_2311":98283},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2783":57629,"_24070":57629,"_5":11891,"_2311":98285,"_24406":98286,"_16893":98287,"_22829":57629},"Listas de revocación (CRL)",[39338,93790,44141,97773],[],{"_2783":57630,"_24070":57629,"_16893":98289,"_5":16788,"_22829":57629,"_2311":98290},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2783":57631,"_24070":57629,"_5":24403,"_16893":98292,"_22829":98293,"_2311":98294},[],"/docs/pr-preview/pr-27/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2783":57632,"_24070":57629,"_5":24403,"_16893":98296,"_22829":98297,"_2311":98298},[],"/docs/pr-preview/pr-27/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2783":57633,"_24070":57629,"_5":24403,"_16893":98300,"_22829":98301,"_2311":98302},[],"/docs/pr-preview/pr-27/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2783":57634,"_24070":57629,"_5":24403,"_16893":98304,"_22829":98305,"_2311":98306},[],"/docs/pr-preview/pr-27/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2783":57635,"_24070":57629,"_5":24403,"_16893":98308,"_22829":98309,"_2311":98310},[],"/docs/pr-preview/pr-27/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2783":57636,"_24070":57629,"_5":24403,"_16893":98312,"_22829":98313,"_2311":98314},[],"/docs/pr-preview/pr-27/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2783":57637,"_24070":57629,"_5":24403,"_16893":98316,"_22829":98317,"_2311":98318},[],"/docs/pr-preview/pr-27/es/platform/pki/crl#referencias","Referencias",{"_2783":57638,"_24070":57629,"_16893":98320,"_5":16788,"_22829":57629,"_2311":98321},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2783":57639,"_24070":57629,"_16893":98323,"_5":16788,"_22829":98293,"_2311":98324},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2783":57640,"_24070":57629,"_16893":98326,"_5":16788,"_22829":98293,"_2311":98327},[],"Campo de `crl_options`",{"_2783":57641,"_24070":57629,"_16893":98329,"_5":16788,"_22829":98293,"_2311":95103},[],{"_2783":57642,"_24070":57629,"_16893":98331,"_5":16788,"_22829":98293,"_2311":98332},[],"Valor inicial del backend",{"_2783":57643,"_24070":57629,"_16893":98334,"_5":16788,"_22829":98293,"_2311":45321},[],{"_2783":57644,"_24070":57629,"_16893":98336,"_5":16788,"_22829":98293,"_2311":98337},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2783":57645,"_24070":57629,"_16893":98339,"_5":16788,"_22829":98293,"_2311":98340},[],"7 días.",{"_2783":57646,"_24070":57629,"_16893":98342,"_5":16788,"_22829":98293,"_2311":45330},[],{"_2783":57647,"_24070":57629,"_16893":98344,"_5":16788,"_22829":98293,"_2311":98345},[],"Plazo desde la publicación que activa la renovación programada.",{"_2783":57648,"_24070":57629,"_16893":98347,"_5":16788,"_22829":98293,"_2311":98348},[],"6 días y 23 horas.",{"_2783":57649,"_24070":57629,"_16893":98350,"_5":16788,"_22829":98293,"_2311":45339},[],{"_2783":57650,"_24070":57629,"_16893":98352,"_5":16788,"_22829":98293,"_2311":98353},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2783":57651,"_24070":57629,"_16893":98355,"_5":16788,"_22829":98293,"_2311":45345},[],{"_2783":57652,"_24070":57629,"_16893":98357,"_5":16788,"_22829":98293,"_2311":45348},[],{"_2783":57653,"_24070":57629,"_16893":98359,"_5":16788,"_22829":98293,"_2311":98360},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2783":57654,"_24070":57629,"_16893":98362,"_5":16788,"_22829":98293,"_2311":98363},[],"SKI de la CA.",{"_2783":57655,"_24070":57629,"_16893":98365,"_5":16788,"_22829":98293,"_2311":98366},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2783":57656,"_24070":57629,"_16893":98368,"_5":16788,"_22829":98293,"_2311":98369},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2783":57657,"_24070":57629,"_16893":98371,"_5":16788,"_22829":98297,"_2311":98372},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2783":57658,"_24070":57629,"_16893":98374,"_5":16788,"_22829":98297,"_2311":98375},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2783":57659,"_24070":57629,"_16893":98377,"_5":16788,"_22829":98297,"_2311":98378},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2783":57660,"_24070":57629,"_16893":98380,"_5":16788,"_22829":98301,"_2311":98381},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2783":57661,"_24070":57629,"_16893":98383,"_5":16788,"_22829":98301,"_2311":98384},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2783":57662,"_24070":57629,"_16893":98386,"_5":16788,"_22829":98305,"_2311":98387},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2783":57663,"_24070":57629,"_16893":98389,"_5":16788,"_22829":98305,"_2311":98390},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2783":57664,"_24070":57629,"_16893":98392,"_5":16788,"_22829":98305,"_2311":98393},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2783":57665,"_24070":57629,"_16893":98395,"_5":16788,"_22829":98305,"_2311":98396},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2783":57666,"_24070":57629,"_16893":98398,"_5":16788,"_22829":98305,"_2311":98399},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2783":57667,"_24070":57629,"_16893":98401,"_5":16788,"_22829":98309,"_2311":98402},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2783":57668,"_24070":57629,"_16893":98404,"_5":16788,"_22829":98309,"_2311":95292},[],{"_2783":57669,"_24070":57629,"_16893":98406,"_5":16788,"_22829":98309,"_2311":98407},[],"Path relativo",{"_2783":57670,"_24070":57629,"_16893":98409,"_5":16788,"_22829":98309,"_2311":93581},[],{"_2783":57671,"_24070":57629,"_16893":98411,"_5":16788,"_22829":98309,"_2311":45403},[],{"_2783":57672,"_24070":57629,"_16893":98413,"_5":16788,"_22829":98309,"_2311":45406},[],{"_2783":57673,"_24070":57629,"_16893":98415,"_5":16788,"_22829":98309,"_2311":98416},[],"Consultar `crl_options` y `latest_crl`.",{"_2783":57674,"_24070":57629,"_16893":98418,"_5":16788,"_22829":98309,"_2311":45412},[],{"_2783":57675,"_24070":57629,"_16893":98420,"_5":16788,"_22829":98309,"_2311":45406},[],{"_2783":57676,"_24070":57629,"_16893":98422,"_5":16788,"_22829":98309,"_2311":98423},[],"Sustituir la configuración de CRL.",{"_2783":57677,"_24070":57629,"_16893":98425,"_5":16788,"_22829":98309,"_2311":98426},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2783":57678,"_24070":57629,"_16893":98428,"_5":16788,"_22829":98309,"_2311":98429},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2783":57679,"_24070":57629,"_16893":98431,"_5":16788,"_22829":98313,"_2311":98432},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2783":57680,"_24070":57629,"_16893":98434,"_5":16788,"_22829":98317,"_2311":98435},[],"RFC 5280: perfil X.509 y CRL.",{"_2783":57681,"_24070":57629,"_16893":98437,"_5":16788,"_22829":98317,"_2311":45432},[],{"_2783":57682,"_24070":57629,"_16893":98439,"_5":16788,"_22829":98317,"_2311":45435},[],{"_2783":57683,"_24070":57629,"_16893":98441,"_5":16788,"_22829":98317,"_2311":98442},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2783":57684,"_24070":57629,"_16893":98444,"_5":16788,"_22829":98317,"_2311":98445},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2783":57685,"_24070":57685,"_5":11891,"_2311":98447,"_24406":98448,"_16893":98449,"_22829":57685},"Claves y motores criptográficos",[39338,93790,44141,97158],[],{"_2783":57686,"_24070":57685,"_16893":98451,"_5":16788,"_22829":57685,"_2311":98452},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2783":57687,"_24070":57685,"_5":24403,"_16893":98454,"_22829":98455,"_2311":98456},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2783":57688,"_24070":57685,"_5":24403,"_16893":98458,"_22829":98459,"_2311":98460},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2783":57689,"_24070":57685,"_5":24403,"_16893":98462,"_22829":98463,"_2311":45460},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#file-system",{"_2783":57690,"_24070":57685,"_5":24403,"_16893":98465,"_22829":98466,"_2311":45464},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#hashicorp-vault",{"_2783":57691,"_24070":57685,"_5":24403,"_16893":98468,"_22829":98469,"_2311":45468},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#aws-secrets-manager",{"_2783":57692,"_24070":57685,"_5":24403,"_16893":98471,"_22829":98472,"_2311":45472},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#aws-kms",{"_2783":57693,"_24070":57685,"_5":24403,"_16893":98474,"_22829":98475,"_2311":45476},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#pkcs11",{"_2783":57694,"_24070":57685,"_5":24403,"_16893":98477,"_22829":98478,"_2311":45480},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#azure-key-vault",{"_2783":57695,"_24070":57685,"_5":24403,"_16893":98480,"_22829":98481,"_2311":98482},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2783":57696,"_24070":57685,"_5":24403,"_16893":98484,"_22829":98485,"_2311":98486},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2783":57697,"_24070":57685,"_5":24403,"_16893":98488,"_22829":98489,"_2311":98490},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2783":57698,"_24070":57685,"_5":24403,"_16893":98492,"_22829":98493,"_2311":98494},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2783":57699,"_24070":57685,"_5":24403,"_16893":98496,"_22829":98497,"_2311":98498},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2783":57700,"_24070":57685,"_5":24403,"_16893":98500,"_22829":98501,"_2311":98502},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2783":57701,"_24070":57685,"_5":24403,"_16893":98504,"_22829":98505,"_2311":98506},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2783":57702,"_24070":57685,"_5":24403,"_16893":98508,"_22829":98509,"_2311":45512},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#sign",{"_2783":57703,"_24070":57685,"_5":24403,"_16893":98511,"_22829":98512,"_2311":45516},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#verify",{"_2783":57704,"_24070":57685,"_5":24403,"_16893":98514,"_22829":98515,"_2311":98516},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2783":57705,"_24070":57685,"_5":24403,"_16893":98518,"_22829":98519,"_2311":98520},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2783":57706,"_24070":57685,"_5":24403,"_16893":98522,"_22829":98523,"_2311":98524},[],"/docs/pr-preview/pr-27/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2783":57707,"_24070":57685,"_16893":98526,"_5":16788,"_22829":57685,"_2311":98527},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2783":57708,"_24070":57685,"_16893":98529,"_5":16788,"_22829":57685,"_2311":98530},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2783":57709,"_24070":57685,"_16893":98532,"_5":16788,"_22829":98455,"_2311":98533},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2783":57710,"_24070":57685,"_16893":98535,"_5":16788,"_22829":98455,"_2311":98536},[],"En la práctica, permite:",{"_2783":57711,"_24070":57685,"_16893":98538,"_5":16788,"_22829":98455,"_2311":98539},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2783":57712,"_24070":57685,"_16893":98541,"_5":16788,"_22829":98455,"_2311":98542},[],"Importar claves creadas externamente.",{"_2783":57713,"_24070":57685,"_16893":98544,"_5":16788,"_22829":98455,"_2311":98545},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2783":57714,"_24070":57685,"_16893":98547,"_5":16788,"_22829":98455,"_2311":98548},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2783":57715,"_24070":57685,"_16893":98550,"_5":16788,"_22829":98459,"_2311":98551},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2783":57716,"_24070":57685,"_16893":98553,"_5":16788,"_22829":98459,"_2311":98554},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2783":57717,"_24070":57685,"_16893":98556,"_5":16788,"_22829":98459,"_2311":98557},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2783":57718,"_24070":57685,"_16893":98559,"_5":16788,"_22829":98463,"_2311":98560},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2783":57719,"_24070":57685,"_16893":98562,"_5":16788,"_22829":98466,"_2311":98563},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2783":57720,"_24070":57685,"_16893":98565,"_5":16788,"_22829":98469,"_2311":98566},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2783":57721,"_24070":57685,"_16893":98568,"_5":16788,"_22829":98472,"_2311":98569},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2783":57722,"_24070":57685,"_16893":98571,"_5":16788,"_22829":98475,"_2311":98572},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2783":57723,"_24070":57685,"_16893":98574,"_5":16788,"_22829":98478,"_2311":98575},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2783":57724,"_24070":57685,"_16893":98577,"_5":16788,"_22829":98478,"_2311":98578},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2783":57725,"_24070":57685,"_16893":98580,"_5":16788,"_22829":98478,"_2311":98581},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2783":57726,"_24070":57685,"_16893":98583,"_5":16788,"_22829":98478,"_2311":98584},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2783":57727,"_24070":57685,"_16893":98586,"_5":16788,"_22829":98481,"_2311":98587},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2783":57728,"_24070":57685,"_16893":98589,"_5":16788,"_22829":98481,"_2311":98590},[],"La tabla incluye los siguientes campos:",{"_2783":57729,"_24070":57685,"_16893":98592,"_5":16788,"_22829":98481,"_2311":98593},[],"**Name**: nombre descriptivo de la clave.",{"_2783":57730,"_24070":57685,"_16893":98595,"_5":16788,"_22829":98481,"_2311":98596},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2783":57731,"_24070":57685,"_16893":98598,"_5":16788,"_22829":98481,"_2311":98599},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2783":57732,"_24070":57685,"_16893":98601,"_5":16788,"_22829":98481,"_2311":98602},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2783":57733,"_24070":57685,"_16893":98604,"_5":16788,"_22829":98481,"_2311":98605},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2783":57734,"_24070":57685,"_16893":98607,"_5":16788,"_22829":98481,"_2311":98608},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2783":57735,"_24070":57685,"_16893":98610,"_5":16788,"_22829":98481,"_2311":98611},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2783":57736,"_24070":57685,"_16893":98613,"_5":16788,"_22829":98481,"_2311":98614},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2783":57737,"_24070":57685,"_16893":98616,"_5":16788,"_22829":98481,"_2311":98617},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2783":57738,"_24070":57685,"_16893":98619,"_5":16788,"_22829":98481,"_2311":98620},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2783":57739,"_24070":57685,"_16893":98622,"_5":16788,"_22829":98481,"_2311":98623},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2783":57740,"_24070":57685,"_16893":98625,"_5":16788,"_22829":98481,"_2311":98626},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2783":57741,"_24070":57685,"_16893":98628,"_5":16788,"_22829":98481,"_2311":98629},[],"**Delete Key** para eliminar la clave del sistema.",{"_2783":57742,"_24070":57685,"_16893":98631,"_5":16788,"_22829":98485,"_2311":98632},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2783":57743,"_24070":57685,"_16893":98634,"_5":16788,"_22829":98489,"_2311":98635},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2783":57744,"_24070":57685,"_16893":98637,"_5":16788,"_22829":98489,"_2311":98638},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2783":57745,"_24070":57685,"_16893":98640,"_5":16788,"_22829":98489,"_2311":98641},[],"**Key Name**: nombre único y descriptivo.",{"_2783":57746,"_24070":57685,"_16893":98643,"_5":16788,"_22829":98489,"_2311":98644},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2783":57747,"_24070":57685,"_16893":98646,"_5":16788,"_22829":98489,"_2311":98647},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2783":57748,"_24070":57685,"_16893":98649,"_5":16788,"_22829":98489,"_2311":98650},[],"**Tags**: metadatos para clasificar la clave.",{"_2783":57749,"_24070":57685,"_16893":98652,"_5":16788,"_22829":98489,"_2311":98653},[],"**Metadata**: información adicional para usos avanzados.",{"_2783":57750,"_24070":57685,"_16893":98655,"_5":16788,"_22829":98493,"_2311":98656},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2783":57751,"_24070":57685,"_16893":98658,"_5":16788,"_22829":98493,"_2311":98659},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2783":57752,"_24070":57685,"_16893":98661,"_5":16788,"_22829":98493,"_2311":98662},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2783":57753,"_24070":57685,"_16893":98664,"_5":16788,"_22829":98493,"_2311":98665},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2783":57754,"_24070":57685,"_16893":98667,"_5":16788,"_22829":98493,"_2311":98668},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2783":57755,"_24070":57685,"_16893":98670,"_5":16788,"_22829":98493,"_2311":98671},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2783":57756,"_24070":57685,"_16893":98673,"_5":16788,"_22829":98493,"_2311":98674},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2783":57757,"_24070":57685,"_16893":98676,"_5":16788,"_22829":98493,"_2311":98677},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2783":57758,"_24070":57685,"_16893":98679,"_5":16788,"_22829":98493,"_2311":98680},[],"**Metadata**: información adicional opcional.",{"_2783":57759,"_24070":57685,"_16893":98682,"_5":16788,"_22829":98493,"_2311":98683},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2783":57760,"_24070":57685,"_16893":98685,"_5":16788,"_22829":98493,"_2311":98686},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2783":57761,"_24070":57685,"_16893":98688,"_5":16788,"_22829":98497,"_2311":98689},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2783":57762,"_24070":57685,"_16893":98691,"_5":16788,"_22829":98501,"_2311":98692},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2783":57763,"_24070":57685,"_16893":98694,"_5":16788,"_22829":98501,"_2311":98695},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2783":57764,"_24070":57685,"_16893":98697,"_5":16788,"_22829":98501,"_2311":98698},[],"**Key Name**: nombre descriptivo.",{"_2783":57765,"_24070":57685,"_16893":98700,"_5":16788,"_22829":98501,"_2311":98701},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2783":57766,"_24070":57685,"_16893":98703,"_5":16788,"_22829":98501,"_2311":98704},[],"**Tags**: etiquetas asociadas.",{"_2783":57767,"_24070":57685,"_16893":98706,"_5":16788,"_22829":98501,"_2311":98707},[],"**Aliases**: nombres alternativos.",{"_2783":57768,"_24070":57685,"_16893":98709,"_5":16788,"_22829":98501,"_2311":98710},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2783":57769,"_24070":57685,"_16893":98712,"_5":16788,"_22829":98501,"_2311":98713},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2783":57770,"_24070":57685,"_16893":98715,"_5":16788,"_22829":98501,"_2311":98716},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2783":57771,"_24070":57685,"_16893":98718,"_5":16788,"_22829":98501,"_2311":98719},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2783":57772,"_24070":57685,"_16893":98721,"_5":16788,"_22829":98505,"_2311":98722},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2783":57773,"_24070":57685,"_16893":98724,"_5":16788,"_22829":98505,"_2311":98725},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2783":57774,"_24070":57685,"_16893":98727,"_5":16788,"_22829":98505,"_2311":98728},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2783":57775,"_24070":57685,"_16893":98730,"_5":16788,"_22829":98509,"_2311":98731},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2783":57776,"_24070":57685,"_16893":98733,"_5":16788,"_22829":98509,"_2311":98734},[],"Campos principales:",{"_2783":57777,"_24070":57685,"_16893":98736,"_5":16788,"_22829":98509,"_2311":98737},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2783":57778,"_24070":57685,"_16893":98739,"_5":16788,"_22829":98509,"_2311":98740},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2783":57779,"_24070":57685,"_16893":98742,"_5":16788,"_22829":98509,"_2311":98743},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2783":57780,"_24070":57685,"_16893":98745,"_5":16788,"_22829":98509,"_2311":98746},[],"**Message**: contenido que se va a firmar.",{"_2783":57781,"_24070":57685,"_16893":98748,"_5":16788,"_22829":98509,"_2311":98749},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2783":57782,"_24070":57685,"_16893":98751,"_5":16788,"_22829":98512,"_2311":98752},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2783":57783,"_24070":57685,"_16893":98754,"_5":16788,"_22829":98512,"_2311":98734},[],{"_2783":57784,"_24070":57685,"_16893":98756,"_5":16788,"_22829":98512,"_2311":98757},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2783":57785,"_24070":57685,"_16893":98759,"_5":16788,"_22829":98512,"_2311":98760},[],"**Message Type**: `Raw` o `Digest`.",{"_2783":57786,"_24070":57685,"_16893":98762,"_5":16788,"_22829":98512,"_2311":98763},[],"**Payload Encoding**: codificación del mensaje.",{"_2783":57787,"_24070":57685,"_16893":98765,"_5":16788,"_22829":98512,"_2311":98766},[],"**Message**: mensaje original o hash.",{"_2783":57788,"_24070":57685,"_16893":98768,"_5":16788,"_22829":98512,"_2311":98769},[],"**Signature**: firma que se desea comprobar.",{"_2783":57789,"_24070":57685,"_16893":98771,"_5":16788,"_22829":98512,"_2311":98772},[],"**Result**: indicador del resultado de la validación.",{"_2783":57790,"_24070":57685,"_16893":98774,"_5":16788,"_22829":98515,"_2311":98775},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2783":57791,"_24070":57685,"_16893":98777,"_5":16788,"_22829":98515,"_2311":98778},[],"Este flujo es útil para:",{"_2783":57792,"_24070":57685,"_16893":98780,"_5":16788,"_22829":98515,"_2311":98781},[],"Solicitar certificados a una CA externa.",{"_2783":57793,"_24070":57685,"_16893":98783,"_5":16788,"_22829":98515,"_2311":98784},[],"Renovar una identidad manteniendo la misma clave.",{"_2783":57794,"_24070":57685,"_16893":98786,"_5":16788,"_22829":98515,"_2311":98787},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2783":57795,"_24070":57685,"_16893":98789,"_5":16788,"_22829":98515,"_2311":98790},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2783":57796,"_24070":57685,"_16893":98792,"_5":16788,"_22829":98515,"_2311":98793},[],"**Organization (O)**: organización o empresa.",{"_2783":57797,"_24070":57685,"_16893":98795,"_5":16788,"_22829":98515,"_2311":98796},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2783":57798,"_24070":57685,"_16893":98798,"_5":16788,"_22829":98515,"_2311":98799},[],"**Country (C)**: código de país de dos letras.",{"_2783":57799,"_24070":57685,"_16893":98801,"_5":16788,"_22829":98515,"_2311":98802},[],"**State / Province (ST)**: estado o provincia.",{"_2783":57800,"_24070":57685,"_16893":98804,"_5":16788,"_22829":98515,"_2311":98805},[],"**Locality (L)**: ciudad o localidad.",{"_2783":57801,"_24070":57685,"_16893":98807,"_5":16788,"_22829":98515,"_2311":98808},[],"**Email Address**: correo de contacto.",{"_2783":57802,"_24070":57685,"_16893":98810,"_5":16788,"_22829":98515,"_2311":98811},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2783":57803,"_24070":57685,"_16893":98813,"_5":16788,"_22829":98515,"_2311":98814},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2783":57804,"_24070":57685,"_16893":98816,"_5":16788,"_22829":98519,"_2311":98817},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2783":57805,"_24070":57685,"_16893":98819,"_5":16788,"_22829":98519,"_2311":45824},[],{"_2783":57806,"_24070":57685,"_16893":98821,"_5":16788,"_22829":98523,"_2311":98822},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2783":57807,"_24070":57807,"_5":11891,"_2311":98824,"_24406":98825,"_16893":98826,"_22829":57807},"Validación online con OCSP",[39338,93790,44141,97773],[],{"_2783":57808,"_24070":57807,"_16893":98828,"_5":16788,"_22829":57807,"_2311":98829},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2783":57809,"_24070":57807,"_5":24403,"_16893":98831,"_22829":98832,"_2311":98833},[],"/docs/pr-preview/pr-27/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2783":57810,"_24070":57807,"_5":24403,"_16893":98835,"_22829":98836,"_2311":98837},[],"/docs/pr-preview/pr-27/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2783":57811,"_24070":57807,"_5":24403,"_16893":98839,"_22829":98840,"_2311":98841},[],"/docs/pr-preview/pr-27/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2783":57812,"_24070":57807,"_5":24403,"_16893":98843,"_22829":98844,"_2311":98845},[],"/docs/pr-preview/pr-27/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2783":57813,"_24070":57807,"_5":24403,"_16893":98847,"_22829":98848,"_2311":98849},[],"/docs/pr-preview/pr-27/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2783":57814,"_24070":57807,"_5":24403,"_16893":98851,"_22829":98852,"_2311":98318},[],"/docs/pr-preview/pr-27/es/platform/pki/ocsp#referencias",{"_2783":57815,"_24070":57807,"_16893":98854,"_5":16788,"_22829":57807,"_2311":98855},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2783":57816,"_24070":57807,"_16893":98857,"_5":16788,"_22829":98832,"_2311":98858},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2783":57817,"_24070":57807,"_16893":98860,"_5":16788,"_22829":98832,"_2311":98861},[],"Estado del registro",{"_2783":57818,"_24070":57807,"_16893":98863,"_5":16788,"_22829":98832,"_2311":98864},[],"Respuesta firmada",{"_2783":57819,"_24070":57807,"_16893":98866,"_5":16788,"_22829":98832,"_2311":43319},[],{"_2783":57820,"_24070":57807,"_16893":98868,"_5":16788,"_22829":98832,"_2311":45874},[],{"_2783":57821,"_24070":57807,"_16893":98870,"_5":16788,"_22829":98832,"_2311":43336},[],{"_2783":57822,"_24070":57807,"_16893":98872,"_5":16788,"_22829":98832,"_2311":98873},[],"`Revoked`, con razón y fecha de revocación.",{"_2783":57823,"_24070":57807,"_16893":98875,"_5":16788,"_22829":98832,"_2311":98876},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2783":57824,"_24070":57807,"_16893":98878,"_5":16788,"_22829":98832,"_2311":98879},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2783":57825,"_24070":57807,"_16893":98881,"_5":16788,"_22829":98832,"_2311":98882},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2783":57826,"_24070":57807,"_16893":98884,"_5":16788,"_22829":98832,"_2311":98885},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2783":57827,"_24070":57807,"_16893":98887,"_5":16788,"_22829":98832,"_2311":98888},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2783":57828,"_24070":57807,"_16893":98890,"_5":16788,"_22829":98836,"_2311":98891},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2783":57829,"_24070":57807,"_16893":98893,"_5":16788,"_22829":98836,"_2311":98894},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2783":57830,"_24070":57807,"_16893":98896,"_5":16788,"_22829":98840,"_2311":98897},[],"El servicio acepta:",{"_2783":57831,"_24070":57807,"_16893":98899,"_5":16788,"_22829":98840,"_2311":95292},[],{"_2783":57832,"_24070":57807,"_16893":98901,"_5":16788,"_22829":98840,"_2311":98902},[],"Ruta del servicio VA",{"_2783":57833,"_24070":57807,"_16893":98904,"_5":16788,"_22829":98840,"_2311":98905},[],"Formato",{"_2783":57834,"_24070":57807,"_16893":98907,"_5":16788,"_22829":98840,"_2311":45914},[],{"_2783":57835,"_24070":57807,"_16893":98909,"_5":16788,"_22829":98840,"_2311":45917},[],{"_2783":57836,"_24070":57807,"_16893":98911,"_5":16788,"_22829":98840,"_2311":98912},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2783":57837,"_24070":57807,"_16893":98914,"_5":16788,"_22829":98840,"_2311":45403},[],{"_2783":57838,"_24070":57807,"_16893":98916,"_5":16788,"_22829":98840,"_2311":45925},[],{"_2783":57839,"_24070":57807,"_16893":98918,"_5":16788,"_22829":98840,"_2311":98919},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2783":57840,"_24070":57807,"_16893":98921,"_5":16788,"_22829":98840,"_2311":98922},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2783":57841,"_24070":57807,"_16893":98924,"_5":16788,"_22829":98844,"_2311":98925},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2783":57842,"_24070":57807,"_16893":98927,"_5":16788,"_22829":98844,"_2311":98928},[],"Genera la solicitud:",{"_2783":57843,"_24070":57807,"_16893":98930,"_5":16788,"_22829":98844,"_2311":98931},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2783":57844,"_24070":57807,"_16893":98933,"_5":16788,"_22829":98844,"_2311":98934},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2783":57845,"_24070":57807,"_16893":98936,"_5":16788,"_22829":98844,"_2311":98937},[],"Verifica el DER recibido:",{"_2783":57846,"_24070":57807,"_16893":98939,"_5":16788,"_22829":98844,"_2311":98940},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2783":57847,"_24070":57807,"_16893":98942,"_5":16788,"_22829":98848,"_2311":98943},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2783":57848,"_24070":57807,"_16893":98945,"_5":16788,"_22829":98848,"_2311":98946},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2783":57849,"_24070":57807,"_16893":98948,"_5":16788,"_22829":98852,"_2311":45958},[],{"_2783":57850,"_24070":57807,"_16893":98950,"_5":16788,"_22829":98852,"_2311":45961},[],{"_2783":57851,"_24070":57807,"_16893":98952,"_5":16788,"_22829":98852,"_2311":98953},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2783":57852,"_24070":57807,"_16893":98955,"_5":16788,"_22829":98852,"_2311":98445},[],{"_2783":57853,"_24070":57853,"_5":11891,"_2311":44141,"_24406":98957,"_16893":98958,"_22829":57853},[39338,93790,44141],[],{"_2783":57854,"_24070":57853,"_16893":98960,"_5":16788,"_22829":57853,"_2311":98961},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2783":57855,"_24070":57853,"_5":24403,"_16893":98963,"_22829":98964,"_2311":96482},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#empieza-aquí",{"_2783":57856,"_24070":57853,"_5":24403,"_16893":98966,"_22829":98967,"_2311":98968},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2783":57857,"_24070":57853,"_5":24403,"_16893":98970,"_22829":98971,"_2311":97004},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#capacidades-principales",{"_2783":57858,"_24070":57853,"_5":24403,"_16893":98973,"_22829":98974,"_2311":97008},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2783":57859,"_24070":57853,"_5":24403,"_16893":98976,"_22829":98977,"_2311":97012},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2783":57860,"_24070":57853,"_5":24403,"_16893":98979,"_22829":98980,"_2311":97016},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#emite-y-controla-certificados",{"_2783":57861,"_24070":57853,"_5":24403,"_16893":98982,"_22829":98983,"_2311":97024},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#publica-el-estado-de-validación",{"_2783":57862,"_24070":57853,"_5":24403,"_16893":98985,"_22829":98986,"_2311":98987},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2783":57863,"_24070":57853,"_5":24403,"_16893":98989,"_22829":98990,"_2311":97939},[],"/docs/pr-preview/pr-27/es/platform/pki/overview#continúa",{"_2783":57864,"_24070":57853,"_16893":98992,"_5":16788,"_22829":57853,"_2311":98993},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2783":57865,"_24070":57853,"_16893":98995,"_5":16788,"_22829":98964,"_2311":98996},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2783":57866,"_24070":57853,"_16893":98998,"_5":16788,"_22829":98964,"_2311":98999},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2783":57867,"_24070":57853,"_16893":99001,"_5":16788,"_22829":98967,"_2311":99002},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2783":57868,"_24070":57853,"_16893":99004,"_5":16788,"_22829":98967,"_2311":99005},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2783":57869,"_24070":57853,"_16893":99007,"_5":16788,"_22829":98967,"_2311":99008},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2783":57870,"_24070":57853,"_16893":99010,"_5":16788,"_22829":98967,"_2311":99011},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2783":57871,"_24070":57853,"_16893":99013,"_5":16788,"_22829":98967,"_2311":99014},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2783":57872,"_24070":57853,"_16893":99016,"_5":16788,"_22829":98974,"_2311":99017},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2783":57873,"_24070":57853,"_16893":99019,"_5":16788,"_22829":98977,"_2311":99020},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2783":57874,"_24070":57853,"_16893":99022,"_5":16788,"_22829":98980,"_2311":99023},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2783":57875,"_24070":57853,"_16893":99025,"_5":16788,"_22829":98983,"_2311":99026},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2783":57876,"_24070":57853,"_16893":99028,"_5":16788,"_22829":98986,"_2311":99029},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2783":57877,"_24070":57853,"_16893":99031,"_5":16788,"_22829":98986,"_2311":99032},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2783":57878,"_24070":57853,"_16893":99034,"_5":16788,"_22829":98986,"_2311":99035},[],"su clave pública corresponda a la clave privada del cliente;",{"_2783":57879,"_24070":57853,"_16893":99037,"_5":16788,"_22829":98986,"_2311":99038},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2783":57880,"_24070":57853,"_16893":99040,"_5":16788,"_22829":98986,"_2311":99041},[],"sus fechas y usos permitan la operación;",{"_2783":57881,"_24070":57853,"_16893":99043,"_5":16788,"_22829":98986,"_2311":99044},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2783":57882,"_24070":57853,"_16893":99046,"_5":16788,"_22829":98986,"_2311":99047},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2783":57883,"_24070":57853,"_16893":99049,"_5":16788,"_22829":98990,"_2311":99050},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2783":57884,"_24070":57853,"_16893":99052,"_5":16788,"_22829":98990,"_2311":99053},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2783":57885,"_24070":57853,"_16893":99055,"_5":16788,"_22829":98990,"_2311":99056},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2783":57886,"_24070":57886,"_5":11891,"_2311":99058,"_24406":99059,"_16893":99060,"_22829":57886},"Crea tu primera CA",[39338,93790,44141,96606],[],{"_2783":57887,"_24070":57886,"_16893":99062,"_5":16788,"_22829":57886,"_2311":99063},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2783":57888,"_24070":57886,"_5":24403,"_16893":99065,"_22829":99066,"_2311":92491},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2783":57889,"_24070":57886,"_5":24403,"_16893":99068,"_22829":99069,"_2311":99070},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2783":57890,"_24070":57886,"_5":24403,"_16893":99072,"_22829":99073,"_2311":99074},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2783":57891,"_24070":57886,"_5":24403,"_16893":99076,"_22829":99077,"_2311":99078},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2783":57892,"_24070":57886,"_5":24403,"_16893":99080,"_22829":99081,"_2311":99082},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2783":57893,"_24070":57886,"_5":24403,"_16893":99084,"_22829":99085,"_2311":99086},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2783":57894,"_24070":57886,"_5":24403,"_16893":99088,"_22829":99089,"_2311":99090},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2783":57895,"_24070":57886,"_5":24403,"_16893":99092,"_22829":99093,"_2311":96854},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2783":57896,"_24070":57886,"_5":24403,"_16893":99095,"_22829":99096,"_2311":92515},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2783":57897,"_24070":57886,"_16893":99098,"_5":16788,"_22829":57886,"_2311":99099},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2783":57898,"_24070":57886,"_16893":99101,"_5":16788,"_22829":99066,"_2311":99102},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2783":57899,"_24070":57886,"_16893":99104,"_5":16788,"_22829":99066,"_2311":99105},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2783":57900,"_24070":57886,"_16893":99107,"_5":16788,"_22829":99066,"_2311":99108},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2783":57901,"_24070":57886,"_16893":99110,"_5":16788,"_22829":99066,"_2311":99111},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2783":57902,"_24070":57886,"_16893":99113,"_5":16788,"_22829":99069,"_2311":99114},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2783":57903,"_24070":57886,"_16893":99116,"_5":16788,"_22829":99069,"_2311":99117},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2783":57904,"_24070":57886,"_16893":99119,"_5":16788,"_22829":99073,"_2311":99120},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2783":57905,"_24070":57886,"_16893":99122,"_5":16788,"_22829":99073,"_2311":99123},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2783":57906,"_24070":57886,"_16893":99125,"_5":16788,"_22829":99077,"_2311":99126},[],"Selecciona **Root CA** y completa:",{"_2783":57907,"_24070":57886,"_16893":99128,"_5":16788,"_22829":99077,"_2311":46140},[],{"_2783":57908,"_24070":57886,"_16893":99130,"_5":16788,"_22829":99077,"_2311":99131},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2783":57909,"_24070":57886,"_16893":99133,"_5":16788,"_22829":99077,"_2311":99134},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2783":57910,"_24070":57886,"_16893":99136,"_5":16788,"_22829":99077,"_2311":99137},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2783":57911,"_24070":57886,"_16893":99139,"_5":16788,"_22829":99077,"_2311":99140},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2783":57912,"_24070":57886,"_16893":99142,"_5":16788,"_22829":99081,"_2311":99143},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2783":57913,"_24070":57886,"_16893":99145,"_5":16788,"_22829":99085,"_2311":99146},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2783":57914,"_24070":57886,"_16893":99148,"_5":16788,"_22829":99085,"_2311":99149},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2783":57915,"_24070":57886,"_16893":99151,"_5":16788,"_22829":99089,"_2311":99152},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2783":57916,"_24070":57886,"_16893":99154,"_5":16788,"_22829":99089,"_2311":99155},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2783":57917,"_24070":57886,"_16893":99157,"_5":16788,"_22829":99089,"_2311":99158},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2783":57918,"_24070":57886,"_16893":99160,"_5":16788,"_22829":99093,"_2311":99161},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2783":57919,"_24070":57886,"_16893":99163,"_5":16788,"_22829":99093,"_2311":99164},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2783":57920,"_24070":57886,"_16893":99166,"_5":16788,"_22829":99093,"_2311":99167},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2783":57921,"_24070":57886,"_16893":99169,"_5":16788,"_22829":99093,"_2311":99170},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2783":57922,"_24070":57886,"_16893":99172,"_5":16788,"_22829":99096,"_2311":99173},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2783":57923,"_24070":57923,"_5":11891,"_2311":99175,"_24406":99176,"_16893":99177,"_22829":57923},"Emite y verifica un certificado",[39338,93790,44141,96606],[],{"_2783":57924,"_24070":57923,"_16893":99179,"_5":16788,"_22829":57923,"_2311":99180},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2783":57925,"_24070":57923,"_5":24403,"_16893":99182,"_22829":99183,"_2311":92491},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2783":57926,"_24070":57923,"_5":24403,"_16893":99185,"_22829":99186,"_2311":99187},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2783":57927,"_24070":57923,"_5":24403,"_16893":99189,"_22829":99190,"_2311":99191},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2783":57928,"_24070":57923,"_5":24403,"_16893":99193,"_22829":99194,"_2311":99195},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2783":57929,"_24070":57923,"_5":24403,"_16893":99197,"_22829":99198,"_2311":99199},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2783":57930,"_24070":57923,"_5":24403,"_16893":99201,"_22829":99202,"_2311":99203},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2783":57931,"_24070":57923,"_5":24403,"_16893":99205,"_22829":99206,"_2311":99086},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2783":57932,"_24070":57923,"_5":24403,"_16893":99208,"_22829":99209,"_2311":99210},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2783":57933,"_24070":57923,"_5":24403,"_16893":99212,"_22829":99213,"_2311":99214},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2783":57934,"_24070":57923,"_5":24403,"_16893":99216,"_22829":99217,"_2311":99218},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2783":57935,"_24070":57923,"_5":24403,"_16893":99220,"_22829":99221,"_2311":96854},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2783":57936,"_24070":57923,"_5":24403,"_16893":99223,"_22829":99224,"_2311":92515},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2783":57937,"_24070":57923,"_16893":99226,"_5":16788,"_22829":57923,"_2311":99227},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2783":57938,"_24070":57923,"_16893":99229,"_5":16788,"_22829":99183,"_2311":99230},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2783":57939,"_24070":57923,"_16893":99232,"_5":16788,"_22829":99183,"_2311":99233},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2783":57940,"_24070":57923,"_16893":99235,"_5":16788,"_22829":99183,"_2311":99236},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2783":57941,"_24070":57923,"_16893":99238,"_5":16788,"_22829":99183,"_2311":99239},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2783":57942,"_24070":57923,"_16893":99241,"_5":16788,"_22829":99183,"_2311":99242},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2783":57943,"_24070":57923,"_16893":99244,"_5":16788,"_22829":99186,"_2311":99245},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2783":57944,"_24070":57923,"_16893":99247,"_5":16788,"_22829":99190,"_2311":99248},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2783":57945,"_24070":57923,"_16893":99250,"_5":16788,"_22829":99190,"_2311":99251},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2783":57946,"_24070":57923,"_16893":99253,"_5":16788,"_22829":99194,"_2311":99254},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2783":57947,"_24070":57923,"_16893":99256,"_5":16788,"_22829":99194,"_2311":99257},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2783":57948,"_24070":57923,"_16893":99259,"_5":16788,"_22829":99198,"_2311":99260},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2783":57949,"_24070":57923,"_16893":99262,"_5":16788,"_22829":99198,"_2311":99263},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2783":57950,"_24070":57923,"_16893":99265,"_5":16788,"_22829":99202,"_2311":99266},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2783":57951,"_24070":57923,"_16893":99268,"_5":16788,"_22829":99206,"_2311":99269},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2783":57952,"_24070":57923,"_16893":99271,"_5":16788,"_22829":99209,"_2311":99272},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2783":57953,"_24070":57923,"_16893":99274,"_5":16788,"_22829":99213,"_2311":99275},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2783":57954,"_24070":57923,"_16893":99277,"_5":16788,"_22829":99213,"_2311":99278},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2783":57955,"_24070":57923,"_16893":99280,"_5":16788,"_22829":99213,"_2311":99281},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2783":57956,"_24070":57923,"_16893":99283,"_5":16788,"_22829":99217,"_2311":99284},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2783":57957,"_24070":57923,"_16893":99286,"_5":16788,"_22829":99217,"_2311":99287},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2783":57958,"_24070":57923,"_16893":99289,"_5":16788,"_22829":99217,"_2311":99290},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2783":57959,"_24070":57923,"_16893":99292,"_5":16788,"_22829":99221,"_2311":96937},[],{"_2783":57960,"_24070":57923,"_16893":99294,"_5":16788,"_22829":99221,"_2311":95741},[],{"_2783":57961,"_24070":57923,"_16893":99296,"_5":16788,"_22829":99221,"_2311":99297},[],"La CA rechaza la emisión",{"_2783":57962,"_24070":57923,"_16893":99299,"_5":16788,"_22829":99221,"_2311":99300},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2783":57963,"_24070":57923,"_16893":99302,"_5":16788,"_22829":99221,"_2311":99303},[],"Sujeto o usos diferentes",{"_2783":57964,"_24070":57923,"_16893":99305,"_5":16788,"_22829":99221,"_2311":99306},[],"Perfil aplicado y valores solicitados.",{"_2783":57965,"_24070":57923,"_16893":99308,"_5":16788,"_22829":99221,"_2311":99309},[],"No se encuentra el emisor",{"_2783":57966,"_24070":57923,"_16893":99311,"_5":16788,"_22829":99221,"_2311":99312},[],"CA descargada y cadena intermedia necesaria.",{"_2783":57967,"_24070":57923,"_16893":99314,"_5":16788,"_22829":99221,"_2311":99315},[],"Falla la vigencia",{"_2783":57968,"_24070":57923,"_16893":99317,"_5":16788,"_22829":99221,"_2311":99318},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2783":57969,"_24070":57923,"_16893":99320,"_5":16788,"_22829":99221,"_2311":99321},[],"Los resúmenes de clave difieren",{"_2783":57970,"_24070":57923,"_16893":99323,"_5":16788,"_22829":99221,"_2311":99324},[],"Archivos de certificado y clave de la misma emisión.",{"_2783":57971,"_24070":57923,"_16893":99326,"_5":16788,"_22829":99221,"_2311":99327},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2783":57972,"_24070":57923,"_16893":99329,"_5":16788,"_22829":99224,"_2311":99330},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2783":57973,"_24070":57923,"_16893":99332,"_5":16788,"_22829":99224,"_2311":99333},[],"Gestionar certificados para inspección, estado y revocación.",{"_2783":57974,"_24070":57923,"_16893":99335,"_5":16788,"_22829":99224,"_2311":99336},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2783":57975,"_24070":57923,"_16893":99338,"_5":16788,"_22829":99224,"_2311":99339},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2783":57976,"_24070":57923,"_16893":99341,"_5":16788,"_22829":99224,"_2311":99342},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2783":57977,"_24070":57977,"_5":11891,"_2311":99344,"_24406":99345,"_16893":99346,"_22829":57977},"Primeros pasos de PKI",[39338,93790,44141,96606],[],{"_2783":57978,"_24070":57977,"_16893":99348,"_5":16788,"_22829":57977,"_2311":99349},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2783":57979,"_24070":57977,"_5":24403,"_16893":99351,"_22829":99352,"_2311":92491},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2783":57980,"_24070":57977,"_5":24403,"_16893":99354,"_22829":99355,"_2311":99356},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2783":57981,"_24070":57977,"_5":24403,"_16893":99358,"_22829":99359,"_2311":96788},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2783":57982,"_24070":57977,"_5":24403,"_16893":99361,"_22829":99362,"_2311":99363},[],"/docs/pr-preview/pr-27/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2783":57983,"_24070":57977,"_16893":99365,"_5":16788,"_22829":57977,"_2311":99366},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2783":57984,"_24070":57977,"_16893":99368,"_5":16788,"_22829":99352,"_2311":99369},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2783":57985,"_24070":57977,"_16893":99371,"_5":16788,"_22829":99352,"_2311":99372},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2783":57986,"_24070":57977,"_16893":99374,"_5":16788,"_22829":99352,"_2311":99375},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2783":57987,"_24070":57977,"_16893":99377,"_5":16788,"_22829":99352,"_2311":99378},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2783":57988,"_24070":57977,"_16893":99380,"_5":16788,"_22829":99352,"_2311":99381},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2783":57989,"_24070":57977,"_16893":99383,"_5":16788,"_22829":99355,"_2311":99384},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2783":57990,"_24070":57977,"_16893":99386,"_5":16788,"_22829":99355,"_2311":99387},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2783":57991,"_24070":57977,"_16893":99389,"_5":16788,"_22829":99355,"_2311":99390},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2783":57992,"_24070":57977,"_16893":99392,"_5":16788,"_22829":99355,"_2311":99393},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2783":57993,"_24070":57977,"_16893":99395,"_5":16788,"_22829":99359,"_2311":99396},[],"Archivo o recurso",{"_2783":57994,"_24070":57977,"_16893":99398,"_5":16788,"_22829":99359,"_2311":96785},[],{"_2783":57995,"_24070":57977,"_16893":99400,"_5":16788,"_22829":99359,"_2311":99401},[],"CA raíz activa y `ca.pem`",{"_2783":57996,"_24070":57977,"_16893":99403,"_5":16788,"_22829":99359,"_2311":99404},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2783":57997,"_24070":57977,"_16893":99406,"_5":16788,"_22829":99359,"_2311":99407},[],"Certificado final y `device.crt`",{"_2783":57998,"_24070":57977,"_16893":99409,"_5":16788,"_22829":99359,"_2311":99410},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2783":57999,"_24070":57977,"_16893":99412,"_5":16788,"_22829":99359,"_2311":99413},[],"Clave privada `device.key`",{"_2783":58000,"_24070":57977,"_16893":99415,"_5":16788,"_22829":99359,"_2311":99416},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2783":58001,"_24070":57977,"_16893":99418,"_5":16788,"_22829":99359,"_2311":99419},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2783":58002,"_24070":57977,"_16893":99421,"_5":16788,"_22829":99362,"_2311":99422},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2783":58003,"_24070":57977,"_16893":99424,"_5":16788,"_22829":99362,"_2311":99425},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2783":58004,"_24070":57977,"_16893":99427,"_5":16788,"_22829":99362,"_2311":99428},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2783":58005,"_24070":58005,"_5":11891,"_2311":99430,"_24406":99431,"_16893":99433,"_22829":58005},"Resolución de problemas PKI",[39338,93790,44141,99432],"Resolución de problemas",[],{"_2783":58006,"_24070":58005,"_16893":99435,"_5":16788,"_22829":58005,"_2311":99436},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2783":58007,"_24070":58005,"_5":24403,"_16893":99438,"_22829":99439,"_2311":99440},[],"/docs/pr-preview/pr-27/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2783":58008,"_24070":58005,"_5":24403,"_16893":99442,"_22829":99443,"_2311":99444},[],"/docs/pr-preview/pr-27/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2783":58009,"_24070":58005,"_5":24403,"_16893":99446,"_22829":99447,"_2311":99448},[],"/docs/pr-preview/pr-27/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2783":58010,"_24070":58005,"_16893":99450,"_5":16788,"_22829":58005,"_2311":99451},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2783":58011,"_24070":58005,"_16893":99453,"_5":16788,"_22829":58005,"_2311":99454},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2783":58012,"_24070":58005,"_16893":99456,"_5":16788,"_22829":99439,"_2311":96785},[],{"_2783":58013,"_24070":58005,"_16893":99458,"_5":16788,"_22829":99439,"_2311":95741},[],{"_2783":58014,"_24070":58005,"_16893":99460,"_5":16788,"_22829":99439,"_2311":92515},[],{"_2783":58015,"_24070":58005,"_16893":99462,"_5":16788,"_22829":99439,"_2311":46476},[],{"_2783":58016,"_24070":58005,"_16893":99464,"_5":16788,"_22829":99439,"_2311":99465},[],"Existe, está activa y sus fechas son utilizables.",{"_2783":58017,"_24070":58005,"_16893":99467,"_5":16788,"_22829":99439,"_2311":99468},[],"Autoridades.",{"_2783":58018,"_24070":58005,"_16893":99470,"_5":16788,"_22829":99439,"_2311":99471},[],"Clave",{"_2783":58019,"_24070":58005,"_16893":99473,"_5":16788,"_22829":99439,"_2311":99474},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2783":58020,"_24070":58005,"_16893":99476,"_5":16788,"_22829":99439,"_2311":99477},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2783":58021,"_24070":58005,"_16893":99479,"_5":16788,"_22829":99439,"_2311":46494},[],{"_2783":58022,"_24070":58005,"_16893":99481,"_5":16788,"_22829":99439,"_2311":99482},[],"PEM correcto y firma verificable.",{"_2783":58023,"_24070":58005,"_16893":99484,"_5":16788,"_22829":99439,"_2311":46500},[],{"_2783":58024,"_24070":58005,"_16893":99486,"_5":16788,"_22829":99439,"_2311":99487},[],"Perfil",{"_2783":58025,"_24070":58005,"_16893":99489,"_5":16788,"_22829":99439,"_2311":99490},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2783":58026,"_24070":58005,"_16893":99492,"_5":16788,"_22829":99439,"_2311":99493},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2783":58027,"_24070":58005,"_16893":99495,"_5":16788,"_22829":99439,"_2311":96937},[],{"_2783":58028,"_24070":58005,"_16893":99497,"_5":16788,"_22829":99439,"_2311":99498},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2783":58029,"_24070":58005,"_16893":99500,"_5":16788,"_22829":99439,"_2311":99501},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2783":58030,"_24070":58005,"_16893":99503,"_5":16788,"_22829":99439,"_2311":99504},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2783":58031,"_24070":58005,"_16893":99506,"_5":16788,"_22829":99439,"_2311":99507},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2783":58032,"_24070":58005,"_16893":99509,"_5":16788,"_22829":99443,"_2311":99510},[],"Revisa cada frontera por separado:",{"_2783":58033,"_24070":58005,"_16893":99512,"_5":16788,"_22829":99443,"_2311":99513},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2783":58034,"_24070":58005,"_16893":99515,"_5":16788,"_22829":99443,"_2311":99516},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2783":58035,"_24070":58005,"_16893":99518,"_5":16788,"_22829":99443,"_2311":99519},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2783":58036,"_24070":58005,"_16893":99521,"_5":16788,"_22829":99443,"_2311":99522},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2783":58037,"_24070":58005,"_16893":99524,"_5":16788,"_22829":99443,"_2311":99525},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2783":58038,"_24070":58005,"_16893":99527,"_5":16788,"_22829":99443,"_2311":99528},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2783":58039,"_24070":58005,"_16893":99530,"_5":16788,"_22829":99447,"_2311":99531},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2783":58040,"_24070":58005,"_16893":99533,"_5":16788,"_22829":99447,"_2311":99534},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_46554":99536,"_46556":99537,"_46558":99538,"_46560":99539,"_14693":2333,"_55743":2333},"spanish",[2311,24070,5,22829],{"_2311":20125,"_24070":20125,"_5":20125,"_22829":20125},{"_2311":99540,"_24070":101834,"_5":104128,"_22829":106422},{"_3710":99541,"_46564":99542,"_5":20125},{"_11654":3674,"_11974":4834,"_11981":4568,"_23327":9158,"_22913":4476,"_16026":6035,"_11675":11703,"_11682":18390,"_23289":4525,"_23628":18389,"_23638":14778,"_23302":4531,"_27827":5720,"_23649":2453,"_27832":4942,"_27835":24083,"_27838":9094,"_27841":3521,"_27844":3766,"_23950":3713,"_27849":9174,"_27851":2574,"_23986":9182,"_23940":16440,"_27855":12651,"_27858":5122,"_24128":5313,"_23667":2474,"_23945":6113,"_24004":4028,"_27864":4766,"_27866":2751,"_27868":4763,"_27870":5979,"_27872":2631,"_27874":4719,"_27876":20130,"_27878":5568,"_27880":4977,"_23340":5606,"_27883":2609,"_27885":2669,"_23334":3820,"_27888":5488,"_27890":10709,"_27892":3967,"_27895":3906,"_23370":3672,"_27899":5808,"_23280":2738,"_27902":9787,"_23307":8479,"_27905":4069,"_27907":2840,"_27910":13456,"_23981":5803,"_27913":2531,"_27915":6128,"_27918":4424,"_27920":2742,"_27922":9187,"_27924":10750,"_27926":6129,"_16029":9186,"_27929":7307,"_27931":3969,"_27933":3879,"_23661":5530,"_27936":4093,"_27938":3757,"_27940":10416,"_27942":2639,"_27944":2567,"_27946":13966,"_27948":2546,"_24056":4080,"_23688":4747,"_27952":5956,"_27954":3771,"_23318":3532,"_27957":5023,"_27959":19962,"_27961":3194,"_23999":4625,"_27964":3696,"_27966":5881,"_27968":17237,"_27970":5581,"_27972":5599,"_23416":3878,"_27977":14203,"_23655":20135,"_27980":5569,"_27982":2652,"_27984":3221,"_27986":7978,"_27988":2536,"_27990":19228,"_23410":6032,"_23633":12157,"_27994":9875,"_27996":2805,"_27999":2760,"_28001":5980,"