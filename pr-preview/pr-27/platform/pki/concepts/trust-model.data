27/deployment/self-hosted/overview",{"_57":277},{"_32":282,"_39":50,"_34":283,"_44":284,"_53":-7,"_13":285,"_55":286},"deployment/self-hosted/fastlane.mdx","Fastlane","Referencia del script scripts/lamassu-fast-lane.sh para desplegar Lamassu PKI de forma automatizada en Kubernetes","/docs/pr-preview/pr-27/deployment/self-hosted/fastlane",{"_57":282},{"_32":288,"_39":60,"_53":-7,"_34":289},"_6","Otros modelos",{"_32":291,"_39":50,"_34":292,"_44":293,"_53":-7,"_13":294,"_55":295},"deployment/aws-marketplace.mdx","Despliega desde AWS Marketplace","Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.","/docs/pr-preview/pr-27/deployment/aws-marketplace",{"_57":291},{"_32":297,"_39":50,"_34":298,"_44":299,"_53":-7,"_13":300,"_55":301},"deployment/saas.mdx","Utiliza Lamassu como SaaS","Consume Lamassu como servicio gestionado sin operar infraestructura propia.","/docs/pr-preview/pr-27/deployment/saas",{"_57":297},"deployment",{"_260":304},"deployment/meta.json","<link rel=\"preload\" as=\"image\" href=\"/docs/pr-preview/pr-27/images/kubernetes.svg\"/><img src=\"/docs/pr-preview/pr-27/images/kubernetes.svg\" width=\"20\" height=\"20\" style=\"width:1.25rem;height:1.25rem;vertical-align:middle;flex-shrink:0;object-fit:contain\"/>","fallback",{"_32":308,"_34":35,"_36":309,"_306":-7},"fallback:root",[310],{"_32":311,"_39":50,"_34":312,"_44":313,"_53":-7,"_13":314,"_55":315},"fallback:test.mdx","Test","A document to test Fumadocs","/docs/pr-preview/pr-27/test",{"_57":316},"test.mdx"]
