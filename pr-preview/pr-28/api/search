view/pr-28/platform/pki/access-control-17","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/access-control#prepare-the-identity-provider","content":"Prepare the identity provider"},"384":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-18","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/access-control#configure-the-two-jwt-validations","content":"Configure the two JWT validations"},"385":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-19","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/access-control#install-and-verify-administrative-access","content":"Install and verify administrative access"},"386":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-20","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/access-control#test-an-unprivileged-identity","content":"Test an unprivileged identity"},"387":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-21","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/access-control#reduce-use-of-the-bootstrap-administrator","content":"Reduce use of the bootstrap administrator"},"388":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-22","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/access-control#fastlane-bootstrap","content":"Fastlane bootstrap"},"389":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-23","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/access-control#design-least-privilege-roles","content":"Design least-privilege roles"},"390":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-24","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/access-control#changes-and-access-revocation","content":"Changes and access revocation"},"391":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-25","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/access-control#operational-checklist","content":"Operational checklist"},"392":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-26","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/access-control#diagnostics","content":"Diagnostics"},"393":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-27","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/access-control#the-response-is-401","content":"The response is 401"},"394":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-28","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/access-control#the-response-is-403","content":"The response is 403"},"395":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-29","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/access-control#everything-returns-403","content":"Everything returns 403"},"396":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-30","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/access-control#access-appears-without-a-policy-grant","content":"Access appears without a policy grant"},"397":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-31","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/access-control#everything-fails-when-authz-is-unavailable","content":"Everything fails when authz is unavailable"},"398":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-32","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control","content":"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**."},"399":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-33","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control","content":"Lamassu does not assign permissions directly to users. The full chain is:"},"400":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-34","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control","content":"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider."},"401":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-35","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#essential-concepts","content":"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled."},"402":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-36","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#essential-concepts","content":"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both."},"403":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-37","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#essential-concepts","content":"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute."},"404":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-38","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#essential-concepts","content":"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter."},"405":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-39","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#essential-concepts","content":"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals."},"406":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-40","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#essential-concepts","content":"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and one of its policies must allow the requested operation."},"407":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-41","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#two-decision-systems","content":"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way."},"408":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-42","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#two-decision-systems","content":"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries."},"409":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-43","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#integrated-or-external-http-services","content":"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema."},"410":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-44","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#integrated-or-external-http-services","content":"The decision is made **before forwarding the request to the service**:"},"411":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-45","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#integrated-or-external-http-services","content":"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS."},"412":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-46","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#integrated-or-external-http-services","content":"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`."},"413":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-47","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#integrated-or-external-http-services","content":"`authz` extracts the credential and resolves all active principals matching it."},"414":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-48","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#integrated-or-external-http-services","content":"It separately loads the policies granted to each principal."},"415":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-49","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#integrated-or-external-http-services","content":"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`."},"416":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-50","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#integrated-or-external-http-services","content":"`authz` looks for an HTTP rule granting that action."},"417":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-51","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#integrated-or-external-http-services","content":"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values."},"418":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-52","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#integrated-or-external-http-services","content":"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway."},"419":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-53","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#integrated-or-external-http-services","content":"When it allows access, `authz` returns the selected principal in `x-current-user`. The Gateway can propagate that header to the service to preserve the identity context."},"420":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-54","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#integrated-or-external-http-services","content":"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, the schema must declare a constraint relating a request value to a normalized attribute of the principal."},"421":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-55","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#authentication-only-routes-and-unmapped-paths","content":"Two schema-level settings cover endpoints that policies do not mention:"},"422":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-56","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#authentication-only-routes-and-unmapped-paths","content":"**`skip_authz: true` on a route** allows any authenticated identity to reach it without a policy grant. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a failed credential is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request."},"423":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-57","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#authentication-only-routes-and-unmapped-paths","content":"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any authenticated identity."},"424":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-58","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#authentication-only-routes-and-unmapped-paths","content":"These are decisions of the schema, not of a policy: they never replace the grant a mapped route requires, they only fill the gap left by endpoints the schema does not enumerate. Keep three rules in mind:"},"425":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-59","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#authentication-only-routes-and-unmapped-paths","content":"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`."},"426":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-60","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#authentication-only-routes-and-unmapped-paths","content":"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides."},"427":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-61","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#authentication-only-routes-and-unmapped-paths","content":"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load."},"428":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-62","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#authentication-only-routes-and-unmapped-paths","content":"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every authenticated identity can reach what they open, including identities with no granted policies. Review these settings whenever you add or upgrade an integrated service."},"429":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-63","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#services-developed-by-lamassu","content":"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others."},"430":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-64","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#services-developed-by-lamassu","content":"The decision is made with the domain operation context:"},"431":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-65","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#services-developed-by-lamassu","content":"The middleware extracts the credential and resolves the matching principals."},"432":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-66","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#services-developed-by-lamassu","content":"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource."},"433":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-67","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#services-developed-by-lamassu","content":"`authz` gathers the entity rules of the granted policies."},"434":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-68","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#services-developed-by-lamassu","content":"The engine evaluates direct grants, attribute filters and relations with other entities."},"435":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-69","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#services-developed-by-lamassu","content":"For an individual operation, it checks that the concrete resource satisfies the computed scope."},"436":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-70","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#services-developed-by-lamassu","content":"For a listing, it generates a SQL filter that the service adds to its own query."},"437":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-71","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#services-developed-by-lamassu","content":"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**."},"438":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-72","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#services-developed-by-lamassu","content":"Actions fall into two groups:"},"439":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-73","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#services-developed-by-lamassu","content":"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples."},"440":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-74","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#services-developed-by-lamassu","content":"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations."},"441":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-75","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#services-developed-by-lamassu","content":"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface."},"442":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-76","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#how-the-two-paths-relate","content":"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services."},"443":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-77","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#how-the-two-paths-relate","content":"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity."},"444":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-78","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#how-the-two-paths-relate","content":"If no combination of principal, policy and rule allows the operation, Lamassu denies it. Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes."},"445":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-79","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#oidc-principals","content":"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens."},"446":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-80","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#oidc-principals","content":"The following principal represents any identity holding the `pki-operators` role in Keycloak:"},"447":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-81","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#oidc-principals","content":"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time."},"448":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-82","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#oidc-principals","content":"The implemented operators are:"},"449":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-83","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#oidc-principals","content":"`equals`, for exact equality;"},"450":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-84","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#oidc-principals","content":"`contains`, to check membership in a list or the presence of text in a scalar value."},"451":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-85","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#oidc-principals","content":"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's."},"452":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-86","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#oidc-principals","content":"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`."},"453":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-87","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#x509-principals","content":"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name."},"454":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-88","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#x509-principals","content":"The available modes are:"},"455":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-89","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#x509-principals","content":"`serial_and_ca`: an exact certificate, identified by serial number and CA;"},"456":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-90","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#x509-principals","content":"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;"},"457":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-91","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#x509-principals","content":"`any_from_ca`: any certificate issued directly by the given CA."},"458":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-92","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#x509-principals","content":"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:"},"459":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-93","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#x509-principals","content":"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA."},"460":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-94","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#x509-principals","content":"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs."},"461":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-95","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#when-several-principals-match","content":"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function."},"462":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-96","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#when-several-principals-match","content":"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them."},"463":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-97","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#when-several-principals-match","content":"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another."},"464":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-98","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#when-several-principals-match","content":"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive."},"465":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-99","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#global-and-direct-access","content":"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations."},"466":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-100","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#global-and-direct-access","content":"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible."},"467":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-101","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#access-inherited-through-relations","content":"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources."},"468":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-102","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#access-inherited-through-relations","content":"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy."},"469":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-103","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#attribute-filtered-access","content":"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND."},"470":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-104","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#attribute-filtered-access","content":"For example, this rule allows reading active certificates issued by a specific CA:"},"471":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-105","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#attribute-filtered-access","content":"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values."},"472":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-106","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#http-rules","content":"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs."},"473":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-107","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#http-rules","content":"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`."},"474":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-108","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#http-rules","content":"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases."},"475":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-109","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#http-rules","content":"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:"},"476":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-110","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#http-rules","content":"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`."},"477":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-111","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#http-rules","content":"Note that:"},"478":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-112","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#http-rules","content":"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`."},"479":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-113","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#http-rules","content":"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied."},"480":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-114","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#http-rules","content":"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass."},"481":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-115","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#included-policies","content":"The `authz` preload installs reusable policies for the main domains. Among them are:"},"482":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-116","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#included-policies","content":"full and read-only access to certificates and authorities;"},"483":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-117","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#included-policies","content":"full and read-only access to the KMS;"},"484":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-118","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#included-policies","content":"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;"},"485":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-119","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#included-policies","content":"an `Auditor` policy with PKI read access and authorization visibility;"},"486":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-120","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#included-policies","content":"console access;"},"487":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-121","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#included-policies","content":"administration and observation policies for the Job Manager NBI and SBI APIs;"},"488":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-122","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#included-policies","content":"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains."},"489":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-123","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#included-policies","content":"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions."},"490":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-124","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#provision-the-first-administrator","content":"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform."},"491":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-125","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#provision-the-first-administrator","content":"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API."},"492":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-126","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#provision-the-first-administrator","content":"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades."},"493":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-127","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#prepare-the-identity-provider","content":"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`."},"494":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-128","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#configure-the-two-jwt-validations","content":"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components."},"495":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-129","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#install-and-verify-administrative-access","content":"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation."},"496":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-130","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#test-an-unprivileged-identity","content":"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations."},"497":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-131","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#reduce-use-of-the-bootstrap-administrator","content":"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work."},"498":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-132","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#fastlane-bootstrap","content":"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`."},"499":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-133","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#fastlane-bootstrap","content":"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design."},"500":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-134","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#design-least-privilege-roles","content":"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:"},"501":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-135","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#design-least-privilege-roles","content":"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group."},"502":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-136","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#design-least-privilege-roles","content":"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access."},"503":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-137","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#design-least-privilege-roles","content":"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration."},"504":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-138","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#design-least-privilege-roles","content":"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting."},"505":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-139","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#design-least-privilege-roles","content":"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls."},"506":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-140","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#design-least-privilege-roles","content":"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions."},"507":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-141","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#design-least-privilege-roles","content":"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade."},"508":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-142","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#changes-and-access-revocation","content":"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching."},"509":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-143","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#changes-and-access-revocation","content":"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider."},"510":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-144","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#changes-and-access-revocation","content":"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one."},"511":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-145","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#operational-checklist","content":"Keep `failOpen: false` unless a documented risk assessment justifies otherwise."},"512":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-146","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#operational-checklist","content":"Use groups or stable roles for people and independent identities for automations."},"513":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-147","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#operational-checklist","content":"Keep at least two recovery administrators and test their access periodically."},"514":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-148","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#operational-checklist","content":"Review active principals, their matches and their grants after IdP changes."},"515":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-149","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#operational-checklist","content":"Search for wildcards in policies before upgrading Lamassu."},"516":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-150","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#operational-checklist","content":"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service."},"517":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-151","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#operational-checklist","content":"Always test one allowed and one denied operation for each role."},"518":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-152","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#operational-checklist","content":"Correlate changes to principals, policies and grants with the audit logs."},"519":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-153","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#the-response-is-401","content":"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential."},"520":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-154","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#the-response-is-403","content":"The credential could be processed but did not produce a positive authorization. Review in this order:"},"521":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-155","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#the-response-is-403","content":"that an active principal of the correct type exists;"},"522":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-156","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#the-response-is-403","content":"that the claim paths and values match the real token exactly;"},"523":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-157","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#the-response-is-403","content":"that all of the principal's conditions hold;"},"524":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-158","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#the-response-is-403","content":"that the principal has the expected policy granted;"},"525":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-159","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#the-response-is-403","content":"that the policy includes the action and the requested resource type or route;"},"526":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-160","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#the-response-is-403","content":"that the identifier, relation, column filter or HTTP constraint includes the real resource."},"527":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-161","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#the-response-is-403","content":"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace."},"528":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-162","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#everything-returns-403","content":"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster."},"529":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-163","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#access-appears-without-a-policy-grant","content":"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any authenticated identity, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants."},"530":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-164","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#everything-fails-when-authz-is-unavailable","content":"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision."},"531":{"id":"/docs/pr-preview/pr-28/platform/pki/access-control-165","page_id":"/docs/pr-preview/pr-28/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/access-control#everything-fails-when-authz-is-unavailable","content":"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment."},"532":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","type":"page","content":"Alerts and subscriptions","breadcrumbs":["Docs","Platform","Operate Lamassu"],"tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/alerts"},"533":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-0","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts","content":"Send PKI events to people and external systems."},"534":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-1","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/alerts#how-it-works","content":"How it works"},"535":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-2","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/alerts#available-channels","content":"Available channels"},"536":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-3","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/alerts#create-a-subscription","content":"Create a subscription"},"537":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-4","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/alerts#choose-the-event","content":"Choose the event"},"538":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-5","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/alerts#configure-the-destination","content":"Configure the destination"},"539":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-6","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/alerts#limit-the-notifications","content":"Limit the notifications"},"540":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-7","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/alerts#review-and-activate","content":"Review and activate"},"541":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-8","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/alerts#manage-a-subscription","content":"Manage a subscription"},"542":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-9","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/alerts#event-families","content":"Event families"},"543":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-10","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts","content":"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes."},"544":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-11","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#how-it-works","content":"A service publishes a domain event."},"545":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-12","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#how-it-works","content":"Lamassu evaluates the subscriptions associated with that event type."},"546":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-13","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#how-it-works","content":"Each subscription's filter decides whether it should be notified."},"547":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-14","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#how-it-works","content":"Lamassu delivers the event to the configured channel."},"548":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-15","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#how-it-works","content":"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter."},"549":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-16","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#available-channels","content":"**Email** sends alerts to a person or an operational list. It only requires the destination address."},"550":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-17","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#available-channels","content":"**Microsoft Teams** posts the notification to a channel through its webhook URL."},"551":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-18","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#available-channels","content":"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`."},"552":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-19","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#choose-the-event","content":"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on."},"553":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-20","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#configure-the-destination","content":"Select Email, Microsoft Teams or Webhook and enter the channel details."},"554":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-21","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#limit-the-notifications","content":"Add a filter if you don't want to receive every instance of the event."},"555":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-22","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#limit-the-notifications","content":"**None** notifies all instances of the event."},"556":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-23","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#limit-the-notifications","content":"**JSON Path** evaluates one or more specific fields."},"557":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-24","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#limit-the-notifications","content":"**JSON Schema** accepts only payloads with a particular structure."},"558":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-25","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#limit-the-notifications","content":"**JavaScript** lets you express custom logic."},"559":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-26","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#limit-the-notifications","content":"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity."},"560":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-27","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#review-and-activate","content":"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery."},"561":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-28","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#manage-a-subscription","content":"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints."},"562":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-29","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#event-families","content":"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`."},"563":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-30","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#event-families","content":"**Certificates:** `ca.sign.certificate` and `certificate.delete`."},"564":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-31","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#event-families","content":"**Profiles:** `profile.create`, `profile.update` and `profile.delete`."},"565":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-32","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#event-families","content":"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`."},"566":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-33","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#event-families","content":"**Devices:** `device.create`, `device.identity.update` and `device.status.update`."},"567":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-34","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#event-families","content":"**Validation:** `va.role.crl.create`."},"568":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-35","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#event-families","content":"**Keys:** `kms.create`, `kms.import`, `kms.sign.message` and `kms.delete`."},"569":{"id":"/docs/pr-preview/pr-28/platform/pki/alerts-36","page_id":"/docs/pr-preview/pr-28/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/alerts#event-families","content":"Use the catalog shown in the console as the source for the types available in your deployed version."},"570":{"id":"/docs/pr-preview/pr-28/platform/pki/audit-logs","page_id":"/docs/pr-preview/pr-28/platform/pki/audit-logs","type":"page","content":"Audit logs","breadcrumbs":["Docs","Platform","Administer Lamassu"],"tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/audit-logs"},"571":{"id":"/docs/pr-preview/pr-28/platform/pki/audit-logs-0","page_id":"/docs/pr-preview/pr-28/platform/pki/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/platform/pki/audit-logs","content":"Understand which audit events Lamassu generates and how to turn them into a durable trail."},"572":{"id":"/docs/pr-preview/pr-28/platform/pki/audit-logs-1","page_id":"/docs/pr-preview/pr-28/platform/pki/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/audit-logs#what-an-event-contains","content":"What an event contains"},"573":{"id":"/docs/pr-preview/pr-28/platform/pki/audit-logs-2","page_id":"/docs/pr-preview/pr-28/platform/pki/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/audit-logs#coverage","content":"Coverage"},"574":{"id":"/docs/pr-preview/pr-28/platform/pki/audit-logs-3","page_id":"/docs/pr-preview/pr-28/platform/pki/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/platform/pki/audit-logs#publication-and-persistence","content":"Publication and persistence"},"57