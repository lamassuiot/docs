ss-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#políticas-incluidas","content":"Políticas incluidas"},"382":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-16","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#provisiona-el-primer-administrador","content":"Provisiona el primer administrador"},"383":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-17","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#prepara-el-proveedor-de-identidad","content":"Prepara el proveedor de identidad"},"384":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-18","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#configura-las-dos-validaciones-jwt","content":"Configura las dos validaciones JWT"},"385":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-19","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#instala-y-verifica-el-acceso-administrativo","content":"Instala y verifica el acceso administrativo"},"386":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-20","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#prueba-una-identidad-sin-privilegios","content":"Prueba una identidad sin privilegios"},"387":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-21","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#reduce-el-uso-del-administrador-de-bootstrap","content":"Reduce el uso del administrador de bootstrap"},"388":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-22","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#bootstrap-de-fastlane","content":"Bootstrap de Fastlane"},"389":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-23","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#diseña-roles-de-mínimo-privilegio","content":"Diseña roles de mínimo privilegio"},"390":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-24","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#cambios-y-revocación-de-acceso","content":"Cambios y revocación de acceso"},"391":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-25","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#lista-de-comprobación-operativa","content":"Lista de comprobación operativa"},"392":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-26","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#diagnóstico","content":"Diagnóstico"},"393":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-27","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#la-respuesta-es-401","content":"La respuesta es 401"},"394":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-28","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#la-respuesta-es-403","content":"La respuesta es 403"},"395":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-29","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#todo-devuelve-403","content":"Todo devuelve 403"},"396":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-30","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#aparece-acceso-sin-política-concedida","content":"Aparece acceso sin política concedida"},"397":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-31","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#todo-falla-cuando-authz-no-está-disponible","content":"Todo falla cuando authz no está disponible"},"398":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-32","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control","content":"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**."},"399":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-33","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control","content":"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:"},"400":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-34","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control","content":"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto."},"401":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-35","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#conceptos-esenciales","content":"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado."},"402":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-36","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#conceptos-esenciales","content":"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas."},"403":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-37","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#conceptos-esenciales","content":"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo."},"404":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-38","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#conceptos-esenciales","content":"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro."},"405":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-39","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#conceptos-esenciales","content":"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales."},"406":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-40","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#conceptos-esenciales","content":"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y alguna de sus políticas debe permitir la operación solicitada."},"407":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-41","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#dos-sistemas-de-decisión","content":"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera."},"408":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-42","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#dos-sistemas-de-decisión","content":"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas."},"409":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-43","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-http-integrados-o-externos","content":"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`."},"410":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-44","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-http-integrados-o-externos","content":"La decisión se toma **antes de reenviar la petición al servicio**:"},"411":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-45","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-http-integrados-o-externos","content":"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC."},"412":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-46","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-http-integrados-o-externos","content":"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`."},"413":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-47","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-http-integrados-o-externos","content":"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella."},"414":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-48","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-http-integrados-o-externos","content":"Carga por separado las políticas concedidas a cada principal."},"415":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-49","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-http-integrados-o-externos","content":"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`."},"416":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-50","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-http-integrados-o-externos","content":"`authz` busca una regla HTTP que conceda esa acción."},"417":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-51","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-http-integrados-o-externos","content":"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición."},"418":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-52","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-http-integrados-o-externos","content":"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway."},"419":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-53","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-http-integrados-o-externos","content":"Cuando permite el acceso, `authz` devuelve el principal seleccionado en `x-current-user`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad."},"420":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-54","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-http-integrados-o-externos","content":"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, el esquema debe declarar una restricción que relacione un valor de la petición con un atributo normalizado del principal."},"421":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-55","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:"},"422":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-56","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad autenticada sin una política que la conceda. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial incorrecta se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición."},"423":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-57","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad autenticada."},"424":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-58","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"Son decisiones del esquema, no de una política: nunca sustituyen el grant que exige una ruta mapeada, solo cubren el hueco de los endpoints que el esquema no enumera. Ten en cuenta tres reglas:"},"425":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-59","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`."},"426":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-60","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo."},"427":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-61","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar."},"428":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-62","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad autenticada puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Revisa estos ajustes cada vez que integres o actualices un servicio."},"429":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-63","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","content":"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras."},"430":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-64","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","content":"La decisión se toma con el contexto de la operación de dominio:"},"431":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-65","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","content":"El middleware extrae la credencial y resuelve los principales coincidentes."},"432":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-66","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","content":"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado."},"433":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-67","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","content":"`authz` reúne las reglas de entidad de las políticas concedidas."},"434":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-68","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","content":"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades."},"435":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-69","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","content":"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado."},"436":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-70","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","content":"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta."},"437":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-71","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","content":"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**."},"438":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-72","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","content":"Las acciones se dividen en dos grupos:"},"439":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-73","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","content":"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales."},"440":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-74","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","content":"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida."},"441":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-75","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","content":"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz."},"442":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-76","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#cómo-se-relacionan-ambos-caminos","content":"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos."},"443":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-77","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#cómo-se-relacionan-ambos-caminos","content":"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad."},"444":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-78","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#cómo-se-relacionan-ambos-caminos","content":"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega. Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas."},"445":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-79","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-oidc","content":"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens."},"446":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-80","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-oidc","content":"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:"},"447":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-81","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-oidc","content":"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez."},"448":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-82","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-oidc","content":"Los operadores implementados son:"},"449":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-83","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-oidc","content":"`equals`, para igualdad exacta;"},"450":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-84","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-oidc","content":"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar."},"451":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-85","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-oidc","content":"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano."},"452":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-86","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-oidc","content":"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`."},"453":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-87","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-x509","content":"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name."},"454":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-88","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-x509","content":"Los modos disponibles son:"},"455":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-89","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-x509","content":"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;"},"456":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-90","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-x509","content":"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;"},"457":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-91","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-x509","content":"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada."},"458":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-92","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-x509","content":"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:"},"459":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-93","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-x509","content":"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA."},"460":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-94","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-x509","content":"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes."},"461":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-95","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#cuando-coinciden-varios-principales","content":"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa."},"462":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-96","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#cuando-coinciden-varios-principales","content":"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos."},"463":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-97","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#cuando-coinciden-varios-principales","content":"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro."},"464":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-98","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#cuando-coinciden-varios-principales","content":"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real."},"465":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-99","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#acceso-global-y-acceso-directo","content":"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas."},"466":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-100","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#acceso-global-y-acceso-directo","content":"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible."},"467":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-101","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#acceso-heredado-por-relaciones","content":"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados."},"468":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-102","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#acceso-heredado-por-relaciones","content":"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política."},"469":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-103","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#acceso-filtrado-por-atributos","content":"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND."},"470":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-104","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#acceso-filtrado-por-atributos","content":"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:"},"471":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-105","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#acceso-filtrado-por-atributos","content":"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados."},"472":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-106","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#reglas-http","content":"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs."},"473":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-107","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#reglas-http","content":"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`."},"474":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-108","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#reglas-http","content":"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos."},"475":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-109","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#reglas-http","content":"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:"},"476":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-110","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#reglas-http","content":"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`."},"477":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-111","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#reglas-http","content":"Ten en cuenta que:"},"478":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-112","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#reglas-http","content":"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`."},"479":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-113","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#reglas-http","content":"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega."},"480":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-114","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#reglas-http","content":"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan."},"481":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-115","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#políticas-incluidas","content":"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:"},"482":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-116","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#políticas-incluidas","content":"acceso completo y de solo lectura a certificados y autoridades;"},"483":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-117","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#políticas-incluidas","content":"acceso completo y de solo lectura a KMS;"},"484":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-118","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#políticas-incluidas","content":"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;"},"485":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-119","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#políticas-incluidas","content":"una política `Auditor` de lectura de PKI y visibilidad de autorización;"},"486":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-120","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#políticas-incluidas","content":"acceso a la interfaz;"},"487":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-121","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#políticas-incluidas","content":"políticas de administración y observación para las APIs NBI y SBI del Job Manager;"},"488":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-122","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#políticas-incluidas","content":"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`."},"489":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-123","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#políticas-incluidas","content":"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal."},"490":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-124","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#provisiona-el-primer-administrador","content":"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma."},"491":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-125","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#provisiona-el-primer-administrador","content":"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI."},"492":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-126","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#provisiona-el-primer-administrador","content":"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones."},"493":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-127","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#prepara-el-proveedor-de-identidad","content":"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`."},"494":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-128","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#configura-las-dos-validaciones-jwt","content":"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes."},"495":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-129","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#instala-y-verifica-el-acceso-administrativo","content":"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva."},"496":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-130","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#prueba-una-identidad-sin-privilegios","content":"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales."},"497":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-131","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#reduce-el-uso-del-administrador-de-bootstrap","content":"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario."},"498":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-132","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#bootstrap-de-fastlane","content":"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`."},"499":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-133","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#bootstrap-de-fastlane","content":"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción."},"500":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-134","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#diseña-roles-de-mínimo-privilegio","content":"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:"},"501":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-135","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#diseña-roles-de-mínimo-privilegio","content":"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado."},"502":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-136","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#diseña-roles-de-mínimo-privilegio","content":"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso."},"503":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-137","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#diseña-roles-de-mínimo-privilegio","content":"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización."},"504":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-138","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#diseña-roles-de-mínimo-privilegio","content":"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar."},"505":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-139","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#diseña-roles-de-mínimo-privilegio","content":"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla."},"506":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-140","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#diseña-roles-de-mínimo-privilegio","content":"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente."},"507":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-141","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#diseña-roles-de-mínimo-privilegio","content":"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización."},"508":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-142","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#cambios-y-revocación-de-acceso","content":"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia."},"509":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-143","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#cambios-y-revocación-de-acceso","content":"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor."},"510":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-144","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#cambios-y-revocación-de-acceso","content":"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior."},"511":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-145","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#lista-de-comprobación-operativa","content":"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario."},"512":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-146","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#lista-de-comprobación-operativa","content":"Usa grupos o roles estables para personas e identidades independientes para automatizaciones."},"513":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-147","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#lista-de-comprobación-operativa","content":"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente."},"514":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-148","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#lista-de-comprobación-operativa","content":"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP."},"515":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-149","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#lista-de-comprobación-operativa","content":"Busca comodines en políticas antes de actualizar Lamassu."},"516":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-150","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#lista-de-comprobación-operativa","content":"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio."},"517":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-151","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#lista-de-comprobación-operativa","content":"Prueba siempre una operación permitida y otra denegada para cada rol."},"518":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-152","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#lista-de-comprobación-operativa","content":"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría."},"519":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-153","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#la-respuesta-es-401","content":"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial."},"520":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-154","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#la-respuesta-es-403","content":"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:"},"521":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-155","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#la-respuesta-es-403","content":"que exista un principal activo del tipo correcto;"},"522":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-156","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#la-respuesta-es-403","content":"que las rutas de claims y sus valores coincidan exactamente con el token real;"},"523":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-157","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#la-respuesta-es-403","content":"que todas las condiciones del principal se cumplan;"},"524":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-158","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#la-respuesta-es-403","content":"que el principal tenga concedida la política esperada;"},"525":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-159","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#la-respuesta-es-403","content":"que la política incluya la acción y el tipo de recurso o ruta solicitados;"},"526":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-160","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#la-respuesta-es-403","content":"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real."},"527":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-161","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#la-respuesta-es-403","content":"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway."},"528":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-162","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#todo-devuelve-403","content":"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster."},"529":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-163","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#aparece-acceso-sin-política-concedida","content":"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad autenticada, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados."},"530":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-164","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#todo-falla-cuando-authz-no-está-disponible","content":"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización."},"531":{"id":"/docs/pr-preview/pr-28/es/platform/pki/access-control-165","page_id":"/docs/pr-preview/pr-28/es/platform/pki/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/access-control#todo-falla-cuando-authz-no-está-disponible","content":"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue."},"532":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","type":"page","content":"Alertas y suscripciones","breadcrumbs":["Docs","Plataforma","Operar Lamassu"],"tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/alerts"},"533":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-0","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts","content":"Envía eventos de la PKI a personas y sistemas externos."},"534":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-1","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#cómo-funciona","content":"Cómo funciona"},"535":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-2","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#canales-disponibles","content":"Canales disponibles"},"536":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-3","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#crea-una-suscripción","content":"Crea una suscripción"},"537":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-4","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#elige-el-evento","content":"Elige el evento"},"538":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-5","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#configura-el-destino","content":"Configura el destino"},"539":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-6","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#limita-las-notificaciones","content":"Limita las notificaciones"},"540":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-7","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#revisa-y-activa","content":"Revisa y activa"},"541":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-8","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#gestiona-una-suscripción","content":"Gestiona una suscripción"},"542":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-9","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#familias-de-eventos","content":"Familias de eventos"},"543":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-10","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts","content":"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo."},"544":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-11","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#cómo-funciona","content":"Un servicio publica un evento de dominio."},"545":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-12","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#cómo-funciona","content":"Lamassu evalúa las suscripciones asociadas a ese tipo de evento."},"546":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-13","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#cómo-funciona","content":"El filtro de cada suscripción decide si debe notificarse."},"547":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-14","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#cómo-funciona","content":"Lamassu entrega el evento al canal configurado."},"548":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-15","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#cómo-funciona","content":"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro."},"549":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-16","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#canales-disponibles","content":"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino."},"550":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-17","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#canales-disponibles","content":"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook."},"551":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-18","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#canales-disponibles","content":"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`."},"552":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-19","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#elige-el-evento","content":"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar."},"553":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-20","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#configura-el-destino","content":"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal."},"554":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-21","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#limita-las-notificaciones","content":"Añade un filtro si no quieres recibir todas las instancias del evento."},"555":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-22","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#limita-las-notificaciones","content":"**None** notifica todas las instancias del evento."},"556":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-23","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#limita-las-notificaciones","content":"**JSON Path** evalúa uno o varios campos concretos."},"557":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-24","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#limita-las-notificaciones","content":"**JSON Schema** acepta únicamente payloads con una estructura determinada."},"558":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-25","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#limita-las-notificaciones","content":"**JavaScript** permite expresar lógica personalizada."},"559":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-26","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/alerts#limita-las-notificaciones","content":"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad."},"560":{"id":"/docs/pr-preview/pr-28/es/platform/pki/alerts-27","page_id":"/docs/pr-preview/pr-28/es/platform/pki/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-28/es/platform/pki/