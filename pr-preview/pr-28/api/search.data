":93566},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2802":56358,"_24435":56353,"_5":24767,"_17116":93568,"_23186":93569,"_2329":93570},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2802":56359,"_24435":56353,"_5":24767,"_17116":93572,"_23186":93573,"_2329":93574},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2802":56360,"_24435":56353,"_5":24767,"_17116":93576,"_23186":93577,"_2329":93578},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2802":56361,"_24435":56353,"_5":24767,"_17116":93580,"_23186":93581,"_2329":93582},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2802":56362,"_24435":56353,"_17116":93584,"_5":17011,"_23186":56353,"_2329":93585},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2802":56363,"_24435":56353,"_17116":93587,"_5":17011,"_23186":93557,"_2329":93588},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2802":56364,"_24435":56353,"_17116":93590,"_5":17011,"_23186":93557,"_2329":93591},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2802":56365,"_24435":56353,"_17116":93593,"_5":17011,"_23186":93557,"_2329":93594},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2802":56366,"_24435":56353,"_17116":93596,"_5":17011,"_23186":93561,"_2329":93597},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2802":56367,"_24435":56353,"_17116":93599,"_5":17011,"_23186":93561,"_2329":93600},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2802":56368,"_24435":56353,"_17116":93602,"_5":17011,"_23186":93561,"_2329":93603},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2802":56369,"_24435":56353,"_17116":93605,"_5":17011,"_23186":93565,"_2329":93606},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2802":56370,"_24435":56353,"_17116":93608,"_5":17011,"_23186":93569,"_2329":93609},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2802":56371,"_24435":56353,"_17116":93611,"_5":17011,"_23186":93573,"_2329":93612},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2802":56372,"_24435":56353,"_17116":93614,"_5":17011,"_23186":93577,"_2329":93615},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2802":56373,"_24435":56353,"_17116":93617,"_5":17011,"_23186":93581,"_2329":93618},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2802":56374,"_24435":56374,"_5":12038,"_2329":93620,"_24770":93621,"_17116":93622,"_23186":56374},"Despliega Lamassu",[39813,93549],[],{"_2802":56375,"_24435":56374,"_17116":93624,"_5":17011,"_23186":56374,"_2329":93625},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2802":56376,"_24435":56374,"_5":24767,"_17116":93627,"_23186":93628,"_2329":93629},[],"/docs/pr-preview/pr-28/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2802":56377,"_24435":56374,"_5":24767,"_17116":93631,"_23186":93632,"_2329":93633},[],"/docs/pr-preview/pr-28/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2802":56378,"_24435":56374,"_5":24767,"_17116":93635,"_23186":93636,"_2329":93637},[],"/docs/pr-preview/pr-28/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2802":56379,"_24435":56374,"_17116":93639,"_5":17011,"_23186":56374,"_2329":93640},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2802":56380,"_24435":56374,"_17116":93642,"_5":17011,"_23186":93628,"_2329":93643},[],"Modelo",{"_2802":56381,"_24435":56374,"_17116":93645,"_5":17011,"_23186":93628,"_2329":93646},[],"Recomendado para",{"_2802":56382,"_24435":56374,"_17116":93648,"_5":17011,"_23186":93628,"_2329":93649},[],"Quién opera la infraestructura",{"_2802":56383,"_24435":56374,"_17116":93651,"_5":17011,"_23186":93628,"_2329":93652},[],"Punto de partida",{"_2802":56384,"_24435":56374,"_17116":93654,"_5":17011,"_23186":93628,"_2329":39920},[],{"_2802":56385,"_24435":56374,"_17116":93656,"_5":17011,"_23186":93628,"_2329":93657},[],"Producción, entornos regulados y despliegues personalizados",{"_2802":56386,"_24435":56374,"_17116":93659,"_5":17011,"_23186":93628,"_2329":93660},[],"Tu equipo",{"_2802":56387,"_24435":56374,"_17116":93662,"_5":17011,"_23186":93628,"_2329":93663},[],"Helm o Fastlane",{"_2802":56388,"_24435":56374,"_17116":93665,"_5":17011,"_23186":93628,"_2329":39932},[],{"_2802":56389,"_24435":56374,"_17116":93667,"_5":17011,"_23186":93628,"_2329":93668},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2802":56390,"_24435":56374,"_17116":93670,"_5":17011,"_23186":93628,"_2329":93660},[],{"_2802":56391,"_24435":56374,"_17116":93672,"_5":17011,"_23186":93628,"_2329":93673},[],"Imagen preconfigurada en EC2",{"_2802":56392,"_24435":56374,"_17116":93675,"_5":17011,"_23186":93628,"_2329":39943},[],{"_2802":56393,"_24435":56374,"_17116":93677,"_5":17011,"_23186":93628,"_2329":93678},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2802":56394,"_24435":56374,"_17116":93680,"_5":17011,"_23186":93628,"_2329":39949},[],{"_2802":56395,"_24435":56374,"_17116":93682,"_5":17011,"_23186":93628,"_2329":93683},[],"Suscripción gestionada",{"_2802":56396,"_24435":56374,"_17116":93685,"_5":17011,"_23186":93628,"_2329":93686},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2802":56397,"_24435":56374,"_17116":93688,"_5":17011,"_23186":93628,"_2329":93689},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2802":56398,"_24435":56374,"_17116":93691,"_5":17011,"_23186":93628,"_2329":93692},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2802":56399,"_24435":56374,"_17116":93694,"_5":17011,"_23186":93632,"_2329":93695},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2802":56400,"_24435":56374,"_17116":93697,"_5":17011,"_23186":93636,"_2329":93698},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2802":56401,"_24435":56401,"_5":12038,"_2329":93700,"_24770":93701,"_17116":93702,"_23186":56401},"Utiliza Lamassu como SaaS",[39813,93549,93550],[],{"_2802":56402,"_24435":56401,"_17116":93704,"_5":17011,"_23186":56401,"_2329":93705},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2802":56403,"_24435":56401,"_5":24767,"_17116":93707,"_23186":93708,"_2329":93709},[],"/docs/pr-preview/pr-28/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2802":56404,"_24435":56401,"_5":24767,"_17116":93711,"_23186":93712,"_2329":93713},[],"/docs/pr-preview/pr-28/es/deployment/saas#planes","Planes",{"_2802":56405,"_24435":56401,"_5":24767,"_17116":93715,"_23186":93716,"_2329":93717},[],"/docs/pr-preview/pr-28/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2802":56406,"_24435":56401,"_17116":93719,"_5":17011,"_23186":56401,"_2329":93720},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2802":56407,"_24435":56401,"_17116":93722,"_5":17011,"_23186":93708,"_2329":93723},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2802":56408,"_24435":56401,"_17116":93725,"_5":17011,"_23186":93708,"_2329":93726},[],"Copias de seguridad automáticas.",{"_2802":56409,"_24435":56401,"_17116":93728,"_5":17011,"_23186":93708,"_2329":93729},[],"Actualizaciones de versión.",{"_2802":56410,"_24435":56401,"_17116":93731,"_5":17011,"_23186":93708,"_2329":93732},[],"Soporte técnico y SLA según el plan contratado.",{"_2802":56411,"_24435":56401,"_17116":93734,"_5":17011,"_23186":93712,"_2329":40004},[],{"_2802":56412,"_24435":56401,"_17116":93736,"_5":17011,"_23186":93712,"_2329":93737},[],"Dispositivos",{"_2802":56413,"_24435":56401,"_17116":93739,"_5":17011,"_23186":93712,"_2329":93740},[],"Soporte",{"_2802":56414,"_24435":56401,"_17116":93742,"_5":17011,"_23186":93712,"_2329":40013},[],{"_2802":56415,"_24435":56401,"_17116":93744,"_5":17011,"_23186":93712,"_2329":40016},[],{"_2802":56416,"_24435":56401,"_17116":93746,"_5":17011,"_23186":93712,"_2329":93747},[],"Hasta 1.000",{"_2802":56417,"_24435":56401,"_17116":93749,"_5":17011,"_23186":93712,"_2329":40022},[],{"_2802":56418,"_24435":56401,"_17116":93751,"_5":17011,"_23186":93712,"_2329":93752},[],"99,5 %",{"_2802":56419,"_24435":56401,"_17116":93754,"_5":17011,"_23186":93712,"_2329":40028},[],{"_2802":56420,"_24435":56401,"_17116":93756,"_5":17011,"_23186":93712,"_2329":93757},[],"Hasta 10.000",{"_2802":56421,"_24435":56401,"_17116":93759,"_5":17011,"_23186":93712,"_2329":93760},[],"Email y chat",{"_2802":56422,"_24435":56401,"_17116":93762,"_5":17011,"_23186":93712,"_2329":93763},[],"99,9 %",{"_2802":56423,"_24435":56401,"_17116":93765,"_5":17011,"_23186":93712,"_2329":40040},[],{"_2802":56424,"_24435":56401,"_17116":93767,"_5":17011,"_23186":93712,"_2329":93768},[],"Ilimitados",{"_2802":56425,"_24435":56401,"_17116":93770,"_5":17011,"_23186":93712,"_2329":93771},[],"Dedicado",{"_2802":56426,"_24435":56401,"_17116":93773,"_5":17011,"_23186":93712,"_2329":93774},[],"99,99 %",{"_2802":56427,"_24435":56401,"_17116":93776,"_5":17011,"_23186":93716,"_2329":93777},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2802":56428,"_24435":56401,"_17116":93779,"_5":17011,"_23186":93716,"_2329":93780},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2802":56429,"_24435":56429,"_5":12038,"_2329":40057,"_24770":93782,"_17116":93784,"_23186":56429},[39813,93549,93783],"Kubernetes autogestionado",[],{"_2802":56430,"_24435":56429,"_17116":93786,"_5":17011,"_23186":56429,"_2329":93787},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2802":56431,"_24435":56429,"_5":24767,"_17116":93789,"_23186":93790,"_2329":93791},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2802":56432,"_24435":56429,"_5":24767,"_17116":93793,"_23186":93794,"_2329":93795},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2802":56433,"_24435":56429,"_5":24767,"_17116":93797,"_23186":93798,"_2329":93799},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2802":56434,"_24435":56429,"_5":24767,"_17116":93801,"_23186":93802,"_2329":93803},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2802":56435,"_24435":56429,"_5":24767,"_17116":93805,"_23186":93806,"_2329":93807},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2802":56436,"_24435":56429,"_5":24767,"_17116":93809,"_23186":93810,"_2329":93811},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2802":56437,"_24435":56429,"_5":24767,"_17116":93813,"_23186":93814,"_2329":93815},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2802":56438,"_24435":56429,"_5":24767,"_17116":93817,"_23186":93818,"_2329":93819},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2802":56439,"_24435":56429,"_5":24767,"_17116":93821,"_23186":93822,"_2329":93823},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2802":56440,"_24435":56429,"_5":24767,"_17116":93825,"_23186":93826,"_2329":93827},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2802":56441,"_24435":56429,"_17116":93829,"_5":17011,"_23186":93790,"_2329":93830},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2802":56442,"_24435":56429,"_17116":93832,"_5":17011,"_23186":93790,"_2329":93833},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2802":56443,"_24435":56429,"_17116":93835,"_5":17011,"_23186":93794,"_2329":93836},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2802":56444,"_24435":56429,"_17116":93838,"_5":17011,"_23186":93794,"_2329":93839},[],"Fastlane instala o configura",{"_2802":56445,"_24435":56429,"_17116":93841,"_5":17011,"_23186":93794,"_2329":93842},[],"Tú sigues proporcionando",{"_2802":56446,"_24435":56429,"_17116":93844,"_5":17011,"_23186":93794,"_2329":93845},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2802":56447,"_24435":56429,"_17116":93847,"_5":17011,"_23186":93794,"_2329":93848},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2802":56448,"_24435":56429,"_17116":93850,"_5":17011,"_23186":93794,"_2329":93851},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2802":56449,"_24435":56429,"_17116":93853,"_5":17011,"_23186":93794,"_2329":93854},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2802":56450,"_24435":56429,"_17116":93856,"_5":17011,"_23186":93794,"_2329":93857},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2802":56451,"_24435":56429,"_17116":93859,"_5":17011,"_23186":93794,"_2329":93860},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2802":56452,"_24435":56429,"_17116":93862,"_5":17011,"_23186":93794,"_2329":93863},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2802":56453,"_24435":56429,"_17116":93865,"_5":17011,"_23186":93794,"_2329":93866},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2802":56454,"_24435":56429,"_17116":93868,"_5":17011,"_23186":93794,"_2329":93869},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2802":56455,"_24435":56429,"_17116":93871,"_5":17011,"_23186":93798,"_2329":93872},[],"Necesitas:",{"_2802":56456,"_24435":56429,"_17116":93874,"_5":17011,"_23186":93798,"_2329":93875},[],"un clúster Kubernetes existente",{"_2802":56457,"_24435":56429,"_17116":93877,"_5":17011,"_23186":93798,"_2329":93878},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2802":56458,"_24435":56429,"_17116":93880,"_5":17011,"_23186":93798,"_2329":40155},[],{"_2802":56459,"_24435":56429,"_17116":93882,"_5":17011,"_23186":93798,"_2329":19375},[],{"_2802":56460,"_24435":56429,"_17116":93884,"_5":17011,"_23186":93798,"_2329":93885},[],"`jq` solo si usas `--sample-data`",{"_2802":56461,"_24435":56429,"_17116":93887,"_5":17011,"_23186":93798,"_2329":93888},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2802":56462,"_24435":56429,"_17116":93890,"_5":17011,"_23186":93798,"_2329":93891},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2802":56463,"_24435":56429,"_17116":93893,"_5":17011,"_23186":93798,"_2329":93894},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2802":56464,"_24435":56429,"_17116":93896,"_5":17011,"_23186":93802,"_2329":93897},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2802":56465,"_24435":56429,"_17116":93899,"_5":17011,"_23186":93802,"_2329":93900},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2802":56466,"_24435":56429,"_17116":93902,"_5":17011,"_23186":93806,"_2329":93903},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2802":56467,"_24435":56429,"_17116":93905,"_5":17011,"_23186":93806,"_2329":93906},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2802":56468,"_24435":56429,"_17116":93908,"_5":17011,"_23186":93806,"_2329":93909},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2802":56469,"_24435":56429,"_17116":93911,"_5":17011,"_23186":93806,"_2329":93912},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2802":56470,"_24435":56429,"_17116":93914,"_5":17011,"_23186":93810,"_2329":93915},[],"Opción",{"_2802":56471,"_24435":56429,"_17116":93917,"_5":17011,"_23186":93810,"_2329":93918},[],"Valor predeterminado",{"_2802":56472,"_24435":56429,"_17116":93920,"_5":17011,"_23186":93810,"_2329":93921},[],"Propósito",{"_2802":56473,"_24435":56429,"_17116":93923,"_5":17011,"_23186":93810,"_2329":40199},[],{"_2802":56474,"_24435":56429,"_17116":93925,"_5":17011,"_23186":93810,"_2329":40202},[],{"_2802":56475,"_24435":56429,"_17116":93927,"_5":17011,"_23186":93810,"_2329":93928},[],"Muestra la ayuda",{"_2802":56476,"_24435":56429,"_17116":93930,"_5":17011,"_23186":93810,"_2329":40208},[],{"_2802":56477,"_24435":56429,"_17116":93932,"_5":17011,"_23186":93810,"_2329":93933},[],"contexto actual",{"_2802":56478,"_24435":56429,"_17116":93935,"_5":17011,"_23186":93810,"_2329":93936},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2802":56479,"_24435":56429,"_17116":93938,"_5":17011,"_23186":93810,"_2329":40217},[],{"_2802":56480,"_24435":56429,"_17116":93940,"_5":17011,"_23186":93810,"_2329":5235},[],{"_2802":56481,"_24435":56429,"_17116":93942,"_5":17011,"_23186":93810,"_2329":93943},[],"Omite prompts y genera credenciales para las dependencias",{"_2802":56482,"_24435":56429,"_17116":93945,"_5":17011,"_23186":93810,"_2329":40225},[],{"_2802":56483,"_24435":56429,"_17116":93947,"_5":17011,"_23186":93810,"_2329":40228},[],{"_2802":56484,"_24435":56429,"_17116":93949,"_5":17011,"_23186":93810,"_2329":93950},[],"Namespace de la instalación",{"_2802":56485,"_24435":56429,"_17116":93952,"_5":17011,"_23186":93810,"_2329":40234},[],{"_2802":56486,"_24435":56429,"_17116":93954,"_5":17011,"_23186":93810,"_2329":40237},[],{"_2802":56487,"_24435":56429,"_17116":93956,"_5":17011,"_23186":93810,"_2329":93957},[],"Dominio usado por la UI, OIDC y el certificado",{"_2802":56488,"_24435":56429,"_17116":93959,"_5":17011,"_23186":93810,"_2329":40243},[],{"_2802":56489,"_24435":56429,"_17116":93961,"_5":17011,"_23186":93810,"_2329":12258},[],{"_2802":56490,"_24435":56429,"_17116":93963,"_5":17011,"_23186":93810,"_2329":93964},[],"Versión del chart de Lamassu",{"_2802":56491,"_24435":56429,"_17116":93966,"_5":17011,"_23186":93810,"_2329":40251},[],{"_2802":56492,"_24435":56429,"_17116":93968,"_5":17011,"_23186":93810,"_2329":40254},[],{"_2802":56493,"_24435":56429,"_17116":93970,"_5":17011,"_23186":93810,"_2329":93971},[],"Puerto del listener HTTPS",{"_2802":56494,"_24435":56429,"_17116":93973,"_5":17011,"_23186":93810,"_2329":40260},[],{"_2802":56495,"_24435":56429,"_17116":93975,"_5":17011,"_23186":93810,"_2329":40263},[],{"_2802":56496,"_24435":56429,"_17116":93977,"_5":17011,"_23186":93810,"_2329":93978},[],"Puerto del listener HTTP",{"_2802":56497,"_24435":56429,"_17116":93980,"_5":17011,"_23186":93810,"_2329":40269},[],{"_2802":56498,"_24435":56429,"_17116":93982,"_5":17011,"_23186":93810,"_2329":40202},[],{"_2802":56499,"_24435":56429,"_17116":93984,"_5":17011,"_23186":93810,"_2329":93985},[],"Certificado PEM para TLS downstream",{"_2802":56500,"_24435":56429,"_17116":93987,"_5":17011,"_23186":93810,"_2329":40277},[],{"_2802":56501,"_24435":56429,"_17116":93989,"_5":17011,"_23186":93810,"_2329":40202},[],{"_2802":56502,"_24435":56429,"_17116":93991,"_5":17011,"_23186":93810,"_2329":93992},[],"Clave privada PEM para TLS downstream",{"_2802":56503,"_24435":56429,"_17116":93994,"_5":17011,"_23186":93810,"_2329":40285},[],{"_2802":56504,"_24435":56429,"_17116":93996,"_5":17011,"_23186":93810,"_2329":93997},[],"chart del repositorio",{"_2802":56505,"_24435":56429,"_17116":93999,"_5":17011,"_23186":93810,"_2329":94000},[],"Usa un chart local de Lamassu sin empaquetar",{"_2802":56506,"_24435":56429,"_17116":94002,"_5":17011,"_23186":93810,"_2329":40294},[],{"_2802":56507,"_24435":56429,"_17116":94004,"_5":17011,"_23186":93810,"_2329":94005},[],"detección automática",{"_2802":56508,"_24435":56429,"_17116":94007,"_5":17011,"_23186":93810,"_2329":94008},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2802":56509,"_24435":56429,"_17116":94010,"_5":17011,"_23186":93810,"_2329":40302},[],{"_2802":56510,"_24435":56429,"_17116":94012,"_5":17011,"_23186":93810,"_2329":5235},[],{"_2802":56511,"_24435":56429,"_17116":94014,"_5":17011,"_23186":93810,"_2329":94015},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2802":56512,"_24435":56429,"_17116":94017,"_5":17011,"_23186":93810,"_2329":40310},[],{"_2802":56513,"_24435":56429,"_17116":94019,"_5":17011,"_23186":93810,"_2329":5235},[],{"_2802":56514,"_24435":56429,"_17116":94021,"_5":17011,"_23186":93810,"_2329":94022},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2802":56515,"_24435":56429,"_17116":94024,"_5":17011,"_23186":93810,"_2329":40318},[],{"_2802":56516,"_24435":56429,"_17116":94026,"_5":17011,"_23186":93810,"_2329":5235},[],{"_2802":56517,"_24435":56429,"_17116":94028,"_5":17011,"_23186":93810,"_2329":94029},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2802":56518,"_24435":56429,"_17116":94031,"_5":17011,"_23186":93810,"_2329":40326},[],{"_2802":56519,"_24435":56429,"_17116":94033,"_5":17011,"_23186":93810,"_2329":40329},[],{"_2802":56520,"_24435":56429,"_17116":94035,"_5":17011,"_23186":93810,"_2329":94036},[],"Usa otro chart local de SoftHSM",{"_2802":56521,"_24435":56429,"_17116":94038,"_5":17011,"_23186":93810,"_2329":94039},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2802":56522,"_24435":56429,"_17116":94041,"_5":17011,"_23186":93814,"_2329":40338},[],{"_2802":56523,"_24435":56429,"_17116":94043,"_5":17011,"_23186":93814,"_2329":94044},[],"valida las herramientas locales y el clúster seleccionado",{"_2802":56524,"_24435":56429,"_17116":94046,"_5":17011,"_23186":93814,"_2329":94047},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2802":56525,"_24435":56429,"_17116":94049,"_5":17011,"_23186":93814,"_2329":94050},[],"crea el namespace",{"_2802":56526,"_24435":56429,"_17116":94052,"_5":17011,"_23186":93814,"_2329":94053},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2802":56527,"_24435":56429,"_17116":94055,"_5":17011,"_23186":93814,"_2329":94056},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2802":56528,"_24435":56429,"_17116":94058,"_5":17011,"_23186":93814,"_2329":94059},[],"instala RabbitMQ",{"_2802":56529,"_24435":56429,"_17116":94061,"_5":17011,"_23186":93814,"_2329":94062},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2802":56530,"_24435":56429,"_17116":94064,"_5":17011,"_23186":93814,"_2329":94065},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2802":56531,"_24435":56429,"_17116":94067,"_5":17011,"_23186":93814,"_2329":94068},[],"carga datos de ejemplo opcionalmente",{"_2802":56532,"_24435":56429,"_17116":94070,"_5":17011,"_23186":93814,"_2329":94071},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2802":56533,"_24435":56429,"_17116":94073,"_5":17011,"_23186":93818,"_2329":94074},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2802":56534,"_24435":56429,"_17116":94076,"_5":17011,"_23186":93818,"_2329":94077},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2802":56535,"_24435":56429,"_17116":94079,"_5":17011,"_23186":93822,"_2329":94080},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2802":56536,"_24435":56429,"_17116":94082,"_5":17011,"_23186":93822,"_2329":94083},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2802":56537,"_24435":56429,"_17116":94085,"_5":17011,"_23186":93822,"_2329":94086},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2802":56538,"_24435":56429,"_17116":94088,"_5":17011,"_23186":93826,"_2329":94089},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2802":56539,"_24435":56539,"_5":12038,"_2329":94091,"_24770":94092,"_17116":94093,"_23186":56539},"Instala con Helm",[39813,93549,93783],[],{"_2802":56540,"_24435":56539,"_17116":94095,"_5":17011,"_23186":56539,"_2329":94096},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2802":56541,"_24435":56539,"_5":24767,"_17116":94098,"_23186":94099,"_2329":94100},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2802":56542,"_24435":56539,"_5":24767,"_17116":94102,"_23186":94103,"_2329":93799},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2802":56543,"_24435":56539,"_5":24767,"_17116":94105,"_23186":94106,"_2329":94107},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2802":56544,"_24435":56539,"_5":24767,"_17116":94109,"_23186":94110,"_2329":94111},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2802":56545,"_24435":56539,"_5":24767,"_17116":94113,"_23186":94114,"_2329":94115},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2802":56546,"_24435":56539,"_5":24767,"_17116":94117,"_23186":94118,"_2329":94119},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2802":56547,"_24435":56539,"_5":24767,"_17116":94121,"_23186":94122,"_2329":94123},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2802":56548,"_24435":56539,"_5":24767,"_17116":94125,"_23186":94126,"_2329":94127},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2802":56549,"_24435":56539,"_5":24767,"_17116":94129,"_23186":94130,"_2329":94131},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2802":56550,"_24435":56539,"_17116":94133,"_5":17011,"_23186":94099,"_2329":94134},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2802":56551,"_24435":56539,"_17116":94136,"_5":17011,"_23186":94103,"_2329":94137},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2802":56552,"_24435":56539,"_17116":94139,"_5":17011,"_23186":94103,"_2329":94140},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2802":56553,"_24435":56539,"_17116":94142,"_5":17011,"_23186":94103,"_2329":94143},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2802":56554,"_24435":56539,"_17116":94145,"_5":17011,"_23186":94103,"_2329":94146},[],"un broker RabbitMQ accesible y sus credenciales",{"_2802":56555,"_24435":56539,"_17116":94148,"_5":17011,"_23186":94103,"_2329":94149},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2802":56556,"_24435":56539,"_17116":94151,"_5":17011,"_23186":94103,"_2329":94152},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2802":56557,"_24435":56539,"_17116":94154,"_5":17011,"_23186":94103,"_2329":94155},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2802":56558,"_24435":56539,"_17116":94157,"_5":17011,"_23186":94103,"_2329":94158},[],"una StorageClass y un diseño de tráfico externo",{"_2802":56559,"_24435":56539,"_17116":94160,"_5":17011,"_23186":94103,"_2329":94161},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2802":56560,"_24435":56539,"_17116":94163,"_5":17011,"_23186":94103,"_2329":94164},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2802":56561,"_24435":56539,"_17116":94166,"_5":17011,"_23186":94103,"_2329":94167},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2802":56562,"_24435":56539,"_17116":94169,"_5":17011,"_23186":94106,"_2329":94170},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2802":56563,"_24435":56539,"_17116":94172,"_5":17011,"_23186":94106,"_2329":94173},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2802":56564,"_24435":56539,"_17116":94175,"_5":17011,"_23186":94106,"_2329":94176},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2802":56565,"_24435":56539,"_17116":94178,"_5":17011,"_23186":94110,"_2329":94179},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2802":56566,"_24435":56539,"_17116":94181,"_5":17011,"_23186":94110,"_2329":94182},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2802":56567,"_24435":56539,"_17116":94184,"_5":17011,"_23186":94110,"_2329":94185},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2802":56568,"_24435":56539,"_17116":94187,"_5":17011,"_23186":94114,"_2329":94188},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2802":56569,"_24435":56539,"_17116":94190,"_5":17011,"_23186":94118,"_2329":94191},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2802":56570,"_24435":56539,"_17116":94193,"_5":17011,"_23186":94118,"_2329":94194},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2802":56571,"_24435":56539,"_17116":94196,"_5":17011,"_23186":94118,"_2329":94197},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2802":56572,"_24435":56539,"_17116":94199,"_5":17011,"_23186":94118,"_2329":94200},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2802":56573,"_24435":56539,"_17116":94202,"_5":17011,"_23186":94122,"_2329":94203},[],"Para instalar un checkout local:",{"_2802":56574,"_24435":56539,"_17116":94205,"_5":17011,"_23186":94126,"_2329":94206},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2802":56575,"_24435":56539,"_17116":94208,"_5":17011,"_23186":94126,"_2329":94209},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2802":56576,"_24435":56539,"_17116":94211,"_5":17011,"_23186":94130,"_2329":94212},[],"Antes de pasar a producción, revisa:",{"_2802":56577,"_24435":56539,"_17116":94214,"_5":17011,"_23186":94130,"_2329":94215},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2802":56578,"_24435":56539,"_17116":94217,"_5":17011,"_23186":94130,"_2329":94218},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2802":56579,"_24435":56539,"_17116":94220,"_5":17011,"_23186":94130,"_2329":94221},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2802":56580,"_24435":56539,"_17116":94223,"_5":17011,"_23186":94130,"_2329":94224},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2802":56581,"_24435":56539,"_17116":94226,"_5":17011,"_23186":94130,"_2329":94227},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2802":56582,"_24435":56539,"_17116":94229,"_5":17011,"_23186":94130,"_2329":94230},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2802":56583,"_24435":56539,"_17116":94232,"_5":17011,"_23186":94130,"_2329":94233},[],"SMTP, observabilidad y entrega de alertas",{"_2802":56584,"_24435":56539,"_17116":94235,"_5":17011,"_23186":94130,"_2329":94236},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2802":56585,"_24435":56539,"_17116":94238,"_5":17011,"_23186":94130,"_2329":94239},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2802":56586,"_24435":56586,"_5":12038,"_2329":94241,"_24770":94242,"_17116":94243,"_23186":56586},"Expón el Gateway",[39813,93549,93783],[],{"_2802":56587,"_24435":56586,"_17116":94245,"_5":17011,"_23186":56586,"_2329":94246},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2802":56588,"_24435":56586,"_5":24767,"_17116":94248,"_23186":94249,"_2329":94250},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2802":56589,"_24435":56586,"_5":24767,"_17116":94252,"_23186":94253,"_2329":94254},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2802":56590,"_24435":56586,"_5":24767,"_17116":94256,"_23186":94257,"_2329":94258},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2802":56591,"_24435":56586,"_5":24767,"_17116":94260,"_23186":94261,"_2329":40559},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#k3s",{"_2802":56592,"_24435":56586,"_5":24767,"_17116":94263,"_23186":94264,"_2329":94265},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2802":56593,"_24435":56586,"_5":24767,"_17116":94267,"_23186":94268,"_2329":94269},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2802":56594,"_24435":56586,"_5":24767,"_17116":94271,"_23186":94272,"_2329":94273},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2802":56595,"_24435":56586,"_5":24767,"_17116":94275,"_23186":94276,"_2329":94277},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2802":56596,"_24435":56586,"_5":24767,"_17116":94279,"_23186":94280,"_2329":94281},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2802":56597,"_24435":56586,"_17116":94283,"_5":17011,"_23186":94249,"_2329":94284},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2802":56598,"_24435":56586,"_17116":94286,"_5":17011,"_23186":94249,"_2329":94287},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2802":56599,"_24435":56586,"_17116":94289,"_5":17011,"_23186":94253,"_2329":94290},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2802":56600,"_24435":56586,"_17116":94292,"_5":17011,"_23186":94253,"_2329":94293},[],"Defínelo únicamente cuando:",{"_2802":56601,"_24435":56586,"_17116":94295,"_5":17011,"_23186":94253,"_2329":94296},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2802":56602,"_24435":56586,"_17116":94298,"_5":17011,"_23186":94253,"_2329":94299},[],"esa dirección está asignada a este Gateway",{"_2802":56603,"_24435":56586,"_17116":94301,"_5":17011,"_23186":94253,"_2329":94302},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2802":56604,"_24435":56586,"_17116":94304,"_5":17011,"_23186":94253,"_2329":94305},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2802":56605,"_24435":56586,"_17116":94307,"_5":17011,"_23186":94253,"_2329":94308},[],"No confundas estos valores:",{"_2802":56606,"_24435":56586,"_17116":94310,"_5":17011,"_23186":94253,"_2329":94311},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2802":56607,"_24435":56586,"_17116":94313,"_5":17011,"_23186":94253,"_2329":94314},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2802":56608,"_24435":56586,"_17116":94316,"_5":17011,"_23186":94253,"_2329":94317},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2802":56609,"_24435":56586,"_17116":94319,"_5":17011,"_23186":94257,"_2329":94320},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2802":56610,"_24435":56586,"_17116":94322,"_5":17011,"_23186":94257,"_2329":94323},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2802":56611,"_24435":56586,"_17116":94325,"_5":17011,"_23186":94261,"_2329":94326},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2802":56612,"_24435":56586,"_17116":94328,"_5":17011,"_23186":94261,"_2329":94329},[],"Para el diseño recomendado:",{"_2802":56613,"_24435":56586,"_17116":94331,"_5":17011,"_23186":94261,"_2329":94332},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2802":56614,"_24435":56586,"_17116":94334,"_5":17011,"_23186":94261,"_2329":94335},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2802":56615,"_24435":56586,"_17116":94337,"_5":17011,"_23186":94261,"_2329":94338},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2802":56616,"_24435":56586,"_17116":94340,"_5":17011,"_23186":94261,"_2329":94341},[],"Apunta DNS a la dirección accesible de la VM.",{"_2802":56617,"_24435":56586,"_17116":94343,"_5":17011,"_23186":94261,"_2329":94344},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2802":56618,"_24435":56586,"_17116":94346,"_5":17011,"_23186":94264,"_2329":94347},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2802":56619,"_24435":56586,"_17116":94349,"_5":17011,"_23186":94268,"_2329":94350},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2802":56620,"_24435":56586,"_17116":94352,"_5":17011,"_23186":94268,"_2329":94353},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2802":56621,"_24435":56586,"_17116":94355,"_5":17011,"_23186":94272,"_2329":94356},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2802":56622,"_24435":56586,"_17116":94358,"_5":17011,"_23186":94272,"_2329":94359},[],"Requisito",{"_2802":56623,"_24435":56586,"_17116":94361,"_5":17011,"_23186":94272,"_2329":94362},[],"Diseño recomendado",{"_2802":56624,"_24435":56586,"_17116":94364,"_5":17011,"_23186":94272,"_2329":94365},[],"Consecuencia",{"_2802":56625,"_24435":56586,"_17116":94367,"_5":17011,"_23186":94272,"_2329":94368},[],"Varias URL o servicios de Lamassu",{"_2802":56626,"_24435":56586,"_17116":94370,"_5":17011,"_23186":94272,"_2329":94371},[],"Un Gateway con varias rutas",{"_2802":56627,"_24435":56586,"_17116":94373,"_5":17011,"_23186":94272,"_2329":94374},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2802":56628,"_24435":56586,"_17116":94376,"_5":17011,"_23186":94272,"_2329":94377},[],"Gateways independientes e IP externas distintas",{"_2802":56629,"_24435":56586,"_17116":94379,"_5":17011,"_23186":94272,"_2329":94380},[],"Una VIP por Gateway",{"_2802":56630,"_24435":56586,"_17116":94382,"_5":17011,"_23186":94272,"_2329":94383},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2802":56631,"_24435":56586,"_17116":94385,"_5":17011,"_23186":94272,"_2329":94386},[],"Gateways independientes, un nodo y una IP",{"_2802":56632,"_24435":56586,"_17116":94388,"_5":17011,"_23186":94272,"_2329":94389},[],"Puertos externos diferentes",{"_2802":56633,"_24435":56586,"_17116":94391,"_5":17011,"_23186":94272,"_2329":94392},[],"Los clientes deben indicar puertos no estándar",{"_2802":56634,"_24435":56586,"_17116":94394,"_5":17011,"_23186":94272,"_2329":94395},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2802":56635,"_24435":56586,"_17116":94397,"_5":17011,"_23186":94272,"_2329":94398},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2802":56636,"_24435":56586,"_17116":94400,"_5":17011,"_23186":94272,"_2329":94401},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2802":56637,"_24435":56586,"_17116":94403,"_5":17011,"_23186":94272,"_2329":94404},[],"Recursos Gateway separados pero proxy compartido",{"_2802":56638,"_24435":56586,"_17116":94406,"_5":17011,"_23186":94272,"_2329":94407},[],"Modo merged Gateway de Envoy",{"_2802":56639,"_24435":56586,"_17116":94409,"_5":17011,"_23186":94272,"_2329":94410},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2802":56640,"_24435":56586,"_17116":94412,"_5":17011,"_23186":94272,"_2329":94413},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2802":56641,"_24435":56586,"_17116":94415,"_5":17011,"_23186":94272,"_2329":94416},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2802":56642,"_24435":56586,"_17116":94418,"_5":17011,"_23186":94272,"_2329":94419},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2802":56643,"_24435":56586,"_17116":94421,"_5":17011,"_23186":94272,"_2329":94422},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2802":56644,"_24435":56586,"_17116":94424,"_5":17011,"_23186":94276,"_2329":94425},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2802":56645,"_24435":56586,"_17116":94427,"_5":17011,"_23186":94276,"_2329":94428},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2802":56646,"_24435":56586,"_17116":94430,"_5":17011,"_23186":94276,"_2329":94431},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2802":56647,"_24435":56586,"_17116":94433,"_5":17011,"_23186":94276,"_2329":94434},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2802":56648,"_24435":56586,"_17116":94436,"_5":17011,"_23186":94276,"_2329":94437},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2802":56649,"_24435":56586,"_17116":94439,"_5":17011,"_23186":94280,"_2329":94440},[],"Comprueba, en orden:",{"_2802":56650,"_24435":56586,"_17116":94442,"_5":17011,"_23186":94280,"_2329":94443},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2802":56651,"_24435":56586,"_17116":94445,"_5":17011,"_23186":94280,"_2329":94446},[],"Su estado contiene la dirección esperada.",{"_2802":56652,"_24435":56586,"_17116":94448,"_5":17011,"_23186":94280,"_2329":94449},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2802":56653,"_24435":56586,"_17116":94451,"_5":17011,"_23186":94280,"_2329":94452},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2802":56654,"_24435":56586,"_17116":94454,"_5":17011,"_23186":94280,"_2329":94455},[],"DNS resuelve al endpoint accesible externamente.",{"_2802":56655,"_24435":56586,"_17116":94457,"_5":17011,"_23186":94280,"_2329":94458},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2802":56656,"_24435":56586,"_17116":94460,"_5":17011,"_23186":94280,"_2329":94461},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2802":56657,"_24435":56657,"_5":12038,"_2329":39920,"_24770":94463,"_17116":94464,"_23186":56657},[39813,93549,93783],[],{"_2802":56658,"_24435":56657,"_17116":94466,"_5":17011,"_23186":56657,"_2329":94467},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2802":56659,"_24435":56657,"_5":24767,"_17116":94469,"_23186":94470,"_2329":94471},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2802":56660,"_24435":56657,"_5":24767,"_17116":94473,"_23186":94474,"_2329":94475},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2802":56661,"_24435":56657,"_5":24767,"_17116":94477,"_23186":94478,"_2329":94479},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2802":56662,"_24435":56657,"_5":24767,"_17116":94481,"_23186":94482,"_2329":94483},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2802":56663,"_24435":56657,"_5":24767,"_17116":94485,"_23186":94486,"_2329":94487},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2802":56664,"_24435":56657,"_5":24767,"_17116":94489,"_23186":94490,"_2329":94491},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2802":56665,"_24435":56657,"_17116":94493,"_5":17011,"_23186":94470,"_2329":94494},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2802":56666,"_24435":56657,"_17116":94496,"_5":17011,"_23186":94474,"_2329":94497},[],"Flujo",{"_2802":56667,"_24435":56657,"_17116":94499,"_5":17011,"_23186":94474,"_2329":94500},[],"Úsalo para",{"_2802":56668,"_24435":56657,"_17116":94502,"_5":17011,"_23186":94474,"_2329":94503},[],"Qué instala",{"_2802":56669,"_24435":56657,"_17116":94505,"_5":17011,"_23186":94474,"_2329":40804},[],{"_2802":56670,"_24435":56657,"_17116":94507,"_5":17011,"_23186":94474,"_2329":94508},[],"Producción y entornos controlados",{"_2802":56671,"_24435":56657,"_17116":94510,"_5":17011,"_23186":94474,"_2329":94511},[],"Servicios de Lamassu y recursos de Gateway API",{"_2802":56672,"_24435":56657,"_17116":94513,"_5":17011,"_23186":94474,"_2329":40057},[],{"_2802":56673,"_24435":56657,"_17116":94515,"_5":17011,"_23186":94474,"_2329":94516},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2802":56674,"_24435":56657,"_17116":94518,"_5":17011,"_23186":94474,"_2329":94519},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2802":56675,"_24435":56657,"_17116":94521,"_5":17011,"_23186":94478,"_2329":94522},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2802":56676,"_24435":56657,"_17116":94524,"_5":17011,"_23186":94478,"_2329":94525},[],"Área",{"_2802":56677,"_24435":56657,"_17116":94527,"_5":17011,"_23186":94478,"_2329":94528},[],"El chart de Lamassu proporciona",{"_2802":56678,"_24435":56657,"_17116":94530,"_5":17011,"_23186":94478,"_2329":94531},[],"Tú proporcionas",{"_2802":56679,"_24435":56657,"_17116":94533,"_5":17011,"_23186":94478,"_2329":94534},[],"Aplicaciones Lamassu",{"_2802":56680,"_24435":56657,"_17116":94536,"_5":17011,"_23186":94478,"_2329":94537},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2802":56681,"_24435":56657,"_17116":94539,"_5":17011,"_23186":94478,"_2329":94540},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2802":56682,"_24435":56657,"_17116":94542,"_5":17011,"_23186":94478,"_2329":94543},[],"Datos PostgreSQL",{"_2802":56683,"_24435":56657,"_17116":94545,"_5":17011,"_23186":94478,"_2329":94546},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2802":56684,"_24435":56657,"_17116":94548,"_5":17011,"_23186":94478,"_2329":94549},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2802":56685,"_24435":56657,"_17116":94551,"_5":17011,"_23186":94478,"_2329":94552},[],"Mensajería",{"_2802":56686,"_24435":56657,"_17116":94554,"_5":17011,"_23186":94478,"_2329":94555},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2802":56687,"_24435":56657,"_17116":94557,"_5":17011,"_23186":94478,"_2329":94558},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2802":56688,"_24435":56657,"_17116":94560,"_5":17011,"_23186":94478,"_2329":94561},[],"Identidad",{"_2802":56689,"_24435":56657,"_17116":94563,"_5":17011,"_23186":94478,"_2329":94564},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2802":56690,"_24435":56657,"_17116":94566,"_5":17011,"_23186":94478,"_2329":94567},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2802":56691,"_24435":56657,"_17116":94569,"_5":17011,"_23186":94478,"_2329":94570},[],"Enrutamiento externo",{"_2802":56692,"_24435":56657,"_17116":94572,"_5":17011,"_23186":94478,"_2329":94573},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2802":56693,"_24435":56657,"_17116":94575,"_5":17011,"_23186":94478,"_2329":94576},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2802":56694,"_24435":56657,"_17116":94578,"_5":17011,"_23186":94478,"_2329":40878},[],{"_2802":56695,"_24435":56657,"_17116":94580,"_5":17011,"_23186":94478,"_2329":94581},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2802":56696,"_24435":56657,"_17116":94583,"_5":17011,"_23186":94478,"_2329":94584},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2802":56697,"_24435":56657,"_17116":94586,"_5":17011,"_23186":94478,"_2329":94587},[],"Datos persistentes de la aplicación",{"_2802":56698,"_24435":56657,"_17116":94589,"_5":17011,"_23186":94478,"_2329":94590},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2802":56699,"_24435":56657,"_17116":94592,"_5":17011,"_23186":94478,"_2329":94593},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2802":56700,"_24435":56657,"_17116":94595,"_5":17011,"_23186":94478,"_2329":94596},[],"Integraciones opcionales",{"_2802":56701,"_24435":56657,"_17116":94598,"_5":17011,"_23186":94478,"_2329":94599},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2802":56702,"_24435":56657,"_17116":94601,"_5":17011,"_23186":94478,"_2329":94602},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2802":56703,"_24435":56657,"_17116":94604,"_5":17011,"_23186":94478,"_2329":94605},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2802":56704,"_24435":56657,"_17116":94607,"_5":17011,"_23186":94478,"_2329":94608},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2802":56705,"_24435":56657,"_17116":94610,"_5":17011,"_23186":94482,"_2329":94611},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2802":56706,"_24435":56657,"_17116":94613,"_5":17011,"_23186":94482,"_2329":94614},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2802":56707,"_24435":56657,"_17116":94616,"_5":17011,"_23186":94486,"_2329":94617},[],"Kubernetes 1.24 o posterior",{"_2802":56708,"_24435":56657,"_17116":94619,"_5":17011,"_23186":94486,"_2329":94620},[],"Helm 3.2 o posterior",{"_2802":56709,"_24435":56657,"_17116":94622,"_5":17011,"_23186":94486,"_2329":94623},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2802":56710,"_24435":56657,"_17116":94625,"_5":17011,"_23186":94486,"_2329":94626},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2802":56711,"_24435":56657,"_17116":94628,"_5":17011,"_23186":94486,"_2329":94629},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2802":56712,"_24435":56657,"_17116":94631,"_5":17011,"_23186":94486,"_2329":94632},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2802":56713,"_24435":56657,"_17116":94634,"_5":17011,"_23186":94486,"_2329":94635},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2802":56714,"_24435":56657,"_17116":94637,"_5":17011,"_23186":94490,"_2329":94638},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2802":56715,"_24435":56657,"_17116":94640,"_5":17011,"_23186":94490,"_2329":94641},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2802":56716,"_24435":56657,"_17116":94643,"_5":17011,"_23186":94490,"_2329":94644},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2802":56717,"_24435":56717,"_5":12038,"_2329":94646,"_24770":94647,"_17116":94649,"_23186":56717},"Resolución de problemas de despliegue",[39813,93549,94648],"Operación",[],{"_2802":56718,"_24435":56717,"_17116":94651,"_5":17011,"_23186":56717,"_2329":94652},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2802":56719,"_24435":56717,"_5":24767,"_17116":94654,"_23186":94655,"_2329":94656},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2802":56720,"_24435":56717,"_5":24767,"_17116":94658,"_23186":94659,"_2329":94660},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2802":56721,"_24435":56717,"_5":24767,"_17116":94662,"_23186":94663,"_2329":94664},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2802":56722,"_24435":56717,"_5":24767,"_17116":94666,"_23186":94667,"_2329":94668},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2802":56723,"_24435":56717,"_5":24767,"_17116":94670,"_23186":94671,"_2329":94672},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2802":56724,"_24435":56717,"_5":24767,"_17116":94674,"_23186":94675,"_2329":94676},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2802":56725,"_24435":56717,"_5":24767,"_17116":94678,"_23186":94679,"_2329":94680},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2802":56726,"_24435":56717,"_5":24767,"_17116":94682,"_23186":94683,"_2329":94684},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2802":56727,"_24435":56717,"_5":24767,"_17116":94686,"_23186":94687,"_2329":94688},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2802":56728,"_24435":56717,"_5":24767,"_17116":94690,"_23186":94691,"_2329":94692},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2802":56729,"_24435":56717,"_5":24767,"_17116":94694,"_23186":94695,"_2329":94696},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2802":56730,"_24435":56717,"_5":24767,"_17116":94698,"_23186":94699,"_2329":94700},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2802":56731,"_24435":56717,"_17116":94702,"_5":17011,"_23186":56717,"_2329":94703},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2802":56732,"_24435":56717,"_17116":94705,"_5":17011,"_23186":94659,"_2329":94706},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2802":56733,"_24435":56717,"_17116":94708,"_5":17011,"_23186":94663,"_2329":94709},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2802":56734,"_24435":56717,"_17116":94711,"_5":17011,"_23186":94667,"_2329":94712},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2802":56735,"_24435":56717,"_17116":94714,"_5":17011,"_23186":94671,"_2329":94715},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2802":56736,"_24435":56717,"_17116":94717,"_5":17011,"_23186":94675,"_2329":94718},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2802":56737,"_24435":56717,"_17116":94720,"_5":17011,"_23186":94679,"_2329":94721},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2802":56738,"_24435":56717,"_17116":94723,"_5":17011,"_23186":94679,"_2329":94724},[],"Ejecuta también la prueba de conectividad del chart:",{"_2802":56739,"_24435":56717,"_17116":94726,"_5":17011,"_23186":94679,"_2329":94727},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2802":56740,"_24435":56717,"_17116":94729,"_5":17011,"_23186":94679,"_2329":94730},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2802":56741,"_24435":56717,"_17116":94732,"_5":17011,"_23186":94683,"_2329":94733},[],"Si recibes un 401:",{"_2802":56742,"_24435":56717,"_17116":94735,"_5":17011,"_23186":94683,"_2329":94736},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2802":56743,"_24435":56717,"_17116":94738,"_5":17011,"_23186":94683,"_2329":94739},[],"verifica emisor, audiencia y expiración del token;",{"_2802":56744,"_24435":56717,"_17116":94741,"_5":17011,"_23186":94683,"_2329":94742},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2802":56745,"_24435":56717,"_17116":94744,"_5":17011,"_23186":94683,"_2329":94745},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2802":56746,"_24435":56717,"_17116":94747,"_5":17011,"_23186":94683,"_2329":94748},[],"Si el login termina pero las APIs devuelven 403:",{"_2802":56747,"_24435":56717,"_17116":94750,"_5":17011,"_23186":94683,"_2329":94751},[],"inspecciona los claims reales del token;",{"_2802":56748,"_24435":56717,"_17116":94753,"_5":17011,"_23186":94683,"_2329":94754},[],"confirma que coinciden con un principal activo;",{"_2802":56749,"_24435":56717,"_17116":94756,"_5":17011,"_23186":94683,"_2329":94757},[],"revisa las políticas concedidas al principal;",{"_2802":56750,"_24435":56717,"_17116":94759,"_5":17011,"_23186":94683,"_2329":94760},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2802":56751,"_24435":56717,"_17116":94762,"_5":17011,"_23186":94683,"_2329":94763},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2802":56752,"_24435":56717,"_17116":94765,"_5":17011,"_23186":94687,"_2329":94766},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2802":56753,"_24435":56717,"_17116":94768,"_5":17011,"_23186":94687,"_2329":94769},[],"Localiza el pod y Service de authz.",{"_2802":56754,"_24435":56717,"_17116":94771,"_5":17011,"_23186":94687,"_2329":94772},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2802":56755,"_24435":56717,"_17116":94774,"_5":17011,"_23186":94687,"_2329":94775},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2802":56756,"_24435":56717,"_17116":94777,"_5":17011,"_23186":94687,"_2329":94778},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2802":56757,"_24435":56717,"_17116":94780,"_5":17011,"_23186":94687,"_2329":94781},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2802":56758,"_24435":56717,"_17116":94783,"_5":17011,"_23186":94691,"_2329":94784},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2802":56759,"_24435":56717,"_17116":94786,"_5":17011,"_23186":94691,"_2329":94787},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2802":56760,"_24435":56717,"_17116":94789,"_5":17011,"_23186":94691,"_2329":94790},[],"volumen persistente sin enlazar;",{"_2802":56761,"_24435":56717,"_17116":94792,"_5":17011,"_23186":94691,"_2329":94793},[],"imagen inaccesible o política de pull incorrecta;",{"_2802":56762,"_24435":56717,"_17116":94795,"_5":17011,"_23186":94691,"_2329":94796},[],"configuración inválida del motor criptográfico;",{"_2802":56763,"_24435":56717,"_17116":94798,"_5":17011,"_23186":94691,"_2329":94799},[],"límites de CPU o memoria demasiado bajos;",{"_2802":56764,"_24435":56717,"_17116":94801,"_5":17011,"_23186":94691,"_2329":94802},[],"migración previa incompleta.",{"_2802":56765,"_24435":56717,"_17116":94804,"_5":17011,"_23186":94691,"_2329":94805},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2802":56766,"_24435":56717,"_17116":94807,"_5":17011,"_23186":94691,"_2329":94808},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2802":56767,"_24435":56717,"_17116":94810,"_5":17011,"_23186":94695,"_2329":94811},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2802":56768,"_24435":56717,"_17116":94813,"_5":17011,"_23186":94695,"_2329":94814},[],"verifica que esté habilitado en el servicio emisor;",{"_2802":56769,"_24435":56717,"_17116":94816,"_5":17011,"_23186":94695,"_2329":94817},[],"comprueba conectividad y credenciales AMQP;",{"_2802":56770,"_24435":56717,"_17116":94819,"_5":17011,"_23186":94695,"_2329":94820},[],"revisa exchange, routing key, colas y consumidores;",{"_2802":56771,"_24435":56717,"_17116":94822,"_5":17011,"_23186":94695,"_2329":94823},[],"inspecciona dead-letter queues;",{"_2802":56772,"_24435":56717,"_17116":94825,"_5":17011,"_23186":94695,"_2329":94826},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2802":56773,"_24435":56717,"_17116":94828,"_5":17011,"_23186":94695,"_2329":94829},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2802":56774,"_24435":56717,"_17116":94831,"_5":17011,"_23186":94699,"_2329":94832},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2802":56775,"_24435":56717,"_17116":94834,"_5":17011,"_23186":94699,"_2329":94835},[],"Antes de cerrar una incidencia, guarda:",{"_2802":56776,"_24435":56717,"_17116":94837,"_5":17011,"_23186":94699,"_2329":94838},[],"causa confirmada;",{"_2802":56777,"_24435":56717,"_17116":94840,"_5":17011,"_23186":94699,"_2329":94841},[],"alcance temporal y recursos afectados;",{"_2802":56778,"_24435":56717,"_17116":94843,"_5":17011,"_23186":94699,"_2329":94844},[],"comandos o consultas utilizados;",{"_2802":56779,"_24435":56717,"_17116":94846,"_5":17011,"_23186":94699,"_2329":94847},[],"cambio aplicado y forma de revertirlo;",{"_2802":56780,"_24435":56717,"_17116":94849,"_5":17011,"_23186":94699,"_2329":94850},[],"validación desde un consumidor;",{"_2802":56781,"_24435":56717,"_17116":94852,"_5":17011,"_23186":94699,"_2329":94853},[],"acción preventiva y propietario.",{"_2802":56782,"_24435":56782,"_5":12038,"_2329":94855,"_24770":94856,"_17116":94859,"_23186":56782},"Control de acceso",[39813,94857,94858],"Plataforma","Administración",[],{"_2802":56783,"_24435":56782,"_17116":94861,"_5":17011,"_23186":56782,"_2329":94862},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2802":56784,"_24435":56782,"_5":24767,"_17116":94864,"_23186":94865,"_2329":94866},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2802":56785,"_24435":56782,"_5":24767,"_17116":94868,"_23186":94869,"_2329":94870},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2802":56786,"_24435":56782,"_5":24767,"_17116":94872,"_23186":94873,"_2329":94874},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2802":56787,"_24435":56782,"_5":24767,"_17116":94876,"_23186":94877,"_2329":94878},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2802":56788,"_24435":56782,"_5":24767,"_17116":94880,"_23186":94881,"_2329":94882},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2802":56789,"_24435":56782,"_5":24767,"_17116":94884,"_23186":94885,"_2329":94886},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2802":56790,"_24435":56782,"_5":24767,"_17116":94888,"_23186":94889,"_2329":94890},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2802":56791,"_24435":56782,"_5":24767,"_17116":94892,"_23186":94893,"_2329":94894},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2802":56792,"_24435":56782,"_5":24767,"_17116":94896,"_23186":94897,"_2329":94898},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2802":56793,"_24435":56782,"_5":24767,"_17116":94900,"_23186":94901,"_2329":94902},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2802":56794,"_24435":56782,"_5":24767,"_17116":94904,"_23186":94905,"_2329":94906},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2802":56795,"_24435":56782,"_5":24767,"_17116":94908,"_23186":94909,"_2329":94910},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2802":56796,"_24435":56782,"_5":24767,"_17116":94912,"_23186":94913,"_2329":94914},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2802":56797,"_24435":56782,"_5":24767,"_17116":94916,"_23186":94917,"_2329":94918},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2802":56798,"_24435":56782,"_5":24767,"_17116":94920,"_23186":94921,"_2329":94922},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2802":56799,"_24435":56782,"_5":24767,"_17116":94924,"_23186":94925,"_2329":94119},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2802":56800,"_24435":56782,"_5":24767,"_17116":94927,"_23186":94928,"_2329":94929},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2802":56801,"_24435":56782,"_5":24767,"_17116":94931,"_23186":94932,"_2329":94933},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2802":56802,"_24435":56782,"_5":24767,"_17116":94935,"_23186":94936,"_2329":94937},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2802":56803,"_24435":56782,"_5":24767,"_17116":94939,"_23186":94940,"_2329":94941},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2802":56804,"_24435":56782,"_5":24767,"_17116":94943,"_23186":94944,"_2329":94945},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2802":56805,"_24435":56782,"_5":24767,"_17116":94947,"_23186":94948,"_2329":94949},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2802":56806,"_24435":56782,"_5":24767,"_17116":94951,"_23186":94952,"_2329":94953},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2802":56807,"_24435":56782,"_5":24767,"_17116":94955,"_23186":94956,"_2329":94957},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2802":56808,"_24435":56782,"_5":24767,"_17116":94959,"_23186":94960,"_2329":94961},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2802":56809,"_24435":56782,"_5":24767,"_17116":94963,"_23186":94964,"_2329":94965},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2802":56810,"_24435":56782,"_5":24767,"_17116":94967,"_23186":94968,"_2329":94969},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2802":56811,"_24435":56782,"_5":24767,"_17116":94971,"_23186":94972,"_2329":94973},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2802":56812,"_24435":56782,"_5":24767,"_17116":94975,"_23186":94976,"_2329":94977},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2802":56813,"_24435":56782,"_5":24767,"_17116":94979,"_23186":94980,"_2329":94981},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2802":56814,"_24435":56782,"_5":24767,"_17116":94983,"_23186":94984,"_2329":94985},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2802":56815,"_24435":56782,"_17116":94987,"_5":17011,"_23186":56782,"_2329":94988},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2802":56816,"_24435":56782,"_17116":94990,"_5":17011,"_23186":56782,"_2329":94991},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2802":56817,"_24435":56782,"_17116":94993,"_5":17011,"_23186":56782,"_2329":94994},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2802":56818,"_24435":56782,"_17116":94996,"_5":17011,"_23186":94865,"_2329":94997},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2802":56819,"_24435":56782,"_17116":94999,"_5":17011,"_23186":94865,"_2329":95000},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2802":56820,"_24435":56782,"_17116":95002,"_5":17011,"_23186":94865,"_2329":95003},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2802":56821,"_24435":56782,"_17116":95005,"_5":17011,"_23186":94865,"_2329":95006},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2802":56822,"_24435":56782,"_17116":95008,"_5":17011,"_23186":94865,"_2329":95009},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2802":56823,"_24435":56782,"_17116":95011,"_5":17011,"_23186":94865,"_2329":95012},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y alguna de sus políticas debe permitir la operación solicitada.",{"_2802":56824,"_24435":56782,"_17116":95014,"_5":17011,"_23186":94869,"_2329":95015},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2802":56825,"_24435":56782,"_17116":95017,"_5":17011,"_23186":94869,"_2329":95018},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2802":56826,"_24435":56782,"_17116":95020,"_5":17011,"_23186":94873,"_2329":95021},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2802":56827,"_24435":56782,"_17116":95023,"_5":17011,"_23186":94873,"_2329":95024},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2802":56828,"_24435":56782,"_17116":95026,"_5":17011,"_23186":94873,"_2329":95027},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2802":56829,"_24435":56782,"_17116":95029,"_5":17011,"_23186":94873,"_2329":95030},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2802":56830,"_24435":56782,"_17116":95032,"_5":17011,"_23186":94873,"_2329":95033},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2802":56831,"_24435":56782,"_17116":95035,"_5":17011,"_23186":94873,"_2329":95036},[],"Carga por separado las políticas concedidas a cada principal.",{"_2802":56832,"_24435":56782,"_17116":95038,"_5":17011,"_23186":94873,"_2329":95039},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2802":56833,"_24435":56782,"_17116":95041,"_5":17011,"_23186":94873,"_2329":95042},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2802":56834,"_24435":56782,"_17116":95044,"_5":17011,"_23186":94873,"_2329":95045},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2802":56835,"_24435":56782,"_17116":95047,"_5":17011,"_23186":94873,"_2329":95048},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2802":56836,"_24435":56782,"_17116":95050,"_5":17011,"_23186":94873,"_2329":95051},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en `x-current-user`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2802":56837,"_24435":56782,"_17116":95053,"_5":17011,"_23186":94873,"_2329":95054},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, el esquema debe declarar una restricción que relacione un valor de la petición con un atributo normalizado del principal.",{"_2802":56838,"_24435":56782,"_17116":95056,"_5":17011,"_23186":94877,"_2329":95057},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2802":56839,"_24435":56782,"_17116":95059,"_5":17011,"_23186":94877,"_2329":95060},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad autenticada sin una política que la conceda. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial incorrecta se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2802":56840,"_24435":56782,"_17116":95062,"_5":17011,"_23186":94877,"_2329":95063},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad autenticada.",{"_2802":56841,"_24435":56782,"_17116":95065,"_5":17011,"_23186":94877,"_2329":95066},[],"Son decisiones del esquema, no de una política: nunca sustituyen el grant que exige una ruta mapeada, solo cubren el hueco de los endpoints que el esquema no enumera. Ten en cuenta tres reglas:",{"_2802":56842,"_24435":56782,"_17116":95068,"_5":17011,"_23186":94877,"_2329":95069},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2802":56843,"_24435":56782,"_17116":95071,"_5":17011,"_23186":94877,"_2329":95072},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2802":56844,"_24435":56782,"_17116":95074,"_5":17011,"_23186":94877,"_2329":95075},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2802":56845,"_24435":56782,"_17116":95077,"_5":17011,"_23186":94877,"_2329":95078},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad autenticada puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2802":56846,"_24435":56782,"_17116":95080,"_5":17011,"_23186":94881,"_2329":95081},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2802":56847,"_24435":56782,"_17116":95083,"_5":17011,"_23186":94881,"_2329":95084},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2802":56848,"_24435":56782,"_17116":95086,"_5":17011,"_23186":94881,"_2329":95087},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2802":56849,"_24435":56782,"_17116":95089,"_5":17011,"_23186":94881,"_2329":95090},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2802":56850,"_24435":56782,"_17116":95092,"_5":17011,"_23186":94881,"_2329":95093},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2802":56851,"_24435":56782,"_17116":95095,"_5":17011,"_23186":94881,"_2329":95096},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2802":56852,"_24435":56782,"_17116":95098,"_5":17011,"_23186":94881,"_2329":95099},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2802":56853,"_24435":56782,"_17116":95101,"_5":17011,"_23186":94881,"_2329":95102},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2802":56854,"_24435":56782,"_17116":95104,"_5":17011,"_23186":94881,"_2329":95105},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2802":56855,"_24435":56782,"_17116":95107,"_5":17011,"_23186":94881,"_2329":95108},[],"Las acciones se dividen en dos grupos:",{"_2802":56856,"_24435":56782,"_17116":95110,"_5":17011,"_23186":94881,"_2329":95111},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2802":56857,"_24435":56782,"_17116":95113,"_5":17011,"_23186":94881,"_2329":95114},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2802":56858,"_24435":56782,"_17116":95116,"_5":17011,"_23186":94881,"_2329":95117},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2802":56859,"_24435":56782,"_17116":95119,"_5":17011,"_23186":94885,"_2329":95120},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2802":56860,"_24435":56782,"_17116":95122,"_5":17011,"_23186":94885,"_2329":95123},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2802":56861,"_24435":56782,"_17116":95125,"_5":17011,"_23186":94885,"_2329":95126},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega. Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2802":56862,"_24435":56782,"_17116":95128,"_5":17011,"_23186":94889,"_2329":95129},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2802":56863,"_24435":56782,"_17116":95131,"_5":17011,"_23186":94889,"_2329":95132},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2802":56864,"_24435":56782,"_17116":95134,"_5":17011,"_23186":94889,"_2329":95135},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2802":56865,"_24435":56782,"_17116":95137,"_5":17011,"_23186":94889,"_2329":95138},[],"Los operadores implementados son:",{"_2802":56866,"_24435":56782,"_17116":95140,"_5":17011,"_23186":94889,"_2329":95141},[],"`equals`, para igualdad exacta;",{"_2802":56867,"_24435":56782,"_17116":95143,"_5":17011,"_23186":94889,"_2329":95144},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2802":56868,"_24435":56782,"_17116":95146,"_5":17011,"_23186":94889,"_2329":95147},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2802":56869,"_24435":56782,"_17116":95149,"_5":17011,"_23186":94889,"_2329":95150},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2802":56870,"_24435":56782,"_17116":95152,"_5":17011,"_23186":94893,"_2329":95153},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2802":56871,"_24435":56782,"_17116":95155,"_5":17011,"_23186":94893,"_2329":95156},[],"Los modos disponibles son:",{"_2802":56872,"_24435":56782,"_17116":95158,"_5":17011,"_23186":94893,"_2329":95159},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2802":56873,"_24435":56782,"_17116":95161,"_5":17011,"_23186":94893,"_2329":95162},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2802":56874,"_24435":56782,"_17116":95164,"_5":17011,"_23186":94893,"_2329":95165},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2802":56875,"_24435":56782,"_17116":95167,"_5":17011,"_23186":94893,"_2329":95168},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2802":56876,"_24435":56782,"_17116":95170,"_5":17011,"_23186":94893,"_2329":95171},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2802":56877,"_24435":56782,"_17116":95173,"_5":17011,"_23186":94893,"_2329":95174},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2802":56878,"_24435":56782,"_17116":95176,"_5":17011,"_23186":94897,"_2329":95177},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2802":56879,"_24435":56782,"_17116":95179,"_5":17011,"_23186":94897,"_2329":95180},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2802":56880,"_24435":56782,"_17116":95182,"_5":17011,"_23186":94897,"_2329":95183},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2802":56881,"_24435":56782,"_17116":95185,"_5":17011,"_23186":94897,"_2329":95186},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2802":56882,"_24435":56782,"_17116":95188,"_5":17011,"_23186":94905,"_2329":95189},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2802":56883,"_24435":56782,"_17116":95191,"_5":17011,"_23186":94905,"_2329":95192},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2802":56884,"_24435":56782,"_17116":95194,"_5":17011,"_23186":94909,"_2329":95195},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2802":56885,"_24435":56782,"_17116":95197,"_5":17011,"_23186":94909,"_2329":95198},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2802":56886,"_24435":56782,"_17116":95200,"_5":17011,"_23186":94913,"_2329":95201},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2802":56887,"_24435":56782,"_17116":95203,"_5":17011,"_23186":94913,"_2329":95204},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2802":56888,"_24435":56782,"_17116":95206,"_5":17011,"_23186":94913,"_2329":95207},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2802":56889,"_24435":56782,"_17116":95209,"_5":17011,"_23186":94917,"_2329":95210},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2802":56890,"_24435":56782,"_17116":95212,"_5":17011,"_23186":94917,"_2329":95213},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2802":56891,"_24435":56782,"_17116":95215,"_5":17011,"_23186":94917,"_2329":95216},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2802":56892,"_24435":56782,"_17116":95218,"_5":17011,"_23186":94917,"_2329":95219},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2802":56893,"_24435":56782,"_17116":95221,"_5":17011,"_23186":94917,"_2329":95222},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2802":56894,"_24435":56782,"_17116":95224,"_5":17011,"_23186":94917,"_2329":95225},[],"Ten en cuenta que:",{"_2802":56895,"_24435":56782,"_17116":95227,"_5":17011,"_23186":94917,"_2329":95228},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2802":56896,"_24435":56782,"_17116":95230,"_5":17011,"_23186":94917,"_2329":95231},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2802":56897,"_24435":56782,"_17116":95233,"_5":17011,"_23186":94917,"_2329":95234},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2802":56898,"_24435":56782,"_17116":95236,"_5":17011,"_23186":94921,"_2329":95237},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2802":56899,"_24435":56782,"_17116":95239,"_5":17011,"_23186":94921,"_2329":95240},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2802":56900,"_24435":56782,"_17116":95242,"_5":17011,"_23186":94921,"_2329":95243},[],"acceso completo y de solo lectura a KMS;",{"_2802":56901,"_24435":56782,"_17116":95245,"_5":17011,"_23186":94921,"_2329":95246},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2802":56902,"_24435":56782,"_17116":95248,"_5":17011,"_23186":94921,"_2329":95249},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2802":56903,"_24435":56782,"_17116":95251,"_5":17011,"_23186":94921,"_2329":95252},[],"acceso a la interfaz;",{"_2802":56904,"_24435":56782,"_17116":95254,"_5":17011,"_23186":94921,"_2329":95255},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2802":56905,"_24435":56782,"_17116":95257,"_5":17011,"_23186":94921,"_2329":95258},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2802":56906,"_24435":56782,"_17116":95260,"_5":17011,"_23186":94921,"_2329":95261},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2802":56907,"_24435":56782,"_17116":95263,"_5":17011,"_23186":94925,"_2329":95264},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2802":56908,"_24435":56782,"_17116":95266,"_5":17011,"_23186":94925,"_2329":95267},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2802":56909,"_24435":56782,"_17116":95269,"_5":17011,"_23186":94925,"_2329":95270},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2802":56910,"_24435":56782,"_17116":95272,"_5":17011,"_23186":94928,"_2329":95273},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2802":56911,"_24435":56782,"_17116":95275,"_5":17011,"_23186":94932,"_2329":95276},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2802":56912,"_24435":56782,"_17116":95278,"_5":17011,"_23186":94936,"_2329":95279},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2802":56913,"_24435":56782,"_17116":95281,"_5":17011,"_23186":94940,"_2329":95282},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2802":56914,"_24435":56782,"_17116":95284,"_5":17011,"_23186":94944,"_2329":95285},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2802":56915,"_24435":56782,"_17116":95287,"_5":17011,"_23186":94948,"_2329":95288},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2802":56916,"_24435":56782,"_17116":95290,"_5":17011,"_23186":94948,"_2329":95291},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2802":56917,"_24435":56782,"_17116":95293,"_5":17011,"_23186":94952,"_2329":95294},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2802":56918,"_24435":56782,"_17116":95296,"_5":17011,"_23186":94952,"_2329":95297},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2802":56919,"_24435":56782,"_17116":95299,"_5":17011,"_23186":94952,"_2329":95300},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2802":56920,"_24435":56782,"_17116":95302,"_5":17011,"_23186":94952,"_2329":95303},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2802":56921,"_24435":56782,"_17116":95305,"_5":17011,"_23186":94952,"_2329":95306},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2802":56922,"_24435":56782,"_17116":95308,"_5":17011,"_23186":94952,"_2329":95309},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2802":56923,"_24435":56782,"_17116":95311,"_5":17011,"_23186":94952,"_2329":95312},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2802":56924,"_24435":56782,"_17116":95314,"_5":17011,"_23186":94952,"_2329":95315},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2802":56925,"_24435":56782,"_17116":95317,"_5":17011,"_23186":94956,"_2329":95318},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2802":56926,"_24435":56782,"_17116":95320,"_5":17011,"_23186":94956,"_2329":95321},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2802":56927,"_24435":56782,"_17116":95323,"_5":17011,"_23186":94956,"_2329":95324},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2802":56928,"_24435":56782,"_17116":95326,"_5":17011,"_23186":94960,"_2329":95327},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2802":56929,"_24435":56782,"_17116":95329,"_5":17011,"_23186":94960,"_2329":95330},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2802":56930,"_24435":56782,"_17116":95332,"_5":17011,"_23186":94960,"_2329":95333},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2802":56931,"_24435":56782,"_17116":95335,"_5":17011,"_23186":94960,"_2329":95336},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2802":56932,"_24435":56782,"_17116":95338,"_5":17011,"_23186":94960,"_2329":95339},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2802":56933,"_24435":56782,"_17116":95341,"_5":17011,"_23186":94960,"_2329":95342},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2802":56934,"_24435":56782,"_17116":95344,"_5":17011,"_23186":94960,"_2329":95345},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2802":56935,"_24435":56782,"_17116":95347,"_5":17011,"_23186":94960,"_2329":95348},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2802":56936,"_24435":56782,"_17116":95350,"_5":17011,"_23186":94968,"_2329":95351},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2802":56937,"_24435":56782,"_17116":95353,"_5":17011,"_23186":94972,"_2329":95354},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2802":56938,"_24435":56782,"_17116":95356,"_5":17011,"_23186":94972,"_2329":95357},[],"que exista un principal activo del tipo correcto;",{"_2802":56939,"_24435":56782,"_17116":95359,"_5":17011,"_23186":94972,"_2329":95360},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2802":56940,"_24435":56782,"_17116":95362,"_5":17011,"_23186":94972,"_2329":95363},[],"que todas las condiciones del principal se cumplan;",{"_2802":56941,"_24435":56782,"_17116":95365,"_5":17011,"_23186":94972,"_2329":95366},[],"que el principal tenga concedida la política esperada;",{"_2802":56942,"_24435":56782,"_17116":95368,"_5":17011,"_23186":94972,"_2329":95369},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2802":56943,"_24435":56782,"_17116":95371,"_5":17011,"_23186":94972,"_2329":95372},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2802":56944,"_24435":56782,"_17116":95374,"_5":17011,"_23186":94972,"_2329":95375},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2802":56945,"_24435":56782,"_17116":95377,"_5":17011,"_23186":94976,"_2329":95378},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2802":56946,"_24435":56782,"_17116":95380,"_5":17011,"_23186":94980,"_2329":95381},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad autenticada, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2802":56947,"_24435":56782,"_17116":95383,"_5":17011,"_23186":94984,"_2329":95384},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2802":56948,"_24435":56782,"_17116":95386,"_5":17011,"_23186":94984,"_2329":95387},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2802":56949,"_24435":56949,"_5":12038,"_2329":95389,"_24770":95390,"_17116":95391,"_23186":56949},"Alertas y suscripciones",[39813,94857,94858],[],{"_2802":56950,"_24435":56949,"_17116":95393,"_5":17011,"_23186":56949,"_2329":95394},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2802":56951,"_24435":56949,"_5":24767,"_17116":95396,"_23186":95397,"_2329":95398},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2802":56952,"_24435":56949,"_5":24767,"_17116":95400,"_23186":95401,"_2329":95402},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2802":56953,"_24435":56949,"_5":24767,"_17116":95404,"_23186":95405,"_2329":95406},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2802":56954,"_24435":56949,"_5":24767,"_17116":95408,"_23186":95409,"_2329":95410},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2802":56955,"_24435":56949,"_5":24767,"_17116":95412,"_23186":95413,"_2329":95414},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2802":56956,"_24435":56949,"_5":24767,"_17116":95416,"_23186":95417,"_2329":95418},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2802":56957,"_24435":56949,"_5":24767,"_17116":95420,"_23186":95421,"_2329":95422},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2802":56958,"_24435":56949,"_5":24767,"_17116":95424,"_23186":95425,"_2329":95426},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2802":56959,"_24435":56949,"_5":24767,"_17116":95428,"_23186":95429,"_2329":95430},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2802":56960,"_24435":56949,"_17116":95432,"_5":17011,"_23186":56949,"_2329":95433},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2802":56961,"_24435":56949,"_17116":95435,"_5":17011,"_23186":95397,"_2329":95436},[],"Un servicio publica un evento de dominio.",{"_2802":56962,"_24435":56949,"_17116":95438,"_5":17011,"_23186":95397,"_2329":95439},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2802":56963,"_24435":56949,"_17116":95441,"_5":17011,"_23186":95397,"_2329":95442},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2802":56964,"_24435":56949,"_17116":95444,"_5":17011,"_23186":95397,"_2329":95445},[],"Lamassu entrega el evento al canal configurado.",{"_2802":56965,"_24435":56949,"_17116":95447,"_5":17011,"_23186":95397,"_2329":95448},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2802":56966,"_24435":56949,"_17116":95450,"_5":17011,"_23186":95401,"_2329":95451},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino.",{"_2802":56967,"_24435":56949,"_17116":95453,"_5":17011,"_23186":95401,"_2329":95454},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2802":56968,"_24435":56949,"_17116":95456,"_5":17011,"_23186":95401,"_2329":95457},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2802":56969,"_24435":56949,"_17116":95459,"_5":17011,"_23186":95409,"_2329":95460},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2802":56970,"_24435":56949,"_17116":95462,"_5":17011,"_23186":95413,"_2329":95463},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2802":56971,"_24435":56949,"_17116":95465,"_5":17011,"_23186":95417,"_2329":95466},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2802":56972,"_24435":56949,"_17116":95468,"_5":17011,"_23186":95417,"_2329":95469},[],"**None** notifica todas las instancias del evento.",{"_2802":56973,"_24435":56949,"_17116":95471,"_5":17011,"_23186":95417,"_2329":95472},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2802":56974,"_24435":56949,"_17116":95474,"_5":17011,"_23186":95417,"_2329":95475},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2802":56975,"_24435":56949,"_17116":95477,"_5":17011,"_23186":95417,"_2329":95478},[],"**JavaScript** permite expresar lógica personalizada.",{"_2802":56976,"_24435":56949,"_17116":95480,"_5":17011,"_23186":95417,"_2329":95481},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2802":56977,"_24435":56949,"_17116":95483,"_5":17011,"_23186":95421,"_2329":95484},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2802":56978,"_24435":56949,"_17116":95486,"_5":17011,"_23186":95425,"_2329":95487},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2802":56979,"_24435":56949,"_17116":95489,"_5":17011,"_23186":95429,"_2329":95490},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2802":56980,"_24435":56949,"_17116":95492,"_5":17011,"_23186":95429,"_2329":95493},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2802":56981,"_24435":56949,"_17116":95495,"_5":17011,"_23186":95429,"_2329":95496},[],"**Perfiles:** `profile.create`, `profile.update` y `profile.delete`.",{"_2802":56982,"_24435":56949,"_17116":95498,"_5":17011,"_23186":95429,"_2329":95499},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2802":56983,"_24435":56949,"_17116":95501,"_5":17011,"_23186":95429,"_2329":95502},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2802":56984,"_24435":56949,"_17116":95504,"_5":17011,"_23186":95429,"_2329":95505},[],"**Validación:** `va.role.crl.create`.",{"_2802":56985,"_24435":56949,"_17116":95507,"_5":17011,"_23186":95429,"_2329":95508},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign.message` y `kms.delete`.",{"_2802":56986,"_24435":56949,"_17116":95510,"_5":17011,"_23186":95429,"_2329":95511},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2802":56987,"_24435":56987,"_5":12038,"_2329":95513,"_24770":95514,"_17116":95515,"_23186":56987},"Registros de auditoría",[39813,94857,94858],[],{"_2802":56988,"_24435":56987,"_17116":95517,"_5":17011,"_23186":56987,"_2329":95518},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2802":56989,"_24435":56987,"_5":24767,"_17116":95520,"_23186":95521,"_2329":95522},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2802":56990,"_24435":56987,"_5":24767,"_17116":95524,"_23186":95525,"_2329":95526},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2802":56991,"_24435":56987,"_5":24767,"_17116":95528,"_23186":95529,"_2329":95530},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2802":56992,"_24435":56987,"_5":24767,"_17116":95532,"_23186":95533,"_2329":95534},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2802":56993,"_24435":56987,"_5":24767,"_17116":95536,"_23186":95537,"_2329":95538},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2802":56994,"_24435":56987,"_5":24767,"_17116":95540,"_23186":95541,"_2329":95542},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2802":56995,"_24435":56987,"_5":24767,"_17116":95544,"_23186":95545,"_2329":95546},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2802":56996,"_24435":56987,"_5":24767,"_17116":95548,"_23186":95549,"_2329":95550},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2802":56997,"_24435":56987,"_5":24767,"_17116":95552,"_23186":95553,"_2329":95554},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2802":56998,"_24435":56987,"_5":24767,"_17116":95556,"_23186":95557,"_2329":95558},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2802":56999,"_24435":56987,"_5":24767,"_17116":95560,"_23186":95561,"_2329":95562},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2802":57000,"_24435":56987,"_17116":95564,"_5":17011,"_23186":56987,"_2329":95565},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2802":57001,"_24435":56987,"_17116":95567,"_5":17011,"_23186":95521,"_2329":95568},[],"El cuerpo de auditoría incluye:",{"_2802":57002,"_24435":56987,"_17116":95570,"_5":17011,"_23186":95521,"_2329":95571},[],"input: datos recibidos por la operación;",{"_2802":57003,"_24435":56987,"_17116":95573,"_5":17011,"_23186":95521,"_2329":95574},[],"has\\_error: indica si el servicio devolvió un error;",{"_2802":57004,"_24435":56987,"_17116":95576,"_5":17011,"_23186":95521,"_2329":95577},[],"output: resultado producido o mensaje de error;",{"_2802":57005,"_24435":56987,"_17116":95579,"_5":17011,"_23186":95521,"_2329":95580},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2802":57006,"_24435":56987,"_17116":95582,"_5":17011,"_23186":95521,"_2329":95583},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2802":57007,"_24435":56987,"_17116":95585,"_5":17011,"_23186":95521,"_2329":95586},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2802":57008,"_24435":56987,"_17116":95588,"_5":17011,"_23186":95525,"_2329":95589},[],"El backend aplica auditoría a mutaciones de:",{"_2802":57009,"_24435":56987,"_17116":95591,"_5":17011,"_23186":95525,"_2329":95592},[],"autoridades, certificados y perfiles de emisión;",{"_2802":57010,"_24435":56987,"_17116":95594,"_5":17011,"_23186":95525,"_2329":95595},[],"claves y motores KMS;",{"_2802":57011,"_24435":56987,"_17116":95597,"_5":17011,"_23186":95525,"_2329":95598},[],"dispositivos e identidades;",{"_2802":57012,"_24435":56987,"_17116":95600,"_5":17011,"_23186":95525,"_2329":95601},[],"DMS y operaciones de enrolamiento;",{"_2802":57013,"_24435":56987,"_17116":95603,"_5":17011,"_23186":95525,"_2329":95604},[],"funciones de validación y CRL;",{"_2802":57014,"_24435":56987,"_17116":95606,"_5":17011,"_23186":95525,"_2329":95607},[],"principales, políticas y concesiones de autorización.",{"_2802":57015,"_24435":56987,"_17116":95609,"_5":17011,"_23186":95525,"_2329":95610},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2802":57016,"_24435":56987,"_17116":95612,"_5":17011,"_23186":95529,"_2329":95613},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2802":57017,"_24435":56987,"_17116":95615,"_5":17011,"_23186":95529,"_2329":95616},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2802":57018,"_24435":56987,"_17116":95618,"_5":17011,"_23186":95529,"_2329":95619},[],"Diseña el consumidor para:",{"_2802":57019,"_24435":56987,"_17116":95621,"_5":17011,"_23186":95529,"_2329":95622},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2802":57020,"_24435":56987,"_17116":95624,"_5":17011,"_23186":95529,"_2329":95625},[],"conservar el CloudEvent completo sin modificar;",{"_2802":57021,"_24435":56987,"_17116":95627,"_5":17011,"_23186":95529,"_2329":95628},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2802":57022,"_24435":56987,"_17116":95630,"_5":17011,"_23186":95529,"_2329":95631},[],"cifrar en tránsito y en reposo;",{"_2802":57023,"_24435":56987,"_17116":95633,"_5":17011,"_23186":95529,"_2329":95634},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2802":57024,"_24435":56987,"_17116":95636,"_5":17011,"_23186":95529,"_2329":95637},[],"aplicar una política explícita de retención y legal hold;",{"_2802":57025,"_24435":56987,"_17116":95639,"_5":17011,"_23186":95529,"_2329":95640},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2802":57026,"_24435":56987,"_17116":95642,"_5":17011,"_23186":95533,"_2329":95643},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2802":57027,"_24435":56987,"_17116":95645,"_5":17011,"_23186":95533,"_2329":95646},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2802":57028,"_24435":56987,"_17116":95648,"_5":17011,"_23186":95541,"_2329":95649},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2802":57029,"_24435":56987,"_17116":95651,"_5":17011,"_23186":95545,"_2329":95652},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2802":57030,"_24435":56987,"_17116":95654,"_5":17011,"_23186":95549,"_2329":95655},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2802":57031,"_24435":56987,"_17116":95657,"_5":17011,"_23186":95553,"_2329":95658},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2802":57032,"_24435":56987,"_17116":95660,"_5":17011,"_23186":95557,"_2329":95661},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2802":57033,"_24435":56987,"_17116":95663,"_5":17011,"_23186":95561,"_2329":95664},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2802":57034,"_24435":56987,"_17116":95666,"_5":17011,"_23186":95561,"_2329":95667},[],"aparece un evento de auditoría correcto;",{"_2802":57035,"_24435":56987,"_17116":95669,"_5":17011,"_23186":95561,"_2329":95670},[],"el principal coincide con la identidad utilizada;",{"_2802":57036,"_24435":56987,"_17116":95672,"_5":17011,"_23186":95561,"_2329":95673},[],"el consumidor lo persiste una sola vez;",{"_2802":57037,"_24435":56987,"_17116":95675,"_5":17011,"_23186":95561,"_2329":95676},[],"puede recuperarse por recurso, actor y periodo;",{"_2802":57038,"_24435":56987,"_17116":95678,"_5":17011,"_23186":95561,"_2329":95679},[],"una interrupción del consumidor produce una alerta.",{"_2802":57039,"_24435":56987,"_17116":95681,"_5":17011,"_23186":95561,"_2329":95682},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2802":57040,"_24435":57040,"_5":12038,"_2329":95684,"_24770":95685,"_17116":95686,"_23186":57040},"Arquitectura de la plataforma",[39813,94857],[],{"_2802":57041,"_24435":57040,"_17116":95688,"_5":17011,"_23186":57040,"_2329":95689},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2802":57042,"_24435":57040,"_5":24767,"_17116":95691,"_23186":95692,"_2329":95693},[],"/docs/pr-preview/pr-28/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2802":57043,"_24435":57040,"_5":24767,"_17116":95695,"_23186":95696,"_2329":95697},[],"/docs/pr-preview/pr-28/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2802":57044,"_24435":57040,"_5":24767,"_17116":95699,"_23186":95700,"_2329":95701},[],"/docs/pr-preview/pr-28/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2802":57045,"_24435":57040,"_5":24767,"_17116":95703,"_23186":95704,"_2329":95705},[],"/docs/pr-preview/pr-28/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2802":57046,"_24435":57040,"_5":24767,"_17116":95707,"_23186":95708,"_2329":95709},[],"/docs/pr-preview/pr-28/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2802":57047,"_24435":57040,"_17116":95711,"_5":17011,"_23186":57040,"_2329":95712},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2802":57048,"_24435":57040,"_17116":95714,"_5":17011,"_23186":57040,"_2329":95715},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2802":57049,"_24435":57040,"_17116":95717,"_5":17011,"_23186":95692,"_2329":95718},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2802":57050,"_24435":57040,"_17116":95720,"_5":17011,"_23186":95696,"_2329":95721},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2802":57051,"_24435":57040,"_17116":95723,"_5":17011,"_23186":95700,"_2329":95724},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2802":57052,"_24435":57040,"_17116":95726,"_5":17011,"_23186":95704,"_2329":95727},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2802":57053,"_24435":57040,"_17116":95729,"_5":17011,"_23186":95708,"_2329":95730},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2802":57054,"_24435":57054,"_5":12038,"_2329":95732,"_24770":95733,"_17116":95734,"_23186":57054},"Cómo funciona Lamassu",[39813,94857],[],{"_2802":57055,"_24435":57054,"_17116":95736,"_5":17011,"_23186":57054,"_2329":95737},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2802":57056,"_24435":57054,"_5":24767,"_17116":95739,"_23186":95740,"_2329":95741},[],"/docs/pr-preview/pr-28/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2802":57057,"_24435":57054,"_5":24767,"_17116":95743,"_23186":95744,"_2329":95745},[],"/docs/pr-preview/pr-28/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2802":57058,"_24435":57054,"_17116":95747,"_5":17011,"_23186":57054,"_2329":95748},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2802":57059,"_24435":57054,"_17116":95750,"_5":17011,"_23186":95740,"_2329":95751},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2802":57060,"_24435":57054,"_17116":95753,"_5":17011,"_23186":95740,"_2329":95754},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2802":57061,"_24435":57054,"_17116":95756,"_5":17011,"_23186":95740,"_2329":95757},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2802":57062,"_24435":57054,"_17116":95759,"_5":17011,"_23186":95740,"_2329":95760},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2802":57063,"_24435":57054,"_17116":95762,"_5":17011,"_23186":95740,"_2329":95763},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2802":57064,"_24435":57054,"_17116":95765,"_5":17011,"_23186":95744,"_2329":95766},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2802":57065,"_24435":57054,"_17116":95768,"_5":17011,"_23186":95744,"_2329":95769},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2802":57066,"_24435":57054,"_17116":95771,"_5":17011,"_23186":95744,"_2329":95772},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2802":57067,"_24435":57054,"_17116":95774,"_5":17011,"_23186":95744,"_2329":95775},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2802":57068,"_24435":57054,"_17116":95777,"_5":17011,"_23186":95744,"_2329":95778},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2802":57069,"_24435":57054,"_17116":95780,"_5":17011,"_23186":95744,"_2329":95781},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2802":57070,"_24435":57054,"_17116":95783,"_5":17011,"_23186":95744,"_2329":95784},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2802":57071,"_24435":57071,"_5":12038,"_2329":95786,"_24770":95787,"_17116":95788,"_23186":57071},"Dispositivos e identidades",[39813,94857,42088,95786],[],{"_2802":57072,"_24435":57071,"_17116":95790,"_5":17011,"_23186":57071,"_2329":95791},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2802":57073,"_24435":57071,"_5":24767,"_17116":95793,"_23186":95794,"_2329":95795},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2802":57074,"_24435":57071,"_5":24767,"_17116":95797,"_23186":95798,"_2329":95799},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2802":57075,"_24435":57071,"_5":24767,"_17116":95801,"_23186":95802,"_2329":95803},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2802":57076,"_24435":57071,"_5":24767,"_17116":95805,"_23186":95806,"_2329":95807},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2802":57077,"_24435":57071,"_5":24767,"_17116":95809,"_23186":95810,"_2329":95811},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2802":57078,"_24435":57071,"_5":24767,"_17116":95813,"_23186":95814,"_2329":95815},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2802":57079,"_24435":57071,"_5":24767,"_17116":95817,"_23186":95818,"_2329":95819},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2802":57080,"_24435":57071,"_5":24767,"_17116":95821,"_23186":95822,"_2329":95823},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2802":57081,"_24435":57071,"_5":24767,"_17116":95825,"_23186":95826,"_2329":95827},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2802":57082,"_24435":57071,"_5":24767,"_17116":95829,"_23186":95830,"_2329":95831},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2802":57083,"_24435":57071,"_5":24767,"_17116":95833,"_23186":95834,"_2329":95835},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2802":57084,"_24435":57071,"_17116":95837,"_5":17011,"_23186":57071,"_2329":95838},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2802":57085,"_24435":57071,"_17116":95840,"_5":17011,"_23186":57071,"_2329":95841},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2802":57086,"_24435":57071,"_17116":95843,"_5":17011,"_23186":95794,"_2329":95844},[],"Vista operativa",{"_2802":57087,"_24435":57071,"_17116":95846,"_5":17011,"_23186":95794,"_2329":95847},[],"Interpretación",{"_2802":57088,"_24435":57071,"_17116":95849,"_5":17011,"_23186":95794,"_2329":42151},[],{"_2802":57089,"_24435":57071,"_17116":95851,"_5":17011,"_23186":95794,"_2329":95852},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2802":57090,"_24435":57071,"_17116":95854,"_5":17011,"_23186":95794,"_2329":42157},[],{"_2802":57091,"_24435":57071,"_17116":95856,"_5":17011,"_23186":95794,"_2329":95857},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2802":57092,"_24435":57071,"_17116":95859,"_5":17011,"_23186":95794,"_2329":42163},[],{"_2802":57093,"_24435":57071,"_17116":95861,"_5":17011,"_23186":95794,"_2329":95862},[],"La identidad está en la ventana operativa de renovación.",{"_2802":57094,"_24435":57071,"_17116":95864,"_5":17011,"_23186":95794,"_2329":42169},[],{"_2802":57095,"_24435":57071,"_17116":95866,"_5":17011,"_23186":95794,"_2329":95867},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2802":57096,"_24435":57071,"_17116":95869,"_5":17011,"_23186":95794,"_2329":42175},[],{"_2802":57097,"_24435":57071,"_17116":95871,"_5":17011,"_23186":95794,"_2329":95872},[],"La identidad ha vencido.",{"_2802":57098,"_24435":57071,"_17116":95874,"_5":17011,"_23186":95794,"_2329":42181},[],{"_2802":57099,"_24435":57071,"_17116":95876,"_5":17011,"_23186":95794,"_2329":95877},[],"La identidad está marcada como revocada.",{"_2802":57100,"_24435":57071,"_17116":95879,"_5":17011,"_23186":95794,"_2329":42187},[],{"_2802":57101,"_24435":57071,"_17116":95881,"_5":17011,"_23186":95794,"_2329":95882},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2802":57102,"_24435":57071,"_17116":95884,"_5":17011,"_23186":95794,"_2329":95885},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2802":57103,"_24435":57071,"_17116":95887,"_5":17011,"_23186":95798,"_2329":95888},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2802":57104,"_24435":57071,"_17116":95890,"_5":17011,"_23186":95798,"_2329":95891},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2802":57105,"_24435":57071,"_17116":95893,"_5":17011,"_23186":95798,"_2329":95894},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2802":57106,"_24435":57071,"_17116":95896,"_5":17011,"_23186":95798,"_2329":95897},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2802":57107,"_24435":57071,"_17116":95899,"_5":17011,"_23186":95802,"_2329":95900},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2802":57108,"_24435":57071,"_17116":95902,"_5":17011,"_23186":95806,"_2329":95903},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2802":57109,"_24435":57071,"_17116":95905,"_5":17011,"_23186":95810,"_2329":95906},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2802":57110,"_24435":57071,"_17116":95908,"_5":17011,"_23186":95814,"_2329":95909},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2802":57111,"_24435":57071,"_17116":95911,"_5":17011,"_23186":95818,"_2329":95912},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2802":57112,"_24435":57071,"_17116":95914,"_5":17011,"_23186":95818,"_2329":95915},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2802":57113,"_24435":57071,"_17116":95917,"_5":17011,"_23186":95822,"_2329":95918},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2802":57114,"_24435":57071,"_17116":95920,"_5":17011,"_23186":95822,"_2329":95921},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2802":57115,"_24435":57071,"_17116":95923,"_5":17011,"_23186":95822,"_2329":95924},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2802":57116,"_24435":57071,"_17116":95926,"_5":17011,"_23186":95822,"_2329":95927},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2802":57117,"_24435":57071,"_17116":95929,"_5":17011,"_23186":95822,"_2329":95930},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2802":57118,"_24435":57071,"_17116":95932,"_5":17011,"_23186":95822,"_2329":95933},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2802":57119,"_24435":57071,"_17116":95935,"_5":17011,"_23186":95826,"_2329":95936},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2802":57120,"_24435":57071,"_17116":95938,"_5":17011,"_23186":95826,"_2329":95939},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2802":57121,"_24435":57071,"_17116":95941,"_5":17011,"_23186":95830,"_2329":95942},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2802":57122,"_24435":57071,"_17116":95944,"_5":17011,"_23186":95830,"_2329":95945},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2802":57123,"_24435":57071,"_17116":95947,"_5":17011,"_23186":95830,"_2329":95948},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2802":57124,"_24435":57071,"_17116":95950,"_5":17011,"_23186":95830,"_2329":95951},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2802":57125,"_24435":57071,"_17116":95953,"_5":17011,"_23186":95834,"_2329":95954},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2802":57126,"_24435":57071,"_17116":95956,"_5":17011,"_23186":95834,"_2329":95957},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2802":57127,"_24435":57127,"_5":12038,"_2329":95959,"_24770":95960,"_17116":95962,"_23186":57127},"Identidad inicial y autenticación",[39813,94857,42088,95786,95961],"Enrolamiento con PKI",[],{"_2802":57128,"_24435":57127,"_17116":95964,"_5":17011,"_23186":57127,"_2329":95965},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2802":57129,"_24435":57127,"_5":24767,"_17116":95967,"_23186":95968,"_2329":95969},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2802":57130,"_24435":57127,"_5":24767,"_17116":95971,"_23186":95972,"_2329":95973},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2802":57131,"_24435":57127,"_5":24767,"_17116":95975,"_23186":95976,"_2329":95977},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2802":57132,"_24435":57127,"_5":24767,"_17116":95979,"_23186":95980,"_2329":95981},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2802":57133,"_24435":57127,"_5":24767,"_17116":95983,"_23186":95984,"_2329":95985},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2802":57134,"_24435":57127,"_17116":95987,"_5":17011,"_23186":57127,"_2329":95988},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2802":57135,"_24435":57127,"_17116":95990,"_5":17011,"_23186":95968,"_2329":95991},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2802":57136,"_24435":57127,"_17116":95993,"_5":17011,"_23186":95968,"_2329":95994},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2802":57137,"_24435":57127,"_17116":95996,"_5":17011,"_23186":95972,"_2329":95997},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2802":57138,"_24435":57127,"_17116":95999,"_5":17011,"_23186":95972,"_2329":96000},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2802":57139,"_24435":57127,"_17116":96002,"_5":17011,"_23186":95972,"_2329":96003},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2802":57140,"_24435":57127,"_17116":96005,"_5":17011,"_23186":95976,"_2329":96006},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2802":57141,"_24435":57127,"_17116":96008,"_5":17011,"_23186":95976,"_2329":96009},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2802":57142,"_24435":57127,"_17116":96011,"_5":17011,"_23186":95980,"_2329":96012},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado.",{"_2802":57143,"_24435":57127,"_17116":96014,"_5":17011,"_23186":95980,"_2329":96015},[],"Ejemplo de cuerpo:",{"_2802":57144,"_24435":57127,"_17116":96017,"_5":17011,"_23186":95980,"_2329":96018},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2802":57145,"_24435":57127,"_17116":96020,"_5":17011,"_23186":95980,"_2329":96021},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2802":57146,"_24435":57127,"_17116":96023,"_5":17011,"_23186":95980,"_2329":96024},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2802":57147,"_24435":57127,"_17116":96026,"_5":17011,"_23186":95980,"_2329":96027},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2802":57148,"_24435":57127,"_17116":96029,"_5":17011,"_23186":95984,"_2329":96030},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2802":57149,"_24435":57127,"_17116":96032,"_5":17011,"_23186":95984,"_2329":96033},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2802":57150,"_24435":57150,"_5":12038,"_2329":96035,"_24770":96036,"_17116":96037,"_23186":57150},"Configura y opera el DMS",[39813,94857,42088,95786,95961],[],{"_2802":57151,"_24435":57150,"_17116":96039,"_5":17011,"_23186":57150,"_2329":96040},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2802":57152,"_24435":57150,"_5":24767,"_17116":96042,"_23186":96043,"_2329":93558},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2802":57153,"_24435":57150,"_5":24767,"_17116":96045,"_23186":96046,"_2329":96047},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2802":57154,"_24435":57150,"_5":24767,"_17116":96049,"_23186":96050,"_2329":96051},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2802":57155,"_24435":57150,"_5":24767,"_17116":96053,"_23186":96054,"_2329":96055},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2802":57156,"_24435":57150,"_5":24767,"_17116":96057,"_23186":96058,"_2329":96059},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2802":57157,"_24435":57150,"_5":24767,"_17116":96061,"_23186":96062,"_2329":96063},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2802":57158,"_24435":57150,"_5":24767,"_17116":96065,"_23186":96066,"_2329":96067},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2802":57159,"_24435":57150,"_5":24767,"_17116":96069,"_23186":96070,"_2329":96071},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2802":57160,"_24435":57150,"_5":24767,"_17116":96073,"_23186":96074,"_2329":42383},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2802":57161,"_24435":57150,"_5":24767,"_17116":96076,"_23186":96077,"_2329":42387},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2802":57162,"_24435":57150,"_5":24767,"_17116":96079,"_23186":96080,"_2329":96081},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2802":57163,"_24435":57150,"_5":24767,"_17116":96083,"_23186":96084,"_2329":96085},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2802":57164,"_24435":57150,"_5":24767,"_17116":96087,"_23186":96088,"_2329":96089},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2802":57165,"_24435":57150,"_5":24767,"_17116":96091,"_23186":96092,"_2329":42403},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2802":57166,"_24435":57150,"_5":24767,"_17116":96094,"_23186":96095,"_2329":96096},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2802":57167,"_24435":57150,"_5":24767,"_17116":96098,"_23186":96099,"_2329":96100},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2802":57168,"_24435":57150,"_5":24767,"_17116":96102,"_23186":96103,"_2329":96104},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2802":57169,"_24435":57150,"_17116":96106,"_5":17011,"_23186":57150,"_2329":96107},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2802":57170,"_24435":57150,"_17116":96109,"_5":17011,"_23186":96043,"_2329":96110},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2802":57171,"_24435":57150,"_17116":96112,"_5":17011,"_23186":96043,"_2329":96113},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2802":57172,"_24435":57150,"_17116":96115,"_5":17011,"_23186":96050,"_2329":96116},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2802":57173,"_24435":57150,"_17116":96118,"_5":17011,"_23186":96054,"_2329":96119},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2802":57174,"_24435":57150,"_17116":96121,"_5":17011,"_23186":96058,"_2329":96122},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2802":57175,"_24435":57150,"_17116":96124,"_5":17011,"_23186":96062,"_2329":96125},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2802":57176,"_24435":57150,"_17116":96127,"_5":17011,"_23186":96066,"_2329":96128},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2802":57177,"_24435":57150,"_17116":96130,"_5":17011,"_23186":96074,"_2329":96131},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2802":57178,"_24435":57150,"_17116":96133,"_5":17011,"_23186":96074,"_2329":96134},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2802":57179,"_24435":57150,"_17116":96136,"_5":17011,"_23186":96077,"_2329":96137},[],"Campo de `settings.enrollment_settings`",{"_2802":57180,"_24435":57150,"_17116":96139,"_5":17011,"_23186":96077,"_2329":96140},[],"Decisión",{"_2802":57181,"_24435":57150,"_17116":96142,"_5":17011,"_23186":96077,"_2329":42454},[],{"_2802":57182,"_24435":57150,"_17116":96144,"_5":17011,"_23186":96077,"_2329":96145},[],"`EST_RFC7030` para estas operaciones.",{"_2802":57183,"_24435":57150,"_17116":96147,"_5":17011,"_23186":96077,"_2329":42460},[],{"_2802":57184,"_24435":57150,"_17116":96149,"_5":17011,"_23186":96077,"_2329":96150},[],"ID de la CA que firmará.",{"_2802":57185,"_24435":57150,"_17116":96152,"_5":17011,"_23186":96077,"_2329":42466},[],{"_2802":57186,"_24435":57150,"_17116":96154,"_5":17011,"_23186":96077,"_2329":96155},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2802":57187,"_24435":57150,"_17116":96157,"_5":17011,"_23186":96077,"_2329":42472},[],{"_2802":57188,"_24435":57150,"_17116":96159,"_5":17011,"_23186":96077,"_2329":96160},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2802":57189,"_24435":57150,"_17116":96162,"_5":17011,"_23186":96077,"_2329":42478},[],{"_2802":57190,"_24435":57150,"_17116":96164,"_5":17011,"_23186":96077,"_2329":96165},[],"Uno de los cuatro modos de autenticación.",{"_2802":57191,"_24435":57150,"_17116":96167,"_5":17011,"_23186":96077,"_2329":96168},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2802":57192,"_24435":57150,"_17116":96170,"_5":17011,"_23186":96080,"_2329":96171},[],"Los bloques son independientes:",{"_2802":57193,"_24435":57150,"_17116":96173,"_5":17011,"_23186":96080,"_2329":96174},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2802":57194,"_24435":57150,"_17116":96176,"_5":17011,"_23186":96080,"_2329":96177},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2802":57195,"_24435":57150,"_17116":96179,"_5":17011,"_23186":96080,"_2329":42496},[],{"_2802":57196,"_24435":57150,"_17116":96181,"_5":17011,"_23186":96080,"_2329":96182},[],"Control aplicado en la operación configurada",{"_2802":57197,"_24435":57150,"_17116":96184,"_5":17011,"_23186":96080,"_2329":42502},[],{"_2802":57198,"_24435":57150,"_17116":96186,"_5":17011,"_23186":96080,"_2329":96187},[],"Validación del certificado presentado.",{"_2802":57199,"_24435":57150,"_17116":96189,"_5":17011,"_23186":96080,"_2329":42508},[],{"_2802":57200,"_24435":57150,"_17116":96191,"_5":17011,"_23186":96080,"_2329":96192},[],"Autorización del webhook configurado.",{"_2802":57201,"_24435":57150,"_17116":96194,"_5":17011,"_23186":96080,"_2329":42514},[],{"_2802":57202,"_24435":57150,"_17116":96196,"_5":17011,"_23186":96080,"_2329":96197},[],"Validación del certificado y, después, aprobación del webhook.",{"_2802":57203,"_24435":57150,"_17116":96199,"_5":17011,"_23186":96080,"_2329":42520},[],{"_2802":57204,"_24435":57150,"_17116":96201,"_5":17011,"_23186":96080,"_2329":96202},[],"Sin autenticación del solicitante por el DMS.",{"_2802":57205,"_24435":57150,"_17116":96204,"_5":17011,"_23186":96080,"_2329":96205},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2802":57206,"_24435":57150,"_17116":96207,"_5":17011,"_23186":96080,"_2329":96208},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2802":57207,"_24435":57150,"_17116":96210,"_5":17011,"_23186":96080,"_2329":96211},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2802":57208,"_24435":57150,"_17116":96213,"_5":17011,"_23186":96080,"_2329":96214},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2802":57209,"_24435":57150,"_17116":96216,"_5":17011,"_23186":96080,"_2329":96217},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2802":57210,"_24435":57150,"_17116":96219,"_5":17011,"_23186":96084,"_2329":96220},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2802":57211,"_24435":57150,"_17116":96222,"_5":17011,"_23186":96088,"_2329":96223},[],"Campo de `settings.reenrollment_settings`",{"_2802":57212,"_24435":57150,"_17116":96225,"_5":17011,"_23186":96088,"_2329":96226},[],"Función",{"_2802":57213,"_24435":57150,"_17116":96228,"_5":17011,"_23186":96088,"_2329":42549},[],{"_2802":57214,"_24435":57150,"_17116":96230,"_5":17011,"_23186":96088,"_2329":96231},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2802":57215,"_24435":57150,"_17116":96233,"_5":17011,"_23186":96088,"_2329":42555},[],{"_2802":57216,"_24435":57150,"_17116":96235,"_5":17011,"_23186":96088,"_2329":96236},[],"Umbral operativo preventivo de monitorización.",{"_2802":57217,"_24435":57150,"_17116":96238,"_5":17011,"_23186":96088,"_2329":42561},[],{"_2802":57218,"_24435":57150,"_17116":96240,"_5":17011,"_23186":96088,"_2329":96241},[],"Umbral operativo crítico de monitorización.",{"_2802":57219,"_24435":57150,"_17116":96243,"_5":17011,"_23186":96088,"_2329":42567},[],{"_2802":57220,"_24435":57150,"_17116":96245,"_5":17011,"_23186":96088,"_2329":96246},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2802":57221,"_24435":57150,"_17116":96248,"_5":17011,"_23186":96088,"_2329":42573},[],{"_2802":57222,"_24435":57150,"_17116":96250,"_5":17011,"_23186":96088,"_2329":96251},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2802":57223,"_24435":57150,"_17116":96253,"_5":17011,"_23186":96088,"_2329":42579},[],{"_2802":57224,"_24435":57150,"_17116":96255,"_5":17011,"_23186":96088,"_2329":96256},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2802":57225,"_24435":57150,"_17116":96258,"_5":17011,"_23186":96088,"_2329":96259},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2802":57226,"_24435":57150,"_17116":96261,"_5":17011,"_23186":96092,"_2329":96262},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2802":57227,"_24435":57150,"_17116":96264,"_5":17011,"_23186":96095,"_2329":93915},[],{"_2802":57228,"_24435":57150,"_17116":96266,"_5":17011,"_23186":96095,"_2329":96267},[],"Qué publica",{"_2802":57229,"_24435":57150,"_17116":96269,"_5":17011,"_23186":96095,"_2329":42596},[],{"_2802":57230,"_24435":57150,"_17116":96271,"_5":17011,"_23186":96095,"_2329":96272},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2802":57231,"_24435":57150,"_17116":96274,"_5":17011,"_23186":96095,"_2329":42602},[],{"_2802":57232,"_24435":57150,"_17116":96276,"_5":17011,"_23186":96095,"_2329":96277},[],"Certificado de la CA emisora seleccionada.",{"_2802":57233,"_24435":57150,"_17116":96279,"_5":17011,"_23186":96095,"_2329":42608},[],{"_2802":57234,"_24435":57150,"_17116":96281,"_5":17011,"_23186":96095,"_2329":96282},[],"Certificados de las CAs elegidas explícitamente.",{"_2802":57235,"_24435":57150,"_17116":96284,"_5":17011,"_23186":96095,"_2329":96285},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2802":57236,"_24435":57150,"_17116":96287,"_5":17011,"_23186":96099,"_2329":96288},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2802":57237,"_24435":57150,"_17116":96290,"_5":17011,"_23186":96099,"_2329":96291},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2802":57238,"_24435":57150,"_17116":96293,"_5":17011,"_23186":96099,"_2329":96294},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2802":57239,"_24435":57150,"_17116":96296,"_5":17011,"_23186":96103,"_2329":96297},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2802":57240,"_24435":57240,"_5":12038,"_2329":96299,"_24770":96300,"_17116":96301,"_23186":57240},"Integra el cliente EST",[39813,94857,42088,95786,95961],[],{"_2802":57241,"_24435":57240,"_17116":96303,"_5":17011,"_23186":57240,"_2329":96304},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2802":57242,"_24435":57240,"_5":24767,"_17116":96306,"_23186":96307,"_2329":93558},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2802":57243,"_24435":57240,"_5":24767,"_17116":96309,"_23186":96310,"_2329":96311},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2802":57244,"_24435":57240,"_5":24767,"_17116":96313,"_23186":96314,"_2329":96315},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2802":57245,"_24435":57240,"_5":24767,"_17116":96317,"_23186":96318,"_2329":96319},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2802":57246,"_24435":57240,"_5":24767,"_17116":96321,"_23186":96322,"_2329":96323},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2802":57247,"_24435":57240,"_5":24767,"_17116":96325,"_23186":96326,"_2329":96327},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2802":57248,"_24435":57240,"_17116":96329,"_5":17011,"_23186":57240,"_2329":96330},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2802":57249,"_24435":57240,"_17116":96332,"_5":17011,"_23186":96307,"_2329":96333},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2802":57250,"_24435":57240,"_17116":96335,"_5":17011,"_23186":96307,"_2329":96336},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2802":57251,"_24435":57240,"_17116":96338,"_5":17011,"_23186":96307,"_2329":96339},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2802":57252,"_24435":57240,"_17116":96341,"_5":17011,"_23186":96310,"_2329":96342},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2802":57253,"_24435":57240,"_17116":96344,"_5":17011,"_23186":96310,"_2329":96345},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2802":57254,"_24435":57240,"_17116":96347,"_5":17011,"_23186":96314,"_2329":96348},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2802":57255,"_24435":57240,"_17116":96350,"_5":17011,"_23186":96314,"_2329":96351},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2802":57256,"_24435":57240,"_17116":96353,"_5":17011,"_23186":96318,"_2329":96354},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2802":57257,"_24435":57240,"_17116":96356,"_5":17011,"_23186":96318,"_2329":96357},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2802":57258,"_24435":57240,"_17116":96359,"_5":17011,"_23186":96322,"_2329":96360},[],"Para el caso de una raíz que emite directamente:",{"_2802":57259,"_24435":57240,"_17116":96362,"_5":17011,"_23186":96322,"_2329":96363},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2802":57260,"_24435":57240,"_17116":96365,"_5":17011,"_23186":96322,"_2329":96366},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2802":57261,"_24435":57240,"_17116":96368,"_5":17011,"_23186":96326,"_2329":96369},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2802":57262,"_24435":57262,"_5":12038,"_2329":96371,"_24770":96372,"_17116":96373,"_23186":57262},"Referencia EST",[39813,94857,42088,95786,95961],[],{"_2802":57263,"_24435":57262,"_17116":96375,"_5":17011,"_23186":57262,"_2329":96376},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2802":57264,"_24435":57262,"_5":24767,"_17116":96378,"_23186":96379,"_2329":96380},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2802":57265,"_24435":57262,"_5":24767,"_17116":96382,"_23186":96383,"_2329":18577},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2802":57266,"_24435":57262,"_5":24767,"_17116":96385,"_23186":96386,"_2329":21284},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2802":57267,"_24435":57262,"_5":24767,"_17116":96388,"_23186":96389,"_2329":21291},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2802":57268,"_24435":57262,"_5":24767,"_17116":96391,"_23186":96392,"_2329":20660},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2802":57269,"_24435":57262,"_5":24767,"_17116":96394,"_23186":96395,"_2329":96396},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2802":57270,"_24435":57262,"_5":24767,"_17116":96398,"_23186":96399,"_2329":96400},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2802":57271,"_24435":57262,"_5":24767,"_17116":96402,"_23186":96403,"_2329":96404},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2802":57272,"_24435":57262,"_17116":96406,"_5":17011,"_23186":57262,"_2329":96407},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2802":57273,"_24435":57262,"_17116":96409,"_5":17011,"_23186":96379,"_2329":96410},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2802":57274,"_24435":57262,"_17116":96412,"_5":17011,"_23186":96379,"_2329":94648},[],{"_2802":57275,"_24435":57262,"_17116":96414,"_5":17011,"_23186":96379,"_2329":96415},[],"Método",{"_2802":57276,"_24435":57262,"_17116":96417,"_5":17011,"_23186":96379,"_2329":96418},[],"Autenticación y condición",{"_2802":57277,"_24435":57262,"_17116":96420,"_5":17011,"_23186":96379,"_2329":42751},[],{"_2802":57278,"_24435":57262,"_17116":96422,"_5":17011,"_23186":96379,"_2329":42754},[],{"_2802":57279,"_24435":57262,"_17116":96424,"_5":17011,"_23186":96379,"_2329":96425},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2802":57280,"_24435":57262,"_17116":96427,"_5":17011,"_23186":96379,"_2329":42760},[],{"_2802":57281,"_24435":57262,"_17116":96429,"_5":17011,"_23186":96379,"_2329":42763},[],{"_2802":57282,"_24435":57262,"_17116":96431,"_5":17011,"_23186":96379,"_2329":96432},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2802":57283,"_24435":57262,"_17116":96434,"_5":17011,"_23186":96379,"_2329":42769},[],{"_2802":57284,"_24435":57262,"_17116":96436,"_5":17011,"_23186":96379,"_2329":42763},[],{"_2802":57285,"_24435":57262,"_17116":96438,"_5":17011,"_23186":96379,"_2329":96439},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2802":57286,"_24435":57262,"_17116":96441,"_5":17011,"_23186":96379,"_2329":42777},[],{"_2802":57287,"_24435":57262,"_17116":96443,"_5":17011,"_23186":96379,"_2329":42763},[],{"_2802":57288,"_24435":57262,"_17116":96445,"_5":17011,"_23186":96379,"_2329":96446},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2802":57289,"_24435":57262,"_17116":96448,"_5":17011,"_23186":96379,"_2329":96449},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2802":57290,"_24435":57262,"_17116":96451,"_5":17011,"_23186":96383,"_2329":96452},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2802":57291,"_24435":57262,"_17116":96454,"_5":17011,"_23186":96383,"_2329":96455},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2802":57292,"_24435":57262,"_17116":96457,"_5":17011,"_23186":96386,"_2329":96458},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2802":57293,"_24435":57262,"_17116":96460,"_5":17011,"_23186":96386,"_2329":96461},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2802":57294,"_24435":57262,"_17116":96463,"_5":17011,"_23186":96389,"_2329":96464},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2802":57295,"_24435":57262,"_17116":96466,"_5":17011,"_23186":96389,"_2329":96467},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2802":57296,"_24435":57262,"_17116":96469,"_5":17011,"_23186":96392,"_2329":96470},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2802":57297,"_24435":57262,"_17116":96472,"_5":17011,"_23186":96392,"_2329":96473},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2802":57298,"_24435":57262,"_17116":96475,"_5":17011,"_23186":96395,"_2329":96476},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2802":57299,"_24435":57262,"_17116":96478,"_5":17011,"_23186":96395,"_2329":96479},[],"Parte",{"_2802":57300,"_24435":57262,"_17116":96481,"_5":17011,"_23186":96395,"_2329":96482},[],"Contenido tras decodificar su Base64",{"_2802":57301,"_24435":57262,"_17116":96484,"_5":17011,"_23186":96395,"_2329":42821},[],{"_2802":57302,"_24435":57262,"_17116":96486,"_5":17011,"_23186":96395,"_2329":96487},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2802":57303,"_24435":57262,"_17116":96489,"_5":17011,"_23186":96395,"_2329":42827},[],{"_2802":57304,"_24435":57262,"_17116":96491,"_5":17011,"_23186":96395,"_2329":96492},[],"PKCS#7 DER con el certificado emitido.",{"_2802":57305,"_24435":57262,"_17116":96494,"_5":17011,"_23186":96395,"_2329":96495},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2802":57306,"_24435":57262,"_17116":96497,"_5":17011,"_23186":96399,"_2329":96498},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2802":57307,"_24435":57262,"_17116":96500,"_5":17011,"_23186":96399,"_2329":96501},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2802":57308,"_24435":57262,"_17116":96503,"_5":17011,"_23186":96399,"_2329":96504},[],"Convierte y comprueba el resultado:",{"_2802":57309,"_24435":57262,"_17116":96506,"_5":17011,"_23186":96399,"_2329":96507},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2802":57310,"_24435":57262,"_17116":96509,"_5":17011,"_23186":96403,"_2329":96510},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2802":57311,"_24435":57262,"_17116":96512,"_5":17011,"_23186":96403,"_2329":96513},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2802":57312,"_24435":57312,"_5":12038,"_2329":95961,"_24770":96515,"_17116":96516,"_23186":57312},[39813,94857,42088,95786,95961],[],{"_2802":57313,"_24435":57312,"_17116":96518,"_5":17011,"_23186":57312,"_2329":96519},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2802":57314,"_24435":57312,"_5":24767,"_17116":96521,"_23186":96522,"_2329":96523},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2802":57315,"_24435":57312,"_5":24767,"_17116":96525,"_23186":96526,"_2329":96527},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2802":57316,"_24435":57312,"_5":24767,"_17116":96529,"_23186":96530,"_2329":96531},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2802":57317,"_24435":57312,"_5":24767,"_17116":96533,"_23186":96534,"_2329":96535},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2802":57318,"_24435":57312,"_17116":96537,"_5":17011,"_23186":57312,"_2329":96538},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2802":57319,"_24435":57312,"_17116":96540,"_5":17011,"_23186":96522,"_2329":96541},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2802":57320,"_24435":57312,"_17116":96543,"_5":17011,"_23186":96522,"_2329":96544},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2802":57321,"_24435":57312,"_17116":96546,"_5":17011,"_23186":96522,"_2329":96547},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2802":57322,"_24435":57312,"_17116":96549,"_5":17011,"_23186":96522,"_2329":96550},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2802":57323,"_24435":57312,"_17116":96552,"_5":17011,"_23186":96522,"_2329":96553},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2802":57324,"_24435":57312,"_17116":96555,"_5":17011,"_23186":96522,"_2329":96556},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2802":57325,"_24435":57312,"_17116":96558,"_5":17011,"_23186":96526,"_2329":96559},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2802":57326,"_24435":57312,"_17116":96561,"_5":17011,"_23186":96526,"_2329":96562},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2802":57327,"_24435":57312,"_17116":96564,"_5":17011,"_23186":96526,"_2329":96565},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2802":57328,"_24435":57312,"_17116":96567,"_5":17011,"_23186":96526,"_2329":96568},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2802":57329,"_24435":57312,"_17116":96570,"_5":17011,"_23186":96530,"_2329":96571},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2802":57330,"_24435":57312,"_17116":96573,"_5":17011,"_23186":96530,"_2329":96574},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2802":57331,"_24435":57312,"_17116":96576,"_5":17011,"_23186":96530,"_2329":96577},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2802":57332,"_24435":57312,"_17116":96579,"_5":17011,"_23186":96530,"_2329":96580},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2802":57333,"_24435":57312,"_17116":96582,"_5":17011,"_23186":96534,"_2329":96583},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2802":57334,"_24435":57312,"_17116":96585,"_5":17011,"_23186":96534,"_2329":96586},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2802":57335,"_24435":57335,"_5":12038,"_2329":96588,"_24770":96589,"_17116":96590,"_23186":57335},"Estrategias de aprovisionamiento",[39813,94857,42088,95786,95961],[],{"_2802":57336,"_24435":57335,"_17116":96592,"_5":17011,"_23186":57335,"_2329":96593},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2802":57337,"_24435":57335,"_5":24767,"_17116":96595,"_23186":96596,"_2329":96597},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2802":57338,"_24435":57335,"_5":24767,"_17116":96599,"_23186":96600,"_2329":96601},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2802":57339,"_24435":57335,"_5":24767,"_17116":96603,"_23186":96604,"_2329":96605},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2802":57340,"_24435":57335,"_5":24767,"_17116":96607,"_23186":96608,"_2329":96609},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2802":57341,"_24435":57335,"_5":24767,"_17116":96611,"_23186":96612,"_2329":96613},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2802":57342,"_24435":57335,"_17116":96615,"_5":17011,"_23186":57335,"_2329":96616},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2802":57343,"_24435":57335,"_17116":96618,"_5":17011,"_23186":96596,"_2329":96619},[],"Recorrido",{"_2802":57344,"_24435":57335,"_17116":96621,"_5":17011,"_23186":96596,"_2329":96622},[],"Cuándo existe el dispositivo",{"_2802":57345,"_24435":57335,"_17116":96624,"_5":17011,"_23186":96596,"_2329":96625},[],"Qué compruebas",{"_2802":57346,"_24435":57335,"_17116":96627,"_5":17011,"_23186":96596,"_2329":96628},[],"Asignación manual",{"_2802":57347,"_24435":57335,"_17116":96630,"_5":17011,"_23186":96596,"_2329":96631},[],"El operador lo crea antes de asociar un certificado.",{"_2802":57348,"_24435":57335,"_17116":96633,"_5":17011,"_23186":96596,"_2329":96634},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2802":57349,"_24435":57335,"_17116":96636,"_5":17011,"_23186":96596,"_2329":96637},[],"EST con `JITP`",{"_2802":57350,"_24435":57335,"_17116":96639,"_5":17011,"_23186":96596,"_2329":96640},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2802":57351,"_24435":57335,"_17116":96642,"_5":17011,"_23186":96596,"_2329":96643},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2802":57352,"_24435":57335,"_17116":96645,"_5":17011,"_23186":96596,"_2329":96646},[],"EST con `PRE_REGISTRATION`",{"_2802":57353,"_24435":57335,"_17116":96648,"_5":17011,"_23186":96596,"_2329":96649},[],"Debe existir antes de `/simpleenroll`.",{"_2802":57354,"_24435":57335,"_17116":96651,"_5":17011,"_23186":96596,"_2329":96652},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2802":57355,"_24435":57335,"_17116":96654,"_5":17011,"_23186":96596,"_2329":96655},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2802":57356,"_24435":57335,"_17116":96657,"_5":17011,"_23186":96596,"_2329":96658},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2802":57357,"_24435":57335,"_17116":96660,"_5":17011,"_23186":96600,"_2329":96661},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2802":57358,"_24435":57335,"_17116":96663,"_5":17011,"_23186":96600,"_2329":96664},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2802":57359,"_24435":57335,"_17116":96666,"_5":17011,"_23186":96600,"_2329":96667},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2802":57360,"_24435":57335,"_17116":96669,"_5":17011,"_23186":96604,"_2329":96670},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2802":57361,"_24435":57335,"_17116":96672,"_5":17011,"_23186":96604,"_2329":96673},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2802":57362,"_24435":57335,"_17116":96675,"_5":17011,"_23186":96604,"_2329":96676},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2802":57363,"_24435":57335,"_17116":96678,"_5":17011,"_23186":96604,"_2329":96679},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2802":57364,"_24435":57335,"_17116":96681,"_5":17011,"_23186":96604,"_2329":96682},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2802":57365,"_24435":57335,"_17116":96684,"_5":17011,"_23186":96604,"_2329":96685},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2802":57366,"_24435":57335,"_17116":96687,"_5":17011,"_23186":96608,"_2329":93915},[],{"_2802":57367,"_24435":57335,"_17116":96689,"_5":17011,"_23186":96608,"_2329":96690},[],"Material que atraviesa EST",{"_2802":57368,"_24435":57335,"_17116":96692,"_5":17011,"_23186":96608,"_2329":96693},[],"Clave generada por el dispositivo",{"_2802":57369,"_24435":57335,"_17116":96695,"_5":17011,"_23186":96608,"_2329":96696},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2802":57370,"_24435":57335,"_17116":96698,"_5":17011,"_23186":96608,"_2329":96699},[],"Clave ya disponible en el dispositivo",{"_2802":57371,"_24435":57335,"_17116":96701,"_5":17011,"_23186":96608,"_2329":96702},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2802":57372,"_24435":57335,"_17116":96704,"_5":17011,"_23186":96608,"_2329":42403},[],{"_2802":57373,"_24435":57335,"_17116":96706,"_5":17011,"_23186":96608,"_2329":96707},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2802":57374,"_24435":57335,"_17116":96709,"_5":17011,"_23186":96608,"_2329":96710},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2802":57375,"_24435":57335,"_17116":96712,"_5":17011,"_23186":96612,"_2329":96713},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2802":57376,"_24435":57376,"_5":12038,"_2329":96715,"_24770":96716,"_17116":96717,"_23186":57376},"Renovación y recuperación",[39813,94857,42088,95786,95961],[],{"_2802":57377,"_24435":57376,"_17116":96719,"_5":17011,"_23186":57376,"_2329":96720},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2802":57378,"_24435":57376,"_5":24767,"_17116":96722,"_23186":96723,"_2329":96724},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2802":57379,"_24435":57376,"_5":24767,"_17116":96726,"_23186":96727,"_2329":96728},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2802":57380,"_24435":57376,"_5":24767,"_17116":96730,"_23186":96731,"_2329":96732},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2802":57381,"_24435":57376,"_5":24767,"_17116":96734,"_23186":96735,"_2329":96736},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2802":57382,"_24435":57376,"_5":24767,"_17116":96738,"_23186":96739,"_2329":96740},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2802":57383,"_24435":57376,"_17116":96742,"_5":17011,"_23186":57376,"_2329":96743},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2802":57384,"_24435":57376,"_17116":96745,"_5":17011,"_23186":96723,"_2329":96746},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2802":57385,"_24435":57376,"_17116":96748,"_5":17011,"_23186":96723,"_2329":96749},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2802":57386,"_24435":57376,"_17116":96751,"_5":17011,"_23186":96723,"_2329":96752},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2802":57387,"_24435":57376,"_17116":96754,"_5":17011,"_23186":96723,"_2329":96755},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2802":57388,"_24435":57376,"_17116":96757,"_5":17011,"_23186":96727,"_2329":96758},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2802":57389,"_24435":57376,"_17116":96760,"_5":17011,"_23186":96727,"_2329":96761},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2802":57390,"_24435":57376,"_17116":96763,"_5":17011,"_23186":96731,"_2329":96764},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2802":57391,"_24435":57376,"_17116":96766,"_5":17011,"_23186":96731,"_2329":96767},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2802":57392,"_24435":57376,"_17116":96769,"_5":17011,"_23186":96731,"_2329":96770},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2802":57393,"_24435":57376,"_17116":96772,"_5":17011,"_23186":96735,"_2329":96773},[],"Situación",{"_2802":57394,"_24435":57376,"_17116":96775,"_5":17011,"_23186":96735,"_2329":96776},[],"Procedimiento",{"_2802":57395,"_24435":57376,"_17116":96778,"_5":17011,"_23186":96735,"_2329":96779},[],"Certificado vigente, fuera de ventana",{"_2802":57396,"_24435":57376,"_17116":96781,"_5":17011,"_23186":96735,"_2329":96782},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2802":57397,"_24435":57376,"_17116":96784,"_5":17011,"_23186":96735,"_2329":96785},[],"Certificado vencido, clave disponible",{"_2802":57398,"_24435":57376,"_17116":96787,"_5":17011,"_23186":96735,"_2329":96788},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2802":57399,"_24435":57376,"_17116":96790,"_5":17011,"_23186":96735,"_2329":96791},[],"Renovación por webhook o `NO_AUTH`",{"_2802":57400,"_24435":57376,"_17116":96793,"_5":17011,"_23186":96735,"_2329":96794},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2802":57401,"_24435":57376,"_17116":96796,"_5":17011,"_23186":96735,"_2329":96797},[],"Clave perdida o inaccesible",{"_2802":57402,"_24435":57376,"_17116":96799,"_5":17011,"_23186":96735,"_2329":96800},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2802":57403,"_24435":57376,"_17116":96802,"_5":17011,"_23186":96735,"_2329":96803},[],"Identidad actual revocada",{"_2802":57404,"_24435":57376,"_17116":96805,"_5":17011,"_23186":96735,"_2329":96806},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2802":57405,"_24435":57376,"_17116":96808,"_5":17011,"_23186":96735,"_2329":96809},[],"Dispositivo sin identidad",{"_2802":57406,"_24435":57376,"_17116":96811,"_5":17011,"_23186":96735,"_2329":96812},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2802":57407,"_24435":57376,"_17116":96814,"_5":17011,"_23186":96735,"_2329":96815},[],"Dispositivo retirado",{"_2802":57408,"_24435":57376,"_17116":96817,"_5":17011,"_23186":96735,"_2329":96818},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2802":57409,"_24435":57376,"_17116":96820,"_5":17011,"_23186":96735,"_2329":96821},[],"Timeout, HTTP 500 o fallo de instalación",{"_2802":57410,"_24435":57376,"_17116":96823,"_5":17011,"_23186":96735,"_2329":96824},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2802":57411,"_24435":57376,"_17116":96826,"_5":17011,"_23186":96739,"_2329":96827},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2802":57412,"_24435":57376,"_17116":96829,"_5":17011,"_23186":96739,"_2329":96830},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2802":57413,"_24435":57413,"_5":12038,"_2329":96832,"_24770":96833,"_17116":96834,"_23186":57413},"Diagnóstico de enrolamiento",[39813,94857,42088,95786,95961],[],{"_2802":57414,"_24435":57413,"_17116":96836,"_5":17011,"_23186":57413,"_2329":96837},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2802":57415,"_24435":57413,"_5":24767,"_17116":96839,"_23186":96840,"_2329":96841},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2802":57416,"_24435":57413,"_5":24767,"_17116":96843,"_23186":96844,"_2329":96845},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2802":57417,"_24435":57413,"_5":24767,"_17116":96847,"_23186":96848,"_2329":96404},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2802":57418,"_24435":57413,"_5":24767,"_17116":96850,"_23186":96851,"_2329":96852},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2802":57419,"_24435":57413,"_17116":96854,"_5":17011,"_23186":57413,"_2329":96855},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2802":57420,"_24435":57413,"_17116":96857,"_5":17011,"_23186":96844,"_2329":96858},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2802":57421,"_24435":57413,"_17116":96860,"_5":17011,"_23186":96844,"_2329":96861},[],"Síntoma o mensaje",{"_2802":57422,"_24435":57413,"_17116":96863,"_5":17011,"_23186":96844,"_2329":96864},[],"Qué revisar",{"_2802":57423,"_24435":57413,"_17116":96866,"_5":17011,"_23186":96844,"_2329":96867},[],"curl rechaza TLS, nombre o emisor",{"_2802":57424,"_24435":57413,"_17116":96869,"_5":17011,"_23186":96844,"_2329":96870},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2802":57425,"_24435":57413,"_17116":96872,"_5":17011,"_23186":96844,"_2329":96873},[],"404 o APS ausente",{"_2802":57426,"_24435":57413,"_17116":96875,"_5":17011,"_23186":96844,"_2329":96876},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2802":57427,"_24435":57413,"_17116":96878,"_5":17011,"_23186":96844,"_2329":96879},[],"400, error de CSR o formato",{"_2802":57428,"_24435":57413,"_17116":96881,"_5":17011,"_23186":96844,"_2329":96882},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2802":57429,"_24435":57413,"_17116":96884,"_5":17011,"_23186":96844,"_2329":96885},[],"Credencial ausente o certificado no válido",{"_2802":57430,"_24435":57413,"_17116":96887,"_5":17011,"_23186":96844,"_2329":96888},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2802":57431,"_24435":57413,"_17116":96890,"_5":17011,"_23186":96844,"_2329":96891},[],"Webhook deniega, expira o responde sin autorización",{"_2802":57432,"_24435":57413,"_17116":96893,"_5":17011,"_23186":96844,"_2329":96894},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2802":57433,"_24435":57413,"_17116":96896,"_5":17011,"_23186":96844,"_2329":43234},[],{"_2802":57434,"_24435":57413,"_17116":96898,"_5":17011,"_23186":96844,"_2329":96899},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2802":57435,"_24435":57413,"_17116":96901,"_5":17011,"_23186":96844,"_2329":43240},[],{"_2802":57436,"_24435":57413,"_17116":96903,"_5":17011,"_23186":96844,"_2329":96904},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2802":57437,"_24435":57413,"_17116":96906,"_5":17011,"_23186":96844,"_2329":96907},[],"DMS propietario distinto",{"_2802":57438,"_24435":57413,"_17116":96909,"_5":17011,"_23186":96844,"_2329":96910},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2802":57439,"_24435":57413,"_17116":96912,"_5":17011,"_23186":96844,"_2329":43252},[],{"_2802":57440,"_24435":57413,"_17116":96914,"_5":17011,"_23186":96844,"_2329":96915},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2802":57441,"_24435":57413,"_17116":96917,"_5":17011,"_23186":96844,"_2329":43258},[],{"_2802":57442,"_24435":57413,"_17116":96919,"_5":17011,"_23186":96844,"_2329":96920},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2802":57443,"_24435":57413,"_17116":96922,"_5":17011,"_23186":96844,"_2329":96923},[],"Certificado actual revocado",{"_2802":57444,"_24435":57413,"_17116":96925,"_5":17011,"_23186":96844,"_2329":96926},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2802":57445,"_24435":57413,"_17116":96928,"_5":17011,"_23186":96844,"_2329":96929},[],"Error de CA, perfil o firma",{"_2802":57446,"_24435":57413,"_17116":96931,"_5":17011,"_23186":96844,"_2329":96932},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2802":57447,"_24435":57413,"_17116":96934,"_5":17011,"_23186":96844,"_2329":96935},[],"HTTP 200 sin conexión del dispositivo",{"_2802":57448,"_24435":57413,"_17116":96937,"_5":17011,"_23186":96844,"_2329":96938},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2802":57449,"_24435":57413,"_17116":96940,"_5":17011,"_23186":96844,"_2329":96941},[],"Timeout o error después de emitir",{"_2802":57450,"_24435":57413,"_17116":96943,"_5":17011,"_23186":96844,"_2329":96944},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2802":57451,"_24435":57413,"_17116":96946,"_5":17011,"_23186":96848,"_2329":96947},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2802":57452,"_24435":57413,"_17116":96949,"_5":17011,"_23186":96848,"_2329":96950},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2802":57453,"_24435":57413,"_17116":96952,"_5":17011,"_23186":96851,"_2329":96953},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2802":57454,"_24435":57413,"_17116":96955,"_5":17011,"_23186":96851,"_2329":96956},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2802":57455,"_24435":57413,"_17116":96958,"_5":17011,"_23186":96851,"_2329":96959},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2802":57456,"_24435":57413,"_17116":96961,"_5":17011,"_23186":96851,"_2329":96962},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2802":57457,"_24435":57413,"_17116":96964,"_5":17011,"_23186":96851,"_2329":96965},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2802":57458,"_24435":57413,"_17116":96967,"_5":17011,"_23186":96851,"_2329":96968},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2802":57459,"_24435":57413,"_17116":96970,"_5":17011,"_23186":96851,"_2329":96971},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2802":57460,"_24435":57460,"_5":12038,"_2329":96973,"_24770":96974,"_17116":96975,"_23186":57460},"Distribución y actualización de confianza",[39813,94857,42088,95786,95961],[],{"_2802":57461,"_24435":57460,"_17116":96977,"_5":17011,"_23186":57460,"_2329":96978},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2802":57462,"_24435":57460,"_5":24767,"_17116":96980,"_23186":96981,"_2329":96982},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2802":57463,"_24435":57460,"_5":24767,"_17116":96984,"_23186":96985,"_2329":96986},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2802":57464,"_24435":57460,"_5":24767,"_17116":96988,"_23186":96989,"_2329":96990},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2802":57465,"_24435":57460,"_5":24767,"_17116":96992,"_23186":96993,"_2329":96994},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2802":57466,"_24435":57460,"_5":24767,"_17116":96996,"_23186":96997,"_2329":96998},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2802":57467,"_24435":57460,"_17116":97000,"_5":17011,"_23186":57460,"_2329":97001},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2802":57468,"_24435":57460,"_17116":97003,"_5":17011,"_23186":96981,"_2329":97004},[],"Relación",{"_2802":57469,"_24435":57460,"_17116":97006,"_5":17011,"_23186":96981,"_2329":97007},[],"Material que prepara el responsable",{"_2802":57470,"_24435":57460,"_17116":97009,"_5":17011,"_23186":96981,"_2329":97010},[],"Dispositivo → servidor EST",{"_2802":57471,"_24435":57460,"_17116":97012,"_5":17011,"_23186":96981,"_2329":97013},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2802":57472,"_24435":57460,"_17116":97015,"_5":17011,"_23186":96981,"_2329":97016},[],"DMS → solicitante",{"_2802":57473,"_24435":57460,"_17116":97018,"_5":17011,"_23186":96981,"_2329":97019},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2802":57474,"_24435":57460,"_17116":97021,"_5":17011,"_23186":96981,"_2329":97022},[],"Consumidor → dispositivo",{"_2802":57475,"_24435":57460,"_17116":97024,"_5":17011,"_23186":96981,"_2329":97025},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2802":57476,"_24435":57460,"_17116":97027,"_5":17011,"_23186":96981,"_2329":97028},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2802":57477,"_24435":57460,"_17116":97030,"_5":17011,"_23186":96985,"_2329":97031},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2802":57478,"_24435":57460,"_17116":97033,"_5":17011,"_23186":96985,"_2329":97034},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2802":57479,"_24435":57460,"_17116":97036,"_5":17011,"_23186":96989,"_2329":97037},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2802":57480,"_24435":57460,"_17116":97039,"_5":17011,"_23186":96989,"_2329":97040},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2802":57481,"_24435":57460,"_17116":97042,"_5":17011,"_23186":96989,"_2329":97043},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2802":57482,"_24435":57460,"_17116":97045,"_5":17011,"_23186":96989,"_2329":97046},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2802":57483,"_24435":57460,"_17116":97048,"_5":17011,"_23186":96989,"_2329":97049},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2802":57484,"_24435":57460,"_17116":97051,"_5":17011,"_23186":96989,"_2329":97052},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2802":57485,"_24435":57460,"_17116":97054,"_5":17011,"_23186":96993,"_2329":97055},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2802":57486,"_24435":57460,"_17116":97057,"_5":17011,"_23186":96993,"_2329":97058},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2802":57487,"_24435":57460,"_17116":97060,"_5":17011,"_23186":96993,"_2329":97061},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2802":57488,"_24435":57460,"_17116":97063,"_5":17011,"_23186":96997,"_2329":97064},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2802":57489,"_24435":57489,"_5":12038,"_2329":43407,"_24770":97066,"_17116":97068,"_23186":57489},[39813,94857,42088,95786,97067],"Integraciones",[],{"_2802":57490,"_24435":57489,"_17116":97070,"_5":17011,"_23186":57489,"_2329":97071},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2802":57491,"_24435":57489,"_5":24767,"_17116":97073,"_23186":97074,"_2329":97075},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2802":57492,"_24435":57489,"_5":24767,"_17116":97077,"_23186":97078,"_2329":97079},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2802":57493,"_24435":57489,"_5":24767,"_17116":97081,"_23186":97082,"_2329":97083},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2802":57494,"_24435":57489,"_5":24767,"_17116":97085,"_23186":97086,"_2329":97087},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2802":57495,"_24435":57489,"_5":24767,"_17116":97089,"_23186":97090,"_2329":97091},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2802":57496,"_24435":57489,"_5":24767,"_17116":97093,"_23186":97094,"_2329":97095},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2802":57497,"_24435":57489,"_5":24767,"_17116":97097,"_23186":97098,"_2329":43441},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2802":57498,"_24435":57489,"_5":24767,"_17116":97100,"_23186":97101,"_2329":43445},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2802":57499,"_24435":57489,"_5":24767,"_17116":97103,"_23186":97104,"_2329":97105},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2802":57500,"_24435":57489,"_5":24767,"_17116":97107,"_23186":97108,"_2329":97109},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2802":57501,"_24435":57489,"_5":24767,"_17116":97111,"_23186":97112,"_2329":97113},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2802":57502,"_24435":57489,"_5":24767,"_17116":97115,"_23186":97116,"_2329":97117},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2802":57503,"_24435":57489,"_5":24767,"_17116":97119,"_23186":97120,"_2329":97121},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2802":57504,"_24435":57489,"_5":24767,"_17116":97123,"_23186":97124,"_2329":97125},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2802":57505,"_24435":57489,"_5":24767,"_17116":97127,"_23186":97128,"_2329":97129},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2802":57506,"_24435":57489,"_5":24767,"_17116":97131,"_23186":97132,"_2329":97133},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2802":57507,"_24435":57489,"_5":24767,"_17116":97135,"_23186":97136,"_2329":97137},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2802":57508,"_24435":57489,"_5":24767,"_17116":97139,"_23186":97140,"_2329":97141},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2802":57509,"_24435":57489,"_5":24767,"_17116":97143,"_23186":97144,"_2329":97145},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2802":57510,"_24435":57489,"_5":24767,"_17116":97147,"_23186":97148,"_2329":97149},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2802":57511,"_24435":57489,"_17116":97151,"_5":17011,"_23186":57489,"_2329":97152},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2802":57512,"_24435":57489,"_17116":97154,"_5":17011,"_23186":57489,"_2329":97155},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2802":57513,"_24435":57489,"_17116":97157,"_5":17011,"_23186":57489,"_2329":97158},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2802":57514,"_24435":57489,"_17116":97160,"_5":17011,"_23186":97074,"_2329":97161},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2802":57515,"_24435":57489,"_17116":97163,"_5":17011,"_23186":97074,"_2329":97164},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2802":57516,"_24435":57489,"_17116":97166,"_5":17011,"_23186":97074,"_2329":97167},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2802":57517,"_24435":57489,"_17116":97169,"_5":17011,"_23186":97074,"_2329":97170},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2802":57518,"_24435":57489,"_17116":97172,"_5":17011,"_23186":97078,"_2329":97173},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2802":57519,"_24435":57489,"_17116":97175,"_5":17011,"_23186":97082,"_2329":97176},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2802":57520,"_24435":57489,"_17116":97178,"_5":17011,"_23186":97082,"_2329":97179},[],"Acción IAM",{"_2802":57521,"_24435":57489,"_17116":97181,"_5":17011,"_23186":97082,"_2329":93921},[],{"_2802":57522,"_24435":57489,"_17116":97183,"_5":17011,"_23186":97082,"_2329":43528},[],{"_2802":57523,"_24435":57489,"_17116":97185,"_5":17011,"_23186":97082,"_2329":97186},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2802":57524,"_24435":57489,"_17116":97188,"_5":17011,"_23186":97082,"_2329":43534},[],{"_2802":57525,"_24435":57489,"_17116":97190,"_5":17011,"_23186":97082,"_2329":97191},[],"Registrar la CA en AWS IoT",{"_2802":57526,"_24435":57489,"_17116":97193,"_5":17011,"_23186":97082,"_2329":43540},[],{"_2802":57527,"_24435":57489,"_17116":97195,"_5":17011,"_23186":97082,"_2329":97196},[],"Consultar el estado del registro de la CA",{"_2802":57528,"_24435":57489,"_17116":97198,"_5":17011,"_23186":97082,"_2329":43546},[],{"_2802":57529,"_24435":57489,"_17116":97200,"_5":17011,"_23186":97082,"_2329":97201},[],"Crear o actualizar Things en IoT Core",{"_2802":57530,"_24435":57489,"_17116":97203,"_5":17011,"_23186":97082,"_2329":43552},[],{"_2802":57531,"_24435":57489,"_17116":97205,"_5":17011,"_23186":97082,"_2329":97206},[],"Aprovisionar Things mediante plantilla",{"_2802":57532,"_24435":57489,"_17116":97208,"_5":17011,"_23186":97082,"_2329":43558},[],{"_2802":57533,"_24435":57489,"_17116":97210,"_5":17011,"_23186":97082,"_2329":97211},[],"Registrar certificados de dispositivo",{"_2802":57534,"_24435":57489,"_17116":97213,"_5":17011,"_23186":97082,"_2329":43564},[],{"_2802":57535,"_24435":57489,"_17116":97215,"_5":17011,"_23186":97082,"_2329":97216},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2802":57536,"_24435":57489,"_17116":97218,"_5":17011,"_23186":97082,"_2329":43570},[],{"_2802":57537,"_24435":57489,"_17116":97220,"_5":17011,"_23186":97082,"_2329":97221},[],"Crear y adjuntar políticas IoT",{"_2802":57538,"_24435":57489,"_17116":97223,"_5":17011,"_23186":97082,"_2329":43576},[],{"_2802":57539,"_24435":57489,"_17116":97225,"_5":17011,"_23186":97082,"_2329":97226},[],"Gestionar grupos de Things",{"_2802":57540,"_24435":57489,"_17116":97228,"_5":17011,"_23186":97082,"_2329":43582},[],{"_2802":57541,"_24435":57489,"_17116":97230,"_5":17011,"_23186":97082,"_2329":97231},[],"Crear plantillas JITP",{"_2802":57542,"_24435":57489,"_17116":97233,"_5":17011,"_23186":97082,"_2329":43588},[],{"_2802":57543,"_24435":57489,"_17116":97235,"_5":17011,"_23186":97082,"_2329":97236},[],"Leer y escribir el Device Shadow",{"_2802":57544,"_24435":57489,"_17116":97238,"_5":17011,"_23186":97082,"_2329":97239},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2802":57545,"_24435":57489,"_17116":97241,"_5":17011,"_23186":97086,"_2329":97242},[],"Parámetro",{"_2802":57546,"_24435":57489,"_17116":97244,"_5":17011,"_23186":97086,"_2329":97245},[],"Tipo",{"_2802":57547,"_24435":57489,"_17116":97247,"_5":17011,"_23186":97086,"_2329":97248},[],"Requerido",{"_2802":57548,"_24435":57489,"_17116":97250,"_5":17011,"_23186":97086,"_2329":97251},[],"Descripción",{"_2802":57549,"_24435":57489,"_17116":97253,"_5":17011,"_23186":97086,"_2329":43609},[],{"_2802":57550,"_24435":57489,"_17116":97255,"_5":17011,"_23186":97086,"_2329":20412},[],{"_2802":57551,"_24435":57489,"_17116":97257,"_5":17011,"_23186":97086,"_2329":97258},[],"Sí",{"_2802":57552,"_24435":57489,"_17116":97260,"_5":17011,"_23186":97086,"_2329":97261},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2802":57553,"_24435":57489,"_17116":97263,"_5":17011,"_23186":97086,"_2329":43620},[],{"_2802":57554,"_24435":57489,"_17116":97265,"_5":17011,"_23186":97086,"_2329":20412},[],{"_2802":57555,"_24435":57489,"_17116":97267,"_5":17011,"_23186":97086,"_2329":97258},[],{"_2802":57556,"_24435":57489,"_17116":97269,"_5":17011,"_23186":97086,"_2329":97270},[],"Región AWS donde opera el conector.",{"_2802":57557,"_24435":57489,"_17116":97272,"_5":17011,"_23186":97086,"_2329":43630},[],{"_2802":57558,"_24435":57489,"_17116":97274,"_5":17011,"_23186":97086,"_2329":20412},[],{"_2802":57559,"_24435":57489,"_17116":97276,"_5":17011,"_23186":97086,"_2329":97258},[],{"_2802":57560,"_24435":57489,"_17116":97278,"_5":17011,"_23186":97086,"_2329":97279},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2802":57561,"_24435":57489,"_17116":97281,"_5":17011,"_23186":97086,"_2329":43640},[],{"_2802":57562,"_24435":57489,"_17116":97283,"_5":17011,"_23186":97086,"_2329":20412},[],{"_2802":57563,"_24435":57489,"_17116":97285,"_5":17011,"_23186":97086,"_2329":97286},[],"Solo con `auth_method=static`",{"_2802":57564,"_24435":57489,"_17116":97288,"_5":17011,"_23186":97086,"_2329":97289},[],"Clave de acceso AWS.",{"_2802":57565,"_24435":57489,"_17116":97291,"_5":17011,"_23186":97086,"_2329":43651},[],{"_2802":57566,"_24435":57489,"_17116":97293,"_5":17011,"_23186":97086,"_2329":20412},[],{"_2802":57567,"_24435":57489,"_17116":97295,"_5":17011,"_23186":97086,"_2329":97286},[],{"_2802":57568,"_24435":57489,"_17116":97297,"_5":17011,"_23186":97086,"_2329":97298},[],"Clave secreta AWS.",{"_2802":57569,"_24435":57489,"_17116":97300,"_5":17011,"_23186":97086,"_2329":43661},[],{"_2802":57570,"_24435":57489,"_17116":97302,"_5":17011,"_23186":97086,"_2329":20412},[],{"_2802":57571,"_24435":57489,"_17116":97304,"_5":17011,"_23186":97086,"_2329":43666},[],{"_2802":57572,"_24435":57489,"_17116":97306,"_5":17011,"_23186":97086,"_2329":97307},[],"Token de sesión (con `auth_method=static`).",{"_2802":57573,"_24435":57489,"_17116":97309,"_5":17011,"_23186":97086,"_2329":43672},[],{"_2802":57574,"_24435":57489,"_17116":97311,"_5":17011,"_23186":97086,"_2329":20412},[],{"_2802":57575,"_24435":57489,"_17116":97313,"_5":17011,"_23186":97086,"_2329":97314},[],"Solo con `auth_method=role`",{"_2802":57576,"_24435":57489,"_17116":97316,"_5":17011,"_23186":97086,"_2329":97317},[],"ARN del rol a asumir.",{"_2802":57577,"_24435":57489,"_17116":97319,"_5":17011,"_23186":97086,"_2329":43683},[],{"_2802":57578,"_24435":57489,"_17116":97321,"_5":17011,"_23186":97086,"_2329":20412},[],{"_2802":57579,"_24435":57489,"_17116":97323,"_5":17011,"_23186":97086,"_2329":43666},[],{"_2802":57580,"_24435":57489,"_17116":97325,"_5":17011,"_23186":97086,"_2329":97326},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2802":57581,"_24435":57489,"_17116":97328,"_5":17011,"_23186":97086,"_2329":43693},[],{"_2802":57582,"_24435":57489,"_17116":97330,"_5":17011,"_23186":97086,"_2329":14414},[],{"_2802":57583,"_24435":57489,"_17116":97332,"_5":17011,"_23186":97086,"_2329":97258},[],{"_2802":57584,"_24435":57489,"_17116":97334,"_5":17011,"_23186":97086,"_2329":97335},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2802":57585,"_24435":57489,"_17116":97337,"_5":17011,"_23186":97086,"_2329":43703},[],{"_2802":57586,"_24435":57489,"_17116":97339,"_5":17011,"_23186":97086,"_2329":20412},[],{"_2802":57587,"_24435":57489,"_17116":97341,"_5":17011,"_23186":97086,"_2329":97258},[],{"_2802":57588,"_24435":57489,"_17116":97343,"_5":17011,"_23186":97086,"_2329":97344},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2802":57589,"_24435":57489,"_17116":97346,"_5":17011,"_23186":97086,"_2329":43713},[],{"_2802":57590,"_24435":57489,"_17116":97348,"_5":17011,"_23186":97086,"_2329":20412},[],{"_2802":57591,"_24435":57489,"_17116":97350,"_5":17011,"_23186":97086,"_2329":97258},[],{"_2802":57592,"_24435":57489,"_17116":97352,"_5":17011,"_23186":97086,"_2329":97353},[],"URL HTTP del Device Manager de Lamassu.",{"_2802":57593,"_24435":57489,"_17116":97355,"_5":17011,"_23186":97086,"_2329":43723},[],{"_2802":57594,"_24435":57489,"_17116":97357,"_5":17011,"_23186":97086,"_2329":20412},[],{"_2802":57595,"_24435":57489,"_17116":97359,"_5":17011,"_23186":97086,"_2329":97258},[],{"_2802":57596,"_24435":57489,"_17116":97361,"_5":17011,"_23186":97086,"_2329":97362},[],"URL HTTP del servicio de CA de Lamassu.",{"_2802":57597,"_24435":57489,"_17116":97364,"_5":17011,"_23186":97090,"_2329":97365},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2802":57598,"_24435":57489,"_17116":97367,"_5":17011,"_23186":97094,"_2329":97368},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2802":57599,"_24435":57489,"_17116":97370,"_5":17011,"_23186":97094,"_2329":97371},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2802":57600,"_24435":57489,"_17116":97373,"_5":17011,"_23186":97098,"_2329":97374},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2802":57601,"_24435":57489,"_17116":97376,"_5":17011,"_23186":97098,"_2329":97377},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2802":57602,"_24435":57489,"_17116":97379,"_5":17011,"_23186":97098,"_2329":97380},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2802":57603,"_24435":57489,"_17116":97382,"_5":17011,"_23186":97098,"_2329":97383},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2802":57604,"_24435":57489,"_17116":97385,"_5":17011,"_23186":97098,"_2329":97386},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2802":57605,"_24435":57489,"_17116":97388,"_5":17011,"_23186":97098,"_2329":97389},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2802":57606,"_24435":57489,"_17116":97391,"_5":17011,"_23186":97101,"_2329":97392},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2802":57607,"_24435":57489,"_17116":97394,"_5":17011,"_23186":97104,"_2329":97395},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2802":57608,"_24435":57489,"_17116":97397,"_5":17011,"_23186":97104,"_2329":97398},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2802":57609,"_24435":57489,"_17116":97400,"_5":17011,"_23186":97108,"_2329":97401},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2802":57610,"_24435":57489,"_17116":97403,"_5":17011,"_23186":97112,"_2329":97404},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2802":57611,"_24435":57489,"_17116":97406,"_5":17011,"_23186":97112,"_2329":97407},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2802":57612,"_24435":57489,"_17116":97409,"_5":17011,"_23186":97112,"_2329":97410},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2802":57613,"_24435":57489,"_17116":97412,"_5":17011,"_23186":97112,"_2329":97413},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2802":57614,"_24435":57489,"_17116":97415,"_5":17011,"_23186":97112,"_2329":97416},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2802":57615,"_24435":57489,"_17116":97418,"_5":17011,"_23186":97112,"_2329":97419},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2802":57616,"_24435":57489,"_17116":97421,"_5":17011,"_23186":97116,"_2329":97422},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2802":57617,"_24435":57489,"_17116":97424,"_5":17011,"_23186":97116,"_2329":97425},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2802":57618,"_24435":57489,"_17116":97427,"_5":17011,"_23186":97116,"_2329":97428},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2802":57619,"_24435":57489,"_17116":97430,"_5":17011,"_23186":97120,"_2329":97431},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2802":57620,"_24435":57489,"_17116":97433,"_5":17011,"_23186":97120,"_2329":97434},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2802":57621,"_24435":57489,"_17116":97436,"_5":17011,"_23186":97120,"_2329":97437},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2802":57622,"_24435":57489,"_17116":97439,"_5":17011,"_23186":97124,"_2329":97440},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2802":57623,"_24435":57489,"_17116":97442,"_5":17011,"_23186":97124,"_2329":97443},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2802":57624,"_24435":57489,"_17116":97445,"_5":17011,"_23186":97124,"_2329":97446},[],"Para que el flujo JITP funcione correctamente:",{"_2802":57625,"_24435":57489,"_17116":97448,"_5":17011,"_23186":97124,"_2329":97449},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2802":57626,"_24435":57489,"_17116":97451,"_5":17011,"_23186":97124,"_2329":97452},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2802":57627,"_24435":57489,"_17116":97454,"_5":17011,"_23186":97124,"_2329":97455},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2802":57628,"_24435":57489,"_17116":97457,"_5":17011,"_23186":97124,"_2329":97458},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2802":57629,"_24435":57489,"_17116":97460,"_5":17011,"_23186":97128,"_2329":97461},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2802":57630,"_24435":57489,"_17116":97463,"_5":17011,"_23186":97128,"_2329":97464},[],"Estado en Lamassu",{"_2802":57631,"_24435":57489,"_17116":97466,"_5":17011,"_23186":97128,"_2329":97467},[],"Razón de revocación",{"_2802":57632,"_24435":57489,"_17116":97469,"_5":17011,"_23186":97128,"_2329":97470},[],"Estado en AWS IoT Core",{"_2802":57633,"_24435":57489,"_17116":97472,"_5":17011,"_23186":97128,"_2329":43844},[],{"_2802":57634,"_24435":57489,"_17116":97474,"_5":17011,"_23186":97128,"_2329":97475},[],"Ninguna",{"_2802":57635,"_24435":57489,"_17116":97477,"_5":17011,"_23186":97128,"_2329":43850},[],{"_2802":57636,"_24435":57489,"_17116":97479,"_5":17011,"_23186":97128,"_2329":43853},[],{"_2802":57637,"_24435":57489,"_17116":97481,"_5":17011,"_23186":97128,"_2329":43856},[],{"_2802":57638,"_24435":57489,"_17116":97483,"_5":17011,"_23186":97128,"_2329":43859},[],{"_2802":57639,"_24435":57489,"_17116":97485,"_5":17011,"_23186":97128,"_2329":43853},[],{"_2802":57640,"_24435":57489,"_17116":97487,"_5":17011,"_23186":97128,"_2329":97488},[],"Cualquier otra razón",{"_2802":57641,"_24435":57489,"_17116":97490,"_5":17011,"_23186":97128,"_2329":43867},[],{"_2802":57642,"_24435":57489,"_17116":97492,"_5":17011,"_23186":97128,"_2329":97493},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2802":57643,"_24435":57489,"_17116":97495,"_5":17011,"_23186":97132,"_2329":97496},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2802":57644,"_24435":57489,"_17116":97498,"_5":17011,"_23186":97132,"_2329":97499},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2802":57645,"_24435":57489,"_17116":97501,"_5":17011,"_23186":97132,"_2329":97502},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2802":57646,"_24435":57489,"_17116":97504,"_5":17011,"_23186":97136,"_2329":97505},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2802":57647,"_24435":57489,"_17116":97507,"_5":17011,"_23186":97136,"_2329":97508},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2802":57648,"_24435":57489,"_17116":97510,"_5":17011,"_23186":97140,"_2329":97511},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2802":57649,"_24435":57489,"_17116":97513,"_5":17011,"_23186":97140,"_2329":97514},[],"Existen dos tipos de acciones:",{"_2802":57650,"_24435":57489,"_17116":97516,"_5":17011,"_23186":97140,"_2329":97517},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2802":57651,"_24435":57489,"_17116":97519,"_5":17011,"_23186":97140,"_2329":97520},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2802":57652,"_24435":57489,"_17116":97522,"_5":17011,"_23186":97140,"_2329":97523},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2802":57653,"_24435":57489,"_17116":97525,"_5":17011,"_23186":97144,"_2329":97526},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2802":57654,"_24435":57489,"_17116":97528,"_5":17011,"_23186":97144,"_2329":97529},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2802":57655,"_24435":57489,"_17116":97531,"_5":17011,"_23186":97144,"_2329":97532},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2802":57656,"_24435":57489,"_17116":97534,"_5":17011,"_23186":97148,"_2329":97535},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2802":57657,"_24435":57489,"_17116":97537,"_5":17011,"_23186":97148,"_2329":97538},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2802":57658,"_24435":57489,"_17116":97540,"_5":17011,"_23186":97148,"_2329":97541},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2802":57659,"_24435":57489,"_17116":97543,"_5":17011,"_23186":97148,"_2329":97544},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2802":57660,"_24435":57489,"_17116":97546,"_5":17011,"_23186":97148,"_2329":97547},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2802":57661,"_24435":57489,"_17116":97549,"_5":17011,"_23186":97148,"_2329":97550},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2802":57662,"_24435":57489,"_17116":97552,"_5":17011,"_23186":97148,"_2329":97553},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2802":57663,"_24435":57489,"_17116":97555,"_5":17011,"_23186":97148,"_2329":97556},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2802":57664,"_24435":57489,"_17116":97558,"_5":17011,"_23186":97148,"_2329":97559},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2802":57665,"_24435":57489,"_17116":97561,"_5":17011,"_23186":97148,"_2329":97562},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2802":57666,"_24435":57489,"_17116":97564,"_5":17011,"_23186":97148,"_2329":97565},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2802":57667,"_24435":57489,"_17116":97567,"_5":17011,"_23186":97148,"_2329":97568},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2802":57668,"_24435":57489,"_17116":97570,"_5":17011,"_23186":97148,"_2329":97571},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2802":57669,"_24435":57489,"_17116":97573,"_5":17011,"_23186":97148,"_2329":97574},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2802":57670,"_24435":57489,"_17116":97576,"_5":17011,"_23186":97148,"_2329":97577},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2802":57671,"_24435":57489,"_17116":97579,"_5":17011,"_23186":97148,"_2329":97580},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2802":57672,"_24435":57489,"_17116":97582,"_5":17011,"_23186":97148,"_2329":97583},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2802":57673,"_24435":57489,"_17116":97585,"_5":17011,"_23186":97148,"_2329":97586},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2802":57674,"_24435":57489,"_17116":97588,"_5":17011,"_23186":97148,"_2329":97589},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2802":57675,"_24435":57489,"_17116":97591,"_5":17011,"_23186":97148,"_2329":97592},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2802":57676,"_24435":57489,"_17116":97594,"_5":17011,"_23186":97148,"_2329":97595},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2802":57677,"_24435":57677,"_5":12038,"_2329":42088,"_24770":97597,"_17116":97598,"_23186":57677},[39813,94857,42088],[],{"_2802":57678,"_24435":57677,"_17116":97600,"_5":17011,"_23186":57677,"_2329":97601},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2802":57679,"_24435":57677,"_5":24767,"_17116":97603,"_23186":97604,"_2329":97605},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2802":57680,"_24435":57677,"_5":24767,"_17116":97607,"_23186":97608,"_2329":95786},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2802":57681,"_24435":57677,"_5":24767,"_17116":97610,"_23186":97611,"_2329":95961},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2802":57682,"_24435":57677,"_5":24767,"_17116":97613,"_23186":97614,"_2329":97067},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/overview#integraciones",{"_2802":57683,"_24435":57677,"_5":24767,"_17116":97616,"_23186":97617,"_2329":97618},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2802":57684,"_24435":57677,"_17116":97620,"_5":17011,"_23186":57677,"_2329":97621},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2802":57685,"_24435":57677,"_17116":97623,"_5":17011,"_23186":97604,"_2329":97624},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2802":57686,"_24435":57677,"_17116":97626,"_5":17011,"_23186":97604,"_2329":97627},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2802":57687,"_24435":57677,"_17116":97629,"_5":17011,"_23186":97608,"_2329":97630},[],"Recurso",{"_2802":57688,"_24435":57677,"_17116":97632,"_5":17011,"_23186":97608,"_2329":97633},[],"Qué representa",{"_2802":57689,"_24435":57677,"_17116":97635,"_5":17011,"_23186":97608,"_2329":97636},[],"**Dispositivo**",{"_2802":57690,"_24435":57677,"_17116":97638,"_5":17011,"_23186":97608,"_2329":97639},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2802":57691,"_24435":57677,"_17116":97641,"_5":17011,"_23186":97608,"_2329":97642},[],"**Identidad**",{"_2802":57692,"_24435":57677,"_17116":97644,"_5":17011,"_23186":97608,"_2329":97645},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2802":57693,"_24435":57677,"_17116":97647,"_5":17011,"_23186":97608,"_2329":44025},[],{"_2802":57694,"_24435":57677,"_17116":97649,"_5":17011,"_23186":97608,"_2329":97650},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2802":57695,"_24435":57677,"_17116":97652,"_5":17011,"_23186":97608,"_2329":97653},[],"**Flota**",{"_2802":57696,"_24435":57677,"_17116":97655,"_5":17011,"_23186":97608,"_2329":97656},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2802":57697,"_24435":57677,"_17116":97658,"_5":17011,"_23186":97608,"_2329":97659},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2802":57698,"_24435":57677,"_17116":97661,"_5":17011,"_23186":97608,"_2329":97662},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2802":57699,"_24435":57677,"_17116":97664,"_5":17011,"_23186":97611,"_2329":97665},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2802":57700,"_24435":57677,"_17116":97667,"_5":17011,"_23186":97611,"_2329":97668},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2802":57701,"_24435":57677,"_17116":97670,"_5":17011,"_23186":97611,"_2329":97671},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2802":57702,"_24435":57677,"_17116":97673,"_5":17011,"_23186":97611,"_2329":97674},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2802":57703,"_24435":57677,"_17116":97676,"_5":17011,"_23186":97611,"_2329":97677},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2802":57704,"_24435":57677,"_17116":97679,"_5":17011,"_23186":97611,"_2329":97680},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2802":57705,"_24435":57677,"_17116":97682,"_5":17011,"_23186":97611,"_2329":97683},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2802":57706,"_24435":57677,"_17116":97685,"_5":17011,"_23186":97611,"_2329":97686},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2802":57707,"_24435":57677,"_17116":97688,"_5":17011,"_23186":97614,"_2329":97689},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2802":57708,"_24435":57677,"_17116":97691,"_5":17011,"_23186":97614,"_2329":97692},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2802":57709,"_24435":57677,"_17116":97694,"_5":17011,"_23186":97617,"_2329":97695},[],"Participante",{"_2802":57710,"_24435":57677,"_17116":97697,"_5":17011,"_23186":97617,"_2329":97698},[],"Responsabilidad",{"_2802":57711,"_24435":57677,"_17116":97700,"_5":17011,"_23186":97617,"_2329":97701},[],"Administrador PKI",{"_2802":57712,"_24435":57677,"_17116":97703,"_5":17011,"_23186":97617,"_2329":97704},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2802":57713,"_24435":57677,"_17116":97706,"_5":17011,"_23186":97617,"_2329":97707},[],"Administrador del aprovisionamiento",{"_2802":57714,"_24435":57677,"_17116":97709,"_5":17011,"_23186":97617,"_2329":97710},[],"DMS, admisión, autenticación por operación e inventario.",{"_2802":57715,"_24435":57677,"_17116":97712,"_5":17011,"_23186":97617,"_2329":97713},[],"Integrador del dispositivo",{"_2802":57716,"_24435":57677,"_17116":97715,"_5":17011,"_23186":97617,"_2329":97716},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2802":57717,"_24435":57677,"_17116":97718,"_5":17011,"_23186":97617,"_2329":97719},[],"Integrador del consumidor",{"_2802":57718,"_24435":57677,"_17116":97721,"_5":17011,"_23186":97617,"_2329":97722},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2802":57719,"_24435":57677,"_17116":97724,"_5":17011,"_23186":97617,"_2329":97725},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2802":57720,"_24435":57720,"_5":12038,"_2329":97727,"_24770":97728,"_17116":97730,"_23186":57720},"Enrola y conecta tu primer dispositivo",[39813,94857,42088,97729],"Primeros pasos",[],{"_2802":57721,"_24435":57720,"_17116":97732,"_5":17011,"_23186":57720,"_2329":97733},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2802":57722,"_24435":57720,"_5":24767,"_17116":97735,"_23186":97736,"_2329":93558},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2802":57723,"_24435":57720,"_5":24767,"_17116":97738,"_23186":97739,"_2329":97740},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2802":57724,"_24435":57720,"_5":24767,"_17116":97742,"_23186":97743,"_2329":97744},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2802":57725,"_24435":57720,"_5":24767,"_17116":97746,"_23186":97747,"_2329":97748},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2802":57726,"_24435":57720,"_5":24767,"_17116":97750,"_23186":97751,"_2329":97752},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2802":57727,"_24435":57720,"_5":24767,"_17116":97754,"_23186":97755,"_2329":97756},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2802":57728,"_24435":57720,"_5":24767,"_17116":97758,"_23186":97759,"_2329":97760},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2802":57729,"_24435":57720,"_5":24767,"_17116":97762,"_23186":97763,"_2329":97764},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2802":57730,"_24435":57720,"_17116":97766,"_5":17011,"_23186":57720,"_2329":97767},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2802":57731,"_24435":57720,"_17116":97769,"_5":17011,"_23186":97736,"_2329":97770},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2802":57732,"_24435":57720,"_17116":97772,"_5":17011,"_23186":97736,"_2329":97773},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2802":57733,"_24435":57720,"_17116":97775,"_5":17011,"_23186":97736,"_2329":97776},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2802":57734,"_24435":57720,"_17116":97778,"_5":17011,"_23186":97736,"_2329":97779},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2802":57735,"_24435":57720,"_17116":97781,"_5":17011,"_23186":97736,"_2329":97782},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2802":57736,"_24435":57720,"_17116":97784,"_5":17011,"_23186":97739,"_2329":97785},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2802":57737,"_24435":57720,"_17116":97787,"_5":17011,"_23186":97739,"_2329":97788},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2802":57738,"_24435":57720,"_17116":97790,"_5":17011,"_23186":97743,"_2329":97791},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2802":57739,"_24435":57720,"_17116":97793,"_5":17011,"_23186":97743,"_2329":97794},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2802":57740,"_24435":57720,"_17116":97796,"_5":17011,"_23186":97743,"_2329":97797},[],"Ajuste",{"_2802":57741,"_24435":57720,"_17116":97799,"_5":17011,"_23186":97743,"_2329":97800},[],"Valor de evaluación",{"_2802":57742,"_24435":57720,"_17116":97802,"_5":17011,"_23186":97743,"_2329":44181},[],{"_2802":57743,"_24435":57720,"_17116":97804,"_5":17011,"_23186":97743,"_2329":97805},[],"Raíz emisora de `device-root.pem`.",{"_2802":57744,"_24435":57720,"_17116":97807,"_5":17011,"_23186":97743,"_2329":96085},[],{"_2802":57745,"_24435":57720,"_17116":97809,"_5":17011,"_23186":97743,"_2329":97810},[],"Perfil final de 1 hora que acabas de preparar.",{"_2802":57746,"_24435":57720,"_17116":97812,"_5":17011,"_23186":97743,"_2329":44192},[],{"_2802":57747,"_24435":57720,"_17116":97814,"_5":17011,"_23186":97743,"_2329":44195},[],{"_2802":57748,"_24435":57720,"_17116":97816,"_5":17011,"_23186":97743,"_2329":44198},[],{"_2802":57749,"_24435":57720,"_17116":97818,"_5":17011,"_23186":97743,"_2329":97819},[],"Habilitado.",{"_2802":57750,"_24435":57720,"_17116":97821,"_5":17011,"_23186":97743,"_2329":44204},[],{"_2802":57751,"_24435":57720,"_17116":97823,"_5":17011,"_23186":97743,"_2329":97824},[],"Deshabilitado; el ID debe ser nuevo.",{"_2802":57752,"_24435":57720,"_17116":97826,"_5":17011,"_23186":97743,"_2329":97827},[],"Autenticación inicial",{"_2802":57753,"_24435":57720,"_17116":97829,"_5":17011,"_23186":97743,"_2329":97830},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2802":57754,"_24435":57720,"_17116":97832,"_5":17011,"_23186":97743,"_2329":97833},[],"Autenticación de renovación",{"_2802":57755,"_24435":57720,"_17116":97835,"_5":17011,"_23186":97743,"_2329":97836},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2802":57756,"_24435":57720,"_17116":97838,"_5":17011,"_23186":97743,"_2329":44222},[],{"_2802":57757,"_24435":57720,"_17116":97840,"_5":17011,"_23186":97743,"_2329":97841},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2802":57758,"_24435":57720,"_17116":97843,"_5":17011,"_23186":97743,"_2329":44228},[],{"_2802":57759,"_24435":57720,"_17116":97845,"_5":17011,"_23186":97743,"_2329":97846},[],"1 hora.",{"_2802":57760,"_24435":57720,"_17116":97848,"_5":17011,"_23186":97743,"_2329":44234},[],{"_2802":57761,"_24435":57720,"_17116":97850,"_5":17011,"_23186":97743,"_2329":97851},[],"30 minutos / 10 minutos.",{"_2802":57762,"_24435":57720,"_17116":97853,"_5":17011,"_23186":97743,"_2329":44240},[],{"_2802":57763,"_24435":57720,"_17116":97855,"_5":17011,"_23186":97743,"_2329":97856},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2802":57764,"_24435":57720,"_17116":97858,"_5":17011,"_23186":97743,"_2329":42403},[],{"_2802":57765,"_24435":57720,"_17116":97860,"_5":17011,"_23186":97743,"_2329":97861},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2802":57766,"_24435":57720,"_17116":97863,"_5":17011,"_23186":97743,"_2329":44251},[],{"_2802":57767,"_24435":57720,"_17116":97865,"_5":17011,"_23186":97743,"_2329":97866},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2802":57768,"_24435":57720,"_17116":97868,"_5":17011,"_23186":97743,"_2329":97869},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2802":57769,"_24435":57720,"_17116":97871,"_5":17011,"_23186":97747,"_2329":97872},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2802":57770,"_24435":57720,"_17116":97874,"_5":17011,"_23186":97747,"_2329":97875},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2802":57771,"_24435":57720,"_17116":97877,"_5":17011,"_23186":97751,"_2329":97878},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2802":57772,"_24435":57720,"_17116":97880,"_5":17011,"_23186":97751,"_2329":97881},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2802":57773,"_24435":57720,"_17116":97883,"_5":17011,"_23186":97751,"_2329":97884},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2802":57774,"_24435":57720,"_17116":97886,"_5":17011,"_23186":97755,"_2329":97887},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2802":57775,"_24435":57720,"_17116":97889,"_5":17011,"_23186":97755,"_2329":97890},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2802":57776,"_24435":57720,"_17116":97892,"_5":17011,"_23186":97759,"_2329":97893},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2802":57777,"_24435":57720,"_17116":97895,"_5":17011,"_23186":97759,"_2329":97896},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2802":57778,"_24435":57720,"_17116":97898,"_5":17011,"_23186":97759,"_2329":97899},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2802":57779,"_24435":57720,"_17116":97901,"_5":17011,"_23186":97759,"_2329":97902},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2802":57780,"_24435":57720,"_17116":97904,"_5":17011,"_23186":97759,"_2329":97905},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2802":57781,"_24435":57720,"_17116":97907,"_5":17011,"_23186":97763,"_2329":97908},[],"Comprobación",{"_2802":57782,"_24435":57720,"_17116":97910,"_5":17011,"_23186":97763,"_2329":97911},[],"Resultado esperado",{"_2802":57783,"_24435":57720,"_17116":97913,"_5":17011,"_23186":97763,"_2329":97914},[],"Registro",{"_2802":57784,"_24435":57720,"_17116":97916,"_5":17011,"_23186":97763,"_2329":97917},[],"ID creado automáticamente y DMS correcto.",{"_2802":57785,"_24435":57720,"_17116":97919,"_5":17011,"_23186":97763,"_2329":97920},[],"Certificado",{"_2802":57786,"_24435":57720,"_17116":97922,"_5":17011,"_23186":97763,"_2329":97923},[],"CN, perfil, serie y clave verificados.",{"_2802":57787,"_24435":57720,"_17116":97925,"_5":17011,"_23186":97763,"_2329":97926},[],"Inventario",{"_2802":57788,"_24435":57720,"_17116":97928,"_5":17011,"_23186":97763,"_2329":97929},[],"Serie recibida visible como identidad actual y en el historial.",{"_2802":57789,"_24435":57720,"_17116":97931,"_5":17011,"_23186":97763,"_2329":97932},[],"Consumidor",{"_2802":57790,"_24435":57720,"_17116":97934,"_5":17011,"_23186":97763,"_2329":97935},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2802":57791,"_24435":57720,"_17116":97937,"_5":17011,"_23186":97763,"_2329":97938},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2802":57792,"_24435":57720,"_17116":97940,"_5":17011,"_23186":97763,"_2329":97941},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2802":57793,"_24435":57793,"_5":12038,"_2329":95803,"_24770":97943,"_17116":97944,"_23186":57793},[39813,94857,42088,97729],[],{"_2802":57794,"_24435":57793,"_17116":97946,"_5":17011,"_23186":57793,"_2329":97947},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2802":57795,"_24435":57793,"_5":24767,"_17116":97949,"_23186":97950,"_2329":93558},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2802":57796,"_24435":57793,"_5":24767,"_17116":97952,"_23186":97953,"_2329":97954},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2802":57797,"_24435":57793,"_5":24767,"_17116":97956,"_23186":97957,"_2329":97958},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2802":57798,"_24435":57793,"_5":24767,"_17116":97960,"_23186":97961,"_2329":97962},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2802":57799,"_24435":57793,"_5":24767,"_17116":97964,"_23186":97965,"_2329":97966},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2802":57800,"_24435":57793,"_5":24767,"_17116":97968,"_23186":97969,"_2329":97970},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2802":57801,"_24435":57793,"_5":24767,"_17116":97972,"_23186":97973,"_2329":97911},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2802":57802,"_24435":57793,"_5":24767,"_17116":97975,"_23186":97976,"_2329":97977},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2802":57803,"_24435":57793,"_5":24767,"_17116":97979,"_23186":97980,"_2329":97981},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2802":57804,"_24435":57793,"_17116":97983,"_5":17011,"_23186":57793,"_2329":97984},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2802":57805,"_24435":57793,"_17116":97986,"_5":17011,"_23186":57793,"_2329":97987},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2802":57806,"_24435":57793,"_17116":97989,"_5":17011,"_23186":97950,"_2329":97990},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2802":57807,"_24435":57793,"_17116":97992,"_5":17011,"_23186":97950,"_2329":97993},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2802":57808,"_24435":57793,"_17116":97995,"_5":17011,"_23186":97950,"_2329":97996},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2802":57809,"_24435":57793,"_17116":97998,"_5":17011,"_23186":97950,"_2329":97999},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2802":57810,"_24435":57793,"_17116":98001,"_5":17011,"_23186":97953,"_2329":98002},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2802":57811,"_24435":57793,"_17116":98004,"_5":17011,"_23186":97953,"_2329":98005},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2802":57812,"_24435":57793,"_17116":98007,"_5":17011,"_23186":97953,"_2329":98008},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2802":57813,"_24435":57793,"_17116":98010,"_5":17011,"_23186":97953,"_2329":98011},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2802":57814,"_24435":57793,"_17116":98013,"_5":17011,"_23186":97953,"_2329":98014},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2802":57815,"_24435":57793,"_17116":98016,"_5":17011,"_23186":97953,"_2329":98017},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2802":57816,"_24435":57793,"_17116":98019,"_5":17011,"_23186":97953,"_2329":98020},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2802":57817,"_24435":57793,"_17116":98022,"_5":17011,"_23186":97953,"_2329":98023},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2802":57818,"_24435":57793,"_17116":98025,"_5":17011,"_23186":97957,"_2329":98026},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2802":57819,"_24435":57793,"_17116":98028,"_5":17011,"_23186":97957,"_2329":44417},[],{"_2802":57820,"_24435":57793,"_17116":98030,"_5":17011,"_23186":97957,"_2329":98031},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2802":57821,"_24435":57793,"_17116":98033,"_5":17011,"_23186":97957,"_2329":98034},[],"**Icon** y **Tags**: clasificación opcional.",{"_2802":57822,"_24435":57793,"_17116":98036,"_5":17011,"_23186":97957,"_2329":98037},[],"Confirma el registro.",{"_2802":57823,"_24435":57793,"_17116":98039,"_5":17011,"_23186":97961,"_2329":98040},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2802":57824,"_24435":57793,"_17116":98042,"_5":17011,"_23186":97961,"_2329":98043},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2802":57825,"_24435":57793,"_17116":98045,"_5":17011,"_23186":97965,"_2329":98046},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2802":57826,"_24435":57793,"_17116":98048,"_5":17011,"_23186":97965,"_2329":98049},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2802":57827,"_24435":57793,"_17116":98051,"_5":17011,"_23186":97969,"_2329":98052},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2802":57828,"_24435":57793,"_17116":98054,"_5":17011,"_23186":97969,"_2329":98055},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2802":57829,"_24435":57793,"_17116":98057,"_5":17011,"_23186":97973,"_2329":97908},[],{"_2802":57830,"_24435":57793,"_17116":98059,"_5":17011,"_23186":97973,"_2329":98060},[],"Resultado",{"_2802":57831,"_24435":57793,"_17116":98062,"_5":17011,"_23186":97973,"_2329":98063},[],"Dispositivo",{"_2802":57832,"_24435":57793,"_17116":98065,"_5":17011,"_23186":97973,"_2329":98066},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2802":57833,"_24435":57793,"_17116":98068,"_5":17011,"_23186":97973,"_2329":98069},[],"Identidad actual",{"_2802":57834,"_24435":57793,"_17116":98071,"_5":17011,"_23186":97973,"_2329":98072},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2802":57835,"_24435":57793,"_17116":98074,"_5":17011,"_23186":97973,"_2329":98075},[],"Historial",{"_2802":57836,"_24435":57793,"_17116":98077,"_5":17011,"_23186":97973,"_2329":98078},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2802":57837,"_24435":57793,"_17116":98080,"_5":17011,"_23186":97973,"_2329":98081},[],"Clave y certificado",{"_2802":57838,"_24435":57793,"_17116":98083,"_5":17011,"_23186":97973,"_2329":98084},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2802":57839,"_24435":57793,"_17116":98086,"_5":17011,"_23186":97976,"_2329":98087},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2802":57840,"_24435":57793,"_17116":98089,"_5":17011,"_23186":97976,"_2329":98090},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2802":57841,"_24435":57793,"_17116":98092,"_5":17011,"_23186":97976,"_2329":98093},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2802":57842,"_24435":57793,"_17116":98095,"_5":17011,"_23186":97976,"_2329":98096},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2802":57843,"_24435":57793,"_17116":98098,"_5":17011,"_23186":97980,"_2329":98099},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2802":57844,"_24435":57793,"_17116":98101,"_5":17011,"_23186":97980,"_2329":98102},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2802":57845,"_24435":57793,"_17116":98104,"_5":17011,"_23186":97980,"_2329":98105},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2802":57846,"_24435":57846,"_5":12038,"_2329":98107,"_24770":98108,"_17116":98109,"_23186":57846},"Plataforma Lamassu IoT",[39813,94857],[],{"_2802":57847,"_24435":57846,"_17116":98111,"_5":17011,"_23186":57846,"_2329":98112},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2802":57848,"_24435":57846,"_5":24767,"_17116":98114,"_23186":98115,"_2329":97605},[],"/docs/pr-preview/pr-28/es/platform/overview#empieza-aquí",{"_2802":57849,"_24435":57846,"_5":24767,"_17116":98117,"_23186":98118,"_2329":98119},[],"/docs/pr-preview/pr-28/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2802":57850,"_24435":57846,"_5":24767,"_17116":98121,"_23186":98122,"_2329":98123},[],"/docs/pr-preview/pr-28/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2802":57851,"_24435":57846,"_5":24767,"_17116":98125,"_23186":98126,"_2329":98127},[],"/docs/pr-preview/pr-28/es/platform/overview#capacidades-principales","Capacidades principales",{"_2802":57852,"_24435":57846,"_5":24767,"_17116":98129,"_23186":98130,"_2329":98131},[],"/docs/pr-preview/pr-28/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2802":57853,"_24435":57846,"_5":24767,"_17116":98133,"_23186":98134,"_2329":98135},[],"/docs/pr-preview/pr-28/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2802":57854,"_24435":57846,"_5":24767,"_17116":98137,"_23186":98138,"_2329":98139},[],"/docs/pr-preview/pr-28/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2802":57855,"_24435":57846,"_5":24767,"_17116":98141,"_23186":98142,"_2329":98143},[],"/docs/pr-preview/pr-28/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2802":57856,"_24435":57846,"_5":24767,"_17116":98145,"_23186":98146,"_2329":98147},[],"/docs/pr-preview/pr-28/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2802":57857,"_24435":57846,"_5":24767,"_17116":98149,"_23186":98150,"_2329":98151},[],"/docs/pr-preview/pr-28/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2802":57858,"_24435":57846,"_5":24767,"_17116":98153,"_23186":98154,"_2329":98155},[],"/docs/pr-preview/pr-28/es/platform/overview#referencia-operativa","Referencia operativa",{"_2802":57859,"_24435":57846,"_17116":98157,"_5":17011,"_23186":57846,"_2329":98158},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2802":57860,"_24435":57846,"_17116":98160,"_5":17011,"_23186":98115,"_2329":98161},[],"Elige el resultado que necesitas obtener:",{"_2802":57861,"_24435":57846,"_17116":98163,"_5":17011,"_23186":98115,"_2329":98164},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2802":57862,"_24435":57846,"_17116":98166,"_5":17011,"_23186":98115,"_2329":98167},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2802":57863,"_24435":57846,"_17116":98169,"_5":17011,"_23186":98115,"_2329":98170},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2802":57864,"_24435":57846,"_17116":98172,"_5":17011,"_23186":98118,"_2329":98173},[],"Bloque",{"_2802":57865,"_24435":57846,"_17116":98175,"_5":17011,"_23186":98118,"_2329":98176},[],"Qué gestionas",{"_2802":57866,"_24435":57846,"_17116":98178,"_5":17011,"_23186":98118,"_2329":98179},[],"Punto de entrada",{"_2802":57867,"_24435":57846,"_17116":98181,"_5":17011,"_23186":98118,"_2329":44571},[],{"_2802":57868,"_24435":57846,"_17116":98183,"_5":17011,"_23186":98118,"_2329":98184},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2802":57869,"_24435":57846,"_17116":98186,"_5":17011,"_23186":98118,"_2329":98187},[],"Visión general de PKI",{"_2802":57870,"_24435":57846,"_17116":98189,"_5":17011,"_23186":98118,"_2329":44580},[],{"_2802":57871,"_24435":57846,"_17116":98191,"_5":17011,"_23186":98118,"_2329":98192},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2802":57872,"_24435":57846,"_17116":98194,"_5":17011,"_23186":98118,"_2329":98195},[],"Visión general de IoT Fleets",{"_2802":57873,"_24435":57846,"_17116":98197,"_5":17011,"_23186":98118,"_2329":98198},[],"**Administración**",{"_2802":57874,"_24435":57846,"_17116":98200,"_5":17011,"_23186":98118,"_2329":98201},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2802":57875,"_24435":57846,"_17116":98203,"_5":17011,"_23186":98118,"_2329":94855},[],{"_2802":57876,"_24435":57846,"_17116":98205,"_5":17011,"_23186":98118,"_2329":98206},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2802":57877,"_24435":57846,"_17116":98208,"_5":17011,"_23186":98122,"_2329":98209},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2802":57878,"_24435":57846,"_17116":98211,"_5":17011,"_23186":98122,"_2329":98212},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2802":57879,"_24435":57846,"_17116":98214,"_5":17011,"_23186":98122,"_2329":98215},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2802":57880,"_24435":57846,"_17116":98217,"_5":17011,"_23186":98122,"_2329":98218},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2802":57881,"_24435":57846,"_17116":98220,"_5":17011,"_23186":98122,"_2329":98221},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2802":57882,"_24435":57846,"_17116":98223,"_5":17011,"_23186":98122,"_2329":98224},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2802":57883,"_24435":57846,"_17116":98226,"_5":17011,"_23186":98130,"_2329":98227},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2802":57884,"_24435":57846,"_17116":98229,"_5":17011,"_23186":98134,"_2329":98230},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2802":57885,"_24435":57846,"_17116":98232,"_5":17011,"_23186":98138,"_2329":98233},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2802":57886,"_24435":57846,"_17116":98235,"_5":17011,"_23186":98142,"_2329":98236},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2802":57887,"_24435":57846,"_17116":98238,"_5":17011,"_23186":98146,"_2329":98239},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2802":57888,"_24435":57846,"_17116":98241,"_5":17011,"_23186":98150,"_2329":98242},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2802":57889,"_24435":57846,"_17116":98244,"_5":17011,"_23186":98154,"_2329":97698},[],{"_2802":57890,"_24435":57846,"_17116":98246,"_5":17011,"_23186":98154,"_2329":98247},[],"Qué prepara o comprueba",{"_2802":57891,"_24435":57846,"_17116":98249,"_5":17011,"_23186":98154,"_2329":97701},[],{"_2802":57892,"_24435":57846,"_17116":98251,"_5":17011,"_23186":98154,"_2329":98252},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2802":57893,"_24435":57846,"_17116":98254,"_5":17011,"_23186":98154,"_2329":98255},[],"Administrador de la flota",{"_2802":57894,"_24435":57846,"_17116":98257,"_5":17011,"_23186":98154,"_2329":98258},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2802":57895,"_24435":57846,"_17116":98260,"_5":17011,"_23186":98154,"_2329":97713},[],{"_2802":57896,"_24435":57846,"_17116":98262,"_5":17011,"_23186":98154,"_2329":98263},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2802":57897,"_24435":57846,"_17116":98265,"_5":17011,"_23186":98154,"_2329":97719},[],{"_2802":57898,"_24435":57846,"_17116":98267,"_5":17011,"_23186":98154,"_2329":98268},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2802":57899,"_24435":57846,"_17116":98270,"_5":17011,"_23186":98154,"_2329":98271},[],"Operador de infraestructura",{"_2802":57900,"_24435":57846,"_17116":98273,"_5":17011,"_23186":98154,"_2329":98274},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2802":57901,"_24435":57846,"_17116":98276,"_5":17011,"_23186":98154,"_2329":98277},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2802":57902,"_24435":57902,"_5":12038,"_2329":98279,"_24770":98280,"_17116":98282,"_23186":57902},"Jerarquía y rotación de CAs",[39813,94857,44672,98281],"Claves, autoridades y certificados",[],{"_2802":57903,"_24435":57902,"_17116":98284,"_5":17011,"_23186":57902,"_2329":98285},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2802":57904,"_24435":57902,"_5":24767,"_17116":98287,"_23186":98288,"_2329":98289},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2802":57905,"_24435":57902,"_5":24767,"_17116":98291,"_23186":98292,"_2329":98293},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2802":57906,"_24435":57902,"_5":24767,"_17116":98295,"_23186":98296,"_2329":98297},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2802":57907,"_24435":57902,"_5":24767,"_17116":98299,"_23186":98300,"_2329":98301},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2802":57908,"_24435":57902,"_5":24767,"_17116":98303,"_23186":98304,"_2329":98305},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2802":57909,"_24435":57902,"_5":24767,"_17116":98307,"_23186":98308,"_2329":98309},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2802":57910,"_24435":57902,"_5":24767,"_17116":98311,"_23186":98312,"_2329":98313},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2802":57911,"_24435":57902,"_5":24767,"_17116":98315,"_23186":98316,"_2329":98317},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2802":57912,"_24435":57902,"_5":24767,"_17116":98319,"_23186":98320,"_2329":98321},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2802":57913,"_24435":57902,"_5":24767,"_17116":98323,"_23186":98324,"_2329":98325},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2802":57914,"_24435":57902,"_5":24767,"_17116":98327,"_23186":98328,"_2329":98329},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2802":57915,"_24435":57902,"_5":24767,"_17116":98331,"_23186":98332,"_2329":98333},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2802":57916,"_24435":57902,"_17116":98335,"_5":17011,"_23186":57902,"_2329":98336},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2802":57917,"_24435":57902,"_17116":98338,"_5":17011,"_23186":57902,"_2329":98339},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2802":57918,"_24435":57902,"_17116":98341,"_5":17011,"_23186":98288,"_2329":98342},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2802":57919,"_24435":57902,"_17116":98344,"_5":17011,"_23186":98288,"_2329":98345},[],"entorno, como producción y preproducción;",{"_2802":57920,"_24435":57902,"_17116":98347,"_5":17011,"_23186":98288,"_2329":98348},[],"propietario o equipo operador;",{"_2802":57921,"_24435":57902,"_17116":98350,"_5":17011,"_23186":98288,"_2329":98351},[],"familia de dispositivos o proceso de fabricación;",{"_2802":57922,"_24435":57902,"_17116":98353,"_5":17011,"_23186":98288,"_2329":98354},[],"región o requisito regulatorio;",{"_2802":57923,"_24435":57902,"_17116":98356,"_5":17011,"_23186":98288,"_2329":98357},[],"motor criptográfico o política de clave;",{"_2802":57924,"_24435":57902,"_17116":98359,"_5":17011,"_23186":98288,"_2329":98360},[],"ventana de mantenimiento y ritmo de renovación.",{"_2802":57925,"_24435":57902,"_17116":98362,"_5":17011,"_23186":98288,"_2329":98363},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2802":57926,"_24435":57902,"_17116":98365,"_5":17011,"_23186":98288,"_2329":98366},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2802":57927,"_24435":57902,"_17116":98368,"_5":17011,"_23186":98292,"_2329":98369},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2802":57928,"_24435":57902,"_17116":98371,"_5":17011,"_23186":98292,"_2329":98372},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2802":57929,"_24435":57902,"_17116":98374,"_5":17011,"_23186":98292,"_2329":98375},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2802":57930,"_24435":57902,"_17116":98377,"_5":17011,"_23186":98296,"_2329":98378},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2802":57931,"_24435":57902,"_17116":98380,"_5":17011,"_23186":98296,"_2329":98381},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2802":57932,"_24435":57902,"_17116":98383,"_5":17011,"_23186":98296,"_2329":98384},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2802":57933,"_24435":57902,"_17116":98386,"_5":17011,"_23186":98296,"_2329":98387},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2802":57934,"_24435":57902,"_17116":98389,"_5":17011,"_23186":98304,"_2329":98390},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2802":57935,"_24435":57902,"_17116":98392,"_5":17011,"_23186":98308,"_2329":98393},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2802":57936,"_24435":57902,"_17116":98395,"_5":17011,"_23186":98312,"_2329":98396},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2802":57937,"_24435":57902,"_17116":98398,"_5":17011,"_23186":98316,"_2329":98399},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2802":57938,"_24435":57902,"_17116":98401,"_5":17011,"_23186":98320,"_2329":98402},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2802":57939,"_24435":57902,"_17116":98404,"_5":17011,"_23186":98324,"_2329":98405},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2802":57940,"_24435":57902,"_17116":98407,"_5":17011,"_23186":98328,"_2329":98408},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2802":57941,"_24435":57902,"_17116":98410,"_5":17011,"_23186":98328,"_2329":98411},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2802":57942,"_24435":57902,"_17116":98413,"_5":17011,"_23186":98328,"_2329":98414},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2802":57943,"_24435":57902,"_17116":98416,"_5":17011,"_23186":98328,"_2329":98417},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2802":57944,"_24435":57902,"_17116":98419,"_5":17011,"_23186":98332,"_2329":98420},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2802":57945,"_24435":57902,"_17116":98422,"_5":17011,"_23186":98332,"_2329":98423},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2802":57946,"_24435":57902,"_17116":98425,"_5":17011,"_23186":98332,"_2329":98426},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2802":57947,"_24435":57902,"_17116":98428,"_5":17011,"_23186":98332,"_2329":98429},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2802":57948,"_24435":57902,"_17116":98431,"_5":17011,"_23186":98332,"_2329":98432},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2802":57949,"_24435":57902,"_17116":98434,"_5":17011,"_23186":98332,"_2329":98435},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2802":57950,"_24435":57902,"_17116":98437,"_5":17011,"_23186":98332,"_2329":98438},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2802":57951,"_24435":57951,"_5":12038,"_2329":98440,"_24770":98441,"_17116":98442,"_23186":57951},"Autoridades de certificación",[39813,94857,44672,98281],[],{"_2802":57952,"_24435":57951,"_17116":98444,"_5":17011,"_23186":57951,"_2329":98445},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2802":57953,"_24435":57951,"_5":24767,"_17116":98447,"_23186":98448,"_2329":98449},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2802":57954,"_24435":57951,"_5":24767,"_17116":98451,"_23186":98452,"_2329":98453},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2802":57955,"_24435":57951,"_5":24767,"_17116":98455,"_23186":98456,"_2329":93558},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2802":57956,"_24435":57951,"_5":24767,"_17116":98458,"_23186":98459,"_2329":98460},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2802":57957,"_24435":57951,"_5":24767,"_17116":98462,"_23186":98463,"_2329":98464},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2802":57958,"_24435":57951,"_5":24767,"_17116":98466,"_23186":98467,"_2329":98468},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2802":57959,"_24435":57951,"_5":24767,"_17116":98470,"_23186":98471,"_2329":98472},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2802":57960,"_24435":57951,"_5":24767,"_17116":98474,"_23186":98475,"_2329":98476},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2802":57961,"_24435":57951,"_5":24767,"_17116":98478,"_23186":98479,"_2329":98480},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2802":57962,"_24435":57951,"_5":24767,"_17116":98482,"_23186":98483,"_2329":98484},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2802":57963,"_24435":57951,"_5":24767,"_17116":98486,"_23186":98487,"_2329":98488},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2802":57964,"_24435":57951,"_5":24767,"_17116":98490,"_23186":98491,"_2329":98492},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2802":57965,"_24435":57951,"_5":24767,"_17116":98494,"_23186":98495,"_2329":98496},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2802":57966,"_24435":57951,"_5":24767,"_17116":98498,"_23186":98499,"_2329":98500},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2802":57967,"_24435":57951,"_5":24767,"_17116":98502,"_23186":98503,"_2329":98504},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2802":57968,"_24435":57951,"_5":24767,"_17116":98506,"_23186":98507,"_2329":98508},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2802":57969,"_24435":57951,"_5":24767,"_17116":98510,"_23186":98511,"_2329":98512},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2802":57970,"_24435":57951,"_5":24767,"_17116":98514,"_23186":98515,"_2329":98516},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2802":57971,"_24435":57951,"_5":24767,"_17116":98518,"_23186":98519,"_2329":98520},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2802":57972,"_24435":57951,"_5":24767,"_17116":98522,"_23186":98523,"_2329":98524},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2802":57973,"_24435":57951,"_5":24767,"_17116":98526,"_23186":98527,"_2329":98528},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2802":57974,"_24435":57951,"_5":24767,"_17116":98530,"_23186":98531,"_2329":98532},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2802":57975,"_24435":57951,"_17116":98534,"_5":17011,"_23186":57951,"_2329":98535},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2802":57976,"_24435":57951,"_17116":98537,"_5":17011,"_23186":57951,"_2329":98538},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2802":57977,"_24435":57951,"_17116":98540,"_5":17011,"_23186":57951,"_2329":98541},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2802":57978,"_24435":57951,"_17116":98543,"_5":17011,"_23186":98448,"_2329":98544},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2802":57979,"_24435":57951,"_17116":98546,"_5":17011,"_23186":98448,"_2329":98547},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2802":57980,"_24435":57951,"_17116":98549,"_5":17011,"_23186":98448,"_2329":98550},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2802":57981,"_24435":57951,"_17116":98552,"_5":17011,"_23186":98448,"_2329":98553},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2802":57982,"_24435":57951,"_17116":98555,"_5":17011,"_23186":98448,"_2329":98556},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2802":57983,"_24435":57951,"_17116":98558,"_5":17011,"_23186":98456,"_2329":98559},[],"Decide si la CA será raíz o intermedia.",{"_2802":57984,"_24435":57951,"_17116":98561,"_5":17011,"_23186":98456,"_2329":98562},[],"Elige el motor que custodiará la clave.",{"_2802":57985,"_24435":57951,"_17116":98564,"_5":17011,"_23186":98456,"_2329":98565},[],"Define una validez superior a la de los certificados que emitirá.",{"_2802":57986,"_24435":57951,"_17116":98567,"_5":17011,"_23186":98456,"_2329":98568},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2802":57987,"_24435":57951,"_17116":98570,"_5":17011,"_23186":98459,"_2329":98571},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2802":57988,"_24435":57951,"_17116":98573,"_5":17011,"_23186":98463,"_2329":98574},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2802":57989,"_24435":57951,"_17116":98576,"_5":17011,"_23186":98463,"_2329":98577},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2802":57990,"_24435":57951,"_17116":98579,"_5":17011,"_23186":98467,"_2329":98580},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2802":57991,"_24435":57951,"_17116":98582,"_5":17011,"_23186":98471,"_2329":98583},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2802":57992,"_24435":57951,"_17116":98585,"_5":17011,"_23186":98471,"_2329":98586},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2802":57993,"_24435":57951,"_17116":98588,"_5":17011,"_23186":98471,"_2329":98589},[],"`ST`: estado o provincia.",{"_2802":57994,"_24435":57951,"_17116":98591,"_5":17011,"_23186":98471,"_2329":98592},[],"`L`: localidad.",{"_2802":57995,"_24435":57951,"_17116":98594,"_5":17011,"_23186":98471,"_2329":98595},[],"`O`: organización.",{"_2802":57996,"_24435":57951,"_17116":98597,"_5":17011,"_23186":98471,"_2329":98598},[],"`OU`: unidad organizativa.",{"_2802":57997,"_24435":57951,"_17116":98600,"_5":17011,"_23186":98471,"_2329":98601},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2802":57998,"_24435":57951,"_17116":98603,"_5":17011,"_23186":98475,"_2329":98604},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2802":57999,"_24435":57951,"_17116":98606,"_5":17011,"_23186":98475,"_2329":98607},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2802":58000,"_24435":57951,"_17116":98609,"_5":17011,"_23186":98479,"_2329":98610},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2802":58001,"_24435":57951,"_17116":98612,"_5":17011,"_23186":98479,"_2329":98613},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2802":58002,"_24435":57951,"_17116":98615,"_5":17011,"_23186":98483,"_2329":98616},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2802":58003,"_24435":57951,"_17116":98618,"_5":17011,"_23186":98483,"_2329":98619},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2802":58004,"_24435":57951,"_17116":98621,"_5":17011,"_23186":98487,"_2329":98622},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2802":58005,"_24435":57951,"_17116":98624,"_5":17011,"_23186":98491,"_2329":98625},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2802":58006,"_24435":57951,"_17116":98627,"_5":17011,"_23186":98495,"_2329":98628},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2802":58007,"_24435":57951,"_17116":98630,"_5":17011,"_23186":98499,"_2329":98631},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2802":58008,"_24435":57951,"_17116":98633,"_5":17011,"_23186":98503,"_2329":98634},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2802":58009,"_24435":57951,"_17116":98636,"_5":17011,"_23186":98503,"_2329":98637},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2802":58010,"_24435":57951,"_17116":98639,"_5":17011,"_23186":98507,"_2329":98640},[],"Abre una CA desde el inventario para consultar:",{"_2802":58011,"_24435":57951,"_17116":98642,"_5":17011,"_23186":98507,"_2329":98643},[],"Estado y periodo de validez.",{"_2802":58012,"_24435":57951,"_17116":98645,"_5":17011,"_23186":98507,"_2329":98646},[],"Certificado y cadena en formato PEM.",{"_2802":58013,"_24435":57951,"_17116":98648,"_5":17011,"_23186":98507,"_2329":98649},[],"Número de certificados activos, expirados y revocados.",{"_2802":58014,"_24435":57951,"_17116":98651,"_5":17011,"_23186":98507,"_2329":98652},[],"Certificados emitidos en **Issued Certificates**.",{"_2802":58015,"_24435":57951,"_17116":98654,"_5":17011,"_23186":98507,"_2329":98655},[],"CRL vinculada a la autoridad.",{"_2802":58016,"_24435":57951,"_17116":98657,"_5":17011,"_23186":98507,"_2329":98658},[],"Metadatos y motor criptográfico asociado.",{"_2802":58017,"_24435":57951,"_17116":98660,"_5":17011,"_23186":98507,"_2329":98661},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2802":58018,"_24435":57951,"_17116":98663,"_5":17011,"_23186":98511,"_2329":98664},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2802":58019,"_24435":57951,"_17116":98666,"_5":17011,"_23186":98511,"_2329":98667},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2802":58020,"_24435":57951,"_17116":98669,"_5":17011,"_23186":98511,"_2329":98670},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2802":58021,"_24435":57951,"_17116":98672,"_5":17011,"_23186":98511,"_2329":98673},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2802":58022,"_24435":57951,"_17116":98675,"_5":17011,"_23186":98515,"_2329":98676},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2802":58023,"_24435":57951,"_17116":98678,"_5":17011,"_23186":98519,"_2329":98679},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2802":58024,"_24435":57951,"_17116":98681,"_5":17011,"_23186":98523,"_2329":98682},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2802":58025,"_24435":57951,"_17116":98684,"_5":17011,"_23186":98527,"_2329":98685},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2802":58026,"_24435":57951,"_17116":98687,"_5":17011,"_23186":98531,"_2329":98688},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2802":58027,"_24435":57951,"_17116":98690,"_5":17011,"_23186":98531,"_2329":98691},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2802":58028,"_24435":58028,"_5":12038,"_2329":98693,"_24770":98694,"_17116":98695,"_23186":58028},"Perfiles de certificado",[39813,94857,44672,98281],[],{"_2802":58029,"_24435":58028,"_17116":98697,"_5":17011,"_23186":58028,"_2329":98698},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2802":58030,"_24435":58028,"_5":24767,"_17116":98700,"_23186":98701,"_2329":98702},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2802":58031,"_24435":58028,"_5":24767,"_17116":98704,"_23186":98705,"_2329":98706},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#validez","Validez",{"_2802":58032,"_24435":58028,"_5":24767,"_17116":98708,"_23186":98709,"_2329":98710},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2802":58033,"_24435":58028,"_5":24767,"_17116":98712,"_23186":98713,"_2329":98714},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2802":58034,"_24435":58028,"_5":24767,"_17116":98716,"_23186":98717,"_2329":98718},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2802":58035,"_24435":58028,"_5":24767,"_17116":98720,"_23186":98721,"_2329":98722},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2802":58036,"_24435":58028,"_5":24767,"_17116":98724,"_23186":98725,"_2329":98726},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2802":58037,"_24435":58028,"_5":24767,"_17116":98728,"_23186":98729,"_2329":98730},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2802":58038,"_24435":58028,"_5":24767,"_17116":98732,"_23186":98733,"_2329":98734},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2802":58039,"_24435":58028,"_5":24767,"_17116":98736,"_23186":98737,"_2329":98738},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2802":58040,"_24435":58028,"_5":24767,"_17116":98740,"_23186":98741,"_2329":98742},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2802":58041,"_24435":58028,"_5":24767,"_17116":98744,"_23186":98745,"_2329":98746},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2802":58042,"_24435":58028,"_5":24767,"_17116":98748,"_23186":98749,"_2329":98750},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2802":58043,"_24435":58028,"_5":24767,"_17116":98752,"_23186":98753,"_2329":98754},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2802":58044,"_24435":58028,"_5":24767,"_17116":98756,"_23186":98757,"_2329":98758},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2802":58045,"_24435":58028,"_5":24767,"_17116":98760,"_23186":98761,"_2329":98762},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2802":58046,"_24435":58028,"_17116":98764,"_5":17011,"_23186":58028,"_2329":98765},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2802":58047,"_24435":58028,"_17116":98767,"_5":17011,"_23186":58028,"_2329":98768},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2802":58048,"_24435":58028,"_17116":98770,"_5":17011,"_23186":98705,"_2329":98771},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2802":58049,"_24435":58028,"_17116":98773,"_5":17011,"_23186":98705,"_2329":98774},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2802":58050,"_24435":58028,"_17116":98776,"_5":17011,"_23186":98709,"_2329":98777},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2802":58051,"_24435":58028,"_17116":98779,"_5":17011,"_23186":98713,"_2329":98780},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2802":58052,"_24435":58028,"_17116":98782,"_5":17011,"_23186":98713,"_2329":98783},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2802":58053,"_24435":58028,"_17116":98785,"_5":17011,"_23186":98713,"_2329":98786},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2802":58054,"_24435":58028,"_17116":98788,"_5":17011,"_23186":98717,"_2329":98789},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2802":58055,"_24435":58028,"_17116":98791,"_5":17011,"_23186":98721,"_2329":98792},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2802":58056,"_24435":58028,"_17116":98794,"_5":17011,"_23186":98721,"_2329":98795},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2802":58057,"_24435":58028,"_17116":98797,"_5":17011,"_23186":98725,"_2329":98798},[],"La aplicación criptográfica puede:",{"_2802":58058,"_24435":58028,"_17116":98800,"_5":17011,"_23186":98725,"_2329":98801},[],"permitir o bloquear claves RSA;",{"_2802":58059,"_24435":58028,"_17116":98803,"_5":17011,"_23186":98725,"_2329":98804},[],"limitar los tamaños RSA admitidos;",{"_2802":58060,"_24435":58028,"_17116":98806,"_5":17011,"_23186":98725,"_2329":98807},[],"permitir o bloquear claves ECDSA;",{"_2802":58061,"_24435":58028,"_17116":98809,"_5":17011,"_23186":98725,"_2329":98810},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2802":58062,"_24435":58028,"_17116":98812,"_5":17011,"_23186":98725,"_2329":98813},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2802":58063,"_24435":58028,"_17116":98815,"_5":17011,"_23186":98729,"_2329":98816},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2802":58064,"_24435":58028,"_17116":98818,"_5":17011,"_23186":98729,"_2329":94648},[],{"_2802":58065,"_24435":58028,"_17116":98820,"_5":17011,"_23186":98729,"_2329":98821},[],"Primera opción",{"_2802":58066,"_24435":58028,"_17116":98823,"_5":17011,"_23186":98729,"_2329":98824},[],"Segunda opción",{"_2802":58067,"_24435":58028,"_17116":98826,"_5":17011,"_23186":98729,"_2329":98827},[],"Si no hay ninguna",{"_2802":58068,"_24435":58028,"_17116":98829,"_5":17011,"_23186":98729,"_2329":98830},[],"Firma directa con una CA",{"_2802":58069,"_24435":58028,"_17116":98832,"_5":17011,"_23186":98729,"_2329":98833},[],"`issuance_profile` incluido en la solicitud",{"_2802":58070,"_24435":58028,"_17116":98835,"_5":17011,"_23186":98729,"_2329":98836},[],"`issuance_profile_id` de la solicitud",{"_2802":58071,"_24435":58028,"_17116":98838,"_5":17011,"_23186":98729,"_2329":98839},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2802":58072,"_24435":58028,"_17116":98841,"_5":17011,"_23186":98729,"_2329":98842},[],"Emisión mediante DMS",{"_2802":58073,"_24435":58028,"_17116":98844,"_5":17011,"_23186":98729,"_2329":45237},[],{"_2802":58074,"_24435":58028,"_17116":98846,"_5":17011,"_23186":98729,"_2329":98847},[],"`settings.issuance_profile` incluido en el DMS",{"_2802":58075,"_24435":58028,"_17116":98849,"_5":17011,"_23186":98729,"_2329":98850},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2802":58076,"_24435":58028,"_17116":98852,"_5":17011,"_23186":98729,"_2329":98853},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2802":58077,"_24435":58028,"_17116":98855,"_5":17011,"_23186":98729,"_2329":98856},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2802":58078,"_24435":58028,"_17116":98858,"_5":17011,"_23186":98737,"_2329":98859},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2802":58079,"_24435":58028,"_17116":98861,"_5":17011,"_23186":98741,"_2329":98862},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2802":58080,"_24435":58028,"_17116":98864,"_5":17011,"_23186":98745,"_2329":98865},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2802":58081,"_24435":58028,"_17116":98867,"_5":17011,"_23186":98749,"_2329":98868},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2802":58082,"_24435":58028,"_17116":98870,"_5":17011,"_23186":98753,"_2329":98871},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2802":58083,"_24435":58028,"_17116":98873,"_5":17011,"_23186":98753,"_2329":98874},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2802":58084,"_24435":58028,"_17116":98876,"_5":17011,"_23186":98757,"_2329":98877},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2802":58085,"_24435":58028,"_17116":98879,"_5":17011,"_23186":98757,"_2329":98880},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2802":58086,"_24435":58028,"_17116":98882,"_5":17011,"_23186":98757,"_2329":98883},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2802":58087,"_24435":58028,"_17116":98885,"_5":17011,"_23186":98757,"_2329":98886},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2802":58088,"_24435":58028,"_17116":98888,"_5":17011,"_23186":98761,"_2329":98889},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2802":58089,"_24435":58028,"_17116":98891,"_5":17011,"_23186":98761,"_2329":98892},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2802":58090,"_24435":58090,"_5":12038,"_2329":98894,"_24770":98895,"_17116":98897,"_23186":58090},"Validación de certificados",[39813,94857,44672,98896],"Validación",[],{"_2802":58091,"_24435":58090,"_17116":98899,"_5":17011,"_23186":58090,"_2329":98900},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2802":58092,"_24435":58090,"_5":24767,"_17116":98902,"_23186":98903,"_2329":98904},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2802":58093,"_24435":58090,"_5":24767,"_17116":98906,"_23186":98907,"_2329":98908},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2802":58094,"_24435":58090,"_5":24767,"_17116":98910,"_23186":98911,"_2329":98912},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2802":58095,"_24435":58090,"_17116":98914,"_5":17011,"_23186":58090,"_2329":98915},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2802":58096,"_24435":58090,"_17116":98917,"_5":17011,"_23186":98903,"_2329":98918},[],"Verifica estos criterios juntos:",{"_2802":58097,"_24435":58090,"_17116":98920,"_5":17011,"_23186":98903,"_2329":97908},[],{"_2802":58098,"_24435":58090,"_17116":98922,"_5":17011,"_23186":98903,"_2329":98923},[],"Resultado necesario",{"_2802":58099,"_24435":58090,"_17116":98925,"_5":17011,"_23186":98903,"_2329":98926},[],"Cadena y firma",{"_2802":58100,"_24435":58090,"_17116":98928,"_5":17011,"_23186":98903,"_2329":98929},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2802":58101,"_24435":58090,"_17116":98931,"_5":17011,"_23186":98903,"_2329":98932},[],"Fechas",{"_2802":58102,"_24435":58090,"_17116":98934,"_5":17011,"_23186":98903,"_2329":98935},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2802":58103,"_24435":58090,"_17116":98937,"_5":17011,"_23186":98903,"_2329":94561},[],{"_2802":58104,"_24435":58090,"_17116":98939,"_5":17011,"_23186":98903,"_2329":98940},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2802":58105,"_24435":58090,"_17116":98942,"_5":17011,"_23186":98903,"_2329":98943},[],"Uso",{"_2802":58106,"_24435":58090,"_17116":98945,"_5":17011,"_23186":98903,"_2329":98946},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2802":58107,"_24435":58090,"_17116":98948,"_5":17011,"_23186":98903,"_2329":98949},[],"Revocación",{"_2802":58108,"_24435":58090,"_17116":98951,"_5":17011,"_23186":98903,"_2329":98952},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2802":58109,"_24435":58090,"_17116":98954,"_5":17011,"_23186":98903,"_2329":98955},[],"Autorización",{"_2802":58110,"_24435":58090,"_17116":98957,"_5":17011,"_23186":98903,"_2329":98958},[],"La aplicación permite la acción a esa identidad.",{"_2802":58111,"_24435":58090,"_17116":98960,"_5":17011,"_23186":98903,"_2329":98961},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2802":58112,"_24435":58090,"_17116":98963,"_5":17011,"_23186":98907,"_2329":98964},[],"Mecanismo",{"_2802":58113,"_24435":58090,"_17116":98966,"_5":17011,"_23186":98907,"_2329":98967},[],"Cuándo utilizarlo",{"_2802":58114,"_24435":58090,"_17116":98969,"_5":17011,"_23186":98907,"_2329":98970},[],"Qué debes mantener",{"_2802":58115,"_24435":58090,"_17116":98972,"_5":17011,"_23186":98907,"_2329":45365},[],{"_2802":58116,"_24435":58090,"_17116":98974,"_5":17011,"_23186":98907,"_2329":98975},[],"Consulta del estado de un certificado concreto.",{"_2802":58117,"_24435":58090,"_17116":98977,"_5":17011,"_23186":98907,"_2329":98978},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2802":58118,"_24435":58090,"_17116":98980,"_5":17011,"_23186":98907,"_2329":45374},[],{"_2802":58119,"_24435":58090,"_17116":98982,"_5":17011,"_23186":98907,"_2329":98983},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2802":58120,"_24435":58090,"_17116":98985,"_5":17011,"_23186":98907,"_2329":98986},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2802":58121,"_24435":58090,"_17116":98988,"_5":17011,"_23186":98907,"_2329":98989},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2802":58122,"_24435":58090,"_17116":98991,"_5":17011,"_23186":98907,"_2329":98992},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2802":58123,"_24435":58090,"_17116":98994,"_5":17011,"_23186":98911,"_2329":98995},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2802":58124,"_24435":58090,"_17116":98997,"_5":17011,"_23186":98911,"_2329":98998},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2802":58125,"_24435":58090,"_17116":99000,"_5":17011,"_23186":98911,"_2329":99001},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2802":58126,"_24435":58090,"_17116":99003,"_5":17011,"_23186":98911,"_2329":99004},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2802":58127,"_24435":58090,"_17116":99006,"_5":17011,"_23186":98911,"_2329":99007},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2802":58128,"_24435":58090,"_17116":99009,"_5":17011,"_23186":98911,"_2329":99010},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2802":58129,"_24435":58090,"_17116":99012,"_5":17011,"_23186":98911,"_2329":99013},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2802":58130,"_24435":58090,"_17116":99015,"_5":17011,"_23186":98911,"_2329":99016},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2802":58131,"_24435":58090,"_17116":99018,"_5":17011,"_23186":98911,"_2329":99019},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2802":58132,"_24435":58132,"_5":12038,"_2329":99021,"_24770":99022,"_17116":99023,"_23186":58132},"Certificados",[39813,94857,44672,98281],[],{"_2802":58133,"_24435":58132,"_17116":99025,"_5":17011,"_23186":58132,"_2329":99026},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2802":58134,"_24435":58132,"_5":24767,"_17116":99028,"_23186":99029,"_2329":99030},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2802":58135,"_24435":58132,"_5":24767,"_17116":99032,"_23186":99033,"_2329":99034},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2802":58136,"_24435":58132,"_5":24767,"_17116":99036,"_23186":99037,"_2329":99038},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2802":58137,"_24435":58132,"_5":24767,"_17116":99040,"_23186":99041,"_2329":99042},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2802":58138,"_24435":58132,"_5":24767,"_17116":99044,"_23186":99045,"_2329":99046},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2802":58139,"_24435":58132,"_5":24767,"_17116":99048,"_23186":99049,"_2329":99050},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2802":58140,"_24435":58132,"_5":24767,"_17116":99052,"_23186":99053,"_2329":99054},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2802":58141,"_24435":58132,"_5":24767,"_17116":99056,"_23186":99057,"_2329":99058},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2802":58142,"_24435":58132,"_5":24767,"_17116":99060,"_23186":99061,"_2329":99062},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#continúa","Continúa",{"_2802":58143,"_24435":58132,"_17116":99064,"_5":17011,"_23186":58132,"_2329":99065},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2802":58144,"_24435":58132,"_17116":99067,"_5":17011,"_23186":99029,"_2329":99068},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2802":58145,"_24435":58132,"_17116":99070,"_5":17011,"_23186":99029,"_2329":99071},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2802":58146,"_24435":58132,"_17116":99073,"_5":17011,"_23186":99033,"_2329":99074},[],"Descarga el PEM e inspecciónalo:",{"_2802":58147,"_24435":58132,"_17116":99076,"_5":17011,"_23186":99033,"_2329":99077},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2802":58148,"_24435":58132,"_17116":99079,"_5":17011,"_23186":99037,"_2329":99080},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2802":58149,"_24435":58132,"_17116":99082,"_5":17011,"_23186":99037,"_2329":99083},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2802":58150,"_24435":58132,"_17116":99085,"_5":17011,"_23186":99037,"_2329":99086},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2802":58151,"_24435":58132,"_17116":99088,"_5":17011,"_23186":99037,"_2329":99089},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2802":58152,"_24435":58132,"_17116":99091,"_5":17011,"_23186":99037,"_2329":99092},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2802":58153,"_24435":58132,"_17116":99094,"_5":17011,"_23186":99037,"_2329":99095},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2802":58154,"_24435":58132,"_17116":99097,"_5":17011,"_23186":99037,"_2329":99098},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2802":58155,"_24435":58132,"_17116":99100,"_5":17011,"_23186":99041,"_2329":99101},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2802":58156,"_24435":58132,"_17116":99103,"_5":17011,"_23186":99045,"_2329":99104},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2802":58157,"_24435":58132,"_17116":99106,"_5":17011,"_23186":99049,"_2329":99107},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2802":58158,"_24435":58132,"_17116":99109,"_5":17011,"_23186":99053,"_2329":99110},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2802":58159,"_24435":58132,"_17116":99112,"_5":17011,"_23186":99053,"_2329":99113},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2802":58160,"_24435":58132,"_17116":99115,"_5":17011,"_23186":99053,"_2329":99116},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2802":58161,"_24435":58132,"_17116":99118,"_5":17011,"_23186":99057,"_2329":99119},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2802":58162,"_24435":58132,"_17116":99121,"_5":17011,"_23186":99057,"_2329":99122},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2802":58163,"_24435":58132,"_17116":99124,"_5":17011,"_23186":99057,"_2329":99125},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2802":58164,"_24435":58132,"_17116":99127,"_5":17011,"_23186":99061,"_2329":99128},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2802":58165,"_24435":58132,"_17116":99130,"_5":17011,"_23186":99061,"_2329":99131},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2802":58166,"_24435":58166,"_5":12038,"_2329":99133,"_24770":99134,"_17116":99136,"_23186":58166},"Ciclo de vida de un certificado",[39813,94857,44672,99135],"Conceptos",[],{"_2802":58167,"_24435":58166,"_17116":99138,"_5":17011,"_23186":58166,"_2329":99139},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2802":58168,"_24435":58166,"_5":24767,"_17116":99141,"_23186":99142,"_2329":99143},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2802":58169,"_24435":58166,"_5":24767,"_17116":99145,"_23186":99146,"_2329":99147},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2802":58170,"_24435":58166,"_5":24767,"_17116":99149,"_23186":99150,"_2329":99151},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2802":58171,"_24435":58166,"_5":24767,"_17116":99153,"_23186":99154,"_2329":99155},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2802":58172,"_24435":58166,"_5":24767,"_17116":99157,"_23186":99158,"_2329":99159},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2802":58173,"_24435":58166,"_5":24767,"_17116":99161,"_23186":99162,"_2329":99163},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2802":58174,"_24435":58166,"_5":24767,"_17116":99165,"_23186":99166,"_2329":99167},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2802":58175,"_24435":58166,"_5":24767,"_17116":99169,"_23186":99170,"_2329":99171},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2802":58176,"_24435":58166,"_5":24767,"_17116":99173,"_23186":99174,"_2329":99175},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2802":58177,"_24435":58166,"_5":24767,"_17116":99177,"_23186":99178,"_2329":99179},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2802":58178,"_24435":58166,"_17116":99181,"_5":17011,"_23186":58166,"_2329":99182},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2802":58179,"_24435":58166,"_17116":99184,"_5":17011,"_23186":99146,"_2329":99185},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2802":58180,"_24435":58166,"_17116":99187,"_5":17011,"_23186":99150,"_2329":99188},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2802":58181,"_24435":58166,"_17116":99190,"_5":17011,"_23186":99154,"_2329":99191},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2802":58182,"_24435":58166,"_17116":99193,"_5":17011,"_23186":99158,"_2329":99194},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2802":58183,"_24435":58166,"_17116":99196,"_5":17011,"_23186":99162,"_2329":99197},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2802":58184,"_24435":58166,"_17116":99199,"_5":17011,"_23186":99166,"_2329":99200},[],"Lamassu persiste cuatro estados X.509:",{"_2802":58185,"_24435":58166,"_17116":99202,"_5":17011,"_23186":99166,"_2329":99203},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2802":58186,"_24435":58166,"_17116":99205,"_5":17011,"_23186":99166,"_2329":99206},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2802":58187,"_24435":58166,"_17116":99208,"_5":17011,"_23186":99166,"_2329":99209},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2802":58188,"_24435":58166,"_17116":99211,"_5":17011,"_23186":99166,"_2329":99212},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2802":58189,"_24435":58166,"_17116":99214,"_5":17011,"_23186":99166,"_2329":99215},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2802":58190,"_24435":58166,"_17116":99217,"_5":17011,"_23186":99170,"_2329":99218},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2802":58191,"_24435":58166,"_17116":99220,"_5":17011,"_23186":99170,"_2329":99221},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2802":58192,"_24435":58166,"_17116":99223,"_5":17011,"_23186":99170,"_2329":99224},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2802":58193,"_24435":58166,"_17116":99226,"_5":17011,"_23186":99174,"_2329":99227},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2802":58194,"_24435":58166,"_17116":99229,"_5":17011,"_23186":99174,"_2329":99230},[],"Antes de confirmar:",{"_2802":58195,"_24435":58166,"_17116":99232,"_5":17011,"_23186":99174,"_2329":99233},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2802":58196,"_24435":58166,"_17116":99235,"_5":17011,"_23186":99174,"_2329":99236},[],"Distribuye la nueva cadena de confianza.",{"_2802":58197,"_24435":58166,"_17116":99238,"_5":17011,"_23186":99174,"_2329":99239},[],"Reemite las identidades necesarias.",{"_2802":58198,"_24435":58166,"_17116":99241,"_5":17011,"_23186":99174,"_2329":99242},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2802":58199,"_24435":58166,"_17116":99244,"_5":17011,"_23186":99174,"_2329":99245},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2802":58200,"_24435":58166,"_17116":99247,"_5":17011,"_23186":99174,"_2329":99248},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2802":58201,"_24435":58166,"_17116":99250,"_5":17011,"_23186":99178,"_2329":99251},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2802":58202,"_24435":58166,"_17116":99253,"_5":17011,"_23186":99178,"_2329":99254},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2802":58203,"_24435":58166,"_17116":99256,"_5":17011,"_23186":99178,"_2329":99257},[],"Cambios de estado y razones de revocación.",{"_2802":58204,"_24435":58166,"_17116":99259,"_5":17011,"_23186":99178,"_2329":99260},[],"Publicación y vigencia de OCSP y CRLs.",{"_2802":58205,"_24435":58166,"_17116":99262,"_5":17011,"_23186":99178,"_2329":99263},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2802":58206,"_24435":58166,"_17116":99265,"_5":17011,"_23186":99178,"_2329":99266},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2802":58207,"_24435":58207,"_5":12038,"_2329":99268,"_24770":99269,"_17116":99270,"_23186":58207},"Modelo de confianza",[39813,94857,44672,99135],[],{"_2802":58208,"_24435":58207,"_17116":99272,"_5":17011,"_23186":58207,"_2329":99273},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2802":58209,"_24435":58207,"_5":24767,"_17116":99275,"_23186":99276,"_2329":99277},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2802":58210,"_24435":58207,"_5":24767,"_17116":99279,"_23186":99280,"_2329":99281},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2802":58211,"_24435":58207,"_5":24767,"_17116":99283,"_23186":99284,"_2329":99285},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2802":58212,"_24435":58207,"_5":24767,"_17116":99287,"_23186":99288,"_2329":99289},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2802":58213,"_24435":58207,"_5":24767,"_17116":99291,"_23186":99292,"_2329":99293},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2802":58214,"_24435":58207,"_5":24767,"_17116":99295,"_23186":99296,"_2329":99297},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2802":58215,"_24435":58207,"_5":24767,"_17116":99299,"_23186":99300,"_2329":99301},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2802":58216,"_24435":58207,"_5":24767,"_17116":99303,"_23186":99304,"_2329":99305},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2802":58217,"_24435":58207,"_5":24767,"_17116":99307,"_23186":99308,"_2329":99309},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2802":58218,"_24435":58207,"_5":24767,"_17116":99311,"_23186":99312,"_2329":99313},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2802":58219,"_24435":58207,"_17116":99315,"_5":17011,"_23186":58207,"_2329":99316},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2802":58220,"_24435":58207,"_17116":99318,"_5":17011,"_23186":99280,"_2329":99319},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2802":58221,"_24435":58207,"_17116":99321,"_5":17011,"_23186":99284,"_2329":99322},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2802":58222,"_24435":58207,"_17116":99324,"_5":17011,"_23186":99288,"_2329":99325},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2802":58223,"_24435":58207,"_17116":99327,"_5":17011,"_23186":99292,"_2329":99328},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2802":58224,"_24435":58207,"_17116":99330,"_5":17011,"_23186":99296,"_2329":99331},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2802":58225,"_24435":58207,"_17116":99333,"_5":17011,"_23186":99296,"_2329":99334},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2802":58226,"_24435":58207,"_17116":99336,"_5":17011,"_23186":99296,"_2329":99337},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2802":58227,"_24435":58207,"_17116":99339,"_5":17011,"_23186":99296,"_2329":99340},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2802":58228,"_24435":58207,"_17116":99342,"_5":17011,"_23186":99296,"_2329":99343},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2802":58229,"_24435":58207,"_17116":99345,"_5":17011,"_23186":99296,"_2329":99346},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2802":58230,"_24435":58207,"_17116":99348,"_5":17011,"_23186":99300,"_2329":99349},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2802":58231,"_24435":58207,"_17116":99351,"_5":17011,"_23186":99300,"_2329":99352},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2802":58232,"_24435":58207,"_17116":99354,"_5":17011,"_23186":99300,"_2329":99355},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2802":58233,"_24435":58207,"_17116":99357,"_5":17011,"_23186":99300,"_2329":99358},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2802":58234,"_24435":58207,"_17116":99360,"_5":17011,"_23186":99300,"_2329":99361},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2802":58235,"_24435":58207,"_17116":99363,"_5":17011,"_23186":99304,"_2329":99364},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2802":58236,"_24435":58207,"_17116":99366,"_5":17011,"_23186":99304,"_2329":99367},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2802":58237,"_24435":58207,"_17116":99369,"_5":17011,"_23186":99304,"_2329":99370},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2802":58238,"_24435":58207,"_17116":99372,"_5":17011,"_23186":99304,"_2329":99373},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2802":58239,"_24435":58207,"_17116":99375,"_5":17011,"_23186":99304,"_2329":99376},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2802":58240,"_24435":58207,"_17116":99378,"_5":17011,"_23186":99304,"_2329":99379},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2802":58241,"_24435":58207,"_17116":99381,"_5":17011,"_23186":99304,"_2329":99382},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2802":58242,"_24435":58207,"_17116":99384,"_5":17011,"_23186":99308,"_2329":99385},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2802":58243,"_24435":58207,"_17116":99387,"_5":17011,"_23186":99312,"_2329":99388},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2802":58244,"_24435":58207,"_17116":99390,"_5":17011,"_23186":99312,"_2329":99391},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2802":58245,"_24435":58207,"_17116":99393,"_5":17011,"_23186":99312,"_2329":99394},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2802":58246,"_24435":58207,"_17116":99396,"_5":17011,"_23186":99312,"_2329":99397},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2802":58247,"_24435":58207,"_17116":99399,"_5":17011,"_23186":99312,"_2329":99400},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2802":58248,"_24435":58207,"_17116":99402,"_5":17011,"_23186":99312,"_2329":99403},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2802":58249,"_24435":58207,"_17116":99405,"_5":17011,"_23186":99312,"_2329":99406},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2802":58250,"_24435":58250,"_5":12038,"_2329":99408,"_24770":99409,"_17116":99410,"_23186":58250},"Listas de revocación (CRL)",[39813,94857,44672,98896],[],{"_2802":58251,"_24435":58250,"_17116":99412,"_5":17011,"_23186":58250,"_2329":99413},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2802":58252,"_24435":58250,"_5":24767,"_17116":99415,"_23186":99416,"_2329":99417},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2802":58253,"_24435":58250,"_5":24767,"_17116":99419,"_23186":99420,"_2329":99421},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2802":58254,"_24435":58250,"_5":24767,"_17116":99423,"_23186":99424,"_2329":99425},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2802":58255,"_24435":58250,"_5":24767,"_17116":99427,"_23186":99428,"_2329":99429},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2802":58256,"_24435":58250,"_5":24767,"_17116":99431,"_23186":99432,"_2329":99433},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2802":58257,"_24435":58250,"_5":24767,"_17116":99435,"_23186":99436,"_2329":99437},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2802":58258,"_24435":58250,"_5":24767,"_17116":99439,"_23186":99440,"_2329":99441},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#referencias","Referencias",{"_2802":58259,"_24435":58250,"_17116":99443,"_5":17011,"_23186":58250,"_2329":99444},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2802":58260,"_24435":58250,"_17116":99446,"_5":17011,"_23186":99416,"_2329":99447},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2802":58261,"_24435":58250,"_17116":99449,"_5":17011,"_23186":99416,"_2329":99450},[],"Campo de `crl_options`",{"_2802":58262,"_24435":58250,"_17116":99452,"_5":17011,"_23186":99416,"_2329":96226},[],{"_2802":58263,"_24435":58250,"_17116":99454,"_5":17011,"_23186":99416,"_2329":99455},[],"Valor inicial del backend",{"_2802":58264,"_24435":58250,"_17116":99457,"_5":17011,"_23186":99416,"_2329":45852},[],{"_2802":58265,"_24435":58250,"_17116":99459,"_5":17011,"_23186":99416,"_2329":99460},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2802":58266,"_24435":58250,"_17116":99462,"_5":17011,"_23186":99416,"_2329":99463},[],"7 días.",{"_2802":58267,"_24435":58250,"_17116":99465,"_5":17011,"_23186":99416,"_2329":45861},[],{"_2802":58268,"_24435":58250,"_17116":99467,"_5":17011,"_23186":99416,"_2329":99468},[],"Plazo desde la publicación que activa la renovación programada.",{"_2802":58269,"_24435":58250,"_17116":99470,"_5":17011,"_23186":99416,"_2329":99471},[],"6 días y 23 horas.",{"_2802":58270,"_24435":58250,"_17116":99473,"_5":17011,"_23186":99416,"_2329":45870},[],{"_2802":58271,"_24435":58250,"_17116":99475,"_5":17011,"_23186":99416,"_2329":99476},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2802":58272,"_24435":58250,"_17116":99478,"_5":17011,"_23186":99416,"_2329":45876},[],{"_2802":58273,"_24435":58250,"_17116":99480,"_5":17011,"_23186":99416,"_2329":45879},[],{"_2802":58274,"_24435":58250,"_17116":99482,"_5":17011,"_23186":99416,"_2329":99483},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2802":58275,"_24435":58250,"_17116":99485,"_5":17011,"_23186":99416,"_2329":99486},[],"SKI de la CA.",{"_2802":58276,"_24435":58250,"_17116":99488,"_5":17011,"_23186":99416,"_2329":99489},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2802":58277,"_24435":58250,"_17116":99491,"_5":17011,"_23186":99416,"_2329":99492},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2802":58278,"_24435":58250,"_17116":99494,"_5":17011,"_23186":99420,"_2329":99495},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2802":58279,"_24435":58250,"_17116":99497,"_5":17011,"_23186":99420,"_2329":99498},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2802":58280,"_24435":58250,"_17116":99500,"_5":17011,"_23186":99420,"_2329":99501},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2802":58281,"_24435":58250,"_17116":99503,"_5":17011,"_23186":99424,"_2329":99504},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2802":58282,"_24435":58250,"_17116":99506,"_5":17011,"_23186":99424,"_2329":99507},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2802":58283,"_24435":58250,"_17116":99509,"_5":17011,"_23186":99428,"_2329":99510},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2802":58284,"_24435":58250,"_17116":99512,"_5":17011,"_23186":99428,"_2329":99513},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2802":58285,"_24435":58250,"_17116":99515,"_5":17011,"_23186":99428,"_2329":99516},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2802":58286,"_24435":58250,"_17116":99518,"_5":17011,"_23186":99428,"_2329":99519},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2802":58287,"_24435":58250,"_17116":99521,"_5":17011,"_23186":99428,"_2329":99522},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2802":58288,"_24435":58250,"_17116":99524,"_5":17011,"_23186":99432,"_2329":99525},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2802":58289,"_24435":58250,"_17116":99527,"_5":17011,"_23186":99432,"_2329":96415},[],{"_2802":58290,"_24435":58250,"_17116":99529,"_5":17011,"_23186":99432,"_2329":99530},[],"Path relativo",{"_2802":58291,"_24435":58250,"_17116":99532,"_5":17011,"_23186":99432,"_2329":94648},[],{"_2802":58292,"_24435":58250,"_17116":99534,"_5":17011,"_23186":99432,"_2329":45934},[],{"_2802":58293,"_24435":58250,"_17116":99536,"_5":17011,"_23186":99432,"_2329":45937},[],{"_2802":58294,"_24435":58250,"_17116":99538,"_5":17011,"_23186":99432,"_2329":99539},[],"Consultar `crl_options` y `latest_crl`.",{"_2802":58295,"_24435":58250,"_17116":99541,"_5":17011,"_23186":99432,"_2329":45943},[],{"_2802":58296,"_24435":58250,"_17116":99543,"_5":17011,"_23186":99432,"_2329":45937},[],{"_2802":58297,"_24435":58250,"_17116":99545,"_5":17011,"_23186":99432,"_2329":99546},[],"Sustituir la configuración de CRL.",{"_2802":58298,"_24435":58250,"_17116":99548,"_5":17011,"_23186":99432,"_2329":99549},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2802":58299,"_24435":58250,"_17116":99551,"_5":17011,"_23186":99432,"_2329":99552},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2802":58300,"_24435":58250,"_17116":99554,"_5":17011,"_23186":99436,"_2329":99555},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2802":58301,"_24435":58250,"_17116":99557,"_5":17011,"_23186":99440,"_2329":99558},[],"RFC 5280: perfil X.509 y CRL.",{"_2802":58302,"_24435":58250,"_17116":99560,"_5":17011,"_23186":99440,"_2329":45963},[],{"_2802":58303,"_24435":58250,"_17116":99562,"_5":17011,"_23186":99440,"_2329":45966},[],{"_2802":58304,"_24435":58250,"_17116":99564,"_5":17011,"_23186":99440,"_2329":99565},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2802":58305,"_24435":58250,"_17116":99567,"_5":17011,"_23186":99440,"_2329":99568},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2802":58306,"_24435":58306,"_5":12038,"_2329":99570,"_24770":99571,"_17116":99572,"_23186":58306},"Claves y motores criptográficos",[39813,94857,44672,98281],[],{"_2802":58307,"_24435":58306,"_17116":99574,"_5":17011,"_23186":58306,"_2329":99575},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2802":58308,"_24435":58306,"_5":24767,"_17116":99577,"_23186":99578,"_2329":99579},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2802":58309,"_24435":58306,"_5":24767,"_17116":99581,"_23186":99582,"_2329":99583},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2802":58310,"_24435":58306,"_5":24767,"_17116":99585,"_23186":99586,"_2329":45991},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#file-system",{"_2802":58311,"_24435":58306,"_5":24767,"_17116":99588,"_23186":99589,"_2329":45995},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#hashicorp-vault",{"_2802":58312,"_24435":58306,"_5":24767,"_17116":99591,"_23186":99592,"_2329":45999},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#aws-secrets-manager",{"_2802":58313,"_24435":58306,"_5":24767,"_17116":99594,"_23186":99595,"_2329":46003},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#aws-kms",{"_2802":58314,"_24435":58306,"_5":24767,"_17116":99597,"_23186":99598,"_2329":46007},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#pkcs11",{"_2802":58315,"_24435":58306,"_5":24767,"_17116":99600,"_23186":99601,"_2329":46011},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#azure-key-vault",{"_2802":58316,"_24435":58306,"_5":24767,"_17116":99603,"_23186":99604,"_2329":99605},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2802":58317,"_24435":58306,"_5":24767,"_17116":99607,"_23186":99608,"_2329":99609},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2802":58318,"_24435":58306,"_5":24767,"_17116":99611,"_23186":99612,"_2329":99613},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2802":58319,"_24435":58306,"_5":24767,"_17116":99615,"_23186":99616,"_2329":99617},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2802":58320,"_24435":58306,"_5":24767,"_17116":99619,"_23186":99620,"_2329":99621},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2802":58321,"_24435":58306,"_5":24767,"_17116":99623,"_23186":99624,"_2329":99625},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2802":58322,"_24435":58306,"_5":24767,"_17116":99627,"_23186":99628,"_2329":99629},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2802":58323,"_24435":58306,"_5":24767,"_17116":99631,"_23186":99632,"_2329":46043},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#sign",{"_2802":58324,"_24435":58306,"_5":24767,"_17116":99634,"_23186":99635,"_2329":46047},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#verify",{"_2802":58325,"_24435":58306,"_5":24767,"_17116":99637,"_23186":99638,"_2329":99639},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2802":58326,"_24435":58306,"_5":24767,"_17116":99641,"_23186":99642,"_2329":99643},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2802":58327,"_24435":58306,"_5":24767,"_17116":99645,"_23186":99646,"_2329":99647},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2802":58328,"_24435":58306,"_17116":99649,"_5":17011,"_23186":58306,"_2329":99650},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2802":58329,"_24435":58306,"_17116":99652,"_5":17011,"_23186":58306,"_2329":99653},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2802":58330,"_24435":58306,"_17116":99655,"_5":17011,"_23186":99578,"_2329":99656},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2802":58331,"_24435":58306,"_17116":99658,"_5":17011,"_23186":99578,"_2329":99659},[],"En la práctica, permite:",{"_2802":58332,"_24435":58306,"_17116":99661,"_5":17011,"_23186":99578,"_2329":99662},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2802":58333,"_24435":58306,"_17116":99664,"_5":17011,"_23186":99578,"_2329":99665},[],"Importar claves creadas externamente.",{"_2802":58334,"_24435":58306,"_17116":99667,"_5":17011,"_23186":99578,"_2329":99668},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2802":58335,"_24435":58306,"_17116":99670,"_5":17011,"_23186":99578,"_2329":99671},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2802":58336,"_24435":58306,"_17116":99673,"_5":17011,"_23186":99582,"_2329":99674},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2802":58337,"_24435":58306,"_17116":99676,"_5":17011,"_23186":99582,"_2329":99677},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2802":58338,"_24435":58306,"_17116":99679,"_5":17011,"_23186":99582,"_2329":99680},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2802":58339,"_24435":58306,"_17116":99682,"_5":17011,"_23186":99586,"_2329":99683},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2802":58340,"_24435":58306,"_17116":99685,"_5":17011,"_23186":99589,"_2329":99686},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2802":58341,"_24435":58306,"_17116":99688,"_5":17011,"_23186":99592,"_2329":99689},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2802":58342,"_24435":58306,"_17116":99691,"_5":17011,"_23186":99595,"_2329":99692},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2802":58343,"_24435":58306,"_17116":99694,"_5":17011,"_23186":99598,"_2329":99695},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2802":58344,"_24435":58306,"_17116":99697,"_5":17011,"_23186":99601,"_2329":99698},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2802":58345,"_24435":58306,"_17116":99700,"_5":17011,"_23186":99601,"_2329":99701},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2802":58346,"_24435":58306,"_17116":99703,"_5":17011,"_23186":99601,"_2329":99704},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2802":58347,"_24435":58306,"_17116":99706,"_5":17011,"_23186":99601,"_2329":99707},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2802":58348,"_24435":58306,"_17116":99709,"_5":17011,"_23186":99604,"_2329":99710},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2802":58349,"_24435":58306,"_17116":99712,"_5":17011,"_23186":99604,"_2329":99713},[],"La tabla incluye los siguientes campos:",{"_2802":58350,"_24435":58306,"_17116":99715,"_5":17011,"_23186":99604,"_2329":99716},[],"**Name**: nombre descriptivo de la clave.",{"_2802":58351,"_24435":58306,"_17116":99718,"_5":17011,"_23186":99604,"_2329":99719},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2802":58352,"_24435":58306,"_17116":99721,"_5":17011,"_23186":99604,"_2329":99722},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2802":58353,"_24435":58306,"_17116":99724,"_5":17011,"_23186":99604,"_2329":99725},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2802":58354,"_24435":58306,"_17116":99727,"_5":17011,"_23186":99604,"_2329":99728},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2802":58355,"_24435":58306,"_17116":99730,"_5":17011,"_23186":99604,"_2329":99731},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2802":58356,"_24435":58306,"_17116":99733,"_5":17011,"_23186":99604,"_2329":99734},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2802":58357,"_24435":58306,"_17116":99736,"_5":17011,"_23186":99604,"_2329":99737},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2802":58358,"_24435":58306,"_17116":99739,"_5":17011,"_23186":99604,"_2329":99740},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2802":58359,"_24435":58306,"_17116":99742,"_5":17011,"_23186":99604,"_2329":99743},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2802":58360,"_24435":58306,"_17116":99745,"_5":17011,"_23186":99604,"_2329":99746},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2802":58361,"_24435":58306,"_17116":99748,"_5":17011,"_23186":99604,"_2329":99749},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2802":58362,"_24435":58306,"_17116":99751,"_5":17011,"_23186":99604,"_2329":99752},[],"**Delete Key** para eliminar la clave del sistema.",{"_2802":58363,"_24435":58306,"_17116":99754,"_5":17011,"_23186":99608,"_2329":99755},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2802":58364,"_24435":58306,"_17116":99757,"_5":17011,"_23186":99612,"_2329":99758},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2802":58365,"_24435":58306,"_17116":99760,"_5":17011,"_23186":99612,"_2329":99761},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2802":58366,"_24435":58306,"_17116":99763,"_5":17011,"_23186":99612,"_2329":99764},[],"**Key Name**: nombre único y descriptivo.",{"_2802":58367,"_24435":58306,"_17116":99766,"_5":17011,"_23186":99612,"_2329":99767},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2802":58368,"_24435":58306,"_17116":99769,"_5":17011,"_23186":99612,"_2329":99770},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2802":58369,"_24435":58306,"_17116":99772,"_5":17011,"_23186":99612,"_2329":99773},[],"**Tags**: metadatos para clasificar la clave.",{"_2802":58370,"_24435":58306,"_17116":99775,"_5":17011,"_23186":99612,"_2329":99776},[],"**Metadata**: información adicional para usos avanzados.",{"_2802":58371,"_24435":58306,"_17116":99778,"_5":17011,"_23186":99616,"_2329":99779},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2802":58372,"_24435":58306,"_17116":99781,"_5":17011,"_23186":99616,"_2329":99782},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2802":58373,"_24435":58306,"_17116":99784,"_5":17011,"_23186":99616,"_2329":99785},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2802":58374,"_24435":58306,"_17116":99787,"_5":17011,"_23186":99616,"_2329":99788},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2802":58375,"_24435":58306,"_17116":99790,"_5":17011,"_23186":99616,"_2329":99791},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2802":58376,"_24435":58306,"_17116":99793,"_5":17011,"_23186":99616,"_2329":99794},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2802":58377,"_24435":58306,"_17116":99796,"_5":17011,"_23186":99616,"_2329":99797},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2802":58378,"_24435":58306,"_17116":99799,"_5":17011,"_23186":99616,"_2329":99800},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2802":58379,"_24435":58306,"_17116":99802,"_5":17011,"_23186":99616,"_2329":99803},[],"**Metadata**: información adicional opcional.",{"_2802":58380,"_24435":58306,"_17116":99805,"_5":17011,"_23186":99616,"_2329":99806},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2802":58381,"_24435":58306,"_17116":99808,"_5":17011,"_23186":99616,"_2329":99809},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2802":58382,"_24435":58306,"_17116":99811,"_5":17011,"_23186":99620,"_2329":99812},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2802":58383,"_24435":58306,"_17116":99814,"_5":17011,"_23186":99624,"_2329":99815},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2802":58384,"_24435":58306,"_17116":99817,"_5":17011,"_23186":99624,"_2329":99818},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2802":58385,"_24435":58306,"_17116":99820,"_5":17011,"_23186":99624,"_2329":99821},[],"**Key Name**: nombre descriptivo.",{"_2802":58386,"_24435":58306,"_17116":99823,"_5":17011,"_23186":99624,"_2329":99824},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2802":58387,"_24435":58306,"_17116":99826,"_5":17011,"_23186":99624,"_2329":99827},[],"**Tags**: etiquetas asociadas.",{"_2802":58388,"_24435":58306,"_17116":99829,"_5":17011,"_23186":99624,"_2329":99830},[],"**Aliases**: nombres alternativos.",{"_2802":58389,"_24435":58306,"_17116":99832,"_5":17011,"_23186":99624,"_2329":99833},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2802":58390,"_24435":58306,"_17116":99835,"_5":17011,"_23186":99624,"_2329":99836},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2802":58391,"_24435":58306,"_17116":99838,"_5":17011,"_23186":99624,"_2329":99839},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2802":58392,"_24435":58306,"_17116":99841,"_5":17011,"_23186":99624,"_2329":99842},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2802":58393,"_24435":58306,"_17116":99844,"_5":17011,"_23186":99628,"_2329":99845},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2802":58394,"_24435":58306,"_17116":99847,"_5":17011,"_23186":99628,"_2329":99848},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2802":58395,"_24435":58306,"_17116":99850,"_5":17011,"_23186":99628,"_2329":99851},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2802":58396,"_24435":58306,"_17116":99853,"_5":17011,"_23186":99632,"_2329":99854},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2802":58397,"_24435":58306,"_17116":99856,"_5":17011,"_23186":99632,"_2329":99857},[],"Campos principales:",{"_2802":58398,"_24435":58306,"_17116":99859,"_5":17011,"_23186":99632,"_2329":99860},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2802":58399,"_24435":58306,"_17116":99862,"_5":17011,"_23186":99632,"_2329":99863},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2802":58400,"_24435":58306,"_17116":99865,"_5":17011,"_23186":99632,"_2329":99866},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2802":58401,"_24435":58306,"_17116":99868,"_5":17011,"_23186":99632,"_2329":99869},[],"**Message**: contenido que se va a firmar.",{"_2802":58402,"_24435":58306,"_17116":99871,"_5":17011,"_23186":99632,"_2329":99872},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2802":58403,"_24435":58306,"_17116":99874,"_5":17011,"_23186":99635,"_2329":99875},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2802":58404,"_24435":58306,"_17116":99877,"_5":17011,"_23186":99635,"_2329":99857},[],{"_2802":58405,"_24435":58306,"_17116":99879,"_5":17011,"_23186":99635,"_2329":99880},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2802":58406,"_24435":58306,"_17116":99882,"_5":17011,"_23186":99635,"_2329":99883},[],"**Message Type**: `Raw` o `Digest`.",{"_2802":58407,"_24435":58306,"_17116":99885,"_5":17011,"_23186":99635,"_2329":99886},[],"**Payload Encoding**: codificación del mensaje.",{"_2802":58408,"_24435":58306,"_17116":99888,"_5":17011,"_23186":99635,"_2329":99889},[],"**Message**: mensaje original o hash.",{"_2802":58409,"_24435":58306,"_17116":99891,"_5":17011,"_23186":99635,"_2329":99892},[],"**Signature**: firma que se desea comprobar.",{"_2802":58410,"_24435":58306,"_17116":99894,"_5":17011,"_23186":99635,"_2329":99895},[],"**Result**: indicador del resultado de la validación.",{"_2802":58411,"_24435":58306,"_17116":99897,"_5":17011,"_23186":99638,"_2329":99898},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2802":58412,"_24435":58306,"_17116":99900,"_5":17011,"_23186":99638,"_2329":99901},[],"Este flujo es útil para:",{"_2802":58413,"_24435":58306,"_17116":99903,"_5":17011,"_23186":99638,"_2329":99904},[],"Solicitar certificados a una CA externa.",{"_2802":58414,"_24435":58306,"_17116":99906,"_5":17011,"_23186":99638,"_2329":99907},[],"Renovar una identidad manteniendo la misma clave.",{"_2802":58415,"_24435":58306,"_17116":99909,"_5":17011,"_23186":99638,"_2329":99910},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2802":58416,"_24435":58306,"_17116":99912,"_5":17011,"_23186":99638,"_2329":99913},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2802":58417,"_24435":58306,"_17116":99915,"_5":17011,"_23186":99638,"_2329":99916},[],"**Organization (O)**: organización o empresa.",{"_2802":58418,"_24435":58306,"_17116":99918,"_5":17011,"_23186":99638,"_2329":99919},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2802":58419,"_24435":58306,"_17116":99921,"_5":17011,"_23186":99638,"_2329":99922},[],"**Country (C)**: código de país de dos letras.",{"_2802":58420,"_24435":58306,"_17116":99924,"_5":17011,"_23186":99638,"_2329":99925},[],"**State / Province (ST)**: estado o provincia.",{"_2802":58421,"_24435":58306,"_17116":99927,"_5":17011,"_23186":99638,"_2329":99928},[],"**Locality (L)**: ciudad o localidad.",{"_2802":58422,"_24435":58306,"_17116":99930,"_5":17011,"_23186":99638,"_2329":99931},[],"**Email Address**: correo de contacto.",{"_2802":58423,"_24435":58306,"_17116":99933,"_5":17011,"_23186":99638,"_2329":99934},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2802":58424,"_24435":58306,"_17116":99936,"_5":17011,"_23186":99638,"_2329":99937},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2802":58425,"_24435":58306,"_17116":99939,"_5":17011,"_23186":99642,"_2329":99940},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2802":58426,"_24435":58306,"_17116":99942,"_5":17011,"_23186":99642,"_2329":46355},[],{"_2802":58427,"_24435":58306,"_17116":99944,"_5":17011,"_23186":99646,"_2329":99945},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2802":58428,"_24435":58428,"_5":12038,"_2329":99947,"_24770":99948,"_17116":99949,"_23186":58428},"Validación online con OCSP",[39813,94857,44672,98896],[],{"_2802":58429,"_24435":58428,"_17116":99951,"_5":17011,"_23186":58428,"_2329":99952},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2802":58430,"_24435":58428,"_5":24767,"_17116":99954,"_23186":99955,"_2329":99956},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2802":58431,"_24435":58428,"_5":24767,"_17116":99958,"_23186":99959,"_2329":99960},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2802":58432,"_24435":58428,"_5":24767,"_17116":99962,"_23186":99963,"_2329":99964},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2802":58433,"_24435":58428,"_5":24767,"_17116":99966,"_23186":99967,"_2329":99968},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2802":58434,"_24435":58428,"_5":24767,"_17116":99970,"_23186":99971,"_2329":99972},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2802":58435,"_24435":58428,"_5":24767,"_17116":99974,"_23186":99975,"_2329":99441},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#referencias",{"_2802":58436,"_24435":58428,"_17116":99977,"_5":17011,"_23186":58428,"_2329":99978},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2802":58437,"_24435":58428,"_17116":99980,"_5":17011,"_23186":99955,"_2329":99981},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2802":58438,"_24435":58428,"_17116":99983,"_5":17011,"_23186":99955,"_2329":99984},[],"Estado del registro",{"_2802":58439,"_24435":58428,"_17116":99986,"_5":17011,"_23186":99955,"_2329":99987},[],"Respuesta firmada",{"_2802":58440,"_24435":58428,"_17116":99989,"_5":17011,"_23186":99955,"_2329":43850},[],{"_2802":58441,"_24435":58428,"_17116":99991,"_5":17011,"_23186":99955,"_2329":46405},[],{"_2802":58442,"_24435":58428,"_17116":99993,"_5":17011,"_23186":99955,"_2329":43867},[],{"_2802":58443,"_24435":58428,"_17116":99995,"_5":17011,"_23186":99955,"_2329":99996},[],"`Revoked`, con razón y fecha de revocación.",{"_2802":58444,"_24435":58428,"_17116":99998,"_5":17011,"_23186":99955,"_2329":99999},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2802":58445,"_24435":58428,"_17116":100001,"_5":17011,"_23186":99955,"_2329":100002},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2802":58446,"_24435":58428,"_17116":100004,"_5":17011,"_23186":99955,"_2329":100005},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2802":58447,"_24435":58428,"_17116":100007,"_5":17011,"_23186":99955,"_2329":100008},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2802":58448,"_24435":58428,"_17116":100010,"_5":17011,"_23186":99955,"_2329":100011},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2802":58449,"_24435":58428,"_17116":100013,"_5":17011,"_23186":99959,"_2329":100014},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2802":58450,"_24435":58428,"_17116":100016,"_5":17011,"_23186":99959,"_2329":100017},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2802":58451,"_24435":58428,"_17116":100019,"_5":17011,"_23186":99963,"_2329":100020},[],"El servicio acepta:",{"_2802":58452,"_24435":58428,"_17116":100022,"_5":17011,"_23186":99963,"_2329":96415},[],{"_2802":58453,"_24435":58428,"_17116":100024,"_5":17011,"_23186":99963,"_2329":100025},[],"Ruta del servicio VA",{"_2802":58454,"_24435":58428,"_17116":100027,"_5":17011,"_23186":99963,"_2329":100028},[],"Formato",{"_2802":58455,"_24435":58428,"_17116":100030,"_5":17011,"_23186":99963,"_2329":46445},[],{"_2802":58456,"_24435":58428,"_17116":100032,"_5":17011,"_23186":99963,"_2329":46448},[],{"_2802":58457,"_24435":58428,"_17116":100034,"_5":17011,"_23186":99963,"_2329":100035},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2802":58458,"_24435":58428,"_17116":100037,"_5":17011,"_23186":99963,"_2329":45934},[],{"_2802":58459,"_24435":58428,"_17116":100039,"_5":17011,"_23186":99963,"_2329":46456},[],{"_2802":58460,"_24435":58428,"_17116":100041,"_5":17011,"_23186":99963,"_2329":100042},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2802":58461,"_24435":58428,"_17116":100044,"_5":17011,"_23186":99963,"_2329":100045},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2802":58462,"_24435":58428,"_17116":100047,"_5":17011,"_23186":99967,"_2329":100048},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2802":58463,"_24435":58428,"_17116":100050,"_5":17011,"_23186":99967,"_2329":100051},[],"Genera la solicitud:",{"_2802":58464,"_24435":58428,"_17116":100053,"_5":17011,"_23186":99967,"_2329":100054},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2802":58465,"_24435":58428,"_17116":100056,"_5":17011,"_23186":99967,"_2329":100057},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2802":58466,"_24435":58428,"_17116":100059,"_5":17011,"_23186":99967,"_2329":100060},[],"Verifica el DER recibido:",{"_2802":58467,"_24435":58428,"_17116":100062,"_5":17011,"_23186":99967,"_2329":100063},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2802":58468,"_24435":58428,"_17116":100065,"_5":17011,"_23186":99971,"_2329":100066},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2802":58469,"_24435":58428,"_17116":100068,"_5":17011,"_23186":99971,"_2329":100069},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2802":58470,"_24435":58428,"_17116":100071,"_5":17011,"_23186":99975,"_2329":46489},[],{"_2802":58471,"_24435":58428,"_17116":100073,"_5":17011,"_23186":99975,"_2329":46492},[],{"_2802":58472,"_24435":58428,"_17116":100075,"_5":17011,"_23186":99975,"_2329":100076},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2802":58473,"_24435":58428,"_17116":100078,"_5":17011,"_23186":99975,"_2329":99568},[],{"_2802":58474,"_24435":58474,"_5":12038,"_2329":44672,"_24770":100080,"_17116":100081,"_23186":58474},[39813,94857,44672],[],{"_2802":58475,"_24435":58474,"_17116":100083,"_5":17011,"_23186":58474,"_2329":100084},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2802":58476,"_24435":58474,"_5":24767,"_17116":100086,"_23186":100087,"_2329":97605},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#empieza-aquí",{"_2802":58477,"_24435":58474,"_5":24767,"_17116":100089,"_23186":100090,"_2329":100091},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2802":58478,"_24435":58474,"_5":24767,"_17116":100093,"_23186":100094,"_2329":98127},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#capacidades-principales",{"_2802":58479,"_24435":58474,"_5":24767,"_17116":100096,"_23186":100097,"_2329":98131},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2802":58480,"_24435":58474,"_5":24767,"_17116":100099,"_23186":100100,"_2329":98135},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2802":58481,"_24435":58474,"_5":24767,"_17116":100102,"_23186":100103,"_2329":98139},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#emite-y-controla-certificados",{"_2802":58482,"_24435":58474,"_5":24767,"_17116":100105,"_23186":100106,"_2329":98147},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#publica-el-estado-de-validación",{"_2802":58483,"_24435":58474,"_5":24767,"_17116":100108,"_23186":100109,"_2329":100110},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2802":58484,"_24435":58474,"_5":24767,"_17116":100112,"_23186":100113,"_2329":99062},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#continúa",{"_2802":58485,"_24435":58474,"_17116":100115,"_5":17011,"_23186":58474,"_2329":100116},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2802":58486,"_24435":58474,"_17116":100118,"_5":17011,"_23186":100087,"_2329":100119},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2802":58487,"_24435":58474,"_17116":100121,"_5":17011,"_23186":100087,"_2329":100122},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2802":58488,"_24435":58474,"_17116":100124,"_5":17011,"_23186":100090,"_2329":100125},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2802":58489,"_24435":58474,"_17116":100127,"_5":17011,"_23186":100090,"_2329":100128},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2802":58490,"_24435":58474,"_17116":100130,"_5":17011,"_23186":100090,"_2329":100131},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2802":58491,"_24435":58474,"_17116":100133,"_5":17011,"_23186":100090,"_2329":100134},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2802":58492,"_24435":58474,"_17116":100136,"_5":17011,"_23186":100090,"_2329":100137},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2802":58493,"_24435":58474,"_17116":100139,"_5":17011,"_23186":100097,"_2329":100140},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2802":58494,"_24435":58474,"_17116":100142,"_5":17011,"_23186":100100,"_2329":100143},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2802":58495,"_24435":58474,"_17116":100145,"_5":17011,"_23186":100103,"_2329":100146},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2802":58496,"_24435":58474,"_17116":100148,"_5":17011,"_23186":100106,"_2329":100149},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2802":58497,"_24435":58474,"_17116":100151,"_5":17011,"_23186":100109,"_2329":100152},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2802":58498,"_24435":58474,"_17116":100154,"_5":17011,"_23186":100109,"_2329":100155},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2802":58499,"_24435":58474,"_17116":100157,"_5":17011,"_23186":100109,"_2329":100158},[],"su clave pública corresponda a la clave privada del cliente;",{"_2802":58500,"_24435":58474,"_17116":100160,"_5":17011,"_23186":100109,"_2329":100161},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2802":58501,"_24435":58474,"_17116":100163,"_5":17011,"_23186":100109,"_2329":100164},[],"sus fechas y usos permitan la operación;",{"_2802":58502,"_24435":58474,"_17116":100166,"_5":17011,"_23186":100109,"_2329":100167},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2802":58503,"_24435":58474,"_17116":100169,"_5":17011,"_23186":100109,"_2329":100170},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2802":58504,"_24435":58474,"_17116":100172,"_5":17011,"_23186":100113,"_2329":100173},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2802":58505,"_24435":58474,"_17116":100175,"_5":17011,"_23186":100113,"_2329":100176},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2802":58506,"_24435":58474,"_17116":100178,"_5":17011,"_23186":100113,"_2329":100179},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2802":58507,"_24435":58507,"_5":12038,"_2329":100181,"_24770":100182,"_17116":100183,"_23186":58507},"Crea tu primera CA",[39813,94857,44672,97729],[],{"_2802":58508,"_24435":58507,"_17116":100185,"_5":17011,"_23186":58507,"_2329":100186},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2802":58509,"_24435":58507,"_5":24767,"_17116":100188,"_23186":100189,"_2329":93558},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2802":58510,"_24435":58507,"_5":24767,"_17116":100191,"_23186":100192,"_2329":100193},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2802":58511,"_24435":58507,"_5":24767,"_17116":100195,"_23186":100196,"_2329":100197},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2802":58512,"_24435":58507,"_5":24767,"_17116":100199,"_23186":100200,"_2329":100201},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2802":58513,"_24435":58507,"_5":24767,"_17116":100203,"_23186":100204,"_2329":100205},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2802":58514,"_24435":58507,"_5":24767,"_17116":100207,"_23186":100208,"_2329":100209},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2802":58515,"_24435":58507,"_5":24767,"_17116":100211,"_23186":100212,"_2329":100213},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2802":58516,"_24435":58507,"_5":24767,"_17116":100215,"_23186":100216,"_2329":97977},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2802":58517,"_24435":58507,"_5":24767,"_17116":100218,"_23186":100219,"_2329":93582},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2802":58518,"_24435":58507,"_17116":100221,"_5":17011,"_23186":58507,"_2329":100222},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2802":58519,"_24435":58507,"_17116":100224,"_5":17011,"_23186":100189,"_2329":100225},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2802":58520,"_24435":58507,"_17116":100227,"_5":17011,"_23186":100189,"_2329":100228},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2802":58521,"_24435":58507,"_17116":100230,"_5":17011,"_23186":100189,"_2329":100231},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2802":58522,"_24435":58507,"_17116":100233,"_5":17011,"_23186":100189,"_2329":100234},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2802":58523,"_24435":58507,"_17116":100236,"_5":17011,"_23186":100192,"_2329":100237},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2802":58524,"_24435":58507,"_17116":100239,"_5":17011,"_23186":100192,"_2329":100240},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2802":58525,"_24435":58507,"_17116":100242,"_5":17011,"_23186":100196,"_2329":100243},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2802":58526,"_24435":58507,"_17116":100245,"_5":17011,"_23186":100196,"_2329":100246},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2802":58527,"_24435":58507,"_17116":100248,"_5":17011,"_23186":100200,"_2329":100249},[],"Selecciona **Root CA** y completa:",{"_2802":58528,"_24435":58507,"_17116":100251,"_5":17011,"_23186":100200,"_2329":46671},[],{"_2802":58529,"_24435":58507,"_17116":100253,"_5":17011,"_23186":100200,"_2329":100254},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2802":58530,"_24435":58507,"_17116":100256,"_5":17011,"_23186":100200,"_2329":100257},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2802":58531,"_24435":58507,"_17116":100259,"_5":17011,"_23186":100200,"_2329":100260},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2802":58532,"_24435":58507,"_17116":100262,"_5":17011,"_23186":100200,"_2329":100263},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2802":58533,"_24435":58507,"_17116":100265,"_5":17011,"_23186":100204,"_2329":100266},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2802":58534,"_24435":58507,"_17116":100268,"_5":17011,"_23186":100208,"_2329":100269},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2802":58535,"_24435":58507,"_17116":100271,"_5":17011,"_23186":100208,"_2329":100272},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2802":58536,"_24435":58507,"_17116":100274,"_5":17011,"_23186":100212,"_2329":100275},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2802":58537,"_24435":58507,"_17116":100277,"_5":17011,"_23186":100212,"_2329":100278},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2802":58538,"_24435":58507,"_17116":100280,"_5":17011,"_23186":100212,"_2329":100281},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2802":58539,"_24435":58507,"_17116":100283,"_5":17011,"_23186":100216,"_2329":100284},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2802":58540,"_24435":58507,"_17116":100286,"_5":17011,"_23186":100216,"_2329":100287},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2802":58541,"_24435":58507,"_17116":100289,"_5":17011,"_23186":100216,"_2329":100290},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2802":58542,"_24435":58507,"_17116":100292,"_5":17011,"_23186":100216,"_2329":100293},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2802":58543,"_24435":58507,"_17116":100295,"_5":17011,"_23186":100219,"_2329":100296},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2802":58544,"_24435":58544,"_5":12038,"_2329":100298,"_24770":100299,"_17116":100300,"_23186":58544},"Emite y verifica un certificado",[39813,94857,44672,97729],[],{"_2802":58545,"_24435":58544,"_17116":100302,"_5":17011,"_23186":58544,"_2329":100303},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2802":58546,"_24435":58544,"_5":24767,"_17116":100305,"_23186":100306,"_2329":93558},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2802":58547,"_24435":58544,"_5":24767,"_17116":100308,"_23186":100309,"_2329":100310},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2802":58548,"_24435":58544,"_5":24767,"_17116":100312,"_23186":100313,"_2329":100314},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2802":58549,"_24435":58544,"_5":24767,"_17116":100316,"_23186":100317,"_2329":100318},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2802":58550,"_24435":58544,"_5":24767,"_17116":100320,"_23186":100321,"_2329":100322},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2802":58551,"_24435":58544,"_5":24767,"_17116":100324,"_23186":100325,"_2329":100326},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2802":58552,"_24435":58544,"_5":24767,"_17116":100328,"_23186":100329,"_2329":100209},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2802":58553,"_24435":58544,"_5":24767,"_17116":100331,"_23186":100332,"_2329":100333},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2802":58554,"_24435":58544,"_5":24767,"_17116":100335,"_23186":100336,"_2329":100337},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2802":58555,"_24435":58544,"_5":24767,"_17116":100339,"_23186":100340,"_2329":100341},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2802":58556,"_24435":58544,"_5":24767,"_17116":100343,"_23186":100344,"_2329":97977},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2802":58557,"_24435":58544,"_5":24767,"_17116":100346,"_23186":100347,"_2329":93582},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2802":58558,"_24435":58544,"_17116":100349,"_5":17011,"_23186":58544,"_2329":100350},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2802":58559,"_24435":58544,"_17116":100352,"_5":17011,"_23186":100306,"_2329":100353},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2802":58560,"_24435":58544,"_17116":100355,"_5":17011,"_23186":100306,"_2329":100356},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2802":58561,"_24435":58544,"_17116":100358,"_5":17011,"_23186":100306,"_2329":100359},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2802":58562,"_24435":58544,"_17116":100361,"_5":17011,"_23186":100306,"_2329":100362},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2802":58563,"_24435":58544,"_17116":100364,"_5":17011,"_23186":100306,"_2329":100365},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2802":58564,"_24435":58544,"_17116":100367,"_5":17011,"_23186":100309,"_2329":100368},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2802":58565,"_24435":58544,"_17116":100370,"_5":17011,"_23186":100313,"_2329":100371},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2802":58566,"_24435":58544,"_17116":100373,"_5":17011,"_23186":100313,"_2329":100374},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2802":58567,"_24435":58544,"_17116":100376,"_5":17011,"_23186":100317,"_2329":100377},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2802":58568,"_24435":58544,"_17116":100379,"_5":17011,"_23186":100317,"_2329":100380},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2802":58569,"_24435":58544,"_17116":100382,"_5":17011,"_23186":100321,"_2329":100383},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2802":58570,"_24435":58544,"_17116":100385,"_5":17011,"_23186":100321,"_2329":100386},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2802":58571,"_24435":58544,"_17116":100388,"_5":17011,"_23186":100325,"_2329":100389},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2802":58572,"_24435":58544,"_17116":100391,"_5":17011,"_23186":100329,"_2329":100392},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2802":58573,"_24435":58544,"_17116":100394,"_5":17011,"_23186":100332,"_2329":100395},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2802":58574,"_24435":58544,"_17116":100397,"_5":17011,"_23186":100336,"_2329":100398},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2802":58575,"_24435":58544,"_17116":100400,"_5":17011,"_23186":100336,"_2329":100401},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2802":58576,"_24435":58544,"_17116":100403,"_5":17011,"_23186":100336,"_2329":100404},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2802":58577,"_24435":58544,"_17116":100406,"_5":17011,"_23186":100340,"_2329":100407},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2802":58578,"_24435":58544,"_17116":100409,"_5":17011,"_23186":100340,"_2329":100410},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2802":58579,"_24435":58544,"_17116":100412,"_5":17011,"_23186":100340,"_2329":100413},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2802":58580,"_24435":58544,"_17116":100415,"_5":17011,"_23186":100344,"_2329":98060},[],{"_2802":58581,"_24435":58544,"_17116":100417,"_5":17011,"_23186":100344,"_2329":96864},[],{"_2802":58582,"_24435":58544,"_17116":100419,"_5":17011,"_23186":100344,"_2329":100420},[],"La CA rechaza la emisión",{"_2802":58583,"_24435":58544,"_17116":100422,"_5":17011,"_23186":100344,"_2329":100423},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2802":58584,"_24435":58544,"_17116":100425,"_5":17011,"_23186":100344,"_2329":100426},[],"Sujeto o usos diferentes",{"_2802":58585,"_24435":58544,"_17116":100428,"_5":17011,"_23186":100344,"_2329":100429},[],"Perfil aplicado y valores solicitados.",{"_2802":58586,"_24435":58544,"_17116":100431,"_5":17011,"_23186":100344,"_2329":100432},[],"No se encuentra el emisor",{"_2802":58587,"_24435":58544,"_17116":100434,"_5":17011,"_23186":100344,"_2329":100435},[],"CA descargada y cadena intermedia necesaria.",{"_2802":58588,"_24435":58544,"_17116":100437,"_5":17011,"_23186":100344,"_2329":100438},[],"Falla la vigencia",{"_2802":58589,"_24435":58544,"_17116":100440,"_5":17011,"_23186":100344,"_2329":100441},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2802":58590,"_24435":58544,"_17116":100443,"_5":17011,"_23186":100344,"_2329":100444},[],"Los resúmenes de clave difieren",{"_2802":58591,"_24435":58544,"_17116":100446,"_5":17011,"_23186":100344,"_2329":100447},[],"Archivos de certificado y clave de la misma emisión.",{"_2802":58592,"_24435":58544,"_17116":100449,"_5":17011,"_23186":100344,"_2329":100450},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2802":58593,"_24435":58544,"_17116":100452,"_5":17011,"_23186":100347,"_2329":100453},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2802":58594,"_24435":58544,"_17116":100455,"_5":17011,"_23186":100347,"_2329":100456},[],"Gestionar certificados para inspección, estado y revocación.",{"_2802":58595,"_24435":58544,"_17116":100458,"_5":17011,"_23186":100347,"_2329":100459},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2802":58596,"_24435":58544,"_17116":100461,"_5":17011,"_23186":100347,"_2329":100462},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2802":58597,"_24435":58544,"_17116":100464,"_5":17011,"_23186":100347,"_2329":100465},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2802":58598,"_24435":58598,"_5":12038,"_2329":100467,"_24770":100468,"_17116":100469,"_23186":58598},"Primeros pasos de PKI",[39813,94857,44672,97729],[],{"_2802":58599,"_24435":58598,"_17116":100471,"_5":17011,"_23186":58598,"_2329":100472},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2802":58600,"_24435":58598,"_5":24767,"_17116":100474,"_23186":100475,"_2329":93558},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2802":58601,"_24435":58598,"_5":24767,"_17116":100477,"_23186":100478,"_2329":100479},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2802":58602,"_24435":58598,"_5":24767,"_17116":100481,"_23186":100482,"_2329":97911},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2802":58603,"_24435":58598,"_5":24767,"_17116":100484,"_23186":100485,"_2329":100486},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2802":58604,"_24435":58598,"_17116":100488,"_5":17011,"_23186":58598,"_2329":100489},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2802":58605,"_24435":58598,"_17116":100491,"_5":17011,"_23186":100475,"_2329":100492},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2802":58606,"_24435":58598,"_17116":100494,"_5":17011,"_23186":100475,"_2329":100495},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2802":58607,"_24435":58598,"_17116":100497,"_5":17011,"_23186":100475,"_2329":100498},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2802":58608,"_24435":58598,"_17116":100500,"_5":17011,"_23186":100475,"_2329":100501},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2802":58609,"_24435":58598,"_17116":100503,"_5":17011,"_23186":100475,"_2329":100504},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2802":58610,"_24435":58598,"_17116":100506,"_5":17011,"_23186":100478,"_2329":100507},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2802":58611,"_24435":58598,"_17116":100509,"_5":17011,"_23186":100478,"_2329":100510},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2802":58612,"_24435":58598,"_17116":100512,"_5":17011,"_23186":100478,"_2329":100513},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2802":58613,"_24435":58598,"_17116":100515,"_5":17011,"_23186":100478,"_2329":100516},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2802":58614,"_24435":58598,"_17116":100518,"_5":17011,"_23186":100482,"_2329":100519},[],"Archivo o recurso",{"_2802":58615,"_24435":58598,"_17116":100521,"_5":17011,"_23186":100482,"_2329":97908},[],{"_2802":58616,"_24435":58598,"_17116":100523,"_5":17011,"_23186":100482,"_2329":100524},[],"CA raíz activa y `ca.pem`",{"_2802":58617,"_24435":58598,"_17116":100526,"_5":17011,"_23186":100482,"_2329":100527},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2802":58618,"_24435":58598,"_17116":100529,"_5":17011,"_23186":100482,"_2329":100530},[],"Certificado final y `device.crt`",{"_2802":58619,"_24435":58598,"_17116":100532,"_5":17011,"_23186":100482,"_2329":100533},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2802":58620,"_24435":58598,"_17116":100535,"_5":17011,"_23186":100482,"_2329":100536},[],"Clave privada `device.key`",{"_2802":58621,"_24435":58598,"_17116":100538,"_5":17011,"_23186":100482,"_2329":100539},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2802":58622,"_24435":58598,"_17116":100541,"_5":17011,"_23186":100482,"_2329":100542},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2802":58623,"_24435":58598,"_17116":100544,"_5":17011,"_23186":100485,"_2329":100545},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2802":58624,"_24435":58598,"_17116":100547,"_5":17011,"_23186":100485,"_2329":100548},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2802":58625,"_24435":58598,"_17116":100550,"_5":17011,"_23186":100485,"_2329":100551},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2802":58626,"_24435":58626,"_5":12038,"_2329":100553,"_24770":100554,"_17116":100556,"_23186":58626},"Resolución de problemas PKI",[39813,94857,44672,100555],"Resolución de problemas",[],{"_2802":58627,"_24435":58626,"_17116":100558,"_5":17011,"_23186":58626,"_2329":100559},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2802":58628,"_24435":58626,"_5":24767,"_17116":100561,"_23186":100562,"_2329":100563},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2802":58629,"_24435":58626,"_5":24767,"_17116":100565,"_23186":100566,"_2329":100567},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2802":58630,"_24435":58626,"_5":24767,"_17116":100569,"_23186":100570,"_2329":100571},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2802":58631,"_24435":58626,"_17116":100573,"_5":17011,"_23186":58626,"_2329":100574},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2802":58632,"_24435":58626,"_17116":100576,"_5":17011,"_23186":58626,"_2329":100577},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2802":58633,"_24435":58626,"_17116":100579,"_5":17011,"_23186":100562,"_2329":97908},[],{"_2802":58634,"_24435":58626,"_17116":100581,"_5":17011,"_23186":100562,"_2329":96864},[],{"_2802":58635,"_24435":58626,"_17116":100583,"_5":17011,"_23186":100562,"_2329":93582},[],{"_2802":58636,"_24435":58626,"_17116":100585,"_5":17011,"_23186":100562,"_2329":47007},[],{"_2802":58637,"_24435":58626,"_17116":100587,"_5":17011,"_23186":100562,"_2329":100588},[],"Existe, está activa y sus fechas son utilizables.",{"_2802":58638,"_24435":58626,"_17116":100590,"_5":17011,"_23186":100562,"_2329":100591},[],"Autoridades.",{"_2802":58639,"_24435":58626,"_17116":100593,"_5":17011,"_23186":100562,"_2329":100594},[],"Clave",{"_2802":58640,"_24435":58626,"_17116":100596,"_5":17011,"_23186":100562,"_2329":100597},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2802":58641,"_24435":58626,"_17116":100599,"_5":17011,"_23186":100562,"_2329":100600},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2802":58642,"_24435":58626,"_17116":100602,"_5":17011,"_23186":100562,"_2329":47025},[],{"_2802":58643,"_24435":58626,"_17116":100604,"_5":17011,"_23186":100562,"_2329":100605},[],"PEM correcto y firma verificable.",{"_2802":58644,"_24435":58626,"_17116":100607,"_5":17011,"_23186":100562,"_2329":47031},[],{"_2802":58645,"_24435":58626,"_17116":100609,"_5":17011,"_23186":100562,"_2329":100610},[],"Perfil",{"_2802":58646,"_24435":58626,"_17116":100612,"_5":17011,"_23186":100562,"_2329":100613},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2802":58647,"_24435":58626,"_17116":100615,"_5":17011,"_23186":100562,"_2329":100616},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2802":58648,"_24435":58626,"_17116":100618,"_5":17011,"_23186":100562,"_2329":98060},[],{"_2802":58649,"_24435":58626,"_17116":100620,"_5":17011,"_23186":100562,"_2329":100621},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2802":58650,"_24435":58626,"_17116":100623,"_5":17011,"_23186":100562,"_2329":100624},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2802":58651,"_24435":58626,"_17116":100626,"_5":17011,"_23186":100562,"_2329":100627},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2802":58652,"_24435":58626,"_17116":100629,"_5":17011,"_23186":100562,"_2329":100630},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2802":58653,"_24435":58626,"_17116":100632,"_5":17011,"_23186":100566,"_2329":100633},[],"Revisa cada frontera por separado:",{"_2802":58654,"_24435":58626,"_17116":100635,"_5":17011,"_23186":100566,"_2329":100636},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2802":58655,"_24435":58626,"_17116":100638,"_5":17011,"_23186":100566,"_2329":100639},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2802":58656,"_24435":58626,"_17116":100641,"_5":17011,"_23186":100566,"_2329":100642},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2802":58657,"_24435":58626,"_17116":100644,"_5":17011,"_23186":100566,"_2329":100645},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2802":58658,"_24435":58626,"_17116":100647,"_5":17011,"_23186":100566,"_2329":100648},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2802":58659,"_24435":58626,"_17116":100650,"_5":17011,"_23186":100566,"_2329":100651},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2802":58660,"_24435":58626,"_17116":100653,"_5":17011,"_23186":100570,"_2329":100654},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2802":58661,"_24435":58626,"_17116":100656,"_5":17011,"_23186":100570,"_2329":100657},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_47085":100659,"_47087":100660,"_47089":100661,"_47091":100662,"_14894":2351,"_56346":2351},"spanish",[2329,24435,5,23186],{"_2329":20412,"_24435":20412,"_5":20412,"_23186":20412},{"_2329":100663,"_24435":102975,"_5":105287,"_23186":107599},{"_3756":100664,"_47095":100665,"_5":20412},{"_11783":7280,"_12126":2596,"_12133":6082,"_23681":3581,"_23269":4653,"_16239":7159,"_11804":2696,"_11811":6137,"_23643":6766,"_23988":3247,"_23998":3843,"_23656":3869,"_28209":16492,"_24009":6764,"_28214":5035,"_28217":24083,"_28220":8838,"_28223":3213,"_28226":7810,"_24310":5024,"_28231":2935,"_28233":19118,"_24346":11045,"_24300":14841,"_28237":12834,"_28240":6990,"_28242":6166,"_24027":16485,"_24305":4320,"_24364":6171,"_28247":5370,"_28249":15877,"_28251":3847,"_28253":4828,"_28255":19361,"_28257":2551,"_28259":5695,"_28261":4930,"_28263":2961,"_23694":5617,"_28266":5652,"_28268":2685,"_23688":8598,"_28271":4759,"_28273":22296,"_28275":5546,"_28278":4972,"_23724":2582,"_28282":9022,"_23634":6102,"_28285":2950,"_23661":12310,"_28288":13866,"_28290":3738,"_28293":6434,"_24341":2570,"_28296":4655,"_28298":9333,"_28301":6501,"_28303":4663,"_28305":4952,"_28307":6037,"_28309":9112,"_16242":5663,"_28312":4530,"_28314":6073,"_28316":8401,"_24021":5922,"_28319":17965,"_28321":4762,"_28323":4068,"_28325":8619,"_28327":14631,"_28329":3486,"_28331":6103,"_24421":3262,"_24048":19607,"_28335":14053,"_28337":7047,"_23672":3851,"_28340":3663,"_28342":4798,"_28344":7573,"_24359":6863,"_28347":2714,"_28349":3273,"_28351":3104,"_28353":564