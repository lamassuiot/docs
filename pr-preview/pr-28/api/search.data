_29820":41458,"_29822":41461,"_29824":41464,"_29826":41467,"_29828":41470,"_29830":41473,"_29832":41476,"_29834":41479,"_29836":41482,"_29838":41485,"_29840":41488,"_29842":41491,"_29844":41494,"_29846":41497,"_29848":41500,"_29850":41503,"_29852":41506,"_29854":41509,"_29856":41512,"_29858":41515,"_29860":41518,"_29862":41521,"_29864":41524,"_29866":41527,"_29868":41530,"_29870":41533,"_29872":41536,"_29874":41539,"_29876":41542,"_29878":41545,"_29880":41548,"_29882":41551,"_29884":41554,"_29886":41557,"_29888":41560,"_29890":41563,"_29892":41566,"_29894":41569,"_29896":41572,"_29898":41575,"_29900":41578,"_29902":41581,"_29904":41584,"_29906":41587,"_29908":41590,"_29910":41593,"_29912":41596,"_29914":41599,"_29916":41602,"_29918":41605,"_29920":41608,"_29922":41611,"_29924":41614,"_29926":41617,"_29928":41620,"_29930":41623,"_29932":41626,"_29934":41629,"_29936":41632,"_29938":41635,"_29940":41638,"_29942":41641,"_29944":41644,"_29946":41647,"_29948":41650,"_29950":41653,"_29952":41656,"_29954":41659,"_29956":41662,"_29958":41665,"_29960":41669,"_29962":41673,"_29964":41677,"_29966":41680,"_29968":41683,"_29970":41686,"_29972":41689},{"_2322":15,"_22971":15,"_5":10796,"_1911":35711,"_23246":35712,"_15675":35716,"_21706":15},"Deploy from AWS Marketplace",[35713,35714,35715],"Docs","Deployment","Other models",[],{"_2322":16,"_22971":15,"_15675":35718,"_5":15564,"_21706":15,"_1911":35719},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2322":17,"_22971":15,"_5":23243,"_15675":35721,"_21706":35722,"_1911":35723},[],"/docs/pr-preview/pr-28/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2322":18,"_22971":15,"_5":23243,"_15675":35725,"_21706":35726,"_1911":35727},[],"/docs/pr-preview/pr-28/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2322":19,"_22971":15,"_5":23243,"_15675":35729,"_21706":35730,"_1911":35731},[],"/docs/pr-preview/pr-28/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2322":20,"_22971":15,"_5":23243,"_15675":35733,"_21706":35734,"_1911":35735},[],"/docs/pr-preview/pr-28/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2322":21,"_22971":15,"_5":23243,"_15675":35737,"_21706":35738,"_1911":35739},[],"/docs/pr-preview/pr-28/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2322":22,"_22971":15,"_5":23243,"_15675":35741,"_21706":35742,"_1911":35743},[],"/docs/pr-preview/pr-28/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2322":23,"_22971":15,"_5":23243,"_15675":35745,"_21706":35746,"_1911":35747},[],"/docs/pr-preview/pr-28/deployment/aws-marketplace#next-step","Next step",{"_2322":24,"_22971":15,"_15675":35749,"_5":15564,"_21706":15,"_1911":35750},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2322":25,"_22971":15,"_15675":35752,"_5":15564,"_21706":35722,"_1911":35753},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2322":26,"_22971":15,"_15675":35755,"_5":15564,"_21706":35722,"_1911":35756},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2322":27,"_22971":15,"_15675":35758,"_5":15564,"_21706":35722,"_1911":35759},[],"A security group allowing the necessary endpoints.",{"_2322":28,"_22971":15,"_15675":35761,"_5":15564,"_21706":35726,"_1911":35762},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2322":29,"_22971":15,"_15675":35764,"_5":15564,"_21706":35726,"_1911":35765},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2322":30,"_22971":15,"_15675":35767,"_5":15564,"_21706":35726,"_1911":35768},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2322":31,"_22971":15,"_15675":35770,"_5":15564,"_21706":35730,"_1911":35771},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2322":32,"_22971":15,"_15675":35773,"_5":15564,"_21706":35734,"_1911":35774},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2322":33,"_22971":15,"_15675":35776,"_5":15564,"_21706":35738,"_1911":35777},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2322":34,"_22971":15,"_15675":35779,"_5":15564,"_21706":35742,"_1911":35780},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2322":35,"_22971":15,"_15675":35782,"_5":15564,"_21706":35746,"_1911":35783},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2322":36,"_22971":36,"_5":10796,"_1911":35785,"_23246":35786,"_15675":35787,"_21706":36},"Deploy Lamassu",[35713,35714],[],{"_2322":37,"_22971":36,"_15675":35789,"_5":15564,"_21706":36,"_1911":35790},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2322":38,"_22971":36,"_5":23243,"_15675":35792,"_21706":35793,"_1911":35794},[],"/docs/pr-preview/pr-28/deployment/overview#choose-a-model","Choose a model",{"_2322":39,"_22971":36,"_5":23243,"_15675":35796,"_21706":35797,"_1911":35798},[],"/docs/pr-preview/pr-28/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2322":40,"_22971":36,"_5":23243,"_15675":35800,"_21706":35801,"_1911":35802},[],"/docs/pr-preview/pr-28/deployment/overview#after-deployment","After deployment",{"_2322":41,"_22971":36,"_15675":35804,"_5":15564,"_21706":36,"_1911":35805},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2322":42,"_22971":36,"_15675":35807,"_5":15564,"_21706":35793,"_1911":35808},[],"Model",{"_2322":43,"_22971":36,"_15675":35810,"_5":15564,"_21706":35793,"_1911":35811},[],"Recommended for",{"_2322":44,"_22971":36,"_15675":35813,"_5":15564,"_21706":35793,"_1911":35814},[],"Who operates the infrastructure",{"_2322":45,"_22971":36,"_15675":35816,"_5":15564,"_21706":35793,"_1911":35817},[],"Starting point",{"_2322":46,"_22971":36,"_15675":35819,"_5":15564,"_21706":35793,"_1911":35820},[],"Kubernetes self-managed",{"_2322":47,"_22971":36,"_15675":35822,"_5":15564,"_21706":35793,"_1911":35823},[],"Production, regulated environments and custom deployments",{"_2322":48,"_22971":36,"_15675":35825,"_5":15564,"_21706":35793,"_1911":35826},[],"Your team",{"_2322":49,"_22971":36,"_15675":35828,"_5":15564,"_21706":35793,"_1911":35829},[],"Helm or Fastlane",{"_2322":50,"_22971":36,"_15675":35831,"_5":15564,"_21706":35793,"_1911":35832},[],"AWS Marketplace",{"_2322":51,"_22971":36,"_15675":35834,"_5":15564,"_21706":35793,"_1911":35835},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2322":52,"_22971":36,"_15675":35837,"_5":15564,"_21706":35793,"_1911":35826},[],{"_2322":53,"_22971":36,"_15675":35839,"_5":15564,"_21706":35793,"_1911":35840},[],"Preconfigured image on EC2",{"_2322":54,"_22971":36,"_15675":35842,"_5":15564,"_21706":35793,"_1911":35843},[],"SaaS",{"_2322":55,"_22971":36,"_15675":35845,"_5":15564,"_21706":35793,"_1911":35846},[],"Teams that want to use the platform without operating it",{"_2322":56,"_22971":36,"_15675":35848,"_5":15564,"_21706":35793,"_1911":35849},[],"Lamassu",{"_2322":57,"_22971":36,"_15675":35851,"_5":15564,"_21706":35793,"_1911":35852},[],"Managed subscription",{"_2322":58,"_22971":36,"_15675":35854,"_5":15564,"_21706":35793,"_1911":35855},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2322":59,"_22971":36,"_15675":35857,"_5":15564,"_21706":35793,"_1911":35858},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2322":60,"_22971":36,"_15675":35860,"_5":15564,"_21706":35793,"_1911":35861},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2322":61,"_22971":36,"_15675":35863,"_5":15564,"_21706":35797,"_1911":35864},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2322":62,"_22971":36,"_15675":35866,"_5":15564,"_21706":35801,"_1911":35867},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2322":63,"_22971":63,"_5":10796,"_1911":35869,"_23246":35870,"_15675":35871,"_21706":63},"Use Lamassu as SaaS",[35713,35714,35715],[],{"_2322":64,"_22971":63,"_15675":35873,"_5":15564,"_21706":63,"_1911":35874},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2322":65,"_22971":63,"_5":23243,"_15675":35876,"_21706":35877,"_1911":35878},[],"/docs/pr-preview/pr-28/deployment/saas#what-the-service-manages","What the service manages",{"_2322":66,"_22971":63,"_5":23243,"_15675":35880,"_21706":35881,"_1911":35882},[],"/docs/pr-preview/pr-28/deployment/saas#plans","Plans",{"_2322":67,"_22971":63,"_5":23243,"_15675":35884,"_21706":35885,"_1911":35886},[],"/docs/pr-preview/pr-28/deployment/saas#request-access","Request access",{"_2322":68,"_22971":63,"_15675":35888,"_5":15564,"_21706":63,"_1911":35889},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2322":69,"_22971":63,"_15675":35891,"_5":15564,"_21706":35877,"_1911":35892},[],"Platform availability and maintenance.",{"_2322":70,"_22971":63,"_15675":35894,"_5":15564,"_21706":35877,"_1911":35895},[],"Automatic backups.",{"_2322":71,"_22971":63,"_15675":35897,"_5":15564,"_21706":35877,"_1911":35898},[],"Version upgrades.",{"_2322":72,"_22971":63,"_15675":35900,"_5":15564,"_21706":35877,"_1911":35901},[],"Technical support and SLA according to your plan.",{"_2322":73,"_22971":63,"_15675":35903,"_5":15564,"_21706":35881,"_1911":35904},[],"Plan",{"_2322":74,"_22971":63,"_15675":35906,"_5":15564,"_21706":35881,"_1911":35907},[],"Devices",{"_2322":75,"_22971":63,"_15675":35909,"_5":15564,"_21706":35881,"_1911":35910},[],"Support",{"_2322":76,"_22971":63,"_15675":35912,"_5":15564,"_21706":35881,"_1911":35913},[],"SLA",{"_2322":77,"_22971":63,"_15675":35915,"_5":15564,"_21706":35881,"_1911":35916},[],"Starter",{"_2322":78,"_22971":63,"_15675":35918,"_5":15564,"_21706":35881,"_1911":35919},[],"Up to 1,000",{"_2322":79,"_22971":63,"_15675":35921,"_5":15564,"_21706":35881,"_1911":35922},[],"Email",{"_2322":80,"_22971":63,"_15675":35924,"_5":15564,"_21706":35881,"_1911":35925},[],"99.5 %",{"_2322":81,"_22971":63,"_15675":35927,"_5":15564,"_21706":35881,"_1911":35928},[],"Professional",{"_2322":82,"_22971":63,"_15675":35930,"_5":15564,"_21706":35881,"_1911":35931},[],"Up to 10,000",{"_2322":83,"_22971":63,"_15675":35933,"_5":15564,"_21706":35881,"_1911":35934},[],"Email and chat",{"_2322":84,"_22971":63,"_15675":35936,"_5":15564,"_21706":35881,"_1911":35937},[],"99.9 %",{"_2322":85,"_22971":63,"_15675":35939,"_5":15564,"_21706":35881,"_1911":35940},[],"Enterprise",{"_2322":86,"_22971":63,"_15675":35942,"_5":15564,"_21706":35881,"_1911":35943},[],"Unlimited",{"_2322":87,"_22971":63,"_15675":35945,"_5":15564,"_21706":35881,"_1911":35946},[],"Dedicated",{"_2322":88,"_22971":63,"_15675":35948,"_5":15564,"_21706":35881,"_1911":35949},[],"99.99 %",{"_2322":89,"_22971":63,"_15675":35951,"_5":15564,"_21706":35885,"_1911":35952},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2322":90,"_22971":63,"_15675":35954,"_5":15564,"_21706":35885,"_1911":35955},[],"When you receive your instance's credentials, continue with Get started.",{"_2322":91,"_22971":91,"_5":10796,"_1911":35957,"_23246":35958,"_15675":35959,"_21706":91},"Fastlane",[35713,35714,35820],[],{"_2322":92,"_22971":91,"_15675":35961,"_5":15564,"_21706":91,"_1911":35962},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2322":93,"_22971":91,"_5":23243,"_15675":35964,"_21706":35965,"_1911":35966},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2322":94,"_22971":91,"_5":23243,"_15675":35968,"_21706":35969,"_1911":35970},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2322":95,"_22971":91,"_5":23243,"_15675":35972,"_21706":35973,"_1911":35723},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#before-you-begin",{"_2322":96,"_22971":91,"_5":23243,"_15675":35975,"_21706":35976,"_1911":35977},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2322":97,"_22971":91,"_5":23243,"_15675":35979,"_21706":35980,"_1911":35981},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2322":98,"_22971":91,"_5":23243,"_15675":35983,"_21706":35984,"_1911":35985},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2322":99,"_22971":91,"_5":23243,"_15675":35987,"_21706":35988,"_1911":35989},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2322":100,"_22971":91,"_5":23243,"_15675":35991,"_21706":35992,"_1911":35993},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2322":101,"_22971":91,"_5":23243,"_15675":35995,"_21706":35996,"_1911":35997},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2322":102,"_22971":91,"_5":23243,"_15675":35999,"_21706":36000,"_1911":36001},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2322":103,"_22971":91,"_15675":36003,"_5":15564,"_21706":35965,"_1911":36004},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2322":104,"_22971":91,"_15675":36006,"_5":15564,"_21706":35965,"_1911":36007},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2322":105,"_22971":91,"_15675":36009,"_5":15564,"_21706":35969,"_1911":36010},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2322":106,"_22971":91,"_15675":36012,"_5":15564,"_21706":35969,"_1911":36013},[],"Fastlane installs or configures",{"_2322":107,"_22971":91,"_15675":36015,"_5":15564,"_21706":35969,"_1911":36016},[],"You still provide",{"_2322":108,"_22971":91,"_15675":36018,"_5":15564,"_21706":35969,"_1911":36019},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2322":109,"_22971":91,"_15675":36021,"_5":15564,"_21706":35969,"_1911":36022},[],"The Kubernetes cluster, nodes and persistent storage",{"_2322":110,"_22971":91,"_15675":36024,"_5":15564,"_21706":35969,"_1911":36025},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2322":111,"_22971":91,"_15675":36027,"_5":15564,"_21706":35969,"_1911":36028},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2322":112,"_22971":91,"_15675":36030,"_5":15564,"_21706":35969,"_1911":36031},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2322":113,"_22971":91,"_15675":36033,"_5":15564,"_21706":35969,"_1911":36034},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2322":114,"_22971":91,"_15675":36036,"_5":15564,"_21706":35969,"_1911":36037},[],"Optional observability and lab HSM components",{"_2322":115,"_22971":91,"_15675":36039,"_5":15564,"_21706":35969,"_1911":36040},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2322":116,"_22971":91,"_15675":36042,"_5":15564,"_21706":35969,"_1911":36043},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2322":117,"_22971":91,"_15675":36045,"_5":15564,"_21706":35973,"_1911":36046},[],"You need:",{"_2322":118,"_22971":91,"_15675":36048,"_5":15564,"_21706":35973,"_1911":36049},[],"an existing Kubernetes cluster",{"_2322":119,"_22971":91,"_15675":36051,"_5":15564,"_21706":35973,"_1911":36052},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2322":120,"_22971":91,"_15675":36054,"_5":15564,"_21706":35973,"_1911":36055},[],"`yq`",{"_2322":121,"_22971":91,"_15675":36057,"_5":15564,"_21706":35973,"_1911":17845},[],{"_2322":122,"_22971":91,"_15675":36059,"_5":15564,"_21706":35973,"_1911":36060},[],"`jq` only when using `--sample-data`",{"_2322":123,"_22971":91,"_15675":36062,"_5":15564,"_21706":35973,"_1911":36063},[],"free external ports 80 and 443 on a single-node K3s host",{"_2322":124,"_22971":91,"_15675":36065,"_5":15564,"_21706":35973,"_1911":36066},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2322":125,"_22971":91,"_15675":36068,"_5":15564,"_21706":35973,"_1911":36069},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2322":126,"_22971":91,"_15675":36071,"_5":15564,"_21706":35976,"_1911":36072},[],"Run the script from a clone of the Helm repository:",{"_2322":127,"_22971":91,"_15675":36074,"_5":15564,"_21706":35976,"_1911":36075},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2322":128,"_22971":91,"_15675":36077,"_5":15564,"_21706":35980,"_1911":36078},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2322":129,"_22971":91,"_15675":36080,"_5":15564,"_21706":35980,"_1911":36081},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2322":130,"_22971":91,"_15675":36083,"_5":15564,"_21706":35980,"_1911":36084},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2322":131,"_22971":91,"_15675":36086,"_5":15564,"_21706":35980,"_1911":36087},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2322":132,"_22971":91,"_15675":36089,"_5":15564,"_21706":35984,"_1911":36090},[],"Option",{"_2322":133,"_22971":91,"_15675":36092,"_5":15564,"_21706":35984,"_1911":36093},[],"Default",{"_2322":134,"_22971":91,"_15675":36095,"_5":15564,"_21706":35984,"_1911":36096},[],"Purpose",{"_2322":135,"_22971":91,"_15675":36098,"_5":15564,"_21706":35984,"_1911":36099},[],"`-h`, `--help`",{"_2322":136,"_22971":91,"_15675":36101,"_5":15564,"_21706":35984,"_1911":36102},[],"—",{"_2322":137,"_22971":91,"_15675":36104,"_5":15564,"_21706":35984,"_1911":36105},[],"Show help",{"_2322":138,"_22971":91,"_15675":36107,"_5":15564,"_21706":35984,"_1911":36108},[],"`-c`, `--context`",{"_2322":139,"_22971":91,"_15675":36110,"_5":15564,"_21706":35984,"_1911":36111},[],"current context",{"_2322":140,"_22971":91,"_15675":36113,"_5":15564,"_21706":35984,"_1911":36114},[],"Select the kubeconfig context for kubectl and Helm",{"_2322":141,"_22971":91,"_15675":36116,"_5":15564,"_21706":35984,"_1911":36117},[],"`-n`, `--non-interactive`",{"_2322":142,"_22971":91,"_15675":36119,"_5":15564,"_21706":35984,"_1911":4456},[],{"_2322":143,"_22971":91,"_15675":36121,"_5":15564,"_21706":35984,"_1911":36122},[],"Skip prompts and generate dependency credentials",{"_2322":144,"_22971":91,"_15675":36124,"_5":15564,"_21706":35984,"_1911":36125},[],"`-ns`, `--namespace`",{"_2322":145,"_22971":91,"_15675":36127,"_5":15564,"_21706":35984,"_1911":36128},[],"`lamassu-dev`",{"_2322":146,"_22971":91,"_15675":36130,"_5":15564,"_21706":35984,"_1911":36131},[],"Namespace for the installation",{"_2322":147,"_22971":91,"_15675":36133,"_5":15564,"_21706":35984,"_1911":36134},[],"`-d`, `--domain`",{"_2322":148,"_22971":91,"_15675":36136,"_5":15564,"_21706":35984,"_1911":36137},[],"`dev.lamassu.io`",{"_2322":149,"_22971":91,"_15675":36139,"_5":15564,"_21706":35984,"_1911":36140},[],"Domain used by the UI, OIDC and certificate",{"_2322":150,"_22971":91,"_15675":36142,"_5":15564,"_21706":35984,"_1911":36143},[],"`-v`, `--version`",{"_2322":151,"_22971":91,"_15675":36145,"_5":15564,"_21706":35984,"_1911":11003},[],{"_2322":152,"_22971":91,"_15675":36147,"_5":15564,"_21706":35984,"_1911":36148},[],"Lamassu chart version",{"_2322":153,"_22971":91,"_15675":36150,"_5":15564,"_21706":35984,"_1911":36151},[],"`--https-port`",{"_2322":154,"_22971":91,"_15675":36153,"_5":15564,"_21706":35984,"_1911":36154},[],"`443`",{"_2322":155,"_22971":91,"_15675":36156,"_5":15564,"_21706":35984,"_1911":36157},[],"Gateway HTTPS listener port",{"_2322":156,"_22971":91,"_15675":36159,"_5":15564,"_21706":35984,"_1911":36160},[],"`--http-port`",{"_2322":157,"_22971":91,"_15675":36162,"_5":15564,"_21706":35984,"_1911":36163},[],"`80`",{"_2322":158,"_22971":91,"_15675":36165,"_5":15564,"_21706":35984,"_1911":36166},[],"Gateway HTTP listener port",{"_2322":159,"_22971":91,"_15675":36168,"_5":15564,"_21706":35984,"_1911":36169},[],"`--tls-crt`",{"_2322":160,"_22971":91,"_15675":36171,"_5":15564,"_21706":35984,"_1911":36102},[],{"_2322":161,"_22971":91,"_15675":36173,"_5":15564,"_21706":35984,"_1911":36174},[],"PEM certificate for downstream TLS",{"_2322":162,"_22971":91,"_15675":36176,"_5":15564,"_21706":35984,"_1911":36177},[],"`--tls-key`",{"_2322":163,"_22971":91,"_15675":36179,"_5":15564,"_21706":35984,"_1911":36102},[],{"_2322":164,"_22971":91,"_15675":36181,"_5":15564,"_21706":35984,"_1911":36182},[],"PEM private key for downstream TLS",{"_2322":165,"_22971":91,"_15675":36184,"_5":15564,"_21706":35984,"_1911":36185},[],"`-l`, `--local-chart-path`",{"_2322":166,"_22971":91,"_15675":36187,"_5":15564,"_21706":35984,"_1911":36188},[],"repository chart",{"_2322":167,"_22971":91,"_15675":36190,"_5":15564,"_21706":35984,"_1911":36191},[],"Use an unpacked local Lamassu chart",{"_2322":168,"_22971":91,"_15675":36193,"_5":15564,"_21706":35984,"_1911":36194},[],"`-ip`, `--gateway-ip`",{"_2322":169,"_22971":91,"_15675":36196,"_5":15564,"_21706":35984,"_1911":6272},[],{"_2322":170,"_22971":91,"_15675":36198,"_5":15564,"_21706":35984,"_1911":36199},[],"Override the address written to `gateway.addresses`",{"_2322":171,"_22971":91,"_15675":36201,"_5":15564,"_21706":35984,"_1911":36202},[],"`--otel`",{"_2322":172,"_22971":91,"_15675":36204,"_5":15564,"_21706":35984,"_1911":4456},[],{"_2322":173,"_22971":91,"_15675":36206,"_5":15564,"_21706":35984,"_1911":36207},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2322":174,"_22971":91,"_15675":36209,"_5":15564,"_21706":35984,"_1911":36210},[],"`--sample-data`",{"_2322":175,"_22971":91,"_15675":36212,"_5":15564,"_21706":35984,"_1911":4456},[],{"_2322":176,"_22971":91,"_15675":36214,"_5":15564,"_21706":35984,"_1911":36215},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2322":177,"_22971":91,"_15675":36217,"_5":15564,"_21706":35984,"_1911":36218},[],"`--with-hsm`",{"_2322":178,"_22971":91,"_15675":36220,"_5":15564,"_21706":35984,"_1911":4456},[],{"_2322":179,"_22971":91,"_15675":36222,"_5":15564,"_21706":35984,"_1911":36223},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2322":180,"_22971":91,"_15675":36225,"_5":15564,"_21706":35984,"_1911":36226},[],"`--softhsm-chart-path`",{"_2322":181,"_22971":91,"_15675":36228,"_5":15564,"_21706":35984,"_1911":36229},[],"`./charts/softhsm`",{"_2322":182,"_22971":91,"_15675":36231,"_5":15564,"_21706":35984,"_1911":36232},[],"Use a different local SoftHSM chart",{"_2322":183,"_22971":91,"_15675":36234,"_5":15564,"_21706":35984,"_1911":36235},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2322":184,"_22971":91,"_15675":36237,"_5":15564,"_21706":35988,"_1911":36238},[],"Fastlane:",{"_2322":185,"_22971":91,"_15675":36240,"_5":15564,"_21706":35988,"_1911":36241},[],"validates local tools and the selected cluster",{"_2322":186,"_22971":91,"_15675":36243,"_5":15564,"_21706":35988,"_1911":36244},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2322":187,"_22971":91,"_15675":36246,"_5":15564,"_21706":35988,"_1911":36247},[],"creates the namespace",{"_2322":188,"_22971":91,"_15675":36249,"_5":15564,"_21706":35988,"_1911":36250},[],"installs PostgreSQL and creates the required databases",{"_2322":189,"_22971":91,"_15675":36252,"_5":15564,"_21706":35988,"_1911":36253},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2322":190,"_22971":91,"_15675":36255,"_5":15564,"_21706":35988,"_1911":36256},[],"installs RabbitMQ",{"_2322":191,"_22971":91,"_15675":36258,"_5":15564,"_21706":35988,"_1911":36259},[],"optionally installs observability and lab HSM components",{"_2322":192,"_22971":91,"_15675":36261,"_5":15564,"_21706":35988,"_1911":36262},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2322":193,"_22971":91,"_15675":36264,"_5":15564,"_21706":35988,"_1911":36265},[],"optionally loads sample data",{"_2322":194,"_22971":91,"_15675":36267,"_5":15564,"_21706":35988,"_1911":36268},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2322":195,"_22971":91,"_15675":36270,"_5":15564,"_21706":35992,"_1911":36271},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2322":196,"_22971":91,"_15675":36273,"_5":15564,"_21706":35992,"_1911":36274},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2322":197,"_22971":91,"_15675":36276,"_5":15564,"_21706":35996,"_1911":36277},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2322":198,"_22971":91,"_15675":36279,"_5":15564,"_21706":35996,"_1911":36280},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2322":199,"_22971":91,"_15675":36282,"_5":15564,"_21706":35996,"_1911":36283},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2322":200,"_22971":91,"_15675":36285,"_5":15564,"_21706":36000,"_1911":36286},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2322":201,"_22971":201,"_5":10796,"_1911":36288,"_23246":36289,"_15675":36290,"_21706":201},"Install with Helm",[35713,35714,35820],[],{"_2322":202,"_22971":201,"_15675":36292,"_5":15564,"_21706":201,"_1911":36293},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2322":203,"_22971":201,"_5":23243,"_15675":36295,"_21706":36296,"_1911":36297},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2322":204,"_22971":201,"_5":23243,"_15675":36299,"_21706":36300,"_1911":35723},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#before-you-begin",{"_2322":205,"_22971":201,"_5":23243,"_15675":36302,"_21706":36303,"_1911":36304},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2322":206,"_22971":201,"_5":23243,"_15675":36306,"_21706":36307,"_1911":36308},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2322":207,"_22971":201,"_5":23243,"_15675":36310,"_21706":36311,"_1911":36312},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2322":208,"_22971":201,"_5":23243,"_15675":36314,"_21706":36315,"_1911":36316},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2322":209,"_22971":201,"_5":23243,"_15675":36318,"_21706":36319,"_1911":36320},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2322":210,"_22971":201,"_5":23243,"_15675":36322,"_21706":36323,"_1911":36324},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2322":211,"_22971":201,"_5":23243,"_15675":36326,"_21706":36327,"_1911":36328},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2322":212,"_22971":201,"_15675":36330,"_5":15564,"_21706":36296,"_1911":36331},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2322":213,"_22971":201,"_15675":36333,"_5":15564,"_21706":36300,"_1911":36334},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2322":214,"_22971":201,"_15675":36336,"_5":15564,"_21706":36300,"_1911":36337},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2322":215,"_22971":201,"_15675":36339,"_5":15564,"_21706":36300,"_1911":36340},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2322":216,"_22971":201,"_15675":36342,"_5":15564,"_21706":36300,"_1911":36343},[],"a reachable RabbitMQ broker and credentials",{"_2322":217,"_22971":201,"_15675":36345,"_5":15564,"_21706":36300,"_1911":36346},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2322":218,"_22971":201,"_15675":36348,"_5":15564,"_21706":36300,"_1911":36349},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2322":219,"_22971":201,"_15675":36351,"_5":15564,"_21706":36300,"_1911":36352},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2322":220,"_22971":201,"_15675":36354,"_5":15564,"_21706":36300,"_1911":36355},[],"a StorageClass and an external traffic design",{"_2322":221,"_22971":201,"_15675":36357,"_5":15564,"_21706":36300,"_1911":36358},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2322":222,"_22971":201,"_15675":36360,"_5":15564,"_21706":36300,"_1911":36361},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2322":223,"_22971":201,"_15675":36363,"_5":15564,"_21706":36300,"_1911":36364},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2322":224,"_22971":201,"_15675":36366,"_5":15564,"_21706":36303,"_1911":36367},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2322":225,"_22971":201,"_15675":36369,"_5":15564,"_21706":36303,"_1911":36370},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2322":226,"_22971":201,"_15675":36372,"_5":15564,"_21706":36303,"_1911":36373},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2322":227,"_22971":201,"_15675":36375,"_5":15564,"_21706":36307,"_1911":36376},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2322":228,"_22971":201,"_15675":36378,"_5":15564,"_21706":36307,"_1911":36379},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2322":229,"_22971":201,"_15675":36381,"_5":15564,"_21706":36307,"_1911":36382},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2322":230,"_22971":201,"_15675":36384,"_5":15564,"_21706":36311,"_1911":36385},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2322":231,"_22971":201,"_15675":36387,"_5":15564,"_21706":36315,"_1911":36388},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2322":232,"_22971":201,"_15675":36390,"_5":15564,"_21706":36315,"_1911":36391},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2322":233,"_22971":201,"_15675":36393,"_5":15564,"_21706":36315,"_1911":36394},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2322":234,"_22971":201,"_15675":36396,"_5":15564,"_21706":36315,"_1911":36397},[],"See Access control for the principal and policy model.",{"_2322":235,"_22971":201,"_15675":36399,"_5":15564,"_21706":36319,"_1911":36400},[],"To install a local checkout instead:",{"_2322":236,"_22971":201,"_15675":36402,"_5":15564,"_21706":36323,"_1911":36403},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2322":237,"_22971":201,"_15675":36405,"_5":15564,"_21706":36323,"_1911":36406},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2322":238,"_22971":201,"_15675":36408,"_5":15564,"_21706":36327,"_1911":36409},[],"Before going live, review:",{"_2322":239,"_22971":201,"_15675":36411,"_5":15564,"_21706":36327,"_1911":36412},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2322":240,"_22971":201,"_15675":36414,"_5":15564,"_21706":36327,"_1911":36415},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2322":241,"_22971":201,"_15675":36417,"_5":15564,"_21706":36327,"_1911":36418},[],"shared VA storage before increasing VA replicas",{"_2322":242,"_22971":201,"_15675":36420,"_5":15564,"_21706":36327,"_1911":36421},[],"managed OIDC roles and removal of evaluation credentials",{"_2322":243,"_22971":201,"_15675":36423,"_5":15564,"_21706":36327,"_1911":36424},[],"a trusted TLS issuer or externally managed certificate",{"_2322":244,"_22971":201,"_15675":36426,"_5":15564,"_21706":36327,"_1911":36427},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2322":245,"_22971":201,"_15675":36429,"_5":15564,"_21706":36327,"_1911":36430},[],"SMTP, observability and alert delivery",{"_2322":246,"_22971":201,"_15675":36432,"_5":15564,"_21706":36327,"_1911":36433},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2322":247,"_22971":201,"_15675":36435,"_5":15564,"_21706":36327,"_1911":36436},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2322":248,"_22971":248,"_5":10796,"_1911":36438,"_23246":36439,"_15675":36440,"_21706":248},"Expose the Gateway",[35713,35714,35820],[],{"_2322":249,"_22971":248,"_15675":36442,"_5":15564,"_21706":248,"_1911":36443},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2322":250,"_22971":248,"_5":23243,"_15675":36445,"_21706":36446,"_1911":36447},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2322":251,"_22971":248,"_5":23243,"_15675":36449,"_21706":36450,"_1911":36451},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2322":252,"_22971":248,"_5":23243,"_15675":36453,"_21706":36454,"_1911":36455},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2322":253,"_22971":248,"_5":23243,"_15675":36457,"_21706":36458,"_1911":36459},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#k3s","K3s",{"_2322":254,"_22971":248,"_5":23243,"_15675":36461,"_21706":36462,"_1911":36463},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2322":255,"_22971":248,"_5":23243,"_15675":36465,"_21706":36466,"_1911":36467},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2322":256,"_22971":248,"_5":23243,"_15675":36469,"_21706":36470,"_1911":36471},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2322":257,"_22971":248,"_5":23243,"_15675":36473,"_21706":36474,"_1911":36475},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2322":258,"_22971":248,"_5":23243,"_15675":36477,"_21706":36478,"_1911":36479},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2322":259,"_22971":248,"_15675":36481,"_5":15564,"_21706":36446,"_1911":36482},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2322":260,"_22971":248,"_15675":36484,"_5":15564,"_21706":36446,"_1911":36485},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2322":261,"_22971":248,"_15675":36487,"_5":15564,"_21706":36450,"_1911":36488},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2322":262,"_22971":248,"_15675":36490,"_5":15564,"_21706":36450,"_1911":36491},[],"Set it only when:",{"_2322":263,"_22971":248,"_15675":36493,"_5":15564,"_21706":36450,"_1911":36494},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2322":264,"_22971":248,"_15675":36496,"_5":15564,"_21706":36450,"_1911":36497},[],"that address is allocated to this Gateway",{"_2322":265,"_22971":248,"_15675":36499,"_5":15564,"_21706":36450,"_1911":36500},[],"the surrounding network already routes traffic for it to the cluster",{"_2322":266,"_22971":248,"_15675":36502,"_5":15564,"_21706":36450,"_1911":36503},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2322":267,"_22971":248,"_15675":36505,"_5":15564,"_21706":36450,"_1911":36506},[],"Keep these two settings separate:",{"_2322":268,"_22971":248,"_15675":36508,"_5":15564,"_21706":36450,"_1911":36509},[],"`gateway.addresses` requests an address for the Gateway.",{"_2322":269,"_22971":248,"_15675":36511,"_5":15564,"_21706":36450,"_1911":36512},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2322":270,"_22971":248,"_15675":36514,"_5":15564,"_21706":36450,"_1911":36515},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2322":271,"_22971":248,"_15675":36517,"_5":15564,"_21706":36454,"_1911":36518},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2322":272,"_22971":248,"_15675":36520,"_5":15564,"_21706":36454,"_1911":36521},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2322":273,"_22971":248,"_15675":36523,"_5":15564,"_21706":36458,"_1911":36524},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2322":274,"_22971":248,"_15675":36526,"_5":15564,"_21706":36458,"_1911":36527},[],"For the recommended design:",{"_2322":275,"_22971":248,"_15675":36529,"_5":15564,"_21706":36458,"_1911":36530},[],"Use only one externally exposed Lamassu Gateway.",{"_2322":276,"_22971":248,"_15675":36532,"_5":15564,"_21706":36458,"_1911":36533},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2322":277,"_22971":248,"_15675":36535,"_5":15564,"_21706":36458,"_1911":36536},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2322":278,"_22971":248,"_15675":36538,"_5":15564,"_21706":36458,"_1911":36539},[],"Point DNS at the VM's reachable address.",{"_2322":279,"_22971":248,"_15675":36541,"_5":15564,"_21706":36458,"_1911":36542},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2322":280,"_22971":248,"_15675":36544,"_5":15564,"_21706":36462,"_1911":36545},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2322":281,"_22971":248,"_15675":36547,"_5":15564,"_21706":36466,"_1911":36548},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2322":282,"_22971":248,"_15675":36550,"_5":15564,"_21706":36466,"_1911":36551},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2322":283,"_22971":248,"_15675":36553,"_5":15564,"_21706":36470,"_1911":36554},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2322":284,"_22971":248,"_15675":36556,"_5":15564,"_21706":36470,"_1911":36557},[],"Requirement",{"_2322":285,"_22971":248,"_15675":36559,"_5":15564,"_21706":36470,"_1911":36560},[],"Recommended design",{"_2322":286,"_22971":248,"_15675":36562,"_5":15564,"_21706":36470,"_1911":36563},[],"Consequence",{"_2322":287,"_22971":248,"_15675":36565,"_5":15564,"_21706":36470,"_1911":36566},[],"Several Lamassu URLs or services",{"_2322":288,"_22971":248,"_15675":36568,"_5":15564,"_21706":36470,"_1911":36569},[],"One Gateway with multiple routes",{"_2322":289,"_22971":248,"_15675":36571,"_5":15564,"_21706":36470,"_1911":36572},[],"One IP and one proxy fleet; this is the chart default",{"_2322":290,"_22971":248,"_15675":36574,"_5":15564,"_21706":36470,"_1911":36575},[],"Independent Gateways and separate external IPs",{"_2322":291,"_22971":248,"_15675":36577,"_5":15564,"_21706":36470,"_1911":36578},[],"One VIP per Gateway",{"_2322":292,"_22971":248,"_15675":36580,"_5":15564,"_21706":36470,"_1911":36581},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2322":293,"_22971":248,"_15675":36583,"_5":15564,"_21706":36470,"_1911":36584},[],"Independent Gateways on one node and one IP",{"_2322":294,"_22971":248,"_15675":36586,"_5":15564,"_21706":36470,"_1911":36587},[],"Use different external ports",{"_2322":295,"_22971":248,"_15675":36589,"_5":15564,"_21706":36470,"_1911":36590},[],"Clients must include non-standard ports",{"_2322":296,"_22971":248,"_15675":36592,"_5":15564,"_21706":36470,"_1911":36593},[],"Separate TLS/mTLS termination behind one IP",{"_2322":297,"_22971":248,"_15675":36595,"_5":15564,"_21706":36470,"_1911":36596},[],"Front-door SNI routing to internal Gateways",{"_2322":298,"_22971":248,"_15675":36598,"_5":15564,"_21706":36470,"_1911":36599},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2322":299,"_22971":248,"_15675":36601,"_5":15564,"_21706":36470,"_1911":36602},[],"Separate Gateway resources but shared proxy infrastructure",{"_2322":300,"_22971":248,"_15675":36604,"_5":15564,"_21706":36470,"_1911":36605},[],"Envoy merged-Gateway mode",{"_2322":301,"_22971":248,"_15675":36607,"_5":15564,"_21706":36470,"_1911":36608},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2322":302,"_22971":248,"_15675":36610,"_5":15564,"_21706":36470,"_1911":36611},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2322":303,"_22971":248,"_15675":36613,"_5":15564,"_21706":36470,"_1911":36614},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2322":304,"_22971":248,"_15675":36616,"_5":15564,"_21706":36470,"_1911":36617},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2322":305,"_22971":248,"_15675":36619,"_5":15564,"_21706":36470,"_1911":36620},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2322":306,"_22971":248,"_15675":36622,"_5":15564,"_21706":36474,"_1911":36623},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2322":307,"_22971":248,"_15675":36625,"_5":15564,"_21706":36474,"_1911":36626},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2322":308,"_22971":248,"_15675":36628,"_5":15564,"_21706":36474,"_1911":36629},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2322":309,"_22971":248,"_15675":36631,"_5":15564,"_21706":36474,"_1911":36632},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2322":310,"_22971":248,"_15675":36634,"_5":15564,"_21706":36474,"_1911":36635},[],"If none of those are possible, use different external ports or change the external network design.",{"_2322":311,"_22971":248,"_15675":36637,"_5":15564,"_21706":36478,"_1911":36638},[],"Check, in order:",{"_2322":312,"_22971":248,"_15675":36640,"_5":15564,"_21706":36478,"_1911":36641},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2322":313,"_22971":248,"_15675":36643,"_5":15564,"_21706":36478,"_1911":36644},[],"Its status contains the expected address.",{"_2322":314,"_22971":248,"_15675":36646,"_5":15564,"_21706":36478,"_1911":36647},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2322":315,"_22971":248,"_15675":36649,"_5":15564,"_21706":36478,"_1911":36650},[],"Port 443 reaches that address from the client network.",{"_2322":316,"_22971":248,"_15675":36652,"_5":15564,"_21706":36478,"_1911":36653},[],"DNS resolves to the externally reachable endpoint.",{"_2322":317,"_22971":248,"_15675":36655,"_5":15564,"_21706":36478,"_1911":36656},[],"The certificate contains the DNS name or IP used by the client.",{"_2322":318,"_22971":248,"_15675":36658,"_5":15564,"_21706":36478,"_1911":36659},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2322":319,"_22971":319,"_5":10796,"_1911":35820,"_23246":36661,"_15675":36662,"_21706":319},[35713,35714,35820],[],{"_2322":320,"_22971":319,"_15675":36664,"_5":15564,"_21706":319,"_1911":36665},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2322":321,"_22971":319,"_5":23243,"_15675":36667,"_21706":36668,"_1911":36669},[],"/docs/pr-preview/pr-28/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2322":322,"_22971":319,"_5":23243,"_15675":36671,"_21706":36672,"_1911":36673},[],"/docs/pr-preview/pr-28/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2322":323,"_22971":319,"_5":23243,"_15675":36675,"_21706":36676,"_1911":36677},[],"/docs/pr-preview/pr-28/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2322":324,"_22971":319,"_5":23243,"_15675":36679,"_21706":36680,"_1911":36681},[],"/docs/pr-preview/pr-28/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2322":325,"_22971":319,"_5":23243,"_15675":36683,"_21706":36684,"_1911":36685},[],"/docs/pr-preview/pr-28/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2322":326,"_22971":319,"_5":23243,"_15675":36687,"_21706":36688,"_1911":36689},[],"/docs/pr-preview/pr-28/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2322":327,"_22971":319,"_15675":36691,"_5":15564,"_21706":36668,"_1911":36692},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2322":328,"_22971":319,"_15675":36694,"_5":15564,"_21706":36672,"_1911":36695},[],"Workflow",{"_2322":329,"_22971":319,"_15675":36697,"_5":15564,"_21706":36672,"_1911":36698},[],"Use it for",{"_2322":330,"_22971":319,"_15675":36700,"_5":15564,"_21706":36672,"_1911":36701},[],"What it installs",{"_2322":331,"_22971":319,"_15675":36703,"_5":15564,"_21706":36672,"_1911":36704},[],"Helm",{"_2322":332,"_22971":319,"_15675":36706,"_5":15564,"_21706":36672,"_1911":36707},[],"Production and controlled environments",{"_2322":333,"_22971":319,"_15675":36709,"_5":15564,"_21706":36672,"_1911":36710},[],"Lamassu services and Gateway API resources",{"_2322":334,"_22971":319,"_15675":36712,"_5":15564,"_21706":36672,"_1911":35957},[],{"_2322":335,"_22971":319,"_15675":36714,"_5":15564,"_21706":36672,"_1911":36715},[],"Evaluation, demos, CI and small lab clusters",{"_2322":336,"_22971":319,"_15675":36717,"_5":15564,"_21706":36672,"_1911":36718},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2322":337,"_22971":319,"_15675":36720,"_5":15564,"_21706":36676,"_1911":36721},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2322":338,"_22971":319,"_15675":36723,"_5":15564,"_21706":36676,"_1911":36724},[],"Area",{"_2322":339,"_22971":319,"_15675":36726,"_5":15564,"_21706":36676,"_1911":36727},[],"The Lamassu chart provides",{"_2322":340,"_22971":319,"_15675":36729,"_5":15564,"_21706":36676,"_1911":36730},[],"You provide",{"_2322":341,"_22971":319,"_15675":36732,"_5":15564,"_21706":36676,"_1911":36733},[],"Lamassu applications",{"_2322":342,"_22971":319,"_15675":36735,"_5":15564,"_21706":36676,"_1911":36736},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2322":343,"_22971":319,"_15675":36738,"_5":15564,"_21706":36676,"_1911":36739},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2322":344,"_22971":319,"_15675":36741,"_5":15564,"_21706":36676,"_1911":36742},[],"PostgreSQL data",{"_2322":345,"_22971":319,"_15675":36744,"_5":15564,"_21706":36676,"_1911":36745},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2322":346,"_22971":319,"_15675":36747,"_5":15564,"_21706":36676,"_1911":36748},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2322":347,"_22971":319,"_15675":36750,"_5":15564,"_21706":36676,"_1911":36751},[],"Messaging",{"_2322":348,"_22971":319,"_15675":36753,"_5":15564,"_21706":36676,"_1911":36754},[],"RabbitMQ connection configuration for the Lamassu services",{"_2322":349,"_22971":319,"_15675":36756,"_5":15564,"_21706":36676,"_1911":36757},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2322":350,"_22971":319,"_15675":36759,"_5":15564,"_21706":36676,"_1911":36760},[],"Identity",{"_2322":351,"_22971":319,"_15675":36762,"_5":15564,"_21706":36676,"_1911":36763},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2322":352,"_22971":319,"_15675":36765,"_5":15564,"_21706":36676,"_1911":36766},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2322":353,"_22971":319,"_15675":36768,"_5":15564,"_21706":36676,"_1911":36769},[],"External routing",{"_2322":354,"_22971":319,"_15675":36771,"_5":15564,"_21706":36676,"_1911":36772},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2322":355,"_22971":319,"_15675":36774,"_5":15564,"_21706":36676,"_1911":36775},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2322":356,"_22971":319,"_15675":36777,"_5":15564,"_21706":36676,"_1911":36778},[],"TLS",{"_2322":357,"_22971":319,"_15675":36780,"_5":15564,"_21706":36676,"_1911":36781},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2322":358,"_22971":319,"_15675":36783,"_5":15564,"_21706":36676,"_1911":36784},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2322":359,"_22971":319,"_15675":36786,"_5":15564,"_21706":36676,"_1911":36787},[],"Persistent application data",{"_2322":360,"_22971":319,"_15675":36789,"_5":15564,"_21706":36676,"_1911":36790},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2322":361,"_22971":319,"_15675":36792,"_5":15564,"_21706":36676,"_1911":36793},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2322":362,"_22971":319,"_15675":36795,"_5":15564,"_21706":36676,"_1911":36796},[],"Optional integrations",{"_2322":363,"_22971":319,"_15675":36798,"_5":15564,"_21706":36676,"_1911":36799},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2322":364,"_22971":319,"_15675":36801,"_5":15564,"_21706":36676,"_1911":36802},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2322":365,"_22971":319,"_15675":36804,"_5":15564,"_21706":36676,"_1911":36805},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2322":366,"_22971":319,"_15675":36807,"_5":15564,"_21706":36676,"_1911":36808},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2322":367,"_22971":319,"_15675":36810,"_5":15564,"_21706":36680,"_1911":36811},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2322":368,"_22971":319,"_15675":36813,"_5":15564,"_21706":36680,"_1911":36814},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2322":369,"_22971":319,"_15675":36816,"_5":15564,"_21706":36684,"_1911":36817},[],"Kubernetes 1.24 or newer",{"_2322":370,"_22971":319,"_15675":36819,"_5":15564,"_21706":36684,"_1911":36820},[],"Helm 3.2 or newer",{"_2322":371,"_22971":319,"_15675":36822,"_5":15564,"_21706":36684,"_1911":36823},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2322":372,"_22971":319,"_15675":36825,"_5":15564,"_21706":36684,"_1911":36826},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2322":373,"_22971":319,"_15675":36828,"_5":15564,"_21706":36684,"_1911":36829},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2322":374,"_22971":319,"_15675":36831,"_5":15564,"_21706":36684,"_1911":36832},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2322":375,"_22971":319,"_15675":36834,"_5":15564,"_21706":36684,"_1911":36835},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2322":376,"_22971":319,"_15675":36837,"_5":15564,"_21706":36688,"_1911":36838},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2322":377,"_22971":319,"_15675":36840,"_5":15564,"_21706":36688,"_1911":36841},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2322":378,"_22971":319,"_15675":36843,"_5":15564,"_21706":36688,"_1911":36844},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2322":379,"_22971":379,"_5":10796,"_1911":36846,"_23246":36847,"_15675":36850,"_21706":379},"Access control",[35713,36848,36849],"Platform","Administer Lamassu",[],{"_2322":380,"_22971":379,"_15675":36852,"_5":15564,"_21706":379,"_1911":36853},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2322":381,"_22971":379,"_5":23243,"_15675":36855,"_21706":36856,"_1911":36857},[],"/docs/pr-preview/pr-28/platform/pki/access-control#essential-concepts","Essential concepts",{"_2322":382,"_22971":379,"_5":23243,"_15675":36859,"_21706":36860,"_1911":36861},[],"/docs/pr-preview/pr-28/platform/pki/access-control#two-decision-systems","Two decision systems",{"_2322":383,"_22971":379,"_5":23243,"_15675":36863,"_21706":36864,"_1911":36865},[],"/docs/pr-preview/pr-28/platform/pki/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2322":384,"_22971":379,"_5":23243,"_15675":36867,"_21706":36868,"_1911":36869},[],"/docs/pr-preview/pr-28/platform/pki/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2322":385,"_22971":379,"_5":23243,"_15675":36871,"_21706":36872,"_1911":36873},[],"/docs/pr-preview/pr-28/platform/pki/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2322":386,"_22971":379,"_5":23243,"_15675":36875,"_21706":36876,"_1911":36877},[],"/docs/pr-preview/pr-28/platform/pki/access-control#how-the-two-paths-relate","How the two paths relate",{"_2322":387,"_22971":379,"_5":23243,"_15675":36879,"_21706":36880,"_1911":36881},[],"/docs/pr-preview/pr-28/platform/pki/access-control#oidc-principals","OIDC principals",{"_2322":388,"_22971":379,"_5":23243,"_15675":36883,"_21706":36884,"_1911":36885},[],"/docs/pr-preview/pr-28/platform/pki/access-control#x509-principals","X.509 principals",{"_2322":389,"_22971":379,"_5":23243,"_15675":36887,"_21706":36888,"_1911":36889},[],"/docs/pr-preview/pr-28/platform/pki/access-control#when-several-principals-match","When several principals match",{"_2322":390,"_22971":379,"_5":23243,"_15675":36891,"_21706":36892,"_1911":36893},[],"/docs/pr-preview/pr-28/platform/pki/access-control#how-policies-express-access","How policies express access",{"_2322":391,"_22971":379,"_5":23243,"_15675":36895,"_21706":36896,"_1911":36897},[],"/docs/pr-preview/pr-28/platform/pki/access-control#global-and-direct-access","Global and direct access",{"_2322":392,"_22971":379,"_5":23243,"_15675":36899,"_21706":36900,"_1911":36901},[],"/docs/pr-preview/pr-28/platform/pki/access-control#access-inherited-through-relations","Access inherited through relations",{"_2322":393,"_22971":379,"_5":23243,"_15675":36903,"_21706":36904,"_1911":36905},[],"/docs/pr-preview/pr-28/platform/pki/access-control#attribute-filtered-access","Attribute-filtered access",{"_2322":394,"_22971":379,"_5":23243,"_15675":36907,"_21706":36908,"_1911":36909},[],"/docs/pr-preview/pr-28/platform/pki/access-control#http-rules","HTTP rules",{"_2322":395,"_22971":379,"_5":23243,"_15675":36911,"_21706":36912,"_1911":36913},[],"/docs/pr-preview/pr-28/platform/pki/access-control#included-policies","Included policies",{"_2322":396,"_22971":379,"_5":23243,"_15675":36915,"_21706":36916,"_1911":36316},[],"/docs/pr-preview/pr-28/platform/pki/access-control#provision-the-first-administrator",{"_2322":397,"_22971":379,"_5":23243,"_15675":36918,"_21706":36919,"_1911":36920},[],"/docs/pr-preview/pr-28/platform/pki/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2322":398,"_22971":379,"_5":23243,"_15675":36922,"_21706":36923,"_1911":36924},[],"/docs/pr-preview/pr-28/platform/pki/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2322":399,"_22971":379,"_5":23243,"_15675":36926,"_21706":36927,"_1911":36928},[],"/docs/pr-preview/pr-28/platform/pki/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2322":400,"_22971":379,"_5":23243,"_15675":36930,"_21706":36931,"_1911":36932},[],"/docs/pr-preview/pr-28/platform/pki/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2322":401,"_22971":379,"_5":23243,"_15675":36934,"_21706":36935,"_1911":36936},[],"/docs/pr-preview/pr-28/platform/pki/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2322":402,"_22971":379,"_5":23243,"_15675":36938,"_21706":36939,"_1911":36940},[],"/docs/pr-preview/pr-28/platform/pki/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2322":403,"_22971":379,"_5":23243,"_15675":36942,"_21706":36943,"_1911":36944},[],"/docs/pr-preview/pr-28/platform/pki/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2322":404,"_22971":379,"_5":23243,"_15675":36946,"_21706":36947,"_1911":36948},[],"/docs/pr-preview/pr-28/platform/pki/access-control#changes-and-access-revocation","Changes and access revocation",{"_2322":405,"_22971":379,"_5":23243,"_15675":36950,"_21706":36951,"_1911":36952},[],"/docs/pr-preview/pr-28/platform/pki/access-control#operational-checklist","Operational checklist",{"_2322":406,"_22971":379,"_5":23243,"_15675":36954,"_21706":36955,"_1911":36956},[],"/docs/pr-preview/pr-28/platform/pki/access-control#diagnostics","Diagnostics",{"_2322":407,"_22971":379,"_5":23243,"_15675":36958,"_21706":36959,"_1911":36960},[],"/docs/pr-preview/pr-28/platform/pki/access-control#the-response-is-401","The response is 401",{"_2322":408,"_22971":379,"_5":23243,"_15675":36962,"_21706":36963,"_1911":36964},[],"/docs/pr-preview/pr-28/platform/pki/access-control#the-response-is-403","The response is 403",{"_2322":409,"_22971":379,"_5":23243,"_15675":36966,"_21706":36967,"_1911":36968},[],"/docs/pr-preview/pr-28/platform/pki/access-control#everything-returns-403","Everything returns 403",{"_2322":410,"_22971":379,"_5":23243,"_15675":36970,"_21706":36971,"_1911":36972},[],"/docs/pr-preview/pr-28/platform/pki/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2322":411,"_22971":379,"_5":23243,"_15675":36974,"_21706":36975,"_1911":36976},[],"/docs/pr-preview/pr-28/platform/pki/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2322":412,"_22971":379,"_15675":36978,"_5":15564,"_21706":379,"_1911":36979},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2322":413,"_22971":379,"_15675":36981,"_5":15564,"_21706":379,"_1911":36982},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2322":414,"_22971":379,"_15675":36984,"_5":15564,"_21706":379,"_1911":36985},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2322":415,"_22971":379,"_15675":36987,"_5":15564,"_21706":36856,"_1911":36988},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2322":416,"_22971":379,"_15675":36990,"_5":15564,"_21706":36856,"_1911":36991},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2322":417,"_22971":379,"_15675":36993,"_5":15564,"_21706":36856,"_1911":36994},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2322":418,"_22971":379,"_15675":36996,"_5":15564,"_21706":36856,"_1911":36997},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2322":419,"_22971":379,"_15675":36999,"_5":15564,"_21706":36856,"_1911":37000},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2322":420,"_22971":379,"_15675":37002,"_5":15564,"_21706":36856,"_1911":37003},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and one of its policies must allow the requested operation.",{"_2322":421,"_22971":379,"_15675":37005,"_5":15564,"_21706":36860,"_1911":37006},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2322":422,"_22971":379,"_15675":37008,"_5":15564,"_21706":36860,"_1911":37009},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2322":423,"_22971":379,"_15675":37011,"_5":15564,"_21706":36864,"_1911":37012},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2322":424,"_22971":379,"_15675":37014,"_5":15564,"_21706":36864,"_1911":37015},[],"The decision is made **before forwarding the request to the service**:",{"_2322":425,"_22971":379,"_15675":37017,"_5":15564,"_21706":36864,"_1911":37018},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2322":426,"_22971":379,"_15675":37020,"_5":15564,"_21706":36864,"_1911":37021},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2322":427,"_22971":379,"_15675":37023,"_5":15564,"_21706":36864,"_1911":37024},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2322":428,"_22971":379,"_15675":37026,"_5":15564,"_21706":36864,"_1911":37027},[],"It separately loads the policies granted to each principal.",{"_2322":429,"_22971":379,"_15675":37029,"_5":15564,"_21706":36864,"_1911":37030},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2322":430,"_22971":379,"_15675":37032,"_5":15564,"_21706":36864,"_1911":37033},[],"`authz` looks for an HTTP rule granting that action.",{"_2322":431,"_22971":379,"_15675":37035,"_5":15564,"_21706":36864,"_1911":37036},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2322":432,"_22971":379,"_15675":37038,"_5":15564,"_21706":36864,"_1911":37039},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2322":433,"_22971":379,"_15675":37041,"_5":15564,"_21706":36864,"_1911":37042},[],"When it allows access, `authz` returns the selected principal in `x-current-user`. The Gateway can propagate that header to the service to preserve the identity context.",{"_2322":434,"_22971":379,"_15675":37044,"_5":15564,"_21706":36864,"_1911":37045},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, the schema must declare a constraint relating a request value to a normalized attribute of the principal.",{"_2322":435,"_22971":379,"_15675":37047,"_5":15564,"_21706":36868,"_1911":37048},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2322":436,"_22971":379,"_15675":37050,"_5":15564,"_21706":36868,"_1911":37051},[],"**`skip_authz: true` on a route** allows any authenticated identity to reach it without a policy grant. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a failed credential is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2322":437,"_22971":379,"_15675":37053,"_5":15564,"_21706":36868,"_1911":37054},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any authenticated identity.",{"_2322":438,"_22971":379,"_15675":37056,"_5":15564,"_21706":36868,"_1911":37057},[],"These are decisions of the schema, not of a policy: they never replace the grant a mapped route requires, they only fill the gap left by endpoints the schema does not enumerate. Keep three rules in mind:",{"_2322":439,"_22971":379,"_15675":37059,"_5":15564,"_21706":36868,"_1911":37060},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2322":440,"_22971":379,"_15675":37062,"_5":15564,"_21706":36868,"_1911":37063},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2322":441,"_22971":379,"_15675":37065,"_5":15564,"_21706":36868,"_1911":37066},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2322":442,"_22971":379,"_15675":37068,"_5":15564,"_21706":36868,"_1911":37069},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every authenticated identity can reach what they open, including identities with no granted policies. Review these settings whenever you add or upgrade an integrated service.",{"_2322":443,"_22971":379,"_15675":37071,"_5":15564,"_21706":36872,"_1911":37072},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2322":444,"_22971":379,"_15675":37074,"_5":15564,"_21706":36872,"_1911":37075},[],"The decision is made with the domain operation context:",{"_2322":445,"_22971":379,"_15675":37077,"_5":15564,"_21706":36872,"_1911":37078},[],"The middleware extracts the credential and resolves the matching principals.",{"_2322":446,"_22971":379,"_15675":37080,"_5":15564,"_21706":36872,"_1911":37081},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2322":447,"_22971":379,"_15675":37083,"_5":15564,"_21706":36872,"_1911":37084},[],"`authz` gathers the entity rules of the granted policies.",{"_2322":448,"_22971":379,"_15675":37086,"_5":15564,"_21706":36872,"_1911":37087},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2322":449,"_22971":379,"_15675":37089,"_5":15564,"_21706":36872,"_1911":37090},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2322":450,"_22971":379,"_15675":37092,"_5":15564,"_21706":36872,"_1911":37093},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2322":451,"_22971":379,"_15675":37095,"_5":15564,"_21706":36872,"_1911":37096},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2322":452,"_22971":379,"_15675":37098,"_5":15564,"_21706":36872,"_1911":37099},[],"Actions fall into two groups:",{"_2322":453,"_22971":379,"_15675":37101,"_5":15564,"_21706":36872,"_1911":37102},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2322":454,"_22971":379,"_15675":37104,"_5":15564,"_21706":36872,"_1911":37105},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2322":455,"_22971":379,"_15675":37107,"_5":15564,"_21706":36872,"_1911":37108},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2322":456,"_22971":379,"_15675":37110,"_5":15564,"_21706":36876,"_1911":37111},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2322":457,"_22971":379,"_15675":37113,"_5":15564,"_21706":36876,"_1911":37114},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2322":458,"_22971":379,"_15675":37116,"_5":15564,"_21706":36876,"_1911":37117},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it. Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2322":459,"_22971":379,"_15675":37119,"_5":15564,"_21706":36880,"_1911":37120},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2322":460,"_22971":379,"_15675":37122,"_5":15564,"_21706":36880,"_1911":37123},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2322":461,"_22971":379,"_15675":37125,"_5":15564,"_21706":36880,"_1911":37126},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2322":462,"_22971":379,"_15675":37128,"_5":15564,"_21706":36880,"_1911":37129},[],"The implemented operators are:",{"_2322":463,"_22971":379,"_15675":37131,"_5":15564,"_21706":36880,"_1911":37132},[],"`equals`, for exact equality;",{"_2322":464,"_22971":379,"_15675":37134,"_5":15564,"_21706":36880,"_1911":37135},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2322":465,"_22971":379,"_15675":37137,"_5":15564,"_21706":36880,"_1911":37138},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2322":466,"_22971":379,"_15675":37140,"_5":15564,"_21706":36880,"_1911":37141},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2322":467,"_22971":379,"_15675":37143,"_5":15564,"_21706":36884,"_1911":37144},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2322":468,"_22971":379,"_15675":37146,"_5":15564,"_21706":36884,"_1911":37147},[],"The available modes are:",{"_2322":469,"_22971":379,"_15675":37149,"_5":15564,"_21706":36884,"_1911":37150},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2322":470,"_22971":379,"_15675":37152,"_5":15564,"_21706":36884,"_1911":37153},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2322":471,"_22971":379,"_15675":37155,"_5":15564,"_21706":36884,"_1911":37156},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2322":472,"_22971":379,"_15675":37158,"_5":15564,"_21706":36884,"_1911":37159},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2322":473,"_22971":379,"_15675":37161,"_5":15564,"_21706":36884,"_1911":37162},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2322":474,"_22971":379,"_15675":37164,"_5":15564,"_21706":36884,"_1911":37165},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2322":475,"_22971":379,"_15675":37167,"_5":15564,"_21706":36888,"_1911":37168},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2322":476,"_22971":379,"_15675":37170,"_5":15564,"_21706":36888,"_1911":37171},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2322":477,"_22971":379,"_15675":37173,"_5":15564,"_21706":36888,"_1911":37174},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2322":478,"_22971":379,"_15675":37176,"_5":15564,"_21706":36888,"_1911":37177},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2322":479,"_22971":379,"_15675":37179,"_5":15564,"_21706":36896,"_1911":37180},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2322":480,"_22971":379,"_15675":37182,"_5":15564,"_21706":36896,"_1911":37183},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2322":481,"_22971":379,"_15675":37185,"_5":15564,"_21706":36900,"_1911":37186},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2322":482,"_22971":379,"_15675":37188,"_5":15564,"_21706":36900,"_1911":37189},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2322":483,"_22971":379,"_15675":37191,"_5":15564,"_21706":36904,"_1911":37192},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2322":484,"_22971":379,"_15675":37194,"_5":15564,"_21706":36904,"_1911":37195},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2322":485,"_22971":379,"_15675":37197,"_5":15564,"_21706":36904,"_1911":37198},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2322":486,"_22971":379,"_15675":37200,"_5":15564,"_21706":36908,"_1911":37201},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2322":487,"_22971":379,"_15675":37203,"_5":15564,"_21706":36908,"_1911":37204},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2322":488,"_22971":379,"_15675":37206,"_5":15564,"_21706":36908,"_1911":37207},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2322":489,"_22971":379,"_15675":37209,"_5":15564,"_21706":36908,"_1911":37210},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2322":490,"_22971":379,"_15675":37212,"_5":15564,"_21706":36908,"_1911":37213},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2322":491,"_22971":379,"_15675":37215,"_5":15564,"_21706":36908,"_1911":37216},[],"Note that:",{"_2322":492,"_22971":379,"_15675":37218,"_5":15564,"_21706":36908,"_1911":37219},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2322":493,"_22971":379,"_15675":37221,"_5":15564,"_21706":36908,"_1911":37222},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2322":494,"_22971":379,"_15675":37224,"_5":15564,"_21706":36908,"_1911":37225},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2322":495,"_22971":379,"_15675":37227,"_5":15564,"_21706":36912,"_1911":37228},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2322":496,"_22971":379,"_15675":37230,"_5":15564,"_21706":36912,"_1911":37231},[],"full and read-only access to certificates and authorities;",{"_2322":497,"_22971":379,"_15675":37233,"_5":15564,"_21706":36912,"_1911":37234},[],"full and read-only access to the KMS;",{"_2322":498,"_22971":379,"_15675":37236,"_5":15564,"_21706":36912,"_1911":37237},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2322":499,"_22971":379,"_15675":37239,"_5":15564,"_21706":36912,"_1911":37240},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2322":500,"_22971":379,"_15675":37242,"_5":15564,"_21706":36912,"_1911":37243},[],"console access;",{"_2322":501,"_22971":379,"_15675":37245,"_5":15564,"_21706":36912,"_1911":37246},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2322":502,"_22971":379,"_15675":37248,"_5":15564,"_21706":36912,"_1911":37249},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2322":503,"_22971":379,"_15675":37251,"_5":15564,"_21706":36912,"_1911":37252},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2322":504,"_22971":379,"_15675":37254,"_5":15564,"_21706":36916,"_1911":37255},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2322":505,"_22971":379,"_15675":37257,"_5":15564,"_21706":36916,"_1911":37258},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2322":506,"_22971":379,"_15675":37260,"_5":15564,"_21706":36916,"_1911":37261},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2322":507,"_22971":379,"_15675":37263,"_5":15564,"_21706":36919,"_1911":37264},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2322":508,"_22971":379,"_15675":37266,"_5":15564,"_21706":36923,"_1911":37267},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2322":509,"_22971":379,"_15675":37269,"_5":15564,"_21706":36927,"_1911":37270},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2322":510,"_22971":379,"_15675":37272,"_5":15564,"_21706":36931,"_1911":37273},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2322":511,"_22971":379,"_15675":37275,"_5":15564,"_21706":36935,"_1911":37276},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2322":512,"_22971":379,"_15675":37278,"_5":15564,"_21706":36939,"_1911":37279},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2322":513,"_22971":379,"_15675":37281,"_5":15564,"_21706":36939,"_1911":37282},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2322":514,"_22971":379,"_15675":37284,"_5":15564,"_21706":36943,"_1911":37285},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2322":515,"_22971":379,"_15675":37287,"_5":15564,"_21706":36943,"_1911":37288},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2322":516,"_22971":379,"_15675":37290,"_5":15564,"_21706":36943,"_1911":37291},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2322":517,"_22971":379,"_15675":37293,"_5":15564,"_21706":36943,"_1911":37294},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2322":518,"_22971":379,"_15675":37296,"_5":15564,"_21706":36943,"_1911":37297},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2322":519,"_22971":379,"_15675":37299,"_5":15564,"_21706":36943,"_1911":37300},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2322":520,"_22971":379,"_15675":37302,"_5":15564,"_21706":36943,"_1911":37303},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2322":521,"_22971":379,"_15675":37305,"_5":15564,"_21706":36943,"_1911":37306},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2322":522,"_22971":379,"_15675":37308,"_5":15564,"_21706":36947,"_1911":37309},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2322":523,"_22971":379,"_15675":37311,"_5":15564,"_21706":36947,"_1911":37312},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2322":524,"_22971":379,"_15675":37314,"_5":15564,"_21706":36947,"_1911":37315},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2322":525,"_22971":379,"_15675":37317,"_5":15564,"_21706":36951,"_1911":37318},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2322":526,"_22971":379,"_15675":37320,"_5":15564,"_21706":36951,"_1911":37321},[],"Use groups or stable roles for people and independent identities for automations.",{"_2322":527,"_22971":379,"_15675":37323,"_5":15564,"_21706":36951,"_1911":37324},[],"Keep at least two recovery administrators and test their access periodically.",{"_2322":528,"_22971":379,"_15675":37326,"_5":15564,"_21706":36951,"_1911":37327},[],"Review active principals, their matches and their grants after IdP changes.",{"_2322":529,"_22971":379,"_15675":37329,"_5":15564,"_21706":36951,"_1911":37330},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2322":530,"_22971":379,"_15675":37332,"_5":15564,"_21706":36951,"_1911":37333},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2322":531,"_22971":379,"_15675":37335,"_5":15564,"_21706":36951,"_1911":37336},[],"Always test one allowed and one denied operation for each role.",{"_2322":532,"_22971":379,"_15675":37338,"_5":15564,"_21706":36951,"_1911":37339},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2322":533,"_22971":379,"_15675":37341,"_5":15564,"_21706":36959,"_1911":37342},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2322":534,"_22971":379,"_15675":37344,"_5":15564,"_21706":36963,"_1911":37345},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2322":535,"_22971":379,"_15675":37347,"_5":15564,"_21706":36963,"_1911":37348},[],"that an active principal of the correct type exists;",{"_2322":536,"_22971":379,"_15675":37350,"_5":15564,"_21706":36963,"_1911":37351},[],"that the claim paths and values match the real token exactly;",{"_2322":537,"_22971":379,"_15675":37353,"_5":15564,"_21706":36963,"_1911":37354},[],"that all of the principal's conditions hold;",{"_2322":538,"_22971":379,"_15675":37356,"_5":15564,"_21706":36963,"_1911":37357},[],"that the principal has the expected policy granted;",{"_2322":539,"_22971":379,"_15675":37359,"_5":15564,"_21706":36963,"_1911":37360},[],"that the policy includes the action and the requested resource type or route;",{"_2322":540,"_22971":379,"_15675":37362,"_5":15564,"_21706":36963,"_1911":37363},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2322":541,"_22971":379,"_15675":37365,"_5":15564,"_21706":36963,"_1911":37366},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2322":542,"_22971":379,"_15675":37368,"_5":15564,"_21706":36967,"_1911":37369},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2322":543,"_22971":379,"_15675":37371,"_5":15564,"_21706":36971,"_1911":37372},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any authenticated identity, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2322":544,"_22971":379,"_15675":37374,"_5":15564,"_21706":36975,"_1911":37375},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2322":545,"_22971":379,"_15675":37377,"_5":15564,"_21706":36975,"_1911":37378},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2322":546,"_22971":546,"_5":10796,"_1911":37380,"_23246":37381,"_15675":37383,"_21706":546},"Alerts and subscriptions",[35713,36848,37382],"Operate Lamassu",[],{"_2322":547,"_22971":546,"_15675":37385,"_5":15564,"_21706":546,"_1911":37386},[],"Send PKI events to people and external systems.",{"_2322":548,"_22971":546,"_5":23243,"_15675":37388,"_21706":37389,"_1911":37390},[],"/docs/pr-preview/pr-28/platform/pki/alerts#how-it-works","How it works",{"_2322":549,"_22971":546,"_5":23243,"_15675":37392,"_21706":37393,"_1911":37394},[],"/docs/pr-preview/pr-28/platform/pki/alerts#available-channels","Available channels",{"_2322":550,"_22971":546,"_5":23243,"_15675":37396,"_21706":37397,"_1911":37398},[],"/docs/pr-preview/pr-28/platform/pki/alerts#create-a-subscription","Create a subscription",{"_2322":551,"_22971":546,"_5":23243,"_15675":37400,"_21706":37401,"_1911":37402},[],"/docs/pr-preview/pr-28/platform/pki/alerts#choose-the-event","Choose the event",{"_2322":552,"_22971":546,"_5":23243,"_15675":37404,"_21706":37405,"_1911":37406},[],"/docs/pr-preview/pr-28/platform/pki/alerts#configure-the-destination","Configure the destination",{"_2322":553,"_22971":546,"_5":23243,"_15675":37408,"_21706":37409,"_1911":37410},[],"/docs/pr-preview/pr-28/platform/pki/alerts#limit-the-notifications","Limit the notifications",{"_2322":554,"_22971":546,"_5":23243,"_15675":37412,"_21706":37413,"_1911":37414},[],"/docs/pr-preview/pr-28/platform/pki/alerts#review-and-activate","Review and activate",{"_2322":555,"_22971":546,"_5":23243,"_15675":37416,"_21706":37417,"_1911":37418},[],"/docs/pr-preview/pr-28/platform/pki/alerts#manage-a-subscription","Manage a subscription",{"_2322":556,"_22971":546,"_5":23243,"_15675":37420,"_21706":37421,"_1911":37422},[],"/docs/pr-preview/pr-28/platform/pki/alerts#event-families","Event families",{"_2322":557,"_22971":546,"_15675":37424,"_5":15564,"_21706":546,"_1911":37425},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2322":558,"_22971":546,"_15675":37427,"_5":15564,"_21706":37389,"_1911":37428},[],"A service publishes a domain event.",{"_2322":559,"_22971":546,"_15675":37430,"_5":15564,"_21706":37389,"_1911":37431},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2322":560,"_22971":546,"_15675":37433,"_5":15564,"_21706":37389,"_1911":37434},[],"Each subscription's filter decides whether it should be notified.",{"_2322":561,"_22971":546,"_15675":37436,"_5":15564,"_21706":37389,"_1911":37437},[],"Lamassu delivers the event to the configured channel.",{"_2322":562,"_22971":546,"_15675":37439,"_5":15564,"_21706":37389,"_1911":37440},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2322":563,"_22971":546,"_15675":37442,"_5":15564,"_21706":37393,"_1911":37443},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address.",{"_2322":564,"_22971":546,"_15675":37445,"_5":15564,"_21706":37393,"_1911":37446},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2322":565,"_22971":546,"_15675":37448,"_5":15564,"_21706":37393,"_1911":37449},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2322":566,"_22971":546,"_15675":37451,"_5":15564,"_21706":37401,"_1911":37452},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2322":567,"_22971":546,"_15675":37454,"_5":15564,"_21706":37405,"_1911":37455},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2322":568,"_22971":546,"_15675":37457,"_5":15564,"_21706":37409,"_1911":37458},[],"Add a filter if you don't want to receive every instance of the event.",{"_2322":569,"_22971":546,"_15675":37460,"_5":15564,"_21706":37409,"_1911":37461},[],"**None** notifies all instances of the event.",{"_2322":570,"_22971":546,"_15675":37463,"_5":15564,"_21706":37409,"_1911":37464},[],"**JSON Path** evaluates one or more specific fields.",{"_2322":571,"_22971":546,"_15675":37466,"_5":15564,"_21706":37409,"_1911":37467},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2322":572,"_22971":546,"_15675":37469,"_5":15564,"_21706":37409,"_1911":37470},[],"**JavaScript** lets you express custom logic.",{"_2322":573,"_22971":546,"_15675":37472,"_5":15564,"_21706":37409,"_1911":37473},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2322":574,"_22971":546,"_15675":37475,"_5":15564,"_21706":37413,"_1911":37476},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2322":575,"_22971":546,"_15675":37478,"_5":15564,"_21706":37417,"_1911":37479},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2322":576,"_22971":546,"_15675":37481,"_5":15564,"_21706":37421,"_1911":37482},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2322":577,"_22971":546,"_15675":37484,"_5":15564,"_21706":37421,"_1911":37485},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2322":578,"_22971":546,"_15675":37487,"_5":15564,"_21706":37421,"_1911":37488},[],"**Profiles:** `profile.create`, `profile.update` and `profile.delete`.",{"_2322":579,"_22971":546,"_15675":37490,"_5":15564,"_21706":37421,"_1911":37491},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2322":580,"_22971":546,"_15675":37493,"_5":15564,"_21706":37421,"_1911":37494},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2322":581,"_22971":546,"_15675":37496,"_5":15564,"_21706":37421,"_1911":37497},[],"**Validation:** `va.role.crl.create`.",{"_2322":582,"_22971":546,"_15675":37499,"_5":15564,"_21706":37421,"_1911":37500},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign.message` and `kms.delete`.",{"_2322":583,"_22971":546,"_15675":37502,"_5":15564,"_21706":37421,"_1911":37503},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2322":584,"_22971":584,"_5":10796,"_1911":37505,"_23246":37506,"_15675":37507,"_21706":584},"Audit logs",[35713,36848,36849],[],{"_2322":585,"_22971":584,"_15675":37509,"_5":15564,"_21706":584,"_1911":37510},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2322":586,"_22971":584,"_5":23243,"_15675":37512,"_21706":37513,"_1911":37514},[],"/docs/pr-preview/pr-28/platform/pki/audit-logs#what-an-event-contains","What an event contains",{"_2322":587,"_22971":584,"_5":23243,"_15675":37516,"_21706":37517,"_1911":37518},[],"/docs/pr-preview/pr-28/platform/pki/audit-logs#coverage","Coverage",{"_2322":588,"_22971":584,"_5":23243,"_15675":37520,"_21706":37521,"_1911":37522},[],"/docs/pr-preview/pr-28/platform/pki/audit-logs#publication-and-persistence","Publication and persistence",{"_2322":589,"_22971":584,"_5":23243,"_15675":37524,"_21706":37525,"_1911":37526},[],"/docs/pr-preview/pr-28/platform/pki/audit-logs#sensitive-data","Sensitive data",{"_2322":590,"_22971":584,"_5":23243,"_15675":37528,"_21706":37529,"_1911":37530},[],"/docs/pr-preview/pr-28/platform/pki/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2322":591,"_22971":584,"_5":23243,"_15675":37532,"_21706":37533,"_1911":37534},[],"/docs/pr-preview/pr-28/platform/pki/audit-logs#bound-the-interval","Bound the interval",{"_2322":592,"_22971":584,"_5":23243,"_15675":37536,"_21706":37537,"_1911":37538},[],"/docs/pr-preview/pr-28/platform/pki/audit-logs#identify-the-operation","Identify the operation",{"_2322":593,"_22971":584,"_5":23243,"_15675":37540,"_21706":37541,"_1911":37542},[],"/docs/pr-preview/pr-28/platform/pki/audit-logs#attribute-the-principal","Attribute the principal",{"_2322":594,"_22971":584,"_5":23243,"_15675":37544,"_21706":37545,"_1911":37546},[],"/docs/pr-preview/pr-28/platform/pki/audit-logs#compare-intent-and-result","Compare intent and result",{"_2322":595,"_22971":584,"_5":23243,"_15675":37548,"_21706":37549,"_1911":37550},[],"/docs/pr-preview/pr-28/platform/pki/audit-logs#follow-the-effect","Follow the effect",{"_2322":596,"_22971":584,"_5":23243,"_15675":37552,"_21706":37553,"_1911":37554},[],"/docs/pr-preview/pr-28/platform/pki/audit-logs#periodic-verification","Periodic verification",{"_2322":597,"_22971":584,"_15675":37556,"_5":15564,"_21706":584,"_1911":37557},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2322":598,"_22971":584,"_15675":37559,"_5":15564,"_21706":37513,"_1911":37560},[],"The audit body includes:",{"_2322":599,"_22971":584,"_15675":37562,"_5":15564,"_21706":37513,"_1911":37563},[],"input: data received by the operation;",{"_2322":600,"_22971":584,"_15675":37565,"_5":15564,"_21706":37513,"_1911":37566},[],"has\\_error: whether the service returned an error;",{"_2322":601,"_22971":584,"_15675":37568,"_5":15564,"_21706":37513,"_1911":37569},[],"output: produced result or error message;",{"_2322":602,"_22971":584,"_15675":37571,"_5":15564,"_21706":37513,"_1911":37572},[],"principals: identifiers of the principals that matched the request.",{"_2322":603,"_22971":584,"_15675":37574,"_5":15564,"_21706":37513,"_1911":37575},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2322":604,"_22971":584,"_15675":37577,"_5":15564,"_21706":37513,"_1911":37578},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2322":605,"_22971":584,"_15675":37580,"_5":15564,"_21706":37517,"_1911":37581},[],"The backend applies auditing to mutations of:",{"_2322":606,"_22971":584,"_15675":37583,"_5":15564,"_21706":37517,"_1911":37584},[],"authorities, certificates and issuance profiles;",{"_2322":607,"_22971":584,"_15675":37586,"_5":15564,"_21706":37517,"_1911":37587},[],"keys and KMS engines;",{"_2322":608,"_22971":584,"_15675":37589,"_5":15564,"_21706":37517,"_1911":37590},[],"devices and identities;",{"_2322":609,"_22971":584,"_15675":37592,"_5":15564,"_21706":37517,"_1911":37593},[],"DMSs and enrollment operations;",{"_2322":610,"_22971":584,"_15675":37595,"_5":15564,"_21706":37517,"_1911":37596},[],"validation functions and CRL;",{"_2322":611,"_22971":584,"_15675":37598,"_5":15564,"_21706":37517,"_1911":37599},[],"principals, policies and authorization grants.",{"_2322":612,"_22971":584,"_15675":37601,"_5":15564,"_21706":37517,"_1911":37602},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2322":613,"_22971":584,"_15675":37604,"_5":15564,"_21706":37521,"_1911":37605},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2322":614,"_22971":584,"_15675":37607,"_5":15564,"_21706":37521,"_1911":37608},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2322":615,"_22971":584,"_15675":37610,"_5":15564,"_21706":37521,"_1911":37611},[],"Design the consumer to:",{"_2322":616,"_22971":584,"_15675":37613,"_5":15564,"_21706":37521,"_1911":37614},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2322":617,"_22971":584,"_15675":37616,"_5":15564,"_21706":37521,"_1911":37617},[],"keep the complete CloudEvent unmodified;",{"_2322":618,"_22971":584,"_15675":37619,"_5":15564,"_21706":37521,"_1911":37620},[],"record the ingestion time and detect duplicates by ID;",{"_2322":619,"_22971":584,"_15675":37622,"_5":15564,"_21706":37521,"_1911":37623},[],"encrypt in transit and at rest;",{"_2322":620,"_22971":584,"_15675":37625,"_5":15564,"_21706":37521,"_1911":37626},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2322":621,"_22971":584,"_15675":37628,"_5":15564,"_21706":37521,"_1911":37629},[],"apply an explicit retention and legal hold policy;",{"_2322":622,"_22971":584,"_15675":37631,"_5":15564,"_21706":37521,"_1911":37632},[],"alert if it stops consuming or the pending queue grows.",{"_2322":623,"_22971":584,"_15675":37634,"_5":15564,"_21706":37525,"_1911":37635},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2322":624,"_22971":584,"_15675":37637,"_5":15564,"_21706":37525,"_1911":37638},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2322":625,"_22971":584,"_15675":37640,"_5":15564,"_21706":37533,"_1911":37641},[],"Start from the reported time and normalize every source to UTC.",{"_2322":626,"_22971":584,"_15675":37643,"_5":15564,"_21706":37537,"_1911":37644},[],"Filter by event type, service source and resource identifier.",{"_2322":627,"_22971":584,"_15675":37646,"_5":15564,"_21706":37541,"_1911":37647},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2322":628,"_22971":584,"_15675":37649,"_5":15564,"_21706":37545,"_1911":37650},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2322":629,"_22971":584,"_15675":37652,"_5":15564,"_21706":37549,"_1911":37653},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2322":630,"_22971":584,"_15675":37655,"_5":15564,"_21706":37553,"_1911":37656},[],"Generate a controlled mutation in a test environment and check that:",{"_2322":631,"_22971":584,"_15675":37658,"_5":15564,"_21706":37553,"_1911":37659},[],"a successful audit event appears;",{"_2322":632,"_22971":584,"_15675":37661,"_5":15564,"_21706":37553,"_1911":37662},[],"the principal matches the identity used;",{"_2322":633,"_22971":584,"_15675":37664,"_5":15564,"_21706":37553,"_1911":37665},[],"the consumer persists it exactly once;",{"_2322":634,"_22971":584,"_15675":37667,"_5":15564,"_21706":37553,"_1911":37668},[],"it can be retrieved by resource, actor and period;",{"_2322":635,"_22971":584,"_15675":37670,"_5":15564,"_21706":37553,"_1911":37671},[],"a consumer outage raises an alert.",{"_2322":636,"_22971":584,"_15675":37673,"_5":15564,"_21706":37553,"_1911":37674},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2322":637,"_22971":637,"_5":10796,"_1911":37676,"_23246":37677,"_15675":37678,"_21706":637},"CA hierarchy and rotation",[35713,36848,37382],[],{"_2322":638,"_22971":637,"_15675":37680,"_5":15564,"_21706":637,"_1911":37681},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2322":639,"_22971":637,"_5":23243,"_15675":37683,"_21706":37684,"_1911":37685},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2322":640,"_22971":637,"_5":23243,"_15675":37687,"_21706":37688,"_1911":37689},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2322":641,"_22971":637,"_5":23243,"_15675":37691,"_21706":37692,"_1911":37693},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2322":642,"_22971":637,"_5":23243,"_15675":37695,"_21706":37696,"_1911":37697},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2322":643,"_22971":637,"_5":23243,"_15675":37699,"_21706":37700,"_1911":37701},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2322":644,"_22971":637,"_5":23243,"_15675":37703,"_21706":37704,"_1911":37705},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2322":645,"_22971":637,"_5":23243,"_15675":37707,"_21706":37708,"_1911":37709},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2322":646,"_22971":637,"_5":23243,"_15675":37711,"_21706":37712,"_1911":37713},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2322":647,"_22971":637,"_5":23243,"_15675":37715,"_21706":37716,"_1911":37717},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2322":648,"_22971":637,"_5":23243,"_15675":37719,"_21706":37720,"_1911":37721},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2322":649,"_22971":637,"_5":23243,"_15675":37723,"_21706":37724,"_1911":37725},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2322":650,"_22971":637,"_5":23243,"_15675":37727,"_21706":37728,"_1911":37729},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2322":651,"_22971":637,"_15675":37731,"_5":15564,"_21706":637,"_1911":37732},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2322":652,"_22971":637,"_15675":37734,"_5":15564,"_21706":37684,"_1911":37735},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2322":653,"_22971":637,"_15675":37737,"_5":15564,"_21706":37684,"_1911":37738},[],"environment, such as production and preproduction;",{"_2322":654,"_22971":637,"_15675":37740,"_5":15564,"_21706":37684,"_1911":37741},[],"owner or operating team;",{"_2322":655,"_22971":637,"_15675":37743,"_5":15564,"_21706":37684,"_1911":37744},[],"device family or manufacturing process;",{"_2322":656,"_22971":637,"_15675":37746,"_5":15564,"_21706":37684,"_1911":37747},[],"region or regulatory requirement;",{"_2322":657,"_22971":637,"_15675":37749,"_5":15564,"_21706":37684,"_1911":37750},[],"cryptographic engine or key policy;",{"_2322":658,"_22971":637,"_15675":37752,"_5":15564,"_21706":37684,"_1911":37753},[],"maintenance window and renewal cadence.",{"_2322":659,"_22971":637,"_15675":37755,"_5":15564,"_21706":37684,"_1911":37756},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2322":660,"_22971":637,"_15675":37758,"_5":15564,"_21706":37684,"_1911":37759},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2322":661,"_22971":637,"_15675":37761,"_5":15564,"_21706":37688,"_1911":37762},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2322":662,"_22971":637,"_15675":37764,"_5":15564,"_21706":37688,"_1911":37765},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2322":663,"_22971":637,"_15675":37767,"_5":15564,"_21706":37688,"_1911":37768},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2322":664,"_22971":637,"_15675":37770,"_5":15564,"_21706":37692,"_1911":37771},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2322":665,"_22971":637,"_15675":37773,"_5":15564,"_21706":37692,"_1911":37774},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2322":666,"_22971":637,"_15675":37776,"_5":15564,"_21706":37692,"_1911":37777},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2322":667,"_22971":637,"_15675":37779,"_5":15564,"_21706":37692,"_1911":37780},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2322":668,"_22971":637,"_15675":37782,"_5":15564,"_21706":37700,"_1911":37783},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2322":669,"_22971":637,"_15675":37785,"_5":15564,"_21706":37704,"_1911":37786},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2322":670,"_22971":637,"_15675":37788,"_5":15564,"_21706":37708,"_1911":37789},[],"Add the new root or chain to consumers before issuing with it. In a DMS, use the managed CAs of `/cacerts` to temporarily keep both the old and new chains.",{"_2322":671,"_22971":637,"_15675":37791,"_5":15564,"_21706":37712,"_1911":37792},[],"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment.",{"_2322":672,"_22971":637,"_15675":37794,"_5":15564,"_21706":37716,"_1911":37795},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2322":673,"_22971":637,"_15675":37797,"_5":15564,"_21706":37720,"_1911":37798},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2322":674,"_22971":637,"_15675":37800,"_5":15564,"_21706":37724,"_1911":37801},[],"When you revoke a CA, Lamassu also updates its child CAs and issued certificates to `REVOKED` with the reason `CessationOfOperation`. The children's revocations propagate the effect to their own branches.",{"_2322":675,"_22971":637,"_15675":37803,"_5":15564,"_21706":37724,"_1911":37804},[],"This protects the coherence of the hierarchy, but it makes revocation a high-impact action. Do not use it as the ordinary mechanism to stop issuing: first complete the migration and remove the CA from operational flows.",{"_2322":676,"_22971":637,"_15675":37806,"_5":15564,"_21706":37728,"_1911":37807},[],"The new chain ends in an anchor installed by the consumer.",{"_2322":677,"_22971":637,"_15675":37809,"_5":15564,"_21706":37728,"_1911":37810},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2322":678,"_22971":637,"_15675":37812,"_5":15564,"_21706":37728,"_1911":37813},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2322":679,"_22971":637,"_15675":37815,"_5":15564,"_21706":37728,"_1911":37816},[],"Re-enrollment accepts the old identity during the planned period.",{"_2322":680,"_22971":637,"_15675":37818,"_5":15564,"_21706":37728,"_1911":37819},[],"OCSP and CRL respond for the authorities that remain active.",{"_2322":681,"_22971":637,"_15675":37821,"_5":15564,"_21706":37728,"_1911":37822},[],"No DMS is left accidentally issuing from the old CA.",{"_2322":682,"_22971":637,"_15675":37824,"_5":15564,"_21706":37728,"_1911":37825},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2322":683,"_22971":683,"_5":10796,"_1911":37827,"_23246":37828,"_15675":37829,"_21706":683},"Certification authorities",[35713,36848,37382],[],{"_2322":684,"_22971":683,"_15675":37831,"_5":15564,"_21706":683,"_1911":37832},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2322":685,"_22971":683,"_5":23243,"_15675":37834,"_21706":37835,"_1911":37836},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2322":686,"_22971":683,"_5":23243,"_15675":37838,"_21706":37839,"_1911":37840},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2322":687,"_22971":683,"_5":23243,"_15675":37842,"_21706":37843,"_1911":35723},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#before-you-begin",{"_2322":688,"_22971":683,"_5":23243,"_15675":37845,"_21706":37846,"_1911":37847},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2322":689,"_22971":683,"_5":23243,"_15675":37849,"_21706":37850,"_1911":37851},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2322":690,"_22971":683,"_5":23243,"_15675":37853,"_21706":37854,"_1911":37855},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2322":691,"_22971":683,"_5":23243,"_15675":37857,"_21706":37858,"_1911":37859},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2322":692,"_22971":683,"_5":23243,"_15675":37861,"_21706":37862,"_1911":37863},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2322":693,"_22971":683,"_5":23243,"_15675":37865,"_21706":37866,"_1911":37867},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2322":694,"_22971":683,"_5":23243,"_15675":37869,"_21706":37870,"_1911":37871},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2322":695,"_22971":683,"_5":23243,"_15675":37873,"_21706":37874,"_1911":37875},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2322":696,"_22971":683,"_5":23243,"_15675":37877,"_21706":37878,"_1911":37879},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2322":697,"_22971":683,"_5":23243,"_15675":37881,"_21706":37882,"_1911":37883},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2322":698,"_22971":683,"_5":23243,"_15675":37885,"_21706":37886,"_1911":37887},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2322":699,"_22971":683,"_5":23243,"_15675":37889,"_21706":37890,"_1911":37891},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2322":700,"_22971":683,"_5":23243,"_15675":37893,"_21706":37894,"_1911":37895},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2322":701,"_22971":683,"_5":23243,"_15675":37897,"_21706":37898,"_1911":37899},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2322":702,"_22971":683,"_5":23243,"_15675":37901,"_21706":37902,"_1911":37903},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2322":703,"_22971":683,"_5":23243,"_15675":37905,"_21706":37906,"_1911":37907},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2322":704,"_22971":683,"_5":23243,"_15675":37909,"_21706":37910,"_1911":37911},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2322":705,"_22971":683,"_5":23243,"_15675":37913,"_21706":37914,"_1911":37915},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2322":706,"_22971":683,"_5":23243,"_15675":37917,"_21706":37918,"_1911":37919},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2322":707,"_22971":683,"_15675":37921,"_5":15564,"_21706":683,"_1911":37922},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2322":708,"_22971":683,"_15675":37924,"_5":15564,"_21706":683,"_1911":37925},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2322":709,"_22971":683,"_15675":37927,"_5":15564,"_21706":37835,"_1911":37928},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2322":710,"_22971":683,"_15675":37930,"_5":15564,"_21706":37835,"_1911":37931},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2322":711,"_22971":683,"_15675":37933,"_5":15564,"_21706":37835,"_1911":37934},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2322":712,"_22971":683,"_15675":37936,"_5":15564,"_21706":37835,"_1911":37937},[],"**Import only the certificate:** add an authority for building chains and validating, but not for issuing.",{"_2322":713,"_22971":683,"_15675":37939,"_5":15564,"_21706":37835,"_1911":37940},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2322":714,"_22971":683,"_15675":37942,"_5":15564,"_21706":37843,"_1911":37943},[],"Decide whether the CA will be a root or an intermediate.",{"_2322":715,"_22971":683,"_15675":37945,"_5":15564,"_21706":37843,"_1911":37946},[],"Choose the engine that will keep the key.",{"_2322":716,"_22971":683,"_15675":37948,"_5":15564,"_21706":37843,"_1911":37949},[],"Define a validity longer than that of the certificates it will issue.",{"_2322":717,"_22971":683,"_15675":37951,"_5":15564,"_21706":37843,"_1911":37952},[],"For an intermediate CA, make sure the parent CA is active.",{"_2322":718,"_22971":683,"_15675":37954,"_5":15564,"_21706":37846,"_1911":37955},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2322":719,"_22971":683,"_15675":37957,"_5":15564,"_21706":37850,"_1911":37958},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2322":720,"_22971":683,"_15675":37960,"_5":15564,"_21706":37850,"_1911":37961},[],"For RSA you can choose 1024, 2048, 3072 or 4096 bits. For EC, the P-256, P-384 and P-521 curves are available.",{"_2322":721,"_22971":683,"_15675":37963,"_5":15564,"_21706":37854,"_1911":37964},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2322":722,"_22971":683,"_15675":37966,"_5":15564,"_21706":37858,"_1911":37967},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2322":723,"_22971":683,"_15675":37969,"_5":15564,"_21706":37858,"_1911":37970},[],"`C`: two-letter ISO 3166-1 country code.",{"_2322":724,"_22971":683,"_15675":37972,"_5":15564,"_21706":37858,"_1911":37973},[],"`ST`: state or province.",{"_2322":725,"_22971":683,"_15675":37975,"_5":15564,"_21706":37858,"_1911":37976},[],"`L`: locality.",{"_2322":726,"_22971":683,"_15675":37978,"_5":15564,"_21706":37858,"_1911":37979},[],"`O`: organization.",{"_2322":727,"_22971":683,"_15675":37981,"_5":15564,"_21706":37858,"_1911":37982},[],"`OU`: organizational unit.",{"_2322":728,"_22971":683,"_15675":37984,"_5":15564,"_21706":37858,"_1911":37985},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2322":729,"_22971":683,"_15675":37987,"_5":15564,"_21706":37862,"_1911":37988},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2322":730,"_22971":683,"_15675":37990,"_5":15564,"_21706":37862,"_1911":37991},[],"Select an existing issuance profile or configure the `Key Usage` and `Extended Key Usage` in the form. If you don't choose a profile, Lamassu applies the default basic usages.",{"_2322":731,"_22971":683,"_15675":37993,"_5":15564,"_21706":37866,"_1911":37994},[],"Confirm the form. The CA should appear in the inventory with its PEM certificate, status, expiration date and list of issued certificates.",{"_2322":732,"_22971":683,"_15675":37996,"_5":15564,"_21706":37866,"_1911":37997},[],"A CA cannot issue certificates that outlive its own expiration date. Leave enough margin to renew or replace the authority without interrupting consumers.",{"_2322":733,"_22971":683,"_15675":37999,"_5":15564,"_21706":37870,"_1911":38000},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2322":734,"_22971":683,"_15675":38002,"_5":15564,"_21706":37870,"_1911":38003},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2322":735,"_22971":683,"_15675":38005,"_5":15564,"_21706":37874,"_1911":38006},[],"Importing preserves an authority created outside Lamassu.",{"_2322":736,"_22971":683,"_15675":38008,"_5":15564,"_21706":37878,"_1911":38009},[],"Choose the engine that will keep the imported key.",{"_2322":737,"_22971":683,"_15675":38011,"_5":15564,"_21706":37882,"_1911":38012},[],"Provide the CA certificate and the private key in PEM format. For a subordinate CA, optionally add the validation chain.",{"_2322":738,"_22971":683,"_15675":38014,"_5":15564,"_21706":37886,"_1911":38015},[],"Configure the validity that end-entity certificates will receive when a request does not specify another duration.",{"_2322":739,"_22971":683,"_15675":38017,"_5":15564,"_21706":37890,"_1911":38018},[],"Lamassu checks that the certificate belongs to a CA and that the material is coherent before registering it.",{"_2322":740,"_22971":683,"_15675":38020,"_5":15564,"_21706":37890,"_1911":38021},[],"If you don't have the private key, import only the certificate. The authority can take part in chains of trust and validation processes, but it cannot issue certificates from Lamassu.",{"_2322":741,"_22971":683,"_15675":38023,"_5":15564,"_21706":37894,"_1911":38024},[],"Open a CA from the inventory to review:",{"_2322":742,"_22971":683,"_15675":38026,"_5":15564,"_21706":37894,"_1911":38027},[],"Status and validity period.",{"_2322":743,"_22971":683,"_15675":38029,"_5":15564,"_21706":37894,"_1911":38030},[],"Certificate and chain in PEM format.",{"_2322":744,"_22971":683,"_15675":38032,"_5":15564,"_21706":37894,"_1911":38033},[],"Number of active, expired and revoked certificates.",{"_2322":745,"_22971":683,"_15675":38035,"_5":15564,"_21706":37894,"_1911":38036},[],"Certificates issued in **Issued Certificates**.",{"_2322":746,"_22971":683,"_15675":38038,"_5":15564,"_21706":37894,"_1911":38039},[],"The CRL linked to the authority.",{"_2322":747,"_22971":683,"_15675":38041,"_5":15564,"_21706":37894,"_1911":38042},[],"Metadata and the associated cryptographic engine.",{"_2322":748,"_22971":683,"_15675":38044,"_5":15564,"_21706":37894,"_1911":38045},[],"You can filter the inventory by name, status and CA type.",{"_2322":749,"_22971":683,"_15675":38047,"_5":15564,"_21706":37898,"_1911":38048},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2322":750,"_22971":683,"_15675":38050,"_5":15564,"_21706":37898,"_1911":38051},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2322":751,"_22971":683,"_15675":38053,"_5":15564,"_21706":37898,"_1911":38054},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2322":752,"_22971":683,"_15675":38056,"_5":15564,"_21706":37898,"_1911":38057},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2322":753,"_22971":683,"_15675":38059,"_5":15564,"_21706":37902,"_1911":38060},[],"Revoking a CA invalidates trust in the certificates it issued and can interrupt devices and services. The action is irreversible.",{"_2322":754,"_22971":683,"_15675":38062,"_5":15564,"_21706":37906,"_1911":38063},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2322":755,"_22971":683,"_15675":38065,"_5":15564,"_21706":37910,"_1911":38066},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2322":756,"_22971":683,"_15675":38068,"_5":15564,"_21706":37914,"_1911":38069},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2322":757,"_22971":683,"_15675":38071,"_5":15564,"_21706":37918,"_1911":38072},[],"The status should change to **REVOKED** and the CRL should reflect the new information. The CA can no longer issue certificates.",{"_2322":758,"_22971":683,"_15675":38074,"_5":15564,"_21706":37918,"_1911":38075},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2322":759,"_22971":759,"_5":10796,"_1911":38077,"_23246":38078,"_15675":38079,"_21706":759},"Certificate profiles",[35713,36848,37382],[],{"_2322":760,"_22971":759,"_15675":38081,"_5":15564,"_21706":759,"_1911":38082},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2322":761,"_22971":759,"_5":23243,"_15675":38084,"_21706":38085,"_1911":38086},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2322":762,"_22971":759,"_5":23243,"_15675":38088,"_21706":38089,"_1911":38090},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#validity","Validity",{"_2322":763,"_22971":759,"_5":23243,"_15675":38092,"_21706":38093,"_1911":38094},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2322":764,"_22971":759,"_5":23243,"_15675":38096,"_21706":38097,"_1911":38098},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2322":765,"_22971":759,"_5":23243,"_15675":38100,"_21706":38101,"_1911":38102},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#subject","Subject",{"_2322":766,"_22971":759,"_5":23243,"_15675":38104,"_21706":38105,"_1911":38106},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2322":767,"_22971":759,"_5":23243,"_15675":38108,"_21706":38109,"_1911":38110},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2322":768,"_22971":759,"_5":23243,"_15675":38112,"_21706":38113,"_1911":38114},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2322":769,"_22971":759,"_5":23243,"_15675":38116,"_21706":38117,"_1911":38118},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2322":770,"_22971":759,"_5":23243,"_15675":38120,"_21706":38121,"_1911":38122},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2322":771,"_22971":759,"_5":23243,"_15675":38124,"_21706":38125,"_1911":38126},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2322":772,"_22971":759,"_5":23243,"_15675":38128,"_21706":38129,"_1911":38130},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2322":773,"_22971":759,"_5":23243,"_15675":38132,"_21706":38133,"_1911":38134},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2322":774,"_22971":759,"_5":23243,"_15675":38136,"_21706":38137,"_1911":38138},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2322":775,"_22971":759,"_5":23243,"_15675":38140,"_21706":38141,"_1911":38142},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#design-examples","Design examples",{"_2322":776,"_22971":759,"_5":23243,"_15675":38144,"_21706":38145,"_1911":38146},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2322":777,"_22971":759,"_15675":38148,"_5":15564,"_21706":759,"_1911":38149},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2322":778,"_22971":759,"_15675":38151,"_5":15564,"_21706":38089,"_1911":38152},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2322":779,"_22971":759,"_15675":38154,"_5":15564,"_21706":38089,"_1911":38155},[],"The end date must never outlive the issuing CA.",{"_2322":780,"_22971":759,"_15675":38157,"_5":15564,"_21706":38093,"_1911":38158},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2322":781,"_22971":759,"_15675":38160,"_5":15564,"_21706":38097,"_1911":38161},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2322":782,"_22971":759,"_15675":38163,"_5":15564,"_21706":38097,"_1911":38164},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2322":783,"_22971":759,"_15675":38166,"_5":15564,"_21706":38097,"_1911":38167},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2322":784,"_22971":759,"_15675":38169,"_5":15564,"_21706":38101,"_1911":38170},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2322":785,"_22971":759,"_15675":38172,"_5":15564,"_21706":38105,"_1911":38173},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2322":786,"_22971":759,"_15675":38175,"_5":15564,"_21706":38105,"_1911":38176},[],"This behavior allows accepting DNS, IP, email or URI as alternative identities without accepting arbitrary extensions.",{"_2322":787,"_22971":759,"_15675":38178,"_5":15564,"_21706":38109,"_1911":38179},[],"The cryptographic enforcement can:",{"_2322":788,"_22971":759,"_15675":38181,"_5":15564,"_21706":38109,"_1911":38182},[],"allow or block RSA keys;",{"_2322":789,"_22971":759,"_15675":38184,"_5":15564,"_21706":38109,"_1911":38185},[],"limit the supported RSA sizes;",{"_2322":790,"_22971":759,"_15675":38187,"_5":15564,"_21706":38109,"_1911":38188},[],"allow or block ECDSA keys;",{"_2322":791,"_22971":759,"_15675":38190,"_5":15564,"_21706":38109,"_1911":38191},[],"limit the supported ECDSA sizes or curves.",{"_2322":792,"_22971":759,"_15675":38193,"_5":15564,"_21706":38109,"_1911":38194},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2322":793,"_22971":759,"_15675":38196,"_5":15564,"_21706":38113,"_1911":38197},[],"In operations that accept multiple sources, Lamassu resolves the profile in this order:",{"_2322":794,"_22971":759,"_15675":38199,"_5":15564,"_21706":38113,"_1911":38200},[],"The profile sent within the operation.",{"_2322":795,"_22971":759,"_15675":38202,"_5":15564,"_21706":38113,"_1911":38203},[],"The profile identifier sent in the operation.",{"_2322":796,"_22971":759,"_15675":38205,"_5":15564,"_21706":38113,"_1911":38206},[],"The default profile associated with the CA.",{"_2322":797,"_22971":759,"_15675":38208,"_5":15564,"_21706":38113,"_1911":38209},[],"A DMS can also reference its own issuance profile. This way, several fleets can use the same CA with different policies.",{"_2322":798,"_22971":759,"_15675":38211,"_5":15564,"_21706":38121,"_1911":38212},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2322":799,"_22971":759,"_15675":38214,"_5":15564,"_21706":38125,"_1911":38215},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2322":800,"_22971":759,"_15675":38217,"_5":15564,"_21706":38129,"_1911":38218},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2322":801,"_22971":759,"_15675":38220,"_5":15564,"_21706":38133,"_1911":38221},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2322":802,"_22971":759,"_15675":38223,"_5":15564,"_21706":38137,"_1911":38224},[],"Attach the profile to a CA or DMS. Issue a test certificate and check subject, SAN, KU, EKU, basic constraints and dates with an independent X.509 tool.",{"_2322":803,"_22971":759,"_15675":38226,"_5":15564,"_21706":38141,"_1911":38227},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2322":804,"_22971":759,"_15675":38229,"_5":15564,"_21706":38141,"_1911":38230},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2322":805,"_22971":759,"_15675":38232,"_5":15564,"_21706":38141,"_1911":38233},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2322":806,"_22971":759,"_15675":38235,"_5":15564,"_21706":38141,"_1911":38236},[],"These are starting patterns, not a universal policy. Always verify the requirements of the protocol, the consumer and the applicable regulatory framework.",{"_2322":807,"_22971":759,"_15675":38238,"_5":15564,"_21706":38145,"_1911":38239},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2322":808,"_22971":759,"_15675":38241,"_5":15564,"_21706":38145,"_1911":38242},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2322":809,"_22971":809,"_5":10796,"_1911":38244,"_23246":38245,"_15675":38246,"_21706":809},"Certificate validation",[35713,36848,37382],[],{"_2322":810,"_22971":809,"_15675":38248,"_5":15564,"_21706":809,"_1911":38249},[],"Publish the status of identities through OCSP and CRL.",{"_2322":811,"_22971":809,"_5":23243,"_15675":38251,"_21706":38252,"_1911":38253},[],"/docs/pr-preview/pr-28/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2322":812,"_22971":809,"_15675":38255,"_5":15564,"_21706":809,"_1911":38256},[],"Issuance proves who signed a certificate; validation tells you whether it should still be accepted. Lamassu publishes status through two complementary mechanisms.",{"_2322":813,"_22971":809,"_15675":38258,"_5":15564,"_21706":38252,"_1911":38259},[],"Use **OCSP** when the consumer is online and needs to check the latest status of a specific certificate.",{"_2322":814,"_22971":809,"_15675":38261,"_5":15564,"_21706":38252,"_1911":38262},[],"Use a **CRL** when validation must happen locally, offline or over a high volume of certificates. The consumer periodically downloads a signed list and keeps it until the next update.",{"_2322":815,"_22971":809,"_15675":38264,"_5":15564,"_21706":38252,"_1911":38265},[],"Many environments use both: OCSP as the primary check and a CRL as the local or fallback mechanism.",{"_2322":816,"_22971":809,"_15675":38267,"_5":15564,"_21706":38252,"_1911":38268},[],"<Card title=\"Online validation with OCSP\" description=\"Query Good, Revoked and Unknown statuses in real time.\" href=\"/docs/platform/pki/ocsp\" />",{"_2322":817,"_22971":809,"_15675":38270,"_5":15564,"_21706":38252,"_1911":38271},[],"<Card title=\"Revocation lists\" description=\"Generate, publish and distribute CRLs per authority.\" href=\"/docs/platform/pki/crl\" />",{"_2322":818,"_22971":818,"_5":10796,"_1911":38273,"_23246":38274,"_15675":38275,"_21706":818},"Certificates",[35713,36848,37382],[],{"_2322":819,"_22971":818,"_15675":38277,"_5":15564,"_21706":818,"_1911":38278},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2322":820,"_22971":818,"_5":23243,"_15675":38280,"_21706":38281,"_1911":38282},[],"/docs/pr-preview/pr-28/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2322":821,"_22971":818,"_5":23243,"_15675":38284,"_21706":38285,"_1911":38286},[],"/docs/pr-preview/pr-28/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2322":822,"_22971":818,"_5":23243,"_15675":38288,"_21706":38289,"_1911":38290},[],"/docs/pr-preview/pr-28/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2322":823,"_22971":818,"_5":23243,"_15675":38292,"_21706":38293,"_1911":38294},[],"/docs/pr-preview/pr-28/platform/pki/certificates#open-the-action","Open the action",{"_2322":824,"_22971":818,"_5":23243,"_15675":38296,"_21706":38297,"_1911":38298},[],"/docs/pr-preview/pr-28/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2322":825,"_22971":818,"_5":23243,"_15675":38300,"_21706":38301,"_1911":38302},[],"/docs/pr-preview/pr-28/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2322":826,"_22971":818,"_5":23243,"_15675":38304,"_21706":38305,"_1911":38306},[],"/docs/pr-preview/pr-28/platform/pki/certificates#continue","Continue",{"_2322":827,"_22971":818,"_15675":38308,"_5":15564,"_21706":818,"_1911":38309},[],"The certificate inventory offers a global view of the identities issued by all authorities. You can also open **Issued Certificates** inside a CA to limit the view to that issuer.",{"_2322":828,"_22971":818,"_15675":38311,"_5":15564,"_21706":38281,"_1911":38312},[],"Open **Certificates** and filter by:",{"_2322":829,"_22971":818,"_15675":38314,"_5":15564,"_21706":38281,"_1911":38315},[],"Subject's `Common Name`.",{"_2322":830,"_22971":818,"_15675":38317,"_5":15564,"_21706":38281,"_1911":38318},[],"Serial number.",{"_2322":831,"_22971":818,"_15675":38320,"_5":15564,"_21706":38281,"_1911":38321},[],"Status.",{"_2322":832,"_22971":818,"_15675":38323,"_5":15564,"_21706":38281,"_1911":38324},[],"Issuing authority.",{"_2322":833,"_22971":818,"_15675":38326,"_5":15564,"_21706":38281,"_1911":38327},[],"Use **Quick Inspect** for a quick check or **View Details** to see the subject, SANs, usages, chain, validity period and full metadata.",{"_2322":834,"_22971":818,"_15675":38329,"_5":15564,"_21706":38285,"_1911":38330},[],"The download action delivers the certificate in PEM format. If the certificate was issued from an external CSR, the private key stays on the system that generated that CSR. If it was generated in the browser, the key was only available when the issuance finished.",{"_2322":835,"_22971":818,"_15675":38332,"_5":15564,"_21706":38289,"_1911":38333},[],"Revoke an identity when the key has been compromised, the subject is no longer authorized or the certificate must stop being accepted before it expires.",{"_2322":836,"_22971":818,"_15675":38335,"_5":15564,"_21706":38293,"_1911":38336},[],"In the inventory or detail view, select **Revoke Certificate**.",{"_2322":837,"_22971":818,"_15675":38338,"_5":15564,"_21706":38297,"_1911":38339},[],"Select the reason that represents the incident. This information is published in OCSP and in the CRL.",{"_2322":838,"_22971":818,"_15675":38341,"_5":15564,"_21706":38301,"_1911":38342},[],"Confirm the operation and check that the status is **Revoked**. If the CA regenerates the CRL upon revocation, also verify that a new version exists.",{"_2322":839,"_22971":818,"_15675":38344,"_5":15564,"_21706":38301,"_1911":38345},[],"A revocation with the reason `CertificateHold` can be reactivated. All other reasons produce a final revocation.",{"_2322":840,"_22971":818,"_15675":38347,"_5":15564,"_21706":38305,"_1911":38348},[],"<Card title=\"Validate with OCSP\" description=\"Query the status of a certificate in real time.\" href=\"/docs/platform/pki/ocsp\" />",{"_2322":841,"_22971":818,"_15675":38350,"_5":15564,"_21706":38305,"_1911":38351},[],"<Card title=\"Distribute a CRL\" description=\"Publish the status for offline validation.\" href=\"/docs/platform/pki/crl\" />",{"_2322":842,"_22971":842,"_5":10796,"_1911":38353,"_23246":38354,"_15675":38356,"_21706":842},"Platform architecture",[35713,36848,38355],"Concepts",[],{"_2322":843,"_22971":842,"_15675":38358,"_5":15564,"_21706":842,"_1911":38359},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2322":844,"_22971":842,"_5":23243,"_15675":38361,"_21706":38362,"_1911":38363},[],"/docs/pr-preview/pr-28/platform/pki/concepts/architecture#control-plane","Control plane",{"_2322":845,"_22971":842,"_5":23243,"_15675":38365,"_21706":38366,"_1911":38367},[],"/docs/pr-preview/pr-28/platform/pki/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2322":846,"_22971":842,"_5":23243,"_15675":38369,"_21706":38370,"_1911":38371},[],"/docs/pr-preview/pr-28/platform/pki/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2322":847,"_22971":842,"_5":23243,"_15675":38373,"_21706":38374,"_1911":38375},[],"/docs/pr-preview/pr-28/platform/pki/concepts/architecture#status-and-validation","Status and validation",{"_2322":848,"_22971":842,"_5":23243,"_15675":38377,"_21706":38378,"_1911":38379},[],"/docs/pr-preview/pr-28/platform/pki/concepts/architecture#platform-dependencies","Platform dependencies",{"_2322":849,"_22971":842,"_15675":38381,"_5":15564,"_21706":842,"_1911":38382},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2322":850,"_22971":842,"_15675":38384,"_5":15564,"_21706":842,"_1911":38385},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2322":851,"_22971":842,"_15675":38387,"_5":15564,"_21706":38362,"_1911":38388},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2322":852,"_22971":842,"_15675":38390,"_5":15564,"_21706":38366,"_1911":38391},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2322":853,"_22971":842,"_15675":38393,"_5":15564,"_21706":38370,"_1911":38394},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2322":854,"_22971":842,"_15675":38396,"_5":15564,"_21706":38374,"_1911":38397},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2322":855,"_22971":842,"_15675":38399,"_5":15564,"_21706":38378,"_1911":38400},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2322":856,"_22971":856,"_5":10796,"_1911":38402,"_23246":38403,"_15675":38404,"_21706":856},"Certificate lifecycle",[35713,36848,38355],[],{"_2322":857,"_22971":856,"_15675":38406,"_5":15564,"_21706":856,"_1911":38407},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2322":858,"_22971":856,"_5":23243,"_15675":38409,"_21706":38410,"_1911":38411},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2322":859,"_22971":856,"_5":23243,"_15675":38413,"_21706":38414,"_1911":38415},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2322":860,"_22971":856,"_5":23243,"_15675":38417,"_21706":38418,"_1911":38419},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2322":861,"_22971":856,"_5":23243,"_15675":38421,"_21706":38422,"_1911":38423},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2322":862,"_22971":856,"_5":23243,"_15675":38425,"_21706":38426,"_1911":38427},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2322":863,"_22971":856,"_5":23243,"_15675":38429,"_21706":38430,"_1911":38431},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2322":864,"_22971":856,"_5":23243,"_15675":38433,"_21706":38434,"_1911":38435},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2322":865,"_22971":856,"_5":23243,"_15675":38437,"_21706":38438,"_1911":38439},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2322":866,"_22971":856,"_5":23243,"_15675":38441,"_21706":38442,"_1911":38443},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2322":867,"_22971":856,"_5":23243,"_15675":38445,"_21706":38446,"_1911":38447},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2322":868,"_22971":856,"_15675":38449,"_5":15564,"_21706":856,"_1911":38450},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2322":869,"_22971":856,"_15675":38452,"_5":15564,"_21706":38414,"_1911":38453},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2322":870,"_22971":856,"_15675":38455,"_5":15564,"_21706":38418,"_1911":38456},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2322":871,"_22971":856,"_15675":38458,"_5":15564,"_21706":38422,"_1911":38459},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2322":872,"_22971":856,"_15675":38461,"_5":15564,"_21706":38426,"_1911":38462},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2322":873,"_22971":856,"_15675":38464,"_5":15564,"_21706":38430,"_1911":38465},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2322":874,"_22971":856,"_15675":38467,"_5":15564,"_21706":38434,"_1911":38468},[],"Lamassu persists four X.509 states:",{"_2322":875,"_22971":856,"_15675":38470,"_5":15564,"_21706":38434,"_1911":38471},[],"**`ACTIVE`**: the certificate is enabled and within its validity period.",{"_2322":876,"_22971":856,"_15675":38473,"_5":15564,"_21706":38434,"_1911":38474},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2322":877,"_22971":856,"_15675":38476,"_5":15564,"_21706":38434,"_1911":38477},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2322":878,"_22971":856,"_15675":38479,"_5":15564,"_21706":38434,"_1911":38480},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2322":879,"_22971":856,"_15675":38482,"_5":15564,"_21706":38434,"_1911":38483},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2322":880,"_22971":856,"_15675":38485,"_5":15564,"_21706":38438,"_1911":38486},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2322":881,"_22971":856,"_15675":38488,"_5":15564,"_21706":38438,"_1911":38489},[],"Only a revocation with the reason `CertificateHold` can be undone. A revocation with any other reason is final in Lamassu.",{"_2322":882,"_22971":856,"_15675":38491,"_5":15564,"_21706":38438,"_1911":38492},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2322":883,"_22971":856,"_15675":38494,"_5":15564,"_21706":38442,"_1911":38495},[],"Revoking a CA is a cascading operation. Lamassu revokes its child CAs and the certificates it issued, with the reason `CessationOfOperation`. The propagation continues down the hierarchy.",{"_2322":884,"_22971":856,"_15675":38497,"_5":15564,"_21706":38442,"_1911":38498},[],"Before confirming:",{"_2322":885,"_22971":856,"_15675":38500,"_5":15564,"_21706":38442,"_1911":38501},[],"Identify DMSs, devices and services that trust that chain.",{"_2322":886,"_22971":856,"_15675":38503,"_5":15564,"_21706":38442,"_1911":38504},[],"Distribute the new chain of trust.",{"_2322":887,"_22971":856,"_15675":38506,"_5":15564,"_21706":38442,"_1911":38507},[],"Reissue the necessary identities.",{"_2322":888,"_22971":856,"_15675":38509,"_5":15564,"_21706":38442,"_1911":38510},[],"Check OCSP and CRL from a real consumer.",{"_2322":889,"_22971":856,"_15675":38512,"_5":15564,"_21706":38442,"_1911":38513},[],"Revoke the old CA once no legitimate traffic remains.",{"_2322":890,"_22971":856,"_15675":38515,"_5":15564,"_21706":38442,"_1911":38516},[],"Decommissioning a device revokes its certificates and prevents it from obtaining new identities. Use this action only when the device is being retired permanently.",{"_2322":891,"_22971":856,"_15675":38518,"_5":15564,"_21706":38446,"_1911":38519},[],"Certificates entering the preventive or critical renewal window.",{"_2322":892,"_22971":856,"_15675":38521,"_5":15564,"_21706":38446,"_1911":38522},[],"Repeated enrollment or re-enrollment failures.",{"_2322":893,"_22971":856,"_15675":38524,"_5":15564,"_21706":38446,"_1911":38525},[],"Status changes and revocation reasons.",{"_2322":894,"_22971":856,"_15675":38527,"_5":15564,"_21706":38446,"_1911":38528},[],"OCSP and CRL publication and validity.",{"_2322":895,"_22971":856,"_15675":38530,"_5":15564,"_21706":38446,"_1911":38531},[],"Dependencies still presenting a replaced certificate.",{"_2322":896,"_22971":856,"_15675":38533,"_5":15564,"_21706":38446,"_1911":38534},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2322":897,"_22971":897,"_5":10796,"_1911":38536,"_23246":38537,"_15675":38538,"_21706":897},"Glossary",[35713,36848,38355],[],{"_2322":898,"_22971":897,"_15675":38540,"_5":15564,"_21706":897,"_1911":38541},[],"PKI, certificate and identity management terms used in Lamassu.",{"_2322":899,"_22971":897,"_5":23243,"_15675":38543,"_21706":38544,"_1911":38545},[],"/docs/pr-preview/pr-28/platform/pki/concepts/glossary#ac","A–C",{"_2322":900,"_22971":897,"_5":23243,"_15675":38547,"_21706":38548,"_1911":38549},[],"/docs/pr-preview/pr-28/platform/pki/concepts/glossary#dk","D–K",{"_2322":901,"_22971":897,"_5":23243,"_15675":38551,"_21706":38552,"_1911":38553},[],"/docs/pr-preview/pr-28/platform/pki/concepts/glossary#mr","M–R",{"_2322":902,"_22971":897,"_5":23243,"_15675":38555,"_21706":38556,"_1911":38557},[],"/docs/pr-preview/pr-28/platform/pki/concepts/glossary#sz","S–Z",{"_2322":903,"_22971":897,"_15675":38559,"_5":15564,"_21706":38544,"_1911":38560},[],"**AKI (Authority Key Identifier)**\\\nIdentifier of the public key of the authority that signed a certificate. It helps build the chain toward the correct issuer.",{"_2322":904,"_22971":897,"_15675":38562,"_5":15564,"_21706":38544,"_1911":38563},[],"**Anchor of trust**\\\nA certificate, usually from a root CA, that a consumer explicitly accepts as the endpoint of a chain.",{"_2322":905,"_22971":897,"_15675":38565,"_5":15564,"_21706":38544,"_1911":38566},[],"**CA (Certification Authority)**\\\nAuthority that signs certificates and binds an identity to a public key.",{"_2322":906,"_22971":897,"_15675":38568,"_5":15564,"_21706":38544,"_1911":38569},[],"**Intermediate CA**\\\nA CA signed by another authority. Used to issue without exposing the root to daily operation.",{"_2322":907,"_22971":897,"_15675":38571,"_5":15564,"_21706":38544,"_1911":38572},[],"**Root CA**\\\nA self-signed CA that starts a hierarchy of trust.",{"_2322":908,"_22971":897,"_15675":38574,"_5":15564,"_21706":38544,"_1911":38575},[],"**X.509 certificate**\\\nA signed document containing a public key, a subject, an issuer, a validity period and extensions that constrain its use.",{"_2322":909,"_22971":897,"_15675":38577,"_5":15564,"_21706":38544,"_1911":38578},[],"**CRL (Certificate Revocation List)**\\\nSigned list of revoked certificates published by a CA.",{"_2322":910,"_22971":897,"_15675":38580,"_5":15564,"_21706":38544,"_1911":38581},[],"**CSR (Certificate Signing Request)**\\\nPKCS#10 request containing a public key and requested attributes. Signing the CSR proves possession of the corresponding private key.",{"_2322":911,"_22971":897,"_15675":38583,"_5":15564,"_21706":38548,"_1911":38584},[],"**DMS (Device Management Service)**\\\nConfiguration that groups registration, enrollment, re-enrollment, issuance and CA distribution rules for a fleet.",{"_2322":912,"_22971":897,"_15675":38586,"_5":15564,"_21706":38548,"_1911":38587},[],"**Distinguished Name (DN)**\\\nSet of subject or issuer attributes, such as `CN`, `O`, `OU`, `C`, `ST` and `L`.",{"_2322":913,"_22971":897,"_15675":38589,"_5":15564,"_21706":38548,"_1911":38590},[],"**EST (Enrollment over Secure Transport)**\\\nProtocol defined in RFC 7030 to obtain CAs, enroll and re-enroll certificates over HTTPS.",{"_2322":914,"_22971":897,"_15675":38592,"_5":15564,"_21706":38548,"_1911":38593},[],"**Extended Key Usage (EKU)**\\\nExtension that constrains purposes such as client authentication, server authentication, code signing or OCSP.",{"_2322":915,"_22971":897,"_15675":38595,"_5":15564,"_21706":38548,"_1911":38596},[],"**Device identity**\\\nRelationship between a device and one of its certificates. A device can keep a history of identities.",{"_2322":916,"_22971":897,"_15675":38598,"_5":15564,"_21706":38548,"_1911":38599},[],"**Identity slot**\\\nLogical position on a device where Lamassu binds an active or historical identity.",{"_2322":917,"_22971":897,"_15675":38601,"_5":15564,"_21706":38548,"_1911":38602},[],"**JITP (Just-in-Time Provisioning)**\\\nAutomatic registration of a device when it successfully completes its first enrollment.",{"_2322":918,"_22971":897,"_15675":38604,"_5":15564,"_21706":38548,"_1911":38605},[],"**KMS (Key Management Service)**\\\nLamassu service that normalizes key generation, import and use across different cryptographic engines.",{"_2322":919,"_22971":897,"_15675":38607,"_5":15564,"_21706":38548,"_1911":38608},[],"**Key Usage**\\\nX.509 extension that allows basic operations such as digital signature, key encryption or certificate signing.",{"_2322":920,"_22971":897,"_15675":38610,"_5":15564,"_21706":38552,"_1911":38611},[],"**mTLS (Mutual TLS)**\\\nTLS where both client and server present certificates. A DMS can use the client certificate as an authentication method.",{"_2322":921,"_22971":897,"_15675":38613,"_5":15564,"_21706":38552,"_1911":38614},[],"**OCSP (Online Certificate Status Protocol)**\\\nProtocol for querying online whether a certificate is valid, revoked or unknown.",{"_2322":922,"_22971":897,"_15675":38616,"_5":15564,"_21706":38552,"_1911":38617},[],"**Issuance profile**\\\nReusable policy that defines how Lamassu builds a certificate and which keys it accepts.",{"_2322":923,"_22971":897,"_15675":38619,"_5":15564,"_21706":38552,"_1911":38620},[],"**Principal**\\\nOperator or API client identity recognized by the authorization service. Lamassu supports OIDC and X.509 principals.",{"_2322":924,"_22971":897,"_15675":38622,"_5":15564,"_21706":38552,"_1911":38623},[],"**Policy**\\\nSet of permissions assignable to one or more principals.",{"_2322":925,"_22971":897,"_15675":38625,"_5":15564,"_21706":38552,"_1911":38626},[],"**RA (Registration Authority)**\\\nComponent that verifies the requester before asking a CA to issue. The DMS plays this role in device enrollment flows.",{"_2322":926,"_22971":897,"_15675":38628,"_5":15564,"_21706":38552,"_1911":38629},[],"**Relying party**\\\nConsuming system that decides whether to accept a presented certificate.",{"_2322":927,"_22971":897,"_15675":38631,"_5":15564,"_21706":38552,"_1911":38632},[],"**Revocation**\\\nInvalidation of a certificate before its expiration date.",{"_2322":928,"_22971":897,"_15675":38634,"_5":15564,"_21706":38556,"_1911":38635},[],"**SAN (Subject Alternative Name)**\\\nExtension that adds identities such as DNS names, IP addresses, emails or URIs.",{"_2322":929,"_22971":897,"_15675":38637,"_5":15564,"_21706":38556,"_1911":38638},[],"**SKI (Subject Key Identifier)**\\\nIdentifier derived from the public key of the certificate itself.",{"_2322":930,"_22971":897,"_15675":38640,"_5":15564,"_21706":38556,"_1911":38641},[],"**VA (Validation Authority)**\\\nLamassu service responsible for OCSP responses and the generation or publication of CRLs.",{"_2322":931,"_22971":897,"_15675":38643,"_5":15564,"_21706":38556,"_1911":38644},[],"**Renewal window**\\\nPeriod before expiration during which a device may or must request another identity.",{"_2322":932,"_22971":897,"_15675":38646,"_5":15564,"_21706":38556,"_1911":38647},[],"Missing an operational term? Check How Lamassu works and the Trust model first, where these concepts appear connected.",{"_2322":933,"_22971":933,"_5":10796,"_1911":38649,"_23246":38650,"_15675":38651,"_21706":933},"How Lamassu works",[35713,36848,38355],[],{"_2322":934,"_22971":933,"_15675":38653,"_5":15564,"_21706":933,"_1911":38654},[],"The mental model of trust, keys, certificates and devices.",{"_2322":935,"_22971":933,"_5":23243,"_15675":38656,"_21706":38657,"_1911":38658},[],"/docs/pr-preview/pr-28/platform/pki/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2322":936,"_22971":933,"_5":23243,"_15675":38660,"_21706":38661,"_1911":38662},[],"/docs/pr-preview/pr-28/platform/pki/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2322":937,"_22971":933,"_15675":38664,"_5":15564,"_21706":933,"_1911":38665},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2322":938,"_22971":933,"_15675":38667,"_5":15564,"_21706":38657,"_1911":38668},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2322":939,"_22971":933,"_15675":38670,"_5":15564,"_21706":38657,"_1911":38671},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2322":940,"_22971":933,"_15675":38673,"_5":15564,"_21706":38657,"_1911":38674},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2322":941,"_22971":933,"_15675":38676,"_5":15564,"_21706":38657,"_1911":38677},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2322":942,"_22971":933,"_15675":38679,"_5":15564,"_21706":38657,"_1911":38680},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2322":943,"_22971":933,"_15675":38682,"_5":15564,"_21706":38661,"_1911":38683},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2322":944,"_22971":933,"_15675":38685,"_5":15564,"_21706":38661,"_1911":38686},[],"A DMS relates that CA to an enrollment policy.",{"_2322":945,"_22971":933,"_15675":38688,"_5":15564,"_21706":38661,"_1911":38689},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2322":946,"_22971":933,"_15675":38691,"_5":15564,"_21706":38661,"_1911":38692},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2322":947,"_22971":933,"_15675":38694,"_5":15564,"_21706":38661,"_1911":38695},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2322":948,"_22971":933,"_15675":38697,"_5":15564,"_21706":38661,"_1911":38698},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/pki/concepts/architecture\" />",{"_2322":949,"_22971":933,"_15675":38700,"_5":15564,"_21706":38661,"_1911":38701},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2322":950,"_22971":950,"_5":10796,"_1911":38703,"_23246":38704,"_15675":38705,"_21706":950},"Trust model",[35713,36848,38355],[],{"_2322":951,"_22971":950,"_15675":38707,"_5":15564,"_21706":950,"_1911":38708},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2322":952,"_22971":950,"_5":23243,"_15675":38710,"_21706":38711,"_1911":38712},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2322":953,"_22971":950,"_5":23243,"_15675":38714,"_21706":38715,"_1911":38716},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2322":954,"_22971":950,"_5":23243,"_15675":38718,"_21706":38719,"_1911":38720},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2322":955,"_22971":950,"_5":23243,"_15675":38722,"_21706":38723,"_1911":38724},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2322":956,"_22971":950,"_5":23243,"_15675":38726,"_21706":38727,"_1911":38728},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2322":957,"_22971":950,"_5":23243,"_15675":38730,"_21706":38731,"_1911":38732},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2322":958,"_22971":950,"_5":23243,"_15675":38734,"_21706":38735,"_1911":38736},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2322":959,"_22971":950,"_5":23243,"_15675":38738,"_21706":38739,"_1911":38740},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2322":960,"_22971":950,"_5":23243,"_15675":38742,"_21706":38743,"_1911":38744},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2322":961,"_22971":950,"_5":23243,"_15675":38746,"_21706":38747,"_1911":38748},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2322":962,"_22971":950,"_15675":38750,"_5":15564,"_21706":950,"_1911":38751},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2322":963,"_22971":950,"_15675":38753,"_5":15564,"_21706":38715,"_1911":38754},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2322":964,"_22971":950,"_15675":38756,"_5":15564,"_21706":38719,"_1911":38757},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2322":965,"_22971":950,"_15675":38759,"_5":15564,"_21706":38723,"_1911":38760},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2322":966,"_22971":950,"_15675":38762,"_5":15564,"_21706":38727,"_1911":38763},[],"The consuming service or device keeps its own trust store. Lamassu can distribute the system CA, the enrollment CA and other managed CAs through `/cacerts`, but the consumer decides which ones it installs and how it applies validation.",{"_2322":967,"_22971":950,"_15675":38765,"_5":15564,"_21706":38731,"_1911":38766},[],"The device proves it can enroll according to the DMS policy.",{"_2322":968,"_22971":950,"_15675":38768,"_5":15564,"_21706":38731,"_1911":38769},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2322":969,"_22971":950,"_15675":38771,"_5":15564,"_21706":38731,"_1911":38772},[],"The CA applies the profile and signs without ever receiving the device's private key.",{"_2322":970,"_22971":950,"_15675":38774,"_5":15564,"_21706":38731,"_1911":38775},[],"The device installs the certificate and the chain it needs.",{"_2322":971,"_22971":950,"_15675":38777,"_5":15564,"_21706":38731,"_1911":38778},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2322":972,"_22971":950,"_15675":38780,"_5":15564,"_21706":38731,"_1911":38781},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2322":973,"_22971":950,"_15675":38783,"_5":15564,"_21706":38735,"_1911":38784},[],"A DMS relates three sets that are worth designing separately:",{"_2322":974,"_22971":950,"_15675":38786,"_5":15564,"_21706":38735,"_1911":38787},[],"**Enrollment CA:** signs the new identities.",{"_2322":975,"_22971":950,"_15675":38789,"_5":15564,"_21706":38735,"_1911":38790},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs.",{"_2322":976,"_22971":950,"_15675":38792,"_5":15564,"_21706":38735,"_1911":38793},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the system CA, the enrollment CA and a list of managed CAs.",{"_2322":977,"_22971":950,"_15675":38795,"_5":15564,"_21706":38735,"_1911":38796},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2322":978,"_22971":950,"_15675":38798,"_5":15564,"_21706":38739,"_1911":38799},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2322":979,"_22971":950,"_15675":38801,"_5":15564,"_21706":38739,"_1911":38802},[],"that the current date is between `Not Before` and `Not After`;",{"_2322":980,"_22971":950,"_15675":38804,"_5":15564,"_21706":38739,"_1911":38805},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2322":981,"_22971":950,"_15675":38807,"_5":15564,"_21706":38739,"_1911":38808},[],"that names, SANs and subject match the expected identity;",{"_2322":982,"_22971":950,"_15675":38810,"_5":15564,"_21706":38739,"_1911":38811},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2322":983,"_22971":950,"_15675":38813,"_5":15564,"_21706":38739,"_1911":38814},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2322":984,"_22971":950,"_15675":38816,"_5":15564,"_21706":38743,"_1911":38817},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2322":985,"_22971":950,"_15675":38819,"_5":15564,"_21706":38747,"_1911":38820},[],"Keep the root out of daily operations, or with very restricted access.",{"_2322":986,"_22971":950,"_15675":38822,"_5":15564,"_21706":38747,"_1911":38823},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2322":987,"_22971":950,"_15675":38825,"_5":15564,"_21706":38747,"_1911":38826},[],"Assign explicit profiles to every use case.",{"_2322":988,"_22971":950,"_15675":38828,"_5":15564,"_21706":38747,"_1911":38829},[],"Distribute the new trust before starting a rotation.",{"_2322":989,"_22971":950,"_15675":38831,"_5":15564,"_21706":38747,"_1911":38832},[],"Keep enough overlap to renew a disconnected fleet.",{"_2322":990,"_22971":950,"_15675":38834,"_5":15564,"_21706":38747,"_1911":38835},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2322":991,"_22971":950,"_15675":38837,"_5":15564,"_21706":38747,"_1911":38838},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2322":992,"_22971":992,"_5":10796,"_1911":38840,"_23246":38841,"_15675":38842,"_21706":992},"Revocation lists (CRL)",[35713,36848,37382],[],{"_2322":993,"_22971":992,"_15675":38844,"_5":15564,"_21706":992,"_1911":38845},[],"Generate and distribute signed lists to validate certificates offline.",{"_2322":994,"_22971":992,"_5":23243,"_15675":38847,"_21706":38848,"_1911":38849},[],"/docs/pr-preview/pr-28/platform/pki/crl#crl-service","CRL service",{"_2322":995,"_22971":992,"_5":23243,"_15675":38851,"_21706":38852,"_1911":38853},[],"/docs/pr-preview/pr-28/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2322":996,"_22971":992,"_5":23243,"_15675":38855,"_21706":38856,"_1911":38857},[],"/docs/pr-preview/pr-28/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2322":997,"_22971":992,"_5":23243,"_15675":38859,"_21706":38860,"_1911":38861},[],"/docs/pr-preview/pr-28/platform/pki/crl#crl-contents","CRL contents",{"_2322":998,"_22971":992,"_5":23243,"_15675":38863,"_21706":38864,"_1911":38865},[],"/docs/pr-preview/pr-28/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2322":999,"_22971":992,"_5":23243,"_15675":38867,"_21706":38868,"_1911":38869},[],"/docs/pr-preview/pr-28/platform/pki/crl#va-role-management-api","VA role management API",{"_2322":1000,"_22971":992,"_5":23243,"_15675":38871,"_21706":38872,"_1911":38873},[],"/docs/pr-preview/pr-28/platform/pki/crl#from-the-interface","From the interface",{"_2322":1001,"_22971":992,"_5":23243,"_15675":38875,"_21706":38876,"_1911":38877},[],"/docs/pr-preview/pr-28/platform/pki/crl#references","References",{"_2322":1002,"_22971":992,"_15675":38879,"_5":15564,"_21706":38848,"_1911":38880},[],"A CRL (*Certificate Revocation List*) is a signed list containing the serial numbers of certificates revoked before their expiration date. Unlike OCSP, it does not require a real-time query: the relying party downloads the list periodically and consults it locally.",{"_2322":1003,"_22971":992,"_15675":38882,"_5":15564,"_21706":38848,"_1911":38883},[],"Lamassu generates and maintains one CRL per CA it manages. Each CRL is signed with the private key of the issuing CA itself and is stored in the object storage configured on the platform.",{"_2322":1004,"_22971":992,"_15675":38885,"_5":15564,"_21706":38852,"_1911":38886},[],"The publication of each CA's CRL is controlled by a *VA role*. This object defines how it is generated, when it is regenerated and which key signs it.",{"_2322":1005,"_22971":992,"_15675":38888,"_5":15564,"_21706":38852,"_1911":38889},[],"The main parameters are:",{"_2322":1006,"_22971":992,"_15675":38891,"_5":15564,"_21706":38852,"_1911":38892},[],"**`validity`** defines the validity period reflected in `nextUpdate`. Its default value is 7 days.",{"_2322":1007,"_22971":992,"_15675":38894,"_5":15564,"_21706":38852,"_1911":38895},[],"**`refresh_interval`** sets the minimum interval between scheduled regenerations. By default it is approximately 6 days and 23 hours.",{"_2322":1008,"_22971":992,"_15675":38897,"_5":15564,"_21706":38852,"_1911":38898},[],"**`regenerate_on_revoke`** orders publishing a new version immediately after a revocation. It is enabled by default.",{"_2322":1009,"_22971":992,"_15675":38900,"_5":15564,"_21706":38852,"_1911":38901},[],"The `subject_key_id_signer` field identifies the CA whose private key signs the CRL. By default, each CA signs its own CRL.",{"_2322":1010,"_22971":992,"_15675":38903,"_5":15564,"_21706":38852,"_1911":38904},[],"Each CRL carries an incremental version number. Lamassu stores all versions under the path `pki/va/crl/{subject_key_id}/{version}.crl` in object storage.",{"_2322":1011,"_22971":992,"_15675":38906,"_5":15564,"_21706":38856,"_1911":38907},[],"A background process monitors active VA roles. When the remaining validity of the current CRL falls below the configured watch period (*blind period*), the system requests the generation of a new CRL. This prevents the published CRL from expiring without a valid version available.",{"_2322":1012,"_22971":992,"_15675":38909,"_5":15564,"_21706":38856,"_1911":38910},[],"Additionally, when `regenerate_on_revoke` is enabled, which is the default behavior, any certificate revocation immediately triggers the generation of a new CRL for the affected CA. This minimizes the time between revocation and its publication.",{"_2322":1013,"_22971":992,"_15675":38912,"_5":15564,"_21706":38860,"_1911":38913},[],"Each entry of the CRL includes the serial number of the revoked certificate, the revocation date and the RFC 5280 reason code.",{"_2322":1014,"_22971":992,"_15675":38915,"_5":15564,"_21706":38860,"_1911":38916},[],"The CRL also includes the *Issuing Distribution Point* (IDP, OID 2.5.29.28) extension, marked as critical, which indicates the public URL from which it can be downloaded. That URL points to the `/crl/{subject_key_id}` endpoint of each configured VA domain.",{"_2322":1015,"_22971":992,"_15675":38918,"_5":15564,"_21706":38864,"_1911":38919},[],"The latest CRL of a CA can be obtained directly without authentication:",{"_2322":1016,"_22971":992,"_15675":38921,"_5":15564,"_21706":38864,"_1911":38922},[],"The response has `Content-Type: application/pkix-crl` and contains the CRL in DER format.",{"_2322":1017,"_22971":992,"_15675":38924,"_5":15564,"_21706":38868,"_1911":38925},[],"The VA role of a CA can be queried and updated through the API:",{"_2322":1018,"_22971":992,"_15675":38927,"_5":15564,"_21706":38868,"_1911":38928},[],"Method",{"_2322":1019,"_22971":992,"_15675":38930,"_5":15564,"_21706":38868,"_1911":38931},[],"Path",{"_2322":1020,"_22971":992,"_15675":38933,"_5":15564,"_21706":38868,"_1911":38934},[],"Description",{"_2322":1021,"_22971":992,"_15675":38936,"_5":15564,"_21706":38868,"_1911":38937},[],"`GET`",{"_2322":1022,"_22971":992,"_15675":38939,"_5":15564,"_21706":38868,"_1911":38940},[],"`/v1/roles/{ca-ski}`",{"_2322":1023,"_22971":992,"_15675":38942,"_5":15564,"_21706":38868,"_1911":38943},[],"Returns the VA role configuration and the metadata of the last issued CRL.",{"_2322":1024,"_22971":992,"_15675":38945,"_5":15564,"_21706":38868,"_1911":38946},[],"`PUT`",{"_2322":1025,"_22971":992,"_15675":38948,"_5":15564,"_21706":38868,"_1911":38940},[],{"_2322":1026,"_22971":992,"_15675":38950,"_5":15564,"_21706":38868,"_1911":38951},[],"Updates the VA role configuration parameters (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_2322":1027,"_22971":992,"_15675":38953,"_5":15564,"_21706":38868,"_1911":38954},[],"Example of querying the VA role:",{"_2322":1028,"_22971":992,"_15675":38956,"_5":15564,"_21706":38868,"_1911":38957},[],"The response includes the `latest_crl` field with the version, the start of validity and the expiration date of the currently published CRL.",{"_2322":1029,"_22971":992,"_15675":38959,"_5":15564,"_21706":38872,"_1911":38960},[],"From a CA's detail panel you can preview the content of the active CRL and download it directly for offline use or for importing into applications that perform local validation.",{"_2322":1030,"_22971":992,"_15675":38962,"_5":15564,"_21706":38876,"_1911":38963},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_2322":1031,"_22971":992,"_15675":38965,"_5":15564,"_21706":38876,"_1911":38966},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2322":1032,"_22971":992,"_15675":38968,"_5":15564,"_21706":38876,"_1911":38969},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2322":1033,"_22971":1033,"_5":10796,"_1911":38971,"_23246":38972,"_15675":38973,"_21706":1033},"Device Management Service",[35713,36848,37382],[],{"_2322":1034,"_22971":1033,"_15675":38975,"_5":15564,"_21706":1033,"_1911":38976},[],"Define how a fleet receives, renews and uses its identities.",{"_2322":1035,"_22971":1033,"_5":23243,"_15675":38978,"_21706":38979,"_1911":35723},[],"/docs/pr-preview/pr-28/platform/pki/device-enrollment#before-you-begin",{"_2322":1036,"_22971":1033,"_5":23243,"_15675":38981,"_21706":38982,"_1911":38983},[],"/docs/pr-preview/pr-28/platform/pki/device-enrollment#configure-a-dms","Configure a DMS",{"_2322":1037,"_22971":1033,"_5":23243,"_15675":38985,"_21706":38986,"_1911":38987},[],"/docs/pr-preview/pr-28/platform/pki/device-enrollment#identify-the-fleet","Identify the fleet",{"_2322":1038,"_22971":1033,"_5":23243,"_15675":38989,"_21706":38990,"_1911":38991},[],"/docs/pr-preview/pr-28/platform/pki/device-enrollment#select-the-enrollment-ca","Select the enrollment CA",{"_2322":1039,"_22971":1033,"_5":23243,"_15675":38993,"_21706":38994,"_1911":38995},[],"/docs/pr-preview/pr-28/platform/pki/device-enrollment#configure-est","Configure EST",{"_2322":1040,"_22971":1033,"_5":23243,"_15675":38997,"_21706":38998,"_1911":38999},[],"/docs/pr-preview/pr-28/platform/pki/device-enrollment#distribute-trust","Distribute trust",{"_2322":1041,"_22971":1033,"_5":23243,"_15675":39001,"_21706":39002,"_1911":39003},[],"/docs/pr-preview/pr-28/platform/pki/device-enrollment#verify-the-endpoints","Verify the endpoints",{"_2322":1042,"_22971":1033,"_5":23243,"_15675":39005,"_21706":39006,"_1911":39007},[],"/docs/pr-preview/pr-28/platform/pki/device-enrollment#trust-distribution","Trust distribution",{"_2322":1043,"_22971":1033,"_5":23243,"_15675":39009,"_21706":39010,"_1911":39011},[],"/docs/pr-preview/pr-28/platform/pki/device-enrollment#operate-the-dms-inventory","Operate the DMS inventory",{"_2322":1044,"_22971":1033,"_5":23243,"_15675":39013,"_21706":39014,"_1911":39015},[],"/docs/pr-preview/pr-28/platform/pki/device-enrollment#integrate-the-devices","Integrate the devices",{"_2322":1045,"_22971":1033,"_15675":39017,"_5":15564,"_21706":1033,"_1911":39018},[],"A &#x2A;*Device Management Service (DMS)** acts as the registration authority facing a fleet. It receives requests, applies the authentication policy and delegates issuance to the configured CA.",{"_2322":1046,"_22971":1033,"_15675":39020,"_5":15564,"_21706":1033,"_1911":39021},[],"Each DMS is an independent operational boundary: it can represent a product line, an environment or a device type with its own CA, authentication rules, distributed trust and renewal window.",{"_2322":1047,"_22971":1033,"_15675":39023,"_5":15564,"_21706":38979,"_1911":39024},[],"Create or import at least one active CA.",{"_2322":1048,"_22971":1033,"_15675":39026,"_5":15564,"_21706":38979,"_1911":39027},[],"Decide how devices will authenticate during initial enrollment.",{"_2322":1049,"_22971":1033,"_15675":39029,"_5":15564,"_21706":38979,"_1911":39030},[],"Define which authorities the device should receive as anchors of trust.",{"_2322":1050,"_22971":1033,"_15675":39032,"_5":15564,"_21706":38979,"_1911":39033},[],"Make sure you have permissions to administer DMSs.",{"_2322":1051,"_22971":1033,"_15675":39035,"_5":15564,"_21706":38986,"_1911":39036},[],"Give the DMS a name that describes its scope, for example a device family or an environment.",{"_2322":1052,"_22971":1033,"_15675":39038,"_5":15564,"_21706":38990,"_1911":39039},[],"Choose the authority that will issue the identities. Its policy and validity period constrain the certificates the fleet can obtain.",{"_2322":1053,"_22971":1033,"_15675":39041,"_5":15564,"_21706":38994,"_1911":39042},[],"Define the authentication of `enroll`, the `reenroll` policy, the renewal window and, if needed, `serverkeygen`.",{"_2322":1054,"_22971":1033,"_15675":39044,"_5":15564,"_21706":38998,"_1911":39045},[],"Configure **CA Distribution** to control the response of the `cacerts` endpoint.",{"_2322":1055,"_22971":1033,"_15675":39047,"_5":15564,"_21706":39002,"_1911":39048},[],"From the DMS menu, open &#x2A;*EST (RFC-7030)** and check the base URL and the invocation examples before integrating the firmware.",{"_2322":1056,"_22971":1033,"_15675":39050,"_5":15564,"_21706":39006,"_1911":39051},[],"**Include Lamassu System CA** distributes the TLS certificate of the Lamassu server, useful for *pinning*. It does not represent an issuing CA.",{"_2322":1057,"_22971":1033,"_15675":39053,"_5":15564,"_21706":39006,"_1911":39054},[],"**Include Enrollment CA** adds the authority configured to issue the DMS's identities.",{"_2322":1058,"_22971":1033,"_15675":39056,"_5":15564,"_21706":39006,"_1911":39057},[],"**Managed CAs** lets you include additional authorities the device must consider trusted.",{"_2322":1059,"_22971":1033,"_15675":39059,"_5":15564,"_21706":39010,"_1911":39060},[],"**Edit** modifies the DMS policy.",{"_2322":1060,"_22971":1033,"_15675":39062,"_5":15564,"_21706":39010,"_1911":39063},[],"**Go to DMS owned devices** opens only the devices of that fleet.",{"_2322":1061,"_22971":1033,"_15675":39065,"_5":15564,"_21706":39010,"_1911":39066},[],"**Show/Edit Metadata** manages advanced configuration and integration data.",{"_2322":1062,"_22971":1033,"_15675":39068,"_5":15564,"_21706":39010,"_1911":39069},[],"**EST (RFC-7030)** shows the endpoints and examples specific to the DMS.",{"_2322":1063,"_22971":1033,"_15675":39071,"_5":15564,"_21706":39010,"_1911":39072},[],"**Delete** removes the DMS and its configuration. The action is irreversible.",{"_2322":1064,"_22971":1033,"_15675":39074,"_5":15564,"_21706":39014,"_1911":39075},[],"<Card title=\"EST enrollment\" description=\"Configure authentication, endpoints and flows for firmware.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2322":1065,"_22971":1033,"_15675":39077,"_5":15564,"_21706":39014,"_1911":39078},[],"<Card title=\"Devices and identities\" description=\"Review statuses, history and operational actions.\" href=\"/docs/platform/pki/device-management\" />",{"_2322":1066,"_22971":1066,"_5":10796,"_1911":39080,"_23246":39081,"_15675":39082,"_21706":1066},"Devices and identities",[35713,36848,37382],[],{"_2322":1067,"_22971":1066,"_15675":39084,"_5":15564,"_21706":1066,"_1911":39085},[],"Register devices and control their identities throughout the lifecycle.",{"_2322":1068,"_22971":1066,"_5":23243,"_15675":39087,"_21706":39088,"_1911":39089},[],"/docs/pr-preview/pr-28/platform/pki/device-management#device-states","Device states",{"_2322":1069,"_22971":1066,"_5":23243,"_15675":39091,"_21706":39092,"_1911":39093},[],"/docs/pr-preview/pr-28/platform/pki/device-management#inspect-a-device","Inspect a device",{"_2322":1070,"_22971":1066,"_5":23243,"_15675":39095,"_21706":39096,"_1911":39097},[],"/docs/pr-preview/pr-28/platform/pki/device-management#register-a-device-manually","Register a device manually",{"_2322":1071,"_22971":1066,"_5":23243,"_15675":39099,"_21706":39100,"_1911":39101},[],"/docs/pr-preview/pr-28/platform/pki/device-management#create-the-device","Create the device",{"_2322":1072,"_22971":1066,"_5":23243,"_15675":39103,"_21706":39104,"_1911":39105},[],"/docs/pr-preview/pr-28/platform/pki/device-management#define-its-membership","Define its membership",{"_2322":1073,"_22971":1066,"_5":23243,"_15675":39107,"_21706":39108,"_1911":39109},[],"/docs/pr-preview/pr-28/platform/pki/device-management#classify-the-device","Classify the device",{"_2322":1074,"_22971":1066,"_5":23243,"_15675":39111,"_21706":39112,"_1911":39113},[],"/docs/pr-preview/pr-28/platform/pki/device-management#verify-the-registration","Verify the registration",{"_2322":1075,"_22971":1066,"_5":23243,"_15675":39115,"_21706":39116,"_1911":39117},[],"/docs/pr-preview/pr-28/platform/pki/device-management#assign-an-identity-manually","Assign an identity manually",{"_2322":1076,"_22971":1066,"_5":23243,"_15675":39119,"_21706":39120,"_1911":39121},[],"/docs/pr-preview/pr-28/platform/pki/device-management#revoke-the-current-identity","Revoke the current identity",{"_2322":1077,"_22971":1066,"_5":23243,"_15675":39123,"_21706":39124,"_1911":39125},[],"/docs/pr-preview/pr-28/platform/pki/device-management#decommission-a-device","Decommission a device",{"_2322":1078,"_22971":1066,"_5":23243,"_15675":39127,"_21706":39128,"_1911":39129},[],"/docs/pr-preview/pr-28/platform/pki/device-management#automate-enrollment","Automate enrollment",{"_2322":1079,"_22971":1066,"_15675":39131,"_5":15564,"_21706":1066,"_1911":39132},[],"A managed device represents an entity in your fleet and keeps the history of the certificates it has used. Lamassu separates the device from its current identity so you can renew or replace certificates without losing traceability.",{"_2322":1080,"_22971":1066,"_15675":39134,"_5":15564,"_21706":39088,"_1911":39135},[],"**Active** indicates the device has a valid identity.",{"_2322":1081,"_22971":1066,"_15675":39137,"_5":15564,"_21706":39088,"_1911":39138},[],"**No Identity** appears when it is registered but does not yet have an associated certificate.",{"_2322":1082,"_22971":1066,"_15675":39140,"_5":15564,"_21706":39088,"_1911":39141},[],"**Renewal Pending** signals that it has entered the renewal window.",{"_2322":1083,"_22971":1066,"_15675":39143,"_5":15564,"_21706":39088,"_1911":39144},[],"**Expiring Soon** warns that the certificate is close to expiring.",{"_2322":1084,"_22971":1066,"_15675":39146,"_5":15564,"_21706":39088,"_1911":39147},[],"**Expired** indicates the identity has passed its validity date.",{"_2322":1085,"_22971":1066,"_15675":39149,"_5":15564,"_21706":39088,"_1911":39150},[],"**Revoked** identifies a certificate invalidated before its expiration.",{"_2322":1086,"_22971":1066,"_15675":39152,"_5":15564,"_21706":39088,"_1911":39153},[],"**Decommissioned** corresponds to a device permanently retired.",{"_2322":1087,"_22971":1066,"_15675":39155,"_5":15564,"_21706":39088,"_1911":39156},[],"The inventory lets you filter by `Device ID`, tags and status.",{"_2322":1088,"_22971":1066,"_15675":39158,"_5":15564,"_21706":39092,"_1911":39159},[],"The detail view separates two perspectives:",{"_2322":1089,"_22971":1066,"_15675":39161,"_5":15564,"_21706":39092,"_1911":39162},[],"**Certificate History** keeps every certificate associated with the device, with its serial number, issuer, status and validity period.",{"_2322":1090,"_22971":1066,"_15675":39164,"_5":15564,"_21706":39092,"_1911":39165},[],"**Device Event Timeline** orders registrations, enrollments, renewals and status changes chronologically.",{"_2322":1091,"_22971":1066,"_15675":39167,"_5":15564,"_21706":39092,"_1911":39168},[],"Use the history for audit and the timeline to reconstruct an incident or diagnose an unexpected transition.",{"_2322":1092,"_22971":1066,"_15675":39170,"_5":15564,"_21706":39096,"_1911":39171},[],"Pre-registration is useful when policy requires the device to exist before requesting its first certificate.",{"_2322":1093,"_22971":1066,"_15675":39173,"_5":15564,"_21706":39100,"_1911":39174},[],"From **Managed Devices**, open the registration form.",{"_2322":1094,"_22971":1066,"_15675":39176,"_5":15564,"_21706":39104,"_1911":39177},[],"Enter a unique **Device ID** and select the DMS that will apply the enrollment and renewal policies.",{"_2322":1095,"_22971":1066,"_15675":39179,"_5":15564,"_21706":39108,"_1911":39180},[],"Add an icon and tags if you need to group devices by model, location, environment or another operational criterion.",{"_2322":1096,"_22971":1066,"_15675":39182,"_5":15564,"_21706":39112,"_1911":39183},[],"The device should appear with status **No Identity** until it completes enrollment or receives a manually assigned identity.",{"_2322":1097,"_22971":1066,"_15675":39185,"_5":15564,"_21706":39116,"_1911":39186},[],"The **Assign Identity** action is available while the device remains in **No Identity**.",{"_2322":1098,"_22971":1066,"_15675":39188,"_5":15564,"_21706":39116,"_1911":39189},[],"Open the device and select **Assign Identity**.",{"_2322":1099,"_22971":1066,"_15675":39191,"_5":15564,"_21706":39116,"_1911":39192},[],"Choose an active certificate whose `Common Name` matches the `Device ID`.",{"_2322":1100,"_22971":1066,"_15675":39194,"_5":15564,"_21706":39116,"_1911":39195},[],"If none exists, select **Issue New Instead** and choose a CA linked to the DMS.",{"_2322":1101,"_22971":1066,"_15675":39197,"_5":15564,"_21706":39116,"_1911":39198},[],"Confirm the assignment.",{"_2322":1102,"_22971":1066,"_15675":39200,"_5":15564,"_21706":39116,"_1911":39201},[],"The device should change to **Active** and the certificate should appear in its history.",{"_2322":1103,"_22971":1066,"_15675":39203,"_5":15564,"_21706":39120,"_1911":39204},[],"In **Device Event Timeline**, locate the latest active certificate and select **Revoke**. Choose a reason consistent with your policy and confirm the operation.",{"_2322":1104,"_22971":1066,"_15675":39206,"_5":15564,"_21706":39120,"_1911":39207},[],"Revocation invalidates the certificate but does not delete the device. You can restore its operation by assigning it a new identity. `CertificateHold` allows reactivating the retained certificate; all other reasons are final.",{"_2322":1105,"_22971":1066,"_15675":39209,"_5":15564,"_21706":39124,"_1911":39210},[],"This action revokes all the device's certificates and prevents it from obtaining an identity again.",{"_2322":1106,"_22971":1066,"_15675":39212,"_5":15564,"_21706":39124,"_1911":39213},[],"Use **Decommission** only when the device has stopped operating or is no longer trustworthy. After confirming, Lamassu revokes the active identity with `CessationOfOperation` and changes the status to **Decommissioned**.",{"_2322":1107,"_22971":1066,"_15675":39215,"_5":15564,"_21706":39128,"_1911":39216},[],"<Card title=\"Configure a DMS\" description=\"Define the CA, trust and policies of the fleet.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2322":1108,"_22971":1066,"_15675":39218,"_5":15564,"_21706":39128,"_1911":39219},[],"<Card title=\"Integrate EST\" description=\"Let the device request and renew its identity.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2322":1109,"_22971":1109,"_5":10796,"_1911":39221,"_23246":39222,"_15675":39223,"_21706":1109},"Device enrollment with EST",[35713,36848,37382],[],{"_2322":1110,"_22971":1109,"_15675":39225,"_5":15564,"_21706":1109,"_1911":39226},[],"EST protocol guide for Lamassu IoT, with DMS configuration for the PKI administrator and the endpoint reference for device integrators.",{"_2322":1111,"_22971":1109,"_5":23243,"_15675":39228,"_21706":39229,"_1911":39230},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#est-enrollment-over-secure-transport","EST: Enrollment over Secure Transport",{"_2322":1112,"_22971":1109,"_5":23243,"_15675":39232,"_21706":39233,"_1911":39234},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#dms-configuration","DMS configuration",{"_2322":1113,"_22971":1109,"_5":23243,"_15675":39236,"_21706":39237,"_1911":39238},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#prerequisites","Prerequisites",{"_2322":1114,"_22971":1109,"_5":23243,"_15675":39240,"_21706":39241,"_1911":39242},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#enrollment-configuration","Enrollment configuration",{"_2322":1115,"_22971":1109,"_5":23243,"_15675":39244,"_21706":39245,"_1911":39246},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#enrollment-device-registration","Enrollment Device Registration",{"_2322":1116,"_22971":1109,"_5":23243,"_15675":39248,"_21706":39249,"_1911":39250},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#enrollment-settings","Enrollment Settings",{"_2322":1117,"_22971":1109,"_5":23243,"_15675":39252,"_21706":39253,"_1911":39254},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#issuance-profile","Issuance profile",{"_2322":1118,"_22971":1109,"_5":23243,"_15675":39256,"_21706":39257,"_1911":39258},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#re-enrollment-configuration","Re-enrollment configuration",{"_2322":1119,"_22971":1109,"_5":23243,"_15675":39260,"_21706":39261,"_1911":39262},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#serverkeygen-configuration","ServerKeyGen configuration",{"_2322":1120,"_22971":1109,"_5":23243,"_15675":39264,"_21706":39265,"_1911":39266},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#verify-the-configuration","Verify the configuration",{"_2322":1121,"_22971":1109,"_5":23243,"_15675":39268,"_21706":39269,"_1911":39270},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#device-integration","Device integration",{"_2322":1122,"_22971":1109,"_5":23243,"_15675":39272,"_21706":39273,"_1911":35723},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#before-you-begin",{"_2322":1123,"_22971":1109,"_5":23243,"_15675":39275,"_21706":39276,"_1911":39277},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#flow-overview","Flow overview",{"_2322":1124,"_22971":1109,"_5":23243,"_15675":39279,"_21706":39280,"_1911":39281},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#client-authentication-model","Client authentication model",{"_2322":1125,"_22971":1109,"_5":23243,"_15675":39283,"_21706":39284,"_1911":39285},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#endpoint-reference","Endpoint reference",{"_2322":1126,"_22971":1109,"_5":23243,"_15675":39287,"_21706":39288,"_1911":39289},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#cacerts","`/cacerts`",{"_2322":1127,"_22971":1109,"_5":23243,"_15675":39291,"_21706":39292,"_1911":39293},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#simpleenroll","`/simpleenroll`",{"_2322":1128,"_22971":1109,"_5":23243,"_15675":39295,"_21706":39296,"_1911":39297},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#simplereenroll","`/simplereenroll`",{"_2322":1129,"_22971":1109,"_5":23243,"_15675":39299,"_21706":39300,"_1911":39301},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#serverkeygen","`/serverkeygen`",{"_2322":1130,"_22971":1109,"_5":23243,"_15675":39303,"_21706":39304,"_1911":39305},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#full-flows","Full flows",{"_2322":1131,"_22971":1109,"_5":23243,"_15675":39307,"_21706":39308,"_1911":39309},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#end-to-end-example-enroll","End-to-end example: enroll",{"_2322":1132,"_22971":1109,"_5":23243,"_15675":39311,"_21706":39312,"_1911":39313},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#end-to-end-example-reenroll","End-to-end example: reenroll",{"_2322":1133,"_22971":1109,"_5":23243,"_15675":39315,"_21706":39316,"_1911":39317},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#next-steps-after-enrollment","Next steps after enrollment",{"_2322":1134,"_22971":1109,"_5":23243,"_15675":39319,"_21706":39320,"_1911":39321},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2322":1135,"_22971":1109,"_5":23243,"_15675":39323,"_21706":39324,"_1911":39325},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#error-codes-and-diagnostics","Error codes and diagnostics",{"_2322":1136,"_22971":1109,"_5":23243,"_15675":39327,"_21706":39328,"_1911":39329},[],"/docs/pr-preview/pr-28/platform/pki/est-enrollment#compatibility-notes","Compatibility notes",{"_2322":1137,"_22971":1109,"_15675":39331,"_5":15564,"_21706":39229,"_1911":39332},[],"Lamassu IoT implements the &#x2A;*EST (Enrollment over Secure Transport)** protocol described in RFC 7030 as its only certificate enrollment mechanism for devices. Each DMS exposes the EST endpoints, validates the device and applies its own authentication, registration and renewal policies. In doing so, it acts as the Registration Authority (RA) facing the client.",{"_2322":1138,"_22971":1109,"_15675":39334,"_5":15564,"_21706":39229,"_1911":39335},[],"The entity that issues and cryptographically signs the certificate is always the **CA associated with the DMS**, not the DMS. The DMS coordinates the process: it receives the CSR, authenticates the device and applies the issuance policy. This distinction matters for the PKI administrator when selecting the `EnrollmentCA` and for the integrator when interpreting the chain of trust received from `/cacerts`.",{"_2322":1139,"_22971":1109,"_15675":39337,"_5":15564,"_21706":39229,"_1911":39338},[],"This guide is split in two parts:",{"_2322":1140,"_22971":1109,"_15675":39340,"_5":15564,"_21706":39229,"_1911":39341},[],"DMS configuration, for the PKI administrator.",{"_2322":1141,"_22971":1109,"_15675":39343,"_5":15564,"_21706":39229,"_1911":39344},[],"Device integration, for anyone consuming the EST endpoints from firmware, scripts or provisioning services.",{"_2322":1142,"_22971":1109,"_15675":39346,"_5":15564,"_21706":39229,"_1911":39347},[],"If you only need a quick orientation, this is the recommended route:",{"_2322":1143,"_22971":1109,"_15675":39349,"_5":15564,"_21706":39229,"_1911":39350},[],"**PKI administrator:** start with DMS configuration and finish with Diagnostics and compatibility.",{"_2322":1144,"_22971":1109,"_15675":39352,"_5":15564,"_21706":39229,"_1911":39353},[],"**Device integrator:** start with Before you begin and continue with `/cacerts`, `/simpleenroll`, `/simplereenroll` or `/serverkeygen`, depending on the flow you will implement.",{"_2322":1145,"_22971":1109,"_15675":39355,"_5":15564,"_21706":39237,"_1911":39356},[],"Before configuring a DMS for EST, the following resources must exist on the platform:",{"_2322":1146,"_22971":1109,"_15675":39358,"_5":15564,"_21706":39237,"_1911":39359},[],"**An available CA**: the CA acting as `EnrollmentCA` must be created and active in Lamassu. If the authentication mode is `CLIENT_CERTIFICATE`, the validation CAs for the bootstrap certificate must also have been created.",{"_2322":1147,"_22971":1109,"_15675":39361,"_5":15564,"_21706":39237,"_1911":39362},[],"**A created DMS**: the DMS this configuration applies to must already exist. The EST configuration is applied over an existing DMS, it does not create one.",{"_2322":1148,"_22971":1109,"_15675":39364,"_5":15564,"_21706":39237,"_1911":39365},[],"It is worth separating four configuration blocks:",{"_2322":1149,"_22971":1109,"_15675":39367,"_5":15564,"_21706":39237,"_1911":39368},[],"How the initial enrollment will be performed, including the registration mode and client authentication.",{"_2322":1150,"_22971":1109,"_15675":39370,"_5":15564,"_21706":39237,"_1911":39371},[],"How the re-enrollment of already-issued certificates will be handled.",{"_2322":1151,"_22971":1109,"_15675":39373,"_5":15564,"_21706":39237,"_1911":39374},[],"How the cacerts endpoint will be configured to distribute the CAs devices use as trust anchors.",{"_2322":1152,"_22971":1109,"_15675":39376,"_5":15564,"_21706":39237,"_1911":39377},[],"Whether server-side key generation through `ServerKeyGen` will be enabled.",{"_2322":1153,"_22971":1109,"_15675":39379,"_5":15564,"_21706":39245,"_1911":39380},[],"This section defines how new devices are registered and with which credentials they authenticate.",{"_2322":1154,"_22971":1109,"_15675":39382,"_5":15564,"_21706":39245,"_1911":39383},[],"**Registration Mode**: determines the behavior when receiving an initial enrollment. In `JITP` (*Just-In-Time Provisioning*) mode, the device is created automatically the first time it presents itself, applying the tags, metadata and icon defined in the provisioning profile. In `PRE_REGISTRATION` mode, the device must already exist on the platform; if it does not, the request is rejected with `device not preregistered`. JITP mode suits large fleets where the inventory is built during deployment; `PRE_REGISTRATION` fits high-security environments where each device is explicitly approved before receiving a certificate.",{"_2322":1155,"_22971":1109,"_15675":39385,"_5":15564,"_21706":39245,"_1911":39386},[],"**Tags**: applied to each device automatically created by this DMS. They are optional and only take effect in JITP mode. Tags improve device search.",{"_2322":1156,"_22971":1109,"_15675":39388,"_5":15564,"_21706":39245,"_1911":39389},[],"**Icon**: applied to each device automatically created by this DMS. It is optional and only takes effect in JITP mode. Purely visual.",{"_2322":1157,"_22971":1109,"_15675":39391,"_5":15564,"_21706":39249,"_1911":39392},[],"**Enrollment CA**: identifies the CA that will sign the identity certificates issued through this DMS. Its choice determines the chain of trust the device will receive and the root against which backend systems will validate fleet certificates.",{"_2322":1158,"_22971":1109,"_15675":39394,"_5":15564,"_21706":39249,"_1911":39395},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): allows an already-enrolled device to enroll again through `/simpleenroll`. When active, the previous certificate is revoked with the reason `superseded` and the identity slot is updated. When inactive, a second `simpleenroll` attempt is rejected with `forbiddenNewEnrollment`. This option must be enabled with care in production environments, since it lets you replace a device's identity without going through the re-enrollment flow.",{"_2322":1159,"_22971":1109,"_15675":39397,"_5":15564,"_21706":39249,"_1911":39398},[],"**Verify CSR Signature** (`verify_csr_signature`): controls whether the server validates the CSR signature against the public key declared in it (PKCS#10 proof of possession). When inactive, a requester could submit a CSR with a public key it does not control and obtain a certificate bound to it. For IoT fleets on open networks it must be enabled.",{"_2322":1160,"_22971":1109,"_15675":39400,"_5":15564,"_21706":39249,"_1911":39401},[],"**Authentication Mode**: defines how the DMS validates the device identity during enrollment. It can require an mTLS certificate (`CLIENT_CERTIFICATE`), delegate authorization to a webhook (`EXTERNAL_WEBHOOK`), combine both controls (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) or accept unauthenticated requests (`NO_AUTH`). The latter must be limited to isolated labs or provisioning networks.",{"_2322":1161,"_22971":1109,"_15675":39403,"_5":15564,"_21706":39249,"_1911":39404},[],"When the mode is `CLIENT_CERTIFICATE` or `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, these parameters are also configured:",{"_2322":1162,"_22971":1109,"_15675":39406,"_5":15564,"_21706":39249,"_1911":39407},[],"**Validation CAs**: list of trusted CAs to validate the bootstrap certificate presented by the device.",{"_2322":1163,"_22971":1109,"_15675":39409,"_5":15564,"_21706":39249,"_1911":39410},[],"**Chain Validation Level**: maximum depth of the validation chain. The value `-1` validates the full chain up to the root CA.",{"_2322":1164,"_22971":1109,"_15675":39412,"_5":15564,"_21706":39249,"_1911":39413},[],"**Allow Authenticating Expired Certificates**: if active, accepts expired client certificates. Useful in recovery scenarios where the device could not renew its certificate in time.",{"_2322":1165,"_22971":1109,"_15675":39415,"_5":15564,"_21706":39249,"_1911":39416},[],"When the mode includes `EXTERNAL_WEBHOOK`, these parameters are also configured:",{"_2322":1166,"_22971":1109,"_15675":39418,"_5":15564,"_21706":39249,"_1911":39419},[],"**Webhook URL**: address of the external service that will decide authorization.",{"_2322":1167,"_22971":1109,"_15675":39421,"_5":15564,"_21706":39249,"_1911":39422},[],"**HTTP Method**: HTTP method used to invoke the webhook. Supports `POST` (default) or `PUT`; both are equivalent for the webhook, only the verb Lamassu uses changes.",{"_2322":1168,"_22971":1109,"_15675":39424,"_5":15564,"_21706":39249,"_1911":39425},[],"**Timeout**: maximum wait time for the webhook call. If not specified, the default is **10 seconds**; after that without a response, Lamassu denies the operation.",{"_2322":1169,"_22971":1109,"_15675":39427,"_5":15564,"_21706":39249,"_1911":39428},[],"**Webhook Authentication Mode**: authentication mode of the webhook toward the external service, for example `ApiKey`, `OIDC` or `mTLS`.",{"_2322":1170,"_22971":1109,"_15675":39430,"_5":15564,"_21706":39249,"_1911":39431},[],"The exact contract the webhook service must implement (request and response schema, examples) is published as an OpenAPI specification: authorization webhook reference.",{"_2322":1171,"_22971":1109,"_15675":39433,"_5":15564,"_21706":39253,"_1911":39434},[],"The behavior of the issued certificate is not determined solely by the device's CSR, but by the **issuance profile** (`IssuanceProfile`) associated with the DMS. The integrator does not configure this profile, but its rules affect the content of the final certificate:",{"_2322":1172,"_22971":1109,"_15675":39436,"_5":15564,"_21706":39253,"_1911":39437},[],"**`HonorSubject`** controls whether the CSR's subject is copied verbatim into the certificate. If disabled, the CA applies the profile's template and ignores the received subject.",{"_2322":1173,"_22971":1109,"_15675":39439,"_5":15564,"_21706":39253,"_1911":39440},[],"**`HonorKeyUsage`** decides whether the CSR's `KeyUsage` is respected or replaced by the one defined in the template.",{"_2322":1174,"_22971":1109,"_15675":39442,"_5":15564,"_21706":39253,"_1911":39443},[],"**`HonorExtendedKeyUsages`** applies the same rule to `ExtKeyUsage`.",{"_2322":1175,"_22971":1109,"_15675":39445,"_5":15564,"_21706":39253,"_1911":39446},[],"**`HonorExtensions`** controls whether the rest of the CSR's extensions, such as SAN or CDP, are included in the certificate.",{"_2322":1176,"_22971":1109,"_15675":39448,"_5":15564,"_21706":39253,"_1911":39449},[],"This matters for the integrator: the `KeyUsage`, `ExtKeyUsage` and SANs declared in the CSR may not appear as-is in the final certificate if the profile decides otherwise. Check with the PKI administrator if the issued certificate does not contain the expected extensions.",{"_2322":1177,"_22971":1109,"_15675":39451,"_5":15564,"_21706":39257,"_1911":39452},[],"The **Re-Enrollment Settings** section controls the certificate renewal process. Re-enrollment can only be performed while the certificate is within the configured window, and optionally also when the certificate has already expired.",{"_2322":1178,"_22971":1109,"_15675":39454,"_5":15564,"_21706":39257,"_1911":39455},[],"**Revoke On Re-Enroll**: if active, the previous certificate is automatically revoked with the reason `superseded` once the new one is issued.",{"_2322":1179,"_22971":1109,"_15675":39457,"_5":15564,"_21706":39257,"_1911":39458},[],"**Allow Expired Renewal**: allows renewing an already-expired certificate. Useful when a device has been offline and could not renew within the window.",{"_2322":1180,"_22971":1109,"_15675":39460,"_5":15564,"_21706":39257,"_1911":39461},[],"**Allowed Renewal Delta**: time window before expiration during which re-enrollment is allowed. Before this window opens, the request is rejected with `invalid reenroll window`.",{"_2322":1181,"_22971":1109,"_15675":39463,"_5":15564,"_21706":39257,"_1911":39464},[],"**Preventive Renewal Delta**: time before expiration from which preventive renewal alerts are raised.",{"_2322":1182,"_22971":1109,"_15675":39466,"_5":15564,"_21706":39257,"_1911":39467},[],"**Critical Renewal Delta**: threshold closest to expiration that triggers critical status alerts.",{"_2322":1183,"_22971":1109,"_15675":39469,"_5":15564,"_21706":39257,"_1911":39470},[],"**Additional Validation CAs**: additional CAs accepted as issuers of the active certificate during re-enrollment. It allows migrating to a new enrollment CA without interrupting the renewal of devices already enrolled with the previous CA.",{"_2322":1184,"_22971":1109,"_15675":39472,"_5":15564,"_21706":39261,"_1911":39473},[],"The **Server Key Generation** section lets Lamassu generate the device's key pair on the server and return it together with the issued certificate. It is useful for devices with limited cryptographic capability.",{"_2322":1185,"_22971":1109,"_15675":39475,"_5":15564,"_21706":39261,"_1911":39476},[],"The **Enable Server-Side Key Generation** option activates the `/serverkeygen` endpoint. When inactive, any call to that endpoint is rejected with `server key generation not enabled`.",{"_2322":1186,"_22971":1109,"_15675":39478,"_5":15564,"_21706":39261,"_1911":39479},[],"**Key Type** selects the algorithm: `RSA` or `ECDSA`. The &#x2A;*Key Size (bits)** field determines the key size. For ECDSA, the size in bits also determines the curve: 256 corresponds to P-256, 384 to P-384 and 521 to P-521.",{"_2322":1187,"_22971":1109,"_15675":39481,"_5":15564,"_21706":39261,"_1911":39482},[],"The key is generated in the server's software engine, not in a hardware Crypto Engine such as AWS KMS or PKCS#11. The only protection of the key in transit is the TLS channel; no additional encryption (CMS EnvelopedData) is applied to the key before sending it to the device. See the `/serverkeygen` section of the integrator reference for the exact response format and security considerations.",{"_2322":1188,"_22971":1109,"_15675":39484,"_5":15564,"_21706":39265,"_1911":39485},[],"Once the enrollment, re-enrollment and ServerKeyGen settings are applied, you can confirm the DMS is operational as follows:",{"_2322":1189,"_22971":1109,"_15675":39487,"_5":15564,"_21706":39265,"_1911":39488},[],"**From the console**: open the DMS detail and check that the EST section shows the assigned enrollment CA and the configured authentication mode.",{"_2322":1190,"_22971":1109,"_15675":39490,"_5":15564,"_21706":39265,"_1911":39491},[],"**With a test request**: invoke the DMS's `/cacerts` endpoint from a `curl` client with server trust. A `200 OK` response with base64 content confirms the DMS is active and the enrollment CA is reachable.",{"_2322":1191,"_22971":1109,"_15675":39493,"_5":15564,"_21706":39265,"_1911":39494},[],"If the DMS does not exist or the CA is not available, the server responds with `DMS not found` or another error message. See the Diagnostics and compatibility section to interpret error messages.",{"_2322":1192,"_22971":1109,"_15675":39496,"_5":15564,"_21706":39269,"_1911":39497},[],"*This section is aimed at device integrators.*",{"_2322":1193,"_22971":1109,"_15675":39499,"_5":15564,"_21706":39269,"_1911":39500},[],"Lamassu's EST endpoints are published under the `/.well-known/est` prefix and always require the presence of the `{aps}` path segment, interpreted as the identifier of the DMS the operation targets. The association is direct: the `{aps}` value received in the URL is used as the DMS ID when querying the internal store. Variants registered without `{aps}` (for example `/.well-known/est/cacerts`) are routed in the code, but their handler requires the `APS` field and returns `400 Bad Request` with the message `Field validation for 'APS' failed` when the segment is not provided.",{"_2322":1194,"_22971":1109,"_15675":39502,"_5":15564,"_21706":39269,"_1911":39503},[],"This part follows the integrator's usual working order: first the prerequisites and the authentication model, then the reference for each endpoint and, finally, complete examples and diagnostic material.",{"_2322":1195,"_22971":1109,"_15675":39505,"_5":15564,"_21706":39273,"_1911":39506},[],"The PKI administrator must have configured a DMS with the `EST_RFC7030` protocol, an assigned enrollment CA and at least one authentication mode. Without that prior configuration, Lamassu rejects any enrollment request. The details of that configuration are in the DMS configuration section of this same page.",{"_2322":1196,"_22971":1109,"_15675":39508,"_5":15564,"_21706":39273,"_1911":39509},[],"Before making the first call, make sure you have:",{"_2322":1197,"_22971":1109,"_15675":39511,"_5":15564,"_21706":39273,"_1911":39512},[],"**The EST host URL**, for example `https://est.lamassu.example`, provided by the PKI administrator.",{"_2322":1198,"_22971":1109,"_15675":39514,"_5":15564,"_21706":39273,"_1911":39515},[],"**The server trust anchor** (`lamassu-trust.pem`), root or intermediate, with which the client will validate Lamassu's TLS.",{"_2322":1199,"_22971":1109,"_15675":39517,"_5":15564,"_21706":39273,"_1911":39518},[],"**The bootstrap certificate and its private key** if the DMS uses `CLIENT_CERTIFICATE` or `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. This identity must come from one of the configured `ValidationCAs`, usually a provisioning CA different from the enrollment CA.",{"_2322":1200,"_22971":1109,"_15675":39520,"_5":15564,"_21706":39273,"_1911":39521},[],"**The DMS ID** (`{aps}`), which must appear in every EST route.",{"_2322":1201,"_22971":1109,"_15675":39523,"_5":15564,"_21706":39276,"_1911":39524},[],"**Download trust with `/cacerts`:** the client validates the server's TLS and receives the certificates in PKCS#7 or PEM.",{"_2322":1202,"_22971":1109,"_15675":39526,"_5":15564,"_21706":39276,"_1911":39527},[],"**Perform initial enrollment with `/simpleenroll`:** present the bootstrap certificate or the credential defined by `AuthMode` to obtain the device certificate.",{"_2322":1203,"_22971":1109,"_15675":39529,"_5":15564,"_21706":39276,"_1911":39530},[],"**Renew with `/simplereenroll`:** authenticate with the device's current certificate to obtain a new one.",{"_2322":1204,"_22971":1109,"_15675":39532,"_5":15564,"_21706":39276,"_1911":39533},[],"**Use `/serverkeygen` only if you need server-side key generation:** it applies the same authentication as `/simpleenroll` and returns the PKCS#8 private key together with the certificate.",{"_2322":1205,"_22971":1109,"_15675":39535,"_5":15564,"_21706":39280,"_1911":39536},[],"Lamassu's implementation recognizes four authentication configurations for `/simpleenroll`, expressed through the DMS's `EnrollmentOptionsESTRFC7030.AuthMode` field. Three are simple modes (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) and one combines two controls (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). The client must present itself in the mode the DMS expects; any other combination fails the enrollment.",{"_2322":1206,"_22971":1109,"_15675":39538,"_5":15564,"_21706":39280,"_1911":39539},[],"Mode (`AuthMode`)",{"_2322":1207,"_22971":1109,"_15675":39541,"_5":15564,"_21706":39280,"_1911":38934},[],{"_2322":1208,"_22971":1109,"_15675":39543,"_5":15564,"_21706":39280,"_1911":39544},[],"Expected credential",{"_2322":1209,"_22971":1109,"_15675":39546,"_5":15564,"_21706":39280,"_1911":39547},[],"Applies in enroll",{"_2322":1210,"_22971":1109,"_15675":39549,"_5":15564,"_21706":39280,"_1911":39550},[],"Applies in reenroll",{"_2322":1211,"_22971":1109,"_15675":39552,"_5":15564,"_21706":39280,"_1911":39553},[],"`CLIENT_CERTIFICATE`",{"_2322":1212,"_22971":1109,"_15675":39555,"_5":15564,"_21706":39280,"_1911":39556},[],"mTLS with X.509 certificate",{"_2322":1213,"_22971":1109,"_15675":39558,"_5":15564,"_21706":39280,"_1911":39559},[],"Client certificate and private key",{"_2322":1214,"_22971":1109,"_15675":39561,"_5":15564,"_21706":39280,"_1911":39562},[],"Yes",{"_2322":1215,"_22971":1109,"_15675":39564,"_5":15564,"_21706":39280,"_1911":39565},[],"Yes (with the active certificate)",{"_2322":1216,"_22971":1109,"_15675":39567,"_5":15564,"_21706":39280,"_1911":39568},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2322":1217,"_22971":1109,"_15675":39570,"_5":15564,"_21706":39280,"_1911":39571},[],"mTLS plus webhook validation",{"_2322":1218,"_22971":1109,"_15675":39573,"_5":15564,"_21706":39280,"_1911":39574},[],"Client certificate and private key, plus webhook approval",{"_2322":1219,"_22971":1109,"_15675":39576,"_5":15564,"_21706":39280,"_1911":39562},[],{"_2322":1220,"_22971":1109,"_15675":39578,"_5":15564,"_21706":39280,"_1911":39579},[],"Not as a combination; in reenroll both controls are not kept",{"_2322":1221,"_22971":1109,"_15675":39581,"_5":15564,"_21706":39280,"_1911":39582},[],"`EXTERNAL_WEBHOOK`",{"_2322":1222,"_22971":1109,"_15675":39584,"_5":15564,"_21706":39280,"_1911":39585},[],"External authorization webhook",{"_2322":1223,"_22971":1109,"_15675":39587,"_5":15564,"_21706":39280,"_1911":39588},[],"None on the TLS channel",{"_2322":1224,"_22971":1109,"_15675":39590,"_5":15564,"_21706":39280,"_1911":39562},[],{"_2322":1225,"_22971":1109,"_15675":39592,"_5":15564,"_21706":39280,"_1911":39593},[],"No, degrades to `NO_AUTH`",{"_2322":1226,"_22971":1109,"_15675":39595,"_5":15564,"_21706":39280,"_1911":39596},[],"`NO_AUTH`",{"_2322":1227,"_22971":1109,"_15675":39598,"_5":15564,"_21706":39280,"_1911":39599},[],"No authentication",{"_2322":1228,"_22971":1109,"_15675":39601,"_5":15564,"_21706":39280,"_1911":39602},[],"None",{"_2322":1229,"_22971":1109,"_15675":39604,"_5":15564,"_21706":39280,"_1911":39605},[],"Yes (restricted use)",{"_2322":1230,"_22971":1109,"_15675":39607,"_5":15564,"_21706":39280,"_1911":39605},[],{"_2322":1231,"_22971":1109,"_15675":39609,"_5":15564,"_21706":39280,"_1911":39610},[],"JWT **is not a valid authentication mode in EST**. The JWT identity extractor exists in the code but is only evaluated in Lamassu's administration API. Any *Bearer token* sent to `/.well-known/est/...` is silently ignored. When the DMS is configured with `AuthMode: CLIENT_CERTIFICATE`, a request carrying only a JWT is rejected for lack of a client certificate. When the DMS is in `AuthMode: NO_AUTH`, the request is processed as such and the JWT neither adds nor removes authorization.",{"_2322":1232,"_22971":1109,"_15675":39612,"_5":15564,"_21706":39280,"_1911":39613},[],"**`CLIENT_CERTIFICATE`**: the client presents an X.509 certificate issued by one of the CAs declared in `AuthOptionsMTLS.ValidationCAs`. The process validates the certificate chain against those CAs through the `ValidationCAs`, `AllowExpired` and `ChainLevelValidation` parameters. In addition, the service checks the revocation status in three steps: first it looks up the cert in Lamassu's local database; if not found, it queries the OCSP responders listed in the AIA extension; if OCSP fails, it tries the CRL Distribution Points (CDP). A revoked certificate interrupts the enrollment with `certificate is revoked`.",{"_2322":1233,"_22971":1109,"_15675":39615,"_5":15564,"_21706":39280,"_1911":39616},[],"Its main parameters are `ValidationCAs`, the list of CAs that can validate the bootstrap certificate or the active certificate; `AllowExpired`, which allows accepting expired client certificates; and `ChainLevelValidation`, which limits the chain depth when its value is greater than zero.",{"_2322":1234,"_22971":1109,"_15675":39618,"_5":15564,"_21706":39280,"_1911":39619},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delegates the authorization decision to an external HTTP service. The EST server builds a `POST` request to the configured webhook with a JSON body reproducing the enrollment context.",{"_2322":1235,"_22971":1109,"_15675":39621,"_5":15564,"_21706":39280,"_1911":39622},[],"The value of the `csr` field is the **base64 encoding of the CSR's PEM** (not the DER, and not the plain PEM). The webhook must respond with `2xx` and a JSON body `{\"authorized\": true}` to continue; any other response aborts the enrollment with `external webhook denied enrollment`. A `204 No Content` **is not a valid response** even though it is a `2xx` code: Lamassu requires a JSON body with the `authorized` field, so a webhook responding without a body denies the operation just like an error.",{"_2322":1236,"_22971":1109,"_15675":39624,"_5":15564,"_21706":39280,"_1911":39625},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combines the two previous modes during `/simpleenroll`. The client must present a valid mTLS certificate and the webhook must return `authorized: true`. In `/simplereenroll` the combination is not preserved: the joint mTLS + webhook check is not maintained, so the integrator must not assume the same guarantees of the initial enrollment apply in reenroll.",{"_2322":1237,"_22971":1109,"_15675":39627,"_5":15564,"_21706":39280,"_1911":39628},[],"**`NO_AUTH`**: the DMS accepts any CSR without validating the client's identity. Lamassu logs a warning (`DMS is configured with NoAuth, allowing enrollment`) and proceeds with the registration. It must be restricted to controlled environments (an isolated provisioning network); any network exposed to the internet with a DMS in `NO_AUTH` is open to certificate issuance by unauthorized third parties.",{"_2322":1238,"_22971":1109,"_15675":39630,"_5":15564,"_21706":39284,"_1911":39631},[],"The following sections describe the endpoints in the usual order of use within the device lifecycle:",{"_2322":1239,"_22971":1109,"_15675":39633,"_5":15564,"_21706":39284,"_1911":39634},[],"`/cacerts`: download of the trust chain.",{"_2322":1240,"_22971":1109,"_15675":39636,"_5":15564,"_21706":39284,"_1911":39637},[],"`/simpleenroll`: initial certificate enrollment.",{"_2322":1241,"_22971":1109,"_15675":39639,"_5":15564,"_21706":39284,"_1911":39640},[],"`/simplereenroll`: renewal of an already-issued certificate.",{"_2322":1242,"_22971":1109,"_15675":39642,"_5":15564,"_21706":39284,"_1911":39643},[],"`/serverkeygen`: enrollment with server-side key generation.",{"_2322":1243,"_22971":1109,"_15675":39645,"_5":15564,"_21706":39288,"_1911":39646},[],"The endpoint `GET /.well-known/est/{aps}/cacerts` distributes the certificates the device needs to validate the EST server and the rest of the CAs managed by the DMS. Lamassu inserts the certificates in this order: first the **downstream** certificate of the Lamassu server, which is the server's TLS leaf and not a CA, useful for pinning if `IncludeLamassuSystemCA` is enabled; then the `ManagedCAs` list declared in the DMS; and last the enrollment CA, if `IncludeEnrollmentCA` is enabled.",{"_2322":1244,"_22971":1109,"_15675":39648,"_5":15564,"_21706":39288,"_1911":39649},[],"`CADistributionSettings` lets you decide what is published:",{"_2322":1245,"_22971":1109,"_15675":39651,"_5":15564,"_21706":39288,"_1911":39652},[],"**`IncludeLamassuSystemCA`** adds the *downstream* certificate of the Lamassu server. It is the TLS leaf the client can use to pin the connection, not a CA.",{"_2322":1246,"_22971":1109,"_15675":39654,"_5":15564,"_21706":39288,"_1911":39655},[],"**`IncludeEnrollmentCA`** adds the DMS's issuing CA, responsible for signing device certificates.",{"_2322":1247,"_22971":1109,"_15675":39657,"_5":15564,"_21706":39288,"_1911":39658},[],"**`ManagedCAs`** publishes additional CAs as trust anchors.",{"_2322":1248,"_22971":1109,"_15675":39660,"_5":15564,"_21706":39288,"_1911":39661},[],"The default format is *degenerate* PKCS#7 (certificates only) base64-encoded. The response declares `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The base64 is wrapped in lines of **76 characters** terminated with CRLF, a width compliant with S/MIME (RFC 5751), not the 64 that some RFC 7030 guides suggest. This wrapping applies only to `/cacerts` and `/simpleenroll`; the internal parts of `/serverkeygen` carry no wrap, as explained below.",{"_2322":1249,"_22971":1109,"_15675":39663,"_5":15564,"_21706":39288,"_1911":39664},[],"*Degenerate* PKCS#7 is a **set** of certificates with no defined semantic order. Although Lamassu inserts them in the order stated, the integrator must not assume that order when validating chains: the chain must be built by `Subject`/`Issuer` matching (or by AKI/SKI), not by position in the response.",{"_2322":1250,"_22971":1109,"_15675":39666,"_5":15564,"_21706":39288,"_1911":39667},[],"The `-i` flag (ignore garbage) helps tolerate the CRLF Lamassu adds and is necessary on some `base64` implementations (BusyBox, BSD); on GNU coreutils it is ignored.",{"_2322":1251,"_22971":1109,"_15675":39669,"_5":15564,"_21706":39288,"_1911":39670},[],"Lamassu additionally adds an extension over the RFC: if the client sends the `Accept: application/x-pem-file` header, the server responds with the PEM concatenation of the same certificates, without the PKCS#7 wrapper. This makes consumption from scripts easier. The extension also works on `/simpleenroll` and `/simplereenroll`.",{"_2322":1252,"_22971":1109,"_15675":39672,"_5":15564,"_21706":39292,"_1911":39673},[],"The endpoint `POST /.well-known/est/{aps}/simpleenroll` receives a CSR and returns the issued certificate. The request body must be the **PKCS#10 (CSR) in DER, base64-encoded** without line breaks. The base64 wraps the DER directly, not a PEM. The `Content-Type` header must be `application/pkcs10`. If the `Content-Type` is different, the server responds `400` with `content-type must be application/pkcs10`; if the body is not valid base64, it responds `400` with `body payload must be base64 encoded`.",{"_2322":1253,"_22971":1109,"_15675":39675,"_5":15564,"_21706":39292,"_1911":39676},[],"The response follows the same wrapper as `/cacerts`: *degenerate* PKCS#7 in base64, with `Content-Type: application/pkcs7-mime; smime-type=certs-only`. The PKCS#7 contains **only the newly issued leaf certificate**; it does not include the issuing CA or intermediates. This complies with RFC 7030 §4.2.3 (where the chain is optional) but implies the integrator must combine this certificate with the chain obtained from `/cacerts` before presenting it to any relying party that validates the full chain (for example, an MQTT broker with strict mTLS).",{"_2322":1254,"_22971":1109,"_15675":39678,"_5":15564,"_21706":39292,"_1911":39679},[],"Several DMS fields govern the behavior of `/simpleenroll`. The integrator does not configure them, but it helps to know them to interpret rejections:",{"_2322":1255,"_22971":1109,"_15675":39681,"_5":15564,"_21706":39292,"_1911":39682},[],"**`EnrollmentSettings.RegistrationMode`** decides whether the device is created during the first enrollment (`JITP`) or must exist beforehand (`PRE_REGISTRATION`).",{"_2322":1256,"_22971":1109,"_15675":39684,"_5":15564,"_21706":39292,"_1911":39685},[],"**`EnrollmentSettings.EnableReplaceableEnrollment`** allows repeating `/simpleenroll` for an already-enrolled device. When doing so, it revokes the previous certificate as `superseded`; if disabled, the server responds with `forbiddenNewEnrollment`.",{"_2322":1257,"_22971":1109,"_15675":39687,"_5":15564,"_21706":39292,"_1911":39688},[],"**`EnrollmentSettings.VerifyCSRSignature`** validates that whoever submits the CSR controls the declared private key. For IoT fleets on open networks it must be enabled.",{"_2322":1258,"_22971":1109,"_15675":39690,"_5":15564,"_21706":39292,"_1911":39691},[],"In `JITP` mode, the first `simpleenroll` with a `CommonName` that does not yet exist in Lamassu creates the device automatically. In `PRE_REGISTRATION` mode, the device must exist beforehand; an unknown `CommonName` is rejected with `device not preregistered`. See Enrollment configuration for more details on both modes and the behavior of the issuance profile.",{"_2322":1259,"_22971":1109,"_15675":39693,"_5":15564,"_21706":39296,"_1911":39694},[],"The endpoint `POST /.well-known/est/{aps}/simplereenroll` renews the certificate of an already-enrolled device. The body format is identical to `/simpleenroll` (DER base64 without line breaks, `Content-Type: application/pkcs10`). The difference lies in authentication: the client must present **the device's active certificate** (not the bootstrap) as the mTLS credential.",{"_2322":1260,"_22971":1109,"_15675":39696,"_5":15564,"_21706":39296,"_1911":39697},[],"If the DMS is configured with `AuthMode: EXTERNAL_WEBHOOK`, the webhook is **not invoked** during `/simplereenroll`. The renewal flow silently degrades to `NO_AUTH`: any client that knows a valid `CommonName` can request reenroll for that device without authentication (`allowing reenroll: using NO AUTH mode` in the log). A DMS with `EXTERNAL_WEBHOOK` must not be used in production for reenroll flows unless access to the endpoint is network-controlled.",{"_2322":1261,"_22971":1109,"_15675":39699,"_5":15564,"_21706":39296,"_1911":39700},[],"The behavior of reenroll is governed by several `ReEnrollmentSettings` fields:",{"_2322":1262,"_22971":1109,"_15675":39702,"_5":15564,"_21706":39296,"_1911":39703},[],"**`ReEnrollmentDelta`** opens the renewal window at `NotAfter - ReEnrollmentDelta`. Before that instant, the server responds with `invalid reenroll window`.",{"_2322":1263,"_22971":1109,"_15675":39705,"_5":15564,"_21706":39296,"_1911":39706},[],"**`EnableExpiredRenewal`** allows using an already-expired certificate as proof of identity; if disabled, the server responds with `expired certificate`.",{"_2322":1264,"_22971":1109,"_15675":39708,"_5":15564,"_21706":39296,"_1911":39709},[],"**`RevokeOnReEnrollment`** revokes the previous certificate as `superseded` after issuing the new one.",{"_2322":1265,"_22971":1109,"_15675":39711,"_5":15564,"_21706":39296,"_1911":39712},[],"**`AdditionalValidationCAs`** adds valid issuers for the current certificate, in addition to the DMS's enrollment CA.",{"_2322":1266,"_22971":1109,"_15675":39714,"_5":15564,"_21706":39296,"_1911":39715},[],"**Subject immutability**: the renewal CSR must have exactly the same subject as the active certificate. Lamassu compares, byte by byte, the `RawSubject` of the CSR with the certificate's (`slices.Compare`). If the bytes differ, the server falls back to a semantic comparison over the `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` and `Country` attributes. If all those attributes match, the reenroll continues despite the byte difference (rescuing cases where only the encoding changes, `PrintableString` versus `UTF8String`). If any attribute differs, the reenroll aborts with `invalid RawSubject bytes`. The integrator must regenerate the CSR with exactly the same subject as in the initial enrollment to avoid depending on fallback behavior.",{"_2322":1267,"_22971":1109,"_15675":39717,"_5":15564,"_21706":39296,"_1911":39718},[],"**Validation of the presented certificate's chain**: validation is first attempted against the DMS's enrollment CA; if it fails, it walks the `AdditionalValidationCAs`. Validation is \"shallow\": each CA is tested as an anchor, no multi-level chain is composed. The client must present the complete chain in the mTLS handshake. A revoked certificate aborts the reenroll with `certificate is revoked`.",{"_2322":1268,"_22971":1109,"_15675":39720,"_5":15564,"_21706":39300,"_1911":39721},[],"The endpoint `POST /.well-known/est/{aps}/serverkeygen` lets Lamassu generate the device's key pair on the server and return, in the same response, the private key and the issued certificate. It is useful for devices with limited cryptographic capability or flows where the key is provisioned during manufacturing.",{"_2322":1269,"_22971":1109,"_15675":39723,"_5":15564,"_21706":39300,"_1911":39724},[],"This endpoint requires `ServerKeyGen.Enabled` to be `true` in the DMS. If it is not enabled, the server responds with `server key generation not enabled`. Authentication applies the same way as in `/simpleenroll`: the integrator presents the credential matching the DMS's `AuthMode`.",{"_2322":1270,"_22971":1109,"_15675":39726,"_5":15564,"_21706":39300,"_1911":39727},[],"The algorithm and size of the generated key are decided by the DMS, not by the client.",{"_2322":1271,"_22971":1109,"_15675":39729,"_5":15564,"_21706":39300,"_1911":39730},[],"**RSA** supports any size accepted by `crypto/rsa`; common values are 2048, 3072 and 4096 bits. An invalid value fails generation with a `500` error.",{"_2322":1272,"_22971":1109,"_15675":39732,"_5":15564,"_21706":39300,"_1911":39733},[],"**ECDSA** supports 224, 256, 384 and 521 bits, equivalent to P-224, P-256 (`prime256v1`), P-384 and P-521. Any other value **silently** degrades to P-256 and only leaves a warning in the log: the client receives no error and may obtain a curve different from the expected one.",{"_2322":1273,"_22971":1109,"_15675":39735,"_5":15564,"_21706":39300,"_1911":39736},[],"The CSR sent by the client serves only to carry the subject and extensions; the PKCS#10 proof of possession does not apply here because the client is not the one who generated the key. Lamassu discards the original CSR's public key, generates a new key pair with its internal entropy, in a software engine and not in a hardware Crypto Engine such as AWS KMS or PKCS#11, builds a new CSR with that key and proceeds with an internal enrollment equivalent to `/simpleenroll`.",{"_2322":1274,"_22971":1109,"_15675":39738,"_5":15564,"_21706":39300,"_1911":39739},[],"The response is a `multipart/mixed` with the literal boundary `estServerLamassuBoundary`. It contains two parts:",{"_2322":1275,"_22971":1109,"_15675":39741,"_5":15564,"_21706":39300,"_1911":39742},[],"The private key in **unencrypted PKCS#8** format, base64-encoded inside a part with `Content-Type: application/pkcs8`.",{"_2322":1276,"_22971":1109,"_15675":39744,"_5":15564,"_21706":39300,"_1911":39745},[],"The issued certificate in *degenerate* PKCS#7 base64, inside a part with `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_2322":1277,"_22971":1109,"_15675":39747,"_5":15564,"_21706":39300,"_1911":39748},[],"Unlike `/cacerts` and `/simpleenroll`, where the base64 is wrapped in 76-character lines, each part of `/serverkeygen` travels as **a single base64 line without breaks**. Any reverse proxy that rewrites the body (for example, normalizing line endings) can break the parsing.",{"_2322":1278,"_22971":1109,"_15675":39750,"_5":15564,"_21706":39300,"_1911":39751},[],"This endpoint reverses the PKI principle whereby the subscriber controls its own private key. The key is serialized as unencrypted PKCS#8 (`PrivateKeyInfo`, without `EncryptedPrivateKeyInfo`). The CMS `EnvelopedData` wrapper contemplated in RFC 7030 §4.4.2 is not applied; no AES key wrap or password-based symmetric encryption is used. The only protection is the channel's TLS. The integrator must guarantee that: (a) no reverse proxy terminates TLS and logs the response body; (b) the key is encrypted at rest immediately after receipt; (c) the audit account on the Lamassu server remains the single point of origin of the key.",{"_2322":1279,"_22971":1109,"_15675":39753,"_5":15564,"_21706":39300,"_1911":39754},[],"To separate the two parts, the following snippet uses `awk` with the literal boundary. It works with Lamassu's exact structure (each part = headers + blank line + a single base64 line); any intermediate proxy rewriting the body will break it.",{"_2322":1280,"_22971":1109,"_15675":39756,"_5":15564,"_21706":39304,"_1911":39757},[],"Once the endpoints have been reviewed individually, these examples show how to chain them in two common scenarios: the initial enrollment of a device and the renewal of an already-issued certificate.",{"_2322":1281,"_22971":1109,"_15675":39759,"_5":15564,"_21706":39308,"_1911":39760},[],"The following script illustrates the complete process of enrolling a device with a locally generated EC P-256 key and mTLS authentication against a bootstrap certificate.",{"_2322":1282,"_22971":1109,"_15675":39762,"_5":15564,"_21706":39312,"_1911":39763},[],"The following script reproduces a renewal process: it detects the expiration of the current certificate, regenerates the CSR with the **same subject** and authenticates with the active certificate.",{"_2322":1283,"_22971":1109,"_15675":39765,"_5":15564,"_21706":39316,"_1911":39766},[],"Once the device has obtained its identity certificate, the usual steps are:",{"_2322":1284,"_22971":1109,"_15675":39768,"_5":15564,"_21706":39316,"_1911":39769},[],"**Install the trust chain** (`cacerts.pem`) into the device's trust store. The MQTT broker, the HTTPS server or any relying party validating mTLS will need this chain.",{"_2322":1285,"_22971":1109,"_15675":39771,"_5":15564,"_21706":39316,"_1911":39772},[],"**Combine the leaf certificate with the chain** before presenting it in mTLS connections. The `/simpleenroll` response contains only the leaf certificate; the relying party may reject the connection if it does not receive the full chain.",{"_2322":1286,"_22971":1109,"_15675":39774,"_5":15564,"_21706":39316,"_1911":39775},[],"**Plan renewal**: configure a timer on the device that invokes `/simplereenroll` within the `ReEnrollmentDelta` window before the certificate expires. Do not wait for expiry unless `EnableExpiredRenewal` is enabled.",{"_2322":1287,"_22971":1109,"_15675":39777,"_5":15564,"_21706":39324,"_1911":39778},[],"Lamassu maps almost every business error to `500 Internal Server Error`, not to `4xx`. The HTTP status code is not enough to distinguish a network error from a policy error. The integrator must inspect the `err` field of the JSON body (`{\"err\": \"<message>\"}`) to determine the exact cause of the failure.",{"_2322":1288,"_22971":1109,"_15675":39780,"_5":15564,"_21706":39324,"_1911":39781},[],"HTTP",{"_2322":1289,"_22971":1109,"_15675":39783,"_5":15564,"_21706":39324,"_1911":39784},[],"Message",{"_2322":1290,"_22971":1109,"_15675":39786,"_5":15564,"_21706":39324,"_1911":39787},[],"Cause",{"_2322":1291,"_22971":1109,"_15675":39789,"_5":15564,"_21706":39324,"_1911":39790},[],"Integrator action",{"_2322":1292,"_22971":1109,"_15675":39792,"_5":15564,"_21706":39324,"_1911":22301},[],{"_2322":1293,"_22971":1109,"_15675":39794,"_5":15564,"_21706":39324,"_1911":39795},[],"`Field validation for 'APS' failed`",{"_2322":1294,"_22971":1109,"_15675":39797,"_5":15564,"_21706":39324,"_1911":39798},[],"The `{aps}` segment is missing from the URL.",{"_2322":1295,"_22971":1109,"_15675":39800,"_5":15564,"_21706":39324,"_1911":39801},[],"Include the DMS ID in the path.",{"_2322":1296,"_22971":1109,"_15675":39803,"_5":15564,"_21706":39324,"_1911":22301},[],{"_2322":1297,"_22971":1109,"_15675":39805,"_5":15564,"_21706":39324,"_1911":39806},[],"`content-type must be application/pkcs10`",{"_2322":1298,"_22971":1109,"_15675":39808,"_5":15564,"_21706":39324,"_1911":39809},[],"`Content-Type` header missing or incorrect.",{"_2322":1299,"_22971":1109,"_15675":39811,"_5":15564,"_21706":39324,"_1911":39812},[],"Set `Content-Type: application/pkcs10`.",{"_2322":1300,"_22971":1109,"_15675":39814,"_5":15564,"_21706":39324,"_1911":22301},[],{"_2322":1301,"_22971":1109,"_15675":39816,"_5":15564,"_21706":39324,"_1911":39817},[],"`body payload must be base64 encoded`",{"_2322":1302,"_22971":1109,"_15675":39819,"_5":15564,"_21706":39324,"_1911":39820},[],"The body is not valid base64.",{"_2322":1303,"_22971":1109,"_15675":39822,"_5":15564,"_21706":39324,"_1911":39823},[],"Use `base64 -w 0` to avoid line breaks.",{"_2322":1304,"_22971":1109,"_15675":39825,"_5":15564,"_21706":39324,"_1911":22214},[],{"_2322":1305,"_22971":1109,"_15675":39827,"_5":15564,"_21706":39324,"_1911":39828},[],"`DMS not found`",{"_2322":1306,"_22971":1109,"_15675":39830,"_5":15564,"_21706":39324,"_1911":39831},[],"The `{aps}` value does not match any DMS.",{"_2322":1307,"_22971":1109,"_15675":39833,"_5":15564,"_21706":39324,"_1911":39834},[],"Verify the identifier with the PKI administrator.",{"_2322":1308,"_22971":1109,"_15675":39836,"_5":15564,"_21706":39324,"_1911":22214},[],{"_2322":1309,"_22971":1109,"_15675":39838,"_5":15564,"_21706":39324,"_1911":39839},[],"`invalid certificate`",{"_2322":1310,"_22971":1109,"_15675":39841,"_5":15564,"_21706":39324,"_1911":39842},[],"The client certificate is not valid against `ValidationCAs`.",{"_2322":1311,"_22971":1109,"_15675":39844,"_5":15564,"_21706":39324,"_1911":39845},[],"Check the bootstrap certificate chain.",{"_2322":1312,"_22971":1109,"_15675":39847,"_5":15564,"_21706":39324,"_1911":22214},[],{"_2322":1313,"_22971":1109,"_15675":39849,"_5":15564,"_21706":39324,"_1911":39850},[],"`certificate is revoked`",{"_2322":1314,"_22971":1109,"_15675":39852,"_5":15564,"_21706":39324,"_1911":39853},[],"The certificate **presented as the mTLS credential** is revoked in Lamassu or via external OCSP/CRL.",{"_2322":1315,"_22971":1109,"_15675":39855,"_5":15564,"_21706":39324,"_1911":39856},[],"Request a new bootstrap certificate or investigate the revocation.",{"_2322":1316,"_22971":1109,"_15675":39858,"_5":15564,"_21706":39324,"_1911":22214},[],{"_2322":1317,"_22971":1109,"_15675":39860,"_5":15564,"_21706":39324,"_1911":39861},[],"`revoked certificate`",{"_2322":1318,"_22971":1109,"_15675":39863,"_5":15564,"_21706":39324,"_1911":39864},[],"In reenroll, the device's **active certificate in the database** is listed as revoked.",{"_2322":1319,"_22971":1109,"_15675":39866,"_5":15564,"_21706":39324,"_1911":39867},[],"Review the identity slot status; if the revocation was intentional, issue a new enroll instead of reenroll.",{"_2322":1320,"_22971":1109,"_15675":39869,"_5":15564,"_21706":39324,"_1911":22214},[],{"_2322":1321,"_22971":1109,"_15675":39871,"_5":15564,"_21706":39324,"_1911":39872},[],"`expired certificate`",{"_2322":1322,"_22971":1109,"_15675":39874,"_5":15564,"_21706":39324,"_1911":39875},[],"The presented certificate has expired and the DMS does not allow `AllowExpired`/`EnableExpiredRenewal`.",{"_2322":1323,"_22971":1109,"_15675":39877,"_5":15564,"_21706":39324,"_1911":39878},[],"Renew before expiration or request `EnableExpiredRenewal` to be enabled.",{"_2322":1324,"_22971":1109,"_15675":39880,"_5":15564,"_21706":39324,"_1911":22214},[],{"_2322":1325,"_22971":1109,"_15675":39882,"_5":15564,"_21706":39324,"_1911":39883},[],"`forbiddenNewEnrollment`",{"_2322":1326,"_22971":1109,"_15675":39885,"_5":15564,"_21706":39324,"_1911":39886},[],"The device is already enrolled and `EnableReplaceableEnrollment` is `false`.",{"_2322":1327,"_22971":1109,"_15675":39888,"_5":15564,"_21706":39324,"_1911":39889},[],"Use `/simplereenroll` or ask the administrator to enable the flag.",{"_2322":1328,"_22971":1109,"_15675":39891,"_5":15564,"_21706":39324,"_1911":22214},[],{"_2322":1329,"_22971":1109,"_15675":39893,"_5":15564,"_21706":39324,"_1911":39894},[],"`device not preregistered`",{"_2322":1330,"_22971":1109,"_15675":39896,"_5":15564,"_21706":39324,"_1911":39897},[],"The DMS is in `PRE_REGISTRATION` and the device does not exist.",{"_2322":1331,"_22971":1109,"_15675":39899,"_5":15564,"_21706":39324,"_1911":39900},[],"Register the device before enrolling it.",{"_2322":1332,"_22971":1109,"_15675":39902,"_5":15564,"_21706":39324,"_1911":22214},[],{"_2322":1333,"_22971":1109,"_15675":39904,"_5":15564,"_21706":39324,"_1911":39905},[],"`invalid reenroll window`",{"_2322":1334,"_22971":1109,"_15675":39907,"_5":15564,"_21706":39324,"_1911":39908},[],"Renewal attempted before `NotAfter - ReEnrollmentDelta`.",{"_2322":1335,"_22971":1109,"_15675":39910,"_5":15564,"_21706":39324,"_1911":39911},[],"Wait for the window to open or request a larger `ReEnrollmentDelta`.",{"_2322":1336,"_22971":1109,"_15675":39913,"_5":15564,"_21706":39324,"_1911":22214},[],{"_2322":1337,"_22971":1109,"_15675":39915,"_5":15564,"_21706":39324,"_1911":39916},[],"`invalid RawSubject bytes`",{"_2322":1338,"_22971":1109,"_15675":39918,"_5":15564,"_21706":39324,"_1911":39919},[],"The renewal CSR's subject does not match the active certificate's.",{"_2322":1339,"_22971":1109,"_15675":39921,"_5":15564,"_21706":39324,"_1911":39922},[],"Regenerate the CSR with the exact subject of the previous cert.",{"_2322":1340,"_22971":1109,"_15675":39924,"_5":15564,"_21706":39324,"_1911":22214},[],{"_2322":1341,"_22971":1109,"_15675":39926,"_5":15564,"_21706":39324,"_1911":39927},[],"`external webhook denied enrollment`",{"_2322":1342,"_22971":1109,"_15675":39929,"_5":15564,"_21706":39324,"_1911":39930},[],"The webhook returned a non-`2xx` code or `authorized != true`.",{"_2322":1343,"_22971":1109,"_15675":39932,"_5":15564,"_21706":39324,"_1911":39933},[],"Review the webhook service logs.",{"_2322":1344,"_22971":1109,"_15675":39935,"_5":15564,"_21706":39324,"_1911":22214},[],{"_2322":1345,"_22971":1109,"_15675":39937,"_5":15564,"_21706":39324,"_1911":39938},[],"`server key generation not enabled`",{"_2322":1346,"_22971":1109,"_15675":39940,"_5":15564,"_21706":39324,"_1911":39941},[],"`/serverkeygen` is disabled on the DMS.",{"_2322":1347,"_22971":1109,"_15675":39943,"_5":15564,"_21706":39324,"_1911":39944},[],"Ask the administrator to enable `ServerKeyGen.Enabled`.",{"_2322":1348,"_22971":1109,"_15675":39946,"_5":15564,"_21706":39324,"_1911":39947},[],"For messages not listed in this table, the Lamassu server logs (with the fields `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) are the first place to look for the cause.",{"_2322":1349,"_22971":1109,"_15675":39949,"_5":15564,"_21706":39328,"_1911":39950},[],"Lamassu's implementation follows RFC 7030 in its essentials but introduces several quirks that can affect strict EST clients or third-party libraries:",{"_2322":1350,"_22971":1109,"_15675":39952,"_5":15564,"_21706":39328,"_1911":39953},[],"The `/csrattrs` and `/fullcmc` endpoints of RFC 7030 are **not implemented** in Lamassu. A client invoking `/.well-known/est/<DMS_ID>/csrattrs` receives `404 Not Found` instead of the `204 No Content` the RFC suggests for \"no attributes\". Strict EST libraries must be configured not to attempt `csrattrs`.",{"_2322":1351,"_22971":1109,"_15675":39955,"_5":15564,"_21706":39328,"_1911":39956},[],"The base64 of the `/cacerts` and `/simpleenroll` responses is wrapped in lines of **76 characters** terminated with CRLF (S/MIME compliant, RFC 5751). The parts of `/serverkeygen` apply no wrap.",{"_2322":1352,"_22971":1109,"_15675":39958,"_5":15564,"_21706":39328,"_1911":39959},[],"The `multipart/mixed` boundary in `/serverkeygen` is fixed and cannot be negotiated.",{"_2322":1353,"_22971":1109,"_15675":39961,"_5":15564,"_21706":39328,"_1911":39962},[],"The `{aps}` segment is **mandatory** in all EST routes. Routes registered without `{aps}` are in the code but respond `400`.",{"_2322":1354,"_22971":1109,"_15675":39964,"_5":15564,"_21706":39328,"_1911":39965},[],"The body of `/cacerts`, `/simpleenroll` and `/simplereenroll` can be returned as concatenated PEM if the client sends `Accept: application/x-pem-file`. This is a Lamassu-specific extension and does not appear in the RFC.",{"_2322":1355,"_22971":1109,"_15675":39967,"_5":15564,"_21706":39328,"_1911":39968},[],"The server does not explicitly reject CSRs signed with SHA-1 or MD5; the integrator must generate the CSR with SHA-256 or higher.",{"_2322":1356,"_22971":1109,"_15675":39970,"_5":15564,"_21706":39328,"_1911":39971},[],"<Card title=\"DMS overview\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2322":1357,"_22971":1109,"_15675":39973,"_5":15564,"_21706":39328,"_1911":39974},[],"<Card title=\"OCSP validation\" href=\"/docs/platform/pki/ocsp\" />",{"_2322":1358,"_22971":1109,"_15675":39976,"_5":15564,"_21706":39328,"_1911":39977},[],"<Card title=\"Manage devices\" href=\"/docs/platform/pki/device-management\" />",{"_2322":1359,"_22971":1359,"_5":10796,"_1911":39979,"_23246":39980,"_15675":39982,"_21706":1359},"AWS IoT Core",[35713,36848,39981],"Integrations",[],{"_2322":1360,"_22971":1359,"_15675":39984,"_5":15564,"_21706":1359,"_1911":39985},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2322":1361,"_22971":1359,"_5":23243,"_15675":39987,"_21706":39988,"_1911":39989},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2322":1362,"_22971":1359,"_5":23243,"_15675":39991,"_21706":39992,"_1911":39238},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#prerequisites",{"_2322":1363,"_22971":1359,"_5":23243,"_15675":39994,"_21706":39995,"_1911":39996},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2322":1364,"_22971":1359,"_5":23243,"_15675":39998,"_21706":39999,"_1911":40000},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2322":1365,"_22971":1359,"_5":23243,"_15675":40002,"_21706":40003,"_1911":40004},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2322":1366,"_22971":1359,"_5":23243,"_15675":40006,"_21706":40007,"_1911":40008},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2322":1367,"_22971":1359,"_5":23243,"_15675":40010,"_21706":40011,"_1911":40012},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#primary-account","Primary Account",{"_2322":1368,"_22971":1359,"_5":23243,"_15675":40014,"_21706":40015,"_1911":40016},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2322":1369,"_22971":1359,"_5":23243,"_15675":40018,"_21706":40019,"_1911":39234},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#dms-configuration",{"_2322":1370,"_22971":1359,"_5":23243,"_15675":40021,"_21706":40022,"_1911":40023},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#none-mode","`none` mode",{"_2322":1371,"_22971":1359,"_5":23243,"_15675":40025,"_21706":40026,"_1911":40027},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2322":1372,"_22971":1359,"_5":23243,"_15675":40029,"_21706":40030,"_1911":40031},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2322":1373,"_22971":1359,"_5":23243,"_15675":40033,"_21706":40034,"_1911":40035},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2322":1374,"_22971":1359,"_5":23243,"_15675":40037,"_21706":40038,"_1911":40039},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2322":1375,"_22971":1359,"_5":23243,"_15675":40041,"_21706":40042,"_1911":40043},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2322":1376,"_22971":1359,"_5":23243,"_15675":40045,"_21706":40046,"_1911":40047},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2322":1377,"_22971":1359,"_5":23243,"_15675":40049,"_21706":40050,"_1911":40051},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2322":1378,"_22971":1359,"_5":23243,"_15675":40053,"_21706":40054,"_1911":40055},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2322":1379,"_22971":1359,"_5":23243,"_15675":40057,"_21706":40058,"_1911":40059},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2322":1380,"_22971":1359,"_5":23243,"_15675":40061,"_21706":40062,"_1911":40063},[],"/docs/pr-preview/pr-28/platform/pki/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2322":1381,"_22971":1359,"_15675":40065,"_5":15564,"_21706":1359,"_1911":40066},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2322":1382,"_22971":1359,"_15675":40068,"_5":15564,"_21706":1359,"_1911":40069},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2322":1383,"_22971":1359,"_15675":40071,"_5":15564,"_21706":1359,"_1911":40072},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2322":1384,"_22971":1359,"_15675":40074,"_5":15564,"_21706":39988,"_1911":40075},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2322":1385,"_22971":1359,"_15675":40077,"_5":15564,"_21706":39988,"_1911":40078},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2322":1386,"_22971":1359,"_15675":40080,"_5":15564,"_21706":39988,"_1911":40081},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2322":1387,"_22971":1359,"_15675":40083,"_5":15564,"_21706":39988,"_1911":40084},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2322":1388,"_22971":1359,"_15675":40086,"_5":15564,"_21706":39992,"_1911":40087},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2322":1389,"_22971":1359,"_15675":40089,"_5":15564,"_21706":39995,"_1911":40090},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2322":1390,"_22971":1359,"_15675":40092,"_5":15564,"_21706":39995,"_1911":40093},[],"IAM action",{"_2322":1391,"_22971":1359,"_15675":40095,"_5":15564,"_21706":39995,"_1911":36096},[],{"_2322":1392,"_22971":1359,"_15675":40097,"_5":15564,"_21706":39995,"_1911":40098},[],"`iot:GetRegistrationCode`",{"_2322":1393,"_22971":1359,"_15675":40100,"_5":15564,"_21706":39995,"_1911":40101},[],"Obtain the verification code for CA registration in the Primary Account",{"_2322":1394,"_22971":1359,"_15675":40103,"_5":15564,"_21706":39995,"_1911":40104},[],"`iot:RegisterCACertificate`",{"_2322":1395,"_22971":1359,"_15675":40106,"_5":15564,"_21706":39995,"_1911":40107},[],"Register the CA in AWS IoT",{"_2322":1396,"_22971":1359,"_15675":40109,"_5":15564,"_21706":39995,"_1911":40110},[],"`iot:DescribeCACertificate`",{"_2322":1397,"_22971":1359,"_15675":40112,"_5":15564,"_21706":39995,"_1911":40113},[],"Check the CA registration status",{"_2322":1398,"_22971":1359,"_15675":40115,"_5":15564,"_21706":39995,"_1911":40116},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2322":1399,"_22971":1359,"_15675":40118,"_5":15564,"_21706":39995,"_1911":40119},[],"Create or update Things in IoT Core",{"_2322":1400,"_22971":1359,"_15675":40121,"_5":15564,"_21706":39995,"_1911":40122},[],"`iot:RegisterThing`",{"_2322":1401,"_22971":1359,"_15675":40124,"_5":15564,"_21706":39995,"_1911":40125},[],"Provision Things through a template",{"_2322":1402,"_22971":1359,"_15675":40127,"_5":15564,"_21706":39995,"_1911":40128},[],"`iot:RegisterCertificate`",{"_2322":1403,"_22971":1359,"_15675":40130,"_5":15564,"_21706":39995,"_1911":40131},[],"Register device certificates",{"_2322":1404,"_22971":1359,"_15675":40133,"_5":15564,"_21706":39995,"_1911":40134},[],"`iot:UpdateCertificate`",{"_2322":1405,"_22971":1359,"_15675":40136,"_5":15564,"_21706":39995,"_1911":40137},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2322":1406,"_22971":1359,"_15675":40139,"_5":15564,"_21706":39995,"_1911":40140},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2322":1407,"_22971":1359,"_15675":40142,"_5":15564,"_21706":39995,"_1911":40143},[],"Create and attach IoT policies",{"_2322":1408,"_22971":1359,"_15675":40145,"_5":15564,"_21706":39995,"_1911":40146},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2322":1409,"_22971":1359,"_15675":40148,"_5":15564,"_21706":39995,"_1911":40149},[],"Manage Thing groups",{"_2322":1410,"_22971":1359,"_15675":40151,"_5":15564,"_21706":39995,"_1911":40152},[],"`iot:CreateProvisioningTemplate`",{"_2322":1411,"_22971":1359,"_15675":40154,"_5":15564,"_21706":39995,"_1911":40155},[],"Create JITP templates",{"_2322":1412,"_22971":1359,"_15675":40157,"_5":15564,"_21706":39995,"_1911":40158},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2322":1413,"_22971":1359,"_15675":40160,"_5":15564,"_21706":39995,"_1911":40161},[],"Read and write the Device Shadow",{"_2322":1414,"_22971":1359,"_15675":40163,"_5":15564,"_21706":39995,"_1911":40164},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2322":1415,"_22971":1359,"_15675":40166,"_5":15564,"_21706":39999,"_1911":40167},[],"Parameter",{"_2322":1416,"_22971":1359,"_15675":40169,"_5":15564,"_21706":39999,"_1911":40170},[],"Type",{"_2322":1417,"_22971":1359,"_15675":40172,"_5":15564,"_21706":39999,"_1911":40173},[],"Required",{"_2322":1418,"_22971":1359,"_15675":40175,"_5":15564,"_21706":39999,"_1911":38934},[],{"_2322":1419,"_22971":1359,"_15675":40177,"_5":15564,"_21706":39999,"_1911":40178},[],"`connector_id`",{"_2322":1420,"_22971":1359,"_15675":40180,"_5":15564,"_21706":39999,"_1911":18899},[],{"_2322":1421,"_22971":1359,"_15675":40182,"_5":15564,"_21706":39999,"_1911":39562},[],{"_2322":1422,"_22971":1359,"_15675":40184,"_5":15564,"_21706":39999,"_1911":40185},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2322":1423,"_22971":1359,"_15675":40187,"_5":15564,"_21706":39999,"_1911":40188},[],"`aws_config.region`",{"_2322":1424,"_22971":1359,"_15675":40190,"_5":15564,"_21706":39999,"_1911":18899},[],{"_2322":1425,"_22971":1359,"_15675":40192,"_5":15564,"_21706":39999,"_1911":39562},[],{"_2322":1426,"_22971":1359,"_15675":40194,"_5":15564,"_21706":39999,"_1911":40195},[],"AWS region where the connector operates.",{"_2322":1427,"_22971":1359,"_15675":40197,"_5":15564,"_21706":39999,"_1911":40198},[],"`aws_config.auth_method`",{"_2322":1428,"_22971":1359,"_15675":40200,"_5":15564,"_21706":39999,"_1911":18899},[],{"_2322":1429,"_22971":1359,"_15675":40202,"_5":15564,"_21706":39999,"_1911":39562},[],{"_2322":1430,"_22971":1359,"_15675":40204,"_5":15564,"_21706":39999,"_1911":40205},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2322":1431,"_22971":1359,"_15675":40207,"_5":15564,"_21706":39999,"_1911":40208},[],"`aws_config.access_key_id`",{"_2322":1432,"_22971":1359,"_15675":40210,"_5":15564,"_21706":39999,"_1911":18899},[],{"_2322":1433,"_22971":1359,"_15675":40212,"_5":15564,"_21706":39999,"_1911":40213},[],"Only with `auth_method=static`",{"_2322":1434,"_22971":1359,"_15675":40215,"_5":15564,"_21706":39999,"_1911":40216},[],"AWS access key.",{"_2322":1435,"_22971":1359,"_15675":40218,"_5":15564,"_21706":39999,"_1911":40219},[],"`aws_config.secret_access_key`",{"_2322":1436,"_22971":1359,"_15675":40221,"_5":15564,"_21706":39999,"_1911":18899},[],{"_2322":1437,"_22971":1359,"_15675":40223,"_5":15564,"_21706":39999,"_1911":40213},[],{"_2322":1438,"_22971":1359,"_15675":40225,"_5":15564,"_21706":39999,"_1911":40226},[],"AWS secret key.",{"_2322":1439,"_22971":1359,"_15675":40228,"_5":15564,"_21706":39999,"_1911":40229},[],"`aws_config.session_token`",{"_2322":1440,"_22971":1359,"_15675":40231,"_5":15564,"_21706":39999,"_1911":18899},[],{"_2322":1441,"_22971":1359,"_15675":40233,"_5":15564,"_21706":39999,"_1911":40234},[],"No",{"_2322":1442,"_22971":1359,"_15675":40236,"_5":15564,"_21706":39999,"_1911":40237},[],"Session token (with `auth_method=static`).",{"_2322":1443,"_22971":1359,"_15675":40239,"_5":15564,"_21706":39999,"_1911":40240},[],"`aws_config.role_arn`",{"_2322":1444,"_22971":1359,"_15675":40242,"_5":15564,"_21706":39999,"_1911":18899},[],{"_2322":1445,"_22971":1359,"_15675":40244,"_5":15564,"_21706":39999,"_1911":40245},[],"Only with `auth_method=role`",{"_2322":1446,"_22971":1359,"_15675":40247,"_5":15564,"_21706":39999,"_1911":40248},[],"ARN of the role to assume.",{"_2322":1447,"_22971":1359,"_15675":40250,"_5":15564,"_21706":39999,"_1911":40251},[],"`aws_config.endpoint_url`",{"_2322":1448,"_22971":1359,"_15675":40253,"_5":15564,"_21706":39999,"_1911":18899},[],{"_2322":1449,"_22971":1359,"_15675":40255,"_5":15564,"_21706":39999,"_1911":40234},[],{"_2322":1450,"_22971":1359,"_15675":40257,"_5":15564,"_21706":39999,"_1911":40258},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2322":1451,"_22971":1359,"_15675":40260,"_5":15564,"_21706":39999,"_1911":40261},[],"`subscriber_event_bus`",{"_2322":1452,"_22971":1359,"_15675":40263,"_5":15564,"_21706":39999,"_1911":13086},[],{"_2322":1453,"_22971":1359,"_15675":40265,"_5":15564,"_21706":39999,"_1911":39562},[],{"_2322":1454,"_22971":1359,"_15675":40267,"_5":15564,"_21706":39999,"_1911":40268},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2322":1455,"_22971":1359,"_15675":40270,"_5":15564,"_21706":39999,"_1911":40271},[],"`dms_manager_client`",{"_2322":1456,"_22971":1359,"_15675":40273,"_5":15564,"_21706":39999,"_1911":18899},[],{"_2322":1457,"_22971":1359,"_15675":40275,"_5":15564,"_21706":39999,"_1911":39562},[],{"_2322":1458,"_22971":1359,"_15675":40277,"_5":15564,"_21706":39999,"_1911":40278},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2322":1459,"_22971":1359,"_15675":40280,"_5":15564,"_21706":39999,"_1911":40281},[],"`device_manager_client`",{"_2322":1460,"_22971":1359,"_15675":40283,"_5":15564,"_21706":39999,"_1911":18899},[],{"_2322":1461,"_22971":1359,"_15675":40285,"_5":15564,"_21706":39999,"_1911":39562},[],{"_2322":1462,"_22971":1359,"_15675":40287,"_5":15564,"_21706":39999,"_1911":40288},[],"HTTP URL of Lamassu's Device Manager.",{"_2322":1463,"_22971":1359,"_15675":40290,"_5":15564,"_21706":39999,"_1911":40291},[],"`ca_client`",{"_2322":1464,"_22971":1359,"_15675":40293,"_5":15564,"_21706":39999,"_1911":18899},[],{"_2322":1465,"_22971":1359,"_15675":40295,"_5":15564,"_21706":39999,"_1911":39562},[],{"_2322":1466,"_22971":1359,"_15675":40297,"_5":15564,"_21706":39999,"_1911":40298},[],"HTTP URL of Lamassu's CA service.",{"_2322":1467,"_22971":1359,"_15675":40300,"_5":15564,"_21706":40003,"_1911":40301},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2322":1468,"_22971":1359,"_15675":40303,"_5":15564,"_21706":40007,"_1911":40304},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2322":1469,"_22971":1359,"_15675":40306,"_5":15564,"_21706":40007,"_1911":40307},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2322":1470,"_22971":1359,"_15675":40309,"_5":15564,"_21706":40011,"_1911":40310},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2322":1471,"_22971":1359,"_15675":40312,"_5":15564,"_21706":40011,"_1911":40313},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2322":1472,"_22971":1359,"_15675":40315,"_5":15564,"_21706":40011,"_1911":40316},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2322":1473,"_22971":1359,"_15675":40318,"_5":15564,"_21706":40011,"_1911":40319},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2322":1474,"_22971":1359,"_15675":40321,"_5":15564,"_21706":40011,"_1911":40322},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2322":1475,"_22971":1359,"_15675":40324,"_5":15564,"_21706":40011,"_1911":40325},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2322":1476,"_22971":1359,"_15675":40327,"_5":15564,"_21706":40015,"_1911":40328},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2322":1477,"_22971":1359,"_15675":40330,"_5":15564,"_21706":40019,"_1911":40331},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2322":1478,"_22971":1359,"_15675":40333,"_5":15564,"_21706":40019,"_1911":40334},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2322":1479,"_22971":1359,"_15675":40336,"_5":15564,"_21706":40022,"_1911":40337},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2322":1480,"_22971":1359,"_15675":40339,"_5":15564,"_21706":40026,"_1911":40340},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2322":1481,"_22971":1359,"_15675":40342,"_5":15564,"_21706":40026,"_1911":40343},[],"Creates or updates the IoT policies configured in the DMS.",{"_2322":1482,"_22971":1359,"_15675":40345,"_5":15564,"_21706":40026,"_1911":40346},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2322":1483,"_22971":1359,"_15675":40348,"_5":15564,"_21706":40026,"_1911":40349},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2322":1484,"_22971":1359,"_15675":40351,"_5":15564,"_21706":40026,"_1911":40352},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2322":1485,"_22971":1359,"_15675":40354,"_5":15564,"_21706":40026,"_1911":40355},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2322":1486,"_22971":1359,"_15675":40357,"_5":15564,"_21706":40026,"_1911":40358},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2322":1487,"_22971":1359,"_15675":40360,"_5":15564,"_21706":40030,"_1911":40361},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2322":1488,"_22971":1359,"_15675":40363,"_5":15564,"_21706":40030,"_1911":40364},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2322":1489,"_22971":1359,"_15675":40366,"_5":15564,"_21706":40030,"_1911":40367},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2322":1490,"_22971":1359,"_15675":40369,"_5":15564,"_21706":40034,"_1911":40370},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2322":1491,"_22971":1359,"_15675":40372,"_5":15564,"_21706":40034,"_1911":40373},[],"The full flow from the device's perspective is:",{"_2322":1492,"_22971":1359,"_15675":40375,"_5":15564,"_21706":40034,"_1911":40376},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2322":1493,"_22971":1359,"_15675":40378,"_5":15564,"_21706":40038,"_1911":40379},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2322":1494,"_22971":1359,"_15675":40381,"_5":15564,"_21706":40038,"_1911":40382},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2322":1495,"_22971":1359,"_15675":40384,"_5":15564,"_21706":40038,"_1911":40385},[],"For the JITP flow to work correctly:",{"_2322":1496,"_22971":1359,"_15675":40387,"_5":15564,"_21706":40038,"_1911":40388},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2322":1497,"_22971":1359,"_15675":40390,"_5":15564,"_21706":40038,"_1911":40391},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2322":1498,"_22971":1359,"_15675":40393,"_5":15564,"_21706":40038,"_1911":40394},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2322":1499,"_22971":1359,"_15675":40396,"_5":15564,"_21706":40038,"_1911":40397},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2322":1500,"_22971":1359,"_15675":40399,"_5":15564,"_21706":40042,"_1911":40400},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2322":1501,"_22971":1359,"_15675":40402,"_5":15564,"_21706":40042,"_1911":40403},[],"Status in Lamassu",{"_2322":1502,"_22971":1359,"_15675":40405,"_5":15564,"_21706":40042,"_1911":40406},[],"Revocation reason",{"_2322":1503,"_22971":1359,"_15675":40408,"_5":15564,"_21706":40042,"_1911":40409},[],"Status in AWS IoT Core",{"_2322":1504,"_22971":1359,"_15675":40411,"_5":15564,"_21706":40042,"_1911":40412},[],"`Active`",{"_2322":1505,"_22971":1359,"_15675":40414,"_5":15564,"_21706":40042,"_1911":39602},[],{"_2322":1506,"_22971":1359,"_15675":40416,"_5":15564,"_21706":40042,"_1911":40417},[],"`ACTIVE`",{"_2322":1507,"_22971":1359,"_15675":40419,"_5":15564,"_21706":40042,"_1911":40420},[],"`Revoked`",{"_2322":1508,"_22971":1359,"_15675":40422,"_5":15564,"_21706":40042,"_1911":40423},[],"`certificateHold`",{"_2322":1509,"_22971":1359,"_15675":40425,"_5":15564,"_21706":40042,"_1911":40426},[],"`INACTIVE`",{"_2322":1510,"_22971":1359,"_15675":40428,"_5":15564,"_21706":40042,"_1911":40420},[],{"_2322":1511,"_22971":1359,"_15675":40430,"_5":15564,"_21706":40042,"_1911":40431},[],"Any other reason",{"_2322":1512,"_22971":1359,"_15675":40433,"_5":15564,"_21706":40042,"_1911":40434},[],"`REVOKED`",{"_2322":1513,"_22971":1359,"_15675":40436,"_5":15564,"_21706":40042,"_1911":40437},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2322":1514,"_22971":1359,"_15675":40439,"_5":15564,"_21706":40046,"_1911":40440},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2322":1515,"_22971":1359,"_15675":40442,"_5":15564,"_21706":40046,"_1911":40443},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2322":1516,"_22971":1359,"_15675":40445,"_5":15564,"_21706":40046,"_1911":40446},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2322":1517,"_22971":1359,"_15675":40448,"_5":15564,"_21706":40050,"_1911":40449},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2322":1518,"_22971":1359,"_15675":40451,"_5":15564,"_21706":40050,"_1911":40452},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2322":1519,"_22971":1359,"_15675":40454,"_5":15564,"_21706":40054,"_1911":40455},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2322":1520,"_22971":1359,"_15675":40457,"_5":15564,"_21706":40054,"_1911":40458},[],"There are two action types:",{"_2322":1521,"_22971":1359,"_15675":40460,"_5":15564,"_21706":40054,"_1911":40461},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2322":1522,"_22971":1359,"_15675":40463,"_5":15564,"_21706":40054,"_1911":40464},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2322":1523,"_22971":1359,"_15675":40466,"_5":15564,"_21706":40054,"_1911":40467},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2322":1524,"_22971":1359,"_15675":40469,"_5":15564,"_21706":40058,"_1911":40470},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2322":1525,"_22971":1359,"_15675":40472,"_5":15564,"_21706":40058,"_1911":40473},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2322":1526,"_22971":1359,"_15675":40475,"_5":15564,"_21706":40058,"_1911":40476},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2322":1527,"_22971":1359,"_15675":40478,"_5":15564,"_21706":40062,"_1911":40479},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2322":1528,"_22971":1359,"_15675":40481,"_5":15564,"_21706":40062,"_1911":40482},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2322":1529,"_22971":1359,"_15675":40484,"_5":15564,"_21706":40062,"_1911":40485},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2322":1530,"_22971":1359,"_15675":40487,"_5":15564,"_21706":40062,"_1911":40488},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2322":1531,"_22971":1359,"_15675":40490,"_5":15564,"_21706":40062,"_1911":40491},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2322":1532,"_22971":1359,"_15675":40493,"_5":15564,"_21706":40062,"_1911":40494},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2322":1533,"_22971":1359,"_15675":40496,"_5":15564,"_21706":40062,"_1911":40497},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2322":1534,"_22971":1359,"_15675":40499,"_5":15564,"_21706":40062,"_1911":40500},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2322":1535,"_22971":1359,"_15675":40502,"_5":15564,"_21706":40062,"_1911":40503},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2322":1536,"_22971":1359,"_15675":40505,"_5":15564,"_21706":40062,"_1911":40506},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2322":1537,"_22971":1359,"_15675":40508,"_5":15564,"_21706":40062,"_1911":40509},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2322":1538,"_22971":1359,"_15675":40511,"_5":15564,"_21706":40062,"_1911":40512},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2322":1539,"_22971":1359,"_15675":40514,"_5":15564,"_21706":40062,"_1911":40515},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2322":1540,"_22971":1359,"_15675":40517,"_5":15564,"_21706":40062,"_1911":40518},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2322":1541,"_22971":1359,"_15675":40520,"_5":15564,"_21706":40062,"_1911":40521},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2322":1542,"_22971":1359,"_15675":40523,"_5":15564,"_21706":40062,"_1911":40524},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2322":1543,"_22971":1359,"_15675":40526,"_5":15564,"_21706":40062,"_1911":40527},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2322":1544,"_22971":1359,"_15675":40529,"_5":15564,"_21706":40062,"_1911":40530},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2322":1545,"_22971":1359,"_15675":40532,"_5":15564,"_21706":40062,"_1911":40533},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2322":1546,"_22971":1359,"_15675":40535,"_5":15564,"_21706":40062,"_1911":40536},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2322":1547,"_22971":1359,"_15675":40538,"_5":15564,"_21706":40062,"_1911":40539},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2322":1548,"_22971":1548,"_5":10796,"_1911":40541,"_23246":40542,"_15675":40543,"_21706":1548},"Keys and cryptographic engines",[35713,36848,37382],[],{"_2322":1549,"_22971":1548,"_15675":40545,"_5":15564,"_21706":1548,"_1911":40546},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2322":1550,"_22971":1548,"_5":23243,"_15675":40548,"_21706":40549,"_1911":40550},[],"/docs/pr-preview/pr-28/platform/pki/key-management#cryptographic-key-management","Cryptographic key management",{"_2322":1551,"_22971":1548,"_5":23243,"_15675":40552,"_21706":40553,"_1911":40554},[],"/docs/pr-preview/pr-28/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2322":1552,"_22971":1548,"_5":23243,"_15675":40556,"_21706":40557,"_1911":40558},[],"/docs/pr-preview/pr-28/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2322":1553,"_22971":1548,"_5":23243,"_15675":40560,"_21706":40561,"_1911":40562},[],"/docs/pr-preview/pr-28/platform/pki/key-management#file-system","File System",{"_2322":1554,"_22971":1548,"_5":23243,"_15675":40564,"_21706":40565,"_1911":40566},[],"/docs/pr-preview/pr-28/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2322":1555,"_22971":1548,"_5":23243,"_15675":40568,"_21706":40569,"_1911":40570},[],"/docs/pr-preview/pr-28/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2322":1556,"_22971":1548,"_5":23243,"_15675":40572,"_21706":40573,"_1911":40574},[],"/docs/pr-preview/pr-28/platform/pki/key-management#aws-kms","AWS KMS",{"_2322":1557,"_22971":1548,"_5":23243,"_15675":40576,"_21706":40577,"_1911":40578},[],"/docs/pr-preview/pr-28/platform/pki/key-management#pkcs11","PKCS#11",{"_2322":1558,"_22971":1548,"_5":23243,"_15675":40580,"_21706":40581,"_1911":40582},[],"/docs/pr-preview/pr-28/platform/pki/key-management#key-inventory","Key inventory",{"_2322":1559,"_22971":1548,"_5":23243,"_15675":40584,"_21706":40585,"_1911":40586},[],"/docs/pr-preview/pr-28/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2322":1560,"_22971":1548,"_5":23243,"_15675":40588,"_21706":40589,"_1911":40590},[],"/docs/pr-preview/pr-28/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2322":1561,"_22971":1548,"_5":23243,"_15675":40592,"_21706":40593,"_1911":40594},[],"/docs/pr-preview/pr-28/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2322":1562,"_22971":1548,"_5":23243,"_15675":40596,"_21706":40597,"_1911":40598},[],"/docs/pr-preview/pr-28/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2322":1563,"_22971":1548,"_5":23243,"_15675":40600,"_21706":40601,"_1911":40602},[],"/docs/pr-preview/pr-28/platform/pki/key-management#view-details","View details",{"_2322":1564,"_22971":1548,"_5":23243,"_15675":40604,"_21706":40605,"_1911":40606},[],"/docs/pr-preview/pr-28/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2322":1565,"_22971":1548,"_5":23243,"_15675":40608,"_21706":40609,"_1911":40610},[],"/docs/pr-preview/pr-28/platform/pki/key-management#sign","Sign",{"_2322":1566,"_22971":1548,"_5":23243,"_15675":40612,"_21706":40613,"_1911":40614},[],"/docs/pr-preview/pr-28/platform/pki/key-management#verify","Verify",{"_2322":1567,"_22971":1548,"_5":23243,"_15675":40616,"_21706":40617,"_1911":40618},[],"/docs/pr-preview/pr-28/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2322":1568,"_22971":1548,"_5":23243,"_15675":40620,"_21706":40621,"_1911":40622},[],"/docs/pr-preview/pr-28/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2322":1569,"_22971":1548,"_15675":40624,"_5":15564,"_21706":40549,"_1911":40625},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2322":1570,"_22971":1548,"_15675":40627,"_5":15564,"_21706":40549,"_1911":40628},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2322":1571,"_22971":1548,"_15675":40630,"_5":15564,"_21706":40553,"_1911":40631},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2322":1572,"_22971":1548,"_15675":40633,"_5":15564,"_21706":40553,"_1911":40634},[],"In practice, it lets you:",{"_2322":1573,"_22971":1548,"_15675":40636,"_5":15564,"_21706":40553,"_1911":40637},[],"Generate new key pairs from Lamassu IoT.",{"_2322":1574,"_22971":1548,"_15675":40639,"_5":15564,"_21706":40553,"_1911":40640},[],"Import keys created externally.",{"_2322":1575,"_22971":1548,"_15675":40642,"_5":15564,"_21706":40553,"_1911":40643},[],"Delegate custody and cryptographic operations to external engines.",{"_2322":1576,"_22971":1548,"_15675":40645,"_5":15564,"_21706":40553,"_1911":40646},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2322":1577,"_22971":1548,"_15675":40648,"_5":15564,"_21706":40557,"_1911":40649},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2322":1578,"_22971":1548,"_15675":40651,"_5":15564,"_21706":40557,"_1911":40652},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2322":1579,"_22971":1548,"_15675":40654,"_5":15564,"_21706":40557,"_1911":40655},[],"Currently, Lamassu supports five engine types. Choose according to the isolation level you need and who should be able to access private material.",{"_2322":1580,"_22971":1548,"_15675":40657,"_5":15564,"_21706":40561,"_1911":40658},[],"Generates keys with Go's cryptographic libraries and delegates their protection to the file system. It works both on-premise and in the cloud, but it does not prevent key extraction and is not recommended for production.",{"_2322":1581,"_22971":1548,"_15675":40660,"_5":15564,"_21706":40565,"_1911":40661},[],"Protects keys at rest and can run on-premise or in the cloud. An administrator with sufficient permissions can still view private material, so it is wise to limit administrative access and safeguard the *unseal* keys.",{"_2322":1582,"_22971":1548,"_15675":40663,"_5":15564,"_21706":40569,"_1911":40664},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2322":1583,"_22971":1548,"_15675":40666,"_5":15564,"_21706":40573,"_1911":40667},[],"Generates keys with hardware entropy and never exposes the private key. Operations run inside the service. Even so, an identity with sufficient permissions could use the key to sign, so IAM policy remains critical.",{"_2322":1584,"_22971":1548,"_15675":40669,"_5":15564,"_21706":40577,"_1911":40670},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2322":1585,"_22971":1548,"_15675":40672,"_5":15564,"_21706":40577,"_1911":40673},[],"Lamassu shows the full list of enabled engines in the console.",{"_2322":1586,"_22971":1548,"_15675":40675,"_5":15564,"_21706":40577,"_1911":40676},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2322":1587,"_22971":1548,"_15675":40678,"_5":15564,"_21706":40577,"_1911":40679},[],"During deployment it is mandatory to define a default engine. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2322":1588,"_22971":1548,"_15675":40681,"_5":15564,"_21706":40581,"_1911":40682},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2322":1589,"_22971":1548,"_15675":40684,"_5":15564,"_21706":40581,"_1911":40685},[],"The table includes the following fields:",{"_2322":1590,"_22971":1548,"_15675":40687,"_5":15564,"_21706":40581,"_1911":40688},[],"**Name**: descriptive name of the key.",{"_2322":1591,"_22971":1548,"_15675":40690,"_5":15564,"_21706":40581,"_1911":40691},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2322":1592,"_22971":1548,"_15675":40693,"_5":15564,"_21706":40581,"_1911":40694},[],"**Strength**: visual indicator of cryptographic strength.",{"_2322":1593,"_22971":1548,"_15675":40696,"_5":15564,"_21706":40581,"_1911":40697},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2322":1594,"_22971":1548,"_15675":40699,"_5":15564,"_21706":40581,"_1911":40700},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2322":1595,"_22971":1548,"_15675":40702,"_5":15564,"_21706":40581,"_1911":40703},[],"**Aliases**: alternative names associated with the key.",{"_2322":1596,"_22971":1548,"_15675":40705,"_5":15564,"_21706":40581,"_1911":40706},[],"**Tags**: labels for classification and search.",{"_2322":1597,"_22971":1548,"_15675":40708,"_5":15564,"_21706":40581,"_1911":40709},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2322":1598,"_22971":1548,"_15675":40711,"_5":15564,"_21706":40581,"_1911":40712},[],"From this view you also reach the most common actions:",{"_2322":1599,"_22971":1548,"_15675":40714,"_5":15564,"_21706":40581,"_1911":40715},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2322":1600,"_22971":1548,"_15675":40717,"_5":15564,"_21706":40581,"_1911":40718},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2322":1601,"_22971":1548,"_15675":40720,"_5":15564,"_21706":40581,"_1911":40721},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2322":1602,"_22971":1548,"_15675":40723,"_5":15564,"_21706":40581,"_1911":40724},[],"**Delete Key** to remove the key from the system.",{"_2322":1603,"_22971":1548,"_15675":40726,"_5":15564,"_21706":40585,"_1911":40727},[],"Keys are registered from the wizard opened with **Create New Key**.",{"_2322":1604,"_22971":1548,"_15675":40729,"_5":15564,"_21706":40589,"_1911":40730},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2322":1605,"_22971":1548,"_15675":40732,"_5":15564,"_21706":40589,"_1911":40733},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2322":1606,"_22971":1548,"_15675":40735,"_5":15564,"_21706":40589,"_1911":40736},[],"**Key Name**: unique and descriptive name.",{"_2322":1607,"_22971":1548,"_15675":40738,"_5":15564,"_21706":40589,"_1911":40739},[],"**Crypto Engine**: engine that will keep the key.",{"_2322":1608,"_22971":1548,"_15675":40741,"_5":15564,"_21706":40589,"_1911":40742},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2322":1609,"_22971":1548,"_15675":40744,"_5":15564,"_21706":40589,"_1911":40745},[],"**Tags**: metadata to classify the key.",{"_2322":1610,"_22971":1548,"_15675":40747,"_5":15564,"_21706":40589,"_1911":40748},[],"**Metadata**: additional information for advanced uses.",{"_2322":1611,"_22971":1548,"_15675":40750,"_5":15564,"_21706":40593,"_1911":40751},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2322":1612,"_22971":1548,"_15675":40753,"_5":15564,"_21706":40593,"_1911":40754},[],"When the key was generated in an isolated environment or an external HSM.",{"_2322":1613,"_22971":1548,"_15675":40756,"_5":15564,"_21706":40593,"_1911":40757},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2322":1614,"_22971":1548,"_15675":40759,"_5":15564,"_21706":40593,"_1911":40760},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2322":1615,"_22971":1548,"_15675":40762,"_5":15564,"_21706":40593,"_1911":40763},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2322":1616,"_22971":1548,"_15675":40765,"_5":15564,"_21706":40593,"_1911":40766},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2322":1617,"_22971":1548,"_15675":40768,"_5":15564,"_21706":40593,"_1911":40769},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2322":1618,"_22971":1548,"_15675":40771,"_5":15564,"_21706":40593,"_1911":40772},[],"**Tags**: labels for organization and search.",{"_2322":1619,"_22971":1548,"_15675":40774,"_5":15564,"_21706":40593,"_1911":40775},[],"**Metadata**: additional optional information.",{"_2322":1620,"_22971":1548,"_15675":40777,"_5":15564,"_21706":40593,"_1911":40778},[],"**Private Key (PEM)**: private key in PEM format.",{"_2322":1621,"_22971":1548,"_15675":40780,"_5":15564,"_21706":40593,"_1911":40781},[],"Once the wizard is complete, the key is stored in the selected engine and can be used for signing, CSR generation and the rest of the operations supported by the KMS.",{"_2322":1622,"_22971":1548,"_15675":40783,"_5":15564,"_21706":40597,"_1911":40784},[],"Each registered key has a detail view and several operational actions.",{"_2322":1623,"_22971":1548,"_15675":40786,"_5":15564,"_21706":40601,"_1911":40787},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2322":1624,"_22971":1548,"_15675":40789,"_5":15564,"_21706":40601,"_1911":40790},[],"The **Overview** tab shows, among others, these fields:",{"_2322":1625,"_22971":1548,"_15675":40792,"_5":15564,"_21706":40601,"_1911":40793},[],"**Key Name**: descriptive name.",{"_2322":1626,"_22971":1548,"_15675":40795,"_5":15564,"_21706":40601,"_1911":40796},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2322":1627,"_22971":1548,"_15675":40798,"_5":15564,"_21706":40601,"_1911":40799},[],"**Tags**: associated labels.",{"_2322":1628,"_22971":1548,"_15675":40801,"_5":15564,"_21706":40601,"_1911":40802},[],"**Aliases**: alternative names.",{"_2322":1629,"_22971":1548,"_15675":40804,"_5":15564,"_21706":40601,"_1911":40805},[],"**Crypto Engine**: engine where the key resides.",{"_2322":1630,"_22971":1548,"_15675":40807,"_5":15564,"_21706":40601,"_1911":40808},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2322":1631,"_22971":1548,"_15675":40810,"_5":15564,"_21706":40601,"_1911":40811},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2322":1632,"_22971":1548,"_15675":40813,"_5":15564,"_21706":40601,"_1911":40814},[],"The **Public Key** tab presents the public key in PEM format, ready to consult or copy.",{"_2322":1633,"_22971":1548,"_15675":40816,"_5":15564,"_21706":40605,"_1911":40817},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2322":1634,"_22971":1548,"_15675":40819,"_5":15564,"_21706":40605,"_1911":40820},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2322":1635,"_22971":1548,"_15675":40822,"_5":15564,"_21706":40609,"_1911":40823},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2322":1636,"_22971":1548,"_15675":40825,"_5":15564,"_21706":40609,"_1911":40826},[],"Main fields:",{"_2322":1637,"_22971":1548,"_15675":40828,"_5":15564,"_21706":40609,"_1911":40829},[],"**Algorithm**: signing algorithm available for the key type.",{"_2322":1638,"_22971":1548,"_15675":40831,"_5":15564,"_21706":40609,"_1911":40832},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2322":1639,"_22971":1548,"_15675":40834,"_5":15564,"_21706":40609,"_1911":40835},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2322":1640,"_22971":1548,"_15675":40837,"_5":15564,"_21706":40609,"_1911":40838},[],"**Message**: content to sign.",{"_2322":1641,"_22971":1548,"_15675":40840,"_5":15564,"_21706":40609,"_1911":40841},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2322":1642,"_22971":1548,"_15675":40843,"_5":15564,"_21706":40613,"_1911":40844},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2322":1643,"_22971":1548,"_15675":40846,"_5":15564,"_21706":40613,"_1911":40826},[],{"_2322":1644,"_22971":1548,"_15675":40848,"_5":15564,"_21706":40613,"_1911":40849},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2322":1645,"_22971":1548,"_15675":40851,"_5":15564,"_21706":40613,"_1911":40852},[],"**Message Type**: `Raw` or `Digest`.",{"_2322":1646,"_22971":1548,"_15675":40854,"_5":15564,"_21706":40613,"_1911":40855},[],"**Payload Encoding**: encoding of the message.",{"_2322":1647,"_22971":1548,"_15675":40857,"_5":15564,"_21706":40613,"_1911":40858},[],"**Message**: original message or hash.",{"_2322":1648,"_22971":1548,"_15675":40860,"_5":15564,"_21706":40613,"_1911":40861},[],"**Signature**: signature to check.",{"_2322":1649,"_22971":1548,"_15675":40863,"_5":15564,"_21706":40613,"_1911":40864},[],"**Result**: indicator of the validation result.",{"_2322":1650,"_22971":1548,"_15675":40866,"_5":15564,"_21706":40617,"_1911":40867},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2322":1651,"_22971":1548,"_15675":40869,"_5":15564,"_21706":40617,"_1911":40870},[],"This flow is useful for:",{"_2322":1652,"_22971":1548,"_15675":40872,"_5":15564,"_21706":40617,"_1911":40873},[],"Requesting certificates from an external CA.",{"_2322":1653,"_22971":1548,"_15675":40875,"_5":15564,"_21706":40617,"_1911":40876},[],"Renewing an identity while keeping the same key.",{"_2322":1654,"_22971":1548,"_15675":40878,"_5":15564,"_21706":40617,"_1911":40879},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2322":1655,"_22971":1548,"_15675":40881,"_5":15564,"_21706":40617,"_1911":40882},[],"**Common Name (CN)**: main name of the identity.",{"_2322":1656,"_22971":1548,"_15675":40884,"_5":15564,"_21706":40617,"_1911":40885},[],"**Organization (O)**: organization or company.",{"_2322":1657,"_22971":1548,"_15675":40887,"_5":15564,"_21706":40617,"_1911":40888},[],"**Organizational Unit (OU)**: department or unit.",{"_2322":1658,"_22971":1548,"_15675":40890,"_5":15564,"_21706":40617,"_1911":40891},[],"**Country (C)**: two-letter country code.",{"_2322":1659,"_22971":1548,"_15675":40893,"_5":15564,"_21706":40617,"_1911":40894},[],"**State / Province (ST)**: state or province.",{"_2322":1660,"_22971":1548,"_15675":40896,"_5":15564,"_21706":40617,"_1911":40897},[],"**Locality (L)**: city or locality.",{"_2322":1661,"_22971":1548,"_15675":40899,"_5":15564,"_21706":40617,"_1911":40900},[],"**Email Address**: contact email.",{"_2322":1662,"_22971":1548,"_15675":40902,"_5":15564,"_21706":40617,"_1911":40903},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2322":1663,"_22971":1548,"_15675":40905,"_5":15564,"_21706":40617,"_1911":40906},[],"Once the form is complete, Lamassu generates the CSR and presents it for download or copy.",{"_2322":1664,"_22971":1548,"_15675":40908,"_5":15564,"_21706":40621,"_1911":40909},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2322":1665,"_22971":1548,"_15675":40911,"_5":15564,"_21706":40621,"_1911":40912},[],"This option shows the steps needed to configure the local environment, load the PKCS#11 module and perform signatures with tools like OpenSSL without extracting the private key from the secured environment.",{"_2322":1666,"_22971":1666,"_5":10796,"_1911":40914,"_23246":40915,"_15675":40916,"_21706":1666},"Online validation with OCSP",[35713,36848,37382],[],{"_2322":1667,"_22971":1666,"_15675":40918,"_5":15564,"_21706":1666,"_1911":40919},[],"Check in real time whether a certificate is still valid or has been revoked.",{"_2322":1668,"_22971":1666,"_5":23243,"_15675":40921,"_21706":40922,"_1911":40923},[],"/docs/pr-preview/pr-28/platform/pki/ocsp#ocsp-service","OCSP service",{"_2322":1669,"_22971":1666,"_5":23243,"_15675":40925,"_21706":40926,"_1911":40927},[],"/docs/pr-preview/pr-28/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2322":1670,"_22971":1666,"_5":23243,"_15675":40929,"_21706":40930,"_1911":40931},[],"/docs/pr-preview/pr-28/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2322":1671,"_22971":1666,"_5":23243,"_15675":40933,"_21706":40934,"_1911":40935},[],"/docs/pr-preview/pr-28/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2322":1672,"_22971":1666,"_5":23243,"_15675":40937,"_21706":40938,"_1911":40939},[],"/docs/pr-preview/pr-28/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2322":1673,"_22971":1666,"_5":23243,"_15675":40941,"_21706":40942,"_1911":38877},[],"/docs/pr-preview/pr-28/platform/pki/ocsp#references",{"_2322":1674,"_22971":1666,"_15675":40944,"_5":15564,"_21706":40922,"_1911":40945},[],"OCSP (Online Certificate Status Protocol) is the mechanism that lets a relying party check, in real time, whether a specific certificate is valid or has been revoked. Instead of downloading a full list of revoked certificates, the client sends a query with the certificate's serial number and receives a signed response with the current status.",{"_2322":1675,"_22971":1666,"_15675":40947,"_5":15564,"_21706":40922,"_1911":40948},[],"Lamassu integrates its own OCSP responder that serves these queries by consulting the internal certificate database directly. No external component is required.",{"_2322":1676,"_22971":1666,"_15675":40950,"_5":15564,"_21706":40926,"_1911":40951},[],"When a client requests the status of a certificate, the responder locates the certificate by its serial number and determines its status from the internal record:",{"_2322":1677,"_22971":1666,"_15675":40953,"_5":15564,"_21706":40926,"_1911":40954},[],"If the certificate is active, the response indicates `Good`.",{"_2322":1678,"_22971":1666,"_15675":40956,"_5":15564,"_21706":40926,"_1911":40957},[],"If the certificate has been revoked, the response indicates `Revoked` and includes the revocation timestamp and the RFC 5280 reason code.",{"_2322":1679,"_22971":1666,"_15675":40959,"_5":15564,"_21706":40926,"_1911":40960},[],"If the serial number is not found or the status is not recognizable, the response indicates `Unknown`.",{"_2322":1680,"_22971":1666,"_15675":40962,"_5":15564,"_21706":40926,"_1911":40963},[],"The OCSP response is signed by the issuing CA of the queried certificate, using the cryptographic engine associated with that CA. Lamassu does not use a delegated OCSP signing certificate: the CA acts directly as the responder.",{"_2322":1681,"_22971":1666,"_15675":40965,"_5":15564,"_21706":40926,"_1911":40966},[],"Each response has a validity window of 24 hours, reflected in the response's `thisUpdate` and `nextUpdate` fields. Clients that cache responses must take this window into account when determining how long a response remains valid.",{"_2322":1682,"_22971":1666,"_15675":40968,"_5":15564,"_21706":40930,"_1911":40969},[],"The OCSP responder URL is automatically embedded in the AIA (*Authority Information Access*) extension of every certificate issued by Lamassu. Clients that verify certificates can read this URL directly from the certificate without additional configuration.",{"_2322":1683,"_22971":1666,"_15675":40971,"_5":15564,"_21706":40934,"_1911":40972},[],"The responder accepts both formats defined in RFC 6960:",{"_2322":1684,"_22971":1666,"_15675":40974,"_5":15564,"_21706":40934,"_1911":40975},[],"`GET /ocsp/{ocsp_request}` includes the OCSP request Base64url-encoded within the URL itself.",{"_2322":1685,"_22971":1666,"_15675":40977,"_5":15564,"_21706":40934,"_1911":40978},[],"`POST /ocsp` sends the request in the body with `Content-Type: application/ocsp-request`.",{"_2322":1686,"_22971":1666,"_15675":40980,"_5":15564,"_21706":40934,"_1911":40981},[],"Example query with `curl` using POST:",{"_2322":1687,"_22971":1666,"_15675":40983,"_5":15564,"_21706":40934,"_1911":40984},[],"The response has `Content-Type: application/ocsp-response` and contains the OCSP response in DER format.",{"_2322":1688,"_22971":1666,"_15675":40986,"_5":15564,"_21706":40938,"_1911":40987},[],"From the certificates screen of Lamassu you can launch an OCSP request directly against the selected certificate with the **OCSP Check** action. This action shows the status returned by the responder without needing external tools.",{"_2322":1689,"_22971":1666,"_15675":40989,"_5":15564,"_21706":40942,"_1911":40990},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_2322":1690,"_22971":1666,"_15675":40992,"_5":15564,"_21706":40942,"_1911":40993},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (revocation reasons, section 5.3.1)",{"_2322":1691,"_22971":1666,"_15675":40995,"_5":15564,"_21706":40942,"_1911":40996},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2322":1692,"_22971":1666,"_15675":40998,"_5":15564,"_21706":40942,"_1911":38969},[],{"_2322":1693,"_22971":1693,"_5":10796,"_1911":41000,"_23246":41001,"_15675":41002,"_21706":1693},"Lamassu IoT Platform",[35713,36848],[],{"_2322":1694,"_22971":1693,"_15675":41004,"_5":15564,"_21706":1693,"_1911":41005},[],"Manage PKI and digital identities for your devices from a single platform.",{"_2322":1695,"_22971":1693,"_5":23243,"_15675":41007,"_21706":41008,"_1911":41009},[],"/docs/pr-preview/pr-28/platform/pki/overview#start-here","Start here",{"_2322":1696,"_22971":1693,"_5":23243,"_15675":41011,"_21706":41012,"_1911":41013},[],"/docs/pr-preview/pr-28/platform/pki/overview#architecture-at-a-glance","Architecture at a glance",{"_2322":1697,"_22971":1693,"_5":23243,"_15675":41015,"_21706":41016,"_1911":41017},[],"/docs/pr-preview/pr-28/platform/pki/overview#core-capabilities","Core capabilities",{"_2322":1698,"_22971":1693,"_5":23243,"_15675":41019,"_21706":41020,"_1911":41021},[],"/docs/pr-preview/pr-28/platform/pki/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2322":1699,"_22971":1693,"_5":23243,"_15675":41023,"_21706":41024,"_1911":41025},[],"/docs/pr-preview/pr-28/platform/pki/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2322":1700,"_22971":1693,"_5":23243,"_15675":41027,"_21706":41028,"_1911":41029},[],"/docs/pr-preview/pr-28/platform/pki/overview#issue-and-control-certificates","Issue and control certificates",{"_2322":1701,"_22971":1693,"_5":23243,"_15675":41031,"_21706":41032,"_1911":41033},[],"/docs/pr-preview/pr-28/platform/pki/overview#automate-device-identities","Automate device identities",{"_2322":1702,"_22971":1693,"_5":23243,"_15675":41035,"_21706":41036,"_1911":41037},[],"/docs/pr-preview/pr-28/platform/pki/overview#publish-validation-status","Publish validation status",{"_2322":1703,"_22971":1693,"_5":23243,"_15675":41039,"_21706":41040,"_1911":41041},[],"/docs/pr-preview/pr-28/platform/pki/overview#react-to-events","React to events",{"_2322":1704,"_22971":1693,"_5":23243,"_15675":41043,"_21706":41044,"_1911":41045},[],"/docs/pr-preview/pr-28/platform/pki/overview#choose-your-path","Choose your path",{"_2322":1705,"_22971":1693,"_5":23243,"_15675":41047,"_21706":41048,"_1911":41049},[],"/docs/pr-preview/pr-28/platform/pki/overview#operational-reference","Operational reference",{"_2322":1706,"_22971":1693,"_15675":41051,"_5":15564,"_21706":1693,"_1911":41052},[],"Lamassu IoT centralizes the issuance, distribution, renewal and revocation of X.509 identities for connected devices. You can build a private PKI, protect its keys and automate the enrollment of a fleet without losing visibility into every certificate.",{"_2322":1707,"_22971":1693,"_15675":41054,"_5":15564,"_21706":41008,"_1911":41055},[],"<Card title=\"Get started\" description=\"Create a CA, issue a certificate and register your first device.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2322":1708,"_22971":1693,"_15675":41057,"_5":15564,"_21706":41008,"_1911":41058},[],"<Card title=\"How Lamassu works\" description=\"Build the mental model of authorities, keys, identities and validation.\" href=\"/docs/platform/pki/concepts/overview\" />",{"_2322":1709,"_22971":1693,"_15675":41060,"_5":15564,"_21706":41012,"_1911":41061},[],"Lamassu runs as a set of services on Kubernetes, backed by PostgreSQL, RabbitMQ and an OIDC provider. Hover a component to trace its connections, or see the platform architecture chapter for the low-level, per-service view.",{"_2322":1710,"_22971":1693,"_15675":41063,"_5":15564,"_21706":41020,"_1911":41064},[],"Create root and intermediate authorities or import an existing PKI. Define which authority can issue each identity and keep the full chain of trust.",{"_2322":1711,"_22971":1693,"_15675":41066,"_5":15564,"_21706":41024,"_1911":41067},[],"Generate and safeguard keys using software engines, PKCS#11 HSMs or cloud services. Lamassu decouples operations from the physical location of the key.",{"_2322":1712,"_22971":1693,"_15675":41069,"_5":15564,"_21706":41028,"_1911":41070},[],"Issue certificates from the console or from a CSR, check their status and revoke them when they stop being trustworthy.",{"_2322":1713,"_22971":1693,"_15675":41072,"_5":15564,"_21706":41032,"_1911":41073},[],"Define enrollment policies with a Device Management Service (DMS) and let devices request or renew their identity through EST.",{"_2322":1714,"_22971":1693,"_15675":41075,"_5":15564,"_21706":41036,"_1911":41076},[],"Offer online validation through OCSP and distribute CRLs for consumers that need to check certificates offline.",{"_2322":1715,"_22971":1693,"_15675":41078,"_5":15564,"_21706":41040,"_1911":41079},[],"Subscribe to lifecycle changes and send notifications by email, Microsoft Teams or webhooks.",{"_2322":1716,"_22971":1693,"_15675":41081,"_5":15564,"_21706":41044,"_1911":41082},[],"<Card title=\"I administer the PKI\" description=\"Configure engines, authorities, issuance and validation.\" href=\"/docs/platform/pki/key-management\" />",{"_2322":1717,"_22971":1693,"_15675":41084,"_5":15564,"_21706":41044,"_1911":41085},[],"<Card title=\"I integrate a device\" description=\"Configure the DMS and use EST to obtain an identity.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2322":1718,"_22971":1693,"_15675":41087,"_5":15564,"_21706":41044,"_1911":41088},[],"<Card title=\"I operate the platform\" description=\"Deploy Lamassu and prepare its dependencies.\" href=\"/docs/deployment/overview\" />",{"_2322":1719,"_22971":1693,"_15675":41090,"_5":15564,"_21706":41044,"_1911":41091},[],"<Card title=\"I integrate another system\" description=\"Connect Lamassu with AWS IoT Core and other destinations.\" href=\"/docs/platform/pki/integrations/aws-iot-core\" />",{"_2322":1720,"_22971":1693,"_15675":41093,"_5":15564,"_21706":41048,"_1911":41094},[],"<Card title=\"Certificate profiles\" description=\"Turn issuance policy into reusable constraints.\" href=\"/docs/platform/pki/certificate-profiles\" />",{"_2322":1721,"_22971":1693,"_15675":41096,"_5":15564,"_21706":41048,"_1911":41097},[],"<Card title=\"Hierarchy and rotation\" description=\"Replace CA certificates or keys without breaking trust.\" href=\"/docs/platform/pki/ca-hierarchy-and-rotation\" />",{"_2322":1722,"_22971":1693,"_15675":41099,"_5":15564,"_21706":41048,"_1911":41100},[],"<Card title=\"Access control\" description=\"Configure principals, policies and the first administrator.\" href=\"/docs/platform/pki/access-control\" />",{"_2322":1723,"_22971":1693,"_15675":41102,"_5":15564,"_21706":41048,"_1911":41103},[],"<Card title=\"Troubleshooting\" description=\"Diagnose the Gateway, services, issuance and enrollment.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2322":1724,"_22971":1724,"_5":10796,"_1911":41105,"_23246":41106,"_15675":41108,"_21706":1724},"Create your first CA",[35713,36848,41107],"Getting started",[],{"_2322":1725,"_22971":1724,"_15675":41110,"_5":15564,"_21706":1724,"_1911":41111},[],"Create a root authority and check that it is ready to issue certificates.",{"_2322":1726,"_22971":1724,"_5":23243,"_15675":41113,"_21706":41114,"_1911":35723},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2322":1727,"_22971":1724,"_5":23243,"_15675":41116,"_21706":41117,"_1911":41118},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2322":1728,"_22971":1724,"_5":23243,"_15675":41120,"_21706":41121,"_1911":41122},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2322":1729,"_22971":1724,"_5":23243,"_15675":41124,"_21706":41125,"_1911":41126},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2322":1730,"_22971":1724,"_5":23243,"_15675":41128,"_21706":41129,"_1911":41130},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2322":1731,"_22971":1724,"_5":23243,"_15675":41132,"_21706":41133,"_1911":41134},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2322":1732,"_22971":1724,"_5":23243,"_15675":41136,"_21706":41137,"_1911":35747},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2322":1733,"_22971":1724,"_15675":41139,"_5":15564,"_21706":1724,"_1911":41140},[],"In this quickstart you will create a root certification authority with a new key pair. When you finish you will have an active CA that you can use in the next quickstart.",{"_2322":1734,"_22971":1724,"_15675":41142,"_5":15564,"_21706":41114,"_1911":41143},[],"Console access with permissions to manage authorities.",{"_2322":1735,"_22971":1724,"_15675":41145,"_5":15564,"_21706":41114,"_1911":41146},[],"At least one cryptographic engine available.",{"_2322":1736,"_22971":1724,"_15675":41148,"_5":15564,"_21706":41114,"_1911":41149},[],"A name that identifies the purpose of the CA, for example `Acme Device Root CA`.",{"_2322":1737,"_22971":1724,"_15675":41151,"_5":15564,"_21706":41114,"_1911":41152},[],"A root CA is self-signed and acts as the anchor of trust. For production it is usually preferable to keep the root more protected and issue from an intermediate CA.",{"_2322":1738,"_22971":1724,"_15675":41154,"_5":15564,"_21706":41117,"_1911":41155},[],"In the side menu, open **Certification Authorities** and select **Create New CA**.",{"_2322":1739,"_22971":1724,"_15675":41157,"_5":15564,"_21706":41117,"_1911":41158},[],"Choose to create a CA with a new key pair. If you already have the key in the KMS, use &#x2A;*Create New CA (Existing Key)**.",{"_2322":1740,"_22971":1724,"_15675":41160,"_5":15564,"_21706":41121,"_1911":41161},[],"Choose the cryptographic engine that will keep the key and configure the algorithm. For a first CA you can use **EC P-384**, as long as it is compatible with your consumers.",{"_2322":1741,"_22971":1724,"_15675":41163,"_5":15564,"_21706":41121,"_1911":41164},[],"The private key will remain under the control of the selected engine.",{"_2322":1742,"_22971":1724,"_15675":41166,"_5":15564,"_21706":41125,"_1911":41167},[],"Select **Root CA** and complete:",{"_2322":1743,"_22971":1724,"_15675":41169,"_5":15564,"_21706":41125,"_1911":41170},[],"**CA Name**: a unique, recognizable name.",{"_2322":1744,"_22971":1724,"_15675":41172,"_5":15564,"_21706":41125,"_1911":41173},[],"**Subject**: at least the organization and country that will identify the authority.",{"_2322":1745,"_22971":1724,"_15675":41175,"_5":15564,"_21706":41125,"_1911":41176},[],"**CA Certificate Expiration**: a validity longer than that of the certificates it will issue.",{"_2322":1746,"_22971":1724,"_15675":41178,"_5":15564,"_21706":41125,"_1911":41179},[],"**Default End-Entity Certificate Issuance Expiration**: the default validity of end-entity certificates.",{"_2322":1747,"_22971":1724,"_15675":41181,"_5":15564,"_21706":41125,"_1911":41182},[],"The CA name will be used as the certificate's `Common Name`.",{"_2322":1748,"_22971":1724,"_15675":41184,"_5":15564,"_21706":41129,"_1911":41185},[],"Check the algorithm, subject and dates before confirming. These values define the anchor of trust and should not be chosen as throwaway test data in a production environment.",{"_2322":1749,"_22971":1724,"_15675":41187,"_5":15564,"_21706":41133,"_1911":41188},[],"Open the new CA from the list. It should appear active and show its PEM certificate, the expiration date and the **Issued Certificates** tab.",{"_2322":1750,"_22971":1724,"_15675":41190,"_5":15564,"_21706":41137,"_1911":41191},[],"Use the authority to issue your first certificate, or see the full authorities guide to create an intermediate CA, import a CA or define advanced profiles.",{"_2322":1751,"_22971":1751,"_5":10796,"_1911":41193,"_23246":41194,"_15675":41195,"_21706":1751},"Issue your first certificate",[35713,36848,41107],[],{"_2322":1752,"_22971":1751,"_15675":41197,"_5":15564,"_21706":1751,"_1911":41198},[],"Issue an X.509 identity from the console and verify the result.",{"_2322":1753,"_22971":1751,"_5":23243,"_15675":41200,"_21706":41201,"_1911":35723},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2322":1754,"_22971":1751,"_5":23243,"_15675":41203,"_21706":41204,"_1911":41205},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2322":1755,"_22971":1751,"_5":23243,"_15675":41207,"_21706":41208,"_1911":41209},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2322":1756,"_22971":1751,"_5":23243,"_15675":41211,"_21706":41212,"_1911":41213},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2322":1757,"_22971":1751,"_5":23243,"_15675":41215,"_21706":41216,"_1911":41217},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2322":1758,"_22971":1751,"_5":23243,"_15675":41219,"_21706":41220,"_1911":41221},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2322":1759,"_22971":1751,"_5":23243,"_15675":41223,"_21706":41224,"_1911":41134},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2322":1760,"_22971":1751,"_5":23243,"_15675":41226,"_21706":41227,"_1911":35747},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#next-step",{"_2322":1761,"_22971":1751,"_15675":41229,"_5":15564,"_21706":1751,"_1911":41230},[],"In this quickstart Lamassu will generate the key and the CSR in the browser, and the CA will issue the certificate. When you finish you will download the certificate and its private key.",{"_2322":1762,"_22971":1751,"_15675":41232,"_5":15564,"_21706":41201,"_1911":41233},[],"An active CA with permission to issue certificates.",{"_2322":1763,"_22971":1751,"_15675":41235,"_5":15564,"_21706":41201,"_1911":41236},[],"A name for the identity, for example `device-001.example.internal`.",{"_2322":1764,"_22971":1751,"_15675":41238,"_5":15564,"_21706":41201,"_1911":41239},[],"A safe place to keep the downloaded private key.",{"_2322":1765,"_22971":1751,"_15675":41241,"_5":15564,"_21706":41201,"_1911":41242},[],"In this flow the key is generated in the browser and Lamassu does not store it. Download it and protect it before closing the operation result.",{"_2322":1766,"_22971":1751,"_15675":41244,"_5":15564,"_21706":41204,"_1911":41245},[],"Open the CA created in the previous quickstart, go to **Issued Certificates** and select **Issue New**.",{"_2322":1767,"_22971":1751,"_15675":41247,"_5":15564,"_21706":41208,"_1911":41248},[],"Select **Generate Key & CSR in Browser**. Use **Upload Existing CSR** when the private key must be generated and kept on the target system.",{"_2322":1768,"_22971":1751,"_15675":41250,"_5":15564,"_21706":41212,"_1911":41251},[],"Enter the `Common Name` and, if applicable, the organization, organizational unit and location. Add SANs for each DNS name, IP address, email or URI the identity will be validated with.",{"_2322":1769,"_22971":1751,"_15675":41253,"_5":15564,"_21706":41216,"_1911":41254},[],"Choose RSA or ECDSA, define the validity and select the key usages. For a device identity that uses mTLS, enable **Digital Signature** and **Client Authentication**.",{"_2322":1770,"_22971":1751,"_15675":41256,"_5":15564,"_21706":41216,"_1911":41257},[],"The validity cannot exceed the expiration date of the issuing CA.",{"_2322":1771,"_22971":1751,"_15675":41259,"_5":15564,"_21706":41220,"_1911":41260},[],"Confirm the issuance and immediately download the certificate and the private key in PEM format.",{"_2322":1772,"_22971":1751,"_15675":41262,"_5":15564,"_21706":41224,"_1911":41263},[],"The certificate should appear in **Issued Certificates** with an active status. Check its subject, SANs, issuer, usages and validity period.",{"_2322":1773,"_22971":1751,"_15675":41265,"_5":15564,"_21706":41227,"_1911":41266},[],"Register your first device to associate the identity with a managed entity, or see certificate management.",{"_2322":1774,"_22971":1774,"_5":10796,"_1911":41268,"_23246":41269,"_15675":41270,"_21706":1774},"Get started",[35713,36848,41107],[],{"_2322":1775,"_22971":1774,"_15675":41272,"_5":15564,"_21706":1774,"_1911":41273},[],"Get a first result with Lamassu and continue from a working base.",{"_2322":1776,"_22971":1774,"_5":23243,"_15675":41275,"_21706":41276,"_1911":41277},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2322":1777,"_22971":1774,"_5":23243,"_15675":41279,"_21706":41280,"_1911":35723},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/overview#before-you-begin",{"_2322":1778,"_22971":1774,"_15675":41282,"_5":15564,"_21706":1774,"_1911":41283},[],"The quickstarts take you from a prepared instance to an active device identity. Each guide produces a verifiable result and links the detailed explanation when you need to go deeper.",{"_2322":1779,"_22971":1774,"_15675":41285,"_5":15564,"_21706":41276,"_1911":41286},[],"<Card title=\"1. Create your first CA\" description=\"Establish a root of trust capable of issuing certificates.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2322":1780,"_22971":1774,"_15675":41288,"_5":15564,"_21706":41276,"_1911":41289},[],"<Card title=\"2. Issue a certificate\" description=\"Create an X.509 identity and verify its contents.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2322":1781,"_22971":1774,"_15675":41291,"_5":15564,"_21706":41276,"_1911":41292},[],"<Card title=\"3. Register a device\" description=\"Add a device and assign it its first identity.\" href=\"/docs/platform/pki/quickstarts/register-device\" />",{"_2322":1782,"_22971":1774,"_15675":41294,"_5":15564,"_21706":41280,"_1911":41295},[],"You need access to the Lamassu IoT console and permissions to administer keys, authorities and devices. The instance must have at least one cryptographic engine configured.",{"_2322":1783,"_22971":1774,"_15675":41297,"_5":15564,"_21706":41280,"_1911":41298},[],"If you don't have an instance yet, first choose a deployment model.",{"_2322":1784,"_22971":1784,"_5":10796,"_1911":41300,"_23246":41301,"_15675":41302,"_21706":1784},"Register your first device",[35713,36848,41107],[],{"_2322":1785,"_22971":1784,"_15675":41304,"_5":15564,"_21706":1784,"_1911":41305},[],"Add a device to Lamassu and assign it an active identity.",{"_2322":1786,"_22971":1784,"_5":23243,"_15675":41307,"_21706":41308,"_1911":35723},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/register-device#before-you-begin",{"_2322":1787,"_22971":1784,"_5":23243,"_15675":41310,"_21706":41311,"_1911":41312},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/register-device#register-the-device","Register the device",{"_2322":1788,"_22971":1784,"_5":23243,"_15675":41314,"_21706":41315,"_1911":41316},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2322":1789,"_22971":1784,"_5":23243,"_15675":41318,"_21706":41319,"_1911":41320},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2322":1790,"_22971":1784,"_5":23243,"_15675":41322,"_21706":41323,"_1911":41324},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/register-device#verify-the-device","Verify the device",{"_2322":1791,"_22971":1784,"_5":23243,"_15675":41326,"_21706":41327,"_1911":41328},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2322":1792,"_22971":1784,"_15675":41330,"_5":15564,"_21706":1784,"_1911":41331},[],"In this quickstart you will manually register a device and assign it its first certificate. It is the shortest path to understanding how Lamassu relates a physical entity to its identity history.",{"_2322":1793,"_22971":1784,"_15675":41333,"_5":15564,"_21706":41308,"_1911":41334},[],"A configured DMS.",{"_2322":1794,"_22971":1784,"_15675":41336,"_5":15564,"_21706":41308,"_1911":41337},[],"A CA associated with the DMS.",{"_2322":1795,"_22971":1784,"_15675":41339,"_5":15564,"_21706":41308,"_1911":41340},[],"A unique identifier for the device.",{"_2322":1796,"_22971":1784,"_15675":41342,"_5":15564,"_21706":41311,"_1911":41343},[],"Open **Managed Devices**, select the action to register a device and complete:",{"_2322":1797,"_22971":1784,"_15675":41345,"_5":15564,"_21706":41311,"_1911":41346},[],"**Device ID**: unique identifier of the device.",{"_2322":1798,"_22971":1784,"_15675":41348,"_5":15564,"_21706":41311,"_1911":41349},[],"**Registration Authority**: the DMS that will apply the enrollment policies.",{"_2322":1799,"_22971":1784,"_15675":41351,"_5":15564,"_21706":41311,"_1911":41352},[],"**Icon** and **Tags**: optional classification to locate it later.",{"_2322":1800,"_22971":1784,"_15675":41354,"_5":15564,"_21706":41315,"_1911":41355},[],"Open the newly created device. It should appear with status **No Identity**: it exists in the inventory but does not yet have an associated certificate.",{"_2322":1801,"_22971":1784,"_15675":41357,"_5":15564,"_21706":41319,"_1911":41358},[],"Select **Assign Identity**. Lamassu will search for active certificates whose `Common Name` matches the `Device ID`.",{"_2322":1802,"_22971":1784,"_15675":41360,"_5":15564,"_21706":41319,"_1911":41361},[],"Select an existing certificate or use **Issue New Instead** to issue one from a CA linked to the DMS.",{"_2322":1803,"_22971":1784,"_15675":41363,"_5":15564,"_21706":41323,"_1911":41364},[],"After confirming, the status should change to **Active**. Review **Certificate History** to check the associated identity and **Device Event Timeline** to see the assignment event.",{"_2322":1804,"_22971":1784,"_15675":41366,"_5":15564,"_21706":41327,"_1911":41367},[],"Manual registration helps you understand the model, but a fleet should use automated enrollment. Continue with Device Management Service and the EST integration.",{"_2322":1805,"_22971":1805,"_5":10796,"_1911":40063,"_23246":41369,"_15675":41370,"_21706":1805},[35713,36848,36849],[],{"_2322":1806,"_22971":1805,"_15675":41372,"_5":15564,"_21706":1805,"_1911":41373},[],"Diagnose access, health, issuance, enrollment and dependencies in a Lamassu deployment.",{"_2322":1807,"_22971":1805,"_5":23243,"_15675":41375,"_21706":41376,"_1911":41377},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2322":1808,"_22971":1805,"_5":23243,"_15675":41379,"_21706":41380,"_1911":41381},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2322":1809,"_22971":1805,"_5":23243,"_15675":41383,"_21706":41384,"_1911":41385},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2322":1810,"_22971":1805,"_5":23243,"_15675":41387,"_21706":41388,"_1911":41389},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2322":1811,"_22971":1805,"_5":23243,"_15675":41391,"_21706":41392,"_1911":41393},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#query-the-affected-service","Query the affected service",{"_2322":1812,"_22971":1805,"_5":23243,"_15675":41395,"_21706":41396,"_1911":41397},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2322":1813,"_22971":1805,"_5":23243,"_15675":41399,"_21706":41400,"_1911":41401},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2322":1814,"_22971":1805,"_5":23243,"_15675":41403,"_21706":41404,"_1911":41405},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2322":1815,"_22971":1805,"_5":23243,"_15675":41407,"_21706":41408,"_1911":41409},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2322":1816,"_22971":1805,"_5":23243,"_15675":41411,"_21706":41412,"_1911":41413},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2322":1817,"_22971":1805,"_5":23243,"_15675":41415,"_21706":41416,"_1911":41417},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2322":1818,"_22971":1805,"_5":23243,"_15675":41419,"_21706":41420,"_1911":41421},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2322":1819,"_22971":1805,"_5":23243,"_15675":41423,"_21706":41424,"_1911":41425},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2322":1820,"_22971":1805,"_5":23243,"_15675":41427,"_21706":41428,"_1911":41429},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2322":1821,"_22971":1805,"_5":23243,"_15675":41431,"_21706":41432,"_1911":41433},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#observability","Observability",{"_2322":1822,"_22971":1805,"_15675":41435,"_5":15564,"_21706":1805,"_1911":41436},[],"Start by locating the failing layer. A Gateway response, an unready pod and a rejected issuance can look like the same problem from the console, but they require different evidence.",{"_2322":1823,"_22971":1805,"_15675":41438,"_5":15564,"_21706":41380,"_1911":41439},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2322":1824,"_22971":1805,"_15675":41441,"_5":15564,"_21706":41384,"_1911":41442},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2322":1825,"_22971":1805,"_15675":41444,"_5":15564,"_21706":41388,"_1911":41445},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2322":1826,"_22971":1805,"_15675":41447,"_5":15564,"_21706":41392,"_1911":41448},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2322":1827,"_22971":1805,"_15675":41450,"_5":15564,"_21706":41396,"_1911":41451},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2322":1828,"_22971":1805,"_15675":41453,"_5":15564,"_21706":41400,"_1911":41454},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2322":1829,"_22971":1805,"_15675":41456,"_5":15564,"_21706":41400,"_1911":41457},[],"Also run the chart's connectivity test:",{"_2322":1830,"_22971":1805,"_15675":41459,"_5":15564,"_21706":41400,"_1911":41460},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2322":1831,"_22971":1805,"_15675":41462,"_5":15564,"_21706":41400,"_1911":41463},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2322":1832,"_22971":1805,"_15675":41465,"_5":15564,"_21706":41404,"_1911":41466},[],"If you receive a 401:",{"_2322":1833,"_22971":1805,"_15675":41468,"_5":15564,"_21706":41404,"_1911":41469},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2322":1834,"_22971":1805,"_15675":41471,"_5":15564,"_21706":41404,"_1911":41472},[],"verify issuer, audience and expiration of the token;",{"_2322":1835,"_22971":1805,"_15675":41474,"_5":15564,"_21706":41404,"_1911":41475},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2322":1836,"_22971":1805,"_15675":41477,"_5":15564,"_21706":41404,"_1911":41478},[],"check that the provider's public and internal routes point to the same realm.",{"_2322":1837,"_22971":1805,"_15675":41480,"_5":15564,"_21706":41404,"_1911":41481},[],"If login succeeds but the APIs return 403:",{"_2322":1838,"_22971":1805,"_15675":41483,"_5":15564,"_21706":41404,"_1911":41484},[],"inspect the token's real claims;",{"_2322":1839,"_22971":1805,"_15675":41486,"_5":15564,"_21706":41404,"_1911":41487},[],"confirm they match an active principal;",{"_2322":1840,"_22971":1805,"_15675":41489,"_5":15564,"_21706":41404,"_1911":41490},[],"review the policies granted to that principal;",{"_2322":1841,"_22971":1805,"_15675":41492,"_5":15564,"_21706":41404,"_1911":41493},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2322":1842,"_22971":1805,"_15675":41495,"_5":15564,"_21706":41404,"_1911":41496},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2322":1843,"_22971":1805,"_15675":41498,"_5":15564,"_21706":41408,"_1911":41499},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2322":1844,"_22971":1805,"_15675":41501,"_5":15564,"_21706":41408,"_1911":41502},[],"Locate the authz pod and Service.",{"_2322":1845,"_22971":1805,"_15675":41504,"_5":15564,"_21706":41408,"_1911":41505},[],"Check /health, logs and its database connection.",{"_2322":1846,"_22971":1805,"_15675":41507,"_5":15564,"_21706":41408,"_1911":41508},[],"Verify the DNS and port configured in externalAuthorization.",{"_2322":1847,"_22971":1805,"_15675":41510,"_5":15564,"_21706":41408,"_1911":41511},[],"Check the check route is /v1/ext\\_authz/check.",{"_2322":1848,"_22971":1805,"_15675":41513,"_5":15564,"_21706":41408,"_1911":41514},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2322":1849,"_22971":1805,"_15675":41516,"_5":15564,"_21706":41412,"_1911":41517},[],"Review kubectl describe pod first. Common causes are:",{"_2322":1850,"_22971":1805,"_15675":41519,"_5":15564,"_21706":41412,"_1911":41520},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2322":1851,"_22971":1805,"_15675":41522,"_5":15564,"_21706":41412,"_1911":41523},[],"unbound persistent volume;",{"_2322":1852,"_22971":1805,"_15675":41525,"_5":15564,"_21706":41412,"_1911":41526},[],"inaccessible image or incorrect pull policy;",{"_2322":1853,"_22971":1805,"_15675":41528,"_5":15564,"_21706":41412,"_1911":41529},[],"invalid cryptographic engine configuration;",{"_2322":1854,"_22971":1805,"_15675":41531,"_5":15564,"_21706":41412,"_1911":41532},[],"CPU or memory limits set too low;",{"_2322":1855,"_22971":1805,"_15675":41534,"_5":15564,"_21706":41412,"_1911":41535},[],"an incomplete prior migration.",{"_2322":1856,"_22971":1805,"_15675":41537,"_5":15564,"_21706":41412,"_1911":41538},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2322":1857,"_22971":1805,"_15675":41540,"_5":15564,"_21706":41412,"_1911":41541},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2322":1858,"_22971":1805,"_15675":41543,"_5":15564,"_21706":41416,"_1911":41544},[],"Narrow the error following this order:",{"_2322":1859,"_22971":1805,"_15675":41546,"_5":15564,"_21706":41416,"_1911":41547},[],"The CA exists, is active and has not expired.",{"_2322":1860,"_22971":1805,"_15675":41549,"_5":15564,"_21706":41416,"_1911":41550},[],"The CA has a usable private key and the engine is available.",{"_2322":1861,"_22971":1805,"_15675":41552,"_5":15564,"_21706":41416,"_1911":41553},[],"The CSR has a valid signature.",{"_2322":1862,"_22971":1805,"_15675":41555,"_5":15564,"_21706":41416,"_1911":41556},[],"The profile allows the key type and size.",{"_2322":1863,"_22971":1805,"_15675":41558,"_5":15564,"_21706":41416,"_1911":41559},[],"The requested validity fits within the CA's lifetime.",{"_2322":1864,"_22971":1805,"_15675":41561,"_5":15564,"_21706":41416,"_1911":41562},[],"KU, EKU, subject and extensions comply with the profile.",{"_2322":1865,"_22971":1805,"_15675":41564,"_5":15564,"_21706":41416,"_1911":41565},[],"If the reissuance of a CA fails, remember it is not supported for a revoked or already-expired CA. To change its key, follow CA hierarchy and rotation.",{"_2322":1866,"_22971":1805,"_15675":41567,"_5":15564,"_21706":41420,"_1911":41568},[],"Check:",{"_2322":1867,"_22971":1805,"_15675":41570,"_5":15564,"_21706":41420,"_1911":41571},[],"the DMS identifier in the EST path;",{"_2322":1868,"_22971":1805,"_15675":41573,"_5":15564,"_21706":41420,"_1911":41574},[],"the configured authentication method;",{"_2322":1869,"_22971":1805,"_15675":41576,"_5":15564,"_21706":41420,"_1911":41577},[],"the chain presented by the client;",{"_2322":1870,"_22971":1805,"_15675":41579,"_5":15564,"_21706":41420,"_1911":41580},[],"the validation CAs and the level limit;",{"_2322":1871,"_22971":1805,"_15675":41582,"_5":15564,"_21706":41420,"_1911":41583},[],"the revocation status of the client certificate;",{"_2322":1872,"_22971":1805,"_15675":41585,"_5":15564,"_21706":41420,"_1911":41586},[],"the CSR signature;",{"_2322":1873,"_22971":1805,"_15675":41588,"_5":15564,"_21706":41420,"_1911":41589},[],"the CA and profile used for issuance;",{"_2322":1874,"_22971":1805,"_15675":41591,"_5":15564,"_21706":41420,"_1911":41592},[],"the re-enrollment window.",{"_2322":1875,"_22971":1805,"_15675":41594,"_5":15564,"_21706":41420,"_1911":41595},[],"During re-enrollment, Lamassu first tries to validate with the enrollment CA and then with the additional CAs. During a migration, keep the old CA in that second set until the overlap ends.",{"_2322":1876,"_22971":1805,"_15675":41597,"_5":15564,"_21706":41424,"_1911":41598},[],"Confirm the revocation was persisted and has reason and timestamp.",{"_2322":1877,"_22971":1805,"_15675":41600,"_5":15564,"_21706":41424,"_1911":41601},[],"Review VA configuration and logs.",{"_2322":1878,"_22971":1805,"_15675":41603,"_5":15564,"_21706":41424,"_1911":41604},[],"Check the CRL's periodicity and next update.",{"_2322":1879,"_22971":1805,"_15675":41606,"_5":15564,"_21706":41424,"_1911":41607},[],"Rule out intermediate caches in proxy and client.",{"_2322":1880,"_22971":1805,"_15675":41609,"_5":15564,"_21706":41424,"_1911":41610},[],"Verify the certificate points to the endpoint you are querying.",{"_2322":1881,"_22971":1805,"_15675":41612,"_5":15564,"_21706":41424,"_1911":41613},[],"Query by the correct serial number and issuer.",{"_2322":1882,"_22971":1805,"_15675":41615,"_5":15564,"_21706":41428,"_1911":41616},[],"Domain and audit events depend on the bus publisher:",{"_2322":1883,"_22971":1805,"_15675":41618,"_5":15564,"_21706":41428,"_1911":41619},[],"verify it is enabled in the emitting service;",{"_2322":1884,"_22971":1805,"_15675":41621,"_5":15564,"_21706":41428,"_1911":41622},[],"check AMQP connectivity and credentials;",{"_2322":1885,"_22971":1805,"_15675":41624,"_5":15564,"_21706":41428,"_1911":41625},[],"review exchange, routing key, queues and consumers;",{"_2322":1886,"_22971":1805,"_15675":41627,"_5":15564,"_21706":41428,"_1911":41628},[],"inspect dead-letter queues;",{"_2322":1887,"_22971":1805,"_15675":41630,"_5":15564,"_21706":41428,"_1911":41631},[],"alert on orphan durable queues and backlog growth.",{"_2322":1888,"_22971":1805,"_15675":41633,"_5":15564,"_21706":41428,"_1911":41634},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2322":1889,"_22971":1805,"_15675":41636,"_5":15564,"_21706":41432,"_1911":41637},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2322":1890,"_22971":1805,"_15675":41639,"_5":15564,"_21706":41432,"_1911":41640},[],"Before closing an incident, record:",{"_2322":1891,"_22971":1805,"_15675":41642,"_5":15564,"_21706":41432,"_1911":41643},[],"the confirmed cause;",{"_2322":1892,"_22971":1805,"_15675":41645,"_5":15564,"_21706":41432,"_1911":41646},[],"the time scope and affected resources;",{"_2322":1893,"_22971":1805,"_15675":41648,"_5":15564,"_21706":41432,"_1911":41649},[],"the commands or queries used;",{"_2322":1894,"_22971":1805,"_15675":41651,"_5":15564,"_21706":41432,"_1911":41652},[],"the applied change and how to revert it;",{"_2322":1895,"_22971":1805,"_15675":41654,"_5":15564,"_21706":41432,"_1911":41655},[],"validation from a consumer;",{"_2322":1896,"_22971":1805,"_15675":41657,"_5":15564,"_21706":41432,"_1911":41658},[],"the preventive action and its owner.",{"_2322":1897,"_22971":1897,"_5":10796,"_1911":41660,"_15675":41661,"_21706":1897},"Test",[],{"_2322":1898,"_22971":1897,"_15675":41663,"_5":15564,"_21706":1897,"_1911":41664},[],"A document to test Fumadocs",{"_2322":1899,"_22971":1897,"_5":23243,"_15675":41666,"_21706":41667,"_1911":41668},[],"/docs/pr-preview/pr-28/test#cards","Cards",{"_2322":1900,"_22971":1897,"_5":23243,"_15675":41670,"_21706":41671,"_1911":41672},[],"/docs/pr-preview/pr-28/test#codeblock","CodeBlock",{"_2322":1901,"_22971":1897,"_5":23243,"_15675":41674,"_21706":41675,"_1911":41676},[],"/docs/pr-preview/pr-28/test#list","List",{"_2322":1902,"_22971":1897,"_15675":41678,"_5":15564,"_21706":1897,"_1911":41679},[],"Hey there!",{"_2322":1903,"_22971":1897,"_15675":41681,"_5":15564,"_21706":41667,"_1911":41682},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_2322":1904,"_22971":1897,"_15675":41684,"_5":15564,"_21706":41667,"_1911":41685},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_2322":1905,