53":100596,"_32755":100600,"_32757":100603,"_32759":100606,"_32761":100608,"_32763":100610,"_32765":100612,"_32767":100614,"_32769":100617,"_32771":100620,"_32773":100623,"_32775":100626,"_32777":100629,"_32779":100631,"_32781":100634,"_32783":100636,"_32785":100639,"_32787":100642,"_32789":100645,"_32791":100647,"_32793":100650,"_32795":100653,"_32797":100656,"_32799":100659,"_32801":100662,"_32803":100665,"_32805":100668,"_32807":100671,"_32809":100674,"_32811":100677,"_32813":100680,"_32815":100683},{"_2802":56362,"_24443":56362,"_5":12033,"_2329":93575,"_24778":93576,"_17120":93579,"_23194":56362},"Despliega desde AWS Marketplace",[39822,93577,93578],"Despliegue","Otros modelos",[],{"_2802":56363,"_24443":56362,"_17120":93581,"_5":17015,"_23194":56362,"_2329":93582},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2802":56364,"_24443":56362,"_5":24775,"_17120":93584,"_23194":93585,"_2329":93586},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2802":56365,"_24443":56362,"_5":24775,"_17120":93588,"_23194":93589,"_2329":93590},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2802":56366,"_24443":56362,"_5":24775,"_17120":93592,"_23194":93593,"_2329":93594},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2802":56367,"_24443":56362,"_5":24775,"_17120":93596,"_23194":93597,"_2329":93598},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2802":56368,"_24443":56362,"_5":24775,"_17120":93600,"_23194":93601,"_2329":93602},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2802":56369,"_24443":56362,"_5":24775,"_17120":93604,"_23194":93605,"_2329":93606},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2802":56370,"_24443":56362,"_5":24775,"_17120":93608,"_23194":93609,"_2329":93610},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2802":56371,"_24443":56362,"_17120":93612,"_5":17015,"_23194":56362,"_2329":93613},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2802":56372,"_24443":56362,"_17120":93615,"_5":17015,"_23194":93585,"_2329":93616},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2802":56373,"_24443":56362,"_17120":93618,"_5":17015,"_23194":93585,"_2329":93619},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2802":56374,"_24443":56362,"_17120":93621,"_5":17015,"_23194":93585,"_2329":93622},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2802":56375,"_24443":56362,"_17120":93624,"_5":17015,"_23194":93589,"_2329":93625},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2802":56376,"_24443":56362,"_17120":93627,"_5":17015,"_23194":93589,"_2329":93628},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2802":56377,"_24443":56362,"_17120":93630,"_5":17015,"_23194":93589,"_2329":93631},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2802":56378,"_24443":56362,"_17120":93633,"_5":17015,"_23194":93593,"_2329":93634},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2802":56379,"_24443":56362,"_17120":93636,"_5":17015,"_23194":93597,"_2329":93637},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2802":56380,"_24443":56362,"_17120":93639,"_5":17015,"_23194":93601,"_2329":93640},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2802":56381,"_24443":56362,"_17120":93642,"_5":17015,"_23194":93605,"_2329":93643},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2802":56382,"_24443":56362,"_17120":93645,"_5":17015,"_23194":93609,"_2329":93646},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2802":56383,"_24443":56383,"_5":12033,"_2329":93648,"_24778":93649,"_17120":93650,"_23194":56383},"Despliega Lamassu",[39822,93577],[],{"_2802":56384,"_24443":56383,"_17120":93652,"_5":17015,"_23194":56383,"_2329":93653},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2802":56385,"_24443":56383,"_5":24775,"_17120":93655,"_23194":93656,"_2329":93657},[],"/docs/pr-preview/pr-28/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2802":56386,"_24443":56383,"_5":24775,"_17120":93659,"_23194":93660,"_2329":93661},[],"/docs/pr-preview/pr-28/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2802":56387,"_24443":56383,"_5":24775,"_17120":93663,"_23194":93664,"_2329":93665},[],"/docs/pr-preview/pr-28/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2802":56388,"_24443":56383,"_17120":93667,"_5":17015,"_23194":56383,"_2329":93668},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2802":56389,"_24443":56383,"_17120":93670,"_5":17015,"_23194":93656,"_2329":93671},[],"Modelo",{"_2802":56390,"_24443":56383,"_17120":93673,"_5":17015,"_23194":93656,"_2329":93674},[],"Recomendado para",{"_2802":56391,"_24443":56383,"_17120":93676,"_5":17015,"_23194":93656,"_2329":93677},[],"Quién opera la infraestructura",{"_2802":56392,"_24443":56383,"_17120":93679,"_5":17015,"_23194":93656,"_2329":93680},[],"Punto de partida",{"_2802":56393,"_24443":56383,"_17120":93682,"_5":17015,"_23194":93656,"_2329":39929},[],{"_2802":56394,"_24443":56383,"_17120":93684,"_5":17015,"_23194":93656,"_2329":93685},[],"Producción, entornos regulados y despliegues personalizados",{"_2802":56395,"_24443":56383,"_17120":93687,"_5":17015,"_23194":93656,"_2329":93688},[],"Tu equipo",{"_2802":56396,"_24443":56383,"_17120":93690,"_5":17015,"_23194":93656,"_2329":93691},[],"Helm o Fastlane",{"_2802":56397,"_24443":56383,"_17120":93693,"_5":17015,"_23194":93656,"_2329":39941},[],{"_2802":56398,"_24443":56383,"_17120":93695,"_5":17015,"_23194":93656,"_2329":93696},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2802":56399,"_24443":56383,"_17120":93698,"_5":17015,"_23194":93656,"_2329":93688},[],{"_2802":56400,"_24443":56383,"_17120":93700,"_5":17015,"_23194":93656,"_2329":93701},[],"Imagen preconfigurada en EC2",{"_2802":56401,"_24443":56383,"_17120":93703,"_5":17015,"_23194":93656,"_2329":39952},[],{"_2802":56402,"_24443":56383,"_17120":93705,"_5":17015,"_23194":93656,"_2329":93706},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2802":56403,"_24443":56383,"_17120":93708,"_5":17015,"_23194":93656,"_2329":39958},[],{"_2802":56404,"_24443":56383,"_17120":93710,"_5":17015,"_23194":93656,"_2329":93711},[],"Suscripción gestionada",{"_2802":56405,"_24443":56383,"_17120":93713,"_5":17015,"_23194":93656,"_2329":93714},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2802":56406,"_24443":56383,"_17120":93716,"_5":17015,"_23194":93656,"_2329":93717},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2802":56407,"_24443":56383,"_17120":93719,"_5":17015,"_23194":93656,"_2329":93720},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2802":56408,"_24443":56383,"_17120":93722,"_5":17015,"_23194":93660,"_2329":93723},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2802":56409,"_24443":56383,"_17120":93725,"_5":17015,"_23194":93664,"_2329":93726},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2802":56410,"_24443":56410,"_5":12033,"_2329":93728,"_24778":93729,"_17120":93730,"_23194":56410},"Utiliza Lamassu como SaaS",[39822,93577,93578],[],{"_2802":56411,"_24443":56410,"_17120":93732,"_5":17015,"_23194":56410,"_2329":93733},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2802":56412,"_24443":56410,"_5":24775,"_17120":93735,"_23194":93736,"_2329":93737},[],"/docs/pr-preview/pr-28/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2802":56413,"_24443":56410,"_5":24775,"_17120":93739,"_23194":93740,"_2329":93741},[],"/docs/pr-preview/pr-28/es/deployment/saas#planes","Planes",{"_2802":56414,"_24443":56410,"_5":24775,"_17120":93743,"_23194":93744,"_2329":93745},[],"/docs/pr-preview/pr-28/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2802":56415,"_24443":56410,"_17120":93747,"_5":17015,"_23194":56410,"_2329":93748},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2802":56416,"_24443":56410,"_17120":93750,"_5":17015,"_23194":93736,"_2329":93751},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2802":56417,"_24443":56410,"_17120":93753,"_5":17015,"_23194":93736,"_2329":93754},[],"Copias de seguridad automáticas.",{"_2802":56418,"_24443":56410,"_17120":93756,"_5":17015,"_23194":93736,"_2329":93757},[],"Actualizaciones de versión.",{"_2802":56419,"_24443":56410,"_17120":93759,"_5":17015,"_23194":93736,"_2329":93760},[],"Soporte técnico y SLA según el plan contratado.",{"_2802":56420,"_24443":56410,"_17120":93762,"_5":17015,"_23194":93740,"_2329":40013},[],{"_2802":56421,"_24443":56410,"_17120":93764,"_5":17015,"_23194":93740,"_2329":93765},[],"Dispositivos",{"_2802":56422,"_24443":56410,"_17120":93767,"_5":17015,"_23194":93740,"_2329":93768},[],"Soporte",{"_2802":56423,"_24443":56410,"_17120":93770,"_5":17015,"_23194":93740,"_2329":40022},[],{"_2802":56424,"_24443":56410,"_17120":93772,"_5":17015,"_23194":93740,"_2329":40025},[],{"_2802":56425,"_24443":56410,"_17120":93774,"_5":17015,"_23194":93740,"_2329":93775},[],"Hasta 1.000",{"_2802":56426,"_24443":56410,"_17120":93777,"_5":17015,"_23194":93740,"_2329":40031},[],{"_2802":56427,"_24443":56410,"_17120":93779,"_5":17015,"_23194":93740,"_2329":93780},[],"99,5 %",{"_2802":56428,"_24443":56410,"_17120":93782,"_5":17015,"_23194":93740,"_2329":40037},[],{"_2802":56429,"_24443":56410,"_17120":93784,"_5":17015,"_23194":93740,"_2329":93785},[],"Hasta 10.000",{"_2802":56430,"_24443":56410,"_17120":93787,"_5":17015,"_23194":93740,"_2329":93788},[],"Email y chat",{"_2802":56431,"_24443":56410,"_17120":93790,"_5":17015,"_23194":93740,"_2329":93791},[],"99,9 %",{"_2802":56432,"_24443":56410,"_17120":93793,"_5":17015,"_23194":93740,"_2329":40049},[],{"_2802":56433,"_24443":56410,"_17120":93795,"_5":17015,"_23194":93740,"_2329":93796},[],"Ilimitados",{"_2802":56434,"_24443":56410,"_17120":93798,"_5":17015,"_23194":93740,"_2329":93799},[],"Dedicado",{"_2802":56435,"_24443":56410,"_17120":93801,"_5":17015,"_23194":93740,"_2329":93802},[],"99,99 %",{"_2802":56436,"_24443":56410,"_17120":93804,"_5":17015,"_23194":93744,"_2329":93805},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2802":56437,"_24443":56410,"_17120":93807,"_5":17015,"_23194":93744,"_2329":93808},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2802":56438,"_24443":56438,"_5":12033,"_2329":40066,"_24778":93810,"_17120":93812,"_23194":56438},[39822,93577,93811],"Kubernetes autogestionado",[],{"_2802":56439,"_24443":56438,"_17120":93814,"_5":17015,"_23194":56438,"_2329":93815},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2802":56440,"_24443":56438,"_5":24775,"_17120":93817,"_23194":93818,"_2329":93819},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2802":56441,"_24443":56438,"_5":24775,"_17120":93821,"_23194":93822,"_2329":93823},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2802":56442,"_24443":56438,"_5":24775,"_17120":93825,"_23194":93826,"_2329":93827},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2802":56443,"_24443":56438,"_5":24775,"_17120":93829,"_23194":93830,"_2329":93831},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2802":56444,"_24443":56438,"_5":24775,"_17120":93833,"_23194":93834,"_2329":93835},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2802":56445,"_24443":56438,"_5":24775,"_17120":93837,"_23194":93838,"_2329":93839},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2802":56446,"_24443":56438,"_5":24775,"_17120":93841,"_23194":93842,"_2329":93843},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2802":56447,"_24443":56438,"_5":24775,"_17120":93845,"_23194":93846,"_2329":93847},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2802":56448,"_24443":56438,"_5":24775,"_17120":93849,"_23194":93850,"_2329":93851},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2802":56449,"_24443":56438,"_5":24775,"_17120":93853,"_23194":93854,"_2329":93855},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2802":56450,"_24443":56438,"_17120":93857,"_5":17015,"_23194":93818,"_2329":93858},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2802":56451,"_24443":56438,"_17120":93860,"_5":17015,"_23194":93818,"_2329":93861},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2802":56452,"_24443":56438,"_17120":93863,"_5":17015,"_23194":93822,"_2329":93864},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2802":56453,"_24443":56438,"_17120":93866,"_5":17015,"_23194":93822,"_2329":93867},[],"Fastlane instala o configura",{"_2802":56454,"_24443":56438,"_17120":93869,"_5":17015,"_23194":93822,"_2329":93870},[],"Tú sigues proporcionando",{"_2802":56455,"_24443":56438,"_17120":93872,"_5":17015,"_23194":93822,"_2329":93873},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2802":56456,"_24443":56438,"_17120":93875,"_5":17015,"_23194":93822,"_2329":93876},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2802":56457,"_24443":56438,"_17120":93878,"_5":17015,"_23194":93822,"_2329":93879},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2802":56458,"_24443":56438,"_17120":93881,"_5":17015,"_23194":93822,"_2329":93882},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2802":56459,"_24443":56438,"_17120":93884,"_5":17015,"_23194":93822,"_2329":93885},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2802":56460,"_24443":56438,"_17120":93887,"_5":17015,"_23194":93822,"_2329":93888},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2802":56461,"_24443":56438,"_17120":93890,"_5":17015,"_23194":93822,"_2329":93891},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2802":56462,"_24443":56438,"_17120":93893,"_5":17015,"_23194":93822,"_2329":93894},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2802":56463,"_24443":56438,"_17120":93896,"_5":17015,"_23194":93822,"_2329":93897},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2802":56464,"_24443":56438,"_17120":93899,"_5":17015,"_23194":93826,"_2329":93900},[],"Necesitas:",{"_2802":56465,"_24443":56438,"_17120":93902,"_5":17015,"_23194":93826,"_2329":93903},[],"un clúster Kubernetes existente",{"_2802":56466,"_24443":56438,"_17120":93905,"_5":17015,"_23194":93826,"_2329":93906},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2802":56467,"_24443":56438,"_17120":93908,"_5":17015,"_23194":93826,"_2329":40164},[],{"_2802":56468,"_24443":56438,"_17120":93910,"_5":17015,"_23194":93826,"_2329":19378},[],{"_2802":56469,"_24443":56438,"_17120":93912,"_5":17015,"_23194":93826,"_2329":93913},[],"`jq` solo si usas `--sample-data`",{"_2802":56470,"_24443":56438,"_17120":93915,"_5":17015,"_23194":93826,"_2329":93916},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2802":56471,"_24443":56438,"_17120":93918,"_5":17015,"_23194":93826,"_2329":93919},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2802":56472,"_24443":56438,"_17120":93921,"_5":17015,"_23194":93826,"_2329":93922},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2802":56473,"_24443":56438,"_17120":93924,"_5":17015,"_23194":93830,"_2329":93925},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2802":56474,"_24443":56438,"_17120":93927,"_5":17015,"_23194":93830,"_2329":93928},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2802":56475,"_24443":56438,"_17120":93930,"_5":17015,"_23194":93834,"_2329":93931},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2802":56476,"_24443":56438,"_17120":93933,"_5":17015,"_23194":93834,"_2329":93934},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2802":56477,"_24443":56438,"_17120":93936,"_5":17015,"_23194":93834,"_2329":93937},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2802":56478,"_24443":56438,"_17120":93939,"_5":17015,"_23194":93834,"_2329":93940},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2802":56479,"_24443":56438,"_17120":93942,"_5":17015,"_23194":93838,"_2329":93943},[],"Opción",{"_2802":56480,"_24443":56438,"_17120":93945,"_5":17015,"_23194":93838,"_2329":93946},[],"Valor predeterminado",{"_2802":56481,"_24443":56438,"_17120":93948,"_5":17015,"_23194":93838,"_2329":93949},[],"Propósito",{"_2802":56482,"_24443":56438,"_17120":93951,"_5":17015,"_23194":93838,"_2329":40208},[],{"_2802":56483,"_24443":56438,"_17120":93953,"_5":17015,"_23194":93838,"_2329":40211},[],{"_2802":56484,"_24443":56438,"_17120":93955,"_5":17015,"_23194":93838,"_2329":93956},[],"Muestra la ayuda",{"_2802":56485,"_24443":56438,"_17120":93958,"_5":17015,"_23194":93838,"_2329":40217},[],{"_2802":56486,"_24443":56438,"_17120":93960,"_5":17015,"_23194":93838,"_2329":93961},[],"contexto actual",{"_2802":56487,"_24443":56438,"_17120":93963,"_5":17015,"_23194":93838,"_2329":93964},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2802":56488,"_24443":56438,"_17120":93966,"_5":17015,"_23194":93838,"_2329":40226},[],{"_2802":56489,"_24443":56438,"_17120":93968,"_5":17015,"_23194":93838,"_2329":5230},[],{"_2802":56490,"_24443":56438,"_17120":93970,"_5":17015,"_23194":93838,"_2329":93971},[],"Omite prompts y genera credenciales para las dependencias",{"_2802":56491,"_24443":56438,"_17120":93973,"_5":17015,"_23194":93838,"_2329":40234},[],{"_2802":56492,"_24443":56438,"_17120":93975,"_5":17015,"_23194":93838,"_2329":40237},[],{"_2802":56493,"_24443":56438,"_17120":93977,"_5":17015,"_23194":93838,"_2329":93978},[],"Namespace de la instalación",{"_2802":56494,"_24443":56438,"_17120":93980,"_5":17015,"_23194":93838,"_2329":40243},[],{"_2802":56495,"_24443":56438,"_17120":93982,"_5":17015,"_23194":93838,"_2329":40246},[],{"_2802":56496,"_24443":56438,"_17120":93984,"_5":17015,"_23194":93838,"_2329":93985},[],"Dominio usado por la UI, OIDC y el certificado",{"_2802":56497,"_24443":56438,"_17120":93987,"_5":17015,"_23194":93838,"_2329":40252},[],{"_2802":56498,"_24443":56438,"_17120":93989,"_5":17015,"_23194":93838,"_2329":12253},[],{"_2802":56499,"_24443":56438,"_17120":93991,"_5":17015,"_23194":93838,"_2329":93992},[],"Versión del chart de Lamassu",{"_2802":56500,"_24443":56438,"_17120":93994,"_5":17015,"_23194":93838,"_2329":40260},[],{"_2802":56501,"_24443":56438,"_17120":93996,"_5":17015,"_23194":93838,"_2329":40263},[],{"_2802":56502,"_24443":56438,"_17120":93998,"_5":17015,"_23194":93838,"_2329":93999},[],"Puerto del listener HTTPS",{"_2802":56503,"_24443":56438,"_17120":94001,"_5":17015,"_23194":93838,"_2329":40269},[],{"_2802":56504,"_24443":56438,"_17120":94003,"_5":17015,"_23194":93838,"_2329":40272},[],{"_2802":56505,"_24443":56438,"_17120":94005,"_5":17015,"_23194":93838,"_2329":94006},[],"Puerto del listener HTTP",{"_2802":56506,"_24443":56438,"_17120":94008,"_5":17015,"_23194":93838,"_2329":40278},[],{"_2802":56507,"_24443":56438,"_17120":94010,"_5":17015,"_23194":93838,"_2329":40211},[],{"_2802":56508,"_24443":56438,"_17120":94012,"_5":17015,"_23194":93838,"_2329":94013},[],"Certificado PEM para TLS downstream",{"_2802":56509,"_24443":56438,"_17120":94015,"_5":17015,"_23194":93838,"_2329":40286},[],{"_2802":56510,"_24443":56438,"_17120":94017,"_5":17015,"_23194":93838,"_2329":40211},[],{"_2802":56511,"_24443":56438,"_17120":94019,"_5":17015,"_23194":93838,"_2329":94020},[],"Clave privada PEM para TLS downstream",{"_2802":56512,"_24443":56438,"_17120":94022,"_5":17015,"_23194":93838,"_2329":40294},[],{"_2802":56513,"_24443":56438,"_17120":94024,"_5":17015,"_23194":93838,"_2329":94025},[],"chart del repositorio",{"_2802":56514,"_24443":56438,"_17120":94027,"_5":17015,"_23194":93838,"_2329":94028},[],"Usa un chart local de Lamassu sin empaquetar",{"_2802":56515,"_24443":56438,"_17120":94030,"_5":17015,"_23194":93838,"_2329":40303},[],{"_2802":56516,"_24443":56438,"_17120":94032,"_5":17015,"_23194":93838,"_2329":94033},[],"detección automática",{"_2802":56517,"_24443":56438,"_17120":94035,"_5":17015,"_23194":93838,"_2329":94036},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2802":56518,"_24443":56438,"_17120":94038,"_5":17015,"_23194":93838,"_2329":40311},[],{"_2802":56519,"_24443":56438,"_17120":94040,"_5":17015,"_23194":93838,"_2329":5230},[],{"_2802":56520,"_24443":56438,"_17120":94042,"_5":17015,"_23194":93838,"_2329":94043},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2802":56521,"_24443":56438,"_17120":94045,"_5":17015,"_23194":93838,"_2329":40319},[],{"_2802":56522,"_24443":56438,"_17120":94047,"_5":17015,"_23194":93838,"_2329":5230},[],{"_2802":56523,"_24443":56438,"_17120":94049,"_5":17015,"_23194":93838,"_2329":94050},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2802":56524,"_24443":56438,"_17120":94052,"_5":17015,"_23194":93838,"_2329":40327},[],{"_2802":56525,"_24443":56438,"_17120":94054,"_5":17015,"_23194":93838,"_2329":5230},[],{"_2802":56526,"_24443":56438,"_17120":94056,"_5":17015,"_23194":93838,"_2329":94057},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2802":56527,"_24443":56438,"_17120":94059,"_5":17015,"_23194":93838,"_2329":40335},[],{"_2802":56528,"_24443":56438,"_17120":94061,"_5":17015,"_23194":93838,"_2329":40338},[],{"_2802":56529,"_24443":56438,"_17120":94063,"_5":17015,"_23194":93838,"_2329":94064},[],"Usa otro chart local de SoftHSM",{"_2802":56530,"_24443":56438,"_17120":94066,"_5":17015,"_23194":93838,"_2329":94067},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2802":56531,"_24443":56438,"_17120":94069,"_5":17015,"_23194":93842,"_2329":40347},[],{"_2802":56532,"_24443":56438,"_17120":94071,"_5":17015,"_23194":93842,"_2329":94072},[],"valida las herramientas locales y el clúster seleccionado",{"_2802":56533,"_24443":56438,"_17120":94074,"_5":17015,"_23194":93842,"_2329":94075},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2802":56534,"_24443":56438,"_17120":94077,"_5":17015,"_23194":93842,"_2329":94078},[],"crea el namespace",{"_2802":56535,"_24443":56438,"_17120":94080,"_5":17015,"_23194":93842,"_2329":94081},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2802":56536,"_24443":56438,"_17120":94083,"_5":17015,"_23194":93842,"_2329":94084},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2802":56537,"_24443":56438,"_17120":94086,"_5":17015,"_23194":93842,"_2329":94087},[],"instala RabbitMQ",{"_2802":56538,"_24443":56438,"_17120":94089,"_5":17015,"_23194":93842,"_2329":94090},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2802":56539,"_24443":56438,"_17120":94092,"_5":17015,"_23194":93842,"_2329":94093},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2802":56540,"_24443":56438,"_17120":94095,"_5":17015,"_23194":93842,"_2329":94096},[],"carga datos de ejemplo opcionalmente",{"_2802":56541,"_24443":56438,"_17120":94098,"_5":17015,"_23194":93842,"_2329":94099},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2802":56542,"_24443":56438,"_17120":94101,"_5":17015,"_23194":93846,"_2329":94102},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2802":56543,"_24443":56438,"_17120":94104,"_5":17015,"_23194":93846,"_2329":94105},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2802":56544,"_24443":56438,"_17120":94107,"_5":17015,"_23194":93850,"_2329":94108},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2802":56545,"_24443":56438,"_17120":94110,"_5":17015,"_23194":93850,"_2329":94111},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2802":56546,"_24443":56438,"_17120":94113,"_5":17015,"_23194":93850,"_2329":94114},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2802":56547,"_24443":56438,"_17120":94116,"_5":17015,"_23194":93854,"_2329":94117},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2802":56548,"_24443":56548,"_5":12033,"_2329":94119,"_24778":94120,"_17120":94121,"_23194":56548},"Instala con Helm",[39822,93577,93811],[],{"_2802":56549,"_24443":56548,"_17120":94123,"_5":17015,"_23194":56548,"_2329":94124},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2802":56550,"_24443":56548,"_5":24775,"_17120":94126,"_23194":94127,"_2329":94128},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2802":56551,"_24443":56548,"_5":24775,"_17120":94130,"_23194":94131,"_2329":93827},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2802":56552,"_24443":56548,"_5":24775,"_17120":94133,"_23194":94134,"_2329":94135},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2802":56553,"_24443":56548,"_5":24775,"_17120":94137,"_23194":94138,"_2329":94139},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2802":56554,"_24443":56548,"_5":24775,"_17120":94141,"_23194":94142,"_2329":94143},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2802":56555,"_24443":56548,"_5":24775,"_17120":94145,"_23194":94146,"_2329":94147},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2802":56556,"_24443":56548,"_5":24775,"_17120":94149,"_23194":94150,"_2329":94151},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2802":56557,"_24443":56548,"_5":24775,"_17120":94153,"_23194":94154,"_2329":94155},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2802":56558,"_24443":56548,"_5":24775,"_17120":94157,"_23194":94158,"_2329":94159},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2802":56559,"_24443":56548,"_17120":94161,"_5":17015,"_23194":94127,"_2329":94162},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2802":56560,"_24443":56548,"_17120":94164,"_5":17015,"_23194":94131,"_2329":94165},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2802":56561,"_24443":56548,"_17120":94167,"_5":17015,"_23194":94131,"_2329":94168},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2802":56562,"_24443":56548,"_17120":94170,"_5":17015,"_23194":94131,"_2329":94171},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2802":56563,"_24443":56548,"_17120":94173,"_5":17015,"_23194":94131,"_2329":94174},[],"un broker RabbitMQ accesible y sus credenciales",{"_2802":56564,"_24443":56548,"_17120":94176,"_5":17015,"_23194":94131,"_2329":94177},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2802":56565,"_24443":56548,"_17120":94179,"_5":17015,"_23194":94131,"_2329":94180},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2802":56566,"_24443":56548,"_17120":94182,"_5":17015,"_23194":94131,"_2329":94183},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2802":56567,"_24443":56548,"_17120":94185,"_5":17015,"_23194":94131,"_2329":94186},[],"una StorageClass y un diseño de tráfico externo",{"_2802":56568,"_24443":56548,"_17120":94188,"_5":17015,"_23194":94131,"_2329":94189},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2802":56569,"_24443":56548,"_17120":94191,"_5":17015,"_23194":94131,"_2329":94192},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2802":56570,"_24443":56548,"_17120":94194,"_5":17015,"_23194":94131,"_2329":94195},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2802":56571,"_24443":56548,"_17120":94197,"_5":17015,"_23194":94134,"_2329":94198},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2802":56572,"_24443":56548,"_17120":94200,"_5":17015,"_23194":94134,"_2329":94201},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2802":56573,"_24443":56548,"_17120":94203,"_5":17015,"_23194":94134,"_2329":94204},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2802":56574,"_24443":56548,"_17120":94206,"_5":17015,"_23194":94138,"_2329":94207},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2802":56575,"_24443":56548,"_17120":94209,"_5":17015,"_23194":94138,"_2329":94210},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2802":56576,"_24443":56548,"_17120":94212,"_5":17015,"_23194":94138,"_2329":94213},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2802":56577,"_24443":56548,"_17120":94215,"_5":17015,"_23194":94142,"_2329":94216},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2802":56578,"_24443":56548,"_17120":94218,"_5":17015,"_23194":94146,"_2329":94219},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2802":56579,"_24443":56548,"_17120":94221,"_5":17015,"_23194":94146,"_2329":94222},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2802":56580,"_24443":56548,"_17120":94224,"_5":17015,"_23194":94146,"_2329":94225},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2802":56581,"_24443":56548,"_17120":94227,"_5":17015,"_23194":94146,"_2329":94228},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2802":56582,"_24443":56548,"_17120":94230,"_5":17015,"_23194":94150,"_2329":94231},[],"Para instalar un checkout local:",{"_2802":56583,"_24443":56548,"_17120":94233,"_5":17015,"_23194":94154,"_2329":94234},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2802":56584,"_24443":56548,"_17120":94236,"_5":17015,"_23194":94154,"_2329":94237},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2802":56585,"_24443":56548,"_17120":94239,"_5":17015,"_23194":94158,"_2329":94240},[],"Antes de pasar a producción, revisa:",{"_2802":56586,"_24443":56548,"_17120":94242,"_5":17015,"_23194":94158,"_2329":94243},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2802":56587,"_24443":56548,"_17120":94245,"_5":17015,"_23194":94158,"_2329":94246},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2802":56588,"_24443":56548,"_17120":94248,"_5":17015,"_23194":94158,"_2329":94249},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2802":56589,"_24443":56548,"_17120":94251,"_5":17015,"_23194":94158,"_2329":94252},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2802":56590,"_24443":56548,"_17120":94254,"_5":17015,"_23194":94158,"_2329":94255},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2802":56591,"_24443":56548,"_17120":94257,"_5":17015,"_23194":94158,"_2329":94258},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2802":56592,"_24443":56548,"_17120":94260,"_5":17015,"_23194":94158,"_2329":94261},[],"SMTP, observabilidad y entrega de alertas",{"_2802":56593,"_24443":56548,"_17120":94263,"_5":17015,"_23194":94158,"_2329":94264},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2802":56594,"_24443":56548,"_17120":94266,"_5":17015,"_23194":94158,"_2329":94267},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2802":56595,"_24443":56595,"_5":12033,"_2329":94269,"_24778":94270,"_17120":94271,"_23194":56595},"Expón el Gateway",[39822,93577,93811],[],{"_2802":56596,"_24443":56595,"_17120":94273,"_5":17015,"_23194":56595,"_2329":94274},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2802":56597,"_24443":56595,"_5":24775,"_17120":94276,"_23194":94277,"_2329":94278},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2802":56598,"_24443":56595,"_5":24775,"_17120":94280,"_23194":94281,"_2329":94282},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2802":56599,"_24443":56595,"_5":24775,"_17120":94284,"_23194":94285,"_2329":94286},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2802":56600,"_24443":56595,"_5":24775,"_17120":94288,"_23194":94289,"_2329":40568},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#k3s",{"_2802":56601,"_24443":56595,"_5":24775,"_17120":94291,"_23194":94292,"_2329":94293},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2802":56602,"_24443":56595,"_5":24775,"_17120":94295,"_23194":94296,"_2329":94297},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2802":56603,"_24443":56595,"_5":24775,"_17120":94299,"_23194":94300,"_2329":94301},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2802":56604,"_24443":56595,"_5":24775,"_17120":94303,"_23194":94304,"_2329":94305},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2802":56605,"_24443":56595,"_5":24775,"_17120":94307,"_23194":94308,"_2329":94309},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2802":56606,"_24443":56595,"_17120":94311,"_5":17015,"_23194":94277,"_2329":94312},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2802":56607,"_24443":56595,"_17120":94314,"_5":17015,"_23194":94277,"_2329":94315},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2802":56608,"_24443":56595,"_17120":94317,"_5":17015,"_23194":94281,"_2329":94318},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2802":56609,"_24443":56595,"_17120":94320,"_5":17015,"_23194":94281,"_2329":94321},[],"Defínelo únicamente cuando:",{"_2802":56610,"_24443":56595,"_17120":94323,"_5":17015,"_23194":94281,"_2329":94324},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2802":56611,"_24443":56595,"_17120":94326,"_5":17015,"_23194":94281,"_2329":94327},[],"esa dirección está asignada a este Gateway",{"_2802":56612,"_24443":56595,"_17120":94329,"_5":17015,"_23194":94281,"_2329":94330},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2802":56613,"_24443":56595,"_17120":94332,"_5":17015,"_23194":94281,"_2329":94333},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2802":56614,"_24443":56595,"_17120":94335,"_5":17015,"_23194":94281,"_2329":94336},[],"No confundas estos valores:",{"_2802":56615,"_24443":56595,"_17120":94338,"_5":17015,"_23194":94281,"_2329":94339},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2802":56616,"_24443":56595,"_17120":94341,"_5":17015,"_23194":94281,"_2329":94342},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2802":56617,"_24443":56595,"_17120":94344,"_5":17015,"_23194":94281,"_2329":94345},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2802":56618,"_24443":56595,"_17120":94347,"_5":17015,"_23194":94285,"_2329":94348},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2802":56619,"_24443":56595,"_17120":94350,"_5":17015,"_23194":94285,"_2329":94351},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2802":56620,"_24443":56595,"_17120":94353,"_5":17015,"_23194":94289,"_2329":94354},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2802":56621,"_24443":56595,"_17120":94356,"_5":17015,"_23194":94289,"_2329":94357},[],"Para el diseño recomendado:",{"_2802":56622,"_24443":56595,"_17120":94359,"_5":17015,"_23194":94289,"_2329":94360},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2802":56623,"_24443":56595,"_17120":94362,"_5":17015,"_23194":94289,"_2329":94363},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2802":56624,"_24443":56595,"_17120":94365,"_5":17015,"_23194":94289,"_2329":94366},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2802":56625,"_24443":56595,"_17120":94368,"_5":17015,"_23194":94289,"_2329":94369},[],"Apunta DNS a la dirección accesible de la VM.",{"_2802":56626,"_24443":56595,"_17120":94371,"_5":17015,"_23194":94289,"_2329":94372},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2802":56627,"_24443":56595,"_17120":94374,"_5":17015,"_23194":94292,"_2329":94375},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2802":56628,"_24443":56595,"_17120":94377,"_5":17015,"_23194":94296,"_2329":94378},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2802":56629,"_24443":56595,"_17120":94380,"_5":17015,"_23194":94296,"_2329":94381},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2802":56630,"_24443":56595,"_17120":94383,"_5":17015,"_23194":94300,"_2329":94384},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2802":56631,"_24443":56595,"_17120":94386,"_5":17015,"_23194":94300,"_2329":94387},[],"Requisito",{"_2802":56632,"_24443":56595,"_17120":94389,"_5":17015,"_23194":94300,"_2329":94390},[],"Diseño recomendado",{"_2802":56633,"_24443":56595,"_17120":94392,"_5":17015,"_23194":94300,"_2329":94393},[],"Consecuencia",{"_2802":56634,"_24443":56595,"_17120":94395,"_5":17015,"_23194":94300,"_2329":94396},[],"Varias URL o servicios de Lamassu",{"_2802":56635,"_24443":56595,"_17120":94398,"_5":17015,"_23194":94300,"_2329":94399},[],"Un Gateway con varias rutas",{"_2802":56636,"_24443":56595,"_17120":94401,"_5":17015,"_23194":94300,"_2329":94402},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2802":56637,"_24443":56595,"_17120":94404,"_5":17015,"_23194":94300,"_2329":94405},[],"Gateways independientes e IP externas distintas",{"_2802":56638,"_24443":56595,"_17120":94407,"_5":17015,"_23194":94300,"_2329":94408},[],"Una VIP por Gateway",{"_2802":56639,"_24443":56595,"_17120":94410,"_5":17015,"_23194":94300,"_2329":94411},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2802":56640,"_24443":56595,"_17120":94413,"_5":17015,"_23194":94300,"_2329":94414},[],"Gateways independientes, un nodo y una IP",{"_2802":56641,"_24443":56595,"_17120":94416,"_5":17015,"_23194":94300,"_2329":94417},[],"Puertos externos diferentes",{"_2802":56642,"_24443":56595,"_17120":94419,"_5":17015,"_23194":94300,"_2329":94420},[],"Los clientes deben indicar puertos no estándar",{"_2802":56643,"_24443":56595,"_17120":94422,"_5":17015,"_23194":94300,"_2329":94423},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2802":56644,"_24443":56595,"_17120":94425,"_5":17015,"_23194":94300,"_2329":94426},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2802":56645,"_24443":56595,"_17120":94428,"_5":17015,"_23194":94300,"_2329":94429},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2802":56646,"_24443":56595,"_17120":94431,"_5":17015,"_23194":94300,"_2329":94432},[],"Recursos Gateway separados pero proxy compartido",{"_2802":56647,"_24443":56595,"_17120":94434,"_5":17015,"_23194":94300,"_2329":94435},[],"Modo merged Gateway de Envoy",{"_2802":56648,"_24443":56595,"_17120":94437,"_5":17015,"_23194":94300,"_2329":94438},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2802":56649,"_24443":56595,"_17120":94440,"_5":17015,"_23194":94300,"_2329":94441},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2802":56650,"_24443":56595,"_17120":94443,"_5":17015,"_23194":94300,"_2329":94444},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2802":56651,"_24443":56595,"_17120":94446,"_5":17015,"_23194":94300,"_2329":94447},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2802":56652,"_24443":56595,"_17120":94449,"_5":17015,"_23194":94300,"_2329":94450},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2802":56653,"_24443":56595,"_17120":94452,"_5":17015,"_23194":94304,"_2329":94453},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2802":56654,"_24443":56595,"_17120":94455,"_5":17015,"_23194":94304,"_2329":94456},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2802":56655,"_24443":56595,"_17120":94458,"_5":17015,"_23194":94304,"_2329":94459},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2802":56656,"_24443":56595,"_17120":94461,"_5":17015,"_23194":94304,"_2329":94462},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2802":56657,"_24443":56595,"_17120":94464,"_5":17015,"_23194":94304,"_2329":94465},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2802":56658,"_24443":56595,"_17120":94467,"_5":17015,"_23194":94308,"_2329":94468},[],"Comprueba, en orden:",{"_2802":56659,"_24443":56595,"_17120":94470,"_5":17015,"_23194":94308,"_2329":94471},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2802":56660,"_24443":56595,"_17120":94473,"_5":17015,"_23194":94308,"_2329":94474},[],"Su estado contiene la dirección esperada.",{"_2802":56661,"_24443":56595,"_17120":94476,"_5":17015,"_23194":94308,"_2329":94477},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2802":56662,"_24443":56595,"_17120":94479,"_5":17015,"_23194":94308,"_2329":94480},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2802":56663,"_24443":56595,"_17120":94482,"_5":17015,"_23194":94308,"_2329":94483},[],"DNS resuelve al endpoint accesible externamente.",{"_2802":56664,"_24443":56595,"_17120":94485,"_5":17015,"_23194":94308,"_2329":94486},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2802":56665,"_24443":56595,"_17120":94488,"_5":17015,"_23194":94308,"_2329":94489},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2802":56666,"_24443":56666,"_5":12033,"_2329":39929,"_24778":94491,"_17120":94492,"_23194":56666},[39822,93577,93811],[],{"_2802":56667,"_24443":56666,"_17120":94494,"_5":17015,"_23194":56666,"_2329":94495},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2802":56668,"_24443":56666,"_5":24775,"_17120":94497,"_23194":94498,"_2329":94499},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2802":56669,"_24443":56666,"_5":24775,"_17120":94501,"_23194":94502,"_2329":94503},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2802":56670,"_24443":56666,"_5":24775,"_17120":94505,"_23194":94506,"_2329":94507},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2802":56671,"_24443":56666,"_5":24775,"_17120":94509,"_23194":94510,"_2329":94511},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2802":56672,"_24443":56666,"_5":24775,"_17120":94513,"_23194":94514,"_2329":94515},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2802":56673,"_24443":56666,"_5":24775,"_17120":94517,"_23194":94518,"_2329":94519},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2802":56674,"_24443":56666,"_17120":94521,"_5":17015,"_23194":94498,"_2329":94522},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2802":56675,"_24443":56666,"_17120":94524,"_5":17015,"_23194":94502,"_2329":94525},[],"Flujo",{"_2802":56676,"_24443":56666,"_17120":94527,"_5":17015,"_23194":94502,"_2329":94528},[],"Úsalo para",{"_2802":56677,"_24443":56666,"_17120":94530,"_5":17015,"_23194":94502,"_2329":94531},[],"Qué instala",{"_2802":56678,"_24443":56666,"_17120":94533,"_5":17015,"_23194":94502,"_2329":40813},[],{"_2802":56679,"_24443":56666,"_17120":94535,"_5":17015,"_23194":94502,"_2329":94536},[],"Producción y entornos controlados",{"_2802":56680,"_24443":56666,"_17120":94538,"_5":17015,"_23194":94502,"_2329":94539},[],"Servicios de Lamassu y recursos de Gateway API",{"_2802":56681,"_24443":56666,"_17120":94541,"_5":17015,"_23194":94502,"_2329":40066},[],{"_2802":56682,"_24443":56666,"_17120":94543,"_5":17015,"_23194":94502,"_2329":94544},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2802":56683,"_24443":56666,"_17120":94546,"_5":17015,"_23194":94502,"_2329":94547},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2802":56684,"_24443":56666,"_17120":94549,"_5":17015,"_23194":94506,"_2329":94550},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2802":56685,"_24443":56666,"_17120":94552,"_5":17015,"_23194":94506,"_2329":94553},[],"Área",{"_2802":56686,"_24443":56666,"_17120":94555,"_5":17015,"_23194":94506,"_2329":94556},[],"El chart de Lamassu proporciona",{"_2802":56687,"_24443":56666,"_17120":94558,"_5":17015,"_23194":94506,"_2329":94559},[],"Tú proporcionas",{"_2802":56688,"_24443":56666,"_17120":94561,"_5":17015,"_23194":94506,"_2329":94562},[],"Aplicaciones Lamassu",{"_2802":56689,"_24443":56666,"_17120":94564,"_5":17015,"_23194":94506,"_2329":94565},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2802":56690,"_24443":56666,"_17120":94567,"_5":17015,"_23194":94506,"_2329":94568},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2802":56691,"_24443":56666,"_17120":94570,"_5":17015,"_23194":94506,"_2329":94571},[],"Datos PostgreSQL",{"_2802":56692,"_24443":56666,"_17120":94573,"_5":17015,"_23194":94506,"_2329":94574},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2802":56693,"_24443":56666,"_17120":94576,"_5":17015,"_23194":94506,"_2329":94577},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2802":56694,"_24443":56666,"_17120":94579,"_5":17015,"_23194":94506,"_2329":94580},[],"Mensajería",{"_2802":56695,"_24443":56666,"_17120":94582,"_5":17015,"_23194":94506,"_2329":94583},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2802":56696,"_24443":56666,"_17120":94585,"_5":17015,"_23194":94506,"_2329":94586},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2802":56697,"_24443":56666,"_17120":94588,"_5":17015,"_23194":94506,"_2329":94589},[],"Identidad",{"_2802":56698,"_24443":56666,"_17120":94591,"_5":17015,"_23194":94506,"_2329":94592},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2802":56699,"_24443":56666,"_17120":94594,"_5":17015,"_23194":94506,"_2329":94595},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2802":56700,"_24443":56666,"_17120":94597,"_5":17015,"_23194":94506,"_2329":94598},[],"Enrutamiento externo",{"_2802":56701,"_24443":56666,"_17120":94600,"_5":17015,"_23194":94506,"_2329":94601},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2802":56702,"_24443":56666,"_17120":94603,"_5":17015,"_23194":94506,"_2329":94604},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2802":56703,"_24443":56666,"_17120":94606,"_5":17015,"_23194":94506,"_2329":40887},[],{"_2802":56704,"_24443":56666,"_17120":94608,"_5":17015,"_23194":94506,"_2329":94609},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2802":56705,"_24443":56666,"_17120":94611,"_5":17015,"_23194":94506,"_2329":94612},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2802":56706,"_24443":56666,"_17120":94614,"_5":17015,"_23194":94506,"_2329":94615},[],"Datos persistentes de la aplicación",{"_2802":56707,"_24443":56666,"_17120":94617,"_5":17015,"_23194":94506,"_2329":94618},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2802":56708,"_24443":56666,"_17120":94620,"_5":17015,"_23194":94506,"_2329":94621},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2802":56709,"_24443":56666,"_17120":94623,"_5":17015,"_23194":94506,"_2329":94624},[],"Integraciones opcionales",{"_2802":56710,"_24443":56666,"_17120":94626,"_5":17015,"_23194":94506,"_2329":94627},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2802":56711,"_24443":56666,"_17120":94629,"_5":17015,"_23194":94506,"_2329":94630},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2802":56712,"_24443":56666,"_17120":94632,"_5":17015,"_23194":94506,"_2329":94633},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2802":56713,"_24443":56666,"_17120":94635,"_5":17015,"_23194":94506,"_2329":94636},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2802":56714,"_24443":56666,"_17120":94638,"_5":17015,"_23194":94510,"_2329":94639},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2802":56715,"_24443":56666,"_17120":94641,"_5":17015,"_23194":94510,"_2329":94642},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2802":56716,"_24443":56666,"_17120":94644,"_5":17015,"_23194":94514,"_2329":94645},[],"Kubernetes 1.24 o posterior",{"_2802":56717,"_24443":56666,"_17120":94647,"_5":17015,"_23194":94514,"_2329":94648},[],"Helm 3.2 o posterior",{"_2802":56718,"_24443":56666,"_17120":94650,"_5":17015,"_23194":94514,"_2329":94651},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2802":56719,"_24443":56666,"_17120":94653,"_5":17015,"_23194":94514,"_2329":94654},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2802":56720,"_24443":56666,"_17120":94656,"_5":17015,"_23194":94514,"_2329":94657},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2802":56721,"_24443":56666,"_17120":94659,"_5":17015,"_23194":94514,"_2329":94660},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2802":56722,"_24443":56666,"_17120":94662,"_5":17015,"_23194":94514,"_2329":94663},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2802":56723,"_24443":56666,"_17120":94665,"_5":17015,"_23194":94518,"_2329":94666},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2802":56724,"_24443":56666,"_17120":94668,"_5":17015,"_23194":94518,"_2329":94669},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2802":56725,"_24443":56666,"_17120":94671,"_5":17015,"_23194":94518,"_2329":94672},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2802":56726,"_24443":56726,"_5":12033,"_2329":94674,"_24778":94675,"_17120":94677,"_23194":56726},"Resolución de problemas de despliegue",[39822,93577,94676],"Operación",[],{"_2802":56727,"_24443":56726,"_17120":94679,"_5":17015,"_23194":56726,"_2329":94680},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2802":56728,"_24443":56726,"_5":24775,"_17120":94682,"_23194":94683,"_2329":94684},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2802":56729,"_24443":56726,"_5":24775,"_17120":94686,"_23194":94687,"_2329":94688},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2802":56730,"_24443":56726,"_5":24775,"_17120":94690,"_23194":94691,"_2329":94692},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2802":56731,"_24443":56726,"_5":24775,"_17120":94694,"_23194":94695,"_2329":94696},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2802":56732,"_24443":56726,"_5":24775,"_17120":94698,"_23194":94699,"_2329":94700},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2802":56733,"_24443":56726,"_5":24775,"_17120":94702,"_23194":94703,"_2329":94704},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2802":56734,"_24443":56726,"_5":24775,"_17120":94706,"_23194":94707,"_2329":94708},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2802":56735,"_24443":56726,"_5":24775,"_17120":94710,"_23194":94711,"_2329":94712},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2802":56736,"_24443":56726,"_5":24775,"_17120":94714,"_23194":94715,"_2329":94716},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2802":56737,"_24443":56726,"_5":24775,"_17120":94718,"_23194":94719,"_2329":94720},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2802":56738,"_24443":56726,"_5":24775,"_17120":94722,"_23194":94723,"_2329":94724},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2802":56739,"_24443":56726,"_5":24775,"_17120":94726,"_23194":94727,"_2329":94728},[],"/docs/pr-preview/pr-28/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2802":56740,"_24443":56726,"_17120":94730,"_5":17015,"_23194":56726,"_2329":94731},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2802":56741,"_24443":56726,"_17120":94733,"_5":17015,"_23194":94687,"_2329":94734},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2802":56742,"_24443":56726,"_17120":94736,"_5":17015,"_23194":94691,"_2329":94737},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2802":56743,"_24443":56726,"_17120":94739,"_5":17015,"_23194":94695,"_2329":94740},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2802":56744,"_24443":56726,"_17120":94742,"_5":17015,"_23194":94699,"_2329":94743},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2802":56745,"_24443":56726,"_17120":94745,"_5":17015,"_23194":94703,"_2329":94746},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2802":56746,"_24443":56726,"_17120":94748,"_5":17015,"_23194":94707,"_2329":94749},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2802":56747,"_24443":56726,"_17120":94751,"_5":17015,"_23194":94707,"_2329":94752},[],"Ejecuta también la prueba de conectividad del chart:",{"_2802":56748,"_24443":56726,"_17120":94754,"_5":17015,"_23194":94707,"_2329":94755},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2802":56749,"_24443":56726,"_17120":94757,"_5":17015,"_23194":94707,"_2329":94758},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2802":56750,"_24443":56726,"_17120":94760,"_5":17015,"_23194":94711,"_2329":94761},[],"Si recibes un 401:",{"_2802":56751,"_24443":56726,"_17120":94763,"_5":17015,"_23194":94711,"_2329":94764},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2802":56752,"_24443":56726,"_17120":94766,"_5":17015,"_23194":94711,"_2329":94767},[],"verifica emisor, audiencia y expiración del token;",{"_2802":56753,"_24443":56726,"_17120":94769,"_5":17015,"_23194":94711,"_2329":94770},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2802":56754,"_24443":56726,"_17120":94772,"_5":17015,"_23194":94711,"_2329":94773},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2802":56755,"_24443":56726,"_17120":94775,"_5":17015,"_23194":94711,"_2329":94776},[],"Si el login termina pero las APIs devuelven 403:",{"_2802":56756,"_24443":56726,"_17120":94778,"_5":17015,"_23194":94711,"_2329":94779},[],"inspecciona los claims reales del token;",{"_2802":56757,"_24443":56726,"_17120":94781,"_5":17015,"_23194":94711,"_2329":94782},[],"confirma que coinciden con un principal activo;",{"_2802":56758,"_24443":56726,"_17120":94784,"_5":17015,"_23194":94711,"_2329":94785},[],"revisa las políticas concedidas al principal;",{"_2802":56759,"_24443":56726,"_17120":94787,"_5":17015,"_23194":94711,"_2329":94788},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2802":56760,"_24443":56726,"_17120":94790,"_5":17015,"_23194":94711,"_2329":94791},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2802":56761,"_24443":56726,"_17120":94793,"_5":17015,"_23194":94715,"_2329":94794},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2802":56762,"_24443":56726,"_17120":94796,"_5":17015,"_23194":94715,"_2329":94797},[],"Localiza el pod y Service de authz.",{"_2802":56763,"_24443":56726,"_17120":94799,"_5":17015,"_23194":94715,"_2329":94800},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2802":56764,"_24443":56726,"_17120":94802,"_5":17015,"_23194":94715,"_2329":94803},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2802":56765,"_24443":56726,"_17120":94805,"_5":17015,"_23194":94715,"_2329":94806},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2802":56766,"_24443":56726,"_17120":94808,"_5":17015,"_23194":94715,"_2329":94809},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2802":56767,"_24443":56726,"_17120":94811,"_5":17015,"_23194":94719,"_2329":94812},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2802":56768,"_24443":56726,"_17120":94814,"_5":17015,"_23194":94719,"_2329":94815},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2802":56769,"_24443":56726,"_17120":94817,"_5":17015,"_23194":94719,"_2329":94818},[],"volumen persistente sin enlazar;",{"_2802":56770,"_24443":56726,"_17120":94820,"_5":17015,"_23194":94719,"_2329":94821},[],"imagen inaccesible o política de pull incorrecta;",{"_2802":56771,"_24443":56726,"_17120":94823,"_5":17015,"_23194":94719,"_2329":94824},[],"configuración inválida del motor criptográfico;",{"_2802":56772,"_24443":56726,"_17120":94826,"_5":17015,"_23194":94719,"_2329":94827},[],"límites de CPU o memoria demasiado bajos;",{"_2802":56773,"_24443":56726,"_17120":94829,"_5":17015,"_23194":94719,"_2329":94830},[],"migración previa incompleta.",{"_2802":56774,"_24443":56726,"_17120":94832,"_5":17015,"_23194":94719,"_2329":94833},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2802":56775,"_24443":56726,"_17120":94835,"_5":17015,"_23194":94719,"_2329":94836},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2802":56776,"_24443":56726,"_17120":94838,"_5":17015,"_23194":94723,"_2329":94839},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2802":56777,"_24443":56726,"_17120":94841,"_5":17015,"_23194":94723,"_2329":94842},[],"verifica que esté habilitado en el servicio emisor;",{"_2802":56778,"_24443":56726,"_17120":94844,"_5":17015,"_23194":94723,"_2329":94845},[],"comprueba conectividad y credenciales AMQP;",{"_2802":56779,"_24443":56726,"_17120":94847,"_5":17015,"_23194":94723,"_2329":94848},[],"revisa exchange, routing key, colas y consumidores;",{"_2802":56780,"_24443":56726,"_17120":94850,"_5":17015,"_23194":94723,"_2329":94851},[],"inspecciona dead-letter queues;",{"_2802":56781,"_24443":56726,"_17120":94853,"_5":17015,"_23194":94723,"_2329":94854},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2802":56782,"_24443":56726,"_17120":94856,"_5":17015,"_23194":94723,"_2329":94857},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2802":56783,"_24443":56726,"_17120":94859,"_5":17015,"_23194":94727,"_2329":94860},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2802":56784,"_24443":56726,"_17120":94862,"_5":17015,"_23194":94727,"_2329":94863},[],"Antes de cerrar una incidencia, guarda:",{"_2802":56785,"_24443":56726,"_17120":94865,"_5":17015,"_23194":94727,"_2329":94866},[],"causa confirmada;",{"_2802":56786,"_24443":56726,"_17120":94868,"_5":17015,"_23194":94727,"_2329":94869},[],"alcance temporal y recursos afectados;",{"_2802":56787,"_24443":56726,"_17120":94871,"_5":17015,"_23194":94727,"_2329":94872},[],"comandos o consultas utilizados;",{"_2802":56788,"_24443":56726,"_17120":94874,"_5":17015,"_23194":94727,"_2329":94875},[],"cambio aplicado y forma de revertirlo;",{"_2802":56789,"_24443":56726,"_17120":94877,"_5":17015,"_23194":94727,"_2329":94878},[],"validación desde un consumidor;",{"_2802":56790,"_24443":56726,"_17120":94880,"_5":17015,"_23194":94727,"_2329":94881},[],"acción preventiva y propietario.",{"_2802":56791,"_24443":56791,"_5":12033,"_2329":94883,"_24778":94884,"_17120":94887,"_23194":56791},"Control de acceso",[39822,94885,94886],"Plataforma","Administración",[],{"_2802":56792,"_24443":56791,"_17120":94889,"_5":17015,"_23194":56791,"_2329":94890},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2802":56793,"_24443":56791,"_5":24775,"_17120":94892,"_23194":94893,"_2329":94894},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2802":56794,"_24443":56791,"_5":24775,"_17120":94896,"_23194":94897,"_2329":94898},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2802":56795,"_24443":56791,"_5":24775,"_17120":94900,"_23194":94901,"_2329":94902},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2802":56796,"_24443":56791,"_5":24775,"_17120":94904,"_23194":94905,"_2329":94906},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2802":56797,"_24443":56791,"_5":24775,"_17120":94908,"_23194":94909,"_2329":94910},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2802":56798,"_24443":56791,"_5":24775,"_17120":94912,"_23194":94913,"_2329":94914},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2802":56799,"_24443":56791,"_5":24775,"_17120":94916,"_23194":94917,"_2329":94918},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2802":56800,"_24443":56791,"_5":24775,"_17120":94920,"_23194":94921,"_2329":94922},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2802":56801,"_24443":56791,"_5":24775,"_17120":94924,"_23194":94925,"_2329":94926},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2802":56802,"_24443":56791,"_5":24775,"_17120":94928,"_23194":94929,"_2329":94930},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2802":56803,"_24443":56791,"_5":24775,"_17120":94932,"_23194":94933,"_2329":94934},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2802":56804,"_24443":56791,"_5":24775,"_17120":94936,"_23194":94937,"_2329":94938},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2802":56805,"_24443":56791,"_5":24775,"_17120":94940,"_23194":94941,"_2329":94942},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2802":56806,"_24443":56791,"_5":24775,"_17120":94944,"_23194":94945,"_2329":94946},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2802":56807,"_24443":56791,"_5":24775,"_17120":94948,"_23194":94949,"_2329":94950},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2802":56808,"_24443":56791,"_5":24775,"_17120":94952,"_23194":94953,"_2329":94147},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2802":56809,"_24443":56791,"_5":24775,"_17120":94955,"_23194":94956,"_2329":94957},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2802":56810,"_24443":56791,"_5":24775,"_17120":94959,"_23194":94960,"_2329":94961},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2802":56811,"_24443":56791,"_5":24775,"_17120":94963,"_23194":94964,"_2329":94965},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2802":56812,"_24443":56791,"_5":24775,"_17120":94967,"_23194":94968,"_2329":94969},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2802":56813,"_24443":56791,"_5":24775,"_17120":94971,"_23194":94972,"_2329":94973},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2802":56814,"_24443":56791,"_5":24775,"_17120":94975,"_23194":94976,"_2329":94977},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2802":56815,"_24443":56791,"_5":24775,"_17120":94979,"_23194":94980,"_2329":94981},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2802":56816,"_24443":56791,"_5":24775,"_17120":94983,"_23194":94984,"_2329":94985},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2802":56817,"_24443":56791,"_5":24775,"_17120":94987,"_23194":94988,"_2329":94989},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2802":56818,"_24443":56791,"_5":24775,"_17120":94991,"_23194":94992,"_2329":94993},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2802":56819,"_24443":56791,"_5":24775,"_17120":94995,"_23194":94996,"_2329":94997},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2802":56820,"_24443":56791,"_5":24775,"_17120":94999,"_23194":95000,"_2329":95001},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2802":56821,"_24443":56791,"_5":24775,"_17120":95003,"_23194":95004,"_2329":95005},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2802":56822,"_24443":56791,"_5":24775,"_17120":95007,"_23194":95008,"_2329":95009},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2802":56823,"_24443":56791,"_5":24775,"_17120":95011,"_23194":95012,"_2329":95013},[],"/docs/pr-preview/pr-28/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2802":56824,"_24443":56791,"_17120":95015,"_5":17015,"_23194":56791,"_2329":95016},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2802":56825,"_24443":56791,"_17120":95018,"_5":17015,"_23194":56791,"_2329":95019},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2802":56826,"_24443":56791,"_17120":95021,"_5":17015,"_23194":56791,"_2329":95022},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2802":56827,"_24443":56791,"_17120":95024,"_5":17015,"_23194":94893,"_2329":95025},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2802":56828,"_24443":56791,"_17120":95027,"_5":17015,"_23194":94893,"_2329":95028},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2802":56829,"_24443":56791,"_17120":95030,"_5":17015,"_23194":94893,"_2329":95031},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2802":56830,"_24443":56791,"_17120":95033,"_5":17015,"_23194":94893,"_2329":95034},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2802":56831,"_24443":56791,"_17120":95036,"_5":17015,"_23194":94893,"_2329":95037},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2802":56832,"_24443":56791,"_17120":95039,"_5":17015,"_23194":94893,"_2329":95040},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2802":56833,"_24443":56791,"_17120":95042,"_5":17015,"_23194":94897,"_2329":95043},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2802":56834,"_24443":56791,"_17120":95045,"_5":17015,"_23194":94897,"_2329":95046},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2802":56835,"_24443":56791,"_17120":95048,"_5":17015,"_23194":94901,"_2329":95049},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2802":56836,"_24443":56791,"_17120":95051,"_5":17015,"_23194":94901,"_2329":95052},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2802":56837,"_24443":56791,"_17120":95054,"_5":17015,"_23194":94901,"_2329":95055},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2802":56838,"_24443":56791,"_17120":95057,"_5":17015,"_23194":94901,"_2329":95058},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2802":56839,"_24443":56791,"_17120":95060,"_5":17015,"_23194":94901,"_2329":95061},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2802":56840,"_24443":56791,"_17120":95063,"_5":17015,"_23194":94901,"_2329":95064},[],"Carga por separado las políticas concedidas a cada principal.",{"_2802":56841,"_24443":56791,"_17120":95066,"_5":17015,"_23194":94901,"_2329":95067},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2802":56842,"_24443":56791,"_17120":95069,"_5":17015,"_23194":94901,"_2329":95070},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2802":56843,"_24443":56791,"_17120":95072,"_5":17015,"_23194":94901,"_2329":95073},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2802":56844,"_24443":56791,"_17120":95075,"_5":17015,"_23194":94901,"_2329":95076},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2802":56845,"_24443":56791,"_17120":95078,"_5":17015,"_23194":94901,"_2329":95079},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en `x-current-user`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2802":56846,"_24443":56791,"_17120":95081,"_5":17015,"_23194":94901,"_2329":95082},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2802":56847,"_24443":56791,"_17120":95084,"_5":17015,"_23194":94905,"_2329":95085},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2802":56848,"_24443":56791,"_17120":95087,"_5":17015,"_23194":94905,"_2329":95088},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2802":56849,"_24443":56791,"_17120":95090,"_5":17015,"_23194":94905,"_2329":95091},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2802":56850,"_24443":56791,"_17120":95093,"_5":17015,"_23194":94905,"_2329":95094},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2802":56851,"_24443":56791,"_17120":95096,"_5":17015,"_23194":94905,"_2329":95097},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2802":56852,"_24443":56791,"_17120":95099,"_5":17015,"_23194":94905,"_2329":95100},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2802":56853,"_24443":56791,"_17120":95102,"_5":17015,"_23194":94905,"_2329":95103},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2802":56854,"_24443":56791,"_17120":95105,"_5":17015,"_23194":94905,"_2329":95106},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2802":56855,"_24443":56791,"_17120":95108,"_5":17015,"_23194":94909,"_2329":95109},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2802":56856,"_24443":56791,"_17120":95111,"_5":17015,"_23194":94909,"_2329":95112},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2802":56857,"_24443":56791,"_17120":95114,"_5":17015,"_23194":94909,"_2329":95115},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2802":56858,"_24443":56791,"_17120":95117,"_5":17015,"_23194":94909,"_2329":95118},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2802":56859,"_24443":56791,"_17120":95120,"_5":17015,"_23194":94909,"_2329":95121},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2802":56860,"_24443":56791,"_17120":95123,"_5":17015,"_23194":94909,"_2329":95124},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2802":56861,"_24443":56791,"_17120":95126,"_5":17015,"_23194":94909,"_2329":95127},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2802":56862,"_24443":56791,"_17120":95129,"_5":17015,"_23194":94909,"_2329":95130},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2802":56863,"_24443":56791,"_17120":95132,"_5":17015,"_23194":94909,"_2329":95133},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2802":56864,"_24443":56791,"_17120":95135,"_5":17015,"_23194":94909,"_2329":95136},[],"Las acciones se dividen en dos grupos:",{"_2802":56865,"_24443":56791,"_17120":95138,"_5":17015,"_23194":94909,"_2329":95139},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2802":56866,"_24443":56791,"_17120":95141,"_5":17015,"_23194":94909,"_2329":95142},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2802":56867,"_24443":56791,"_17120":95144,"_5":17015,"_23194":94909,"_2329":95145},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2802":56868,"_24443":56791,"_17120":95147,"_5":17015,"_23194":94913,"_2329":95148},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2802":56869,"_24443":56791,"_17120":95150,"_5":17015,"_23194":94913,"_2329":95151},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2802":56870,"_24443":56791,"_17120":95153,"_5":17015,"_23194":94913,"_2329":95154},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2802":56871,"_24443":56791,"_17120":95156,"_5":17015,"_23194":94917,"_2329":95157},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2802":56872,"_24443":56791,"_17120":95159,"_5":17015,"_23194":94917,"_2329":95160},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2802":56873,"_24443":56791,"_17120":95162,"_5":17015,"_23194":94917,"_2329":95163},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2802":56874,"_24443":56791,"_17120":95165,"_5":17015,"_23194":94917,"_2329":95166},[],"Los operadores implementados son:",{"_2802":56875,"_24443":56791,"_17120":95168,"_5":17015,"_23194":94917,"_2329":95169},[],"`equals`, para igualdad exacta;",{"_2802":56876,"_24443":56791,"_17120":95171,"_5":17015,"_23194":94917,"_2329":95172},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2802":56877,"_24443":56791,"_17120":95174,"_5":17015,"_23194":94917,"_2329":95175},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2802":56878,"_24443":56791,"_17120":95177,"_5":17015,"_23194":94917,"_2329":95178},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2802":56879,"_24443":56791,"_17120":95180,"_5":17015,"_23194":94921,"_2329":95181},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2802":56880,"_24443":56791,"_17120":95183,"_5":17015,"_23194":94921,"_2329":95184},[],"Los modos disponibles son:",{"_2802":56881,"_24443":56791,"_17120":95186,"_5":17015,"_23194":94921,"_2329":95187},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2802":56882,"_24443":56791,"_17120":95189,"_5":17015,"_23194":94921,"_2329":95190},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2802":56883,"_24443":56791,"_17120":95192,"_5":17015,"_23194":94921,"_2329":95193},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2802":56884,"_24443":56791,"_17120":95195,"_5":17015,"_23194":94921,"_2329":95196},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2802":56885,"_24443":56791,"_17120":95198,"_5":17015,"_23194":94921,"_2329":95199},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2802":56886,"_24443":56791,"_17120":95201,"_5":17015,"_23194":94921,"_2329":95202},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2802":56887,"_24443":56791,"_17120":95204,"_5":17015,"_23194":94925,"_2329":95205},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2802":56888,"_24443":56791,"_17120":95207,"_5":17015,"_23194":94925,"_2329":95208},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2802":56889,"_24443":56791,"_17120":95210,"_5":17015,"_23194":94925,"_2329":95211},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2802":56890,"_24443":56791,"_17120":95213,"_5":17015,"_23194":94925,"_2329":95214},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2802":56891,"_24443":56791,"_17120":95216,"_5":17015,"_23194":94933,"_2329":95217},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2802":56892,"_24443":56791,"_17120":95219,"_5":17015,"_23194":94933,"_2329":95220},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2802":56893,"_24443":56791,"_17120":95222,"_5":17015,"_23194":94937,"_2329":95223},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2802":56894,"_24443":56791,"_17120":95225,"_5":17015,"_23194":94937,"_2329":95226},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2802":56895,"_24443":56791,"_17120":95228,"_5":17015,"_23194":94941,"_2329":95229},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2802":56896,"_24443":56791,"_17120":95231,"_5":17015,"_23194":94941,"_2329":95232},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2802":56897,"_24443":56791,"_17120":95234,"_5":17015,"_23194":94941,"_2329":95235},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2802":56898,"_24443":56791,"_17120":95237,"_5":17015,"_23194":94945,"_2329":95238},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2802":56899,"_24443":56791,"_17120":95240,"_5":17015,"_23194":94945,"_2329":95241},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2802":56900,"_24443":56791,"_17120":95243,"_5":17015,"_23194":94945,"_2329":95244},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2802":56901,"_24443":56791,"_17120":95246,"_5":17015,"_23194":94945,"_2329":95247},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2802":56902,"_24443":56791,"_17120":95249,"_5":17015,"_23194":94945,"_2329":95250},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2802":56903,"_24443":56791,"_17120":95252,"_5":17015,"_23194":94945,"_2329":95253},[],"Ten en cuenta que:",{"_2802":56904,"_24443":56791,"_17120":95255,"_5":17015,"_23194":94945,"_2329":95256},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2802":56905,"_24443":56791,"_17120":95258,"_5":17015,"_23194":94945,"_2329":95259},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2802":56906,"_24443":56791,"_17120":95261,"_5":17015,"_23194":94945,"_2329":95262},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2802":56907,"_24443":56791,"_17120":95264,"_5":17015,"_23194":94949,"_2329":95265},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2802":56908,"_24443":56791,"_17120":95267,"_5":17015,"_23194":94949,"_2329":95268},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2802":56909,"_24443":56791,"_17120":95270,"_5":17015,"_23194":94949,"_2329":95271},[],"acceso completo y de solo lectura a KMS;",{"_2802":56910,"_24443":56791,"_17120":95273,"_5":17015,"_23194":94949,"_2329":95274},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2802":56911,"_24443":56791,"_17120":95276,"_5":17015,"_23194":94949,"_2329":95277},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2802":56912,"_24443":56791,"_17120":95279,"_5":17015,"_23194":94949,"_2329":95280},[],"acceso a la interfaz;",{"_2802":56913,"_24443":56791,"_17120":95282,"_5":17015,"_23194":94949,"_2329":95283},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2802":56914,"_24443":56791,"_17120":95285,"_5":17015,"_23194":94949,"_2329":95286},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2802":56915,"_24443":56791,"_17120":95288,"_5":17015,"_23194":94949,"_2329":95289},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2802":56916,"_24443":56791,"_17120":95291,"_5":17015,"_23194":94953,"_2329":95292},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2802":56917,"_24443":56791,"_17120":95294,"_5":17015,"_23194":94953,"_2329":95295},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2802":56918,"_24443":56791,"_17120":95297,"_5":17015,"_23194":94953,"_2329":95298},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2802":56919,"_24443":56791,"_17120":95300,"_5":17015,"_23194":94956,"_2329":95301},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2802":56920,"_24443":56791,"_17120":95303,"_5":17015,"_23194":94960,"_2329":95304},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2802":56921,"_24443":56791,"_17120":95306,"_5":17015,"_23194":94964,"_2329":95307},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2802":56922,"_24443":56791,"_17120":95309,"_5":17015,"_23194":94968,"_2329":95310},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2802":56923,"_24443":56791,"_17120":95312,"_5":17015,"_23194":94972,"_2329":95313},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2802":56924,"_24443":56791,"_17120":95315,"_5":17015,"_23194":94976,"_2329":95316},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2802":56925,"_24443":56791,"_17120":95318,"_5":17015,"_23194":94976,"_2329":95319},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2802":56926,"_24443":56791,"_17120":95321,"_5":17015,"_23194":94980,"_2329":95322},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2802":56927,"_24443":56791,"_17120":95324,"_5":17015,"_23194":94980,"_2329":95325},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2802":56928,"_24443":56791,"_17120":95327,"_5":17015,"_23194":94980,"_2329":95328},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2802":56929,"_24443":56791,"_17120":95330,"_5":17015,"_23194":94980,"_2329":95331},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2802":56930,"_24443":56791,"_17120":95333,"_5":17015,"_23194":94980,"_2329":95334},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2802":56931,"_24443":56791,"_17120":95336,"_5":17015,"_23194":94980,"_2329":95337},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2802":56932,"_24443":56791,"_17120":95339,"_5":17015,"_23194":94980,"_2329":95340},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2802":56933,"_24443":56791,"_17120":95342,"_5":17015,"_23194":94980,"_2329":95343},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2802":56934,"_24443":56791,"_17120":95345,"_5":17015,"_23194":94984,"_2329":95346},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2802":56935,"_24443":56791,"_17120":95348,"_5":17015,"_23194":94984,"_2329":95349},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2802":56936,"_24443":56791,"_17120":95351,"_5":17015,"_23194":94984,"_2329":95352},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2802":56937,"_24443":56791,"_17120":95354,"_5":17015,"_23194":94988,"_2329":95355},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2802":56938,"_24443":56791,"_17120":95357,"_5":17015,"_23194":94988,"_2329":95358},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2802":56939,"_24443":56791,"_17120":95360,"_5":17015,"_23194":94988,"_2329":95361},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2802":56940,"_24443":56791,"_17120":95363,"_5":17015,"_23194":94988,"_2329":95364},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2802":56941,"_24443":56791,"_17120":95366,"_5":17015,"_23194":94988,"_2329":95367},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2802":56942,"_24443":56791,"_17120":95369,"_5":17015,"_23194":94988,"_2329":95370},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2802":56943,"_24443":56791,"_17120":95372,"_5":17015,"_23194":94988,"_2329":95373},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2802":56944,"_24443":56791,"_17120":95375,"_5":17015,"_23194":94988,"_2329":95376},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2802":56945,"_24443":56791,"_17120":95378,"_5":17015,"_23194":94996,"_2329":95379},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2802":56946,"_24443":56791,"_17120":95381,"_5":17015,"_23194":95000,"_2329":95382},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2802":56947,"_24443":56791,"_17120":95384,"_5":17015,"_23194":95000,"_2329":95385},[],"que exista un principal activo del tipo correcto;",{"_2802":56948,"_24443":56791,"_17120":95387,"_5":17015,"_23194":95000,"_2329":95388},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2802":56949,"_24443":56791,"_17120":95390,"_5":17015,"_23194":95000,"_2329":95391},[],"que todas las condiciones del principal se cumplan;",{"_2802":56950,"_24443":56791,"_17120":95393,"_5":17015,"_23194":95000,"_2329":95394},[],"que el principal tenga concedida la política esperada;",{"_2802":56951,"_24443":56791,"_17120":95396,"_5":17015,"_23194":95000,"_2329":95397},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2802":56952,"_24443":56791,"_17120":95399,"_5":17015,"_23194":95000,"_2329":95400},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2802":56953,"_24443":56791,"_17120":95402,"_5":17015,"_23194":95000,"_2329":95403},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2802":56954,"_24443":56791,"_17120":95405,"_5":17015,"_23194":95004,"_2329":95406},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2802":56955,"_24443":56791,"_17120":95408,"_5":17015,"_23194":95008,"_2329":95409},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2802":56956,"_24443":56791,"_17120":95411,"_5":17015,"_23194":95012,"_2329":95412},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2802":56957,"_24443":56791,"_17120":95414,"_5":17015,"_23194":95012,"_2329":95415},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2802":56958,"_24443":56958,"_5":12033,"_2329":95417,"_24778":95418,"_17120":95419,"_23194":56958},"Alertas y suscripciones",[39822,94885,94886],[],{"_2802":56959,"_24443":56958,"_17120":95421,"_5":17015,"_23194":56958,"_2329":95422},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2802":56960,"_24443":56958,"_5":24775,"_17120":95424,"_23194":95425,"_2329":95426},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2802":56961,"_24443":56958,"_5":24775,"_17120":95428,"_23194":95429,"_2329":95430},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2802":56962,"_24443":56958,"_5":24775,"_17120":95432,"_23194":95433,"_2329":95434},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2802":56963,"_24443":56958,"_5":24775,"_17120":95436,"_23194":95437,"_2329":95438},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2802":56964,"_24443":56958,"_5":24775,"_17120":95440,"_23194":95441,"_2329":95442},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2802":56965,"_24443":56958,"_5":24775,"_17120":95444,"_23194":95445,"_2329":95446},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2802":56966,"_24443":56958,"_5":24775,"_17120":95448,"_23194":95449,"_2329":95450},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2802":56967,"_24443":56958,"_5":24775,"_17120":95452,"_23194":95453,"_2329":95454},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2802":56968,"_24443":56958,"_5":24775,"_17120":95456,"_23194":95457,"_2329":95458},[],"/docs/pr-preview/pr-28/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2802":56969,"_24443":56958,"_17120":95460,"_5":17015,"_23194":56958,"_2329":95461},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2802":56970,"_24443":56958,"_17120":95463,"_5":17015,"_23194":95425,"_2329":95464},[],"Un servicio publica un evento de dominio.",{"_2802":56971,"_24443":56958,"_17120":95466,"_5":17015,"_23194":95425,"_2329":95467},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2802":56972,"_24443":56958,"_17120":95469,"_5":17015,"_23194":95425,"_2329":95470},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2802":56973,"_24443":56958,"_17120":95472,"_5":17015,"_23194":95425,"_2329":95473},[],"Lamassu entrega el evento al canal configurado.",{"_2802":56974,"_24443":56958,"_17120":95475,"_5":17015,"_23194":95425,"_2329":95476},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2802":56975,"_24443":56958,"_17120":95478,"_5":17015,"_23194":95429,"_2329":95479},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino.",{"_2802":56976,"_24443":56958,"_17120":95481,"_5":17015,"_23194":95429,"_2329":95482},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2802":56977,"_24443":56958,"_17120":95484,"_5":17015,"_23194":95429,"_2329":95485},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2802":56978,"_24443":56958,"_17120":95487,"_5":17015,"_23194":95437,"_2329":95488},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2802":56979,"_24443":56958,"_17120":95490,"_5":17015,"_23194":95441,"_2329":95491},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2802":56980,"_24443":56958,"_17120":95493,"_5":17015,"_23194":95445,"_2329":95494},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2802":56981,"_24443":56958,"_17120":95496,"_5":17015,"_23194":95445,"_2329":95497},[],"**None** notifica todas las instancias del evento.",{"_2802":56982,"_24443":56958,"_17120":95499,"_5":17015,"_23194":95445,"_2329":95500},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2802":56983,"_24443":56958,"_17120":95502,"_5":17015,"_23194":95445,"_2329":95503},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2802":56984,"_24443":56958,"_17120":95505,"_5":17015,"_23194":95445,"_2329":95506},[],"**JavaScript** permite expresar lógica personalizada.",{"_2802":56985,"_24443":56958,"_17120":95508,"_5":17015,"_23194":95445,"_2329":95509},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2802":56986,"_24443":56958,"_17120":95511,"_5":17015,"_23194":95449,"_2329":95512},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2802":56987,"_24443":56958,"_17120":95514,"_5":17015,"_23194":95453,"_2329":95515},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2802":56988,"_24443":56958,"_17120":95517,"_5":17015,"_23194":95457,"_2329":95518},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2802":56989,"_24443":56958,"_17120":95520,"_5":17015,"_23194":95457,"_2329":95521},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2802":56990,"_24443":56958,"_17120":95523,"_5":17015,"_23194":95457,"_2329":95524},[],"**Perfiles:** `profile.create`, `profile.update` y `profile.delete`.",{"_2802":56991,"_24443":56958,"_17120":95526,"_5":17015,"_23194":95457,"_2329":95527},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2802":56992,"_24443":56958,"_17120":95529,"_5":17015,"_23194":95457,"_2329":95530},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2802":56993,"_24443":56958,"_17120":95532,"_5":17015,"_23194":95457,"_2329":95533},[],"**Validación:** `va.role.crl.create`.",{"_2802":56994,"_24443":56958,"_17120":95535,"_5":17015,"_23194":95457,"_2329":95536},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign.message` y `kms.delete`.",{"_2802":56995,"_24443":56958,"_17120":95538,"_5":17015,"_23194":95457,"_2329":95539},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2802":56996,"_24443":56996,"_5":12033,"_2329":95541,"_24778":95542,"_17120":95543,"_23194":56996},"Registros de auditoría",[39822,94885,94886],[],{"_2802":56997,"_24443":56996,"_17120":95545,"_5":17015,"_23194":56996,"_2329":95546},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2802":56998,"_24443":56996,"_5":24775,"_17120":95548,"_23194":95549,"_2329":95550},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2802":56999,"_24443":56996,"_5":24775,"_17120":95552,"_23194":95553,"_2329":95554},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2802":57000,"_24443":56996,"_5":24775,"_17120":95556,"_23194":95557,"_2329":95558},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2802":57001,"_24443":56996,"_5":24775,"_17120":95560,"_23194":95561,"_2329":95562},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2802":57002,"_24443":56996,"_5":24775,"_17120":95564,"_23194":95565,"_2329":95566},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2802":57003,"_24443":56996,"_5":24775,"_17120":95568,"_23194":95569,"_2329":95570},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2802":57004,"_24443":56996,"_5":24775,"_17120":95572,"_23194":95573,"_2329":95574},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2802":57005,"_24443":56996,"_5":24775,"_17120":95576,"_23194":95577,"_2329":95578},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2802":57006,"_24443":56996,"_5":24775,"_17120":95580,"_23194":95581,"_2329":95582},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2802":57007,"_24443":56996,"_5":24775,"_17120":95584,"_23194":95585,"_2329":95586},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2802":57008,"_24443":56996,"_5":24775,"_17120":95588,"_23194":95589,"_2329":95590},[],"/docs/pr-preview/pr-28/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2802":57009,"_24443":56996,"_17120":95592,"_5":17015,"_23194":56996,"_2329":95593},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2802":57010,"_24443":56996,"_17120":95595,"_5":17015,"_23194":95549,"_2329":95596},[],"El cuerpo de auditoría incluye:",{"_2802":57011,"_24443":56996,"_17120":95598,"_5":17015,"_23194":95549,"_2329":95599},[],"input: datos recibidos por la operación;",{"_2802":57012,"_24443":56996,"_17120":95601,"_5":17015,"_23194":95549,"_2329":95602},[],"has\\_error: indica si el servicio devolvió un error;",{"_2802":57013,"_24443":56996,"_17120":95604,"_5":17015,"_23194":95549,"_2329":95605},[],"output: resultado producido o mensaje de error;",{"_2802":57014,"_24443":56996,"_17120":95607,"_5":17015,"_23194":95549,"_2329":95608},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2802":57015,"_24443":56996,"_17120":95610,"_5":17015,"_23194":95549,"_2329":95611},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2802":57016,"_24443":56996,"_17120":95613,"_5":17015,"_23194":95549,"_2329":95614},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2802":57017,"_24443":56996,"_17120":95616,"_5":17015,"_23194":95553,"_2329":95617},[],"El backend aplica auditoría a mutaciones de:",{"_2802":57018,"_24443":56996,"_17120":95619,"_5":17015,"_23194":95553,"_2329":95620},[],"autoridades, certificados y perfiles de emisión;",{"_2802":57019,"_24443":56996,"_17120":95622,"_5":17015,"_23194":95553,"_2329":95623},[],"claves y motores KMS;",{"_2802":57020,"_24443":56996,"_17120":95625,"_5":17015,"_23194":95553,"_2329":95626},[],"dispositivos e identidades;",{"_2802":57021,"_24443":56996,"_17120":95628,"_5":17015,"_23194":95553,"_2329":95629},[],"DMS y operaciones de enrolamiento;",{"_2802":57022,"_24443":56996,"_17120":95631,"_5":17015,"_23194":95553,"_2329":95632},[],"funciones de validación y CRL;",{"_2802":57023,"_24443":56996,"_17120":95634,"_5":17015,"_23194":95553,"_2329":95635},[],"principales, políticas y concesiones de autorización.",{"_2802":57024,"_24443":56996,"_17120":95637,"_5":17015,"_23194":95553,"_2329":95638},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2802":57025,"_24443":56996,"_17120":95640,"_5":17015,"_23194":95557,"_2329":95641},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2802":57026,"_24443":56996,"_17120":95643,"_5":17015,"_23194":95557,"_2329":95644},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2802":57027,"_24443":56996,"_17120":95646,"_5":17015,"_23194":95557,"_2329":95647},[],"Diseña el consumidor para:",{"_2802":57028,"_24443":56996,"_17120":95649,"_5":17015,"_23194":95557,"_2329":95650},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2802":57029,"_24443":56996,"_17120":95652,"_5":17015,"_23194":95557,"_2329":95653},[],"conservar el CloudEvent completo sin modificar;",{"_2802":57030,"_24443":56996,"_17120":95655,"_5":17015,"_23194":95557,"_2329":95656},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2802":57031,"_24443":56996,"_17120":95658,"_5":17015,"_23194":95557,"_2329":95659},[],"cifrar en tránsito y en reposo;",{"_2802":57032,"_24443":56996,"_17120":95661,"_5":17015,"_23194":95557,"_2329":95662},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2802":57033,"_24443":56996,"_17120":95664,"_5":17015,"_23194":95557,"_2329":95665},[],"aplicar una política explícita de retención y legal hold;",{"_2802":57034,"_24443":56996,"_17120":95667,"_5":17015,"_23194":95557,"_2329":95668},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2802":57035,"_24443":56996,"_17120":95670,"_5":17015,"_23194":95561,"_2329":95671},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2802":57036,"_24443":56996,"_17120":95673,"_5":17015,"_23194":95561,"_2329":95674},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2802":57037,"_24443":56996,"_17120":95676,"_5":17015,"_23194":95569,"_2329":95677},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2802":57038,"_24443":56996,"_17120":95679,"_5":17015,"_23194":95573,"_2329":95680},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2802":57039,"_24443":56996,"_17120":95682,"_5":17015,"_23194":95577,"_2329":95683},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2802":57040,"_24443":56996,"_17120":95685,"_5":17015,"_23194":95581,"_2329":95686},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2802":57041,"_24443":56996,"_17120":95688,"_5":17015,"_23194":95585,"_2329":95689},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2802":57042,"_24443":56996,"_17120":95691,"_5":17015,"_23194":95589,"_2329":95692},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2802":57043,"_24443":56996,"_17120":95694,"_5":17015,"_23194":95589,"_2329":95695},[],"aparece un evento de auditoría correcto;",{"_2802":57044,"_24443":56996,"_17120":95697,"_5":17015,"_23194":95589,"_2329":95698},[],"el principal coincide con la identidad utilizada;",{"_2802":57045,"_24443":56996,"_17120":95700,"_5":17015,"_23194":95589,"_2329":95701},[],"el consumidor lo persiste una sola vez;",{"_2802":57046,"_24443":56996,"_17120":95703,"_5":17015,"_23194":95589,"_2329":95704},[],"puede recuperarse por recurso, actor y periodo;",{"_2802":57047,"_24443":56996,"_17120":95706,"_5":17015,"_23194":95589,"_2329":95707},[],"una interrupción del consumidor produce una alerta.",{"_2802":57048,"_24443":56996,"_17120":95709,"_5":17015,"_23194":95589,"_2329":95710},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2802":57049,"_24443":57049,"_5":12033,"_2329":95712,"_24778":95713,"_17120":95714,"_23194":57049},"Arquitectura de la plataforma",[39822,94885],[],{"_2802":57050,"_24443":57049,"_17120":95716,"_5":17015,"_23194":57049,"_2329":95717},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2802":57051,"_24443":57049,"_5":24775,"_17120":95719,"_23194":95720,"_2329":95721},[],"/docs/pr-preview/pr-28/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2802":57052,"_24443":57049,"_5":24775,"_17120":95723,"_23194":95724,"_2329":95725},[],"/docs/pr-preview/pr-28/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2802":57053,"_24443":57049,"_5":24775,"_17120":95727,"_23194":95728,"_2329":95729},[],"/docs/pr-preview/pr-28/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2802":57054,"_24443":57049,"_5":24775,"_17120":95731,"_23194":95732,"_2329":95733},[],"/docs/pr-preview/pr-28/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2802":57055,"_24443":57049,"_5":24775,"_17120":95735,"_23194":95736,"_2329":95737},[],"/docs/pr-preview/pr-28/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2802":57056,"_24443":57049,"_17120":95739,"_5":17015,"_23194":57049,"_2329":95740},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2802":57057,"_24443":57049,"_17120":95742,"_5":17015,"_23194":57049,"_2329":95743},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2802":57058,"_24443":57049,"_17120":95745,"_5":17015,"_23194":95720,"_2329":95746},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2802":57059,"_24443":57049,"_17120":95748,"_5":17015,"_23194":95724,"_2329":95749},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2802":57060,"_24443":57049,"_17120":95751,"_5":17015,"_23194":95728,"_2329":95752},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2802":57061,"_24443":57049,"_17120":95754,"_5":17015,"_23194":95732,"_2329":95755},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2802":57062,"_24443":57049,"_17120":95757,"_5":17015,"_23194":95736,"_2329":95758},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2802":57063,"_24443":57063,"_5":12033,"_2329":95760,"_24778":95761,"_17120":95762,"_23194":57063},"Cómo funciona Lamassu",[39822,94885],[],{"_2802":57064,"_24443":57063,"_17120":95764,"_5":17015,"_23194":57063,"_2329":95765},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2802":57065,"_24443":57063,"_5":24775,"_17120":95767,"_23194":95768,"_2329":95769},[],"/docs/pr-preview/pr-28/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2802":57066,"_24443":57063,"_5":24775,"_17120":95771,"_23194":95772,"_2329":95773},[],"/docs/pr-preview/pr-28/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2802":57067,"_24443":57063,"_17120":95775,"_5":17015,"_23194":57063,"_2329":95776},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2802":57068,"_24443":57063,"_17120":95778,"_5":17015,"_23194":95768,"_2329":95779},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2802":57069,"_24443":57063,"_17120":95781,"_5":17015,"_23194":95768,"_2329":95782},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2802":57070,"_24443":57063,"_17120":95784,"_5":17015,"_23194":95768,"_2329":95785},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2802":57071,"_24443":57063,"_17120":95787,"_5":17015,"_23194":95768,"_2329":95788},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2802":57072,"_24443":57063,"_17120":95790,"_5":17015,"_23194":95768,"_2329":95791},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2802":57073,"_24443":57063,"_17120":95793,"_5":17015,"_23194":95772,"_2329":95794},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2802":57074,"_24443":57063,"_17120":95796,"_5":17015,"_23194":95772,"_2329":95797},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2802":57075,"_24443":57063,"_17120":95799,"_5":17015,"_23194":95772,"_2329":95800},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2802":57076,"_24443":57063,"_17120":95802,"_5":17015,"_23194":95772,"_2329":95803},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2802":57077,"_24443":57063,"_17120":95805,"_5":17015,"_23194":95772,"_2329":95806},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2802":57078,"_24443":57063,"_17120":95808,"_5":17015,"_23194":95772,"_2329":95809},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2802":57079,"_24443":57063,"_17120":95811,"_5":17015,"_23194":95772,"_2329":95812},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2802":57080,"_24443":57080,"_5":12033,"_2329":95814,"_24778":95815,"_17120":95816,"_23194":57080},"Dispositivos e identidades",[39822,94885,42097,95814],[],{"_2802":57081,"_24443":57080,"_17120":95818,"_5":17015,"_23194":57080,"_2329":95819},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2802":57082,"_24443":57080,"_5":24775,"_17120":95821,"_23194":95822,"_2329":95823},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2802":57083,"_24443":57080,"_5":24775,"_17120":95825,"_23194":95826,"_2329":95827},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2802":57084,"_24443":57080,"_5":24775,"_17120":95829,"_23194":95830,"_2329":95831},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2802":57085,"_24443":57080,"_5":24775,"_17120":95833,"_23194":95834,"_2329":95835},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2802":57086,"_24443":57080,"_5":24775,"_17120":95837,"_23194":95838,"_2329":95839},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2802":57087,"_24443":57080,"_5":24775,"_17120":95841,"_23194":95842,"_2329":95843},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2802":57088,"_24443":57080,"_5":24775,"_17120":95845,"_23194":95846,"_2329":95847},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2802":57089,"_24443":57080,"_5":24775,"_17120":95849,"_23194":95850,"_2329":95851},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2802":57090,"_24443":57080,"_5":24775,"_17120":95853,"_23194":95854,"_2329":95855},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2802":57091,"_24443":57080,"_5":24775,"_17120":95857,"_23194":95858,"_2329":95859},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2802":57092,"_24443":57080,"_5":24775,"_17120":95861,"_23194":95862,"_2329":95863},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2802":57093,"_24443":57080,"_17120":95865,"_5":17015,"_23194":57080,"_2329":95866},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2802":57094,"_24443":57080,"_17120":95868,"_5":17015,"_23194":57080,"_2329":95869},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2802":57095,"_24443":57080,"_17120":95871,"_5":17015,"_23194":95822,"_2329":95872},[],"Vista operativa",{"_2802":57096,"_24443":57080,"_17120":95874,"_5":17015,"_23194":95822,"_2329":95875},[],"Interpretación",{"_2802":57097,"_24443":57080,"_17120":95877,"_5":17015,"_23194":95822,"_2329":42160},[],{"_2802":57098,"_24443":57080,"_17120":95879,"_5":17015,"_23194":95822,"_2329":95880},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2802":57099,"_24443":57080,"_17120":95882,"_5":17015,"_23194":95822,"_2329":42166},[],{"_2802":57100,"_24443":57080,"_17120":95884,"_5":17015,"_23194":95822,"_2329":95885},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2802":57101,"_24443":57080,"_17120":95887,"_5":17015,"_23194":95822,"_2329":42172},[],{"_2802":57102,"_24443":57080,"_17120":95889,"_5":17015,"_23194":95822,"_2329":95890},[],"La identidad está en la ventana operativa de renovación.",{"_2802":57103,"_24443":57080,"_17120":95892,"_5":17015,"_23194":95822,"_2329":42178},[],{"_2802":57104,"_24443":57080,"_17120":95894,"_5":17015,"_23194":95822,"_2329":95895},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2802":57105,"_24443":57080,"_17120":95897,"_5":17015,"_23194":95822,"_2329":42184},[],{"_2802":57106,"_24443":57080,"_17120":95899,"_5":17015,"_23194":95822,"_2329":95900},[],"La identidad ha vencido.",{"_2802":57107,"_24443":57080,"_17120":95902,"_5":17015,"_23194":95822,"_2329":42190},[],{"_2802":57108,"_24443":57080,"_17120":95904,"_5":17015,"_23194":95822,"_2329":95905},[],"La identidad está marcada como revocada.",{"_2802":57109,"_24443":57080,"_17120":95907,"_5":17015,"_23194":95822,"_2329":42196},[],{"_2802":57110,"_24443":57080,"_17120":95909,"_5":17015,"_23194":95822,"_2329":95910},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2802":57111,"_24443":57080,"_17120":95912,"_5":17015,"_23194":95822,"_2329":95913},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2802":57112,"_24443":57080,"_17120":95915,"_5":17015,"_23194":95826,"_2329":95916},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2802":57113,"_24443":57080,"_17120":95918,"_5":17015,"_23194":95826,"_2329":95919},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2802":57114,"_24443":57080,"_17120":95921,"_5":17015,"_23194":95826,"_2329":95922},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2802":57115,"_24443":57080,"_17120":95924,"_5":17015,"_23194":95826,"_2329":95925},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2802":57116,"_24443":57080,"_17120":95927,"_5":17015,"_23194":95830,"_2329":95928},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2802":57117,"_24443":57080,"_17120":95930,"_5":17015,"_23194":95834,"_2329":95931},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2802":57118,"_24443":57080,"_17120":95933,"_5":17015,"_23194":95838,"_2329":95934},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2802":57119,"_24443":57080,"_17120":95936,"_5":17015,"_23194":95842,"_2329":95937},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2802":57120,"_24443":57080,"_17120":95939,"_5":17015,"_23194":95846,"_2329":95940},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2802":57121,"_24443":57080,"_17120":95942,"_5":17015,"_23194":95846,"_2329":95943},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2802":57122,"_24443":57080,"_17120":95945,"_5":17015,"_23194":95850,"_2329":95946},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2802":57123,"_24443":57080,"_17120":95948,"_5":17015,"_23194":95850,"_2329":95949},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2802":57124,"_24443":57080,"_17120":95951,"_5":17015,"_23194":95850,"_2329":95952},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2802":57125,"_24443":57080,"_17120":95954,"_5":17015,"_23194":95850,"_2329":95955},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2802":57126,"_24443":57080,"_17120":95957,"_5":17015,"_23194":95850,"_2329":95958},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2802":57127,"_24443":57080,"_17120":95960,"_5":17015,"_23194":95850,"_2329":95961},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2802":57128,"_24443":57080,"_17120":95963,"_5":17015,"_23194":95854,"_2329":95964},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2802":57129,"_24443":57080,"_17120":95966,"_5":17015,"_23194":95854,"_2329":95967},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2802":57130,"_24443":57080,"_17120":95969,"_5":17015,"_23194":95858,"_2329":95970},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2802":57131,"_24443":57080,"_17120":95972,"_5":17015,"_23194":95858,"_2329":95973},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2802":57132,"_24443":57080,"_17120":95975,"_5":17015,"_23194":95858,"_2329":95976},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2802":57133,"_24443":57080,"_17120":95978,"_5":17015,"_23194":95858,"_2329":95979},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2802":57134,"_24443":57080,"_17120":95981,"_5":17015,"_23194":95862,"_2329":95982},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2802":57135,"_24443":57080,"_17120":95984,"_5":17015,"_23194":95862,"_2329":95985},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2802":57136,"_24443":57136,"_5":12033,"_2329":95987,"_24778":95988,"_17120":95990,"_23194":57136},"Identidad inicial y autenticación",[39822,94885,42097,95814,95989],"Enrolamiento con PKI",[],{"_2802":57137,"_24443":57136,"_17120":95992,"_5":17015,"_23194":57136,"_2329":95993},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2802":57138,"_24443":57136,"_5":24775,"_17120":95995,"_23194":95996,"_2329":95997},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2802":57139,"_24443":57136,"_5":24775,"_17120":95999,"_23194":96000,"_2329":96001},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2802":57140,"_24443":57136,"_5":24775,"_17120":96003,"_23194":96004,"_2329":96005},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2802":57141,"_24443":57136,"_5":24775,"_17120":96007,"_23194":96008,"_2329":96009},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2802":57142,"_24443":57136,"_5":24775,"_17120":96011,"_23194":96012,"_2329":96013},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2802":57143,"_24443":57136,"_17120":96015,"_5":17015,"_23194":57136,"_2329":96016},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2802":57144,"_24443":57136,"_17120":96018,"_5":17015,"_23194":95996,"_2329":96019},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2802":57145,"_24443":57136,"_17120":96021,"_5":17015,"_23194":95996,"_2329":96022},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2802":57146,"_24443":57136,"_17120":96024,"_5":17015,"_23194":96000,"_2329":96025},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2802":57147,"_24443":57136,"_17120":96027,"_5":17015,"_23194":96000,"_2329":96028},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2802":57148,"_24443":57136,"_17120":96030,"_5":17015,"_23194":96000,"_2329":96031},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2802":57149,"_24443":57136,"_17120":96033,"_5":17015,"_23194":96004,"_2329":96034},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2802":57150,"_24443":57136,"_17120":96036,"_5":17015,"_23194":96004,"_2329":96037},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2802":57151,"_24443":57136,"_17120":96039,"_5":17015,"_23194":96008,"_2329":96040},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado.",{"_2802":57152,"_24443":57136,"_17120":96042,"_5":17015,"_23194":96008,"_2329":96043},[],"Ejemplo de cuerpo:",{"_2802":57153,"_24443":57136,"_17120":96045,"_5":17015,"_23194":96008,"_2329":96046},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2802":57154,"_24443":57136,"_17120":96048,"_5":17015,"_23194":96008,"_2329":96049},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2802":57155,"_24443":57136,"_17120":96051,"_5":17015,"_23194":96008,"_2329":96052},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2802":57156,"_24443":57136,"_17120":96054,"_5":17015,"_23194":96008,"_2329":96055},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2802":57157,"_24443":57136,"_17120":96057,"_5":17015,"_23194":96012,"_2329":96058},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2802":57158,"_24443":57136,"_17120":96060,"_5":17015,"_23194":96012,"_2329":96061},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2802":57159,"_24443":57159,"_5":12033,"_2329":96063,"_24778":96064,"_17120":96065,"_23194":57159},"Configura y opera el DMS",[39822,94885,42097,95814,95989],[],{"_2802":57160,"_24443":57159,"_17120":96067,"_5":17015,"_23194":57159,"_2329":96068},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2802":57161,"_24443":57159,"_5":24775,"_17120":96070,"_23194":96071,"_2329":93586},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2802":57162,"_24443":57159,"_5":24775,"_17120":96073,"_23194":96074,"_2329":96075},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2802":57163,"_24443":57159,"_5":24775,"_17120":96077,"_23194":96078,"_2329":96079},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2802":57164,"_24443":57159,"_5":24775,"_17120":96081,"_23194":96082,"_2329":96083},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2802":57165,"_24443":57159,"_5":24775,"_17120":96085,"_23194":96086,"_2329":96087},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2802":57166,"_24443":57159,"_5":24775,"_17120":96089,"_23194":96090,"_2329":96091},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2802":57167,"_24443":57159,"_5":24775,"_17120":96093,"_23194":96094,"_2329":96095},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2802":57168,"_24443":57159,"_5":24775,"_17120":96097,"_23194":96098,"_2329":96099},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2802":57169,"_24443":57159,"_5":24775,"_17120":96101,"_23194":96102,"_2329":42392},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2802":57170,"_24443":57159,"_5":24775,"_17120":96104,"_23194":96105,"_2329":42396},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2802":57171,"_24443":57159,"_5":24775,"_17120":96107,"_23194":96108,"_2329":96109},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2802":57172,"_24443":57159,"_5":24775,"_17120":96111,"_23194":96112,"_2329":96113},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2802":57173,"_24443":57159,"_5":24775,"_17120":96115,"_23194":96116,"_2329":96117},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2802":57174,"_24443":57159,"_5":24775,"_17120":96119,"_23194":96120,"_2329":42412},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2802":57175,"_24443":57159,"_5":24775,"_17120":96122,"_23194":96123,"_2329":96124},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2802":57176,"_24443":57159,"_5":24775,"_17120":96126,"_23194":96127,"_2329":96128},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2802":57177,"_24443":57159,"_5":24775,"_17120":96130,"_23194":96131,"_2329":96132},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2802":57178,"_24443":57159,"_17120":96134,"_5":17015,"_23194":57159,"_2329":96135},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2802":57179,"_24443":57159,"_17120":96137,"_5":17015,"_23194":96071,"_2329":96138},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2802":57180,"_24443":57159,"_17120":96140,"_5":17015,"_23194":96071,"_2329":96141},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2802":57181,"_24443":57159,"_17120":96143,"_5":17015,"_23194":96078,"_2329":96144},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2802":57182,"_24443":57159,"_17120":96146,"_5":17015,"_23194":96082,"_2329":96147},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2802":57183,"_24443":57159,"_17120":96149,"_5":17015,"_23194":96086,"_2329":96150},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2802":57184,"_24443":57159,"_17120":96152,"_5":17015,"_23194":96090,"_2329":96153},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2802":57185,"_24443":57159,"_17120":96155,"_5":17015,"_23194":96094,"_2329":96156},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2802":57186,"_24443":57159,"_17120":96158,"_5":17015,"_23194":96102,"_2329":96159},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2802":57187,"_24443":57159,"_17120":96161,"_5":17015,"_23194":96102,"_2329":96162},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2802":57188,"_24443":57159,"_17120":96164,"_5":17015,"_23194":96105,"_2329":96165},[],"Campo de `settings.enrollment_settings`",{"_2802":57189,"_24443":57159,"_17120":96167,"_5":17015,"_23194":96105,"_2329":96168},[],"Decisión",{"_2802":57190,"_24443":57159,"_17120":96170,"_5":17015,"_23194":96105,"_2329":42463},[],{"_2802":57191,"_24443":57159,"_17120":96172,"_5":17015,"_23194":96105,"_2329":96173},[],"`EST_RFC7030` para estas operaciones.",{"_2802":57192,"_24443":57159,"_17120":96175,"_5":17015,"_23194":96105,"_2329":42469},[],{"_2802":57193,"_24443":57159,"_17120":96177,"_5":17015,"_23194":96105,"_2329":96178},[],"ID de la CA que firmará.",{"_2802":57194,"_24443":57159,"_17120":96180,"_5":17015,"_23194":96105,"_2329":42475},[],{"_2802":57195,"_24443":57159,"_17120":96182,"_5":17015,"_23194":96105,"_2329":96183},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2802":57196,"_24443":57159,"_17120":96185,"_5":17015,"_23194":96105,"_2329":42481},[],{"_2802":57197,"_24443":57159,"_17120":96187,"_5":17015,"_23194":96105,"_2329":96188},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2802":57198,"_24443":57159,"_17120":96190,"_5":17015,"_23194":96105,"_2329":42487},[],{"_2802":57199,"_24443":57159,"_17120":96192,"_5":17015,"_23194":96105,"_2329":96193},[],"Uno de los cuatro modos de autenticación.",{"_2802":57200,"_24443":57159,"_17120":96195,"_5":17015,"_23194":96105,"_2329":96196},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2802":57201,"_24443":57159,"_17120":96198,"_5":17015,"_23194":96108,"_2329":96199},[],"Los bloques son independientes:",{"_2802":57202,"_24443":57159,"_17120":96201,"_5":17015,"_23194":96108,"_2329":96202},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2802":57203,"_24443":57159,"_17120":96204,"_5":17015,"_23194":96108,"_2329":96205},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2802":57204,"_24443":57159,"_17120":96207,"_5":17015,"_23194":96108,"_2329":42505},[],{"_2802":57205,"_24443":57159,"_17120":96209,"_5":17015,"_23194":96108,"_2329":96210},[],"Control aplicado en la operación configurada",{"_2802":57206,"_24443":57159,"_17120":96212,"_5":17015,"_23194":96108,"_2329":42511},[],{"_2802":57207,"_24443":57159,"_17120":96214,"_5":17015,"_23194":96108,"_2329":96215},[],"Validación del certificado presentado.",{"_2802":57208,"_24443":57159,"_17120":96217,"_5":17015,"_23194":96108,"_2329":42517},[],{"_2802":57209,"_24443":57159,"_17120":96219,"_5":17015,"_23194":96108,"_2329":96220},[],"Autorización del webhook configurado.",{"_2802":57210,"_24443":57159,"_17120":96222,"_5":17015,"_23194":96108,"_2329":42523},[],{"_2802":57211,"_24443":57159,"_17120":96224,"_5":17015,"_23194":96108,"_2329":96225},[],"Validación del certificado y, después, aprobación del webhook.",{"_2802":57212,"_24443":57159,"_17120":96227,"_5":17015,"_23194":96108,"_2329":42529},[],{"_2802":57213,"_24443":57159,"_17120":96229,"_5":17015,"_23194":96108,"_2329":96230},[],"Sin autenticación del solicitante por el DMS.",{"_2802":57214,"_24443":57159,"_17120":96232,"_5":17015,"_23194":96108,"_2329":96233},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2802":57215,"_24443":57159,"_17120":96235,"_5":17015,"_23194":96108,"_2329":96236},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2802":57216,"_24443":57159,"_17120":96238,"_5":17015,"_23194":96108,"_2329":96239},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2802":57217,"_24443":57159,"_17120":96241,"_5":17015,"_23194":96108,"_2329":96242},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2802":57218,"_24443":57159,"_17120":96244,"_5":17015,"_23194":96108,"_2329":96245},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2802":57219,"_24443":57159,"_17120":96247,"_5":17015,"_23194":96112,"_2329":96248},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2802":57220,"_24443":57159,"_17120":96250,"_5":17015,"_23194":96116,"_2329":96251},[],"Campo de `settings.reenrollment_settings`",{"_2802":57221,"_24443":57159,"_17120":96253,"_5":17015,"_23194":96116,"_2329":96254},[],"Función",{"_2802":57222,"_24443":57159,"_17120":96256,"_5":17015,"_23194":96116,"_2329":42558},[],{"_2802":57223,"_24443":57159,"_17120":96258,"_5":17015,"_23194":96116,"_2329":96259},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2802":57224,"_24443":57159,"_17120":96261,"_5":17015,"_23194":96116,"_2329":42564},[],{"_2802":57225,"_24443":57159,"_17120":96263,"_5":17015,"_23194":96116,"_2329":96264},[],"Umbral operativo preventivo de monitorización.",{"_2802":57226,"_24443":57159,"_17120":96266,"_5":17015,"_23194":96116,"_2329":42570},[],{"_2802":57227,"_24443":57159,"_17120":96268,"_5":17015,"_23194":96116,"_2329":96269},[],"Umbral operativo crítico de monitorización.",{"_2802":57228,"_24443":57159,"_17120":96271,"_5":17015,"_23194":96116,"_2329":42576},[],{"_2802":57229,"_24443":57159,"_17120":96273,"_5":17015,"_23194":96116,"_2329":96274},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2802":57230,"_24443":57159,"_17120":96276,"_5":17015,"_23194":96116,"_2329":42582},[],{"_2802":57231,"_24443":57159,"_17120":96278,"_5":17015,"_23194":96116,"_2329":96279},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2802":57232,"_24443":57159,"_17120":96281,"_5":17015,"_23194":96116,"_2329":42588},[],{"_2802":57233,"_24443":57159,"_17120":96283,"_5":17015,"_23194":96116,"_2329":96284},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2802":57234,"_24443":57159,"_17120":96286,"_5":17015,"_23194":96116,"_2329":96287},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2802":57235,"_24443":57159,"_17120":96289,"_5":17015,"_23194":96120,"_2329":96290},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2802":57236,"_24443":57159,"_17120":96292,"_5":17015,"_23194":96123,"_2329":93943},[],{"_2802":57237,"_24443":57159,"_17120":96294,"_5":17015,"_23194":96123,"_2329":96295},[],"Qué publica",{"_2802":57238,"_24443":57159,"_17120":96297,"_5":17015,"_23194":96123,"_2329":42605},[],{"_2802":57239,"_24443":57159,"_17120":96299,"_5":17015,"_23194":96123,"_2329":96300},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2802":57240,"_24443":57159,"_17120":96302,"_5":17015,"_23194":96123,"_2329":42611},[],{"_2802":57241,"_24443":57159,"_17120":96304,"_5":17015,"_23194":96123,"_2329":96305},[],"Certificado de la CA emisora seleccionada.",{"_2802":57242,"_24443":57159,"_17120":96307,"_5":17015,"_23194":96123,"_2329":42617},[],{"_2802":57243,"_24443":57159,"_17120":96309,"_5":17015,"_23194":96123,"_2329":96310},[],"Certificados de las CAs elegidas explícitamente.",{"_2802":57244,"_24443":57159,"_17120":96312,"_5":17015,"_23194":96123,"_2329":96313},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2802":57245,"_24443":57159,"_17120":96315,"_5":17015,"_23194":96127,"_2329":96316},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2802":57246,"_24443":57159,"_17120":96318,"_5":17015,"_23194":96127,"_2329":96319},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2802":57247,"_24443":57159,"_17120":96321,"_5":17015,"_23194":96127,"_2329":96322},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2802":57248,"_24443":57159,"_17120":96324,"_5":17015,"_23194":96131,"_2329":96325},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2802":57249,"_24443":57249,"_5":12033,"_2329":96327,"_24778":96328,"_17120":96329,"_23194":57249},"Integra el cliente EST",[39822,94885,42097,95814,95989],[],{"_2802":57250,"_24443":57249,"_17120":96331,"_5":17015,"_23194":57249,"_2329":96332},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2802":57251,"_24443":57249,"_5":24775,"_17120":96334,"_23194":96335,"_2329":93586},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2802":57252,"_24443":57249,"_5":24775,"_17120":96337,"_23194":96338,"_2329":96339},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2802":57253,"_24443":57249,"_5":24775,"_17120":96341,"_23194":96342,"_2329":96343},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2802":57254,"_24443":57249,"_5":24775,"_17120":96345,"_23194":96346,"_2329":96347},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2802":57255,"_24443":57249,"_5":24775,"_17120":96349,"_23194":96350,"_2329":96351},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2802":57256,"_24443":57249,"_5":24775,"_17120":96353,"_23194":96354,"_2329":96355},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2802":57257,"_24443":57249,"_17120":96357,"_5":17015,"_23194":57249,"_2329":96358},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2802":57258,"_24443":57249,"_17120":96360,"_5":17015,"_23194":96335,"_2329":96361},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2802":57259,"_24443":57249,"_17120":96363,"_5":17015,"_23194":96335,"_2329":96364},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2802":57260,"_24443":57249,"_17120":96366,"_5":17015,"_23194":96335,"_2329":96367},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2802":57261,"_24443":57249,"_17120":96369,"_5":17015,"_23194":96338,"_2329":96370},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2802":57262,"_24443":57249,"_17120":96372,"_5":17015,"_23194":96338,"_2329":96373},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2802":57263,"_24443":57249,"_17120":96375,"_5":17015,"_23194":96342,"_2329":96376},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2802":57264,"_24443":57249,"_17120":96378,"_5":17015,"_23194":96342,"_2329":96379},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2802":57265,"_24443":57249,"_17120":96381,"_5":17015,"_23194":96346,"_2329":96382},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2802":57266,"_24443":57249,"_17120":96384,"_5":17015,"_23194":96346,"_2329":96385},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2802":57267,"_24443":57249,"_17120":96387,"_5":17015,"_23194":96350,"_2329":96388},[],"Para el caso de una raíz que emite directamente:",{"_2802":57268,"_24443":57249,"_17120":96390,"_5":17015,"_23194":96350,"_2329":96391},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2802":57269,"_24443":57249,"_17120":96393,"_5":17015,"_23194":96350,"_2329":96394},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2802":57270,"_24443":57249,"_17120":96396,"_5":17015,"_23194":96354,"_2329":96397},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2802":57271,"_24443":57271,"_5":12033,"_2329":96399,"_24778":96400,"_17120":96401,"_23194":57271},"Referencia EST",[39822,94885,42097,95814,95989],[],{"_2802":57272,"_24443":57271,"_17120":96403,"_5":17015,"_23194":57271,"_2329":96404},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2802":57273,"_24443":57271,"_5":24775,"_17120":96406,"_23194":96407,"_2329":96408},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2802":57274,"_24443":57271,"_5":24775,"_17120":96410,"_23194":96411,"_2329":18580},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2802":57275,"_24443":57271,"_5":24775,"_17120":96413,"_23194":96414,"_2329":21287},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2802":57276,"_24443":57271,"_5":24775,"_17120":96416,"_23194":96417,"_2329":21294},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2802":57277,"_24443":57271,"_5":24775,"_17120":96419,"_23194":96420,"_2329":20663},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2802":57278,"_24443":57271,"_5":24775,"_17120":96422,"_23194":96423,"_2329":96424},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2802":57279,"_24443":57271,"_5":24775,"_17120":96426,"_23194":96427,"_2329":96428},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2802":57280,"_24443":57271,"_5":24775,"_17120":96430,"_23194":96431,"_2329":96432},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2802":57281,"_24443":57271,"_17120":96434,"_5":17015,"_23194":57271,"_2329":96435},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2802":57282,"_24443":57271,"_17120":96437,"_5":17015,"_23194":96407,"_2329":96438},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2802":57283,"_24443":57271,"_17120":96440,"_5":17015,"_23194":96407,"_2329":94676},[],{"_2802":57284,"_24443":57271,"_17120":96442,"_5":17015,"_23194":96407,"_2329":96443},[],"Método",{"_2802":57285,"_24443":57271,"_17120":96445,"_5":17015,"_23194":96407,"_2329":96446},[],"Autenticación y condición",{"_2802":57286,"_24443":57271,"_17120":96448,"_5":17015,"_23194":96407,"_2329":42760},[],{"_2802":57287,"_24443":57271,"_17120":96450,"_5":17015,"_23194":96407,"_2329":42763},[],{"_2802":57288,"_24443":57271,"_17120":96452,"_5":17015,"_23194":96407,"_2329":96453},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2802":57289,"_24443":57271,"_17120":96455,"_5":17015,"_23194":96407,"_2329":42769},[],{"_2802":57290,"_24443":57271,"_17120":96457,"_5":17015,"_23194":96407,"_2329":42772},[],{"_2802":57291,"_24443":57271,"_17120":96459,"_5":17015,"_23194":96407,"_2329":96460},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2802":57292,"_24443":57271,"_17120":96462,"_5":17015,"_23194":96407,"_2329":42778},[],{"_2802":57293,"_24443":57271,"_17120":96464,"_5":17015,"_23194":96407,"_2329":42772},[],{"_2802":57294,"_24443":57271,"_17120":96466,"_5":17015,"_23194":96407,"_2329":96467},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2802":57295,"_24443":57271,"_17120":96469,"_5":17015,"_23194":96407,"_2329":42786},[],{"_2802":57296,"_24443":57271,"_17120":96471,"_5":17015,"_23194":96407,"_2329":42772},[],{"_2802":57297,"_24443":57271,"_17120":96473,"_5":17015,"_23194":96407,"_2329":96474},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2802":57298,"_24443":57271,"_17120":96476,"_5":17015,"_23194":96407,"_2329":96477},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2802":57299,"_24443":57271,"_17120":96479,"_5":17015,"_23194":96411,"_2329":96480},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2802":57300,"_24443":57271,"_17120":96482,"_5":17015,"_23194":96411,"_2329":96483},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2802":57301,"_24443":57271,"_17120":96485,"_5":17015,"_23194":96414,"_2329":96486},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2802":57302,"_24443":57271,"_17120":96488,"_5":17015,"_23194":96414,"_2329":96489},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2802":57303,"_24443":57271,"_17120":96491,"_5":17015,"_23194":96417,"_2329":96492},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2802":57304,"_24443":57271,"_17120":96494,"_5":17015,"_23194":96417,"_2329":96495},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2802":57305,"_24443":57271,"_17120":96497,"_5":17015,"_23194":96420,"_2329":96498},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2802":57306,"_24443":57271,"_17120":96500,"_5":17015,"_23194":96420,"_2329":96501},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2802":57307,"_24443":57271,"_17120":96503,"_5":17015,"_23194":96423,"_2329":96504},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2802":57308,"_24443":57271,"_17120":96506,"_5":17015,"_23194":96423,"_2329":96507},[],"Parte",{"_2802":57309,"_24443":57271,"_17120":96509,"_5":17015,"_23194":96423,"_2329":96510},[],"Contenido tras decodificar su Base64",{"_2802":57310,"_24443":57271,"_17120":96512,"_5":17015,"_23194":96423,"_2329":42830},[],{"_2802":57311,"_24443":57271,"_17120":96514,"_5":17015,"_23194":96423,"_2329":96515},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2802":57312,"_24443":57271,"_17120":96517,"_5":17015,"_23194":96423,"_2329":42836},[],{"_2802":57313,"_24443":57271,"_17120":96519,"_5":17015,"_23194":96423,"_2329":96520},[],"PKCS#7 DER con el certificado emitido.",{"_2802":57314,"_24443":57271,"_17120":96522,"_5":17015,"_23194":96423,"_2329":96523},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2802":57315,"_24443":57271,"_17120":96525,"_5":17015,"_23194":96427,"_2329":96526},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2802":57316,"_24443":57271,"_17120":96528,"_5":17015,"_23194":96427,"_2329":96529},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2802":57317,"_24443":57271,"_17120":96531,"_5":17015,"_23194":96427,"_2329":96532},[],"Convierte y comprueba el resultado:",{"_2802":57318,"_24443":57271,"_17120":96534,"_5":17015,"_23194":96427,"_2329":96535},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2802":57319,"_24443":57271,"_17120":96537,"_5":17015,"_23194":96431,"_2329":96538},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2802":57320,"_24443":57271,"_17120":96540,"_5":17015,"_23194":96431,"_2329":96541},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2802":57321,"_24443":57321,"_5":12033,"_2329":95989,"_24778":96543,"_17120":96544,"_23194":57321},[39822,94885,42097,95814,95989],[],{"_2802":57322,"_24443":57321,"_17120":96546,"_5":17015,"_23194":57321,"_2329":96547},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2802":57323,"_24443":57321,"_5":24775,"_17120":96549,"_23194":96550,"_2329":96551},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2802":57324,"_24443":57321,"_5":24775,"_17120":96553,"_23194":96554,"_2329":96555},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2802":57325,"_24443":57321,"_5":24775,"_17120":96557,"_23194":96558,"_2329":96559},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2802":57326,"_24443":57321,"_5":24775,"_17120":96561,"_23194":96562,"_2329":96563},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2802":57327,"_24443":57321,"_17120":96565,"_5":17015,"_23194":57321,"_2329":96566},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2802":57328,"_24443":57321,"_17120":96568,"_5":17015,"_23194":96550,"_2329":96569},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2802":57329,"_24443":57321,"_17120":96571,"_5":17015,"_23194":96550,"_2329":96572},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2802":57330,"_24443":57321,"_17120":96574,"_5":17015,"_23194":96550,"_2329":96575},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2802":57331,"_24443":57321,"_17120":96577,"_5":17015,"_23194":96550,"_2329":96578},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2802":57332,"_24443":57321,"_17120":96580,"_5":17015,"_23194":96550,"_2329":96581},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2802":57333,"_24443":57321,"_17120":96583,"_5":17015,"_23194":96550,"_2329":96584},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2802":57334,"_24443":57321,"_17120":96586,"_5":17015,"_23194":96554,"_2329":96587},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2802":57335,"_24443":57321,"_17120":96589,"_5":17015,"_23194":96554,"_2329":96590},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2802":57336,"_24443":57321,"_17120":96592,"_5":17015,"_23194":96554,"_2329":96593},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2802":57337,"_24443":57321,"_17120":96595,"_5":17015,"_23194":96554,"_2329":96596},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2802":57338,"_24443":57321,"_17120":96598,"_5":17015,"_23194":96558,"_2329":96599},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2802":57339,"_24443":57321,"_17120":96601,"_5":17015,"_23194":96558,"_2329":96602},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2802":57340,"_24443":57321,"_17120":96604,"_5":17015,"_23194":96558,"_2329":96605},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2802":57341,"_24443":57321,"_17120":96607,"_5":17015,"_23194":96558,"_2329":96608},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2802":57342,"_24443":57321,"_17120":96610,"_5":17015,"_23194":96562,"_2329":96611},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2802":57343,"_24443":57321,"_17120":96613,"_5":17015,"_23194":96562,"_2329":96614},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2802":57344,"_24443":57344,"_5":12033,"_2329":96616,"_24778":96617,"_17120":96618,"_23194":57344},"Estrategias de aprovisionamiento",[39822,94885,42097,95814,95989],[],{"_2802":57345,"_24443":57344,"_17120":96620,"_5":17015,"_23194":57344,"_2329":96621},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2802":57346,"_24443":57344,"_5":24775,"_17120":96623,"_23194":96624,"_2329":96625},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2802":57347,"_24443":57344,"_5":24775,"_17120":96627,"_23194":96628,"_2329":96629},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2802":57348,"_24443":57344,"_5":24775,"_17120":96631,"_23194":96632,"_2329":96633},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2802":57349,"_24443":57344,"_5":24775,"_17120":96635,"_23194":96636,"_2329":96637},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2802":57350,"_24443":57344,"_5":24775,"_17120":96639,"_23194":96640,"_2329":96641},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2802":57351,"_24443":57344,"_17120":96643,"_5":17015,"_23194":57344,"_2329":96644},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2802":57352,"_24443":57344,"_17120":96646,"_5":17015,"_23194":96624,"_2329":96647},[],"Recorrido",{"_2802":57353,"_24443":57344,"_17120":96649,"_5":17015,"_23194":96624,"_2329":96650},[],"Cuándo existe el dispositivo",{"_2802":57354,"_24443":57344,"_17120":96652,"_5":17015,"_23194":96624,"_2329":96653},[],"Qué compruebas",{"_2802":57355,"_24443":57344,"_17120":96655,"_5":17015,"_23194":96624,"_2329":96656},[],"Asignación manual",{"_2802":57356,"_24443":57344,"_17120":96658,"_5":17015,"_23194":96624,"_2329":96659},[],"El operador lo crea antes de asociar un certificado.",{"_2802":57357,"_24443":57344,"_17120":96661,"_5":17015,"_23194":96624,"_2329":96662},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2802":57358,"_24443":57344,"_17120":96664,"_5":17015,"_23194":96624,"_2329":96665},[],"EST con `JITP`",{"_2802":57359,"_24443":57344,"_17120":96667,"_5":17015,"_23194":96624,"_2329":96668},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2802":57360,"_24443":57344,"_17120":96670,"_5":17015,"_23194":96624,"_2329":96671},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2802":57361,"_24443":57344,"_17120":96673,"_5":17015,"_23194":96624,"_2329":96674},[],"EST con `PRE_REGISTRATION`",{"_2802":57362,"_24443":57344,"_17120":96676,"_5":17015,"_23194":96624,"_2329":96677},[],"Debe existir antes de `/simpleenroll`.",{"_2802":57363,"_24443":57344,"_17120":96679,"_5":17015,"_23194":96624,"_2329":96680},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2802":57364,"_24443":57344,"_17120":96682,"_5":17015,"_23194":96624,"_2329":96683},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2802":57365,"_24443":57344,"_17120":96685,"_5":17015,"_23194":96624,"_2329":96686},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2802":57366,"_24443":57344,"_17120":96688,"_5":17015,"_23194":96628,"_2329":96689},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2802":57367,"_24443":57344,"_17120":96691,"_5":17015,"_23194":96628,"_2329":96692},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2802":57368,"_24443":57344,"_17120":96694,"_5":17015,"_23194":96628,"_2329":96695},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2802":57369,"_24443":57344,"_17120":96697,"_5":17015,"_23194":96632,"_2329":96698},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2802":57370,"_24443":57344,"_17120":96700,"_5":17015,"_23194":96632,"_2329":96701},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2802":57371,"_24443":57344,"_17120":96703,"_5":17015,"_23194":96632,"_2329":96704},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2802":57372,"_24443":57344,"_17120":96706,"_5":17015,"_23194":96632,"_2329":96707},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2802":57373,"_24443":57344,"_17120":96709,"_5":17015,"_23194":96632,"_2329":96710},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2802":57374,"_24443":57344,"_17120":96712,"_5":17015,"_23194":96632,"_2329":96713},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2802":57375,"_24443":57344,"_17120":96715,"_5":17015,"_23194":96636,"_2329":93943},[],{"_2802":57376,"_24443":57344,"_17120":96717,"_5":17015,"_23194":96636,"_2329":96718},[],"Material que atraviesa EST",{"_2802":57377,"_24443":57344,"_17120":96720,"_5":17015,"_23194":96636,"_2329":96721},[],"Clave generada por el dispositivo",{"_2802":57378,"_24443":57344,"_17120":96723,"_5":17015,"_23194":96636,"_2329":96724},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2802":57379,"_24443":57344,"_17120":96726,"_5":17015,"_23194":96636,"_2329":96727},[],"Clave ya disponible en el dispositivo",{"_2802":57380,"_24443":57344,"_17120":96729,"_5":17015,"_23194":96636,"_2329":96730},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2802":57381,"_24443":57344,"_17120":96732,"_5":17015,"_23194":96636,"_2329":42412},[],{"_2802":57382,"_24443":57344,"_17120":96734,"_5":17015,"_23194":96636,"_2329":96735},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2802":57383,"_24443":57344,"_17120":96737,"_5":17015,"_23194":96636,"_2329":96738},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2802":57384,"_24443":57344,"_17120":96740,"_5":17015,"_23194":96640,"_2329":96741},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2802":57385,"_24443":57385,"_5":12033,"_2329":96743,"_24778":96744,"_17120":96745,"_23194":57385},"Renovación y recuperación",[39822,94885,42097,95814,95989],[],{"_2802":57386,"_24443":57385,"_17120":96747,"_5":17015,"_23194":57385,"_2329":96748},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2802":57387,"_24443":57385,"_5":24775,"_17120":96750,"_23194":96751,"_2329":96752},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2802":57388,"_24443":57385,"_5":24775,"_17120":96754,"_23194":96755,"_2329":96756},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2802":57389,"_24443":57385,"_5":24775,"_17120":96758,"_23194":96759,"_2329":96760},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2802":57390,"_24443":57385,"_5":24775,"_17120":96762,"_23194":96763,"_2329":96764},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2802":57391,"_24443":57385,"_5":24775,"_17120":96766,"_23194":96767,"_2329":96768},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2802":57392,"_24443":57385,"_17120":96770,"_5":17015,"_23194":57385,"_2329":96771},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2802":57393,"_24443":57385,"_17120":96773,"_5":17015,"_23194":96751,"_2329":96774},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2802":57394,"_24443":57385,"_17120":96776,"_5":17015,"_23194":96751,"_2329":96777},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2802":57395,"_24443":57385,"_17120":96779,"_5":17015,"_23194":96751,"_2329":96780},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2802":57396,"_24443":57385,"_17120":96782,"_5":17015,"_23194":96751,"_2329":96783},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2802":57397,"_24443":57385,"_17120":96785,"_5":17015,"_23194":96755,"_2329":96786},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2802":57398,"_24443":57385,"_17120":96788,"_5":17015,"_23194":96755,"_2329":96789},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2802":57399,"_24443":57385,"_17120":96791,"_5":17015,"_23194":96759,"_2329":96792},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2802":57400,"_24443":57385,"_17120":96794,"_5":17015,"_23194":96759,"_2329":96795},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2802":57401,"_24443":57385,"_17120":96797,"_5":17015,"_23194":96759,"_2329":96798},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2802":57402,"_24443":57385,"_17120":96800,"_5":17015,"_23194":96763,"_2329":96801},[],"Situación",{"_2802":57403,"_24443":57385,"_17120":96803,"_5":17015,"_23194":96763,"_2329":96804},[],"Procedimiento",{"_2802":57404,"_24443":57385,"_17120":96806,"_5":17015,"_23194":96763,"_2329":96807},[],"Certificado vigente, fuera de ventana",{"_2802":57405,"_24443":57385,"_17120":96809,"_5":17015,"_23194":96763,"_2329":96810},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2802":57406,"_24443":57385,"_17120":96812,"_5":17015,"_23194":96763,"_2329":96813},[],"Certificado vencido, clave disponible",{"_2802":57407,"_24443":57385,"_17120":96815,"_5":17015,"_23194":96763,"_2329":96816},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2802":57408,"_24443":57385,"_17120":96818,"_5":17015,"_23194":96763,"_2329":96819},[],"Renovación por webhook o `NO_AUTH`",{"_2802":57409,"_24443":57385,"_17120":96821,"_5":17015,"_23194":96763,"_2329":96822},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2802":57410,"_24443":57385,"_17120":96824,"_5":17015,"_23194":96763,"_2329":96825},[],"Clave perdida o inaccesible",{"_2802":57411,"_24443":57385,"_17120":96827,"_5":17015,"_23194":96763,"_2329":96828},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2802":57412,"_24443":57385,"_17120":96830,"_5":17015,"_23194":96763,"_2329":96831},[],"Identidad actual revocada",{"_2802":57413,"_24443":57385,"_17120":96833,"_5":17015,"_23194":96763,"_2329":96834},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2802":57414,"_24443":57385,"_17120":96836,"_5":17015,"_23194":96763,"_2329":96837},[],"Dispositivo sin identidad",{"_2802":57415,"_24443":57385,"_17120":96839,"_5":17015,"_23194":96763,"_2329":96840},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2802":57416,"_24443":57385,"_17120":96842,"_5":17015,"_23194":96763,"_2329":96843},[],"Dispositivo retirado",{"_2802":57417,"_24443":57385,"_17120":96845,"_5":17015,"_23194":96763,"_2329":96846},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2802":57418,"_24443":57385,"_17120":96848,"_5":17015,"_23194":96763,"_2329":96849},[],"Timeout, HTTP 500 o fallo de instalación",{"_2802":57419,"_24443":57385,"_17120":96851,"_5":17015,"_23194":96763,"_2329":96852},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2802":57420,"_24443":57385,"_17120":96854,"_5":17015,"_23194":96767,"_2329":96855},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2802":57421,"_24443":57385,"_17120":96857,"_5":17015,"_23194":96767,"_2329":96858},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2802":57422,"_24443":57422,"_5":12033,"_2329":96860,"_24778":96861,"_17120":96862,"_23194":57422},"Diagnóstico de enrolamiento",[39822,94885,42097,95814,95989],[],{"_2802":57423,"_24443":57422,"_17120":96864,"_5":17015,"_23194":57422,"_2329":96865},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2802":57424,"_24443":57422,"_5":24775,"_17120":96867,"_23194":96868,"_2329":96869},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2802":57425,"_24443":57422,"_5":24775,"_17120":96871,"_23194":96872,"_2329":96873},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2802":57426,"_24443":57422,"_5":24775,"_17120":96875,"_23194":96876,"_2329":96432},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2802":57427,"_24443":57422,"_5":24775,"_17120":96878,"_23194":96879,"_2329":96880},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2802":57428,"_24443":57422,"_17120":96882,"_5":17015,"_23194":57422,"_2329":96883},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2802":57429,"_24443":57422,"_17120":96885,"_5":17015,"_23194":96872,"_2329":96886},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2802":57430,"_24443":57422,"_17120":96888,"_5":17015,"_23194":96872,"_2329":96889},[],"Síntoma o mensaje",{"_2802":57431,"_24443":57422,"_17120":96891,"_5":17015,"_23194":96872,"_2329":96892},[],"Qué revisar",{"_2802":57432,"_24443":57422,"_17120":96894,"_5":17015,"_23194":96872,"_2329":96895},[],"curl rechaza TLS, nombre o emisor",{"_2802":57433,"_24443":57422,"_17120":96897,"_5":17015,"_23194":96872,"_2329":96898},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2802":57434,"_24443":57422,"_17120":96900,"_5":17015,"_23194":96872,"_2329":96901},[],"404 o APS ausente",{"_2802":57435,"_24443":57422,"_17120":96903,"_5":17015,"_23194":96872,"_2329":96904},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2802":57436,"_24443":57422,"_17120":96906,"_5":17015,"_23194":96872,"_2329":96907},[],"400, error de CSR o formato",{"_2802":57437,"_24443":57422,"_17120":96909,"_5":17015,"_23194":96872,"_2329":96910},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2802":57438,"_24443":57422,"_17120":96912,"_5":17015,"_23194":96872,"_2329":96913},[],"Credencial ausente o certificado no válido",{"_2802":57439,"_24443":57422,"_17120":96915,"_5":17015,"_23194":96872,"_2329":96916},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2802":57440,"_24443":57422,"_17120":96918,"_5":17015,"_23194":96872,"_2329":96919},[],"Webhook deniega, expira o responde sin autorización",{"_2802":57441,"_24443":57422,"_17120":96921,"_5":17015,"_23194":96872,"_2329":96922},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2802":57442,"_24443":57422,"_17120":96924,"_5":17015,"_23194":96872,"_2329":43243},[],{"_2802":57443,"_24443":57422,"_17120":96926,"_5":17015,"_23194":96872,"_2329":96927},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2802":57444,"_24443":57422,"_17120":96929,"_5":17015,"_23194":96872,"_2329":43249},[],{"_2802":57445,"_24443":57422,"_17120":96931,"_5":17015,"_23194":96872,"_2329":96932},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2802":57446,"_24443":57422,"_17120":96934,"_5":17015,"_23194":96872,"_2329":96935},[],"DMS propietario distinto",{"_2802":57447,"_24443":57422,"_17120":96937,"_5":17015,"_23194":96872,"_2329":96938},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2802":57448,"_24443":57422,"_17120":96940,"_5":17015,"_23194":96872,"_2329":43261},[],{"_2802":57449,"_24443":57422,"_17120":96942,"_5":17015,"_23194":96872,"_2329":96943},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2802":57450,"_24443":57422,"_17120":96945,"_5":17015,"_23194":96872,"_2329":43267},[],{"_2802":57451,"_24443":57422,"_17120":96947,"_5":17015,"_23194":96872,"_2329":96948},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2802":57452,"_24443":57422,"_17120":96950,"_5":17015,"_23194":96872,"_2329":96951},[],"Certificado actual revocado",{"_2802":57453,"_24443":57422,"_17120":96953,"_5":17015,"_23194":96872,"_2329":96954},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2802":57454,"_24443":57422,"_17120":96956,"_5":17015,"_23194":96872,"_2329":96957},[],"Error de CA, perfil o firma",{"_2802":57455,"_24443":57422,"_17120":96959,"_5":17015,"_23194":96872,"_2329":96960},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2802":57456,"_24443":57422,"_17120":96962,"_5":17015,"_23194":96872,"_2329":96963},[],"HTTP 200 sin conexión del dispositivo",{"_2802":57457,"_24443":57422,"_17120":96965,"_5":17015,"_23194":96872,"_2329":96966},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2802":57458,"_24443":57422,"_17120":96968,"_5":17015,"_23194":96872,"_2329":96969},[],"Timeout o error después de emitir",{"_2802":57459,"_24443":57422,"_17120":96971,"_5":17015,"_23194":96872,"_2329":96972},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2802":57460,"_24443":57422,"_17120":96974,"_5":17015,"_23194":96876,"_2329":96975},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2802":57461,"_24443":57422,"_17120":96977,"_5":17015,"_23194":96876,"_2329":96978},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2802":57462,"_24443":57422,"_17120":96980,"_5":17015,"_23194":96879,"_2329":96981},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2802":57463,"_24443":57422,"_17120":96983,"_5":17015,"_23194":96879,"_2329":96984},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2802":57464,"_24443":57422,"_17120":96986,"_5":17015,"_23194":96879,"_2329":96987},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2802":57465,"_24443":57422,"_17120":96989,"_5":17015,"_23194":96879,"_2329":96990},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2802":57466,"_24443":57422,"_17120":96992,"_5":17015,"_23194":96879,"_2329":96993},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2802":57467,"_24443":57422,"_17120":96995,"_5":17015,"_23194":96879,"_2329":96996},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2802":57468,"_24443":57422,"_17120":96998,"_5":17015,"_23194":96879,"_2329":96999},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2802":57469,"_24443":57469,"_5":12033,"_2329":97001,"_24778":97002,"_17120":97003,"_23194":57469},"Distribución y actualización de confianza",[39822,94885,42097,95814,95989],[],{"_2802":57470,"_24443":57469,"_17120":97005,"_5":17015,"_23194":57469,"_2329":97006},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2802":57471,"_24443":57469,"_5":24775,"_17120":97008,"_23194":97009,"_2329":97010},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2802":57472,"_24443":57469,"_5":24775,"_17120":97012,"_23194":97013,"_2329":97014},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2802":57473,"_24443":57469,"_5":24775,"_17120":97016,"_23194":97017,"_2329":97018},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2802":57474,"_24443":57469,"_5":24775,"_17120":97020,"_23194":97021,"_2329":97022},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2802":57475,"_24443":57469,"_5":24775,"_17120":97024,"_23194":97025,"_2329":97026},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2802":57476,"_24443":57469,"_17120":97028,"_5":17015,"_23194":57469,"_2329":97029},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2802":57477,"_24443":57469,"_17120":97031,"_5":17015,"_23194":97009,"_2329":97032},[],"Relación",{"_2802":57478,"_24443":57469,"_17120":97034,"_5":17015,"_23194":97009,"_2329":97035},[],"Material que prepara el responsable",{"_2802":57479,"_24443":57469,"_17120":97037,"_5":17015,"_23194":97009,"_2329":97038},[],"Dispositivo → servidor EST",{"_2802":57480,"_24443":57469,"_17120":97040,"_5":17015,"_23194":97009,"_2329":97041},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2802":57481,"_24443":57469,"_17120":97043,"_5":17015,"_23194":97009,"_2329":97044},[],"DMS → solicitante",{"_2802":57482,"_24443":57469,"_17120":97046,"_5":17015,"_23194":97009,"_2329":97047},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2802":57483,"_24443":57469,"_17120":97049,"_5":17015,"_23194":97009,"_2329":97050},[],"Consumidor → dispositivo",{"_2802":57484,"_24443":57469,"_17120":97052,"_5":17015,"_23194":97009,"_2329":97053},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2802":57485,"_24443":57469,"_17120":97055,"_5":17015,"_23194":97009,"_2329":97056},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2802":57486,"_24443":57469,"_17120":97058,"_5":17015,"_23194":97013,"_2329":97059},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2802":57487,"_24443":57469,"_17120":97061,"_5":17015,"_23194":97013,"_2329":97062},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2802":57488,"_24443":57469,"_17120":97064,"_5":17015,"_23194":97017,"_2329":97065},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2802":57489,"_24443":57469,"_17120":97067,"_5":17015,"_23194":97017,"_2329":97068},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2802":57490,"_24443":57469,"_17120":97070,"_5":17015,"_23194":97017,"_2329":97071},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2802":57491,"_24443":57469,"_17120":97073,"_5":17015,"_23194":97017,"_2329":97074},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2802":57492,"_24443":57469,"_17120":97076,"_5":17015,"_23194":97017,"_2329":97077},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2802":57493,"_24443":57469,"_17120":97079,"_5":17015,"_23194":97017,"_2329":97080},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2802":57494,"_24443":57469,"_17120":97082,"_5":17015,"_23194":97021,"_2329":97083},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2802":57495,"_24443":57469,"_17120":97085,"_5":17015,"_23194":97021,"_2329":97086},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2802":57496,"_24443":57469,"_17120":97088,"_5":17015,"_23194":97021,"_2329":97089},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2802":57497,"_24443":57469,"_17120":97091,"_5":17015,"_23194":97025,"_2329":97092},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2802":57498,"_24443":57498,"_5":12033,"_2329":43416,"_24778":97094,"_17120":97096,"_23194":57498},[39822,94885,42097,95814,97095],"Integraciones",[],{"_2802":57499,"_24443":57498,"_17120":97098,"_5":17015,"_23194":57498,"_2329":97099},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2802":57500,"_24443":57498,"_5":24775,"_17120":97101,"_23194":97102,"_2329":97103},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2802":57501,"_24443":57498,"_5":24775,"_17120":97105,"_23194":97106,"_2329":97107},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2802":57502,"_24443":57498,"_5":24775,"_17120":97109,"_23194":97110,"_2329":97111},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2802":57503,"_24443":57498,"_5":24775,"_17120":97113,"_23194":97114,"_2329":97115},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2802":57504,"_24443":57498,"_5":24775,"_17120":97117,"_23194":97118,"_2329":97119},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2802":57505,"_24443":57498,"_5":24775,"_17120":97121,"_23194":97122,"_2329":97123},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2802":57506,"_24443":57498,"_5":24775,"_17120":97125,"_23194":97126,"_2329":43450},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2802":57507,"_24443":57498,"_5":24775,"_17120":97128,"_23194":97129,"_2329":43454},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2802":57508,"_24443":57498,"_5":24775,"_17120":97131,"_23194":97132,"_2329":97133},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2802":57509,"_24443":57498,"_5":24775,"_17120":97135,"_23194":97136,"_2329":97137},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2802":57510,"_24443":57498,"_5":24775,"_17120":97139,"_23194":97140,"_2329":97141},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2802":57511,"_24443":57498,"_5":24775,"_17120":97143,"_23194":97144,"_2329":97145},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2802":57512,"_24443":57498,"_5":24775,"_17120":97147,"_23194":97148,"_2329":97149},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2802":57513,"_24443":57498,"_5":24775,"_17120":97151,"_23194":97152,"_2329":97153},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2802":57514,"_24443":57498,"_5":24775,"_17120":97155,"_23194":97156,"_2329":97157},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2802":57515,"_24443":57498,"_5":24775,"_17120":97159,"_23194":97160,"_2329":97161},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2802":57516,"_24443":57498,"_5":24775,"_17120":97163,"_23194":97164,"_2329":97165},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2802":57517,"_24443":57498,"_5":24775,"_17120":97167,"_23194":97168,"_2329":97169},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2802":57518,"_24443":57498,"_5":24775,"_17120":97171,"_23194":97172,"_2329":97173},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2802":57519,"_24443":57498,"_5":24775,"_17120":97175,"_23194":97176,"_2329":97177},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2802":57520,"_24443":57498,"_17120":97179,"_5":17015,"_23194":57498,"_2329":97180},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2802":57521,"_24443":57498,"_17120":97182,"_5":17015,"_23194":57498,"_2329":97183},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2802":57522,"_24443":57498,"_17120":97185,"_5":17015,"_23194":57498,"_2329":97186},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2802":57523,"_24443":57498,"_17120":97188,"_5":17015,"_23194":97102,"_2329":97189},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2802":57524,"_24443":57498,"_17120":97191,"_5":17015,"_23194":97102,"_2329":97192},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2802":57525,"_24443":57498,"_17120":97194,"_5":17015,"_23194":97102,"_2329":97195},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2802":57526,"_24443":57498,"_17120":97197,"_5":17015,"_23194":97102,"_2329":97198},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2802":57527,"_24443":57498,"_17120":97200,"_5":17015,"_23194":97106,"_2329":97201},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2802":57528,"_24443":57498,"_17120":97203,"_5":17015,"_23194":97110,"_2329":97204},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2802":57529,"_24443":57498,"_17120":97206,"_5":17015,"_23194":97110,"_2329":97207},[],"Acción IAM",{"_2802":57530,"_24443":57498,"_17120":97209,"_5":17015,"_23194":97110,"_2329":93949},[],{"_2802":57531,"_24443":57498,"_17120":97211,"_5":17015,"_23194":97110,"_2329":43537},[],{"_2802":57532,"_24443":57498,"_17120":97213,"_5":17015,"_23194":97110,"_2329":97214},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2802":57533,"_24443":57498,"_17120":97216,"_5":17015,"_23194":97110,"_2329":43543},[],{"_2802":57534,"_24443":57498,"_17120":97218,"_5":17015,"_23194":97110,"_2329":97219},[],"Registrar la CA en AWS IoT",{"_2802":57535,"_24443":57498,"_17120":97221,"_5":17015,"_23194":97110,"_2329":43549},[],{"_2802":57536,"_24443":57498,"_17120":97223,"_5":17015,"_23194":97110,"_2329":97224},[],"Consultar el estado del registro de la CA",{"_2802":57537,"_24443":57498,"_17120":97226,"_5":17015,"_23194":97110,"_2329":43555},[],{"_2802":57538,"_24443":57498,"_17120":97228,"_5":17015,"_23194":97110,"_2329":97229},[],"Crear o actualizar Things en IoT Core",{"_2802":57539,"_24443":57498,"_17120":97231,"_5":17015,"_23194":97110,"_2329":43561},[],{"_2802":57540,"_24443":57498,"_17120":97233,"_5":17015,"_23194":97110,"_2329":97234},[],"Aprovisionar Things mediante plantilla",{"_2802":57541,"_24443":57498,"_17120":97236,"_5":17015,"_23194":97110,"_2329":43567},[],{"_2802":57542,"_24443":57498,"_17120":97238,"_5":17015,"_23194":97110,"_2329":97239},[],"Registrar certificados de dispositivo",{"_2802":57543,"_24443":57498,"_17120":97241,"_5":17015,"_23194":97110,"_2329":43573},[],{"_2802":57544,"_24443":57498,"_17120":97243,"_5":17015,"_23194":97110,"_2329":97244},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2802":57545,"_24443":57498,"_17120":97246,"_5":17015,"_23194":97110,"_2329":43579},[],{"_2802":57546,"_24443":57498,"_17120":97248,"_5":17015,"_23194":97110,"_2329":97249},[],"Crear y adjuntar políticas IoT",{"_2802":57547,"_24443":57498,"_17120":97251,"_5":17015,"_23194":97110,"_2329":43585},[],{"_2802":57548,"_24443":57498,"_17120":97253,"_5":17015,"_23194":97110,"_2329":97254},[],"Gestionar grupos de Things",{"_2802":57549,"_24443":57498,"_17120":97256,"_5":17015,"_23194":97110,"_2329":43591},[],{"_2802":57550,"_24443":57498,"_17120":97258,"_5":17015,"_23194":97110,"_2329":97259},[],"Crear plantillas JITP",{"_2802":57551,"_24443":57498,"_17120":97261,"_5":17015,"_23194":97110,"_2329":43597},[],{"_2802":57552,"_24443":57498,"_17120":97263,"_5":17015,"_23194":97110,"_2329":97264},[],"Leer y escribir el Device Shadow",{"_2802":57553,"_24443":57498,"_17120":97266,"_5":17015,"_23194":97110,"_2329":97267},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2802":57554,"_24443":57498,"_17120":97269,"_5":17015,"_23194":97114,"_2329":97270},[],"Parámetro",{"_2802":57555,"_24443":57498,"_17120":97272,"_5":17015,"_23194":97114,"_2329":97273},[],"Tipo",{"_2802":57556,"_24443":57498,"_17120":97275,"_5":17015,"_23194":97114,"_2329":97276},[],"Requerido",{"_2802":57557,"_24443":57498,"_17120":97278,"_5":17015,"_23194":97114,"_2329":97279},[],"Descripción",{"_2802":57558,"_24443":57498,"_17120":97281,"_5":17015,"_23194":97114,"_2329":43618},[],{"_2802":57559,"_24443":57498,"_17120":97283,"_5":17015,"_23194":97114,"_2329":20415},[],{"_2802":57560,"_24443":57498,"_17120":97285,"_5":17015,"_23194":97114,"_2329":97286},[],"Sí",{"_2802":57561,"_24443":57498,"_17120":97288,"_5":17015,"_23194":97114,"_2329":97289},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2802":57562,"_24443":57498,"_17120":97291,"_5":17015,"_23194":97114,"_2329":43629},[],{"_2802":57563,"_24443":57498,"_17120":97293,"_5":17015,"_23194":97114,"_2329":20415},[],{"_2802":57564,"_24443":57498,"_17120":97295,"_5":17015,"_23194":97114,"_2329":97286},[],{"_2802":57565,"_24443":57498,"_17120":97297,"_5":17015,"_23194":97114,"_2329":97298},[],"Región AWS donde opera el conector.",{"_2802":57566,"_24443":57498,"_17120":97300,"_5":17015,"_23194":97114,"_2329":43639},[],{"_2802":57567,"_24443":57498,"_17120":97302,"_5":17015,"_23194":97114,"_2329":20415},[],{"_2802":57568,"_24443":57498,"_17120":97304,"_5":17015,"_23194":97114,"_2329":97286},[],{"_2802":57569,"_24443":57498,"_17120":97306,"_5":17015,"_23194":97114,"_2329":97307},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2802":57570,"_24443":57498,"_17120":97309,"_5":17015,"_23194":97114,"_2329":43649},[],{"_2802":57571,"_24443":57498,"_17120":97311,"_5":17015,"_23194":97114,"_2329":20415},[],{"_2802":57572,"_24443":57498,"_17120":97313,"_5":17015,"_23194":97114,"_2329":97314},[],"Solo con `auth_method=static`",{"_2802":57573,"_24443":57498,"_17120":97316,"_5":17015,"_23194":97114,"_2329":97317},[],"Clave de acceso AWS.",{"_2802":57574,"_24443":57498,"_17120":97319,"_5":17015,"_23194":97114,"_2329":43660},[],{"_2802":57575,"_24443":57498,"_17120":97321,"_5":17015,"_23194":97114,"_2329":20415},[],{"_2802":57576,"_24443":57498,"_17120":97323,"_5":17015,"_23194":97114,"_2329":97314},[],{"_2802":57577,"_24443":57498,"_17120":97325,"_5":17015,"_23194":97114,"_2329":97326},[],"Clave secreta AWS.",{"_2802":57578,"_24443":57498,"_17120":97328,"_5":17015,"_23194":97114,"_2329":43670},[],{"_2802":57579,"_24443":57498,"_17120":97330,"_5":17015,"_23194":97114,"_2329":20415},[],{"_2802":57580,"_24443":57498,"_17120":97332,"_5":17015,"_23194":97114,"_2329":43675},[],{"_2802":57581,"_24443":57498,"_17120":97334,"_5":17015,"_23194":97114,"_2329":97335},[],"Token de sesión (con `auth_method=static`).",{"_2802":57582,"_24443":57498,"_17120":97337,"_5":17015,"_23194":97114,"_2329":43681},[],{"_2802":57583,"_24443":57498,"_17120":97339,"_5":17015,"_23194":97114,"_2329":20415},[],{"_2802":57584,"_24443":57498,"_17120":97341,"_5":17015,"_23194":97114,"_2329":97342},[],"Solo con `auth_method=role`",{"_2802":57585,"_24443":57498,"_17120":97344,"_5":17015,"_23194":97114,"_2329":97345},[],"ARN del rol a asumir.",{"_2802":57586,"_24443":57498,"_17120":97347,"_5":17015,"_23194":97114,"_2329":43692},[],{"_2802":57587,"_24443":57498,"_17120":97349,"_5":17015,"_23194":97114,"_2329":20415},[],{"_2802":57588,"_24443":57498,"_17120":97351,"_5":17015,"_23194":97114,"_2329":43675},[],{"_2802":57589,"_24443":57498,"_17120":97353,"_5":17015,"_23194":97114,"_2329":97354},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2802":57590,"_24443":57498,"_17120":97356,"_5":17015,"_23194":97114,"_2329":43702},[],{"_2802":57591,"_24443":57498,"_17120":97358,"_5":17015,"_23194":97114,"_2329":14408},[],{"_2802":57592,"_24443":57498,"_17120":97360,"_5":17015,"_23194":97114,"_2329":97286},[],{"_2802":57593,"_24443":57498,"_17120":97362,"_5":17015,"_23194":97114,"_2329":97363},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2802":57594,"_24443":57498,"_17120":97365,"_5":17015,"_23194":97114,"_2329":43712},[],{"_2802":57595,"_24443":57498,"_17120":97367,"_5":17015,"_23194":97114,"_2329":20415},[],{"_2802":57596,"_24443":57498,"_17120":97369,"_5":17015,"_23194":97114,"_2329":97286},[],{"_2802":57597,"_24443":57498,"_17120":97371,"_5":17015,"_23194":97114,"_2329":97372},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2802":57598,"_24443":57498,"_17120":97374,"_5":17015,"_23194":97114,"_2329":43722},[],{"_2802":57599,"_24443":57498,"_17120":97376,"_5":17015,"_23194":97114,"_2329":20415},[],{"_2802":57600,"_24443":57498,"_17120":97378,"_5":17015,"_23194":97114,"_2329":97286},[],{"_2802":57601,"_24443":57498,"_17120":97380,"_5":17015,"_23194":97114,"_2329":97381},[],"URL HTTP del Device Manager de Lamassu.",{"_2802":57602,"_24443":57498,"_17120":97383,"_5":17015,"_23194":97114,"_2329":43732},[],{"_2802":57603,"_24443":57498,"_17120":97385,"_5":17015,"_23194":97114,"_2329":20415},[],{"_2802":57604,"_24443":57498,"_17120":97387,"_5":17015,"_23194":97114,"_2329":97286},[],{"_2802":57605,"_24443":57498,"_17120":97389,"_5":17015,"_23194":97114,"_2329":97390},[],"URL HTTP del servicio de CA de Lamassu.",{"_2802":57606,"_24443":57498,"_17120":97392,"_5":17015,"_23194":97118,"_2329":97393},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2802":57607,"_24443":57498,"_17120":97395,"_5":17015,"_23194":97122,"_2329":97396},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2802":57608,"_24443":57498,"_17120":97398,"_5":17015,"_23194":97122,"_2329":97399},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2802":57609,"_24443":57498,"_17120":97401,"_5":17015,"_23194":97126,"_2329":97402},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2802":57610,"_24443":57498,"_17120":97404,"_5":17015,"_23194":97126,"_2329":97405},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2802":57611,"_24443":57498,"_17120":97407,"_5":17015,"_23194":97126,"_2329":97408},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2802":57612,"_24443":57498,"_17120":97410,"_5":17015,"_23194":97126,"_2329":97411},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2802":57613,"_24443":57498,"_17120":97413,"_5":17015,"_23194":97126,"_2329":97414},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2802":57614,"_24443":57498,"_17120":97416,"_5":17015,"_23194":97126,"_2329":97417},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2802":57615,"_24443":57498,"_17120":97419,"_5":17015,"_23194":97129,"_2329":97420},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2802":57616,"_24443":57498,"_17120":97422,"_5":17015,"_23194":97132,"_2329":97423},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2802":57617,"_24443":57498,"_17120":97425,"_5":17015,"_23194":97132,"_2329":97426},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2802":57618,"_24443":57498,"_17120":97428,"_5":17015,"_23194":97136,"_2329":97429},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2802":57619,"_24443":57498,"_17120":97431,"_5":17015,"_23194":97140,"_2329":97432},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2802":57620,"_24443":57498,"_17120":97434,"_5":17015,"_23194":97140,"_2329":97435},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2802":57621,"_24443":57498,"_17120":97437,"_5":17015,"_23194":97140,"_2329":97438},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2802":57622,"_24443":57498,"_17120":97440,"_5":17015,"_23194":97140,"_2329":97441},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2802":57623,"_24443":57498,"_17120":97443,"_5":17015,"_23194":97140,"_2329":97444},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2802":57624,"_24443":57498,"_17120":97446,"_5":17015,"_23194":97140,"_2329":97447},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2802":57625,"_24443":57498,"_17120":97449,"_5":17015,"_23194":97144,"_2329":97450},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2802":57626,"_24443":57498,"_17120":97452,"_5":17015,"_23194":97144,"_2329":97453},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2802":57627,"_24443":57498,"_17120":97455,"_5":17015,"_23194":97144,"_2329":97456},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2802":57628,"_24443":57498,"_17120":97458,"_5":17015,"_23194":97148,"_2329":97459},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2802":57629,"_24443":57498,"_17120":97461,"_5":17015,"_23194":97148,"_2329":97462},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2802":57630,"_24443":57498,"_17120":97464,"_5":17015,"_23194":97148,"_2329":97465},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2802":57631,"_24443":57498,"_17120":97467,"_5":17015,"_23194":97152,"_2329":97468},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2802":57632,"_24443":57498,"_17120":97470,"_5":17015,"_23194":97152,"_2329":97471},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2802":57633,"_24443":57498,"_17120":97473,"_5":17015,"_23194":97152,"_2329":97474},[],"Para que el flujo JITP funcione correctamente:",{"_2802":57634,"_24443":57498,"_17120":97476,"_5":17015,"_23194":97152,"_2329":97477},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2802":57635,"_24443":57498,"_17120":97479,"_5":17015,"_23194":97152,"_2329":97480},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2802":57636,"_24443":57498,"_17120":97482,"_5":17015,"_23194":97152,"_2329":97483},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2802":57637,"_24443":57498,"_17120":97485,"_5":17015,"_23194":97152,"_2329":97486},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2802":57638,"_24443":57498,"_17120":97488,"_5":17015,"_23194":97156,"_2329":97489},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2802":57639,"_24443":57498,"_17120":97491,"_5":17015,"_23194":97156,"_2329":97492},[],"Estado en Lamassu",{"_2802":57640,"_24443":57498,"_17120":97494,"_5":17015,"_23194":97156,"_2329":97495},[],"Razón de revocación",{"_2802":57641,"_24443":57498,"_17120":97497,"_5":17015,"_23194":97156,"_2329":97498},[],"Estado en AWS IoT Core",{"_2802":57642,"_24443":57498,"_17120":97500,"_5":17015,"_23194":97156,"_2329":43853},[],{"_2802":57643,"_24443":57498,"_17120":97502,"_5":17015,"_23194":97156,"_2329":97503},[],"Ninguna",{"_2802":57644,"_24443":57498,"_17120":97505,"_5":17015,"_23194":97156,"_2329":43859},[],{"_2802":57645,"_24443":57498,"_17120":97507,"_5":17015,"_23194":97156,"_2329":43862},[],{"_2802":57646,"_24443":57498,"_17120":97509,"_5":17015,"_23194":97156,"_2329":43865},[],{"_2802":57647,"_24443":57498,"_17120":97511,"_5":17015,"_23194":97156,"_2329":43868},[],{"_2802":57648,"_24443":57498,"_17120":97513,"_5":17015,"_23194":97156,"_2329":43862},[],{"_2802":57649,"_24443":57498,"_17120":97515,"_5":17015,"_23194":97156,"_2329":97516},[],"Cualquier otra razón",{"_2802":57650,"_24443":57498,"_17120":97518,"_5":17015,"_23194":97156,"_2329":43876},[],{"_2802":57651,"_24443":57498,"_17120":97520,"_5":17015,"_23194":97156,"_2329":97521},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2802":57652,"_24443":57498,"_17120":97523,"_5":17015,"_23194":97160,"_2329":97524},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2802":57653,"_24443":57498,"_17120":97526,"_5":17015,"_23194":97160,"_2329":97527},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2802":57654,"_24443":57498,"_17120":97529,"_5":17015,"_23194":97160,"_2329":97530},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2802":57655,"_24443":57498,"_17120":97532,"_5":17015,"_23194":97164,"_2329":97533},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2802":57656,"_24443":57498,"_17120":97535,"_5":17015,"_23194":97164,"_2329":97536},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2802":57657,"_24443":57498,"_17120":97538,"_5":17015,"_23194":97168,"_2329":97539},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2802":57658,"_24443":57498,"_17120":97541,"_5":17015,"_23194":97168,"_2329":97542},[],"Existen dos tipos de acciones:",{"_2802":57659,"_24443":57498,"_17120":97544,"_5":17015,"_23194":97168,"_2329":97545},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2802":57660,"_24443":57498,"_17120":97547,"_5":17015,"_23194":97168,"_2329":97548},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2802":57661,"_24443":57498,"_17120":97550,"_5":17015,"_23194":97168,"_2329":97551},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2802":57662,"_24443":57498,"_17120":97553,"_5":17015,"_23194":97172,"_2329":97554},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2802":57663,"_24443":57498,"_17120":97556,"_5":17015,"_23194":97172,"_2329":97557},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2802":57664,"_24443":57498,"_17120":97559,"_5":17015,"_23194":97172,"_2329":97560},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2802":57665,"_24443":57498,"_17120":97562,"_5":17015,"_23194":97176,"_2329":97563},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2802":57666,"_24443":57498,"_17120":97565,"_5":17015,"_23194":97176,"_2329":97566},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2802":57667,"_24443":57498,"_17120":97568,"_5":17015,"_23194":97176,"_2329":97569},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2802":57668,"_24443":57498,"_17120":97571,"_5":17015,"_23194":97176,"_2329":97572},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2802":57669,"_24443":57498,"_17120":97574,"_5":17015,"_23194":97176,"_2329":97575},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2802":57670,"_24443":57498,"_17120":97577,"_5":17015,"_23194":97176,"_2329":97578},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2802":57671,"_24443":57498,"_17120":97580,"_5":17015,"_23194":97176,"_2329":97581},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2802":57672,"_24443":57498,"_17120":97583,"_5":17015,"_23194":97176,"_2329":97584},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2802":57673,"_24443":57498,"_17120":97586,"_5":17015,"_23194":97176,"_2329":97587},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2802":57674,"_24443":57498,"_17120":97589,"_5":17015,"_23194":97176,"_2329":97590},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2802":57675,"_24443":57498,"_17120":97592,"_5":17015,"_23194":97176,"_2329":97593},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2802":57676,"_24443":57498,"_17120":97595,"_5":17015,"_23194":97176,"_2329":97596},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2802":57677,"_24443":57498,"_17120":97598,"_5":17015,"_23194":97176,"_2329":97599},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2802":57678,"_24443":57498,"_17120":97601,"_5":17015,"_23194":97176,"_2329":97602},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2802":57679,"_24443":57498,"_17120":97604,"_5":17015,"_23194":97176,"_2329":97605},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2802":57680,"_24443":57498,"_17120":97607,"_5":17015,"_23194":97176,"_2329":97608},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2802":57681,"_24443":57498,"_17120":97610,"_5":17015,"_23194":97176,"_2329":97611},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2802":57682,"_24443":57498,"_17120":97613,"_5":17015,"_23194":97176,"_2329":97614},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2802":57683,"_24443":57498,"_17120":97616,"_5":17015,"_23194":97176,"_2329":97617},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2802":57684,"_24443":57498,"_17120":97619,"_5":17015,"_23194":97176,"_2329":97620},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2802":57685,"_24443":57498,"_17120":97622,"_5":17015,"_23194":97176,"_2329":97623},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2802":57686,"_24443":57686,"_5":12033,"_2329":42097,"_24778":97625,"_17120":97626,"_23194":57686},[39822,94885,42097],[],{"_2802":57687,"_24443":57686,"_17120":97628,"_5":17015,"_23194":57686,"_2329":97629},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2802":57688,"_24443":57686,"_5":24775,"_17120":97631,"_23194":97632,"_2329":97633},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2802":57689,"_24443":57686,"_5":24775,"_17120":97635,"_23194":97636,"_2329":95814},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2802":57690,"_24443":57686,"_5":24775,"_17120":97638,"_23194":97639,"_2329":95989},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2802":57691,"_24443":57686,"_5":24775,"_17120":97641,"_23194":97642,"_2329":97095},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/overview#integraciones",{"_2802":57692,"_24443":57686,"_5":24775,"_17120":97644,"_23194":97645,"_2329":97646},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2802":57693,"_24443":57686,"_17120":97648,"_5":17015,"_23194":57686,"_2329":97649},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2802":57694,"_24443":57686,"_17120":97651,"_5":17015,"_23194":97632,"_2329":97652},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2802":57695,"_24443":57686,"_17120":97654,"_5":17015,"_23194":97632,"_2329":97655},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2802":57696,"_24443":57686,"_17120":97657,"_5":17015,"_23194":97636,"_2329":97658},[],"Recurso",{"_2802":57697,"_24443":57686,"_17120":97660,"_5":17015,"_23194":97636,"_2329":97661},[],"Qué representa",{"_2802":57698,"_24443":57686,"_17120":97663,"_5":17015,"_23194":97636,"_2329":97664},[],"**Dispositivo**",{"_2802":57699,"_24443":57686,"_17120":97666,"_5":17015,"_23194":97636,"_2329":97667},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2802":57700,"_24443":57686,"_17120":97669,"_5":17015,"_23194":97636,"_2329":97670},[],"**Identidad**",{"_2802":57701,"_24443":57686,"_17120":97672,"_5":17015,"_23194":97636,"_2329":97673},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2802":57702,"_24443":57686,"_17120":97675,"_5":17015,"_23194":97636,"_2329":44034},[],{"_2802":57703,"_24443":57686,"_17120":97677,"_5":17015,"_23194":97636,"_2329":97678},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2802":57704,"_24443":57686,"_17120":97680,"_5":17015,"_23194":97636,"_2329":97681},[],"**Flota**",{"_2802":57705,"_24443":57686,"_17120":97683,"_5":17015,"_23194":97636,"_2329":97684},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2802":57706,"_24443":57686,"_17120":97686,"_5":17015,"_23194":97636,"_2329":97687},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2802":57707,"_24443":57686,"_17120":97689,"_5":17015,"_23194":97636,"_2329":97690},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2802":57708,"_24443":57686,"_17120":97692,"_5":17015,"_23194":97639,"_2329":97693},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2802":57709,"_24443":57686,"_17120":97695,"_5":17015,"_23194":97639,"_2329":97696},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2802":57710,"_24443":57686,"_17120":97698,"_5":17015,"_23194":97639,"_2329":97699},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2802":57711,"_24443":57686,"_17120":97701,"_5":17015,"_23194":97639,"_2329":97702},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2802":57712,"_24443":57686,"_17120":97704,"_5":17015,"_23194":97639,"_2329":97705},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2802":57713,"_24443":57686,"_17120":97707,"_5":17015,"_23194":97639,"_2329":97708},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2802":57714,"_24443":57686,"_17120":97710,"_5":17015,"_23194":97639,"_2329":97711},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2802":57715,"_24443":57686,"_17120":97713,"_5":17015,"_23194":97639,"_2329":97714},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2802":57716,"_24443":57686,"_17120":97716,"_5":17015,"_23194":97642,"_2329":97717},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2802":57717,"_24443":57686,"_17120":97719,"_5":17015,"_23194":97642,"_2329":97720},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2802":57718,"_24443":57686,"_17120":97722,"_5":17015,"_23194":97645,"_2329":97723},[],"Participante",{"_2802":57719,"_24443":57686,"_17120":97725,"_5":17015,"_23194":97645,"_2329":97726},[],"Responsabilidad",{"_2802":57720,"_24443":57686,"_17120":97728,"_5":17015,"_23194":97645,"_2329":97729},[],"Administrador PKI",{"_2802":57721,"_24443":57686,"_17120":97731,"_5":17015,"_23194":97645,"_2329":97732},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2802":57722,"_24443":57686,"_17120":97734,"_5":17015,"_23194":97645,"_2329":97735},[],"Administrador del aprovisionamiento",{"_2802":57723,"_24443":57686,"_17120":97737,"_5":17015,"_23194":97645,"_2329":97738},[],"DMS, admisión, autenticación por operación e inventario.",{"_2802":57724,"_24443":57686,"_17120":97740,"_5":17015,"_23194":97645,"_2329":97741},[],"Integrador del dispositivo",{"_2802":57725,"_24443":57686,"_17120":97743,"_5":17015,"_23194":97645,"_2329":97744},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2802":57726,"_24443":57686,"_17120":97746,"_5":17015,"_23194":97645,"_2329":97747},[],"Integrador del consumidor",{"_2802":57727,"_24443":57686,"_17120":97749,"_5":17015,"_23194":97645,"_2329":97750},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2802":57728,"_24443":57686,"_17120":97752,"_5":17015,"_23194":97645,"_2329":97753},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2802":57729,"_24443":57729,"_5":12033,"_2329":97755,"_24778":97756,"_17120":97758,"_23194":57729},"Enrola y conecta tu primer dispositivo",[39822,94885,42097,97757],"Primeros pasos",[],{"_2802":57730,"_24443":57729,"_17120":97760,"_5":17015,"_23194":57729,"_2329":97761},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2802":57731,"_24443":57729,"_5":24775,"_17120":97763,"_23194":97764,"_2329":93586},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2802":57732,"_24443":57729,"_5":24775,"_17120":97766,"_23194":97767,"_2329":97768},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2802":57733,"_24443":57729,"_5":24775,"_17120":97770,"_23194":97771,"_2329":97772},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2802":57734,"_24443":57729,"_5":24775,"_17120":97774,"_23194":97775,"_2329":97776},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2802":57735,"_24443":57729,"_5":24775,"_17120":97778,"_23194":97779,"_2329":97780},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2802":57736,"_24443":57729,"_5":24775,"_17120":97782,"_23194":97783,"_2329":97784},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2802":57737,"_24443":57729,"_5":24775,"_17120":97786,"_23194":97787,"_2329":97788},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2802":57738,"_24443":57729,"_5":24775,"_17120":97790,"_23194":97791,"_2329":97792},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2802":57739,"_24443":57729,"_17120":97794,"_5":17015,"_23194":57729,"_2329":97795},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2802":57740,"_24443":57729,"_17120":97797,"_5":17015,"_23194":97764,"_2329":97798},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2802":57741,"_24443":57729,"_17120":97800,"_5":17015,"_23194":97764,"_2329":97801},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2802":57742,"_24443":57729,"_17120":97803,"_5":17015,"_23194":97764,"_2329":97804},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2802":57743,"_24443":57729,"_17120":97806,"_5":17015,"_23194":97764,"_2329":97807},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2802":57744,"_24443":57729,"_17120":97809,"_5":17015,"_23194":97764,"_2329":97810},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2802":57745,"_24443":57729,"_17120":97812,"_5":17015,"_23194":97767,"_2329":97813},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2802":57746,"_24443":57729,"_17120":97815,"_5":17015,"_23194":97767,"_2329":97816},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2802":57747,"_24443":57729,"_17120":97818,"_5":17015,"_23194":97771,"_2329":97819},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2802":57748,"_24443":57729,"_17120":97821,"_5":17015,"_23194":97771,"_2329":97822},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2802":57749,"_24443":57729,"_17120":97824,"_5":17015,"_23194":97771,"_2329":97825},[],"Ajuste",{"_2802":57750,"_24443":57729,"_17120":97827,"_5":17015,"_23194":97771,"_2329":97828},[],"Valor de evaluación",{"_2802":57751,"_24443":57729,"_17120":97830,"_5":17015,"_23194":97771,"_2329":44190},[],{"_2802":57752,"_24443":57729,"_17120":97832,"_5":17015,"_23194":97771,"_2329":97833},[],"Raíz emisora de `device-root.pem`.",{"_2802":57753,"_24443":57729,"_17120":97835,"_5":17015,"_23194":97771,"_2329":96113},[],{"_2802":57754,"_24443":57729,"_17120":97837,"_5":17015,"_23194":97771,"_2329":97838},[],"Perfil final de 1 hora que acabas de preparar.",{"_2802":57755,"_24443":57729,"_17120":97840,"_5":17015,"_23194":97771,"_2329":44201},[],{"_2802":57756,"_24443":57729,"_17120":97842,"_5":17015,"_23194":97771,"_2329":44204},[],{"_2802":57757,"_24443":57729,"_17120":97844,"_5":17015,"_23194":97771,"_2329":44207},[],{"_2802":57758,"_24443":57729,"_17120":97846,"_5":17015,"_23194":97771,"_2329":97847},[],"Habilitado.",{"_2802":57759,"_24443":57729,"_17120":97849,"_5":17015,"_23194":97771,"_2329":44213},[],{"_2802":57760,"_24443":57729,"_17120":97851,"_5":17015,"_23194":97771,"_2329":97852},[],"Deshabilitado; el ID debe ser nuevo.",{"_2802":57761,"_24443":57729,"_17120":97854,"_5":17015,"_23194":97771,"_2329":97855},[],"Autenticación inicial",{"_2802":57762,"_24443":57729,"_17120":97857,"_5":17015,"_23194":97771,"_2329":97858},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2802":57763,"_24443":57729,"_17120":97860,"_5":17015,"_23194":97771,"_2329":97861},[],"Autenticación de renovación",{"_2802":57764,"_24443":57729,"_17120":97863,"_5":17015,"_23194":97771,"_2329":97864},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2802":57765,"_24443":57729,"_17120":97866,"_5":17015,"_23194":97771,"_2329":44231},[],{"_2802":57766,"_24443":57729,"_17120":97868,"_5":17015,"_23194":97771,"_2329":97869},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2802":57767,"_24443":57729,"_17120":97871,"_5":17015,"_23194":97771,"_2329":44237},[],{"_2802":57768,"_24443":57729,"_17120":97873,"_5":17015,"_23194":97771,"_2329":97874},[],"1 hora.",{"_2802":57769,"_24443":57729,"_17120":97876,"_5":17015,"_23194":97771,"_2329":44243},[],{"_2802":57770,"_24443":57729,"_17120":97878,"_5":17015,"_23194":97771,"_2329":97879},[],"30 minutos / 10 minutos.",{"_2802":57771,"_24443":57729,"_17120":97881,"_5":17015,"_23194":97771,"_2329":44249},[],{"_2802":57772,"_24443":57729,"_17120":97883,"_5":17015,"_23194":97771,"_2329":97884},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2802":57773,"_24443":57729,"_17120":97886,"_5":17015,"_23194":97771,"_2329":42412},[],{"_2802":57774,"_24443":57729,"_17120":97888,"_5":17015,"_23194":97771,"_2329":97889},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2802":57775,"_24443":57729,"_17120":97891,"_5":17015,"_23194":97771,"_2329":44260},[],{"_2802":57776,"_24443":57729,"_17120":97893,"_5":17015,"_23194":97771,"_2329":97894},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2802":57777,"_24443":57729,"_17120":97896,"_5":17015,"_23194":97771,"_2329":97897},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2802":57778,"_24443":57729,"_17120":97899,"_5":17015,"_23194":97775,"_2329":97900},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2802":57779,"_24443":57729,"_17120":97902,"_5":17015,"_23194":97775,"_2329":97903},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2802":57780,"_24443":57729,"_17120":97905,"_5":17015,"_23194":97779,"_2329":97906},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2802":57781,"_24443":57729,"_17120":97908,"_5":17015,"_23194":97779,"_2329":97909},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2802":57782,"_24443":57729,"_17120":97911,"_5":17015,"_23194":97779,"_2329":97912},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2802":57783,"_24443":57729,"_17120":97914,"_5":17015,"_23194":97783,"_2329":97915},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2802":57784,"_24443":57729,"_17120":97917,"_5":17015,"_23194":97783,"_2329":97918},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2802":57785,"_24443":57729,"_17120":97920,"_5":17015,"_23194":97787,"_2329":97921},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2802":57786,"_24443":57729,"_17120":97923,"_5":17015,"_23194":97787,"_2329":97924},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2802":57787,"_24443":57729,"_17120":97926,"_5":17015,"_23194":97787,"_2329":97927},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2802":57788,"_24443":57729,"_17120":97929,"_5":17015,"_23194":97787,"_2329":97930},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2802":57789,"_24443":57729,"_17120":97932,"_5":17015,"_23194":97787,"_2329":97933},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2802":57790,"_24443":57729,"_17120":97935,"_5":17015,"_23194":97791,"_2329":97936},[],"Comprobación",{"_2802":57791,"_24443":57729,"_17120":97938,"_5":17015,"_23194":97791,"_2329":97939},[],"Resultado esperado",{"_2802":57792,"_24443":57729,"_17120":97941,"_5":17015,"_23194":97791,"_2329":97942},[],"Registro",{"_2802":57793,"_24443":57729,"_17120":97944,"_5":17015,"_23194":97791,"_2329":97945},[],"ID creado automáticamente y DMS correcto.",{"_2802":57794,"_24443":57729,"_17120":97947,"_5":17015,"_23194":97791,"_2329":97948},[],"Certificado",{"_2802":57795,"_24443":57729,"_17120":97950,"_5":17015,"_23194":97791,"_2329":97951},[],"CN, perfil, serie y clave verificados.",{"_2802":57796,"_24443":57729,"_17120":97953,"_5":17015,"_23194":97791,"_2329":97954},[],"Inventario",{"_2802":57797,"_24443":57729,"_17120":97956,"_5":17015,"_23194":97791,"_2329":97957},[],"Serie recibida visible como identidad actual y en el historial.",{"_2802":57798,"_24443":57729,"_17120":97959,"_5":17015,"_23194":97791,"_2329":97960},[],"Consumidor",{"_2802":57799,"_24443":57729,"_17120":97962,"_5":17015,"_23194":97791,"_2329":97963},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2802":57800,"_24443":57729,"_17120":97965,"_5":17015,"_23194":97791,"_2329":97966},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2802":57801,"_24443":57729,"_17120":97968,"_5":17015,"_23194":97791,"_2329":97969},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2802":57802,"_24443":57802,"_5":12033,"_2329":95831,"_24778":97971,"_17120":97972,"_23194":57802},[39822,94885,42097,97757],[],{"_2802":57803,"_24443":57802,"_17120":97974,"_5":17015,"_23194":57802,"_2329":97975},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2802":57804,"_24443":57802,"_5":24775,"_17120":97977,"_23194":97978,"_2329":93586},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2802":57805,"_24443":57802,"_5":24775,"_17120":97980,"_23194":97981,"_2329":97982},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2802":57806,"_24443":57802,"_5":24775,"_17120":97984,"_23194":97985,"_2329":97986},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2802":57807,"_24443":57802,"_5":24775,"_17120":97988,"_23194":97989,"_2329":97990},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2802":57808,"_24443":57802,"_5":24775,"_17120":97992,"_23194":97993,"_2329":97994},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2802":57809,"_24443":57802,"_5":24775,"_17120":97996,"_23194":97997,"_2329":97998},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2802":57810,"_24443":57802,"_5":24775,"_17120":98000,"_23194":98001,"_2329":97939},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2802":57811,"_24443":57802,"_5":24775,"_17120":98003,"_23194":98004,"_2329":98005},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2802":57812,"_24443":57802,"_5":24775,"_17120":98007,"_23194":98008,"_2329":98009},[],"/docs/pr-preview/pr-28/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2802":57813,"_24443":57802,"_17120":98011,"_5":17015,"_23194":57802,"_2329":98012},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2802":57814,"_24443":57802,"_17120":98014,"_5":17015,"_23194":57802,"_2329":98015},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2802":57815,"_24443":57802,"_17120":98017,"_5":17015,"_23194":97978,"_2329":98018},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2802":57816,"_24443":57802,"_17120":98020,"_5":17015,"_23194":97978,"_2329":98021},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2802":57817,"_24443":57802,"_17120":98023,"_5":17015,"_23194":97978,"_2329":98024},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2802":57818,"_24443":57802,"_17120":98026,"_5":17015,"_23194":97978,"_2329":98027},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2802":57819,"_24443":57802,"_17120":98029,"_5":17015,"_23194":97981,"_2329":98030},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2802":57820,"_24443":57802,"_17120":98032,"_5":17015,"_23194":97981,"_2329":98033},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2802":57821,"_24443":57802,"_17120":98035,"_5":17015,"_23194":97981,"_2329":98036},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2802":57822,"_24443":57802,"_17120":98038,"_5":17015,"_23194":97981,"_2329":98039},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2802":57823,"_24443":57802,"_17120":98041,"_5":17015,"_23194":97981,"_2329":98042},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2802":57824,"_24443":57802,"_17120":98044,"_5":17015,"_23194":97981,"_2329":98045},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2802":57825,"_24443":57802,"_17120":98047,"_5":17015,"_23194":97981,"_2329":98048},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2802":57826,"_24443":57802,"_17120":98050,"_5":17015,"_23194":97981,"_2329":98051},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2802":57827,"_24443":57802,"_17120":98053,"_5":17015,"_23194":97985,"_2329":98054},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2802":57828,"_24443":57802,"_17120":98056,"_5":17015,"_23194":97985,"_2329":44426},[],{"_2802":57829,"_24443":57802,"_17120":98058,"_5":17015,"_23194":97985,"_2329":98059},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2802":57830,"_24443":57802,"_17120":98061,"_5":17015,"_23194":97985,"_2329":98062},[],"**Icon** y **Tags**: clasificación opcional.",{"_2802":57831,"_24443":57802,"_17120":98064,"_5":17015,"_23194":97985,"_2329":98065},[],"Confirma el registro.",{"_2802":57832,"_24443":57802,"_17120":98067,"_5":17015,"_23194":97989,"_2329":98068},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2802":57833,"_24443":57802,"_17120":98070,"_5":17015,"_23194":97989,"_2329":98071},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2802":57834,"_24443":57802,"_17120":98073,"_5":17015,"_23194":97993,"_2329":98074},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2802":57835,"_24443":57802,"_17120":98076,"_5":17015,"_23194":97993,"_2329":98077},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2802":57836,"_24443":57802,"_17120":98079,"_5":17015,"_23194":97997,"_2329":98080},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2802":57837,"_24443":57802,"_17120":98082,"_5":17015,"_23194":97997,"_2329":98083},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2802":57838,"_24443":57802,"_17120":98085,"_5":17015,"_23194":98001,"_2329":97936},[],{"_2802":57839,"_24443":57802,"_17120":98087,"_5":17015,"_23194":98001,"_2329":98088},[],"Resultado",{"_2802":57840,"_24443":57802,"_17120":98090,"_5":17015,"_23194":98001,"_2329":98091},[],"Dispositivo",{"_2802":57841,"_24443":57802,"_17120":98093,"_5":17015,"_23194":98001,"_2329":98094},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2802":57842,"_24443":57802,"_17120":98096,"_5":17015,"_23194":98001,"_2329":98097},[],"Identidad actual",{"_2802":57843,"_24443":57802,"_17120":98099,"_5":17015,"_23194":98001,"_2329":98100},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2802":57844,"_24443":57802,"_17120":98102,"_5":17015,"_23194":98001,"_2329":98103},[],"Historial",{"_2802":57845,"_24443":57802,"_17120":98105,"_5":17015,"_23194":98001,"_2329":98106},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2802":57846,"_24443":57802,"_17120":98108,"_5":17015,"_23194":98001,"_2329":98109},[],"Clave y certificado",{"_2802":57847,"_24443":57802,"_17120":98111,"_5":17015,"_23194":98001,"_2329":98112},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2802":57848,"_24443":57802,"_17120":98114,"_5":17015,"_23194":98004,"_2329":98115},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2802":57849,"_24443":57802,"_17120":98117,"_5":17015,"_23194":98004,"_2329":98118},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2802":57850,"_24443":57802,"_17120":98120,"_5":17015,"_23194":98004,"_2329":98121},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2802":57851,"_24443":57802,"_17120":98123,"_5":17015,"_23194":98004,"_2329":98124},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2802":57852,"_24443":57802,"_17120":98126,"_5":17015,"_23194":98008,"_2329":98127},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2802":57853,"_24443":57802,"_17120":98129,"_5":17015,"_23194":98008,"_2329":98130},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2802":57854,"_24443":57802,"_17120":98132,"_5":17015,"_23194":98008,"_2329":98133},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2802":57855,"_24443":57855,"_5":12033,"_2329":98135,"_24778":98136,"_17120":98137,"_23194":57855},"Plataforma Lamassu IoT",[39822,94885],[],{"_2802":57856,"_24443":57855,"_17120":98139,"_5":17015,"_23194":57855,"_2329":98140},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2802":57857,"_24443":57855,"_5":24775,"_17120":98142,"_23194":98143,"_2329":97633},[],"/docs/pr-preview/pr-28/es/platform/overview#empieza-aquí",{"_2802":57858,"_24443":57855,"_5":24775,"_17120":98145,"_23194":98146,"_2329":98147},[],"/docs/pr-preview/pr-28/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2802":57859,"_24443":57855,"_5":24775,"_17120":98149,"_23194":98150,"_2329":98151},[],"/docs/pr-preview/pr-28/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2802":57860,"_24443":57855,"_5":24775,"_17120":98153,"_23194":98154,"_2329":98155},[],"/docs/pr-preview/pr-28/es/platform/overview#capacidades-principales","Capacidades principales",{"_2802":57861,"_24443":57855,"_5":24775,"_17120":98157,"_23194":98158,"_2329":98159},[],"/docs/pr-preview/pr-28/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2802":57862,"_24443":57855,"_5":24775,"_17120":98161,"_23194":98162,"_2329":98163},[],"/docs/pr-preview/pr-28/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2802":57863,"_24443":57855,"_5":24775,"_17120":98165,"_23194":98166,"_2329":98167},[],"/docs/pr-preview/pr-28/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2802":57864,"_24443":57855,"_5":24775,"_17120":98169,"_23194":98170,"_2329":98171},[],"/docs/pr-preview/pr-28/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2802":57865,"_24443":57855,"_5":24775,"_17120":98173,"_23194":98174,"_2329":98175},[],"/docs/pr-preview/pr-28/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2802":57866,"_24443":57855,"_5":24775,"_17120":98177,"_23194":98178,"_2329":98179},[],"/docs/pr-preview/pr-28/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2802":57867,"_24443":57855,"_5":24775,"_17120":98181,"_23194":98182,"_2329":98183},[],"/docs/pr-preview/pr-28/es/platform/overview#referencia-operativa","Referencia operativa",{"_2802":57868,"_24443":57855,"_17120":98185,"_5":17015,"_23194":57855,"_2329":98186},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2802":57869,"_24443":57855,"_17120":98188,"_5":17015,"_23194":98143,"_2329":98189},[],"Elige el resultado que necesitas obtener:",{"_2802":57870,"_24443":57855,"_17120":98191,"_5":17015,"_23194":98143,"_2329":98192},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2802":57871,"_24443":57855,"_17120":98194,"_5":17015,"_23194":98143,"_2329":98195},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2802":57872,"_24443":57855,"_17120":98197,"_5":17015,"_23194":98143,"_2329":98198},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2802":57873,"_24443":57855,"_17120":98200,"_5":17015,"_23194":98146,"_2329":98201},[],"Bloque",{"_2802":57874,"_24443":57855,"_17120":98203,"_5":17015,"_23194":98146,"_2329":98204},[],"Qué gestionas",{"_2802":57875,"_24443":57855,"_17120":98206,"_5":17015,"_23194":98146,"_2329":98207},[],"Punto de entrada",{"_2802":57876,"_24443":57855,"_17120":98209,"_5":17015,"_23194":98146,"_2329":44580},[],{"_2802":57877,"_24443":57855,"_17120":98211,"_5":17015,"_23194":98146,"_2329":98212},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2802":57878,"_24443":57855,"_17120":98214,"_5":17015,"_23194":98146,"_2329":98215},[],"Visión general de PKI",{"_2802":57879,"_24443":57855,"_17120":98217,"_5":17015,"_23194":98146,"_2329":44589},[],{"_2802":57880,"_24443":57855,"_17120":98219,"_5":17015,"_23194":98146,"_2329":98220},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2802":57881,"_24443":57855,"_17120":98222,"_5":17015,"_23194":98146,"_2329":98223},[],"Visión general de IoT Fleets",{"_2802":57882,"_24443":57855,"_17120":98225,"_5":17015,"_23194":98146,"_2329":98226},[],"**Administración**",{"_2802":57883,"_24443":57855,"_17120":98228,"_5":17015,"_23194":98146,"_2329":98229},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2802":57884,"_24443":57855,"_17120":98231,"_5":17015,"_23194":98146,"_2329":94883},[],{"_2802":57885,"_24443":57855,"_17120":98233,"_5":17015,"_23194":98146,"_2329":98234},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2802":57886,"_24443":57855,"_17120":98236,"_5":17015,"_23194":98150,"_2329":98237},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2802":57887,"_24443":57855,"_17120":98239,"_5":17015,"_23194":98150,"_2329":98240},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2802":57888,"_24443":57855,"_17120":98242,"_5":17015,"_23194":98150,"_2329":98243},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2802":57889,"_24443":57855,"_17120":98245,"_5":17015,"_23194":98150,"_2329":98246},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2802":57890,"_24443":57855,"_17120":98248,"_5":17015,"_23194":98150,"_2329":98249},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2802":57891,"_24443":57855,"_17120":98251,"_5":17015,"_23194":98150,"_2329":98252},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2802":57892,"_24443":57855,"_17120":98254,"_5":17015,"_23194":98158,"_2329":98255},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2802":57893,"_24443":57855,"_17120":98257,"_5":17015,"_23194":98162,"_2329":98258},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2802":57894,"_24443":57855,"_17120":98260,"_5":17015,"_23194":98166,"_2329":98261},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2802":57895,"_24443":57855,"_17120":98263,"_5":17015,"_23194":98170,"_2329":98264},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2802":57896,"_24443":57855,"_17120":98266,"_5":17015,"_23194":98174,"_2329":98267},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2802":57897,"_24443":57855,"_17120":98269,"_5":17015,"_23194":98178,"_2329":98270},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2802":57898,"_24443":57855,"_17120":98272,"_5":17015,"_23194":98182,"_2329":97726},[],{"_2802":57899,"_24443":57855,"_17120":98274,"_5":17015,"_23194":98182,"_2329":98275},[],"Qué prepara o comprueba",{"_2802":57900,"_24443":57855,"_17120":98277,"_5":17015,"_23194":98182,"_2329":97729},[],{"_2802":57901,"_24443":57855,"_17120":98279,"_5":17015,"_23194":98182,"_2329":98280},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2802":57902,"_24443":57855,"_17120":98282,"_5":17015,"_23194":98182,"_2329":98283},[],"Administrador de la flota",{"_2802":57903,"_24443":57855,"_17120":98285,"_5":17015,"_23194":98182,"_2329":98286},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2802":57904,"_24443":57855,"_17120":98288,"_5":17015,"_23194":98182,"_2329":97741},[],{"_2802":57905,"_24443":57855,"_17120":98290,"_5":17015,"_23194":98182,"_2329":98291},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2802":57906,"_24443":57855,"_17120":98293,"_5":17015,"_23194":98182,"_2329":97747},[],{"_2802":57907,"_24443":57855,"_17120":98295,"_5":17015,"_23194":98182,"_2329":98296},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2802":57908,"_24443":57855,"_17120":98298,"_5":17015,"_23194":98182,"_2329":98299},[],"Operador de infraestructura",{"_2802":57909,"_24443":57855,"_17120":98301,"_5":17015,"_23194":98182,"_2329":98302},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2802":57910,"_24443":57855,"_17120":98304,"_5":17015,"_23194":98182,"_2329":98305},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2802":57911,"_24443":57911,"_5":12033,"_2329":98307,"_24778":98308,"_17120":98310,"_23194":57911},"Jerarquía y rotación de CAs",[39822,94885,44681,98309],"Claves, autoridades y certificados",[],{"_2802":57912,"_24443":57911,"_17120":98312,"_5":17015,"_23194":57911,"_2329":98313},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2802":57913,"_24443":57911,"_5":24775,"_17120":98315,"_23194":98316,"_2329":98317},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2802":57914,"_24443":57911,"_5":24775,"_17120":98319,"_23194":98320,"_2329":98321},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2802":57915,"_24443":57911,"_5":24775,"_17120":98323,"_23194":98324,"_2329":98325},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2802":57916,"_24443":57911,"_5":24775,"_17120":98327,"_23194":98328,"_2329":98329},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2802":57917,"_24443":57911,"_5":24775,"_17120":98331,"_23194":98332,"_2329":98333},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2802":57918,"_24443":57911,"_5":24775,"_17120":98335,"_23194":98336,"_2329":98337},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2802":57919,"_24443":57911,"_5":24775,"_17120":98339,"_23194":98340,"_2329":98341},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2802":57920,"_24443":57911,"_5":24775,"_17120":98343,"_23194":98344,"_2329":98345},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2802":57921,"_24443":57911,"_5":24775,"_17120":98347,"_23194":98348,"_2329":98349},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2802":57922,"_24443":57911,"_5":24775,"_17120":98351,"_23194":98352,"_2329":98353},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2802":57923,"_24443":57911,"_5":24775,"_17120":98355,"_23194":98356,"_2329":98357},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2802":57924,"_24443":57911,"_5":24775,"_17120":98359,"_23194":98360,"_2329":98361},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2802":57925,"_24443":57911,"_17120":98363,"_5":17015,"_23194":57911,"_2329":98364},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2802":57926,"_24443":57911,"_17120":98366,"_5":17015,"_23194":57911,"_2329":98367},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2802":57927,"_24443":57911,"_17120":98369,"_5":17015,"_23194":98316,"_2329":98370},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2802":57928,"_24443":57911,"_17120":98372,"_5":17015,"_23194":98316,"_2329":98373},[],"entorno, como producción y preproducción;",{"_2802":57929,"_24443":57911,"_17120":98375,"_5":17015,"_23194":98316,"_2329":98376},[],"propietario o equipo operador;",{"_2802":57930,"_24443":57911,"_17120":98378,"_5":17015,"_23194":98316,"_2329":98379},[],"familia de dispositivos o proceso de fabricación;",{"_2802":57931,"_24443":57911,"_17120":98381,"_5":17015,"_23194":98316,"_2329":98382},[],"región o requisito regulatorio;",{"_2802":57932,"_24443":57911,"_17120":98384,"_5":17015,"_23194":98316,"_2329":98385},[],"motor criptográfico o política de clave;",{"_2802":57933,"_24443":57911,"_17120":98387,"_5":17015,"_23194":98316,"_2329":98388},[],"ventana de mantenimiento y ritmo de renovación.",{"_2802":57934,"_24443":57911,"_17120":98390,"_5":17015,"_23194":98316,"_2329":98391},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2802":57935,"_24443":57911,"_17120":98393,"_5":17015,"_23194":98316,"_2329":98394},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2802":57936,"_24443":57911,"_17120":98396,"_5":17015,"_23194":98320,"_2329":98397},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2802":57937,"_24443":57911,"_17120":98399,"_5":17015,"_23194":98320,"_2329":98400},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2802":57938,"_24443":57911,"_17120":98402,"_5":17015,"_23194":98320,"_2329":98403},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2802":57939,"_24443":57911,"_17120":98405,"_5":17015,"_23194":98324,"_2329":98406},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2802":57940,"_24443":57911,"_17120":98408,"_5":17015,"_23194":98324,"_2329":98409},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2802":57941,"_24443":57911,"_17120":98411,"_5":17015,"_23194":98324,"_2329":98412},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2802":57942,"_24443":57911,"_17120":98414,"_5":17015,"_23194":98324,"_2329":98415},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2802":57943,"_24443":57911,"_17120":98417,"_5":17015,"_23194":98332,"_2329":98418},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2802":57944,"_24443":57911,"_17120":98420,"_5":17015,"_23194":98336,"_2329":98421},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2802":57945,"_24443":57911,"_17120":98423,"_5":17015,"_23194":98340,"_2329":98424},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2802":57946,"_24443":57911,"_17120":98426,"_5":17015,"_23194":98344,"_2329":98427},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2802":57947,"_24443":57911,"_17120":98429,"_5":17015,"_23194":98348,"_2329":98430},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2802":57948,"_24443":57911,"_17120":98432,"_5":17015,"_23194":98352,"_2329":98433},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2802":57949,"_24443":57911,"_17120":98435,"_5":17015,"_23194":98356,"_2329":98436},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2802":57950,"_24443":57911,"_17120":98438,"_5":17015,"_23194":98356,"_2329":98439},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2802":57951,"_24443":57911,"_17120":98441,"_5":17015,"_23194":98356,"_2329":98442},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2802":57952,"_24443":57911,"_17120":98444,"_5":17015,"_23194":98356,"_2329":98445},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2802":57953,"_24443":57911,"_17120":98447,"_5":17015,"_23194":98360,"_2329":98448},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2802":57954,"_24443":57911,"_17120":98450,"_5":17015,"_23194":98360,"_2329":98451},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2802":57955,"_24443":57911,"_17120":98453,"_5":17015,"_23194":98360,"_2329":98454},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2802":57956,"_24443":57911,"_17120":98456,"_5":17015,"_23194":98360,"_2329":98457},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2802":57957,"_24443":57911,"_17120":98459,"_5":17015,"_23194":98360,"_2329":98460},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2802":57958,"_24443":57911,"_17120":98462,"_5":17015,"_23194":98360,"_2329":98463},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2802":57959,"_24443":57911,"_17120":98465,"_5":17015,"_23194":98360,"_2329":98466},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2802":57960,"_24443":57960,"_5":12033,"_2329":98468,"_24778":98469,"_17120":98470,"_23194":57960},"Autoridades de certificación",[39822,94885,44681,98309],[],{"_2802":57961,"_24443":57960,"_17120":98472,"_5":17015,"_23194":57960,"_2329":98473},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2802":57962,"_24443":57960,"_5":24775,"_17120":98475,"_23194":98476,"_2329":98477},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2802":57963,"_24443":57960,"_5":24775,"_17120":98479,"_23194":98480,"_2329":98481},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2802":57964,"_24443":57960,"_5":24775,"_17120":98483,"_23194":98484,"_2329":93586},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2802":57965,"_24443":57960,"_5":24775,"_17120":98486,"_23194":98487,"_2329":98488},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2802":57966,"_24443":57960,"_5":24775,"_17120":98490,"_23194":98491,"_2329":98492},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2802":57967,"_24443":57960,"_5":24775,"_17120":98494,"_23194":98495,"_2329":98496},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2802":57968,"_24443":57960,"_5":24775,"_17120":98498,"_23194":98499,"_2329":98500},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2802":57969,"_24443":57960,"_5":24775,"_17120":98502,"_23194":98503,"_2329":98504},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2802":57970,"_24443":57960,"_5":24775,"_17120":98506,"_23194":98507,"_2329":98508},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2802":57971,"_24443":57960,"_5":24775,"_17120":98510,"_23194":98511,"_2329":98512},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2802":57972,"_24443":57960,"_5":24775,"_17120":98514,"_23194":98515,"_2329":98516},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2802":57973,"_24443":57960,"_5":24775,"_17120":98518,"_23194":98519,"_2329":98520},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2802":57974,"_24443":57960,"_5":24775,"_17120":98522,"_23194":98523,"_2329":98524},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2802":57975,"_24443":57960,"_5":24775,"_17120":98526,"_23194":98527,"_2329":98528},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2802":57976,"_24443":57960,"_5":24775,"_17120":98530,"_23194":98531,"_2329":98532},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2802":57977,"_24443":57960,"_5":24775,"_17120":98534,"_23194":98535,"_2329":98536},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2802":57978,"_24443":57960,"_5":24775,"_17120":98538,"_23194":98539,"_2329":98540},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2802":57979,"_24443":57960,"_5":24775,"_17120":98542,"_23194":98543,"_2329":98544},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2802":57980,"_24443":57960,"_5":24775,"_17120":98546,"_23194":98547,"_2329":98548},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2802":57981,"_24443":57960,"_5":24775,"_17120":98550,"_23194":98551,"_2329":98552},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2802":57982,"_24443":57960,"_5":24775,"_17120":98554,"_23194":98555,"_2329":98556},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2802":57983,"_24443":57960,"_5":24775,"_17120":98558,"_23194":98559,"_2329":98560},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2802":57984,"_24443":57960,"_17120":98562,"_5":17015,"_23194":57960,"_2329":98563},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2802":57985,"_24443":57960,"_17120":98565,"_5":17015,"_23194":57960,"_2329":98566},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2802":57986,"_24443":57960,"_17120":98568,"_5":17015,"_23194":57960,"_2329":98569},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2802":57987,"_24443":57960,"_17120":98571,"_5":17015,"_23194":98476,"_2329":98572},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2802":57988,"_24443":57960,"_17120":98574,"_5":17015,"_23194":98476,"_2329":98575},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2802":57989,"_24443":57960,"_17120":98577,"_5":17015,"_23194":98476,"_2329":98578},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2802":57990,"_24443":57960,"_17120":98580,"_5":17015,"_23194":98476,"_2329":98581},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2802":57991,"_24443":57960,"_17120":98583,"_5":17015,"_23194":98476,"_2329":98584},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2802":57992,"_24443":57960,"_17120":98586,"_5":17015,"_23194":98484,"_2329":98587},[],"Decide si la CA será raíz o intermedia.",{"_2802":57993,"_24443":57960,"_17120":98589,"_5":17015,"_23194":98484,"_2329":98590},[],"Elige el motor que custodiará la clave.",{"_2802":57994,"_24443":57960,"_17120":98592,"_5":17015,"_23194":98484,"_2329":98593},[],"Define una validez superior a la de los certificados que emitirá.",{"_2802":57995,"_24443":57960,"_17120":98595,"_5":17015,"_23194":98484,"_2329":98596},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2802":57996,"_24443":57960,"_17120":98598,"_5":17015,"_23194":98487,"_2329":98599},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2802":57997,"_24443":57960,"_17120":98601,"_5":17015,"_23194":98491,"_2329":98602},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2802":57998,"_24443":57960,"_17120":98604,"_5":17015,"_23194":98491,"_2329":98605},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2802":57999,"_24443":57960,"_17120":98607,"_5":17015,"_23194":98495,"_2329":98608},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2802":58000,"_24443":57960,"_17120":98610,"_5":17015,"_23194":98499,"_2329":98611},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2802":58001,"_24443":57960,"_17120":98613,"_5":17015,"_23194":98499,"_2329":98614},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2802":58002,"_24443":57960,"_17120":98616,"_5":17015,"_23194":98499,"_2329":98617},[],"`ST`: estado o provincia.",{"_2802":58003,"_24443":57960,"_17120":98619,"_5":17015,"_23194":98499,"_2329":98620},[],"`L`: localidad.",{"_2802":58004,"_24443":57960,"_17120":98622,"_5":17015,"_23194":98499,"_2329":98623},[],"`O`: organización.",{"_2802":58005,"_24443":57960,"_17120":98625,"_5":17015,"_23194":98499,"_2329":98626},[],"`OU`: unidad organizativa.",{"_2802":58006,"_24443":57960,"_17120":98628,"_5":17015,"_23194":98499,"_2329":98629},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2802":58007,"_24443":57960,"_17120":98631,"_5":17015,"_23194":98503,"_2329":98632},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2802":58008,"_24443":57960,"_17120":98634,"_5":17015,"_23194":98503,"_2329":98635},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2802":58009,"_24443":57960,"_17120":98637,"_5":17015,"_23194":98507,"_2329":98638},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2802":58010,"_24443":57960,"_17120":98640,"_5":17015,"_23194":98507,"_2329":98641},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2802":58011,"_24443":57960,"_17120":98643,"_5":17015,"_23194":98511,"_2329":98644},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2802":58012,"_24443":57960,"_17120":98646,"_5":17015,"_23194":98511,"_2329":98647},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2802":58013,"_24443":57960,"_17120":98649,"_5":17015,"_23194":98515,"_2329":98650},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2802":58014,"_24443":57960,"_17120":98652,"_5":17015,"_23194":98519,"_2329":98653},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2802":58015,"_24443":57960,"_17120":98655,"_5":17015,"_23194":98523,"_2329":98656},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2802":58016,"_24443":57960,"_17120":98658,"_5":17015,"_23194":98527,"_2329":98659},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2802":58017,"_24443":57960,"_17120":98661,"_5":17015,"_23194":98531,"_2329":98662},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2802":58018,"_24443":57960,"_17120":98664,"_5":17015,"_23194":98531,"_2329":98665},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2802":58019,"_24443":57960,"_17120":98667,"_5":17015,"_23194":98535,"_2329":98668},[],"Abre una CA desde el inventario para consultar:",{"_2802":58020,"_24443":57960,"_17120":98670,"_5":17015,"_23194":98535,"_2329":98671},[],"Estado y periodo de validez.",{"_2802":58021,"_24443":57960,"_17120":98673,"_5":17015,"_23194":98535,"_2329":98674},[],"Certificado y cadena en formato PEM.",{"_2802":58022,"_24443":57960,"_17120":98676,"_5":17015,"_23194":98535,"_2329":98677},[],"Número de certificados activos, expirados y revocados.",{"_2802":58023,"_24443":57960,"_17120":98679,"_5":17015,"_23194":98535,"_2329":98680},[],"Certificados emitidos en **Issued Certificates**.",{"_2802":58024,"_24443":57960,"_17120":98682,"_5":17015,"_23194":98535,"_2329":98683},[],"CRL vinculada a la autoridad.",{"_2802":58025,"_24443":57960,"_17120":98685,"_5":17015,"_23194":98535,"_2329":98686},[],"Metadatos y motor criptográfico asociado.",{"_2802":58026,"_24443":57960,"_17120":98688,"_5":17015,"_23194":98535,"_2329":98689},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2802":58027,"_24443":57960,"_17120":98691,"_5":17015,"_23194":98539,"_2329":98692},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2802":58028,"_24443":57960,"_17120":98694,"_5":17015,"_23194":98539,"_2329":98695},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2802":58029,"_24443":57960,"_17120":98697,"_5":17015,"_23194":98539,"_2329":98698},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2802":58030,"_24443":57960,"_17120":98700,"_5":17015,"_23194":98539,"_2329":98701},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2802":58031,"_24443":57960,"_17120":98703,"_5":17015,"_23194":98543,"_2329":98704},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2802":58032,"_24443":57960,"_17120":98706,"_5":17015,"_23194":98547,"_2329":98707},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2802":58033,"_24443":57960,"_17120":98709,"_5":17015,"_23194":98551,"_2329":98710},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2802":58034,"_24443":57960,"_17120":98712,"_5":17015,"_23194":98555,"_2329":98713},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2802":58035,"_24443":57960,"_17120":98715,"_5":17015,"_23194":98559,"_2329":98716},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2802":58036,"_24443":57960,"_17120":98718,"_5":17015,"_23194":98559,"_2329":98719},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2802":58037,"_24443":58037,"_5":12033,"_2329":98721,"_24778":98722,"_17120":98723,"_23194":58037},"Perfiles de certificado",[39822,94885,44681,98309],[],{"_2802":58038,"_24443":58037,"_17120":98725,"_5":17015,"_23194":58037,"_2329":98726},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2802":58039,"_24443":58037,"_5":24775,"_17120":98728,"_23194":98729,"_2329":98730},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2802":58040,"_24443":58037,"_5":24775,"_17120":98732,"_23194":98733,"_2329":98734},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#validez","Validez",{"_2802":58041,"_24443":58037,"_5":24775,"_17120":98736,"_23194":98737,"_2329":98738},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2802":58042,"_24443":58037,"_5":24775,"_17120":98740,"_23194":98741,"_2329":98742},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2802":58043,"_24443":58037,"_5":24775,"_17120":98744,"_23194":98745,"_2329":98746},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2802":58044,"_24443":58037,"_5":24775,"_17120":98748,"_23194":98749,"_2329":98750},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2802":58045,"_24443":58037,"_5":24775,"_17120":98752,"_23194":98753,"_2329":98754},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2802":58046,"_24443":58037,"_5":24775,"_17120":98756,"_23194":98757,"_2329":98758},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2802":58047,"_24443":58037,"_5":24775,"_17120":98760,"_23194":98761,"_2329":98762},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2802":58048,"_24443":58037,"_5":24775,"_17120":98764,"_23194":98765,"_2329":98766},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2802":58049,"_24443":58037,"_5":24775,"_17120":98768,"_23194":98769,"_2329":98770},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2802":58050,"_24443":58037,"_5":24775,"_17120":98772,"_23194":98773,"_2329":98774},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2802":58051,"_24443":58037,"_5":24775,"_17120":98776,"_23194":98777,"_2329":98778},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2802":58052,"_24443":58037,"_5":24775,"_17120":98780,"_23194":98781,"_2329":98782},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2802":58053,"_24443":58037,"_5":24775,"_17120":98784,"_23194":98785,"_2329":98786},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2802":58054,"_24443":58037,"_5":24775,"_17120":98788,"_23194":98789,"_2329":98790},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2802":58055,"_24443":58037,"_17120":98792,"_5":17015,"_23194":58037,"_2329":98793},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2802":58056,"_24443":58037,"_17120":98795,"_5":17015,"_23194":58037,"_2329":98796},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2802":58057,"_24443":58037,"_17120":98798,"_5":17015,"_23194":98733,"_2329":98799},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2802":58058,"_24443":58037,"_17120":98801,"_5":17015,"_23194":98733,"_2329":98802},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2802":58059,"_24443":58037,"_17120":98804,"_5":17015,"_23194":98737,"_2329":98805},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2802":58060,"_24443":58037,"_17120":98807,"_5":17015,"_23194":98741,"_2329":98808},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2802":58061,"_24443":58037,"_17120":98810,"_5":17015,"_23194":98741,"_2329":98811},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2802":58062,"_24443":58037,"_17120":98813,"_5":17015,"_23194":98741,"_2329":98814},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2802":58063,"_24443":58037,"_17120":98816,"_5":17015,"_23194":98745,"_2329":98817},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2802":58064,"_24443":58037,"_17120":98819,"_5":17015,"_23194":98749,"_2329":98820},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2802":58065,"_24443":58037,"_17120":98822,"_5":17015,"_23194":98749,"_2329":98823},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2802":58066,"_24443":58037,"_17120":98825,"_5":17015,"_23194":98753,"_2329":98826},[],"La aplicación criptográfica puede:",{"_2802":58067,"_24443":58037,"_17120":98828,"_5":17015,"_23194":98753,"_2329":98829},[],"permitir o bloquear claves RSA;",{"_2802":58068,"_24443":58037,"_17120":98831,"_5":17015,"_23194":98753,"_2329":98832},[],"limitar los tamaños RSA admitidos;",{"_2802":58069,"_24443":58037,"_17120":98834,"_5":17015,"_23194":98753,"_2329":98835},[],"permitir o bloquear claves ECDSA;",{"_2802":58070,"_24443":58037,"_17120":98837,"_5":17015,"_23194":98753,"_2329":98838},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2802":58071,"_24443":58037,"_17120":98840,"_5":17015,"_23194":98753,"_2329":98841},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2802":58072,"_24443":58037,"_17120":98843,"_5":17015,"_23194":98757,"_2329":98844},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2802":58073,"_24443":58037,"_17120":98846,"_5":17015,"_23194":98757,"_2329":94676},[],{"_2802":58074,"_24443":58037,"_17120":98848,"_5":17015,"_23194":98757,"_2329":98849},[],"Primera opción",{"_2802":58075,"_24443":58037,"_17120":98851,"_5":17015,"_23194":98757,"_2329":98852},[],"Segunda opción",{"_2802":58076,"_24443":58037,"_17120":98854,"_5":17015,"_23194":98757,"_2329":98855},[],"Si no hay ninguna",{"_2802":58077,"_24443":58037,"_17120":98857,"_5":17015,"_23194":98757,"_2329":98858},[],"Firma directa con una CA",{"_2802":58078,"_24443":58037,"_17120":98860,"_5":17015,"_23194":98757,"_2329":98861},[],"`issuance_profile` incluido en la solicitud",{"_2802":58079,"_24443":58037,"_17120":98863,"_5":17015,"_23194":98757,"_2329":98864},[],"`issuance_profile_id` de la solicitud",{"_2802":58080,"_24443":58037,"_17120":98866,"_5":17015,"_23194":98757,"_2329":98867},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2802":58081,"_24443":58037,"_17120":98869,"_5":17015,"_23194":98757,"_2329":98870},[],"Emisión mediante DMS",{"_2802":58082,"_24443":58037,"_17120":98872,"_5":17015,"_23194":98757,"_2329":45246},[],{"_2802":58083,"_24443":58037,"_17120":98874,"_5":17015,"_23194":98757,"_2329":98875},[],"`settings.issuance_profile` incluido en el DMS",{"_2802":58084,"_24443":58037,"_17120":98877,"_5":17015,"_23194":98757,"_2329":98878},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2802":58085,"_24443":58037,"_17120":98880,"_5":17015,"_23194":98757,"_2329":98881},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2802":58086,"_24443":58037,"_17120":98883,"_5":17015,"_23194":98757,"_2329":98884},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2802":58087,"_24443":58037,"_17120":98886,"_5":17015,"_23194":98765,"_2329":98887},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2802":58088,"_24443":58037,"_17120":98889,"_5":17015,"_23194":98769,"_2329":98890},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2802":58089,"_24443":58037,"_17120":98892,"_5":17015,"_23194":98773,"_2329":98893},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2802":58090,"_24443":58037,"_17120":98895,"_5":17015,"_23194":98777,"_2329":98896},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2802":58091,"_24443":58037,"_17120":98898,"_5":17015,"_23194":98781,"_2329":98899},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2802":58092,"_24443":58037,"_17120":98901,"_5":17015,"_23194":98781,"_2329":98902},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2802":58093,"_24443":58037,"_17120":98904,"_5":17015,"_23194":98785,"_2329":98905},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2802":58094,"_24443":58037,"_17120":98907,"_5":17015,"_23194":98785,"_2329":98908},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2802":58095,"_24443":58037,"_17120":98910,"_5":17015,"_23194":98785,"_2329":98911},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2802":58096,"_24443":58037,"_17120":98913,"_5":17015,"_23194":98785,"_2329":98914},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2802":58097,"_24443":58037,"_17120":98916,"_5":17015,"_23194":98789,"_2329":98917},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2802":58098,"_24443":58037,"_17120":98919,"_5":17015,"_23194":98789,"_2329":98920},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2802":58099,"_24443":58099,"_5":12033,"_2329":98922,"_24778":98923,"_17120":98925,"_23194":58099},"Validación de certificados",[39822,94885,44681,98924],"Validación",[],{"_2802":58100,"_24443":58099,"_17120":98927,"_5":17015,"_23194":58099,"_2329":98928},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2802":58101,"_24443":58099,"_5":24775,"_17120":98930,"_23194":98931,"_2329":98932},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2802":58102,"_24443":58099,"_5":24775,"_17120":98934,"_23194":98935,"_2329":98936},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2802":58103,"_24443":58099,"_5":24775,"_17120":98938,"_23194":98939,"_2329":98940},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2802":58104,"_24443":58099,"_17120":98942,"_5":17015,"_23194":58099,"_2329":98943},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2802":58105,"_24443":58099,"_17120":98945,"_5":17015,"_23194":98931,"_2329":98946},[],"Verifica estos criterios juntos:",{"_2802":58106,"_24443":58099,"_17120":98948,"_5":17015,"_23194":98931,"_2329":97936},[],{"_2802":58107,"_24443":58099,"_17120":98950,"_5":17015,"_23194":98931,"_2329":98951},[],"Resultado necesario",{"_2802":58108,"_24443":58099,"_17120":98953,"_5":17015,"_23194":98931,"_2329":98954},[],"Cadena y firma",{"_2802":58109,"_24443":58099,"_17120":98956,"_5":17015,"_23194":98931,"_2329":98957},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2802":58110,"_24443":58099,"_17120":98959,"_5":17015,"_23194":98931,"_2329":98960},[],"Fechas",{"_2802":58111,"_24443":58099,"_17120":98962,"_5":17015,"_23194":98931,"_2329":98963},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2802":58112,"_24443":58099,"_17120":98965,"_5":17015,"_23194":98931,"_2329":94589},[],{"_2802":58113,"_24443":58099,"_17120":98967,"_5":17015,"_23194":98931,"_2329":98968},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2802":58114,"_24443":58099,"_17120":98970,"_5":17015,"_23194":98931,"_2329":98971},[],"Uso",{"_2802":58115,"_24443":58099,"_17120":98973,"_5":17015,"_23194":98931,"_2329":98974},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2802":58116,"_24443":58099,"_17120":98976,"_5":17015,"_23194":98931,"_2329":98977},[],"Revocación",{"_2802":58117,"_24443":58099,"_17120":98979,"_5":17015,"_23194":98931,"_2329":98980},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2802":58118,"_24443":58099,"_17120":98982,"_5":17015,"_23194":98931,"_2329":98983},[],"Autorización",{"_2802":58119,"_24443":58099,"_17120":98985,"_5":17015,"_23194":98931,"_2329":98986},[],"La aplicación permite la acción a esa identidad.",{"_2802":58120,"_24443":58099,"_17120":98988,"_5":17015,"_23194":98931,"_2329":98989},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2802":58121,"_24443":58099,"_17120":98991,"_5":17015,"_23194":98935,"_2329":98992},[],"Mecanismo",{"_2802":58122,"_24443":58099,"_17120":98994,"_5":17015,"_23194":98935,"_2329":98995},[],"Cuándo utilizarlo",{"_2802":58123,"_24443":58099,"_17120":98997,"_5":17015,"_23194":98935,"_2329":98998},[],"Qué debes mantener",{"_2802":58124,"_24443":58099,"_17120":99000,"_5":17015,"_23194":98935,"_2329":45374},[],{"_2802":58125,"_24443":58099,"_17120":99002,"_5":17015,"_23194":98935,"_2329":99003},[],"Consulta del estado de un certificado concreto.",{"_2802":58126,"_24443":58099,"_17120":99005,"_5":17015,"_23194":98935,"_2329":99006},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2802":58127,"_24443":58099,"_17120":99008,"_5":17015,"_23194":98935,"_2329":45383},[],{"_2802":58128,"_24443":58099,"_17120":99010,"_5":17015,"_23194":98935,"_2329":99011},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2802":58129,"_24443":58099,"_17120":99013,"_5":17015,"_23194":98935,"_2329":99014},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2802":58130,"_24443":58099,"_17120":99016,"_5":17015,"_23194":98935,"_2329":99017},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2802":58131,"_24443":58099,"_17120":99019,"_5":17015,"_23194":98935,"_2329":99020},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2802":58132,"_24443":58099,"_17120":99022,"_5":17015,"_23194":98939,"_2329":99023},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2802":58133,"_24443":58099,"_17120":99025,"_5":17015,"_23194":98939,"_2329":99026},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2802":58134,"_24443":58099,"_17120":99028,"_5":17015,"_23194":98939,"_2329":99029},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2802":58135,"_24443":58099,"_17120":99031,"_5":17015,"_23194":98939,"_2329":99032},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2802":58136,"_24443":58099,"_17120":99034,"_5":17015,"_23194":98939,"_2329":99035},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2802":58137,"_24443":58099,"_17120":99037,"_5":17015,"_23194":98939,"_2329":99038},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2802":58138,"_24443":58099,"_17120":99040,"_5":17015,"_23194":98939,"_2329":99041},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2802":58139,"_24443":58099,"_17120":99043,"_5":17015,"_23194":98939,"_2329":99044},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2802":58140,"_24443":58099,"_17120":99046,"_5":17015,"_23194":98939,"_2329":99047},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2802":58141,"_24443":58141,"_5":12033,"_2329":99049,"_24778":99050,"_17120":99051,"_23194":58141},"Certificados",[39822,94885,44681,98309],[],{"_2802":58142,"_24443":58141,"_17120":99053,"_5":17015,"_23194":58141,"_2329":99054},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2802":58143,"_24443":58141,"_5":24775,"_17120":99056,"_23194":99057,"_2329":99058},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2802":58144,"_24443":58141,"_5":24775,"_17120":99060,"_23194":99061,"_2329":99062},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2802":58145,"_24443":58141,"_5":24775,"_17120":99064,"_23194":99065,"_2329":99066},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2802":58146,"_24443":58141,"_5":24775,"_17120":99068,"_23194":99069,"_2329":99070},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2802":58147,"_24443":58141,"_5":24775,"_17120":99072,"_23194":99073,"_2329":99074},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2802":58148,"_24443":58141,"_5":24775,"_17120":99076,"_23194":99077,"_2329":99078},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2802":58149,"_24443":58141,"_5":24775,"_17120":99080,"_23194":99081,"_2329":99082},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2802":58150,"_24443":58141,"_5":24775,"_17120":99084,"_23194":99085,"_2329":99086},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2802":58151,"_24443":58141,"_5":24775,"_17120":99088,"_23194":99089,"_2329":99090},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#continúa","Continúa",{"_2802":58152,"_24443":58141,"_17120":99092,"_5":17015,"_23194":58141,"_2329":99093},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2802":58153,"_24443":58141,"_17120":99095,"_5":17015,"_23194":99057,"_2329":99096},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2802":58154,"_24443":58141,"_17120":99098,"_5":17015,"_23194":99057,"_2329":99099},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2802":58155,"_24443":58141,"_17120":99101,"_5":17015,"_23194":99061,"_2329":99102},[],"Descarga el PEM e inspecciónalo:",{"_2802":58156,"_24443":58141,"_17120":99104,"_5":17015,"_23194":99061,"_2329":99105},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2802":58157,"_24443":58141,"_17120":99107,"_5":17015,"_23194":99065,"_2329":99108},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2802":58158,"_24443":58141,"_17120":99110,"_5":17015,"_23194":99065,"_2329":99111},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2802":58159,"_24443":58141,"_17120":99113,"_5":17015,"_23194":99065,"_2329":99114},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2802":58160,"_24443":58141,"_17120":99116,"_5":17015,"_23194":99065,"_2329":99117},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2802":58161,"_24443":58141,"_17120":99119,"_5":17015,"_23194":99065,"_2329":99120},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2802":58162,"_24443":58141,"_17120":99122,"_5":17015,"_23194":99065,"_2329":99123},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2802":58163,"_24443":58141,"_17120":99125,"_5":17015,"_23194":99065,"_2329":99126},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2802":58164,"_24443":58141,"_17120":99128,"_5":17015,"_23194":99069,"_2329":99129},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2802":58165,"_24443":58141,"_17120":99131,"_5":17015,"_23194":99073,"_2329":99132},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2802":58166,"_24443":58141,"_17120":99134,"_5":17015,"_23194":99077,"_2329":99135},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2802":58167,"_24443":58141,"_17120":99137,"_5":17015,"_23194":99081,"_2329":99138},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2802":58168,"_24443":58141,"_17120":99140,"_5":17015,"_23194":99081,"_2329":99141},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2802":58169,"_24443":58141,"_17120":99143,"_5":17015,"_23194":99081,"_2329":99144},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2802":58170,"_24443":58141,"_17120":99146,"_5":17015,"_23194":99085,"_2329":99147},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2802":58171,"_24443":58141,"_17120":99149,"_5":17015,"_23194":99085,"_2329":99150},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2802":58172,"_24443":58141,"_17120":99152,"_5":17015,"_23194":99085,"_2329":99153},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2802":58173,"_24443":58141,"_17120":99155,"_5":17015,"_23194":99089,"_2329":99156},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2802":58174,"_24443":58141,"_17120":99158,"_5":17015,"_23194":99089,"_2329":99159},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2802":58175,"_24443":58175,"_5":12033,"_2329":99161,"_24778":99162,"_17120":99164,"_23194":58175},"Ciclo de vida de un certificado",[39822,94885,44681,99163],"Conceptos",[],{"_2802":58176,"_24443":58175,"_17120":99166,"_5":17015,"_23194":58175,"_2329":99167},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2802":58177,"_24443":58175,"_5":24775,"_17120":99169,"_23194":99170,"_2329":99171},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2802":58178,"_24443":58175,"_5":24775,"_17120":99173,"_23194":99174,"_2329":99175},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2802":58179,"_24443":58175,"_5":24775,"_17120":99177,"_23194":99178,"_2329":99179},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2802":58180,"_24443":58175,"_5":24775,"_17120":99181,"_23194":99182,"_2329":99183},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2802":58181,"_24443":58175,"_5":24775,"_17120":99185,"_23194":99186,"_2329":99187},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2802":58182,"_24443":58175,"_5":24775,"_17120":99189,"_23194":99190,"_2329":99191},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2802":58183,"_24443":58175,"_5":24775,"_17120":99193,"_23194":99194,"_2329":99195},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2802":58184,"_24443":58175,"_5":24775,"_17120":99197,"_23194":99198,"_2329":99199},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2802":58185,"_24443":58175,"_5":24775,"_17120":99201,"_23194":99202,"_2329":99203},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2802":58186,"_24443":58175,"_5":24775,"_17120":99205,"_23194":99206,"_2329":99207},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2802":58187,"_24443":58175,"_17120":99209,"_5":17015,"_23194":58175,"_2329":99210},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2802":58188,"_24443":58175,"_17120":99212,"_5":17015,"_23194":99174,"_2329":99213},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2802":58189,"_24443":58175,"_17120":99215,"_5":17015,"_23194":99178,"_2329":99216},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2802":58190,"_24443":58175,"_17120":99218,"_5":17015,"_23194":99182,"_2329":99219},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2802":58191,"_24443":58175,"_17120":99221,"_5":17015,"_23194":99186,"_2329":99222},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2802":58192,"_24443":58175,"_17120":99224,"_5":17015,"_23194":99190,"_2329":99225},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2802":58193,"_24443":58175,"_17120":99227,"_5":17015,"_23194":99194,"_2329":99228},[],"Lamassu persiste cuatro estados X.509:",{"_2802":58194,"_24443":58175,"_17120":99230,"_5":17015,"_23194":99194,"_2329":99231},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2802":58195,"_24443":58175,"_17120":99233,"_5":17015,"_23194":99194,"_2329":99234},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2802":58196,"_24443":58175,"_17120":99236,"_5":17015,"_23194":99194,"_2329":99237},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2802":58197,"_24443":58175,"_17120":99239,"_5":17015,"_23194":99194,"_2329":99240},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2802":58198,"_24443":58175,"_17120":99242,"_5":17015,"_23194":99194,"_2329":99243},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2802":58199,"_24443":58175,"_17120":99245,"_5":17015,"_23194":99198,"_2329":99246},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2802":58200,"_24443":58175,"_17120":99248,"_5":17015,"_23194":99198,"_2329":99249},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2802":58201,"_24443":58175,"_17120":99251,"_5":17015,"_23194":99198,"_2329":99252},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2802":58202,"_24443":58175,"_17120":99254,"_5":17015,"_23194":99202,"_2329":99255},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2802":58203,"_24443":58175,"_17120":99257,"_5":17015,"_23194":99202,"_2329":99258},[],"Antes de confirmar:",{"_2802":58204,"_24443":58175,"_17120":99260,"_5":17015,"_23194":99202,"_2329":99261},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2802":58205,"_24443":58175,"_17120":99263,"_5":17015,"_23194":99202,"_2329":99264},[],"Distribuye la nueva cadena de confianza.",{"_2802":58206,"_24443":58175,"_17120":99266,"_5":17015,"_23194":99202,"_2329":99267},[],"Reemite las identidades necesarias.",{"_2802":58207,"_24443":58175,"_17120":99269,"_5":17015,"_23194":99202,"_2329":99270},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2802":58208,"_24443":58175,"_17120":99272,"_5":17015,"_23194":99202,"_2329":99273},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2802":58209,"_24443":58175,"_17120":99275,"_5":17015,"_23194":99202,"_2329":99276},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2802":58210,"_24443":58175,"_17120":99278,"_5":17015,"_23194":99206,"_2329":99279},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2802":58211,"_24443":58175,"_17120":99281,"_5":17015,"_23194":99206,"_2329":99282},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2802":58212,"_24443":58175,"_17120":99284,"_5":17015,"_23194":99206,"_2329":99285},[],"Cambios de estado y razones de revocación.",{"_2802":58213,"_24443":58175,"_17120":99287,"_5":17015,"_23194":99206,"_2329":99288},[],"Publicación y vigencia de OCSP y CRLs.",{"_2802":58214,"_24443":58175,"_17120":99290,"_5":17015,"_23194":99206,"_2329":99291},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2802":58215,"_24443":58175,"_17120":99293,"_5":17015,"_23194":99206,"_2329":99294},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2802":58216,"_24443":58216,"_5":12033,"_2329":99296,"_24778":99297,"_17120":99298,"_23194":58216},"Modelo de confianza",[39822,94885,44681,99163],[],{"_2802":58217,"_24443":58216,"_17120":99300,"_5":17015,"_23194":58216,"_2329":99301},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2802":58218,"_24443":58216,"_5":24775,"_17120":99303,"_23194":99304,"_2329":99305},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2802":58219,"_24443":58216,"_5":24775,"_17120":99307,"_23194":99308,"_2329":99309},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2802":58220,"_24443":58216,"_5":24775,"_17120":99311,"_23194":99312,"_2329":99313},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2802":58221,"_24443":58216,"_5":24775,"_17120":99315,"_23194":99316,"_2329":99317},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2802":58222,"_24443":58216,"_5":24775,"_17120":99319,"_23194":99320,"_2329":99321},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2802":58223,"_24443":58216,"_5":24775,"_17120":99323,"_23194":99324,"_2329":99325},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2802":58224,"_24443":58216,"_5":24775,"_17120":99327,"_23194":99328,"_2329":99329},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2802":58225,"_24443":58216,"_5":24775,"_17120":99331,"_23194":99332,"_2329":99333},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2802":58226,"_24443":58216,"_5":24775,"_17120":99335,"_23194":99336,"_2329":99337},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2802":58227,"_24443":58216,"_5":24775,"_17120":99339,"_23194":99340,"_2329":99341},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2802":58228,"_24443":58216,"_17120":99343,"_5":17015,"_23194":58216,"_2329":99344},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2802":58229,"_24443":58216,"_17120":99346,"_5":17015,"_23194":99308,"_2329":99347},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2802":58230,"_24443":58216,"_17120":99349,"_5":17015,"_23194":99312,"_2329":99350},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2802":58231,"_24443":58216,"_17120":99352,"_5":17015,"_23194":99316,"_2329":99353},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2802":58232,"_24443":58216,"_17120":99355,"_5":17015,"_23194":99320,"_2329":99356},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2802":58233,"_24443":58216,"_17120":99358,"_5":17015,"_23194":99324,"_2329":99359},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2802":58234,"_24443":58216,"_17120":99361,"_5":17015,"_23194":99324,"_2329":99362},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2802":58235,"_24443":58216,"_17120":99364,"_5":17015,"_23194":99324,"_2329":99365},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2802":58236,"_24443":58216,"_17120":99367,"_5":17015,"_23194":99324,"_2329":99368},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2802":58237,"_24443":58216,"_17120":99370,"_5":17015,"_23194":99324,"_2329":99371},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2802":58238,"_24443":58216,"_17120":99373,"_5":17015,"_23194":99324,"_2329":99374},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2802":58239,"_24443":58216,"_17120":99376,"_5":17015,"_23194":99328,"_2329":99377},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2802":58240,"_24443":58216,"_17120":99379,"_5":17015,"_23194":99328,"_2329":99380},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2802":58241,"_24443":58216,"_17120":99382,"_5":17015,"_23194":99328,"_2329":99383},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2802":58242,"_24443":58216,"_17120":99385,"_5":17015,"_23194":99328,"_2329":99386},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2802":58243,"_24443":58216,"_17120":99388,"_5":17015,"_23194":99328,"_2329":99389},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2802":58244,"_24443":58216,"_17120":99391,"_5":17015,"_23194":99332,"_2329":99392},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2802":58245,"_24443":58216,"_17120":99394,"_5":17015,"_23194":99332,"_2329":99395},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2802":58246,"_24443":58216,"_17120":99397,"_5":17015,"_23194":99332,"_2329":99398},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2802":58247,"_24443":58216,"_17120":99400,"_5":17015,"_23194":99332,"_2329":99401},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2802":58248,"_24443":58216,"_17120":99403,"_5":17015,"_23194":99332,"_2329":99404},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2802":58249,"_24443":58216,"_17120":99406,"_5":17015,"_23194":99332,"_2329":99407},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2802":58250,"_24443":58216,"_17120":99409,"_5":17015,"_23194":99332,"_2329":99410},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2802":58251,"_24443":58216,"_17120":99412,"_5":17015,"_23194":99336,"_2329":99413},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2802":58252,"_24443":58216,"_17120":99415,"_5":17015,"_23194":99340,"_2329":99416},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2802":58253,"_24443":58216,"_17120":99418,"_5":17015,"_23194":99340,"_2329":99419},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2802":58254,"_24443":58216,"_17120":99421,"_5":17015,"_23194":99340,"_2329":99422},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2802":58255,"_24443":58216,"_17120":99424,"_5":17015,"_23194":99340,"_2329":99425},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2802":58256,"_24443":58216,"_17120":99427,"_5":17015,"_23194":99340,"_2329":99428},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2802":58257,"_24443":58216,"_17120":99430,"_5":17015,"_23194":99340,"_2329":99431},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2802":58258,"_24443":58216,"_17120":99433,"_5":17015,"_23194":99340,"_2329":99434},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2802":58259,"_24443":58259,"_5":12033,"_2329":99436,"_24778":99437,"_17120":99438,"_23194":58259},"Listas de revocación (CRL)",[39822,94885,44681,98924],[],{"_2802":58260,"_24443":58259,"_17120":99440,"_5":17015,"_23194":58259,"_2329":99441},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2802":58261,"_24443":58259,"_5":24775,"_17120":99443,"_23194":99444,"_2329":99445},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2802":58262,"_24443":58259,"_5":24775,"_17120":99447,"_23194":99448,"_2329":99449},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2802":58263,"_24443":58259,"_5":24775,"_17120":99451,"_23194":99452,"_2329":99453},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2802":58264,"_24443":58259,"_5":24775,"_17120":99455,"_23194":99456,"_2329":99457},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2802":58265,"_24443":58259,"_5":24775,"_17120":99459,"_23194":99460,"_2329":99461},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2802":58266,"_24443":58259,"_5":24775,"_17120":99463,"_23194":99464,"_2329":99465},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2802":58267,"_24443":58259,"_5":24775,"_17120":99467,"_23194":99468,"_2329":99469},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#referencias","Referencias",{"_2802":58268,"_24443":58259,"_17120":99471,"_5":17015,"_23194":58259,"_2329":99472},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2802":58269,"_24443":58259,"_17120":99474,"_5":17015,"_23194":99444,"_2329":99475},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2802":58270,"_24443":58259,"_17120":99477,"_5":17015,"_23194":99444,"_2329":99478},[],"Campo de `crl_options`",{"_2802":58271,"_24443":58259,"_17120":99480,"_5":17015,"_23194":99444,"_2329":96254},[],{"_2802":58272,"_24443":58259,"_17120":99482,"_5":17015,"_23194":99444,"_2329":99483},[],"Valor inicial del backend",{"_2802":58273,"_24443":58259,"_17120":99485,"_5":17015,"_23194":99444,"_2329":45861},[],{"_2802":58274,"_24443":58259,"_17120":99487,"_5":17015,"_23194":99444,"_2329":99488},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2802":58275,"_24443":58259,"_17120":99490,"_5":17015,"_23194":99444,"_2329":99491},[],"7 días.",{"_2802":58276,"_24443":58259,"_17120":99493,"_5":17015,"_23194":99444,"_2329":45870},[],{"_2802":58277,"_24443":58259,"_17120":99495,"_5":17015,"_23194":99444,"_2329":99496},[],"Plazo desde la publicación que activa la renovación programada.",{"_2802":58278,"_24443":58259,"_17120":99498,"_5":17015,"_23194":99444,"_2329":99499},[],"6 días y 23 horas.",{"_2802":58279,"_24443":58259,"_17120":99501,"_5":17015,"_23194":99444,"_2329":45879},[],{"_2802":58280,"_24443":58259,"_17120":99503,"_5":17015,"_23194":99444,"_2329":99504},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2802":58281,"_24443":58259,"_17120":99506,"_5":17015,"_23194":99444,"_2329":45885},[],{"_2802":58282,"_24443":58259,"_17120":99508,"_5":17015,"_23194":99444,"_2329":45888},[],{"_2802":58283,"_24443":58259,"_17120":99510,"_5":17015,"_23194":99444,"_2329":99511},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2802":58284,"_24443":58259,"_17120":99513,"_5":17015,"_23194":99444,"_2329":99514},[],"SKI de la CA.",{"_2802":58285,"_24443":58259,"_17120":99516,"_5":17015,"_23194":99444,"_2329":99517},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2802":58286,"_24443":58259,"_17120":99519,"_5":17015,"_23194":99444,"_2329":99520},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2802":58287,"_24443":58259,"_17120":99522,"_5":17015,"_23194":99448,"_2329":99523},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2802":58288,"_24443":58259,"_17120":99525,"_5":17015,"_23194":99448,"_2329":99526},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2802":58289,"_24443":58259,"_17120":99528,"_5":17015,"_23194":99448,"_2329":99529},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2802":58290,"_24443":58259,"_17120":99531,"_5":17015,"_23194":99452,"_2329":99532},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2802":58291,"_24443":58259,"_17120":99534,"_5":17015,"_23194":99452,"_2329":99535},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2802":58292,"_24443":58259,"_17120":99537,"_5":17015,"_23194":99456,"_2329":99538},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2802":58293,"_24443":58259,"_17120":99540,"_5":17015,"_23194":99456,"_2329":99541},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2802":58294,"_24443":58259,"_17120":99543,"_5":17015,"_23194":99456,"_2329":99544},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2802":58295,"_24443":58259,"_17120":99546,"_5":17015,"_23194":99456,"_2329":99547},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2802":58296,"_24443":58259,"_17120":99549,"_5":17015,"_23194":99456,"_2329":99550},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2802":58297,"_24443":58259,"_17120":99552,"_5":17015,"_23194":99460,"_2329":99553},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2802":58298,"_24443":58259,"_17120":99555,"_5":17015,"_23194":99460,"_2329":96443},[],{"_2802":58299,"_24443":58259,"_17120":99557,"_5":17015,"_23194":99460,"_2329":99558},[],"Path relativo",{"_2802":58300,"_24443":58259,"_17120":99560,"_5":17015,"_23194":99460,"_2329":94676},[],{"_2802":58301,"_24443":58259,"_17120":99562,"_5":17015,"_23194":99460,"_2329":45943},[],{"_2802":58302,"_24443":58259,"_17120":99564,"_5":17015,"_23194":99460,"_2329":45946},[],{"_2802":58303,"_24443":58259,"_17120":99566,"_5":17015,"_23194":99460,"_2329":99567},[],"Consultar `crl_options` y `latest_crl`.",{"_2802":58304,"_24443":58259,"_17120":99569,"_5":17015,"_23194":99460,"_2329":45952},[],{"_2802":58305,"_24443":58259,"_17120":99571,"_5":17015,"_23194":99460,"_2329":45946},[],{"_2802":58306,"_24443":58259,"_17120":99573,"_5":17015,"_23194":99460,"_2329":99574},[],"Sustituir la configuración de CRL.",{"_2802":58307,"_24443":58259,"_17120":99576,"_5":17015,"_23194":99460,"_2329":99577},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2802":58308,"_24443":58259,"_17120":99579,"_5":17015,"_23194":99460,"_2329":99580},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2802":58309,"_24443":58259,"_17120":99582,"_5":17015,"_23194":99464,"_2329":99583},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2802":58310,"_24443":58259,"_17120":99585,"_5":17015,"_23194":99468,"_2329":99586},[],"RFC 5280: perfil X.509 y CRL.",{"_2802":58311,"_24443":58259,"_17120":99588,"_5":17015,"_23194":99468,"_2329":45972},[],{"_2802":58312,"_24443":58259,"_17120":99590,"_5":17015,"_23194":99468,"_2329":45975},[],{"_2802":58313,"_24443":58259,"_17120":99592,"_5":17015,"_23194":99468,"_2329":99593},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2802":58314,"_24443":58259,"_17120":99595,"_5":17015,"_23194":99468,"_2329":99596},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2802":58315,"_24443":58315,"_5":12033,"_2329":99598,"_24778":99599,"_17120":99600,"_23194":58315},"Claves y motores criptográficos",[39822,94885,44681,98309],[],{"_2802":58316,"_24443":58315,"_17120":99602,"_5":17015,"_23194":58315,"_2329":99603},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2802":58317,"_24443":58315,"_5":24775,"_17120":99605,"_23194":99606,"_2329":99607},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2802":58318,"_24443":58315,"_5":24775,"_17120":99609,"_23194":99610,"_2329":99611},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2802":58319,"_24443":58315,"_5":24775,"_17120":99613,"_23194":99614,"_2329":46000},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#file-system",{"_2802":58320,"_24443":58315,"_5":24775,"_17120":99616,"_23194":99617,"_2329":46004},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#hashicorp-vault",{"_2802":58321,"_24443":58315,"_5":24775,"_17120":99619,"_23194":99620,"_2329":46008},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#aws-secrets-manager",{"_2802":58322,"_24443":58315,"_5":24775,"_17120":99622,"_23194":99623,"_2329":46012},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#aws-kms",{"_2802":58323,"_24443":58315,"_5":24775,"_17120":99625,"_23194":99626,"_2329":46016},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#pkcs11",{"_2802":58324,"_24443":58315,"_5":24775,"_17120":99628,"_23194":99629,"_2329":46020},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#azure-key-vault",{"_2802":58325,"_24443":58315,"_5":24775,"_17120":99631,"_23194":99632,"_2329":99633},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2802":58326,"_24443":58315,"_5":24775,"_17120":99635,"_23194":99636,"_2329":99637},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2802":58327,"_24443":58315,"_5":24775,"_17120":99639,"_23194":99640,"_2329":99641},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2802":58328,"_24443":58315,"_5":24775,"_17120":99643,"_23194":99644,"_2329":99645},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2802":58329,"_24443":58315,"_5":24775,"_17120":99647,"_23194":99648,"_2329":99649},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2802":58330,"_24443":58315,"_5":24775,"_17120":99651,"_23194":99652,"_2329":99653},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2802":58331,"_24443":58315,"_5":24775,"_17120":99655,"_23194":99656,"_2329":99657},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2802":58332,"_24443":58315,"_5":24775,"_17120":99659,"_23194":99660,"_2329":46052},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#sign",{"_2802":58333,"_24443":58315,"_5":24775,"_17120":99662,"_23194":99663,"_2329":46056},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#verify",{"_2802":58334,"_24443":58315,"_5":24775,"_17120":99665,"_23194":99666,"_2329":99667},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2802":58335,"_24443":58315,"_5":24775,"_17120":99669,"_23194":99670,"_2329":99671},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2802":58336,"_24443":58315,"_5":24775,"_17120":99673,"_23194":99674,"_2329":99675},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2802":58337,"_24443":58315,"_17120":99677,"_5":17015,"_23194":58315,"_2329":99678},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2802":58338,"_24443":58315,"_17120":99680,"_5":17015,"_23194":58315,"_2329":99681},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2802":58339,"_24443":58315,"_17120":99683,"_5":17015,"_23194":99606,"_2329":99684},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2802":58340,"_24443":58315,"_17120":99686,"_5":17015,"_23194":99606,"_2329":99687},[],"En la práctica, permite:",{"_2802":58341,"_24443":58315,"_17120":99689,"_5":17015,"_23194":99606,"_2329":99690},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2802":58342,"_24443":58315,"_17120":99692,"_5":17015,"_23194":99606,"_2329":99693},[],"Importar claves creadas externamente.",{"_2802":58343,"_24443":58315,"_17120":99695,"_5":17015,"_23194":99606,"_2329":99696},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2802":58344,"_24443":58315,"_17120":99698,"_5":17015,"_23194":99606,"_2329":99699},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2802":58345,"_24443":58315,"_17120":99701,"_5":17015,"_23194":99610,"_2329":99702},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2802":58346,"_24443":58315,"_17120":99704,"_5":17015,"_23194":99610,"_2329":99705},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2802":58347,"_24443":58315,"_17120":99707,"_5":17015,"_23194":99610,"_2329":99708},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2802":58348,"_24443":58315,"_17120":99710,"_5":17015,"_23194":99614,"_2329":99711},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2802":58349,"_24443":58315,"_17120":99713,"_5":17015,"_23194":99617,"_2329":99714},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2802":58350,"_24443":58315,"_17120":99716,"_5":17015,"_23194":99620,"_2329":99717},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2802":58351,"_24443":58315,"_17120":99719,"_5":17015,"_23194":99623,"_2329":99720},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2802":58352,"_24443":58315,"_17120":99722,"_5":17015,"_23194":99626,"_2329":99723},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2802":58353,"_24443":58315,"_17120":99725,"_5":17015,"_23194":99629,"_2329":99726},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2802":58354,"_24443":58315,"_17120":99728,"_5":17015,"_23194":99629,"_2329":99729},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2802":58355,"_24443":58315,"_17120":99731,"_5":17015,"_23194":99629,"_2329":99732},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2802":58356,"_24443":58315,"_17120":99734,"_5":17015,"_23194":99629,"_2329":99735},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2802":58357,"_24443":58315,"_17120":99737,"_5":17015,"_23194":99632,"_2329":99738},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2802":58358,"_24443":58315,"_17120":99740,"_5":17015,"_23194":99632,"_2329":99741},[],"La tabla incluye los siguientes campos:",{"_2802":58359,"_24443":58315,"_17120":99743,"_5":17015,"_23194":99632,"_2329":99744},[],"**Name**: nombre descriptivo de la clave.",{"_2802":58360,"_24443":58315,"_17120":99746,"_5":17015,"_23194":99632,"_2329":99747},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2802":58361,"_24443":58315,"_17120":99749,"_5":17015,"_23194":99632,"_2329":99750},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2802":58362,"_24443":58315,"_17120":99752,"_5":17015,"_23194":99632,"_2329":99753},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2802":58363,"_24443":58315,"_17120":99755,"_5":17015,"_23194":99632,"_2329":99756},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2802":58364,"_24443":58315,"_17120":99758,"_5":17015,"_23194":99632,"_2329":99759},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2802":58365,"_24443":58315,"_17120":99761,"_5":17015,"_23194":99632,"_2329":99762},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2802":58366,"_24443":58315,"_17120":99764,"_5":17015,"_23194":99632,"_2329":99765},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2802":58367,"_24443":58315,"_17120":99767,"_5":17015,"_23194":99632,"_2329":99768},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2802":58368,"_24443":58315,"_17120":99770,"_5":17015,"_23194":99632,"_2329":99771},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2802":58369,"_24443":58315,"_17120":99773,"_5":17015,"_23194":99632,"_2329":99774},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2802":58370,"_24443":58315,"_17120":99776,"_5":17015,"_23194":99632,"_2329":99777},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2802":58371,"_24443":58315,"_17120":99779,"_5":17015,"_23194":99632,"_2329":99780},[],"**Delete Key** para eliminar la clave del sistema.",{"_2802":58372,"_24443":58315,"_17120":99782,"_5":17015,"_23194":99636,"_2329":99783},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2802":58373,"_24443":58315,"_17120":99785,"_5":17015,"_23194":99640,"_2329":99786},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2802":58374,"_24443":58315,"_17120":99788,"_5":17015,"_23194":99640,"_2329":99789},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2802":58375,"_24443":58315,"_17120":99791,"_5":17015,"_23194":99640,"_2329":99792},[],"**Key Name**: nombre único y descriptivo.",{"_2802":58376,"_24443":58315,"_17120":99794,"_5":17015,"_23194":99640,"_2329":99795},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2802":58377,"_24443":58315,"_17120":99797,"_5":17015,"_23194":99640,"_2329":99798},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2802":58378,"_24443":58315,"_17120":99800,"_5":17015,"_23194":99640,"_2329":99801},[],"**Tags**: metadatos para clasificar la clave.",{"_2802":58379,"_24443":58315,"_17120":99803,"_5":17015,"_23194":99640,"_2329":99804},[],"**Metadata**: información adicional para usos avanzados.",{"_2802":58380,"_24443":58315,"_17120":99806,"_5":17015,"_23194":99644,"_2329":99807},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2802":58381,"_24443":58315,"_17120":99809,"_5":17015,"_23194":99644,"_2329":99810},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2802":58382,"_24443":58315,"_17120":99812,"_5":17015,"_23194":99644,"_2329":99813},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2802":58383,"_24443":58315,"_17120":99815,"_5":17015,"_23194":99644,"_2329":99816},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2802":58384,"_24443":58315,"_17120":99818,"_5":17015,"_23194":99644,"_2329":99819},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2802":58385,"_24443":58315,"_17120":99821,"_5":17015,"_23194":99644,"_2329":99822},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2802":58386,"_24443":58315,"_17120":99824,"_5":17015,"_23194":99644,"_2329":99825},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2802":58387,"_24443":58315,"_17120":99827,"_5":17015,"_23194":99644,"_2329":99828},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2802":58388,"_24443":58315,"_17120":99830,"_5":17015,"_23194":99644,"_2329":99831},[],"**Metadata**: información adicional opcional.",{"_2802":58389,"_24443":58315,"_17120":99833,"_5":17015,"_23194":99644,"_2329":99834},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2802":58390,"_24443":58315,"_17120":99836,"_5":17015,"_23194":99644,"_2329":99837},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2802":58391,"_24443":58315,"_17120":99839,"_5":17015,"_23194":99648,"_2329":99840},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2802":58392,"_24443":58315,"_17120":99842,"_5":17015,"_23194":99652,"_2329":99843},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2802":58393,"_24443":58315,"_17120":99845,"_5":17015,"_23194":99652,"_2329":99846},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2802":58394,"_24443":58315,"_17120":99848,"_5":17015,"_23194":99652,"_2329":99849},[],"**Key Name**: nombre descriptivo.",{"_2802":58395,"_24443":58315,"_17120":99851,"_5":17015,"_23194":99652,"_2329":99852},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2802":58396,"_24443":58315,"_17120":99854,"_5":17015,"_23194":99652,"_2329":99855},[],"**Tags**: etiquetas asociadas.",{"_2802":58397,"_24443":58315,"_17120":99857,"_5":17015,"_23194":99652,"_2329":99858},[],"**Aliases**: nombres alternativos.",{"_2802":58398,"_24443":58315,"_17120":99860,"_5":17015,"_23194":99652,"_2329":99861},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2802":58399,"_24443":58315,"_17120":99863,"_5":17015,"_23194":99652,"_2329":99864},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2802":58400,"_24443":58315,"_17120":99866,"_5":17015,"_23194":99652,"_2329":99867},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2802":58401,"_24443":58315,"_17120":99869,"_5":17015,"_23194":99652,"_2329":99870},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2802":58402,"_24443":58315,"_17120":99872,"_5":17015,"_23194":99656,"_2329":99873},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2802":58403,"_24443":58315,"_17120":99875,"_5":17015,"_23194":99656,"_2329":99876},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2802":58404,"_24443":58315,"_17120":99878,"_5":17015,"_23194":99656,"_2329":99879},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2802":58405,"_24443":58315,"_17120":99881,"_5":17015,"_23194":99660,"_2329":99882},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2802":58406,"_24443":58315,"_17120":99884,"_5":17015,"_23194":99660,"_2329":99885},[],"Campos principales:",{"_2802":58407,"_24443":58315,"_17120":99887,"_5":17015,"_23194":99660,"_2329":99888},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2802":58408,"_24443":58315,"_17120":99890,"_5":17015,"_23194":99660,"_2329":99891},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2802":58409,"_24443":58315,"_17120":99893,"_5":17015,"_23194":99660,"_2329":99894},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2802":58410,"_24443":58315,"_17120":99896,"_5":17015,"_23194":99660,"_2329":99897},[],"**Message**: contenido que se va a firmar.",{"_2802":58411,"_24443":58315,"_17120":99899,"_5":17015,"_23194":99660,"_2329":99900},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2802":58412,"_24443":58315,"_17120":99902,"_5":17015,"_23194":99663,"_2329":99903},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2802":58413,"_24443":58315,"_17120":99905,"_5":17015,"_23194":99663,"_2329":99885},[],{"_2802":58414,"_24443":58315,"_17120":99907,"_5":17015,"_23194":99663,"_2329":99908},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2802":58415,"_24443":58315,"_17120":99910,"_5":17015,"_23194":99663,"_2329":99911},[],"**Message Type**: `Raw` o `Digest`.",{"_2802":58416,"_24443":58315,"_17120":99913,"_5":17015,"_23194":99663,"_2329":99914},[],"**Payload Encoding**: codificación del mensaje.",{"_2802":58417,"_24443":58315,"_17120":99916,"_5":17015,"_23194":99663,"_2329":99917},[],"**Message**: mensaje original o hash.",{"_2802":58418,"_24443":58315,"_17120":99919,"_5":17015,"_23194":99663,"_2329":99920},[],"**Signature**: firma que se desea comprobar.",{"_2802":58419,"_24443":58315,"_17120":99922,"_5":17015,"_23194":99663,"_2329":99923},[],"**Result**: indicador del resultado de la validación.",{"_2802":58420,"_24443":58315,"_17120":99925,"_5":17015,"_23194":99666,"_2329":99926},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2802":58421,"_24443":58315,"_17120":99928,"_5":17015,"_23194":99666,"_2329":99929},[],"Este flujo es útil para:",{"_2802":58422,"_24443":58315,"_17120":99931,"_5":17015,"_23194":99666,"_2329":99932},[],"Solicitar certificados a una CA externa.",{"_2802":58423,"_24443":58315,"_17120":99934,"_5":17015,"_23194":99666,"_2329":99935},[],"Renovar una identidad manteniendo la misma clave.",{"_2802":58424,"_24443":58315,"_17120":99937,"_5":17015,"_23194":99666,"_2329":99938},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2802":58425,"_24443":58315,"_17120":99940,"_5":17015,"_23194":99666,"_2329":99941},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2802":58426,"_24443":58315,"_17120":99943,"_5":17015,"_23194":99666,"_2329":99944},[],"**Organization (O)**: organización o empresa.",{"_2802":58427,"_24443":58315,"_17120":99946,"_5":17015,"_23194":99666,"_2329":99947},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2802":58428,"_24443":58315,"_17120":99949,"_5":17015,"_23194":99666,"_2329":99950},[],"**Country (C)**: código de país de dos letras.",{"_2802":58429,"_24443":58315,"_17120":99952,"_5":17015,"_23194":99666,"_2329":99953},[],"**State / Province (ST)**: estado o provincia.",{"_2802":58430,"_24443":58315,"_17120":99955,"_5":17015,"_23194":99666,"_2329":99956},[],"**Locality (L)**: ciudad o localidad.",{"_2802":58431,"_24443":58315,"_17120":99958,"_5":17015,"_23194":99666,"_2329":99959},[],"**Email Address**: correo de contacto.",{"_2802":58432,"_24443":58315,"_17120":99961,"_5":17015,"_23194":99666,"_2329":99962},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2802":58433,"_24443":58315,"_17120":99964,"_5":17015,"_23194":99666,"_2329":99965},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2802":58434,"_24443":58315,"_17120":99967,"_5":17015,"_23194":99670,"_2329":99968},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2802":58435,"_24443":58315,"_17120":99970,"_5":17015,"_23194":99670,"_2329":46364},[],{"_2802":58436,"_24443":58315,"_17120":99972,"_5":17015,"_23194":99674,"_2329":99973},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2802":58437,"_24443":58437,"_5":12033,"_2329":99975,"_24778":99976,"_17120":99977,"_23194":58437},"Validación online con OCSP",[39822,94885,44681,98924],[],{"_2802":58438,"_24443":58437,"_17120":99979,"_5":17015,"_23194":58437,"_2329":99980},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2802":58439,"_24443":58437,"_5":24775,"_17120":99982,"_23194":99983,"_2329":99984},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2802":58440,"_24443":58437,"_5":24775,"_17120":99986,"_23194":99987,"_2329":99988},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2802":58441,"_24443":58437,"_5":24775,"_17120":99990,"_23194":99991,"_2329":99992},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2802":58442,"_24443":58437,"_5":24775,"_17120":99994,"_23194":99995,"_2329":99996},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2802":58443,"_24443":58437,"_5":24775,"_17120":99998,"_23194":99999,"_2329":100000},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2802":58444,"_24443":58437,"_5":24775,"_17120":100002,"_23194":100003,"_2329":99469},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#referencias",{"_2802":58445,"_24443":58437,"_17120":100005,"_5":17015,"_23194":58437,"_2329":100006},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2802":58446,"_24443":58437,"_17120":100008,"_5":17015,"_23194":99983,"_2329":100009},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2802":58447,"_24443":58437,"_17120":100011,"_5":17015,"_23194":99983,"_2329":100012},[],"Estado del registro",{"_2802":58448,"_24443":58437,"_17120":100014,"_5":17015,"_23194":99983,"_2329":100015},[],"Respuesta firmada",{"_2802":58449,"_24443":58437,"_17120":100017,"_5":17015,"_23194":99983,"_2329":43859},[],{"_2802":58450,"_24443":58437,"_17120":100019,"_5":17015,"_23194":99983,"_2329":46414},[],{"_2802":58451,"_24443":58437,"_17120":100021,"_5":17015,"_23194":99983,"_2329":43876},[],{"_2802":58452,"_24443":58437,"_17120":100023,"_5":17015,"_23194":99983,"_2329":100024},[],"`Revoked`, con razón y fecha de revocación.",{"_2802":58453,"_24443":58437,"_17120":100026,"_5":17015,"_23194":99983,"_2329":100027},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2802":58454,"_24443":58437,"_17120":100029,"_5":17015,"_23194":99983,"_2329":100030},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2802":58455,"_24443":58437,"_17120":100032,"_5":17015,"_23194":99983,"_2329":100033},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2802":58456,"_24443":58437,"_17120":100035,"_5":17015,"_23194":99983,"_2329":100036},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2802":58457,"_24443":58437,"_17120":100038,"_5":17015,"_23194":99983,"_2329":100039},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2802":58458,"_24443":58437,"_17120":100041,"_5":17015,"_23194":99987,"_2329":100042},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2802":58459,"_24443":58437,"_17120":100044,"_5":17015,"_23194":99987,"_2329":100045},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2802":58460,"_24443":58437,"_17120":100047,"_5":17015,"_23194":99991,"_2329":100048},[],"El servicio acepta:",{"_2802":58461,"_24443":58437,"_17120":100050,"_5":17015,"_23194":99991,"_2329":96443},[],{"_2802":58462,"_24443":58437,"_17120":100052,"_5":17015,"_23194":99991,"_2329":100053},[],"Ruta del servicio VA",{"_2802":58463,"_24443":58437,"_17120":100055,"_5":17015,"_23194":99991,"_2329":100056},[],"Formato",{"_2802":58464,"_24443":58437,"_17120":100058,"_5":17015,"_23194":99991,"_2329":46454},[],{"_2802":58465,"_24443":58437,"_17120":100060,"_5":17015,"_23194":99991,"_2329":46457},[],{"_2802":58466,"_24443":58437,"_17120":100062,"_5":17015,"_23194":99991,"_2329":100063},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2802":58467,"_24443":58437,"_17120":100065,"_5":17015,"_23194":99991,"_2329":45943},[],{"_2802":58468,"_24443":58437,"_17120":100067,"_5":17015,"_23194":99991,"_2329":46465},[],{"_2802":58469,"_24443":58437,"_17120":100069,"_5":17015,"_23194":99991,"_2329":100070},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2802":58470,"_24443":58437,"_17120":100072,"_5":17015,"_23194":99991,"_2329":100073},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2802":58471,"_24443":58437,"_17120":100075,"_5":17015,"_23194":99995,"_2329":100076},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2802":58472,"_24443":58437,"_17120":100078,"_5":17015,"_23194":99995,"_2329":100079},[],"Genera la solicitud:",{"_2802":58473,"_24443":58437,"_17120":100081,"_5":17015,"_23194":99995,"_2329":100082},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2802":58474,"_24443":58437,"_17120":100084,"_5":17015,"_23194":99995,"_2329":100085},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2802":58475,"_24443":58437,"_17120":100087,"_5":17015,"_23194":99995,"_2329":100088},[],"Verifica el DER recibido:",{"_2802":58476,"_24443":58437,"_17120":100090,"_5":17015,"_23194":99995,"_2329":100091},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2802":58477,"_24443":58437,"_17120":100093,"_5":17015,"_23194":99999,"_2329":100094},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2802":58478,"_24443":58437,"_17120":100096,"_5":17015,"_23194":99999,"_2329":100097},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2802":58479,"_24443":58437,"_17120":100099,"_5":17015,"_23194":100003,"_2329":46498},[],{"_2802":58480,"_24443":58437,"_17120":100101,"_5":17015,"_23194":100003,"_2329":46501},[],{"_2802":58481,"_24443":58437,"_17120":100103,"_5":17015,"_23194":100003,"_2329":100104},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2802":58482,"_24443":58437,"_17120":100106,"_5":17015,"_23194":100003,"_2329":99596},[],{"_2802":58483,"_24443":58483,"_5":12033,"_2329":44681,"_24778":100108,"_17120":100109,"_23194":58483},[39822,94885,44681],[],{"_2802":58484,"_24443":58483,"_17120":100111,"_5":17015,"_23194":58483,"_2329":100112},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2802":58485,"_24443":58483,"_5":24775,"_17120":100114,"_23194":100115,"_2329":97633},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#empieza-aquí",{"_2802":58486,"_24443":58483,"_5":24775,"_17120":100117,"_23194":100118,"_2329":100119},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2802":58487,"_24443":58483,"_5":24775,"_17120":100121,"_23194":100122,"_2329":98155},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#capacidades-principales",{"_2802":58488,"_24443":58483,"_5":24775,"_17120":100124,"_23194":100125,"_2329":98159},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2802":58489,"_24443":58483,"_5":24775,"_17120":100127,"_23194":100128,"_2329":98163},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2802":58490,"_24443":58483,"_5":24775,"_17120":100130,"_23194":100131,"_2329":98167},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#emite-y-controla-certificados",{"_2802":58491,"_24443":58483,"_5":24775,"_17120":100133,"_23194":100134,"_2329":98175},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#publica-el-estado-de-validación",{"_2802":58492,"_24443":58483,"_5":24775,"_17120":100136,"_23194":100137,"_2329":100138},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2802":58493,"_24443":58483,"_5":24775,"_17120":100140,"_23194":100141,"_2329":99090},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#continúa",{"_2802":58494,"_24443":58483,"_17120":100143,"_5":17015,"_23194":58483,"_2329":100144},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2802":58495,"_24443":58483,"_17120":100146,"_5":17015,"_23194":100115,"_2329":100147},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2802":58496,"_24443":58483,"_17120":100149,"_5":17015,"_23194":100115,"_2329":100150},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2802":58497,"_24443":58483,"_17120":100152,"_5":17015,"_23194":100118,"_2329":100153},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2802":58498,"_24443":58483,"_17120":100155,"_5":17015,"_23194":100118,"_2329":100156},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2802":58499,"_24443":58483,"_17120":100158,"_5":17015,"_23194":100118,"_2329":100159},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2802":58500,"_24443":58483,"_17120":100161,"_5":17015,"_23194":100118,"_2329":100162},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2802":58501,"_24443":58483,"_17120":100164,"_5":17015,"_23194":100118,"_2329":100165},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2802":58502,"_24443":58483,"_17120":100167,"_5":17015,"_23194":100125,"_2329":100168},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2802":58503,"_24443":58483,"_17120":100170,"_5":17015,"_23194":100128,"_2329":100171},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2802":58504,"_24443":58483,"_17120":100173,"_5":17015,"_23194":100131,"_2329":100174},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2802":58505,"_24443":58483,"_17120":100176,"_5":17015,"_23194":100134,"_2329":100177},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2802":58506,"_24443":58483,"_17120":100179,"_5":17015,"_23194":100137,"_2329":100180},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2802":58507,"_24443":58483,"_17120":100182,"_5":17015,"_23194":100137,"_2329":100183},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2802":58508,"_24443":58483,"_17120":100185,"_5":17015,"_23194":100137,"_2329":100186},[],"su clave pública corresponda a la clave privada del cliente;",{"_2802":58509,"_24443":58483,"_17120":100188,"_5":17015,"_23194":100137,"_2329":100189},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2802":58510,"_24443":58483,"_17120":100191,"_5":17015,"_23194":100137,"_2329":100192},[],"sus fechas y usos permitan la operación;",{"_2802":58511,"_24443":58483,"_17120":100194,"_5":17015,"_23194":100137,"_2329":100195},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2802":58512,"_24443":58483,"_17120":100197,"_5":17015,"_23194":100137,"_2329":100198},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2802":58513,"_24443":58483,"_17120":100200,"_5":17015,"_23194":100141,"_2329":100201},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2802":58514,"_24443":58483,"_17120":100203,"_5":17015,"_23194":100141,"_2329":100204},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2802":58515,"_24443":58483,"_17120":100206,"_5":17015,"_23194":100141,"_2329":100207},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2802":58516,"_24443":58516,"_5":12033,"_2329":100209,"_24778":100210,"_17120":100211,"_23194":58516},"Crea tu primera CA",[39822,94885,44681,97757],[],{"_2802":58517,"_24443":58516,"_17120":100213,"_5":17015,"_23194":58516,"_2329":100214},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2802":58518,"_24443":58516,"_5":24775,"_17120":100216,"_23194":100217,"_2329":93586},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2802":58519,"_24443":58516,"_5":24775,"_17120":100219,"_23194":100220,"_2329":100221},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2802":58520,"_24443":58516,"_5":24775,"_17120":100223,"_23194":100224,"_2329":100225},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2802":58521,"_24443":58516,"_5":24775,"_17120":100227,"_23194":100228,"_2329":100229},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2802":58522,"_24443":58516,"_5":24775,"_17120":100231,"_23194":100232,"_2329":100233},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2802":58523,"_24443":58516,"_5":24775,"_17120":100235,"_23194":100236,"_2329":100237},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2802":58524,"_24443":58516,"_5":24775,"_17120":100239,"_23194":100240,"_2329":100241},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2802":58525,"_24443":58516,"_5":24775,"_17120":100243,"_23194":100244,"_2329":98005},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2802":58526,"_24443":58516,"_5":24775,"_17120":100246,"_23194":100247,"_2329":93610},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2802":58527,"_24443":58516,"_17120":100249,"_5":17015,"_23194":58516,"_2329":100250},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2802":58528,"_24443":58516,"_17120":100252,"_5":17015,"_23194":100217,"_2329":100253},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2802":58529,"_24443":58516,"_17120":100255,"_5":17015,"_23194":100217,"_2329":100256},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2802":58530,"_24443":58516,"_17120":100258,"_5":17015,"_23194":100217,"_2329":100259},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2802":58531,"_24443":58516,"_17120":100261,"_5":17015,"_23194":100217,"_2329":100262},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2802":58532,"_24443":58516,"_17120":100264,"_5":17015,"_23194":100220,"_2329":100265},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2802":58533,"_24443":58516,"_17120":100267,"_5":17015,"_23194":100220,"_2329":100268},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2802":58534,"_24443":58516,"_17120":100270,"_5":17015,"_23194":100224,"_2329":100271},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2802":58535,"_24443":58516,"_17120":100273,"_5":17015,"_23194":100224,"_2329":100274},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2802":58536,"_24443":58516,"_17120":100276,"_5":17015,"_23194":100228,"_2329":100277},[],"Selecciona **Root CA** y completa:",{"_2802":58537,"_24443":58516,"_17120":100279,"_5":17015,"_23194":100228,"_2329":46680},[],{"_2802":58538,"_24443":58516,"_17120":100281,"_5":17015,"_23194":100228,"_2329":100282},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2802":58539,"_24443":58516,"_17120":100284,"_5":17015,"_23194":100228,"_2329":100285},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2802":58540,"_24443":58516,"_17120":100287,"_5":17015,"_23194":100228,"_2329":100288},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2802":58541,"_24443":58516,"_17120":100290,"_5":17015,"_23194":100228,"_2329":100291},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2802":58542,"_24443":58516,"_17120":100293,"_5":17015,"_23194":100232,"_2329":100294},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2802":58543,"_24443":58516,"_17120":100296,"_5":17015,"_23194":100236,"_2329":100297},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2802":58544,"_24443":58516,"_17120":100299,"_5":17015,"_23194":100236,"_2329":100300},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2802":58545,"_24443":58516,"_17120":100302,"_5":17015,"_23194":100240,"_2329":100303},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2802":58546,"_24443":58516,"_17120":100305,"_5":17015,"_23194":100240,"_2329":100306},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2802":58547,"_24443":58516,"_17120":100308,"_5":17015,"_23194":100240,"_2329":100309},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2802":58548,"_24443":58516,"_17120":100311,"_5":17015,"_23194":100244,"_2329":100312},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2802":58549,"_24443":58516,"_17120":100314,"_5":17015,"_23194":100244,"_2329":100315},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2802":58550,"_24443":58516,"_17120":100317,"_5":17015,"_23194":100244,"_2329":100318},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2802":58551,"_24443":58516,"_17120":100320,"_5":17015,"_23194":100244,"_2329":100321},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2802":58552,"_24443":58516,"_17120":100323,"_5":17015,"_23194":100247,"_2329":100324},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2802":58553,"_24443":58553,"_5":12033,"_2329":100326,"_24778":100327,"_17120":100328,"_23194":58553},"Emite y verifica un certificado",[39822,94885,44681,97757],[],{"_2802":58554,"_24443":58553,"_17120":100330,"_5":17015,"_23194":58553,"_2329":100331},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2802":58555,"_24443":58553,"_5":24775,"_17120":100333,"_23194":100334,"_2329":93586},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2802":58556,"_24443":58553,"_5":24775,"_17120":100336,"_23194":100337,"_2329":100338},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2802":58557,"_24443":58553,"_5":24775,"_17120":100340,"_23194":100341,"_2329":100342},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2802":58558,"_24443":58553,"_5":24775,"_17120":100344,"_23194":100345,"_2329":100346},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2802":58559,"_24443":58553,"_5":24775,"_17120":100348,"_23194":100349,"_2329":100350},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2802":58560,"_24443":58553,"_5":24775,"_17120":100352,"_23194":100353,"_2329":100354},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2802":58561,"_24443":58553,"_5":24775,"_17120":100356,"_23194":100357,"_2329":100237},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2802":58562,"_24443":58553,"_5":24775,"_17120":100359,"_23194":100360,"_2329":100361},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2802":58563,"_24443":58553,"_5":24775,"_17120":100363,"_23194":100364,"_2329":100365},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2802":58564,"_24443":58553,"_5":24775,"_17120":100367,"_23194":100368,"_2329":100369},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2802":58565,"_24443":58553,"_5":24775,"_17120":100371,"_23194":100372,"_2329":98005},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2802":58566,"_24443":58553,"_5":24775,"_17120":100374,"_23194":100375,"_2329":93610},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2802":58567,"_24443":58553,"_17120":100377,"_5":17015,"_23194":58553,"_2329":100378},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2802":58568,"_24443":58553,"_17120":100380,"_5":17015,"_23194":100334,"_2329":100381},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2802":58569,"_24443":58553,"_17120":100383,"_5":17015,"_23194":100334,"_2329":100384},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2802":58570,"_24443":58553,"_17120":100386,"_5":17015,"_23194":100334,"_2329":100387},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2802":58571,"_24443":58553,"_17120":100389,"_5":17015,"_23194":100334,"_2329":100390},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2802":58572,"_24443":58553,"_17120":100392,"_5":17015,"_23194":100334,"_2329":100393},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2802":58573,"_24443":58553,"_17120":100395,"_5":17015,"_23194":100337,"_2329":100396},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2802":58574,"_24443":58553,"_17120":100398,"_5":17015,"_23194":100341,"_2329":100399},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2802":58575,"_24443":58553,"_17120":100401,"_5":17015,"_23194":100341,"_2329":100402},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2802":58576,"_24443":58553,"_17120":100404,"_5":17015,"_23194":100345,"_2329":100405},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2802":58577,"_24443":58553,"_17120":100407,"_5":17015,"_23194":100345,"_2329":100408},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2802":58578,"_24443":58553,"_17120":100410,"_5":17015,"_23194":100349,"_2329":100411},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2802":58579,"_24443":58553,"_17120":100413,"_5":17015,"_23194":100349,"_2329":100414},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2802":58580,"_24443":58553,"_17120":100416,"_5":17015,"_23194":100353,"_2329":100417},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2802":58581,"_24443":58553,"_17120":100419,"_5":17015,"_23194":100357,"_2329":100420},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2802":58582,"_24443":58553,"_17120":100422,"_5":17015,"_23194":100360,"_2329":100423},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2802":58583,"_24443":58553,"_17120":100425,"_5":17015,"_23194":100364,"_2329":100426},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2802":58584,"_24443":58553,"_17120":100428,"_5":17015,"_23194":100364,"_2329":100429},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2802":58585,"_24443":58553,"_17120":100431,"_5":17015,"_23194":100364,"_2329":100432},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2802":58586,"_24443":58553,"_17120":100434,"_5":17015,"_23194":100368,"_2329":100435},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2802":58587,"_24443":58553,"_17120":100437,"_5":17015,"_23194":100368,"_2329":100438},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2802":58588,"_24443":58553,"_17120":100440,"_5":17015,"_23194":100368,"_2329":100441},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2802":58589,"_24443":58553,"_17120":100443,"_5":17015,"_23194":100372,"_2329":98088},[],{"_2802":58590,"_24443":58553,"_17120":100445,"_5":17015,"_23194":100372,"_2329":96892},[],{"_2802":58591,"_24443":58553,"_17120":100447,"_5":17015,"_23194":100372,"_2329":100448},[],"La CA rechaza la emisión",{"_2802":58592,"_24443":58553,"_17120":100450,"_5":17015,"_23194":100372,"_2329":100451},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2802":58593,"_24443":58553,"_17120":100453,"_5":17015,"_23194":100372,"_2329":100454},[],"Sujeto o usos diferentes",{"_2802":58594,"_24443":58553,"_17120":100456,"_5":17015,"_23194":100372,"_2329":100457},[],"Perfil aplicado y valores solicitados.",{"_2802":58595,"_24443":58553,"_17120":100459,"_5":17015,"_23194":100372,"_2329":100460},[],"No se encuentra el emisor",{"_2802":58596,"_24443":58553,"_17120":100462,"_5":17015,"_23194":100372,"_2329":100463},[],"CA descargada y cadena intermedia necesaria.",{"_2802":58597,"_24443":58553,"_17120":100465,"_5":17015,"_23194":100372,"_2329":100466},[],"Falla la vigencia",{"_2802":58598,"_24443":58553,"_17120":100468,"_5":17015,"_23194":100372,"_2329":100469},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2802":58599,"_24443":58553,"_17120":100471,"_5":17015,"_23194":100372,"_2329":100472},[],"Los resúmenes de clave difieren",{"_2802":58600,"_24443":58553,"_17120":100474,"_5":17015,"_23194":100372,"_2329":100475},[],"Archivos de certificado y clave de la misma emisión.",{"_2802":58601,"_24443":58553,"_17120":100477,"_5":17015,"_23194":100372,"_2329":100478},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2802":58602,"_24443":58553,"_17120":100480,"_5":17015,"_23194":100375,"_2329":100481},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2802":58603,"_24443":58553,"_17120":100483,"_5":17015,"_23194":100375,"_2329":100484},[],"Gestionar certificados para inspección, estado y revocación.",{"_2802":58604,"_24443":58553,"_17120":100486,"_5":17015,"_23194":100375,"_2329":100487},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2802":58605,"_24443":58553,"_17120":100489,"_5":17015,"_23194":100375,"_2329":100490},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2802":58606,"_24443":58553,"_17120":100492,"_5":17015,"_23194":100375,"_2329":100493},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2802":58607,"_24443":58607,"_5":12033,"_2329":100495,"_24778":100496,"_17120":100497,"_23194":58607},"Primeros pasos de PKI",[39822,94885,44681,97757],[],{"_2802":58608,"_24443":58607,"_17120":100499,"_5":17015,"_23194":58607,"_2329":100500},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2802":58609,"_24443":58607,"_5":24775,"_17120":100502,"_23194":100503,"_2329":93586},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2802":58610,"_24443":58607,"_5":24775,"_17120":100505,"_23194":100506,"_2329":100507},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2802":58611,"_24443":58607,"_5":24775,"_17120":100509,"_23194":100510,"_2329":97939},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2802":58612,"_24443":58607,"_5":24775,"_17120":100512,"_23194":100513,"_2329":100514},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2802":58613,"_24443":58607,"_17120":100516,"_5":17015,"_23194":58607,"_2329":100517},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2802":58614,"_24443":58607,"_17120":100519,"_5":17015,"_23194":100503,"_2329":100520},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2802":58615,"_24443":58607,"_17120":100522,"_5":17015,"_23194":100503,"_2329":100523},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2802":58616,"_24443":58607,"_17120":100525,"_5":17015,"_23194":100503,"_2329":100526},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2802":58617,"_24443":58607,"_17120":100528,"_5":17015,"_23194":100503,"_2329":100529},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2802":58618,"_24443":58607,"_17120":100531,"_5":17015,"_23194":100503,"_2329":100532},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2802":58619,"_24443":58607,"_17120":100534,"_5":17015,"_23194":100506,"_2329":100535},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2802":58620,"_24443":58607,"_17120":100537,"_5":17015,"_23194":100506,"_2329":100538},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2802":58621,"_24443":58607,"_17120":100540,"_5":17015,"_23194":100506,"_2329":100541},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2802":58622,"_24443":58607,"_17120":100543,"_5":17015,"_23194":100506,"_2329":100544},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2802":58623,"_24443":58607,"_17120":100546,"_5":17015,"_23194":100510,"_2329":100547},[],"Archivo o recurso",{"_2802":58624,"_24443":58607,"_17120":100549,"_5":17015,"_23194":100510,"_2329":97936},[],{"_2802":58625,"_24443":58607,"_17120":100551,"_5":17015,"_23194":100510,"_2329":100552},[],"CA raíz activa y `ca.pem`",{"_2802":58626,"_24443":58607,"_17120":100554,"_5":17015,"_23194":100510,"_2329":100555},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2802":58627,"_24443":58607,"_17120":100557,"_5":17015,"_23194":100510,"_2329":100558},[],"Certificado final y `device.crt`",{"_2802":58628,"_24443":58607,"_17120":100560,"_5":17015,"_23194":100510,"_2329":100561},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2802":58629,"_24443":58607,"_17120":100563,"_5":17015,"_23194":100510,"_2329":100564},[],"Clave privada `device.key`",{"_2802":58630,"_24443":58607,"_17120":100566,"_5":17015,"_23194":100510,"_2329":100567},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2802":58631,"_24443":58607,"_17120":100569,"_5":17015,"_23194":100510,"_2329":100570},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2802":58632,"_24443":58607,"_17120":100572,"_5":17015,"_23194":100513,"_2329":100573},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2802":58633,"_24443":58607,"_17120":100575,"_5":17015,"_23194":100513,"_2329":100576},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2802":58634,"_24443":58607,"_17120":100578,"_5":17015,"_23194":100513,"_2329":100579},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2802":58635,"_24443":58635,"_5":12033,"_2329":100581,"_24778":100582,"_17120":100584,"_23194":58635},"Resolución de problemas PKI",[39822,94885,44681,100583],"Resolución de problemas",[],{"_2802":58636,"_24443":58635,"_17120":100586,"_5":17015,"_23194":58635,"_2329":100587},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2802":58637,"_24443":58635,"_5":24775,"_17120":100589,"_23194":100590,"_2329":100591},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2802":58638,"_24443":58635,"_5":24775,"_17120":100593,"_23194":100594,"_2329":100595},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2802":58639,"_24443":58635,"_5":24775,"_17120":100597,"_23194":100598,"_2329":100599},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2802":58640,"_24443":58635,"_17120":100601,"_5":17015,"_23194":58635,"_2329":100602},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2802":58641,"_24443":58635,"_17120":100604,"_5":17015,"_23194":58635,"_2329":100605},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2802":58642,"_24443":58635,"_17120":100607,"_5":17015,"_23194":100590,"_2329":97936},[],{"_2802":58643,"_24443":58635,"_17120":100609,"_5":17015,"_23194":100590,"_2329":96892},[],{"_2802":58644,"_24443":58635,"_17120":100611,"_5":17015,"_23194":100590,"_2329":93610},[],{"_2802":58645,"_24443":58635,"_17120":100613,"_5":17015,"_23194":100590,"_2329":47016},[],{"_2802":58646,"_24443":58635,"_17120":100615,"_5":17015,"_23194":100590,"_2329":100616},[],"Existe, está activa y sus fechas son utilizables.",{"_2802":58647,"_24443":58635,"_17120":100618,"_5":17015,"_23194":100590,"_2329":100619},[],"Autoridades.",{"_2802":58648,"_24443":58635,"_17120":100621,"_5":17015,"_23194":100590,"_2329":100622},[],"Clave",{"_2802":58649,"_24443":58635,"_17120":100624,"_5":17015,"_23194":100590,"_2329":100625},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2802":58650,"_24443":58635,"_17120":100627,"_5":17015,"_23194":100590,"_2329":100628},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2802":58651,"_24443":58635,"_17120":100630,"_5":17015,"_23194":100590,"_2329":47034},[],{"_2802":58652,"_24443":58635,"_17120":100632,"_5":17015,"_23194":100590,"_2329":100633},[],"PEM correcto y firma verificable.",{"_2802":58653,"_24443":58635,"_17120":100635,"_5":17015,"_23194":100590,"_2329":47040},[],{"_2802":58654,"_24443":58635,"_17120":100637,"_5":17015,"_23194":100590,"_2329":100638},[],"Perfil",{"_2802":58655,"_24443":58635,"_17120":100640,"_5":17015,"_23194":100590,"_2329":100641},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2802":58656,"_24443":58635,"_17120":100643,"_5":17015,"_23194":100590,"_2329":100644},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2802":58657,"_24443":58635,"_17120":100646,"_5":17015,"_23194":100590,"_2329":98088},[],{"_2802":58658,"_24443":58635,"_17120":100648,"_5":17015,"_23194":100590,"_2329":100649},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2802":58659,"_24443":58635,"_17120":100651,"_5":17015,"_23194":100590,"_2329":100652},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2802":58660,"_24443":58635,"_17120":100654,"_5":17015,"_23194":100590,"_2329":100655},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2802":58661,"_24443":58635,"_17120":100657,"_5":17015,"_23194":100590,"_2329":100658},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2802":58662,"_24443":58635,"_17120":100660,"_5":17015,"_23194":100594,"_2329":100661},[],"Revisa cada frontera por separado:",{"_2802":58663,"_24443":58635,"_17120":100663,"_5":17015,"_23194":100594,"_2329":100664},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2802":58664,"_24443":58635,"_17120":100666,"_5":17015,"_23194":100594,"_2329":100667},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2802":58665,"_24443":58635,"_17120":100669,"_5":17015,"_23194":100594,"_2329":100670},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2802":58666,"_24443":58635,"_17120":100672,"_5":17015,"_23194":100594,"_2329":100673},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2802":58667,"_24443":58635,"_17120":100675,"_5":17015,"_23194":100594,"_2329":100676},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2802":58668,"_24443":58635,"_17120":100678,"_5":17015,"_23194":100594,"_2329":100679},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2802":58669,"_24443":58635,"_17120":100681,"_5":17015,"_23194":100598,"_2329":100682},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2802":58670,"_24443":58635,"_17120":100684,"_5":17015,"_23194":100598,"_2329":100685},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_47094":100687,"_47096":100688,"_47098":100689,"_47100":100690,"_14888":2351,"_56355":2351},"spanish",[2329,24443,5,23194],{"_2329":20415,"_24443":20415,"_5":20415,"_23194":20415},{"_2329":100691,"_24443":103003,"_5":105315,"_23194":107627},{"_3756":100692,"_47104":100693,"_5":20415},{"_11778":7275,"_12121":2596,"_12128":6077,"_23689":3581,"_23277":4653,"_16243":7154,"_11799":2696,"_11806":6132,"_23651":6761,"_23996":3247,"_24006":3843,"_23664":3869,"_28217":16496,"_24017":6759,"_28222":5035,"_28225":24091,"_28228":8833,"_28231":3213,"_28234":7805,"_24318":5024,"_28239":2935,"_28241":19121,"_24354":11040,"_24308":14835,"_28245":12829,"_28248":6985,"_28250":6161,"_24035":16489,"_24313":4320,"_24372":6166,"_28255":5365,"_28257":15881,"_28259":3847,"_28261":4828,"_28263":19364,"_28265":2551,"_28267":5690,"_28269":4930,"_28271":2961,"_23702":5612,"_28274":5647,"_28276":2685,"_23696":8593,"_28279":4759,"_28281":22304,"_28283":5541,"_28286":4972,"_23732":2582,"_28290":9017,"_23642":6097,"_28293":2950,"_23669":12305,"_28296":13861,"_28298":3738,"_28301":6429,"_24349":2570,"_28304":4655,"_28306":9328,"_28309":6496,"_28311":4663,"_28313":4952,"_28315":6032,"_28317":9107,"_16246":5658,"_28320":4530,"_28322":6068,"_28324":8396,