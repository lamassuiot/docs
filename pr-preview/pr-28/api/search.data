02":89345,"_29904":89348,"_29906":89351,"_29908":89354,"_29910":89357,"_29912":89360,"_29914":89363,"_29916":89366,"_29918":89369,"_29920":89372,"_29922":89375,"_29924":89378,"_29926":89381,"_29928":89384,"_29930":89387,"_29932":89390,"_29934":89393,"_29936":89396,"_29938":89399,"_29940":89402,"_29942":89405,"_29944":89408,"_29946":89411,"_29948":89414,"_29950":89417,"_29952":89420,"_29954":89422,"_29956":89424,"_29958":89427,"_29960":89430,"_29962":89433,"_29964":89435,"_29966":89437,"_29968":89439,"_29970":89441},{"_2322":49290,"_22971":49290,"_5":10796,"_1911":83587,"_23246":83588,"_15675":83591,"_21706":49290},"Despliega desde AWS Marketplace",[35713,83589,83590],"Despliegue","Otros modelos",[],{"_2322":49291,"_22971":49290,"_15675":83593,"_5":15564,"_21706":49290,"_1911":83594},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2322":49292,"_22971":49290,"_5":23243,"_15675":83596,"_21706":83597,"_1911":83598},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2322":49293,"_22971":49290,"_5":23243,"_15675":83600,"_21706":83601,"_1911":83602},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2322":49294,"_22971":49290,"_5":23243,"_15675":83604,"_21706":83605,"_1911":83606},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2322":49295,"_22971":49290,"_5":23243,"_15675":83608,"_21706":83609,"_1911":83610},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2322":49296,"_22971":49290,"_5":23243,"_15675":83612,"_21706":83613,"_1911":83614},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2322":49297,"_22971":49290,"_5":23243,"_15675":83616,"_21706":83617,"_1911":83618},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2322":49298,"_22971":49290,"_5":23243,"_15675":83620,"_21706":83621,"_1911":83622},[],"/docs/pr-preview/pr-28/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2322":49299,"_22971":49290,"_15675":83624,"_5":15564,"_21706":49290,"_1911":83625},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2322":49300,"_22971":49290,"_15675":83627,"_5":15564,"_21706":83597,"_1911":83628},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2322":49301,"_22971":49290,"_15675":83630,"_5":15564,"_21706":83597,"_1911":83631},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2322":49302,"_22971":49290,"_15675":83633,"_5":15564,"_21706":83597,"_1911":83634},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2322":49303,"_22971":49290,"_15675":83636,"_5":15564,"_21706":83601,"_1911":83637},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2322":49304,"_22971":49290,"_15675":83639,"_5":15564,"_21706":83601,"_1911":83640},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2322":49305,"_22971":49290,"_15675":83642,"_5":15564,"_21706":83601,"_1911":83643},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2322":49306,"_22971":49290,"_15675":83645,"_5":15564,"_21706":83605,"_1911":83646},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2322":49307,"_22971":49290,"_15675":83648,"_5":15564,"_21706":83609,"_1911":83649},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2322":49308,"_22971":49290,"_15675":83651,"_5":15564,"_21706":83613,"_1911":83652},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2322":49309,"_22971":49290,"_15675":83654,"_5":15564,"_21706":83617,"_1911":83655},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2322":49310,"_22971":49290,"_15675":83657,"_5":15564,"_21706":83621,"_1911":83658},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2322":49311,"_22971":49311,"_5":10796,"_1911":83660,"_23246":83661,"_15675":83662,"_21706":49311},"Despliega Lamassu",[35713,83589],[],{"_2322":49312,"_22971":49311,"_15675":83664,"_5":15564,"_21706":49311,"_1911":83665},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2322":49313,"_22971":49311,"_5":23243,"_15675":83667,"_21706":83668,"_1911":83669},[],"/docs/pr-preview/pr-28/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2322":49314,"_22971":49311,"_5":23243,"_15675":83671,"_21706":83672,"_1911":83673},[],"/docs/pr-preview/pr-28/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2322":49315,"_22971":49311,"_5":23243,"_15675":83675,"_21706":83676,"_1911":83677},[],"/docs/pr-preview/pr-28/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2322":49316,"_22971":49311,"_15675":83679,"_5":15564,"_21706":49311,"_1911":83680},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2322":49317,"_22971":49311,"_15675":83682,"_5":15564,"_21706":83668,"_1911":83683},[],"Modelo",{"_2322":49318,"_22971":49311,"_15675":83685,"_5":15564,"_21706":83668,"_1911":83686},[],"Recomendado para",{"_2322":49319,"_22971":49311,"_15675":83688,"_5":15564,"_21706":83668,"_1911":83689},[],"Quién opera la infraestructura",{"_2322":49320,"_22971":49311,"_15675":83691,"_5":15564,"_21706":83668,"_1911":83692},[],"Punto de partida",{"_2322":49321,"_22971":49311,"_15675":83694,"_5":15564,"_21706":83668,"_1911":35820},[],{"_2322":49322,"_22971":49311,"_15675":83696,"_5":15564,"_21706":83668,"_1911":83697},[],"Producción, entornos regulados y despliegues personalizados",{"_2322":49323,"_22971":49311,"_15675":83699,"_5":15564,"_21706":83668,"_1911":83700},[],"Tu equipo",{"_2322":49324,"_22971":49311,"_15675":83702,"_5":15564,"_21706":83668,"_1911":83703},[],"Helm o Fastlane",{"_2322":49325,"_22971":49311,"_15675":83705,"_5":15564,"_21706":83668,"_1911":35832},[],{"_2322":49326,"_22971":49311,"_15675":83707,"_5":15564,"_21706":83668,"_1911":83708},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2322":49327,"_22971":49311,"_15675":83710,"_5":15564,"_21706":83668,"_1911":83700},[],{"_2322":49328,"_22971":49311,"_15675":83712,"_5":15564,"_21706":83668,"_1911":83713},[],"Imagen preconfigurada en EC2",{"_2322":49329,"_22971":49311,"_15675":83715,"_5":15564,"_21706":83668,"_1911":35843},[],{"_2322":49330,"_22971":49311,"_15675":83717,"_5":15564,"_21706":83668,"_1911":83718},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2322":49331,"_22971":49311,"_15675":83720,"_5":15564,"_21706":83668,"_1911":35849},[],{"_2322":49332,"_22971":49311,"_15675":83722,"_5":15564,"_21706":83668,"_1911":83723},[],"Suscripción gestionada",{"_2322":49333,"_22971":49311,"_15675":83725,"_5":15564,"_21706":83668,"_1911":83726},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2322":49334,"_22971":49311,"_15675":83728,"_5":15564,"_21706":83668,"_1911":83729},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2322":49335,"_22971":49311,"_15675":83731,"_5":15564,"_21706":83668,"_1911":83732},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2322":49336,"_22971":49311,"_15675":83734,"_5":15564,"_21706":83672,"_1911":83735},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2322":49337,"_22971":49311,"_15675":83737,"_5":15564,"_21706":83676,"_1911":83738},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2322":49338,"_22971":49338,"_5":10796,"_1911":83740,"_23246":83741,"_15675":83742,"_21706":49338},"Utiliza Lamassu como SaaS",[35713,83589,83590],[],{"_2322":49339,"_22971":49338,"_15675":83744,"_5":15564,"_21706":49338,"_1911":83745},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2322":49340,"_22971":49338,"_5":23243,"_15675":83747,"_21706":83748,"_1911":83749},[],"/docs/pr-preview/pr-28/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2322":49341,"_22971":49338,"_5":23243,"_15675":83751,"_21706":83752,"_1911":83753},[],"/docs/pr-preview/pr-28/es/deployment/saas#planes","Planes",{"_2322":49342,"_22971":49338,"_5":23243,"_15675":83755,"_21706":83756,"_1911":83757},[],"/docs/pr-preview/pr-28/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2322":49343,"_22971":49338,"_15675":83759,"_5":15564,"_21706":49338,"_1911":83760},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2322":49344,"_22971":49338,"_15675":83762,"_5":15564,"_21706":83748,"_1911":83763},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2322":49345,"_22971":49338,"_15675":83765,"_5":15564,"_21706":83748,"_1911":83766},[],"Copias de seguridad automáticas.",{"_2322":49346,"_22971":49338,"_15675":83768,"_5":15564,"_21706":83748,"_1911":83769},[],"Actualizaciones de versión.",{"_2322":49347,"_22971":49338,"_15675":83771,"_5":15564,"_21706":83748,"_1911":83772},[],"Soporte técnico y SLA según el plan contratado.",{"_2322":49348,"_22971":49338,"_15675":83774,"_5":15564,"_21706":83752,"_1911":35904},[],{"_2322":49349,"_22971":49338,"_15675":83776,"_5":15564,"_21706":83752,"_1911":83777},[],"Dispositivos",{"_2322":49350,"_22971":49338,"_15675":83779,"_5":15564,"_21706":83752,"_1911":83780},[],"Soporte",{"_2322":49351,"_22971":49338,"_15675":83782,"_5":15564,"_21706":83752,"_1911":35913},[],{"_2322":49352,"_22971":49338,"_15675":83784,"_5":15564,"_21706":83752,"_1911":35916},[],{"_2322":49353,"_22971":49338,"_15675":83786,"_5":15564,"_21706":83752,"_1911":83787},[],"Hasta 1.000",{"_2322":49354,"_22971":49338,"_15675":83789,"_5":15564,"_21706":83752,"_1911":35922},[],{"_2322":49355,"_22971":49338,"_15675":83791,"_5":15564,"_21706":83752,"_1911":83792},[],"99,5 %",{"_2322":49356,"_22971":49338,"_15675":83794,"_5":15564,"_21706":83752,"_1911":35928},[],{"_2322":49357,"_22971":49338,"_15675":83796,"_5":15564,"_21706":83752,"_1911":83797},[],"Hasta 10.000",{"_2322":49358,"_22971":49338,"_15675":83799,"_5":15564,"_21706":83752,"_1911":83800},[],"Email y chat",{"_2322":49359,"_22971":49338,"_15675":83802,"_5":15564,"_21706":83752,"_1911":83803},[],"99,9 %",{"_2322":49360,"_22971":49338,"_15675":83805,"_5":15564,"_21706":83752,"_1911":35940},[],{"_2322":49361,"_22971":49338,"_15675":83807,"_5":15564,"_21706":83752,"_1911":83808},[],"Ilimitados",{"_2322":49362,"_22971":49338,"_15675":83810,"_5":15564,"_21706":83752,"_1911":83811},[],"Dedicado",{"_2322":49363,"_22971":49338,"_15675":83813,"_5":15564,"_21706":83752,"_1911":83814},[],"99,99 %",{"_2322":49364,"_22971":49338,"_15675":83816,"_5":15564,"_21706":83756,"_1911":83817},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2322":49365,"_22971":49338,"_15675":83819,"_5":15564,"_21706":83756,"_1911":83820},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2322":49366,"_22971":49366,"_5":10796,"_1911":35957,"_23246":83822,"_15675":83823,"_21706":49366},[35713,83589,35820],[],{"_2322":49367,"_22971":49366,"_15675":83825,"_5":15564,"_21706":49366,"_1911":83826},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2322":49368,"_22971":49366,"_5":23243,"_15675":83828,"_21706":83829,"_1911":83830},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2322":49369,"_22971":49366,"_5":23243,"_15675":83832,"_21706":83833,"_1911":83834},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2322":49370,"_22971":49366,"_5":23243,"_15675":83836,"_21706":83837,"_1911":83838},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2322":49371,"_22971":49366,"_5":23243,"_15675":83840,"_21706":83841,"_1911":83842},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2322":49372,"_22971":49366,"_5":23243,"_15675":83844,"_21706":83845,"_1911":83846},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2322":49373,"_22971":49366,"_5":23243,"_15675":83848,"_21706":83849,"_1911":83850},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2322":49374,"_22971":49366,"_5":23243,"_15675":83852,"_21706":83853,"_1911":83854},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2322":49375,"_22971":49366,"_5":23243,"_15675":83856,"_21706":83857,"_1911":83858},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2322":49376,"_22971":49366,"_5":23243,"_15675":83860,"_21706":83861,"_1911":83862},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2322":49377,"_22971":49366,"_5":23243,"_15675":83864,"_21706":83865,"_1911":83866},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2322":49378,"_22971":49366,"_15675":83868,"_5":15564,"_21706":83829,"_1911":83869},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2322":49379,"_22971":49366,"_15675":83871,"_5":15564,"_21706":83829,"_1911":83872},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2322":49380,"_22971":49366,"_15675":83874,"_5":15564,"_21706":83833,"_1911":83875},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2322":49381,"_22971":49366,"_15675":83877,"_5":15564,"_21706":83833,"_1911":83878},[],"Fastlane instala o configura",{"_2322":49382,"_22971":49366,"_15675":83880,"_5":15564,"_21706":83833,"_1911":83881},[],"Tú sigues proporcionando",{"_2322":49383,"_22971":49366,"_15675":83883,"_5":15564,"_21706":83833,"_1911":83884},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2322":49384,"_22971":49366,"_15675":83886,"_5":15564,"_21706":83833,"_1911":83887},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2322":49385,"_22971":49366,"_15675":83889,"_5":15564,"_21706":83833,"_1911":83890},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2322":49386,"_22971":49366,"_15675":83892,"_5":15564,"_21706":83833,"_1911":83893},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2322":49387,"_22971":49366,"_15675":83895,"_5":15564,"_21706":83833,"_1911":83896},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2322":49388,"_22971":49366,"_15675":83898,"_5":15564,"_21706":83833,"_1911":83899},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2322":49389,"_22971":49366,"_15675":83901,"_5":15564,"_21706":83833,"_1911":83902},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2322":49390,"_22971":49366,"_15675":83904,"_5":15564,"_21706":83833,"_1911":83905},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2322":49391,"_22971":49366,"_15675":83907,"_5":15564,"_21706":83833,"_1911":83908},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2322":49392,"_22971":49366,"_15675":83910,"_5":15564,"_21706":83837,"_1911":83911},[],"Necesitas:",{"_2322":49393,"_22971":49366,"_15675":83913,"_5":15564,"_21706":83837,"_1911":83914},[],"un clúster Kubernetes existente",{"_2322":49394,"_22971":49366,"_15675":83916,"_5":15564,"_21706":83837,"_1911":83917},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2322":49395,"_22971":49366,"_15675":83919,"_5":15564,"_21706":83837,"_1911":36055},[],{"_2322":49396,"_22971":49366,"_15675":83921,"_5":15564,"_21706":83837,"_1911":17845},[],{"_2322":49397,"_22971":49366,"_15675":83923,"_5":15564,"_21706":83837,"_1911":83924},[],"`jq` solo si usas `--sample-data`",{"_2322":49398,"_22971":49366,"_15675":83926,"_5":15564,"_21706":83837,"_1911":83927},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2322":49399,"_22971":49366,"_15675":83929,"_5":15564,"_21706":83837,"_1911":83930},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2322":49400,"_22971":49366,"_15675":83932,"_5":15564,"_21706":83837,"_1911":83933},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2322":49401,"_22971":49366,"_15675":83935,"_5":15564,"_21706":83841,"_1911":83936},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2322":49402,"_22971":49366,"_15675":83938,"_5":15564,"_21706":83841,"_1911":83939},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2322":49403,"_22971":49366,"_15675":83941,"_5":15564,"_21706":83845,"_1911":83942},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2322":49404,"_22971":49366,"_15675":83944,"_5":15564,"_21706":83845,"_1911":83945},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2322":49405,"_22971":49366,"_15675":83947,"_5":15564,"_21706":83845,"_1911":83948},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2322":49406,"_22971":49366,"_15675":83950,"_5":15564,"_21706":83845,"_1911":83951},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2322":49407,"_22971":49366,"_15675":83953,"_5":15564,"_21706":83849,"_1911":83954},[],"Opción",{"_2322":49408,"_22971":49366,"_15675":83956,"_5":15564,"_21706":83849,"_1911":83957},[],"Valor predeterminado",{"_2322":49409,"_22971":49366,"_15675":83959,"_5":15564,"_21706":83849,"_1911":83960},[],"Propósito",{"_2322":49410,"_22971":49366,"_15675":83962,"_5":15564,"_21706":83849,"_1911":36099},[],{"_2322":49411,"_22971":49366,"_15675":83964,"_5":15564,"_21706":83849,"_1911":36102},[],{"_2322":49412,"_22971":49366,"_15675":83966,"_5":15564,"_21706":83849,"_1911":83967},[],"Muestra la ayuda",{"_2322":49413,"_22971":49366,"_15675":83969,"_5":15564,"_21706":83849,"_1911":36108},[],{"_2322":49414,"_22971":49366,"_15675":83971,"_5":15564,"_21706":83849,"_1911":83972},[],"contexto actual",{"_2322":49415,"_22971":49366,"_15675":83974,"_5":15564,"_21706":83849,"_1911":83975},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2322":49416,"_22971":49366,"_15675":83977,"_5":15564,"_21706":83849,"_1911":36117},[],{"_2322":49417,"_22971":49366,"_15675":83979,"_5":15564,"_21706":83849,"_1911":4456},[],{"_2322":49418,"_22971":49366,"_15675":83981,"_5":15564,"_21706":83849,"_1911":83982},[],"Omite prompts y genera credenciales para las dependencias",{"_2322":49419,"_22971":49366,"_15675":83984,"_5":15564,"_21706":83849,"_1911":36125},[],{"_2322":49420,"_22971":49366,"_15675":83986,"_5":15564,"_21706":83849,"_1911":36128},[],{"_2322":49421,"_22971":49366,"_15675":83988,"_5":15564,"_21706":83849,"_1911":83989},[],"Namespace de la instalación",{"_2322":49422,"_22971":49366,"_15675":83991,"_5":15564,"_21706":83849,"_1911":36134},[],{"_2322":49423,"_22971":49366,"_15675":83993,"_5":15564,"_21706":83849,"_1911":36137},[],{"_2322":49424,"_22971":49366,"_15675":83995,"_5":15564,"_21706":83849,"_1911":83996},[],"Dominio usado por la UI, OIDC y el certificado",{"_2322":49425,"_22971":49366,"_15675":83998,"_5":15564,"_21706":83849,"_1911":36143},[],{"_2322":49426,"_22971":49366,"_15675":84000,"_5":15564,"_21706":83849,"_1911":11003},[],{"_2322":49427,"_22971":49366,"_15675":84002,"_5":15564,"_21706":83849,"_1911":84003},[],"Versión del chart de Lamassu",{"_2322":49428,"_22971":49366,"_15675":84005,"_5":15564,"_21706":83849,"_1911":36151},[],{"_2322":49429,"_22971":49366,"_15675":84007,"_5":15564,"_21706":83849,"_1911":36154},[],{"_2322":49430,"_22971":49366,"_15675":84009,"_5":15564,"_21706":83849,"_1911":84010},[],"Puerto del listener HTTPS",{"_2322":49431,"_22971":49366,"_15675":84012,"_5":15564,"_21706":83849,"_1911":36160},[],{"_2322":49432,"_22971":49366,"_15675":84014,"_5":15564,"_21706":83849,"_1911":36163},[],{"_2322":49433,"_22971":49366,"_15675":84016,"_5":15564,"_21706":83849,"_1911":84017},[],"Puerto del listener HTTP",{"_2322":49434,"_22971":49366,"_15675":84019,"_5":15564,"_21706":83849,"_1911":36169},[],{"_2322":49435,"_22971":49366,"_15675":84021,"_5":15564,"_21706":83849,"_1911":36102},[],{"_2322":49436,"_22971":49366,"_15675":84023,"_5":15564,"_21706":83849,"_1911":84024},[],"Certificado PEM para TLS downstream",{"_2322":49437,"_22971":49366,"_15675":84026,"_5":15564,"_21706":83849,"_1911":36177},[],{"_2322":49438,"_22971":49366,"_15675":84028,"_5":15564,"_21706":83849,"_1911":36102},[],{"_2322":49439,"_22971":49366,"_15675":84030,"_5":15564,"_21706":83849,"_1911":84031},[],"Clave privada PEM para TLS downstream",{"_2322":49440,"_22971":49366,"_15675":84033,"_5":15564,"_21706":83849,"_1911":36185},[],{"_2322":49441,"_22971":49366,"_15675":84035,"_5":15564,"_21706":83849,"_1911":84036},[],"chart del repositorio",{"_2322":49442,"_22971":49366,"_15675":84038,"_5":15564,"_21706":83849,"_1911":84039},[],"Usa un chart local de Lamassu sin empaquetar",{"_2322":49443,"_22971":49366,"_15675":84041,"_5":15564,"_21706":83849,"_1911":36194},[],{"_2322":49444,"_22971":49366,"_15675":84043,"_5":15564,"_21706":83849,"_1911":84044},[],"detección automática",{"_2322":49445,"_22971":49366,"_15675":84046,"_5":15564,"_21706":83849,"_1911":84047},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2322":49446,"_22971":49366,"_15675":84049,"_5":15564,"_21706":83849,"_1911":36202},[],{"_2322":49447,"_22971":49366,"_15675":84051,"_5":15564,"_21706":83849,"_1911":4456},[],{"_2322":49448,"_22971":49366,"_15675":84053,"_5":15564,"_21706":83849,"_1911":84054},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2322":49449,"_22971":49366,"_15675":84056,"_5":15564,"_21706":83849,"_1911":36210},[],{"_2322":49450,"_22971":49366,"_15675":84058,"_5":15564,"_21706":83849,"_1911":4456},[],{"_2322":49451,"_22971":49366,"_15675":84060,"_5":15564,"_21706":83849,"_1911":84061},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2322":49452,"_22971":49366,"_15675":84063,"_5":15564,"_21706":83849,"_1911":36218},[],{"_2322":49453,"_22971":49366,"_15675":84065,"_5":15564,"_21706":83849,"_1911":4456},[],{"_2322":49454,"_22971":49366,"_15675":84067,"_5":15564,"_21706":83849,"_1911":84068},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2322":49455,"_22971":49366,"_15675":84070,"_5":15564,"_21706":83849,"_1911":36226},[],{"_2322":49456,"_22971":49366,"_15675":84072,"_5":15564,"_21706":83849,"_1911":36229},[],{"_2322":49457,"_22971":49366,"_15675":84074,"_5":15564,"_21706":83849,"_1911":84075},[],"Usa otro chart local de SoftHSM",{"_2322":49458,"_22971":49366,"_15675":84077,"_5":15564,"_21706":83849,"_1911":84078},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2322":49459,"_22971":49366,"_15675":84080,"_5":15564,"_21706":83853,"_1911":36238},[],{"_2322":49460,"_22971":49366,"_15675":84082,"_5":15564,"_21706":83853,"_1911":84083},[],"valida las herramientas locales y el clúster seleccionado",{"_2322":49461,"_22971":49366,"_15675":84085,"_5":15564,"_21706":83853,"_1911":84086},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2322":49462,"_22971":49366,"_15675":84088,"_5":15564,"_21706":83853,"_1911":84089},[],"crea el namespace",{"_2322":49463,"_22971":49366,"_15675":84091,"_5":15564,"_21706":83853,"_1911":84092},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2322":49464,"_22971":49366,"_15675":84094,"_5":15564,"_21706":83853,"_1911":84095},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2322":49465,"_22971":49366,"_15675":84097,"_5":15564,"_21706":83853,"_1911":84098},[],"instala RabbitMQ",{"_2322":49466,"_22971":49366,"_15675":84100,"_5":15564,"_21706":83853,"_1911":84101},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2322":49467,"_22971":49366,"_15675":84103,"_5":15564,"_21706":83853,"_1911":84104},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2322":49468,"_22971":49366,"_15675":84106,"_5":15564,"_21706":83853,"_1911":84107},[],"carga datos de ejemplo opcionalmente",{"_2322":49469,"_22971":49366,"_15675":84109,"_5":15564,"_21706":83853,"_1911":84110},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2322":49470,"_22971":49366,"_15675":84112,"_5":15564,"_21706":83857,"_1911":84113},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2322":49471,"_22971":49366,"_15675":84115,"_5":15564,"_21706":83857,"_1911":84116},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2322":49472,"_22971":49366,"_15675":84118,"_5":15564,"_21706":83861,"_1911":84119},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2322":49473,"_22971":49366,"_15675":84121,"_5":15564,"_21706":83861,"_1911":84122},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2322":49474,"_22971":49366,"_15675":84124,"_5":15564,"_21706":83861,"_1911":84125},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2322":49475,"_22971":49366,"_15675":84127,"_5":15564,"_21706":83865,"_1911":84128},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2322":49476,"_22971":49476,"_5":10796,"_1911":84130,"_23246":84131,"_15675":84132,"_21706":49476},"Instala con Helm",[35713,83589,35820],[],{"_2322":49477,"_22971":49476,"_15675":84134,"_5":15564,"_21706":49476,"_1911":84135},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2322":49478,"_22971":49476,"_5":23243,"_15675":84137,"_21706":84138,"_1911":84139},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2322":49479,"_22971":49476,"_5":23243,"_15675":84141,"_21706":84142,"_1911":83838},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2322":49480,"_22971":49476,"_5":23243,"_15675":84144,"_21706":84145,"_1911":84146},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2322":49481,"_22971":49476,"_5":23243,"_15675":84148,"_21706":84149,"_1911":84150},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2322":49482,"_22971":49476,"_5":23243,"_15675":84152,"_21706":84153,"_1911":84154},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2322":49483,"_22971":49476,"_5":23243,"_15675":84156,"_21706":84157,"_1911":84158},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2322":49484,"_22971":49476,"_5":23243,"_15675":84160,"_21706":84161,"_1911":84162},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2322":49485,"_22971":49476,"_5":23243,"_15675":84164,"_21706":84165,"_1911":84166},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2322":49486,"_22971":49476,"_5":23243,"_15675":84168,"_21706":84169,"_1911":84170},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2322":49487,"_22971":49476,"_15675":84172,"_5":15564,"_21706":84138,"_1911":84173},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2322":49488,"_22971":49476,"_15675":84175,"_5":15564,"_21706":84142,"_1911":84176},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2322":49489,"_22971":49476,"_15675":84178,"_5":15564,"_21706":84142,"_1911":84179},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2322":49490,"_22971":49476,"_15675":84181,"_5":15564,"_21706":84142,"_1911":84182},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2322":49491,"_22971":49476,"_15675":84184,"_5":15564,"_21706":84142,"_1911":84185},[],"un broker RabbitMQ accesible y sus credenciales",{"_2322":49492,"_22971":49476,"_15675":84187,"_5":15564,"_21706":84142,"_1911":84188},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2322":49493,"_22971":49476,"_15675":84190,"_5":15564,"_21706":84142,"_1911":84191},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2322":49494,"_22971":49476,"_15675":84193,"_5":15564,"_21706":84142,"_1911":84194},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2322":49495,"_22971":49476,"_15675":84196,"_5":15564,"_21706":84142,"_1911":84197},[],"una StorageClass y un diseño de tráfico externo",{"_2322":49496,"_22971":49476,"_15675":84199,"_5":15564,"_21706":84142,"_1911":84200},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2322":49497,"_22971":49476,"_15675":84202,"_5":15564,"_21706":84142,"_1911":84203},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2322":49498,"_22971":49476,"_15675":84205,"_5":15564,"_21706":84142,"_1911":84206},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2322":49499,"_22971":49476,"_15675":84208,"_5":15564,"_21706":84145,"_1911":84209},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2322":49500,"_22971":49476,"_15675":84211,"_5":15564,"_21706":84145,"_1911":84212},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2322":49501,"_22971":49476,"_15675":84214,"_5":15564,"_21706":84145,"_1911":84215},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2322":49502,"_22971":49476,"_15675":84217,"_5":15564,"_21706":84149,"_1911":84218},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2322":49503,"_22971":49476,"_15675":84220,"_5":15564,"_21706":84149,"_1911":84221},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2322":49504,"_22971":49476,"_15675":84223,"_5":15564,"_21706":84149,"_1911":84224},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2322":49505,"_22971":49476,"_15675":84226,"_5":15564,"_21706":84153,"_1911":84227},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2322":49506,"_22971":49476,"_15675":84229,"_5":15564,"_21706":84157,"_1911":84230},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2322":49507,"_22971":49476,"_15675":84232,"_5":15564,"_21706":84157,"_1911":84233},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2322":49508,"_22971":49476,"_15675":84235,"_5":15564,"_21706":84157,"_1911":84236},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2322":49509,"_22971":49476,"_15675":84238,"_5":15564,"_21706":84157,"_1911":84239},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2322":49510,"_22971":49476,"_15675":84241,"_5":15564,"_21706":84161,"_1911":84242},[],"Para instalar un checkout local:",{"_2322":49511,"_22971":49476,"_15675":84244,"_5":15564,"_21706":84165,"_1911":84245},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2322":49512,"_22971":49476,"_15675":84247,"_5":15564,"_21706":84165,"_1911":84248},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2322":49513,"_22971":49476,"_15675":84250,"_5":15564,"_21706":84169,"_1911":84251},[],"Antes de pasar a producción, revisa:",{"_2322":49514,"_22971":49476,"_15675":84253,"_5":15564,"_21706":84169,"_1911":84254},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2322":49515,"_22971":49476,"_15675":84256,"_5":15564,"_21706":84169,"_1911":84257},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2322":49516,"_22971":49476,"_15675":84259,"_5":15564,"_21706":84169,"_1911":84260},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2322":49517,"_22971":49476,"_15675":84262,"_5":15564,"_21706":84169,"_1911":84263},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2322":49518,"_22971":49476,"_15675":84265,"_5":15564,"_21706":84169,"_1911":84266},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2322":49519,"_22971":49476,"_15675":84268,"_5":15564,"_21706":84169,"_1911":84269},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2322":49520,"_22971":49476,"_15675":84271,"_5":15564,"_21706":84169,"_1911":84272},[],"SMTP, observabilidad y entrega de alertas",{"_2322":49521,"_22971":49476,"_15675":84274,"_5":15564,"_21706":84169,"_1911":84275},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2322":49522,"_22971":49476,"_15675":84277,"_5":15564,"_21706":84169,"_1911":84278},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2322":49523,"_22971":49523,"_5":10796,"_1911":84280,"_23246":84281,"_15675":84282,"_21706":49523},"Expón el Gateway",[35713,83589,35820],[],{"_2322":49524,"_22971":49523,"_15675":84284,"_5":15564,"_21706":49523,"_1911":84285},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2322":49525,"_22971":49523,"_5":23243,"_15675":84287,"_21706":84288,"_1911":84289},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2322":49526,"_22971":49523,"_5":23243,"_15675":84291,"_21706":84292,"_1911":84293},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2322":49527,"_22971":49523,"_5":23243,"_15675":84295,"_21706":84296,"_1911":84297},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2322":49528,"_22971":49523,"_5":23243,"_15675":84299,"_21706":84300,"_1911":36459},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#k3s",{"_2322":49529,"_22971":49523,"_5":23243,"_15675":84302,"_21706":84303,"_1911":84304},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2322":49530,"_22971":49523,"_5":23243,"_15675":84306,"_21706":84307,"_1911":84308},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2322":49531,"_22971":49523,"_5":23243,"_15675":84310,"_21706":84311,"_1911":84312},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2322":49532,"_22971":49523,"_5":23243,"_15675":84314,"_21706":84315,"_1911":84316},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2322":49533,"_22971":49523,"_5":23243,"_15675":84318,"_21706":84319,"_1911":84320},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2322":49534,"_22971":49523,"_15675":84322,"_5":15564,"_21706":84288,"_1911":84323},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2322":49535,"_22971":49523,"_15675":84325,"_5":15564,"_21706":84288,"_1911":84326},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2322":49536,"_22971":49523,"_15675":84328,"_5":15564,"_21706":84292,"_1911":84329},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2322":49537,"_22971":49523,"_15675":84331,"_5":15564,"_21706":84292,"_1911":84332},[],"Defínelo únicamente cuando:",{"_2322":49538,"_22971":49523,"_15675":84334,"_5":15564,"_21706":84292,"_1911":84335},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2322":49539,"_22971":49523,"_15675":84337,"_5":15564,"_21706":84292,"_1911":84338},[],"esa dirección está asignada a este Gateway",{"_2322":49540,"_22971":49523,"_15675":84340,"_5":15564,"_21706":84292,"_1911":84341},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2322":49541,"_22971":49523,"_15675":84343,"_5":15564,"_21706":84292,"_1911":84344},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2322":49542,"_22971":49523,"_15675":84346,"_5":15564,"_21706":84292,"_1911":84347},[],"No confundas estos valores:",{"_2322":49543,"_22971":49523,"_15675":84349,"_5":15564,"_21706":84292,"_1911":84350},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2322":49544,"_22971":49523,"_15675":84352,"_5":15564,"_21706":84292,"_1911":84353},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2322":49545,"_22971":49523,"_15675":84355,"_5":15564,"_21706":84292,"_1911":84356},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2322":49546,"_22971":49523,"_15675":84358,"_5":15564,"_21706":84296,"_1911":84359},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2322":49547,"_22971":49523,"_15675":84361,"_5":15564,"_21706":84296,"_1911":84362},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2322":49548,"_22971":49523,"_15675":84364,"_5":15564,"_21706":84300,"_1911":84365},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2322":49549,"_22971":49523,"_15675":84367,"_5":15564,"_21706":84300,"_1911":84368},[],"Para el diseño recomendado:",{"_2322":49550,"_22971":49523,"_15675":84370,"_5":15564,"_21706":84300,"_1911":84371},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2322":49551,"_22971":49523,"_15675":84373,"_5":15564,"_21706":84300,"_1911":84374},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2322":49552,"_22971":49523,"_15675":84376,"_5":15564,"_21706":84300,"_1911":84377},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2322":49553,"_22971":49523,"_15675":84379,"_5":15564,"_21706":84300,"_1911":84380},[],"Apunta DNS a la dirección accesible de la VM.",{"_2322":49554,"_22971":49523,"_15675":84382,"_5":15564,"_21706":84300,"_1911":84383},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2322":49555,"_22971":49523,"_15675":84385,"_5":15564,"_21706":84303,"_1911":84386},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2322":49556,"_22971":49523,"_15675":84388,"_5":15564,"_21706":84307,"_1911":84389},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2322":49557,"_22971":49523,"_15675":84391,"_5":15564,"_21706":84307,"_1911":84392},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2322":49558,"_22971":49523,"_15675":84394,"_5":15564,"_21706":84311,"_1911":84395},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2322":49559,"_22971":49523,"_15675":84397,"_5":15564,"_21706":84311,"_1911":84398},[],"Requisito",{"_2322":49560,"_22971":49523,"_15675":84400,"_5":15564,"_21706":84311,"_1911":84401},[],"Diseño recomendado",{"_2322":49561,"_22971":49523,"_15675":84403,"_5":15564,"_21706":84311,"_1911":84404},[],"Consecuencia",{"_2322":49562,"_22971":49523,"_15675":84406,"_5":15564,"_21706":84311,"_1911":84407},[],"Varias URL o servicios de Lamassu",{"_2322":49563,"_22971":49523,"_15675":84409,"_5":15564,"_21706":84311,"_1911":84410},[],"Un Gateway con varias rutas",{"_2322":49564,"_22971":49523,"_15675":84412,"_5":15564,"_21706":84311,"_1911":84413},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2322":49565,"_22971":49523,"_15675":84415,"_5":15564,"_21706":84311,"_1911":84416},[],"Gateways independientes e IP externas distintas",{"_2322":49566,"_22971":49523,"_15675":84418,"_5":15564,"_21706":84311,"_1911":84419},[],"Una VIP por Gateway",{"_2322":49567,"_22971":49523,"_15675":84421,"_5":15564,"_21706":84311,"_1911":84422},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2322":49568,"_22971":49523,"_15675":84424,"_5":15564,"_21706":84311,"_1911":84425},[],"Gateways independientes, un nodo y una IP",{"_2322":49569,"_22971":49523,"_15675":84427,"_5":15564,"_21706":84311,"_1911":84428},[],"Puertos externos diferentes",{"_2322":49570,"_22971":49523,"_15675":84430,"_5":15564,"_21706":84311,"_1911":84431},[],"Los clientes deben indicar puertos no estándar",{"_2322":49571,"_22971":49523,"_15675":84433,"_5":15564,"_21706":84311,"_1911":84434},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2322":49572,"_22971":49523,"_15675":84436,"_5":15564,"_21706":84311,"_1911":84437},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2322":49573,"_22971":49523,"_15675":84439,"_5":15564,"_21706":84311,"_1911":84440},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2322":49574,"_22971":49523,"_15675":84442,"_5":15564,"_21706":84311,"_1911":84443},[],"Recursos Gateway separados pero proxy compartido",{"_2322":49575,"_22971":49523,"_15675":84445,"_5":15564,"_21706":84311,"_1911":84446},[],"Modo merged Gateway de Envoy",{"_2322":49576,"_22971":49523,"_15675":84448,"_5":15564,"_21706":84311,"_1911":84449},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2322":49577,"_22971":49523,"_15675":84451,"_5":15564,"_21706":84311,"_1911":84452},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2322":49578,"_22971":49523,"_15675":84454,"_5":15564,"_21706":84311,"_1911":84455},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2322":49579,"_22971":49523,"_15675":84457,"_5":15564,"_21706":84311,"_1911":84458},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2322":49580,"_22971":49523,"_15675":84460,"_5":15564,"_21706":84311,"_1911":84461},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2322":49581,"_22971":49523,"_15675":84463,"_5":15564,"_21706":84315,"_1911":84464},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2322":49582,"_22971":49523,"_15675":84466,"_5":15564,"_21706":84315,"_1911":84467},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2322":49583,"_22971":49523,"_15675":84469,"_5":15564,"_21706":84315,"_1911":84470},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2322":49584,"_22971":49523,"_15675":84472,"_5":15564,"_21706":84315,"_1911":84473},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2322":49585,"_22971":49523,"_15675":84475,"_5":15564,"_21706":84315,"_1911":84476},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2322":49586,"_22971":49523,"_15675":84478,"_5":15564,"_21706":84319,"_1911":84479},[],"Comprueba, en orden:",{"_2322":49587,"_22971":49523,"_15675":84481,"_5":15564,"_21706":84319,"_1911":84482},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2322":49588,"_22971":49523,"_15675":84484,"_5":15564,"_21706":84319,"_1911":84485},[],"Su estado contiene la dirección esperada.",{"_2322":49589,"_22971":49523,"_15675":84487,"_5":15564,"_21706":84319,"_1911":84488},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2322":49590,"_22971":49523,"_15675":84490,"_5":15564,"_21706":84319,"_1911":84491},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2322":49591,"_22971":49523,"_15675":84493,"_5":15564,"_21706":84319,"_1911":84494},[],"DNS resuelve al endpoint accesible externamente.",{"_2322":49592,"_22971":49523,"_15675":84496,"_5":15564,"_21706":84319,"_1911":84497},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2322":49593,"_22971":49523,"_15675":84499,"_5":15564,"_21706":84319,"_1911":84500},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2322":49594,"_22971":49594,"_5":10796,"_1911":35820,"_23246":84502,"_15675":84503,"_21706":49594},[35713,83589,35820],[],{"_2322":49595,"_22971":49594,"_15675":84505,"_5":15564,"_21706":49594,"_1911":84506},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2322":49596,"_22971":49594,"_5":23243,"_15675":84508,"_21706":84509,"_1911":84510},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2322":49597,"_22971":49594,"_5":23243,"_15675":84512,"_21706":84513,"_1911":84514},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2322":49598,"_22971":49594,"_5":23243,"_15675":84516,"_21706":84517,"_1911":84518},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2322":49599,"_22971":49594,"_5":23243,"_15675":84520,"_21706":84521,"_1911":84522},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2322":49600,"_22971":49594,"_5":23243,"_15675":84524,"_21706":84525,"_1911":84526},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2322":49601,"_22971":49594,"_5":23243,"_15675":84528,"_21706":84529,"_1911":84530},[],"/docs/pr-preview/pr-28/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2322":49602,"_22971":49594,"_15675":84532,"_5":15564,"_21706":84509,"_1911":84533},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2322":49603,"_22971":49594,"_15675":84535,"_5":15564,"_21706":84513,"_1911":84536},[],"Flujo",{"_2322":49604,"_22971":49594,"_15675":84538,"_5":15564,"_21706":84513,"_1911":84539},[],"Úsalo para",{"_2322":49605,"_22971":49594,"_15675":84541,"_5":15564,"_21706":84513,"_1911":84542},[],"Qué instala",{"_2322":49606,"_22971":49594,"_15675":84544,"_5":15564,"_21706":84513,"_1911":36704},[],{"_2322":49607,"_22971":49594,"_15675":84546,"_5":15564,"_21706":84513,"_1911":84547},[],"Producción y entornos controlados",{"_2322":49608,"_22971":49594,"_15675":84549,"_5":15564,"_21706":84513,"_1911":84550},[],"Servicios de Lamassu y recursos de Gateway API",{"_2322":49609,"_22971":49594,"_15675":84552,"_5":15564,"_21706":84513,"_1911":35957},[],{"_2322":49610,"_22971":49594,"_15675":84554,"_5":15564,"_21706":84513,"_1911":84555},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2322":49611,"_22971":49594,"_15675":84557,"_5":15564,"_21706":84513,"_1911":84558},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2322":49612,"_22971":49594,"_15675":84560,"_5":15564,"_21706":84517,"_1911":84561},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2322":49613,"_22971":49594,"_15675":84563,"_5":15564,"_21706":84517,"_1911":84564},[],"Área",{"_2322":49614,"_22971":49594,"_15675":84566,"_5":15564,"_21706":84517,"_1911":84567},[],"El chart de Lamassu proporciona",{"_2322":49615,"_22971":49594,"_15675":84569,"_5":15564,"_21706":84517,"_1911":84570},[],"Tú proporcionas",{"_2322":49616,"_22971":49594,"_15675":84572,"_5":15564,"_21706":84517,"_1911":84573},[],"Aplicaciones Lamassu",{"_2322":49617,"_22971":49594,"_15675":84575,"_5":15564,"_21706":84517,"_1911":84576},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2322":49618,"_22971":49594,"_15675":84578,"_5":15564,"_21706":84517,"_1911":84579},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2322":49619,"_22971":49594,"_15675":84581,"_5":15564,"_21706":84517,"_1911":84582},[],"Datos PostgreSQL",{"_2322":49620,"_22971":49594,"_15675":84584,"_5":15564,"_21706":84517,"_1911":84585},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2322":49621,"_22971":49594,"_15675":84587,"_5":15564,"_21706":84517,"_1911":84588},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2322":49622,"_22971":49594,"_15675":84590,"_5":15564,"_21706":84517,"_1911":84591},[],"Mensajería",{"_2322":49623,"_22971":49594,"_15675":84593,"_5":15564,"_21706":84517,"_1911":84594},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2322":49624,"_22971":49594,"_15675":84596,"_5":15564,"_21706":84517,"_1911":84597},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2322":49625,"_22971":49594,"_15675":84599,"_5":15564,"_21706":84517,"_1911":84600},[],"Identidad",{"_2322":49626,"_22971":49594,"_15675":84602,"_5":15564,"_21706":84517,"_1911":84603},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2322":49627,"_22971":49594,"_15675":84605,"_5":15564,"_21706":84517,"_1911":84606},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2322":49628,"_22971":49594,"_15675":84608,"_5":15564,"_21706":84517,"_1911":84609},[],"Enrutamiento externo",{"_2322":49629,"_22971":49594,"_15675":84611,"_5":15564,"_21706":84517,"_1911":84612},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2322":49630,"_22971":49594,"_15675":84614,"_5":15564,"_21706":84517,"_1911":84615},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2322":49631,"_22971":49594,"_15675":84617,"_5":15564,"_21706":84517,"_1911":36778},[],{"_2322":49632,"_22971":49594,"_15675":84619,"_5":15564,"_21706":84517,"_1911":84620},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2322":49633,"_22971":49594,"_15675":84622,"_5":15564,"_21706":84517,"_1911":84623},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2322":49634,"_22971":49594,"_15675":84625,"_5":15564,"_21706":84517,"_1911":84626},[],"Datos persistentes de la aplicación",{"_2322":49635,"_22971":49594,"_15675":84628,"_5":15564,"_21706":84517,"_1911":84629},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2322":49636,"_22971":49594,"_15675":84631,"_5":15564,"_21706":84517,"_1911":84632},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2322":49637,"_22971":49594,"_15675":84634,"_5":15564,"_21706":84517,"_1911":84635},[],"Integraciones opcionales",{"_2322":49638,"_22971":49594,"_15675":84637,"_5":15564,"_21706":84517,"_1911":84638},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2322":49639,"_22971":49594,"_15675":84640,"_5":15564,"_21706":84517,"_1911":84641},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2322":49640,"_22971":49594,"_15675":84643,"_5":15564,"_21706":84517,"_1911":84644},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2322":49641,"_22971":49594,"_15675":84646,"_5":15564,"_21706":84517,"_1911":84647},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2322":49642,"_22971":49594,"_15675":84649,"_5":15564,"_21706":84521,"_1911":84650},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2322":49643,"_22971":49594,"_15675":84652,"_5":15564,"_21706":84521,"_1911":84653},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2322":49644,"_22971":49594,"_15675":84655,"_5":15564,"_21706":84525,"_1911":84656},[],"Kubernetes 1.24 o posterior",{"_2322":49645,"_22971":49594,"_15675":84658,"_5":15564,"_21706":84525,"_1911":84659},[],"Helm 3.2 o posterior",{"_2322":49646,"_22971":49594,"_15675":84661,"_5":15564,"_21706":84525,"_1911":84662},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2322":49647,"_22971":49594,"_15675":84664,"_5":15564,"_21706":84525,"_1911":84665},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2322":49648,"_22971":49594,"_15675":84667,"_5":15564,"_21706":84525,"_1911":84668},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2322":49649,"_22971":49594,"_15675":84670,"_5":15564,"_21706":84525,"_1911":84671},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2322":49650,"_22971":49594,"_15675":84673,"_5":15564,"_21706":84525,"_1911":84674},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2322":49651,"_22971":49594,"_15675":84676,"_5":15564,"_21706":84529,"_1911":84677},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2322":49652,"_22971":49594,"_15675":84679,"_5":15564,"_21706":84529,"_1911":84680},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2322":49653,"_22971":49594,"_15675":84682,"_5":15564,"_21706":84529,"_1911":84683},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2322":49654,"_22971":49654,"_5":10796,"_1911":84685,"_23246":84686,"_15675":84689,"_21706":49654},"Control de acceso",[35713,84687,84688],"Plataforma","Administrar Lamassu",[],{"_2322":49655,"_22971":49654,"_15675":84691,"_5":15564,"_21706":49654,"_1911":84692},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2322":49656,"_22971":49654,"_5":23243,"_15675":84694,"_21706":84695,"_1911":84696},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#conceptos-esenciales","Conceptos esenciales",{"_2322":49657,"_22971":49654,"_5":23243,"_15675":84698,"_21706":84699,"_1911":84700},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2322":49658,"_22971":49654,"_5":23243,"_15675":84702,"_21706":84703,"_1911":84704},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2322":49659,"_22971":49654,"_5":23243,"_15675":84706,"_21706":84707,"_1911":84708},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2322":49660,"_22971":49654,"_5":23243,"_15675":84710,"_21706":84711,"_1911":84712},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2322":49661,"_22971":49654,"_5":23243,"_15675":84714,"_21706":84715,"_1911":84716},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2322":49662,"_22971":49654,"_5":23243,"_15675":84718,"_21706":84719,"_1911":84720},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-oidc","Principales OIDC",{"_2322":49663,"_22971":49654,"_5":23243,"_15675":84722,"_21706":84723,"_1911":84724},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#principales-x509","Principales X.509",{"_2322":49664,"_22971":49654,"_5":23243,"_15675":84726,"_21706":84727,"_1911":84728},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2322":49665,"_22971":49654,"_5":23243,"_15675":84730,"_21706":84731,"_1911":84732},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2322":49666,"_22971":49654,"_5":23243,"_15675":84734,"_21706":84735,"_1911":84736},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2322":49667,"_22971":49654,"_5":23243,"_15675":84738,"_21706":84739,"_1911":84740},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2322":49668,"_22971":49654,"_5":23243,"_15675":84742,"_21706":84743,"_1911":84744},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2322":49669,"_22971":49654,"_5":23243,"_15675":84746,"_21706":84747,"_1911":84748},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#reglas-http","Reglas HTTP",{"_2322":49670,"_22971":49654,"_5":23243,"_15675":84750,"_21706":84751,"_1911":84752},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#políticas-incluidas","Políticas incluidas",{"_2322":49671,"_22971":49654,"_5":23243,"_15675":84754,"_21706":84755,"_1911":84158},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#provisiona-el-primer-administrador",{"_2322":49672,"_22971":49654,"_5":23243,"_15675":84757,"_21706":84758,"_1911":84759},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2322":49673,"_22971":49654,"_5":23243,"_15675":84761,"_21706":84762,"_1911":84763},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2322":49674,"_22971":49654,"_5":23243,"_15675":84765,"_21706":84766,"_1911":84767},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2322":49675,"_22971":49654,"_5":23243,"_15675":84769,"_21706":84770,"_1911":84771},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2322":49676,"_22971":49654,"_5":23243,"_15675":84773,"_21706":84774,"_1911":84775},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2322":49677,"_22971":49654,"_5":23243,"_15675":84777,"_21706":84778,"_1911":84779},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2322":49678,"_22971":49654,"_5":23243,"_15675":84781,"_21706":84782,"_1911":84783},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2322":49679,"_22971":49654,"_5":23243,"_15675":84785,"_21706":84786,"_1911":84787},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2322":49680,"_22971":49654,"_5":23243,"_15675":84789,"_21706":84790,"_1911":84791},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2322":49681,"_22971":49654,"_5":23243,"_15675":84793,"_21706":84794,"_1911":84795},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#diagnóstico","Diagnóstico",{"_2322":49682,"_22971":49654,"_5":23243,"_15675":84797,"_21706":84798,"_1911":84799},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#la-respuesta-es-401","La respuesta es 401",{"_2322":49683,"_22971":49654,"_5":23243,"_15675":84801,"_21706":84802,"_1911":84803},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#la-respuesta-es-403","La respuesta es 403",{"_2322":49684,"_22971":49654,"_5":23243,"_15675":84805,"_21706":84806,"_1911":84807},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#todo-devuelve-403","Todo devuelve 403",{"_2322":49685,"_22971":49654,"_5":23243,"_15675":84809,"_21706":84810,"_1911":84811},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2322":49686,"_22971":49654,"_5":23243,"_15675":84813,"_21706":84814,"_1911":84815},[],"/docs/pr-preview/pr-28/es/platform/pki/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2322":49687,"_22971":49654,"_15675":84817,"_5":15564,"_21706":49654,"_1911":84818},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2322":49688,"_22971":49654,"_15675":84820,"_5":15564,"_21706":49654,"_1911":84821},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2322":49689,"_22971":49654,"_15675":84823,"_5":15564,"_21706":49654,"_1911":84824},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2322":49690,"_22971":49654,"_15675":84826,"_5":15564,"_21706":84695,"_1911":84827},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2322":49691,"_22971":49654,"_15675":84829,"_5":15564,"_21706":84695,"_1911":84830},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2322":49692,"_22971":49654,"_15675":84832,"_5":15564,"_21706":84695,"_1911":84833},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2322":49693,"_22971":49654,"_15675":84835,"_5":15564,"_21706":84695,"_1911":84836},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2322":49694,"_22971":49654,"_15675":84838,"_5":15564,"_21706":84695,"_1911":84839},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2322":49695,"_22971":49654,"_15675":84841,"_5":15564,"_21706":84695,"_1911":84842},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y alguna de sus políticas debe permitir la operación solicitada.",{"_2322":49696,"_22971":49654,"_15675":84844,"_5":15564,"_21706":84699,"_1911":84845},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2322":49697,"_22971":49654,"_15675":84847,"_5":15564,"_21706":84699,"_1911":84848},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2322":49698,"_22971":49654,"_15675":84850,"_5":15564,"_21706":84703,"_1911":84851},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2322":49699,"_22971":49654,"_15675":84853,"_5":15564,"_21706":84703,"_1911":84854},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2322":49700,"_22971":49654,"_15675":84856,"_5":15564,"_21706":84703,"_1911":84857},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2322":49701,"_22971":49654,"_15675":84859,"_5":15564,"_21706":84703,"_1911":84860},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2322":49702,"_22971":49654,"_15675":84862,"_5":15564,"_21706":84703,"_1911":84863},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2322":49703,"_22971":49654,"_15675":84865,"_5":15564,"_21706":84703,"_1911":84866},[],"Carga por separado las políticas concedidas a cada principal.",{"_2322":49704,"_22971":49654,"_15675":84868,"_5":15564,"_21706":84703,"_1911":84869},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2322":49705,"_22971":49654,"_15675":84871,"_5":15564,"_21706":84703,"_1911":84872},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2322":49706,"_22971":49654,"_15675":84874,"_5":15564,"_21706":84703,"_1911":84875},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2322":49707,"_22971":49654,"_15675":84877,"_5":15564,"_21706":84703,"_1911":84878},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2322":49708,"_22971":49654,"_15675":84880,"_5":15564,"_21706":84703,"_1911":84881},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en `x-current-user`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2322":49709,"_22971":49654,"_15675":84883,"_5":15564,"_21706":84703,"_1911":84884},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, el esquema debe declarar una restricción que relacione un valor de la petición con un atributo normalizado del principal.",{"_2322":49710,"_22971":49654,"_15675":84886,"_5":15564,"_21706":84707,"_1911":84887},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2322":49711,"_22971":49654,"_15675":84889,"_5":15564,"_21706":84707,"_1911":84890},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad autenticada sin una política que la conceda. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial incorrecta se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2322":49712,"_22971":49654,"_15675":84892,"_5":15564,"_21706":84707,"_1911":84893},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad autenticada.",{"_2322":49713,"_22971":49654,"_15675":84895,"_5":15564,"_21706":84707,"_1911":84896},[],"Son decisiones del esquema, no de una política: nunca sustituyen el grant que exige una ruta mapeada, solo cubren el hueco de los endpoints que el esquema no enumera. Ten en cuenta tres reglas:",{"_2322":49714,"_22971":49654,"_15675":84898,"_5":15564,"_21706":84707,"_1911":84899},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2322":49715,"_22971":49654,"_15675":84901,"_5":15564,"_21706":84707,"_1911":84902},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2322":49716,"_22971":49654,"_15675":84904,"_5":15564,"_21706":84707,"_1911":84905},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2322":49717,"_22971":49654,"_15675":84907,"_5":15564,"_21706":84707,"_1911":84908},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad autenticada puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2322":49718,"_22971":49654,"_15675":84910,"_5":15564,"_21706":84711,"_1911":84911},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2322":49719,"_22971":49654,"_15675":84913,"_5":15564,"_21706":84711,"_1911":84914},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2322":49720,"_22971":49654,"_15675":84916,"_5":15564,"_21706":84711,"_1911":84917},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2322":49721,"_22971":49654,"_15675":84919,"_5":15564,"_21706":84711,"_1911":84920},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2322":49722,"_22971":49654,"_15675":84922,"_5":15564,"_21706":84711,"_1911":84923},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2322":49723,"_22971":49654,"_15675":84925,"_5":15564,"_21706":84711,"_1911":84926},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2322":49724,"_22971":49654,"_15675":84928,"_5":15564,"_21706":84711,"_1911":84929},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2322":49725,"_22971":49654,"_15675":84931,"_5":15564,"_21706":84711,"_1911":84932},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2322":49726,"_22971":49654,"_15675":84934,"_5":15564,"_21706":84711,"_1911":84935},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2322":49727,"_22971":49654,"_15675":84937,"_5":15564,"_21706":84711,"_1911":84938},[],"Las acciones se dividen en dos grupos:",{"_2322":49728,"_22971":49654,"_15675":84940,"_5":15564,"_21706":84711,"_1911":84941},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2322":49729,"_22971":49654,"_15675":84943,"_5":15564,"_21706":84711,"_1911":84944},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2322":49730,"_22971":49654,"_15675":84946,"_5":15564,"_21706":84711,"_1911":84947},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2322":49731,"_22971":49654,"_15675":84949,"_5":15564,"_21706":84715,"_1911":84950},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2322":49732,"_22971":49654,"_15675":84952,"_5":15564,"_21706":84715,"_1911":84953},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2322":49733,"_22971":49654,"_15675":84955,"_5":15564,"_21706":84715,"_1911":84956},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega. Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2322":49734,"_22971":49654,"_15675":84958,"_5":15564,"_21706":84719,"_1911":84959},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2322":49735,"_22971":49654,"_15675":84961,"_5":15564,"_21706":84719,"_1911":84962},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2322":49736,"_22971":49654,"_15675":84964,"_5":15564,"_21706":84719,"_1911":84965},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2322":49737,"_22971":49654,"_15675":84967,"_5":15564,"_21706":84719,"_1911":84968},[],"Los operadores implementados son:",{"_2322":49738,"_22971":49654,"_15675":84970,"_5":15564,"_21706":84719,"_1911":84971},[],"`equals`, para igualdad exacta;",{"_2322":49739,"_22971":49654,"_15675":84973,"_5":15564,"_21706":84719,"_1911":84974},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2322":49740,"_22971":49654,"_15675":84976,"_5":15564,"_21706":84719,"_1911":84977},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2322":49741,"_22971":49654,"_15675":84979,"_5":15564,"_21706":84719,"_1911":84980},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2322":49742,"_22971":49654,"_15675":84982,"_5":15564,"_21706":84723,"_1911":84983},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2322":49743,"_22971":49654,"_15675":84985,"_5":15564,"_21706":84723,"_1911":84986},[],"Los modos disponibles son:",{"_2322":49744,"_22971":49654,"_15675":84988,"_5":15564,"_21706":84723,"_1911":84989},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2322":49745,"_22971":49654,"_15675":84991,"_5":15564,"_21706":84723,"_1911":84992},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2322":49746,"_22971":49654,"_15675":84994,"_5":15564,"_21706":84723,"_1911":84995},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2322":49747,"_22971":49654,"_15675":84997,"_5":15564,"_21706":84723,"_1911":84998},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2322":49748,"_22971":49654,"_15675":85000,"_5":15564,"_21706":84723,"_1911":85001},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2322":49749,"_22971":49654,"_15675":85003,"_5":15564,"_21706":84723,"_1911":85004},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2322":49750,"_22971":49654,"_15675":85006,"_5":15564,"_21706":84727,"_1911":85007},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2322":49751,"_22971":49654,"_15675":85009,"_5":15564,"_21706":84727,"_1911":85010},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2322":49752,"_22971":49654,"_15675":85012,"_5":15564,"_21706":84727,"_1911":85013},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2322":49753,"_22971":49654,"_15675":85015,"_5":15564,"_21706":84727,"_1911":85016},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2322":49754,"_22971":49654,"_15675":85018,"_5":15564,"_21706":84735,"_1911":85019},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2322":49755,"_22971":49654,"_15675":85021,"_5":15564,"_21706":84735,"_1911":85022},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2322":49756,"_22971":49654,"_15675":85024,"_5":15564,"_21706":84739,"_1911":85025},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2322":49757,"_22971":49654,"_15675":85027,"_5":15564,"_21706":84739,"_1911":85028},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2322":49758,"_22971":49654,"_15675":85030,"_5":15564,"_21706":84743,"_1911":85031},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2322":49759,"_22971":49654,"_15675":85033,"_5":15564,"_21706":84743,"_1911":85034},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2322":49760,"_22971":49654,"_15675":85036,"_5":15564,"_21706":84743,"_1911":85037},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2322":49761,"_22971":49654,"_15675":85039,"_5":15564,"_21706":84747,"_1911":85040},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2322":49762,"_22971":49654,"_15675":85042,"_5":15564,"_21706":84747,"_1911":85043},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2322":49763,"_22971":49654,"_15675":85045,"_5":15564,"_21706":84747,"_1911":85046},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2322":49764,"_22971":49654,"_15675":85048,"_5":15564,"_21706":84747,"_1911":85049},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2322":49765,"_22971":49654,"_15675":85051,"_5":15564,"_21706":84747,"_1911":85052},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2322":49766,"_22971":49654,"_15675":85054,"_5":15564,"_21706":84747,"_1911":85055},[],"Ten en cuenta que:",{"_2322":49767,"_22971":49654,"_15675":85057,"_5":15564,"_21706":84747,"_1911":85058},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2322":49768,"_22971":49654,"_15675":85060,"_5":15564,"_21706":84747,"_1911":85061},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2322":49769,"_22971":49654,"_15675":85063,"_5":15564,"_21706":84747,"_1911":85064},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2322":49770,"_22971":49654,"_15675":85066,"_5":15564,"_21706":84751,"_1911":85067},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2322":49771,"_22971":49654,"_15675":85069,"_5":15564,"_21706":84751,"_1911":85070},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2322":49772,"_22971":49654,"_15675":85072,"_5":15564,"_21706":84751,"_1911":85073},[],"acceso completo y de solo lectura a KMS;",{"_2322":49773,"_22971":49654,"_15675":85075,"_5":15564,"_21706":84751,"_1911":85076},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2322":49774,"_22971":49654,"_15675":85078,"_5":15564,"_21706":84751,"_1911":85079},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2322":49775,"_22971":49654,"_15675":85081,"_5":15564,"_21706":84751,"_1911":85082},[],"acceso a la interfaz;",{"_2322":49776,"_22971":49654,"_15675":85084,"_5":15564,"_21706":84751,"_1911":85085},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2322":49777,"_22971":49654,"_15675":85087,"_5":15564,"_21706":84751,"_1911":85088},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2322":49778,"_22971":49654,"_15675":85090,"_5":15564,"_21706":84751,"_1911":85091},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2322":49779,"_22971":49654,"_15675":85093,"_5":15564,"_21706":84755,"_1911":85094},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2322":49780,"_22971":49654,"_15675":85096,"_5":15564,"_21706":84755,"_1911":85097},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2322":49781,"_22971":49654,"_15675":85099,"_5":15564,"_21706":84755,"_1911":85100},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2322":49782,"_22971":49654,"_15675":85102,"_5":15564,"_21706":84758,"_1911":85103},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2322":49783,"_22971":49654,"_15675":85105,"_5":15564,"_21706":84762,"_1911":85106},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2322":49784,"_22971":49654,"_15675":85108,"_5":15564,"_21706":84766,"_1911":85109},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2322":49785,"_22971":49654,"_15675":85111,"_5":15564,"_21706":84770,"_1911":85112},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2322":49786,"_22971":49654,"_15675":85114,"_5":15564,"_21706":84774,"_1911":85115},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2322":49787,"_22971":49654,"_15675":85117,"_5":15564,"_21706":84778,"_1911":85118},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2322":49788,"_22971":49654,"_15675":85120,"_5":15564,"_21706":84778,"_1911":85121},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2322":49789,"_22971":49654,"_15675":85123,"_5":15564,"_21706":84782,"_1911":85124},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2322":49790,"_22971":49654,"_15675":85126,"_5":15564,"_21706":84782,"_1911":85127},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2322":49791,"_22971":49654,"_15675":85129,"_5":15564,"_21706":84782,"_1911":85130},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2322":49792,"_22971":49654,"_15675":85132,"_5":15564,"_21706":84782,"_1911":85133},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2322":49793,"_22971":49654,"_15675":85135,"_5":15564,"_21706":84782,"_1911":85136},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2322":49794,"_22971":49654,"_15675":85138,"_5":15564,"_21706":84782,"_1911":85139},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2322":49795,"_22971":49654,"_15675":85141,"_5":15564,"_21706":84782,"_1911":85142},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2322":49796,"_22971":49654,"_15675":85144,"_5":15564,"_21706":84782,"_1911":85145},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2322":49797,"_22971":49654,"_15675":85147,"_5":15564,"_21706":84786,"_1911":85148},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2322":49798,"_22971":49654,"_15675":85150,"_5":15564,"_21706":84786,"_1911":85151},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2322":49799,"_22971":49654,"_15675":85153,"_5":15564,"_21706":84786,"_1911":85154},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2322":49800,"_22971":49654,"_15675":85156,"_5":15564,"_21706":84790,"_1911":85157},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2322":49801,"_22971":49654,"_15675":85159,"_5":15564,"_21706":84790,"_1911":85160},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2322":49802,"_22971":49654,"_15675":85162,"_5":15564,"_21706":84790,"_1911":85163},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2322":49803,"_22971":49654,"_15675":85165,"_5":15564,"_21706":84790,"_1911":85166},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2322":49804,"_22971":49654,"_15675":85168,"_5":15564,"_21706":84790,"_1911":85169},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2322":49805,"_22971":49654,"_15675":85171,"_5":15564,"_21706":84790,"_1911":85172},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2322":49806,"_22971":49654,"_15675":85174,"_5":15564,"_21706":84790,"_1911":85175},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2322":49807,"_22971":49654,"_15675":85177,"_5":15564,"_21706":84790,"_1911":85178},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2322":49808,"_22971":49654,"_15675":85180,"_5":15564,"_21706":84798,"_1911":85181},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2322":49809,"_22971":49654,"_15675":85183,"_5":15564,"_21706":84802,"_1911":85184},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2322":49810,"_22971":49654,"_15675":85186,"_5":15564,"_21706":84802,"_1911":85187},[],"que exista un principal activo del tipo correcto;",{"_2322":49811,"_22971":49654,"_15675":85189,"_5":15564,"_21706":84802,"_1911":85190},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2322":49812,"_22971":49654,"_15675":85192,"_5":15564,"_21706":84802,"_1911":85193},[],"que todas las condiciones del principal se cumplan;",{"_2322":49813,"_22971":49654,"_15675":85195,"_5":15564,"_21706":84802,"_1911":85196},[],"que el principal tenga concedida la política esperada;",{"_2322":49814,"_22971":49654,"_15675":85198,"_5":15564,"_21706":84802,"_1911":85199},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2322":49815,"_22971":49654,"_15675":85201,"_5":15564,"_21706":84802,"_1911":85202},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2322":49816,"_22971":49654,"_15675":85204,"_5":15564,"_21706":84802,"_1911":85205},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2322":49817,"_22971":49654,"_15675":85207,"_5":15564,"_21706":84806,"_1911":85208},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2322":49818,"_22971":49654,"_15675":85210,"_5":15564,"_21706":84810,"_1911":85211},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad autenticada, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2322":49819,"_22971":49654,"_15675":85213,"_5":15564,"_21706":84814,"_1911":85214},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2322":49820,"_22971":49654,"_15675":85216,"_5":15564,"_21706":84814,"_1911":85217},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2322":49821,"_22971":49821,"_5":10796,"_1911":85219,"_23246":85220,"_15675":85222,"_21706":49821},"Alertas y suscripciones",[35713,84687,85221],"Operar Lamassu",[],{"_2322":49822,"_22971":49821,"_15675":85224,"_5":15564,"_21706":49821,"_1911":85225},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2322":49823,"_22971":49821,"_5":23243,"_15675":85227,"_21706":85228,"_1911":85229},[],"/docs/pr-preview/pr-28/es/platform/pki/alerts#cómo-funciona","Cómo funciona",{"_2322":49824,"_22971":49821,"_5":23243,"_15675":85231,"_21706":85232,"_1911":85233},[],"/docs/pr-preview/pr-28/es/platform/pki/alerts#canales-disponibles","Canales disponibles",{"_2322":49825,"_22971":49821,"_5":23243,"_15675":85235,"_21706":85236,"_1911":85237},[],"/docs/pr-preview/pr-28/es/platform/pki/alerts#crea-una-suscripción","Crea una suscripción",{"_2322":49826,"_22971":49821,"_5":23243,"_15675":85239,"_21706":85240,"_1911":85241},[],"/docs/pr-preview/pr-28/es/platform/pki/alerts#elige-el-evento","Elige el evento",{"_2322":49827,"_22971":49821,"_5":23243,"_15675":85243,"_21706":85244,"_1911":85245},[],"/docs/pr-preview/pr-28/es/platform/pki/alerts#configura-el-destino","Configura el destino",{"_2322":49828,"_22971":49821,"_5":23243,"_15675":85247,"_21706":85248,"_1911":85249},[],"/docs/pr-preview/pr-28/es/platform/pki/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2322":49829,"_22971":49821,"_5":23243,"_15675":85251,"_21706":85252,"_1911":85253},[],"/docs/pr-preview/pr-28/es/platform/pki/alerts#revisa-y-activa","Revisa y activa",{"_2322":49830,"_22971":49821,"_5":23243,"_15675":85255,"_21706":85256,"_1911":85257},[],"/docs/pr-preview/pr-28/es/platform/pki/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2322":49831,"_22971":49821,"_5":23243,"_15675":85259,"_21706":85260,"_1911":85261},[],"/docs/pr-preview/pr-28/es/platform/pki/alerts#familias-de-eventos","Familias de eventos",{"_2322":49832,"_22971":49821,"_15675":85263,"_5":15564,"_21706":49821,"_1911":85264},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2322":49833,"_22971":49821,"_15675":85266,"_5":15564,"_21706":85228,"_1911":85267},[],"Un servicio publica un evento de dominio.",{"_2322":49834,"_22971":49821,"_15675":85269,"_5":15564,"_21706":85228,"_1911":85270},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2322":49835,"_22971":49821,"_15675":85272,"_5":15564,"_21706":85228,"_1911":85273},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2322":49836,"_22971":49821,"_15675":85275,"_5":15564,"_21706":85228,"_1911":85276},[],"Lamassu entrega el evento al canal configurado.",{"_2322":49837,"_22971":49821,"_15675":85278,"_5":15564,"_21706":85228,"_1911":85279},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2322":49838,"_22971":49821,"_15675":85281,"_5":15564,"_21706":85232,"_1911":85282},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino.",{"_2322":49839,"_22971":49821,"_15675":85284,"_5":15564,"_21706":85232,"_1911":85285},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2322":49840,"_22971":49821,"_15675":85287,"_5":15564,"_21706":85232,"_1911":85288},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2322":49841,"_22971":49821,"_15675":85290,"_5":15564,"_21706":85240,"_1911":85291},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2322":49842,"_22971":49821,"_15675":85293,"_5":15564,"_21706":85244,"_1911":85294},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2322":49843,"_22971":49821,"_15675":85296,"_5":15564,"_21706":85248,"_1911":85297},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2322":49844,"_22971":49821,"_15675":85299,"_5":15564,"_21706":85248,"_1911":85300},[],"**None** notifica todas las instancias del evento.",{"_2322":49845,"_22971":49821,"_15675":85302,"_5":15564,"_21706":85248,"_1911":85303},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2322":49846,"_22971":49821,"_15675":85305,"_5":15564,"_21706":85248,"_1911":85306},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2322":49847,"_22971":49821,"_15675":85308,"_5":15564,"_21706":85248,"_1911":85309},[],"**JavaScript** permite expresar lógica personalizada.",{"_2322":49848,"_22971":49821,"_15675":85311,"_5":15564,"_21706":85248,"_1911":85312},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2322":49849,"_22971":49821,"_15675":85314,"_5":15564,"_21706":85252,"_1911":85315},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2322":49850,"_22971":49821,"_15675":85317,"_5":15564,"_21706":85256,"_1911":85318},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2322":49851,"_22971":49821,"_15675":85320,"_5":15564,"_21706":85260,"_1911":85321},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2322":49852,"_22971":49821,"_15675":85323,"_5":15564,"_21706":85260,"_1911":85324},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2322":49853,"_22971":49821,"_15675":85326,"_5":15564,"_21706":85260,"_1911":85327},[],"**Perfiles:** `profile.create`, `profile.update` y `profile.delete`.",{"_2322":49854,"_22971":49821,"_15675":85329,"_5":15564,"_21706":85260,"_1911":85330},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2322":49855,"_22971":49821,"_15675":85332,"_5":15564,"_21706":85260,"_1911":85333},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2322":49856,"_22971":49821,"_15675":85335,"_5":15564,"_21706":85260,"_1911":85336},[],"**Validación:** `va.role.crl.create`.",{"_2322":49857,"_22971":49821,"_15675":85338,"_5":15564,"_21706":85260,"_1911":85339},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign.message` y `kms.delete`.",{"_2322":49858,"_22971":49821,"_15675":85341,"_5":15564,"_21706":85260,"_1911":85342},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2322":49859,"_22971":49859,"_5":10796,"_1911":85344,"_23246":85345,"_15675":85346,"_21706":49859},"Registros de auditoría",[35713,84687,84688],[],{"_2322":49860,"_22971":49859,"_15675":85348,"_5":15564,"_21706":49859,"_1911":85349},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2322":49861,"_22971":49859,"_5":23243,"_15675":85351,"_21706":85352,"_1911":85353},[],"/docs/pr-preview/pr-28/es/platform/pki/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2322":49862,"_22971":49859,"_5":23243,"_15675":85355,"_21706":85356,"_1911":85357},[],"/docs/pr-preview/pr-28/es/platform/pki/audit-logs#cobertura","Cobertura",{"_2322":49863,"_22971":49859,"_5":23243,"_15675":85359,"_21706":85360,"_1911":85361},[],"/docs/pr-preview/pr-28/es/platform/pki/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2322":49864,"_22971":49859,"_5":23243,"_15675":85363,"_21706":85364,"_1911":85365},[],"/docs/pr-preview/pr-28/es/platform/pki/audit-logs#datos-sensibles","Datos sensibles",{"_2322":49865,"_22971":49859,"_5":23243,"_15675":85367,"_21706":85368,"_1911":85369},[],"/docs/pr-preview/pr-28/es/platform/pki/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2322":49866,"_22971":49859,"_5":23243,"_15675":85371,"_21706":85372,"_1911":85373},[],"/docs/pr-preview/pr-28/es/platform/pki/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2322":49867,"_22971":49859,"_5":23243,"_15675":85375,"_21706":85376,"_1911":85377},[],"/docs/pr-preview/pr-28/es/platform/pki/audit-logs#identifica-la-operación","Identifica la operación",{"_2322":49868,"_22971":49859,"_5":23243,"_15675":85379,"_21706":85380,"_1911":85381},[],"/docs/pr-preview/pr-28/es/platform/pki/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2322":49869,"_22971":49859,"_5":23243,"_15675":85383,"_21706":85384,"_1911":85385},[],"/docs/pr-preview/pr-28/es/platform/pki/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2322":49870,"_22971":49859,"_5":23243,"_15675":85387,"_21706":85388,"_1911":85389},[],"/docs/pr-preview/pr-28/es/platform/pki/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2322":49871,"_22971":49859,"_5":23243,"_15675":85391,"_21706":85392,"_1911":85393},[],"/docs/pr-preview/pr-28/es/platform/pki/audit-logs#verificación-periódica","Verificación periódica",{"_2322":49872,"_22971":49859,"_15675":85395,"_5":15564,"_21706":49859,"_1911":85396},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2322":49873,"_22971":49859,"_15675":85398,"_5":15564,"_21706":85352,"_1911":85399},[],"El cuerpo de auditoría incluye:",{"_2322":49874,"_22971":49859,"_15675":85401,"_5":15564,"_21706":85352,"_1911":85402},[],"input: datos recibidos por la operación;",{"_2322":49875,"_22971":49859,"_15675":85404,"_5":15564,"_21706":85352,"_1911":85405},[],"has\\_error: indica si el servicio devolvió un error;",{"_2322":49876,"_22971":49859,"_15675":85407,"_5":15564,"_21706":85352,"_1911":85408},[],"output: resultado producido o mensaje de error;",{"_2322":49877,"_22971":49859,"_15675":85410,"_5":15564,"_21706":85352,"_1911":85411},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2322":49878,"_22971":49859,"_15675":85413,"_5":15564,"_21706":85352,"_1911":85414},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2322":49879,"_22971":49859,"_15675":85416,"_5":15564,"_21706":85352,"_1911":85417},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2322":49880,"_22971":49859,"_15675":85419,"_5":15564,"_21706":85356,"_1911":85420},[],"El backend aplica auditoría a mutaciones de:",{"_2322":49881,"_22971":49859,"_15675":85422,"_5":15564,"_21706":85356,"_1911":85423},[],"autoridades, certificados y perfiles de emisión;",{"_2322":49882,"_22971":49859,"_15675":85425,"_5":15564,"_21706":85356,"_1911":85426},[],"claves y motores KMS;",{"_2322":49883,"_22971":49859,"_15675":85428,"_5":15564,"_21706":85356,"_1911":85429},[],"dispositivos e identidades;",{"_2322":49884,"_22971":49859,"_15675":85431,"_5":15564,"_21706":85356,"_1911":85432},[],"DMS y operaciones de enrolamiento;",{"_2322":49885,"_22971":49859,"_15675":85434,"_5":15564,"_21706":85356,"_1911":85435},[],"funciones de validación y CRL;",{"_2322":49886,"_22971":49859,"_15675":85437,"_5":15564,"_21706":85356,"_1911":85438},[],"principales, políticas y concesiones de autorización.",{"_2322":49887,"_22971":49859,"_15675":85440,"_5":15564,"_21706":85356,"_1911":85441},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2322":49888,"_22971":49859,"_15675":85443,"_5":15564,"_21706":85360,"_1911":85444},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2322":49889,"_22971":49859,"_15675":85446,"_5":15564,"_21706":85360,"_1911":85447},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2322":49890,"_22971":49859,"_15675":85449,"_5":15564,"_21706":85360,"_1911":85450},[],"Diseña el consumidor para:",{"_2322":49891,"_22971":49859,"_15675":85452,"_5":15564,"_21706":85360,"_1911":85453},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2322":49892,"_22971":49859,"_15675":85455,"_5":15564,"_21706":85360,"_1911":85456},[],"conservar el CloudEvent completo sin modificar;",{"_2322":49893,"_22971":49859,"_15675":85458,"_5":15564,"_21706":85360,"_1911":85459},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2322":49894,"_22971":49859,"_15675":85461,"_5":15564,"_21706":85360,"_1911":85462},[],"cifrar en tránsito y en reposo;",{"_2322":49895,"_22971":49859,"_15675":85464,"_5":15564,"_21706":85360,"_1911":85465},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2322":49896,"_22971":49859,"_15675":85467,"_5":15564,"_21706":85360,"_1911":85468},[],"aplicar una política explícita de retención y legal hold;",{"_2322":49897,"_22971":49859,"_15675":85470,"_5":15564,"_21706":85360,"_1911":85471},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2322":49898,"_22971":49859,"_15675":85473,"_5":15564,"_21706":85364,"_1911":85474},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2322":49899,"_22971":49859,"_15675":85476,"_5":15564,"_21706":85364,"_1911":85477},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2322":49900,"_22971":49859,"_15675":85479,"_5":15564,"_21706":85372,"_1911":85480},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2322":49901,"_22971":49859,"_15675":85482,"_5":15564,"_21706":85376,"_1911":85483},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2322":49902,"_22971":49859,"_15675":85485,"_5":15564,"_21706":85380,"_1911":85486},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2322":49903,"_22971":49859,"_15675":85488,"_5":15564,"_21706":85384,"_1911":85489},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2322":49904,"_22971":49859,"_15675":85491,"_5":15564,"_21706":85388,"_1911":85492},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2322":49905,"_22971":49859,"_15675":85494,"_5":15564,"_21706":85392,"_1911":85495},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2322":49906,"_22971":49859,"_15675":85497,"_5":15564,"_21706":85392,"_1911":85498},[],"aparece un evento de auditoría correcto;",{"_2322":49907,"_22971":49859,"_15675":85500,"_5":15564,"_21706":85392,"_1911":85501},[],"el principal coincide con la identidad utilizada;",{"_2322":49908,"_22971":49859,"_15675":85503,"_5":15564,"_21706":85392,"_1911":85504},[],"el consumidor lo persiste una sola vez;",{"_2322":49909,"_22971":49859,"_15675":85506,"_5":15564,"_21706":85392,"_1911":85507},[],"puede recuperarse por recurso, actor y periodo;",{"_2322":49910,"_22971":49859,"_15675":85509,"_5":15564,"_21706":85392,"_1911":85510},[],"una interrupción del consumidor produce una alerta.",{"_2322":49911,"_22971":49859,"_15675":85512,"_5":15564,"_21706":85392,"_1911":85513},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2322":49912,"_22971":49912,"_5":10796,"_1911":85515,"_23246":85516,"_15675":85517,"_21706":49912},"Jerarquía y rotación de CAs",[35713,84687,85221],[],{"_2322":49913,"_22971":49912,"_15675":85519,"_5":15564,"_21706":49912,"_1911":85520},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2322":49914,"_22971":49912,"_5":23243,"_15675":85522,"_21706":85523,"_1911":85524},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2322":49915,"_22971":49912,"_5":23243,"_15675":85526,"_21706":85527,"_1911":85528},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2322":49916,"_22971":49912,"_5":23243,"_15675":85530,"_21706":85531,"_1911":85532},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2322":49917,"_22971":49912,"_5":23243,"_15675":85534,"_21706":85535,"_1911":85536},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2322":49918,"_22971":49912,"_5":23243,"_15675":85538,"_21706":85539,"_1911":85540},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2322":49919,"_22971":49912,"_5":23243,"_15675":85542,"_21706":85543,"_1911":85544},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2322":49920,"_22971":49912,"_5":23243,"_15675":85546,"_21706":85547,"_1911":85548},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2322":49921,"_22971":49912,"_5":23243,"_15675":85550,"_21706":85551,"_1911":85552},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2322":49922,"_22971":49912,"_5":23243,"_15675":85554,"_21706":85555,"_1911":85556},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2322":49923,"_22971":49912,"_5":23243,"_15675":85558,"_21706":85559,"_1911":85560},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2322":49924,"_22971":49912,"_5":23243,"_15675":85562,"_21706":85563,"_1911":85564},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2322":49925,"_22971":49912,"_5":23243,"_15675":85566,"_21706":85567,"_1911":85568},[],"/docs/pr-preview/pr-28/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2322":49926,"_22971":49912,"_15675":85570,"_5":15564,"_21706":49912,"_1911":85571},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2322":49927,"_22971":49912,"_15675":85573,"_5":15564,"_21706":85523,"_1911":85574},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2322":49928,"_22971":49912,"_15675":85576,"_5":15564,"_21706":85523,"_1911":85577},[],"entorno, como producción y preproducción;",{"_2322":49929,"_22971":49912,"_15675":85579,"_5":15564,"_21706":85523,"_1911":85580},[],"propietario o equipo operador;",{"_2322":49930,"_22971":49912,"_15675":85582,"_5":15564,"_21706":85523,"_1911":85583},[],"familia de dispositivos o proceso de fabricación;",{"_2322":49931,"_22971":49912,"_15675":85585,"_5":15564,"_21706":85523,"_1911":85586},[],"región o requisito regulatorio;",{"_2322":49932,"_22971":49912,"_15675":85588,"_5":15564,"_21706":85523,"_1911":85589},[],"motor criptográfico o política de clave;",{"_2322":49933,"_22971":49912,"_15675":85591,"_5":15564,"_21706":85523,"_1911":85592},[],"ventana de mantenimiento y ritmo de renovación.",{"_2322":49934,"_22971":49912,"_15675":85594,"_5":15564,"_21706":85523,"_1911":85595},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2322":49935,"_22971":49912,"_15675":85597,"_5":15564,"_21706":85523,"_1911":85598},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2322":49936,"_22971":49912,"_15675":85600,"_5":15564,"_21706":85527,"_1911":85601},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2322":49937,"_22971":49912,"_15675":85603,"_5":15564,"_21706":85527,"_1911":85604},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2322":49938,"_22971":49912,"_15675":85606,"_5":15564,"_21706":85527,"_1911":85607},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2322":49939,"_22971":49912,"_15675":85609,"_5":15564,"_21706":85531,"_1911":85610},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2322":49940,"_22971":49912,"_15675":85612,"_5":15564,"_21706":85531,"_1911":85613},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2322":49941,"_22971":49912,"_15675":85615,"_5":15564,"_21706":85531,"_1911":85616},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2322":49942,"_22971":49912,"_15675":85618,"_5":15564,"_21706":85531,"_1911":85619},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2322":49943,"_22971":49912,"_15675":85621,"_5":15564,"_21706":85539,"_1911":85622},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2322":49944,"_22971":49912,"_15675":85624,"_5":15564,"_21706":85543,"_1911":85625},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2322":49945,"_22971":49912,"_15675":85627,"_5":15564,"_21706":85547,"_1911":85628},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. En un DMS, utiliza las CAs gestionadas de `/cacerts` para mantener temporalmente las cadenas antigua y nueva.",{"_2322":49946,"_22971":49912,"_15675":85630,"_5":15564,"_21706":85551,"_1911":85631},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2322":49947,"_22971":49912,"_15675":85633,"_5":15564,"_21706":85555,"_1911":85634},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2322":49948,"_22971":49912,"_15675":85636,"_5":15564,"_21706":85559,"_1911":85637},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2322":49949,"_22971":49912,"_15675":85639,"_5":15564,"_21706":85563,"_1911":85640},[],"Al revocar una CA, Lamassu actualiza también sus CAs hijas y certificados emitidos a `REVOKED` con razón `CessationOfOperation`. Las revocaciones de las hijas propagan el efecto a sus propias ramas.",{"_2322":49950,"_22971":49912,"_15675":85642,"_5":15564,"_21706":85563,"_1911":85643},[],"Esto protege la coherencia de la jerarquía, pero convierte la revocación en una acción de gran impacto. No la utilices como mecanismo ordinario para dejar de emitir: primero completa la migración y elimina la CA de los flujos operativos.",{"_2322":49951,"_22971":49912,"_15675":85645,"_5":15564,"_21706":85567,"_1911":85646},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2322":49952,"_22971":49912,"_15675":85648,"_5":15564,"_21706":85567,"_1911":85649},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2322":49953,"_22971":49912,"_15675":85651,"_5":15564,"_21706":85567,"_1911":85652},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2322":49954,"_22971":49912,"_15675":85654,"_5":15564,"_21706":85567,"_1911":85655},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2322":49955,"_22971":49912,"_15675":85657,"_5":15564,"_21706":85567,"_1911":85658},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2322":49956,"_22971":49912,"_15675":85660,"_5":15564,"_21706":85567,"_1911":85661},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2322":49957,"_22971":49912,"_15675":85663,"_5":15564,"_21706":85567,"_1911":85664},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2322":49958,"_22971":49958,"_5":10796,"_1911":85666,"_23246":85667,"_15675":85668,"_21706":49958},"Autoridades de certificación",[35713,84687,85221],[],{"_2322":49959,"_22971":49958,"_15675":85670,"_5":15564,"_21706":49958,"_1911":85671},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2322":49960,"_22971":49958,"_5":23243,"_15675":85673,"_21706":85674,"_1911":85675},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2322":49961,"_22971":49958,"_5":23243,"_15675":85677,"_21706":85678,"_1911":85679},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2322":49962,"_22971":49958,"_5":23243,"_15675":85681,"_21706":85682,"_1911":83598},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2322":49963,"_22971":49958,"_5":23243,"_15675":85684,"_21706":85685,"_1911":85686},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2322":49964,"_22971":49958,"_5":23243,"_15675":85688,"_21706":85689,"_1911":85690},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2322":49965,"_22971":49958,"_5":23243,"_15675":85692,"_21706":85693,"_1911":85694},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2322":49966,"_22971":49958,"_5":23243,"_15675":85696,"_21706":85697,"_1911":85698},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2322":49967,"_22971":49958,"_5":23243,"_15675":85700,"_21706":85701,"_1911":85702},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2322":49968,"_22971":49958,"_5":23243,"_15675":85704,"_21706":85705,"_1911":85706},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2322":49969,"_22971":49958,"_5":23243,"_15675":85708,"_21706":85709,"_1911":85710},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2322":49970,"_22971":49958,"_5":23243,"_15675":85712,"_21706":85713,"_1911":85714},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2322":49971,"_22971":49958,"_5":23243,"_15675":85716,"_21706":85717,"_1911":85718},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2322":49972,"_22971":49958,"_5":23243,"_15675":85720,"_21706":85721,"_1911":85722},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2322":49973,"_22971":49958,"_5":23243,"_15675":85724,"_21706":85725,"_1911":85726},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2322":49974,"_22971":49958,"_5":23243,"_15675":85728,"_21706":85729,"_1911":85730},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2322":49975,"_22971":49958,"_5":23243,"_15675":85732,"_21706":85733,"_1911":85734},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2322":49976,"_22971":49958,"_5":23243,"_15675":85736,"_21706":85737,"_1911":85738},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2322":49977,"_22971":49958,"_5":23243,"_15675":85740,"_21706":85741,"_1911":85742},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2322":49978,"_22971":49958,"_5":23243,"_15675":85744,"_21706":85745,"_1911":85746},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2322":49979,"_22971":49958,"_5":23243,"_15675":85748,"_21706":85749,"_1911":85750},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2322":49980,"_22971":49958,"_5":23243,"_15675":85752,"_21706":85753,"_1911":85754},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2322":49981,"_22971":49958,"_5":23243,"_15675":85756,"_21706":85757,"_1911":85758},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2322":49982,"_22971":49958,"_15675":85760,"_5":15564,"_21706":49958,"_1911":85761},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2322":49983,"_22971":49958,"_15675":85763,"_5":15564,"_21706":49958,"_1911":85764},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2322":49984,"_22971":49958,"_15675":85766,"_5":15564,"_21706":85674,"_1911":85767},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2322":49985,"_22971":49958,"_15675":85769,"_5":15564,"_21706":85674,"_1911":85770},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2322":49986,"_22971":49958,"_15675":85772,"_5":15564,"_21706":85674,"_1911":85773},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2322":49987,"_22971":49958,"_15675":85775,"_5":15564,"_21706":85674,"_1911":85776},[],"**Importar solo el certificado:** añade una autoridad para construir cadenas y validar, pero no para emitir.",{"_2322":49988,"_22971":49958,"_15675":85778,"_5":15564,"_21706":85674,"_1911":85779},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2322":49989,"_22971":49958,"_15675":85781,"_5":15564,"_21706":85682,"_1911":85782},[],"Decide si la CA será raíz o intermedia.",{"_2322":49990,"_22971":49958,"_15675":85784,"_5":15564,"_21706":85682,"_1911":85785},[],"Elige el motor que custodiará la clave.",{"_2322":49991,"_22971":49958,"_15675":85787,"_5":15564,"_21706":85682,"_1911":85788},[],"Define una validez superior a la de los certificados que emitirá.",{"_2322":49992,"_22971":49958,"_15675":85790,"_5":15564,"_21706":85682,"_1911":85791},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2322":49993,"_22971":49958,"_15675":85793,"_5":15564,"_21706":85685,"_1911":85794},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2322":49994,"_22971":49958,"_15675":85796,"_5":15564,"_21706":85689,"_1911":85797},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2322":49995,"_22971":49958,"_15675":85799,"_5":15564,"_21706":85689,"_1911":85800},[],"Para RSA puedes elegir 1024, 2048, 3072 o 4096 bits. Para EC están disponibles las curvas P-256, P-384 y P-521.",{"_2322":49996,"_22971":49958,"_15675":85802,"_5":15564,"_21706":85693,"_1911":85803},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2322":49997,"_22971":49958,"_15675":85805,"_5":15564,"_21706":85697,"_1911":85806},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2322":49998,"_22971":49958,"_15675":85808,"_5":15564,"_21706":85697,"_1911":85809},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2322":49999,"_22971":49958,"_15675":85811,"_5":15564,"_21706":85697,"_1911":85812},[],"`ST`: estado o provincia.",{"_2322":50000,"_22971":49958,"_15675":85814,"_5":15564,"_21706":85697,"_1911":85815},[],"`L`: localidad.",{"_2322":50001,"_22971":49958,"_15675":85817,"_5":15564,"_21706":85697,"_1911":85818},[],"`O`: organización.",{"_2322":50002,"_22971":49958,"_15675":85820,"_5":15564,"_21706":85697,"_1911":85821},[],"`OU`: unidad organizativa.",{"_2322":50003,"_22971":49958,"_15675":85823,"_5":15564,"_21706":85697,"_1911":85824},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2322":50004,"_22971":49958,"_15675":85826,"_5":15564,"_21706":85701,"_1911":85827},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2322":50005,"_22971":49958,"_15675":85829,"_5":15564,"_21706":85701,"_1911":85830},[],"Selecciona un perfil de emisión existente o configura los `Key Usage` y `Extended Key Usage` en el formulario. Si no eliges un perfil, Lamassu aplica los usos básicos predeterminados.",{"_2322":50006,"_22971":49958,"_15675":85832,"_5":15564,"_21706":85705,"_1911":85833},[],"Confirma el formulario. La CA debe aparecer en el inventario con su certificado PEM, estado, fecha de expiración y relación de certificados emitidos.",{"_2322":50007,"_22971":49958,"_15675":85835,"_5":15564,"_21706":85705,"_1911":85836},[],"Una CA no puede emitir certificados que superen su propia fecha de expiración. Deja margen suficiente para renovar o sustituir la autoridad sin interrumpir a los consumidores.",{"_2322":50008,"_22971":49958,"_15675":85838,"_5":15564,"_21706":85709,"_1911":85839},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2322":50009,"_22971":49958,"_15675":85841,"_5":15564,"_21706":85709,"_1911":85842},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2322":50010,"_22971":49958,"_15675":85844,"_5":15564,"_21706":85713,"_1911":85845},[],"La importación conserva una autoridad creada fuera de Lamassu.",{"_2322":50011,"_22971":49958,"_15675":85847,"_5":15564,"_21706":85717,"_1911":85848},[],"Elige el motor que custodiará la clave importada.",{"_2322":50012,"_22971":49958,"_15675":85850,"_5":15564,"_21706":85721,"_1911":85851},[],"Proporciona el certificado de CA y la clave privada en formato PEM. Para una CA subordinada, añade opcionalmente la cadena de validación.",{"_2322":50013,"_22971":49958,"_15675":85853,"_5":15564,"_21706":85725,"_1911":85854},[],"Configura la validez que recibirán los certificados finales cuando una solicitud no indique otra duración.",{"_2322":50014,"_22971":49958,"_15675":85856,"_5":15564,"_21706":85729,"_1911":85857},[],"Lamassu comprueba que el certificado pertenece a una CA y que el material es coherente antes de registrarlo.",{"_2322":50015,"_22971":49958,"_15675":85859,"_5":15564,"_21706":85729,"_1911":85860},[],"Si no dispones de la clave privada, importa únicamente el certificado. La autoridad podrá formar parte de cadenas de confianza y procesos de validación, pero no podrá emitir certificados desde Lamassu.",{"_2322":50016,"_22971":49958,"_15675":85862,"_5":15564,"_21706":85733,"_1911":85863},[],"Abre una CA desde el inventario para consultar:",{"_2322":50017,"_22971":49958,"_15675":85865,"_5":15564,"_21706":85733,"_1911":85866},[],"Estado y periodo de validez.",{"_2322":50018,"_22971":49958,"_15675":85868,"_5":15564,"_21706":85733,"_1911":85869},[],"Certificado y cadena en formato PEM.",{"_2322":50019,"_22971":49958,"_15675":85871,"_5":15564,"_21706":85733,"_1911":85872},[],"Número de certificados activos, expirados y revocados.",{"_2322":50020,"_22971":49958,"_15675":85874,"_5":15564,"_21706":85733,"_1911":85875},[],"Certificados emitidos en **Issued Certificates**.",{"_2322":50021,"_22971":49958,"_15675":85877,"_5":15564,"_21706":85733,"_1911":85878},[],"CRL vinculada a la autoridad.",{"_2322":50022,"_22971":49958,"_15675":85880,"_5":15564,"_21706":85733,"_1911":85881},[],"Metadatos y motor criptográfico asociado.",{"_2322":50023,"_22971":49958,"_15675":85883,"_5":15564,"_21706":85733,"_1911":85884},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2322":50024,"_22971":49958,"_15675":85886,"_5":15564,"_21706":85737,"_1911":85887},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2322":50025,"_22971":49958,"_15675":85889,"_5":15564,"_21706":85737,"_1911":85890},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2322":50026,"_22971":49958,"_15675":85892,"_5":15564,"_21706":85737,"_1911":85893},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2322":50027,"_22971":49958,"_15675":85895,"_5":15564,"_21706":85737,"_1911":85896},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2322":50028,"_22971":49958,"_15675":85898,"_5":15564,"_21706":85741,"_1911":85899},[],"Revocar una CA invalida la confianza en los certificados que ha emitido y puede interrumpir dispositivos y servicios. La acción es irreversible.",{"_2322":50029,"_22971":49958,"_15675":85901,"_5":15564,"_21706":85745,"_1911":85902},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2322":50030,"_22971":49958,"_15675":85904,"_5":15564,"_21706":85749,"_1911":85905},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2322":50031,"_22971":49958,"_15675":85907,"_5":15564,"_21706":85753,"_1911":85908},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2322":50032,"_22971":49958,"_15675":85910,"_5":15564,"_21706":85757,"_1911":85911},[],"El estado debe cambiar a **REVOKED** y la CRL debe reflejar la nueva información. La CA deja de poder emitir certificados.",{"_2322":50033,"_22971":49958,"_15675":85913,"_5":15564,"_21706":85757,"_1911":85914},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2322":50034,"_22971":50034,"_5":10796,"_1911":85916,"_23246":85917,"_15675":85918,"_21706":50034},"Perfiles de certificado",[35713,84687,85221],[],{"_2322":50035,"_22971":50034,"_15675":85920,"_5":15564,"_21706":50034,"_1911":85921},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2322":50036,"_22971":50034,"_5":23243,"_15675":85923,"_21706":85924,"_1911":85925},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2322":50037,"_22971":50034,"_5":23243,"_15675":85927,"_21706":85928,"_1911":85929},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#validez","Validez",{"_2322":50038,"_22971":50034,"_5":23243,"_15675":85931,"_21706":85932,"_1911":85933},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2322":50039,"_22971":50034,"_5":23243,"_15675":85935,"_21706":85936,"_1911":85937},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2322":50040,"_22971":50034,"_5":23243,"_15675":85939,"_21706":85940,"_1911":85941},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2322":50041,"_22971":50034,"_5":23243,"_15675":85943,"_21706":85944,"_1911":85945},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2322":50042,"_22971":50034,"_5":23243,"_15675":85947,"_21706":85948,"_1911":85949},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2322":50043,"_22971":50034,"_5":23243,"_15675":85951,"_21706":85952,"_1911":85953},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2322":50044,"_22971":50034,"_5":23243,"_15675":85955,"_21706":85956,"_1911":85957},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2322":50045,"_22971":50034,"_5":23243,"_15675":85959,"_21706":85960,"_1911":85961},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2322":50046,"_22971":50034,"_5":23243,"_15675":85963,"_21706":85964,"_1911":85965},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2322":50047,"_22971":50034,"_5":23243,"_15675":85967,"_21706":85968,"_1911":85969},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2322":50048,"_22971":50034,"_5":23243,"_15675":85971,"_21706":85972,"_1911":85973},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2322":50049,"_22971":50034,"_5":23243,"_15675":85975,"_21706":85976,"_1911":85977},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2322":50050,"_22971":50034,"_5":23243,"_15675":85979,"_21706":85980,"_1911":85981},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2322":50051,"_22971":50034,"_5":23243,"_15675":85983,"_21706":85984,"_1911":85985},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2322":50052,"_22971":50034,"_15675":85987,"_5":15564,"_21706":50034,"_1911":85988},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2322":50053,"_22971":50034,"_15675":85990,"_5":15564,"_21706":85928,"_1911":85991},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2322":50054,"_22971":50034,"_15675":85993,"_5":15564,"_21706":85928,"_1911":85994},[],"La fecha final nunca debe superar la de la CA emisora.",{"_2322":50055,"_22971":50034,"_15675":85996,"_5":15564,"_21706":85932,"_1911":85997},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2322":50056,"_22971":50034,"_15675":85999,"_5":15564,"_21706":85936,"_1911":86000},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2322":50057,"_22971":50034,"_15675":86002,"_5":15564,"_21706":85936,"_1911":86003},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2322":50058,"_22971":50034,"_15675":86005,"_5":15564,"_21706":85936,"_1911":86006},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2322":50059,"_22971":50034,"_15675":86008,"_5":15564,"_21706":85940,"_1911":86009},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2322":50060,"_22971":50034,"_15675":86011,"_5":15564,"_21706":85944,"_1911":86012},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2322":50061,"_22971":50034,"_15675":86014,"_5":15564,"_21706":85944,"_1911":86015},[],"Este comportamiento permite aceptar DNS, IP, correo o URI como identidades alternativas sin aceptar extensiones arbitrarias.",{"_2322":50062,"_22971":50034,"_15675":86017,"_5":15564,"_21706":85948,"_1911":86018},[],"La aplicación criptográfica puede:",{"_2322":50063,"_22971":50034,"_15675":86020,"_5":15564,"_21706":85948,"_1911":86021},[],"permitir o bloquear claves RSA;",{"_2322":50064,"_22971":50034,"_15675":86023,"_5":15564,"_21706":85948,"_1911":86024},[],"limitar los tamaños RSA admitidos;",{"_2322":50065,"_22971":50034,"_15675":86026,"_5":15564,"_21706":85948,"_1911":86027},[],"permitir o bloquear claves ECDSA;",{"_2322":50066,"_22971":50034,"_15675":86029,"_5":15564,"_21706":85948,"_1911":86030},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2322":50067,"_22971":50034,"_15675":86032,"_5":15564,"_21706":85948,"_1911":86033},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2322":50068,"_22971":50034,"_15675":86035,"_5":15564,"_21706":85952,"_1911":86036},[],"En operaciones que admiten varias fuentes, Lamassu resuelve el perfil en este orden:",{"_2322":50069,"_22971":50034,"_15675":86038,"_5":15564,"_21706":85952,"_1911":86039},[],"Perfil enviado dentro de la operación.",{"_2322":50070,"_22971":50034,"_15675":86041,"_5":15564,"_21706":85952,"_1911":86042},[],"Identificador de perfil enviado en la operación.",{"_2322":50071,"_22971":50034,"_15675":86044,"_5":15564,"_21706":85952,"_1911":86045},[],"Perfil predeterminado asociado a la CA.",{"_2322":50072,"_22971":50034,"_15675":86047,"_5":15564,"_21706":85952,"_1911":86048},[],"Un DMS también puede referenciar su propio perfil de emisión. De este modo, varias flotas pueden usar la misma CA con políticas distintas.",{"_2322":50073,"_22971":50034,"_15675":86050,"_5":15564,"_21706":85960,"_1911":86051},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2322":50074,"_22971":50034,"_15675":86053,"_5":15564,"_21706":85964,"_1911":86054},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2322":50075,"_22971":50034,"_15675":86056,"_5":15564,"_21706":85968,"_1911":86057},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2322":50076,"_22971":50034,"_15675":86059,"_5":15564,"_21706":85972,"_1911":86060},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2322":50077,"_22971":50034,"_15675":86062,"_5":15564,"_21706":85976,"_1911":86063},[],"Asocia el perfil a una CA o DMS. Emite un certificado de prueba y comprueba sujeto, SAN, KU, EKU, restricciones básicas y fechas con una herramienta X.509 independiente.",{"_2322":50078,"_22971":50034,"_15675":86065,"_5":15564,"_21706":85980,"_1911":86066},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2322":50079,"_22971":50034,"_15675":86068,"_5":15564,"_21706":85980,"_1911":86069},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2322":50080,"_22971":50034,"_15675":86071,"_5":15564,"_21706":85980,"_1911":86072},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2322":50081,"_22971":50034,"_15675":86074,"_5":15564,"_21706":85980,"_1911":86075},[],"Son patrones de partida, no una política universal. Verifica siempre los requisitos del protocolo, del consumidor y del marco regulatorio aplicable.",{"_2322":50082,"_22971":50034,"_15675":86077,"_5":15564,"_21706":85984,"_1911":86078},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2322":50083,"_22971":50034,"_15675":86080,"_5":15564,"_21706":85984,"_1911":86081},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2322":50084,"_22971":50084,"_5":10796,"_1911":86083,"_23246":86084,"_15675":86085,"_21706":50084},"Validación de certificados",[35713,84687,85221],[],{"_2322":50085,"_22971":50084,"_15675":86087,"_5":15564,"_21706":50084,"_1911":86088},[],"Publica el estado de las identidades mediante OCSP y CRL.",{"_2322":50086,"_22971":50084,"_5":23243,"_15675":86090,"_21706":86091,"_1911":86092},[],"/docs/pr-preview/pr-28/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2322":50087,"_22971":50084,"_15675":86094,"_5":15564,"_21706":50084,"_1911":86095},[],"La emisión demuestra quién firmó un certificado; la validación permite saber si todavía debe aceptarse. Lamassu publica el estado mediante dos mecanismos complementarios.",{"_2322":50088,"_22971":50084,"_15675":86097,"_5":15564,"_21706":86091,"_1911":86098},[],"Usa **OCSP** cuando el consumidor esté conectado y necesite consultar el estado más reciente de un certificado concreto.",{"_2322":50089,"_22971":50084,"_15675":86100,"_5":15564,"_21706":86091,"_1911":86101},[],"Usa una **CRL** cuando la validación deba realizarse localmente, sin conexión o sobre un volumen elevado de certificados. El consumidor descarga periódicamente una lista firmada y la conserva hasta la siguiente actualización.",{"_2322":50090,"_22971":50084,"_15675":86103,"_5":15564,"_21706":86091,"_1911":86104},[],"Muchos entornos utilizan ambos: OCSP como comprobación primaria y CRL como mecanismo local o de respaldo.",{"_2322":50091,"_22971":50084,"_15675":86106,"_5":15564,"_21706":86091,"_1911":86107},[],"<Card title=\"Validación online con OCSP\" description=\"Consulta estados Good, Revoked y Unknown en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_2322":50092,"_22971":50084,"_15675":86109,"_5":15564,"_21706":86091,"_1911":86110},[],"<Card title=\"Listas de revocación\" description=\"Genera, publica y distribuye CRLs por autoridad.\" href=\"/docs/platform/pki/crl\" />",{"_2322":50093,"_22971":50093,"_5":10796,"_1911":86112,"_23246":86113,"_15675":86114,"_21706":50093},"Certificados",[35713,84687,85221],[],{"_2322":50094,"_22971":50093,"_15675":86116,"_5":15564,"_21706":50093,"_1911":86117},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2322":50095,"_22971":50093,"_5":23243,"_15675":86119,"_21706":86120,"_1911":86121},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2322":50096,"_22971":50093,"_5":23243,"_15675":86123,"_21706":86124,"_1911":86125},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2322":50097,"_22971":50093,"_5":23243,"_15675":86127,"_21706":86128,"_1911":86129},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2322":50098,"_22971":50093,"_5":23243,"_15675":86131,"_21706":86132,"_1911":86133},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2322":50099,"_22971":50093,"_5":23243,"_15675":86135,"_21706":86136,"_1911":86137},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2322":50100,"_22971":50093,"_5":23243,"_15675":86139,"_21706":86140,"_1911":86141},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2322":50101,"_22971":50093,"_5":23243,"_15675":86143,"_21706":86144,"_1911":86145},[],"/docs/pr-preview/pr-28/es/platform/pki/certificates#continúa","Continúa",{"_2322":50102,"_22971":50093,"_15675":86147,"_5":15564,"_21706":50093,"_1911":86148},[],"El inventario de certificados ofrece una vista global de las identidades emitidas por todas las autoridades. También puedes abrir **Issued Certificates** dentro de una CA para limitar la vista a ese emisor.",{"_2322":50103,"_22971":50093,"_15675":86150,"_5":15564,"_21706":86120,"_1911":86151},[],"Abre **Certificates** y filtra por:",{"_2322":50104,"_22971":50093,"_15675":86153,"_5":15564,"_21706":86120,"_1911":86154},[],"`Common Name` del sujeto.",{"_2322":50105,"_22971":50093,"_15675":86156,"_5":15564,"_21706":86120,"_1911":86157},[],"Número de serie.",{"_2322":50106,"_22971":50093,"_15675":86159,"_5":15564,"_21706":86120,"_1911":86160},[],"Estado.",{"_2322":50107,"_22971":50093,"_15675":86162,"_5":15564,"_21706":86120,"_1911":86163},[],"Autoridad emisora.",{"_2322":50108,"_22971":50093,"_15675":86165,"_5":15564,"_21706":86120,"_1911":86166},[],"Utiliza **Quick Inspect** para una comprobación rápida o **View Details** para ver el sujeto, SANs, usos, cadena, periodo de validez y metadatos completos.",{"_2322":50109,"_22971":50093,"_15675":86168,"_5":15564,"_21706":86124,"_1911":86169},[],"La acción de descarga entrega el certificado en formato PEM. Si el certificado se emitió mediante un CSR externo, la clave privada permanece en el sistema que generó ese CSR. Si se generó en el navegador, la clave solo estuvo disponible al finalizar la emisión.",{"_2322":50110,"_22971":50093,"_15675":86171,"_5":15564,"_21706":86128,"_1911":86172},[],"Revoca una identidad cuando la clave se haya comprometido, el sujeto ya no esté autorizado o el certificado deba dejar de aceptarse antes de expirar.",{"_2322":50111,"_22971":50093,"_15675":86174,"_5":15564,"_21706":86132,"_1911":86175},[],"En el inventario o la vista de detalle, selecciona **Revoke Certificate**.",{"_2322":50112,"_22971":50093,"_15675":86177,"_5":15564,"_21706":86136,"_1911":86178},[],"Selecciona la razón que represente el incidente. Esta información se publica en OCSP y en la CRL.",{"_2322":50113,"_22971":50093,"_15675":86180,"_5":15564,"_21706":86140,"_1911":86181},[],"Confirma la operación y comprueba que el estado sea **Revoked**. Si la CA regenera la CRL al revocar, verifica también que exista una versión nueva.",{"_2322":50114,"_22971":50093,"_15675":86183,"_5":15564,"_21706":86140,"_1911":86184},[],"Una revocación con la razón `CertificateHold` puede reactivarse. Las demás razones producen una revocación definitiva.",{"_2322":50115,"_22971":50093,"_15675":86186,"_5":15564,"_21706":86144,"_1911":86187},[],"<Card title=\"Validar con OCSP\" description=\"Consulta el estado de un certificado en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_2322":50116,"_22971":50093,"_15675":86189,"_5":15564,"_21706":86144,"_1911":86190},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación offline.\" href=\"/docs/platform/pki/crl\" />",{"_2322":50117,"_22971":50117,"_5":10796,"_1911":86192,"_23246":86193,"_15675":86195,"_21706":50117},"Arquitectura de la plataforma",[35713,84687,86194],"Conceptos",[],{"_2322":50118,"_22971":50117,"_15675":86197,"_5":15564,"_21706":50117,"_1911":86198},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2322":50119,"_22971":50117,"_5":23243,"_15675":86200,"_21706":86201,"_1911":86202},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/architecture#plano-de-control","Plano de control",{"_2322":50120,"_22971":50117,"_5":23243,"_15675":86204,"_21706":86205,"_1911":86206},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2322":50121,"_22971":50117,"_5":23243,"_15675":86208,"_21706":86209,"_1911":86210},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2322":50122,"_22971":50117,"_5":23243,"_15675":86212,"_21706":86213,"_1911":86214},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/architecture#estado-y-validación","Estado y validación",{"_2322":50123,"_22971":50117,"_5":23243,"_15675":86216,"_21706":86217,"_1911":86218},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2322":50124,"_22971":50117,"_15675":86220,"_5":15564,"_21706":50117,"_1911":86221},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2322":50125,"_22971":50117,"_15675":86223,"_5":15564,"_21706":50117,"_1911":86224},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2322":50126,"_22971":50117,"_15675":86226,"_5":15564,"_21706":86201,"_1911":86227},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2322":50127,"_22971":50117,"_15675":86229,"_5":15564,"_21706":86205,"_1911":86230},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2322":50128,"_22971":50117,"_15675":86232,"_5":15564,"_21706":86209,"_1911":86233},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2322":50129,"_22971":50117,"_15675":86235,"_5":15564,"_21706":86213,"_1911":86236},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2322":50130,"_22971":50117,"_15675":86238,"_5":15564,"_21706":86217,"_1911":86239},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2322":50131,"_22971":50131,"_5":10796,"_1911":86241,"_23246":86242,"_15675":86243,"_21706":50131},"Ciclo de vida de un certificado",[35713,84687,86194],[],{"_2322":50132,"_22971":50131,"_15675":86245,"_5":15564,"_21706":50131,"_1911":86246},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2322":50133,"_22971":50131,"_5":23243,"_15675":86248,"_21706":86249,"_1911":86250},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2322":50134,"_22971":50131,"_5":23243,"_15675":86252,"_21706":86253,"_1911":86254},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2322":50135,"_22971":50131,"_5":23243,"_15675":86256,"_21706":86257,"_1911":86258},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2322":50136,"_22971":50131,"_5":23243,"_15675":86260,"_21706":86261,"_1911":86262},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2322":50137,"_22971":50131,"_5":23243,"_15675":86264,"_21706":86265,"_1911":86266},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2322":50138,"_22971":50131,"_5":23243,"_15675":86268,"_21706":86269,"_1911":86270},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2322":50139,"_22971":50131,"_5":23243,"_15675":86272,"_21706":86273,"_1911":86274},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2322":50140,"_22971":50131,"_5":23243,"_15675":86276,"_21706":86277,"_1911":86278},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2322":50141,"_22971":50131,"_5":23243,"_15675":86280,"_21706":86281,"_1911":86282},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2322":50142,"_22971":50131,"_5":23243,"_15675":86284,"_21706":86285,"_1911":86286},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2322":50143,"_22971":50131,"_15675":86288,"_5":15564,"_21706":50131,"_1911":86289},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2322":50144,"_22971":50131,"_15675":86291,"_5":15564,"_21706":86253,"_1911":86292},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2322":50145,"_22971":50131,"_15675":86294,"_5":15564,"_21706":86257,"_1911":86295},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2322":50146,"_22971":50131,"_15675":86297,"_5":15564,"_21706":86261,"_1911":86298},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2322":50147,"_22971":50131,"_15675":86300,"_5":15564,"_21706":86265,"_1911":86301},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2322":50148,"_22971":50131,"_15675":86303,"_5":15564,"_21706":86269,"_1911":86304},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2322":50149,"_22971":50131,"_15675":86306,"_5":15564,"_21706":86273,"_1911":86307},[],"Lamassu persiste cuatro estados X.509:",{"_2322":50150,"_22971":50131,"_15675":86309,"_5":15564,"_21706":86273,"_1911":86310},[],"**`ACTIVE`**: el certificado está habilitado y dentro de su periodo de validez.",{"_2322":50151,"_22971":50131,"_15675":86312,"_5":15564,"_21706":86273,"_1911":86313},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2322":50152,"_22971":50131,"_15675":86315,"_5":15564,"_21706":86273,"_1911":86316},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2322":50153,"_22971":50131,"_15675":86318,"_5":15564,"_21706":86273,"_1911":86319},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2322":50154,"_22971":50131,"_15675":86321,"_5":15564,"_21706":86273,"_1911":86322},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2322":50155,"_22971":50131,"_15675":86324,"_5":15564,"_21706":86277,"_1911":86325},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2322":50156,"_22971":50131,"_15675":86327,"_5":15564,"_21706":86277,"_1911":86328},[],"Solo una revocación con razón `CertificateHold` puede revertirse. Una revocación con cualquier otra razón es definitiva en Lamassu.",{"_2322":50157,"_22971":50131,"_15675":86330,"_5":15564,"_21706":86277,"_1911":86331},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2322":50158,"_22971":50131,"_15675":86333,"_5":15564,"_21706":86281,"_1911":86334},[],"Revocar una CA es una operación en cascada. Lamassu revoca sus CAs hijas y los certificados que ha emitido con la razón `CessationOfOperation`. La propagación continúa por la jerarquía.",{"_2322":50159,"_22971":50131,"_15675":86336,"_5":15564,"_21706":86281,"_1911":86337},[],"Antes de confirmar:",{"_2322":50160,"_22971":50131,"_15675":86339,"_5":15564,"_21706":86281,"_1911":86340},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2322":50161,"_22971":50131,"_15675":86342,"_5":15564,"_21706":86281,"_1911":86343},[],"Distribuye la nueva cadena de confianza.",{"_2322":50162,"_22971":50131,"_15675":86345,"_5":15564,"_21706":86281,"_1911":86346},[],"Reemite las identidades necesarias.",{"_2322":50163,"_22971":50131,"_15675":86348,"_5":15564,"_21706":86281,"_1911":86349},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2322":50164,"_22971":50131,"_15675":86351,"_5":15564,"_21706":86281,"_1911":86352},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2322":50165,"_22971":50131,"_15675":86354,"_5":15564,"_21706":86281,"_1911":86355},[],"Dar de baja un dispositivo revoca sus certificados y le impide obtener nuevas identidades. Utiliza esta acción únicamente cuando el dispositivo se retire de forma permanente.",{"_2322":50166,"_22971":50131,"_15675":86357,"_5":15564,"_21706":86285,"_1911":86358},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2322":50167,"_22971":50131,"_15675":86360,"_5":15564,"_21706":86285,"_1911":86361},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2322":50168,"_22971":50131,"_15675":86363,"_5":15564,"_21706":86285,"_1911":86364},[],"Cambios de estado y razones de revocación.",{"_2322":50169,"_22971":50131,"_15675":86366,"_5":15564,"_21706":86285,"_1911":86367},[],"Publicación y vigencia de OCSP y CRLs.",{"_2322":50170,"_22971":50131,"_15675":86369,"_5":15564,"_21706":86285,"_1911":86370},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2322":50171,"_22971":50131,"_15675":86372,"_5":15564,"_21706":86285,"_1911":86373},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2322":50172,"_22971":50172,"_5":10796,"_1911":86375,"_23246":86376,"_15675":86377,"_21706":50172},"Glosario",[35713,84687,86194],[],{"_2322":50173,"_22971":50172,"_15675":86379,"_5":15564,"_21706":50172,"_1911":86380},[],"Términos de PKI, certificados y gestión de identidades usados en Lamassu.",{"_2322":50174,"_22971":50172,"_5":23243,"_15675":86382,"_21706":86383,"_1911":38545},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/glossary#ac",{"_2322":50175,"_22971":50172,"_5":23243,"_15675":86385,"_21706":86386,"_1911":38549},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/glossary#dk",{"_2322":50176,"_22971":50172,"_5":23243,"_15675":86388,"_21706":86389,"_1911":38553},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/glossary#mr",{"_2322":50177,"_22971":50172,"_5":23243,"_15675":86391,"_21706":86392,"_1911":38557},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/glossary#sz",{"_2322":50178,"_22971":50172,"_15675":86394,"_5":15564,"_21706":86383,"_1911":86395},[],"**AKI (Authority Key Identifier)**\\\nIdentificador de la clave pública de la autoridad que firmó un certificado. Ayuda a construir la cadena hacia el emisor correcto.",{"_2322":50179,"_22971":50172,"_15675":86397,"_5":15564,"_21706":86383,"_1911":86398},[],"**Ancla de confianza**\\\nCertificado, normalmente de una CA raíz, que un consumidor acepta de forma explícita como punto final de una cadena.",{"_2322":50180,"_22971":50172,"_15675":86400,"_5":15564,"_21706":86383,"_1911":86401},[],"**CA (Certification Authority)**\\\nAutoridad que firma certificados y vincula una identidad con una clave pública.",{"_2322":50181,"_22971":50172,"_15675":86403,"_5":15564,"_21706":86383,"_1911":86404},[],"**CA intermedia**\\\nCA firmada por otra autoridad. Se utiliza para emitir sin exponer la raíz a la operación diaria.",{"_2322":50182,"_22971":50172,"_15675":86406,"_5":15564,"_21706":86383,"_1911":86407},[],"**CA raíz**\\\nCA autofirmada que inicia una jerarquía de confianza.",{"_2322":50183,"_22971":50172,"_15675":86409,"_5":15564,"_21706":86383,"_1911":86410},[],"**Certificado X.509**\\\nDocumento firmado que contiene una clave pública, un sujeto, un emisor, un periodo de validez y extensiones que delimitan su uso.",{"_2322":50184,"_22971":50172,"_15675":86412,"_5":15564,"_21706":86383,"_1911":86413},[],"**CRL (Certificate Revocation List)**\\\nLista firmada de certificados revocados publicada por una CA.",{"_2322":50185,"_22971":50172,"_15675":86415,"_5":15564,"_21706":86383,"_1911":86416},[],"**CSR (Certificate Signing Request)**\\\nSolicitud PKCS#10 que contiene una clave pública y atributos solicitados. La firma de la CSR demuestra posesión de la clave privada correspondiente.",{"_2322":50186,"_22971":50172,"_15675":86418,"_5":15564,"_21706":86386,"_1911":86419},[],"**DMS (Device Management Service)**\\\nConfiguración que agrupa reglas de registro, enrolamiento, re-enrolamiento, emisión y distribución de CAs para una flota.",{"_2322":50187,"_22971":50172,"_15675":86421,"_5":15564,"_21706":86386,"_1911":86422},[],"**Distinguished Name (DN)**\\\nConjunto de atributos del sujeto o emisor, como `CN`, `O`, `OU`, `C`, `ST` y `L`.",{"_2322":50188,"_22971":50172,"_15675":86424,"_5":15564,"_21706":86386,"_1911":86425},[],"**EST (Enrollment over Secure Transport)**\\\nProtocolo definido en RFC 7030 para obtener CAs, enrolar y re-enrolar certificados sobre HTTPS.",{"_2322":50189,"_22971":50172,"_15675":86427,"_5":15564,"_21706":86386,"_1911":86428},[],"**Extended Key Usage (EKU)**\\\nExtensión que acota finalidades como autenticación de cliente, autenticación de servidor, firma de código u OCSP.",{"_2322":50190,"_22971":50172,"_15675":86430,"_5":15564,"_21706":86386,"_1911":86431},[],"**Identidad de dispositivo**\\\nRelación entre un dispositivo y uno de sus certificados. Un dispositivo puede conservar un historial de identidades.",{"_2322":50191,"_22971":50172,"_15675":86433,"_5":15564,"_21706":86386,"_1911":86434},[],"**Identity slot**\\\nPosición lógica en un dispositivo donde Lamassu vincula una identidad activa o histórica.",{"_2322":50192,"_22971":50172,"_15675":86436,"_5":15564,"_21706":86386,"_1911":86437},[],"**JITP (Just-in-Time Provisioning)**\\\nRegistro automático de un dispositivo cuando completa correctamente su primer enrolamiento.",{"_2322":50193,"_22971":50172,"_15675":86439,"_5":15564,"_21706":86386,"_1911":86440},[],"**KMS (Key Management Service)**\\\nServicio de Lamassu que normaliza generación, importación y uso de claves sobre distintos motores criptográficos.",{"_2322":50194,"_22971":50172,"_15675":86442,"_5":15564,"_21706":86386,"_1911":86443},[],"**Key Usage**\\\nExtensión X.509 que permite operaciones básicas como firma digital, cifrado de clave o firma de certificados.",{"_2322":50195,"_22971":50172,"_15675":86445,"_5":15564,"_21706":86389,"_1911":86446},[],"**mTLS (Mutual TLS)**\\\nTLS donde cliente y servidor presentan certificados. Un DMS puede usar el certificado cliente como método de autenticación.",{"_2322":50196,"_22971":50172,"_15675":86448,"_5":15564,"_21706":86389,"_1911":86449},[],"**OCSP (Online Certificate Status Protocol)**\\\nProtocolo para consultar en línea si un certificado está vigente, revocado o es desconocido.",{"_2322":50197,"_22971":50172,"_15675":86451,"_5":15564,"_21706":86389,"_1911":86452},[],"**Perfil de emisión**\\\nPolítica reutilizable que define cómo Lamassu construye un certificado y qué claves acepta.",{"_2322":50198,"_22971":50172,"_15675":86454,"_5":15564,"_21706":86389,"_1911":86455},[],"**Principal**\\\nIdentidad de operador o cliente de API reconocida por el servicio de autorización. Lamassu admite principales OIDC y X.509.",{"_2322":50199,"_22971":50172,"_15675":86457,"_5":15564,"_21706":86389,"_1911":86458},[],"**Política**\\\nConjunto de permisos asignable a uno o varios principales.",{"_2322":50200,"_22971":50172,"_15675":86460,"_5":15564,"_21706":86389,"_1911":86461},[],"**RA (Registration Authority)**\\\nComponente que verifica al solicitante antes de pedir a una CA que emita. El DMS cumple este papel en los flujos de enrolamiento de dispositivos.",{"_2322":50201,"_22971":50172,"_15675":86463,"_5":15564,"_21706":86389,"_1911":86464},[],"**Relying party**\\\nSistema consumidor que decide si acepta un certificado presentado.",{"_2322":50202,"_22971":50172,"_15675":86466,"_5":15564,"_21706":86389,"_1911":86467},[],"**Revocación**\\\nInvalidación de un certificado antes de su fecha de expiración.",{"_2322":50203,"_22971":50172,"_15675":86469,"_5":15564,"_21706":86392,"_1911":86470},[],"**SAN (Subject Alternative Name)**\\\nExtensión que añade identidades como nombres DNS, direcciones IP, correos o URIs.",{"_2322":50204,"_22971":50172,"_15675":86472,"_5":15564,"_21706":86392,"_1911":86473},[],"**SKI (Subject Key Identifier)**\\\nIdentificador derivado de la clave pública del propio certificado.",{"_2322":50205,"_22971":50172,"_15675":86475,"_5":15564,"_21706":86392,"_1911":86476},[],"**VA (Validation Authority)**\\\nServicio de Lamassu responsable de las respuestas OCSP y la generación o publicación de CRLs.",{"_2322":50206,"_22971":50172,"_15675":86478,"_5":15564,"_21706":86392,"_1911":86479},[],"**Ventana de renovación**\\\nPeriodo anterior a la expiración durante el que un dispositivo puede o debe solicitar otra identidad.",{"_2322":50207,"_22971":50172,"_15675":86481,"_5":15564,"_21706":86392,"_1911":86482},[],"¿Falta un término operativo? Consulta primero Cómo funciona Lamassu y el Modelo de confianza, donde estos conceptos aparecen conectados.",{"_2322":50208,"_22971":50208,"_5":10796,"_1911":86484,"_23246":86485,"_15675":86486,"_21706":50208},"Cómo funciona Lamassu",[35713,84687,86194],[],{"_2322":50209,"_22971":50208,"_15675":86488,"_5":15564,"_21706":50208,"_1911":86489},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2322":50210,"_22971":50208,"_5":23243,"_15675":86491,"_21706":86492,"_1911":86493},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2322":50211,"_22971":50208,"_5":23243,"_15675":86495,"_21706":86496,"_1911":86497},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2322":50212,"_22971":50208,"_15675":86499,"_5":15564,"_21706":50208,"_1911":86500},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2322":50213,"_22971":50208,"_15675":86502,"_5":15564,"_21706":86492,"_1911":86503},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2322":50214,"_22971":50208,"_15675":86505,"_5":15564,"_21706":86492,"_1911":86506},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2322":50215,"_22971":50208,"_15675":86508,"_5":15564,"_21706":86492,"_1911":86509},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2322":50216,"_22971":50208,"_15675":86511,"_5":15564,"_21706":86492,"_1911":86512},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2322":50217,"_22971":50208,"_15675":86514,"_5":15564,"_21706":86492,"_1911":86515},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2322":50218,"_22971":50208,"_15675":86517,"_5":15564,"_21706":86496,"_1911":86518},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2322":50219,"_22971":50208,"_15675":86520,"_5":15564,"_21706":86496,"_1911":86521},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2322":50220,"_22971":50208,"_15675":86523,"_5":15564,"_21706":86496,"_1911":86524},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2322":50221,"_22971":50208,"_15675":86526,"_5":15564,"_21706":86496,"_1911":86527},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2322":50222,"_22971":50208,"_15675":86529,"_5":15564,"_21706":86496,"_1911":86530},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2322":50223,"_22971":50208,"_15675":86532,"_5":15564,"_21706":86496,"_1911":86533},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/pki/concepts/architecture\" />",{"_2322":50224,"_22971":50208,"_15675":86535,"_5":15564,"_21706":86496,"_1911":86536},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2322":50225,"_22971":50225,"_5":10796,"_1911":86538,"_23246":86539,"_15675":86540,"_21706":50225},"Modelo de confianza",[35713,84687,86194],[],{"_2322":50226,"_22971":50225,"_15675":86542,"_5":15564,"_21706":50225,"_1911":86543},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2322":50227,"_22971":50225,"_5":23243,"_15675":86545,"_21706":86546,"_1911":86547},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2322":50228,"_22971":50225,"_5":23243,"_15675":86549,"_21706":86550,"_1911":86551},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2322":50229,"_22971":50225,"_5":23243,"_15675":86553,"_21706":86554,"_1911":86555},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2322":50230,"_22971":50225,"_5":23243,"_15675":86557,"_21706":86558,"_1911":86559},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2322":50231,"_22971":50225,"_5":23243,"_15675":86561,"_21706":86562,"_1911":86563},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2322":50232,"_22971":50225,"_5":23243,"_15675":86565,"_21706":86566,"_1911":86567},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2322":50233,"_22971":50225,"_5":23243,"_15675":86569,"_21706":86570,"_1911":86571},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2322":50234,"_22971":50225,"_5":23243,"_15675":86573,"_21706":86574,"_1911":86575},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2322":50235,"_22971":50225,"_5":23243,"_15675":86577,"_21706":86578,"_1911":86579},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2322":50236,"_22971":50225,"_5":23243,"_15675":86581,"_21706":86582,"_1911":86583},[],"/docs/pr-preview/pr-28/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2322":50237,"_22971":50225,"_15675":86585,"_5":15564,"_21706":50225,"_1911":86586},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2322":50238,"_22971":50225,"_15675":86588,"_5":15564,"_21706":86550,"_1911":86589},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2322":50239,"_22971":50225,"_15675":86591,"_5":15564,"_21706":86554,"_1911":86592},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2322":50240,"_22971":50225,"_15675":86594,"_5":15564,"_21706":86558,"_1911":86595},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2322":50241,"_22971":50225,"_15675":86597,"_5":15564,"_21706":86562,"_1911":86598},[],"El servicio o dispositivo consumidor mantiene su propio almacén de confianza. Lamassu puede distribuir la CA del sistema, la CA de enrolamiento y otras CAs gestionadas mediante `/cacerts`, pero el consumidor decide cuáles instala y cómo aplica la validación.",{"_2322":50242,"_22971":50225,"_15675":86600,"_5":15564,"_21706":86566,"_1911":86601},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2322":50243,"_22971":50225,"_15675":86603,"_5":15564,"_21706":86566,"_1911":86604},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2322":50244,"_22971":50225,"_15675":86606,"_5":15564,"_21706":86566,"_1911":86607},[],"La CA aplica el perfil y firma sin recibir la clave privada del dispositivo.",{"_2322":50245,"_22971":50225,"_15675":86609,"_5":15564,"_21706":86566,"_1911":86610},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2322":50246,"_22971":50225,"_15675":86612,"_5":15564,"_21706":86566,"_1911":86613},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2322":50247,"_22971":50225,"_15675":86615,"_5":15564,"_21706":86566,"_1911":86616},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2322":50248,"_22971":50225,"_15675":86618,"_5":15564,"_21706":86570,"_1911":86619},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2322":50249,"_22971":50225,"_15675":86621,"_5":15564,"_21706":86570,"_1911":86622},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2322":50250,"_22971":50225,"_15675":86624,"_5":15564,"_21706":86570,"_1911":86625},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2322":50251,"_22971":50225,"_15675":86627,"_5":15564,"_21706":86570,"_1911":86628},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir la CA del sistema, la CA de enrolamiento y una lista de CAs gestionadas.",{"_2322":50252,"_22971":50225,"_15675":86630,"_5":15564,"_21706":86570,"_1911":86631},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2322":50253,"_22971":50225,"_15675":86633,"_5":15564,"_21706":86574,"_1911":86634},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2322":50254,"_22971":50225,"_15675":86636,"_5":15564,"_21706":86574,"_1911":86637},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2322":50255,"_22971":50225,"_15675":86639,"_5":15564,"_21706":86574,"_1911":86640},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2322":50256,"_22971":50225,"_15675":86642,"_5":15564,"_21706":86574,"_1911":86643},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2322":50257,"_22971":50225,"_15675":86645,"_5":15564,"_21706":86574,"_1911":86646},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2322":50258,"_22971":50225,"_15675":86648,"_5":15564,"_21706":86574,"_1911":86649},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2322":50259,"_22971":50225,"_15675":86651,"_5":15564,"_21706":86578,"_1911":86652},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2322":50260,"_22971":50225,"_15675":86654,"_5":15564,"_21706":86582,"_1911":86655},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2322":50261,"_22971":50225,"_15675":86657,"_5":15564,"_21706":86582,"_1911":86658},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2322":50262,"_22971":50225,"_15675":86660,"_5":15564,"_21706":86582,"_1911":86661},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2322":50263,"_22971":50225,"_15675":86663,"_5":15564,"_21706":86582,"_1911":86664},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2322":50264,"_22971":50225,"_15675":86666,"_5":15564,"_21706":86582,"_1911":86667},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2322":50265,"_22971":50225,"_15675":86669,"_5":15564,"_21706":86582,"_1911":86670},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2322":50266,"_22971":50225,"_15675":86672,"_5":15564,"_21706":86582,"_1911":86673},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2322":50267,"_22971":50267,"_5":10796,"_1911":86675,"_23246":86676,"_15675":86677,"_21706":50267},"Listas de revocación (CRL)",[35713,84687,85221],[],{"_2322":50268,"_22971":50267,"_15675":86679,"_5":15564,"_21706":50267,"_1911":86680},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2322":50269,"_22971":50267,"_5":23243,"_15675":86682,"_21706":86683,"_1911":86684},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#servicio-crl","Servicio CRL",{"_2322":50270,"_22971":50267,"_5":23243,"_15675":86686,"_21706":86687,"_1911":86688},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2322":50271,"_22971":50267,"_5":23243,"_15675":86690,"_21706":86691,"_1911":86692},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2322":50272,"_22971":50267,"_5":23243,"_15675":86694,"_21706":86695,"_1911":86696},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2322":50273,"_22971":50267,"_5":23243,"_15675":86698,"_21706":86699,"_1911":86700},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2322":50274,"_22971":50267,"_5":23243,"_15675":86702,"_21706":86703,"_1911":86704},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2322":50275,"_22971":50267,"_5":23243,"_15675":86706,"_21706":86707,"_1911":86708},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2322":50276,"_22971":50267,"_5":23243,"_15675":86710,"_21706":86711,"_1911":86712},[],"/docs/pr-preview/pr-28/es/platform/pki/crl#referencias","Referencias",{"_2322":50277,"_22971":50267,"_15675":86714,"_5":15564,"_21706":86683,"_1911":86715},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_2322":50278,"_22971":50267,"_15675":86717,"_5":15564,"_21706":86683,"_1911":86718},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_2322":50279,"_22971":50267,"_15675":86720,"_5":15564,"_21706":86687,"_1911":86721},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_2322":50280,"_22971":50267,"_15675":86723,"_5":15564,"_21706":86687,"_1911":86724},[],"Los parámetros principales son:",{"_2322":50281,"_22971":50267,"_15675":86726,"_5":15564,"_21706":86687,"_1911":86727},[],"**`validity`** define el periodo de validez reflejado en `nextUpdate`. Su valor predeterminado es 7 días.",{"_2322":50282,"_22971":50267,"_15675":86729,"_5":15564,"_21706":86687,"_1911":86730},[],"**`refresh_interval`** establece el intervalo mínimo entre regeneraciones programadas. Por defecto es aproximadamente 6 días y 23 horas.",{"_2322":50283,"_22971":50267,"_15675":86732,"_5":15564,"_21706":86687,"_1911":86733},[],"**`regenerate_on_revoke`** ordena publicar una versión nueva inmediatamente después de una revocación. Está activo por defecto.",{"_2322":50284,"_22971":50267,"_15675":86735,"_5":15564,"_21706":86687,"_1911":86736},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_2322":50285,"_22971":50267,"_15675":86738,"_5":15564,"_21706":86687,"_1911":86739},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_2322":50286,"_22971":50267,"_15675":86741,"_5":15564,"_21706":86691,"_1911":86742},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_2322":50287,"_22971":50267,"_15675":86744,"_5":15564,"_21706":86691,"_1911":86745},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_2322":50288,"_22971":50267,"_15675":86747,"_5":15564,"_21706":86695,"_1911":86748},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_2322":50289,"_22971":50267,"_15675":86750,"_5":15564,"_21706":86695,"_1911":86751},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_2322":50290,"_22971":50267,"_15675":86753,"_5":15564,"_21706":86699,"_1911":86754},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_2322":50291,"_22971":50267,"_15675":86756,"_5":15564,"_21706":86699,"_1911":86757},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_2322":50292,"_22971":50267,"_15675":86759,"_5":15564,"_21706":86703,"_1911":86760},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_2322":50293,"_22971":50267,"_15675":86762,"_5":15564,"_21706":86703,"_1911":86763},[],"Método",{"_2322":50294,"_22971":50267,"_15675":86765,"_5":15564,"_21706":86703,"_1911":86766},[],"Ruta",{"_2322":50295,"_22971":50267,"_15675":86768,"_5":15564,"_21706":86703,"_1911":86769},[],"Descripción",{"_2322":50296,"_22971":50267,"_15675":86771,"_5":15564,"_21706":86703,"_1911":38937},[],{"_2322":50297,"_22971":50267,"_15675":86773,"_5":15564,"_21706":86703,"_1911":38940},[],{"_2322":50298,"_22971":50267,"_15675":86775,"_5":15564,"_21706":86703,"_1911":86776},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_2322":50299,"_22971":50267,"_15675":86778,"_5":15564,"_21706":86703,"_1911":38946},[],{"_2322":50300,"_22971":50267,"_15675":86780,"_5":15564,"_21706":86703,"_1911":38940},[],{"_2322":50301,"_22971":50267,"_15675":86782,"_5":15564,"_21706":86703,"_1911":86783},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_2322":50302,"_22971":50267,"_15675":86785,"_5":15564,"_21706":86703,"_1911":86786},[],"Ejemplo de consulta del rol VA:",{"_2322":50303,"_22971":50267,"_15675":86788,"_5":15564,"_21706":86703,"_1911":86789},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_2322":50304,"_22971":50267,"_15675":86791,"_5":15564,"_21706":86707,"_1911":86792},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_2322":50305,"_22971":50267,"_15675":86794,"_5":15564,"_21706":86711,"_1911":38963},[],{"_2322":50306,"_22971":50267,"_15675":86796,"_5":15564,"_21706":86711,"_1911":86797},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2322":50307,"_22971":50267,"_15675":86799,"_5":15564,"_21706":86711,"_1911":86800},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2322":50308,"_22971":50308,"_5":10796,"_1911":38971,"_23246":86802,"_15675":86803,"_21706":50308},[35713,84687,85221],[],{"_2322":50309,"_22971":50308,"_15675":86805,"_5":15564,"_21706":50308,"_1911":86806},[],"Define cómo una flota recibe, renueva y utiliza sus identidades.",{"_2322":50310,"_22971":50308,"_5":23243,"_15675":86808,"_21706":86809,"_1911":83598},[],"/docs/pr-preview/pr-28/es/platform/pki/device-enrollment#antes-de-empezar",{"_2322":50311,"_22971":50308,"_5":23243,"_15675":86811,"_21706":86812,"_1911":86813},[],"/docs/pr-preview/pr-28/es/platform/pki/device-enrollment#configura-un-dms","Configura un DMS",{"_2322":50312,"_22971":50308,"_5":23243,"_15675":86815,"_21706":86816,"_1911":86817},[],"/docs/pr-preview/pr-28/es/platform/pki/device-enrollment#identifica-la-flota","Identifica la flota",{"_2322":50313,"_22971":50308,"_5":23243,"_15675":86819,"_21706":86820,"_1911":86821},[],"/docs/pr-preview/pr-28/es/platform/pki/device-enrollment#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2322":50314,"_22971":50308,"_5":23243,"_15675":86823,"_21706":86824,"_1911":86825},[],"/docs/pr-preview/pr-28/es/platform/pki/device-enrollment#configura-est","Configura EST",{"_2322":50315,"_22971":50308,"_5":23243,"_15675":86827,"_21706":86828,"_1911":86829},[],"/docs/pr-preview/pr-28/es/platform/pki/device-enrollment#distribuye-la-confianza","Distribuye la confianza",{"_2322":50316,"_22971":50308,"_5":23243,"_15675":86831,"_21706":86832,"_1911":86833},[],"/docs/pr-preview/pr-28/es/platform/pki/device-enrollment#verifica-los-endpoints","Verifica los endpoints",{"_2322":50317,"_22971":50308,"_5":23243,"_15675":86835,"_21706":86836,"_1911":86837},[],"/docs/pr-preview/pr-28/es/platform/pki/device-enrollment#distribución-de-confianza","Distribución de confianza",{"_2322":50318,"_22971":50308,"_5":23243,"_15675":86839,"_21706":86840,"_1911":86841},[],"/docs/pr-preview/pr-28/es/platform/pki/device-enrollment#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2322":50319,"_22971":50308,"_5":23243,"_15675":86843,"_21706":86844,"_1911":86845},[],"/docs/pr-preview/pr-28/es/platform/pki/device-enrollment#integra-los-dispositivos","Integra los dispositivos",{"_2322":50320,"_22971":50308,"_15675":86847,"_5":15564,"_21706":50308,"_1911":86848},[],"Un &#x2A;*Device Management Service (DMS)** actúa como autoridad de registro frente a una flota. Recibe solicitudes, aplica la política de autenticación y encarga la emisión a la CA configurada.",{"_2322":50321,"_22971":50308,"_15675":86850,"_5":15564,"_21706":50308,"_1911":86851},[],"Cada DMS es un límite operativo independiente: puede representar una línea de producto, un entorno o un tipo de dispositivo con su propia CA, reglas de autenticación, confianza distribuida y ventana de renovación.",{"_2322":50322,"_22971":50308,"_15675":86853,"_5":15564,"_21706":86809,"_1911":86854},[],"Crea o importa al menos una CA activa.",{"_2322":50323,"_22971":50308,"_15675":86856,"_5":15564,"_21706":86809,"_1911":86857},[],"Decide cómo se autenticarán los dispositivos durante el primer enrolamiento.",{"_2322":50324,"_22971":50308,"_15675":86859,"_5":15564,"_21706":86809,"_1911":86860},[],"Define qué autoridades debe recibir el dispositivo como anclas de confianza.",{"_2322":50325,"_22971":50308,"_15675":86862,"_5":15564,"_21706":86809,"_1911":86863},[],"Asegúrate de tener permisos para administrar DMS.",{"_2322":50326,"_22971":50308,"_15675":86865,"_5":15564,"_21706":86816,"_1911":86866},[],"Asigna al DMS un nombre que describa su alcance, por ejemplo una familia de dispositivos o un entorno.",{"_2322":50327,"_22971":50308,"_15675":86868,"_5":15564,"_21706":86820,"_1911":86869},[],"Elige la autoridad que emitirá las identidades. Su política y periodo de validez condicionan los certificados que podrá obtener la flota.",{"_2322":50328,"_22971":50308,"_15675":86871,"_5":15564,"_21706":86824,"_1911":86872},[],"Define la autenticación de `enroll`, la política de `reenroll`, la ventana de renovación y, si se necesita, `serverkeygen`.",{"_2322":50329,"_22971":50308,"_15675":86874,"_5":15564,"_21706":86828,"_1911":86875},[],"Configura **CA Distribution** para controlar la respuesta del endpoint `cacerts`.",{"_2322":50330,"_22971":50308,"_15675":86877,"_5":15564,"_21706":86832,"_1911":86878},[],"Desde el menú del DMS, abre &#x2A;*EST (RFC-7030)** y comprueba la URL base y los ejemplos de invocación antes de integrar el firmware.",{"_2322":50331,"_22971":50308,"_15675":86880,"_5":15564,"_21706":86836,"_1911":86881},[],"**Include Lamassu System CA** distribuye el certificado TLS del servidor Lamassu, útil para *pinning*. No representa una CA de emisión.",{"_2322":50332,"_22971":50308,"_15675":86883,"_5":15564,"_21706":86836,"_1911":86884},[],"**Include Enrollment CA** añade la autoridad configurada para emitir las identidades del DMS.",{"_2322":50333,"_22971":50308,"_15675":86886,"_5":15564,"_21706":86836,"_1911":86887},[],"**Managed CAs** permite incluir autoridades adicionales que el dispositivo debe considerar de confianza.",{"_2322":50334,"_22971":50308,"_15675":86889,"_5":15564,"_21706":86840,"_1911":86890},[],"**Edit** modifica la política del DMS.",{"_2322":50335,"_22971":50308,"_15675":86892,"_5":15564,"_21706":86840,"_1911":86893},[],"**Go to DMS owned devices** abre únicamente los dispositivos de esa flota.",{"_2322":50336,"_22971":50308,"_15675":86895,"_5":15564,"_21706":86840,"_1911":86896},[],"**Show/Edit Metadata** permite gestionar configuración avanzada y datos de integraciones.",{"_2322":50337,"_22971":50308,"_15675":86898,"_5":15564,"_21706":86840,"_1911":86899},[],"**EST (RFC-7030)** muestra los endpoints y ejemplos específicos del DMS.",{"_2322":50338,"_22971":50308,"_15675":86901,"_5":15564,"_21706":86840,"_1911":86902},[],"**Delete** elimina el DMS y su configuración. La acción es irreversible.",{"_2322":50339,"_22971":50308,"_15675":86904,"_5":15564,"_21706":86844,"_1911":86905},[],"<Card title=\"Enrolamiento EST\" description=\"Configura autenticación, endpoints y flujos para firmware.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2322":50340,"_22971":50308,"_15675":86907,"_5":15564,"_21706":86844,"_1911":86908},[],"<Card title=\"Dispositivos e identidades\" description=\"Consulta estados, historial y acciones operativas.\" href=\"/docs/platform/pki/device-management\" />",{"_2322":50341,"_22971":50341,"_5":10796,"_1911":86910,"_23246":86911,"_15675":86912,"_21706":50341},"Dispositivos e identidades",[35713,84687,85221],[],{"_2322":50342,"_22971":50341,"_15675":86914,"_5":15564,"_21706":50341,"_1911":86915},[],"Registra dispositivos y controla sus identidades durante todo el ciclo de vida.",{"_2322":50343,"_22971":50341,"_5":23243,"_15675":86917,"_21706":86918,"_1911":86919},[],"/docs/pr-preview/pr-28/es/platform/pki/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2322":50344,"_22971":50341,"_5":23243,"_15675":86921,"_21706":86922,"_1911":86923},[],"/docs/pr-preview/pr-28/es/platform/pki/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2322":50345,"_22971":50341,"_5":23243,"_15675":86925,"_21706":86926,"_1911":86927},[],"/docs/pr-preview/pr-28/es/platform/pki/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2322":50346,"_22971":50341,"_5":23243,"_15675":86929,"_21706":86930,"_1911":86931},[],"/docs/pr-preview/pr-28/es/platform/pki/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2322":50347,"_22971":50341,"_5":23243,"_15675":86933,"_21706":86934,"_1911":86935},[],"/docs/pr-preview/pr-28/es/platform/pki/device-management#define-su-pertenencia","Define su pertenencia",{"_2322":50348,"_22971":50341,"_5":23243,"_15675":86937,"_21706":86938,"_1911":86939},[],"/docs/pr-preview/pr-28/es/platform/pki/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2322":50349,"_22971":50341,"_5":23243,"_15675":86941,"_21706":86942,"_1911":86943},[],"/docs/pr-preview/pr-28/es/platform/pki/device-management#verifica-el-alta","Verifica el alta",{"_2322":50350,"_22971":50341,"_5":23243,"_15675":86945,"_21706":86946,"_1911":86947},[],"/docs/pr-preview/pr-28/es/platform/pki/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2322":50351,"_22971":50341,"_5":23243,"_15675":86949,"_21706":86950,"_1911":86951},[],"/docs/pr-preview/pr-28/es/platform/pki/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2322":50352,"_22971":50341,"_5":23243,"_15675":86953,"_21706":86954,"_1911":86955},[],"/docs/pr-preview/pr-28/es/platform/pki/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2322":50353,"_22971":50341,"_5":23243,"_15675":86957,"_21706":86958,"_1911":86959},[],"/docs/pr-preview/pr-28/es/platform/pki/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2322":50354,"_22971":50341,"_15675":86961,"_5":15564,"_21706":50341,"_1911":86962},[],"Un dispositivo gestionado representa una entidad de tu flota y conserva el historial de los certificados que ha utilizado. Lamassu separa el dispositivo de su identidad actual para que puedas renovar o sustituir certificados sin perder trazabilidad.",{"_2322":50355,"_22971":50341,"_15675":86964,"_5":15564,"_21706":86918,"_1911":86965},[],"**Active** indica que el dispositivo tiene una identidad válida.",{"_2322":50356,"_22971":50341,"_15675":86967,"_5":15564,"_21706":86918,"_1911":86968},[],"**No Identity** aparece cuando está registrado, pero todavía no tiene un certificado asociado.",{"_2322":50357,"_22971":50341,"_15675":86970,"_5":15564,"_21706":86918,"_1911":86971},[],"**Renewal Pending** señala que ha entrado en la ventana de renovación.",{"_2322":50358,"_22971":50341,"_15675":86973,"_5":15564,"_21706":86918,"_1911":86974},[],"**Expiring Soon** advierte que el certificado está próximo a expirar.",{"_2322":50359,"_22971":50341,"_15675":86976,"_5":15564,"_21706":86918,"_1911":86977},[],"**Expired** indica que la identidad ha superado su fecha de validez.",{"_2322":50360,"_22971":50341,"_15675":86979,"_5":15564,"_21706":86918,"_1911":86980},[],"**Revoked** identifica un certificado invalidado antes de su expiración.",{"_2322":50361,"_22971":50341,"_15675":86982,"_5":15564,"_21706":86918,"_1911":86983},[],"**Decommissioned** corresponde a un dispositivo retirado de forma permanente.",{"_2322":50362,"_22971":50341,"_15675":86985,"_5":15564,"_21706":86918,"_1911":86986},[],"El inventario permite filtrar por `Device ID`, etiquetas y estado.",{"_2322":50363,"_22971":50341,"_15675":86988,"_5":15564,"_21706":86922,"_1911":86989},[],"La vista de detalle separa dos perspectivas:",{"_2322":50364,"_22971":50341,"_15675":86991,"_5":15564,"_21706":86922,"_1911":86992},[],"**Certificate History** conserva todos los certificados asociados, con su número de serie, emisor, estado y periodo de validez.",{"_2322":50365,"_22971":50341,"_15675":86994,"_5":15564,"_21706":86922,"_1911":86995},[],"**Device Event Timeline** ordena cronológicamente registros, enrolamientos, renovaciones y cambios de estado.",{"_2322":50366,"_22971":50341,"_15675":86997,"_5":15564,"_21706":86922,"_1911":86998},[],"Utiliza el historial para auditoría y la línea de tiempo para reconstruir un incidente o diagnosticar una transición inesperada.",{"_2322":50367,"_22971":50341,"_15675":87000,"_5":15564,"_21706":86926,"_1911":87001},[],"El registro previo es útil cuando la política exige que el dispositivo exista antes de solicitar su primer certificado.",{"_2322":50368,"_22971":50341,"_15675":87003,"_5":15564,"_21706":86930,"_1911":87004},[],"Desde **Managed Devices**, abre el formulario de registro.",{"_2322":50369,"_22971":50341,"_15675":87006,"_5":15564,"_21706":86934,"_1911":87007},[],"Introduce un **Device ID** único y selecciona el DMS que aplicará las políticas de enrolamiento y renovación.",{"_2322":50370,"_22971":50341,"_15675":87009,"_5":15564,"_21706":86938,"_1911":87010},[],"Añade un icono y etiquetas si necesitas agruparlo por modelo, ubicación, entorno u otro criterio operativo.",{"_2322":50371,"_22971":50341,"_15675":87012,"_5":15564,"_21706":86942,"_1911":87013},[],"El dispositivo debe aparecer con estado **No Identity** hasta que complete el enrolamiento o reciba una identidad manual.",{"_2322":50372,"_22971":50341,"_15675":87015,"_5":15564,"_21706":86946,"_1911":87016},[],"La acción **Assign Identity** está disponible mientras el dispositivo permanece en **No Identity**.",{"_2322":50373,"_22971":50341,"_15675":87018,"_5":15564,"_21706":86946,"_1911":87019},[],"Abre el dispositivo y selecciona **Assign Identity**.",{"_2322":50374,"_22971":50341,"_15675":87021,"_5":15564,"_21706":86946,"_1911":87022},[],"Elige un certificado activo cuyo `Common Name` coincida con el `Device ID`.",{"_2322":50375,"_22971":50341,"_15675":87024,"_5":15564,"_21706":86946,"_1911":87025},[],"Si no existe, selecciona **Issue New Instead** y elige una CA vinculada al DMS.",{"_2322":50376,"_22971":50341,"_15675":87027,"_5":15564,"_21706":86946,"_1911":87028},[],"Confirma la asignación.",{"_2322":50377,"_22971":50341,"_15675":87030,"_5":15564,"_21706":86946,"_1911":87031},[],"El dispositivo debe cambiar a **Active** y el certificado debe aparecer en su historial.",{"_2322":50378,"_22971":50341,"_15675":87033,"_5":15564,"_21706":86950,"_1911":87034},[],"En **Device Event Timeline**, localiza el último certificado activo y selecciona **Revoke**. Elige una razón conforme a tu política y confirma la operación.",{"_2322":50379,"_22971":50341,"_15675":87036,"_5":15564,"_21706":86950,"_1911":87037},[],"La revocación invalida el certificado, pero no elimina el dispositivo. Puedes restaurar su operación asignándole una identidad nueva. `CertificateHold` permite reactivar el certificado retenido; el resto de razones son definitivas.",{"_2322":50380,"_22971":50341,"_15675":87039,"_5":15564,"_21706":86954,"_1911":87040},[],"Esta acción revoca todos los certificados del dispositivo e impide que vuelva a obtener una identidad.",{"_2322":50381,"_22971":50341,"_15675":87042,"_5":15564,"_21706":86954,"_1911":87043},[],"Usa **Decommission** únicamente cuando el dispositivo haya dejado de operar o ya no sea fiable. Tras confirmar, Lamassu revoca la identidad activa con `CessationOfOperation` y cambia el estado a **Decommissioned**.",{"_2322":50382,"_22971":50341,"_15675":87045,"_5":15564,"_21706":86958,"_1911":87046},[],"<Card title=\"Configura un DMS\" description=\"Define la CA, confianza y políticas de la flota.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2322":50383,"_22971":50341,"_15675":87048,"_5":15564,"_21706":86958,"_1911":87049},[],"<Card title=\"Integra EST\" description=\"Permite que el dispositivo solicite y renueve su identidad.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2322":50384,"_22971":50384,"_5":10796,"_1911":87051,"_23246":87052,"_15675":87053,"_21706":50384},"Enrolamiento de dispositivos con EST",[35713,84687,85221],[],{"_2322":50385,"_22971":50384,"_15675":87055,"_5":15564,"_21706":50384,"_1911":87056},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_2322":50386,"_22971":50384,"_5":23243,"_15675":87058,"_21706":87059,"_1911":39230},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#est-enrollment-over-secure-transport",{"_2322":50387,"_22971":50384,"_5":23243,"_15675":87061,"_21706":87062,"_1911":87063},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#configuración-del-dms","Configuración del DMS",{"_2322":50388,"_22971":50384,"_5":23243,"_15675":87065,"_21706":87066,"_1911":87067},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#requisitos-previos","Requisitos previos",{"_2322":50389,"_22971":50384,"_5":23243,"_15675":87069,"_21706":87070,"_1911":87071},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#configuración-de-enrollment","Configuración de enrollment",{"_2322":50390,"_22971":50384,"_5":23243,"_15675":87073,"_21706":87074,"_1911":39246},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#enrollment-device-registration",{"_2322":50391,"_22971":50384,"_5":23243,"_15675":87076,"_21706":87077,"_1911":39250},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#enrollment-settings",{"_2322":50392,"_22971":50384,"_5":23243,"_15675":87079,"_21706":87080,"_1911":87081},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#perfil-de-emisión","Perfil de emisión",{"_2322":50393,"_22971":50384,"_5":23243,"_15675":87083,"_21706":87084,"_1911":87085},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2322":50394,"_22971":50384,"_5":23243,"_15675":87087,"_21706":87088,"_1911":87089},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_2322":50395,"_22971":50384,"_5":23243,"_15675":87091,"_21706":87092,"_1911":87093},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#verificar-la-configuración","Verificar la configuración",{"_2322":50396,"_22971":50384,"_5":23243,"_15675":87095,"_21706":87096,"_1911":87097},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#integración-de-dispositivos","Integración de dispositivos",{"_2322":50397,"_22971":50384,"_5":23243,"_15675":87099,"_21706":87100,"_1911":83598},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#antes-de-empezar",{"_2322":50398,"_22971":50384,"_5":23243,"_15675":87102,"_21706":87103,"_1911":87104},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#resumen-del-flujo","Resumen del flujo",{"_2322":50399,"_22971":50384,"_5":23243,"_15675":87106,"_21706":87107,"_1911":87108},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_2322":50400,"_22971":50384,"_5":23243,"_15675":87110,"_21706":87111,"_1911":87112},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#referencia-de-endpoints","Referencia de endpoints",{"_2322":50401,"_22971":50384,"_5":23243,"_15675":87114,"_21706":87115,"_1911":39289},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#cacerts",{"_2322":50402,"_22971":50384,"_5":23243,"_15675":87117,"_21706":87118,"_1911":39293},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#simpleenroll",{"_2322":50403,"_22971":50384,"_5":23243,"_15675":87120,"_21706":87121,"_1911":39297},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#simplereenroll",{"_2322":50404,"_22971":50384,"_5":23243,"_15675":87123,"_21706":87124,"_1911":39301},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#serverkeygen",{"_2322":50405,"_22971":50384,"_5":23243,"_15675":87126,"_21706":87127,"_1911":87128},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#flujos-completos","Flujos completos",{"_2322":50406,"_22971":50384,"_5":23243,"_15675":87130,"_21706":87131,"_1911":87132},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_2322":50407,"_22971":50384,"_5":23243,"_15675":87134,"_21706":87135,"_1911":87136},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_2322":50408,"_22971":50384,"_5":23243,"_15675":87138,"_21706":87139,"_1911":87140},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_2322":50409,"_22971":50384,"_5":23243,"_15675":87142,"_21706":87143,"_1911":87144},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2322":50410,"_22971":50384,"_5":23243,"_15675":87146,"_21706":87147,"_1911":87148},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2322":50411,"_22971":50384,"_5":23243,"_15675":87150,"_21706":87151,"_1911":87152},[],"/docs/pr-preview/pr-28/es/platform/pki/est-enrollment#notas-de-compatibilidad","Notas de compatibilidad",{"_2322":50412,"_22971":50384,"_15675":87154,"_5":15564,"_21706":87059,"_1911":87155},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación. Así, actúa como autoridad de registro (RA) frente al cliente.",{"_2322":50413,"_22971":50384,"_15675":87157,"_5":15564,"_21706":87059,"_1911":87158},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_2322":50414,"_22971":50384,"_15675":87160,"_5":15564,"_21706":87059,"_1911":87161},[],"Esta guía está dividida en dos partes:",{"_2322":50415,"_22971":50384,"_15675":87163,"_5":15564,"_21706":87059,"_1911":87164},[],"Configuración del DMS, para el administrador PKI.",{"_2322":50416,"_22971":50384,"_15675":87166,"_5":15564,"_21706":87059,"_1911":87167},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_2322":50417,"_22971":50384,"_15675":87169,"_5":15564,"_21706":87059,"_1911":87170},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_2322":50418,"_22971":50384,"_15675":87172,"_5":15564,"_21706":87059,"_1911":87173},[],"**Administrador PKI:** empiece por Configuración del DMS y termine con Diagnóstico y compatibilidad.",{"_2322":50419,"_22971":50384,"_15675":87175,"_5":15564,"_21706":87059,"_1911":87176},[],"**Integrador de dispositivos:** empiece por Antes de empezar y continúe con `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo que vaya a implementar.",{"_2322":50420,"_22971":50384,"_15675":87178,"_5":15564,"_21706":87066,"_1911":87179},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_2322":50421,"_22971":50384,"_15675":87181,"_5":15564,"_21706":87066,"_1911":87182},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_2322":50422,"_22971":50384,"_15675":87184,"_5":15564,"_21706":87066,"_1911":87185},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_2322":50423,"_22971":50384,"_15675":87187,"_5":15564,"_21706":87066,"_1911":87188},[],"Conviene separar cuatro bloques de configuración:",{"_2322":50424,"_22971":50384,"_15675":87190,"_5":15564,"_21706":87066,"_1911":87191},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_2322":50425,"_22971":50384,"_15675":87193,"_5":15564,"_21706":87066,"_1911":87194},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_2322":50426,"_22971":50384,"_15675":87196,"_5":15564,"_21706":87066,"_1911":87197},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_2322":50427,"_22971":50384,"_15675":87199,"_5":15564,"_21706":87066,"_1911":87200},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_2322":50428,"_22971":50384,"_15675":87202,"_5":15564,"_21706":87074,"_1911":87203},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_2322":50429,"_22971":50384,"_15675":87205,"_5":15564,"_21706":87074,"_1911":87206},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_2322":50430,"_22971":50384,"_15675":87208,"_5":15564,"_21706":87074,"_1911":87209},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_2322":50431,"_22971":50384,"_15675":87211,"_5":15564,"_21706":87074,"_1911":87212},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_2322":50432,"_22971":50384,"_15675":87214,"_5":15564,"_21706":87077,"_1911":87215},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_2322":50433,"_22971":50384,"_15675":87217,"_5":15564,"_21706":87077,"_1911":87218},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_2322":50434,"_22971":50384,"_15675":87220,"_5":15564,"_21706":87077,"_1911":87221},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_2322":50435,"_22971":50384,"_15675":87223,"_5":15564,"_21706":87077,"_1911":87224},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Puede exigir un certificado mTLS (`CLIENT_CERTIFICATE`), delegar la autorización en un webhook (`EXTERNAL_WEBHOOK`), combinar ambos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) o aceptar solicitudes sin autenticación (`NO_AUTH`). Este último modo debe limitarse a laboratorios o redes de aprovisionamiento aisladas.",{"_2322":50436,"_22971":50384,"_15675":87226,"_5":15564,"_21706":87077,"_1911":87227},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_2322":50437,"_22971":50384,"_15675":87229,"_5":15564,"_21706":87077,"_1911":87230},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_2322":50438,"_22971":50384,"_15675":87232,"_5":15564,"_21706":87077,"_1911":87233},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_2322":50439,"_22971":50384,"_15675":87235,"_5":15564,"_21706":87077,"_1911":87236},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_2322":50440,"_22971":50384,"_15675":87238,"_5":15564,"_21706":87077,"_1911":87239},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_2322":50441,"_22971":50384,"_15675":87241,"_5":15564,"_21706":87077,"_1911":87242},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_2322":50442,"_22971":50384,"_15675":87244,"_5":15564,"_21706":87077,"_1911":87245},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_2322":50443,"_22971":50384,"_15675":87247,"_5":15564,"_21706":87077,"_1911":87248},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_2322":50444,"_22971":50384,"_15675":87250,"_5":15564,"_21706":87077,"_1911":87251},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_2322":50445,"_22971":50384,"_15675":87253,"_5":15564,"_21706":87077,"_1911":87254},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_2322":50446,"_22971":50384,"_15675":87256,"_5":15564,"_21706":87080,"_1911":87257},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_2322":50447,"_22971":50384,"_15675":87259,"_5":15564,"_21706":87080,"_1911":87260},[],"**`HonorSubject`** controla si el subject del CSR se traslada literalmente al certificado. Si está desactivado, la CA aplica la plantilla del perfil e ignora el subject recibido.",{"_2322":50448,"_22971":50384,"_15675":87262,"_5":15564,"_21706":87080,"_1911":87263},[],"**`HonorKeyUsage`** decide si se respeta el `KeyUsage` del CSR o se sustituye por el definido en la plantilla.",{"_2322":50449,"_22971":50384,"_15675":87265,"_5":15564,"_21706":87080,"_1911":87266},[],"**`HonorExtendedKeyUsages`** aplica la misma regla a `ExtKeyUsage`.",{"_2322":50450,"_22971":50384,"_15675":87268,"_5":15564,"_21706":87080,"_1911":87269},[],"**`HonorExtensions`** controla si el resto de extensiones del CSR, como SAN o CDP, se incluyen en el certificado.",{"_2322":50451,"_22971":50384,"_15675":87271,"_5":15564,"_21706":87080,"_1911":87272},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_2322":50452,"_22971":50384,"_15675":87274,"_5":15564,"_21706":87084,"_1911":87275},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_2322":50453,"_22971":50384,"_15675":87277,"_5":15564,"_21706":87084,"_1911":87278},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_2322":50454,"_22971":50384,"_15675":87280,"_5":15564,"_21706":87084,"_1911":87281},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_2322":50455,"_22971":50384,"_15675":87283,"_5":15564,"_21706":87084,"_1911":87284},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_2322":50456,"_22971":50384,"_15675":87286,"_5":15564,"_21706":87084,"_1911":87287},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_2322":50457,"_22971":50384,"_15675":87289,"_5":15564,"_21706":87084,"_1911":87290},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_2322":50458,"_22971":50384,"_15675":87292,"_5":15564,"_21706":87084,"_1911":87293},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_2322":50459,"_22971":50384,"_15675":87295,"_5":15564,"_21706":87088,"_1911":87296},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_2322":50460,"_22971":50384,"_15675":87298,"_5":15564,"_21706":87088,"_1911":87299},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_2322":50461,"_22971":50384,"_15675":87301,"_5":15564,"_21706":87088,"_1911":87302},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_2322":50462,"_22971":50384,"_15675":87304,"_5":15564,"_21706":87088,"_1911":87305},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_2322":50463,"_22971":50384,"_15675":87307,"_5":15564,"_21706":87092,"_1911":87308},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_2322":50464,"_22971":50384,"_15675":87310,"_5":15564,"_21706":87092,"_1911":87311},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_2322":50465,"_22971":50384,"_15675":87313,"_5":15564,"_21706":87092,"_1911":87314},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_2322":50466,"_22971":50384,"_15675":87316,"_5":15564,"_21706":87092,"_1911":87317},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_2322":50467,"_22971":50384,"_15675":87319,"_5":15564,"_21706":87096,"_1911":87320},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_2322":50468,"_22971":50384,"_15675":87322,"_5":15564,"_21706":87096,"_1911":87323},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_2322":50469,"_22971":50384,"_15675":87325,"_5":15564,"_21706":87096,"_1911":87326},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_2322":50470,"_22971":50384,"_15675":87328,"_5":15564,"_21706":87100,"_1911":87329},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_2322":50471,"_22971":50384,"_15675":87331,"_5":15564,"_21706":87100,"_1911":87332},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_2322":50472,"_22971":50384,"_15675":87334,"_5":15564,"_21706":87100,"_1911":87335},[],"**La URL del host EST**, por ejemplo `https://est.lamassu.example`, proporcionada por el administrador PKI.",{"_2322":50473,"_22971":50384,"_15675":87337,"_5":15564,"_21706":87100,"_1911":87338},[],"**El ancla de confianza del servidor** (`lamassu-trust.pem`), raíz o intermedia, con la que el cliente validará el TLS de Lamassu.",{"_2322":50474,"_22971":50384,"_15675":87340,"_5":15564,"_21706":87100,"_1911":87341},[],"**El certificado bootstrap y su clave privada** si el DMS usa `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Esta identidad debe proceder de una de las `ValidationCAs` configuradas, normalmente una CA de aprovisionamiento distinta de la CA de enrolamiento.",{"_2322":50475,"_22971":50384,"_15675":87343,"_5":15564,"_21706":87100,"_1911":87344},[],"**El ID del DMS** (`{aps}`), que debe aparecer en todas las rutas EST.",{"_2322":50476,"_22971":50384,"_15675":87346,"_5":15564,"_21706":87103,"_1911":87347},[],"**Descargue la confianza con `/cacerts`:** el cliente valida el TLS del servidor y recibe los certificados en PKCS#7 o PEM.",{"_2322":50477,"_22971":50384,"_15675":87349,"_5":15564,"_21706":87103,"_1911":87350},[],"**Realice el alta inicial con `/simpleenroll`:** presente el certificado bootstrap o la credencial definida por `AuthMode` para obtener el certificado del dispositivo.",{"_2322":50478,"_22971":50384,"_15675":87352,"_5":15564,"_21706":87103,"_1911":87353},[],"**Renueve con `/simplereenroll`:** autentíquese con el certificado actual del dispositivo para obtener uno nuevo.",{"_2322":50479,"_22971":50384,"_15675":87355,"_5":15564,"_21706":87103,"_1911":87356},[],"**Use `/serverkeygen` solo si necesita generación de claves en servidor:** aplica la misma autenticación que `/simpleenroll` y devuelve la clave privada PKCS#8 junto con el certificado.",{"_2322":50480,"_22971":50384,"_15675":87358,"_5":15564,"_21706":87107,"_1911":87359},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_2322":50481,"_22971":50384,"_15675":87361,"_5":15564,"_21706":87107,"_1911":87362},[],"Modo (`AuthMode`)",{"_2322":50482,"_22971":50384,"_15675":87364,"_5":15564,"_21706":87107,"_1911":86769},[],{"_2322":50483,"_22971":50384,"_15675":87366,"_5":15564,"_21706":87107,"_1911":87367},[],"Credencial esperada",{"_2322":50484,"_22971":50384,"_15675":87369,"_5":15564,"_21706":87107,"_1911":87370},[],"Aplica en enroll",{"_2322":50485,"_22971":50384,"_15675":87372,"_5":15564,"_21706":87107,"_1911":87373},[],"Aplica en reenroll",{"_2322":50486,"_22971":50384,"_15675":87375,"_5":15564,"_21706":87107,"_1911":39553},[],{"_2322":50487,"_22971":50384,"_15675":87377,"_5":15564,"_21706":87107,"_1911":87378},[],"mTLS con certificado X.509",{"_2322":50488,"_22971":50384,"_15675":87380,"_5":15564,"_21706":87107,"_1911":87381},[],"Certificado y clave privada cliente",{"_2322":50489,"_22971":50384,"_15675":87383,"_5":15564,"_21706":87107,"_1911":87384},[],"Sí",{"_2322":50490,"_22971":50384,"_15675":87386,"_5":15564,"_21706":87107,"_1911":87387},[],"Sí (con el certificado en vigor)",{"_2322":50491,"_22971":50384,"_15675":87389,"_5":15564,"_21706":87107,"_1911":39568},[],{"_2322":50492,"_22971":50384,"_15675":87391,"_5":15564,"_21706":87107,"_1911":87392},[],"mTLS más validación por webhook",{"_2322":50493,"_22971":50384,"_15675":87394,"_5":15564,"_21706":87107,"_1911":87395},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_2322":50494,"_22971":50384,"_15675":87397,"_5":15564,"_21706":87107,"_1911":87384},[],{"_2322":50495,"_22971":50384,"_15675":87399,"_5":15564,"_21706":87107,"_1911":87400},[],"No como combinación; en reenroll no mantiene ambos controles",{"_2322":50496,"_22971":50384,"_15675":87402,"_5":15564,"_21706":87107,"_1911":39582},[],{"_2322":50497,"_22971":50384,"_15675":87404,"_5":15564,"_21706":87107,"_1911":87405},[],"Webhook externo de autorización",{"_2322":50498,"_22971":50384,"_15675":87407,"_5":15564,"_21706":87107,"_1911":87408},[],"Ninguna en el canal TLS",{"_2322":50499,"_22971":50384,"_15675":87410,"_5":15564,"_21706":87107,"_1911":87384},[],{"_2322":50500,"_22971":50384,"_15675":87412,"_5":15564,"_21706":87107,"_1911":87413},[],"No, degrada a `NO_AUTH`",{"_2322":50501,"_22971":50384,"_15675":87415,"_5":15564,"_21706":87107,"_1911":39596},[],{"_2322":50502,"_22971":50384,"_15675":87417,"_5":15564,"_21706":87107,"_1911":87418},[],"Sin autenticación",{"_2322":50503,"_22971":50384,"_15675":87420,"_5":15564,"_21706":87107,"_1911":87421},[],"Ninguna",{"_2322":50504,"_22971":50384,"_15675":87423,"_5":15564,"_21706":87107,"_1911":87424},[],"Sí (uso restringido)",{"_2322":50505,"_22971":50384,"_15675":87426,"_5":15564,"_21706":87107,"_1911":87424},[],{"_2322":50506,"_22971":50384,"_15675":87428,"_5":15564,"_21706":87107,"_1911":87429},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_2322":50507,"_22971":50384,"_15675":87431,"_5":15564,"_21706":87107,"_1911":87432},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_2322":50508,"_22971":50384,"_15675":87434,"_5":15564,"_21706":87107,"_1911":87435},[],"Sus parámetros principales son `ValidationCAs`, la lista de CAs que pueden validar el certificado bootstrap o el certificado en vigor; `AllowExpired`, que permite aceptar certificados cliente caducados; y `ChainLevelValidation`, que limita la profundidad de la cadena cuando su valor es mayor que cero.",{"_2322":50509,"_22971":50384,"_15675":87437,"_5":15564,"_21706":87107,"_1911":87438},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_2322":50510,"_22971":50384,"_15675":87440,"_5":15564,"_21706":87107,"_1911":87441},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_2322":50511,"_22971":50384,"_15675":87443,"_5":15564,"_21706":87107,"_1911":87444},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll`. El cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_2322":50512,"_22971":50384,"_15675":87446,"_5":15564,"_21706":87107,"_1911":87447},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_2322":50513,"_22971":50384,"_15675":87449,"_5":15564,"_21706":87111,"_1911":87450},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_2322":50514,"_22971":50384,"_15675":87452,"_5":15564,"_21706":87111,"_1911":87453},[],"`/cacerts`: descarga de la cadena de confianza.",{"_2322":50515,"_22971":50384,"_15675":87455,"_5":15564,"_21706":87111,"_1911":87456},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_2322":50516,"_22971":50384,"_15675":87458,"_5":15564,"_21706":87111,"_1911":87459},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_2322":50517,"_22971":50384,"_15675":87461,"_5":15564,"_21706":87111,"_1911":87462},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_2322":50518,"_22971":50384,"_15675":87464,"_5":15564,"_21706":87115,"_1911":87465},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_2322":50519,"_22971":50384,"_15675":87467,"_5":15564,"_21706":87115,"_1911":87468},[],"`CADistributionSettings` permite decidir qué se publica:",{"_2322":50520,"_22971":50384,"_15675":87470,"_5":15564,"_21706":87115,"_1911":87471},[],"**`IncludeLamassuSystemCA`** añade el certificado *downstream* del servidor Lamassu. Es la hoja TLS que el cliente puede usar para anclar la conexión, no una CA.",{"_2322":50521,"_22971":50384,"_15675":87473,"_5":15564,"_21706":87115,"_1911":87474},[],"**`IncludeEnrollmentCA`** añade la CA emisora del DMS, responsable de firmar los certificados de dispositivo.",{"_2322":50522,"_22971":50384,"_15675":87476,"_5":15564,"_21706":87115,"_1911":87477},[],"**`ManagedCAs`** publica CAs adicionales como anclas de confianza.",{"_2322":50523,"_22971":50384,"_15675":87479,"_5":15564,"_21706":87115,"_1911":87480},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_2322":50524,"_22971":50384,"_15675":87482,"_5":15564,"_21706":87115,"_1911":87483},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_2322":50525,"_22971":50384,"_15675":87485,"_5":15564,"_21706":87115,"_1911":87486},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_2322":50526,"_22971":50384,"_15675":87488,"_5":15564,"_21706":87115,"_1911":87489},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_2322":50527,"_22971":50384,"_15675":87491,"_5":15564,"_21706":87118,"_1911":87492},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_2322":50528,"_22971":50384,"_15675":87494,"_5":15564,"_21706":87118,"_1911":87495},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_2322":50529,"_22971":50384,"_15675":87497,"_5":15564,"_21706":87118,"_1911":87498},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos:",{"_2322":50530,"_22971":50384,"_15675":87500,"_5":15564,"_21706":87118,"_1911":87501},[],"**`EnrollmentSettings.RegistrationMode`** decide si el dispositivo se crea durante la primera inscripción (`JITP`) o debe existir previamente (`PRE_REGISTRATION`).",{"_2322":50531,"_22971":50384,"_15675":87503,"_5":15564,"_21706":87118,"_1911":87504},[],"**`EnrollmentSettings.EnableReplaceableEnrollment`** permite repetir `/simpleenroll` para un dispositivo ya enrolado. Al hacerlo, revoca el certificado anterior como `superseded`; si está desactivado, el servidor responde con `forbiddenNewEnrollment`.",{"_2322":50532,"_22971":50384,"_15675":87506,"_5":15564,"_21706":87118,"_1911":87507},[],"**`EnrollmentSettings.VerifyCSRSignature`** valida que quien envía el CSR controla la clave privada declarada. Para flotas IoT en redes abiertas debe estar activo.",{"_2322":50533,"_22971":50384,"_15675":87509,"_5":15564,"_21706":87118,"_1911":87510},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_2322":50534,"_22971":50384,"_15675":87512,"_5":15564,"_21706":87121,"_1911":87513},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_2322":50535,"_22971":50384,"_15675":87515,"_5":15564,"_21706":87121,"_1911":87516},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_2322":50536,"_22971":50384,"_15675":87518,"_5":15564,"_21706":87121,"_1911":87519},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_2322":50537,"_22971":50384,"_15675":87521,"_5":15564,"_21706":87121,"_1911":87522},[],"**`ReEnrollmentDelta`** abre la ventana de renovación en `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_2322":50538,"_22971":50384,"_15675":87524,"_5":15564,"_21706":87121,"_1911":87525},[],"**`EnableExpiredRenewal`** permite usar un certificado ya caducado como prueba de identidad; si está desactivado, el servidor responde con `expired certificate`.",{"_2322":50539,"_22971":50384,"_15675":87527,"_5":15564,"_21706":87121,"_1911":87528},[],"**`RevokeOnReEnrollment`** revoca el certificado anterior como `superseded` después de emitir el nuevo.",{"_2322":50540,"_22971":50384,"_15675":87530,"_5":15564,"_21706":87121,"_1911":87531},[],"**`AdditionalValidationCAs`** añade emisores válidos para el certificado actual, además de la CA de enrolamiento del DMS.",{"_2322":50541,"_22971":50384,"_15675":87533,"_5":15564,"_21706":87121,"_1911":87534},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_2322":50542,"_22971":50384,"_15675":87536,"_5":15564,"_21706":87121,"_1911":87537},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_2322":50543,"_22971":50384,"_15675":87539,"_5":15564,"_21706":87124,"_1911":87540},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_2322":50544,"_22971":50384,"_15675":87542,"_5":15564,"_21706":87124,"_1911":87543},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_2322":50545,"_22971":50384,"_15675":87545,"_5":15564,"_21706":87124,"_1911":87546},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_2322":50546,"_22971":50384,"_15675":87548,"_5":15564,"_21706":87124,"_1911":87549},[],"**RSA** admite cualquier tamaño aceptado por `crypto/rsa`; los valores habituales son 2048, 3072 y 4096 bits. Un valor no válido hace fallar la generación con un error `500`.",{"_2322":50547,"_22971":50384,"_15675":87551,"_5":15564,"_21706":87124,"_1911":87552},[],"**ECDSA** admite 224, 256, 384 y 521 bits, equivalentes a P-224, P-256 (`prime256v1`), P-384 y P-521. Cualquier otro valor degrada **silenciosamente** a P-256 y solo deja un aviso en el log: el cliente no recibe un error y puede obtener una curva distinta de la esperada.",{"_2322":50548,"_22971":50384,"_15675":87554,"_5":15564,"_21706":87124,"_1911":87555},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_2322":50549,"_22971":50384,"_15675":87557,"_5":15564,"_21706":87124,"_1911":87558},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_2322":50550,"_22971":50384,"_15675":87560,"_5":15564,"_21706":87124,"_1911":87561},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_2322":50551,"_22971":50384,"_15675":87563,"_5":15564,"_21706":87124,"_1911":87564},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_2322":50552,"_22971":50384,"_15675":87566,"_5":15564,"_21706":87124,"_1911":87567},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_2322":50553,"_22971":50384,"_15675":87569,"_5":15564,"_21706":87124,"_1911":87570},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_2322":50554,"_22971":50384,"_15675":87572,"_5":15564,"_21706":87124,"_1911":87573},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_2322":50555,"_22971":50384,"_15675":87575,"_5":15564,"_21706":87127,"_1911":87576},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_2322":50556,"_22971":50384,"_15675":87578,"_5":15564,"_21706":87131,"_1911":87579},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_2322":50557,"_22971":50384,"_15675":87581,"_5":15564,"_21706":87135,"_1911":87582},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_2322":50558,"_22971":50384,"_15675":87584,"_5":15564,"_21706":87139,"_1911":87585},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_2322":50559,"_22971":50384,"_15675":87587,"_5":15564,"_21706":87139,"_1911":87588},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_2322":50560,"_22971":50384,"_15675":87590,"_5":15564,"_21706":87139,"_1911":87591},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_2322":50561,"_22971":50384,"_15675":87593,"_5":15564,"_21706":87139,"_1911":87594},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_2322":50562,"_22971":50384,"_15675":87596,"_5":15564,"_21706":87147,"_1911":87597},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_2322":50563,"_22971":50384,"_15675":87599,"_5":15564,"_21706":87147,"_1911":39781},[],{"_2322":50564,"_22971":50384,"_15675":87601,"_5":15564,"_21706":87147,"_1911":87602},[],"Mensaje",{"_2322":50565,"_22971":50384,"_15675":87604,"_5":15564,"_21706":87147,"_1911":87605},[],"Causa",{"_2322":50566,"_22971":50384,"_15675":87607,"_5":15564,"_21706":87147,"_1911":87608},[],"Acción del integrador",{"_2322":50567,"_22971":50384,"_15675":87610,"_5":15564,"_21706":87147,"_1911":22301},[],{"_2322":50568,"_22971":50384,"_15675":87612,"_5":15564,"_21706":87147,"_1911":39795},[],{"_2322":50569,"_22971":50384,"_15675":87614,"_5":15564,"_21706":87147,"_1911":87615},[],"El segmento `{aps}` falta en la URL.",{"_2322":50570,"_22971":50384,"_15675":87617,"_5":15564,"_21706":87147,"_1911":87618},[],"Incluir el ID del DMS en la ruta.",{"_2322":50571,"_22971":50384,"_15675":87620,"_5":15564,"_21706":87147,"_1911":22301},[],{"_2322":50572,"_22971":50384,"_15675":87622,"_5":15564,"_21706":87147,"_1911":39806},[],{"_2322":50573,"_22971":50384,"_15675":87624,"_5":15564,"_21706":87147,"_1911":87625},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_2322":50574,"_22971":50384,"_15675":87627,"_5":15564,"_21706":87147,"_1911":87628},[],"Fijar `Content-Type: application/pkcs10`.",{"_2322":50575,"_22971":50384,"_15675":87630,"_5":15564,"_21706":87147,"_1911":22301},[],{"_2322":50576,"_22971":50384,"_15675":87632,"_5":15564,"_21706":87147,"_1911":39817},[],{"_2322":50577,"_22971":50384,"_15675":87634,"_5":15564,"_21706":87147,"_1911":87635},[],"El cuerpo no es base64 válido.",{"_2322":50578,"_22971":50384,"_15675":87637,"_5":15564,"_21706":87147,"_1911":87638},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_2322":50579,"_22971":50384,"_15675":87640,"_5":15564,"_21706":87147,"_1911":22214},[],{"_2322":50580,"_22971":50384,"_15675":87642,"_5":15564,"_21706":87147,"_1911":39828},[],{"_2322":50581,"_22971":50384,"_15675":87644,"_5":15564,"_21706":87147,"_1911":87645},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_2322":50582,"_22971":50384,"_15675":87647,"_5":15564,"_21706":87147,"_1911":87648},[],"Verificar el identificador con el administrador PKI.",{"_2322":50583,"_22971":50384,"_15675":87650,"_5":15564,"_21706":87147,"_1911":22214},[],{"_2322":50584,"_22971":50384,"_15675":87652,"_5":15564,"_21706":87147,"_1911":39839},[],{"_2322":50585,"_22971":50384,"_15675":87654,"_5":15564,"_21706":87147,"_1911":87655},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_2322":50586,"_22971":50384,"_15675":87657,"_5":15564,"_21706":87147,"_1911":87658},[],"Comprobar la cadena del certificado bootstrap.",{"_2322":50587,"_22971":50384,"_15675":87660,"_5":15564,"_21706":87147,"_1911":22214},[],{"_2322":50588,"_22971":50384,"_15675":87662,"_5":15564,"_21706":87147,"_1911":39850},[],{"_2322":50589,"_22971":50384,"_15675":87664,"_5":15564,"_21706":87147,"_1911":87665},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_2322":50590,"_22971":50384,"_15675":87667,"_5":15564,"_21706":87147,"_1911":87668},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_2322":50591,"_22971":50384,"_15675":87670,"_5":15564,"_21706":87147,"_1911":22214},[],{"_2322":50592,"_22971":50384,"_15675":87672,"_5":15564,"_21706":87147,"_1911":39861},[],{"_2322":50593,"_22971":50384,"_15675":87674,"_5":15564,"_21706":87147,"_1911":87675},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_2322":50594,"_22971":50384,"_15675":87677,"_5":15564,"_21706":87147,"_1911":87678},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_2322":50595,"_22971":50384,"_15675":87680,"_5":15564,"_21706":87147,"_1911":22214},[],{"_2322":50596,"_22971":50384,"_15675":87682,"_5":15564,"_21706":87147,"_1911":39872},[],{"_2322":50597,"_22971":50384,"_15675":87684,"_5":15564,"_21706":87147,"_1911":87685},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_2322":50598,"_22971":50384,"_15675":87687,"_5":15564,"_21706":87147,"_1911":87688},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_2322":50599,"_22971":50384,"_15675":87690,"_5":15564,"_21706":87147,"_1911":22214},[],{"_2322":50600,"_22971":50384,"_15675":87692,"_5":15564,"_21706":87147,"_1911":39883},[],{"_2322":50601,"_22971":50384,"_15675":87694,"_5":15564,"_21706":87147,"_1911":87695},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_2322":50602,"_22971":50384,"_15675":87697,"_5":15564,"_21706":87147,"_1911":87698},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_2322":50603,"_22971":50384,"_15675":87700,"_5":15564,"_21706":87147,"_1911":22214},[],{"_2322":50604,"_22971":50384,"_15675":87702,"_5":15564,"_21706":87147,"_1911":39894},[],{"_2322":50605,"_22971":50384,"_15675":87704,"_5":15564,"_21706":87147,"_1911":87705},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_2322":50606,"_22971":50384,"_15675":87707,"_5":15564,"_21706":87147,"_1911":87708},[],"Registrar el dispositivo antes de inscribirlo.",{"_2322":50607,"_22971":50384,"_15675":87710,"_5":15564,"_21706":87147,"_1911":22214},[],{"_2322":50608,"_22971":50384,"_15675":87712,"_5":15564,"_21706":87147,"_1911":39905},[],{"_2322":50609,"_22971":50384,"_15675":87714,"_5":15564,"_21706":87147,"_1911":87715},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_2322":50610,"_22971":50384,"_15675":87717,"_5":15564,"_21706":87147,"_1911":87718},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_2322":50611,"_22971":50384,"_15675":87720,"_5":15564,"_21706":87147,"_1911":22214},[],{"_2322":50612,"_22971":50384,"_15675":87722,"_5":15564,"_21706":87147,"_1911":39916},[],{"_2322":50613,"_22971":50384,"_15675":87724,"_5":15564,"_21706":87147,"_1911":87725},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_2322":50614,"_22971":50384,"_15675":87727,"_5":15564,"_21706":87147,"_1911":87728},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_2322":50615,"_22971":50384,"_15675":87730,"_5":15564,"_21706":87147,"_1911":22214},[],{"_2322":50616,"_22971":50384,"_15675":87732,"_5":15564,"_21706":87147,"_1911":39927},[],{"_2322":50617,"_22971":50384,"_15675":87734,"_5":15564,"_21706":87147,"_1911":87735},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_2322":50618,"_22971":50384,"_15675":87737,"_5":15564,"_21706":87147,"_1911":87738},[],"Revisar los logs del servicio webhook.",{"_2322":50619,"_22971":50384,"_15675":87740,"_5":15564,"_21706":87147,"_1911":22214},[],{"_2322":50620,"_22971":50384,"_15675":87742,"_5":15564,"_21706":87147,"_1911":39938},[],{"_2322":50621,"_22971":50384,"_15675":87744,"_5":15564,"_21706":87147,"_1911":87745},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_2322":50622,"_22971":50384,"_15675":87747,"_5":15564,"_21706":87147,"_1911":87748},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_2322":50623,"_22971":50384,"_15675":87750,"_5":15564,"_21706":87147,"_1911":87751},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_2322":50624,"_22971":50384,"_15675":87753,"_5":15564,"_21706":87151,"_1911":87754},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_2322":50625,"_22971":50384,"_15675":87756,"_5":15564,"_21706":87151,"_1911":87757},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_2322":50626,"_22971":50384,"_15675":87759,"_5":15564,"_21706":87151,"_1911":87760},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_2322":50627,"_22971":50384,"_15675":87762,"_5":15564,"_21706":87151,"_1911":87763},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_2322":50628,"_22971":50384,"_15675":87765,"_5":15564,"_21706":87151,"_1911":87766},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_2322":50629,"_22971":50384,"_15675":87768,"_5":15564,"_21706":87151,"_1911":87769},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_2322":50630,"_22971":50384,"_15675":87771,"_5":15564,"_21706":87151,"_1911":87772},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_2322":50631,"_22971":50384,"_15675":87774,"_5":15564,"_21706":87151,"_1911":87775},[],"<Card title=\"Visión general del DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2322":50632,"_22971":50384,"_15675":87777,"_5":15564,"_21706":87151,"_1911":87778},[],"<Card title=\"Validación OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2322":50633,"_22971":50384,"_15675":87780,"_5":15564,"_21706":87151,"_1911":87781},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/platform/pki/device-management\" />",{"_2322":50634,"_22971":50634,"_5":10796,"_1911":39979,"_23246":87783,"_15675":87785,"_21706":50634},[35713,84687,87784],"Integraciones",[],{"_2322":50635,"_22971":50634,"_15675":87787,"_5":15564,"_21706":50634,"_1911":87788},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2322":50636,"_22971":50634,"_5":23243,"_15675":87790,"_21706":87791,"_1911":87792},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2322":50637,"_22971":50634,"_5":23243,"_15675":87794,"_21706":87795,"_1911":87796},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2322":50638,"_22971":50634,"_5":23243,"_15675":87798,"_21706":87799,"_1911":87800},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2322":50639,"_22971":50634,"_5":23243,"_15675":87802,"_21706":87803,"_1911":87804},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2322":50640,"_22971":50634,"_5":23243,"_15675":87806,"_21706":87807,"_1911":87808},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2322":50641,"_22971":50634,"_5":23243,"_15675":87810,"_21706":87811,"_1911":87812},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2322":50642,"_22971":50634,"_5":23243,"_15675":87814,"_21706":87815,"_1911":40012},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#primary-account",{"_2322":50643,"_22971":50634,"_5":23243,"_15675":87817,"_21706":87818,"_1911":40016},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#secondary-account-sni-only",{"_2322":50644,"_22971":50634,"_5":23243,"_15675":87820,"_21706":87821,"_1911":87063},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#configuración-del-dms",{"_2322":50645,"_22971":50634,"_5":23243,"_15675":87823,"_21706":87824,"_1911":87825},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#modo-none","Modo `none`",{"_2322":50646,"_22971":50634,"_5":23243,"_15675":87827,"_21706":87828,"_1911":87829},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2322":50647,"_22971":50634,"_5":23243,"_15675":87831,"_21706":87832,"_1911":87833},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2322":50648,"_22971":50634,"_5":23243,"_15675":87835,"_21706":87836,"_1911":87837},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2322":50649,"_22971":50634,"_5":23243,"_15675":87839,"_21706":87840,"_1911":87841},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2322":50650,"_22971":50634,"_5":23243,"_15675":87843,"_21706":87844,"_1911":87845},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2322":50651,"_22971":50634,"_5":23243,"_15675":87847,"_21706":87848,"_1911":87849},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2322":50652,"_22971":50634,"_5":23243,"_15675":87851,"_21706":87852,"_1911":87853},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2322":50653,"_22971":50634,"_5":23243,"_15675":87855,"_21706":87856,"_1911":87857},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2322":50654,"_22971":50634,"_5":23243,"_15675":87859,"_21706":87860,"_1911":87861},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2322":50655,"_22971":50634,"_5":23243,"_15675":87863,"_21706":87864,"_1911":87865},[],"/docs/pr-preview/pr-28/es/platform/pki/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2322":50656,"_22971":50634,"_15675":87867,"_5":15564,"_21706":50634,"_1911":87868},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2322":50657,"_22971":50634,"_15675":87870,"_5":15564,"_21706":50634,"_1911":87871},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2322":50658,"_22971":50634,"_15675":87873,"_5":15564,"_21706":50634,"_1911":87874},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2322":50659,"_22971":50634,"_15675":87876,"_5":15564,"_21706":87791,"_1911":87877},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2322":50660,"_22971":50634,"_15675":87879,"_5":15564,"_21706":87791,"_1911":87880},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2322":50661,"_22971":50634,"_15675":87882,"_5":15564,"_21706":87791,"_1911":87883},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2322":50662,"_22971":50634,"_15675":87885,"_5":15564,"_21706":87791,"_1911":87886},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2322":50663,"_22971":50634,"_15675":87888,"_5":15564,"_21706":87795,"_1911":87889},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2322":50664,"_22971":50634,"_15675":87891,"_5":15564,"_21706":87799,"_1911":87892},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2322":50665,"_22971":50634,"_15675":87894,"_5":15564,"_21706":87799,"_1911":87895},[],"Acción IAM",{"_2322":50666,"_22971":50634,"_15675":87897,"_5":15564,"_21706":87799,"_1911":83960},[],{"_2322":50667,"_22971":50634,"_15675":87899,"_5":15564,"_21706":87799,"_1911":40098},[],{"_2322":50668,"_22971":50634,"_15675":87901,"_5":15564,"_21706":87799,"_1911":87902},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2322":50669,"_22971":50634,"_15675":87904,"_5":15564,"_21706":87799,"_1911":40104},[],{"_2322":50670,"_22971":50634,"_15675":87906,"_5":15564,"_21706":87799,"_1911":87907},[],"Registrar la CA en AWS IoT",{"_2322":50671,"_22971":50634,"_15675":87909,"_5":15564,"_21706":87799,"_1911":40110},[],{"_2322":50672,"_22971":50634,"_15675":87911,"_5":15564,"_21706":87799,"_1911":87912},[],"Consultar el estado del registro de la CA",{"_2322":50673,"_22971":50634,"_15675":87914,"_5":15564,"_21706":87799,"_1911":40116},[],{"_2322":50674,"_22971":50634,"_15675":87916,"_5":15564,"_21706":87799,"_1911":87917},[],"Crear o actualizar Things en IoT Core",{"_2322":50675,"_22971":50634,"_15675":87919,"_5":15564,"_21706":87799,"_1911":40122},[],{"_2322":50676,"_22971":50634,"_15675":87921,"_5":15564,"_21706":87799,"_1911":87922},[],"Aprovisionar Things mediante plantilla",{"_2322":50677,"_22971":50634,"_15675":87924,"_5":15564,"_21706":87799,"_1911":40128},[],{"_2322":50678,"_22971":50634,"_15675":87926,"_5":15564,"_21706":87799,"_1911":87927},[],"Registrar certificados de dispositivo",{"_2322":50679,"_22971":50634,"_15675":87929,"_5":15564,"_21706":87799,"_1911":40134},[],{"_2322":50680,"_22971":50634,"_15675":87931,"_5":15564,"_21706":87799,"_1911":87932},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2322":50681,"_22971":50634,"_15675":87934,"_5":15564,"_21706":87799,"_1911":40140},[],{"_2322":50682,"_22971":50634,"_15675":87936,"_5":15564,"_21706":87799,"_1911":87937},[],"Crear y adjuntar políticas IoT",{"_2322":50683,"_22971":50634,"_15675":87939,"_5":15564,"_21706":87799,"_1911":40146},[],{"_2322":50684,"_22971":50634,"_15675":87941,"_5":15564,"_21706":87799,"_1911":87942},[],"Gestionar grupos de Things",{"_2322":50685,"_22971":50634,"_15675":87944,"_5":15564,"_21706":87799,"_1911":40152},[],{"_2322":50686,"_22971":50634,"_15675":87946,"_5":15564,"_21706":87799,"_1911":87947},[],"Crear plantillas JITP",{"_2322":50687,"_22971":50634,"_15675":87949,"_5":15564,"_21706":87799,"_1911":40158},[],{"_2322":50688,"_22971":50634,"_15675":87951,"_5":15564,"_21706":87799,"_1911":87952},[],"Leer y escribir el Device Shadow",{"_2322":50689,"_22971":50634,"_15675":87954,"_5":15564,"_21706":87799,"_1911":87955},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2322":50690,"_22971":50634,"_15675":87957,"_5":15564,"_21706":87803,"_1911":87958},[],"Parámetro",{"_2322":50691,"_22971":50634,"_15675":87960,"_5":15564,"_21706":87803,"_1911":87961},[],"Tipo",{"_2322":50692,"_22971":50634,"_15675":87963,"_5":15564,"_21706":87803,"_1911":87964},[],"Requerido",{"_2322":50693,"_22971":50634,"_15675":87966,"_5":15564,"_21706":87803,"_1911":86769},[],{"_2322":50694,"_22971":50634,"_15675":87968,"_5":15564,"_21706":87803,"_1911":40178},[],{"_2322":50695,"_22971":50634,"_15675":87970,"_5":15564,"_21706":87803,"_1911":18899},[],{"_2322":50696,"_22971":50634,"_15675":87972,"_5":15564,"_21706":87803,"_1911":87384},[],{"_2322":50697,"_22971":50634,"_15675":87974,"_5":15564,"_21706":87803,"_1911":87975},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2322":50698,"_22971":50634,"_15675":87977,"_5":15564,"_21706":87803,"_1911":40188},[],{"_2322":50699,"_22971":50634,"_15675":87979,"_5":15564,"_21706":87803,"_1911":18899},[],{"_2322":50700,"_22971":50634,"_15675":87981,"_5":15564,"_21706":87803,"_1911":87384},[],{"_2322":50701,"_22971":50634,"_15675":87983,"_5":15564,"_21706":87803,"_1911":87984},[],"Región AWS donde opera el conector.",{"_2322":50702,"_22971":50634,"_15675":87986,"_5":15564,"_21706":87803,"_1911":40198},[],{"_2322":50703,"_22971":50634,"_15675":87988,"_5":15564,"_21706":87803,"_1911":18899},[],{"_2322":50704,"_22971":50634,"_15675":87990,"_5":15564,"_21706":87803,"_1911":87384},[],{"_2322":50705,"_22971":50634,"_15675":87992,"_5":15564,"_21706":87803,"_1911":87993},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2322":50706,"_22971":50634,"_15675":87995,"_5":15564,"_21706":87803,"_1911":40208},[],{"_2322":50707,"_22971":50634,"_15675":87997,"_5":15564,"_21706":87803,"_1911":18899},[],{"_2322":50708,"_22971":50634,"_15675":87999,"_5":15564,"_21706":87803,"_1911":88000},[],"Solo con `auth_method=static`",{"_2322":50709,"_22971":50634,"_15675":88002,"_5":15564,"_21706":87803,"_1911":88003},[],"Clave de acceso AWS.",{"_2322":50710,"_22971":50634,"_15675":88005,"_5":15564,"_21706":87803,"_1911":40219},[],{"_2322":50711,"_22971":50634,"_15675":88007,"_5":15564,"_21706":87803,"_1911":18899},[],{"_2322":50712,"_22971":50634,"_15675":88009,"_5":15564,"_21706":87803,"_1911":88000},[],{"_2322":50713,"_22971":50634,"_15675":88011,"_5":15564,"_21706":87803,"_1911":88012},[],"Clave secreta AWS.",{"_2322":50714,"_22971":50634,"_15675":88014,"_5":15564,"_21706":87803,"_1911":40229},[],{"_2322":50715,"_22971":50634,"_15675":88016,"_5":15564,"_21706":87803,"_1911":18899},[],{"_2322":50716,"_22971":50634,"_15675":88018,"_5":15564,"_21706":87803,"_1911":40234},[],{"_2322":50717,"_22971":50634,"_15675":88020,"_5":15564,"_21706":87803,"_1911":88021},[],"Token de sesión (con `auth_method=static`).",{"_2322":50718,"_22971":50634,"_15675":88023,"_5":15564,"_21706":87803,"_1911":40240},[],{"_2322":50719,"_22971":50634,"_15675":88025,"_5":15564,"_21706":87803,"_1911":18899},[],{"_2322":50720,"_22971":50634,"_15675":88027,"_5":15564,"_21706":87803,"_1911":88028},[],"Solo con `auth_method=role`",{"_2322":50721,"_22971":50634,"_15675":88030,"_5":15564,"_21706":87803,"_1911":88031},[],"ARN del rol a asumir.",{"_2322":50722,"_22971":50634,"_15675":88033,"_5":15564,"_21706":87803,"_1911":40251},[],{"_2322":50723,"_22971":50634,"_15675":88035,"_5":15564,"_21706":87803,"_1911":18899},[],{"_2322":50724,"_22971":50634,"_15675":88037,"_5":15564,"_21706":87803,"_1911":40234},[],{"_2322":50725,"_22971":50634,"_15675":88039,"_5":15564,"_21706":87803,"_1911":88040},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2322":50726,"_22971":50634,"_15675":88042,"_5":15564,"_21706":87803,"_1911":40261},[],{"_2322":50727,"_22971":50634,"_15675":88044,"_5":15564,"_21706":87803,"_1911":64300},[],{"_2322":50728,"_22971":50634,"_15675":88046,"_5":15564,"_21706":87803,"_1911":87384},[],{"_2322":50729,"_22971":50634,"_15675":88048,"_5":15564,"_21706":87803,"_1911":88049},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2322":50730,"_22971":50634,"_15675":88051,"_5":15564,"_21706":87803,"_1911":40271},[],{"_2322":50731,"_22971":50634,"_15675":88053,"_5":15564,"_21706":87803,"_1911":18899},[],{"_2322":50732,"_22971":50634,"_15675":88055,"_5":15564,"_21706":87803,"_1911":87384},[],{"_2322":50733,"_22971":50634,"_15675":88057,"_5":15564,"_21706":87803,"_1911":88058},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2322":50734,"_22971":50634,"_15675":88060,"_5":15564,"_21706":87803,"_1911":40281},[],{"_2322":50735,"_22971":50634,"_15675":88062,"_5":15564,"_21706":87803,"_1911":18899},[],{"_2322":50736,"_22971":50634,"_15675":88064,"_5":15564,"_21706":87803,"_1911":87384},[],{"_2322":50737,"_22971":50634,"_15675":88066,"_5":15564,"_21706":87803,"_1911":88067},[],"URL HTTP del Device Manager de Lamassu.",{"_2322":50738,"_22971":50634,"_15675":88069,"_5":15564,"_21706":87803,"_1911":40291},[],{"_2322":50739,"_22971":50634,"_15675":88071,"_5":15564,"_21706":87803,"_1911":18899},[],{"_2322":50740,"_22971":50634,"_15675":88073,"_5":15564,"_21706":87803,"_1911":87384},[],{"_2322":50741,"_22971":50634,"_15675":88075,"_5":15564,"_21706":87803,"_1911":88076},[],"URL HTTP del servicio de CA de Lamassu.",{"_2322":50742,"_22971":50634,"_15675":88078,"_5":15564,"_21706":87807,"_1911":88079},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2322":50743,"_22971":50634,"_15675":88081,"_5":15564,"_21706":87811,"_1911":88082},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2322":50744,"_22971":50634,"_15675":88084,"_5":15564,"_21706":87811,"_1911":88085},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2322":50745,"_22971":50634,"_15675":88087,"_5":15564,"_21706":87815,"_1911":88088},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2322":50746,"_22971":50634,"_15675":88090,"_5":15564,"_21706":87815,"_1911":88091},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2322":50747,"_22971":50634,"_15675":88093,"_5":15564,"_21706":87815,"_1911":88094},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2322":50748,"_22971":50634,"_15675":88096,"_5":15564,"_21706":87815,"_1911":88097},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2322":50749,"_22971":50634,"_15675":88099,"_5":15564,"_21706":87815,"_1911":88100},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2322":50750,"_22971":50634,"_15675":88102,"_5":15564,"_21706":87815,"_1911":88103},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2322":50751,"_22971":50634,"_15675":88105,"_5":15564,"_21706":87818,"_1911":88106},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2322":50752,"_22971":50634,"_15675":88108,"_5":15564,"_21706":87821,"_1911":88109},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2322":50753,"_22971":50634,"_15675":88111,"_5":15564,"_21706":87821,"_1911":88112},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2322":50754,"_22971":50634,"_15675":88114,"_5":15564,"_21706":87824,"_1911":88115},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2322":50755,"_22971":50634,"_15675":88117,"_5":15564,"_21706":87828,"_1911":88118},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2322":50756,"_22971":50634,"_15675":88120,"_5":15564,"_21706":87828,"_1911":88121},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2322":50757,"_22971":50634,"_15675":88123,"_5":15564,"_21706":87828,"_1911":88124},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2322":50758,"_22971":50634,"_15675":88126,"_5":15564,"_21706":87828,"_1911":88127},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2322":50759,"_22971":50634,"_15675":88129,"_5":15564,"_21706":87828,"_1911":88130},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2322":50760,"_22971":50634,"_15675":88132,"_5":15564,"_21706":87828,"_1911":88133},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2322":50761,"_22971":50634,"_15675":88135,"_5":15564,"_21706":87832,"_1911":88136},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2322":50762,"_22971":50634,"_15675":88138,"_5":15564,"_21706":87832,"_1911":88139},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2322":50763,"_22971":50634,"_15675":88141,"_5":15564,"_21706":87832,"_1911":88142},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2322":50764,"_22971":50634,"_15675":88144,"_5":15564,"_21706":87836,"_1911":88145},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2322":50765,"_22971":50634,"_15675":88147,"_5":15564,"_21706":87836,"_1911":88148},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2322":50766,"_22971":50634,"_15675":88150,"_5":15564,"_21706":87836,"_1911":88151},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2322":50767,"_22971":50634,"_15675":88153,"_5":15564,"_21706":87840,"_1911":88154},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2322":50768,"_22971":50634,"_15675":88156,"_5":15564,"_21706":87840,"_1911":88157},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2322":50769,"_22971":50634,"_15675":88159,"_5":15564,"_21706":87840,"_1911":88160},[],"Para que el flujo JITP funcione correctamente:",{"_2322":50770,"_22971":50634,"_15675":88162,"_5":15564,"_21706":87840,"_1911":88163},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2322":50771,"_22971":50634,"_15675":88165,"_5":15564,"_21706":87840,"_1911":88166},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2322":50772,"_22971":50634,"_15675":88168,"_5":15564,"_21706":87840,"_1911":88169},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2322":50773,"_22971":50634,"_15675":88171,"_5":15564,"_21706":87840,"_1911":88172},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2322":50774,"_22971":50634,"_15675":88174,"_5":15564,"_21706":87844,"_1911":88175},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2322":50775,"_22971":50634,"_15675":88177,"_5":15564,"_21706":87844,"_1911":88178},[],"Estado en Lamassu",{"_2322":50776,"_22971":50634,"_15675":88180,"_5":15564,"_21706":87844,"_1911":88181},[],"Razón de revocación",{"_2322":50777,"_22971":50634,"_15675":88183,"_5":15564,"_21706":87844,"_1911":88184},[],"Estado en AWS IoT Core",{"_2322":50778,"_22971":50634,"_15675":88186,"_5":15564,"_21706":87844,"_1911":40412},[],{"_2322":50779,"_22971":50634,"_15675":88188,"_5":15564,"_21706":87844,"_1911":87421},[],{"_2322":50780,"_22971":50634,"_15675":88190,"_5":15564,"_21706":87844,"_1911":40417},[],{"_2322":50781,"_22971":50634,"_15675":88192,"_5":15564,"_21706":87844,"_1911":40420},[],{"_2322":50782,"_22971":50634,"_15675":88194,"_5":15564,"_21706":87844,"_1911":40423},[],{"_2322":50783,"_22971":50634,"_15675":88196,"_5":15564,"_21706":87844,"_1911":40426},[],{"_2322":50784,"_22971":50634,"_15675":88198,"_5":15564,"_21706":87844,"_1911":40420},[],{"_2322":50785,"_22971":50634,"_15675":88200,"_5":15564,"_21706":87844,"_1911":88201},[],"Cualquier otra razón",{"_2322":50786,"_22971":50634,"_15675":88203,"_5":15564,"_21706":87844,"_1911":40434},[],{"_2322":50787,"_22971":50634,"_15675":88205,"_5":15564,"_21706":87844,"_1911":88206},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2322":50788,"_22971":50634,"_15675":88208,"_5":15564,"_21706":87848,"_1911":88209},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2322":50789,"_22971":50634,"_15675":88211,"_5":15564,"_21706":87848,"_1911":88212},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2322":50790,"_22971":50634,"_15675":88214,"_5":15564,"_21706":87848,"_1911":88215},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2322":50791,"_22971":50634,"_15675":88217,"_5":15564,"_21706":87852,"_1911":88218},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2322":50792,"_22971":50634,"_15675":88220,"_5":15564,"_21706":87852,"_1911":88221},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2322":50793,"_22971":50634,"_15675":88223,"_5":15564,"_21706":87856,"_1911":88224},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2322":50794,"_22971":50634,"_15675":88226,"_5":15564,"_21706":87856,"_1911":88227},[],"Existen dos tipos de acciones:",{"_2322":50795,"_22971":50634,"_15675":88229,"_5":15564,"_21706":87856,"_1911":88230},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2322":50796,"_22971":50634,"_15675":88232,"_5":15564,"_21706":87856,"_1911":88233},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2322":50797,"_22971":50634,"_15675":88235,"_5":15564,"_21706":87856,"_1911":88236},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2322":50798,"_22971":50634,"_15675":88238,"_5":15564,"_21706":87860,"_1911":88239},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2322":50799,"_22971":50634,"_15675":88241,"_5":15564,"_21706":87860,"_1911":88242},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2322":50800,"_22971":50634,"_15675":88244,"_5":15564,"_21706":87860,"_1911":88245},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2322":50801,"_22971":50634,"_15675":88247,"_5":15564,"_21706":87864,"_1911":88248},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2322":50802,"_22971":50634,"_15675":88250,"_5":15564,"_21706":87864,"_1911":88251},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2322":50803,"_22971":50634,"_15675":88253,"_5":15564,"_21706":87864,"_1911":88254},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2322":50804,"_22971":50634,"_15675":88256,"_5":15564,"_21706":87864,"_1911":88257},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2322":50805,"_22971":50634,"_15675":88259,"_5":15564,"_21706":87864,"_1911":88260},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2322":50806,"_22971":50634,"_15675":88262,"_5":15564,"_21706":87864,"_1911":88263},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2322":50807,"_22971":50634,"_15675":88265,"_5":15564,"_21706":87864,"_1911":88266},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2322":50808,"_22971":50634,"_15675":88268,"_5":15564,"_21706":87864,"_1911":88269},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2322":50809,"_22971":50634,"_15675":88271,"_5":15564,"_21706":87864,"_1911":88272},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2322":50810,"_22971":50634,"_15675":88274,"_5":15564,"_21706":87864,"_1911":88275},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2322":50811,"_22971":50634,"_15675":88277,"_5":15564,"_21706":87864,"_1911":88278},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2322":50812,"_22971":50634,"_15675":88280,"_5":15564,"_21706":87864,"_1911":88281},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2322":50813,"_22971":50634,"_15675":88283,"_5":15564,"_21706":87864,"_1911":88284},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2322":50814,"_22971":50634,"_15675":88286,"_5":15564,"_21706":87864,"_1911":88287},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2322":50815,"_22971":50634,"_15675":88289,"_5":15564,"_21706":87864,"_1911":88290},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2322":50816,"_22971":50634,"_15675":88292,"_5":15564,"_21706":87864,"_1911":88293},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2322":50817,"_22971":50634,"_15675":88295,"_5":15564,"_21706":87864,"_1911":88296},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2322":50818,"_22971":50634,"_15675":88298,"_5":15564,"_21706":87864,"_1911":88299},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2322":50819,"_22971":50634,"_15675":88301,"_5":15564,"_21706":87864,"_1911":88302},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2322":50820,"_22971":50634,"_15675":88304,"_5":15564,"_21706":87864,"_1911":88305},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2322":50821,"_22971":50634,"_15675":88307,"_5":15564,"_21706":87864,"_1911":88308},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2322":50822,"_22971":50822,"_5":10796,"_1911":88310,"_23246":88311,"_15675":88312,"_21706":50822},"Claves y motores criptográficos",[35713,84687,85221],[],{"_2322":50823,"_22971":50822,"_15675":88314,"_5":15564,"_21706":50822,"_1911":88315},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2322":50824,"_22971":50822,"_5":23243,"_15675":88317,"_21706":88318,"_1911":88319},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_2322":50825,"_22971":50822,"_5":23243,"_15675":88321,"_21706":88322,"_1911":88323},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2322":50826,"_22971":50822,"_5":23243,"_15675":88325,"_21706":88326,"_1911":88327},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2322":50827,"_22971":50822,"_5":23243,"_15675":88329,"_21706":88330,"_1911":40562},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#file-system",{"_2322":50828,"_22971":50822,"_5":23243,"_15675":88332,"_21706":88333,"_1911":40566},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#hashicorp-vault",{"_2322":50829,"_22971":50822,"_5":23243,"_15675":88335,"_21706":88336,"_1911":40570},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#aws-secrets-manager",{"_2322":50830,"_22971":50822,"_5":23243,"_15675":88338,"_21706":88339,"_1911":40574},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#aws-kms",{"_2322":50831,"_22971":50822,"_5":23243,"_15675":88341,"_21706":88342,"_1911":40578},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#pkcs11",{"_2322":50832,"_22971":50822,"_5":23243,"_15675":88344,"_21706":88345,"_1911":88346},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2322":50833,"_22971":50822,"_5":23243,"_15675":88348,"_21706":88349,"_1911":88350},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2322":50834,"_22971":50822,"_5":23243,"_15675":88352,"_21706":88353,"_1911":88354},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2322":50835,"_22971":50822,"_5":23243,"_15675":88356,"_21706":88357,"_1911":88358},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2322":50836,"_22971":50822,"_5":23243,"_15675":88360,"_21706":88361,"_1911":88362},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2322":50837,"_22971":50822,"_5":23243,"_15675":88364,"_21706":88365,"_1911":88366},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2322":50838,"_22971":50822,"_5":23243,"_15675":88368,"_21706":88369,"_1911":88370},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2322":50839,"_22971":50822,"_5":23243,"_15675":88372,"_21706":88373,"_1911":40610},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#sign",{"_2322":50840,"_22971":50822,"_5":23243,"_15675":88375,"_21706":88376,"_1911":40614},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#verify",{"_2322":50841,"_22971":50822,"_5":23243,"_15675":88378,"_21706":88379,"_1911":88380},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2322":50842,"_22971":50822,"_5":23243,"_15675":88382,"_21706":88383,"_1911":88384},[],"/docs/pr-preview/pr-28/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2322":50843,"_22971":50822,"_15675":88386,"_5":15564,"_21706":88318,"_1911":88387},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2322":50844,"_22971":50822,"_15675":88389,"_5":15564,"_21706":88318,"_1911":88390},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2322":50845,"_22971":50822,"_15675":88392,"_5":15564,"_21706":88322,"_1911":88393},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2322":50846,"_22971":50822,"_15675":88395,"_5":15564,"_21706":88322,"_1911":88396},[],"En la práctica, permite:",{"_2322":50847,"_22971":50822,"_15675":88398,"_5":15564,"_21706":88322,"_1911":88399},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2322":50848,"_22971":50822,"_15675":88401,"_5":15564,"_21706":88322,"_1911":88402},[],"Importar claves creadas externamente.",{"_2322":50849,"_22971":50822,"_15675":88404,"_5":15564,"_21706":88322,"_1911":88405},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2322":50850,"_22971":50822,"_15675":88407,"_5":15564,"_21706":88322,"_1911":88408},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2322":50851,"_22971":50822,"_15675":88410,"_5":15564,"_21706":88326,"_1911":88411},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2322":50852,"_22971":50822,"_15675":88413,"_5":15564,"_21706":88326,"_1911":88414},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2322":50853,"_22971":50822,"_15675":88416,"_5":15564,"_21706":88326,"_1911":88417},[],"Actualmente, Lamassu soporta cinco tipos de motor. Elige según el nivel de aislamiento que necesites y quién debe poder acceder al material privado.",{"_2322":50854,"_22971":50822,"_15675":88419,"_5":15564,"_21706":88330,"_1911":88420},[],"Genera las claves con las librerías criptográficas de Go y delega su protección en el sistema de archivos. Funciona tanto on-premise como en cloud, pero no evita la extracción de la clave y no está recomendado para producción.",{"_2322":50855,"_22971":50822,"_15675":88422,"_5":15564,"_21706":88333,"_1911":88423},[],"Protege las claves en reposo y puede ejecutarse on-premise o en cloud. Un administrador con permisos suficientes todavía puede visualizar el material privado, por lo que conviene limitar el acceso administrativo y custodiar las claves de *unseal*.",{"_2322":50856,"_22971":50822,"_15675":88425,"_5":15564,"_21706":88336,"_1911":88426},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2322":50857,"_22971":50822,"_15675":88428,"_5":15564,"_21706":88339,"_1911":88429},[],"Genera las claves con entropía hardware y no expone la clave privada. Las operaciones se ejecutan dentro del servicio. Aun así, una identidad con permisos suficientes podría utilizar la clave para firmar, por lo que la política IAM sigue siendo crítica.",{"_2322":50858,"_22971":50822,"_15675":88431,"_5":15564,"_21706":88342,"_1911":88432},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2322":50859,"_22971":50822,"_15675":88434,"_5":15564,"_21706":88342,"_1911":88435},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_2322":50860,"_22971":50822,"_15675":88437,"_5":15564,"_21706":88342,"_1911":88438},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2322":50861,"_22971":50822,"_15675":88440,"_5":15564,"_21706":88342,"_1911":88441},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2322":50862,"_22971":50822,"_15675":88443,"_5":15564,"_21706":88345,"_1911":88444},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2322":50863,"_22971":50822,"_15675":88446,"_5":15564,"_21706":88345,"_1911":88447},[],"La tabla incluye los siguientes campos:",{"_2322":50864,"_22971":50822,"_15675":88449,"_5":15564,"_21706":88345,"_1911":88450},[],"**Name**: nombre descriptivo de la clave.",{"_2322":50865,"_22971":50822,"_15675":88452,"_5":15564,"_21706":88345,"_1911":88453},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2322":50866,"_22971":50822,"_15675":88455,"_5":15564,"_21706":88345,"_1911":88456},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2322":50867,"_22971":50822,"_15675":88458,"_5":15564,"_21706":88345,"_1911":88459},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2322":50868,"_22971":50822,"_15675":88461,"_5":15564,"_21706":88345,"_1911":88462},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2322":50869,"_22971":50822,"_15675":88464,"_5":15564,"_21706":88345,"_1911":88465},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2322":50870,"_22971":50822,"_15675":88467,"_5":15564,"_21706":88345,"_1911":88468},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2322":50871,"_22971":50822,"_15675":88470,"_5":15564,"_21706":88345,"_1911":88471},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2322":50872,"_22971":50822,"_15675":88473,"_5":15564,"_21706":88345,"_1911":88474},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2322":50873,"_22971":50822,"_15675":88476,"_5":15564,"_21706":88345,"_1911":88477},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2322":50874,"_22971":50822,"_15675":88479,"_5":15564,"_21706":88345,"_1911":88480},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2322":50875,"_22971":50822,"_15675":88482,"_5":15564,"_21706":88345,"_1911":88483},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2322":50876,"_22971":50822,"_15675":88485,"_5":15564,"_21706":88345,"_1911":88486},[],"**Delete Key** para eliminar la clave del sistema.",{"_2322":50877,"_22971":50822,"_15675":88488,"_5":15564,"_21706":88349,"_1911":88489},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_2322":50878,"_22971":50822,"_15675":88491,"_5":15564,"_21706":88353,"_1911":88492},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2322":50879,"_22971":50822,"_15675":88494,"_5":15564,"_21706":88353,"_1911":88495},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_2322":50880,"_22971":50822,"_15675":88497,"_5":15564,"_21706":88353,"_1911":88498},[],"**Key Name**: nombre único y descriptivo.",{"_2322":50881,"_22971":50822,"_15675":88500,"_5":15564,"_21706":88353,"_1911":88501},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2322":50882,"_22971":50822,"_15675":88503,"_5":15564,"_21706":88353,"_1911":88504},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2322":50883,"_22971":50822,"_15675":88506,"_5":15564,"_21706":88353,"_1911":88507},[],"**Tags**: metadatos para clasificar la clave.",{"_2322":50884,"_22971":50822,"_15675":88509,"_5":15564,"_21706":88353,"_1911":88510},[],"**Metadata**: información adicional para usos avanzados.",{"_2322":50885,"_22971":50822,"_15675":88512,"_5":15564,"_21706":88357,"_1911":88513},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2322":50886,"_22971":50822,"_15675":88515,"_5":15564,"_21706":88357,"_1911":88516},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_2322":50887,"_22971":50822,"_15675":88518,"_5":15564,"_21706":88357,"_1911":88519},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2322":50888,"_22971":50822,"_15675":88521,"_5":15564,"_21706":88357,"_1911":88522},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2322":50889,"_22971":50822,"_15675":88524,"_5":15564,"_21706":88357,"_1911":88525},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_2322":50890,"_22971":50822,"_15675":88527,"_5":15564,"_21706":88357,"_1911":88528},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2322":50891,"_22971":50822,"_15675":88530,"_5":15564,"_21706":88357,"_1911":88531},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2322":50892,"_22971":50822,"_15675":88533,"_5":15564,"_21706":88357,"_1911":88534},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2322":50893,"_22971":50822,"_15675":88536,"_5":15564,"_21706":88357,"_1911":88537},[],"**Metadata**: información adicional opcional.",{"_2322":50894,"_22971":50822,"_15675":88539,"_5":15564,"_21706":88357,"_1911":88540},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2322":50895,"_22971":50822,"_15675":88542,"_5":15564,"_21706":88357,"_1911":88543},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_2322":50896,"_22971":50822,"_15675":88545,"_5":15564,"_21706":88361,"_1911":88546},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2322":50897,"_22971":50822,"_15675":88548,"_5":15564,"_21706":88365,"_1911":88549},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2322":50898,"_22971":50822,"_15675":88551,"_5":15564,"_21706":88365,"_1911":88552},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2322":50899,"_22971":50822,"_15675":88554,"_5":15564,"_21706":88365,"_1911":88555},[],"**Key Name**: nombre descriptivo.",{"_2322":50900,"_22971":50822,"_15675":88557,"_5":15564,"_21706":88365,"_1911":88558},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2322":50901,"_22971":50822,"_15675":88560,"_5":15564,"_21706":88365,"_1911":88561},[],"**Tags**: etiquetas asociadas.",{"_2322":50902,"_22971":50822,"_15675":88563,"_5":15564,"_21706":88365,"_1911":88564},[],"**Aliases**: nombres alternativos.",{"_2322":50903,"_22971":50822,"_15675":88566,"_5":15564,"_21706":88365,"_1911":88567},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2322":50904,"_22971":50822,"_15675":88569,"_5":15564,"_21706":88365,"_1911":88570},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2322":50905,"_22971":50822,"_15675":88572,"_5":15564,"_21706":88365,"_1911":88573},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2322":50906,"_22971":50822,"_15675":88575,"_5":15564,"_21706":88365,"_1911":88576},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_2322":50907,"_22971":50822,"_15675":88578,"_5":15564,"_21706":88369,"_1911":88579},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2322":50908,"_22971":50822,"_15675":88581,"_5":15564,"_21706":88369,"_1911":88582},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2322":50909,"_22971":50822,"_15675":88584,"_5":15564,"_21706":88373,"_1911":88585},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2322":50910,"_22971":50822,"_15675":88587,"_5":15564,"_21706":88373,"_1911":88588},[],"Campos principales:",{"_2322":50911,"_22971":50822,"_15675":88590,"_5":15564,"_21706":88373,"_1911":88591},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2322":50912,"_22971":50822,"_15675":88593,"_5":15564,"_21706":88373,"_1911":88594},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2322":50913,"_22971":50822,"_15675":88596,"_5":15564,"_21706":88373,"_1911":88597},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2322":50914,"_22971":50822,"_15675":88599,"_5":15564,"_21706":88373,"_1911":88600},[],"**Message**: contenido que se va a firmar.",{"_2322":50915,"_22971":50822,"_15675":88602,"_5":15564,"_21706":88373,"_1911":88603},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2322":50916,"_22971":50822,"_15675":88605,"_5":15564,"_21706":88376,"_1911":88606},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2322":50917,"_22971":50822,"_15675":88608,"_5":15564,"_21706":88376,"_1911":88588},[],{"_2322":50918,"_22971":50822,"_15675":88610,"_5":15564,"_21706":88376,"_1911":88611},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2322":50919,"_22971":50822,"_15675":88613,"_5":15564,"_21706":88376,"_1911":88614},[],"**Message Type**: `Raw` o `Digest`.",{"_2322":50920,"_22971":50822,"_15675":88616,"_5":15564,"_21706":88376,"_1911":88617},[],"**Payload Encoding**: codificación del mensaje.",{"_2322":50921,"_22971":50822,"_15675":88619,"_5":15564,"_21706":88376,"_1911":88620},[],"**Message**: mensaje original o hash.",{"_2322":50922,"_22971":50822,"_15675":88622,"_5":15564,"_21706":88376,"_1911":88623},[],"**Signature**: firma que se desea comprobar.",{"_2322":50923,"_22971":50822,"_15675":88625,"_5":15564,"_21706":88376,"_1911":88626},[],"**Result**: indicador del resultado de la validación.",{"_2322":50924,"_22971":50822,"_15675":88628,"_5":15564,"_21706":88379,"_1911":88629},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2322":50925,"_22971":50822,"_15675":88631,"_5":15564,"_21706":88379,"_1911":88632},[],"Este flujo es útil para:",{"_2322":50926,"_22971":50822,"_15675":88634,"_5":15564,"_21706":88379,"_1911":88635},[],"Solicitar certificados a una CA externa.",{"_2322":50927,"_22971":50822,"_15675":88637,"_5":15564,"_21706":88379,"_1911":88638},[],"Renovar una identidad manteniendo la misma clave.",{"_2322":50928,"_22971":50822,"_15675":88640,"_5":15564,"_21706":88379,"_1911":88641},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2322":50929,"_22971":50822,"_15675":88643,"_5":15564,"_21706":88379,"_1911":88644},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2322":50930,"_22971":50822,"_15675":88646,"_5":15564,"_21706":88379,"_1911":88647},[],"**Organization (O)**: organización o empresa.",{"_2322":50931,"_22971":50822,"_15675":88649,"_5":15564,"_21706":88379,"_1911":88650},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2322":50932,"_22971":50822,"_15675":88652,"_5":15564,"_21706":88379,"_1911":88653},[],"**Country (C)**: código de país de dos letras.",{"_2322":50933,"_22971":50822,"_15675":88655,"_5":15564,"_21706":88379,"_1911":88656},[],"**State / Province (ST)**: estado o provincia.",{"_2322":50934,"_22971":50822,"_15675":88658,"_5":15564,"_21706":88379,"_1911":88659},[],"**Locality (L)**: ciudad o localidad.",{"_2322":50935,"_22971":50822,"_15675":88661,"_5":15564,"_21706":88379,"_1911":88662},[],"**Email Address**: correo de contacto.",{"_2322":50936,"_22971":50822,"_15675":88664,"_5":15564,"_21706":88379,"_1911":88665},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2322":50937,"_22971":50822,"_15675":88667,"_5":15564,"_21706":88379,"_1911":88668},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_2322":50938,"_22971":50822,"_15675":88670,"_5":15564,"_21706":88383,"_1911":88671},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2322":50939,"_22971":50822,"_15675":88673,"_5":15564,"_21706":88383,"_1911":88674},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_2322":50940,"_22971":50940,"_5":10796,"_1911":88676,"_23246":88677,"_15675":88678,"_21706":50940},"Validación online con OCSP",[35713,84687,85221],[],{"_2322":50941,"_22971":50940,"_15675":88680,"_5":15564,"_21706":50940,"_1911":88681},[],"Consulta en tiempo real si un certificado sigue vigente o se ha revocado.",{"_2322":50942,"_22971":50940,"_5":23243,"_15675":88683,"_21706":88684,"_1911":88685},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#servicio-ocsp","Servicio OCSP",{"_2322":50943,"_22971":50940,"_5":23243,"_15675":88687,"_21706":88688,"_1911":88689},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2322":50944,"_22971":50940,"_5":23243,"_15675":88691,"_21706":88692,"_1911":88693},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2322":50945,"_22971":50940,"_5":23243,"_15675":88695,"_21706":88696,"_1911":88697},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2322":50946,"_22971":50940,"_5":23243,"_15675":88699,"_21706":88700,"_1911":88701},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2322":50947,"_22971":50940,"_5":23243,"_15675":88703,"_21706":88704,"_1911":86712},[],"/docs/pr-preview/pr-28/es/platform/pki/ocsp#referencias",{"_2322":50948,"_22971":50940,"_15675":88706,"_5":15564,"_21706":88684,"_1911":88707},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_2322":50949,"_22971":50940,"_15675":88709,"_5":15564,"_21706":88684,"_1911":88710},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_2322":50950,"_22971":50940,"_15675":88712,"_5":15564,"_21706":88688,"_1911":88713},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_2322":50951,"_22971":50940,"_15675":88715,"_5":15564,"_21706":88688,"_1911":88716},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_2322":50952,"_22971":50940,"_15675":88718,"_5":15564,"_21706":88688,"_1911":88719},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_2322":50953,"_22971":50940,"_15675":88721,"_5":15564,"_21706":88688,"_1911":88722},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_2322":50954,"_22971":50940,"_15675":88724,"_5":15564,"_21706":88688,"_1911":88725},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_2322":50955,"_22971":50940,"_15675":88727,"_5":15564,"_21706":88688,"_1911":88728},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_2322":50956,"_22971":50940,"_15675":88730,"_5":15564,"_21706":88692,"_1911":88731},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_2322":50957,"_22971":50940,"_15675":88733,"_5":15564,"_21706":88696,"_1911":88734},[],"El respondedor acepta los dos formatos definidos en RFC 6960:",{"_2322":50958,"_22971":50940,"_15675":88736,"_5":15564,"_21706":88696,"_1911":88737},[],"`GET /ocsp/{ocsp_request}` incluye la petición OCSP codificada en Base64url dentro de la propia URL.",{"_2322":50959,"_22971":50940,"_15675":88739,"_5":15564,"_21706":88696,"_1911":88740},[],"`POST /ocsp` envía la petición en el cuerpo con `Content-Type: application/ocsp-request`.",{"_2322":50960,"_22971":50940,"_15675":88742,"_5":15564,"_21706":88696,"_1911":88743},[],"Ejemplo de consulta con `curl` mediante POST:",{"_2322":50961,"_22971":50940,"_15675":88745,"_5":15564,"_21706":88696,"_1911":88746},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_2322":50962,"_22971":50940,"_15675":88748,"_5":15564,"_21706":88700,"_1911":88749},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_2322":50963,"_22971":50940,"_15675":88751,"_5":15564,"_21706":88704,"_1911":40990},[],{"_2322":50964,"_22971":50940,"_15675":88753,"_5":15564,"_21706":88704,"_1911":88754},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_2322":50965,"_22971":50940,"_15675":88756,"_5":15564,"_21706":88704,"_1911":88757},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2322":50966,"_22971":50940,"_15675":88759,"_5":15564,"_21706":88704,"_1911":86800},[],{"_2322":50967,"_22971":50967,"_5":10796,"_1911":88761,"_23246":88762,"_15675":88763,"_21706":50967},"Plataforma Lamassu IoT",[35713,84687],[],{"_2322":50968,"_22971":50967,"_15675":88765,"_5":15564,"_21706":50967,"_1911":88766},[],"Gestiona la PKI y las identidades digitales de tus dispositivos desde una única plataforma.",{"_2322":50969,"_22971":50967,"_5":23243,"_15675":88768,"_21706":88769,"_1911":88770},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#empieza-aquí","Empieza aquí",{"_2322":50970,"_22971":50967,"_5":23243,"_15675":88772,"_21706":88773,"_1911":88774},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2322":50971,"_22971":50967,"_5":23243,"_15675":88776,"_21706":88777,"_1911":88778},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#capacidades-principales","Capacidades principales",{"_2322":50972,"_22971":50967,"_5":23243,"_15675":88780,"_21706":88781,"_1911":88782},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2322":50973,"_22971":50967,"_5":23243,"_15675":88784,"_21706":88785,"_1911":88786},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2322":50974,"_22971":50967,"_5":23243,"_15675":88788,"_21706":88789,"_1911":88790},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2322":50975,"_22971":50967,"_5":23243,"_15675":88792,"_21706":88793,"_1911":88794},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2322":50976,"_22971":50967,"_5":23243,"_15675":88796,"_21706":88797,"_1911":88798},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2322":50977,"_22971":50967,"_5":23243,"_15675":88800,"_21706":88801,"_1911":88802},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2322":50978,"_22971":50967,"_5":23243,"_15675":88804,"_21706":88805,"_1911":88806},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#elige-tu-recorrido","Elige tu recorrido",{"_2322":50979,"_22971":50967,"_5":23243,"_15675":88808,"_21706":88809,"_1911":88810},[],"/docs/pr-preview/pr-28/es/platform/pki/overview#referencia-operativa","Referencia operativa",{"_2322":50980,"_22971":50967,"_15675":88812,"_5":15564,"_21706":50967,"_1911":88813},[],"Lamassu IoT centraliza la emisión, distribución, renovación y revocación de identidades X.509 para dispositivos conectados. Puedes construir una PKI privada, proteger sus claves y automatizar el enrolamiento de una flota sin perder visibilidad sobre cada certificado.",{"_2322":50981,"_22971":50967,"_15675":88815,"_5":15564,"_21706":88769,"_1911":88816},[],"<Card title=\"Primeros pasos\" description=\"Crea una CA, emite un certificado y registra tu primer dispositivo.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2322":50982,"_22971":50967,"_15675":88818,"_5":15564,"_21706":88769,"_1911":88819},[],"<Card title=\"Cómo funciona Lamassu\" description=\"Construye el modelo mental de autoridades, claves, identidades y validación.\" href=\"/docs/platform/pki/concepts/overview\" />",{"_2322":50983,"_22971":50967,"_15675":88821,"_5":15564,"_21706":88773,"_1911":88822},[],"Lamassu se ejecuta como un conjunto de servicios sobre Kubernetes, respaldados por PostgreSQL, RabbitMQ y un proveedor OIDC. Pasa el cursor sobre un componente para trazar sus conexiones, o consulta el capítulo de arquitectura de la plataforma para la vista de bajo nivel, servicio a servicio.",{"_2322":50984,"_22971":50967,"_15675":88824,"_5":15564,"_21706":88781,"_1911":88825},[],"Crea autoridades raíz e intermedias o importa una PKI existente. Define qué autoridad puede emitir cada identidad y conserva la cadena de confianza completa.",{"_2322":50985,"_22971":50967,"_15675":88827,"_5":15564,"_21706":88785,"_1911":88828},[],"Genera y custodia claves mediante motores software, HSMs PKCS#11 o servicios cloud. Lamassu desacopla las operaciones de la ubicación física de la clave.",{"_2322":50986,"_22971":50967,"_15675":88830,"_5":15564,"_21706":88789,"_1911":88831},[],"Emite certificados desde la consola o a partir de un CSR, consulta su estado y revócalos cuando dejan de ser fiables.",{"_2322":50987,"_22971":50967,"_15675":88833,"_5":15564,"_21706":88793,"_1911":88834},[],"Define políticas de enrolamiento mediante un Device Management Service (DMS) y deja que los dispositivos soliciten o renueven su identidad a través de EST.",{"_2322":50988,"_22971":50967,"_15675":88836,"_5":15564,"_21706":88797,"_1911":88837},[],"Ofrece validación online mediante OCSP y distribuye CRLs para consumidores que necesitan comprobar certificados sin conexión.",{"_2322":50989,"_22971":50967,"_15675":88839,"_5":15564,"_21706":88801,"_1911":88840},[],"Suscríbete a cambios del ciclo de vida y envía notificaciones por correo, Microsoft Teams o webhooks.",{"_2322":50990,"_22971":50967,"_15675":88842,"_5":15564,"_21706":88805,"_1911":88843},[],"<Card title=\"Administro la PKI\" description=\"Configura motores, autoridades, emisión y validación.\" href=\"/docs/platform/pki/key-management\" />",{"_2322":50991,"_22971":50967,"_15675":88845,"_5":15564,"_21706":88805,"_1911":88846},[],"<Card title=\"Integro un dispositivo\" description=\"Configura el DMS y usa EST para obtener una identidad.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2322":50992,"_22971":50967,"_15675":88848,"_5":15564,"_21706":88805,"_1911":88849},[],"<Card title=\"Opero la plataforma\" description=\"Despliega Lamassu y prepara sus dependencias.\" href=\"/docs/deployment/overview\" />",{"_2322":50993,"_22971":50967,"_15675":88851,"_5":15564,"_21706":88805,"_1911":88852},[],"<Card title=\"Integro otro sistema\" description=\"Conecta Lamassu con AWS IoT Core y otros destinos.\" href=\"/docs/platform/pki/integrations/aws-iot-core\" />",{"_2322":50994,"_22971":50967,"_15675":88854,"_5":15564,"_21706":88809,"_1911":88855},[],"<Card title=\"Perfiles de certificado\" description=\"Convierte la política de emisión en restricciones reutilizables.\" href=\"/docs/platform/pki/certificate-profiles\" />",{"_2322":50995,"_22971":50967,"_15675":88857,"_5":15564,"_21706":88809,"_1911":88858},[],"<Card title=\"Jerarquía y rotación\" description=\"Sustituye certificados o claves de CA sin romper la confianza.\" href=\"/docs/platform/pki/ca-hierarchy-and-rotation\" />",{"_2322":50996,"_22971":50967,"_15675":88860,"_5":15564,"_21706":88809,"_1911":88861},[],"<Card title=\"Control de acceso\" description=\"Configura principales, políticas y el primer administrador.\" href=\"/docs/platform/pki/access-control\" />",{"_2322":50997,"_22971":50967,"_15675":88863,"_5":15564,"_21706":88809,"_1911":88864},[],"<Card title=\"Resolución de problemas\" description=\"Diagnostica Gateway, servicios, emisión y enrolamiento.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2322":50998,"_22971":50998,"_5":10796,"_1911":88866,"_23246":88867,"_15675":88869,"_21706":50998},"Crea tu primera CA",[35713,84687,88868],"Primeros pasos",[],{"_2322":50999,"_22971":50998,"_15675":88871,"_5":15564,"_21706":50998,"_1911":88872},[],"Crea una autoridad raíz y comprueba que está preparada para emitir certificados.",{"_2322":51000,"_22971":50998,"_5":23243,"_15675":88874,"_21706":88875,"_1911":83598},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2322":51001,"_22971":50998,"_5":23243,"_15675":88877,"_21706":88878,"_1911":88879},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2322":51002,"_22971":50998,"_5":23243,"_15675":88881,"_21706":88882,"_1911":88883},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2322":51003,"_22971":50998,"_5":23243,"_15675":88885,"_21706":88886,"_1911":88887},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2322":51004,"_22971":50998,"_5":23243,"_15675":88889,"_21706":88890,"_1911":88891},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2322":51005,"_22971":50998,"_5":23243,"_15675":88893,"_21706":88894,"_1911":88895},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2322":51006,"_22971":50998,"_5":23243,"_15675":88897,"_21706":88898,"_1911":83622},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2322":51007,"_22971":50998,"_15675":88900,"_5":15564,"_21706":50998,"_1911":88901},[],"En este quickstart crearás una autoridad de certificación raíz con un nuevo par de claves. Al terminar tendrás una CA activa que podrás usar en el siguiente quickstart.",{"_2322":51008,"_22971":50998,"_15675":88903,"_5":15564,"_21706":88875,"_1911":88904},[],"Acceso a la consola con permisos para gestionar autoridades.",{"_2322":51009,"_22971":50998,"_15675":88906,"_5":15564,"_21706":88875,"_1911":88907},[],"Al menos un motor criptográfico disponible.",{"_2322":51010,"_22971":50998,"_15675":88909,"_5":15564,"_21706":88875,"_1911":88910},[],"Un nombre que identifique el propósito de la CA, por ejemplo `Acme Device Root CA`.",{"_2322":51011,"_22971":50998,"_15675":88912,"_5":15564,"_21706":88875,"_1911":88913},[],"Una CA raíz se autofirma y actúa como ancla de confianza. Para producción suele ser preferible mantener la raíz más protegida y emitir desde una CA intermedia.",{"_2322":51012,"_22971":50998,"_15675":88915,"_5":15564,"_21706":88878,"_1911":88916},[],"En el menú lateral, abre **Certification Authorities** y selecciona **Create New CA**.",{"_2322":51013,"_22971":50998,"_15675":88918,"_5":15564,"_21706":88878,"_1911":88919},[],"Elige crear una CA con un par de claves nuevo. Si ya tienes la clave en el KMS, usa &#x2A;*Create New CA (Existing Key)**.",{"_2322":51014,"_22971":50998,"_15675":88921,"_5":15564,"_21706":88882,"_1911":88922},[],"Elige el motor criptográfico que custodiará la clave y configura el algoritmo. Para una primera CA puedes usar **EC P-384**, siempre que sea compatible con tus consumidores.",{"_2322":51015,"_22971":50998,"_15675":88924,"_5":15564,"_21706":88882,"_1911":88925},[],"La clave privada permanecerá bajo el control del motor seleccionado.",{"_2322":51016,"_22971":50998,"_15675":88927,"_5":15564,"_21706":88886,"_1911":88928},[],"Selecciona **Root CA** y completa:",{"_2322":51017,"_22971":50998,"_15675":88930,"_5":15564,"_21706":88886,"_1911":88931},[],"**CA Name**: un nombre único y reconocible.",{"_2322":51018,"_22971":50998,"_15675":88933,"_5":15564,"_21706":88886,"_1911":88934},[],"**Subject**: al menos la organización y el país que identificarán a la autoridad.",{"_2322":51019,"_22971":50998,"_15675":88936,"_5":15564,"_21706":88886,"_1911":88937},[],"**CA Certificate Expiration**: una validez mayor que la de los certificados que emitirá.",{"_2322":51020,"_22971":50998,"_15675":88939,"_5":15564,"_21706":88886,"_1911":88940},[],"**Default End-Entity Certificate Issuance Expiration**: la validez predeterminada de los certificados finales.",{"_2322":51021,"_22971":50998,"_15675":88942,"_5":15564,"_21706":88886,"_1911":88943},[],"El nombre de la CA se utilizará como `Common Name` del certificado.",{"_2322":51022,"_22971":50998,"_15675":88945,"_5":15564,"_21706":88890,"_1911":88946},[],"Comprueba el algoritmo, el sujeto y las fechas antes de confirmar. Estos valores definen el ancla de confianza y no deberían elegirse como simples datos de prueba en un entorno productivo.",{"_2322":51023,"_22971":50998,"_15675":88948,"_5":15564,"_21706":88894,"_1911":88949},[],"Abre la nueva CA desde el listado. Debe aparecer activa y mostrar su certificado PEM, la fecha de expiración y la pestaña **Issued Certificates**.",{"_2322":51024,"_22971":50998,"_15675":88951,"_5":15564,"_21706":88898,"_1911":88952},[],"Usa la autoridad para emitir tu primer certificado, o consulta la guía completa de autoridades para crear una CA intermedia, importar una CA o definir perfiles avanzados.",{"_2322":51025,"_22971":51025,"_5":10796,"_1911":88954,"_23246":88955,"_15675":88956,"_21706":51025},"Emite tu primer certificado",[35713,84687,88868],[],{"_2322":51026,"_22971":51025,"_15675":88958,"_5":15564,"_21706":51025,"_1911":88959},[],"Emite una identidad X.509 desde la consola y verifica el resultado.",{"_2322":51027,"_22971":51025,"_5":23243,"_15675":88961,"_21706":88962,"_1911":83598},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2322":51028,"_22971":51025,"_5":23243,"_15675":88964,"_21706":88965,"_1911":88966},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2322":51029,"_22971":51025,"_5":23243,"_15675":88968,"_21706":88969,"_1911":88970},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2322":51030,"_22971":51025,"_5":23243,"_15675":88972,"_21706":88973,"_1911":88974},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2322":51031,"_22971":51025,"_5":23243,"_15675":88976,"_21706":88977,"_1911":88978},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2322":51032,"_22971":51025,"_5":23243,"_15675":88980,"_21706":88981,"_1911":88982},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2322":51033,"_22971":51025,"_5":23243,"_15675":88984,"_21706":88985,"_1911":88895},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2322":51034,"_22971":51025,"_5":23243,"_15675":88987,"_21706":88988,"_1911":83622},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2322":51035,"_22971":51025,"_15675":88990,"_5":15564,"_21706":51025,"_1911":88991},[],"En este quickstart Lamassu generará la clave y el CSR en el navegador, y la CA emitirá el certificado. Al terminar descargarás el certificado y su clave privada.",{"_2322":51036,"_22971":51025,"_15675":88993,"_5":15564,"_21706":88962,"_1911":88994},[],"Una CA activa con permiso para emitir certificados.",{"_2322":51037,"_22971":51025,"_15675":88996,"_5":15564,"_21706":88962,"_1911":88997},[],"Un nombre para la identidad, por ejemplo `device-001.example.internal`.",{"_2322":51038,"_22971":51025,"_15675":88999,"_5":15564,"_21706":88962,"_1911":89000},[],"Un lugar seguro en el que custodiar la clave privada descargada.",{"_2322":51039,"_22971":51025,"_15675":89002,"_5":15564,"_21706":88962,"_1911":89003},[],"En este flujo la clave se genera en el navegador y Lamassu no la almacena. Descárgala y protégela antes de cerrar el resultado de la operación.",{"_2322":51040,"_22971":51025,"_15675":89005,"_5":15564,"_21706":88965,"_1911":89006},[],"Abre la CA creada en el quickstart anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2322":51041,"_22971":51025,"_15675":89008,"_5":15564,"_21706":88969,"_1911":89009},[],"Selecciona **Generate Key & CSR in Browser**. Usa **Upload Existing CSR** cuando la clave privada deba generarse y permanecer en el sistema de destino.",{"_2322":51042,"_22971":51025,"_15675":89011,"_5":15564,"_21706":88973,"_1911":89012},[],"Introduce el `Common Name` y, si corresponde, la organización, unidad organizativa y ubicación. Añade SANs para cada nombre DNS, dirección IP, correo o URI con el que se vaya a validar la identidad.",{"_2322":51043,"_22971":51025,"_15675":89014,"_5":15564,"_21706":88977,"_1911":89015},[],"Elige RSA o ECDSA, define la validez y selecciona los usos de clave. Para una identidad de dispositivo que usa mTLS, habilita **Digital Signature** y **Client Authentication**.",{"_2322":51044,"_22971":51025,"_15675":89017,"_5":15564,"_21706":88977,"_1911":89018},[],"La validez no puede superar la fecha de expiración de la CA emisora.",{"_2322":51045,"_22971":51025,"_15675":89020,"_5":15564,"_21706":88981,"_1911":89021},[],"Confirma la emisión y descarga inmediatamente el certificado y la clave privada en formato PEM.",{"_2322":51046,"_22971":51025,"_15675":89023,"_5":15564,"_21706":88985,"_1911":89024},[],"El certificado debe aparecer en **Issued Certificates** con estado activo. Comprueba su sujeto, SANs, emisor, usos y periodo de validez.",{"_2322":51047,"_22971":51025,"_15675":89026,"_5":15564,"_21706":88988,"_1911":89027},[],"Registra tu primer dispositivo para asociar la identidad a una entidad gestionada, o consulta la gestión de certificados.",{"_2322":51048,"_22971":51048,"_5":10796,"_1911":88868,"_23246":89029,"_15675":89030,"_21706":51048},[35713,84687,88868],[],{"_2322":51049,"_22971":51048,"_15675":89032,"_5":15564,"_21706":51048,"_1911":89033},[],"Obtén un primer resultado con Lamassu y continúa desde una base funcional.",{"_2322":51050,"_22971":51048,"_5":23243,"_15675":89035,"_21706":89036,"_1911":89037},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2322":51051,"_22971":51048,"_5":23243,"_15675":89039,"_21706":89040,"_1911":83598},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2322":51052,"_22971":51048,"_15675":89042,"_5":15564,"_21706":51048,"_1911":89043},[],"Los quickstarts te llevan desde una instancia preparada hasta una identidad de dispositivo activa. Cada guía produce un resultado verificable y enlaza la explicación detallada cuando necesitas ir más allá.",{"_2322":51053,"_22971":51048,"_15675":89045,"_5":15564,"_21706":89036,"_1911":89046},[],"<Card title=\"1. Crea tu primera CA\" description=\"Establece una raíz de confianza capaz de emitir certificados.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2322":51054,"_22971":51048,"_15675":89048,"_5":15564,"_21706":89036,"_1911":89049},[],"<Card title=\"2. Emite un certificado\" description=\"Crea una identidad X.509 y verifica su contenido.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2322":51055,"_22971":51048,"_15675":89051,"_5":15564,"_21706":89036,"_1911":89052},[],"<Card title=\"3. Registra un dispositivo\" description=\"Añade un dispositivo y asígnale su primera identidad.\" href=\"/docs/platform/pki/quickstarts/register-device\" />",{"_2322":51056,"_22971":51048,"_15675":89054,"_5":15564,"_21706":89040,"_1911":89055},[],"Necesitas acceso a la consola de Lamassu IoT y permisos para administrar claves, autoridades y dispositivos. La instancia debe tener al menos un motor criptográfico configurado.",{"_2322":51057,"_22971":51048,"_15675":89057,"_5":15564,"_21706":89040,"_1911":89058},[],"Si todavía no tienes una instancia, elige primero un modelo de despliegue.",{"_2322":51058,"_22971":51058,"_5":10796,"_1911":89060,"_23246":89061,"_15675":89062,"_21706":51058},"Registra tu primer dispositivo",[35713,84687,88868],[],{"_2322":51059,"_22971":51058,"_15675":89064,"_5":15564,"_21706":51058,"_1911":89065},[],"Añade un dispositivo a Lamassu y asígnale una identidad activa.",{"_2322":51060,"_22971":51058,"_5":23243,"_15675":89067,"_21706":89068,"_1911":83598},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/register-device#antes-de-empezar",{"_2322":51061,"_22971":51058,"_5":23243,"_15675":89070,"_21706":89071,"_1911":89072},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2322":51062,"_22971":51058,"_5":23243,"_15675":89074,"_21706":89075,"_1911":89076},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2322":51063,"_22971":51058,"_5":23243,"_15675":89078,"_21706":89079,"_1911":89080},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2322":51064,"_22971":51058,"_5":23243,"_15675":89082,"_21706":89083,"_1911":89084},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2322":51065,"_22971":51058,"_5":23243,"_15675":89086,"_21706":89087,"_1911":89088},[],"/docs/pr-preview/pr-28/es/platform/pki/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2322":51066,"_22971":51058,"_15675":89090,"_5":15564,"_21706":51058,"_1911":89091},[],"En este quickstart registrarás manualmente un dispositivo y le asignarás su primer certificado. Es el recorrido más corto para entender cómo Lamassu relaciona una entidad física con su historial de identidades.",{"_2322":51067,"_22971":51058,"_15675":89093,"_5":15564,"_21706":89068,"_1911":89094},[],"Un DMS configurado.",{"_2322":51068,"_22971":51058,"_15675":89096,"_5":15564,"_21706":89068,"_1911":89097},[],"Una CA asociada al DMS.",{"_2322":51069,"_22971":51058,"_15675":89099,"_5":15564,"_21706":89068,"_1911":89100},[],"Un identificador único para el dispositivo.",{"_2322":51070,"_22971":51058,"_15675":89102,"_5":15564,"_21706":89071,"_1911":89103},[],"Abre **Managed Devices**, selecciona la acción para registrar un dispositivo y completa:",{"_2322":51071,"_22971":51058,"_15675":89105,"_5":15564,"_21706":89071,"_1911":89106},[],"**Device ID**: identificador único del dispositivo.",{"_2322":51072,"_22971":51058,"_15675":89108,"_5":15564,"_21706":89071,"_1911":89109},[],"**Registration Authority**: DMS que aplicará las políticas de enrolamiento.",{"_2322":51073,"_22971":51058,"_15675":89111,"_5":15564,"_21706":89071,"_1911":89112},[],"**Icon** y **Tags**: clasificación opcional para localizarlo después.",{"_2322":51074,"_22971":51058,"_15675":89114,"_5":15564,"_21706":89075,"_1911":89115},[],"Abre el dispositivo recién creado. Debe aparecer con estado **No Identity**: existe en el inventario, pero todavía no tiene un certificado asociado.",{"_2322":51075,"_22971":51058,"_15675":89117,"_5":15564,"_21706":89079,"_1911":89118},[],"Selecciona **Assign Identity**. Lamassu buscará certificados activos cuyo `Common Name` coincida con el `Device ID`.",{"_2322":51076,"_22971":51058,"_15675":89120,"_5":15564,"_21706":89079,"_1911":89121},[],"Selecciona un certificado existente o usa **Issue New Instead** para emitir uno desde una CA vinculada al DMS.",{"_2322":51077,"_22971":51058,"_15675":89123,"_5":15564,"_21706":89083,"_1911":89124},[],"Tras confirmar, el estado debe cambiar a **Active**. Revisa **Certificate History** para comprobar la identidad asociada y **Device Event Timeline** para ver el evento de asignación.",{"_2322":51078,"_22971":51058,"_15675":89126,"_5":15564,"_21706":89087,"_1911":89127},[],"El registro manual ayuda a entender el modelo, pero una flota debe usar enrolamiento automatizado. Continúa con Device Management Service y la integración EST.",{"_2322":51079,"_22971":51079,"_5":10796,"_1911":89129,"_23246":89130,"_15675":89131,"_21706":51079},"Resolución de problemas",[35713,84687,84688],[],{"_2322":51080,"_22971":51079,"_15675":89133,"_5":15564,"_21706":51079,"_1911":89134},[],"Diagnostica acceso, salud, emisión, enrolamiento y dependencias en un despliegue de Lamassu.",{"_2322":51081,"_22971":51079,"_5":23243,"_15675":89136,"_21706":89137,"_1911":89138},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2322":51082,"_22971":51079,"_5":23243,"_15675":89140,"_21706":89141,"_1911":89142},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2322":51083,"_22971":51079,"_5":23243,"_15675":89144,"_21706":89145,"_1911":89146},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2322":51084,"_22971":51079,"_5":23243,"_15675":89148,"_21706":89149,"_1911":89150},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2322":51085,"_22971":51079,"_5":23243,"_15675":89152,"_21706":89153,"_1911":89154},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2322":51086,"_22971":51079,"_5":23243,"_15675":89156,"_21706":89157,"_1911":89158},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2322":51087,"_22971":51079,"_5":23243,"_15675":89160,"_21706":89161,"_1911":89162},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2322":51088,"_22971":51079,"_5":23243,"_15675":89164,"_21706":89165,"_1911":89166},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2322":51089,"_22971":51079,"_5":23243,"_15675":89168,"_21706":89169,"_1911":89170},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2322":51090,"_22971":51079,"_5":23243,"_15675":89172,"_21706":89173,"_1911":89174},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2322":51091,"_22971":51079,"_5":23243,"_15675":89176,"_21706":89177,"_1911":89178},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2322":51092,"_22971":51079,"_5":23243,"_15675":89180,"_21706":89181,"_1911":89182},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2322":51093,"_22971":51079,"_5":23243,"_15675":89184,"_21706":89185,"_1911":89186},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2322":51094,"_22971":51079,"_5":23243,"_15675":89188,"_21706":89189,"_1911":89190},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2322":51095,"_22971":51079,"_5":23243,"_15675":89192,"_21706":89193,"_1911":89194},[],"/docs/pr-preview/pr-28/es/platform/pki/troubleshooting#observabilidad","Observabilidad",{"_2322":51096,"_22971":51079,"_15675":89196,"_5":15564,"_21706":51079,"_1911":89197},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway, un pod no preparado y una emisión rechazada pueden parecer el mismo problema desde la consola, pero requieren evidencias distintas.",{"_2322":51097,"_22971":51079,"_15675":89199,"_5":15564,"_21706":89141,"_1911":89200},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2322":51098,"_22971":51079,"_15675":89202,"_5":15564,"_21706":89145,"_1911":89203},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2322":51099,"_22971":51079,"_15675":89205,"_5":15564,"_21706":89149,"_1911":89206},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2322":51100,"_22971":51079,"_15675":89208,"_5":15564,"_21706":89153,"_1911":89209},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2322":51101,"_22971":51079,"_15675":89211,"_5":15564,"_21706":89157,"_1911":89212},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2322":51102,"_22971":51079,"_15675":89214,"_5":15564,"_21706":89161,"_1911":89215},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2322":51103,"_22971":51079,"_15675":89217,"_5":15564,"_21706":89161,"_1911":89218},[],"Ejecuta también la prueba de conectividad del chart:",{"_2322":51104,"_22971":51079,"_15675":89220,"_5":15564,"_21706":89161,"_1911":89221},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2322":51105,"_22971":51079,"_15675":89223,"_5":15564,"_21706":89161,"_1911":89224},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2322":51106,"_22971":51079,"_15675":89226,"_5":15564,"_21706":89165,"_1911":89227},[],"Si recibes un 401:",{"_2322":51107,"_22971":51079,"_15675":89229,"_5":15564,"_21706":89165,"_1911":89230},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2322":51108,"_22971":51079,"_15675":89232,"_5":15564,"_21706":89165,"_1911":89233},[],"verifica emisor, audiencia y expiración del token;",{"_2322":51109,"_22971":51079,"_15675":89235,"_5":15564,"_21706":89165,"_1911":89236},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2322":51110,"_22971":51079,"_15675":89238,"_5":15564,"_21706":89165,"_1911":89239},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2322":51111,"_22971":51079,"_15675":89241,"_5":15564,"_21706":89165,"_1911":89242},[],"Si el login termina pero las APIs devuelven 403:",{"_2322":51112,"_22971":51079,"_15675":89244,"_5":15564,"_21706":89165,"_1911":89245},[],"inspecciona los claims reales del token;",{"_2322":51113,"_22971":51079,"_15675":89247,"_5":15564,"_21706":89165,"_1911":89248},[],"confirma que coinciden con un principal activo;",{"_2322":51114,"_22971":51079,"_15675":89250,"_5":15564,"_21706":89165,"_1911":89251},[],"revisa las políticas concedidas al principal;",{"_2322":51115,"_22971":51079,"_15675":89253,"_5":15564,"_21706":89165,"_1911":89254},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2322":51116,"_22971":51079,"_15675":89256,"_5":15564,"_21706":89165,"_1911":89257},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2322":51117,"_22971":51079,"_15675":89259,"_5":15564,"_21706":89169,"_1911":89260},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2322":51118,"_22971":51079,"_15675":89262,"_5":15564,"_21706":89169,"_1911":89263},[],"Localiza el pod y Service de authz.",{"_2322":51119,"_22971":51079,"_15675":89265,"_5":15564,"_21706":89169,"_1911":89266},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2322":51120,"_22971":51079,"_15675":89268,"_5":15564,"_21706":89169,"_1911":89269},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2322":51121,"_22971":51079,"_15675":89271,"_5":15564,"_21706":89169,"_1911":89272},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2322":51122,"_22971":51079,"_15675":89274,"_5":15564,"_21706":89169,"_1911":89275},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2322":51123,"_22971":51079,"_15675":89277,"_5":15564,"_21706":89173,"_1911":89278},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2322":51124,"_22971":51079,"_15675":89280,"_5":15564,"_21706":89173,"_1911":89281},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2322":51125,"_22971":51079,"_15675":89283,"_5":15564,"_21706":89173,"_1911":89284},[],"volumen persistente sin enlazar;",{"_2322":51126,"_22971":51079,"_15675":89286,"_5":15564,"_21706":89173,"_1911":89287},[],"imagen inaccesible o política de pull incorrecta;",{"_2322":51127,"_22971":51079,"_15675":89289,"_5":15564,"_21706":89173,"_1911":89290},[],"configuración inválida del motor criptográfico;",{"_2322":51128,"_22971":51079,"_15675":89292,"_5":15564,"_21706":89173,"_1911":89293},[],"límites de CPU o memoria demasiado bajos;",{"_2322":51129,"_22971":51079,"_15675":89295,"_5":15564,"_21706":89173,"_1911":89296},[],"migración previa incompleta.",{"_2322":51130,"_22971":51079,"_15675":89298,"_5":15564,"_21706":89173,"_1911":89299},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2322":51131,"_22971":51079,"_15675":89301,"_5":15564,"_21706":89173,"_1911":89302},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2322":51132,"_22971":51079,"_15675":89304,"_5":15564,"_21706":89177,"_1911":89305},[],"Acota el error siguiendo este orden:",{"_2322":51133,"_22971":51079,"_15675":89307,"_5":15564,"_21706":89177,"_1911":89308},[],"La CA existe, está activa y no ha expirado.",{"_2322":51134,"_22971":51079,"_15675":89310,"_5":15564,"_21706":89177,"_1911":89311},[],"La CA tiene una clave privada utilizable y el motor está disponible.",{"_2322":51135,"_22971":51079,"_15675":89313,"_5":15564,"_21706":89177,"_1911":89314},[],"La CSR tiene una firma válida.",{"_2322":51136,"_22971":51079,"_15675":89316,"_5":15564,"_21706":89177,"_1911":89317},[],"El perfil permite el tipo y tamaño de clave.",{"_2322":51137,"_22971":51079,"_15675":89319,"_5":15564,"_21706":89177,"_1911":89320},[],"La validez solicitada cabe dentro de la vigencia de la CA.",{"_2322":51138,"_22971":51079,"_15675":89322,"_5":15564,"_21706":89177,"_1911":89323},[],"KU, EKU, sujeto y extensiones cumplen el perfil.",{"_2322":51139,"_22971":51079,"_15675":89325,"_5":15564,"_21706":89177,"_1911":89326},[],"Si la reemisión de una CA falla, recuerda que no se admite para una CA revocada o ya expirada. Para cambiar su clave, sigue Jerarquía y rotación de CAs.",{"_2322":51140,"_22971":51079,"_15675":89328,"_5":15564,"_21706":89181,"_1911":89329},[],"Comprueba:",{"_2322":51141,"_22971":51079,"_15675":89331,"_5":15564,"_21706":89181,"_1911":89332},[],"el identificador del DMS en el path EST;",{"_2322":51142,"_22971":51079,"_15675":89334,"_5":15564,"_21706":89181,"_1911":89335},[],"el método de autenticación configurado;",{"_2322":51143,"_22971":51079,"_15675":89337,"_5":15564,"_21706":89181,"_1911":89338},[],"la cadena presentada por el cliente;",{"_2322":51144,"_22971":51079,"_15675":89340,"_5":15564,"_21706":89181,"_1911":89341},[],"las CAs de validación y el límite de niveles;",{"_2322":51145,"_22971":51079,"_15675":89343,"_5":15564,"_21706":89181,"_1911":89344},[],"el estado de revocación del certificado cliente;",{"_2322":51146,"_22971":51079,"_15675":89346,"_5":15564,"_21706":89181,"_1911":89347},[],"la firma de la CSR;",{"_2322":51147,"_22971":51079,"_15675":89349,"_5":15564,"_21706":89181,"_1911":89350},[],"la CA y el perfil usados para emitir;",{"_2322":51148,"_22971":51079,"_15675":89352,"_5":15564,"_21706":89181,"_1911":89353},[],"la ventana de re-enrolamiento.",{"_2322":51149,"_22971":51079,"_15675":89355,"_5":15564,"_21706":89181,"_1911":89356},[],"En re-enrolamiento, Lamassu intenta validar primero con la CA de enrolamiento y después con las CAs adicionales. Durante una migración, conserva la CA anterior en ese segundo conjunto hasta terminar el solapamiento.",{"_2322":51150,"_22971":51079,"_15675":89358,"_5":15564,"_21706":89185,"_1911":89359},[],"Confirma que la revocación quedó persistida y tiene razón y timestamp.",{"_2322":51151,"_22971":51079,"_15675":89361,"_5":15564,"_21706":89185,"_1911":89362},[],"Revisa la configuración y logs de VA.",{"_2322":51152,"_22971":51079,"_15675":89364,"_5":15564,"_21706":89185,"_1911":89365},[],"Comprueba la periodicidad y próxima actualización de la CRL.",{"_2322":51153,"_22971":51079,"_15675":89367,"_5":15564,"_21706":89185,"_1911":89368},[],"Descarta cachés intermedias en proxy y cliente.",{"_2322":51154,"_22971":51079,"_15675":89370,"_5":15564,"_21706":89185,"_1911":89371},[],"Verifica que el certificado apunta al endpoint que estás consultando.",{"_2322":51155,"_22971":51079,"_15675":89373,"_5":15564,"_21706":89185,"_1911":89374},[],"Consulta por número de serie y emisor correctos.",{"_2322":51156,"_22971":51079,"_15675":89376,"_5":15564,"_21706":89189,"_1911":89377},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2322":51157,"_22971":51079,"_15675":89379,"_5":15564,"_21706":89189,"_1911":89380},[],"verifica que esté habilitado en el servicio emisor;",{"_2322":51158,"_22971":51079,"_15675":89382,"_5":15564,"_21706":89189,"_1911":89383},[],"comprueba conectividad y credenciales AMQP;",{"_2322":51159,"_22971":51079,"_15675":89385,"_5":15564,"_21706":89189,"_1911":89386},[],"revisa exchange, routing key, colas y consumidores;",{"_2322":51160,"_22971":51079,"_15675":89388,"_5":15564,"_21706":89189,"_1911":89389},[],"inspecciona dead-letter queues;",{"_2322":51161,"_22971":51079,"_15675":89391,"_5":15564,"_21706":89189,"_1911":89392},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2322":51162,"_22971":51079,"_15675":89394,"_5":15564,"_21706":89189,"_1911":89395},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2322":51163,"_22971":51079,"_15675":89397,"_5":15564,"_21706":89193,"_1911":89398},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2322":51164,"_22971":51079,"_15675":89400,"_5":15564,"_21706":89193,"_1911":89401},[],"Antes de cerrar una incidencia, guarda:",{"_2322":51165,"_22971":51079,"_15675":89403,"_5":15564,"_21706":89193,"_1911":89404},[],"causa confirmada;",{"_2322":51166,"_22971":51079,"_15675":89406,"_5":15564,"_21706":89193,"_1911":89407},[],"alcance temporal y recursos afectados;",{"_2322":51167,"_22971":51079,"_15675":89409,"_5":15564,"_21706":89193,"_1911":89410},[],"comandos o consultas utilizados;",{"_2322":51168,"_22971":51079,"_15675":89412,"_5":15564,"_21706":89193,"_1911":89413},[],"cambio aplicado y forma de revertirlo;",{"_2322":51169,"_22971":51079,"_15675":89415,"_5":15564,"_21706":89193,"_1911":89416},[],"validación desde un consumidor;",{"_2322":51170,"_22971":51079,"_15675":89418,"_5":15564,"_21706":89193,"_1911":89419},[],"acción preventiva y propietario.",{"_2322":51171,"_22971":51171,"_5":10796,"_1911":41660,"_15675":89421,"_21706":51171},[],{"_2322":51172,"_22971":51171,"_15675":89423,"_5":15564,"_21706":51171,"_1911":41664},[],{"_2322":51173,"_22971":51171,"_5":23243,"_15675":89425,"_21706":89426,"_1911":41668},[],"/docs/pr-preview/pr-28/es/test#cards",{"_2322":51174,"_22971":51171,"_5":23243,"_15675":89428,"_21706":89429,"_1911":41672},[],"/docs/pr-preview/pr-28/es/test#codeblock",{"_2322":51175,"_22971":51171,"_5":23243,"_15675":89431,"_21706":89432,"_1911":41676},[],"/docs/pr-preview/pr-28/es/test#list",{"_2322":51176,"_22971":51171,"_15675":89434,"_5":15564,"_21706":51171,"_1911":41679},[],{"_2322":51177,"_22971":51171,"_15675":89436,"_5":15564,"_21706":89426,"_1911":41682},[],{"_2322":51178,"_22971":51171,"_15675":89438,"_5":15564,"_21706":89426,"_1911":41685},[],{"_2322":51179,"_22971":51171,"_15675":89440,"_5":15564,"_21706":89432,"_1911":41688},[],{"_2322":51180,"_22971":51171,"_15675":89442,"_5":15564,"_21706":89432,"_1911":41691},[],{"_41695":89444,"_41697":89445,"_41699":89446,"_41701":89447,"_13497":1928,"_492