32779":47032,"_32781":47035,"_32783":47038,"_32785":47041,"_32787":47044,"_32789":47047,"_32791":47050,"_32793":47052,"_32795":47055,"_32797":47058,"_32799":47061,"_32801":47064,"_32803":47067,"_32805":47070,"_32807":47073,"_32809":47076,"_32811":47079,"_32813":47082,"_32815":47085,"_32817":47088},{"_2802":15,"_24443":15,"_5":12033,"_2329":39820,"_24778":39821,"_17120":39825,"_23194":15},"Deploy from AWS Marketplace",[39822,39823,39824],"Docs","Deployment","Other models",[],{"_2802":16,"_24443":15,"_17120":39827,"_5":17015,"_23194":15,"_2329":39828},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2802":17,"_24443":15,"_5":24775,"_17120":39830,"_23194":39831,"_2329":39832},[],"/docs/pr-preview/pr-28/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2802":18,"_24443":15,"_5":24775,"_17120":39834,"_23194":39835,"_2329":39836},[],"/docs/pr-preview/pr-28/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2802":19,"_24443":15,"_5":24775,"_17120":39838,"_23194":39839,"_2329":39840},[],"/docs/pr-preview/pr-28/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2802":20,"_24443":15,"_5":24775,"_17120":39842,"_23194":39843,"_2329":39844},[],"/docs/pr-preview/pr-28/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2802":21,"_24443":15,"_5":24775,"_17120":39846,"_23194":39847,"_2329":39848},[],"/docs/pr-preview/pr-28/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2802":22,"_24443":15,"_5":24775,"_17120":39850,"_23194":39851,"_2329":39852},[],"/docs/pr-preview/pr-28/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2802":23,"_24443":15,"_5":24775,"_17120":39854,"_23194":39855,"_2329":39856},[],"/docs/pr-preview/pr-28/deployment/aws-marketplace#next-step","Next step",{"_2802":24,"_24443":15,"_17120":39858,"_5":17015,"_23194":15,"_2329":39859},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2802":25,"_24443":15,"_17120":39861,"_5":17015,"_23194":39831,"_2329":39862},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2802":26,"_24443":15,"_17120":39864,"_5":17015,"_23194":39831,"_2329":39865},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2802":27,"_24443":15,"_17120":39867,"_5":17015,"_23194":39831,"_2329":39868},[],"A security group allowing the necessary endpoints.",{"_2802":28,"_24443":15,"_17120":39870,"_5":17015,"_23194":39835,"_2329":39871},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2802":29,"_24443":15,"_17120":39873,"_5":17015,"_23194":39835,"_2329":39874},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2802":30,"_24443":15,"_17120":39876,"_5":17015,"_23194":39835,"_2329":39877},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2802":31,"_24443":15,"_17120":39879,"_5":17015,"_23194":39839,"_2329":39880},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2802":32,"_24443":15,"_17120":39882,"_5":17015,"_23194":39843,"_2329":39883},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2802":33,"_24443":15,"_17120":39885,"_5":17015,"_23194":39847,"_2329":39886},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2802":34,"_24443":15,"_17120":39888,"_5":17015,"_23194":39851,"_2329":39889},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2802":35,"_24443":15,"_17120":39891,"_5":17015,"_23194":39855,"_2329":39892},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2802":36,"_24443":36,"_5":12033,"_2329":39894,"_24778":39895,"_17120":39896,"_23194":36},"Deploy Lamassu",[39822,39823],[],{"_2802":37,"_24443":36,"_17120":39898,"_5":17015,"_23194":36,"_2329":39899},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2802":38,"_24443":36,"_5":24775,"_17120":39901,"_23194":39902,"_2329":39903},[],"/docs/pr-preview/pr-28/deployment/overview#choose-a-model","Choose a model",{"_2802":39,"_24443":36,"_5":24775,"_17120":39905,"_23194":39906,"_2329":39907},[],"/docs/pr-preview/pr-28/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2802":40,"_24443":36,"_5":24775,"_17120":39909,"_23194":39910,"_2329":39911},[],"/docs/pr-preview/pr-28/deployment/overview#after-deployment","After deployment",{"_2802":41,"_24443":36,"_17120":39913,"_5":17015,"_23194":36,"_2329":39914},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2802":42,"_24443":36,"_17120":39916,"_5":17015,"_23194":39902,"_2329":39917},[],"Model",{"_2802":43,"_24443":36,"_17120":39919,"_5":17015,"_23194":39902,"_2329":39920},[],"Recommended for",{"_2802":44,"_24443":36,"_17120":39922,"_5":17015,"_23194":39902,"_2329":39923},[],"Who operates the infrastructure",{"_2802":45,"_24443":36,"_17120":39925,"_5":17015,"_23194":39902,"_2329":39926},[],"Starting point",{"_2802":46,"_24443":36,"_17120":39928,"_5":17015,"_23194":39902,"_2329":39929},[],"Kubernetes self-managed",{"_2802":47,"_24443":36,"_17120":39931,"_5":17015,"_23194":39902,"_2329":39932},[],"Production, regulated environments and custom deployments",{"_2802":48,"_24443":36,"_17120":39934,"_5":17015,"_23194":39902,"_2329":39935},[],"Your team",{"_2802":49,"_24443":36,"_17120":39937,"_5":17015,"_23194":39902,"_2329":39938},[],"Helm or Fastlane",{"_2802":50,"_24443":36,"_17120":39940,"_5":17015,"_23194":39902,"_2329":39941},[],"AWS Marketplace",{"_2802":51,"_24443":36,"_17120":39943,"_5":17015,"_23194":39902,"_2329":39944},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2802":52,"_24443":36,"_17120":39946,"_5":17015,"_23194":39902,"_2329":39935},[],{"_2802":53,"_24443":36,"_17120":39948,"_5":17015,"_23194":39902,"_2329":39949},[],"Preconfigured image on EC2",{"_2802":54,"_24443":36,"_17120":39951,"_5":17015,"_23194":39902,"_2329":39952},[],"SaaS",{"_2802":55,"_24443":36,"_17120":39954,"_5":17015,"_23194":39902,"_2329":39955},[],"Teams that want to use the platform without operating it",{"_2802":56,"_24443":36,"_17120":39957,"_5":17015,"_23194":39902,"_2329":39958},[],"Lamassu",{"_2802":57,"_24443":36,"_17120":39960,"_5":17015,"_23194":39902,"_2329":39961},[],"Managed subscription",{"_2802":58,"_24443":36,"_17120":39963,"_5":17015,"_23194":39902,"_2329":39964},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2802":59,"_24443":36,"_17120":39966,"_5":17015,"_23194":39902,"_2329":39967},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2802":60,"_24443":36,"_17120":39969,"_5":17015,"_23194":39902,"_2329":39970},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2802":61,"_24443":36,"_17120":39972,"_5":17015,"_23194":39906,"_2329":39973},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2802":62,"_24443":36,"_17120":39975,"_5":17015,"_23194":39910,"_2329":39976},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2802":63,"_24443":63,"_5":12033,"_2329":39978,"_24778":39979,"_17120":39980,"_23194":63},"Use Lamassu as SaaS",[39822,39823,39824],[],{"_2802":64,"_24443":63,"_17120":39982,"_5":17015,"_23194":63,"_2329":39983},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2802":65,"_24443":63,"_5":24775,"_17120":39985,"_23194":39986,"_2329":39987},[],"/docs/pr-preview/pr-28/deployment/saas#what-the-service-manages","What the service manages",{"_2802":66,"_24443":63,"_5":24775,"_17120":39989,"_23194":39990,"_2329":39991},[],"/docs/pr-preview/pr-28/deployment/saas#plans","Plans",{"_2802":67,"_24443":63,"_5":24775,"_17120":39993,"_23194":39994,"_2329":39995},[],"/docs/pr-preview/pr-28/deployment/saas#request-access","Request access",{"_2802":68,"_24443":63,"_17120":39997,"_5":17015,"_23194":63,"_2329":39998},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2802":69,"_24443":63,"_17120":40000,"_5":17015,"_23194":39986,"_2329":40001},[],"Platform availability and maintenance.",{"_2802":70,"_24443":63,"_17120":40003,"_5":17015,"_23194":39986,"_2329":40004},[],"Automatic backups.",{"_2802":71,"_24443":63,"_17120":40006,"_5":17015,"_23194":39986,"_2329":40007},[],"Version upgrades.",{"_2802":72,"_24443":63,"_17120":40009,"_5":17015,"_23194":39986,"_2329":40010},[],"Technical support and SLA according to your plan.",{"_2802":73,"_24443":63,"_17120":40012,"_5":17015,"_23194":39990,"_2329":40013},[],"Plan",{"_2802":74,"_24443":63,"_17120":40015,"_5":17015,"_23194":39990,"_2329":40016},[],"Devices",{"_2802":75,"_24443":63,"_17120":40018,"_5":17015,"_23194":39990,"_2329":40019},[],"Support",{"_2802":76,"_24443":63,"_17120":40021,"_5":17015,"_23194":39990,"_2329":40022},[],"SLA",{"_2802":77,"_24443":63,"_17120":40024,"_5":17015,"_23194":39990,"_2329":40025},[],"Starter",{"_2802":78,"_24443":63,"_17120":40027,"_5":17015,"_23194":39990,"_2329":40028},[],"Up to 1,000",{"_2802":79,"_24443":63,"_17120":40030,"_5":17015,"_23194":39990,"_2329":40031},[],"Email",{"_2802":80,"_24443":63,"_17120":40033,"_5":17015,"_23194":39990,"_2329":40034},[],"99.5 %",{"_2802":81,"_24443":63,"_17120":40036,"_5":17015,"_23194":39990,"_2329":40037},[],"Professional",{"_2802":82,"_24443":63,"_17120":40039,"_5":17015,"_23194":39990,"_2329":40040},[],"Up to 10,000",{"_2802":83,"_24443":63,"_17120":40042,"_5":17015,"_23194":39990,"_2329":40043},[],"Email and chat",{"_2802":84,"_24443":63,"_17120":40045,"_5":17015,"_23194":39990,"_2329":40046},[],"99.9 %",{"_2802":85,"_24443":63,"_17120":40048,"_5":17015,"_23194":39990,"_2329":40049},[],"Enterprise",{"_2802":86,"_24443":63,"_17120":40051,"_5":17015,"_23194":39990,"_2329":40052},[],"Unlimited",{"_2802":87,"_24443":63,"_17120":40054,"_5":17015,"_23194":39990,"_2329":40055},[],"Dedicated",{"_2802":88,"_24443":63,"_17120":40057,"_5":17015,"_23194":39990,"_2329":40058},[],"99.99 %",{"_2802":89,"_24443":63,"_17120":40060,"_5":17015,"_23194":39994,"_2329":40061},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2802":90,"_24443":63,"_17120":40063,"_5":17015,"_23194":39994,"_2329":40064},[],"When you receive your instance's credentials, continue with Get started.",{"_2802":91,"_24443":91,"_5":12033,"_2329":40066,"_24778":40067,"_17120":40068,"_23194":91},"Fastlane",[39822,39823,39929],[],{"_2802":92,"_24443":91,"_17120":40070,"_5":17015,"_23194":91,"_2329":40071},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2802":93,"_24443":91,"_5":24775,"_17120":40073,"_23194":40074,"_2329":40075},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2802":94,"_24443":91,"_5":24775,"_17120":40077,"_23194":40078,"_2329":40079},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2802":95,"_24443":91,"_5":24775,"_17120":40081,"_23194":40082,"_2329":39832},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#before-you-begin",{"_2802":96,"_24443":91,"_5":24775,"_17120":40084,"_23194":40085,"_2329":40086},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2802":97,"_24443":91,"_5":24775,"_17120":40088,"_23194":40089,"_2329":40090},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2802":98,"_24443":91,"_5":24775,"_17120":40092,"_23194":40093,"_2329":40094},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2802":99,"_24443":91,"_5":24775,"_17120":40096,"_23194":40097,"_2329":40098},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2802":100,"_24443":91,"_5":24775,"_17120":40100,"_23194":40101,"_2329":40102},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2802":101,"_24443":91,"_5":24775,"_17120":40104,"_23194":40105,"_2329":40106},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2802":102,"_24443":91,"_5":24775,"_17120":40108,"_23194":40109,"_2329":40110},[],"/docs/pr-preview/pr-28/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2802":103,"_24443":91,"_17120":40112,"_5":17015,"_23194":40074,"_2329":40113},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2802":104,"_24443":91,"_17120":40115,"_5":17015,"_23194":40074,"_2329":40116},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2802":105,"_24443":91,"_17120":40118,"_5":17015,"_23194":40078,"_2329":40119},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2802":106,"_24443":91,"_17120":40121,"_5":17015,"_23194":40078,"_2329":40122},[],"Fastlane installs or configures",{"_2802":107,"_24443":91,"_17120":40124,"_5":17015,"_23194":40078,"_2329":40125},[],"You still provide",{"_2802":108,"_24443":91,"_17120":40127,"_5":17015,"_23194":40078,"_2329":40128},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2802":109,"_24443":91,"_17120":40130,"_5":17015,"_23194":40078,"_2329":40131},[],"The Kubernetes cluster, nodes and persistent storage",{"_2802":110,"_24443":91,"_17120":40133,"_5":17015,"_23194":40078,"_2329":40134},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2802":111,"_24443":91,"_17120":40136,"_5":17015,"_23194":40078,"_2329":40137},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2802":112,"_24443":91,"_17120":40139,"_5":17015,"_23194":40078,"_2329":40140},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2802":113,"_24443":91,"_17120":40142,"_5":17015,"_23194":40078,"_2329":40143},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2802":114,"_24443":91,"_17120":40145,"_5":17015,"_23194":40078,"_2329":40146},[],"Optional observability and lab HSM components",{"_2802":115,"_24443":91,"_17120":40148,"_5":17015,"_23194":40078,"_2329":40149},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2802":116,"_24443":91,"_17120":40151,"_5":17015,"_23194":40078,"_2329":40152},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2802":117,"_24443":91,"_17120":40154,"_5":17015,"_23194":40082,"_2329":40155},[],"You need:",{"_2802":118,"_24443":91,"_17120":40157,"_5":17015,"_23194":40082,"_2329":40158},[],"an existing Kubernetes cluster",{"_2802":119,"_24443":91,"_17120":40160,"_5":17015,"_23194":40082,"_2329":40161},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2802":120,"_24443":91,"_17120":40163,"_5":17015,"_23194":40082,"_2329":40164},[],"`yq`",{"_2802":121,"_24443":91,"_17120":40166,"_5":17015,"_23194":40082,"_2329":19378},[],{"_2802":122,"_24443":91,"_17120":40168,"_5":17015,"_23194":40082,"_2329":40169},[],"`jq` only when using `--sample-data`",{"_2802":123,"_24443":91,"_17120":40171,"_5":17015,"_23194":40082,"_2329":40172},[],"free external ports 80 and 443 on a single-node K3s host",{"_2802":124,"_24443":91,"_17120":40174,"_5":17015,"_23194":40082,"_2329":40175},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2802":125,"_24443":91,"_17120":40177,"_5":17015,"_23194":40082,"_2329":40178},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2802":126,"_24443":91,"_17120":40180,"_5":17015,"_23194":40085,"_2329":40181},[],"Run the script from a clone of the Helm repository:",{"_2802":127,"_24443":91,"_17120":40183,"_5":17015,"_23194":40085,"_2329":40184},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2802":128,"_24443":91,"_17120":40186,"_5":17015,"_23194":40089,"_2329":40187},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2802":129,"_24443":91,"_17120":40189,"_5":17015,"_23194":40089,"_2329":40190},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2802":130,"_24443":91,"_17120":40192,"_5":17015,"_23194":40089,"_2329":40193},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2802":131,"_24443":91,"_17120":40195,"_5":17015,"_23194":40089,"_2329":40196},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2802":132,"_24443":91,"_17120":40198,"_5":17015,"_23194":40093,"_2329":40199},[],"Option",{"_2802":133,"_24443":91,"_17120":40201,"_5":17015,"_23194":40093,"_2329":40202},[],"Default",{"_2802":134,"_24443":91,"_17120":40204,"_5":17015,"_23194":40093,"_2329":40205},[],"Purpose",{"_2802":135,"_24443":91,"_17120":40207,"_5":17015,"_23194":40093,"_2329":40208},[],"`-h`, `--help`",{"_2802":136,"_24443":91,"_17120":40210,"_5":17015,"_23194":40093,"_2329":40211},[],"—",{"_2802":137,"_24443":91,"_17120":40213,"_5":17015,"_23194":40093,"_2329":40214},[],"Show help",{"_2802":138,"_24443":91,"_17120":40216,"_5":17015,"_23194":40093,"_2329":40217},[],"`-c`, `--context`",{"_2802":139,"_24443":91,"_17120":40219,"_5":17015,"_23194":40093,"_2329":40220},[],"current context",{"_2802":140,"_24443":91,"_17120":40222,"_5":17015,"_23194":40093,"_2329":40223},[],"Select the kubeconfig context for kubectl and Helm",{"_2802":141,"_24443":91,"_17120":40225,"_5":17015,"_23194":40093,"_2329":40226},[],"`-n`, `--non-interactive`",{"_2802":142,"_24443":91,"_17120":40228,"_5":17015,"_23194":40093,"_2329":5230},[],{"_2802":143,"_24443":91,"_17120":40230,"_5":17015,"_23194":40093,"_2329":40231},[],"Skip prompts and generate dependency credentials",{"_2802":144,"_24443":91,"_17120":40233,"_5":17015,"_23194":40093,"_2329":40234},[],"`-ns`, `--namespace`",{"_2802":145,"_24443":91,"_17120":40236,"_5":17015,"_23194":40093,"_2329":40237},[],"`lamassu-dev`",{"_2802":146,"_24443":91,"_17120":40239,"_5":17015,"_23194":40093,"_2329":40240},[],"Namespace for the installation",{"_2802":147,"_24443":91,"_17120":40242,"_5":17015,"_23194":40093,"_2329":40243},[],"`-d`, `--domain`",{"_2802":148,"_24443":91,"_17120":40245,"_5":17015,"_23194":40093,"_2329":40246},[],"`dev.lamassu.io`",{"_2802":149,"_24443":91,"_17120":40248,"_5":17015,"_23194":40093,"_2329":40249},[],"Domain used by the UI, OIDC and certificate",{"_2802":150,"_24443":91,"_17120":40251,"_5":17015,"_23194":40093,"_2329":40252},[],"`-v`, `--version`",{"_2802":151,"_24443":91,"_17120":40254,"_5":17015,"_23194":40093,"_2329":12253},[],{"_2802":152,"_24443":91,"_17120":40256,"_5":17015,"_23194":40093,"_2329":40257},[],"Lamassu chart version",{"_2802":153,"_24443":91,"_17120":40259,"_5":17015,"_23194":40093,"_2329":40260},[],"`--https-port`",{"_2802":154,"_24443":91,"_17120":40262,"_5":17015,"_23194":40093,"_2329":40263},[],"`443`",{"_2802":155,"_24443":91,"_17120":40265,"_5":17015,"_23194":40093,"_2329":40266},[],"Gateway HTTPS listener port",{"_2802":156,"_24443":91,"_17120":40268,"_5":17015,"_23194":40093,"_2329":40269},[],"`--http-port`",{"_2802":157,"_24443":91,"_17120":40271,"_5":17015,"_23194":40093,"_2329":40272},[],"`80`",{"_2802":158,"_24443":91,"_17120":40274,"_5":17015,"_23194":40093,"_2329":40275},[],"Gateway HTTP listener port",{"_2802":159,"_24443":91,"_17120":40277,"_5":17015,"_23194":40093,"_2329":40278},[],"`--tls-crt`",{"_2802":160,"_24443":91,"_17120":40280,"_5":17015,"_23194":40093,"_2329":40211},[],{"_2802":161,"_24443":91,"_17120":40282,"_5":17015,"_23194":40093,"_2329":40283},[],"PEM certificate for downstream TLS",{"_2802":162,"_24443":91,"_17120":40285,"_5":17015,"_23194":40093,"_2329":40286},[],"`--tls-key`",{"_2802":163,"_24443":91,"_17120":40288,"_5":17015,"_23194":40093,"_2329":40211},[],{"_2802":164,"_24443":91,"_17120":40290,"_5":17015,"_23194":40093,"_2329":40291},[],"PEM private key for downstream TLS",{"_2802":165,"_24443":91,"_17120":40293,"_5":17015,"_23194":40093,"_2329":40294},[],"`-l`, `--local-chart-path`",{"_2802":166,"_24443":91,"_17120":40296,"_5":17015,"_23194":40093,"_2329":40297},[],"repository chart",{"_2802":167,"_24443":91,"_17120":40299,"_5":17015,"_23194":40093,"_2329":40300},[],"Use an unpacked local Lamassu chart",{"_2802":168,"_24443":91,"_17120":40302,"_5":17015,"_23194":40093,"_2329":40303},[],"`-ip`, `--gateway-ip`",{"_2802":169,"_24443":91,"_17120":40305,"_5":17015,"_23194":40093,"_2329":7111},[],{"_2802":170,"_24443":91,"_17120":40307,"_5":17015,"_23194":40093,"_2329":40308},[],"Override the address written to `gateway.addresses`",{"_2802":171,"_24443":91,"_17120":40310,"_5":17015,"_23194":40093,"_2329":40311},[],"`--otel`",{"_2802":172,"_24443":91,"_17120":40313,"_5":17015,"_23194":40093,"_2329":5230},[],{"_2802":173,"_24443":91,"_17120":40315,"_5":17015,"_23194":40093,"_2329":40316},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2802":174,"_24443":91,"_17120":40318,"_5":17015,"_23194":40093,"_2329":40319},[],"`--sample-data`",{"_2802":175,"_24443":91,"_17120":40321,"_5":17015,"_23194":40093,"_2329":5230},[],{"_2802":176,"_24443":91,"_17120":40323,"_5":17015,"_23194":40093,"_2329":40324},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2802":177,"_24443":91,"_17120":40326,"_5":17015,"_23194":40093,"_2329":40327},[],"`--with-hsm`",{"_2802":178,"_24443":91,"_17120":40329,"_5":17015,"_23194":40093,"_2329":5230},[],{"_2802":179,"_24443":91,"_17120":40331,"_5":17015,"_23194":40093,"_2329":40332},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2802":180,"_24443":91,"_17120":40334,"_5":17015,"_23194":40093,"_2329":40335},[],"`--softhsm-chart-path`",{"_2802":181,"_24443":91,"_17120":40337,"_5":17015,"_23194":40093,"_2329":40338},[],"`./charts/softhsm`",{"_2802":182,"_24443":91,"_17120":40340,"_5":17015,"_23194":40093,"_2329":40341},[],"Use a different local SoftHSM chart",{"_2802":183,"_24443":91,"_17120":40343,"_5":17015,"_23194":40093,"_2329":40344},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2802":184,"_24443":91,"_17120":40346,"_5":17015,"_23194":40097,"_2329":40347},[],"Fastlane:",{"_2802":185,"_24443":91,"_17120":40349,"_5":17015,"_23194":40097,"_2329":40350},[],"validates local tools and the selected cluster",{"_2802":186,"_24443":91,"_17120":40352,"_5":17015,"_23194":40097,"_2329":40353},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2802":187,"_24443":91,"_17120":40355,"_5":17015,"_23194":40097,"_2329":40356},[],"creates the namespace",{"_2802":188,"_24443":91,"_17120":40358,"_5":17015,"_23194":40097,"_2329":40359},[],"installs PostgreSQL and creates the required databases",{"_2802":189,"_24443":91,"_17120":40361,"_5":17015,"_23194":40097,"_2329":40362},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2802":190,"_24443":91,"_17120":40364,"_5":17015,"_23194":40097,"_2329":40365},[],"installs RabbitMQ",{"_2802":191,"_24443":91,"_17120":40367,"_5":17015,"_23194":40097,"_2329":40368},[],"optionally installs observability and lab HSM components",{"_2802":192,"_24443":91,"_17120":40370,"_5":17015,"_23194":40097,"_2329":40371},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2802":193,"_24443":91,"_17120":40373,"_5":17015,"_23194":40097,"_2329":40374},[],"optionally loads sample data",{"_2802":194,"_24443":91,"_17120":40376,"_5":17015,"_23194":40097,"_2329":40377},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2802":195,"_24443":91,"_17120":40379,"_5":17015,"_23194":40101,"_2329":40380},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2802":196,"_24443":91,"_17120":40382,"_5":17015,"_23194":40101,"_2329":40383},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2802":197,"_24443":91,"_17120":40385,"_5":17015,"_23194":40105,"_2329":40386},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2802":198,"_24443":91,"_17120":40388,"_5":17015,"_23194":40105,"_2329":40389},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2802":199,"_24443":91,"_17120":40391,"_5":17015,"_23194":40105,"_2329":40392},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2802":200,"_24443":91,"_17120":40394,"_5":17015,"_23194":40109,"_2329":40395},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2802":201,"_24443":201,"_5":12033,"_2329":40397,"_24778":40398,"_17120":40399,"_23194":201},"Install with Helm",[39822,39823,39929],[],{"_2802":202,"_24443":201,"_17120":40401,"_5":17015,"_23194":201,"_2329":40402},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2802":203,"_24443":201,"_5":24775,"_17120":40404,"_23194":40405,"_2329":40406},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2802":204,"_24443":201,"_5":24775,"_17120":40408,"_23194":40409,"_2329":39832},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#before-you-begin",{"_2802":205,"_24443":201,"_5":24775,"_17120":40411,"_23194":40412,"_2329":40413},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2802":206,"_24443":201,"_5":24775,"_17120":40415,"_23194":40416,"_2329":40417},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2802":207,"_24443":201,"_5":24775,"_17120":40419,"_23194":40420,"_2329":40421},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2802":208,"_24443":201,"_5":24775,"_17120":40423,"_23194":40424,"_2329":40425},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2802":209,"_24443":201,"_5":24775,"_17120":40427,"_23194":40428,"_2329":40429},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2802":210,"_24443":201,"_5":24775,"_17120":40431,"_23194":40432,"_2329":40433},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2802":211,"_24443":201,"_5":24775,"_17120":40435,"_23194":40436,"_2329":40437},[],"/docs/pr-preview/pr-28/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2802":212,"_24443":201,"_17120":40439,"_5":17015,"_23194":40405,"_2329":40440},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2802":213,"_24443":201,"_17120":40442,"_5":17015,"_23194":40409,"_2329":40443},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2802":214,"_24443":201,"_17120":40445,"_5":17015,"_23194":40409,"_2329":40446},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2802":215,"_24443":201,"_17120":40448,"_5":17015,"_23194":40409,"_2329":40449},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2802":216,"_24443":201,"_17120":40451,"_5":17015,"_23194":40409,"_2329":40452},[],"a reachable RabbitMQ broker and credentials",{"_2802":217,"_24443":201,"_17120":40454,"_5":17015,"_23194":40409,"_2329":40455},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2802":218,"_24443":201,"_17120":40457,"_5":17015,"_23194":40409,"_2329":40458},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2802":219,"_24443":201,"_17120":40460,"_5":17015,"_23194":40409,"_2329":40461},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2802":220,"_24443":201,"_17120":40463,"_5":17015,"_23194":40409,"_2329":40464},[],"a StorageClass and an external traffic design",{"_2802":221,"_24443":201,"_17120":40466,"_5":17015,"_23194":40409,"_2329":40467},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2802":222,"_24443":201,"_17120":40469,"_5":17015,"_23194":40409,"_2329":40470},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2802":223,"_24443":201,"_17120":40472,"_5":17015,"_23194":40409,"_2329":40473},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2802":224,"_24443":201,"_17120":40475,"_5":17015,"_23194":40412,"_2329":40476},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2802":225,"_24443":201,"_17120":40478,"_5":17015,"_23194":40412,"_2329":40479},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2802":226,"_24443":201,"_17120":40481,"_5":17015,"_23194":40412,"_2329":40482},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2802":227,"_24443":201,"_17120":40484,"_5":17015,"_23194":40416,"_2329":40485},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2802":228,"_24443":201,"_17120":40487,"_5":17015,"_23194":40416,"_2329":40488},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2802":229,"_24443":201,"_17120":40490,"_5":17015,"_23194":40416,"_2329":40491},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2802":230,"_24443":201,"_17120":40493,"_5":17015,"_23194":40420,"_2329":40494},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2802":231,"_24443":201,"_17120":40496,"_5":17015,"_23194":40424,"_2329":40497},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2802":232,"_24443":201,"_17120":40499,"_5":17015,"_23194":40424,"_2329":40500},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2802":233,"_24443":201,"_17120":40502,"_5":17015,"_23194":40424,"_2329":40503},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2802":234,"_24443":201,"_17120":40505,"_5":17015,"_23194":40424,"_2329":40506},[],"See Access control for the principal and policy model.",{"_2802":235,"_24443":201,"_17120":40508,"_5":17015,"_23194":40428,"_2329":40509},[],"To install a local checkout instead:",{"_2802":236,"_24443":201,"_17120":40511,"_5":17015,"_23194":40432,"_2329":40512},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2802":237,"_24443":201,"_17120":40514,"_5":17015,"_23194":40432,"_2329":40515},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2802":238,"_24443":201,"_17120":40517,"_5":17015,"_23194":40436,"_2329":40518},[],"Before going live, review:",{"_2802":239,"_24443":201,"_17120":40520,"_5":17015,"_23194":40436,"_2329":40521},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2802":240,"_24443":201,"_17120":40523,"_5":17015,"_23194":40436,"_2329":40524},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2802":241,"_24443":201,"_17120":40526,"_5":17015,"_23194":40436,"_2329":40527},[],"shared VA storage before increasing VA replicas",{"_2802":242,"_24443":201,"_17120":40529,"_5":17015,"_23194":40436,"_2329":40530},[],"managed OIDC roles and removal of evaluation credentials",{"_2802":243,"_24443":201,"_17120":40532,"_5":17015,"_23194":40436,"_2329":40533},[],"a trusted TLS issuer or externally managed certificate",{"_2802":244,"_24443":201,"_17120":40535,"_5":17015,"_23194":40436,"_2329":40536},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2802":245,"_24443":201,"_17120":40538,"_5":17015,"_23194":40436,"_2329":40539},[],"SMTP, observability and alert delivery",{"_2802":246,"_24443":201,"_17120":40541,"_5":17015,"_23194":40436,"_2329":40542},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2802":247,"_24443":201,"_17120":40544,"_5":17015,"_23194":40436,"_2329":40545},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2802":248,"_24443":248,"_5":12033,"_2329":40547,"_24778":40548,"_17120":40549,"_23194":248},"Expose the Gateway",[39822,39823,39929],[],{"_2802":249,"_24443":248,"_17120":40551,"_5":17015,"_23194":248,"_2329":40552},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2802":250,"_24443":248,"_5":24775,"_17120":40554,"_23194":40555,"_2329":40556},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2802":251,"_24443":248,"_5":24775,"_17120":40558,"_23194":40559,"_2329":40560},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2802":252,"_24443":248,"_5":24775,"_17120":40562,"_23194":40563,"_2329":40564},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2802":253,"_24443":248,"_5":24775,"_17120":40566,"_23194":40567,"_2329":40568},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#k3s","K3s",{"_2802":254,"_24443":248,"_5":24775,"_17120":40570,"_23194":40571,"_2329":40572},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2802":255,"_24443":248,"_5":24775,"_17120":40574,"_23194":40575,"_2329":40576},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2802":256,"_24443":248,"_5":24775,"_17120":40578,"_23194":40579,"_2329":40580},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2802":257,"_24443":248,"_5":24775,"_17120":40582,"_23194":40583,"_2329":40584},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2802":258,"_24443":248,"_5":24775,"_17120":40586,"_23194":40587,"_2329":40588},[],"/docs/pr-preview/pr-28/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2802":259,"_24443":248,"_17120":40590,"_5":17015,"_23194":40555,"_2329":40591},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2802":260,"_24443":248,"_17120":40593,"_5":17015,"_23194":40555,"_2329":40594},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2802":261,"_24443":248,"_17120":40596,"_5":17015,"_23194":40559,"_2329":40597},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2802":262,"_24443":248,"_17120":40599,"_5":17015,"_23194":40559,"_2329":40600},[],"Set it only when:",{"_2802":263,"_24443":248,"_17120":40602,"_5":17015,"_23194":40559,"_2329":40603},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2802":264,"_24443":248,"_17120":40605,"_5":17015,"_23194":40559,"_2329":40606},[],"that address is allocated to this Gateway",{"_2802":265,"_24443":248,"_17120":40608,"_5":17015,"_23194":40559,"_2329":40609},[],"the surrounding network already routes traffic for it to the cluster",{"_2802":266,"_24443":248,"_17120":40611,"_5":17015,"_23194":40559,"_2329":40612},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2802":267,"_24443":248,"_17120":40614,"_5":17015,"_23194":40559,"_2329":40615},[],"Keep these two settings separate:",{"_2802":268,"_24443":248,"_17120":40617,"_5":17015,"_23194":40559,"_2329":40618},[],"`gateway.addresses` requests an address for the Gateway.",{"_2802":269,"_24443":248,"_17120":40620,"_5":17015,"_23194":40559,"_2329":40621},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2802":270,"_24443":248,"_17120":40623,"_5":17015,"_23194":40559,"_2329":40624},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2802":271,"_24443":248,"_17120":40626,"_5":17015,"_23194":40563,"_2329":40627},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2802":272,"_24443":248,"_17120":40629,"_5":17015,"_23194":40563,"_2329":40630},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2802":273,"_24443":248,"_17120":40632,"_5":17015,"_23194":40567,"_2329":40633},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2802":274,"_24443":248,"_17120":40635,"_5":17015,"_23194":40567,"_2329":40636},[],"For the recommended design:",{"_2802":275,"_24443":248,"_17120":40638,"_5":17015,"_23194":40567,"_2329":40639},[],"Use only one externally exposed Lamassu Gateway.",{"_2802":276,"_24443":248,"_17120":40641,"_5":17015,"_23194":40567,"_2329":40642},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2802":277,"_24443":248,"_17120":40644,"_5":17015,"_23194":40567,"_2329":40645},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2802":278,"_24443":248,"_17120":40647,"_5":17015,"_23194":40567,"_2329":40648},[],"Point DNS at the VM's reachable address.",{"_2802":279,"_24443":248,"_17120":40650,"_5":17015,"_23194":40567,"_2329":40651},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2802":280,"_24443":248,"_17120":40653,"_5":17015,"_23194":40571,"_2329":40654},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2802":281,"_24443":248,"_17120":40656,"_5":17015,"_23194":40575,"_2329":40657},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2802":282,"_24443":248,"_17120":40659,"_5":17015,"_23194":40575,"_2329":40660},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2802":283,"_24443":248,"_17120":40662,"_5":17015,"_23194":40579,"_2329":40663},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2802":284,"_24443":248,"_17120":40665,"_5":17015,"_23194":40579,"_2329":40666},[],"Requirement",{"_2802":285,"_24443":248,"_17120":40668,"_5":17015,"_23194":40579,"_2329":40669},[],"Recommended design",{"_2802":286,"_24443":248,"_17120":40671,"_5":17015,"_23194":40579,"_2329":40672},[],"Consequence",{"_2802":287,"_24443":248,"_17120":40674,"_5":17015,"_23194":40579,"_2329":40675},[],"Several Lamassu URLs or services",{"_2802":288,"_24443":248,"_17120":40677,"_5":17015,"_23194":40579,"_2329":40678},[],"One Gateway with multiple routes",{"_2802":289,"_24443":248,"_17120":40680,"_5":17015,"_23194":40579,"_2329":40681},[],"One IP and one proxy fleet; this is the chart default",{"_2802":290,"_24443":248,"_17120":40683,"_5":17015,"_23194":40579,"_2329":40684},[],"Independent Gateways and separate external IPs",{"_2802":291,"_24443":248,"_17120":40686,"_5":17015,"_23194":40579,"_2329":40687},[],"One VIP per Gateway",{"_2802":292,"_24443":248,"_17120":40689,"_5":17015,"_23194":40579,"_2329":40690},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2802":293,"_24443":248,"_17120":40692,"_5":17015,"_23194":40579,"_2329":40693},[],"Independent Gateways on one node and one IP",{"_2802":294,"_24443":248,"_17120":40695,"_5":17015,"_23194":40579,"_2329":40696},[],"Use different external ports",{"_2802":295,"_24443":248,"_17120":40698,"_5":17015,"_23194":40579,"_2329":40699},[],"Clients must include non-standard ports",{"_2802":296,"_24443":248,"_17120":40701,"_5":17015,"_23194":40579,"_2329":40702},[],"Separate TLS/mTLS termination behind one IP",{"_2802":297,"_24443":248,"_17120":40704,"_5":17015,"_23194":40579,"_2329":40705},[],"Front-door SNI routing to internal Gateways",{"_2802":298,"_24443":248,"_17120":40707,"_5":17015,"_23194":40579,"_2329":40708},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2802":299,"_24443":248,"_17120":40710,"_5":17015,"_23194":40579,"_2329":40711},[],"Separate Gateway resources but shared proxy infrastructure",{"_2802":300,"_24443":248,"_17120":40713,"_5":17015,"_23194":40579,"_2329":40714},[],"Envoy merged-Gateway mode",{"_2802":301,"_24443":248,"_17120":40716,"_5":17015,"_23194":40579,"_2329":40717},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2802":302,"_24443":248,"_17120":40719,"_5":17015,"_23194":40579,"_2329":40720},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2802":303,"_24443":248,"_17120":40722,"_5":17015,"_23194":40579,"_2329":40723},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2802":304,"_24443":248,"_17120":40725,"_5":17015,"_23194":40579,"_2329":40726},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2802":305,"_24443":248,"_17120":40728,"_5":17015,"_23194":40579,"_2329":40729},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2802":306,"_24443":248,"_17120":40731,"_5":17015,"_23194":40583,"_2329":40732},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2802":307,"_24443":248,"_17120":40734,"_5":17015,"_23194":40583,"_2329":40735},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2802":308,"_24443":248,"_17120":40737,"_5":17015,"_23194":40583,"_2329":40738},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2802":309,"_24443":248,"_17120":40740,"_5":17015,"_23194":40583,"_2329":40741},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2802":310,"_24443":248,"_17120":40743,"_5":17015,"_23194":40583,"_2329":40744},[],"If none of those are possible, use different external ports or change the external network design.",{"_2802":311,"_24443":248,"_17120":40746,"_5":17015,"_23194":40587,"_2329":40747},[],"Check, in order:",{"_2802":312,"_24443":248,"_17120":40749,"_5":17015,"_23194":40587,"_2329":40750},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2802":313,"_24443":248,"_17120":40752,"_5":17015,"_23194":40587,"_2329":40753},[],"Its status contains the expected address.",{"_2802":314,"_24443":248,"_17120":40755,"_5":17015,"_23194":40587,"_2329":40756},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2802":315,"_24443":248,"_17120":40758,"_5":17015,"_23194":40587,"_2329":40759},[],"Port 443 reaches that address from the client network.",{"_2802":316,"_24443":248,"_17120":40761,"_5":17015,"_23194":40587,"_2329":40762},[],"DNS resolves to the externally reachable endpoint.",{"_2802":317,"_24443":248,"_17120":40764,"_5":17015,"_23194":40587,"_2329":40765},[],"The certificate contains the DNS name or IP used by the client.",{"_2802":318,"_24443":248,"_17120":40767,"_5":17015,"_23194":40587,"_2329":40768},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2802":319,"_24443":319,"_5":12033,"_2329":39929,"_24778":40770,"_17120":40771,"_23194":319},[39822,39823,39929],[],{"_2802":320,"_24443":319,"_17120":40773,"_5":17015,"_23194":319,"_2329":40774},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2802":321,"_24443":319,"_5":24775,"_17120":40776,"_23194":40777,"_2329":40778},[],"/docs/pr-preview/pr-28/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2802":322,"_24443":319,"_5":24775,"_17120":40780,"_23194":40781,"_2329":40782},[],"/docs/pr-preview/pr-28/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2802":323,"_24443":319,"_5":24775,"_17120":40784,"_23194":40785,"_2329":40786},[],"/docs/pr-preview/pr-28/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2802":324,"_24443":319,"_5":24775,"_17120":40788,"_23194":40789,"_2329":40790},[],"/docs/pr-preview/pr-28/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2802":325,"_24443":319,"_5":24775,"_17120":40792,"_23194":40793,"_2329":40794},[],"/docs/pr-preview/pr-28/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2802":326,"_24443":319,"_5":24775,"_17120":40796,"_23194":40797,"_2329":40798},[],"/docs/pr-preview/pr-28/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2802":327,"_24443":319,"_17120":40800,"_5":17015,"_23194":40777,"_2329":40801},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2802":328,"_24443":319,"_17120":40803,"_5":17015,"_23194":40781,"_2329":40804},[],"Workflow",{"_2802":329,"_24443":319,"_17120":40806,"_5":17015,"_23194":40781,"_2329":40807},[],"Use it for",{"_2802":330,"_24443":319,"_17120":40809,"_5":17015,"_23194":40781,"_2329":40810},[],"What it installs",{"_2802":331,"_24443":319,"_17120":40812,"_5":17015,"_23194":40781,"_2329":40813},[],"Helm",{"_2802":332,"_24443":319,"_17120":40815,"_5":17015,"_23194":40781,"_2329":40816},[],"Production and controlled environments",{"_2802":333,"_24443":319,"_17120":40818,"_5":17015,"_23194":40781,"_2329":40819},[],"Lamassu services and Gateway API resources",{"_2802":334,"_24443":319,"_17120":40821,"_5":17015,"_23194":40781,"_2329":40066},[],{"_2802":335,"_24443":319,"_17120":40823,"_5":17015,"_23194":40781,"_2329":40824},[],"Evaluation, demos, CI and small lab clusters",{"_2802":336,"_24443":319,"_17120":40826,"_5":17015,"_23194":40781,"_2329":40827},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2802":337,"_24443":319,"_17120":40829,"_5":17015,"_23194":40785,"_2329":40830},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2802":338,"_24443":319,"_17120":40832,"_5":17015,"_23194":40785,"_2329":40833},[],"Area",{"_2802":339,"_24443":319,"_17120":40835,"_5":17015,"_23194":40785,"_2329":40836},[],"The Lamassu chart provides",{"_2802":340,"_24443":319,"_17120":40838,"_5":17015,"_23194":40785,"_2329":40839},[],"You provide",{"_2802":341,"_24443":319,"_17120":40841,"_5":17015,"_23194":40785,"_2329":40842},[],"Lamassu applications",{"_2802":342,"_24443":319,"_17120":40844,"_5":17015,"_23194":40785,"_2329":40845},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2802":343,"_24443":319,"_17120":40847,"_5":17015,"_23194":40785,"_2329":40848},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2802":344,"_24443":319,"_17120":40850,"_5":17015,"_23194":40785,"_2329":40851},[],"PostgreSQL data",{"_2802":345,"_24443":319,"_17120":40853,"_5":17015,"_23194":40785,"_2329":40854},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2802":346,"_24443":319,"_17120":40856,"_5":17015,"_23194":40785,"_2329":40857},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2802":347,"_24443":319,"_17120":40859,"_5":17015,"_23194":40785,"_2329":40860},[],"Messaging",{"_2802":348,"_24443":319,"_17120":40862,"_5":17015,"_23194":40785,"_2329":40863},[],"RabbitMQ connection configuration for the Lamassu services",{"_2802":349,"_24443":319,"_17120":40865,"_5":17015,"_23194":40785,"_2329":40866},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2802":350,"_24443":319,"_17120":40868,"_5":17015,"_23194":40785,"_2329":40869},[],"Identity",{"_2802":351,"_24443":319,"_17120":40871,"_5":17015,"_23194":40785,"_2329":40872},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2802":352,"_24443":319,"_17120":40874,"_5":17015,"_23194":40785,"_2329":40875},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2802":353,"_24443":319,"_17120":40877,"_5":17015,"_23194":40785,"_2329":40878},[],"External routing",{"_2802":354,"_24443":319,"_17120":40880,"_5":17015,"_23194":40785,"_2329":40881},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2802":355,"_24443":319,"_17120":40883,"_5":17015,"_23194":40785,"_2329":40884},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2802":356,"_24443":319,"_17120":40886,"_5":17015,"_23194":40785,"_2329":40887},[],"TLS",{"_2802":357,"_24443":319,"_17120":40889,"_5":17015,"_23194":40785,"_2329":40890},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2802":358,"_24443":319,"_17120":40892,"_5":17015,"_23194":40785,"_2329":40893},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2802":359,"_24443":319,"_17120":40895,"_5":17015,"_23194":40785,"_2329":40896},[],"Persistent application data",{"_2802":360,"_24443":319,"_17120":40898,"_5":17015,"_23194":40785,"_2329":40899},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2802":361,"_24443":319,"_17120":40901,"_5":17015,"_23194":40785,"_2329":40902},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2802":362,"_24443":319,"_17120":40904,"_5":17015,"_23194":40785,"_2329":40905},[],"Optional integrations",{"_2802":363,"_24443":319,"_17120":40907,"_5":17015,"_23194":40785,"_2329":40908},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2802":364,"_24443":319,"_17120":40910,"_5":17015,"_23194":40785,"_2329":40911},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2802":365,"_24443":319,"_17120":40913,"_5":17015,"_23194":40785,"_2329":40914},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2802":366,"_24443":319,"_17120":40916,"_5":17015,"_23194":40785,"_2329":40917},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2802":367,"_24443":319,"_17120":40919,"_5":17015,"_23194":40789,"_2329":40920},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2802":368,"_24443":319,"_17120":40922,"_5":17015,"_23194":40789,"_2329":40923},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2802":369,"_24443":319,"_17120":40925,"_5":17015,"_23194":40793,"_2329":40926},[],"Kubernetes 1.24 or newer",{"_2802":370,"_24443":319,"_17120":40928,"_5":17015,"_23194":40793,"_2329":40929},[],"Helm 3.2 or newer",{"_2802":371,"_24443":319,"_17120":40931,"_5":17015,"_23194":40793,"_2329":40932},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2802":372,"_24443":319,"_17120":40934,"_5":17015,"_23194":40793,"_2329":40935},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2802":373,"_24443":319,"_17120":40937,"_5":17015,"_23194":40793,"_2329":40938},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2802":374,"_24443":319,"_17120":40940,"_5":17015,"_23194":40793,"_2329":40941},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2802":375,"_24443":319,"_17120":40943,"_5":17015,"_23194":40793,"_2329":40944},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2802":376,"_24443":319,"_17120":40946,"_5":17015,"_23194":40797,"_2329":40947},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2802":377,"_24443":319,"_17120":40949,"_5":17015,"_23194":40797,"_2329":40950},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2802":378,"_24443":319,"_17120":40952,"_5":17015,"_23194":40797,"_2329":40953},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2802":379,"_24443":379,"_5":12033,"_2329":40955,"_24778":40956,"_17120":40958,"_23194":379},"Deployment troubleshooting",[39822,39823,40957],"Operations",[],{"_2802":380,"_24443":379,"_17120":40960,"_5":17015,"_23194":379,"_2329":40961},[],"Diagnose access, service health and infrastructure dependencies.",{"_2802":381,"_24443":379,"_5":24775,"_17120":40963,"_23194":40964,"_2329":40965},[],"/docs/pr-preview/pr-28/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2802":382,"_24443":379,"_5":24775,"_17120":40967,"_23194":40968,"_2329":40969},[],"/docs/pr-preview/pr-28/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2802":383,"_24443":379,"_5":24775,"_17120":40971,"_23194":40972,"_2329":40973},[],"/docs/pr-preview/pr-28/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2802":384,"_24443":379,"_5":24775,"_17120":40975,"_23194":40976,"_2329":40977},[],"/docs/pr-preview/pr-28/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2802":385,"_24443":379,"_5":24775,"_17120":40979,"_23194":40980,"_2329":40981},[],"/docs/pr-preview/pr-28/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2802":386,"_24443":379,"_5":24775,"_17120":40983,"_23194":40984,"_2329":40985},[],"/docs/pr-preview/pr-28/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2802":387,"_24443":379,"_5":24775,"_17120":40987,"_23194":40988,"_2329":40989},[],"/docs/pr-preview/pr-28/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2802":388,"_24443":379,"_5":24775,"_17120":40991,"_23194":40992,"_2329":40993},[],"/docs/pr-preview/pr-28/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2802":389,"_24443":379,"_5":24775,"_17120":40995,"_23194":40996,"_2329":40997},[],"/docs/pr-preview/pr-28/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2802":390,"_24443":379,"_5":24775,"_17120":40999,"_23194":41000,"_2329":41001},[],"/docs/pr-preview/pr-28/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2802":391,"_24443":379,"_5":24775,"_17120":41003,"_23194":41004,"_2329":41005},[],"/docs/pr-preview/pr-28/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2802":392,"_24443":379,"_5":24775,"_17120":41007,"_23194":41008,"_2329":41009},[],"/docs/pr-preview/pr-28/deployment/troubleshooting#observability","Observability",{"_2802":393,"_24443":379,"_17120":41011,"_5":17015,"_23194":379,"_2329":41012},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2802":394,"_24443":379,"_17120":41014,"_5":17015,"_23194":40968,"_2329":41015},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2802":395,"_24443":379,"_17120":41017,"_5":17015,"_23194":40972,"_2329":41018},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2802":396,"_24443":379,"_17120":41020,"_5":17015,"_23194":40976,"_2329":41021},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2802":397,"_24443":379,"_17120":41023,"_5":17015,"_23194":40980,"_2329":41024},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2802":398,"_24443":379,"_17120":41026,"_5":17015,"_23194":40984,"_2329":41027},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2802":399,"_24443":379,"_17120":41029,"_5":17015,"_23194":40988,"_2329":41030},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2802":400,"_24443":379,"_17120":41032,"_5":17015,"_23194":40988,"_2329":41033},[],"Also run the chart's connectivity test:",{"_2802":401,"_24443":379,"_17120":41035,"_5":17015,"_23194":40988,"_2329":41036},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2802":402,"_24443":379,"_17120":41038,"_5":17015,"_23194":40988,"_2329":41039},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2802":403,"_24443":379,"_17120":41041,"_5":17015,"_23194":40992,"_2329":41042},[],"If you receive a 401:",{"_2802":404,"_24443":379,"_17120":41044,"_5":17015,"_23194":40992,"_2329":41045},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2802":405,"_24443":379,"_17120":41047,"_5":17015,"_23194":40992,"_2329":41048},[],"verify issuer, audience and expiration of the token;",{"_2802":406,"_24443":379,"_17120":41050,"_5":17015,"_23194":40992,"_2329":41051},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2802":407,"_24443":379,"_17120":41053,"_5":17015,"_23194":40992,"_2329":41054},[],"check that the provider's public and internal routes point to the same realm.",{"_2802":408,"_24443":379,"_17120":41056,"_5":17015,"_23194":40992,"_2329":41057},[],"If login succeeds but the APIs return 403:",{"_2802":409,"_24443":379,"_17120":41059,"_5":17015,"_23194":40992,"_2329":41060},[],"inspect the token's real claims;",{"_2802":410,"_24443":379,"_17120":41062,"_5":17015,"_23194":40992,"_2329":41063},[],"confirm they match an active principal;",{"_2802":411,"_24443":379,"_17120":41065,"_5":17015,"_23194":40992,"_2329":41066},[],"review the policies granted to that principal;",{"_2802":412,"_24443":379,"_17120":41068,"_5":17015,"_23194":40992,"_2329":41069},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2802":413,"_24443":379,"_17120":41071,"_5":17015,"_23194":40992,"_2329":41072},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2802":414,"_24443":379,"_17120":41074,"_5":17015,"_23194":40996,"_2329":41075},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2802":415,"_24443":379,"_17120":41077,"_5":17015,"_23194":40996,"_2329":41078},[],"Locate the authz pod and Service.",{"_2802":416,"_24443":379,"_17120":41080,"_5":17015,"_23194":40996,"_2329":41081},[],"Check /health, logs and its database connection.",{"_2802":417,"_24443":379,"_17120":41083,"_5":17015,"_23194":40996,"_2329":41084},[],"Verify the DNS and port configured in externalAuthorization.",{"_2802":418,"_24443":379,"_17120":41086,"_5":17015,"_23194":40996,"_2329":41087},[],"Check the check route is /v1/ext\\_authz/check.",{"_2802":419,"_24443":379,"_17120":41089,"_5":17015,"_23194":40996,"_2329":41090},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2802":420,"_24443":379,"_17120":41092,"_5":17015,"_23194":41000,"_2329":41093},[],"Review kubectl describe pod first. Common causes are:",{"_2802":421,"_24443":379,"_17120":41095,"_5":17015,"_23194":41000,"_2329":41096},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2802":422,"_24443":379,"_17120":41098,"_5":17015,"_23194":41000,"_2329":41099},[],"unbound persistent volume;",{"_2802":423,"_24443":379,"_17120":41101,"_5":17015,"_23194":41000,"_2329":41102},[],"inaccessible image or incorrect pull policy;",{"_2802":424,"_24443":379,"_17120":41104,"_5":17015,"_23194":41000,"_2329":41105},[],"invalid cryptographic engine configuration;",{"_2802":425,"_24443":379,"_17120":41107,"_5":17015,"_23194":41000,"_2329":41108},[],"CPU or memory limits set too low;",{"_2802":426,"_24443":379,"_17120":41110,"_5":17015,"_23194":41000,"_2329":41111},[],"an incomplete prior migration.",{"_2802":427,"_24443":379,"_17120":41113,"_5":17015,"_23194":41000,"_2329":41114},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2802":428,"_24443":379,"_17120":41116,"_5":17015,"_23194":41000,"_2329":41117},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2802":429,"_24443":379,"_17120":41119,"_5":17015,"_23194":41004,"_2329":41120},[],"Domain and audit events depend on the bus publisher:",{"_2802":430,"_24443":379,"_17120":41122,"_5":17015,"_23194":41004,"_2329":41123},[],"verify it is enabled in the emitting service;",{"_2802":431,"_24443":379,"_17120":41125,"_5":17015,"_23194":41004,"_2329":41126},[],"check AMQP connectivity and credentials;",{"_2802":432,"_24443":379,"_17120":41128,"_5":17015,"_23194":41004,"_2329":41129},[],"review exchange, routing key, queues and consumers;",{"_2802":433,"_24443":379,"_17120":41131,"_5":17015,"_23194":41004,"_2329":41132},[],"inspect dead-letter queues;",{"_2802":434,"_24443":379,"_17120":41134,"_5":17015,"_23194":41004,"_2329":41135},[],"alert on orphan durable queues and backlog growth.",{"_2802":435,"_24443":379,"_17120":41137,"_5":17015,"_23194":41004,"_2329":41138},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2802":436,"_24443":379,"_17120":41140,"_5":17015,"_23194":41008,"_2329":41141},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2802":437,"_24443":379,"_17120":41143,"_5":17015,"_23194":41008,"_2329":41144},[],"Before closing an incident, record:",{"_2802":438,"_24443":379,"_17120":41146,"_5":17015,"_23194":41008,"_2329":41147},[],"the confirmed cause;",{"_2802":439,"_24443":379,"_17120":41149,"_5":17015,"_23194":41008,"_2329":41150},[],"the time scope and affected resources;",{"_2802":440,"_24443":379,"_17120":41152,"_5":17015,"_23194":41008,"_2329":41153},[],"the commands or queries used;",{"_2802":441,"_24443":379,"_17120":41155,"_5":17015,"_23194":41008,"_2329":41156},[],"the applied change and how to revert it;",{"_2802":442,"_24443":379,"_17120":41158,"_5":17015,"_23194":41008,"_2329":41159},[],"validation from a consumer;",{"_2802":443,"_24443":379,"_17120":41161,"_5":17015,"_23194":41008,"_2329":41162},[],"the preventive action and its owner.",{"_2802":444,"_24443":444,"_5":12033,"_2329":41164,"_24778":41165,"_17120":41168,"_23194":444},"Access control",[39822,41166,41167],"Platform","Administration",[],{"_2802":445,"_24443":444,"_17120":41170,"_5":17015,"_23194":444,"_2329":41171},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2802":446,"_24443":444,"_5":24775,"_17120":41173,"_23194":41174,"_2329":41175},[],"/docs/pr-preview/pr-28/platform/administration/access-control#essential-concepts","Essential concepts",{"_2802":447,"_24443":444,"_5":24775,"_17120":41177,"_23194":41178,"_2329":41179},[],"/docs/pr-preview/pr-28/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2802":448,"_24443":444,"_5":24775,"_17120":41181,"_23194":41182,"_2329":41183},[],"/docs/pr-preview/pr-28/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2802":449,"_24443":444,"_5":24775,"_17120":41185,"_23194":41186,"_2329":41187},[],"/docs/pr-preview/pr-28/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2802":450,"_24443":444,"_5":24775,"_17120":41189,"_23194":41190,"_2329":41191},[],"/docs/pr-preview/pr-28/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2802":451,"_24443":444,"_5":24775,"_17120":41193,"_23194":41194,"_2329":41195},[],"/docs/pr-preview/pr-28/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2802":452,"_24443":444,"_5":24775,"_17120":41197,"_23194":41198,"_2329":41199},[],"/docs/pr-preview/pr-28/platform/administration/access-control#oidc-principals","OIDC principals",{"_2802":453,"_24443":444,"_5":24775,"_17120":41201,"_23194":41202,"_2329":41203},[],"/docs/pr-preview/pr-28/platform/administration/access-control#x509-principals","X.509 principals",{"_2802":454,"_24443":444,"_5":24775,"_17120":41205,"_23194":41206,"_2329":41207},[],"/docs/pr-preview/pr-28/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2802":455,"_24443":444,"_5":24775,"_17120":41209,"_23194":41210,"_2329":41211},[],"/docs/pr-preview/pr-28/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2802":456,"_24443":444,"_5":24775,"_17120":41213,"_23194":41214,"_2329":41215},[],"/docs/pr-preview/pr-28/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2802":457,"_24443":444,"_5":24775,"_17120":41217,"_23194":41218,"_2329":41219},[],"/docs/pr-preview/pr-28/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2802":458,"_24443":444,"_5":24775,"_17120":41221,"_23194":41222,"_2329":41223},[],"/docs/pr-preview/pr-28/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2802":459,"_24443":444,"_5":24775,"_17120":41225,"_23194":41226,"_2329":41227},[],"/docs/pr-preview/pr-28/platform/administration/access-control#http-rules","HTTP rules",{"_2802":460,"_24443":444,"_5":24775,"_17120":41229,"_23194":41230,"_2329":41231},[],"/docs/pr-preview/pr-28/platform/administration/access-control#included-policies","Included policies",{"_2802":461,"_24443":444,"_5":24775,"_17120":41233,"_23194":41234,"_2329":40425},[],"/docs/pr-preview/pr-28/platform/administration/access-control#provision-the-first-administrator",{"_2802":462,"_24443":444,"_5":24775,"_17120":41236,"_23194":41237,"_2329":41238},[],"/docs/pr-preview/pr-28/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2802":463,"_24443":444,"_5":24775,"_17120":41240,"_23194":41241,"_2329":41242},[],"/docs/pr-preview/pr-28/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2802":464,"_24443":444,"_5":24775,"_17120":41244,"_23194":41245,"_2329":41246},[],"/docs/pr-preview/pr-28/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2802":465,"_24443":444,"_5":24775,"_17120":41248,"_23194":41249,"_2329":41250},[],"/docs/pr-preview/pr-28/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2802":466,"_24443":444,"_5":24775,"_17120":41252,"_23194":41253,"_2329":41254},[],"/docs/pr-preview/pr-28/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2802":467,"_24443":444,"_5":24775,"_17120":41256,"_23194":41257,"_2329":41258},[],"/docs/pr-preview/pr-28/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2802":468,"_24443":444,"_5":24775,"_17120":41260,"_23194":41261,"_2329":41262},[],"/docs/pr-preview/pr-28/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2802":469,"_24443":444,"_5":24775,"_17120":41264,"_23194":41265,"_2329":41266},[],"/docs/pr-preview/pr-28/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2802":470,"_24443":444,"_5":24775,"_17120":41268,"_23194":41269,"_2329":41270},[],"/docs/pr-preview/pr-28/platform/administration/access-control#operational-checklist","Operational checklist",{"_2802":471,"_24443":444,"_5":24775,"_17120":41272,"_23194":41273,"_2329":41274},[],"/docs/pr-preview/pr-28/platform/administration/access-control#diagnostics","Diagnostics",{"_2802":472,"_24443":444,"_5":24775,"_17120":41276,"_23194":41277,"_2329":41278},[],"/docs/pr-preview/pr-28/platform/administration/access-control#the-response-is-401","The response is 401",{"_2802":473,"_24443":444,"_5":24775,"_17120":41280,"_23194":41281,"_2329":41282},[],"/docs/pr-preview/pr-28/platform/administration/access-control#the-response-is-403","The response is 403",{"_2802":474,"_24443":444,"_5":24775,"_17120":41284,"_23194":41285,"_2329":41286},[],"/docs/pr-preview/pr-28/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2802":475,"_24443":444,"_5":24775,"_17120":41288,"_23194":41289,"_2329":41290},[],"/docs/pr-preview/pr-28/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2802":476,"_24443":444,"_5":24775,"_17120":41292,"_23194":41293,"_2329":41294},[],"/docs/pr-preview/pr-28/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2802":477,"_24443":444,"_17120":41296,"_5":17015,"_23194":444,"_2329":41297},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2802":478,"_24443":444,"_17120":41299,"_5":17015,"_23194":444,"_2329":41300},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2802":479,"_24443":444,"_17120":41302,"_5":17015,"_23194":444,"_2329":41303},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2802":480,"_24443":444,"_17120":41305,"_5":17015,"_23194":41174,"_2329":41306},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2802":481,"_24443":444,"_17120":41308,"_5":17015,"_23194":41174,"_2329":41309},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2802":482,"_24443":444,"_17120":41311,"_5":17015,"_23194":41174,"_2329":41312},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2802":483,"_24443":444,"_17120":41314,"_5":17015,"_23194":41174,"_2329":41315},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2802":484,"_24443":444,"_17120":41317,"_5":17015,"_23194":41174,"_2329":41318},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2802":485,"_24443":444,"_17120":41320,"_5":17015,"_23194":41174,"_2329":41321},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2802":486,"_24443":444,"_17120":41323,"_5":17015,"_23194":41178,"_2329":41324},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2802":487,"_24443":444,"_17120":41326,"_5":17015,"_23194":41178,"_2329":41327},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2802":488,"_24443":444,"_17120":41329,"_5":17015,"_23194":41182,"_2329":41330},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2802":489,"_24443":444,"_17120":41332,"_5":17015,"_23194":41182,"_2329":41333},[],"The decision is made **before forwarding the request to the service**:",{"_2802":490,"_24443":444,"_17120":41335,"_5":17015,"_23194":41182,"_2329":41336},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2802":491,"_24443":444,"_17120":41338,"_5":17015,"_23194":41182,"_2329":41339},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2802":492,"_24443":444,"_17120":41341,"_5":17015,"_23194":41182,"_2329":41342},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2802":493,"_24443":444,"_17120":41344,"_5":17015,"_23194":41182,"_2329":41345},[],"It separately loads the policies granted to each principal.",{"_2802":494,"_24443":444,"_17120":41347,"_5":17015,"_23194":41182,"_2329":41348},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2802":495,"_24443":444,"_17120":41350,"_5":17015,"_23194":41182,"_2329":41351},[],"`authz` looks for an HTTP rule granting that action.",{"_2802":496,"_24443":444,"_17120":41353,"_5":17015,"_23194":41182,"_2329":41354},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2802":497,"_24443":444,"_17120":41356,"_5":17015,"_23194":41182,"_2329":41357},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2802":498,"_24443":444,"_17120":41359,"_5":17015,"_23194":41182,"_2329":41360},[],"When it allows access, `authz` returns the selected principal in `x-current-user`. The Gateway can propagate that header to the service to preserve the identity context.",{"_2802":499,"_24443":444,"_17120":41362,"_5":17015,"_23194":41182,"_2329":41363},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2802":500,"_24443":444,"_17120":41365,"_5":17015,"_23194":41186,"_2329":41366},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2802":501,"_24443":444,"_17120":41368,"_5":17015,"_23194":41186,"_2329":41369},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2802":502,"_24443":444,"_17120":41371,"_5":17015,"_23194":41186,"_2329":41372},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2802":503,"_24443":444,"_17120":41374,"_5":17015,"_23194":41186,"_2329":41375},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2802":504,"_24443":444,"_17120":41377,"_5":17015,"_23194":41186,"_2329":41378},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2802":505,"_24443":444,"_17120":41380,"_5":17015,"_23194":41186,"_2329":41381},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2802":506,"_24443":444,"_17120":41383,"_5":17015,"_23194":41186,"_2329":41384},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2802":507,"_24443":444,"_17120":41386,"_5":17015,"_23194":41186,"_2329":41387},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2802":508,"_24443":444,"_17120":41389,"_5":17015,"_23194":41190,"_2329":41390},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2802":509,"_24443":444,"_17120":41392,"_5":17015,"_23194":41190,"_2329":41393},[],"The decision is made with the domain operation context:",{"_2802":510,"_24443":444,"_17120":41395,"_5":17015,"_23194":41190,"_2329":41396},[],"The middleware extracts the credential and resolves the matching principals.",{"_2802":511,"_24443":444,"_17120":41398,"_5":17015,"_23194":41190,"_2329":41399},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2802":512,"_24443":444,"_17120":41401,"_5":17015,"_23194":41190,"_2329":41402},[],"`authz` gathers the entity rules of the granted policies.",{"_2802":513,"_24443":444,"_17120":41404,"_5":17015,"_23194":41190,"_2329":41405},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2802":514,"_24443":444,"_17120":41407,"_5":17015,"_23194":41190,"_2329":41408},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2802":515,"_24443":444,"_17120":41410,"_5":17015,"_23194":41190,"_2329":41411},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2802":516,"_24443":444,"_17120":41413,"_5":17015,"_23194":41190,"_2329":41414},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2802":517,"_24443":444,"_17120":41416,"_5":17015,"_23194":41190,"_2329":41417},[],"Actions fall into two groups:",{"_2802":518,"_24443":444,"_17120":41419,"_5":17015,"_23194":41190,"_2329":41420},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2802":519,"_24443":444,"_17120":41422,"_5":17015,"_23194":41190,"_2329":41423},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2802":520,"_24443":444,"_17120":41425,"_5":17015,"_23194":41190,"_2329":41426},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2802":521,"_24443":444,"_17120":41428,"_5":17015,"_23194":41194,"_2329":41429},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2802":522,"_24443":444,"_17120":41431,"_5":17015,"_23194":41194,"_2329":41432},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2802":523,"_24443":444,"_17120":41434,"_5":17015,"_23194":41194,"_2329":41435},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2802":524,"_24443":444,"_17120":41437,"_5":17015,"_23194":41198,"_2329":41438},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2802":525,"_24443":444,"_17120":41440,"_5":17015,"_23194":41198,"_2329":41441},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2802":526,"_24443":444,"_17120":41443,"_5":17015,"_23194":41198,"_2329":41444},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2802":527,"_24443":444,"_17120":41446,"_5":17015,"_23194":41198,"_2329":41447},[],"The implemented operators are:",{"_2802":528,"_24443":444,"_17120":41449,"_5":17015,"_23194":41198,"_2329":41450},[],"`equals`, for exact equality;",{"_2802":529,"_24443":444,"_17120":41452,"_5":17015,"_23194":41198,"_2329":41453},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2802":530,"_24443":444,"_17120":41455,"_5":17015,"_23194":41198,"_2329":41456},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2802":531,"_24443":444,"_17120":41458,"_5":17015,"_23194":41198,"_2329":41459},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2802":532,"_24443":444,"_17120":41461,"_5":17015,"_23194":41202,"_2329":41462},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2802":533,"_24443":444,"_17120":41464,"_5":17015,"_23194":41202,"_2329":41465},[],"The available modes are:",{"_2802":534,"_24443":444,"_17120":41467,"_5":17015,"_23194":41202,"_2329":41468},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2802":535,"_24443":444,"_17120":41470,"_5":17015,"_23194":41202,"_2329":41471},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2802":536,"_24443":444,"_17120":41473,"_5":17015,"_23194":41202,"_2329":41474},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2802":537,"_24443":444,"_17120":41476,"_5":17015,"_23194":41202,"_2329":41477},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2802":538,"_24443":444,"_17120":41479,"_5":17015,"_23194":41202,"_2329":41480},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2802":539,"_24443":444,"_17120":41482,"_5":17015,"_23194":41202,"_2329":41483},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2802":540,"_24443":444,"_17120":41485,"_5":17015,"_23194":41206,"_2329":41486},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2802":541,"_24443":444,"_17120":41488,"_5":17015,"_23194":41206,"_2329":41489},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2802":542,"_24443":444,"_17120":41491,"_5":17015,"_23194":41206,"_2329":41492},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2802":543,"_24443":444,"_17120":41494,"_5":17015,"_23194":41206,"_2329":41495},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2802":544,"_24443":444,"_17120":41497,"_5":17015,"_23194":41214,"_2329":41498},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2802":545,"_24443":444,"_17120":41500,"_5":17015,"_23194":41214,"_2329":41501},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2802":546,"_24443":444,"_17120":41503,"_5":17015,"_23194":41218,"_2329":41504},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2802":547,"_24443":444,"_17120":41506,"_5":17015,"_23194":41218,"_2329":41507},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2802":548,"_24443":444,"_17120":41509,"_5":17015,"_23194":41222,"_2329":41510},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2802":549,"_24443":444,"_17120":41512,"_5":17015,"_23194":41222,"_2329":41513},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2802":550,"_24443":444,"_17120":41515,"_5":17015,"_23194":41222,"_2329":41516},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2802":551,"_24443":444,"_17120":41518,"_5":17015,"_23194":41226,"_2329":41519},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2802":552,"_24443":444,"_17120":41521,"_5":17015,"_23194":41226,"_2329":41522},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2802":553,"_24443":444,"_17120":41524,"_5":17015,"_23194":41226,"_2329":41525},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2802":554,"_24443":444,"_17120":41527,"_5":17015,"_23194":41226,"_2329":41528},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2802":555,"_24443":444,"_17120":41530,"_5":17015,"_23194":41226,"_2329":41531},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2802":556,"_24443":444,"_17120":41533,"_5":17015,"_23194":41226,"_2329":41534},[],"Note that:",{"_2802":557,"_24443":444,"_17120":41536,"_5":17015,"_23194":41226,"_2329":41537},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2802":558,"_24443":444,"_17120":41539,"_5":17015,"_23194":41226,"_2329":41540},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2802":559,"_24443":444,"_17120":41542,"_5":17015,"_23194":41226,"_2329":41543},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2802":560,"_24443":444,"_17120":41545,"_5":17015,"_23194":41230,"_2329":41546},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2802":561,"_24443":444,"_17120":41548,"_5":17015,"_23194":41230,"_2329":41549},[],"full and read-only access to certificates and authorities;",{"_2802":562,"_24443":444,"_17120":41551,"_5":17015,"_23194":41230,"_2329":41552},[],"full and read-only access to the KMS;",{"_2802":563,"_24443":444,"_17120":41554,"_5":17015,"_23194":41230,"_2329":41555},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2802":564,"_24443":444,"_17120":41557,"_5":17015,"_23194":41230,"_2329":41558},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2802":565,"_24443":444,"_17120":41560,"_5":17015,"_23194":41230,"_2329":41561},[],"console access;",{"_2802":566,"_24443":444,"_17120":41563,"_5":17015,"_23194":41230,"_2329":41564},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2802":567,"_24443":444,"_17120":41566,"_5":17015,"_23194":41230,"_2329":41567},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2802":568,"_24443":444,"_17120":41569,"_5":17015,"_23194":41230,"_2329":41570},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2802":569,"_24443":444,"_17120":41572,"_5":17015,"_23194":41234,"_2329":41573},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2802":570,"_24443":444,"_17120":41575,"_5":17015,"_23194":41234,"_2329":41576},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2802":571,"_24443":444,"_17120":41578,"_5":17015,"_23194":41234,"_2329":41579},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2802":572,"_24443":444,"_17120":41581,"_5":17015,"_23194":41237,"_2329":41582},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2802":573,"_24443":444,"_17120":41584,"_5":17015,"_23194":41241,"_2329":41585},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2802":574,"_24443":444,"_17120":41587,"_5":17015,"_23194":41245,"_2329":41588},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2802":575,"_24443":444,"_17120":41590,"_5":17015,"_23194":41249,"_2329":41591},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2802":576,"_24443":444,"_17120":41593,"_5":17015,"_23194":41253,"_2329":41594},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2802":577,"_24443":444,"_17120":41596,"_5":17015,"_23194":41257,"_2329":41597},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2802":578,"_24443":444,"_17120":41599,"_5":17015,"_23194":41257,"_2329":41600},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2802":579,"_24443":444,"_17120":41602,"_5":17015,"_23194":41261,"_2329":41603},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2802":580,"_24443":444,"_17120":41605,"_5":17015,"_23194":41261,"_2329":41606},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2802":581,"_24443":444,"_17120":41608,"_5":17015,"_23194":41261,"_2329":41609},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2802":582,"_24443":444,"_17120":41611,"_5":17015,"_23194":41261,"_2329":41612},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2802":583,"_24443":444,"_17120":41614,"_5":17015,"_23194":41261,"_2329":41615},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2802":584,"_24443":444,"_17120":41617,"_5":17015,"_23194":41261,"_2329":41618},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2802":585,"_24443":444,"_17120":41620,"_5":17015,"_23194":41261,"_2329":41621},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2802":586,"_24443":444,"_17120":41623,"_5":17015,"_23194":41261,"_2329":41624},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2802":587,"_24443":444,"_17120":41626,"_5":17015,"_23194":41265,"_2329":41627},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2802":588,"_24443":444,"_17120":41629,"_5":17015,"_23194":41265,"_2329":41630},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2802":589,"_24443":444,"_17120":41632,"_5":17015,"_23194":41265,"_2329":41633},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2802":590,"_24443":444,"_17120":41635,"_5":17015,"_23194":41269,"_2329":41636},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2802":591,"_24443":444,"_17120":41638,"_5":17015,"_23194":41269,"_2329":41639},[],"Use groups or stable roles for people and independent identities for automations.",{"_2802":592,"_24443":444,"_17120":41641,"_5":17015,"_23194":41269,"_2329":41642},[],"Keep at least two recovery administrators and test their access periodically.",{"_2802":593,"_24443":444,"_17120":41644,"_5":17015,"_23194":41269,"_2329":41645},[],"Review active principals, their matches and their grants after IdP changes.",{"_2802":594,"_24443":444,"_17120":41647,"_5":17015,"_23194":41269,"_2329":41648},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2802":595,"_24443":444,"_17120":41650,"_5":17015,"_23194":41269,"_2329":41651},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2802":596,"_24443":444,"_17120":41653,"_5":17015,"_23194":41269,"_2329":41654},[],"Always test one allowed and one denied operation for each role.",{"_2802":597,"_24443":444,"_17120":41656,"_5":17015,"_23194":41269,"_2329":41657},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2802":598,"_24443":444,"_17120":41659,"_5":17015,"_23194":41277,"_2329":41660},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2802":599,"_24443":444,"_17120":41662,"_5":17015,"_23194":41281,"_2329":41663},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2802":600,"_24443":444,"_17120":41665,"_5":17015,"_23194":41281,"_2329":41666},[],"that an active principal of the correct type exists;",{"_2802":601,"_24443":444,"_17120":41668,"_5":17015,"_23194":41281,"_2329":41669},[],"that the claim paths and values match the real token exactly;",{"_2802":602,"_24443":444,"_17120":41671,"_5":17015,"_23194":41281,"_2329":41672},[],"that all of the principal's conditions hold;",{"_2802":603,"_24443":444,"_17120":41674,"_5":17015,"_23194":41281,"_2329":41675},[],"that the principal has the expected policy granted;",{"_2802":604,"_24443":444,"_17120":41677,"_5":17015,"_23194":41281,"_2329":41678},[],"that the policy includes the action and the requested resource type or route;",{"_2802":605,"_24443":444,"_17120":41680,"_5":17015,"_23194":41281,"_2329":41681},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2802":606,"_24443":444,"_17120":41683,"_5":17015,"_23194":41281,"_2329":41684},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2802":607,"_24443":444,"_17120":41686,"_5":17015,"_23194":41285,"_2329":41687},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2802":608,"_24443":444,"_17120":41689,"_5":17015,"_23194":41289,"_2329":41690},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2802":609,"_24443":444,"_17120":41692,"_5":17015,"_23194":41293,"_2329":41693},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2802":610,"_24443":444,"_17120":41695,"_5":17015,"_23194":41293,"_2329":41696},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2802":611,"_24443":611,"_5":12033,"_2329":41698,"_24778":41699,"_17120":41700,"_23194":611},"Alerts and subscriptions",[39822,41166,41167],[],{"_2802":612,"_24443":611,"_17120":41702,"_5":17015,"_23194":611,"_2329":41703},[],"Send PKI events to people and external systems.",{"_2802":613,"_24443":611,"_5":24775,"_17120":41705,"_23194":41706,"_2329":41707},[],"/docs/pr-preview/pr-28/platform/administration/alerts#how-it-works","How it works",{"_2802":614,"_24443":611,"_5":24775,"_17120":41709,"_23194":41710,"_2329":41711},[],"/docs/pr-preview/pr-28/platform/administration/alerts#available-channels","Available channels",{"_2802":615,"_24443":611,"_5":24775,"_17120":41713,"_23194":41714,"_2329":41715},[],"/docs/pr-preview/pr-28/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2802":616,"_24443":611,"_5":24775,"_17120":41717,"_23194":41718,"_2329":41719},[],"/docs/pr-preview/pr-28/platform/administration/alerts#choose-the-event","Choose the event",{"_2802":617,"_24443":611,"_5":24775,"_17120":41721,"_23194":41722,"_2329":41723},[],"/docs/pr-preview/pr-28/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2802":618,"_24443":611,"_5":24775,"_17120":41725,"_23194":41726,"_2329":41727},[],"/docs/pr-preview/pr-28/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2802":619,"_24443":611,"_5":24775,"_17120":41729,"_23194":41730,"_2329":41731},[],"/docs/pr-preview/pr-28/platform/administration/alerts#review-and-activate","Review and activate",{"_2802":620,"_24443":611,"_5":24775,"_17120":41733,"_23194":41734,"_2329":41735},[],"/docs/pr-preview/pr-28/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2802":621,"_24443":611,"_5":24775,"_17120":41737,"_23194":41738,"_2329":41739},[],"/docs/pr-preview/pr-28/platform/administration/alerts#event-families","Event families",{"_2802":622,"_24443":611,"_17120":41741,"_5":17015,"_23194":611,"_2329":41742},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2802":623,"_24443":611,"_17120":41744,"_5":17015,"_23194":41706,"_2329":41745},[],"A service publishes a domain event.",{"_2802":624,"_24443":611,"_17120":41747,"_5":17015,"_23194":41706,"_2329":41748},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2802":625,"_24443":611,"_17120":41750,"_5":17015,"_23194":41706,"_2329":41751},[],"Each subscription's filter decides whether it should be notified.",{"_2802":626,"_24443":611,"_17120":41753,"_5":17015,"_23194":41706,"_2329":41754},[],"Lamassu delivers the event to the configured channel.",{"_2802":627,"_24443":611,"_17120":41756,"_5":17015,"_23194":41706,"_2329":41757},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2802":628,"_24443":611,"_17120":41759,"_5":17015,"_23194":41710,"_2329":41760},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address.",{"_2802":629,"_24443":611,"_17120":41762,"_5":17015,"_23194":41710,"_2329":41763},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2802":630,"_24443":611,"_17120":41765,"_5":17015,"_23194":41710,"_2329":41766},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2802":631,"_24443":611,"_17120":41768,"_5":17015,"_23194":41718,"_2329":41769},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2802":632,"_24443":611,"_17120":41771,"_5":17015,"_23194":41722,"_2329":41772},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2802":633,"_24443":611,"_17120":41774,"_5":17015,"_23194":41726,"_2329":41775},[],"Add a filter if you don't want to receive every instance of the event.",{"_2802":634,"_24443":611,"_17120":41777,"_5":17015,"_23194":41726,"_2329":41778},[],"**None** notifies all instances of the event.",{"_2802":635,"_24443":611,"_17120":41780,"_5":17015,"_23194":41726,"_2329":41781},[],"**JSON Path** evaluates one or more specific fields.",{"_2802":636,"_24443":611,"_17120":41783,"_5":17015,"_23194":41726,"_2329":41784},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2802":637,"_24443":611,"_17120":41786,"_5":17015,"_23194":41726,"_2329":41787},[],"**JavaScript** lets you express custom logic.",{"_2802":638,"_24443":611,"_17120":41789,"_5":17015,"_23194":41726,"_2329":41790},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2802":639,"_24443":611,"_17120":41792,"_5":17015,"_23194":41730,"_2329":41793},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2802":640,"_24443":611,"_17120":41795,"_5":17015,"_23194":41734,"_2329":41796},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2802":641,"_24443":611,"_17120":41798,"_5":17015,"_23194":41738,"_2329":41799},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2802":642,"_24443":611,"_17120":41801,"_5":17015,"_23194":41738,"_2329":41802},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2802":643,"_24443":611,"_17120":41804,"_5":17015,"_23194":41738,"_2329":41805},[],"**Profiles:** `profile.create`, `profile.update` and `profile.delete`.",{"_2802":644,"_24443":611,"_17120":41807,"_5":17015,"_23194":41738,"_2329":41808},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2802":645,"_24443":611,"_17120":41810,"_5":17015,"_23194":41738,"_2329":41811},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2802":646,"_24443":611,"_17120":41813,"_5":17015,"_23194":41738,"_2329":41814},[],"**Validation:** `va.role.crl.create`.",{"_2802":647,"_24443":611,"_17120":41816,"_5":17015,"_23194":41738,"_2329":41817},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign.message` and `kms.delete`.",{"_2802":648,"_24443":611,"_17120":41819,"_5":17015,"_23194":41738,"_2329":41820},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2802":649,"_24443":649,"_5":12033,"_2329":41822,"_24778":41823,"_17120":41824,"_23194":649},"Audit logs",[39822,41166,41167],[],{"_2802":650,"_24443":649,"_17120":41826,"_5":17015,"_23194":649,"_2329":41827},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2802":651,"_24443":649,"_5":24775,"_17120":41829,"_23194":41830,"_2329":41831},[],"/docs/pr-preview/pr-28/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2802":652,"_24443":649,"_5":24775,"_17120":41833,"_23194":41834,"_2329":41835},[],"/docs/pr-preview/pr-28/platform/administration/audit-logs#coverage","Coverage",{"_2802":653,"_24443":649,"_5":24775,"_17120":41837,"_23194":41838,"_2329":41839},[],"/docs/pr-preview/pr-28/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2802":654,"_24443":649,"_5":24775,"_17120":41841,"_23194":41842,"_2329":41843},[],"/docs/pr-preview/pr-28/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2802":655,"_24443":649,"_5":24775,"_17120":41845,"_23194":41846,"_2329":41847},[],"/docs/pr-preview/pr-28/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2802":656,"_24443":649,"_5":24775,"_17120":41849,"_23194":41850,"_2329":41851},[],"/docs/pr-preview/pr-28/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2802":657,"_24443":649,"_5":24775,"_17120":41853,"_23194":41854,"_2329":41855},[],"/docs/pr-preview/pr-28/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2802":658,"_24443":649,"_5":24775,"_17120":41857,"_23194":41858,"_2329":41859},[],"/docs/pr-preview/pr-28/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2802":659,"_24443":649,"_5":24775,"_17120":41861,"_23194":41862,"_2329":41863},[],"/docs/pr-preview/pr-28/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2802":660,"_24443":649,"_5":24775,"_17120":41865,"_23194":41866,"_2329":41867},[],"/docs/pr-preview/pr-28/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2802":661,"_24443":649,"_5":24775,"_17120":41869,"_23194":41870,"_2329":41871},[],"/docs/pr-preview/pr-28/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2802":662,"_24443":649,"_17120":41873,"_5":17015,"_23194":649,"_2329":41874},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2802":663,"_24443":649,"_17120":41876,"_5":17015,"_23194":41830,"_2329":41877},[],"The audit body includes:",{"_2802":664,"_24443":649,"_17120":41879,"_5":17015,"_23194":41830,"_2329":41880},[],"input: data received by the operation;",{"_2802":665,"_24443":649,"_17120":41882,"_5":17015,"_23194":41830,"_2329":41883},[],"has\\_error: whether the service returned an error;",{"_2802":666,"_24443":649,"_17120":41885,"_5":17015,"_23194":41830,"_2329":41886},[],"output: produced result or error message;",{"_2802":667,"_24443":649,"_17120":41888,"_5":17015,"_23194":41830,"_2329":41889},[],"principals: identifiers of the principals that matched the request.",{"_2802":668,"_24443":649,"_17120":41891,"_5":17015,"_23194":41830,"_2329":41892},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2802":669,"_24443":649,"_17120":41894,"_5":17015,"_23194":41830,"_2329":41895},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2802":670,"_24443":649,"_17120":41897,"_5":17015,"_23194":41834,"_2329":41898},[],"The backend applies auditing to mutations of:",{"_2802":671,"_24443":649,"_17120":41900,"_5":17015,"_23194":41834,"_2329":41901},[],"authorities, certificates and issuance profiles;",{"_2802":672,"_24443":649,"_17120":41903,"_5":17015,"_23194":41834,"_2329":41904},[],"keys and KMS engines;",{"_2802":673,"_24443":649,"_17120":41906,"_5":17015,"_23194":41834,"_2329":41907},[],"devices and identities;",{"_2802":674,"_24443":649,"_17120":41909,"_5":17015,"_23194":41834,"_2329":41910},[],"DMSs and enrollment operations;",{"_2802":675,"_24443":649,"_17120":41912,"_5":17015,"_23194":41834,"_2329":41913},[],"validation functions and CRL;",{"_2802":676,"_24443":649,"_17120":41915,"_5":17015,"_23194":41834,"_2329":41916},[],"principals, policies and authorization grants.",{"_2802":677,"_24443":649,"_17120":41918,"_5":17015,"_23194":41834,"_2329":41919},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2802":678,"_24443":649,"_17120":41921,"_5":17015,"_23194":41838,"_2329":41922},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2802":679,"_24443":649,"_17120":41924,"_5":17015,"_23194":41838,"_2329":41925},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2802":680,"_24443":649,"_17120":41927,"_5":17015,"_23194":41838,"_2329":41928},[],"Design the consumer to:",{"_2802":681,"_24443":649,"_17120":41930,"_5":17015,"_23194":41838,"_2329":41931},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2802":682,"_24443":649,"_17120":41933,"_5":17015,"_23194":41838,"_2329":41934},[],"keep the complete CloudEvent unmodified;",{"_2802":683,"_24443":649,"_17120":41936,"_5":17015,"_23194":41838,"_2329":41937},[],"record the ingestion time and detect duplicates by ID;",{"_2802":684,"_24443":649,"_17120":41939,"_5":17015,"_23194":41838,"_2329":41940},[],"encrypt in transit and at rest;",{"_2802":685,"_24443":649,"_17120":41942,"_5":17015,"_23194":41838,"_2329":41943},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2802":686,"_24443":649,"_17120":41945,"_5":17015,"_23194":41838,"_2329":41946},[],"apply an explicit retention and legal hold policy;",{"_2802":687,"_24443":649,"_17120":41948,"_5":17015,"_23194":41838,"_2329":41949},[],"alert if it stops consuming or the pending queue grows.",{"_2802":688,"_24443":649,"_17120":41951,"_5":17015,"_23194":41842,"_2329":41952},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2802":689,"_24443":649,"_17120":41954,"_5":17015,"_23194":41842,"_2329":41955},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2802":690,"_24443":649,"_17120":41957,"_5":17015,"_23194":41850,"_2329":41958},[],"Start from the reported time and normalize every source to UTC.",{"_2802":691,"_24443":649,"_17120":41960,"_5":17015,"_23194":41854,"_2329":41961},[],"Filter by event type, service source and resource identifier.",{"_2802":692,"_24443":649,"_17120":41963,"_5":17015,"_23194":41858,"_2329":41964},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2802":693,"_24443":649,"_17120":41966,"_5":17015,"_23194":41862,"_2329":41967},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2802":694,"_24443":649,"_17120":41969,"_5":17015,"_23194":41866,"_2329":41970},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2802":695,"_24443":649,"_17120":41972,"_5":17015,"_23194":41870,"_2329":41973},[],"Generate a controlled mutation in a test environment and check that:",{"_2802":696,"_24443":649,"_17120":41975,"_5":17015,"_23194":41870,"_2329":41976},[],"a successful audit event appears;",{"_2802":697,"_24443":649,"_17120":41978,"_5":17015,"_23194":41870,"_2329":41979},[],"the principal matches the identity used;",{"_2802":698,"_24443":649,"_17120":41981,"_5":17015,"_23194":41870,"_2329":41982},[],"the consumer persists it exactly once;",{"_2802":699,"_24443":649,"_17120":41984,"_5":17015,"_23194":41870,"_2329":41985},[],"it can be retrieved by resource, actor and period;",{"_2802":700,"_24443":649,"_17120":41987,"_5":17015,"_23194":41870,"_2329":41988},[],"a consumer outage raises an alert.",{"_2802":701,"_24443":649,"_17120":41990,"_5":17015,"_23194":41870,"_2329":41991},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2802":702,"_24443":702,"_5":12033,"_2329":41993,"_24778":41994,"_17120":41995,"_23194":702},"Platform architecture",[39822,41166],[],{"_2802":703,"_24443":702,"_17120":41997,"_5":17015,"_23194":702,"_2329":41998},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2802":704,"_24443":702,"_5":24775,"_17120":42000,"_23194":42001,"_2329":42002},[],"/docs/pr-preview/pr-28/platform/concepts/architecture#control-plane","Control plane",{"_2802":705,"_24443":702,"_5":24775,"_17120":42004,"_23194":42005,"_2329":42006},[],"/docs/pr-preview/pr-28/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2802":706,"_24443":702,"_5":24775,"_17120":42008,"_23194":42009,"_2329":42010},[],"/docs/pr-preview/pr-28/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2802":707,"_24443":702,"_5":24775,"_17120":42012,"_23194":42013,"_2329":42014},[],"/docs/pr-preview/pr-28/platform/concepts/architecture#status-and-validation","Status and validation",{"_2802":708,"_24443":702,"_5":24775,"_17120":42016,"_23194":42017,"_2329":42018},[],"/docs/pr-preview/pr-28/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2802":709,"_24443":702,"_17120":42020,"_5":17015,"_23194":702,"_2329":42021},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2802":710,"_24443":702,"_17120":42023,"_5":17015,"_23194":702,"_2329":42024},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2802":711,"_24443":702,"_17120":42026,"_5":17015,"_23194":42001,"_2329":42027},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2802":712,"_24443":702,"_17120":42029,"_5":17015,"_23194":42005,"_2329":42030},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2802":713,"_24443":702,"_17120":42032,"_5":17015,"_23194":42009,"_2329":42033},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2802":714,"_24443":702,"_17120":42035,"_5":17015,"_23194":42013,"_2329":42036},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2802":715,"_24443":702,"_17120":42038,"_5":17015,"_23194":42017,"_2329":42039},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2802":716,"_24443":716,"_5":12033,"_2329":42041,"_24778":42042,"_17120":42043,"_23194":716},"How Lamassu works",[39822,41166],[],{"_2802":717,"_24443":716,"_17120":42045,"_5":17015,"_23194":716,"_2329":42046},[],"The mental model of trust, keys, certificates and devices.",{"_2802":718,"_24443":716,"_5":24775,"_17120":42048,"_23194":42049,"_2329":42050},[],"/docs/pr-preview/pr-28/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2802":719,"_24443":716,"_5":24775,"_17120":42052,"_23194":42053,"_2329":42054},[],"/docs/pr-preview/pr-28/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2802":720,"_24443":716,"_17120":42056,"_5":17015,"_23194":716,"_2329":42057},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2802":721,"_24443":716,"_17120":42059,"_5":17015,"_23194":42049,"_2329":42060},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2802":722,"_24443":716,"_17120":42062,"_5":17015,"_23194":42049,"_2329":42063},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2802":723,"_24443":716,"_17120":42065,"_5":17015,"_23194":42049,"_2329":42066},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2802":724,"_24443":716,"_17120":42068,"_5":17015,"_23194":42049,"_2329":42069},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2802":725,"_24443":716,"_17120":42071,"_5":17015,"_23194":42049,"_2329":42072},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2802":726,"_24443":716,"_17120":42074,"_5":17015,"_23194":42053,"_2329":42075},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2802":727,"_24443":716,"_17120":42077,"_5":17015,"_23194":42053,"_2329":42078},[],"A DMS relates that CA to an enrollment policy.",{"_2802":728,"_24443":716,"_17120":42080,"_5":17015,"_23194":42053,"_2329":42081},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2802":729,"_24443":716,"_17120":42083,"_5":17015,"_23194":42053,"_2329":42084},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2802":730,"_24443":716,"_17120":42086,"_5":17015,"_23194":42053,"_2329":42087},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2802":731,"_24443":716,"_17120":42089,"_5":17015,"_23194":42053,"_2329":42090},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2802":732,"_24443":716,"_17120":42092,"_5":17015,"_23194":42053,"_2329":42093},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2802":733,"_24443":733,"_5":12033,"_2329":42095,"_24778":42096,"_17120":42098,"_23194":733},"Devices and identities",[39822,41166,42097,42095],"IoT Fleets",[],{"_2802":734,"_24443":733,"_17120":42100,"_5":17015,"_23194":733,"_2329":42101},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2802":735,"_24443":733,"_5":24775,"_17120":42103,"_23194":42104,"_2329":42105},[],"/docs/pr-preview/pr-28/platform/iot-fleets/device-management#device-states","Device states",{"_2802":736,"_24443":733,"_5":24775,"_17120":42107,"_23194":42108,"_2329":42109},[],"/docs/pr-preview/pr-28/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2802":737,"_24443":733,"_5":24775,"_17120":42111,"_23194":42112,"_2329":42113},[],"/docs/pr-preview/pr-28/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2802":738,"_24443":733,"_5":24775,"_17120":42115,"_23194":42116,"_2329":42117},[],"/docs/pr-preview/pr-28/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2802":739,"_24443":733,"_5":24775,"_17120":42119,"_23194":42120,"_2329":42121},[],"/docs/pr-preview/pr-28/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2802":740,"_24443":733,"_5":24775,"_17120":42123,"_23194":42124,"_2329":42125},[],"/docs/pr-preview/pr-28/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2802":741,"_24443":733,"_5":24775,"_17120":42127,"_23194":42128,"_2329":42129},[],"/docs/pr-preview/pr-28/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2802":742,"_24443":733,"_5":24775,"_17120":42131,"_23194":42132,"_2329":42133},[],"/docs/pr-preview/pr-28/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2802":743,"_24443":733,"_5":24775,"_17120":42135,"_23194":42136,"_2329":42137},[],"/docs/pr-preview/pr-28/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2802":744,"_24443":733,"_5":24775,"_17120":42139,"_23194":42140,"_2329":42141},[],"/docs/pr-preview/pr-28/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2802":745,"_24443":733,"_5":24775,"_17120":42143,"_23194":42144,"_2329":42145},[],"/docs/pr-preview/pr-28/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2802":746,"_24443":733,"_17120":42147,"_5":17015,"_23194":733,"_2329":42148},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2802":747,"_24443":733,"_17120":42150,"_5":17015,"_23194":733,"_2329":42151},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2802":748,"_24443":733,"_17120":42153,"_5":17015,"_23194":42104,"_2329":42154},[],"Operational view",{"_2802":749,"_24443":733,"_17120":42156,"_5":17015,"_23194":42104,"_2329":42157},[],"Meaning",{"_2802":750,"_24443":733,"_17120":42159,"_5":17015,"_23194":42104,"_2329":42160},[],"**No Identity**",{"_2802":751,"_24443":733,"_17120":42162,"_5":17015,"_23194":42104,"_2329":42163},[],"A record exists without an associated identity.",{"_2802":752,"_24443":733,"_17120":42165,"_5":17015,"_23194":42104,"_2329":42166},[],"**Active**",{"_2802":753,"_24443":733,"_17120":42168,"_5":17015,"_23194":42104,"_2329":42169},[],"The slot is active; also check certificate dates, status and usages.",{"_2802":754,"_24443":733,"_17120":42171,"_5":17015,"_23194":42104,"_2329":42172},[],"**Renewal Pending**",{"_2802":755,"_24443":733,"_17120":42174,"_5":17015,"_23194":42104,"_2329":42175},[],"The identity is in the operational renewal window.",{"_2802":756,"_24443":733,"_17120":42177,"_5":17015,"_23194":42104,"_2329":42178},[],"**Expiring Soon**",{"_2802":757,"_24443":733,"_17120":42180,"_5":17015,"_23194":42104,"_2329":42181},[],"Expiration is approaching according to configured thresholds.",{"_2802":758,"_24443":733,"_17120":42183,"_5":17015,"_23194":42104,"_2329":42184},[],"**Expired**",{"_2802":759,"_24443":733,"_17120":42186,"_5":17015,"_23194":42104,"_2329":42187},[],"The identity has expired.",{"_2802":760,"_24443":733,"_17120":42189,"_5":17015,"_23194":42104,"_2329":42190},[],"**Revoked**",{"_2802":761,"_24443":733,"_17120":42192,"_5":17015,"_23194":42104,"_2329":42193},[],"The identity is marked revoked.",{"_2802":762,"_24443":733,"_17120":42195,"_5":17015,"_23194":42104,"_2329":42196},[],"**Decommissioned**",{"_2802":763,"_24443":733,"_17120":42198,"_5":17015,"_23194":42104,"_2329":42199},[],"The record is retired and ordinary updates do not restore operation.",{"_2802":764,"_24443":733,"_17120":42201,"_5":17015,"_23194":42104,"_2329":42202},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2802":765,"_24443":733,"_17120":42204,"_5":17015,"_23194":42108,"_2329":42205},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2802":766,"_24443":733,"_17120":42207,"_5":17015,"_23194":42108,"_2329":42208},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2802":767,"_24443":733,"_17120":42210,"_5":17015,"_23194":42108,"_2329":42211},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2802":768,"_24443":733,"_17120":42213,"_5":17015,"_23194":42108,"_2329":42214},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2802":769,"_24443":733,"_17120":42216,"_5":17015,"_23194":42112,"_2329":42217},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2802":770,"_24443":733,"_17120":42219,"_5":17015,"_23194":42116,"_2329":42220},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2802":771,"_24443":733,"_17120":42222,"_5":17015,"_23194":42120,"_2329":42223},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2802":772,"_24443":733,"_17120":42225,"_5":17015,"_23194":42124,"_2329":42226},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2802":773,"_24443":733,"_17120":42228,"_5":17015,"_23194":42128,"_2329":42229},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2802":774,"_24443":733,"_17120":42231,"_5":17015,"_23194":42128,"_2329":42232},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2802":775,"_24443":733,"_17120":42234,"_5":17015,"_23194":42132,"_2329":42235},[],"From **No Identity**, use **Assign Identity**:",{"_2802":776,"_24443":733,"_17120":42237,"_5":17015,"_23194":42132,"_2329":42238},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2802":777,"_24443":733,"_17120":42240,"_5":17015,"_23194":42132,"_2329":42241},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2802":778,"_24443":733,"_17120":42243,"_5":17015,"_23194":42132,"_2329":42244},[],"Confirm and read the serial, active version and history again.",{"_2802":779,"_24443":733,"_17120":42246,"_5":17015,"_23194":42132,"_2329":42247},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2802":780,"_24443":733,"_17120":42249,"_5":17015,"_23194":42132,"_2329":42250},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2802":781,"_24443":733,"_17120":42252,"_5":17015,"_23194":42136,"_2329":42253},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2802":782,"_24443":733,"_17120":42255,"_5":17015,"_23194":42136,"_2329":42256},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2802":783,"_24443":733,"_17120":42258,"_5":17015,"_23194":42140,"_2329":42259},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2802":784,"_24443":733,"_17120":42261,"_5":17015,"_23194":42140,"_2329":42262},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2802":785,"_24443":733,"_17120":42264,"_5":17015,"_23194":42140,"_2329":42265},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2802":786,"_24443":733,"_17120":42267,"_5":17015,"_23194":42140,"_2329":42268},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2802":787,"_24443":733,"_17120":42270,"_5":17015,"_23194":42144,"_2329":42271},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2802":788,"_24443":733,"_17120":42273,"_5":17015,"_23194":42144,"_2329":42274},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2802":789,"_24443":789,"_5":12033,"_2329":42276,"_24778":42277,"_17120":42279,"_23194":789},"Bootstrap identity and authentication",[39822,41166,42097,42095,42278],"Enrollment with PKI",[],{"_2802":790,"_24443":789,"_17120":42281,"_5":17015,"_23194":789,"_2329":42282},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2802":791,"_24443":789,"_5":24775,"_17120":42284,"_23194":42285,"_2329":42286},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2802":792,"_24443":789,"_5":24775,"_17120":42288,"_23194":42289,"_2329":42290},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2802":793,"_24443":789,"_5":24775,"_17120":42292,"_23194":42293,"_2329":42294},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2802":794,"_24443":789,"_5":24775,"_17120":42296,"_23194":42297,"_2329":42298},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2802":795,"_24443":789,"_5":24775,"_17120":42300,"_23194":42301,"_2329":42302},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2802":796,"_24443":789,"_17120":42304,"_5":17015,"_23194":789,"_2329":42305},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2802":797,"_24443":789,"_17120":42307,"_5":17015,"_23194":42285,"_2329":42308},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2802":798,"_24443":789,"_17120":42310,"_5":17015,"_23194":42285,"_2329":42311},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2802":799,"_24443":789,"_17120":42313,"_5":17015,"_23194":42289,"_2329":42314},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2802":800,"_24443":789,"_17120":42316,"_5":17015,"_23194":42289,"_2329":42317},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2802":801,"_24443":789,"_17120":42319,"_5":17015,"_23194":42289,"_2329":42320},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2802":802,"_24443":789,"_17120":42322,"_5":17015,"_23194":42293,"_2329":42323},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2802":803,"_24443":789,"_17120":42325,"_5":17015,"_23194":42293,"_2329":42326},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2802":804,"_24443":789,"_17120":42328,"_5":17015,"_23194":42297,"_2329":42329},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout.",{"_2802":805,"_24443":789,"_17120":42331,"_5":17015,"_23194":42297,"_2329":42332},[],"Example body:",{"_2802":806,"_24443":789,"_17120":42334,"_5":17015,"_23194":42297,"_2329":42335},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2802":807,"_24443":789,"_17120":42337,"_5":17015,"_23194":42297,"_2329":42338},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2802":808,"_24443":789,"_17120":42340,"_5":17015,"_23194":42297,"_2329":42341},[],"Continuation requires a successful HTTP response and JSON:",{"_2802":809,"_24443":789,"_17120":42343,"_5":17015,"_23194":42297,"_2329":42344},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2802":810,"_24443":789,"_17120":42346,"_5":17015,"_23194":42301,"_2329":42347},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2802":811,"_24443":789,"_17120":42349,"_5":17015,"_23194":42301,"_2329":42350},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2802":812,"_24443":812,"_5":12033,"_2329":42352,"_24778":42353,"_17120":42354,"_23194":812},"Configure and operate the DMS",[39822,41166,42097,42095,42278],[],{"_2802":813,"_24443":812,"_17120":42356,"_5":17015,"_23194":812,"_2329":42357},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2802":814,"_24443":812,"_5":24775,"_17120":42359,"_23194":42360,"_2329":39832},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2802":815,"_24443":812,"_5":24775,"_17120":42362,"_23194":42363,"_2329":42364},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2802":816,"_24443":812,"_5":24775,"_17120":42366,"_23194":42367,"_2329":42368},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2802":817,"_24443":812,"_5":24775,"_17120":42370,"_23194":42371,"_2329":42372},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2802":818,"_24443":812,"_5":24775,"_17120":42374,"_23194":42375,"_2329":42376},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2802":819,"_24443":812,"_5":24775,"_17120":42378,"_23194":42379,"_2329":42380},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2802":820,"_24443":812,"_5":24775,"_17120":42382,"_23194":42383,"_2329":42384},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2802":821,"_24443":812,"_5":24775,"_17120":42386,"_23194":42387,"_2329":42388},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2802":822,"_24443":812,"_5":24775,"_17120":42390,"_23194":42391,"_2329":42392},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2802":823,"_24443":812,"_5":24775,"_17120":42394,"_23194":42395,"_2329":42396},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2802":824,"_24443":812,"_5":24775,"_17120":42398,"_23194":42399,"_2329":42400},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2802":825,"_24443":812,"_5":24775,"_17120":42402,"_23194":42403,"_2329":42404},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2802":826,"_24443":812,"_5":24775,"_17120":42406,"_23194":42407,"_2329":42408},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2802":827,"_24443":812,"_5":24775,"_17120":42410,"_23194":42411,"_2329":42412},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2802":828,"_24443":812,"_5":24775,"_17120":42414,"_23194":42415,"_2329":42416},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2802":829,"_24443":812,"_5":24775,"_17120":42418,"_23194":42419,"_2329":42420},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2802":830,"_24443":812,"_5":24775,"_17120":42422,"_23194":42423,"_2329":42424},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2802":831,"_24443":812,"_17120":42426,"_5":17015,"_23194":812,"_2329":42427},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2802":832,"_24443":812,"_17120":42429,"_5":17015,"_23194":42360,"_2329":42430},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2802":833,"_24443":812,"_17120":42432,"_5":17015,"_23194":42360,"_2329":42433},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2802":834,"_24443":812,"_17120":42435,"_5":17015,"_23194":42367,"_2329":42436},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2802":835,"_24443":812,"_17120":42438,"_5":17015,"_23194":42371,"_2329":42439},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2802":836,"_24443":812,"_17120":42441,"_5":17015,"_23194":42375,"_2329":42442},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2802":837,"_24443":812,"_17120":42444,"_5":17015,"_23194":42379,"_2329":42445},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2802":838,"_24443":812,"_17120":42447,"_5":17015,"_23194":42383,"_2329":42448},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2802":839,"_24443":812,"_17120":42450,"_5":17015,"_23194":42391,"_2329":42451},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2802":840,"_24443":812,"_17120":42453,"_5":17015,"_23194":42391,"_2329":42454},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2802":841,"_24443":812,"_17120":42456,"_5":17015,"_23194":42395,"_2329":42457},[],"`settings.enrollment_settings` field",{"_2802":842,"_24443":812,"_17120":42459,"_5":17015,"_23194":42395,"_2329":42460},[],"Decision",{"_2802":843,"_24443":812,"_17120":42462,"_5":17015,"_23194":42395,"_2329":42463},[],"`protocol`",{"_2802":844,"_24443":812,"_17120":42465,"_5":17015,"_23194":42395,"_2329":42466},[],"`EST_RFC7030` for these operations.",{"_2802":845,"_24443":812,"_17120":42468,"_5":17015,"_23194":42395,"_2329":42469},[],"`enrollment_ca`",{"_2802":846,"_24443":812,"_17120":42471,"_5":17015,"_23194":42395,"_2329":42472},[],"ID of the signing CA.",{"_2802":847,"_24443":812,"_17120":42474,"_5":17015,"_23194":42395,"_2329":42475},[],"`verify_csr_signature`",{"_2802":848,"_24443":812,"_17120":42477,"_5":17015,"_23194":42395,"_2329":42478},[],"Keep `true` to verify CSR key possession.",{"_2802":849,"_24443":812,"_17120":42480,"_5":17015,"_23194":42395,"_2329":42481},[],"`enable_replaceable_enrollment`",{"_2802":850,"_24443":812,"_17120":42483,"_5":17015,"_23194":42395,"_2329":42484},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2802":851,"_24443":812,"_17120":42486,"_5":17015,"_23194":42395,"_2329":42487},[],"`est_rfc7030_settings.auth_mode`",{"_2802":852,"_24443":812,"_17120":42489,"_5":17015,"_23194":42395,"_2329":42490},[],"One of the four authentication modes.",{"_2802":853,"_24443":812,"_17120":42492,"_5":17015,"_23194":42395,"_2329":42493},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2802":854,"_24443":812,"_17120":42495,"_5":17015,"_23194":42399,"_2329":42496},[],"The blocks are independent:",{"_2802":855,"_24443":812,"_17120":42498,"_5":17015,"_23194":42399,"_2329":42499},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2802":856,"_24443":812,"_17120":42501,"_5":17015,"_23194":42399,"_2329":42502},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2802":857,"_24443":812,"_17120":42504,"_5":17015,"_23194":42399,"_2329":42505},[],"`auth_mode`",{"_2802":858,"_24443":812,"_17120":42507,"_5":17015,"_23194":42399,"_2329":42508},[],"Control applied in the configured operation",{"_2802":859,"_24443":812,"_17120":42510,"_5":17015,"_23194":42399,"_2329":42511},[],"`CLIENT_CERTIFICATE`",{"_2802":860,"_24443":812,"_17120":42513,"_5":17015,"_23194":42399,"_2329":42514},[],"Presented certificate validation.",{"_2802":861,"_24443":812,"_17120":42516,"_5":17015,"_23194":42399,"_2329":42517},[],"`EXTERNAL_WEBHOOK`",{"_2802":862,"_24443":812,"_17120":42519,"_5":17015,"_23194":42399,"_2329":42520},[],"Configured webhook authorization.",{"_2802":863,"_24443":812,"_17120":42522,"_5":17015,"_23194":42399,"_2329":42523},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2802":864,"_24443":812,"_17120":42525,"_5":17015,"_23194":42399,"_2329":42526},[],"Certificate validation followed by webhook approval.",{"_2802":865,"_24443":812,"_17120":42528,"_5":17015,"_23194":42399,"_2329":42529},[],"`NO_AUTH`",{"_2802":866,"_24443":812,"_17120":42531,"_5":17015,"_23194":42399,"_2329":42532},[],"No DMS requester authentication.",{"_2802":867,"_24443":812,"_17120":42534,"_5":17015,"_23194":42399,"_2329":42535},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2802":868,"_24443":812,"_17120":42537,"_5":17015,"_23194":42399,"_2329":42538},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2802":869,"_24443":812,"_17120":42540,"_5":17015,"_23194":42399,"_2329":42541},[],"For certificate re-enrollment, the validator uses the enrollment CA, then `additional_validation_cas`, and `enable_expired_renewal`. Do not assume copying initial `validation_cas` changes those issuers.",{"_2802":870,"_24443":812,"_17120":42543,"_5":17015,"_23194":42399,"_2329":42544},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2802":871,"_24443":812,"_17120":42546,"_5":17015,"_23194":42399,"_2329":42547},[],"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks; if your version’s console does not expose independent settings, use the DMS API.",{"_2802":872,"_24443":812,"_17120":42549,"_5":17015,"_23194":42403,"_2329":42550},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2802":873,"_24443":812,"_17120":42552,"_5":17015,"_23194":42407,"_2329":42553},[],"`settings.reenrollment_settings` field",{"_2802":874,"_24443":812,"_17120":42555,"_5":17015,"_23194":42407,"_2329":40205},[],{"_2802":875,"_24443":812,"_17120":42557,"_5":17015,"_23194":42407,"_2329":42558},[],"`reenrollment_delta`",{"_2802":876,"_24443":812,"_17120":42560,"_5":17015,"_23194":42407,"_2329":42561},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2802":877,"_24443":812,"_17120":42563,"_5":17015,"_23194":42407,"_2329":42564},[],"`preventive_delta`",{"_2802":878,"_24443":812,"_17120":42566,"_5":17015,"_23194":42407,"_2329":42567},[],"Preventive operational monitoring threshold.",{"_2802":879,"_24443":812,"_17120":42569,"_5":17015,"_23194":42407,"_2329":42570},[],"`critical_delta`",{"_2802":880,"_24443":812,"_17120":42572,"_5":17015,"_23194":42407,"_2329":42573},[],"Critical operational monitoring threshold.",{"_2802":881,"_24443":812,"_17120":42575,"_5":17015,"_23194":42407,"_2329":42576},[],"`enable_expired_renewal`",{"_2802":882,"_24443":812,"_17120":42578,"_5":17015,"_23194":42407,"_2329":42579},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2802":883,"_24443":812,"_17120":42581,"_5":17015,"_23194":42407,"_2329":42582},[],"`additional_validation_cas`",{"_2802":884,"_24443":812,"_17120":42584,"_5":17015,"_23194":42407,"_2329":42585},[],"Additional mTLS credential issuers during migration.",{"_2802":885,"_24443":812,"_17120":42587,"_5":17015,"_23194":42407,"_2329":42588},[],"`revoke_on_reenrollment`",{"_2802":886,"_24443":812,"_17120":42590,"_5":17015,"_23194":42407,"_2329":42591},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2802":887,"_24443":812,"_17120":42593,"_5":17015,"_23194":42407,"_2329":42594},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2802":888,"_24443":812,"_17120":42596,"_5":17015,"_23194":42411,"_2329":42597},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2802":889,"_24443":812,"_17120":42599,"_5":17015,"_23194":42415,"_2329":40199},[],{"_2802":890,"_24443":812,"_17120":42601,"_5":17015,"_23194":42415,"_2329":42602},[],"Published material",{"_2802":891,"_24443":812,"_17120":42604,"_5":17015,"_23194":42415,"_2329":42605},[],"**Include Lamassu System CA**",{"_2802":892,"_24443":812,"_17120":42607,"_5":17015,"_23194":42415,"_2329":42608},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2802":893,"_24443":812,"_17120":42610,"_5":17015,"_23194":42415,"_2329":42611},[],"**Include Enrollment CA**",{"_2802":894,"_24443":812,"_17120":42613,"_5":17015,"_23194":42415,"_2329":42614},[],"Selected issuing CA certificate.",{"_2802":895,"_24443":812,"_17120":42616,"_5":17015,"_23194":42415,"_2329":42617},[],"**Managed CAs**",{"_2802":896,"_24443":812,"_17120":42619,"_5":17015,"_23194":42415,"_2329":42620},[],"Explicitly selected CA certificates.",{"_2802":897,"_24443":812,"_17120":42622,"_5":17015,"_23194":42415,"_2329":42623},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2802":898,"_24443":812,"_17120":42625,"_5":17015,"_23194":42419,"_2329":42626},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2802":899,"_24443":812,"_17120":42628,"_5":17015,"_23194":42419,"_2329":42629},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2802":900,"_24443":812,"_17120":42631,"_5":17015,"_23194":42419,"_2329":42632},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2802":901,"_24443":812,"_17120":42634,"_5":17015,"_23194":42423,"_2329":42635},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2802":902,"_24443":902,"_5":12033,"_2329":42637,"_24778":42638,"_17120":42639,"_23194":902},"Integrate the EST client",[39822,41166,42097,42095,42278],[],{"_2802":903,"_24443":902,"_17120":42641,"_5":17015,"_23194":902,"_2329":42642},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2802":904,"_24443":902,"_5":24775,"_17120":42644,"_23194":42645,"_2329":39832},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2802":905,"_24443":902,"_5":24775,"_17120":42647,"_23194":42648,"_2329":42649},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2802":906,"_24443":902,"_5":24775,"_17120":42651,"_23194":42652,"_2329":42653},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2802":907,"_24443":902,"_5":24775,"_17120":42655,"_23194":42656,"_2329":42657},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2802":908,"_24443":902,"_5":24775,"_17120":42659,"_23194":42660,"_2329":42661},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2802":909,"_24443":902,"_5":24775,"_17120":42663,"_23194":42664,"_2329":42665},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2802":910,"_24443":902,"_17120":42667,"_5":17015,"_23194":902,"_2329":42668},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2802":911,"_24443":902,"_17120":42670,"_5":17015,"_23194":42645,"_2329":42671},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2802":912,"_24443":902,"_17120":42673,"_5":17015,"_23194":42645,"_2329":42674},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2802":913,"_24443":902,"_17120":42676,"_5":17015,"_23194":42645,"_2329":42677},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2802":914,"_24443":902,"_17120":42679,"_5":17015,"_23194":42648,"_2329":42680},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2802":915,"_24443":902,"_17120":42682,"_5":17015,"_23194":42648,"_2329":42683},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2802":916,"_24443":902,"_17120":42685,"_5":17015,"_23194":42652,"_2329":42686},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2802":917,"_24443":902,"_17120":42688,"_5":17015,"_23194":42652,"_2329":42689},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2802":918,"_24443":902,"_17120":42691,"_5":17015,"_23194":42656,"_2329":42692},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2802":919,"_24443":902,"_17120":42694,"_5":17015,"_23194":42656,"_2329":42695},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2802":920,"_24443":902,"_17120":42697,"_5":17015,"_23194":42660,"_2329":42698},[],"For a root that issues directly:",{"_2802":921,"_24443":902,"_17120":42700,"_5":17015,"_23194":42660,"_2329":42701},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2802":922,"_24443":902,"_17120":42703,"_5":17015,"_23194":42660,"_2329":42704},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2802":923,"_24443":902,"_17120":42706,"_5":17015,"_23194":42664,"_2329":42707},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2802":924,"_24443":924,"_5":12033,"_2329":42709,"_24778":42710,"_17120":42711,"_23194":924},"EST reference",[39822,41166,42097,42095,42278],[],{"_2802":925,"_24443":924,"_17120":42713,"_5":17015,"_23194":924,"_2329":42714},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2802":926,"_24443":924,"_5":24775,"_17120":42716,"_23194":42717,"_2329":42718},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2802":927,"_24443":924,"_5":24775,"_17120":42720,"_23194":42721,"_2329":18580},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2802":928,"_24443":924,"_5":24775,"_17120":42723,"_23194":42724,"_2329":21287},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2802":929,"_24443":924,"_5":24775,"_17120":42726,"_23194":42727,"_2329":21294},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2802":930,"_24443":924,"_5":24775,"_17120":42729,"_23194":42730,"_2329":20663},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2802":931,"_24443":924,"_5":24775,"_17120":42732,"_23194":42733,"_2329":42734},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2802":932,"_24443":924,"_5":24775,"_17120":42736,"_23194":42737,"_2329":42738},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2802":933,"_24443":924,"_5":24775,"_17120":42740,"_23194":42741,"_2329":42742},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2802":934,"_24443":924,"_17120":42744,"_5":17015,"_23194":924,"_2329":42745},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2802":935,"_24443":924,"_17120":42747,"_5":17015,"_23194":42717,"_2329":42748},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2802":936,"_24443":924,"_17120":42750,"_5":17015,"_23194":42717,"_2329":42751},[],"Operation",{"_2802":937,"_24443":924,"_17120":42753,"_5":17015,"_23194":42717,"_2329":42754},[],"Method",{"_2802":938,"_24443":924,"_17120":42756,"_5":17015,"_23194":42717,"_2329":42757},[],"Authentication and condition",{"_2802":939,"_24443":924,"_17120":42759,"_5":17015,"_23194":42717,"_2329":42760},[],"`/cacerts`",{"_2802":940,"_24443":924,"_17120":42762,"_5":17015,"_23194":42717,"_2329":42763},[],"GET",{"_2802":941,"_24443":924,"_17120":42765,"_5":17015,"_23194":42717,"_2329":42766},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2802":942,"_24443":924,"_17120":42768,"_5":17015,"_23194":42717,"_2329":42769},[],"`/simpleenroll`",{"_2802":943,"_24443":924,"_17120":42771,"_5":17015,"_23194":42717,"_2329":42772},[],"POST",{"_2802":944,"_24443":924,"_17120":42774,"_5":17015,"_23194":42717,"_2329":42775},[],"Initial authentication and DMS registration/replacement policy.",{"_2802":945,"_24443":924,"_17120":42777,"_5":17015,"_23194":42717,"_2329":42778},[],"`/simplereenroll`",{"_2802":946,"_24443":924,"_17120":42780,"_5":17015,"_23194":42717,"_2329":42772},[],{"_2802":947,"_24443":924,"_17120":42782,"_5":17015,"_23194":42717,"_2329":42783},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2802":948,"_24443":924,"_17120":42785,"_5":17015,"_23194":42717,"_2329":42786},[],"`/serverkeygen`",{"_2802":949,"_24443":924,"_17120":42788,"_5":17015,"_23194":42717,"_2329":42772},[],{"_2802":950,"_24443":924,"_17120":42790,"_5":17015,"_23194":42717,"_2329":42791},[],"Initial authentication and admission; server generation enabled.",{"_2802":951,"_24443":924,"_17120":42793,"_5":17015,"_23194":42717,"_2329":42794},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2802":952,"_24443":924,"_17120":42796,"_5":17015,"_23194":42721,"_2329":42797},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2802":953,"_24443":924,"_17120":42799,"_5":17015,"_23194":42721,"_2329":42800},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2802":954,"_24443":924,"_17120":42802,"_5":17015,"_23194":42724,"_2329":42803},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2802":955,"_24443":924,"_17120":42805,"_5":17015,"_23194":42724,"_2329":42806},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2802":956,"_24443":924,"_17120":42808,"_5":17015,"_23194":42727,"_2329":42809},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2802":957,"_24443":924,"_17120":42811,"_5":17015,"_23194":42727,"_2329":42812},[],"The enrollment CA or an additional CA validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2802":958,"_24443":924,"_17120":42814,"_5":17015,"_23194":42730,"_2329":42815},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2802":959,"_24443":924,"_17120":42817,"_5":17015,"_23194":42730,"_2329":42818},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2802":960,"_24443":924,"_17120":42820,"_5":17015,"_23194":42733,"_2329":42821},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2802":961,"_24443":924,"_17120":42823,"_5":17015,"_23194":42733,"_2329":42824},[],"Part",{"_2802":962,"_24443":924,"_17120":42826,"_5":17015,"_23194":42733,"_2329":42827},[],"Content after decoding its Base64",{"_2802":963,"_24443":924,"_17120":42829,"_5":17015,"_23194":42733,"_2329":42830},[],"`application/pkcs8`",{"_2802":964,"_24443":924,"_17120":42832,"_5":17015,"_23194":42733,"_2329":42833},[],"Unencrypted DER PKCS#8 private key.",{"_2802":965,"_24443":924,"_17120":42835,"_5":17015,"_23194":42733,"_2329":42836},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2802":966,"_24443":924,"_17120":42838,"_5":17015,"_23194":42733,"_2329":42839},[],"DER PKCS#7 containing the issued certificate.",{"_2802":967,"_24443":924,"_17120":42841,"_5":17015,"_23194":42733,"_2329":42842},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2802":968,"_24443":924,"_17120":42844,"_5":17015,"_23194":42737,"_2329":42845},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2802":969,"_24443":924,"_17120":42847,"_5":17015,"_23194":42737,"_2329":42848},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2802":970,"_24443":924,"_17120":42850,"_5":17015,"_23194":42737,"_2329":42851},[],"Convert and check the result:",{"_2802":971,"_24443":924,"_17120":42853,"_5":17015,"_23194":42737,"_2329":42854},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2802":972,"_24443":924,"_17120":42856,"_5":17015,"_23194":42741,"_2329":42857},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2802":973,"_24443":924,"_17120":42859,"_5":17015,"_23194":42741,"_2329":42860},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2802":974,"_24443":974,"_5":12033,"_2329":42278,"_24778":42862,"_17120":42863,"_23194":974},[39822,41166,42097,42095,42278],[],{"_2802":975,"_24443":974,"_17120":42865,"_5":17015,"_23194":974,"_2329":42866},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2802":976,"_24443":974,"_5":24775,"_17120":42868,"_23194":42869,"_2329":42870},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2802":977,"_24443":974,"_5":24775,"_17120":42872,"_23194":42873,"_2329":42874},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2802":978,"_24443":974,"_5":24775,"_17120":42876,"_23194":42877,"_2329":42878},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2802":979,"_24443":974,"_5":24775,"_17120":42880,"_23194":42881,"_2329":42882},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2802":980,"_24443":974,"_17120":42884,"_5":17015,"_23194":974,"_2329":42885},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2802":981,"_24443":974,"_17120":42887,"_5":17015,"_23194":42869,"_2329":42888},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2802":982,"_24443":974,"_17120":42890,"_5":17015,"_23194":42869,"_2329":42891},[],"The integrator installs initial EST server trust and an admission credential.",{"_2802":983,"_24443":974,"_17120":42893,"_5":17015,"_23194":42869,"_2329":42894},[],"The client requests an identity for its `Device ID` through EST.",{"_2802":984,"_24443":974,"_17120":42896,"_5":17015,"_23194":42869,"_2329":42897},[],"Certificate, device binding and key/certificate installation are checked.",{"_2802":985,"_24443":974,"_17120":42899,"_5":17015,"_23194":42869,"_2329":42900},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2802":986,"_24443":974,"_17120":42902,"_5":17015,"_23194":42869,"_2329":42903},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2802":987,"_24443":974,"_17120":42905,"_5":17015,"_23194":42873,"_2329":42906},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2802":988,"_24443":974,"_17120":42908,"_5":17015,"_23194":42873,"_2329":42909},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2802":989,"_24443":974,"_17120":42911,"_5":17015,"_23194":42873,"_2329":42912},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2802":990,"_24443":974,"_17120":42914,"_5":17015,"_23194":42873,"_2329":42915},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2802":991,"_24443":974,"_17120":42917,"_5":17015,"_23194":42877,"_2329":42918},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2802":992,"_24443":974,"_17120":42920,"_5":17015,"_23194":42877,"_2329":42921},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2802":993,"_24443":974,"_17120":42923,"_5":17015,"_23194":42877,"_2329":42924},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2802":994,"_24443":974,"_17120":42926,"_5":17015,"_23194":42877,"_2329":42927},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2802":995,"_24443":974,"_17120":42929,"_5":17015,"_23194":42881,"_2329":42930},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract and migrations, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2802":996,"_24443":974,"_17120":42932,"_5":17015,"_23194":42881,"_2329":42933},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2802":997,"_24443":997,"_5":12033,"_2329":42935,"_24778":42936,"_17120":42937,"_23194":997},"Provisioning strategies",[39822,41166,42097,42095,42278],[],{"_2802":998,"_24443":997,"_17120":42939,"_5":17015,"_23194":997,"_2329":42940},[],"Choose device registration, identity authorization and key generation.",{"_2802":999,"_24443":997,"_5":24775,"_17120":42942,"_23194":42943,"_2329":42944},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2802":1000,"_24443":997,"_5":24775,"_17120":42946,"_23194":42947,"_2329":42948},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2802":1001,"_24443":997,"_5":24775,"_17120":42950,"_23194":42951,"_2329":42952},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2802":1002,"_24443":997,"_5":24775,"_17120":42954,"_23194":42955,"_2329":42956},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2802":1003,"_24443":997,"_5":24775,"_17120":42958,"_23194":42959,"_2329":42960},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2802":1004,"_24443":997,"_17120":42962,"_5":17015,"_23194":997,"_2329":42963},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2802":1005,"_24443":997,"_17120":42965,"_5":17015,"_23194":42943,"_2329":42966},[],"Path",{"_2802":1006,"_24443":997,"_17120":42968,"_5":17015,"_23194":42943,"_2329":42969},[],"When the device exists",{"_2802":1007,"_24443":997,"_17120":42971,"_5":17015,"_23194":42943,"_2329":42972},[],"What to check",{"_2802":1008,"_24443":997,"_17120":42974,"_5":17015,"_23194":42943,"_2329":42975},[],"Manual assignment",{"_2802":1009,"_24443":997,"_17120":42977,"_5":17015,"_23194":42943,"_2329":42978},[],"An operator creates it before associating a certificate.",{"_2802":1010,"_24443":997,"_17120":42980,"_5":17015,"_23194":42943,"_2329":42981},[],"ID, owning DMS, certificate CN and bound serial.",{"_2802":1011,"_24443":997,"_17120":42983,"_5":17015,"_23194":42943,"_2329":42984},[],"EST with `JITP`",{"_2802":1012,"_24443":997,"_17120":42986,"_5":17015,"_23194":42943,"_2329":42987},[],"Created for an unknown CN during `/simpleenroll`.",{"_2802":1013,"_24443":997,"_17120":42989,"_5":17015,"_23194":42943,"_2329":42990},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2802":1014,"_24443":997,"_17120":42992,"_5":17015,"_23194":42943,"_2329":42993},[],"EST with `PRE_REGISTRATION`",{"_2802":1015,"_24443":997,"_17120":42995,"_5":17015,"_23194":42943,"_2329":42996},[],"Must exist before `/simpleenroll`.",{"_2802":1016,"_24443":997,"_17120":42998,"_5":17015,"_23194":42943,"_2329":42999},[],"Approved record, same DMS and replacement conditions for your version.",{"_2802":1017,"_24443":997,"_17120":43001,"_5":17015,"_23194":42943,"_2329":43002},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2802":1018,"_24443":997,"_17120":43004,"_5":17015,"_23194":42943,"_2329":43005},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2802":1019,"_24443":997,"_17120":43007,"_5":17015,"_23194":42947,"_2329":43008},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2802":1020,"_24443":997,"_17120":43010,"_5":17015,"_23194":42947,"_2329":43011},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2802":1021,"_24443":997,"_17120":43013,"_5":17015,"_23194":42947,"_2329":43014},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2802":1022,"_24443":997,"_17120":43016,"_5":17015,"_23194":42951,"_2329":43017},[],"Decide initial enrollment and re-enrollment separately:",{"_2802":1023,"_24443":997,"_17120":43019,"_5":17015,"_23194":42951,"_2329":43020},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2802":1024,"_24443":997,"_17120":43022,"_5":17015,"_23194":42951,"_2329":43023},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2802":1025,"_24443":997,"_17120":43025,"_5":17015,"_23194":42951,"_2329":43026},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2802":1026,"_24443":997,"_17120":43028,"_5":17015,"_23194":42951,"_2329":43029},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2802":1027,"_24443":997,"_17120":43031,"_5":17015,"_23194":42951,"_2329":43032},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2802":1028,"_24443":997,"_17120":43034,"_5":17015,"_23194":42955,"_2329":40199},[],{"_2802":1029,"_24443":997,"_17120":43036,"_5":17015,"_23194":42955,"_2329":43037},[],"Material crossing EST",{"_2802":1030,"_24443":997,"_17120":43039,"_5":17015,"_23194":42955,"_2329":43040},[],"Device-generated key",{"_2802":1031,"_24443":997,"_17120":43042,"_5":17015,"_23194":42955,"_2329":43043},[],"Public CSR and certificate; the key stays on the client.",{"_2802":1032,"_24443":997,"_17120":43045,"_5":17015,"_23194":42955,"_2329":43046},[],"Existing device key",{"_2802":1033,"_24443":997,"_17120":43048,"_5":17015,"_23194":42955,"_2329":43049},[],"CSR signed with that key and a new certificate.",{"_2802":1034,"_24443":997,"_17120":43051,"_5":17015,"_23194":42955,"_2329":42412},[],{"_2802":1035,"_24443":997,"_17120":43053,"_5":17015,"_23194":42955,"_2329":43054},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2802":1036,"_24443":997,"_17120":43056,"_5":17015,"_23194":42955,"_2329":43057},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2802":1037,"_24443":997,"_17120":43059,"_5":17015,"_23194":42959,"_2329":43060},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2802":1038,"_24443":1038,"_5":12033,"_2329":43062,"_24778":43063,"_17120":43064,"_23194":1038},"Renewal and recovery",[39822,41166,42097,42095,42278],[],{"_2802":1039,"_24443":1038,"_17120":43066,"_5":17015,"_23194":1038,"_2329":43067},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2802":1040,"_24443":1038,"_5":24775,"_17120":43069,"_23194":43070,"_2329":43071},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2802":1041,"_24443":1038,"_5":24775,"_17120":43073,"_23194":43074,"_2329":43075},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2802":1042,"_24443":1038,"_5":24775,"_17120":43077,"_23194":43078,"_2329":43079},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2802":1043,"_24443":1038,"_5":24775,"_17120":43081,"_23194":43082,"_2329":43083},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2802":1044,"_24443":1038,"_5":24775,"_17120":43085,"_23194":43086,"_2329":43087},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2802":1045,"_24443":1038,"_17120":43089,"_5":17015,"_23194":1038,"_2329":43090},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2802":1046,"_24443":1038,"_17120":43092,"_5":17015,"_23194":43070,"_2329":43093},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2802":1047,"_24443":1038,"_17120":43095,"_5":17015,"_23194":43070,"_2329":43096},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2802":1048,"_24443":1038,"_17120":43098,"_5":17015,"_23194":43070,"_2329":43099},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2802":1049,"_24443":1038,"_17120":43101,"_5":17015,"_23194":43070,"_2329":43102},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2802":1050,"_24443":1038,"_17120":43104,"_5":17015,"_23194":43074,"_2329":43105},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2802":1051,"_24443":1038,"_17120":43107,"_5":17015,"_23194":43074,"_2329":43108},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2802":1052,"_24443":1038,"_17120":43110,"_5":17015,"_23194":43078,"_2329":43111},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2802":1053,"_24443":1038,"_17120":43113,"_5":17015,"_23194":43078,"_2329":43114},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2802":1054,"_24443":1038,"_17120":43116,"_5":17015,"_23194":43078,"_2329":43117},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2802":1055,"_24443":1038,"_17120":43119,"_5":17015,"_23194":43082,"_2329":43120},[],"Situation",{"_2802":1056,"_24443":1038,"_17120":43122,"_5":17015,"_23194":43082,"_2329":43123},[],"Procedure",{"_2802":1057,"_24443":1038,"_17120":43125,"_5":17015,"_23194":43082,"_2329":43126},[],"Valid certificate, outside the window",{"_2802":1058,"_24443":1038,"_17120":43128,"_5":17015,"_23194":43082,"_2329":43129},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2802":1059,"_24443":1038,"_17120":43131,"_5":17015,"_23194":43082,"_2329":43132},[],"Expired certificate, key available",{"_2802":1060,"_24443":1038,"_17120":43134,"_5":17015,"_23194":43082,"_2329":43135},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2802":1061,"_24443":1038,"_17120":43137,"_5":17015,"_23194":43082,"_2329":43138},[],"Renewal through webhook or `NO_AUTH`",{"_2802":1062,"_24443":1038,"_17120":43140,"_5":17015,"_23194":43082,"_2329":43141},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2802":1063,"_24443":1038,"_17120":43143,"_5":17015,"_23194":43082,"_2329":43144},[],"Lost or inaccessible key",{"_2802":1064,"_24443":1038,"_17120":43146,"_5":17015,"_23194":43082,"_2329":43147},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2802":1065,"_24443":1038,"_17120":43149,"_5":17015,"_23194":43082,"_2329":43150},[],"Current identity revoked",{"_2802":1066,"_24443":1038,"_17120":43152,"_5":17015,"_23194":43082,"_2329":43153},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2802":1067,"_24443":1038,"_17120":43155,"_5":17015,"_23194":43082,"_2329":43156},[],"Device without an identity",{"_2802":1068,"_24443":1038,"_17120":43158,"_5":17015,"_23194":43082,"_2329":43159},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2802":1069,"_24443":1038,"_17120":43161,"_5":17015,"_23194":43082,"_2329":43162},[],"Retired device",{"_2802":1070,"_24443":1038,"_17120":43164,"_5":17015,"_23194":43082,"_2329":43165},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2802":1071,"_24443":1038,"_17120":43167,"_5":17015,"_23194":43082,"_2329":43168},[],"Timeout, HTTP 500 or installation failure",{"_2802":1072,"_24443":1038,"_17120":43170,"_5":17015,"_23194":43082,"_2329":43171},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2802":1073,"_24443":1038,"_17120":43173,"_5":17015,"_23194":43086,"_2329":43174},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2802":1074,"_24443":1038,"_17120":43176,"_5":17015,"_23194":43086,"_2329":43177},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2802":1075,"_24443":1075,"_5":12033,"_2329":43179,"_24778":43180,"_17120":43181,"_23194":1075},"Enrollment troubleshooting",[39822,41166,42097,42095,42278],[],{"_2802":1076,"_24443":1075,"_17120":43183,"_5":17015,"_23194":1075,"_2329":43184},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2802":1077,"_24443":1075,"_5":24775,"_17120":43186,"_23194":43187,"_2329":43188},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2802":1078,"_24443":1075,"_5":24775,"_17120":43190,"_23194":43191,"_2329":43192},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2802":1079,"_24443":1075,"_5":24775,"_17120":43194,"_23194":43195,"_2329":42742},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2802":1080,"_24443":1075,"_5":24775,"_17120":43197,"_23194":43198,"_2329":43199},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2802":1081,"_24443":1075,"_17120":43201,"_5":17015,"_23194":1075,"_2329":43202},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2802":1082,"_24443":1075,"_17120":43204,"_5":17015,"_23194":43191,"_2329":43205},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2802":1083,"_24443":1075,"_17120":43207,"_5":17015,"_23194":43191,"_2329":43208},[],"Symptom or message",{"_2802":1084,"_24443":1075,"_17120":43210,"_5":17015,"_23194":43191,"_2329":42972},[],{"_2802":1085,"_24443":1075,"_17120":43212,"_5":17015,"_23194":43191,"_2329":43213},[],"curl rejects TLS, name or issuer",{"_2802":1086,"_24443":1075,"_17120":43215,"_5":17015,"_23194":43191,"_2329":43216},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2802":1087,"_24443":1075,"_17120":43218,"_5":17015,"_23194":43191,"_2329":43219},[],"404 or missing APS",{"_2802":1088,"_24443":1075,"_17120":43221,"_5":17015,"_23194":43191,"_2329":43222},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2802":1089,"_24443":1075,"_17120":43224,"_5":17015,"_23194":43191,"_2329":43225},[],"400, CSR or format error",{"_2802":1090,"_24443":1075,"_17120":43227,"_5":17015,"_23194":43191,"_2329":43228},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2802":1091,"_24443":1075,"_17120":43230,"_5":17015,"_23194":43191,"_2329":43231},[],"Missing credential or invalid certificate",{"_2802":1092,"_24443":1075,"_17120":43233,"_5":17015,"_23194":43191,"_2329":43234},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2802":1093,"_24443":1075,"_17120":43236,"_5":17015,"_23194":43191,"_2329":43237},[],"Webhook denies, times out or responds without authorization",{"_2802":1094,"_24443":1075,"_17120":43239,"_5":17015,"_23194":43191,"_2329":43240},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2802":1095,"_24443":1075,"_17120":43242,"_5":17015,"_23194":43191,"_2329":43243},[],"`device not preregistered`",{"_2802":1096,"_24443":1075,"_17120":43245,"_5":17015,"_23194":43191,"_2329":43246},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2802":1097,"_24443":1075,"_17120":43248,"_5":17015,"_23194":43191,"_2329":43249},[],"`forbiddenNewEnrollment`",{"_2802":1098,"_24443":1075,"_17120":43251,"_5":17015,"_23194":43191,"_2329":43252},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2802":1099,"_24443":1075,"_17120":43254,"_5":17015,"_23194":43191,"_2329":43255},[],"Different owning DMS",{"_2802":1100,"_24443":1075,"_17120":43257,"_5":17015,"_23194":43191,"_2329":43258},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2802":1101,"_24443":1075,"_17120":43260,"_5":17015,"_23194":43191,"_2329":43261},[],"`invalid RawSubject bytes`",{"_2802":1102,"_24443":1075,"_17120":43263,"_5":17015,"_23194":43191,"_2329":43264},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2802":1103,"_24443":1075,"_17120":43266,"_5":17015,"_23194":43191,"_2329":43267},[],"`invalid reenroll window`",{"_2802":1104,"_24443":1075,"_17120":43269,"_5":17015,"_23194":43191,"_2329":43270},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2802":1105,"_24443":1075,"_17120":43272,"_5":17015,"_23194":43191,"_2329":43273},[],"Current certificate revoked",{"_2802":1106,"_24443":1075,"_17120":43275,"_5":17015,"_23194":43191,"_2329":43276},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2802":1107,"_24443":1075,"_17120":43278,"_5":17015,"_23194":43191,"_2329":43279},[],"CA, profile or signing error",{"_2802":1108,"_24443":1075,"_17120":43281,"_5":17015,"_23194":43191,"_2329":43282},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2802":1109,"_24443":1075,"_17120":43284,"_5":17015,"_23194":43191,"_2329":43285},[],"HTTP 200 without a device connection",{"_2802":1110,"_24443":1075,"_17120":43287,"_5":17015,"_23194":43191,"_2329":43288},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2802":1111,"_24443":1075,"_17120":43290,"_5":17015,"_23194":43191,"_2329":43291},[],"Timeout or error after issuance",{"_2802":1112,"_24443":1075,"_17120":43293,"_5":17015,"_23194":43191,"_2329":43294},[],"New certificates, current slot and previous identity's state before retrying.",{"_2802":1113,"_24443":1075,"_17120":43296,"_5":17015,"_23194":43195,"_2329":43297},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode after migration and Gateway behavior with expired certificates and the bootstrap CA.",{"_2802":1114,"_24443":1075,"_17120":43299,"_5":17015,"_23194":43195,"_2329":43300},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2802":1115,"_24443":1075,"_17120":43302,"_5":17015,"_23194":43198,"_2329":43303},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2802":1116,"_24443":1075,"_17120":43305,"_5":17015,"_23194":43198,"_2329":43306},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2802":1117,"_24443":1075,"_17120":43308,"_5":17015,"_23194":43198,"_2329":43309},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2802":1118,"_24443":1075,"_17120":43311,"_5":17015,"_23194":43198,"_2329":43312},[],"Make one request, save headers/body and query the device and certificates.",{"_2802":1119,"_24443":1075,"_17120":43314,"_5":17015,"_23194":43198,"_2329":43315},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2802":1120,"_24443":1075,"_17120":43317,"_5":17015,"_23194":43198,"_2329":43318},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2802":1121,"_24443":1075,"_17120":43320,"_5":17015,"_23194":43198,"_2329":43321},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2802":1122,"_24443":1122,"_5":12033,"_2329":43323,"_24778":43324,"_17120":43325,"_23194":1122},"Trust distribution and updates",[39822,41166,42097,42095,42278],[],{"_2802":1123,"_24443":1122,"_17120":43327,"_5":17015,"_23194":1122,"_2329":43328},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2802":1124,"_24443":1122,"_5":24775,"_17120":43330,"_23194":43331,"_2329":43332},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2802":1125,"_24443":1122,"_5":24775,"_17120":43334,"_23194":43335,"_2329":43336},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2802":1126,"_24443":1122,"_5":24775,"_17120":43338,"_23194":43339,"_2329":43340},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2802":1127,"_24443":1122,"_5":24775,"_17120":43342,"_23194":43343,"_2329":43344},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2802":1128,"_24443":1122,"_5":24775,"_17120":43346,"_23194":43347,"_2329":43348},[],"/docs/pr-preview/pr-28/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2802":1129,"_24443":1122,"_17120":43350,"_5":17015,"_23194":1122,"_2329":43351},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2802":1130,"_24443":1122,"_17120":43353,"_5":17015,"_23194":43331,"_2329":43354},[],"Relationship",{"_2802":1131,"_24443":1122,"_17120":43356,"_5":17015,"_23194":43331,"_2329":43357},[],"Material prepared by its owner",{"_2802":1132,"_24443":1122,"_17120":43359,"_5":17015,"_23194":43331,"_2329":43360},[],"Device → EST server",{"_2802":1133,"_24443":1122,"_17120":43362,"_5":17015,"_23194":43331,"_2329":43363},[],"Previously verified server root, chain or pin and TLS name.",{"_2802":1134,"_24443":1122,"_17120":43365,"_5":17015,"_23194":43331,"_2329":43366},[],"DMS → requester",{"_2802":1135,"_24443":1122,"_17120":43368,"_5":17015,"_23194":43331,"_2329":43369},[],"CAs and rules authorizing initial or renewal credentials.",{"_2802":1136,"_24443":1122,"_17120":43371,"_5":17015,"_23194":43331,"_2329":43372},[],"Consumer → device",{"_2802":1137,"_24443":1122,"_17120":43374,"_5":17015,"_23194":43331,"_2329":43375},[],"Operational identity roots, intermediates, validation and permissions.",{"_2802":1138,"_24443":1122,"_17120":43377,"_5":17015,"_23194":43331,"_2329":43378},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2802":1139,"_24443":1122,"_17120":43380,"_5":17015,"_23194":43335,"_2329":43381},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2802":1140,"_24443":1122,"_17120":43383,"_5":17015,"_23194":43335,"_2329":43384},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2802":1141,"_24443":1122,"_17120":43386,"_5":17015,"_23194":43339,"_2329":43387},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2802":1142,"_24443":1122,"_17120":43389,"_5":17015,"_23194":43339,"_2329":43390},[],"Select policy-approved roots as anchors.",{"_2802":1143,"_24443":1122,"_17120":43392,"_5":17015,"_23194":43339,"_2329":43393},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2802":1144,"_24443":1122,"_17120":43395,"_5":17015,"_23194":43339,"_2329":43396},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2802":1145,"_24443":1122,"_17120":43398,"_5":17015,"_23194":43339,"_2329":43399},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2802":1146,"_24443":1122,"_17120":43401,"_5":17015,"_23194":43339,"_2329":43402},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2802":1147,"_24443":1122,"_17120":43404,"_5":17015,"_23194":43343,"_2329":43405},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2802":1148,"_24443":1122,"_17120":43407,"_5":17015,"_23194":43343,"_2329":43408},[],"In the DMS, separate distributed CAs from `additional_validation_cas`, used for re-enrollment credentials. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2802":1149,"_24443":1122,"_17120":43410,"_5":17015,"_23194":43343,"_2329":43411},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2802":1150,"_24443":1122,"_17120":43413,"_5":17015,"_23194":43347,"_2329":43414},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2802":1151,"_24443":1151,"_5":12033,"_2329":43416,"_24778":43417,"_17120":43419,"_23194":1151},"AWS IoT Core",[39822,41166,42097,42095,43418],"Integrations",[],{"_2802":1152,"_24443":1151,"_17120":43421,"_5":17015,"_23194":1151,"_2329":43422},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2802":1153,"_24443":1151,"_5":24775,"_17120":43424,"_23194":43425,"_2329":43426},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2802":1154,"_24443":1151,"_5":24775,"_17120":43428,"_23194":43429,"_2329":43430},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2802":1155,"_24443":1151,"_5":24775,"_17120":43432,"_23194":43433,"_2329":43434},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2802":1156,"_24443":1151,"_5":24775,"_17120":43436,"_23194":43437,"_2329":43438},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2802":1157,"_24443":1151,"_5":24775,"_17120":43440,"_23194":43441,"_2329":43442},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2802":1158,"_24443":1151,"_5":24775,"_17120":43444,"_23194":43445,"_2329":43446},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2802":1159,"_24443":1151,"_5":24775,"_17120":43448,"_23194":43449,"_2329":43450},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2802":1160,"_24443":1151,"_5":24775,"_17120":43452,"_23194":43453,"_2329":43454},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2802":1161,"_24443":1151,"_5":24775,"_17120":43456,"_23194":43457,"_2329":43458},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2802":1162,"_24443":1151,"_5":24775,"_17120":43460,"_23194":43461,"_2329":43462},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2802":1163,"_24443":1151,"_5":24775,"_17120":43464,"_23194":43465,"_2329":43466},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2802":1164,"_24443":1151,"_5":24775,"_17120":43468,"_23194":43469,"_2329":43470},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2802":1165,"_24443":1151,"_5":24775,"_17120":43472,"_23194":43473,"_2329":43474},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2802":1166,"_24443":1151,"_5":24775,"_17120":43476,"_23194":43477,"_2329":43478},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2802":1167,"_24443":1151,"_5":24775,"_17120":43480,"_23194":43481,"_2329":43482},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2802":1168,"_24443":1151,"_5":24775,"_17120":43484,"_23194":43485,"_2329":43486},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2802":1169,"_24443":1151,"_5":24775,"_17120":43488,"_23194":43489,"_2329":43490},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2802":1170,"_24443":1151,"_5":24775,"_17120":43492,"_23194":43493,"_2329":43494},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2802":1171,"_24443":1151,"_5":24775,"_17120":43496,"_23194":43497,"_2329":43498},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2802":1172,"_24443":1151,"_5":24775,"_17120":43500,"_23194":43501,"_2329":43502},[],"/docs/pr-preview/pr-28/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2802":1173,"_24443":1151,"_17120":43504,"_5":17015,"_23194":1151,"_2329":43505},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2802":1174,"_24443":1151,"_17120":43507,"_5":17015,"_23194":1151,"_2329":43508},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2802":1175,"_24443":1151,"_17120":43510,"_5":17015,"_23194":1151,"_2329":43511},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2802":1176,"_24443":1151,"_17120":43513,"_5":17015,"_23194":43425,"_2329":43514},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2802":1177,"_24443":1151,"_17120":43516,"_5":17015,"_23194":43425,"_2329":43517},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2802":1178,"_24443":1151,"_17120":43519,"_5":17015,"_23194":43425,"_2329":43520},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2802":1179,"_24443":1151,"_17120":43522,"_5":17015,"_23194":43425,"_2329":43523},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2802":1180,"_24443":1151,"_17120":43525,"_5":17015,"_23194":43429,"_2329":43526},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2802":1181,"_24443":1151,"_17120":43528,"_5":17015,"_23194":43433,"_2329":43529},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2802":1182,"_24443":1151,"_17120":43531,"_5":17015,"_23194":43433,"_2329":43532},[],"IAM action",{"_2802":1183,"_24443":1151,"_17120":43534,"_5":17015,"_23194":43433,"_2329":40205},[],{"_2802":1184,"_24443":1151,"_17120":43536,"_5":17015,"_23194":43433,"_2329":43537},[],"`iot:GetRegistrationCode`",{"_2802":1185,"_24443":1151,"_17120":43539,"_5":17015,"_23194":43433,"_2329":43540},[],"Obtain the verification code for CA registration in the Primary Account",{"_2802":1186,"_24443":1151,"_17120":43542,"_5":17015,"_23194":43433,"_2329":43543},[],"`iot:RegisterCACertificate`",{"_2802":1187,"_24443":1151,"_17120":43545,"_5":17015,"_23194":43433,"_2329":43546},[],"Register the CA in AWS IoT",{"_2802":1188,"_24443":1151,"_17120":43548,"_5":17015,"_23194":43433,"_2329":43549},[],"`iot:DescribeCACertificate`",{"_2802":1189,"_24443":1151,"_17120":43551,"_5":17015,"_23194":43433,"_2329":43552},[],"Check the CA registration status",{"_2802":1190,"_24443":1151,"_17120":43554,"_5":17015,"_23194":43433,"_2329":43555},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2802":1191,"_24443":1151,"_17120":43557,"_5":17015,"_23194":43433,"_2329":43558},[],"Create or update Things in IoT Core",{"_2802":1192,"_24443":1151,"_17120":43560,"_5":17015,"_23194":43433,"_2329":43561},[],"`iot:RegisterThing`",{"_2802":1193,"_24443":1151,"_17120":43563,"_5":17015,"_23194":43433,"_2329":43564},[],"Provision Things through a template",{"_2802":1194,"_24443":1151,"_17120":43566,"_5":17015,"_23194":43433,"_2329":43567},[],"`iot:RegisterCertificate`",{"_2802":1195,"_24443":1151,"_17120":43569,"_5":17015,"_23194":43433,"_2329":43570},[],"Register device certificates",{"_2802":1196,"_24443":1151,"_17120":43572,"_5":17015,"_23194":43433,"_2329":43573},[],"`iot:UpdateCertificate`",{"_2802":1197,"_24443":1151,"_17120":43575,"_5":17015,"_23194":43433,"_2329":43576},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2802":1198,"_24443":1151,"_17120":43578,"_5":17015,"_23194":43433,"_2329":43579},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2802":1199,"_24443":1151,"_17120":43581,"_5":17015,"_23194":43433,"_2329":43582},[],"Create and attach IoT policies",{"_2802":1200,"_24443":1151,"_17120":43584,"_5":17015,"_23194":43433,"_2329":43585},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2802":1201,"_24443":1151,"_17120":43587,"_5":17015,"_23194":43433,"_2329":43588},[],"Manage Thing groups",{"_2802":1202,"_24443":1151,"_17120":43590,"_5":17015,"_23194":43433,"_2329":43591},[],"`iot:CreateProvisioningTemplate`",{"_2802":1203,"_24443":1151,"_17120":43593,"_5":17015,"_23194":43433,"_2329":43594},[],"Create JITP templates",{"_2802":1204,"_24443":1151,"_17120":43596,"_5":17015,"_23194":43433,"_2329":43597},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2802":1205,"_24443":1151,"_17120":43599,"_5":17015,"_23194":43433,"_2329":43600},[],"Read and write the Device Shadow",{"_2802":1206,"_24443":1151,"_17120":43602,"_5":17015,"_23194":43433,"_2329":43603},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2802":1207,"_24443":1151,"_17120":43605,"_5":17015,"_23194":43437,"_2329":43606},[],"Parameter",{"_2802":1208,"_24443":1151,"_17120":43608,"_5":17015,"_23194":43437,"_2329":43609},[],"Type",{"_2802":1209,"_24443":1151,"_17120":43611,"_5":17015,"_23194":43437,"_2329":43612},[],"Required",{"_2802":1210,"_24443":1151,"_17120":43614,"_5":17015,"_23194":43437,"_2329":43615},[],"Description",{"_2802":1211,"_24443":1151,"_17120":43617,"_5":17015,"_23194":43437,"_2329":43618},[],"`connector_id`",{"_2802":1212,"_24443":1151,"_17120":43620,"_5":17015,"_23194":43437,"_2329":20415},[],{"_2802":1213,"_24443":1151,"_17120":43622,"_5":17015,"_23194":43437,"_2329":43623},[],"Yes",{"_2802":1214,"_24443":1151,"_17120":43625,"_5":17015,"_23194":43437,"_2329":43626},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2802":1215,"_24443":1151,"_17120":43628,"_5":17015,"_23194":43437,"_2329":43629},[],"`aws_config.region`",{"_2802":1216,"_24443":1151,"_17120":43631,"_5":17015,"_23194":43437,"_2329":20415},[],{"_2802":1217,"_24443":1151,"_17120":43633,"_5":17015,"_23194":43437,"_2329":43623},[],{"_2802":1218,"_24443":1151,"_17120":43635,"_5":17015,"_23194":43437,"_2329":43636},[],"AWS region where the connector operates.",{"_2802":1219,"_24443":1151,"_17120":43638,"_5":17015,"_23194":43437,"_2329":43639},[],"`aws_config.auth_method`",{"_2802":1220,"_24443":1151,"_17120":43641,"_5":17015,"_23194":43437,"_2329":20415},[],{"_2802":1221,"_24443":1151,"_17120":43643,"_5":17015,"_23194":43437,"_2329":43623},[],{"_2802":1222,"_24443":1151,"_17120":43645,"_5":17015,"_23194":43437,"_2329":43646},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2802":1223,"_24443":1151,"_17120":43648,"_5":17015,"_23194":43437,"_2329":43649},[],"`aws_config.access_key_id`",{"_2802":1224,"_24443":1151,"_17120":43651,"_5":17015,"_23194":43437,"_2329":20415},[],{"_2802":1225,"_24443":1151,"_17120":43653,"_5":17015,"_23194":43437,"_2329":43654},[],"Only with `auth_method=static`",{"_2802":1226,"_24443":1151,"_17120":43656,"_5":17015,"_23194":43437,"_2329":43657},[],"AWS access key.",{"_2802":1227,"_24443":1151,"_17120":43659,"_5":17015,"_23194":43437,"_2329":43660},[],"`aws_config.secret_access_key`",{"_2802":1228,"_24443":1151,"_17120":43662,"_5":17015,"_23194":43437,"_2329":20415},[],{"_2802":1229,"_24443":1151,"_17120":43664,"_5":17015,"_23194":43437,"_2329":43654},[],{"_2802":1230,"_24443":1151,"_17120":43666,"_5":17015,"_23194":43437,"_2329":43667},[],"AWS secret key.",{"_2802":1231,"_24443":1151,"_17120":43669,"_5":17015,"_23194":43437,"_2329":43670},[],"`aws_config.session_token`",{"_2802":1232,"_24443":1151,"_17120":43672,"_5":17015,"_23194":43437,"_2329":20415},[],{"_2802":1233,"_24443":1151,"_17120":43674,"_5":17015,"_23194":43437,"_2329":43675},[],"No",{"_2802":1234,"_24443":1151,"_17120":43677,"_5":17015,"_23194":43437,"_2329":43678},[],"Session token (with `auth_method=static`).",{"_2802":1235,"_24443":1151,"_17120":43680,"_5":17015,"_23194":43437,"_2329":43681},[],"`aws_config.role_arn`",{"_2802":1236,"_24443":1151,"_17120":43683,"_5":17015,"_23194":43437,"_2329":20415},[],{"_2802":1237,"_24443":1151,"_17120":43685,"_5":17015,"_23194":43437,"_2329":43686},[],"Only with `auth_method=role`",{"_2802":1238,"_24443":1151,"_17120":43688,"_5":17015,"_23194":43437,"_2329":43689},[],"ARN of the role to assume.",{"_2802":1239,"_24443":1151,"_17120":43691,"_5":17015,"_23194":43437,"_2329":43692},[],"`aws_config.endpoint_url`",{"_2802":1240,"_24443":1151,"_17120":43694,"_5":17015,"_23194":43437,"_2329":20415},[],{"_2802":1241,"_24443":1151,"_17120":43696,"_5":17015,"_23194":43437,"_2329":43675},[],{"_2802":1242,"_24443":1151,"_17120":43698,"_5":17015,"_23194":43437,"_2329":43699},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2802":1243,"_24443":1151,"_17120":43701,"_5":17015,"_23194":43437,"_2329":43702},[],"`subscriber_event_bus`",{"_2802":1244,"_24443":1151,"_17120":43704,"_5":17015,"_23194":43437,"_2329":14397},[],{"_2802":1245,"_24443":1151,"_17120":43706,"_5":17015,"_23194":43437,"_2329":43623},[],{"_2802":1246,"_24443":1151,"_17120":43708,"_5":17015,"_23194":43437,"_2329":43709},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2802":1247,"_24443":1151,"_17120":43711,"_5":17015,"_23194":43437,"_2329":43712},[],"`dms_manager_client`",{"_2802":1248,"_24443":1151,"_17120":43714,"_5":17015,"_23194":43437,"_2329":20415},[],{"_2802":1249,"_24443":1151,"_17120":43716,"_5":17015,"_23194":43437,"_2329":43623},[],{"_2802":1250,"_24443":1151,"_17120":43718,"_5":17015,"_23194":43437,"_2329":43719},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2802":1251,"_24443":1151,"_17120":43721,"_5":17015,"_23194":43437,"_2329":43722},[],"`device_manager_client`",{"_2802":1252,"_24443":1151,"_17120":43724,"_5":17015,"_23194":43437,"_2329":20415},[],{"_2802":1253,"_24443":1151,"_17120":43726,"_5":17015,"_23194":43437,"_2329":43623},[],{"_2802":1254,"_24443":1151,"_17120":43728,"_5":17015,"_23194":43437,"_2329":43729},[],"HTTP URL of Lamassu's Device Manager.",{"_2802":1255,"_24443":1151,"_17120":43731,"_5":17015,"_23194":43437,"_2329":43732},[],"`ca_client`",{"_2802":1256,"_24443":1151,"_17120":43734,"_5":17015,"_23194":43437,"_2329":20415},[],{"_2802":1257,"_24443":1151,"_17120":43736,"_5":17015,"_23194":43437,"_2329":43623},[],{"_2802":1258,"_24443":1151,"_17120":43738,"_5":17015,"_23194":43437,"_2329":43739},[],"HTTP URL of Lamassu's CA service.",{"_2802":1259,"_24443":1151,"_17120":43741,"_5":17015,"_23194":43441,"_2329":43742},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2802":1260,"_24443":1151,"_17120":43744,"_5":17015,"_23194":43445,"_2329":43745},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2802":1261,"_24443":1151,"_17120":43747,"_5":17015,"_23194":43445,"_2329":43748},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2802":1262,"_24443":1151,"_17120":43750,"_5":17015,"_23194":43449,"_2329":43751},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2802":1263,"_24443":1151,"_17120":43753,"_5":17015,"_23194":43449,"_2329":43754},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2802":1264,"_24443":1151,"_17120":43756,"_5":17015,"_23194":43449,"_2329":43757},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2802":1265,"_24443":1151,"_17120":43759,"_5":17015,"_23194":43449,"_2329":43760},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2802":1266,"_24443":1151,"_17120":43762,"_5":17015,"_23194":43449,"_2329":43763},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2802":1267,"_24443":1151,"_17120":43765,"_5":17015,"_23194":43449,"_2329":43766},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2802":1268,"_24443":1151,"_17120":43768,"_5":17015,"_23194":43453,"_2329":43769},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2802":1269,"_24443":1151,"_17120":43771,"_5":17015,"_23194":43457,"_2329":43772},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2802":1270,"_24443":1151,"_17120":43774,"_5":17015,"_23194":43457,"_2329":43775},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2802":1271,"_24443":1151,"_17120":43777,"_5":17015,"_23194":43461,"_2329":43778},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2802":1272,"_24443":1151,"_17120":43780,"_5":17015,"_23194":43465,"_2329":43781},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2802":1273,"_24443":1151,"_17120":43783,"_5":17015,"_23194":43465,"_2329":43784},[],"Creates or updates the IoT policies configured in the DMS.",{"_2802":1274,"_24443":1151,"_17120":43786,"_5":17015,"_23194":43465,"_2329":43787},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2802":1275,"_24443":1151,"_17120":43789,"_5":17015,"_23194":43465,"_2329":43790},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2802":1276,"_24443":1151,"_17120":43792,"_5":17015,"_23194":43465,"_2329":43793},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2802":1277,"_24443":1151,"_17120":43795,"_5":17015,"_23194":43465,"_2329":43796},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2802":1278,"_24443":1151,"_17120":43798,"_5":17015,"_23194":43465,"_2329":43799},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2802":1279,"_24443":1151,"_17120":43801,"_5":17015,"_23194":43469,"_2329":43802},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2802":1280,"_24443":1151,"_17120":43804,"_5":17015,"_23194":43469,"_2329":43805},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2802":1281,"_24443":1151,"_17120":43807,"_5":17015,"_23194":43469,"_2329":43808},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2802":1282,"_24443":1151,"_17120":43810,"_5":17015,"_23194":43473,"_2329":43811},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2802":1283,"_24443":1151,"_17120":43813,"_5":17015,"_23194":43473,"_2329":43814},[],"The full flow from the device's perspective is:",{"_2802":1284,"_24443":1151,"_17120":43816,"_5":17015,"_23194":43473,"_2329":43817},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2802":1285,"_24443":1151,"_17120":43819,"_5":17015,"_23194":43477,"_2329":43820},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2802":1286,"_24443":1151,"_17120":43822,"_5":17015,"_23194":43477,"_2329":43823},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2802":1287,"_24443":1151,"_17120":43825,"_5":17015,"_23194":43477,"_2329":43826},[],"For the JITP flow to work correctly:",{"_2802":1288,"_24443":1151,"_17120":43828,"_5":17015,"_23194":43477,"_2329":43829},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2802":1289,"_24443":1151,"_17120":43831,"_5":17015,"_23194":43477,"_2329":43832},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2802":1290,"_24443":1151,"_17120":43834,"_5":17015,"_23194":43477,"_2329":43835},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2802":1291,"_24443":1151,"_17120":43837,"_5":17015,"_23194":43477,"_2329":43838},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2802":1292,"_24443":1151,"_17120":43840,"_5":17015,"_23194":43481,"_2329":43841},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2802":1293,"_24443":1151,"_17120":43843,"_5":17015,"_23194":43481,"_2329":43844},[],"Status in Lamassu",{"_2802":1294,"_24443":1151,"_17120":43846,"_5":17015,"_23194":43481,"_2329":43847},[],"Revocation reason",{"_2802":1295,"_24443":1151,"_17120":43849,"_5":17015,"_23194":43481,"_2329":43850},[],"Status in AWS IoT Core",{"_2802":1296,"_24443":1151,"_17120":43852,"_5":17015,"_23194":43481,"_2329":43853},[],"`Active`",{"_2802":1297,"_24443":1151,"_17120":43855,"_5":17015,"_23194":43481,"_2329":43856},[],"None",{"_2802":1298,"_24443":1151,"_17120":43858,"_5":17015,"_23194":43481,"_2329":43859},[],"`ACTIVE`",{"_2802":1299,"_24443":1151,"_17120":43861,"_5":17015,"_23194":43481,"_2329":43862},[],"`Revoked`",{"_2802":1300,"_24443":1151,"_17120":43864,"_5":17015,"_23194":43481,"_2329":43865},[],"`certificateHold`",{"_2802":1301,"_24443":1151,"_17120":43867,"_5":17015,"_23194":43481,"_2329":43868},[],"`INACTIVE`",{"_2802":1302,"_24443":1151,"_17120":43870,"_5":17015,"_23194":43481,"_2329":43862},[],{"_2802":1303,"_24443":1151,"_17120":43872,"_5":17015,"_23194":43481,"_2329":43873},[],"Any other reason",{"_2802":1304,"_24443":1151,"_17120":43875,"_5":17015,"_23194":43481,"_2329":43876},[],"`REVOKED`",{"_2802":1305,"_24443":1151,"_17120":43878,"_5":17015,"_23194":43481,"_2329":43879},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2802":1306,"_24443":1151,"_17120":43881,"_5":17015,"_23194":43485,"_2329":43882},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2802":1307,"_24443":1151,"_17120":43884,"_5":17015,"_23194":43485,"_2329":43885},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2802":1308,"_24443":1151,"_17120":43887,"_5":17015,"_23194":43485,"_2329":43888},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2802":1309,"_24443":1151,"_17120":43890,"_5":17015,"_23194":43489,"_2329":43891},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2802":1310,"_24443":1151,"_17120":43893,"_5":17015,"_23194":43489,"_2329":43894},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2802":1311,"_24443":1151,"_17120":43896,"_5":17015,"_23194":43493,"_2329":43897},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2802":1312,"_24443":1151,"_17120":43899,"_5":17015,"_23194":43493,"_2329":43900},[],"There are two action types:",{"_2802":1313,"_24443":1151,"_17120":43902,"_5":17015,"_23194":43493,"_2329":43903},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2802":1314,"_24443":1151,"_17120":43905,"_5":17015,"_23194":43493,"_2329":43906},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2802":1315,"_24443":1151,"_17120":43908,"_5":17015,"_23194":43493,"_2329":43909},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2802":1316,"_24443":1151,"_17120":43911,"_5":17015,"_23194":43497,"_2329":43912},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2802":1317,"_24443":1151,"_17120":43914,"_5":17015,"_23194":43497,"_2329":43915},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2802":1318,"_24443":1151,"_17120":43917,"_5":17015,"_23194":43497,"_2329":43918},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2802":1319,"_24443":1151,"_17120":43920,"_5":17015,"_23194":43501,"_2329":43921},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2802":1320,"_24443":1151,"_17120":43923,"_5":17015,"_23194":43501,"_2329":43924},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2802":1321,"_24443":1151,"_17120":43926,"_5":17015,"_23194":43501,"_2329":43927},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2802":1322,"_24443":1151,"_17120":43929,"_5":17015,"_23194":43501,"_2329":43930},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2802":1323,"_24443":1151,"_17120":43932,"_5":17015,"_23194":43501,"_2329":43933},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2802":1324,"_24443":1151,"_17120":43935,"_5":17015,"_23194":43501,"_2329":43936},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2802":1325,"_24443":1151,"_17120":43938,"_5":17015,"_23194":43501,"_2329":43939},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2802":1326,"_24443":1151,"_17120":43941,"_5":17015,"_23194":43501,"_2329":43942},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2802":1327,"_24443":1151,"_17120":43944,"_5":17015,"_23194":43501,"_2329":43945},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2802":1328,"_24443":1151,"_17120":43947,"_5":17015,"_23194":43501,"_2329":43948},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2802":1329,"_24443":1151,"_17120":43950,"_5":17015,"_23194":43501,"_2329":43951},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2802":1330,"_24443":1151,"_17120":43953,"_5":17015,"_23194":43501,"_2329":43954},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2802":1331,"_24443":1151,"_17120":43956,"_5":17015,"_23194":43501,"_2329":43957},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2802":1332,"_24443":1151,"_17120":43959,"_5":17015,"_23194":43501,"_2329":43960},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2802":1333,"_24443":1151,"_17120":43962,"_5":17015,"_23194":43501,"_2329":43963},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2802":1334,"_24443":1151,"_17120":43965,"_5":17015,"_23194":43501,"_2329":43966},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2802":1335,"_24443":1151,"_17120":43968,"_5":17015,"_23194":43501,"_2329":43969},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2802":1336,"_24443":1151,"_17120":43971,"_5":17015,"_23194":43501,"_2329":43972},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2802":1337,"_24443":1151,"_17120":43974,"_5":17015,"_23194":43501,"_2329":43975},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2802":1338,"_24443":1151,"_17120":43977,"_5":17015,"_23194":43501,"_2329":43978},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2802":1339,"_24443":1151,"_17120":43980,"_5":17015,"_23194":43501,"_2329":43981},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2802":1340,"_24443":1340,"_5":12033,"_2329":42097,"_24778":43983,"_17120":43984,"_23194":1340},[39822,41166,42097],[],{"_2802":1341,"_24443":1340,"_17120":43986,"_5":17015,"_23194":1340,"_2329":43987},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2802":1342,"_24443":1340,"_5":24775,"_17120":43989,"_23194":43990,"_2329":43991},[],"/docs/pr-preview/pr-28/platform/iot-fleets/overview#start-here","Start here",{"_2802":1343,"_24443":1340,"_5":24775,"_17120":43993,"_23194":43994,"_2329":42095},[],"/docs/pr-preview/pr-28/platform/iot-fleets/overview#devices-and-identities",{"_2802":1344,"_24443":1340,"_5":24775,"_17120":43996,"_23194":43997,"_2329":42278},[],"/docs/pr-preview/pr-28/platform/iot-fleets/overview#enrollment-with-pki",{"_2802":1345,"_24443":1340,"_5":24775,"_17120":43999,"_23194":44000,"_2329":43418},[],"/docs/pr-preview/pr-28/platform/iot-fleets/overview#integrations",{"_2802":1346,"_24443":1340,"_5":24775,"_17120":44002,"_23194":44003,"_2329":44004},[],"/docs/pr-preview/pr-28/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2802":1347,"_24443":1340,"_17120":44006,"_5":17015,"_23194":1340,"_2329":44007},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2802":1348,"_24443":1340,"_17120":44009,"_5":17015,"_23194":43990,"_2329":44010},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2802":1349,"_24443":1340,"_17120":44012,"_5":17015,"_23194":43990,"_2329":44013},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2802":1350,"_24443":1340,"_17120":44015,"_5":17015,"_23194":43994,"_2329":44016},[],"Resource",{"_2802":1351,"_24443":1340,"_17120":44018,"_5":17015,"_23194":43994,"_2329":44019},[],"What it represents",{"_2802":1352,"_24443":1340,"_17120":44021,"_5":17015,"_23194":43994,"_2329":44022},[],"**Device**",{"_2802":1353,"_24443":1340,"_17120":44024,"_5":17015,"_23194":43994,"_2329":44025},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2802":1354,"_24443":1340,"_17120":44027,"_5":17015,"_23194":43994,"_2329":44028},[],"**Identity**",{"_2802":1355,"_24443":1340,"_17120":44030,"_5":17015,"_23194":43994,"_2329":44031},[],"The device's association with its certificates: an active version and a history.",{"_2802":1356,"_24443":1340,"_17120":44033,"_5":17015,"_23194":43994,"_2329":44034},[],"**DMS**",{"_2802":1357,"_24443":1340,"_17120":44036,"_5":17015,"_23194":43994,"_2329":44037},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2802":1358,"_24443":1340,"_17120":44039,"_5":17015,"_23194":43994,"_2329":44040},[],"**Fleet**",{"_2802":1359,"_24443":1340,"_17120":44042,"_5":17015,"_23194":43994,"_2329":44043},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2802":1360,"_24443":1340,"_17120":44045,"_5":17015,"_23194":43994,"_2329":44046},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2802":1361,"_24443":1340,"_17120":44048,"_5":17015,"_23194":43994,"_2329":44049},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2802":1362,"_24443":1340,"_17120":44051,"_5":17015,"_23194":43997,"_2329":44052},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2802":1363,"_24443":1340,"_17120":44054,"_5":17015,"_23194":43997,"_2329":44055},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2802":1364,"_24443":1340,"_17120":44057,"_5":17015,"_23194":43997,"_2329":44058},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2802":1365,"_24443":1340,"_17120":44060,"_5":17015,"_23194":43997,"_2329":44061},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2802":1366,"_24443":1340,"_17120":44063,"_5":17015,"_23194":43997,"_2329":44064},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2802":1367,"_24443":1340,"_17120":44066,"_5":17015,"_23194":43997,"_2329":44067},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2802":1368,"_24443":1340,"_17120":44069,"_5":17015,"_23194":43997,"_2329":44070},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2802":1369,"_24443":1340,"_17120":44072,"_5":17015,"_23194":43997,"_2329":44073},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2802":1370,"_24443":1340,"_17120":44075,"_5":17015,"_23194":44000,"_2329":44076},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2802":1371,"_24443":1340,"_17120":44078,"_5":17015,"_23194":44000,"_2329":44079},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2802":1372,"_24443":1340,"_17120":44081,"_5":17015,"_23194":44003,"_2329":44082},[],"Participant",{"_2802":1373,"_24443":1340,"_17120":44084,"_5":17015,"_23194":44003,"_2329":44085},[],"Responsibility",{"_2802":1374,"_24443":1340,"_17120":44087,"_5":17015,"_23194":44003,"_2329":44088},[],"PKI administrator",{"_2802":1375,"_24443":1340,"_17120":44090,"_5":17015,"_23194":44003,"_2329":44091},[],"CA, issuance profile, chain and revocation publication.",{"_2802":1376,"_24443":1340,"_17120":44093,"_5":17015,"_23194":44003,"_2329":44094},[],"Provisioning administrator",{"_2802":1377,"_24443":1340,"_17120":44096,"_5":17015,"_23194":44003,"_2329":44097},[],"DMS, admission, authentication per operation and inventory.",{"_2802":1378,"_24443":1340,"_17120":44099,"_5":17015,"_23194":44003,"_2329":44100},[],"Device integrator",{"_2802":1379,"_24443":1340,"_17120":44102,"_5":17015,"_23194":44003,"_2329":44103},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2802":1380,"_24443":1340,"_17120":44105,"_5":17015,"_23194":44003,"_2329":44106},[],"Consumer integrator",{"_2802":1381,"_24443":1340,"_17120":44108,"_5":17015,"_23194":44003,"_2329":44109},[],"Trusted issuers, validation and device permissions in the destination.",{"_2802":1382,"_24443":1340,"_17120":44111,"_5":17015,"_23194":44003,"_2329":44112},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2802":1383,"_24443":1383,"_5":12033,"_2329":44114,"_24778":44115,"_17120":44117,"_23194":1383},"Enroll and connect your first device",[39822,41166,42097,44116],"Getting started",[],{"_2802":1384,"_24443":1383,"_17120":44119,"_5":17015,"_23194":1383,"_2329":44120},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2802":1385,"_24443":1383,"_5":24775,"_17120":44122,"_23194":44123,"_2329":39832},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2802":1386,"_24443":1383,"_5":24775,"_17120":44125,"_23194":44126,"_2329":44127},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2802":1387,"_24443":1383,"_5":24775,"_17120":44129,"_23194":44130,"_2329":44131},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2802":1388,"_24443":1383,"_5":24775,"_17120":44133,"_23194":44134,"_2329":44135},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2802":1389,"_24443":1383,"_5":24775,"_17120":44137,"_23194":44138,"_2329":44139},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2802":1390,"_24443":1383,"_5":24775,"_17120":44141,"_23194":44142,"_2329":44143},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2802":1391,"_24443":1383,"_5":24775,"_17120":44145,"_23194":44146,"_2329":44147},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2802":1392,"_24443":1383,"_5":24775,"_17120":44149,"_23194":44150,"_2329":44151},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2802":1393,"_24443":1383,"_17120":44153,"_5":17015,"_23194":1383,"_2329":44154},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2802":1394,"_24443":1383,"_17120":44156,"_5":17015,"_23194":44123,"_2329":44157},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2802":1395,"_24443":1383,"_17120":44159,"_5":17015,"_23194":44123,"_2329":44160},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2802":1396,"_24443":1383,"_17120":44162,"_5":17015,"_23194":44123,"_2329":44163},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2802":1397,"_24443":1383,"_17120":44165,"_5":17015,"_23194":44123,"_2329":44166},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2802":1398,"_24443":1383,"_17120":44168,"_5":17015,"_23194":44123,"_2329":44169},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2802":1399,"_24443":1383,"_17120":44171,"_5":17015,"_23194":44126,"_2329":44172},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2802":1400,"_24443":1383,"_17120":44174,"_5":17015,"_23194":44126,"_2329":44175},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2802":1401,"_24443":1383,"_17120":44177,"_5":17015,"_23194":44130,"_2329":44178},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2802":1402,"_24443":1383,"_17120":44180,"_5":17015,"_23194":44130,"_2329":44181},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2802":1403,"_24443":1383,"_17120":44183,"_5":17015,"_23194":44130,"_2329":44184},[],"Setting",{"_2802":1404,"_24443":1383,"_17120":44186,"_5":17015,"_23194":44130,"_2329":44187},[],"Evaluation value",{"_2802":1405,"_24443":1383,"_17120":44189,"_5":17015,"_23194":44130,"_2329":44190},[],"Enrollment CA",{"_2802":1406,"_24443":1383,"_17120":44192,"_5":17015,"_23194":44130,"_2329":44193},[],"Issuing root from `device-root.pem`.",{"_2802":1407,"_24443":1383,"_17120":44195,"_5":17015,"_23194":44130,"_2329":42404},[],{"_2802":1408,"_24443":1383,"_17120":44197,"_5":17015,"_23194":44130,"_2329":44198},[],"The 1-hour leaf profile you just prepared.",{"_2802":1409,"_24443":1383,"_17120":44200,"_5":17015,"_23194":44130,"_2329":44201},[],"Protocol / Registration Mode",{"_2802":1410,"_24443":1383,"_17120":44203,"_5":17015,"_23194":44130,"_2329":44204},[],"`EST_RFC7030` / `JITP`.",{"_2802":1411,"_24443":1383,"_17120":44206,"_5":17015,"_23194":44130,"_2329":44207},[],"Verify CSR Signature",{"_2802":1412,"_24443":1383,"_17120":44209,"_5":17015,"_23194":44130,"_2329":44210},[],"Enabled.",{"_2802":1413,"_24443":1383,"_17120":44212,"_5":17015,"_23194":44130,"_2329":44213},[],"Enable Replaceable Enrollment",{"_2802":1414,"_24443":1383,"_17120":44215,"_5":17015,"_23194":44130,"_2329":44216},[],"Disabled; the ID must be new.",{"_2802":1415,"_24443":1383,"_17120":44218,"_5":17015,"_23194":44130,"_2329":44219},[],"Initial authentication",{"_2802":1416,"_24443":1383,"_17120":44221,"_5":17015,"_23194":44130,"_2329":44222},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2802":1417,"_24443":1383,"_17120":44224,"_5":17015,"_23194":44130,"_2329":44225},[],"Renewal authentication",{"_2802":1418,"_24443":1383,"_17120":44227,"_5":17015,"_23194":44130,"_2329":44228},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2802":1419,"_24443":1383,"_17120":44230,"_5":17015,"_23194":44130,"_2329":44231},[],"Additional Validation CAs / Enable Expired Renewal",{"_2802":1420,"_24443":1383,"_17120":44233,"_5":17015,"_23194":44130,"_2329":44234},[],"Empty list for this direct issuance / disabled.",{"_2802":1421,"_24443":1383,"_17120":44236,"_5":17015,"_23194":44130,"_2329":44237},[],"Re-enrollment Delta",{"_2802":1422,"_24443":1383,"_17120":44239,"_5":17015,"_23194":44130,"_2329":44240},[],"1 hour.",{"_2802":1423,"_24443":1383,"_17120":44242,"_5":17015,"_23194":44130,"_2329":44243},[],"Preventive / Critical Delta",{"_2802":1424,"_24443":1383,"_17120":44245,"_5":17015,"_23194":44130,"_2329":44246},[],"30 minutes / 10 minutes.",{"_2802":1425,"_24443":1383,"_17120":44248,"_5":17015,"_23194":44130,"_2329":44249},[],"Revoke on Re-enrollment",{"_2802":1426,"_24443":1383,"_17120":44251,"_5":17015,"_23194":44130,"_2329":44252},[],"Disabled to test the successor before retiring the previous identity.",{"_2802":1427,"_24443":1383,"_17120":44254,"_5":17015,"_23194":44130,"_2329":42412},[],{"_2802":1428,"_24443":1383,"_17120":44256,"_5":17015,"_23194":44130,"_2329":44257},[],"Disabled; the operational key is generated in the client.",{"_2802":1429,"_24443":1383,"_17120":44259,"_5":17015,"_23194":44130,"_2329":44260},[],"CA Distribution",{"_2802":1430,"_24443":1383,"_17120":44262,"_5":17015,"_23194":44130,"_2329":44263},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2802":1431,"_24443":1383,"_17120":44265,"_5":17015,"_23194":44130,"_2329":44266},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2802":1432,"_24443":1383,"_17120":44268,"_5":17015,"_23194":44134,"_2329":44269},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2802":1433,"_24443":1383,"_17120":44271,"_5":17015,"_23194":44134,"_2329":44272},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2802":1434,"_24443":1383,"_17120":44274,"_5":17015,"_23194":44138,"_2329":44275},[],"Generate a new key and CSR with the selected identifier:",{"_2802":1435,"_24443":1383,"_17120":44277,"_5":17015,"_23194":44138,"_2329":44278},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2802":1436,"_24443":1383,"_17120":44280,"_5":17015,"_23194":44138,"_2329":44281},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2802":1437,"_24443":1383,"_17120":44283,"_5":17015,"_23194":44142,"_2329":44284},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2802":1438,"_24443":1383,"_17120":44286,"_5":17015,"_23194":44142,"_2329":44287},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2802":1439,"_24443":1383,"_17120":44289,"_5":17015,"_23194":44146,"_2329":44290},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2802":1440,"_24443":1383,"_17120":44292,"_5":17015,"_23194":44146,"_2329":44293},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2802":1441,"_24443":1383,"_17120":44295,"_5":17015,"_23194":44146,"_2329":44296},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2802":1442,"_24443":1383,"_17120":44298,"_5":17015,"_23194":44146,"_2329":44299},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2802":1443,"_24443":1383,"_17120":44301,"_5":17015,"_23194":44146,"_2329":44302},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2802":1444,"_24443":1383,"_17120":44304,"_5":17015,"_23194":44150,"_2329":44305},[],"Check",{"_2802":1445,"_24443":1383,"_17120":44307,"_5":17015,"_23194":44150,"_2329":44308},[],"Expected result",{"_2802":1446,"_24443":1383,"_17120":44310,"_5":17015,"_23194":44150,"_2329":44311},[],"Registration",{"_2802":1447,"_24443":1383,"_17120":44313,"_5":17015,"_23194":44150,"_2329":44314},[],"ID created automatically and correct DMS.",{"_2802":1448,"_24443":1383,"_17120":44316,"_5":17015,"_23194":44150,"_2329":44317},[],"Certificate",{"_2802":1449,"_24443":1383,"_17120":44319,"_5":17015,"_23194":44150,"_2329":44320},[],"CN, profile, serial and key verified.",{"_2802":1450,"_24443":1383,"_17120":44322,"_5":17015,"_23194":44150,"_2329":44323},[],"Inventory",{"_2802":1451,"_24443":1383,"_17120":44325,"_5":17015,"_23194":44150,"_2329":44326},[],"Received serial visible as the current identity and in history.",{"_2802":1452,"_24443":1383,"_17120":44328,"_5":17015,"_23194":44150,"_2329":44329},[],"Consumer",{"_2802":1453,"_24443":1383,"_17120":44331,"_5":17015,"_23194":44150,"_2329":44332},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2802":1454,"_24443":1383,"_17120":44334,"_5":17015,"_23194":44150,"_2329":44335},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2802":1455,"_24443":1383,"_17120":44337,"_5":17015,"_23194":44150,"_2329":44338},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2802":1456,"_24443":1456,"_5":12033,"_2329":42113,"_24778":44340,"_17120":44341,"_23194":1456},[39822,41166,42097,44116],[],{"_2802":1457,"_24443":1456,"_17120":44343,"_5":17015,"_23194":1456,"_2329":44344},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2802":1458,"_24443":1456,"_5":24775,"_17120":44346,"_23194":44347,"_2329":39832},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2802":1459,"_24443":1456,"_5":24775,"_17120":44349,"_23194":44350,"_2329":44351},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2802":1460,"_24443":1456,"_5":24775,"_17120":44353,"_23194":44354,"_2329":44355},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2802":1461,"_24443":1456,"_5":24775,"_17120":44357,"_23194":44358,"_2329":44359},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2802":1462,"_24443":1456,"_5":24775,"_17120":44361,"_23194":44362,"_2329":44363},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2802":1463,"_24443":1456,"_5":24775,"_17120":44365,"_23194":44366,"_2329":44367},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2802":1464,"_24443":1456,"_5":24775,"_17120":44369,"_23194":44370,"_2329":44308},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2802":1465,"_24443":1456,"_5":24775,"_17120":44372,"_23194":44373,"_2329":44374},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2802":1466,"_24443":1456,"_5":24775,"_17120":44376,"_23194":44377,"_2329":44378},[],"/docs/pr-preview/pr-28/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2802":1467,"_24443":1456,"_17120":44380,"_5":17015,"_23194":1456,"_2329":44381},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2802":1468,"_24443":1456,"_17120":44383,"_5":17015,"_23194":1456,"_2329":44384},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2802":1469,"_24443":1456,"_17120":44386,"_5":17015,"_23194":44347,"_2329":44387},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2802":1470,"_24443":1456,"_17120":44389,"_5":17015,"_23194":44347,"_2329":44390},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2802":1471,"_24443":1456,"_17120":44392,"_5":17015,"_23194":44347,"_2329":44393},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2802":1472,"_24443":1456,"_17120":44395,"_5":17015,"_23194":44347,"_2329":44396},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2802":1473,"_24443":1456,"_17120":44398,"_5":17015,"_23194":44350,"_2329":44399},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2802":1474,"_24443":1456,"_17120":44401,"_5":17015,"_23194":44350,"_2329":44402},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2802":1475,"_24443":1456,"_17120":44404,"_5":17015,"_23194":44350,"_2329":44405},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2802":1476,"_24443":1456,"_17120":44407,"_5":17015,"_23194":44350,"_2329":44408},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2802":1477,"_24443":1456,"_17120":44410,"_5":17015,"_23194":44350,"_2329":44411},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2802":1478,"_24443":1456,"_17120":44413,"_5":17015,"_23194":44350,"_2329":44414},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2802":1479,"_24443":1456,"_17120":44416,"_5":17015,"_23194":44350,"_2329":44417},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2802":1480,"_24443":1456,"_17120":44419,"_5":17015,"_23194":44350,"_2329":44420},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2802":1481,"_24443":1456,"_17120":44422,"_5":17015,"_23194":44354,"_2329":44423},[],"Open **Managed Devices** and the registration action. Complete:",{"_2802":1482,"_24443":1456,"_17120":44425,"_5":17015,"_23194":44354,"_2329":44426},[],"**Device ID**: `device-001`.",{"_2802":1483,"_24443":1456,"_17120":44428,"_5":17015,"_23194":44354,"_2329":44429},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2802":1484,"_24443":1456,"_17120":44431,"_5":17015,"_23194":44354,"_2329":44432},[],"**Icon** and **Tags**: optional classification.",{"_2802":1485,"_24443":1456,"_17120":44434,"_5":17015,"_23194":44354,"_2329":44435},[],"Confirm registration.",{"_2802":1486,"_24443":1456,"_17120":44437,"_5":17015,"_23194":44358,"_2329":44438},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2802":1487,"_24443":1456,"_17120":44440,"_5":17015,"_23194":44358,"_2329":44441},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2802":1488,"_24443":1456,"_17120":44443,"_5":17015,"_23194":44362,"_2329":44444},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2802":1489,"_24443":1456,"_17120":44446,"_5":17015,"_23194":44362,"_2329":44447},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2802":1490,"_24443":1456,"_17120":44449,"_5":17015,"_23194":44366,"_2329":44450},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2802":1491,"_24443":1456,"_17120":44452,"_5":17015,"_23194":44366,"_2329":44453},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2802":1492,"_24443":1456,"_17120":44455,"_5":17015,"_23194":44370,"_2329":44305},[],{"_2802":1493,"_24443":1456,"_17120":44457,"_5":17015,"_23194":44370,"_2329":44458},[],"Result",{"_2802":1494,"_24443":1456,"_17120":44460,"_5":17015,"_23194":44370,"_2329":44461},[],"Device",{"_2802":1495,"_24443":1456,"_17120":44463,"_5":17015,"_23194":44370,"_2329":44464},[],"`device-001` appears in inventory with the expected DMS.",{"_2802":1496,"_24443":1456,"_17120":44466,"_5":17015,"_23194":44370,"_2329":44467},[],"Current identity",{"_2802":1497,"_24443":1456,"_17120":44469,"_5":17015,"_23194":44370,"_2329":44470},[],"The associated certificate matches the one you verified in PKI.",{"_2802":1498,"_24443":1456,"_17120":44472,"_5":17015,"_23194":44370,"_2329":44473},[],"History",{"_2802":1499,"_24443":1456,"_17120":44475,"_5":17015,"_23194":44370,"_2329":44476},[],"The associated issuance appears with its serial number and dates.",{"_2802":1500,"_24443":1456,"_17120":44478,"_5":17015,"_23194":44370,"_2329":44479},[],"Key and certificate",{"_2802":1501,"_24443":1456,"_17120":44481,"_5":17015,"_23194":44370,"_2329":44482},[],"You have the verified pair ready to install on the device.",{"_2802":1502,"_24443":1456,"_17120":44484,"_5":17015,"_23194":44373,"_2329":44485},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2802":1503,"_24443":1456,"_17120":44487,"_5":17015,"_23194":44373,"_2329":44488},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2802":1504,"_24443":1456,"_17120":44490,"_5":17015,"_23194":44373,"_2329":44491},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2802":1505,"_24443":1456,"_17120":44493,"_5":17015,"_23194":44373,"_2329":44494},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2802":1506,"_24443":1456,"_17120":44496,"_5":17015,"_23194":44377,"_2329":44497},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2802":1507,"_24443":1456,"_17120":44499,"_5":17015,"_23194":44377,"_2329":44500},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2802":1508,"_24443":1456,"_17120":44502,"_5":17015,"_23194":44377,"_2329":44503},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2802":1509,"_24443":1509,"_5":12033,"_2329":44505,"_24778":44506,"_17120":44507,"_23194":1509},"Lamassu IoT Platform",[39822,41166],[],{"_2802":1510,"_24443":1509,"_17120":44509,"_5":17015,"_23194":1509,"_2329":44510},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2802":1511,"_24443":1509,"_5":24775,"_17120":44512,"_23194":44513,"_2329":43991},[],"/docs/pr-preview/pr-28/platform/overview#start-here",{"_2802":1512,"_24443":1509,"_5":24775,"_17120":44515,"_23194":44516,"_2329":44517},[],"/docs/pr-preview/pr-28/platform/overview#choose-your-path","Choose your path",{"_2802":1513,"_24443":1509,"_5":24775,"_17120":44519,"_23194":44520,"_2329":44521},[],"/docs/pr-preview/pr-28/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2802":1514,"_24443":1509,"_5":24775,"_17120":44523,"_23194":44524,"_2329":44525},[],"/docs/pr-preview/pr-28/platform/overview#core-capabilities","Core capabilities",{"_2802":1515,"_24443":1509,"_5":24775,"_17120":44527,"_23194":44528,"_2329":44529},[],"/docs/pr-preview/pr-28/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2802":1516,"_24443":1509,"_5":24775,"_17120":44531,"_23194":44532,"_2329":44533},[],"/docs/pr-preview/pr-28/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2802":1517,"_24443":1509,"_5":24775,"_17120":44535,"_23194":44536,"_2329":44537},[],"/docs/pr-preview/pr-28/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2802":1518,"_24443":1509,"_5":24775,"_17120":44539,"_23194":44540,"_2329":44541},[],"/docs/pr-preview/pr-28/platform/overview#automate-device-identities","Automate device identities",{"_2802":1519,"_24443":1509,"_5":24775,"_17120":44543,"_23194":44544,"_2329":44545},[],"/docs/pr-preview/pr-28/platform/overview#publish-validation-status","Publish validation status",{"_2802":1520,"_24443":1509,"_5":24775,"_17120":44547,"_23194":44548,"_2329":44549},[],"/docs/pr-preview/pr-28/platform/overview#react-to-events","React to events",{"_2802":1521,"_24443":1509,"_5":24775,"_17120":44551,"_23194":44552,"_2329":44553},[],"/docs/pr-preview/pr-28/platform/overview#operational-reference","Operational reference",{"_2802":1522,"_24443":1509,"_17120":44555,"_5":17015,"_23194":1509,"_2329":44556},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2802":1523,"_24443":1509,"_17120":44558,"_5":17015,"_23194":44513,"_2329":44559},[],"Choose the result you need:",{"_2802":1524,"_24443":1509,"_17120":44561,"_5":17015,"_23194":44513,"_2329":44562},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2802":1525,"_24443":1509,"_17120":44564,"_5":17015,"_23194":44513,"_2329":44565},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2802":1526,"_24443":1509,"_17120":44567,"_5":17015,"_23194":44513,"_2329":44568},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2802":1527,"_24443":1509,"_17120":44570,"_5":17015,"_23194":44516,"_2329":44571},[],"Section",{"_2802":1528,"_24443":1509,"_17120":44573,"_5":17015,"_23194":44516,"_2329":44574},[],"What you manage",{"_2802":1529,"_24443":1509,"_17120":44576,"_5":17015,"_23194":44516,"_2329":44577},[],"Entry point",{"_2802":1530,"_24443":1509,"_17120":44579,"_5":17015,"_23194":44516,"_2329":44580},[],"**PKI**",{"_2802":1531,"_24443":1509,"_17120":44582,"_5":17015,"_23194":44516,"_2329":44583},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2802":1532,"_24443":1509,"_17120":44585,"_5":17015,"_23194":44516,"_2329":44586},[],"PKI overview",{"_2802":1533,"_24443":1509,"_17120":44588,"_5":17015,"_23194":44516,"_2329":44589},[],"**IoT Fleets**",{"_2802":1534,"_24443":1509,"_17120":44591,"_5":17015,"_23194":44516,"_2329":44592},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2802":1535,"_24443":1509,"_17120":44594,"_5":17015,"_23194":44516,"_2329":44595},[],"IoT Fleets overview",{"_2802":1536,"_24443":1509,"_17120":44597,"_5":17015,"_23194":44516,"_2329":44598},[],"**Administration**",{"_2802":1537,"_24443":1509,"_17120":44600,"_5":17015,"_23194":44516,"_2329":44601},[],"Operator permissions, audit and event subscriptions.",{"_2802":1538,"_24443":1509,"_17120":44603,"_5":17015,"_23194":44516,"_2329":41164},[],{"_2802":1539,"_24443":1509,"_17120":44605,"_5":17015,"_23194":44516,"_2329":44606},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2802":1540,"_24443":1509,"_17120":44608,"_5":17015,"_23194":44520,"_2329":44609},[],"An identity's journey connects four responsibilities:",{"_2802":1541,"_24443":1509,"_17120":44611,"_5":17015,"_23194":44520,"_2329":44612},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2802":1542,"_24443":1509,"_17120":44614,"_5":17015,"_23194":44520,"_2329":44615},[],"The provisioning administrator configures the DMS and initial trust.",{"_2802":1543,"_24443":1509,"_17120":44617,"_5":17015,"_23194":44520,"_2329":44618},[],"The device client requests a certificate and installs it with the matching key.",{"_2802":1544,"_24443":1509,"_17120":44620,"_5":17015,"_23194":44520,"_2329":44621},[],"The consumer validates the identity and applies its access permissions.",{"_2802":1545,"_24443":1509,"_17120":44623,"_5":17015,"_23194":44520,"_2329":44624},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2802":1546,"_24443":1509,"_17120":44626,"_5":17015,"_23194":44528,"_2329":44627},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2802":1547,"_24443":1509,"_17120":44629,"_5":17015,"_23194":44532,"_2329":44630},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2802":1548,"_24443":1509,"_17120":44632,"_5":17015,"_23194":44536,"_2329":44633},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2802":1549,"_24443":1509,"_17120":44635,"_5":17015,"_23194":44540,"_2329":44636},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2802":1550,"_24443":1509,"_17120":44638,"_5":17015,"_23194":44544,"_2329":44639},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2802":1551,"_24443":1509,"_17120":44641,"_5":17015,"_23194":44548,"_2329":44642},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2802":1552,"_24443":1509,"_17120":44644,"_5":17015,"_23194":44552,"_2329":44085},[],{"_2802":1553,"_24443":1509,"_17120":44646,"_5":17015,"_23194":44552,"_2329":44647},[],"What it prepares or checks",{"_2802":1554,"_24443":1509,"_17120":44649,"_5":17015,"_23194":44552,"_2329":44088},[],{"_2802":1555,"_24443":1509,"_17120":44651,"_5":17015,"_23194":44552,"_2329":44652},[],"Key custody, CA hierarchy, profiles and validation.",{"_2802":1556,"_24443":1509,"_17120":44654,"_5":17015,"_23194":44552,"_2329":44655},[],"Fleet administrator",{"_2802":1557,"_24443":1509,"_17120":44657,"_5":17015,"_23194":44552,"_2329":44658},[],"DMS, device admission, renewal policy and inventory.",{"_2802":1558,"_24443":1509,"_17120":44660,"_5":17015,"_23194":44552,"_2329":44100},[],{"_2802":1559,"_24443":1509,"_17120":44662,"_5":17015,"_23194":44552,"_2329":44663},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2802":1560,"_24443":1509,"_17120":44665,"_5":17015,"_23194":44552,"_2329":44106},[],{"_2802":1561,"_24443":1509,"_17120":44667,"_5":17015,"_23194":44552,"_2329":44668},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2802":1562,"_24443":1509,"_17120":44670,"_5":17015,"_23194":44552,"_2329":44671},[],"Infrastructure operator",{"_2802":1563,"_24443":1509,"_17120":44673,"_5":17015,"_23194":44552,"_2329":44674},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2802":1564,"_24443":1509,"_17120":44676,"_5":17015,"_23194":44552,"_2329":44677},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2802":1565,"_24443":1565,"_5":12033,"_2329":44679,"_24778":44680,"_17120":44683,"_23194":1565},"CA hierarchy and rotation",[39822,41166,44681,44682],"PKI","Keys, authorities and certificates",[],{"_2802":1566,"_24443":1565,"_17120":44685,"_5":17015,"_23194":1565,"_2329":44686},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2802":1567,"_24443":1565,"_5":24775,"_17120":44688,"_23194":44689,"_2329":44690},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2802":1568,"_24443":1565,"_5":24775,"_17120":44692,"_23194":44693,"_2329":44694},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2802":1569,"_24443":1565,"_5":24775,"_17120":44696,"_23194":44697,"_2329":44698},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2802":1570,"_24443":1565,"_5":24775,"_17120":44700,"_23194":44701,"_2329":44702},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2802":1571,"_24443":1565,"_5":24775,"_17120":44704,"_23194":44705,"_2329":44706},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2802":1572,"_24443":1565,"_5":24775,"_17120":44708,"_23194":44709,"_2329":44710},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2802":1573,"_24443":1565,"_5":24775,"_17120":44712,"_23194":44713,"_2329":44714},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2802":1574,"_24443":1565,"_5":24775,"_17120":44716,"_23194":44717,"_2329":44718},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2802":1575,"_24443":1565,"_5":24775,"_17120":44720,"_23194":44721,"_2329":44722},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2802":1576,"_24443":1565,"_5":24775,"_17120":44724,"_23194":44725,"_2329":44726},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2802":1577,"_24443":1565,"_5":24775,"_17120":44728,"_23194":44729,"_2329":44730},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2802":1578,"_24443":1565,"_5":24775,"_17120":44732,"_23194":44733,"_2329":44734},[],"/docs/pr-preview/pr-28/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2802":1579,"_24443":1565,"_17120":44736,"_5":17015,"_23194":1565,"_2329":44737},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2802":1580,"_24443":1565,"_17120":44739,"_5":17015,"_23194":1565,"_2329":44740},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2802":1581,"_24443":1565,"_17120":44742,"_5":17015,"_23194":44689,"_2329":44743},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2802":1582,"_24443":1565,"_17120":44745,"_5":17015,"_23194":44689,"_2329":44746},[],"environment, such as production and preproduction;",{"_2802":1583,"_24443":1565,"_17120":44748,"_5":17015,"_23194":44689,"_2329":44749},[],"owner or operating team;",{"_2802":1584,"_24443":1565,"_17120":44751,"_5":17015,"_23194":44689,"_2329":44752},[],"device family or manufacturing process;",{"_2802":1585,"_24443":1565,"_17120":44754,"_5":17015,"_23194":44689,"_2329":44755},[],"region or regulatory requirement;",{"_2802":1586,"_24443":1565,"_17120":44757,"_5":17015,"_23194":44689,"_2329":44758},[],"cryptographic engine or key policy;",{"_2802":1587,"_24443":1565,"_17120":44760,"_5":17015,"_23194":44689,"_2329":44761},[],"maintenance window and renewal cadence.",{"_2802":1588,"_24443":1565,"_17120":44763,"_5":17015,"_23194":44689,"_2329":44764},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2802":1589,"_24443":1565,"_17120":44766,"_5":17015,"_23194":44689,"_2329":44767},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2802":1590,"_24443":1565,"_17120":44769,"_5":17015,"_23194":44693,"_2329":44770},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2802":1591,"_24443":1565,"_17120":44772,"_5":17015,"_23194":44693,"_2329":44773},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2802":1592,"_24443":1565,"_17120":44775,"_5":17015,"_23194":44693,"_2329":44776},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2802":1593,"_24443":1565,"_17120":44778,"_5":17015,"_23194":44697,"_2329":44779},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2802":1594,"_24443":1565,"_17120":44781,"_5":17015,"_23194":44697,"_2329":44782},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2802":1595,"_24443":1565,"_17120":44784,"_5":17015,"_23194":44697,"_2329":44785},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2802":1596,"_24443":1565,"_17120":44787,"_5":17015,"_23194":44697,"_2329":44788},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2802":1597,"_24443":1565,"_17120":44790,"_5":17015,"_23194":44705,"_2329":44791},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2802":1598,"_24443":1565,"_17120":44793,"_5":17015,"_23194":44709,"_2329":44794},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2802":1599,"_24443":1565,"_17120":44796,"_5":17015,"_23194":44713,"_2329":44797},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2802":1600,"_24443":1565,"_17120":44799,"_5":17015,"_23194":44717,"_2329":44800},[],"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment.",{"_2802":1601,"_24443":1565,"_17120":44802,"_5":17015,"_23194":44721,"_2329":44803},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2802":1602,"_24443":1565,"_17120":44805,"_5":17015,"_23194":44725,"_2329":44806},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2802":1603,"_24443":1565,"_17120":44808,"_5":17015,"_23194":44729,"_2329":44809},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2802":1604,"_24443":1565,"_17120":44811,"_5":17015,"_23194":44729,"_2329":44812},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2802":1605,"_24443":1565,"_17120":44814,"_5":17015,"_23194":44729,"_2329":44815},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2802":1606,"_24443":1565,"_17120":44817,"_5":17015,"_23194":44729,"_2329":44818},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2802":1607,"_24443":1565,"_17120":44820,"_5":17015,"_23194":44733,"_2329":44821},[],"The new chain ends in an anchor installed by the consumer.",{"_2802":1608,"_24443":1565,"_17120":44823,"_5":17015,"_23194":44733,"_2329":44824},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2802":1609,"_24443":1565,"_17120":44826,"_5":17015,"_23194":44733,"_2329":44827},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2802":1610,"_24443":1565,"_17120":44829,"_5":17015,"_23194":44733,"_2329":44830},[],"Re-enrollment accepts the old identity during the planned period.",{"_2802":1611,"_24443":1565,"_17120":44832,"_5":17015,"_23194":44733,"_2329":44833},[],"OCSP and CRL respond for the authorities that remain active.",{"_2802":1612,"_24443":1565,"_17120":44835,"_5":17015,"_23194":44733,"_2329":44836},[],"No DMS is left accidentally issuing from the old CA.",{"_2802":1613,"_24443":1565,"_17120":44838,"_5":17015,"_23194":44733,"_2329":44839},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2802":1614,"_24443":1614,"_5":12033,"_2329":44841,"_24778":44842,"_17120":44843,"_23194":1614},"Certification authorities",[39822,41166,44681,44682],[],{"_2802":1615,"_24443":1614,"_17120":44845,"_5":17015,"_23194":1614,"_2329":44846},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2802":1616,"_24443":1614,"_5":24775,"_17120":44848,"_23194":44849,"_2329":44850},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2802":1617,"_24443":1614,"_5":24775,"_17120":44852,"_23194":44853,"_2329":44854},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2802":1618,"_24443":1614,"_5":24775,"_17120":44856,"_23194":44857,"_2329":39832},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#before-you-begin",{"_2802":1619,"_24443":1614,"_5":24775,"_17120":44859,"_23194":44860,"_2329":44861},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2802":1620,"_24443":1614,"_5":24775,"_17120":44863,"_23194":44864,"_2329":44865},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2802":1621,"_24443":1614,"_5":24775,"_17120":44867,"_23194":44868,"_2329":44869},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2802":1622,"_24443":1614,"_5":24775,"_17120":44871,"_23194":44872,"_2329":44873},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2802":1623,"_24443":1614,"_5":24775,"_17120":44875,"_23194":44876,"_2329":44877},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2802":1624,"_24443":1614,"_5":24775,"_17120":44879,"_23194":44880,"_2329":44881},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2802":1625,"_24443":1614,"_5":24775,"_17120":44883,"_23194":44884,"_2329":44885},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2802":1626,"_24443":1614,"_5":24775,"_17120":44887,"_23194":44888,"_2329":44889},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2802":1627,"_24443":1614,"_5":24775,"_17120":44891,"_23194":44892,"_2329":44893},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2802":1628,"_24443":1614,"_5":24775,"_17120":44895,"_23194":44896,"_2329":44897},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2802":1629,"_24443":1614,"_5":24775,"_17120":44899,"_23194":44900,"_2329":44901},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2802":1630,"_24443":1614,"_5":24775,"_17120":44903,"_23194":44904,"_2329":44905},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2802":1631,"_24443":1614,"_5":24775,"_17120":44907,"_23194":44908,"_2329":44909},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2802":1632,"_24443":1614,"_5":24775,"_17120":44911,"_23194":44912,"_2329":44913},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2802":1633,"_24443":1614,"_5":24775,"_17120":44915,"_23194":44916,"_2329":44917},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2802":1634,"_24443":1614,"_5":24775,"_17120":44919,"_23194":44920,"_2329":44921},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2802":1635,"_24443":1614,"_5":24775,"_17120":44923,"_23194":44924,"_2329":44925},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2802":1636,"_24443":1614,"_5":24775,"_17120":44927,"_23194":44928,"_2329":44929},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2802":1637,"_24443":1614,"_5":24775,"_17120":44931,"_23194":44932,"_2329":44933},[],"/docs/pr-preview/pr-28/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2802":1638,"_24443":1614,"_17120":44935,"_5":17015,"_23194":1614,"_2329":44936},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2802":1639,"_24443":1614,"_17120":44938,"_5":17015,"_23194":1614,"_2329":44939},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2802":1640,"_24443":1614,"_17120":44941,"_5":17015,"_23194":1614,"_2329":44942},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2802":1641,"_24443":1614,"_17120":44944,"_5":17015,"_23194":44849,"_2329":44945},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2802":1642,"_24443":1614,"_17120":44947,"_5":17015,"_23194":44849,"_2329":44948},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2802":1643,"_24443":1614,"_17120":44950,"_5":17015,"_23194":44849,"_2329":44951},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2802":1644,"_24443":1614,"_17120":44953,"_5":17015,"_23194":44849,"_2329":44954},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2802":1645,"_24443":1614,"_17120":44956,"_5":17015,"_23194":44849,"_2329":44957},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2802":1646,"_24443":1614,"_17120":44959,"_5":17015,"_23194":44857,"_2329":44960},[],"Decide whether the CA will be a root or an intermediate.",{"_2802":1647,"_24443":1614,"_17120":44962,"_5":17015,"_23194":44857,"_2329":44963},[],"Choose the engine that will keep the key.",{"_2802":1648,"_24443":1614,"_17120":44965,"_5":17015,"_23194":44857,"_2329":44966},[],"Define a validity longer than that of the certificates it will issue.",{"_2802":1649,"_24443":1614,"_17120":44968,"_5":17015,"_23194":44857,"_2329":44969},[],"For an intermediate CA, make sure the parent CA is active.",{"_2802":1650,"_24443":1614,"_17120":44971,"_5":17015,"_23194":44860,"_2329":44972},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2802":1651,"_24443":1614,"_17120":44974,"_5":17015,"_23194":44864,"_2329":44975},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2802":1652,"_24443":1614,"_17120":44977,"_5":17015,"_23194":44864,"_2329":44978},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2802":1653,"_24443":1614,"_17120":44980,"_5":17015,"_23194":44868,"_2329":44981},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2802":1654,"_24443":1614,"_17120":44983,"_5":17015,"_23194":44872,"_2329":44984},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2802":1655,"_24443":1614,"_17120":44986,"_5":17015,"_23194":44872,"_2329":44987},[],"`C`: two-letter ISO 3166-1 country code.",{"_2802":1656,"_24443":1614,"_17120":44989,"_5":17015,"_23194":44872,"_2329":44990},[],"`ST`: state or province.",{"_2802":1657,"_24443":1614,"_17120":44992,"_5":17015,"_23194":44872,"_2329":44993},[],"`L`: locality.",{"_2802":1658,"_24443":1614,"_17120":44995,"_5":17015,"_23194":44872,"_2329":44996},[],"`O`: organization.",{"_2802":1659,"_24443":1614,"_17120":44998,"_5":17015,"_23194":44872,"_2329":44999},[],"`OU`: organizational unit.",{"_2802":1660,"_24443":1614,"_17120":45001,"_5":17015,"_23194":44872,"_2329":45002},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2802":1661,"_24443":1614,"_17120":45004,"_5":17015,"_23194":44876,"_2329":45005},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2802":1662,"_24443":1614,"_17120":45007,"_5":17015,"_23194":44876,"_2329":45008},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2802":1663,"_24443":1614,"_17120":45010,"_5":17015,"_23194":44880,"_2329":45011},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2802":1664,"_24443":1614,"_17120":45013,"_5":17015,"_23194":44880,"_2329":45014},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2802":1665,"_24443":1614,"_17120":45016,"_5":17015,"_23194":44884,"_2329":45017},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2802":1666,"_24443":1614,"_17120":45019,"_5":17015,"_23194":44884,"_2329":45020},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2802":1667,"_24443":1614,"_17120":45022,"_5":17015,"_23194":44888,"_2329":45023},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2802":1668,"_24443":1614,"_17120":45025,"_5":17015,"_23194":44892,"_2329":45026},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2802":1669,"_24443":1614,"_17120":45028,"_5":17015,"_23194":44896,"_2329":45029},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2802":1670,"_24443":1614,"_17120":45031,"_5":17015,"_23194":44900,"_2329":45032},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2802":1671,"_24443":1614,"_17120":45034,"_5":17015,"_23194":44904,"_2329":45035},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2802":1672,"_24443":1614,"_17120":45037,"_5":17015,"_23194":44904,"_2329":45038},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2802":1673,"_24443":1614,"_17120":45040,"_5":17015,"_23194":44908,"_2329":45041},[],"Open a CA from the inventory to review:",{"_2802":1674,"_24443":1614,"_17120":45043,"_5":17015,"_23194":44908,"_2329":45044},[],"Status and validity period.",{"_2802":1675,"_24443":1614,"_17120":45046,"_5":17015,"_23194":44908,"_2329":45047},[],"Certificate and chain in PEM format.",{"_2802":1676,"_24443":1614,"_17120":45049,"_5":17015,"_23194":44908,"_2329":45050},[],"Number of active, expired and revoked certificates.",{"_2802":1677,"_24443":1614,"_17120":45052,"_5":17015,"_23194":44908,"_2329":45053},[],"Certificates issued in **Issued Certificates**.",{"_2802":1678,"_24443":1614,"_17120":45055,"_5":17015,"_23194":44908,"_2329":45056},[],"The CRL linked to the authority.",{"_2802":1679,"_24443":1614,"_17120":45058,"_5":17015,"_23194":44908,"_2329":45059},[],"Metadata and the associated cryptographic engine.",{"_2802":1680,"_24443":1614,"_17120":45061,"_5":17015,"_23194":44908,"_2329":45062},[],"You can filter the inventory by name, status and CA type.",{"_2802":1681,"_24443":1614,"_17120":45064,"_5":17015,"_23194":44912,"_2329":45065},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2802":1682,"_24443":1614,"_17120":45067,"_5":17015,"_23194":44912,"_2329":45068},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2802":1683,"_24443":1614,"_17120":45070,"_5":17015,"_23194":44912,"_2329":45071},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2802":1684,"_24443":1614,"_17120":45073,"_5":17015,"_23194":44912,"_2329":45074},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2802":1685,"_24443":1614,"_17120":45076,"_5":17015,"_23194":44916,"_2329":45077},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2802":1686,"_24443":1614,"_17120":45079,"_5":17015,"_23194":44920,"_2329":45080},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2802":1687,"_24443":1614,"_17120":45082,"_5":17015,"_23194":44924,"_2329":45083},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2802":1688,"_24443":1614,"_17120":45085,"_5":17015,"_23194":44928,"_2329":45086},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2802":1689,"_24443":1614,"_17120":45088,"_5":17015,"_23194":44932,"_2329":45089},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2802":1690,"_24443":1614,"_17120":45091,"_5":17015,"_23194":44932,"_2329":45092},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2802":1691,"_24443":1691,"_5":12033,"_2329":45094,"_24778":45095,"_17120":45096,"_23194":1691},"Certificate profiles",[39822,41166,44681,44682],[],{"_2802":1692,"_24443":1691,"_17120":45098,"_5":17015,"_23194":1691,"_2329":45099},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2802":1693,"_24443":1691,"_5":24775,"_17120":45101,"_23194":45102,"_2329":45103},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2802":1694,"_24443":1691,"_5":24775,"_17120":45105,"_23194":45106,"_2329":45107},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#validity","Validity",{"_2802":1695,"_24443":1691,"_5":24775,"_17120":45109,"_23194":45110,"_2329":45111},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2802":1696,"_24443":1691,"_5":24775,"_17120":45113,"_23194":45114,"_2329":45115},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2802":1697,"_24443":1691,"_5":24775,"_17120":45117,"_23194":45118,"_2329":45119},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#subject","Subject",{"_2802":1698,"_24443":1691,"_5":24775,"_17120":45121,"_23194":45122,"_2329":45123},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2802":1699,"_24443":1691,"_5":24775,"_17120":45125,"_23194":45126,"_2329":45127},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2802":1700,"_24443":1691,"_5":24775,"_17120":45129,"_23194":45130,"_2329":45131},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2802":1701,"_24443":1691,"_5":24775,"_17120":45133,"_23194":45134,"_2329":45135},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2802":1702,"_24443":1691,"_5":24775,"_17120":45137,"_23194":45138,"_2329":45139},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2802":1703,"_24443":1691,"_5":24775,"_17120":45141,"_23194":45142,"_2329":45143},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2802":1704,"_24443":1691,"_5":24775,"_17120":45145,"_23194":45146,"_2329":45147},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2802":1705,"_24443":1691,"_5":24775,"_17120":45149,"_23194":45150,"_2329":45151},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2802":1706,"_24443":1691,"_5":24775,"_17120":45153,"_23194":45154,"_2329":45155},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2802":1707,"_24443":1691,"_5":24775,"_17120":45157,"_23194":45158,"_2329":45159},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#design-examples","Design examples",{"_2802":1708,"_24443":1691,"_5":24775,"_17120":45161,"_23194":45162,"_2329":45163},[],"/docs/pr-preview/pr-28/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2802":1709,"_24443":1691,"_17120":45165,"_5":17015,"_23194":1691,"_2329":45166},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2802":1710,"_24443":1691,"_17120":45168,"_5":17015,"_23194":1691,"_2329":45169},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2802":1711,"_24443":1691,"_17120":45171,"_5":17015,"_23194":45106,"_2329":45172},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2802":1712,"_24443":1691,"_17120":45174,"_5":17015,"_23194":45106,"_2329":45175},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2802":1713,"_24443":1691,"_17120":45177,"_5":17015,"_23194":45110,"_2329":45178},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2802":1714,"_24443":1691,"_17120":45180,"_5":17015,"_23194":45114,"_2329":45181},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2802":1715,"_24443":1691,"_17120":45183,"_5":17015,"_23194":45114,"_2329":45184},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2802":1716,"_24443":1691,"_17120":45186,"_5":17015,"_23194":45114,"_2329":45187},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2802":1717,"_24443":1691,"_17120":45189,"_5":17015,"_23194":45118,"_2329":45190},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2802":1718,"_24443":1691,"_17120":45192,"_5":17015,"_23194":45122,"_2329":45193},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2802":1719,"_24443":1691,"_17120":45195,"_5":17015,"_23194":45122,"_2329":45196},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2802":1720,"_24443":1691,"_17120":45198,"_5":17015,"_23194":45126,"_2329":45199},[],"The cryptographic enforcement can:",{"_2802":1721,"_24443":1691,"_17120":45201,"_5":17015,"_23194":45126,"_2329":45202},[],"allow or block RSA keys;",{"_2802":1722,"_24443":1691,"_17120":45204,"_5":17015,"_23194":45126,"_2329":45205},[],"limit the supported RSA sizes;",{"_2802":1723,"_24443":1691,"_17120":45207,"_5":17015,"_23194":45126,"_2329":45208},[],"allow or block ECDSA keys;",{"_2802":1724,"_24443":1691,"_17120":45210,"_5":17015,"_23194":45126,"_2329":45211},[],"limit the supported ECDSA sizes or curves.",{"_2802":1725,"_24443":1691,"_17120":45213,"_5":17015,"_23194":45126,"_2329":45214},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2802":1726,"_24443":1691,"_17120":45216,"_5":17015,"_23194":45130,"_2329":45217},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2802":1727,"_24443":1691,"_17120":45219,"_5":17015,"_23194":45130,"_2329":42751},[],{"_2802":1728,"_24443":1691,"_17120":45221,"_5":17015,"_23194":45130,"_2329":45222},[],"First choice",{"_2802":1729,"_24443":1691,"_17120":45224,"_5":17015,"_23194":45130,"_2329":45225},[],"Second choice",{"_2802":1730,"_24443":1691,"_17120":45227,"_5":17015,"_23194":45130,"_2329":45228},[],"If neither is supplied",{"_2802":1731,"_24443":1691,"_17120":45230,"_5":17015,"_23194":45130,"_2329":45231},[],"Direct signing with a CA",{"_2802":1732,"_24443":1691,"_17120":45233,"_5":17015,"_23194":45130,"_2329":45234},[],"`issuance_profile` embedded in the request",{"_2802":1733,"_24443":1691,"_17120":45236,"_5":17015,"_23194":45130,"_2329":45237},[],"Request `issuance_profile_id`",{"_2802":1734,"_24443":1691,"_17120":45239,"_5":17015,"_23194":45130,"_2329":45240},[],"CA default profile (`profile_id`).",{"_2802":1735,"_24443":1691,"_17120":45242,"_5":17015,"_23194":45130,"_2329":45243},[],"Issuance through a DMS",{"_2802":1736,"_24443":1691,"_17120":45245,"_5":17015,"_23194":45130,"_2329":45246},[],"`settings.issuance_profile_id`",{"_2802":1737,"_24443":1691,"_17120":45248,"_5":17015,"_23194":45130,"_2329":45249},[],"`settings.issuance_profile` embedded in the DMS",{"_2802":1738,"_24443":1691,"_17120":45251,"_5":17015,"_23194":45130,"_2329":45252},[],"Enrollment CA default profile.",{"_2802":1739,"_24443":1691,"_17120":45254,"_5":17015,"_23194":45130,"_2329":45255},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2802":1740,"_24443":1691,"_17120":45257,"_5":17015,"_23194":45130,"_2329":45258},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2802":1741,"_24443":1691,"_17120":45260,"_5":17015,"_23194":45138,"_2329":45261},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2802":1742,"_24443":1691,"_17120":45263,"_5":17015,"_23194":45142,"_2329":45264},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2802":1743,"_24443":1691,"_17120":45266,"_5":17015,"_23194":45146,"_2329":45267},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2802":1744,"_24443":1691,"_17120":45269,"_5":17015,"_23194":45150,"_2329":45270},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2802":1745,"_24443":1691,"_17120":45272,"_5":17015,"_23194":45154,"_2329":45273},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2802":1746,"_24443":1691,"_17120":45275,"_5":17015,"_23194":45154,"_2329":45276},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2802":1747,"_24443":1691,"_17120":45278,"_5":17015,"_23194":45158,"_2329":45279},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2802":1748,"_24443":1691,"_17120":45281,"_5":17015,"_23194":45158,"_2329":45282},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2802":1749,"_24443":1691,"_17120":45284,"_5":17015,"_23194":45158,"_2329":45285},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2802":1750,"_24443":1691,"_17120":45287,"_5":17015,"_23194":45158,"_2329":45288},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2802":1751,"_24443":1691,"_17120":45290,"_5":17015,"_23194":45162,"_2329":45291},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2802":1752,"_24443":1691,"_17120":45293,"_5":17015,"_23194":45162,"_2329":45294},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2802":1753,"_24443":1753,"_5":12033,"_2329":45296,"_24778":45297,"_17120":45299,"_23194":1753},"Certificate validation",[39822,41166,44681,45298],"Validation",[],{"_2802":1754,"_24443":1753,"_17120":45301,"_5":17015,"_23194":1753,"_2329":45302},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2802":1755,"_24443":1753,"_5":24775,"_17120":45304,"_23194":45305,"_2329":45306},[],"/docs/pr-preview/pr-28/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2802":1756,"_24443":1753,"_5":24775,"_17120":45308,"_23194":45309,"_2329":45310},[],"/docs/pr-preview/pr-28/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2802":1757,"_24443":1753,"_5":24775,"_17120":45312,"_23194":45313,"_2329":45314},[],"/docs/pr-preview/pr-28/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2802":1758,"_24443":1753,"_17120":45316,"_5":17015,"_23194":1753,"_2329":45317},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2802":1759,"_24443":1753,"_17120":45319,"_5":17015,"_23194":45305,"_2329":45320},[],"Verify these criteria together:",{"_2802":1760,"_24443":1753,"_17120":45322,"_5":17015,"_23194":45305,"_2329":44305},[],{"_2802":1761,"_24443":1753,"_17120":45324,"_5":17015,"_23194":45305,"_2329":45325},[],"Required result",{"_2802":1762,"_24443":1753,"_17120":45327,"_5":17015,"_23194":45305,"_2329":45328},[],"Chain and signature",{"_2802":1763,"_24443":1753,"_17120":45330,"_5":17015,"_23194":45305,"_2329":45331},[],"Valid chain to a root deliberately installed in the consumer.",{"_2802":1764,"_24443":1753,"_17120":45333,"_5":17015,"_23194":45305,"_2329":45334},[],"Dates",{"_2802":1765,"_24443":1753,"_17120":45336,"_5":17015,"_23194":45305,"_2329":45337},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2802":1766,"_24443":1753,"_17120":45339,"_5":17015,"_23194":45305,"_2329":40869},[],{"_2802":1767,"_24443":1753,"_17120":45341,"_5":17015,"_23194":45305,"_2329":45342},[],"Name, SAN or identifier matches the expected peer.",{"_2802":1768,"_24443":1753,"_17120":45344,"_5":17015,"_23194":45305,"_2329":40205},[],{"_2802":1769,"_24443":1753,"_17120":45346,"_5":17015,"_23194":45305,"_2329":45347},[],"KU, EKU and constraints permit the specific operation.",{"_2802":1770,"_24443":1753,"_17120":45349,"_5":17015,"_23194":45305,"_2329":45350},[],"Revocation",{"_2802":1771,"_24443":1753,"_17120":45352,"_5":17015,"_23194":45305,"_2329":45353},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2802":1772,"_24443":1753,"_17120":45355,"_5":17015,"_23194":45305,"_2329":45356},[],"Authorization",{"_2802":1773,"_24443":1753,"_17120":45358,"_5":17015,"_23194":45305,"_2329":45359},[],"The application permits that identity to perform the action.",{"_2802":1774,"_24443":1753,"_17120":45361,"_5":17015,"_23194":45305,"_2329":45362},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2802":1775,"_24443":1753,"_17120":45364,"_5":17015,"_23194":45309,"_2329":45365},[],"Mechanism",{"_2802":1776,"_24443":1753,"_17120":45367,"_5":17015,"_23194":45309,"_2329":45368},[],"When to use it",{"_2802":1777,"_24443":1753,"_17120":45370,"_5":17015,"_23194":45309,"_2329":45371},[],"What you must maintain",{"_2802":1778,"_24443":1753,"_17120":45373,"_5":17015,"_23194":45309,"_2329":45374},[],"OCSP",{"_2802":1779,"_24443":1753,"_17120":45376,"_5":17015,"_23194":45309,"_2329":45377},[],"Status query for a specific certificate.",{"_2802":1780,"_24443":1753,"_17120":45379,"_5":17015,"_23194":45309,"_2329":45380},[],"Responder access, signature verification and cache/freshness policy.",{"_2802":1781,"_24443":1753,"_17120":45382,"_5":17015,"_23194":45309,"_2329":45383},[],"CRL",{"_2802":1782,"_24443":1753,"_17120":45385,"_5":17015,"_23194":45309,"_2329":45386},[],"Local checks for many certificates or offline operation.",{"_2802":1783,"_24443":1753,"_17120":45388,"_5":17015,"_23194":45309,"_2329":45389},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2802":1784,"_24443":1753,"_17120":45391,"_5":17015,"_23194":45309,"_2329":45392},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2802":1785,"_24443":1753,"_17120":45394,"_5":17015,"_23194":45309,"_2329":45395},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2802":1786,"_24443":1753,"_17120":45397,"_5":17015,"_23194":45313,"_2329":45398},[],"Accept a current, authorized certificate with a known chain.",{"_2802":1787,"_24443":1753,"_17120":45400,"_5":17015,"_23194":45313,"_2329":45401},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2802":1788,"_24443":1753,"_17120":45403,"_5":17015,"_23194":45313,"_2329":45404},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2802":1789,"_24443":1753,"_17120":45406,"_5":17015,"_23194":45313,"_2329":45407},[],"Check that a new connection with that identity is rejected.",{"_2802":1790,"_24443":1753,"_17120":45409,"_5":17015,"_23194":45313,"_2329":45410},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2802":1791,"_24443":1753,"_17120":45412,"_5":17015,"_23194":45313,"_2329":45413},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2802":1792,"_24443":1753,"_17120":45415,"_5":17015,"_23194":45313,"_2329":45416},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2802":1793,"_24443":1753,"_17120":45418,"_5":17015,"_23194":45313,"_2329":45419},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2802":1794,"_24443":1753,"_17120":45421,"_5":17015,"_23194":45313,"_2329":45422},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2802":1795,"_24443":1795,"_5":12033,"_2329":45424,"_24778":45425,"_17120":45426,"_23194":1795},"Certificates",[39822,41166,44681,44682],[],{"_2802":1796,"_24443":1795,"_17120":45428,"_5":17015,"_23194":1795,"_2329":45429},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2802":1797,"_24443":1795,"_5":24775,"_17120":45431,"_23194":45432,"_2329":45433},[],"/docs/pr-preview/pr-28/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2802":1798,"_24443":1795,"_5":24775,"_17120":45435,"_23194":45436,"_2329":45437},[],"/docs/pr-preview/pr-28/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2802":1799,"_24443":1795,"_5":24775,"_17120":45439,"_23194":45440,"_2329":45441},[],"/docs/pr-preview/pr-28/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2802":1800,"_24443":1795,"_5":24775,"_17120":45443,"_23194":45444,"_2329":45445},[],"/docs/pr-preview/pr-28/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2802":1801,"_24443":1795,"_5":24775,"_17120":45447,"_23194":45448,"_2329":45449},[],"/docs/pr-preview/pr-28/platform/pki/certificates#open-the-action","Open the action",{"_2802":1802,"_24443":1795,"_5":24775,"_17120":45451,"_23194":45452,"_2329":45453},[],"/docs/pr-preview/pr-28/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2802":1803,"_24443":1795,"_5":24775,"_17120":45455,"_23194":45456,"_2329":45457},[],"/docs/pr-preview/pr-28/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2802":1804,"_24443":1795,"_5":24775,"_17120":45459,"_23194":45460,"_2329":45461},[],"/docs/pr-preview/pr-28/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2802":1805,"_24443":1795,"_5":24775,"_17120":45463,"_23194":45464,"_2329":45465},[],"/docs/pr-preview/pr-28/platform/pki/certificates#continue","Continue",{"_2802":1806,"_24443":1795,"_17120":45467,"_5":17015,"_23194":1795,"_2329":45468},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2802":1807,"_24443":1795,"_17120":45470,"_5":17015,"_23194":45432,"_2329":45471},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2802":1808,"_24443":1795,"_17120":45473,"_5":17015,"_23194":45432,"_2329":45474},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2802":1809,"_24443":1795,"_17120":45476,"_5":17015,"_23194":45436,"_2329":45477},[],"Download the PEM and inspect it:",{"_2802":1810,"_24443":1795,"_17120":45479,"_5":17015,"_23194":45436,"_2329":45480},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2802":1811,"_24443":1795,"_17120":45482,"_5":17015,"_23194":45440,"_2329":45483},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2802":1812,"_24443":1795,"_17120":45485,"_5":17015,"_23194":45440,"_2329":45486},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2802":1813,"_24443":1795,"_17120":45488,"_5":17015,"_23194":45440,"_2329":45489},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2802":1814,"_24443":1795,"_17120":45491,"_5":17015,"_23194":45440,"_2329":45492},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2802":1815,"_24443":1795,"_17120":45494,"_5":17015,"_23194":45440,"_2329":45495},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2802":1816,"_24443":1795,"_17120":45497,"_5":17015,"_23194":45440,"_2329":45498},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2802":1817,"_24443":1795,"_17120":45500,"_5":17015,"_23194":45440,"_2329":45501},[],"For browser key generation, follow Issue your first certificate.",{"_2802":1818,"_24443":1795,"_17120":45503,"_5":17015,"_23194":45444,"_2329":45504},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2802":1819,"_24443":1795,"_17120":45506,"_5":17015,"_23194":45448,"_2329":45507},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2802":1820,"_24443":1795,"_17120":45509,"_5":17015,"_23194":45452,"_2329":45510},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2802":1821,"_24443":1795,"_17120":45512,"_5":17015,"_23194":45456,"_2329":45513},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2802":1822,"_24443":1795,"_17120":45515,"_5":17015,"_23194":45456,"_2329":45516},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2802":1823,"_24443":1795,"_17120":45518,"_5":17015,"_23194":45456,"_2329":45519},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2802":1824,"_24443":1795,"_17120":45521,"_5":17015,"_23194":45460,"_2329":45522},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2802":1825,"_24443":1795,"_17120":45524,"_5":17015,"_23194":45460,"_2329":45525},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2802":1826,"_24443":1795,"_17120":45527,"_5":17015,"_23194":45460,"_2329":45528},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2802":1827,"_24443":1795,"_17120":45530,"_5":17015,"_23194":45464,"_2329":45531},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2802":1828,"_24443":1795,"_17120":45533,"_5":17015,"_23194":45464,"_2329":45534},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2802":1829,"_24443":1829,"_5":12033,"_2329":45536,"_24778":45537,"_17120":45539,"_23194":1829},"Certificate lifecycle",[39822,41166,44681,45538],"Concepts",[],{"_2802":1830,"_24443":1829,"_17120":45541,"_5":17015,"_23194":1829,"_2329":45542},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2802":1831,"_24443":1829,"_5":24775,"_17120":45544,"_23194":45545,"_2329":45546},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2802":1832,"_24443":1829,"_5":24775,"_17120":45548,"_23194":45549,"_2329":45550},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2802":1833,"_24443":1829,"_5":24775,"_17120":45552,"_23194":45553,"_2329":45554},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2802":1834,"_24443":1829,"_5":24775,"_17120":45556,"_23194":45557,"_2329":45558},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2802":1835,"_24443":1829,"_5":24775,"_17120":45560,"_23194":45561,"_2329":45562},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2802":1836,"_24443":1829,"_5":24775,"_17120":45564,"_23194":45565,"_2329":45566},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2802":1837,"_24443":1829,"_5":24775,"_17120":45568,"_23194":45569,"_2329":45570},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2802":1838,"_24443":1829,"_5":24775,"_17120":45572,"_23194":45573,"_2329":45574},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2802":1839,"_24443":1829,"_5":24775,"_17120":45576,"_23194":45577,"_2329":45578},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2802":1840,"_24443":1829,"_5":24775,"_17120":45580,"_23194":45581,"_2329":45582},[],"/docs/pr-preview/pr-28/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2802":1841,"_24443":1829,"_17120":45584,"_5":17015,"_23194":1829,"_2329":45585},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2802":1842,"_24443":1829,"_17120":45587,"_5":17015,"_23194":45549,"_2329":45588},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2802":1843,"_24443":1829,"_17120":45590,"_5":17015,"_23194":45553,"_2329":45591},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2802":1844,"_24443":1829,"_17120":45593,"_5":17015,"_23194":45557,"_2329":45594},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2802":1845,"_24443":1829,"_17120":45596,"_5":17015,"_23194":45561,"_2329":45597},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2802":1846,"_24443":1829,"_17120":45599,"_5":17015,"_23194":45565,"_2329":45600},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2802":1847,"_24443":1829,"_17120":45602,"_5":17015,"_23194":45569,"_2329":45603},[],"Lamassu persists four X.509 states:",{"_2802":1848,"_24443":1829,"_17120":45605,"_5":17015,"_23194":45569,"_2329":45606},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2802":1849,"_24443":1829,"_17120":45608,"_5":17015,"_23194":45569,"_2329":45609},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2802":1850,"_24443":1829,"_17120":45611,"_5":17015,"_23194":45569,"_2329":45612},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2802":1851,"_24443":1829,"_17120":45614,"_5":17015,"_23194":45569,"_2329":45615},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2802":1852,"_24443":1829,"_17120":45617,"_5":17015,"_23194":45569,"_2329":45618},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2802":1853,"_24443":1829,"_17120":45620,"_5":17015,"_23194":45573,"_2329":45621},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2802":1854,"_24443":1829,"_17120":45623,"_5":17015,"_23194":45573,"_2329":45624},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2802":1855,"_24443":1829,"_17120":45626,"_5":17015,"_23194":45573,"_2329":45627},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2802":1856,"_24443":1829,"_17120":45629,"_5":17015,"_23194":45577,"_2329":45630},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2802":1857,"_24443":1829,"_17120":45632,"_5":17015,"_23194":45577,"_2329":45633},[],"Before confirming:",{"_2802":1858,"_24443":1829,"_17120":45635,"_5":17015,"_23194":45577,"_2329":45636},[],"Identify DMSs, devices and services that trust that chain.",{"_2802":1859,"_24443":1829,"_17120":45638,"_5":17015,"_23194":45577,"_2329":45639},[],"Distribute the new chain of trust.",{"_2802":1860,"_24443":1829,"_17120":45641,"_5":17015,"_23194":45577,"_2329":45642},[],"Reissue the necessary identities.",{"_2802":1861,"_24443":1829,"_17120":45644,"_5":17015,"_23194":45577,"_2329":45645},[],"Check OCSP and CRL from a real consumer.",{"_2802":1862,"_24443":1829,"_17120":45647,"_5":17015,"_23194":45577,"_2329":45648},[],"Revoke the old CA once no legitimate traffic remains.",{"_2802":1863,"_24443":1829,"_17120":45650,"_5":17015,"_23194":45577,"_2329":45651},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2802":1864,"_24443":1829,"_17120":45653,"_5":17015,"_23194":45581,"_2329":45654},[],"Certificates entering the preventive or critical renewal window.",{"_2802":1865,"_24443":1829,"_17120":45656,"_5":17015,"_23194":45581,"_2329":45657},[],"Repeated enrollment or re-enrollment failures.",{"_2802":1866,"_24443":1829,"_17120":45659,"_5":17015,"_23194":45581,"_2329":45660},[],"Status changes and revocation reasons.",{"_2802":1867,"_24443":1829,"_17120":45662,"_5":17015,"_23194":45581,"_2329":45663},[],"OCSP and CRL publication and validity.",{"_2802":1868,"_24443":1829,"_17120":45665,"_5":17015,"_23194":45581,"_2329":45666},[],"Dependencies still presenting a replaced certificate.",{"_2802":1869,"_24443":1829,"_17120":45668,"_5":17015,"_23194":45581,"_2329":45669},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2802":1870,"_24443":1870,"_5":12033,"_2329":45671,"_24778":45672,"_17120":45673,"_23194":1870},"Trust model",[39822,41166,44681,45538],[],{"_2802":1871,"_24443":1870,"_17120":45675,"_5":17015,"_23194":1870,"_2329":45676},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2802":1872,"_24443":1870,"_5":24775,"_17120":45678,"_23194":45679,"_2329":45680},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2802":1873,"_24443":1870,"_5":24775,"_17120":45682,"_23194":45683,"_2329":45684},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2802":1874,"_24443":1870,"_5":24775,"_17120":45686,"_23194":45687,"_2329":45688},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2802":1875,"_24443":1870,"_5":24775,"_17120":45690,"_23194":45691,"_2329":45692},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2802":1876,"_24443":1870,"_5":24775,"_17120":45694,"_23194":45695,"_2329":45696},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2802":1877,"_24443":1870,"_5":24775,"_17120":45698,"_23194":45699,"_2329":45700},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2802":1878,"_24443":1870,"_5":24775,"_17120":45702,"_23194":45703,"_2329":45704},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2802":1879,"_24443":1870,"_5":24775,"_17120":45706,"_23194":45707,"_2329":45708},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2802":1880,"_24443":1870,"_5":24775,"_17120":45710,"_23194":45711,"_2329":45712},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2802":1881,"_24443":1870,"_5":24775,"_17120":45714,"_23194":45715,"_2329":45716},[],"/docs/pr-preview/pr-28/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2802":1882,"_24443":1870,"_17120":45718,"_5":17015,"_23194":1870,"_2329":45719},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2802":1883,"_24443":1870,"_17120":45721,"_5":17015,"_23194":45683,"_2329":45722},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2802":1884,"_24443":1870,"_17120":45724,"_5":17015,"_23194":45687,"_2329":45725},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2802":1885,"_24443":1870,"_17120":45727,"_5":17015,"_23194":45691,"_2329":45728},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2802":1886,"_24443":1870,"_17120":45730,"_5":17015,"_23194":45695,"_2329":45731},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2802":1887,"_24443":1870,"_17120":45733,"_5":17015,"_23194":45699,"_2329":45734},[],"The device proves it can enroll according to the DMS policy.",{"_2802":1888,"_24443":1870,"_17120":45736,"_5":17015,"_23194":45699,"_2329":45737},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2802":1889,"_24443":1870,"_17120":45739,"_5":17015,"_23194":45699,"_2329":45740},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2802":1890,"_24443":1870,"_17120":45742,"_5":17015,"_23194":45699,"_2329":45743},[],"The device installs the certificate and the chain it needs.",{"_2802":1891,"_24443":1870,"_17120":45745,"_5":17015,"_23194":45699,"_2329":45746},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2802":1892,"_24443":1870,"_17120":45748,"_5":17015,"_23194":45699,"_2329":45749},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2802":1893,"_24443":1870,"_17120":45751,"_5":17015,"_23194":45703,"_2329":45752},[],"A DMS relates three sets that are worth designing separately:",{"_2802":1894,"_24443":1870,"_17120":45754,"_5":17015,"_23194":45703,"_2329":45755},[],"**Enrollment CA:** signs the new identities.",{"_2802":1895,"_24443":1870,"_17120":45757,"_5":17015,"_23194":45703,"_2329":45758},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs.",{"_2802":1896,"_24443":1870,"_17120":45760,"_5":17015,"_23194":45703,"_2329":45761},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2802":1897,"_24443":1870,"_17120":45763,"_5":17015,"_23194":45703,"_2329":45764},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2802":1898,"_24443":1870,"_17120":45766,"_5":17015,"_23194":45707,"_2329":45767},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2802":1899,"_24443":1870,"_17120":45769,"_5":17015,"_23194":45707,"_2329":45770},[],"that the current date is between `Not Before` and `Not After`;",{"_2802":1900,"_24443":1870,"_17120":45772,"_5":17015,"_23194":45707,"_2329":45773},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2802":1901,"_24443":1870,"_17120":45775,"_5":17015,"_23194":45707,"_2329":45776},[],"that names, SANs and subject match the expected identity;",{"_2802":1902,"_24443":1870,"_17120":45778,"_5":17015,"_23194":45707,"_2329":45779},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2802":1903,"_24443":1870,"_17120":45781,"_5":17015,"_23194":45707,"_2329":45782},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2802":1904,"_24443":1870,"_17120":45784,"_5":17015,"_23194":45707,"_2329":45785},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2802":1905,"_24443":1870,"_17120":45787,"_5":17015,"_23194":45711,"_2329":45788},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2802":1906,"_24443":1870,"_17120":45790,"_5":17015,"_23194":45715,"_2329":45791},[],"Keep the root out of daily operations, or with very restricted access.",{"_2802":1907,"_24443":1870,"_17120":45793,"_5":17015,"_23194":45715,"_2329":45794},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2802":1908,"_24443":1870,"_17120":45796,"_5":17015,"_23194":45715,"_2329":45797},[],"Assign explicit profiles to every use case.",{"_2802":1909,"_24443":1870,"_17120":45799,"_5":17015,"_23194":45715,"_2329":45800},[],"Distribute the new trust before starting a rotation.",{"_2802":1910,"_24443":1870,"_17120":45802,"_5":17015,"_23194":45715,"_2329":45803},[],"Keep enough overlap to renew a disconnected fleet.",{"_2802":1911,"_24443":1870,"_17120":45805,"_5":17015,"_23194":45715,"_2329":45806},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2802":1912,"_24443":1870,"_17120":45808,"_5":17015,"_23194":45715,"_2329":45809},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2802":1913,"_24443":1913,"_5":12033,"_2329":45811,"_24778":45812,"_17120":45813,"_23194":1913},"Revocation lists (CRL)",[39822,41166,44681,45298],[],{"_2802":1914,"_24443":1913,"_17120":45815,"_5":17015,"_23194":1913,"_2329":45816},[],"Generate and distribute signed lists to validate certificates offline.",{"_2802":1915,"_24443":1913,"_5":24775,"_17120":45818,"_23194":45819,"_2329":45820},[],"/docs/pr-preview/pr-28/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2802":1916,"_24443":1913,"_5":24775,"_17120":45822,"_23194":45823,"_2329":45824},[],"/docs/pr-preview/pr-28/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2802":1917,"_24443":1913,"_5":24775,"_17120":45826,"_23194":45827,"_2329":45828},[],"/docs/pr-preview/pr-28/platform/pki/crl#crl-contents","CRL contents",{"_2802":1918,"_24443":1913,"_5":24775,"_17120":45830,"_23194":45831,"_2329":45832},[],"/docs/pr-preview/pr-28/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2802":1919,"_24443":1913,"_5":24775,"_17120":45834,"_23194":45835,"_2329":45836},[],"/docs/pr-preview/pr-28/platform/pki/crl#va-role-management-api","VA role management API",{"_2802":1920,"_24443":1913,"_5":24775,"_17120":45838,"_23194":45839,"_2329":45840},[],"/docs/pr-preview/pr-28/platform/pki/crl#from-the-interface","From the interface",{"_2802":1921,"_24443":1913,"_5":24775,"_17120":45842,"_23194":45843,"_2329":45844},[],"/docs/pr-preview/pr-28/platform/pki/crl#references","References",{"_2802":1922,"_24443":1913,"_17120":45846,"_5":17015,"_23194":1913,"_2329":45847},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2802":1923,"_24443":1913,"_17120":45849,"_5":17015,"_23194":45819,"_2329":45850},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2802":1924,"_24443":1913,"_17120":45852,"_5":17015,"_23194":45819,"_2329":45853},[],"`crl_options` field",{"_2802":1925,"_24443":1913,"_17120":45855,"_5":17015,"_23194":45819,"_2329":40205},[],{"_2802":1926,"_24443":1913,"_17120":45857,"_5":17015,"_23194":45819,"_2329":45858},[],"Backend initial value",{"_2802":1927,"_24443":1913,"_17120":45860,"_5":17015,"_23194":45819,"_2329":45861},[],"`validity`",{"_2802":1928,"_24443":1913,"_17120":45863,"_5":17015,"_23194":45819,"_2329":45864},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2802":1929,"_24443":1913,"_17120":45866,"_5":17015,"_23194":45819,"_2329":45867},[],"7 days.",{"_2802":1930,"_24443":1913,"_17120":45869,"_5":17015,"_23194":45819,"_2329":45870},[],"`refresh_interval`",{"_2802":1931,"_24443":1913,"_17120":45872,"_5":17015,"_23194":45819,"_2329":45873},[],"Time since publication that triggers scheduled renewal.",{"_2802":1932,"_24443":1913,"_17120":45875,"_5":17015,"_23194":45819,"_2329":45876},[],"6 days and 23 hours.",{"_2802":1933,"_24443":1913,"_17120":45878,"_5":17015,"_23194":45819,"_2329":45879},[],"`regenerate_on_revoke`",{"_2802":1934,"_24443":1913,"_17120":45881,"_5":17015,"_23194":45819,"_2329":45882},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2802":1935,"_24443":1913,"_17120":45884,"_5":17015,"_23194":45819,"_2329":45885},[],"`true`.",{"_2802":1936,"_24443":1913,"_17120":45887,"_5":17015,"_23194":45819,"_2329":45888},[],"`subject_key_id_signer`",{"_2802":1937,"_24443":1913,"_17120":45890,"_5":17015,"_23194":45819,"_2329":45891},[],"Configuration field initialized with the CA’s SKI.",{"_2802":1938,"_24443":1913,"_17120":45893,"_5":17015,"_23194":45819,"_2329":45894},[],"CA SKI.",{"_2802":1939,"_24443":1913,"_17120":45896,"_5":17015,"_23194":45819,"_2329":45897},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2802":1940,"_24443":1913,"_17120":45899,"_5":17015,"_23194":45819,"_2329":45900},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2802":1941,"_24443":1913,"_17120":45902,"_5":17015,"_23194":45823,"_2329":45903},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2802":1942,"_24443":1913,"_17120":45905,"_5":17015,"_23194":45823,"_2329":45906},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2802":1943,"_24443":1913,"_17120":45908,"_5":17015,"_23194":45823,"_2329":45909},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2802":1944,"_24443":1913,"_17120":45911,"_5":17015,"_23194":45827,"_2329":45912},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2802":1945,"_24443":1913,"_17120":45914,"_5":17015,"_23194":45827,"_2329":45915},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2802":1946,"_24443":1913,"_17120":45917,"_5":17015,"_23194":45831,"_2329":45918},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2802":1947,"_24443":1913,"_17120":45920,"_5":17015,"_23194":45831,"_2329":45921},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2802":1948,"_24443":1913,"_17120":45923,"_5":17015,"_23194":45831,"_2329":45924},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2802":1949,"_24443":1913,"_17120":45926,"_5":17015,"_23194":45831,"_2329":45927},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2802":1950,"_24443":1913,"_17120":45929,"_5":17015,"_23194":45831,"_2329":45930},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2802":1951,"_24443":1913,"_17120":45932,"_5":17015,"_23194":45835,"_2329":45933},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2802":1952,"_24443":1913,"_17120":45935,"_5":17015,"_23194":45835,"_2329":42754},[],{"_2802":1953,"_24443":1913,"_17120":45937,"_5":17015,"_23194":45835,"_2329":45938},[],"Relative path",{"_2802":1954,"_24443":1913,"_17120":45940,"_5":17015,"_23194":45835,"_2329":42751},[],{"_2802":1955,"_24443":1913,"_17120":45942,"_5":17015,"_23194":45835,"_2329":45943},[],"`GET`",{"_2802":1956,"_24443":1913,"_17120":45945,"_5":17015,"_23194":45835,"_2329":45946},[],"`/v1/roles/{ca-ski}`",{"_2802":1957,"_24443":1913,"_17120":45948,"_5":17015,"_23194":45835,"_2329":45949},[],"Read `crl_options` and `latest_crl`.",{"_2802":1958,"_24443":1913,"_17120":45951,"_5":17015,"_23194":45835,"_2329":45952},[],"`PUT`",{"_2802":1959,"_24443":1913,"_17120":45954,"_5":17015,"_23194":45835,"_2329":45946},[],{"_2802":1960,"_24443":1913,"_17120":45956,"_5":17015,"_23194":45835,"_2329":45957},[],"Replace CRL configuration.",{"_2802":1961,"_24443":1913,"_17120":45959,"_5":17015,"_23194":45835,"_2329":45960},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2802":1962,"_24443":1913,"_17120":45962,"_5":17015,"_23194":45835,"_2329":45963},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2802":1963,"_24443":1913,"_17120":45965,"_5":17015,"_23194":45839,"_2329":45966},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2802":1964,"_24443":1913,"_17120":45968,"_5":17015,"_23194":45843,"_2329":45969},[],"RFC 5280: X.509 and CRL profile.",{"_2802":1965,"_24443":1913,"_17120":45971,"_5":17015,"_23194":45843,"_2329":45972},[],"OpenSSL: openssl-crl.",{"_2802":1966,"_24443":1913,"_17120":45974,"_5":17015,"_23194":45843,"_2329":45975},[],"OpenSSL: openssl-verify.",{"_2802":1967,"_24443":1913,"_17120":45977,"_5":17015,"_23194":45843,"_2329":45978},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2802":1968,"_24443":1913,"_17120":45980,"_5":17015,"_23194":45843,"_2329":45981},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2802":1969,"_24443":1969,"_5":12033,"_2329":45983,"_24778":45984,"_17120":45985,"_23194":1969},"Keys and cryptographic engines",[39822,41166,44681,44682],[],{"_2802":1970,"_24443":1969,"_17120":45987,"_5":17015,"_23194":1969,"_2329":45988},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2802":1971,"_24443":1969,"_5":24775,"_17120":45990,"_23194":45991,"_2329":45992},[],"/docs/pr-preview/pr-28/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2802":1972,"_24443":1969,"_5":24775,"_17120":45994,"_23194":45995,"_2329":45996},[],"/docs/pr-preview/pr-28/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2802":1973,"_24443":1969,"_5":24775,"_17120":45998,"_23194":45999,"_2329":46000},[],"/docs/pr-preview/pr-28/platform/pki/key-management#file-system","File System",{"_2802":1974,"_24443":1969,"_5":24775,"_17120":46002,"_23194":46003,"_2329":46004},[],"/docs/pr-preview/pr-28/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2802":1975,"_24443":1969,"_5":24775,"_17120":46006,"_23194":46007,"_2329":46008},[],"/docs/pr-preview/pr-28/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2802":1976,"_24443":1969,"_5":24775,"_17120":46010,"_23194":46011,"_2329":46012},[],"/docs/pr-preview/pr-28/platform/pki/key-management#aws-kms","AWS KMS",{"_2802":1977,"_24443":1969,"_5":24775,"_17120":46014,"_23194":46015,"_2329":46016},[],"/docs/pr-preview/pr-28/platform/pki/key-management#pkcs11","PKCS#11",{"_2802":1978,"_24443":1969,"_5":24775,"_17120":46018,"_23194":46019,"_2329":46020},[],"/docs/pr-preview/pr-28/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2802":1979,"_24443":1969,"_5":24775,"_17120":46022,"_23194":46023,"_2329":46024},[],"/docs/pr-preview/pr-28/platform/pki/key-management#key-inventory","Key inventory",{"_2802":1980,"_24443":1969,"_5":24775,"_17120":46026,"_23194":46027,"_2329":46028},[],"/docs/pr-preview/pr-28/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2802":1981,"_24443":1969,"_5":24775,"_17120":46030,"_23194":46031,"_2329":46032},[],"/docs/pr-preview/pr-28/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2802":1982,"_24443":1969,"_5":24775,"_17120":46034,"_23194":46035,"_2329":46036},[],"/docs/pr-preview/pr-28/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2802":1983,"_24443":1969,"_5":24775,"_17120":46038,"_23194":46039,"_2329":46040},[],"/docs/pr-preview/pr-28/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2802":1984,"_24443":1969,"_5":24775,"_17120":46042,"_23194":46043,"_2329":46044},[],"/docs/pr-preview/pr-28/platform/pki/key-management#view-details","View details",{"_2802":1985,"_24443":1969,"_5":24775,"_17120":46046,"_23194":46047,"_2329":46048},[],"/docs/pr-preview/pr-28/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2802":1986,"_24443":1969,"_5":24775,"_17120":46050,"_23194":46051,"_2329":46052},[],"/docs/pr-preview/pr-28/platform/pki/key-management#sign","Sign",{"_2802":1987,"_24443":1969,"_5":24775,"_17120":46054,"_23194":46055,"_2329":46056},[],"/docs/pr-preview/pr-28/platform/pki/key-management#verify","Verify",{"_2802":1988,"_24443":1969,"_5":24775,"_17120":46058,"_23194":46059,"_2329":46060},[],"/docs/pr-preview/pr-28/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2802":1989,"_24443":1969,"_5":24775,"_17120":46062,"_23194":46063,"_2329":46064},[],"/docs/pr-preview/pr-28/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2802":1990,"_24443":1969,"_5":24775,"_17120":46066,"_23194":46067,"_2329":46068},[],"/docs/pr-preview/pr-28/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2802":1991,"_24443":1969,"_17120":46070,"_5":17015,"_23194":1969,"_2329":46071},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2802":1992,"_24443":1969,"_17120":46073,"_5":17015,"_23194":1969,"_2329":46074},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2802":1993,"_24443":1969,"_17120":46076,"_5":17015,"_23194":45991,"_2329":46077},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2802":1994,"_24443":1969,"_17120":46079,"_5":17015,"_23194":45991,"_2329":46080},[],"In practice, it lets you:",{"_2802":1995,"_24443":1969,"_17120":46082,"_5":17015,"_23194":45991,"_2329":46083},[],"Generate new key pairs from Lamassu IoT.",{"_2802":1996,"_24443":1969,"_17120":46085,"_5":17015,"_23194":45991,"_2329":46086},[],"Import keys created externally.",{"_2802":1997,"_24443":1969,"_17120":46088,"_5":17015,"_23194":45991,"_2329":46089},[],"Delegate custody and cryptographic operations to external engines.",{"_2802":1998,"_24443":1969,"_17120":46091,"_5":17015,"_23194":45991,"_2329":46092},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2802":1999,"_24443":1969,"_17120":46094,"_5":17015,"_23194":45995,"_2329":46095},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2802":2000,"_24443":1969,"_17120":46097,"_5":17015,"_23194":45995,"_2329":46098},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2802":2001,"_24443":1969,"_17120":46100,"_5":17015,"_23194":45995,"_2329":46101},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2802":2002,"_24443":1969,"_17120":46103,"_5":17015,"_23194":45999,"_2329":46104},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2802":2003,"_24443":1969,"_17120":46106,"_5":17015,"_23194":46003,"_2329":46107},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2802":2004,"_24443":1969,"_17120":46109,"_5":17015,"_23194":46007,"_2329":46110},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2802":2005,"_24443":1969,"_17120":46112,"_5":17015,"_23194":46011,"_2329":46113},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2802":2006,"_24443":1969,"_17120":46115,"_5":17015,"_23194":46015,"_2329":46116},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2802":2007,"_24443":1969,"_17120":46118,"_5":17015,"_23194":46019,"_2329":46119},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2802":2008,"_24443":1969,"_17120":46121,"_5":17015,"_23194":46019,"_2329":46122},[],"Lamassu shows the enabled engines in the console.",{"_2802":2009,"_24443":1969,"_17120":46124,"_5":17015,"_23194":46019,"_2329":46125},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2802":2010,"_24443":1969,"_17120":46127,"_5":17015,"_23194":46019,"_2329":46128},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2802":2011,"_24443":1969,"_17120":46130,"_5":17015,"_23194":46023,"_2329":46131},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2802":2012,"_24443":1969,"_17120":46133,"_5":17015,"_23194":46023,"_2329":46134},[],"The table includes the following fields:",{"_2802":2013,"_24443":1969,"_17120":46136,"_5":17015,"_23194":46023,"_2329":46137},[],"**Name**: descriptive name of the key.",{"_2802":2014,"_24443":1969,"_17120":46139,"_5":17015,"_23194":46023,"_2329":46140},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2802":2015,"_24443":1969,"_17120":46142,"_5":17015,"_23194":46023,"_2329":46143},[],"**Strength**: visual indicator of cryptographic strength.",{"_2802":2016,"_24443":1969,"_17120":46145,"_5":17015,"_23194":46023,"_2329":46146},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2802":2017,"_24443":1969,"_17120":46148,"_5":17015,"_23194":46023,"_2329":46149},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2802":2018,"_24443":1969,"_17120":46151,"_5":17015,"_23194":46023,"_2329":46152},[],"**Aliases**: alternative names associated with the key.",{"_2802":2019,"_24443":1969,"_17120":46154,"_5":17015,"_23194":46023,"_2329":46155},[],"**Tags**: labels for classification and search.",{"_2802":2020,"_24443":1969,"_17120":46157,"_5":17015,"_23194":46023,"_2329":46158},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2802":2021,"_24443":1969,"_17120":46160,"_5":17015,"_23194":46023,"_2329":46161},[],"From this view you also reach the most common actions:",{"_2802":2022,"_24443":1969,"_17120":46163,"_5":17015,"_23194":46023,"_2329":46164},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2802":2023,"_24443":1969,"_17120":46166,"_5":17015,"_23194":46023,"_2329":46167},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2802":2024,"_24443":1969,"_17120":46169,"_5":17015,"_23194":46023,"_2329":46170},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2802":2025,"_24443":1969,"_17120":46172,"_5":17015,"_23194":46023,"_2329":46173},[],"**Delete Key** to remove the key from the system.",{"_2802":2026,"_24443":1969,"_17120":46175,"_5":17015,"_23194":46027,"_2329":46176},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2802":2027,"_24443":1969,"_17120":46178,"_5":17015,"_23194":46031,"_2329":46179},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2802":2028,"_24443":1969,"_17120":46181,"_5":17015,"_23194":46031,"_2329":46182},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2802":2029,"_24443":1969,"_17120":46184,"_5":17015,"_23194":46031,"_2329":46185},[],"**Key Name**: unique and descriptive name.",{"_2802":2030,"_24443":1969,"_17120":46187,"_5":17015,"_23194":46031,"_2329":46188},[],"**Crypto Engine**: engine that will keep the key.",{"_2802":2031,"_24443":1969,"_17120":46190,"_5":17015,"_23194":46031,"_2329":46191},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2802":2032,"_24443":1969,"_17120":46193,"_5":17015,"_23194":46031,"_2329":46194},[],"**Tags**: metadata to classify the key.",{"_2802":2033,"_24443":1969,"_17120":46196,"_5":17015,"_23194":46031,"_2329":46197},[],"**Metadata**: additional information for advanced uses.",{"_2802":2034,"_24443":1969,"_17120":46199,"_5":17015,"_23194":46035,"_2329":46200},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2802":2035,"_24443":1969,"_17120":46202,"_5":17015,"_23194":46035,"_2329":46203},[],"When you have an exportable private key and the destination engine supports import.",{"_2802":2036,"_24443":1969,"_17120":46205,"_5":17015,"_23194":46035,"_2329":46206},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2802":2037,"_24443":1969,"_17120":46208,"_5":17015,"_23194":46035,"_2329":46209},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2802":2038,"_24443":1969,"_17120":46211,"_5":17015,"_23194":46035,"_2329":46212},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2802":2039,"_24443":1969,"_17120":46214,"_5":17015,"_23194":46035,"_2329":46215},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2802":2040,"_24443":1969,"_17120":46217,"_5":17015,"_23194":46035,"_2329":46218},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2802":2041,"_24443":1969,"_17120":46220,"_5":17015,"_23194":46035,"_2329":46221},[],"**Tags**: labels for organization and search.",{"_2802":2042,"_24443":1969,"_17120":46223,"_5":17015,"_23194":46035,"_2329":46224},[],"**Metadata**: additional optional information.",{"_2802":2043,"_24443":1969,"_17120":46226,"_5":17015,"_23194":46035,"_2329":46227},[],"**Private Key (PEM)**: private key in PEM format.",{"_2802":2044,"_24443":1969,"_17120":46229,"_5":17015,"_23194":46035,"_2329":46230},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2802":2045,"_24443":1969,"_17120":46232,"_5":17015,"_23194":46039,"_2329":46233},[],"Each registered key has a detail view and several operational actions.",{"_2802":2046,"_24443":1969,"_17120":46235,"_5":17015,"_23194":46043,"_2329":46236},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2802":2047,"_24443":1969,"_17120":46238,"_5":17015,"_23194":46043,"_2329":46239},[],"The **Overview** tab shows, among others, these fields:",{"_2802":2048,"_24443":1969,"_17120":46241,"_5":17015,"_23194":46043,"_2329":46242},[],"**Key Name**: descriptive name.",{"_2802":2049,"_24443":1969,"_17120":46244,"_5":17015,"_23194":46043,"_2329":46245},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2802":2050,"_24443":1969,"_17120":46247,"_5":17015,"_23194":46043,"_2329":46248},[],"**Tags**: associated labels.",{"_2802":2051,"_24443":1969,"_17120":46250,"_5":17015,"_23194":46043,"_2329":46251},[],"**Aliases**: alternative names.",{"_2802":2052,"_24443":1969,"_17120":46253,"_5":17015,"_23194":46043,"_2329":46254},[],"**Crypto Engine**: engine where the key resides.",{"_2802":2053,"_24443":1969,"_17120":46256,"_5":17015,"_23194":46043,"_2329":46257},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2802":2054,"_24443":1969,"_17120":46259,"_5":17015,"_23194":46043,"_2329":46260},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2802":2055,"_24443":1969,"_17120":46262,"_5":17015,"_23194":46043,"_2329":46263},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2802":2056,"_24443":1969,"_17120":46265,"_5":17015,"_23194":46047,"_2329":46266},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2802":2057,"_24443":1969,"_17120":46268,"_5":17015,"_23194":46047,"_2329":46269},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2802":2058,"_24443":1969,"_17120":46271,"_5":17015,"_23194":46047,"_2329":46272},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2802":2059,"_24443":1969,"_17120":46274,"_5":17015,"_23194":46051,"_2329":46275},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2802":2060,"_24443":1969,"_17120":46277,"_5":17015,"_23194":46051,"_2329":46278},[],"Main fields:",{"_2802":2061,"_24443":1969,"_17120":46280,"_5":17015,"_23194":46051,"_2329":46281},[],"**Algorithm**: signing algorithm available for the key type.",{"_2802":2062,"_24443":1969,"_17120":46283,"_5":17015,"_23194":46051,"_2329":46284},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2802":2063,"_24443":1969,"_17120":46286,"_5":17015,"_23194":46051,"_2329":46287},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2802":2064,"_24443":1969,"_17120":46289,"_5":17015,"_23194":46051,"_2329":46290},[],"**Message**: content to sign.",{"_2802":2065,"_24443":1969,"_17120":46292,"_5":17015,"_23194":46051,"_2329":46293},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2802":2066,"_24443":1969,"_17120":46295,"_5":17015,"_23194":46055,"_2329":46296},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2802":2067,"_24443":1969,"_17120":46298,"_5":17015,"_23194":46055,"_2329":46278},[],{"_2802":2068,"_24443":1969,"_17120":46300,"_5":17015,"_23194":46055,"_2329":46301},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2802":2069,"_24443":1969,"_17120":46303,"_5":17015,"_23194":46055,"_2329":46304},[],"**Message Type**: `Raw` or `Digest`.",{"_2802":2070,"_24443":1969,"_17120":46306,"_5":17015,"_23194":46055,"_2329":46307},[],"**Payload Encoding**: encoding of the message.",{"_2802":2071,"_24443":1969,"_17120":46309,"_5":17015,"_23194":46055,"_2329":46310},[],"**Message**: original message or hash.",{"_2802":2072,"_24443":1969,"_17120":46312,"_5":17015,"_23194":46055,"_2329":46313},[],"**Signature**: signature to check.",{"_2802":2073,"_24443":1969,"_17120":46315,"_5":17015,"_23194":46055,"_2329":46316},[],"**Result**: indicator of the validation result.",{"_2802":2074,"_24443":1969,"_17120":46318,"_5":17015,"_23194":46059,"_2329":46319},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2802":2075,"_24443":1969,"_17120":46321,"_5":17015,"_23194":46059,"_2329":46322},[],"This flow is useful for:",{"_2802":2076,"_24443":1969,"_17120":46324,"_5":17015,"_23194":46059,"_2329":46325},[],"Requesting certificates from an external CA.",{"_2802":2077,"_24443":1969,"_17120":46327,"_5":17015,"_23194":46059,"_2329":46328},[],"Renewing an identity while keeping the same key.",{"_2802":2078,"_24443":1969,"_17120":46330,"_5":17015,"_23194":46059,"_2329":46331},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2802":2079,"_24443":1969,"_17120":46333,"_5":17015,"_23194":46059,"_2329":46334},[],"**Common Name (CN)**: main name of the identity.",{"_2802":2080,"_24443":1969,"_17120":46336,"_5":17015,"_23194":46059,"_2329":46337},[],"**Organization (O)**: organization or company.",{"_2802":2081,"_24443":1969,"_17120":46339,"_5":17015,"_23194":46059,"_2329":46340},[],"**Organizational Unit (OU)**: department or unit.",{"_2802":2082,"_24443":1969,"_17120":46342,"_5":17015,"_23194":46059,"_2329":46343},[],"**Country (C)**: two-letter country code.",{"_2802":2083,"_24443":1969,"_17120":46345,"_5":17015,"_23194":46059,"_2329":46346},[],"**State / Province (ST)**: state or province.",{"_2802":2084,"_24443":1969,"_17120":46348,"_5":17015,"_23194":46059,"_2329":46349},[],"**Locality (L)**: city or locality.",{"_2802":2085,"_24443":1969,"_17120":46351,"_5":17015,"_23194":46059,"_2329":46352},[],"**Email Address**: contact email.",{"_2802":2086,"_24443":1969,"_17120":46354,"_5":17015,"_23194":46059,"_2329":46355},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2802":2087,"_24443":1969,"_17120":46357,"_5":17015,"_23194":46059,"_2329":46358},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2802":2088,"_24443":1969,"_17120":46360,"_5":17015,"_23194":46063,"_2329":46361},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2802":2089,"_24443":1969,"_17120":46363,"_5":17015,"_23194":46063,"_2329":46364},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2802":2090,"_24443":1969,"_17120":46366,"_5":17015,"_23194":46067,"_2329":46367},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2802":2091,"_24443":2091,"_5":12033,"_2329":46369,"_24778":46370,"_17120":46371,"_23194":2091},"Online validation with OCSP",[39822,41166,44681,45298],[],{"_2802":2092,"_24443":2091,"_17120":46373,"_5":17015,"_23194":2091,"_2329":46374},[],"Query signed status and verify the responder’s response.",{"_2802":2093,"_24443":2091,"_5":24775,"_17120":46376,"_23194":46377,"_2329":46378},[],"/docs/pr-preview/pr-28/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2802":2094,"_24443":2091,"_5":24775,"_17120":46380,"_23194":46381,"_2329":46382},[],"/docs/pr-preview/pr-28/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2802":2095,"_24443":2091,"_5":24775,"_17120":46384,"_23194":46385,"_2329":46386},[],"/docs/pr-preview/pr-28/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2802":2096,"_24443":2091,"_5":24775,"_17120":46388,"_23194":46389,"_2329":46390},[],"/docs/pr-preview/pr-28/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2802":2097,"_24443":2091,"_5":24775,"_17120":46392,"_23194":46393,"_2329":46394},[],"/docs/pr-preview/pr-28/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2802":2098,"_24443":2091,"_5":24775,"_17120":46396,"_23194":46397,"_2329":45844},[],"/docs/pr-preview/pr-28/platform/pki/ocsp#references",{"_2802":2099,"_24443":2091,"_17120":46399,"_5":17015,"_23194":2091,"_2329":46400},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2802":2100,"_24443":2091,"_17120":46402,"_5":17015,"_23194":46377,"_2329":46403},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2802":2101,"_24443":2091,"_17120":46405,"_5":17015,"_23194":46377,"_2329":46406},[],"Record status",{"_2802":2102,"_24443":2091,"_17120":46408,"_5":17015,"_23194":46377,"_2329":46409},[],"Signed response",{"_2802":2103,"_24443":2091,"_17120":46411,"_5":17015,"_23194":46377,"_2329":43859},[],{"_2802":2104,"_24443":2091,"_17120":46413,"_5":17015,"_23194":46377,"_2329":46414},[],"`Good`.",{"_2802":2105,"_24443":2091,"_17120":46416,"_5":17015,"_23194":46377,"_2329":43876},[],{"_2802":2106,"_24443":2091,"_17120":46418,"_5":17015,"_23194":46377,"_2329":46419},[],"`Revoked`, with revocation reason and timestamp.",{"_2802":2107,"_24443":2091,"_17120":46421,"_5":17015,"_23194":46377,"_2329":46422},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2802":2108,"_24443":2091,"_17120":46424,"_5":17015,"_23194":46377,"_2329":46425},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2802":2109,"_24443":2091,"_17120":46427,"_5":17015,"_23194":46377,"_2329":46428},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2802":2110,"_24443":2091,"_17120":46430,"_5":17015,"_23194":46377,"_2329":46431},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2802":2111,"_24443":2091,"_17120":46433,"_5":17015,"_23194":46377,"_2329":46434},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2802":2112,"_24443":2091,"_17120":46436,"_5":17015,"_23194":46381,"_2329":46437},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2802":2113,"_24443":2091,"_17120":46439,"_5":17015,"_23194":46381,"_2329":46440},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2802":2114,"_24443":2091,"_17120":46442,"_5":17015,"_23194":46385,"_2329":46443},[],"The service accepts:",{"_2802":2115,"_24443":2091,"_17120":46445,"_5":17015,"_23194":46385,"_2329":42754},[],{"_2802":2116,"_24443":2091,"_17120":46447,"_5":17015,"_23194":46385,"_2329":46448},[],"VA service path",{"_2802":2117,"_24443":2091,"_17120":46450,"_5":17015,"_23194":46385,"_2329":46451},[],"Format",{"_2802":2118,"_24443":2091,"_17120":46453,"_5":17015,"_23194":46385,"_2329":46454},[],"`POST`",{"_2802":2119,"_24443":2091,"_17120":46456,"_5":17015,"_23194":46385,"_2329":46457},[],"`/ocsp`",{"_2802":2120,"_24443":2091,"_17120":46459,"_5":17015,"_23194":46385,"_2329":46460},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2802":2121,"_24443":2091,"_17120":46462,"_5":17015,"_23194":46385,"_2329":45943},[],{"_2802":2122,"_24443":2091,"_17120":46464,"_5":17015,"_23194":46385,"_2329":46465},[],"`/ocsp/{ocsp_request}`",{"_2802":2123,"_24443":2091,"_17120":46467,"_5":17015,"_23194":46385,"_2329":46468},[],"DER request encoded using padded URL Base64.",{"_2802":2124,"_24443":2091,"_17120":46470,"_5":17015,"_23194":46385,"_2329":46471},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2802":2125,"_24443":2091,"_17120":46473,"_5":17015,"_23194":46389,"_2329":46474},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2802":2126,"_24443":2091,"_17120":46476,"_5":17015,"_23194":46389,"_2329":46477},[],"Generate the request:",{"_2802":2127,"_24443":2091,"_17120":46479,"_5":17015,"_23194":46389,"_2329":46480},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2802":2128,"_24443":2091,"_17120":46482,"_5":17015,"_23194":46389,"_2329":46483},[],"Replace the example URL with the inspected endpoint:",{"_2802":2129,"_24443":2091,"_17120":46485,"_5":17015,"_23194":46389,"_2329":46486},[],"Verify the returned DER:",{"_2802":2130,"_24443":2091,"_17120":46488,"_5":17015,"_23194":46389,"_2329":46489},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2802":2131,"_24443":2091,"_17120":46491,"_5":17015,"_23194":46393,"_2329":46492},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2802":2132,"_24443":2091,"_17120":46494,"_5":17015,"_23194":46393,"_2329":46495},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2802":2133,"_24443":2091,"_17120":46497,"_5":17015,"_23194":46397,"_2329":46498},[],"RFC 6960: OCSP.",{"_2802":2134,"_24443":2091,"_17120":46500,"_5":17015,"_23194":46397,"_2329":46501},[],"OpenSSL: openssl-ocsp.",{"_2802":2135,"_24443":2091,"_17120":46503,"_5":17015,"_23194":46397,"_2329":46504},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2802":2136,"_24443":2091,"_17120":46506,"_5":17015,"_23194":46397,"_2329":45981},[],{"_2802":2137,"_24443":2137,"_5":12033,"_2329":44681,"_24778":46508,"_17120":46509,"_23194":2137},[39822,41166,44681],[],{"_2802":2138,"_24443":2137,"_17120":46511,"_5":17015,"_23194":2137,"_2329":46512},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2802":2139,"_24443":2137,"_5":24775,"_17120":46514,"_23194":46515,"_2329":43991},[],"/docs/pr-preview/pr-28/platform/pki/overview#start-here",{"_2802":2140,"_24443":2137,"_5":24775,"_17120":46517,"_23194":46518,"_2329":46519},[],"/docs/pr-preview/pr-28/platform/pki/overview#what-you-need","What you need",{"_2802":2141,"_24443":2137,"_5":24775,"_17120":46521,"_23194":46522,"_2329":44525},[],"/docs/pr-preview/pr-28/platform/pki/overview#core-capabilities",{"_2802":2142,"_24443":2137,"_5":24775,"_17120":46524,"_23194":46525,"_2329":44529},[],"/docs/pr-preview/pr-28/platform/pki/overview#build-your-trust-hierarchy",{"_2802":2143,"_24443":2137,"_5":24775,"_17120":46527,"_23194":46528,"_2329":44533},[],"/docs/pr-preview/pr-28/platform/pki/overview#protect-cryptographic-keys",{"_2802":2144,"_24443":2137,"_5":24775,"_17120":46530,"_23194":46531,"_2329":44537},[],"/docs/pr-preview/pr-28/platform/pki/overview#issue-and-control-certificates",{"_2802":2145,"_24443":2137,"_5":24775,"_17120":46533,"_23194":46534,"_2329":44545},[],"/docs/pr-preview/pr-28/platform/pki/overview#publish-validation-status",{"_2802":2146,"_24443":2137,"_5":24775,"_17120":46536,"_23194":46537,"_2329":46538},[],"/docs/pr-preview/pr-28/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2802":2147,"_24443":2137,"_5":24775,"_17120":46540,"_23194":46541,"_2329":45465},[],"/docs/pr-preview/pr-28/platform/pki/overview#continue",{"_2802":2148,"_24443":2137,"_17120":46543,"_5":17015,"_23194":2137,"_2329":46544},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2802":2149,"_24443":2137,"_17120":46546,"_5":17015,"_23194":46515,"_2329":46547},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2802":2150,"_24443":2137,"_17120":46549,"_5":17015,"_23194":46515,"_2329":46550},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2802":2151,"_24443":2137,"_17120":46552,"_5":17015,"_23194":46518,"_2329":46553},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2802":2152,"_24443":2137,"_17120":46555,"_5":17015,"_23194":46518,"_2329":46556},[],"An available cryptographic engine to keep the authority's key.",{"_2802":2153,"_24443":2137,"_17120":46558,"_5":17015,"_23194":46518,"_2329":46559},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2802":2154,"_24443":2137,"_17120":46561,"_5":17015,"_23194":46518,"_2329":46562},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2802":2155,"_24443":2137,"_17120":46564,"_5":17015,"_23194":46518,"_2329":46565},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2802":2156,"_24443":2137,"_17120":46567,"_5":17015,"_23194":46525,"_2329":46568},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2802":2157,"_24443":2137,"_17120":46570,"_5":17015,"_23194":46528,"_2329":46571},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2802":2158,"_24443":2137,"_17120":46573,"_5":17015,"_23194":46531,"_2329":46574},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2802":2159,"_24443":2137,"_17120":46576,"_5":17015,"_23194":46534,"_2329":46577},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2802":2160,"_24443":2137,"_17120":46579,"_5":17015,"_23194":46537,"_2329":46580},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2802":2161,"_24443":2137,"_17120":46582,"_5":17015,"_23194":46537,"_2329":46583},[],"its subject and extensions identify the expected client;",{"_2802":2162,"_24443":2137,"_17120":46585,"_5":17015,"_23194":46537,"_2329":46586},[],"its public key matches the client's private key;",{"_2802":2163,"_24443":2137,"_17120":46588,"_5":17015,"_23194":46537,"_2329":46589},[],"its chain reaches a root trusted by the consumer;",{"_2802":2164,"_24443":2137,"_17120":46591,"_5":17015,"_23194":46537,"_2329":46592},[],"its dates and usages allow the operation;",{"_2802":2165,"_24443":2137,"_17120":46594,"_5":17015,"_23194":46537,"_2329":46595},[],"the consumer applies revocation checks and authorization.",{"_2802":2166,"_24443":2137,"_17120":46597,"_5":17015,"_23194":46537,"_2329":46598},[],"The issuance path includes the first independent checks.",{"_2802":2167,"_24443":2137,"_17120":46600,"_5":17015,"_23194":46541,"_2329":46601},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2802":2168,"_24443":2137,"_17120":46603,"_5":17015,"_23194":46541,"_2329":46604},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2802":2169,"_24443":2137,"_17120":46606,"_5":17015,"_23194":46541,"_2329":46607},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2802":2170,"_24443":2170,"_5":12033,"_2329":46609,"_24778":46610,"_17120":46611,"_23194":2170},"Create your first CA",[39822,41166,44681,44116],[],{"_2802":2171,"_24443":2170,"_17120":46613,"_5":17015,"_23194":2170,"_2329":46614},[],"Create an evaluation root and check its certificate before issuing.",{"_2802":2172,"_24443":2170,"_5":24775,"_17120":46616,"_23194":46617,"_2329":39832},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2802":2173,"_24443":2170,"_5":24775,"_17120":46619,"_23194":46620,"_2329":46621},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2802":2174,"_24443":2170,"_5":24775,"_17120":46623,"_23194":46624,"_2329":46625},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2802":2175,"_24443":2170,"_5":24775,"_17120":46627,"_23194":46628,"_2329":46629},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2802":2176,"_24443":2170,"_5":24775,"_17120":46631,"_23194":46632,"_2329":46633},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2802":2177,"_24443":2170,"_5":24775,"_17120":46635,"_23194":46636,"_2329":46637},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2802":2178,"_24443":2170,"_5":24775,"_17120":46639,"_23194":46640,"_2329":46641},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2802":2179,"_24443":2170,"_5":24775,"_17120":46643,"_23194":46644,"_2329":44374},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2802":2180,"_24443":2170,"_5":24775,"_17120":46646,"_23194":46647,"_2329":39856},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2802":2181,"_24443":2170,"_17120":46649,"_5":17015,"_23194":2170,"_2329":46650},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2802":2182,"_24443":2170,"_17120":46652,"_5":17015,"_23194":46617,"_2329":46653},[],"Console access and permission to create keys and authorities.",{"_2802":2183,"_24443":2170,"_17120":46655,"_5":17015,"_23194":46617,"_2329":46656},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2802":2184,"_24443":2170,"_17120":46658,"_5":17015,"_23194":46617,"_2329":46659},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2802":2185,"_24443":2170,"_17120":46661,"_5":17015,"_23194":46617,"_2329":46662},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2802":2186,"_24443":2170,"_17120":46664,"_5":17015,"_23194":46620,"_2329":46665},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2802":2187,"_24443":2170,"_17120":46667,"_5":17015,"_23194":46620,"_2329":46668},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2802":2188,"_24443":2170,"_17120":46670,"_5":17015,"_23194":46624,"_2329":46671},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2802":2189,"_24443":2170,"_17120":46673,"_5":17015,"_23194":46624,"_2329":46674},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2802":2190,"_24443":2170,"_17120":46676,"_5":17015,"_23194":46628,"_2329":46677},[],"Select **Root CA** and complete:",{"_2802":2191,"_24443":2170,"_17120":46679,"_5":17015,"_23194":46628,"_2329":46680},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2802":2192,"_24443":2170,"_17120":46682,"_5":17015,"_23194":46628,"_2329":46683},[],"**Subject**: organization and country details for your evaluation.",{"_2802":2193,"_24443":2170,"_17120":46685,"_5":17015,"_23194":46628,"_2329":46686},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2802":2194,"_24443":2170,"_17120":46688,"_5":17015,"_23194":46628,"_2329":46689},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2802":2195,"_24443":2170,"_17120":46691,"_5":17015,"_23194":46628,"_2329":46692},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2802":2196,"_24443":2170,"_17120":46694,"_5":17015,"_23194":46632,"_2329":46695},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2802":2197,"_24443":2170,"_17120":46697,"_5":17015,"_23194":46636,"_2329":46698},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2802":2198,"_24443":2170,"_17120":46700,"_5":17015,"_23194":46636,"_2329":46701},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2802":2199,"_24443":2170,"_17120":46703,"_5":17015,"_23194":46640,"_2329":46704},[],"Run from the directory where you saved `ca.pem`:",{"_2802":2200,"_24443":2170,"_17120":46706,"_5":17015,"_23194":46640,"_2329":46707},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2802":2201,"_24443":2170,"_17120":46709,"_5":17015,"_23194":46640,"_2329":46710},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2802":2202,"_24443":2170,"_17120":46712,"_5":17015,"_23194":46644,"_2329":46713},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2802":2203,"_24443":2170,"_17120":46715,"_5":17015,"_23194":46644,"_2329":46716},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2802":2204,"_24443":2170,"_17120":46718,"_5":17015,"_23194":46644,"_2329":46719},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2802":2205,"_24443":2170,"_17120":46721,"_5":17015,"_23194":46644,"_2329":46722},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2802":2206,"_24443":2170,"_17120":46724,"_5":17015,"_23194":46647,"_2329":46725},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2802":2207,"_24443":2207,"_5":12033,"_2329":46727,"_24778":46728,"_17120":46729,"_23194":2207},"Issue and verify a certificate",[39822,41166,44681,44116],[],{"_2802":2208,"_24443":2207,"_17120":46731,"_5":17015,"_23194":2207,"_2329":46732},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2802":2209,"_24443":2207,"_5":24775,"_17120":46734,"_23194":46735,"_2329":39832},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2802":2210,"_24443":2207,"_5":24775,"_17120":46737,"_23194":46738,"_2329":46739},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2802":2211,"_24443":2207,"_5":24775,"_17120":46741,"_23194":46742,"_2329":46743},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2802":2212,"_24443":2207,"_5":24775,"_17120":46745,"_23194":46746,"_2329":46747},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2802":2213,"_24443":2207,"_5":24775,"_17120":46749,"_23194":46750,"_2329":46751},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2802":2214,"_24443":2207,"_5":24775,"_17120":46753,"_23194":46754,"_2329":46755},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2802":2215,"_24443":2207,"_5":24775,"_17120":46757,"_23194":46758,"_2329":46637},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2802":2216,"_24443":2207,"_5":24775,"_17120":46760,"_23194":46761,"_2329":46762},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2802":2217,"_24443":2207,"_5":24775,"_17120":46764,"_23194":46765,"_2329":46766},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2802":2218,"_24443":2207,"_5":24775,"_17120":46768,"_23194":46769,"_2329":46770},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2802":2219,"_24443":2207,"_5":24775,"_17120":46772,"_23194":46773,"_2329":44374},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2802":2220,"_24443":2207,"_5":24775,"_17120":46775,"_23194":46776,"_2329":39856},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/issue-certificate#next-step",{"_2802":2221,"_24443":2207,"_17120":46778,"_5":17015,"_23194":2207,"_2329":46779},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2802":2222,"_24443":2207,"_17120":46781,"_5":17015,"_23194":46735,"_2329":46782},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2802":2223,"_24443":2207,"_17120":46784,"_5":17015,"_23194":46735,"_2329":46785},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2802":2224,"_24443":2207,"_17120":46787,"_5":17015,"_23194":46735,"_2329":46788},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2802":2225,"_24443":2207,"_17120":46790,"_5":17015,"_23194":46735,"_2329":46791},[],"A client identifier: here we use `device-001`.",{"_2802":2226,"_24443":2207,"_17120":46793,"_5":17015,"_23194":46735,"_2329":46794},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2802":2227,"_24443":2207,"_17120":46796,"_5":17015,"_23194":46738,"_2329":46797},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2802":2228,"_24443":2207,"_17120":46799,"_5":17015,"_23194":46742,"_2329":46800},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2802":2229,"_24443":2207,"_17120":46802,"_5":17015,"_23194":46742,"_2329":46803},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2802":2230,"_24443":2207,"_17120":46805,"_5":17015,"_23194":46746,"_2329":46806},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2802":2231,"_24443":2207,"_17120":46808,"_5":17015,"_23194":46746,"_2329":46809},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2802":2232,"_24443":2207,"_17120":46811,"_5":17015,"_23194":46750,"_2329":46812},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2802":2233,"_24443":2207,"_17120":46814,"_5":17015,"_23194":46750,"_2329":46815},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2802":2234,"_24443":2207,"_17120":46817,"_5":17015,"_23194":46754,"_2329":46818},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2802":2235,"_24443":2207,"_17120":46820,"_5":17015,"_23194":46758,"_2329":46821},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2802":2236,"_24443":2207,"_17120":46823,"_5":17015,"_23194":46761,"_2329":46824},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2802":2237,"_24443":2207,"_17120":46826,"_5":17015,"_23194":46765,"_2329":46827},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2802":2238,"_24443":2207,"_17120":46829,"_5":17015,"_23194":46765,"_2329":46830},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2802":2239,"_24443":2207,"_17120":46832,"_5":17015,"_23194":46765,"_2329":46833},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2802":2240,"_24443":2207,"_17120":46835,"_5":17015,"_23194":46769,"_2329":46836},[],"In Bash, compare the two public-key digests:",{"_2802":2241,"_24443":2207,"_17120":46838,"_5":17015,"_23194":46769,"_2329":46839},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2802":2242,"_24443":2207,"_17120":46841,"_5":17015,"_23194":46769,"_2329":46842},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2802":2243,"_24443":2207,"_17120":46844,"_5":17015,"_23194":46773,"_2329":44458},[],{"_2802":2244,"_24443":2207,"_17120":46846,"_5":17015,"_23194":46773,"_2329":46847},[],"What to review",{"_2802":2245,"_24443":2207,"_17120":46849,"_5":17015,"_23194":46773,"_2329":46850},[],"The CA rejects issuance",{"_2802":2246,"_24443":2207,"_17120":46852,"_5":17015,"_23194":46773,"_2329":46853},[],"Permissions, CA state and key, algorithm and profile.",{"_2802":2247,"_24443":2207,"_17120":46855,"_5":17015,"_23194":46773,"_2329":46856},[],"Different subject or usages",{"_2802":2248,"_24443":2207,"_17120":46858,"_5":17015,"_23194":46773,"_2329":46859},[],"Applied profile and requested values.",{"_2802":2249,"_24443":2207,"_17120":46861,"_5":17015,"_23194":46773,"_2329":46862},[],"Issuer cannot be found",{"_2802":2250,"_24443":2207,"_17120":46864,"_5":17015,"_23194":46773,"_2329":46865},[],"Downloaded CA and required intermediate chain.",{"_2802":2251,"_24443":2207,"_17120":46867,"_5":17015,"_23194":46773,"_2329":46868},[],"Validity fails",{"_2802":2252,"_24443":2207,"_17120":46870,"_5":17015,"_23194":46773,"_2329":46871},[],"Certificate and CA dates, and the computer's clock.",{"_2802":2253,"_24443":2207,"_17120":46873,"_5":17015,"_23194":46773,"_2329":46874},[],"Public-key digests differ",{"_2802":2254,"_24443":2207,"_17120":46876,"_5":17015,"_23194":46773,"_2329":46877},[],"Certificate and key files from the same issuance.",{"_2802":2255,"_24443":2207,"_17120":46879,"_5":17015,"_23194":46773,"_2329":46880},[],"See PKI diagnostics to narrow an issuance failure.",{"_2802":2256,"_24443":2207,"_17120":46882,"_5":17015,"_23194":46776,"_2329":46883},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2802":2257,"_24443":2207,"_17120":46885,"_5":17015,"_23194":46776,"_2329":46886},[],"Manage certificates for inspection, status and revocation.",{"_2802":2258,"_24443":2207,"_17120":46888,"_5":17015,"_23194":46776,"_2329":46889},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2802":2259,"_24443":2207,"_17120":46891,"_5":17015,"_23194":46776,"_2329":46892},[],"Prepare EST for the device to request its next identities.",{"_2802":2260,"_24443":2207,"_17120":46894,"_5":17015,"_23194":46776,"_2329":46895},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2802":2261,"_24443":2261,"_5":12033,"_2329":46897,"_24778":46898,"_17120":46899,"_23194":2261},"PKI getting started",[39822,41166,44681,44116],[],{"_2802":2262,"_24443":2261,"_17120":46901,"_5":17015,"_23194":2261,"_2329":46902},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2802":2263,"_24443":2261,"_5":24775,"_17120":46904,"_23194":46905,"_2329":39832},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/overview#before-you-begin",{"_2802":2264,"_24443":2261,"_5":24775,"_17120":46907,"_23194":46908,"_2329":46909},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2802":2265,"_24443":2261,"_5":24775,"_17120":46911,"_23194":46912,"_2329":44308},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/overview#expected-result",{"_2802":2266,"_24443":2261,"_5":24775,"_17120":46914,"_23194":46915,"_2329":46916},[],"/docs/pr-preview/pr-28/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2802":2267,"_24443":2261,"_17120":46918,"_5":17015,"_23194":2261,"_2329":46919},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2802":2268,"_24443":2261,"_17120":46921,"_5":17015,"_23194":46905,"_2329":46922},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2802":2269,"_24443":2261,"_17120":46924,"_5":17015,"_23194":46905,"_2329":46925},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2802":2270,"_24443":2261,"_17120":46927,"_5":17015,"_23194":46905,"_2329":46928},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2802":2271,"_24443":2261,"_17120":46930,"_5":17015,"_23194":46905,"_2329":46931},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2802":2272,"_24443":2261,"_17120":46933,"_5":17015,"_23194":46905,"_2329":46934},[],"A working directory with restricted access for the downloaded key.",{"_2802":2273,"_24443":2261,"_17120":46936,"_5":17015,"_23194":46908,"_2329":46937},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2802":2274,"_24443":2261,"_17120":46939,"_5":17015,"_23194":46908,"_2329":46940},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2802":2275,"_24443":2261,"_17120":46942,"_5":17015,"_23194":46908,"_2329":46943},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2802":2276,"_24443":2261,"_17120":46945,"_5":17015,"_23194":46908,"_2329":46946},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2802":2277,"_24443":2261,"_17120":46948,"_5":17015,"_23194":46912,"_2329":46949},[],"File or resource",{"_2802":2278,"_24443":2261,"_17120":46951,"_5":17015,"_23194":46912,"_2329":44305},[],{"_2802":2279,"_24443":2261,"_17120":46953,"_5":17015,"_23194":46912,"_2329":46954},[],"Active root CA and `ca.pem`",{"_2802":2280,"_24443":2261,"_17120":46956,"_5":17015,"_23194":46912,"_2329":46957},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2802":2281,"_24443":2261,"_17120":46959,"_5":17015,"_23194":46912,"_2329":46960},[],"End-entity certificate and `device.crt`",{"_2802":2282,"_24443":2261,"_17120":46962,"_5":17015,"_23194":46912,"_2329":46963},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2802":2283,"_24443":2261,"_17120":46965,"_5":17015,"_23194":46912,"_2329":46966},[],"Private key `device.key`",{"_2802":2284,"_24443":2261,"_17120":46968,"_5":17015,"_23194":46912,"_2329":46969},[],"Its public key matches the one included in `device.crt`.",{"_2802":2285,"_24443":2261,"_17120":46971,"_5":17015,"_23194":46912,"_2329":46972},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2802":2286,"_24443":2261,"_17120":46974,"_5":17015,"_23194":46915,"_2329":46975},[],"To operate certificates, continue with Certificates and Validation.",{"_2802":2287,"_24443":2261,"_17120":46977,"_5":17015,"_23194":46915,"_2329":46978},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2802":2288,"_24443":2261,"_17120":46980,"_5":17015,"_23194":46915,"_2329":46981},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2802":2289,"_24443":2289,"_5":12033,"_2329":46983,"_24778":46984,"_17120":46985,"_23194":2289},"PKI troubleshooting",[39822,41166,44681,43502],[],{"_2802":2290,"_24443":2289,"_17120":46987,"_5":17015,"_23194":2289,"_2329":46988},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2802":2291,"_24443":2289,"_5":24775,"_17120":46990,"_23194":46991,"_2329":46992},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2802":2292,"_24443":2289,"_5":24775,"_17120":46994,"_23194":46995,"_2329":46996},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2802":2293,"_24443":2289,"_5":24775,"_17120":46998,"_23194":46999,"_2329":47000},[],"/docs/pr-preview/pr-28/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2802":2294,"_24443":2289,"_17120":47002,"_5":17015,"_23194":2289,"_2329":47003},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2802":2295,"_24443":2289,"_17120":47005,"_5":17015,"_23194":2289,"_2329":47006},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2802":2296,"_24443":2289,"_17120":47008,"_5":17015,"_23194":46991,"_2329":44305},[],{"_2802":2297,"_24443":2289,"_17120":47010,"_5":17015,"_23194":46991,"_2329":47011},[],"What to inspect",{"_2802":2298,"_24443":2289,"_17120":47013,"_5":17015,"_23194":46991,"_2329":39856},[],{"_2802":2299,"_24443":2289,"_17120":47015,"_5":17015,"_23194":46991,"_2329":47016},[],"CA",{"_2802":2300,"_24443":2289,"_17120":47018,"_5":17015,"_23194":46991,"_2329":47019},[],"Exists, is active and has usable dates.",{"_2802":2301,"_24443":2289,"_17120":47021,"_5":17015,"_23194":46991,"_2329":47022},[],"Authorities.",{"_2802":2302,"_24443":2289,"_17120":47024,"_5":17015,"_23194":46991,"_2329":47025},[],"Key",{"_2802":2303,"_24443":2289,"_17120":47027,"_5":17015,"_23194":46991,"_2329":47028},[],"The record has a usable private key and the engine can sign.",{"_2802":2304,"_24443":2289,"_17120":47030,"_5":17015,"_23194":46991,"_2329":47031},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2802":2305,"_24443":2289,"_17120":47033,"_5":17015,"_23194":46991,"_2329":47034},[],"CSR",{"_2802":2306,"_24443":2289,"_17120":47036,"_5":17015,"_23194":46991,"_2329":47037},[],"Correct PEM and verifiable signature.",{"_2802":2307,"_24443":2289,"_17120":47039,"_5":17015,"_23194":46991,"_2329":47040},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2802":2308,"_24443":2289,"_17120":47042,"_5":17015,"_23194":46991,"_2329":47043},[],"Profile",{"_2802":2309,"_24443":2289,"_17120":47045,"_5":17015,"_23194":46991,"_2329":47046},[],"Selected source, existing ID, allowed algorithm and size.",{"_2802":2310,"_24443":2289,"_17120":47048,"_5":17015,"_23194":46991,"_2329":47049},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2802":2311,"_24443":2289,"_17120":47051,"_5":17015,"_23194":46991,"_2329":44458},[],{"_2802":2312,"_24443":2289,"_17120":47053,"_5":17015,"_23194":46991,"_2329":47054},[],"Appropriate subject, SAN, usages and dates.",{"_2802":2313,"_24443":2289,"_17120":47056,"_5":17015,"_23194":46991,"_2329":47057},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2802":2314,"_24443":2289,"_17120":47059,"_5":17015,"_23194":46991,"_2329":47060},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2802":2315,"_24443":2289,"_17120":47062,"_5":17015,"_23194":46991,"_2329":47063},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2802":2316,"_24443":2289,"_17120":47065,"_5":17015,"_23194":46995,"_2329":47066},[],"Check each boundary independently:",{"_2802":2317,"_24443":2289,"_17120":47068,"_5":17015,"_23194":46995,"_2329":47069},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2802":2318,"_24443":2289,"_17120":47071,"_5":17015,"_23194":46995,"_2329":47072},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2802":2319,"_24443":2289,"_17120":47074,"_5":17015,"_23194":46995,"_2329":47075},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2802":2320,"_24443":2289,"_17120":47077,"_5":17015,"_23194":46995,"_2329":47078},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2802":2321,"_24443":2289,"_17120":47080,"_5":17015,"_23194":46995,"_2329":47081},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2802":2322,"_24443":2289,"_17120":47083,"_5":17015,"_23194":46995,"_2329":47084},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2802":2323,"_24443":2289,"_17120":47086,"_5":17015,"_23194":46999,"_2329":47087},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2802":2324,"_24443":2289,"_17120":47089,"_5":17015,"_23194":46999,"_2329":47090},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.","count","sorting",{"_47094":47095,"_47096":47097,"_47098":47099,"_47100":47101,"_14888":2351,"_56355":2351},"language","english","sortableProperties",[2329,24443,5,23194],"sortablePropertiesWithTypes",{"_2329":20415,"_24443":20415,"_5":20415,"_23194":20415},"sorts",{"_2329":47102,"_24443":49416,"_5":51729,"_23194":54042},{"_3756":47103,"_47104":47105,"_5":20415},{"_11778":4784,"_12121":3846,"_12128":5555,"_23689":20420,"_23277":2688,"_16243":6099,"_11799":2668,"_11806":2667,"_23651":9759,"_23996":4323,"_24006":11595,"_23664":6075,"_28217":4030,"_24017":21366,"_28222":11383,"_28225":6000,"_28228":3731,"_28231":13433,"_28234":2934,"_24318":19325,"_28239":3814,"_28241":4785,"_24354":11279,"_24308":3042,"_28245":9295,"_28248":2891,"_28250":7019,"_24035":15017,"_24313":6025,"_24372":5049,"_28255":3197,"_28257":2878,"_28259":11486,"_28261":3007,"_28263":2621,"_28265":3421,"_28267":6108,"_28269":4372,"_28271":9130,"_23702":15884,"_28274":4329,"_28276":2659,"_23696":6128,"_28279":10336,"_28281":6064,"_28283":6007,"_28286":6190,"_23732":6130,"_28290":19518,"_23642":5571,"_28293":6194,"_23669":6329,"_28296":3924,"_28298":4149,"_28301":5772,"_24349":5130,"_28304":4688,"_28306":3376,"_28309":5400,"_28311":5916,"_28313":6167,"_28315":2951,"_28317":2716,"_16246":6188,"_28320":3821,"_28322":2389,"_28324":6145,"_24029":7798,"_28327":21290,"_28329":2390,"_28331":4665,"_28333":5921,"_28335":2590,"_28337":2391,"_28339":15246,"_24429":2954,"_24056":8189,"_28343":3967,"_28345":7042,"_23680":2733,"_28348":5556,"_28350":5593,"_28352":3637,"_24367":2475,"_28355":10111,"_28357":4929,"_28359":3287,"_28361":7799,"_28363":6111,"_23778":2616,"_28368":2606,"_24023":2608,"_28371":5486,"_28373":2705,"_28375":4496,"_28377":2873,"_28379":3274,"_28381":4113,"_23772":11692,"_24001":4069,"_28385":8549,"_28387":4789,"_28390":4833,"_28392":2507,"_28394":3387,"_28396":22304,"_28398":11103,"_28400":2548,"_28403":8278,"_28405":2607,"_28407":5578,"_28409":4674,"_28411":2579