enTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia."},"423":{"id":"/docs/pr-preview/pr-36/es/deployment/troubleshooting-57","page_id":"/docs/pr-preview/pr-36/es/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/deployment/troubleshooting#observabilidad","content":"Antes de cerrar una incidencia, guarda:"},"424":{"id":"/docs/pr-preview/pr-36/es/deployment/troubleshooting-58","page_id":"/docs/pr-preview/pr-36/es/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/deployment/troubleshooting#observabilidad","content":"causa confirmada;"},"425":{"id":"/docs/pr-preview/pr-36/es/deployment/troubleshooting-59","page_id":"/docs/pr-preview/pr-36/es/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/deployment/troubleshooting#observabilidad","content":"alcance temporal y recursos afectados;"},"426":{"id":"/docs/pr-preview/pr-36/es/deployment/troubleshooting-60","page_id":"/docs/pr-preview/pr-36/es/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/deployment/troubleshooting#observabilidad","content":"comandos o consultas utilizados;"},"427":{"id":"/docs/pr-preview/pr-36/es/deployment/troubleshooting-61","page_id":"/docs/pr-preview/pr-36/es/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/deployment/troubleshooting#observabilidad","content":"cambio aplicado y forma de revertirlo;"},"428":{"id":"/docs/pr-preview/pr-36/es/deployment/troubleshooting-62","page_id":"/docs/pr-preview/pr-36/es/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/deployment/troubleshooting#observabilidad","content":"validación desde un consumidor;"},"429":{"id":"/docs/pr-preview/pr-36/es/deployment/troubleshooting-63","p