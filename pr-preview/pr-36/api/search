erview-20","page_id":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview#expected-result","content":"It identifies `device-001`, supports client authentication and verifies against `ca.pem`."},"2305":{"id":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview-21","page_id":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview#expected-result","content":"Private key `device.key`"},"2306":{"id":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview-22","page_id":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview#expected-result","content":"Its public key matches the one included in `device.crt`."},"2307":{"id":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview-23","page_id":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview#expected-result","content":"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration."},"2308":{"id":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview-24","page_id":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"To operate certificates, continue with Certificates and Validation."},"2309":{"id":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview-25","page_id":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation."},"2310":{"id":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview-26","page_id":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"For the device to request its certificate, prepare the DMS and EST client."},"2311":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","type":"page","content":"PKI troubleshooting","breadcrumbs":["Docs","Platform","PKI","Troubleshooting"],"tags":[],"url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting"},"2312":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-0","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","content":"Diagnose certificate issuance, OCSP and CRL."},"2313":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-1","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"Issuance fails"},"2314":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-2","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"OCSP or CRL do not reflect a change"},"2315":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-3","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"The chain validates but the connection fails"},"2316":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-4","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","content":"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics."},"2317":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-5","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","content":"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics."},"2318":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-6","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"Check"},"2319":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-7","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"What to inspect"},"2320":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-8","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"Next step"},"2321":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-9","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"CA"},"2322":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-10","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"Exists, is active and has usable dates."},"2323":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-11","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"Authorities."},"2324":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-12","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"Key"},"2325":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-13","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"The record has a usable private key and the engine can sign."},"2326":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-14","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"Try **Sign / Verify** in KMS; check provider permissions and availability."},"2327":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-15","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"CSR"},"2328":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-16","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"Correct PEM and verifiable signature."},"2329":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-17","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"`openssl req -in request.csr -noout -verify -text`."},"2330":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-18","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"Profile"},"2331":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-19","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"Selected source, existing ID, allowed algorithm and size."},"2332":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-20","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"Check Profiles precedence; CA and DMS resolve differently."},"2333":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-21","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"Result"},"2334":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-22","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"Appropriate subject, SAN, usages and dates."},"2335":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-23","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance."},"2336":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-24","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration."},"2337":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-25","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#issuance-fails","content":"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation."},"2338":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-26","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"Check each boundary independently:"},"2339":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-27","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions."},"2340":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-28","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy."},"2341":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-29","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`."},"2342":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-30","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator."},"2343":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-31","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection."},"2344":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-32","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure."},"2345":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-33","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests."},"2346":{"id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting-34","page_id":"/docs/pr-preview/pr-36/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures."}},"count":2346},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":860,"2":1764,"3":571,"4":1231,"5":1485,"6":731,"7":1372,"8":1370,"9":1423,"10":1931,"11":1529,"12":433,"13":422,"14":40,"15":143,"16":105,"17":1119,"18":1789,"19":733,"20":1851,"21":768,"22":861,"23":701,"24":683,"25":1311,"26":456,"27":2323,"28":1414,"29":1641,"30":2298,"31":1857,"32":1339,"33":1596,"34":2344,"35":1124,"36":551,"37":990,"38":2345,"39":1562,"40":1768,"41":1885,"42":1342,"43":1396,"44":358,"45":338,"46":359,"47":2196,"48":1459,"49":2200,"50":753,"51":2267,"52":1546,"53":1692,"54":1361,"55":1548,"56":541,"57":2247,"58":1886,"59":1543,"60":891,"61":1880,"62":1842,"63":1856,"64":2181,"65":946,"66":383,"67":1597,"68":2182,"69":947,"70":384,"71":973,"72":2180,"73":843,"74":385,"75":760,"76":2294,"77":1021,"78":582,"79":862,"80":2258,"81":572,"82":1627,"83":1099,"84":712,"85":2266,"86":2154,"87":816,"88":2238,"89":1031,"90":1078,"91":1024,"92":1029,"93":2339,"94":1559,"95":2044,"96":976,"97":611,"98":423,"99":707,"100":1509,"101":1595,"102":1027,"103":2336,"104":492,"105":280,"106":333,"107":606,"108":278,"109":1089,"110":1025,"111":1030,"112":1767,"113":787,"114":590,"115":1454,"116":2098,"117":1779,"118":1505,"119":844,"120":1618,"121":179,"122":0,"123":1828,"124":177,"125":830,"126":1801,"127":182,"