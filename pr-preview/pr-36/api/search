Revoke the current identity"},"726":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-10","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#decommission-a-device","content":"Decommission a device"},"727":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-11","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#automate-enrollment","content":"Automate enrollment"},"728":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-12","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","content":"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create."},"729":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-13","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","content":"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device."},"730":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-14","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"Operational view"},"731":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-15","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"Meaning"},"732":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-16","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"**No Identity**"},"733":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-17","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"A record exists without an associated identity."},"734":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-18","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"**Active**"},"735":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-19","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"The slot is active; also check certificate dates, status and usages."},"736":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-20","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"**Renewal Pending**"},"737":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-21","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"The identity is in the operational renewal window."},"738":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-22","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"**Expiring Soon**"},"739":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-23","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"Expiration is approaching according to configured thresholds."},"740":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-24","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"**Expired**"},"741":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-25","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"The identity has expired."},"742":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-26","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"**Revoked**"},"743":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-27","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"The identity is marked revoked."},"744":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-28","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"**Decommissioned**"},"745":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-29","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"The record is retired and ordinary updates do not restore operation."},"746":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-30","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance."},"747":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-31","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#inspect-a-device","content":"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial."},"748":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-32","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#inspect-a-device","content":"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version."},"749":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-33","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#inspect-a-device","content":"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates."},"750":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-34","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#inspect-a-device","content":"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment."},"751":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-35","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#register-a-device-manually","content":"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS."},"752":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-36","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#create-the-device","content":"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet."},"753":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-37","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#define-its-membership","content":"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS."},"754":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-38","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#classify-the-device","content":"Add model, environment or location tags and an icon according to your inventory."},"755":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-39","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#verify-the-registration","content":"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment."},"756":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-40","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#verify-the-registration","content":"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies."},"757":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-41","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#assign-an-identity-manually","content":"From **No Identity**, use **Assign Identity**:"},"758":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-42","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`."},"759":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-43","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#assign-an-identity-manually","content":"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first."},"760":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-44","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Confirm and read the serial, active version and history again."},"761":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-45","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Install the key/certificate pair and required intermediates on the device and test usage."},"762":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-46","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it."},"763":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-47","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#revoke-the-current-identity","content":"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide."},"764":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-48","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#revoke-the-current-identity","content":"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes."},"765":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-49","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#decommission-a-device","content":"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer."},"766":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-50","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#decommission-a-device","content":"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial."},"767":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-51","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#decommission-a-device","content":"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control."},"768":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-52","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#decommission-a-device","content":"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change."},"769":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-53","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#automate-enrollment","content":"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />"},"770":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-54","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#automate-enrollment","content":"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />"},"771":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","type":"page","content":"Bootstrap identity and authentication","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity"},"772":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-0","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","content":"Prepare server trust and admission proofs for enroll and reenroll."},"773":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-1","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","content":"Initial server trust"},"774":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-2","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"Bootstrap credential"},"775":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-3","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","content":"Modes per operation"},"776":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-4","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"Webhook contract"},"777":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-5","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","content":"Revocation and checks"},"778":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-6","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","content":"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID."},"779":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-7","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","content":"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`."},"780":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-8","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","content":"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies."},"781":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-9","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service."},"782":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-10","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device."},"783":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-11","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity."},"784":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-12","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","content":"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears."},"785":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-13","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","content":"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication."},"786":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-14","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide."},"787":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-15","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"Example body:"},"788":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-16","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy."},"789":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-17","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client."},"790":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-18","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"Continuation requires a successful HTTP response and JSON:"},"791":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-19","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification."},"792":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-20","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","content":"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source."},"793":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity-21","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","content":"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client."},"794":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"page","content":"Configure and operate the DMS","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms"},"795":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-0","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","content":"Define registration, authentication per operation, issuance, renewal and distributed trust."},"796":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-1","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#before-you-begin","content":"Before you begin"},"797":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-2","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#configure-a-dms","content":"Configure a DMS"},"798":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-3","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#identify-the-fleet","content":"Identify the fleet"},"799":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-4","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","content":"Select the enrollment CA"},"800":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-5","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#configure-est","content":"Configure EST"},"801":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-6","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#distribute-trust","content":"Distribute trust"},"802":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-7","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#verify-the-endpoints","content":"Verify the endpoints"},"803":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-8","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-configuration","content":"Enrollment configuration"},"804":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-9","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"Enrollment Device Registration"},"805":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-10","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Enrollment Settings"},"806":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-11","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Authentication per operation"},"807":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-12","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"External webhook settings"},"808":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-13","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#issuance-profile","content":"Issuance profile"},"809":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-14","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Re-enrollment configuration"},"810":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-15","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#serverkeygen","content":"ServerKeyGen"},"811":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-16","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Trust distribution"},"812":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-17","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"Operate the DMS inventory"},"813":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-18","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#integrate-the-devices","content":"Integrate the devices"},"814":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-19","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","content":"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator."},"815":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-20","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#before-you-begin","content":"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement."},"816":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-21","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#before-you-begin","content":"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication."},"817":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-22","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#identify-the-fleet","content":"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS."},"818":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-23","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","content":"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity."},"819":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-24","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#configure-est","content":"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key."},"820":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-25","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#distribute-trust","content":"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation."},"821":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-26","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#verify-the-endpoints","content":"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance."},"822":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-27","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration."},"823":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-28","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode."},"824":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-29","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`settings.enrollment_settings` field"},"825":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-30","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Decision"},"826":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-31","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`protocol`"},"827":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-32","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`EST_RFC7030` for these operations."},"828":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-33","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`enrollment_ca`"},"829":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-34","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"ID of the signing CA."},"830":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-35","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`verify_csr_signature`"},"831":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-36","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Keep `true` to verify CSR key possession."},"832":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-37","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`enable_replaceable_enrollment`"},"833":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-38","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic."},"834":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-39","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`est_rfc7030_settings.auth_mode`"},"835":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-40","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"One of the four authentication modes."},"836":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-41","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes."},"837":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-42","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"The blocks are independent:"},"838":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-43","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`."},"839":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-44","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`."},"840":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-45","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`auth_mode`"},"841":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-46","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Control applied in the configured operation"},"842":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-47","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`CLIENT_CERTIFICATE`"},"843":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-48","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Presented certificate validation."},"844":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-49","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`EXTERNAL_WEBHOOK`"},"845":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-50","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Configured webhook authorization."},"846":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-51","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`"},"847":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-52","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Certificate validation followed by webhook approval."},"848":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-53","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`NO_AUTH`"},"849":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-54","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"No DMS requester authentication."},"850":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-55","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails."},"851":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-56","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path."},"852":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-57","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"For certificate re-enrollment, the validator uses the enrollment CA, then `additional_validation_cas`, and `enable_expired_renewal`. Do not assume copying initial `validation_cas` changes those issuers."},"853":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-58","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID."},"854":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-59","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:"},"855":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-60","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`external_webhook_settings` field"},"856":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-61","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Decision"},"857":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-62","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`url`"},"858":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-63","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed."},"859":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-64","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`method`"},"860":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-65","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`POST` or `PUT`; `POST` by default."},"861":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-66","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`name`"},"862":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-67","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Label used in service logs."},"863":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-68","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.auth_mode`"},"864":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-69","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`."},"865":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-70","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.apikey_options`"},"866":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-71","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Required for `apikey`: `header` and `key`. Reserved header names are rejected."},"867":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-72","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.jwt_options`"},"868":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-73","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`."},"869":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-74","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.mtls_options`"},"870":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-75","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Required for `mtls`: `cert_content` and `key_content` as inline PEM."},"871":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-76","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.insecure_skip_verify`"},"872":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-77","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here."},"873":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-78","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.call_timeout`"},"874":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-79","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Maximum duration of the authorization call (for example `10s`); 10 seconds by default."},"875":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-80","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Rules for that configuration:"},"876":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-81","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so supply the PEM as `mtls_options.cert_content` and `key_content`."},"877":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-82","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected."},"878":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-83","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`."},"879":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-84","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The API ignores the legacy fields `validate_server_cert`, `apikey`, `oidc` and `mtls`. A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` that still carries only the legacy option fields (`apikey`, `oidc`, `mtls`) fails validation with 400; only legacy `noauth` bodies are accepted, and their credentials are dropped."},"880":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-85","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The authorization response must be JSON of at most 1 MiB; a larger body fails the call."},"881":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-86","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises."},"882":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-87","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks; if your version’s console does not expose independent settings, use the DMS API."},"883":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-88","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Migration `20261021120000` rewrites every stored webhook config into this layout: `validate_server_cert` becomes the negated `insecure_skip_verify` (a config where `validate_server_cert` was false keeps skipping verification), `oidc` becomes `jwt_options`, `apikey` becomes `apikey_options` and `mtls` becomes `mtls_options`. When both the legacy certificate and key are PEM, they move into `mtls_options.cert_content` and `key_content` and need no action. Otherwise, including a mixed config (PEM certificate, file-path key), both values become `mtls_options.cert_file` and `key_file`. Delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are re-entered as PEM content, or the leftover file fields are removed if the webhook does not use mTLS. If your version's console does not expose those fields, edit the DMS through the DMS API."},"884":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-89","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#issuance-profile","content":"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust."},"885":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-90","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`settings.reenrollment_settings` field"},"886":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-91","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Purpose"},"887":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-92","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`reenrollment_delta`"},"888":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-93","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Opens the window at the active certificate’s `NotAfter` minus this delta."},"889":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-94","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`preventive_delta`"},"890":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-95","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Preventive operational monitoring threshold."},"891":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-96","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`critical_delta`"},"892":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-97","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Critical operational monitoring threshold."},"893":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-98","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`enable_expired_renewal`"},"894":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-99","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself."},"895":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-100","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`additional_validation_cas`"},"896":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-101","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Additional mTLS credential issuers during migration."},"897":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-102","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`revoke_on_reenrollment`"},"898":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-103","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor."},"899":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-104","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures."},"900":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-105","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#serverkeygen","content":"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference."},"901":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-106","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Option"},"902":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-107","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Published material"},"903":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-108","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#trust-distribution","content":"**Include Lamassu System CA**"},"904":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-109","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Available downstream TLS certificate; it can be a leaf, not an issuing CA."},"905":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-110","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#trust-distribution","content":"**Include Enrollment CA**"},"906":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-111","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Selected issuing CA certificate."},"907":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-112","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#trust-distribution","content":"**Managed CAs**"},"908":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-113","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Explicitly selected CA certificates."},"909":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-114","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#trust-distribution","content":"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust."},"910":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-115","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields."},"911":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-116","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs."},"912":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-117","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement."},"913":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms-118","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/dms#integrate-the-devices","content":"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures."},"914":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","type":"page","content":"Integrate the EST client","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client"},"915":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-0","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","content":"Prepare trust, send a CSR and check the identity you receive."},"916":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-1","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"Before you begin"},"917":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-2","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","content":"Download and inspect cacerts"},"918":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-3","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#prepare-the-csr","content":"Prepare the CSR"},"919":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-4","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#request-the-identity","content":"Request the identity"},"920":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-5","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"Check and install the result"},"921":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-6","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#next-steps","content":"Next steps"},"922":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-7","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","content":"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device."},"923":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-8","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools."},"924":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-9","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity."},"925":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-10","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name."},"926":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-11","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","content":"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file."},"927":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-12","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","content":"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works."},"928":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-13","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#prepare-the-csr","content":"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject."},"929":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-14","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#prepare-the-csr","content":"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles."},"930":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-15","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#request-the-identity","content":"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:"},"931":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-16","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#request-the-identity","content":"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance."},"932":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-17","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"For a root that issues directly:"},"933":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-18","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation."},"934":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-19","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete."},"935":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client-20","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-client#next-steps","content":"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures."},"936":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","type":"page","content":"EST reference","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference"},"937":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-0","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","content":"Look up Lamassu routes, formats, authentication and multipart responses."},"938":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-1","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Endpoint reference"},"939":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-2","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#cacerts","content":"cacerts"},"940":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-3","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"simpleenroll"},"941":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-4","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"simplereenroll"},"942":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-5","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"serverkeygen"},"943":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-6","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#response-format","content":"Response format"},"944":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-7","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Request and extraction"},"945":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-8","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#compatibility-notes","content":"Compatibility notes"},"946":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-9","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","content":"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy."},"947":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-10","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route."},"948":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-11","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Operation"},"949":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-12","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Method"},"950":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-13","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Authentication and condition"},"951":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-14","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/cacerts`"},"952":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-15","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"GET"},"953":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-16","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply."},"954":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-17","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/simpleenroll`"},"955":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-18","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"POST"},"956":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-19","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Initial authentication and DMS registration/replacement policy."},"957":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-20","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/simplereenroll`"},"958":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-21","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"POST"},"959":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-22","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Renewal authentication, existing identity, subject, revocation and window."},"960":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-23","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/serverkeygen`"},"961":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-24","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"POST"},"962":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-25","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Initial authentication and admission; server generation enabled."},"963":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-26","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract."},"964":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-27","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#cacerts","content":"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor."},"965":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-28","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#cacerts","content":"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots."},"966":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-29","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy."},"967":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-30","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR."},"968":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-31","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate."},"969":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-32","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"The enrollment CA or an additional CA validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery."},"970":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-33","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM."},"971":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-34","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement."},"972":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-35","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#response-format","content":"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:"},"973":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-36","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#response-format","content":"Part"},"974":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-37","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#response-format","content":"Content after decoding its Base64"},"975":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-38","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#response-format","content":"`application/pkcs8`"},"976":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-39","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#response-format","content":"Unencrypted DER PKCS#8 private key."},"977":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-40","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#response-format","content":"`application/pkcs7-mime; smime-type=certs-only`"},"978":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-41","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#response-format","content":"DER PKCS#7 containing the issued certificate."},"979":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-42","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#response-format","content":"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers."},"980":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-43","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key."},"981":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-44","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:"},"982":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-45","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Convert and check the result:"},"983":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-46","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser."},"984":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-47","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#compatibility-notes","content":"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting."},"985":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference-48","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/est-reference#compatibility-notes","content":"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client."},"986":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","type":"page","content":"Enrollment with PKI","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview"},"987":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-0","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","content":"Choose admission policy and connect DMS, initial trust and the EST client."},"988":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-1","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#the-journey","content":"The journey"},"989":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-2","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"For the administrator"},"990":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-3","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"For the integrator"},"991":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-4","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#contract-version","content":"Contract version"},"992":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-5","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","content":"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer."},"993":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-6","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#the-journey","content":"The administrator prepares the CA, issuance profile and DMS."},"994":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-7","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#the-journey","content":"The integrator installs initial EST server trust and an admission credential."},"995":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-8","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#the-journey","content":"The client requests an identity for its `Device ID` through EST."},"996":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-9","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#the-journey","content":"Certificate, device binding and key/certificate installation are checked."},"997":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-10","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#the-journey","content":"The consumer validates and authorizes the identity; the client schedules renewal and recovery."},"998":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-11","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#the-journey","content":"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test."},"999":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-12","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />"},"1000":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-13","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />"},"1001":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-14","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />"},"1002":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-15","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />"},"1003":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-16","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />"},"1004":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-17","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />"},"1005":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-18","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />"},"1006":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-19","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />"},"1007":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-20","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#contract-version","content":"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract and migrations, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan."},"1008":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview-21","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/overview#contract-version","content":"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations."},"1009":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-s