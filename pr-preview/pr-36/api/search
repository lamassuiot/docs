/troubleshooting#i-cannot-sign-in","content":"If you receive a 401:"},"390":{"id":"/docs/pr-preview/pr-36/deployment/troubleshooting-24","page_id":"/docs/pr-preview/pr-36/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/deployment/troubleshooting#i-cannot-sign-in","content":"check that the UI's OIDC authority is reachable from the browser;"},"391":{"id":"/docs/pr-preview/pr-36/deployment/troubleshooting-25","page_id":"/docs/pr-preview/pr-36/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/deployment/troubleshooting#i-cannot-sign-in","content":"verify issuer, audience and expiration of the token;"},"392":{"id":"/docs/pr-preview/pr-36/deployment/troubleshooting-26","page_id":"/docs/pr-preview/pr-36/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/deployment/troubleshooting#i-cannot-sign-in","content":"confirm the Gateway can fetch the keys from the JWKS URI;"},"393":{"id":"/docs/pr-preview/pr-36/deployment/troubleshooting-27","page_id":"/docs/pr-preview/pr-36/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/deployment/troubleshooting#i-cannot-sign-in","content":"check that the provider's public and internal routes point to the same realm."},"394":{"id":"/docs/pr-preview/pr-36/deployment/troubleshooting-28","page_id":"/docs/pr-preview/pr-36/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/deployment/troubleshooting#i-cannot-sign-in","content":"If login succeeds but the APIs return 403:"},"395":{"id":"/docs/pr-preview/pr-36/deployment/troubleshooting-29","page_id":"/docs/pr-preview/pr-36/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/deployment/troubleshooting#i-cannot-sign-in","content":"inspect the token's real claims;"},"396":{"id":"/docs/pr-preview/pr-36/deployment/troubleshooting-30","page_id":"/docs/pr-preview/pr-36/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/deployment/troubleshooting#i-cannot-sign-in","content":"confirm they match an active principal;"},"397":{"id":"/docs/pr-preview/pr-36/deployment/troubleshooting-31","page_id":"/docs/pr-preview/pr-36/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/deployment/troubleshooting#i-cannot-sign-in","content":"review the policies granted to that principal;"},"398":{"id":"/docs/pr-preview/pr-36/deployment/troubleshooting-32","page_id":"/docs/pr-preview/pr-36/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/deployment/troubleshooting#i-cannot-sign-in","content":"verify that authz reaches PostgreSQL and its JWKS."},"399":{"id":"/docs/pr-preview/pr-36/deployment/troubleshooting-33","page_id":"/docs/pr-preview/pr-36/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/deployment/troubleshooting#i-cannot-sign-in","content":"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap."},"400":{"id":"/docs/pr-preview/pr-36/deployment/troubleshooting-34","page_id":"/docs/pr-preview/pr-36/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/deployment/troubleshooting#everything-returns-403-or-5xx","content":"External authorization fails closed by default. If authz is unavailable, protected routes are blocked."},"401":{"id":"/docs/pr-preview/pr-36/deployment/troubleshooting-35","page_id":"/docs/pr-preview/pr-36/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Locate the authz pod and Service."},"402":{"id":"/docs/pr-preview/pr-36/deployment/troubleshooting-36","page_id":"/docs/pr-preview/pr-36/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/deployment/troubleshooting#everythi