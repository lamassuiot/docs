type, service source and resource identifier."},"674":{"id":"/docs/pr-preview/pr-36/platform/administration/audit-logs-42","page_id":"/docs/pr-preview/pr-36/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/administration/audit-logs#attribute-the-principal","content":"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment."},"675":{"id":"/docs/pr-preview/pr-36/platform/administration/audit-logs-43","page_id":"/docs/pr-preview/pr-36/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/administration/audit-logs#compare-intent-and-result","content":"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed."},"676":{"id":"/docs/pr-preview/pr-36/platform/administration/audit-logs-44","page_id":"/docs/pr-preview/pr-36/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/administration/audit-logs#follow-the-effect","content":"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations."},"677":{"id":"/docs/pr-preview/pr-36/platform/administration/audit-logs-45","page_id":"/docs/pr-preview/pr-36/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/administration/audit-logs#periodic-verification","content":"Generate a controlled mutation in a test environment and check that:"},"678":{"id":"/docs/pr-preview/pr-36/platform/administration/audit-logs-46","page_id":"/docs/pr-preview/pr-36/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/administration/audit-logs#periodic-verification","content":"a successful audit event appears;"},"679":{"id":"/docs/pr-preview/pr-36/platform/administration/audit-logs-47","page_id":"/docs/pr-preview/pr-36/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/administration/audit-logs#periodic-verification","content":"the principal matches the identity used;"},"680":{"id":"/docs/pr-preview/pr-36/platform/administration/audit-logs-48","page_id":"/docs/pr-preview/pr-36/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/administration/audit-logs#periodic-verification","content":"the consumer persists it exactly once;"},"681":{"id":"/docs/pr-preview/pr-36/platform/administration/audit-logs-49","page_id":"/docs/pr-preview/pr-36/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/administration/audit-logs#periodic-verification","content":"it can be retrieved by resource, actor and period;"},"682":{"id":"/docs/pr-preview/pr-36/platform/administration/audit-logs-50","page_id":"/docs/pr-preview/pr-36/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/administration/audit-logs#periodic-verification","content":"a consumer outage raises an alert."},"683":{"id":"/docs/pr-preview/pr-36/platform/administration/audit-logs-51","page_id":"/docs/pr-preview/pr-36/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/administration/audit-logs#periodic-verification","content":"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved."},"684":{"id":"/docs/pr-preview/pr-36/platform/concepts/architecture","page_id":"/docs/pr-preview/pr-36/platform/concepts/architecture","type":"page","content":"Platform architecture","breadcrumbs":["Docs","Platform"],"tags":[],"url":"/docs/pr-preview/pr-36/platform/concepts/architecture"},"685":{"id":"/docs/pr-preview/pr-36/platform/concepts/architecture-0","page_id":"/docs/pr-preview/pr-36/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/architecture","content":"Lamassu components and how control, keys, issuance and devices relate."},"686":{"id":"/docs/pr-preview/pr-36/platform/concepts/architecture-1","page_id":"/docs/pr-preview/pr-36/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/concepts/architecture#control-plane","content":"Control plane"},"687":{"id":"/docs/pr-preview/pr-36/platform/concepts/architecture-2","page_id":"/docs/pr-preview/pr-36/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/concepts/architecture#key-custody-and-cryptographic-operations","content":"Key custody and cryptographic operations"},"688":{"id":"/docs/pr-preview/pr-36/platform/concepts/architecture-3","page_id":"/docs/pr-preview/pr-36/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/concepts/architecture#issuance-and-enrollment","content":"Issuance and enrollment"},"689":{"id":"/docs/pr-preview/pr-36/platform/concepts/architecture-4","page_id":"/docs/pr-preview/pr-36/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/concepts/architecture#status-and-validation","content":"Status and validation"},"690":{"id":"/docs/pr-preview/pr-36/platform/concepts/architecture-5","page_id":"/docs/pr-preview/pr-36/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/concepts/architecture#platform-dependencies","content":"Platform dependencies"},"691":{"id":"/docs/pr-preview/pr-36/platform/concepts/architecture-6","page_id":"/docs/pr-preview/pr-36/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/architecture","content":"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load."},"692":{"id":"/docs/pr-preview/pr-36/platform/concepts/architecture-7","page_id":"/docs/pr-preview/pr-36/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/architecture","content":"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies."},"693":{"id":"/docs/pr-preview/pr-36/platform/concepts/architecture-8","page_id":"/docs/pr-preview/pr-36/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/architecture#control-plane","content":"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform."},"694":{"id":"/docs/pr-preview/pr-36/platform/concepts/architecture-9","page_id":"/docs/pr-preview/pr-36/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/architecture#key-custody-and-cryptographic-operations","content":"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation."},"695":{"id":"/docs/pr-preview/pr-36/platform/concepts/architecture-10","page_id":"/docs/pr-preview/pr-36/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/architecture#issuance-and-enrollment","content":"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity."},"696":{"id":"/docs/pr-preview/pr-36/platform/concepts/architecture-11","page_id":"/docs/pr-preview/pr-36/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/architecture#status-and-validation","content":"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate."},"697":{"id":"/docs/pr-preview/pr-36/platform/concepts/architecture-12","page_id":"/docs/pr-preview/pr-36/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/architecture#platform-dependencies","content":"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes."},"698":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","type":"page","content":"How Lamassu works","breadcrumbs":["Docs","Platform"],"tags":[],"url":"/docs/pr-preview/pr-36/platform/concepts/overview"},"699":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-0","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/overview","content":"The mental model of trust, keys, certificates and devices."},"700":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-1","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/concepts/overview#the-model-in-five-pieces","content":"The model in five pieces"},"701":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-2","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/concepts/overview#from-onboarding-to-operation","content":"From onboarding to operation"},"702":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-3","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/overview","content":"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle."},"703":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-4","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/overview#the-model-in-five-pieces","content":"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services."},"704":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-5","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/overview#the-model-in-five-pieces","content":"**Certification Authority (CA).** Signs certificates and establishes the chain of trust."},"705":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-6","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/overview#the-model-in-five-pieces","content":"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed."},"706":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-7","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/overview#the-model-in-five-pieces","content":"**Device.** Keeps its private key and presents the certificate to prove its identity."},"707":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-8","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/overview#the-model-in-five-pieces","content":"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL."},"708":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-9","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/overview#from-onboarding-to-operation","content":"An administrator configures a cryptographic engine and creates or imports a CA."},"709":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-10","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/overview#from-onboarding-to-operation","content":"A DMS relates that CA to an enrollment policy."},"710":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-11","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/overview#from-onboarding-to-operation","content":"The device generates a key and requests a certificate through EST, or an operator assigns it an identity."},"711":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-12","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/overview#from-onboarding-to-operation","content":"Lamassu keeps the inventory, history and status of the identity."},"712":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-13","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/overview#from-onboarding-to-operation","content":"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid."},"713":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-14","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/overview#from-onboarding-to-operation","content":"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />"},"714":{"id":"/docs/pr-preview/pr-36/platform/concepts/overview-15","page_id":"/docs/pr-preview/pr-36/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/concepts/overview#from-onboarding-to-operation","content":"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />"},"715":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","type":"page","content":"Devices and identities","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities"],"tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management"},"716":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-0","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","content":"Register, inspect and retire devices while checking their current identity and history."},"717":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-1","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#device-states","content":"Device states"},"718":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-2","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management#inspect-a-device","content":"Inspect a device"},"719":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/device-management-3","page_id":"/docs/pr-preview/pr-36/platfo