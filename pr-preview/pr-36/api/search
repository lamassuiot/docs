-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Deshabilitado para probar el sucesor antes de retirar el anterior."},"1448":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-43","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"ServerKeyGen"},"1449":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-44","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Deshabilitado; la clave operativa se genera en el cliente."},"1450":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-45","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"CA Distribution"},"1451":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-46","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado."},"1452":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-47","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS."},"1453":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-48","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","content":"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:"},"1454":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-49","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","content":"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir."},"1455":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-50","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","content":"Genera una clave nueva y una CSR con el identificador elegido:"},"1456":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-51","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","content":"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:"},"1457":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-52","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","content":"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida."},"1458":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-53","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","content":"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora."},"1459":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-54","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","content":"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active."},"1460":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-55","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:"},"1461":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-56","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:"},"1462":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-57","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL."},"1463":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-58","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:"},"1464":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-59","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server."},"1465":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-60","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Comprobación"},"1466":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-61","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Resultado esperado"},"1467":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-62","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Registro"},"1468":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-63","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"ID creado automáticamente y DMS correcto."},"1469":{"id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device-64","page_id":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-cont