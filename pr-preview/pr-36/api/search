rategies#choose-custody","content":"Choose custody"},"1015":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-5","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","content":"Check the decision"},"1016":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-6","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","content":"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself."},"1017":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-7","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Path"},"1018":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-8","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"When the device exists"},"1019":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-9","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"What to check"},"1020":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-10","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Manual assignment"},"1021":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-11","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"An operator creates it before associating a certificate."},"1022":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-12","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"ID, owning DMS, certificate CN and bound serial."},"1023":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-13","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"EST with `JITP`"},"1024":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-14","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Created for an unknown CN during `/simpleenroll`."},"1025":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-15","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Authorized credential, unused ID, profile, resulting registration and identity."},"1026":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-16","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"EST with `PRE_REGISTRATION`"},"1027":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-17","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Must exist before `/simpleenroll`."},"1028":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-18","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Approved record, same DMS and replacement conditions for your version."},"1029":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-19","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions."},"1030":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-20","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration."},"1031":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-21","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path."},"1032":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-22","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state."},"1033":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-23","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying."},"1034":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-24","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"Decide initial enrollment and re-enrollment separately:"},"1035":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-25","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**Client certificate:** useful when each device has an initial credential whose key it controls."},"1036":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-26","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID."},"1037":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-27","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**Certificate and webhook:** requires both controls in the configured operation."},"1038":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-28","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS."},"1039":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-29","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication."},"1040":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-30","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Option"},"1041":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-31","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Material crossing EST"},"1042":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-32","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Device-generated key"},"1043":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-33","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Public CSR and certificate; the key stays on the client."},"1044":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-34","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Existing device key"},"1045":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-35","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"CSR signed with that key and a new certificate."},"1046":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-36","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"ServerKeyGen"},"1047":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-37","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Private PKCS#8 key and certificate in a TLS-protected multipart response."},"1048":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-38","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material."},"1049":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies-39","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","content":"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate."},"1050":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","type":"page","content":"Renewal and recovery","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery"},"1051":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-0","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","content":"Renew without losing the identity and recover devices according to their actual state."},"1052":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-1","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Prepare renewal"},"1053":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-2","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","content":"Request the successor certificate"},"1054":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-3","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"Install and check the new pair"},"1055":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-4","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Recover according to state"},"1056":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-5","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","content":"Continuous operation"},"1057":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-6","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","content":"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps."},"1058":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-7","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key."},"1059":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-8","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted."},"1060":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-9","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window."},"1061":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-10","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one."},"1062":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-11","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","content":"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes."},"1063":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-12","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","content":"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results."},"1064":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-13","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key."},"1065":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-14","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption."},"1066":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-15","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation."},"1067":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-16","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Situation"},"1068":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-17","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Procedure"},"1069":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-18","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Valid certificate, outside the window"},"1070":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-19","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Schedule the request within the window. Do not use `simpleenroll` to bypass it."},"1071":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-20","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Expired certificate, key available"},"1072":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-21","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply."},"1073":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-22","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Renewal through webhook or `NO_AUTH`"},"1074":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-23","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition."},"1075":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-24","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Lost or inaccessible key"},"1076":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-25","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity."},"1077":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-26","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Current identity revoked"},"1078":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-27","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it."},"1079":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-28","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Device without an identity"},"1080":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-29","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning."},"1081":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-30","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Retired device"},"1082":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-31","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent."},"1083":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-32","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Timeout, HTTP 500 or installation failure"},"1084":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-33","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked."},"1085":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-34","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","content":"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed."},"1086":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery-35","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","content":"Continue with Trust distribution, Devices and identities and Troubleshooting."},"1087":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","type":"page","content":"Enrollment troubleshooting","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting"},"1088":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-0","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","content":"Locate transport, authentication, registration, issuance and installation failures."},"1089":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-1","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","content":"Diagnostics and compatibility"},"1090":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-2","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Error codes and diagnostics"},"1091":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-3","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes","content":"Compatibility notes"},"1092":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-4","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"EST enrollment fails"},"1093":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-5","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","content":"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report."},"1094":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-6","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result."},"1095":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-7","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Symptom or message"},"1096":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-8","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"What to check"},"1097":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-9","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"curl rejects TLS, name or issuer"},"1098":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-10","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification."},"1099":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-11","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"404 or missing APS"},"1100":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-12","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name."},"1101":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-13","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"400, CSR or format error"},"1102":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-14","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding."},"1103":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-15","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Missing credential or invalid certificate"},"1104":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-16","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA."},"1105":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-17","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Webhook denies, times out or responds without authorization"},"1106":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-18","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`."},"1107":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-19","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`unexpected status code: <n>: redirects are not followed`"},"1108":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-20","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed."},"1109":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-21","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`webhook response exceeds 1048576 bytes`"},"1110":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-22","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook."},"1111":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-23","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`webhook config must not reference files`"},"1112":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-24","page_id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the PEM as `cert_content` and `key_content`; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the upgrade note in DMS."},"1113":{"id":"/docs/pr-preview/pr-36/platform/iot-fleets/enrollment/troubleshooting-25","page_id":"/docs/pr-preview/pr-36/platf