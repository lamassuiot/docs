_33074":101724,"_33076":101727,"_33078":101730,"_33080":101732,"_33082":101734,"_33084":101736,"_33086":101738,"_33088":101741,"_33090":101744,"_33092":101747,"_33094":101750,"_33096":101753,"_33098":101755,"_33100":101758,"_33102":101760,"_33104":101763,"_33106":101766,"_33108":101769,"_33110":101771,"_33112":101774,"_33114":101777,"_33116":101780,"_33118":101783,"_33120":101786,"_33122":101789,"_33124":101792,"_33126":101795,"_33128":101798,"_33130":101801,"_33132":101804,"_33134":101807},{"_2837":57040,"_24687":57040,"_5":12136,"_2365":94604,"_25023":94605,"_17267":94608,"_23357":57040},"Despliega desde AWS Marketplace",[40249,94606,94607],"Despliegue","Otros modelos",[],{"_2837":57041,"_24687":57040,"_17267":94610,"_5":17162,"_23357":57040,"_2365":94611},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2837":57042,"_24687":57040,"_5":25020,"_17267":94613,"_23357":94614,"_2365":94615},[],"/docs/pr-preview/pr-36/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2837":57043,"_24687":57040,"_5":25020,"_17267":94617,"_23357":94618,"_2365":94619},[],"/docs/pr-preview/pr-36/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2837":57044,"_24687":57040,"_5":25020,"_17267":94621,"_23357":94622,"_2365":94623},[],"/docs/pr-preview/pr-36/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2837":57045,"_24687":57040,"_5":25020,"_17267":94625,"_23357":94626,"_2365":94627},[],"/docs/pr-preview/pr-36/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2837":57046,"_24687":57040,"_5":25020,"_17267":94629,"_23357":94630,"_2365":94631},[],"/docs/pr-preview/pr-36/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2837":57047,"_24687":57040,"_5":25020,"_17267":94633,"_23357":94634,"_2365":94635},[],"/docs/pr-preview/pr-36/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2837":57048,"_24687":57040,"_5":25020,"_17267":94637,"_23357":94638,"_2365":94639},[],"/docs/pr-preview/pr-36/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2837":57049,"_24687":57040,"_17267":94641,"_5":17162,"_23357":57040,"_2365":94642},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2837":57050,"_24687":57040,"_17267":94644,"_5":17162,"_23357":94614,"_2365":94645},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2837":57051,"_24687":57040,"_17267":94647,"_5":17162,"_23357":94614,"_2365":94648},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2837":57052,"_24687":57040,"_17267":94650,"_5":17162,"_23357":94614,"_2365":94651},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2837":57053,"_24687":57040,"_17267":94653,"_5":17162,"_23357":94618,"_2365":94654},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2837":57054,"_24687":57040,"_17267":94656,"_5":17162,"_23357":94618,"_2365":94657},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2837":57055,"_24687":57040,"_17267":94659,"_5":17162,"_23357":94618,"_2365":94660},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2837":57056,"_24687":57040,"_17267":94662,"_5":17162,"_23357":94622,"_2365":94663},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2837":57057,"_24687":57040,"_17267":94665,"_5":17162,"_23357":94626,"_2365":94666},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2837":57058,"_24687":57040,"_17267":94668,"_5":17162,"_23357":94630,"_2365":94669},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2837":57059,"_24687":57040,"_17267":94671,"_5":17162,"_23357":94634,"_2365":94672},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2837":57060,"_24687":57040,"_17267":94674,"_5":17162,"_23357":94638,"_2365":94675},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2837":57061,"_24687":57061,"_5":12136,"_2365":94677,"_25023":94678,"_17267":94679,"_23357":57061},"Despliega Lamassu",[40249,94606],[],{"_2837":57062,"_24687":57061,"_17267":94681,"_5":17162,"_23357":57061,"_2365":94682},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2837":57063,"_24687":57061,"_5":25020,"_17267":94684,"_23357":94685,"_2365":94686},[],"/docs/pr-preview/pr-36/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2837":57064,"_24687":57061,"_5":25020,"_17267":94688,"_23357":94689,"_2365":94690},[],"/docs/pr-preview/pr-36/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2837":57065,"_24687":57061,"_5":25020,"_17267":94692,"_23357":94693,"_2365":94694},[],"/docs/pr-preview/pr-36/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2837":57066,"_24687":57061,"_17267":94696,"_5":17162,"_23357":57061,"_2365":94697},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2837":57067,"_24687":57061,"_17267":94699,"_5":17162,"_23357":94685,"_2365":94700},[],"Modelo",{"_2837":57068,"_24687":57061,"_17267":94702,"_5":17162,"_23357":94685,"_2365":94703},[],"Recomendado para",{"_2837":57069,"_24687":57061,"_17267":94705,"_5":17162,"_23357":94685,"_2365":94706},[],"Quién opera la infraestructura",{"_2837":57070,"_24687":57061,"_17267":94708,"_5":17162,"_23357":94685,"_2365":94709},[],"Punto de partida",{"_2837":57071,"_24687":57061,"_17267":94711,"_5":17162,"_23357":94685,"_2365":40356},[],{"_2837":57072,"_24687":57061,"_17267":94713,"_5":17162,"_23357":94685,"_2365":94714},[],"Producción, entornos regulados y despliegues personalizados",{"_2837":57073,"_24687":57061,"_17267":94716,"_5":17162,"_23357":94685,"_2365":94717},[],"Tu equipo",{"_2837":57074,"_24687":57061,"_17267":94719,"_5":17162,"_23357":94685,"_2365":94720},[],"Helm o Fastlane",{"_2837":57075,"_24687":57061,"_17267":94722,"_5":17162,"_23357":94685,"_2365":40368},[],{"_2837":57076,"_24687":57061,"_17267":94724,"_5":17162,"_23357":94685,"_2365":94725},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2837":57077,"_24687":57061,"_17267":94727,"_5":17162,"_23357":94685,"_2365":94717},[],{"_2837":57078,"_24687":57061,"_17267":94729,"_5":17162,"_23357":94685,"_2365":94730},[],"Imagen preconfigurada en EC2",{"_2837":57079,"_24687":57061,"_17267":94732,"_5":17162,"_23357":94685,"_2365":40379},[],{"_2837":57080,"_24687":57061,"_17267":94734,"_5":17162,"_23357":94685,"_2365":94735},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2837":57081,"_24687":57061,"_17267":94737,"_5":17162,"_23357":94685,"_2365":40385},[],{"_2837":57082,"_24687":57061,"_17267":94739,"_5":17162,"_23357":94685,"_2365":94740},[],"Suscripción gestionada",{"_2837":57083,"_24687":57061,"_17267":94742,"_5":17162,"_23357":94685,"_2365":94743},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2837":57084,"_24687":57061,"_17267":94745,"_5":17162,"_23357":94685,"_2365":94746},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2837":57085,"_24687":57061,"_17267":94748,"_5":17162,"_23357":94685,"_2365":94749},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2837":57086,"_24687":57061,"_17267":94751,"_5":17162,"_23357":94689,"_2365":94752},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2837":57087,"_24687":57061,"_17267":94754,"_5":17162,"_23357":94693,"_2365":94755},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2837":57088,"_24687":57088,"_5":12136,"_2365":94757,"_25023":94758,"_17267":94759,"_23357":57088},"Utiliza Lamassu como SaaS",[40249,94606,94607],[],{"_2837":57089,"_24687":57088,"_17267":94761,"_5":17162,"_23357":57088,"_2365":94762},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2837":57090,"_24687":57088,"_5":25020,"_17267":94764,"_23357":94765,"_2365":94766},[],"/docs/pr-preview/pr-36/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2837":57091,"_24687":57088,"_5":25020,"_17267":94768,"_23357":94769,"_2365":94770},[],"/docs/pr-preview/pr-36/es/deployment/saas#planes","Planes",{"_2837":57092,"_24687":57088,"_5":25020,"_17267":94772,"_23357":94773,"_2365":94774},[],"/docs/pr-preview/pr-36/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2837":57093,"_24687":57088,"_17267":94776,"_5":17162,"_23357":57088,"_2365":94777},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2837":57094,"_24687":57088,"_17267":94779,"_5":17162,"_23357":94765,"_2365":94780},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2837":57095,"_24687":57088,"_17267":94782,"_5":17162,"_23357":94765,"_2365":94783},[],"Copias de seguridad automáticas.",{"_2837":57096,"_24687":57088,"_17267":94785,"_5":17162,"_23357":94765,"_2365":94786},[],"Actualizaciones de versión.",{"_2837":57097,"_24687":57088,"_17267":94788,"_5":17162,"_23357":94765,"_2365":94789},[],"Soporte técnico y SLA según el plan contratado.",{"_2837":57098,"_24687":57088,"_17267":94791,"_5":17162,"_23357":94769,"_2365":40440},[],{"_2837":57099,"_24687":57088,"_17267":94793,"_5":17162,"_23357":94769,"_2365":94794},[],"Dispositivos",{"_2837":57100,"_24687":57088,"_17267":94796,"_5":17162,"_23357":94769,"_2365":94797},[],"Soporte",{"_2837":57101,"_24687":57088,"_17267":94799,"_5":17162,"_23357":94769,"_2365":40449},[],{"_2837":57102,"_24687":57088,"_17267":94801,"_5":17162,"_23357":94769,"_2365":40452},[],{"_2837":57103,"_24687":57088,"_17267":94803,"_5":17162,"_23357":94769,"_2365":94804},[],"Hasta 1.000",{"_2837":57104,"_24687":57088,"_17267":94806,"_5":17162,"_23357":94769,"_2365":40458},[],{"_2837":57105,"_24687":57088,"_17267":94808,"_5":17162,"_23357":94769,"_2365":94809},[],"99,5 %",{"_2837":57106,"_24687":57088,"_17267":94811,"_5":17162,"_23357":94769,"_2365":40464},[],{"_2837":57107,"_24687":57088,"_17267":94813,"_5":17162,"_23357":94769,"_2365":94814},[],"Hasta 10.000",{"_2837":57108,"_24687":57088,"_17267":94816,"_5":17162,"_23357":94769,"_2365":94817},[],"Email y chat",{"_2837":57109,"_24687":57088,"_17267":94819,"_5":17162,"_23357":94769,"_2365":94820},[],"99,9 %",{"_2837":57110,"_24687":57088,"_17267":94822,"_5":17162,"_23357":94769,"_2365":40476},[],{"_2837":57111,"_24687":57088,"_17267":94824,"_5":17162,"_23357":94769,"_2365":94825},[],"Ilimitados",{"_2837":57112,"_24687":57088,"_17267":94827,"_5":17162,"_23357":94769,"_2365":94828},[],"Dedicado",{"_2837":57113,"_24687":57088,"_17267":94830,"_5":17162,"_23357":94769,"_2365":94831},[],"99,99 %",{"_2837":57114,"_24687":57088,"_17267":94833,"_5":17162,"_23357":94773,"_2365":94834},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2837":57115,"_24687":57088,"_17267":94836,"_5":17162,"_23357":94773,"_2365":94837},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2837":57116,"_24687":57116,"_5":12136,"_2365":40493,"_25023":94839,"_17267":94841,"_23357":57116},[40249,94606,94840],"Kubernetes autogestionado",[],{"_2837":57117,"_24687":57116,"_17267":94843,"_5":17162,"_23357":57116,"_2365":94844},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2837":57118,"_24687":57116,"_5":25020,"_17267":94846,"_23357":94847,"_2365":94848},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2837":57119,"_24687":57116,"_5":25020,"_17267":94850,"_23357":94851,"_2365":94852},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2837":57120,"_24687":57116,"_5":25020,"_17267":94854,"_23357":94855,"_2365":94856},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2837":57121,"_24687":57116,"_5":25020,"_17267":94858,"_23357":94859,"_2365":94860},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2837":57122,"_24687":57116,"_5":25020,"_17267":94862,"_23357":94863,"_2365":94864},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2837":57123,"_24687":57116,"_5":25020,"_17267":94866,"_23357":94867,"_2365":94868},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2837":57124,"_24687":57116,"_5":25020,"_17267":94870,"_23357":94871,"_2365":94872},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2837":57125,"_24687":57116,"_5":25020,"_17267":94874,"_23357":94875,"_2365":94876},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2837":57126,"_24687":57116,"_5":25020,"_17267":94878,"_23357":94879,"_2365":94880},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2837":57127,"_24687":57116,"_5":25020,"_17267":94882,"_23357":94883,"_2365":94884},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2837":57128,"_24687":57116,"_17267":94886,"_5":17162,"_23357":94847,"_2365":94887},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2837":57129,"_24687":57116,"_17267":94889,"_5":17162,"_23357":94847,"_2365":94890},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2837":57130,"_24687":57116,"_17267":94892,"_5":17162,"_23357":94851,"_2365":94893},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2837":57131,"_24687":57116,"_17267":94895,"_5":17162,"_23357":94851,"_2365":94896},[],"Fastlane instala o configura",{"_2837":57132,"_24687":57116,"_17267":94898,"_5":17162,"_23357":94851,"_2365":94899},[],"Tú sigues proporcionando",{"_2837":57133,"_24687":57116,"_17267":94901,"_5":17162,"_23357":94851,"_2365":94902},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2837":57134,"_24687":57116,"_17267":94904,"_5":17162,"_23357":94851,"_2365":94905},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2837":57135,"_24687":57116,"_17267":94907,"_5":17162,"_23357":94851,"_2365":94908},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2837":57136,"_24687":57116,"_17267":94910,"_5":17162,"_23357":94851,"_2365":94911},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2837":57137,"_24687":57116,"_17267":94913,"_5":17162,"_23357":94851,"_2365":94914},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2837":57138,"_24687":57116,"_17267":94916,"_5":17162,"_23357":94851,"_2365":94917},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2837":57139,"_24687":57116,"_17267":94919,"_5":17162,"_23357":94851,"_2365":94920},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2837":57140,"_24687":57116,"_17267":94922,"_5":17162,"_23357":94851,"_2365":94923},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2837":57141,"_24687":57116,"_17267":94925,"_5":17162,"_23357":94851,"_2365":94926},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2837":57142,"_24687":57116,"_17267":94928,"_5":17162,"_23357":94855,"_2365":94929},[],"Necesitas:",{"_2837":57143,"_24687":57116,"_17267":94931,"_5":17162,"_23357":94855,"_2365":94932},[],"un clúster Kubernetes existente",{"_2837":57144,"_24687":57116,"_17267":94934,"_5":17162,"_23357":94855,"_2365":94935},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2837":57145,"_24687":57116,"_17267":94937,"_5":17162,"_23357":94855,"_2365":40591},[],{"_2837":57146,"_24687":57116,"_17267":94939,"_5":17162,"_23357":94855,"_2365":19512},[],{"_2837":57147,"_24687":57116,"_17267":94941,"_5":17162,"_23357":94855,"_2365":94942},[],"`jq` solo si usas `--sample-data`",{"_2837":57148,"_24687":57116,"_17267":94944,"_5":17162,"_23357":94855,"_2365":94945},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2837":57149,"_24687":57116,"_17267":94947,"_5":17162,"_23357":94855,"_2365":94948},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2837":57150,"_24687":57116,"_17267":94950,"_5":17162,"_23357":94855,"_2365":94951},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2837":57151,"_24687":57116,"_17267":94953,"_5":17162,"_23357":94859,"_2365":94954},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2837":57152,"_24687":57116,"_17267":94956,"_5":17162,"_23357":94859,"_2365":94957},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2837":57153,"_24687":57116,"_17267":94959,"_5":17162,"_23357":94863,"_2365":94960},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2837":57154,"_24687":57116,"_17267":94962,"_5":17162,"_23357":94863,"_2365":94963},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2837":57155,"_24687":57116,"_17267":94965,"_5":17162,"_23357":94863,"_2365":94966},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2837":57156,"_24687":57116,"_17267":94968,"_5":17162,"_23357":94863,"_2365":94969},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2837":57157,"_24687":57116,"_17267":94971,"_5":17162,"_23357":94867,"_2365":94972},[],"Opción",{"_2837":57158,"_24687":57116,"_17267":94974,"_5":17162,"_23357":94867,"_2365":94975},[],"Valor predeterminado",{"_2837":57159,"_24687":57116,"_17267":94977,"_5":17162,"_23357":94867,"_2365":94978},[],"Propósito",{"_2837":57160,"_24687":57116,"_17267":94980,"_5":17162,"_23357":94867,"_2365":40635},[],{"_2837":57161,"_24687":57116,"_17267":94982,"_5":17162,"_23357":94867,"_2365":40638},[],{"_2837":57162,"_24687":57116,"_17267":94984,"_5":17162,"_23357":94867,"_2365":94985},[],"Muestra la ayuda",{"_2837":57163,"_24687":57116,"_17267":94987,"_5":17162,"_23357":94867,"_2365":40644},[],{"_2837":57164,"_24687":57116,"_17267":94989,"_5":17162,"_23357":94867,"_2365":94990},[],"contexto actual",{"_2837":57165,"_24687":57116,"_17267":94992,"_5":17162,"_23357":94867,"_2365":94993},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2837":57166,"_24687":57116,"_17267":94995,"_5":17162,"_23357":94867,"_2365":40653},[],{"_2837":57167,"_24687":57116,"_17267":94997,"_5":17162,"_23357":94867,"_2365":5300},[],{"_2837":57168,"_24687":57116,"_17267":94999,"_5":17162,"_23357":94867,"_2365":95000},[],"Omite prompts y genera credenciales para las dependencias",{"_2837":57169,"_24687":57116,"_17267":95002,"_5":17162,"_23357":94867,"_2365":40661},[],{"_2837":57170,"_24687":57116,"_17267":95004,"_5":17162,"_23357":94867,"_2365":40664},[],{"_2837":57171,"_24687":57116,"_17267":95006,"_5":17162,"_23357":94867,"_2365":95007},[],"Namespace de la instalación",{"_2837":57172,"_24687":57116,"_17267":95009,"_5":17162,"_23357":94867,"_2365":40670},[],{"_2837":57173,"_24687":57116,"_17267":95011,"_5":17162,"_23357":94867,"_2365":40673},[],{"_2837":57174,"_24687":57116,"_17267":95013,"_5":17162,"_23357":94867,"_2365":95014},[],"Dominio usado por la UI, OIDC y el certificado",{"_2837":57175,"_24687":57116,"_17267":95016,"_5":17162,"_23357":94867,"_2365":40679},[],{"_2837":57176,"_24687":57116,"_17267":95018,"_5":17162,"_23357":94867,"_2365":12357},[],{"_2837":57177,"_24687":57116,"_17267":95020,"_5":17162,"_23357":94867,"_2365":95021},[],"Versión del chart de Lamassu",{"_2837":57178,"_24687":57116,"_17267":95023,"_5":17162,"_23357":94867,"_2365":40687},[],{"_2837":57179,"_24687":57116,"_17267":95025,"_5":17162,"_23357":94867,"_2365":40690},[],{"_2837":57180,"_24687":57116,"_17267":95027,"_5":17162,"_23357":94867,"_2365":95028},[],"Puerto del listener HTTPS",{"_2837":57181,"_24687":57116,"_17267":95030,"_5":17162,"_23357":94867,"_2365":40696},[],{"_2837":57182,"_24687":57116,"_17267":95032,"_5":17162,"_23357":94867,"_2365":40699},[],{"_2837":57183,"_24687":57116,"_17267":95034,"_5":17162,"_23357":94867,"_2365":95035},[],"Puerto del listener HTTP",{"_2837":57184,"_24687":57116,"_17267":95037,"_5":17162,"_23357":94867,"_2365":40705},[],{"_2837":57185,"_24687":57116,"_17267":95039,"_5":17162,"_23357":94867,"_2365":40638},[],{"_2837":57186,"_24687":57116,"_17267":95041,"_5":17162,"_23357":94867,"_2365":95042},[],"Certificado PEM para TLS downstream",{"_2837":57187,"_24687":57116,"_17267":95044,"_5":17162,"_23357":94867,"_2365":40713},[],{"_2837":57188,"_24687":57116,"_17267":95046,"_5":17162,"_23357":94867,"_2365":40638},[],{"_2837":57189,"_24687":57116,"_17267":95048,"_5":17162,"_23357":94867,"_2365":95049},[],"Clave privada PEM para TLS downstream",{"_2837":57190,"_24687":57116,"_17267":95051,"_5":17162,"_23357":94867,"_2365":40721},[],{"_2837":57191,"_24687":57116,"_17267":95053,"_5":17162,"_23357":94867,"_2365":95054},[],"chart del repositorio",{"_2837":57192,"_24687":57116,"_17267":95056,"_5":17162,"_23357":94867,"_2365":95057},[],"Usa un chart local de Lamassu sin empaquetar",{"_2837":57193,"_24687":57116,"_17267":95059,"_5":17162,"_23357":94867,"_2365":40730},[],{"_2837":57194,"_24687":57116,"_17267":95061,"_5":17162,"_23357":94867,"_2365":95062},[],"detección automática",{"_2837":57195,"_24687":57116,"_17267":95064,"_5":17162,"_23357":94867,"_2365":95065},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2837":57196,"_24687":57116,"_17267":95067,"_5":17162,"_23357":94867,"_2365":40738},[],{"_2837":57197,"_24687":57116,"_17267":95069,"_5":17162,"_23357":94867,"_2365":5300},[],{"_2837":57198,"_24687":57116,"_17267":95071,"_5":17162,"_23357":94867,"_2365":95072},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2837":57199,"_24687":57116,"_17267":95074,"_5":17162,"_23357":94867,"_2365":40746},[],{"_2837":57200,"_24687":57116,"_17267":95076,"_5":17162,"_23357":94867,"_2365":5300},[],{"_2837":57201,"_24687":57116,"_17267":95078,"_5":17162,"_23357":94867,"_2365":95079},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2837":57202,"_24687":57116,"_17267":95081,"_5":17162,"_23357":94867,"_2365":40754},[],{"_2837":57203,"_24687":57116,"_17267":95083,"_5":17162,"_23357":94867,"_2365":5300},[],{"_2837":57204,"_24687":57116,"_17267":95085,"_5":17162,"_23357":94867,"_2365":95086},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2837":57205,"_24687":57116,"_17267":95088,"_5":17162,"_23357":94867,"_2365":40762},[],{"_2837":57206,"_24687":57116,"_17267":95090,"_5":17162,"_23357":94867,"_2365":40765},[],{"_2837":57207,"_24687":57116,"_17267":95092,"_5":17162,"_23357":94867,"_2365":95093},[],"Usa otro chart local de SoftHSM",{"_2837":57208,"_24687":57116,"_17267":95095,"_5":17162,"_23357":94867,"_2365":95096},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2837":57209,"_24687":57116,"_17267":95098,"_5":17162,"_23357":94871,"_2365":40774},[],{"_2837":57210,"_24687":57116,"_17267":95100,"_5":17162,"_23357":94871,"_2365":95101},[],"valida las herramientas locales y el clúster seleccionado",{"_2837":57211,"_24687":57116,"_17267":95103,"_5":17162,"_23357":94871,"_2365":95104},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2837":57212,"_24687":57116,"_17267":95106,"_5":17162,"_23357":94871,"_2365":95107},[],"crea el namespace",{"_2837":57213,"_24687":57116,"_17267":95109,"_5":17162,"_23357":94871,"_2365":95110},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2837":57214,"_24687":57116,"_17267":95112,"_5":17162,"_23357":94871,"_2365":95113},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2837":57215,"_24687":57116,"_17267":95115,"_5":17162,"_23357":94871,"_2365":95116},[],"instala RabbitMQ",{"_2837":57216,"_24687":57116,"_17267":95118,"_5":17162,"_23357":94871,"_2365":95119},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2837":57217,"_24687":57116,"_17267":95121,"_5":17162,"_23357":94871,"_2365":95122},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2837":57218,"_24687":57116,"_17267":95124,"_5":17162,"_23357":94871,"_2365":95125},[],"carga datos de ejemplo opcionalmente",{"_2837":57219,"_24687":57116,"_17267":95127,"_5":17162,"_23357":94871,"_2365":95128},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2837":57220,"_24687":57116,"_17267":95130,"_5":17162,"_23357":94875,"_2365":95131},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2837":57221,"_24687":57116,"_17267":95133,"_5":17162,"_23357":94875,"_2365":95134},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2837":57222,"_24687":57116,"_17267":95136,"_5":17162,"_23357":94879,"_2365":95137},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2837":57223,"_24687":57116,"_17267":95139,"_5":17162,"_23357":94879,"_2365":95140},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2837":57224,"_24687":57116,"_17267":95142,"_5":17162,"_23357":94879,"_2365":95143},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2837":57225,"_24687":57116,"_17267":95145,"_5":17162,"_23357":94883,"_2365":95146},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2837":57226,"_24687":57226,"_5":12136,"_2365":95148,"_25023":95149,"_17267":95150,"_23357":57226},"Instala con Helm",[40249,94606,94840],[],{"_2837":57227,"_24687":57226,"_17267":95152,"_5":17162,"_23357":57226,"_2365":95153},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2837":57228,"_24687":57226,"_5":25020,"_17267":95155,"_23357":95156,"_2365":95157},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2837":57229,"_24687":57226,"_5":25020,"_17267":95159,"_23357":95160,"_2365":94856},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2837":57230,"_24687":57226,"_5":25020,"_17267":95162,"_23357":95163,"_2365":95164},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2837":57231,"_24687":57226,"_5":25020,"_17267":95166,"_23357":95167,"_2365":95168},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2837":57232,"_24687":57226,"_5":25020,"_17267":95170,"_23357":95171,"_2365":95172},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2837":57233,"_24687":57226,"_5":25020,"_17267":95174,"_23357":95175,"_2365":95176},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2837":57234,"_24687":57226,"_5":25020,"_17267":95178,"_23357":95179,"_2365":95180},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2837":57235,"_24687":57226,"_5":25020,"_17267":95182,"_23357":95183,"_2365":95184},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2837":57236,"_24687":57226,"_5":25020,"_17267":95186,"_23357":95187,"_2365":95188},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2837":57237,"_24687":57226,"_17267":95190,"_5":17162,"_23357":95156,"_2365":95191},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2837":57238,"_24687":57226,"_17267":95193,"_5":17162,"_23357":95160,"_2365":95194},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2837":57239,"_24687":57226,"_17267":95196,"_5":17162,"_23357":95160,"_2365":95197},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2837":57240,"_24687":57226,"_17267":95199,"_5":17162,"_23357":95160,"_2365":95200},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2837":57241,"_24687":57226,"_17267":95202,"_5":17162,"_23357":95160,"_2365":95203},[],"un broker RabbitMQ accesible y sus credenciales",{"_2837":57242,"_24687":57226,"_17267":95205,"_5":17162,"_23357":95160,"_2365":95206},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2837":57243,"_24687":57226,"_17267":95208,"_5":17162,"_23357":95160,"_2365":95209},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2837":57244,"_24687":57226,"_17267":95211,"_5":17162,"_23357":95160,"_2365":95212},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2837":57245,"_24687":57226,"_17267":95214,"_5":17162,"_23357":95160,"_2365":95215},[],"una StorageClass y un diseño de tráfico externo",{"_2837":57246,"_24687":57226,"_17267":95217,"_5":17162,"_23357":95160,"_2365":95218},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2837":57247,"_24687":57226,"_17267":95220,"_5":17162,"_23357":95160,"_2365":95221},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2837":57248,"_24687":57226,"_17267":95223,"_5":17162,"_23357":95160,"_2365":95224},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2837":57249,"_24687":57226,"_17267":95226,"_5":17162,"_23357":95163,"_2365":95227},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2837":57250,"_24687":57226,"_17267":95229,"_5":17162,"_23357":95163,"_2365":95230},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2837":57251,"_24687":57226,"_17267":95232,"_5":17162,"_23357":95163,"_2365":95233},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2837":57252,"_24687":57226,"_17267":95235,"_5":17162,"_23357":95167,"_2365":95236},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2837":57253,"_24687":57226,"_17267":95238,"_5":17162,"_23357":95167,"_2365":95239},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2837":57254,"_24687":57226,"_17267":95241,"_5":17162,"_23357":95167,"_2365":95242},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2837":57255,"_24687":57226,"_17267":95244,"_5":17162,"_23357":95171,"_2365":95245},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2837":57256,"_24687":57226,"_17267":95247,"_5":17162,"_23357":95175,"_2365":95248},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2837":57257,"_24687":57226,"_17267":95250,"_5":17162,"_23357":95175,"_2365":95251},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2837":57258,"_24687":57226,"_17267":95253,"_5":17162,"_23357":95175,"_2365":95254},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2837":57259,"_24687":57226,"_17267":95256,"_5":17162,"_23357":95175,"_2365":95257},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2837":57260,"_24687":57226,"_17267":95259,"_5":17162,"_23357":95179,"_2365":95260},[],"Para instalar un checkout local:",{"_2837":57261,"_24687":57226,"_17267":95262,"_5":17162,"_23357":95183,"_2365":95263},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2837":57262,"_24687":57226,"_17267":95265,"_5":17162,"_23357":95183,"_2365":95266},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2837":57263,"_24687":57226,"_17267":95268,"_5":17162,"_23357":95187,"_2365":95269},[],"Antes de pasar a producción, revisa:",{"_2837":57264,"_24687":57226,"_17267":95271,"_5":17162,"_23357":95187,"_2365":95272},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2837":57265,"_24687":57226,"_17267":95274,"_5":17162,"_23357":95187,"_2365":95275},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2837":57266,"_24687":57226,"_17267":95277,"_5":17162,"_23357":95187,"_2365":95278},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2837":57267,"_24687":57226,"_17267":95280,"_5":17162,"_23357":95187,"_2365":95281},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2837":57268,"_24687":57226,"_17267":95283,"_5":17162,"_23357":95187,"_2365":95284},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2837":57269,"_24687":57226,"_17267":95286,"_5":17162,"_23357":95187,"_2365":95287},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2837":57270,"_24687":57226,"_17267":95289,"_5":17162,"_23357":95187,"_2365":95290},[],"SMTP, observabilidad y entrega de alertas",{"_2837":57271,"_24687":57226,"_17267":95292,"_5":17162,"_23357":95187,"_2365":95293},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2837":57272,"_24687":57226,"_17267":95295,"_5":17162,"_23357":95187,"_2365":95296},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2837":57273,"_24687":57273,"_5":12136,"_2365":95298,"_25023":95299,"_17267":95300,"_23357":57273},"Expón el Gateway",[40249,94606,94840],[],{"_2837":57274,"_24687":57273,"_17267":95302,"_5":17162,"_23357":57273,"_2365":95303},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2837":57275,"_24687":57273,"_5":25020,"_17267":95305,"_23357":95306,"_2365":95307},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2837":57276,"_24687":57273,"_5":25020,"_17267":95309,"_23357":95310,"_2365":95311},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2837":57277,"_24687":57273,"_5":25020,"_17267":95313,"_23357":95314,"_2365":95315},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2837":57278,"_24687":57273,"_5":25020,"_17267":95317,"_23357":95318,"_2365":40995},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#k3s",{"_2837":57279,"_24687":57273,"_5":25020,"_17267":95320,"_23357":95321,"_2365":95322},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2837":57280,"_24687":57273,"_5":25020,"_17267":95324,"_23357":95325,"_2365":95326},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2837":57281,"_24687":57273,"_5":25020,"_17267":95328,"_23357":95329,"_2365":95330},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2837":57282,"_24687":57273,"_5":25020,"_17267":95332,"_23357":95333,"_2365":95334},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2837":57283,"_24687":57273,"_5":25020,"_17267":95336,"_23357":95337,"_2365":95338},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2837":57284,"_24687":57273,"_17267":95340,"_5":17162,"_23357":95306,"_2365":95341},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2837":57285,"_24687":57273,"_17267":95343,"_5":17162,"_23357":95306,"_2365":95344},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2837":57286,"_24687":57273,"_17267":95346,"_5":17162,"_23357":95310,"_2365":95347},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2837":57287,"_24687":57273,"_17267":95349,"_5":17162,"_23357":95310,"_2365":95350},[],"Defínelo únicamente cuando:",{"_2837":57288,"_24687":57273,"_17267":95352,"_5":17162,"_23357":95310,"_2365":95353},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2837":57289,"_24687":57273,"_17267":95355,"_5":17162,"_23357":95310,"_2365":95356},[],"esa dirección está asignada a este Gateway",{"_2837":57290,"_24687":57273,"_17267":95358,"_5":17162,"_23357":95310,"_2365":95359},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2837":57291,"_24687":57273,"_17267":95361,"_5":17162,"_23357":95310,"_2365":95362},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2837":57292,"_24687":57273,"_17267":95364,"_5":17162,"_23357":95310,"_2365":95365},[],"No confundas estos valores:",{"_2837":57293,"_24687":57273,"_17267":95367,"_5":17162,"_23357":95310,"_2365":95368},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2837":57294,"_24687":57273,"_17267":95370,"_5":17162,"_23357":95310,"_2365":95371},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2837":57295,"_24687":57273,"_17267":95373,"_5":17162,"_23357":95310,"_2365":95374},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2837":57296,"_24687":57273,"_17267":95376,"_5":17162,"_23357":95314,"_2365":95377},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2837":57297,"_24687":57273,"_17267":95379,"_5":17162,"_23357":95314,"_2365":95380},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2837":57298,"_24687":57273,"_17267":95382,"_5":17162,"_23357":95318,"_2365":95383},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2837":57299,"_24687":57273,"_17267":95385,"_5":17162,"_23357":95318,"_2365":95386},[],"Para el diseño recomendado:",{"_2837":57300,"_24687":57273,"_17267":95388,"_5":17162,"_23357":95318,"_2365":95389},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2837":57301,"_24687":57273,"_17267":95391,"_5":17162,"_23357":95318,"_2365":95392},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2837":57302,"_24687":57273,"_17267":95394,"_5":17162,"_23357":95318,"_2365":95395},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2837":57303,"_24687":57273,"_17267":95397,"_5":17162,"_23357":95318,"_2365":95398},[],"Apunta DNS a la dirección accesible de la VM.",{"_2837":57304,"_24687":57273,"_17267":95400,"_5":17162,"_23357":95318,"_2365":95401},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2837":57305,"_24687":57273,"_17267":95403,"_5":17162,"_23357":95321,"_2365":95404},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2837":57306,"_24687":57273,"_17267":95406,"_5":17162,"_23357":95325,"_2365":95407},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2837":57307,"_24687":57273,"_17267":95409,"_5":17162,"_23357":95325,"_2365":95410},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2837":57308,"_24687":57273,"_17267":95412,"_5":17162,"_23357":95329,"_2365":95413},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2837":57309,"_24687":57273,"_17267":95415,"_5":17162,"_23357":95329,"_2365":95416},[],"Requisito",{"_2837":57310,"_24687":57273,"_17267":95418,"_5":17162,"_23357":95329,"_2365":95419},[],"Diseño recomendado",{"_2837":57311,"_24687":57273,"_17267":95421,"_5":17162,"_23357":95329,"_2365":95422},[],"Consecuencia",{"_2837":57312,"_24687":57273,"_17267":95424,"_5":17162,"_23357":95329,"_2365":95425},[],"Varias URL o servicios de Lamassu",{"_2837":57313,"_24687":57273,"_17267":95427,"_5":17162,"_23357":95329,"_2365":95428},[],"Un Gateway con varias rutas",{"_2837":57314,"_24687":57273,"_17267":95430,"_5":17162,"_23357":95329,"_2365":95431},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2837":57315,"_24687":57273,"_17267":95433,"_5":17162,"_23357":95329,"_2365":95434},[],"Gateways independientes e IP externas distintas",{"_2837":57316,"_24687":57273,"_17267":95436,"_5":17162,"_23357":95329,"_2365":95437},[],"Una VIP por Gateway",{"_2837":57317,"_24687":57273,"_17267":95439,"_5":17162,"_23357":95329,"_2365":95440},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2837":57318,"_24687":57273,"_17267":95442,"_5":17162,"_23357":95329,"_2365":95443},[],"Gateways independientes, un nodo y una IP",{"_2837":57319,"_24687":57273,"_17267":95445,"_5":17162,"_23357":95329,"_2365":95446},[],"Puertos externos diferentes",{"_2837":57320,"_24687":57273,"_17267":95448,"_5":17162,"_23357":95329,"_2365":95449},[],"Los clientes deben indicar puertos no estándar",{"_2837":57321,"_24687":57273,"_17267":95451,"_5":17162,"_23357":95329,"_2365":95452},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2837":57322,"_24687":57273,"_17267":95454,"_5":17162,"_23357":95329,"_2365":95455},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2837":57323,"_24687":57273,"_17267":95457,"_5":17162,"_23357":95329,"_2365":95458},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2837":57324,"_24687":57273,"_17267":95460,"_5":17162,"_23357":95329,"_2365":95461},[],"Recursos Gateway separados pero proxy compartido",{"_2837":57325,"_24687":57273,"_17267":95463,"_5":17162,"_23357":95329,"_2365":95464},[],"Modo merged Gateway de Envoy",{"_2837":57326,"_24687":57273,"_17267":95466,"_5":17162,"_23357":95329,"_2365":95467},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2837":57327,"_24687":57273,"_17267":95469,"_5":17162,"_23357":95329,"_2365":95470},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2837":57328,"_24687":57273,"_17267":95472,"_5":17162,"_23357":95329,"_2365":95473},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2837":57329,"_24687":57273,"_17267":95475,"_5":17162,"_23357":95329,"_2365":95476},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2837":57330,"_24687":57273,"_17267":95478,"_5":17162,"_23357":95329,"_2365":95479},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2837":57331,"_24687":57273,"_17267":95481,"_5":17162,"_23357":95333,"_2365":95482},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2837":57332,"_24687":57273,"_17267":95484,"_5":17162,"_23357":95333,"_2365":95485},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2837":57333,"_24687":57273,"_17267":95487,"_5":17162,"_23357":95333,"_2365":95488},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2837":57334,"_24687":57273,"_17267":95490,"_5":17162,"_23357":95333,"_2365":95491},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2837":57335,"_24687":57273,"_17267":95493,"_5":17162,"_23357":95333,"_2365":95494},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2837":57336,"_24687":57273,"_17267":95496,"_5":17162,"_23357":95337,"_2365":95497},[],"Comprueba, en orden:",{"_2837":57337,"_24687":57273,"_17267":95499,"_5":17162,"_23357":95337,"_2365":95500},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2837":57338,"_24687":57273,"_17267":95502,"_5":17162,"_23357":95337,"_2365":95503},[],"Su estado contiene la dirección esperada.",{"_2837":57339,"_24687":57273,"_17267":95505,"_5":17162,"_23357":95337,"_2365":95506},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2837":57340,"_24687":57273,"_17267":95508,"_5":17162,"_23357":95337,"_2365":95509},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2837":57341,"_24687":57273,"_17267":95511,"_5":17162,"_23357":95337,"_2365":95512},[],"DNS resuelve al endpoint accesible externamente.",{"_2837":57342,"_24687":57273,"_17267":95514,"_5":17162,"_23357":95337,"_2365":95515},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2837":57343,"_24687":57273,"_17267":95517,"_5":17162,"_23357":95337,"_2365":95518},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2837":57344,"_24687":57344,"_5":12136,"_2365":40356,"_25023":95520,"_17267":95521,"_23357":57344},[40249,94606,94840],[],{"_2837":57345,"_24687":57344,"_17267":95523,"_5":17162,"_23357":57344,"_2365":95524},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2837":57346,"_24687":57344,"_5":25020,"_17267":95526,"_23357":95527,"_2365":95528},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2837":57347,"_24687":57344,"_5":25020,"_17267":95530,"_23357":95531,"_2365":95532},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2837":57348,"_24687":57344,"_5":25020,"_17267":95534,"_23357":95535,"_2365":95536},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2837":57349,"_24687":57344,"_5":25020,"_17267":95538,"_23357":95539,"_2365":95540},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2837":57350,"_24687":57344,"_5":25020,"_17267":95542,"_23357":95543,"_2365":95544},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2837":57351,"_24687":57344,"_5":25020,"_17267":95546,"_23357":95547,"_2365":95548},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2837":57352,"_24687":57344,"_17267":95550,"_5":17162,"_23357":95527,"_2365":95551},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2837":57353,"_24687":57344,"_17267":95553,"_5":17162,"_23357":95531,"_2365":95554},[],"Flujo",{"_2837":57354,"_24687":57344,"_17267":95556,"_5":17162,"_23357":95531,"_2365":95557},[],"Úsalo para",{"_2837":57355,"_24687":57344,"_17267":95559,"_5":17162,"_23357":95531,"_2365":95560},[],"Qué instala",{"_2837":57356,"_24687":57344,"_17267":95562,"_5":17162,"_23357":95531,"_2365":41240},[],{"_2837":57357,"_24687":57344,"_17267":95564,"_5":17162,"_23357":95531,"_2365":95565},[],"Producción y entornos controlados",{"_2837":57358,"_24687":57344,"_17267":95567,"_5":17162,"_23357":95531,"_2365":95568},[],"Servicios de Lamassu y recursos de Gateway API",{"_2837":57359,"_24687":57344,"_17267":95570,"_5":17162,"_23357":95531,"_2365":40493},[],{"_2837":57360,"_24687":57344,"_17267":95572,"_5":17162,"_23357":95531,"_2365":95573},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2837":57361,"_24687":57344,"_17267":95575,"_5":17162,"_23357":95531,"_2365":95576},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2837":57362,"_24687":57344,"_17267":95578,"_5":17162,"_23357":95535,"_2365":95579},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2837":57363,"_24687":57344,"_17267":95581,"_5":17162,"_23357":95535,"_2365":95582},[],"Área",{"_2837":57364,"_24687":57344,"_17267":95584,"_5":17162,"_23357":95535,"_2365":95585},[],"El chart de Lamassu proporciona",{"_2837":57365,"_24687":57344,"_17267":95587,"_5":17162,"_23357":95535,"_2365":95588},[],"Tú proporcionas",{"_2837":57366,"_24687":57344,"_17267":95590,"_5":17162,"_23357":95535,"_2365":95591},[],"Aplicaciones Lamassu",{"_2837":57367,"_24687":57344,"_17267":95593,"_5":17162,"_23357":95535,"_2365":95594},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2837":57368,"_24687":57344,"_17267":95596,"_5":17162,"_23357":95535,"_2365":95597},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2837":57369,"_24687":57344,"_17267":95599,"_5":17162,"_23357":95535,"_2365":95600},[],"Datos PostgreSQL",{"_2837":57370,"_24687":57344,"_17267":95602,"_5":17162,"_23357":95535,"_2365":95603},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2837":57371,"_24687":57344,"_17267":95605,"_5":17162,"_23357":95535,"_2365":95606},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2837":57372,"_24687":57344,"_17267":95608,"_5":17162,"_23357":95535,"_2365":95609},[],"Mensajería",{"_2837":57373,"_24687":57344,"_17267":95611,"_5":17162,"_23357":95535,"_2365":95612},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2837":57374,"_24687":57344,"_17267":95614,"_5":17162,"_23357":95535,"_2365":95615},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2837":57375,"_24687":57344,"_17267":95617,"_5":17162,"_23357":95535,"_2365":95618},[],"Identidad",{"_2837":57376,"_24687":57344,"_17267":95620,"_5":17162,"_23357":95535,"_2365":95621},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2837":57377,"_24687":57344,"_17267":95623,"_5":17162,"_23357":95535,"_2365":95624},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2837":57378,"_24687":57344,"_17267":95626,"_5":17162,"_23357":95535,"_2365":95627},[],"Enrutamiento externo",{"_2837":57379,"_24687":57344,"_17267":95629,"_5":17162,"_23357":95535,"_2365":95630},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2837":57380,"_24687":57344,"_17267":95632,"_5":17162,"_23357":95535,"_2365":95633},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2837":57381,"_24687":57344,"_17267":95635,"_5":17162,"_23357":95535,"_2365":41314},[],{"_2837":57382,"_24687":57344,"_17267":95637,"_5":17162,"_23357":95535,"_2365":95638},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2837":57383,"_24687":57344,"_17267":95640,"_5":17162,"_23357":95535,"_2365":95641},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2837":57384,"_24687":57344,"_17267":95643,"_5":17162,"_23357":95535,"_2365":95644},[],"Datos persistentes de la aplicación",{"_2837":57385,"_24687":57344,"_17267":95646,"_5":17162,"_23357":95535,"_2365":95647},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2837":57386,"_24687":57344,"_17267":95649,"_5":17162,"_23357":95535,"_2365":95650},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2837":57387,"_24687":57344,"_17267":95652,"_5":17162,"_23357":95535,"_2365":95653},[],"Integraciones opcionales",{"_2837":57388,"_24687":57344,"_17267":95655,"_5":17162,"_23357":95535,"_2365":95656},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2837":57389,"_24687":57344,"_17267":95658,"_5":17162,"_23357":95535,"_2365":95659},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2837":57390,"_24687":57344,"_17267":95661,"_5":17162,"_23357":95535,"_2365":95662},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2837":57391,"_24687":57344,"_17267":95664,"_5":17162,"_23357":95535,"_2365":95665},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2837":57392,"_24687":57344,"_17267":95667,"_5":17162,"_23357":95539,"_2365":95668},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2837":57393,"_24687":57344,"_17267":95670,"_5":17162,"_23357":95539,"_2365":95671},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2837":57394,"_24687":57344,"_17267":95673,"_5":17162,"_23357":95543,"_2365":95674},[],"Kubernetes 1.24 o posterior",{"_2837":57395,"_24687":57344,"_17267":95676,"_5":17162,"_23357":95543,"_2365":95677},[],"Helm 3.2 o posterior",{"_2837":57396,"_24687":57344,"_17267":95679,"_5":17162,"_23357":95543,"_2365":95680},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2837":57397,"_24687":57344,"_17267":95682,"_5":17162,"_23357":95543,"_2365":95683},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2837":57398,"_24687":57344,"_17267":95685,"_5":17162,"_23357":95543,"_2365":95686},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2837":57399,"_24687":57344,"_17267":95688,"_5":17162,"_23357":95543,"_2365":95689},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2837":57400,"_24687":57344,"_17267":95691,"_5":17162,"_23357":95543,"_2365":95692},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2837":57401,"_24687":57344,"_17267":95694,"_5":17162,"_23357":95547,"_2365":95695},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2837":57402,"_24687":57344,"_17267":95697,"_5":17162,"_23357":95547,"_2365":95698},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2837":57403,"_24687":57344,"_17267":95700,"_5":17162,"_23357":95547,"_2365":95701},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2837":57404,"_24687":57404,"_5":12136,"_2365":95703,"_25023":95704,"_17267":95706,"_23357":57404},"Resolución de problemas de despliegue",[40249,94606,95705],"Operación",[],{"_2837":57405,"_24687":57404,"_17267":95708,"_5":17162,"_23357":57404,"_2365":95709},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2837":57406,"_24687":57404,"_5":25020,"_17267":95711,"_23357":95712,"_2365":95713},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2837":57407,"_24687":57404,"_5":25020,"_17267":95715,"_23357":95716,"_2365":95717},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2837":57408,"_24687":57404,"_5":25020,"_17267":95719,"_23357":95720,"_2365":95721},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2837":57409,"_24687":57404,"_5":25020,"_17267":95723,"_23357":95724,"_2365":95725},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2837":57410,"_24687":57404,"_5":25020,"_17267":95727,"_23357":95728,"_2365":95729},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2837":57411,"_24687":57404,"_5":25020,"_17267":95731,"_23357":95732,"_2365":95733},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2837":57412,"_24687":57404,"_5":25020,"_17267":95735,"_23357":95736,"_2365":95737},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2837":57413,"_24687":57404,"_5":25020,"_17267":95739,"_23357":95740,"_2365":95741},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2837":57414,"_24687":57404,"_5":25020,"_17267":95743,"_23357":95744,"_2365":95745},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2837":57415,"_24687":57404,"_5":25020,"_17267":95747,"_23357":95748,"_2365":95749},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2837":57416,"_24687":57404,"_5":25020,"_17267":95751,"_23357":95752,"_2365":95753},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2837":57417,"_24687":57404,"_5":25020,"_17267":95755,"_23357":95756,"_2365":95757},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2837":57418,"_24687":57404,"_17267":95759,"_5":17162,"_23357":57404,"_2365":95760},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2837":57419,"_24687":57404,"_17267":95762,"_5":17162,"_23357":95716,"_2365":95763},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2837":57420,"_24687":57404,"_17267":95765,"_5":17162,"_23357":95720,"_2365":95766},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2837":57421,"_24687":57404,"_17267":95768,"_5":17162,"_23357":95724,"_2365":95769},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2837":57422,"_24687":57404,"_17267":95771,"_5":17162,"_23357":95728,"_2365":95772},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2837":57423,"_24687":57404,"_17267":95774,"_5":17162,"_23357":95732,"_2365":95775},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2837":57424,"_24687":57404,"_17267":95777,"_5":17162,"_23357":95736,"_2365":95778},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2837":57425,"_24687":57404,"_17267":95780,"_5":17162,"_23357":95736,"_2365":95781},[],"Ejecuta también la prueba de conectividad del chart:",{"_2837":57426,"_24687":57404,"_17267":95783,"_5":17162,"_23357":95736,"_2365":95784},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2837":57427,"_24687":57404,"_17267":95786,"_5":17162,"_23357":95736,"_2365":95787},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2837":57428,"_24687":57404,"_17267":95789,"_5":17162,"_23357":95740,"_2365":95790},[],"Si recibes un 401:",{"_2837":57429,"_24687":57404,"_17267":95792,"_5":17162,"_23357":95740,"_2365":95793},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2837":57430,"_24687":57404,"_17267":95795,"_5":17162,"_23357":95740,"_2365":95796},[],"verifica emisor, audiencia y expiración del token;",{"_2837":57431,"_24687":57404,"_17267":95798,"_5":17162,"_23357":95740,"_2365":95799},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2837":57432,"_24687":57404,"_17267":95801,"_5":17162,"_23357":95740,"_2365":95802},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2837":57433,"_24687":57404,"_17267":95804,"_5":17162,"_23357":95740,"_2365":95805},[],"Si el login termina pero las APIs devuelven 403:",{"_2837":57434,"_24687":57404,"_17267":95807,"_5":17162,"_23357":95740,"_2365":95808},[],"inspecciona los claims reales del token;",{"_2837":57435,"_24687":57404,"_17267":95810,"_5":17162,"_23357":95740,"_2365":95811},[],"confirma que coinciden con un principal activo;",{"_2837":57436,"_24687":57404,"_17267":95813,"_5":17162,"_23357":95740,"_2365":95814},[],"revisa las políticas concedidas al principal;",{"_2837":57437,"_24687":57404,"_17267":95816,"_5":17162,"_23357":95740,"_2365":95817},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2837":57438,"_24687":57404,"_17267":95819,"_5":17162,"_23357":95740,"_2365":95820},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2837":57439,"_24687":57404,"_17267":95822,"_5":17162,"_23357":95744,"_2365":95823},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2837":57440,"_24687":57404,"_17267":95825,"_5":17162,"_23357":95744,"_2365":95826},[],"Localiza el pod y Service de authz.",{"_2837":57441,"_24687":57404,"_17267":95828,"_5":17162,"_23357":95744,"_2365":95829},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2837":57442,"_24687":57404,"_17267":95831,"_5":17162,"_23357":95744,"_2365":95832},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2837":57443,"_24687":57404,"_17267":95834,"_5":17162,"_23357":95744,"_2365":95835},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2837":57444,"_24687":57404,"_17267":95837,"_5":17162,"_23357":95744,"_2365":95838},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2837":57445,"_24687":57404,"_17267":95840,"_5":17162,"_23357":95748,"_2365":95841},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2837":57446,"_24687":57404,"_17267":95843,"_5":17162,"_23357":95748,"_2365":95844},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2837":57447,"_24687":57404,"_17267":95846,"_5":17162,"_23357":95748,"_2365":95847},[],"volumen persistente sin enlazar;",{"_2837":57448,"_24687":57404,"_17267":95849,"_5":17162,"_23357":95748,"_2365":95850},[],"imagen inaccesible o política de pull incorrecta;",{"_2837":57449,"_24687":57404,"_17267":95852,"_5":17162,"_23357":95748,"_2365":95853},[],"configuración inválida del motor criptográfico;",{"_2837":57450,"_24687":57404,"_17267":95855,"_5":17162,"_23357":95748,"_2365":95856},[],"límites de CPU o memoria demasiado bajos;",{"_2837":57451,"_24687":57404,"_17267":95858,"_5":17162,"_23357":95748,"_2365":95859},[],"migración previa incompleta.",{"_2837":57452,"_24687":57404,"_17267":95861,"_5":17162,"_23357":95748,"_2365":95862},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2837":57453,"_24687":57404,"_17267":95864,"_5":17162,"_23357":95748,"_2365":95865},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2837":57454,"_24687":57404,"_17267":95867,"_5":17162,"_23357":95752,"_2365":95868},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2837":57455,"_24687":57404,"_17267":95870,"_5":17162,"_23357":95752,"_2365":95871},[],"verifica que esté habilitado en el servicio emisor;",{"_2837":57456,"_24687":57404,"_17267":95873,"_5":17162,"_23357":95752,"_2365":95874},[],"comprueba conectividad y credenciales AMQP;",{"_2837":57457,"_24687":57404,"_17267":95876,"_5":17162,"_23357":95752,"_2365":95877},[],"revisa exchange, routing key, colas y consumidores;",{"_2837":57458,"_24687":57404,"_17267":95879,"_5":17162,"_23357":95752,"_2365":95880},[],"inspecciona dead-letter queues;",{"_2837":57459,"_24687":57404,"_17267":95882,"_5":17162,"_23357":95752,"_2365":95883},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2837":57460,"_24687":57404,"_17267":95885,"_5":17162,"_23357":95752,"_2365":95886},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2837":57461,"_24687":57404,"_17267":95888,"_5":17162,"_23357":95756,"_2365":95889},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2837":57462,"_24687":57404,"_17267":95891,"_5":17162,"_23357":95756,"_2365":95892},[],"Antes de cerrar una incidencia, guarda:",{"_2837":57463,"_24687":57404,"_17267":95894,"_5":17162,"_23357":95756,"_2365":95895},[],"causa confirmada;",{"_2837":57464,"_24687":57404,"_17267":95897,"_5":17162,"_23357":95756,"_2365":95898},[],"alcance temporal y recursos afectados;",{"_2837":57465,"_24687":57404,"_17267":95900,"_5":17162,"_23357":95756,"_2365":95901},[],"comandos o consultas utilizados;",{"_2837":57466,"_24687":57404,"_17267":95903,"_5":17162,"_23357":95756,"_2365":95904},[],"cambio aplicado y forma de revertirlo;",{"_2837":57467,"_24687":57404,"_17267":95906,"_5":17162,"_23357":95756,"_2365":95907},[],"validación desde un consumidor;",{"_2837":57468,"_24687":57404,"_17267":95909,"_5":17162,"_23357":95756,"_2365":95910},[],"acción preventiva y propietario.",{"_2837":57469,"_24687":57469,"_5":12136,"_2365":95912,"_25023":95913,"_17267":95916,"_23357":57469},"Control de acceso",[40249,95914,95915],"Plataforma","Administración",[],{"_2837":57470,"_24687":57469,"_17267":95918,"_5":17162,"_23357":57469,"_2365":95919},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2837":57471,"_24687":57469,"_5":25020,"_17267":95921,"_23357":95922,"_2365":95923},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2837":57472,"_24687":57469,"_5":25020,"_17267":95925,"_23357":95926,"_2365":95927},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2837":57473,"_24687":57469,"_5":25020,"_17267":95929,"_23357":95930,"_2365":95931},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2837":57474,"_24687":57469,"_5":25020,"_17267":95933,"_23357":95934,"_2365":95935},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2837":57475,"_24687":57469,"_5":25020,"_17267":95937,"_23357":95938,"_2365":95939},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2837":57476,"_24687":57469,"_5":25020,"_17267":95941,"_23357":95942,"_2365":95943},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2837":57477,"_24687":57469,"_5":25020,"_17267":95945,"_23357":95946,"_2365":95947},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2837":57478,"_24687":57469,"_5":25020,"_17267":95949,"_23357":95950,"_2365":95951},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2837":57479,"_24687":57469,"_5":25020,"_17267":95953,"_23357":95954,"_2365":95955},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2837":57480,"_24687":57469,"_5":25020,"_17267":95957,"_23357":95958,"_2365":95959},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2837":57481,"_24687":57469,"_5":25020,"_17267":95961,"_23357":95962,"_2365":95963},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2837":57482,"_24687":57469,"_5":25020,"_17267":95965,"_23357":95966,"_2365":95967},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2837":57483,"_24687":57469,"_5":25020,"_17267":95969,"_23357":95970,"_2365":95971},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2837":57484,"_24687":57469,"_5":25020,"_17267":95973,"_23357":95974,"_2365":95975},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2837":57485,"_24687":57469,"_5":25020,"_17267":95977,"_23357":95978,"_2365":95176},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2837":57486,"_24687":57469,"_5":25020,"_17267":95980,"_23357":95981,"_2365":95982},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2837":57487,"_24687":57469,"_5":25020,"_17267":95984,"_23357":95985,"_2365":95986},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2837":57488,"_24687":57469,"_5":25020,"_17267":95988,"_23357":95989,"_2365":95990},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2837":57489,"_24687":57469,"_5":25020,"_17267":95992,"_23357":95993,"_2365":95994},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2837":57490,"_24687":57469,"_5":25020,"_17267":95996,"_23357":95997,"_2365":95998},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2837":57491,"_24687":57469,"_5":25020,"_17267":96000,"_23357":96001,"_2365":96002},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2837":57492,"_24687":57469,"_5":25020,"_17267":96004,"_23357":96005,"_2365":96006},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2837":57493,"_24687":57469,"_5":25020,"_17267":96008,"_23357":96009,"_2365":96010},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2837":57494,"_24687":57469,"_5":25020,"_17267":96012,"_23357":96013,"_2365":96014},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2837":57495,"_24687":57469,"_5":25020,"_17267":96016,"_23357":96017,"_2365":96018},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2837":57496,"_24687":57469,"_5":25020,"_17267":96020,"_23357":96021,"_2365":96022},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2837":57497,"_24687":57469,"_5":25020,"_17267":96024,"_23357":96025,"_2365":96026},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2837":57498,"_24687":57469,"_5":25020,"_17267":96028,"_23357":96029,"_2365":96030},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2837":57499,"_24687":57469,"_5":25020,"_17267":96032,"_23357":96033,"_2365":96034},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2837":57500,"_24687":57469,"_17267":96036,"_5":17162,"_23357":57469,"_2365":96037},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2837":57501,"_24687":57469,"_17267":96039,"_5":17162,"_23357":57469,"_2365":96040},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2837":57502,"_24687":57469,"_17267":96042,"_5":17162,"_23357":57469,"_2365":96043},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2837":57503,"_24687":57469,"_17267":96045,"_5":17162,"_23357":95922,"_2365":96046},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2837":57504,"_24687":57469,"_17267":96048,"_5":17162,"_23357":95922,"_2365":96049},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2837":57505,"_24687":57469,"_17267":96051,"_5":17162,"_23357":95922,"_2365":96052},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2837":57506,"_24687":57469,"_17267":96054,"_5":17162,"_23357":95922,"_2365":96055},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2837":57507,"_24687":57469,"_17267":96057,"_5":17162,"_23357":95922,"_2365":96058},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2837":57508,"_24687":57469,"_17267":96060,"_5":17162,"_23357":95922,"_2365":96061},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y alguna de sus políticas debe permitir la operación solicitada.",{"_2837":57509,"_24687":57469,"_17267":96063,"_5":17162,"_23357":95926,"_2365":96064},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2837":57510,"_24687":57469,"_17267":96066,"_5":17162,"_23357":95926,"_2365":96067},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2837":57511,"_24687":57469,"_17267":96069,"_5":17162,"_23357":95930,"_2365":96070},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2837":57512,"_24687":57469,"_17267":96072,"_5":17162,"_23357":95930,"_2365":96073},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2837":57513,"_24687":57469,"_17267":96075,"_5":17162,"_23357":95930,"_2365":96076},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2837":57514,"_24687":57469,"_17267":96078,"_5":17162,"_23357":95930,"_2365":96079},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2837":57515,"_24687":57469,"_17267":96081,"_5":17162,"_23357":95930,"_2365":96082},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2837":57516,"_24687":57469,"_17267":96084,"_5":17162,"_23357":95930,"_2365":96085},[],"Carga por separado las políticas concedidas a cada principal.",{"_2837":57517,"_24687":57469,"_17267":96087,"_5":17162,"_23357":95930,"_2365":96088},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2837":57518,"_24687":57469,"_17267":96090,"_5":17162,"_23357":95930,"_2365":96091},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2837":57519,"_24687":57469,"_17267":96093,"_5":17162,"_23357":95930,"_2365":96094},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política.",{"_2837":57520,"_24687":57469,"_17267":96096,"_5":17162,"_23357":95930,"_2365":96097},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2837":57521,"_24687":57469,"_17267":96099,"_5":17162,"_23357":95930,"_2365":96100},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en `x-current-user`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2837":57522,"_24687":57469,"_17267":96102,"_5":17162,"_23357":95930,"_2365":96103},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, el esquema debe declarar una restricción que relacione un valor de la petición con un atributo normalizado del principal.",{"_2837":57523,"_24687":57469,"_17267":96105,"_5":17162,"_23357":95934,"_2365":96106},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2837":57524,"_24687":57469,"_17267":96108,"_5":17162,"_23357":95934,"_2365":96109},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2837":57525,"_24687":57469,"_17267":96111,"_5":17162,"_23357":95934,"_2365":96112},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2837":57526,"_24687":57469,"_17267":96114,"_5":17162,"_23357":95934,"_2365":96115},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2837":57527,"_24687":57469,"_17267":96117,"_5":17162,"_23357":95934,"_2365":96118},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2837":57528,"_24687":57469,"_17267":96120,"_5":17162,"_23357":95934,"_2365":96121},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2837":57529,"_24687":57469,"_17267":96123,"_5":17162,"_23357":95934,"_2365":96124},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2837":57530,"_24687":57469,"_17267":96126,"_5":17162,"_23357":95934,"_2365":96127},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2837":57531,"_24687":57469,"_17267":96129,"_5":17162,"_23357":95934,"_2365":96130},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2837":57532,"_24687":57469,"_17267":96132,"_5":17162,"_23357":95934,"_2365":96133},[],"Las acciones se dividen en dos grupos:",{"_2837":57533,"_24687":57469,"_17267":96135,"_5":17162,"_23357":95934,"_2365":96136},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2837":57534,"_24687":57469,"_17267":96138,"_5":17162,"_23357":95934,"_2365":96139},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2837":57535,"_24687":57469,"_17267":96141,"_5":17162,"_23357":95934,"_2365":96142},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2837":57536,"_24687":57469,"_17267":96144,"_5":17162,"_23357":95938,"_2365":96145},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2837":57537,"_24687":57469,"_17267":96147,"_5":17162,"_23357":95938,"_2365":96148},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2837":57538,"_24687":57469,"_17267":96150,"_5":17162,"_23357":95938,"_2365":96151},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega. Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2837":57539,"_24687":57469,"_17267":96153,"_5":17162,"_23357":95942,"_2365":96154},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2837":57540,"_24687":57469,"_17267":96156,"_5":17162,"_23357":95942,"_2365":96157},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2837":57541,"_24687":57469,"_17267":96159,"_5":17162,"_23357":95942,"_2365":96160},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2837":57542,"_24687":57469,"_17267":96162,"_5":17162,"_23357":95942,"_2365":96163},[],"Los operadores implementados son:",{"_2837":57543,"_24687":57469,"_17267":96165,"_5":17162,"_23357":95942,"_2365":96166},[],"`equals`, para igualdad exacta;",{"_2837":57544,"_24687":57469,"_17267":96168,"_5":17162,"_23357":95942,"_2365":96169},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2837":57545,"_24687":57469,"_17267":96171,"_5":17162,"_23357":95942,"_2365":96172},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2837":57546,"_24687":57469,"_17267":96174,"_5":17162,"_23357":95942,"_2365":96175},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2837":57547,"_24687":57469,"_17267":96177,"_5":17162,"_23357":95946,"_2365":96178},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2837":57548,"_24687":57469,"_17267":96180,"_5":17162,"_23357":95946,"_2365":96181},[],"Los modos disponibles son:",{"_2837":57549,"_24687":57469,"_17267":96183,"_5":17162,"_23357":95946,"_2365":96184},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2837":57550,"_24687":57469,"_17267":96186,"_5":17162,"_23357":95946,"_2365":96187},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2837":57551,"_24687":57469,"_17267":96189,"_5":17162,"_23357":95946,"_2365":96190},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2837":57552,"_24687":57469,"_17267":96192,"_5":17162,"_23357":95946,"_2365":96193},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2837":57553,"_24687":57469,"_17267":96195,"_5":17162,"_23357":95946,"_2365":96196},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2837":57554,"_24687":57469,"_17267":96198,"_5":17162,"_23357":95946,"_2365":96199},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2837":57555,"_24687":57469,"_17267":96201,"_5":17162,"_23357":95950,"_2365":96202},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2837":57556,"_24687":57469,"_17267":96204,"_5":17162,"_23357":95950,"_2365":96205},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2837":57557,"_24687":57469,"_17267":96207,"_5":17162,"_23357":95950,"_2365":96208},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2837":57558,"_24687":57469,"_17267":96210,"_5":17162,"_23357":95950,"_2365":96211},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2837":57559,"_24687":57469,"_17267":96213,"_5":17162,"_23357":95958,"_2365":96214},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2837":57560,"_24687":57469,"_17267":96216,"_5":17162,"_23357":95958,"_2365":96217},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2837":57561,"_24687":57469,"_17267":96219,"_5":17162,"_23357":95962,"_2365":96220},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2837":57562,"_24687":57469,"_17267":96222,"_5":17162,"_23357":95962,"_2365":96223},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2837":57563,"_24687":57469,"_17267":96225,"_5":17162,"_23357":95966,"_2365":96226},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2837":57564,"_24687":57469,"_17267":96228,"_5":17162,"_23357":95966,"_2365":96229},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2837":57565,"_24687":57469,"_17267":96231,"_5":17162,"_23357":95966,"_2365":96232},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2837":57566,"_24687":57469,"_17267":96234,"_5":17162,"_23357":95970,"_2365":96235},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2837":57567,"_24687":57469,"_17267":96237,"_5":17162,"_23357":95970,"_2365":96238},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2837":57568,"_24687":57469,"_17267":96240,"_5":17162,"_23357":95970,"_2365":96241},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2837":57569,"_24687":57469,"_17267":96243,"_5":17162,"_23357":95974,"_2365":96244},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2837":57570,"_24687":57469,"_17267":96246,"_5":17162,"_23357":95974,"_2365":96247},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2837":57571,"_24687":57469,"_17267":96249,"_5":17162,"_23357":95974,"_2365":96250},[],"acceso completo y de solo lectura a KMS;",{"_2837":57572,"_24687":57469,"_17267":96252,"_5":17162,"_23357":95974,"_2365":96253},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2837":57573,"_24687":57469,"_17267":96255,"_5":17162,"_23357":95974,"_2365":96256},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2837":57574,"_24687":57469,"_17267":96258,"_5":17162,"_23357":95974,"_2365":96259},[],"acceso a la interfaz;",{"_2837":57575,"_24687":57469,"_17267":96261,"_5":17162,"_23357":95974,"_2365":96262},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2837":57576,"_24687":57469,"_17267":96264,"_5":17162,"_23357":95974,"_2365":96265},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2837":57577,"_24687":57469,"_17267":96267,"_5":17162,"_23357":95974,"_2365":96268},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2837":57578,"_24687":57469,"_17267":96270,"_5":17162,"_23357":95978,"_2365":96271},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2837":57579,"_24687":57469,"_17267":96273,"_5":17162,"_23357":95978,"_2365":96274},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2837":57580,"_24687":57469,"_17267":96276,"_5":17162,"_23357":95978,"_2365":96277},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2837":57581,"_24687":57469,"_17267":96279,"_5":17162,"_23357":95981,"_2365":96280},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2837":57582,"_24687":57469,"_17267":96282,"_5":17162,"_23357":95985,"_2365":96283},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2837":57583,"_24687":57469,"_17267":96285,"_5":17162,"_23357":95989,"_2365":96286},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2837":57584,"_24687":57469,"_17267":96288,"_5":17162,"_23357":95993,"_2365":96289},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2837":57585,"_24687":57469,"_17267":96291,"_5":17162,"_23357":95997,"_2365":96292},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2837":57586,"_24687":57469,"_17267":96294,"_5":17162,"_23357":96001,"_2365":96295},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2837":57587,"_24687":57469,"_17267":96297,"_5":17162,"_23357":96001,"_2365":96298},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2837":57588,"_24687":57469,"_17267":96300,"_5":17162,"_23357":96005,"_2365":96301},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2837":57589,"_24687":57469,"_17267":96303,"_5":17162,"_23357":96005,"_2365":96304},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2837":57590,"_24687":57469,"_17267":96306,"_5":17162,"_23357":96005,"_2365":96307},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2837":57591,"_24687":57469,"_17267":96309,"_5":17162,"_23357":96005,"_2365":96310},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2837":57592,"_24687":57469,"_17267":96312,"_5":17162,"_23357":96005,"_2365":96313},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2837":57593,"_24687":57469,"_17267":96315,"_5":17162,"_23357":96005,"_2365":96316},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2837":57594,"_24687":57469,"_17267":96318,"_5":17162,"_23357":96005,"_2365":96319},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2837":57595,"_24687":57469,"_17267":96321,"_5":17162,"_23357":96005,"_2365":96322},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2837":57596,"_24687":57469,"_17267":96324,"_5":17162,"_23357":96009,"_2365":96325},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2837":57597,"_24687":57469,"_17267":96327,"_5":17162,"_23357":96009,"_2365":96328},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2837":57598,"_24687":57469,"_17267":96330,"_5":17162,"_23357":96009,"_2365":96331},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2837":57599,"_24687":57469,"_17267":96333,"_5":17162,"_23357":96013,"_2365":96334},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2837":57600,"_24687":57469,"_17267":96336,"_5":17162,"_23357":96013,"_2365":96337},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2837":57601,"_24687":57469,"_17267":96339,"_5":17162,"_23357":96013,"_2365":96340},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2837":57602,"_24687":57469,"_17267":96342,"_5":17162,"_23357":96013,"_2365":96343},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2837":57603,"_24687":57469,"_17267":96345,"_5":17162,"_23357":96013,"_2365":96346},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2837":57604,"_24687":57469,"_17267":96348,"_5":17162,"_23357":96013,"_2365":96349},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2837":57605,"_24687":57469,"_17267":96351,"_5":17162,"_23357":96013,"_2365":96352},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2837":57606,"_24687":57469,"_17267":96354,"_5":17162,"_23357":96021,"_2365":96355},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2837":57607,"_24687":57469,"_17267":96357,"_5":17162,"_23357":96025,"_2365":96358},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2837":57608,"_24687":57469,"_17267":96360,"_5":17162,"_23357":96025,"_2365":96361},[],"que exista un principal activo del tipo correcto;",{"_2837":57609,"_24687":57469,"_17267":96363,"_5":17162,"_23357":96025,"_2365":96364},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2837":57610,"_24687":57469,"_17267":96366,"_5":17162,"_23357":96025,"_2365":96367},[],"que todas las condiciones del principal se cumplan;",{"_2837":57611,"_24687":57469,"_17267":96369,"_5":17162,"_23357":96025,"_2365":96370},[],"que el principal tenga concedida la política esperada;",{"_2837":57612,"_24687":57469,"_17267":96372,"_5":17162,"_23357":96025,"_2365":96373},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2837":57613,"_24687":57469,"_17267":96375,"_5":17162,"_23357":96025,"_2365":96376},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2837":57614,"_24687":57469,"_17267":96378,"_5":17162,"_23357":96025,"_2365":96379},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos.",{"_2837":57615,"_24687":57469,"_17267":96381,"_5":17162,"_23357":96029,"_2365":96382},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2837":57616,"_24687":57469,"_17267":96384,"_5":17162,"_23357":96033,"_2365":96385},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2837":57617,"_24687":57469,"_17267":96387,"_5":17162,"_23357":96033,"_2365":96388},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2837":57618,"_24687":57618,"_5":12136,"_2365":96390,"_25023":96391,"_17267":96392,"_23357":57618},"Alertas y suscripciones",[40249,95914,95915],[],{"_2837":57619,"_24687":57618,"_17267":96394,"_5":17162,"_23357":57618,"_2365":96395},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2837":57620,"_24687":57618,"_5":25020,"_17267":96397,"_23357":96398,"_2365":96399},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2837":57621,"_24687":57618,"_5":25020,"_17267":96401,"_23357":96402,"_2365":96403},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2837":57622,"_24687":57618,"_5":25020,"_17267":96405,"_23357":96406,"_2365":96407},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2837":57623,"_24687":57618,"_5":25020,"_17267":96409,"_23357":96410,"_2365":96411},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2837":57624,"_24687":57618,"_5":25020,"_17267":96413,"_23357":96414,"_2365":96415},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2837":57625,"_24687":57618,"_5":25020,"_17267":96417,"_23357":96418,"_2365":96419},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2837":57626,"_24687":57618,"_5":25020,"_17267":96421,"_23357":96422,"_2365":96423},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2837":57627,"_24687":57618,"_5":25020,"_17267":96425,"_23357":96426,"_2365":96427},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2837":57628,"_24687":57618,"_5":25020,"_17267":96429,"_23357":96430,"_2365":96431},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2837":57629,"_24687":57618,"_5":25020,"_17267":96433,"_23357":96434,"_2365":96435},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2837":57630,"_24687":57618,"_17267":96437,"_5":17162,"_23357":57618,"_2365":96438},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2837":57631,"_24687":57618,"_17267":96440,"_5":17162,"_23357":96398,"_2365":96441},[],"Un servicio publica un evento de dominio.",{"_2837":57632,"_24687":57618,"_17267":96443,"_5":17162,"_23357":96398,"_2365":96444},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2837":57633,"_24687":57618,"_17267":96446,"_5":17162,"_23357":96398,"_2365":96447},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2837":57634,"_24687":57618,"_17267":96449,"_5":17162,"_23357":96398,"_2365":96450},[],"Lamassu entrega el evento al canal configurado.",{"_2837":57635,"_24687":57618,"_17267":96452,"_5":17162,"_23357":96398,"_2365":96453},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2837":57636,"_24687":57618,"_17267":96455,"_5":17162,"_23357":96402,"_2365":96456},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2837":57637,"_24687":57618,"_17267":96458,"_5":17162,"_23357":96402,"_2365":96459},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2837":57638,"_24687":57618,"_17267":96461,"_5":17162,"_23357":96402,"_2365":96462},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2837":57639,"_24687":57618,"_17267":96464,"_5":17162,"_23357":96402,"_2365":96465},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2837":57640,"_24687":57618,"_17267":96467,"_5":17162,"_23357":96402,"_2365":96468},[],"`apikey_options` necesita `header` y `key`.",{"_2837":57641,"_24687":57618,"_17267":96470,"_5":17162,"_23357":96402,"_2365":96471},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2837":57642,"_24687":57618,"_17267":96473,"_5":17162,"_23357":96402,"_2365":96474},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2837":57643,"_24687":57618,"_17267":96476,"_5":17162,"_23357":96402,"_2365":96477},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2837":57644,"_24687":57618,"_17267":96479,"_5":17162,"_23357":96410,"_2365":96480},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2837":57645,"_24687":57618,"_17267":96482,"_5":17162,"_23357":96414,"_2365":96483},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2837":57646,"_24687":57618,"_17267":96485,"_5":17162,"_23357":96418,"_2365":96486},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2837":57647,"_24687":57618,"_17267":96488,"_5":17162,"_23357":96418,"_2365":96489},[],"**None** notifica todas las instancias del evento.",{"_2837":57648,"_24687":57618,"_17267":96491,"_5":17162,"_23357":96418,"_2365":96492},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2837":57649,"_24687":57618,"_17267":96494,"_5":17162,"_23357":96418,"_2365":96495},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2837":57650,"_24687":57618,"_17267":96497,"_5":17162,"_23357":96418,"_2365":96498},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2837":57651,"_24687":57618,"_17267":96500,"_5":17162,"_23357":96418,"_2365":96501},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2837":57652,"_24687":57618,"_17267":96503,"_5":17162,"_23357":96422,"_2365":96504},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2837":57653,"_24687":57618,"_17267":96506,"_5":17162,"_23357":96426,"_2365":96507},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2837":57654,"_24687":57618,"_17267":96509,"_5":17162,"_23357":96426,"_2365":96510},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2837":57655,"_24687":57618,"_17267":96512,"_5":17162,"_23357":96426,"_2365":96513},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2837":57656,"_24687":57618,"_17267":96515,"_5":17162,"_23357":96426,"_2365":96516},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2837":57657,"_24687":57618,"_17267":96518,"_5":17162,"_23357":96426,"_2365":96519},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2837":57658,"_24687":57618,"_17267":96521,"_5":17162,"_23357":96426,"_2365":96522},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2837":57659,"_24687":57618,"_17267":96524,"_5":17162,"_23357":96426,"_2365":96525},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2837":57660,"_24687":57618,"_17267":96527,"_5":17162,"_23357":96426,"_2365":96528},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2837":57661,"_24687":57618,"_17267":96530,"_5":17162,"_23357":96430,"_2365":96531},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2837":57662,"_24687":57618,"_17267":96533,"_5":17162,"_23357":96434,"_2365":96534},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2837":57663,"_24687":57618,"_17267":96536,"_5":17162,"_23357":96434,"_2365":96537},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2837":57664,"_24687":57618,"_17267":96539,"_5":17162,"_23357":96434,"_2365":96540},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2837":57665,"_24687":57618,"_17267":96542,"_5":17162,"_23357":96434,"_2365":96543},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2837":57666,"_24687":57618,"_17267":96545,"_5":17162,"_23357":96434,"_2365":96546},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2837":57667,"_24687":57618,"_17267":96548,"_5":17162,"_23357":96434,"_2365":96549},[],"**Validación:** `va.role.crl.create`.",{"_2837":57668,"_24687":57618,"_17267":96551,"_5":17162,"_23357":96434,"_2365":96552},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2837":57669,"_24687":57618,"_17267":96554,"_5":17162,"_23357":96434,"_2365":96555},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2837":57670,"_24687":57670,"_5":12136,"_2365":96557,"_25023":96558,"_17267":96559,"_23357":57670},"Registros de auditoría",[40249,95914,95915],[],{"_2837":57671,"_24687":57670,"_17267":96561,"_5":17162,"_23357":57670,"_2365":96562},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2837":57672,"_24687":57670,"_5":25020,"_17267":96564,"_23357":96565,"_2365":96566},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2837":57673,"_24687":57670,"_5":25020,"_17267":96568,"_23357":96569,"_2365":96570},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2837":57674,"_24687":57670,"_5":25020,"_17267":96572,"_23357":96573,"_2365":96574},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2837":57675,"_24687":57670,"_5":25020,"_17267":96576,"_23357":96577,"_2365":96578},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2837":57676,"_24687":57670,"_5":25020,"_17267":96580,"_23357":96581,"_2365":96582},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2837":57677,"_24687":57670,"_5":25020,"_17267":96584,"_23357":96585,"_2365":96586},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2837":57678,"_24687":57670,"_5":25020,"_17267":96588,"_23357":96589,"_2365":96590},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2837":57679,"_24687":57670,"_5":25020,"_17267":96592,"_23357":96593,"_2365":96594},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2837":57680,"_24687":57670,"_5":25020,"_17267":96596,"_23357":96597,"_2365":96598},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2837":57681,"_24687":57670,"_5":25020,"_17267":96600,"_23357":96601,"_2365":96602},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2837":57682,"_24687":57670,"_5":25020,"_17267":96604,"_23357":96605,"_2365":96606},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2837":57683,"_24687":57670,"_17267":96608,"_5":17162,"_23357":57670,"_2365":96609},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2837":57684,"_24687":57670,"_17267":96611,"_5":17162,"_23357":96565,"_2365":96612},[],"El cuerpo de auditoría incluye:",{"_2837":57685,"_24687":57670,"_17267":96614,"_5":17162,"_23357":96565,"_2365":96615},[],"input: datos recibidos por la operación;",{"_2837":57686,"_24687":57670,"_17267":96617,"_5":17162,"_23357":96565,"_2365":96618},[],"has\\_error: indica si el servicio devolvió un error;",{"_2837":57687,"_24687":57670,"_17267":96620,"_5":17162,"_23357":96565,"_2365":96621},[],"output: resultado producido o mensaje de error;",{"_2837":57688,"_24687":57670,"_17267":96623,"_5":17162,"_23357":96565,"_2365":96624},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2837":57689,"_24687":57670,"_17267":96626,"_5":17162,"_23357":96565,"_2365":96627},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2837":57690,"_24687":57670,"_17267":96629,"_5":17162,"_23357":96565,"_2365":96630},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2837":57691,"_24687":57670,"_17267":96632,"_5":17162,"_23357":96569,"_2365":96633},[],"El backend aplica auditoría a mutaciones de:",{"_2837":57692,"_24687":57670,"_17267":96635,"_5":17162,"_23357":96569,"_2365":96636},[],"autoridades, certificados y perfiles de emisión;",{"_2837":57693,"_24687":57670,"_17267":96638,"_5":17162,"_23357":96569,"_2365":96639},[],"claves y motores KMS;",{"_2837":57694,"_24687":57670,"_17267":96641,"_5":17162,"_23357":96569,"_2365":96642},[],"dispositivos e identidades;",{"_2837":57695,"_24687":57670,"_17267":96644,"_5":17162,"_23357":96569,"_2365":96645},[],"DMS y operaciones de enrolamiento;",{"_2837":57696,"_24687":57670,"_17267":96647,"_5":17162,"_23357":96569,"_2365":96648},[],"funciones de validación y CRL;",{"_2837":57697,"_24687":57670,"_17267":96650,"_5":17162,"_23357":96569,"_2365":96651},[],"principales, políticas y concesiones de autorización.",{"_2837":57698,"_24687":57670,"_17267":96653,"_5":17162,"_23357":96569,"_2365":96654},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2837":57699,"_24687":57670,"_17267":96656,"_5":17162,"_23357":96573,"_2365":96657},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2837":57700,"_24687":57670,"_17267":96659,"_5":17162,"_23357":96573,"_2365":96660},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2837":57701,"_24687":57670,"_17267":96662,"_5":17162,"_23357":96573,"_2365":96663},[],"Diseña el consumidor para:",{"_2837":57702,"_24687":57670,"_17267":96665,"_5":17162,"_23357":96573,"_2365":96666},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2837":57703,"_24687":57670,"_17267":96668,"_5":17162,"_23357":96573,"_2365":96669},[],"conservar el CloudEvent completo sin modificar;",{"_2837":57704,"_24687":57670,"_17267":96671,"_5":17162,"_23357":96573,"_2365":96672},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2837":57705,"_24687":57670,"_17267":96674,"_5":17162,"_23357":96573,"_2365":96675},[],"cifrar en tránsito y en reposo;",{"_2837":57706,"_24687":57670,"_17267":96677,"_5":17162,"_23357":96573,"_2365":96678},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2837":57707,"_24687":57670,"_17267":96680,"_5":17162,"_23357":96573,"_2365":96681},[],"aplicar una política explícita de retención y legal hold;",{"_2837":57708,"_24687":57670,"_17267":96683,"_5":17162,"_23357":96573,"_2365":96684},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2837":57709,"_24687":57670,"_17267":96686,"_5":17162,"_23357":96577,"_2365":96687},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2837":57710,"_24687":57670,"_17267":96689,"_5":17162,"_23357":96577,"_2365":96690},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2837":57711,"_24687":57670,"_17267":96692,"_5":17162,"_23357":96585,"_2365":96693},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2837":57712,"_24687":57670,"_17267":96695,"_5":17162,"_23357":96589,"_2365":96696},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2837":57713,"_24687":57670,"_17267":96698,"_5":17162,"_23357":96593,"_2365":96699},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2837":57714,"_24687":57670,"_17267":96701,"_5":17162,"_23357":96597,"_2365":96702},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2837":57715,"_24687":57670,"_17267":96704,"_5":17162,"_23357":96601,"_2365":96705},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2837":57716,"_24687":57670,"_17267":96707,"_5":17162,"_23357":96605,"_2365":96708},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2837":57717,"_24687":57670,"_17267":96710,"_5":17162,"_23357":96605,"_2365":96711},[],"aparece un evento de auditoría correcto;",{"_2837":57718,"_24687":57670,"_17267":96713,"_5":17162,"_23357":96605,"_2365":96714},[],"el principal coincide con la identidad utilizada;",{"_2837":57719,"_24687":57670,"_17267":96716,"_5":17162,"_23357":96605,"_2365":96717},[],"el consumidor lo persiste una sola vez;",{"_2837":57720,"_24687":57670,"_17267":96719,"_5":17162,"_23357":96605,"_2365":96720},[],"puede recuperarse por recurso, actor y periodo;",{"_2837":57721,"_24687":57670,"_17267":96722,"_5":17162,"_23357":96605,"_2365":96723},[],"una interrupción del consumidor produce una alerta.",{"_2837":57722,"_24687":57670,"_17267":96725,"_5":17162,"_23357":96605,"_2365":96726},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2837":57723,"_24687":57723,"_5":12136,"_2365":96728,"_25023":96729,"_17267":96730,"_23357":57723},"Arquitectura de la plataforma",[40249,95914],[],{"_2837":57724,"_24687":57723,"_17267":96732,"_5":17162,"_23357":57723,"_2365":96733},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2837":57725,"_24687":57723,"_5":25020,"_17267":96735,"_23357":96736,"_2365":96737},[],"/docs/pr-preview/pr-36/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2837":57726,"_24687":57723,"_5":25020,"_17267":96739,"_23357":96740,"_2365":96741},[],"/docs/pr-preview/pr-36/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2837":57727,"_24687":57723,"_5":25020,"_17267":96743,"_23357":96744,"_2365":96745},[],"/docs/pr-preview/pr-36/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2837":57728,"_24687":57723,"_5":25020,"_17267":96747,"_23357":96748,"_2365":96749},[],"/docs/pr-preview/pr-36/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2837":57729,"_24687":57723,"_5":25020,"_17267":96751,"_23357":96752,"_2365":96753},[],"/docs/pr-preview/pr-36/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2837":57730,"_24687":57723,"_17267":96755,"_5":17162,"_23357":57723,"_2365":96756},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2837":57731,"_24687":57723,"_17267":96758,"_5":17162,"_23357":57723,"_2365":96759},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2837":57732,"_24687":57723,"_17267":96761,"_5":17162,"_23357":96736,"_2365":96762},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2837":57733,"_24687":57723,"_17267":96764,"_5":17162,"_23357":96740,"_2365":96765},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2837":57734,"_24687":57723,"_17267":96767,"_5":17162,"_23357":96744,"_2365":96768},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2837":57735,"_24687":57723,"_17267":96770,"_5":17162,"_23357":96748,"_2365":96771},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2837":57736,"_24687":57723,"_17267":96773,"_5":17162,"_23357":96752,"_2365":96774},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2837":57737,"_24687":57737,"_5":12136,"_2365":96776,"_25023":96777,"_17267":96778,"_23357":57737},"Cómo funciona Lamassu",[40249,95914],[],{"_2837":57738,"_24687":57737,"_17267":96780,"_5":17162,"_23357":57737,"_2365":96781},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2837":57739,"_24687":57737,"_5":25020,"_17267":96783,"_23357":96784,"_2365":96785},[],"/docs/pr-preview/pr-36/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2837":57740,"_24687":57737,"_5":25020,"_17267":96787,"_23357":96788,"_2365":96789},[],"/docs/pr-preview/pr-36/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2837":57741,"_24687":57737,"_17267":96791,"_5":17162,"_23357":57737,"_2365":96792},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2837":57742,"_24687":57737,"_17267":96794,"_5":17162,"_23357":96784,"_2365":96795},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2837":57743,"_24687":57737,"_17267":96797,"_5":17162,"_23357":96784,"_2365":96798},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2837":57744,"_24687":57737,"_17267":96800,"_5":17162,"_23357":96784,"_2365":96801},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2837":57745,"_24687":57737,"_17267":96803,"_5":17162,"_23357":96784,"_2365":96804},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2837":57746,"_24687":57737,"_17267":96806,"_5":17162,"_23357":96784,"_2365":96807},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2837":57747,"_24687":57737,"_17267":96809,"_5":17162,"_23357":96788,"_2365":96810},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2837":57748,"_24687":57737,"_17267":96812,"_5":17162,"_23357":96788,"_2365":96813},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2837":57749,"_24687":57737,"_17267":96815,"_5":17162,"_23357":96788,"_2365":96816},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2837":57750,"_24687":57737,"_17267":96818,"_5":17162,"_23357":96788,"_2365":96819},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2837":57751,"_24687":57737,"_17267":96821,"_5":17162,"_23357":96788,"_2365":96822},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2837":57752,"_24687":57737,"_17267":96824,"_5":17162,"_23357":96788,"_2365":96825},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2837":57753,"_24687":57737,"_17267":96827,"_5":17162,"_23357":96788,"_2365":96828},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2837":57754,"_24687":57754,"_5":12136,"_2365":96830,"_25023":96831,"_17267":96832,"_23357":57754},"Dispositivos e identidades",[40249,95914,42511,96830],[],{"_2837":57755,"_24687":57754,"_17267":96834,"_5":17162,"_23357":57754,"_2365":96835},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2837":57756,"_24687":57754,"_5":25020,"_17267":96837,"_23357":96838,"_2365":96839},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2837":57757,"_24687":57754,"_5":25020,"_17267":96841,"_23357":96842,"_2365":96843},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2837":57758,"_24687":57754,"_5":25020,"_17267":96845,"_23357":96846,"_2365":96847},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2837":57759,"_24687":57754,"_5":25020,"_17267":96849,"_23357":96850,"_2365":96851},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2837":57760,"_24687":57754,"_5":25020,"_17267":96853,"_23357":96854,"_2365":96855},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2837":57761,"_24687":57754,"_5":25020,"_17267":96857,"_23357":96858,"_2365":96859},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2837":57762,"_24687":57754,"_5":25020,"_17267":96861,"_23357":96862,"_2365":96863},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2837":57763,"_24687":57754,"_5":25020,"_17267":96865,"_23357":96866,"_2365":96867},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2837":57764,"_24687":57754,"_5":25020,"_17267":96869,"_23357":96870,"_2365":96871},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2837":57765,"_24687":57754,"_5":25020,"_17267":96873,"_23357":96874,"_2365":96875},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2837":57766,"_24687":57754,"_5":25020,"_17267":96877,"_23357":96878,"_2365":96879},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2837":57767,"_24687":57754,"_17267":96881,"_5":17162,"_23357":57754,"_2365":96882},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2837":57768,"_24687":57754,"_17267":96884,"_5":17162,"_23357":57754,"_2365":96885},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2837":57769,"_24687":57754,"_17267":96887,"_5":17162,"_23357":96838,"_2365":96888},[],"Vista operativa",{"_2837":57770,"_24687":57754,"_17267":96890,"_5":17162,"_23357":96838,"_2365":96891},[],"Interpretación",{"_2837":57771,"_24687":57754,"_17267":96893,"_5":17162,"_23357":96838,"_2365":42574},[],{"_2837":57772,"_24687":57754,"_17267":96895,"_5":17162,"_23357":96838,"_2365":96896},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2837":57773,"_24687":57754,"_17267":96898,"_5":17162,"_23357":96838,"_2365":42580},[],{"_2837":57774,"_24687":57754,"_17267":96900,"_5":17162,"_23357":96838,"_2365":96901},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2837":57775,"_24687":57754,"_17267":96903,"_5":17162,"_23357":96838,"_2365":42586},[],{"_2837":57776,"_24687":57754,"_17267":96905,"_5":17162,"_23357":96838,"_2365":96906},[],"La identidad está en la ventana operativa de renovación.",{"_2837":57777,"_24687":57754,"_17267":96908,"_5":17162,"_23357":96838,"_2365":42592},[],{"_2837":57778,"_24687":57754,"_17267":96910,"_5":17162,"_23357":96838,"_2365":96911},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2837":57779,"_24687":57754,"_17267":96913,"_5":17162,"_23357":96838,"_2365":42598},[],{"_2837":57780,"_24687":57754,"_17267":96915,"_5":17162,"_23357":96838,"_2365":96916},[],"La identidad ha vencido.",{"_2837":57781,"_24687":57754,"_17267":96918,"_5":17162,"_23357":96838,"_2365":42604},[],{"_2837":57782,"_24687":57754,"_17267":96920,"_5":17162,"_23357":96838,"_2365":96921},[],"La identidad está marcada como revocada.",{"_2837":57783,"_24687":57754,"_17267":96923,"_5":17162,"_23357":96838,"_2365":42610},[],{"_2837":57784,"_24687":57754,"_17267":96925,"_5":17162,"_23357":96838,"_2365":96926},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2837":57785,"_24687":57754,"_17267":96928,"_5":17162,"_23357":96838,"_2365":96929},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2837":57786,"_24687":57754,"_17267":96931,"_5":17162,"_23357":96842,"_2365":96932},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2837":57787,"_24687":57754,"_17267":96934,"_5":17162,"_23357":96842,"_2365":96935},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2837":57788,"_24687":57754,"_17267":96937,"_5":17162,"_23357":96842,"_2365":96938},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2837":57789,"_24687":57754,"_17267":96940,"_5":17162,"_23357":96842,"_2365":96941},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2837":57790,"_24687":57754,"_17267":96943,"_5":17162,"_23357":96846,"_2365":96944},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2837":57791,"_24687":57754,"_17267":96946,"_5":17162,"_23357":96850,"_2365":96947},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2837":57792,"_24687":57754,"_17267":96949,"_5":17162,"_23357":96854,"_2365":96950},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2837":57793,"_24687":57754,"_17267":96952,"_5":17162,"_23357":96858,"_2365":96953},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2837":57794,"_24687":57754,"_17267":96955,"_5":17162,"_23357":96862,"_2365":96956},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2837":57795,"_24687":57754,"_17267":96958,"_5":17162,"_23357":96862,"_2365":96959},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2837":57796,"_24687":57754,"_17267":96961,"_5":17162,"_23357":96866,"_2365":96962},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2837":57797,"_24687":57754,"_17267":96964,"_5":17162,"_23357":96866,"_2365":96965},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2837":57798,"_24687":57754,"_17267":96967,"_5":17162,"_23357":96866,"_2365":96968},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2837":57799,"_24687":57754,"_17267":96970,"_5":17162,"_23357":96866,"_2365":96971},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2837":57800,"_24687":57754,"_17267":96973,"_5":17162,"_23357":96866,"_2365":96974},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2837":57801,"_24687":57754,"_17267":96976,"_5":17162,"_23357":96866,"_2365":96977},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2837":57802,"_24687":57754,"_17267":96979,"_5":17162,"_23357":96870,"_2365":96980},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2837":57803,"_24687":57754,"_17267":96982,"_5":17162,"_23357":96870,"_2365":96983},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2837":57804,"_24687":57754,"_17267":96985,"_5":17162,"_23357":96874,"_2365":96986},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2837":57805,"_24687":57754,"_17267":96988,"_5":17162,"_23357":96874,"_2365":96989},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2837":57806,"_24687":57754,"_17267":96991,"_5":17162,"_23357":96874,"_2365":96992},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2837":57807,"_24687":57754,"_17267":96994,"_5":17162,"_23357":96874,"_2365":96995},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2837":57808,"_24687":57754,"_17267":96997,"_5":17162,"_23357":96878,"_2365":96998},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2837":57809,"_24687":57754,"_17267":97000,"_5":17162,"_23357":96878,"_2365":97001},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2837":57810,"_24687":57810,"_5":12136,"_2365":97003,"_25023":97004,"_17267":97006,"_23357":57810},"Identidad inicial y autenticación",[40249,95914,42511,96830,97005],"Enrolamiento con PKI",[],{"_2837":57811,"_24687":57810,"_17267":97008,"_5":17162,"_23357":57810,"_2365":97009},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2837":57812,"_24687":57810,"_5":25020,"_17267":97011,"_23357":97012,"_2365":97013},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2837":57813,"_24687":57810,"_5":25020,"_17267":97015,"_23357":97016,"_2365":97017},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2837":57814,"_24687":57810,"_5":25020,"_17267":97019,"_23357":97020,"_2365":97021},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2837":57815,"_24687":57810,"_5":25020,"_17267":97023,"_23357":97024,"_2365":97025},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2837":57816,"_24687":57810,"_5":25020,"_17267":97027,"_23357":97028,"_2365":97029},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2837":57817,"_24687":57810,"_17267":97031,"_5":17162,"_23357":57810,"_2365":97032},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2837":57818,"_24687":57810,"_17267":97034,"_5":17162,"_23357":97012,"_2365":97035},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2837":57819,"_24687":57810,"_17267":97037,"_5":17162,"_23357":97012,"_2365":97038},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2837":57820,"_24687":57810,"_17267":97040,"_5":17162,"_23357":97016,"_2365":97041},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2837":57821,"_24687":57810,"_17267":97043,"_5":17162,"_23357":97016,"_2365":97044},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2837":57822,"_24687":57810,"_17267":97046,"_5":17162,"_23357":97016,"_2365":97047},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2837":57823,"_24687":57810,"_17267":97049,"_5":17162,"_23357":97020,"_2365":97050},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2837":57824,"_24687":57810,"_17267":97052,"_5":17162,"_23357":97020,"_2365":97053},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2837":57825,"_24687":57810,"_17267":97055,"_5":17162,"_23357":97024,"_2365":97056},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2837":57826,"_24687":57810,"_17267":97058,"_5":17162,"_23357":97024,"_2365":97059},[],"Ejemplo de cuerpo:",{"_2837":57827,"_24687":57810,"_17267":97061,"_5":17162,"_23357":97024,"_2365":97062},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2837":57828,"_24687":57810,"_17267":97064,"_5":17162,"_23357":97024,"_2365":97065},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2837":57829,"_24687":57810,"_17267":97067,"_5":17162,"_23357":97024,"_2365":97068},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2837":57830,"_24687":57810,"_17267":97070,"_5":17162,"_23357":97024,"_2365":97071},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2837":57831,"_24687":57810,"_17267":97073,"_5":17162,"_23357":97028,"_2365":97074},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2837":57832,"_24687":57810,"_17267":97076,"_5":17162,"_23357":97028,"_2365":97077},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2837":57833,"_24687":57833,"_5":12136,"_2365":97079,"_25023":97080,"_17267":97081,"_23357":57833},"Configura y opera el DMS",[40249,95914,42511,96830,97005],[],{"_2837":57834,"_24687":57833,"_17267":97083,"_5":17162,"_23357":57833,"_2365":97084},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2837":57835,"_24687":57833,"_5":25020,"_17267":97086,"_23357":97087,"_2365":94615},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2837":57836,"_24687":57833,"_5":25020,"_17267":97089,"_23357":97090,"_2365":97091},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2837":57837,"_24687":57833,"_5":25020,"_17267":97093,"_23357":97094,"_2365":97095},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2837":57838,"_24687":57833,"_5":25020,"_17267":97097,"_23357":97098,"_2365":97099},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2837":57839,"_24687":57833,"_5":25020,"_17267":97101,"_23357":97102,"_2365":97103},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2837":57840,"_24687":57833,"_5":25020,"_17267":97105,"_23357":97106,"_2365":97107},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2837":57841,"_24687":57833,"_5":25020,"_17267":97109,"_23357":97110,"_2365":97111},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2837":57842,"_24687":57833,"_5":25020,"_17267":97113,"_23357":97114,"_2365":97115},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2837":57843,"_24687":57833,"_5":25020,"_17267":97117,"_23357":97118,"_2365":42806},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2837":57844,"_24687":57833,"_5":25020,"_17267":97120,"_23357":97121,"_2365":42810},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2837":57845,"_24687":57833,"_5":25020,"_17267":97123,"_23357":97124,"_2365":97125},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2837":57846,"_24687":57833,"_5":25020,"_17267":97127,"_23357":97128,"_2365":97129},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2837":57847,"_24687":57833,"_5":25020,"_17267":97131,"_23357":97132,"_2365":97133},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2837":57848,"_24687":57833,"_5":25020,"_17267":97135,"_23357":97136,"_2365":97137},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2837":57849,"_24687":57833,"_5":25020,"_17267":97139,"_23357":97140,"_2365":42830},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2837":57850,"_24687":57833,"_5":25020,"_17267":97142,"_23357":97143,"_2365":97144},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2837":57851,"_24687":57833,"_5":25020,"_17267":97146,"_23357":97147,"_2365":97148},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2837":57852,"_24687":57833,"_5":25020,"_17267":97150,"_23357":97151,"_2365":97152},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2837":57853,"_24687":57833,"_17267":97154,"_5":17162,"_23357":57833,"_2365":97155},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2837":57854,"_24687":57833,"_17267":97157,"_5":17162,"_23357":97087,"_2365":97158},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2837":57855,"_24687":57833,"_17267":97160,"_5":17162,"_23357":97087,"_2365":97161},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2837":57856,"_24687":57833,"_17267":97163,"_5":17162,"_23357":97094,"_2365":97164},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2837":57857,"_24687":57833,"_17267":97166,"_5":17162,"_23357":97098,"_2365":97167},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2837":57858,"_24687":57833,"_17267":97169,"_5":17162,"_23357":97102,"_2365":97170},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2837":57859,"_24687":57833,"_17267":97172,"_5":17162,"_23357":97106,"_2365":97173},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2837":57860,"_24687":57833,"_17267":97175,"_5":17162,"_23357":97110,"_2365":97176},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2837":57861,"_24687":57833,"_17267":97178,"_5":17162,"_23357":97118,"_2365":97179},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2837":57862,"_24687":57833,"_17267":97181,"_5":17162,"_23357":97118,"_2365":97182},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2837":57863,"_24687":57833,"_17267":97184,"_5":17162,"_23357":97121,"_2365":97185},[],"Campo de `settings.enrollment_settings`",{"_2837":57864,"_24687":57833,"_17267":97187,"_5":17162,"_23357":97121,"_2365":97188},[],"Decisión",{"_2837":57865,"_24687":57833,"_17267":97190,"_5":17162,"_23357":97121,"_2365":42881},[],{"_2837":57866,"_24687":57833,"_17267":97192,"_5":17162,"_23357":97121,"_2365":97193},[],"`EST_RFC7030` para estas operaciones.",{"_2837":57867,"_24687":57833,"_17267":97195,"_5":17162,"_23357":97121,"_2365":42887},[],{"_2837":57868,"_24687":57833,"_17267":97197,"_5":17162,"_23357":97121,"_2365":97198},[],"ID de la CA que firmará.",{"_2837":57869,"_24687":57833,"_17267":97200,"_5":17162,"_23357":97121,"_2365":42893},[],{"_2837":57870,"_24687":57833,"_17267":97202,"_5":17162,"_23357":97121,"_2365":97203},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2837":57871,"_24687":57833,"_17267":97205,"_5":17162,"_23357":97121,"_2365":42899},[],{"_2837":57872,"_24687":57833,"_17267":97207,"_5":17162,"_23357":97121,"_2365":97208},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2837":57873,"_24687":57833,"_17267":97210,"_5":17162,"_23357":97121,"_2365":42905},[],{"_2837":57874,"_24687":57833,"_17267":97212,"_5":17162,"_23357":97121,"_2365":97213},[],"Uno de los cuatro modos de autenticación.",{"_2837":57875,"_24687":57833,"_17267":97215,"_5":17162,"_23357":97121,"_2365":97216},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2837":57876,"_24687":57833,"_17267":97218,"_5":17162,"_23357":97124,"_2365":97219},[],"Los bloques son independientes:",{"_2837":57877,"_24687":57833,"_17267":97221,"_5":17162,"_23357":97124,"_2365":97222},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2837":57878,"_24687":57833,"_17267":97224,"_5":17162,"_23357":97124,"_2365":97225},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2837":57879,"_24687":57833,"_17267":97227,"_5":17162,"_23357":97124,"_2365":42923},[],{"_2837":57880,"_24687":57833,"_17267":97229,"_5":17162,"_23357":97124,"_2365":97230},[],"Control aplicado en la operación configurada",{"_2837":57881,"_24687":57833,"_17267":97232,"_5":17162,"_23357":97124,"_2365":42929},[],{"_2837":57882,"_24687":57833,"_17267":97234,"_5":17162,"_23357":97124,"_2365":97235},[],"Validación del certificado presentado.",{"_2837":57883,"_24687":57833,"_17267":97237,"_5":17162,"_23357":97124,"_2365":42935},[],{"_2837":57884,"_24687":57833,"_17267":97239,"_5":17162,"_23357":97124,"_2365":97240},[],"Autorización del webhook configurado.",{"_2837":57885,"_24687":57833,"_17267":97242,"_5":17162,"_23357":97124,"_2365":42941},[],{"_2837":57886,"_24687":57833,"_17267":97244,"_5":17162,"_23357":97124,"_2365":97245},[],"Validación del certificado y, después, aprobación del webhook.",{"_2837":57887,"_24687":57833,"_17267":97247,"_5":17162,"_23357":97124,"_2365":42947},[],{"_2837":57888,"_24687":57833,"_17267":97249,"_5":17162,"_23357":97124,"_2365":97250},[],"Sin autenticación del solicitante por el DMS.",{"_2837":57889,"_24687":57833,"_17267":97252,"_5":17162,"_23357":97124,"_2365":97253},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2837":57890,"_24687":57833,"_17267":97255,"_5":17162,"_23357":97124,"_2365":97256},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2837":57891,"_24687":57833,"_17267":97258,"_5":17162,"_23357":97124,"_2365":97259},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2837":57892,"_24687":57833,"_17267":97261,"_5":17162,"_23357":97124,"_2365":97262},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2837":57893,"_24687":57833,"_17267":97264,"_5":17162,"_23357":97128,"_2365":97265},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2837":57894,"_24687":57833,"_17267":97267,"_5":17162,"_23357":97128,"_2365":97268},[],"Campo de `external_webhook_settings`",{"_2837":57895,"_24687":57833,"_17267":97270,"_5":17162,"_23357":97128,"_2365":97188},[],{"_2837":57896,"_24687":57833,"_17267":97272,"_5":17162,"_23357":97128,"_2365":42973},[],{"_2837":57897,"_24687":57833,"_17267":97274,"_5":17162,"_23357":97128,"_2365":97275},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2837":57898,"_24687":57833,"_17267":97277,"_5":17162,"_23357":97128,"_2365":42979},[],{"_2837":57899,"_24687":57833,"_17267":97279,"_5":17162,"_23357":97128,"_2365":97280},[],"`POST` o `PUT`; `POST` por defecto.",{"_2837":57900,"_24687":57833,"_17267":97282,"_5":17162,"_23357":97128,"_2365":42985},[],{"_2837":57901,"_24687":57833,"_17267":97284,"_5":17162,"_23357":97128,"_2365":97285},[],"Etiqueta usada en los logs del servicio.",{"_2837":57902,"_24687":57833,"_17267":97287,"_5":17162,"_23357":97128,"_2365":42991},[],{"_2837":57903,"_24687":57833,"_17267":97289,"_5":17162,"_23357":97128,"_2365":97290},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2837":57904,"_24687":57833,"_17267":97292,"_5":17162,"_23357":97128,"_2365":42997},[],{"_2837":57905,"_24687":57833,"_17267":97294,"_5":17162,"_23357":97128,"_2365":97295},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2837":57906,"_24687":57833,"_17267":97297,"_5":17162,"_23357":97128,"_2365":43003},[],{"_2837":57907,"_24687":57833,"_17267":97299,"_5":17162,"_23357":97128,"_2365":97300},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2837":57908,"_24687":57833,"_17267":97302,"_5":17162,"_23357":97128,"_2365":43009},[],{"_2837":57909,"_24687":57833,"_17267":97304,"_5":17162,"_23357":97128,"_2365":97305},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2837":57910,"_24687":57833,"_17267":97307,"_5":17162,"_23357":97128,"_2365":43015},[],{"_2837":57911,"_24687":57833,"_17267":97309,"_5":17162,"_23357":97128,"_2365":97310},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2837":57912,"_24687":57833,"_17267":97312,"_5":17162,"_23357":97128,"_2365":43021},[],{"_2837":57913,"_24687":57833,"_17267":97314,"_5":17162,"_23357":97128,"_2365":97315},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2837":57914,"_24687":57833,"_17267":97317,"_5":17162,"_23357":97128,"_2365":97318},[],"Reglas de esa configuración:",{"_2837":57915,"_24687":57833,"_17267":97320,"_5":17162,"_23357":97128,"_2365":97321},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2837":57916,"_24687":57833,"_17267":97323,"_5":17162,"_23357":97128,"_2365":97324},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2837":57917,"_24687":57833,"_17267":97326,"_5":17162,"_23357":97128,"_2365":97327},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2837":57918,"_24687":57833,"_17267":97329,"_5":17162,"_23357":97128,"_2365":97330},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2837":57919,"_24687":57833,"_17267":97332,"_5":17162,"_23357":97128,"_2365":97333},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2837":57920,"_24687":57833,"_17267":97335,"_5":17162,"_23357":97128,"_2365":97336},[],"Con credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en texto claro. Prefiere `https://` para `url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2837":57921,"_24687":57833,"_17267":97338,"_5":17162,"_23357":97128,"_2365":97339},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2837":57922,"_24687":57833,"_17267":97341,"_5":17162,"_23357":97128,"_2365":97342},[],"La migración `20261021120000` reescribe la configuración de webhook almacenada a este esquema: `validate_server_cert` pasa a ser el `insecure_skip_verify` negado (una configuración con `validate_server_cert` en falso sigue omitiendo la verificación), `oidc` pasa a `jwt_options`, `apikey` pasa a `apikey_options` y `mtls` pasa a `mtls_options`. Los valores PEM se mueven a `mtls_options.cert_content` y `key_content`; los valores heredados que eran rutas de archivo pasan a `mtls_options.cert_file` y `key_file`, que la entrega rechaza. Cada enroll y reenroll cuyo modo de autenticación use el webhook falla hasta que el certificado y la clave se introduzcan de nuevo como contenido PEM. La conversión solo comprueba el valor del certificado buscando el marcado PEM: una configuración heredada mixta (certificado PEM, clave como ruta) se convierte en un par de contenidos inválido y debe introducirse de nuevo íntegramente como PEM. Si la consola de tu versión no expone esos campos, edita el DMS mediante la API DMS.",{"_2837":57923,"_24687":57833,"_17267":97344,"_5":17162,"_23357":97132,"_2365":97345},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2837":57924,"_24687":57833,"_17267":97347,"_5":17162,"_23357":97136,"_2365":97348},[],"Campo de `settings.reenrollment_settings`",{"_2837":57925,"_24687":57833,"_17267":97350,"_5":17162,"_23357":97136,"_2365":97351},[],"Función",{"_2837":57926,"_24687":57833,"_17267":97353,"_5":17162,"_23357":97136,"_2365":43062},[],{"_2837":57927,"_24687":57833,"_17267":97355,"_5":17162,"_23357":97136,"_2365":97356},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2837":57928,"_24687":57833,"_17267":97358,"_5":17162,"_23357":97136,"_2365":43068},[],{"_2837":57929,"_24687":57833,"_17267":97360,"_5":17162,"_23357":97136,"_2365":97361},[],"Umbral operativo preventivo de monitorización.",{"_2837":57930,"_24687":57833,"_17267":97363,"_5":17162,"_23357":97136,"_2365":43074},[],{"_2837":57931,"_24687":57833,"_17267":97365,"_5":17162,"_23357":97136,"_2365":97366},[],"Umbral operativo crítico de monitorización.",{"_2837":57932,"_24687":57833,"_17267":97368,"_5":17162,"_23357":97136,"_2365":43080},[],{"_2837":57933,"_24687":57833,"_17267":97370,"_5":17162,"_23357":97136,"_2365":97371},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2837":57934,"_24687":57833,"_17267":97373,"_5":17162,"_23357":97136,"_2365":43086},[],{"_2837":57935,"_24687":57833,"_17267":97375,"_5":17162,"_23357":97136,"_2365":97376},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2837":57936,"_24687":57833,"_17267":97378,"_5":17162,"_23357":97136,"_2365":43092},[],{"_2837":57937,"_24687":57833,"_17267":97380,"_5":17162,"_23357":97136,"_2365":97381},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2837":57938,"_24687":57833,"_17267":97383,"_5":17162,"_23357":97136,"_2365":97384},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2837":57939,"_24687":57833,"_17267":97386,"_5":17162,"_23357":97140,"_2365":97387},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2837":57940,"_24687":57833,"_17267":97389,"_5":17162,"_23357":97143,"_2365":94972},[],{"_2837":57941,"_24687":57833,"_17267":97391,"_5":17162,"_23357":97143,"_2365":97392},[],"Qué publica",{"_2837":57942,"_24687":57833,"_17267":97394,"_5":17162,"_23357":97143,"_2365":43109},[],{"_2837":57943,"_24687":57833,"_17267":97396,"_5":17162,"_23357":97143,"_2365":97397},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2837":57944,"_24687":57833,"_17267":97399,"_5":17162,"_23357":97143,"_2365":43115},[],{"_2837":57945,"_24687":57833,"_17267":97401,"_5":17162,"_23357":97143,"_2365":97402},[],"Certificado de la CA emisora seleccionada.",{"_2837":57946,"_24687":57833,"_17267":97404,"_5":17162,"_23357":97143,"_2365":43121},[],{"_2837":57947,"_24687":57833,"_17267":97406,"_5":17162,"_23357":97143,"_2365":97407},[],"Certificados de las CAs elegidas explícitamente.",{"_2837":57948,"_24687":57833,"_17267":97409,"_5":17162,"_23357":97143,"_2365":97410},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2837":57949,"_24687":57833,"_17267":97412,"_5":17162,"_23357":97147,"_2365":97413},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2837":57950,"_24687":57833,"_17267":97415,"_5":17162,"_23357":97147,"_2365":97416},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2837":57951,"_24687":57833,"_17267":97418,"_5":17162,"_23357":97147,"_2365":97419},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2837":57952,"_24687":57833,"_17267":97421,"_5":17162,"_23357":97151,"_2365":97422},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2837":57953,"_24687":57953,"_5":12136,"_2365":97424,"_25023":97425,"_17267":97426,"_23357":57953},"Integra el cliente EST",[40249,95914,42511,96830,97005],[],{"_2837":57954,"_24687":57953,"_17267":97428,"_5":17162,"_23357":57953,"_2365":97429},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2837":57955,"_24687":57953,"_5":25020,"_17267":97431,"_23357":97432,"_2365":94615},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2837":57956,"_24687":57953,"_5":25020,"_17267":97434,"_23357":97435,"_2365":97436},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2837":57957,"_24687":57953,"_5":25020,"_17267":97438,"_23357":97439,"_2365":97440},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2837":57958,"_24687":57953,"_5":25020,"_17267":97442,"_23357":97443,"_2365":97444},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2837":57959,"_24687":57953,"_5":25020,"_17267":97446,"_23357":97447,"_2365":97448},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2837":57960,"_24687":57953,"_5":25020,"_17267":97450,"_23357":97451,"_2365":97452},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2837":57961,"_24687":57953,"_17267":97454,"_5":17162,"_23357":57953,"_2365":97455},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2837":57962,"_24687":57953,"_17267":97457,"_5":17162,"_23357":97432,"_2365":97458},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2837":57963,"_24687":57953,"_17267":97460,"_5":17162,"_23357":97432,"_2365":97461},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2837":57964,"_24687":57953,"_17267":97463,"_5":17162,"_23357":97432,"_2365":97464},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2837":57965,"_24687":57953,"_17267":97466,"_5":17162,"_23357":97435,"_2365":97467},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2837":57966,"_24687":57953,"_17267":97469,"_5":17162,"_23357":97435,"_2365":97470},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2837":57967,"_24687":57953,"_17267":97472,"_5":17162,"_23357":97439,"_2365":97473},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2837":57968,"_24687":57953,"_17267":97475,"_5":17162,"_23357":97439,"_2365":97476},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2837":57969,"_24687":57953,"_17267":97478,"_5":17162,"_23357":97443,"_2365":97479},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2837":57970,"_24687":57953,"_17267":97481,"_5":17162,"_23357":97443,"_2365":97482},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2837":57971,"_24687":57953,"_17267":97484,"_5":17162,"_23357":97447,"_2365":97485},[],"Para el caso de una raíz que emite directamente:",{"_2837":57972,"_24687":57953,"_17267":97487,"_5":17162,"_23357":97447,"_2365":97488},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2837":57973,"_24687":57953,"_17267":97490,"_5":17162,"_23357":97447,"_2365":97491},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2837":57974,"_24687":57953,"_17267":97493,"_5":17162,"_23357":97451,"_2365":97494},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2837":57975,"_24687":57975,"_5":12136,"_2365":97496,"_25023":97497,"_17267":97498,"_23357":57975},"Referencia EST",[40249,95914,42511,96830,97005],[],{"_2837":57976,"_24687":57975,"_17267":97500,"_5":17162,"_23357":57975,"_2365":97501},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2837":57977,"_24687":57975,"_5":25020,"_17267":97503,"_23357":97504,"_2365":97505},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2837":57978,"_24687":57975,"_5":25020,"_17267":97507,"_23357":97508,"_2365":18723},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2837":57979,"_24687":57975,"_5":25020,"_17267":97510,"_23357":97511,"_2365":21471},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2837":57980,"_24687":57975,"_5":25020,"_17267":97513,"_23357":97514,"_2365":21478},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2837":57981,"_24687":57975,"_5":25020,"_17267":97516,"_23357":97517,"_2365":20848},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2837":57982,"_24687":57975,"_5":25020,"_17267":97519,"_23357":97520,"_2365":97521},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2837":57983,"_24687":57975,"_5":25020,"_17267":97523,"_23357":97524,"_2365":97525},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2837":57984,"_24687":57975,"_5":25020,"_17267":97527,"_23357":97528,"_2365":97529},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2837":57985,"_24687":57975,"_17267":97531,"_5":17162,"_23357":57975,"_2365":97532},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2837":57986,"_24687":57975,"_17267":97534,"_5":17162,"_23357":97504,"_2365":97535},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2837":57987,"_24687":57975,"_17267":97537,"_5":17162,"_23357":97504,"_2365":95705},[],{"_2837":57988,"_24687":57975,"_17267":97539,"_5":17162,"_23357":97504,"_2365":97540},[],"Método",{"_2837":57989,"_24687":57975,"_17267":97542,"_5":17162,"_23357":97504,"_2365":97543},[],"Autenticación y condición",{"_2837":57990,"_24687":57975,"_17267":97545,"_5":17162,"_23357":97504,"_2365":43264},[],{"_2837":57991,"_24687":57975,"_17267":97547,"_5":17162,"_23357":97504,"_2365":43267},[],{"_2837":57992,"_24687":57975,"_17267":97549,"_5":17162,"_23357":97504,"_2365":97550},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2837":57993,"_24687":57975,"_17267":97552,"_5":17162,"_23357":97504,"_2365":43273},[],{"_2837":57994,"_24687":57975,"_17267":97554,"_5":17162,"_23357":97504,"_2365":43276},[],{"_2837":57995,"_24687":57975,"_17267":97556,"_5":17162,"_23357":97504,"_2365":97557},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2837":57996,"_24687":57975,"_17267":97559,"_5":17162,"_23357":97504,"_2365":43282},[],{"_2837":57997,"_24687":57975,"_17267":97561,"_5":17162,"_23357":97504,"_2365":43276},[],{"_2837":57998,"_24687":57975,"_17267":97563,"_5":17162,"_23357":97504,"_2365":97564},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2837":57999,"_24687":57975,"_17267":97566,"_5":17162,"_23357":97504,"_2365":43290},[],{"_2837":58000,"_24687":57975,"_17267":97568,"_5":17162,"_23357":97504,"_2365":43276},[],{"_2837":58001,"_24687":57975,"_17267":97570,"_5":17162,"_23357":97504,"_2365":97571},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2837":58002,"_24687":57975,"_17267":97573,"_5":17162,"_23357":97504,"_2365":97574},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2837":58003,"_24687":57975,"_17267":97576,"_5":17162,"_23357":97508,"_2365":97577},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2837":58004,"_24687":57975,"_17267":97579,"_5":17162,"_23357":97508,"_2365":97580},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2837":58005,"_24687":57975,"_17267":97582,"_5":17162,"_23357":97511,"_2365":97583},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2837":58006,"_24687":57975,"_17267":97585,"_5":17162,"_23357":97511,"_2365":97586},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2837":58007,"_24687":57975,"_17267":97588,"_5":17162,"_23357":97514,"_2365":97589},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2837":58008,"_24687":57975,"_17267":97591,"_5":17162,"_23357":97514,"_2365":97592},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2837":58009,"_24687":57975,"_17267":97594,"_5":17162,"_23357":97517,"_2365":97595},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2837":58010,"_24687":57975,"_17267":97597,"_5":17162,"_23357":97517,"_2365":97598},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2837":58011,"_24687":57975,"_17267":97600,"_5":17162,"_23357":97520,"_2365":97601},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2837":58012,"_24687":57975,"_17267":97603,"_5":17162,"_23357":97520,"_2365":97604},[],"Parte",{"_2837":58013,"_24687":57975,"_17267":97606,"_5":17162,"_23357":97520,"_2365":97607},[],"Contenido tras decodificar su Base64",{"_2837":58014,"_24687":57975,"_17267":97609,"_5":17162,"_23357":97520,"_2365":43334},[],{"_2837":58015,"_24687":57975,"_17267":97611,"_5":17162,"_23357":97520,"_2365":97612},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2837":58016,"_24687":57975,"_17267":97614,"_5":17162,"_23357":97520,"_2365":43340},[],{"_2837":58017,"_24687":57975,"_17267":97616,"_5":17162,"_23357":97520,"_2365":97617},[],"PKCS#7 DER con el certificado emitido.",{"_2837":58018,"_24687":57975,"_17267":97619,"_5":17162,"_23357":97520,"_2365":97620},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2837":58019,"_24687":57975,"_17267":97622,"_5":17162,"_23357":97524,"_2365":97623},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2837":58020,"_24687":57975,"_17267":97625,"_5":17162,"_23357":97524,"_2365":97626},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2837":58021,"_24687":57975,"_17267":97628,"_5":17162,"_23357":97524,"_2365":97629},[],"Convierte y comprueba el resultado:",{"_2837":58022,"_24687":57975,"_17267":97631,"_5":17162,"_23357":97524,"_2365":97632},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2837":58023,"_24687":57975,"_17267":97634,"_5":17162,"_23357":97528,"_2365":97635},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2837":58024,"_24687":57975,"_17267":97637,"_5":17162,"_23357":97528,"_2365":97638},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2837":58025,"_24687":58025,"_5":12136,"_2365":97005,"_25023":97640,"_17267":97641,"_23357":58025},[40249,95914,42511,96830,97005],[],{"_2837":58026,"_24687":58025,"_17267":97643,"_5":17162,"_23357":58025,"_2365":97644},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2837":58027,"_24687":58025,"_5":25020,"_17267":97646,"_23357":97647,"_2365":97648},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2837":58028,"_24687":58025,"_5":25020,"_17267":97650,"_23357":97651,"_2365":97652},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2837":58029,"_24687":58025,"_5":25020,"_17267":97654,"_23357":97655,"_2365":97656},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2837":58030,"_24687":58025,"_5":25020,"_17267":97658,"_23357":97659,"_2365":97660},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2837":58031,"_24687":58025,"_17267":97662,"_5":17162,"_23357":58025,"_2365":97663},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2837":58032,"_24687":58025,"_17267":97665,"_5":17162,"_23357":97647,"_2365":97666},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2837":58033,"_24687":58025,"_17267":97668,"_5":17162,"_23357":97647,"_2365":97669},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2837":58034,"_24687":58025,"_17267":97671,"_5":17162,"_23357":97647,"_2365":97672},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2837":58035,"_24687":58025,"_17267":97674,"_5":17162,"_23357":97647,"_2365":97675},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2837":58036,"_24687":58025,"_17267":97677,"_5":17162,"_23357":97647,"_2365":97678},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2837":58037,"_24687":58025,"_17267":97680,"_5":17162,"_23357":97647,"_2365":97681},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2837":58038,"_24687":58025,"_17267":97683,"_5":17162,"_23357":97651,"_2365":97684},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2837":58039,"_24687":58025,"_17267":97686,"_5":17162,"_23357":97651,"_2365":97687},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2837":58040,"_24687":58025,"_17267":97689,"_5":17162,"_23357":97651,"_2365":97690},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2837":58041,"_24687":58025,"_17267":97692,"_5":17162,"_23357":97651,"_2365":97693},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2837":58042,"_24687":58025,"_17267":97695,"_5":17162,"_23357":97655,"_2365":97696},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2837":58043,"_24687":58025,"_17267":97698,"_5":17162,"_23357":97655,"_2365":97699},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2837":58044,"_24687":58025,"_17267":97701,"_5":17162,"_23357":97655,"_2365":97702},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2837":58045,"_24687":58025,"_17267":97704,"_5":17162,"_23357":97655,"_2365":97705},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2837":58046,"_24687":58025,"_17267":97707,"_5":17162,"_23357":97659,"_2365":97708},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2837":58047,"_24687":58025,"_17267":97710,"_5":17162,"_23357":97659,"_2365":97711},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2837":58048,"_24687":58048,"_5":12136,"_2365":97713,"_25023":97714,"_17267":97715,"_23357":58048},"Estrategias de aprovisionamiento",[40249,95914,42511,96830,97005],[],{"_2837":58049,"_24687":58048,"_17267":97717,"_5":17162,"_23357":58048,"_2365":97718},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2837":58050,"_24687":58048,"_5":25020,"_17267":97720,"_23357":97721,"_2365":97722},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2837":58051,"_24687":58048,"_5":25020,"_17267":97724,"_23357":97725,"_2365":97726},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2837":58052,"_24687":58048,"_5":25020,"_17267":97728,"_23357":97729,"_2365":97730},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2837":58053,"_24687":58048,"_5":25020,"_17267":97732,"_23357":97733,"_2365":97734},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2837":58054,"_24687":58048,"_5":25020,"_17267":97736,"_23357":97737,"_2365":97738},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2837":58055,"_24687":58048,"_17267":97740,"_5":17162,"_23357":58048,"_2365":97741},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2837":58056,"_24687":58048,"_17267":97743,"_5":17162,"_23357":97721,"_2365":97744},[],"Recorrido",{"_2837":58057,"_24687":58048,"_17267":97746,"_5":17162,"_23357":97721,"_2365":97747},[],"Cuándo existe el dispositivo",{"_2837":58058,"_24687":58048,"_17267":97749,"_5":17162,"_23357":97721,"_2365":97750},[],"Qué compruebas",{"_2837":58059,"_24687":58048,"_17267":97752,"_5":17162,"_23357":97721,"_2365":97753},[],"Asignación manual",{"_2837":58060,"_24687":58048,"_17267":97755,"_5":17162,"_23357":97721,"_2365":97756},[],"El operador lo crea antes de asociar un certificado.",{"_2837":58061,"_24687":58048,"_17267":97758,"_5":17162,"_23357":97721,"_2365":97759},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2837":58062,"_24687":58048,"_17267":97761,"_5":17162,"_23357":97721,"_2365":97762},[],"EST con `JITP`",{"_2837":58063,"_24687":58048,"_17267":97764,"_5":17162,"_23357":97721,"_2365":97765},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2837":58064,"_24687":58048,"_17267":97767,"_5":17162,"_23357":97721,"_2365":97768},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2837":58065,"_24687":58048,"_17267":97770,"_5":17162,"_23357":97721,"_2365":97771},[],"EST con `PRE_REGISTRATION`",{"_2837":58066,"_24687":58048,"_17267":97773,"_5":17162,"_23357":97721,"_2365":97774},[],"Debe existir antes de `/simpleenroll`.",{"_2837":58067,"_24687":58048,"_17267":97776,"_5":17162,"_23357":97721,"_2365":97777},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2837":58068,"_24687":58048,"_17267":97779,"_5":17162,"_23357":97721,"_2365":97780},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2837":58069,"_24687":58048,"_17267":97782,"_5":17162,"_23357":97721,"_2365":97783},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2837":58070,"_24687":58048,"_17267":97785,"_5":17162,"_23357":97725,"_2365":97786},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2837":58071,"_24687":58048,"_17267":97788,"_5":17162,"_23357":97725,"_2365":97789},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2837":58072,"_24687":58048,"_17267":97791,"_5":17162,"_23357":97725,"_2365":97792},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2837":58073,"_24687":58048,"_17267":97794,"_5":17162,"_23357":97729,"_2365":97795},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2837":58074,"_24687":58048,"_17267":97797,"_5":17162,"_23357":97729,"_2365":97798},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2837":58075,"_24687":58048,"_17267":97800,"_5":17162,"_23357":97729,"_2365":97801},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2837":58076,"_24687":58048,"_17267":97803,"_5":17162,"_23357":97729,"_2365":97804},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2837":58077,"_24687":58048,"_17267":97806,"_5":17162,"_23357":97729,"_2365":97807},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2837":58078,"_24687":58048,"_17267":97809,"_5":17162,"_23357":97729,"_2365":97810},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2837":58079,"_24687":58048,"_17267":97812,"_5":17162,"_23357":97733,"_2365":94972},[],{"_2837":58080,"_24687":58048,"_17267":97814,"_5":17162,"_23357":97733,"_2365":97815},[],"Material que atraviesa EST",{"_2837":58081,"_24687":58048,"_17267":97817,"_5":17162,"_23357":97733,"_2365":97818},[],"Clave generada por el dispositivo",{"_2837":58082,"_24687":58048,"_17267":97820,"_5":17162,"_23357":97733,"_2365":97821},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2837":58083,"_24687":58048,"_17267":97823,"_5":17162,"_23357":97733,"_2365":97824},[],"Clave ya disponible en el dispositivo",{"_2837":58084,"_24687":58048,"_17267":97826,"_5":17162,"_23357":97733,"_2365":97827},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2837":58085,"_24687":58048,"_17267":97829,"_5":17162,"_23357":97733,"_2365":42830},[],{"_2837":58086,"_24687":58048,"_17267":97831,"_5":17162,"_23357":97733,"_2365":97832},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2837":58087,"_24687":58048,"_17267":97834,"_5":17162,"_23357":97733,"_2365":97835},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2837":58088,"_24687":58048,"_17267":97837,"_5":17162,"_23357":97737,"_2365":97838},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2837":58089,"_24687":58089,"_5":12136,"_2365":97840,"_25023":97841,"_17267":97842,"_23357":58089},"Renovación y recuperación",[40249,95914,42511,96830,97005],[],{"_2837":58090,"_24687":58089,"_17267":97844,"_5":17162,"_23357":58089,"_2365":97845},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2837":58091,"_24687":58089,"_5":25020,"_17267":97847,"_23357":97848,"_2365":97849},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2837":58092,"_24687":58089,"_5":25020,"_17267":97851,"_23357":97852,"_2365":97853},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2837":58093,"_24687":58089,"_5":25020,"_17267":97855,"_23357":97856,"_2365":97857},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2837":58094,"_24687":58089,"_5":25020,"_17267":97859,"_23357":97860,"_2365":97861},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2837":58095,"_24687":58089,"_5":25020,"_17267":97863,"_23357":97864,"_2365":97865},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2837":58096,"_24687":58089,"_17267":97867,"_5":17162,"_23357":58089,"_2365":97868},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2837":58097,"_24687":58089,"_17267":97870,"_5":17162,"_23357":97848,"_2365":97871},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2837":58098,"_24687":58089,"_17267":97873,"_5":17162,"_23357":97848,"_2365":97874},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2837":58099,"_24687":58089,"_17267":97876,"_5":17162,"_23357":97848,"_2365":97877},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2837":58100,"_24687":58089,"_17267":97879,"_5":17162,"_23357":97848,"_2365":97880},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2837":58101,"_24687":58089,"_17267":97882,"_5":17162,"_23357":97852,"_2365":97883},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2837":58102,"_24687":58089,"_17267":97885,"_5":17162,"_23357":97852,"_2365":97886},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2837":58103,"_24687":58089,"_17267":97888,"_5":17162,"_23357":97856,"_2365":97889},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2837":58104,"_24687":58089,"_17267":97891,"_5":17162,"_23357":97856,"_2365":97892},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2837":58105,"_24687":58089,"_17267":97894,"_5":17162,"_23357":97856,"_2365":97895},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2837":58106,"_24687":58089,"_17267":97897,"_5":17162,"_23357":97860,"_2365":97898},[],"Situación",{"_2837":58107,"_24687":58089,"_17267":97900,"_5":17162,"_23357":97860,"_2365":97901},[],"Procedimiento",{"_2837":58108,"_24687":58089,"_17267":97903,"_5":17162,"_23357":97860,"_2365":97904},[],"Certificado vigente, fuera de ventana",{"_2837":58109,"_24687":58089,"_17267":97906,"_5":17162,"_23357":97860,"_2365":97907},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2837":58110,"_24687":58089,"_17267":97909,"_5":17162,"_23357":97860,"_2365":97910},[],"Certificado vencido, clave disponible",{"_2837":58111,"_24687":58089,"_17267":97912,"_5":17162,"_23357":97860,"_2365":97913},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2837":58112,"_24687":58089,"_17267":97915,"_5":17162,"_23357":97860,"_2365":97916},[],"Renovación por webhook o `NO_AUTH`",{"_2837":58113,"_24687":58089,"_17267":97918,"_5":17162,"_23357":97860,"_2365":97919},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2837":58114,"_24687":58089,"_17267":97921,"_5":17162,"_23357":97860,"_2365":97922},[],"Clave perdida o inaccesible",{"_2837":58115,"_24687":58089,"_17267":97924,"_5":17162,"_23357":97860,"_2365":97925},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2837":58116,"_24687":58089,"_17267":97927,"_5":17162,"_23357":97860,"_2365":97928},[],"Identidad actual revocada",{"_2837":58117,"_24687":58089,"_17267":97930,"_5":17162,"_23357":97860,"_2365":97931},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2837":58118,"_24687":58089,"_17267":97933,"_5":17162,"_23357":97860,"_2365":97934},[],"Dispositivo sin identidad",{"_2837":58119,"_24687":58089,"_17267":97936,"_5":17162,"_23357":97860,"_2365":97937},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2837":58120,"_24687":58089,"_17267":97939,"_5":17162,"_23357":97860,"_2365":97940},[],"Dispositivo retirado",{"_2837":58121,"_24687":58089,"_17267":97942,"_5":17162,"_23357":97860,"_2365":97943},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2837":58122,"_24687":58089,"_17267":97945,"_5":17162,"_23357":97860,"_2365":97946},[],"Timeout, HTTP 500 o fallo de instalación",{"_2837":58123,"_24687":58089,"_17267":97948,"_5":17162,"_23357":97860,"_2365":97949},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2837":58124,"_24687":58089,"_17267":97951,"_5":17162,"_23357":97864,"_2365":97952},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2837":58125,"_24687":58089,"_17267":97954,"_5":17162,"_23357":97864,"_2365":97955},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2837":58126,"_24687":58126,"_5":12136,"_2365":97957,"_25023":97958,"_17267":97959,"_23357":58126},"Diagnóstico de enrolamiento",[40249,95914,42511,96830,97005],[],{"_2837":58127,"_24687":58126,"_17267":97961,"_5":17162,"_23357":58126,"_2365":97962},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2837":58128,"_24687":58126,"_5":25020,"_17267":97964,"_23357":97965,"_2365":97966},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2837":58129,"_24687":58126,"_5":25020,"_17267":97968,"_23357":97969,"_2365":97970},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2837":58130,"_24687":58126,"_5":25020,"_17267":97972,"_23357":97973,"_2365":97529},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2837":58131,"_24687":58126,"_5":25020,"_17267":97975,"_23357":97976,"_2365":97977},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2837":58132,"_24687":58126,"_17267":97979,"_5":17162,"_23357":58126,"_2365":97980},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2837":58133,"_24687":58126,"_17267":97982,"_5":17162,"_23357":97969,"_2365":97983},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2837":58134,"_24687":58126,"_17267":97985,"_5":17162,"_23357":97969,"_2365":97986},[],"Síntoma o mensaje",{"_2837":58135,"_24687":58126,"_17267":97988,"_5":17162,"_23357":97969,"_2365":97989},[],"Qué revisar",{"_2837":58136,"_24687":58126,"_17267":97991,"_5":17162,"_23357":97969,"_2365":97992},[],"curl rechaza TLS, nombre o emisor",{"_2837":58137,"_24687":58126,"_17267":97994,"_5":17162,"_23357":97969,"_2365":97995},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2837":58138,"_24687":58126,"_17267":97997,"_5":17162,"_23357":97969,"_2365":97998},[],"404 o APS ausente",{"_2837":58139,"_24687":58126,"_17267":98000,"_5":17162,"_23357":97969,"_2365":98001},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2837":58140,"_24687":58126,"_17267":98003,"_5":17162,"_23357":97969,"_2365":98004},[],"400, error de CSR o formato",{"_2837":58141,"_24687":58126,"_17267":98006,"_5":17162,"_23357":97969,"_2365":98007},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2837":58142,"_24687":58126,"_17267":98009,"_5":17162,"_23357":97969,"_2365":98010},[],"Credencial ausente o certificado no válido",{"_2837":58143,"_24687":58126,"_17267":98012,"_5":17162,"_23357":97969,"_2365":98013},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2837":58144,"_24687":58126,"_17267":98015,"_5":17162,"_23357":97969,"_2365":98016},[],"Webhook deniega, expira o responde sin autorización",{"_2837":58145,"_24687":58126,"_17267":98018,"_5":17162,"_23357":97969,"_2365":98019},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2837":58146,"_24687":58126,"_17267":98021,"_5":17162,"_23357":97969,"_2365":43747},[],{"_2837":58147,"_24687":58126,"_17267":98023,"_5":17162,"_23357":97969,"_2365":98024},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2837":58148,"_24687":58126,"_17267":98026,"_5":17162,"_23357":97969,"_2365":43753},[],{"_2837":58149,"_24687":58126,"_17267":98028,"_5":17162,"_23357":97969,"_2365":98029},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2837":58150,"_24687":58126,"_17267":98031,"_5":17162,"_23357":97969,"_2365":43759},[],{"_2837":58151,"_24687":58126,"_17267":98033,"_5":17162,"_23357":97969,"_2365":98034},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Introduce el PEM como `cert_content` y `key_content`; consulta la nota de migración en DMS.",{"_2837":58152,"_24687":58126,"_17267":98036,"_5":17162,"_23357":97969,"_2365":98037},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2837":58153,"_24687":58126,"_17267":98039,"_5":17162,"_23357":97969,"_2365":98040},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2837":58154,"_24687":58126,"_17267":98042,"_5":17162,"_23357":97969,"_2365":98043},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2837":58155,"_24687":58126,"_17267":98045,"_5":17162,"_23357":97969,"_2365":98046},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2837":58156,"_24687":58126,"_17267":98048,"_5":17162,"_23357":97969,"_2365":43777},[],{"_2837":58157,"_24687":58126,"_17267":98050,"_5":17162,"_23357":97969,"_2365":98051},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2837":58158,"_24687":58126,"_17267":98053,"_5":17162,"_23357":97969,"_2365":43783},[],{"_2837":58159,"_24687":58126,"_17267":98055,"_5":17162,"_23357":97969,"_2365":98056},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2837":58160,"_24687":58126,"_17267":98058,"_5":17162,"_23357":97969,"_2365":98059},[],"DMS propietario distinto",{"_2837":58161,"_24687":58126,"_17267":98061,"_5":17162,"_23357":97969,"_2365":98062},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2837":58162,"_24687":58126,"_17267":98064,"_5":17162,"_23357":97969,"_2365":43795},[],{"_2837":58163,"_24687":58126,"_17267":98066,"_5":17162,"_23357":97969,"_2365":98067},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2837":58164,"_24687":58126,"_17267":98069,"_5":17162,"_23357":97969,"_2365":43801},[],{"_2837":58165,"_24687":58126,"_17267":98071,"_5":17162,"_23357":97969,"_2365":98072},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2837":58166,"_24687":58126,"_17267":98074,"_5":17162,"_23357":97969,"_2365":98075},[],"Certificado actual revocado",{"_2837":58167,"_24687":58126,"_17267":98077,"_5":17162,"_23357":97969,"_2365":98078},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2837":58168,"_24687":58126,"_17267":98080,"_5":17162,"_23357":97969,"_2365":98081},[],"Error de CA, perfil o firma",{"_2837":58169,"_24687":58126,"_17267":98083,"_5":17162,"_23357":97969,"_2365":98084},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2837":58170,"_24687":58126,"_17267":98086,"_5":17162,"_23357":97969,"_2365":98087},[],"HTTP 200 sin conexión del dispositivo",{"_2837":58171,"_24687":58126,"_17267":98089,"_5":17162,"_23357":97969,"_2365":98090},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2837":58172,"_24687":58126,"_17267":98092,"_5":17162,"_23357":97969,"_2365":98093},[],"Timeout o error después de emitir",{"_2837":58173,"_24687":58126,"_17267":98095,"_5":17162,"_23357":97969,"_2365":98096},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2837":58174,"_24687":58126,"_17267":98098,"_5":17162,"_23357":97973,"_2365":98099},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2837":58175,"_24687":58126,"_17267":98101,"_5":17162,"_23357":97973,"_2365":98102},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2837":58176,"_24687":58126,"_17267":98104,"_5":17162,"_23357":97976,"_2365":98105},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2837":58177,"_24687":58126,"_17267":98107,"_5":17162,"_23357":97976,"_2365":98108},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2837":58178,"_24687":58126,"_17267":98110,"_5":17162,"_23357":97976,"_2365":98111},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2837":58179,"_24687":58126,"_17267":98113,"_5":17162,"_23357":97976,"_2365":98114},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2837":58180,"_24687":58126,"_17267":98116,"_5":17162,"_23357":97976,"_2365":98117},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2837":58181,"_24687":58126,"_17267":98119,"_5":17162,"_23357":97976,"_2365":98120},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2837":58182,"_24687":58126,"_17267":98122,"_5":17162,"_23357":97976,"_2365":98123},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2837":58183,"_24687":58183,"_5":12136,"_2365":98125,"_25023":98126,"_17267":98127,"_23357":58183},"Distribución y actualización de confianza",[40249,95914,42511,96830,97005],[],{"_2837":58184,"_24687":58183,"_17267":98129,"_5":17162,"_23357":58183,"_2365":98130},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2837":58185,"_24687":58183,"_5":25020,"_17267":98132,"_23357":98133,"_2365":98134},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2837":58186,"_24687":58183,"_5":25020,"_17267":98136,"_23357":98137,"_2365":98138},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2837":58187,"_24687":58183,"_5":25020,"_17267":98140,"_23357":98141,"_2365":98142},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2837":58188,"_24687":58183,"_5":25020,"_17267":98144,"_23357":98145,"_2365":98146},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2837":58189,"_24687":58183,"_5":25020,"_17267":98148,"_23357":98149,"_2365":98150},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2837":58190,"_24687":58183,"_17267":98152,"_5":17162,"_23357":58183,"_2365":98153},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2837":58191,"_24687":58183,"_17267":98155,"_5":17162,"_23357":98133,"_2365":98156},[],"Relación",{"_2837":58192,"_24687":58183,"_17267":98158,"_5":17162,"_23357":98133,"_2365":98159},[],"Material que prepara el responsable",{"_2837":58193,"_24687":58183,"_17267":98161,"_5":17162,"_23357":98133,"_2365":98162},[],"Dispositivo → servidor EST",{"_2837":58194,"_24687":58183,"_17267":98164,"_5":17162,"_23357":98133,"_2365":98165},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2837":58195,"_24687":58183,"_17267":98167,"_5":17162,"_23357":98133,"_2365":98168},[],"DMS → solicitante",{"_2837":58196,"_24687":58183,"_17267":98170,"_5":17162,"_23357":98133,"_2365":98171},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2837":58197,"_24687":58183,"_17267":98173,"_5":17162,"_23357":98133,"_2365":98174},[],"Consumidor → dispositivo",{"_2837":58198,"_24687":58183,"_17267":98176,"_5":17162,"_23357":98133,"_2365":98177},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2837":58199,"_24687":58183,"_17267":98179,"_5":17162,"_23357":98133,"_2365":98180},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2837":58200,"_24687":58183,"_17267":98182,"_5":17162,"_23357":98137,"_2365":98183},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2837":58201,"_24687":58183,"_17267":98185,"_5":17162,"_23357":98137,"_2365":98186},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2837":58202,"_24687":58183,"_17267":98188,"_5":17162,"_23357":98141,"_2365":98189},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2837":58203,"_24687":58183,"_17267":98191,"_5":17162,"_23357":98141,"_2365":98192},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2837":58204,"_24687":58183,"_17267":98194,"_5":17162,"_23357":98141,"_2365":98195},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2837":58205,"_24687":58183,"_17267":98197,"_5":17162,"_23357":98141,"_2365":98198},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2837":58206,"_24687":58183,"_17267":98200,"_5":17162,"_23357":98141,"_2365":98201},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2837":58207,"_24687":58183,"_17267":98203,"_5":17162,"_23357":98141,"_2365":98204},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2837":58208,"_24687":58183,"_17267":98206,"_5":17162,"_23357":98145,"_2365":98207},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2837":58209,"_24687":58183,"_17267":98209,"_5":17162,"_23357":98145,"_2365":98210},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2837":58210,"_24687":58183,"_17267":98212,"_5":17162,"_23357":98145,"_2365":98213},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2837":58211,"_24687":58183,"_17267":98215,"_5":17162,"_23357":98149,"_2365":98216},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2837":58212,"_24687":58212,"_5":12136,"_2365":43950,"_25023":98218,"_17267":98220,"_23357":58212},[40249,95914,42511,96830,98219],"Integraciones",[],{"_2837":58213,"_24687":58212,"_17267":98222,"_5":17162,"_23357":58212,"_2365":98223},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2837":58214,"_24687":58212,"_5":25020,"_17267":98225,"_23357":98226,"_2365":98227},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2837":58215,"_24687":58212,"_5":25020,"_17267":98229,"_23357":98230,"_2365":98231},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2837":58216,"_24687":58212,"_5":25020,"_17267":98233,"_23357":98234,"_2365":98235},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2837":58217,"_24687":58212,"_5":25020,"_17267":98237,"_23357":98238,"_2365":98239},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2837":58218,"_24687":58212,"_5":25020,"_17267":98241,"_23357":98242,"_2365":98243},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2837":58219,"_24687":58212,"_5":25020,"_17267":98245,"_23357":98246,"_2365":98247},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2837":58220,"_24687":58212,"_5":25020,"_17267":98249,"_23357":98250,"_2365":43984},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2837":58221,"_24687":58212,"_5":25020,"_17267":98252,"_23357":98253,"_2365":43988},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2837":58222,"_24687":58212,"_5":25020,"_17267":98255,"_23357":98256,"_2365":98257},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2837":58223,"_24687":58212,"_5":25020,"_17267":98259,"_23357":98260,"_2365":98261},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2837":58224,"_24687":58212,"_5":25020,"_17267":98263,"_23357":98264,"_2365":98265},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2837":58225,"_24687":58212,"_5":25020,"_17267":98267,"_23357":98268,"_2365":98269},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2837":58226,"_24687":58212,"_5":25020,"_17267":98271,"_23357":98272,"_2365":98273},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2837":58227,"_24687":58212,"_5":25020,"_17267":98275,"_23357":98276,"_2365":98277},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2837":58228,"_24687":58212,"_5":25020,"_17267":98279,"_23357":98280,"_2365":98281},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2837":58229,"_24687":58212,"_5":25020,"_17267":98283,"_23357":98284,"_2365":98285},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2837":58230,"_24687":58212,"_5":25020,"_17267":98287,"_23357":98288,"_2365":98289},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2837":58231,"_24687":58212,"_5":25020,"_17267":98291,"_23357":98292,"_2365":98293},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2837":58232,"_24687":58212,"_5":25020,"_17267":98295,"_23357":98296,"_2365":98297},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2837":58233,"_24687":58212,"_5":25020,"_17267":98299,"_23357":98300,"_2365":98301},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2837":58234,"_24687":58212,"_17267":98303,"_5":17162,"_23357":58212,"_2365":98304},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2837":58235,"_24687":58212,"_17267":98306,"_5":17162,"_23357":58212,"_2365":98307},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2837":58236,"_24687":58212,"_17267":98309,"_5":17162,"_23357":58212,"_2365":98310},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2837":58237,"_24687":58212,"_17267":98312,"_5":17162,"_23357":98226,"_2365":98313},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2837":58238,"_24687":58212,"_17267":98315,"_5":17162,"_23357":98226,"_2365":98316},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2837":58239,"_24687":58212,"_17267":98318,"_5":17162,"_23357":98226,"_2365":98319},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2837":58240,"_24687":58212,"_17267":98321,"_5":17162,"_23357":98226,"_2365":98322},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2837":58241,"_24687":58212,"_17267":98324,"_5":17162,"_23357":98230,"_2365":98325},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2837":58242,"_24687":58212,"_17267":98327,"_5":17162,"_23357":98234,"_2365":98328},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2837":58243,"_24687":58212,"_17267":98330,"_5":17162,"_23357":98234,"_2365":98331},[],"Acción IAM",{"_2837":58244,"_24687":58212,"_17267":98333,"_5":17162,"_23357":98234,"_2365":94978},[],{"_2837":58245,"_24687":58212,"_17267":98335,"_5":17162,"_23357":98234,"_2365":44071},[],{"_2837":58246,"_24687":58212,"_17267":98337,"_5":17162,"_23357":98234,"_2365":98338},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2837":58247,"_24687":58212,"_17267":98340,"_5":17162,"_23357":98234,"_2365":44077},[],{"_2837":58248,"_24687":58212,"_17267":98342,"_5":17162,"_23357":98234,"_2365":98343},[],"Registrar la CA en AWS IoT",{"_2837":58249,"_24687":58212,"_17267":98345,"_5":17162,"_23357":98234,"_2365":44083},[],{"_2837":58250,"_24687":58212,"_17267":98347,"_5":17162,"_23357":98234,"_2365":98348},[],"Consultar el estado del registro de la CA",{"_2837":58251,"_24687":58212,"_17267":98350,"_5":17162,"_23357":98234,"_2365":44089},[],{"_2837":58252,"_24687":58212,"_17267":98352,"_5":17162,"_23357":98234,"_2365":98353},[],"Crear o actualizar Things en IoT Core",{"_2837":58253,"_24687":58212,"_17267":98355,"_5":17162,"_23357":98234,"_2365":44095},[],{"_2837":58254,"_24687":58212,"_17267":98357,"_5":17162,"_23357":98234,"_2365":98358},[],"Aprovisionar Things mediante plantilla",{"_2837":58255,"_24687":58212,"_17267":98360,"_5":17162,"_23357":98234,"_2365":44101},[],{"_2837":58256,"_24687":58212,"_17267":98362,"_5":17162,"_23357":98234,"_2365":98363},[],"Registrar certificados de dispositivo",{"_2837":58257,"_24687":58212,"_17267":98365,"_5":17162,"_23357":98234,"_2365":44107},[],{"_2837":58258,"_24687":58212,"_17267":98367,"_5":17162,"_23357":98234,"_2365":98368},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2837":58259,"_24687":58212,"_17267":98370,"_5":17162,"_23357":98234,"_2365":44113},[],{"_2837":58260,"_24687":58212,"_17267":98372,"_5":17162,"_23357":98234,"_2365":98373},[],"Crear y adjuntar políticas IoT",{"_2837":58261,"_24687":58212,"_17267":98375,"_5":17162,"_23357":98234,"_2365":44119},[],{"_2837":58262,"_24687":58212,"_17267":98377,"_5":17162,"_23357":98234,"_2365":98378},[],"Gestionar grupos de Things",{"_2837":58263,"_24687":58212,"_17267":98380,"_5":17162,"_23357":98234,"_2365":44125},[],{"_2837":58264,"_24687":58212,"_17267":98382,"_5":17162,"_23357":98234,"_2365":98383},[],"Crear plantillas JITP",{"_2837":58265,"_24687":58212,"_17267":98385,"_5":17162,"_23357":98234,"_2365":44131},[],{"_2837":58266,"_24687":58212,"_17267":98387,"_5":17162,"_23357":98234,"_2365":98388},[],"Leer y escribir el Device Shadow",{"_2837":58267,"_24687":58212,"_17267":98390,"_5":17162,"_23357":98234,"_2365":98391},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2837":58268,"_24687":58212,"_17267":98393,"_5":17162,"_23357":98238,"_2365":98394},[],"Parámetro",{"_2837":58269,"_24687":58212,"_17267":98396,"_5":17162,"_23357":98238,"_2365":98397},[],"Tipo",{"_2837":58270,"_24687":58212,"_17267":98399,"_5":17162,"_23357":98238,"_2365":98400},[],"Requerido",{"_2837":58271,"_24687":58212,"_17267":98402,"_5":17162,"_23357":98238,"_2365":98403},[],"Descripción",{"_2837":58272,"_24687":58212,"_17267":98405,"_5":17162,"_23357":98238,"_2365":44152},[],{"_2837":58273,"_24687":58212,"_17267":98407,"_5":17162,"_23357":98238,"_2365":20592},[],{"_2837":58274,"_24687":58212,"_17267":98409,"_5":17162,"_23357":98238,"_2365":98410},[],"Sí",{"_2837":58275,"_24687":58212,"_17267":98412,"_5":17162,"_23357":98238,"_2365":98413},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2837":58276,"_24687":58212,"_17267":98415,"_5":17162,"_23357":98238,"_2365":44163},[],{"_2837":58277,"_24687":58212,"_17267":98417,"_5":17162,"_23357":98238,"_2365":20592},[],{"_2837":58278,"_24687":58212,"_17267":98419,"_5":17162,"_23357":98238,"_2365":98410},[],{"_2837":58279,"_24687":58212,"_17267":98421,"_5":17162,"_23357":98238,"_2365":98422},[],"Región AWS donde opera el conector.",{"_2837":58280,"_24687":58212,"_17267":98424,"_5":17162,"_23357":98238,"_2365":44173},[],{"_2837":58281,"_24687":58212,"_17267":98426,"_5":17162,"_23357":98238,"_2365":20592},[],{"_2837":58282,"_24687":58212,"_17267":98428,"_5":17162,"_23357":98238,"_2365":98410},[],{"_2837":58283,"_24687":58212,"_17267":98430,"_5":17162,"_23357":98238,"_2365":98431},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2837":58284,"_24687":58212,"_17267":98433,"_5":17162,"_23357":98238,"_2365":44183},[],{"_2837":58285,"_24687":58212,"_17267":98435,"_5":17162,"_23357":98238,"_2365":20592},[],{"_2837":58286,"_24687":58212,"_17267":98437,"_5":17162,"_23357":98238,"_2365":98438},[],"Solo con `auth_method=static`",{"_2837":58287,"_24687":58212,"_17267":98440,"_5":17162,"_23357":98238,"_2365":98441},[],"Clave de acceso AWS.",{"_2837":58288,"_24687":58212,"_17267":98443,"_5":17162,"_23357":98238,"_2365":44194},[],{"_2837":58289,"_24687":58212,"_17267":98445,"_5":17162,"_23357":98238,"_2365":20592},[],{"_2837":58290,"_24687":58212,"_17267":98447,"_5":17162,"_23357":98238,"_2365":98438},[],{"_2837":58291,"_24687":58212,"_17267":98449,"_5":17162,"_23357":98238,"_2365":98450},[],"Clave secreta AWS.",{"_2837":58292,"_24687":58212,"_17267":98452,"_5":17162,"_23357":98238,"_2365":44204},[],{"_2837":58293,"_24687":58212,"_17267":98454,"_5":17162,"_23357":98238,"_2365":20592},[],{"_2837":58294,"_24687":58212,"_17267":98456,"_5":17162,"_23357":98238,"_2365":44209},[],{"_2837":58295,"_24687":58212,"_17267":98458,"_5":17162,"_23357":98238,"_2365":98459},[],"Token de sesión (con `auth_method=static`).",{"_2837":58296,"_24687":58212,"_17267":98461,"_5":17162,"_23357":98238,"_2365":44215},[],{"_2837":58297,"_24687":58212,"_17267":98463,"_5":17162,"_23357":98238,"_2365":20592},[],{"_2837":58298,"_24687":58212,"_17267":98465,"_5":17162,"_23357":98238,"_2365":98466},[],"Solo con `auth_method=role`",{"_2837":58299,"_24687":58212,"_17267":98468,"_5":17162,"_23357":98238,"_2365":98469},[],"ARN del rol a asumir.",{"_2837":58300,"_24687":58212,"_17267":98471,"_5":17162,"_23357":98238,"_2365":44226},[],{"_2837":58301,"_24687":58212,"_17267":98473,"_5":17162,"_23357":98238,"_2365":20592},[],{"_2837":58302,"_24687":58212,"_17267":98475,"_5":17162,"_23357":98238,"_2365":44209},[],{"_2837":58303,"_24687":58212,"_17267":98477,"_5":17162,"_23357":98238,"_2365":98478},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2837":58304,"_24687":58212,"_17267":98480,"_5":17162,"_23357":98238,"_2365":44236},[],{"_2837":58305,"_24687":58212,"_17267":98482,"_5":17162,"_23357":98238,"_2365":14502},[],{"_2837":58306,"_24687":58212,"_17267":98484,"_5":17162,"_23357":98238,"_2365":98410},[],{"_2837":58307,"_24687":58212,"_17267":98486,"_5":17162,"_23357":98238,"_2365":98487},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2837":58308,"_24687":58212,"_17267":98489,"_5":17162,"_23357":98238,"_2365":44246},[],{"_2837":58309,"_24687":58212,"_17267":98491,"_5":17162,"_23357":98238,"_2365":20592},[],{"_2837":58310,"_24687":58212,"_17267":98493,"_5":17162,"_23357":98238,"_2365":98410},[],{"_2837":58311,"_24687":58212,"_17267":98495,"_5":17162,"_23357":98238,"_2365":98496},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2837":58312,"_24687":58212,"_17267":98498,"_5":17162,"_23357":98238,"_2365":44256},[],{"_2837":58313,"_24687":58212,"_17267":98500,"_5":17162,"_23357":98238,"_2365":20592},[],{"_2837":58314,"_24687":58212,"_17267":98502,"_5":17162,"_23357":98238,"_2365":98410},[],{"_2837":58315,"_24687":58212,"_17267":98504,"_5":17162,"_23357":98238,"_2365":98505},[],"URL HTTP del Device Manager de Lamassu.",{"_2837":58316,"_24687":58212,"_17267":98507,"_5":17162,"_23357":98238,"_2365":44266},[],{"_2837":58317,"_24687":58212,"_17267":98509,"_5":17162,"_23357":98238,"_2365":20592},[],{"_2837":58318,"_24687":58212,"_17267":98511,"_5":17162,"_23357":98238,"_2365":98410},[],{"_2837":58319,"_24687":58212,"_17267":98513,"_5":17162,"_23357":98238,"_2365":98514},[],"URL HTTP del servicio de CA de Lamassu.",{"_2837":58320,"_24687":58212,"_17267":98516,"_5":17162,"_23357":98242,"_2365":98517},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2837":58321,"_24687":58212,"_17267":98519,"_5":17162,"_23357":98246,"_2365":98520},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2837":58322,"_24687":58212,"_17267":98522,"_5":17162,"_23357":98246,"_2365":98523},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2837":58323,"_24687":58212,"_17267":98525,"_5":17162,"_23357":98250,"_2365":98526},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2837":58324,"_24687":58212,"_17267":98528,"_5":17162,"_23357":98250,"_2365":98529},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2837":58325,"_24687":58212,"_17267":98531,"_5":17162,"_23357":98250,"_2365":98532},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2837":58326,"_24687":58212,"_17267":98534,"_5":17162,"_23357":98250,"_2365":98535},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2837":58327,"_24687":58212,"_17267":98537,"_5":17162,"_23357":98250,"_2365":98538},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2837":58328,"_24687":58212,"_17267":98540,"_5":17162,"_23357":98250,"_2365":98541},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2837":58329,"_24687":58212,"_17267":98543,"_5":17162,"_23357":98253,"_2365":98544},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2837":58330,"_24687":58212,"_17267":98546,"_5":17162,"_23357":98256,"_2365":98547},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2837":58331,"_24687":58212,"_17267":98549,"_5":17162,"_23357":98256,"_2365":98550},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2837":58332,"_24687":58212,"_17267":98552,"_5":17162,"_23357":98260,"_2365":98553},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2837":58333,"_24687":58212,"_17267":98555,"_5":17162,"_23357":98264,"_2365":98556},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2837":58334,"_24687":58212,"_17267":98558,"_5":17162,"_23357":98264,"_2365":98559},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2837":58335,"_24687":58212,"_17267":98561,"_5":17162,"_23357":98264,"_2365":98562},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2837":58336,"_24687":58212,"_17267":98564,"_5":17162,"_23357":98264,"_2365":98565},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2837":58337,"_24687":58212,"_17267":98567,"_5":17162,"_23357":98264,"_2365":98568},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2837":58338,"_24687":58212,"_17267":98570,"_5":17162,"_23357":98264,"_2365":98571},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2837":58339,"_24687":58212,"_17267":98573,"_5":17162,"_23357":98268,"_2365":98574},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2837":58340,"_24687":58212,"_17267":98576,"_5":17162,"_23357":98268,"_2365":98577},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2837":58341,"_24687":58212,"_17267":98579,"_5":17162,"_23357":98268,"_2365":98580},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2837":58342,"_24687":58212,"_17267":98582,"_5":17162,"_23357":98272,"_2365":98583},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2837":58343,"_24687":58212,"_17267":98585,"_5":17162,"_23357":98272,"_2365":98586},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2837":58344,"_24687":58212,"_17267":98588,"_5":17162,"_23357":98272,"_2365":98589},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2837":58345,"_24687":58212,"_17267":98591,"_5":17162,"_23357":98276,"_2365":98592},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2837":58346,"_24687":58212,"_17267":98594,"_5":17162,"_23357":98276,"_2365":98595},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2837":58347,"_24687":58212,"_17267":98597,"_5":17162,"_23357":98276,"_2365":98598},[],"Para que el flujo JITP funcione correctamente:",{"_2837":58348,"_24687":58212,"_17267":98600,"_5":17162,"_23357":98276,"_2365":98601},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2837":58349,"_24687":58212,"_17267":98603,"_5":17162,"_23357":98276,"_2365":98604},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2837":58350,"_24687":58212,"_17267":98606,"_5":17162,"_23357":98276,"_2365":98607},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2837":58351,"_24687":58212,"_17267":98609,"_5":17162,"_23357":98276,"_2365":98610},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2837":58352,"_24687":58212,"_17267":98612,"_5":17162,"_23357":98280,"_2365":98613},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2837":58353,"_24687":58212,"_17267":98615,"_5":17162,"_23357":98280,"_2365":98616},[],"Estado en Lamassu",{"_2837":58354,"_24687":58212,"_17267":98618,"_5":17162,"_23357":98280,"_2365":98619},[],"Razón de revocación",{"_2837":58355,"_24687":58212,"_17267":98621,"_5":17162,"_23357":98280,"_2365":98622},[],"Estado en AWS IoT Core",{"_2837":58356,"_24687":58212,"_17267":98624,"_5":17162,"_23357":98280,"_2365":44387},[],{"_2837":58357,"_24687":58212,"_17267":98626,"_5":17162,"_23357":98280,"_2365":98627},[],"Ninguna",{"_2837":58358,"_24687":58212,"_17267":98629,"_5":17162,"_23357":98280,"_2365":44393},[],{"_2837":58359,"_24687":58212,"_17267":98631,"_5":17162,"_23357":98280,"_2365":44396},[],{"_2837":58360,"_24687":58212,"_17267":98633,"_5":17162,"_23357":98280,"_2365":44399},[],{"_2837":58361,"_24687":58212,"_17267":98635,"_5":17162,"_23357":98280,"_2365":44402},[],{"_2837":58362,"_24687":58212,"_17267":98637,"_5":17162,"_23357":98280,"_2365":44396},[],{"_2837":58363,"_24687":58212,"_17267":98639,"_5":17162,"_23357":98280,"_2365":98640},[],"Cualquier otra razón",{"_2837":58364,"_24687":58212,"_17267":98642,"_5":17162,"_23357":98280,"_2365":44410},[],{"_2837":58365,"_24687":58212,"_17267":98644,"_5":17162,"_23357":98280,"_2365":98645},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2837":58366,"_24687":58212,"_17267":98647,"_5":17162,"_23357":98284,"_2365":98648},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2837":58367,"_24687":58212,"_17267":98650,"_5":17162,"_23357":98284,"_2365":98651},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2837":58368,"_24687":58212,"_17267":98653,"_5":17162,"_23357":98284,"_2365":98654},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2837":58369,"_24687":58212,"_17267":98656,"_5":17162,"_23357":98288,"_2365":98657},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2837":58370,"_24687":58212,"_17267":98659,"_5":17162,"_23357":98288,"_2365":98660},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2837":58371,"_24687":58212,"_17267":98662,"_5":17162,"_23357":98292,"_2365":98663},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2837":58372,"_24687":58212,"_17267":98665,"_5":17162,"_23357":98292,"_2365":98666},[],"Existen dos tipos de acciones:",{"_2837":58373,"_24687":58212,"_17267":98668,"_5":17162,"_23357":98292,"_2365":98669},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2837":58374,"_24687":58212,"_17267":98671,"_5":17162,"_23357":98292,"_2365":98672},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2837":58375,"_24687":58212,"_17267":98674,"_5":17162,"_23357":98292,"_2365":98675},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2837":58376,"_24687":58212,"_17267":98677,"_5":17162,"_23357":98296,"_2365":98678},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2837":58377,"_24687":58212,"_17267":98680,"_5":17162,"_23357":98296,"_2365":98681},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2837":58378,"_24687":58212,"_17267":98683,"_5":17162,"_23357":98296,"_2365":98684},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2837":58379,"_24687":58212,"_17267":98686,"_5":17162,"_23357":98300,"_2365":98687},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2837":58380,"_24687":58212,"_17267":98689,"_5":17162,"_23357":98300,"_2365":98690},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2837":58381,"_24687":58212,"_17267":98692,"_5":17162,"_23357":98300,"_2365":98693},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2837":58382,"_24687":58212,"_17267":98695,"_5":17162,"_23357":98300,"_2365":98696},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2837":58383,"_24687":58212,"_17267":98698,"_5":17162,"_23357":98300,"_2365":98699},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2837":58384,"_24687":58212,"_17267":98701,"_5":17162,"_23357":98300,"_2365":98702},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2837":58385,"_24687":58212,"_17267":98704,"_5":17162,"_23357":98300,"_2365":98705},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2837":58386,"_24687":58212,"_17267":98707,"_5":17162,"_23357":98300,"_2365":98708},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2837":58387,"_24687":58212,"_17267":98710,"_5":17162,"_23357":98300,"_2365":98711},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2837":58388,"_24687":58212,"_17267":98713,"_5":17162,"_23357":98300,"_2365":98714},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2837":58389,"_24687":58212,"_17267":98716,"_5":17162,"_23357":98300,"_2365":98717},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2837":58390,"_24687":58212,"_17267":98719,"_5":17162,"_23357":98300,"_2365":98720},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2837":58391,"_24687":58212,"_17267":98722,"_5":17162,"_23357":98300,"_2365":98723},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2837":58392,"_24687":58212,"_17267":98725,"_5":17162,"_23357":98300,"_2365":98726},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2837":58393,"_24687":58212,"_17267":98728,"_5":17162,"_23357":98300,"_2365":98729},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2837":58394,"_24687":58212,"_17267":98731,"_5":17162,"_23357":98300,"_2365":98732},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2837":58395,"_24687":58212,"_17267":98734,"_5":17162,"_23357":98300,"_2365":98735},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2837":58396,"_24687":58212,"_17267":98737,"_5":17162,"_23357":98300,"_2365":98738},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2837":58397,"_24687":58212,"_17267":98740,"_5":17162,"_23357":98300,"_2365":98741},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2837":58398,"_24687":58212,"_17267":98743,"_5":17162,"_23357":98300,"_2365":98744},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2837":58399,"_24687":58212,"_17267":98746,"_5":17162,"_23357":98300,"_2365":98747},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2837":58400,"_24687":58400,"_5":12136,"_2365":42511,"_25023":98749,"_17267":98750,"_23357":58400},[40249,95914,42511],[],{"_2837":58401,"_24687":58400,"_17267":98752,"_5":17162,"_23357":58400,"_2365":98753},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2837":58402,"_24687":58400,"_5":25020,"_17267":98755,"_23357":98756,"_2365":98757},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2837":58403,"_24687":58400,"_5":25020,"_17267":98759,"_23357":98760,"_2365":96830},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2837":58404,"_24687":58400,"_5":25020,"_17267":98762,"_23357":98763,"_2365":97005},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2837":58405,"_24687":58400,"_5":25020,"_17267":98765,"_23357":98766,"_2365":98219},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/overview#integraciones",{"_2837":58406,"_24687":58400,"_5":25020,"_17267":98768,"_23357":98769,"_2365":98770},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2837":58407,"_24687":58400,"_17267":98772,"_5":17162,"_23357":58400,"_2365":98773},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2837":58408,"_24687":58400,"_17267":98775,"_5":17162,"_23357":98756,"_2365":98776},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2837":58409,"_24687":58400,"_17267":98778,"_5":17162,"_23357":98756,"_2365":98779},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2837":58410,"_24687":58400,"_17267":98781,"_5":17162,"_23357":98760,"_2365":98782},[],"Recurso",{"_2837":58411,"_24687":58400,"_17267":98784,"_5":17162,"_23357":98760,"_2365":98785},[],"Qué representa",{"_2837":58412,"_24687":58400,"_17267":98787,"_5":17162,"_23357":98760,"_2365":98788},[],"**Dispositivo**",{"_2837":58413,"_24687":58400,"_17267":98790,"_5":17162,"_23357":98760,"_2365":98791},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2837":58414,"_24687":58400,"_17267":98793,"_5":17162,"_23357":98760,"_2365":98794},[],"**Identidad**",{"_2837":58415,"_24687":58400,"_17267":98796,"_5":17162,"_23357":98760,"_2365":98797},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2837":58416,"_24687":58400,"_17267":98799,"_5":17162,"_23357":98760,"_2365":44568},[],{"_2837":58417,"_24687":58400,"_17267":98801,"_5":17162,"_23357":98760,"_2365":98802},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2837":58418,"_24687":58400,"_17267":98804,"_5":17162,"_23357":98760,"_2365":98805},[],"**Flota**",{"_2837":58419,"_24687":58400,"_17267":98807,"_5":17162,"_23357":98760,"_2365":98808},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2837":58420,"_24687":58400,"_17267":98810,"_5":17162,"_23357":98760,"_2365":98811},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2837":58421,"_24687":58400,"_17267":98813,"_5":17162,"_23357":98760,"_2365":98814},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2837":58422,"_24687":58400,"_17267":98816,"_5":17162,"_23357":98763,"_2365":98817},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2837":58423,"_24687":58400,"_17267":98819,"_5":17162,"_23357":98763,"_2365":98820},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2837":58424,"_24687":58400,"_17267":98822,"_5":17162,"_23357":98763,"_2365":98823},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2837":58425,"_24687":58400,"_17267":98825,"_5":17162,"_23357":98763,"_2365":98826},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2837":58426,"_24687":58400,"_17267":98828,"_5":17162,"_23357":98763,"_2365":98829},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2837":58427,"_24687":58400,"_17267":98831,"_5":17162,"_23357":98763,"_2365":98832},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2837":58428,"_24687":58400,"_17267":98834,"_5":17162,"_23357":98763,"_2365":98835},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2837":58429,"_24687":58400,"_17267":98837,"_5":17162,"_23357":98763,"_2365":98838},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2837":58430,"_24687":58400,"_17267":98840,"_5":17162,"_23357":98766,"_2365":98841},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2837":58431,"_24687":58400,"_17267":98843,"_5":17162,"_23357":98766,"_2365":98844},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2837":58432,"_24687":58400,"_17267":98846,"_5":17162,"_23357":98769,"_2365":98847},[],"Participante",{"_2837":58433,"_24687":58400,"_17267":98849,"_5":17162,"_23357":98769,"_2365":98850},[],"Responsabilidad",{"_2837":58434,"_24687":58400,"_17267":98852,"_5":17162,"_23357":98769,"_2365":98853},[],"Administrador PKI",{"_2837":58435,"_24687":58400,"_17267":98855,"_5":17162,"_23357":98769,"_2365":98856},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2837":58436,"_24687":58400,"_17267":98858,"_5":17162,"_23357":98769,"_2365":98859},[],"Administrador del aprovisionamiento",{"_2837":58437,"_24687":58400,"_17267":98861,"_5":17162,"_23357":98769,"_2365":98862},[],"DMS, admisión, autenticación por operación e inventario.",{"_2837":58438,"_24687":58400,"_17267":98864,"_5":17162,"_23357":98769,"_2365":98865},[],"Integrador del dispositivo",{"_2837":58439,"_24687":58400,"_17267":98867,"_5":17162,"_23357":98769,"_2365":98868},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2837":58440,"_24687":58400,"_17267":98870,"_5":17162,"_23357":98769,"_2365":98871},[],"Integrador del consumidor",{"_2837":58441,"_24687":58400,"_17267":98873,"_5":17162,"_23357":98769,"_2365":98874},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2837":58442,"_24687":58400,"_17267":98876,"_5":17162,"_23357":98769,"_2365":98877},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2837":58443,"_24687":58443,"_5":12136,"_2365":98879,"_25023":98880,"_17267":98882,"_23357":58443},"Enrola y conecta tu primer dispositivo",[40249,95914,42511,98881],"Primeros pasos",[],{"_2837":58444,"_24687":58443,"_17267":98884,"_5":17162,"_23357":58443,"_2365":98885},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2837":58445,"_24687":58443,"_5":25020,"_17267":98887,"_23357":98888,"_2365":94615},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2837":58446,"_24687":58443,"_5":25020,"_17267":98890,"_23357":98891,"_2365":98892},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2837":58447,"_24687":58443,"_5":25020,"_17267":98894,"_23357":98895,"_2365":98896},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2837":58448,"_24687":58443,"_5":25020,"_17267":98898,"_23357":98899,"_2365":98900},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2837":58449,"_24687":58443,"_5":25020,"_17267":98902,"_23357":98903,"_2365":98904},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2837":58450,"_24687":58443,"_5":25020,"_17267":98906,"_23357":98907,"_2365":98908},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2837":58451,"_24687":58443,"_5":25020,"_17267":98910,"_23357":98911,"_2365":98912},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2837":58452,"_24687":58443,"_5":25020,"_17267":98914,"_23357":98915,"_2365":98916},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2837":58453,"_24687":58443,"_17267":98918,"_5":17162,"_23357":58443,"_2365":98919},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2837":58454,"_24687":58443,"_17267":98921,"_5":17162,"_23357":98888,"_2365":98922},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2837":58455,"_24687":58443,"_17267":98924,"_5":17162,"_23357":98888,"_2365":98925},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2837":58456,"_24687":58443,"_17267":98927,"_5":17162,"_23357":98888,"_2365":98928},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2837":58457,"_24687":58443,"_17267":98930,"_5":17162,"_23357":98888,"_2365":98931},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2837":58458,"_24687":58443,"_17267":98933,"_5":17162,"_23357":98888,"_2365":98934},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2837":58459,"_24687":58443,"_17267":98936,"_5":17162,"_23357":98891,"_2365":98937},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2837":58460,"_24687":58443,"_17267":98939,"_5":17162,"_23357":98891,"_2365":98940},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2837":58461,"_24687":58443,"_17267":98942,"_5":17162,"_23357":98895,"_2365":98943},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2837":58462,"_24687":58443,"_17267":98945,"_5":17162,"_23357":98895,"_2365":98946},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2837":58463,"_24687":58443,"_17267":98948,"_5":17162,"_23357":98895,"_2365":98949},[],"Ajuste",{"_2837":58464,"_24687":58443,"_17267":98951,"_5":17162,"_23357":98895,"_2365":98952},[],"Valor de evaluación",{"_2837":58465,"_24687":58443,"_17267":98954,"_5":17162,"_23357":98895,"_2365":44724},[],{"_2837":58466,"_24687":58443,"_17267":98956,"_5":17162,"_23357":98895,"_2365":98957},[],"Raíz emisora de `device-root.pem`.",{"_2837":58467,"_24687":58443,"_17267":98959,"_5":17162,"_23357":98895,"_2365":97133},[],{"_2837":58468,"_24687":58443,"_17267":98961,"_5":17162,"_23357":98895,"_2365":98962},[],"Perfil final de 1 hora que acabas de preparar.",{"_2837":58469,"_24687":58443,"_17267":98964,"_5":17162,"_23357":98895,"_2365":44735},[],{"_2837":58470,"_24687":58443,"_17267":98966,"_5":17162,"_23357":98895,"_2365":44738},[],{"_2837":58471,"_24687":58443,"_17267":98968,"_5":17162,"_23357":98895,"_2365":44741},[],{"_2837":58472,"_24687":58443,"_17267":98970,"_5":17162,"_23357":98895,"_2365":98971},[],"Habilitado.",{"_2837":58473,"_24687":58443,"_17267":98973,"_5":17162,"_23357":98895,"_2365":44747},[],{"_2837":58474,"_24687":58443,"_17267":98975,"_5":17162,"_23357":98895,"_2365":98976},[],"Deshabilitado; el ID debe ser nuevo.",{"_2837":58475,"_24687":58443,"_17267":98978,"_5":17162,"_23357":98895,"_2365":98979},[],"Autenticación inicial",{"_2837":58476,"_24687":58443,"_17267":98981,"_5":17162,"_23357":98895,"_2365":98982},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2837":58477,"_24687":58443,"_17267":98984,"_5":17162,"_23357":98895,"_2365":98985},[],"Autenticación de renovación",{"_2837":58478,"_24687":58443,"_17267":98987,"_5":17162,"_23357":98895,"_2365":98988},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2837":58479,"_24687":58443,"_17267":98990,"_5":17162,"_23357":98895,"_2365":44765},[],{"_2837":58480,"_24687":58443,"_17267":98992,"_5":17162,"_23357":98895,"_2365":98993},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2837":58481,"_24687":58443,"_17267":98995,"_5":17162,"_23357":98895,"_2365":44771},[],{"_2837":58482,"_24687":58443,"_17267":98997,"_5":17162,"_23357":98895,"_2365":98998},[],"1 hora.",{"_2837":58483,"_24687":58443,"_17267":99000,"_5":17162,"_23357":98895,"_2365":44777},[],{"_2837":58484,"_24687":58443,"_17267":99002,"_5":17162,"_23357":98895,"_2365":99003},[],"30 minutos / 10 minutos.",{"_2837":58485,"_24687":58443,"_17267":99005,"_5":17162,"_23357":98895,"_2365":44783},[],{"_2837":58486,"_24687":58443,"_17267":99007,"_5":17162,"_23357":98895,"_2365":99008},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2837":58487,"_24687":58443,"_17267":99010,"_5":17162,"_23357":98895,"_2365":42830},[],{"_2837":58488,"_24687":58443,"_17267":99012,"_5":17162,"_23357":98895,"_2365":99013},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2837":58489,"_24687":58443,"_17267":99015,"_5":17162,"_23357":98895,"_2365":44794},[],{"_2837":58490,"_24687":58443,"_17267":99017,"_5":17162,"_23357":98895,"_2365":99018},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2837":58491,"_24687":58443,"_17267":99020,"_5":17162,"_23357":98895,"_2365":99021},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2837":58492,"_24687":58443,"_17267":99023,"_5":17162,"_23357":98899,"_2365":99024},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2837":58493,"_24687":58443,"_17267":99026,"_5":17162,"_23357":98899,"_2365":99027},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2837":58494,"_24687":58443,"_17267":99029,"_5":17162,"_23357":98903,"_2365":99030},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2837":58495,"_24687":58443,"_17267":99032,"_5":17162,"_23357":98903,"_2365":99033},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2837":58496,"_24687":58443,"_17267":99035,"_5":17162,"_23357":98903,"_2365":99036},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2837":58497,"_24687":58443,"_17267":99038,"_5":17162,"_23357":98907,"_2365":99039},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2837":58498,"_24687":58443,"_17267":99041,"_5":17162,"_23357":98907,"_2365":99042},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2837":58499,"_24687":58443,"_17267":99044,"_5":17162,"_23357":98911,"_2365":99045},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2837":58500,"_24687":58443,"_17267":99047,"_5":17162,"_23357":98911,"_2365":99048},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2837":58501,"_24687":58443,"_17267":99050,"_5":17162,"_23357":98911,"_2365":99051},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2837":58502,"_24687":58443,"_17267":99053,"_5":17162,"_23357":98911,"_2365":99054},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2837":58503,"_24687":58443,"_17267":99056,"_5":17162,"_23357":98911,"_2365":99057},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2837":58504,"_24687":58443,"_17267":99059,"_5":17162,"_23357":98915,"_2365":99060},[],"Comprobación",{"_2837":58505,"_24687":58443,"_17267":99062,"_5":17162,"_23357":98915,"_2365":99063},[],"Resultado esperado",{"_2837":58506,"_24687":58443,"_17267":99065,"_5":17162,"_23357":98915,"_2365":99066},[],"Registro",{"_2837":58507,"_24687":58443,"_17267":99068,"_5":17162,"_23357":98915,"_2365":99069},[],"ID creado automáticamente y DMS correcto.",{"_2837":58508,"_24687":58443,"_17267":99071,"_5":17162,"_23357":98915,"_2365":99072},[],"Certificado",{"_2837":58509,"_24687":58443,"_17267":99074,"_5":17162,"_23357":98915,"_2365":99075},[],"CN, perfil, serie y clave verificados.",{"_2837":58510,"_24687":58443,"_17267":99077,"_5":17162,"_23357":98915,"_2365":99078},[],"Inventario",{"_2837":58511,"_24687":58443,"_17267":99080,"_5":17162,"_23357":98915,"_2365":99081},[],"Serie recibida visible como identidad actual y en el historial.",{"_2837":58512,"_24687":58443,"_17267":99083,"_5":17162,"_23357":98915,"_2365":99084},[],"Consumidor",{"_2837":58513,"_24687":58443,"_17267":99086,"_5":17162,"_23357":98915,"_2365":99087},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2837":58514,"_24687":58443,"_17267":99089,"_5":17162,"_23357":98915,"_2365":99090},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2837":58515,"_24687":58443,"_17267":99092,"_5":17162,"_23357":98915,"_2365":99093},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2837":58516,"_24687":58516,"_5":12136,"_2365":96847,"_25023":99095,"_17267":99096,"_23357":58516},[40249,95914,42511,98881],[],{"_2837":58517,"_24687":58516,"_17267":99098,"_5":17162,"_23357":58516,"_2365":99099},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2837":58518,"_24687":58516,"_5":25020,"_17267":99101,"_23357":99102,"_2365":94615},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2837":58519,"_24687":58516,"_5":25020,"_17267":99104,"_23357":99105,"_2365":99106},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2837":58520,"_24687":58516,"_5":25020,"_17267":99108,"_23357":99109,"_2365":99110},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2837":58521,"_24687":58516,"_5":25020,"_17267":99112,"_23357":99113,"_2365":99114},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2837":58522,"_24687":58516,"_5":25020,"_17267":99116,"_23357":99117,"_2365":99118},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2837":58523,"_24687":58516,"_5":25020,"_17267":99120,"_23357":99121,"_2365":99122},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2837":58524,"_24687":58516,"_5":25020,"_17267":99124,"_23357":99125,"_2365":99063},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2837":58525,"_24687":58516,"_5":25020,"_17267":99127,"_23357":99128,"_2365":99129},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2837":58526,"_24687":58516,"_5":25020,"_17267":99131,"_23357":99132,"_2365":99133},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2837":58527,"_24687":58516,"_17267":99135,"_5":17162,"_23357":58516,"_2365":99136},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2837":58528,"_24687":58516,"_17267":99138,"_5":17162,"_23357":58516,"_2365":99139},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2837":58529,"_24687":58516,"_17267":99141,"_5":17162,"_23357":99102,"_2365":99142},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2837":58530,"_24687":58516,"_17267":99144,"_5":17162,"_23357":99102,"_2365":99145},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2837":58531,"_24687":58516,"_17267":99147,"_5":17162,"_23357":99102,"_2365":99148},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2837":58532,"_24687":58516,"_17267":99150,"_5":17162,"_23357":99102,"_2365":99151},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2837":58533,"_24687":58516,"_17267":99153,"_5":17162,"_23357":99105,"_2365":99154},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2837":58534,"_24687":58516,"_17267":99156,"_5":17162,"_23357":99105,"_2365":99157},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2837":58535,"_24687":58516,"_17267":99159,"_5":17162,"_23357":99105,"_2365":99160},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2837":58536,"_24687":58516,"_17267":99162,"_5":17162,"_23357":99105,"_2365":99163},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2837":58537,"_24687":58516,"_17267":99165,"_5":17162,"_23357":99105,"_2365":99166},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2837":58538,"_24687":58516,"_17267":99168,"_5":17162,"_23357":99105,"_2365":99169},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2837":58539,"_24687":58516,"_17267":99171,"_5":17162,"_23357":99105,"_2365":99172},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2837":58540,"_24687":58516,"_17267":99174,"_5":17162,"_23357":99105,"_2365":99175},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2837":58541,"_24687":58516,"_17267":99177,"_5":17162,"_23357":99109,"_2365":99178},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2837":58542,"_24687":58516,"_17267":99180,"_5":17162,"_23357":99109,"_2365":44960},[],{"_2837":58543,"_24687":58516,"_17267":99182,"_5":17162,"_23357":99109,"_2365":99183},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2837":58544,"_24687":58516,"_17267":99185,"_5":17162,"_23357":99109,"_2365":99186},[],"**Icon** y **Tags**: clasificación opcional.",{"_2837":58545,"_24687":58516,"_17267":99188,"_5":17162,"_23357":99109,"_2365":99189},[],"Confirma el registro.",{"_2837":58546,"_24687":58516,"_17267":99191,"_5":17162,"_23357":99113,"_2365":99192},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2837":58547,"_24687":58516,"_17267":99194,"_5":17162,"_23357":99113,"_2365":99195},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2837":58548,"_24687":58516,"_17267":99197,"_5":17162,"_23357":99117,"_2365":99198},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2837":58549,"_24687":58516,"_17267":99200,"_5":17162,"_23357":99117,"_2365":99201},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2837":58550,"_24687":58516,"_17267":99203,"_5":17162,"_23357":99121,"_2365":99204},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2837":58551,"_24687":58516,"_17267":99206,"_5":17162,"_23357":99121,"_2365":99207},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2837":58552,"_24687":58516,"_17267":99209,"_5":17162,"_23357":99125,"_2365":99060},[],{"_2837":58553,"_24687":58516,"_17267":99211,"_5":17162,"_23357":99125,"_2365":99212},[],"Resultado",{"_2837":58554,"_24687":58516,"_17267":99214,"_5":17162,"_23357":99125,"_2365":99215},[],"Dispositivo",{"_2837":58555,"_24687":58516,"_17267":99217,"_5":17162,"_23357":99125,"_2365":99218},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2837":58556,"_24687":58516,"_17267":99220,"_5":17162,"_23357":99125,"_2365":99221},[],"Identidad actual",{"_2837":58557,"_24687":58516,"_17267":99223,"_5":17162,"_23357":99125,"_2365":99224},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2837":58558,"_24687":58516,"_17267":99226,"_5":17162,"_23357":99125,"_2365":99227},[],"Historial",{"_2837":58559,"_24687":58516,"_17267":99229,"_5":17162,"_23357":99125,"_2365":99230},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2837":58560,"_24687":58516,"_17267":99232,"_5":17162,"_23357":99125,"_2365":99233},[],"Clave y certificado",{"_2837":58561,"_24687":58516,"_17267":99235,"_5":17162,"_23357":99125,"_2365":99236},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2837":58562,"_24687":58516,"_17267":99238,"_5":17162,"_23357":99128,"_2365":99239},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2837":58563,"_24687":58516,"_17267":99241,"_5":17162,"_23357":99128,"_2365":99242},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2837":58564,"_24687":58516,"_17267":99244,"_5":17162,"_23357":99128,"_2365":99245},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2837":58565,"_24687":58516,"_17267":99247,"_5":17162,"_23357":99128,"_2365":99248},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2837":58566,"_24687":58516,"_17267":99250,"_5":17162,"_23357":99132,"_2365":99251},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2837":58567,"_24687":58516,"_17267":99253,"_5":17162,"_23357":99132,"_2365":99254},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2837":58568,"_24687":58516,"_17267":99256,"_5":17162,"_23357":99132,"_2365":99257},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2837":58569,"_24687":58569,"_5":12136,"_2365":99259,"_25023":99260,"_17267":99261,"_23357":58569},"Plataforma Lamassu IoT",[40249,95914],[],{"_2837":58570,"_24687":58569,"_17267":99263,"_5":17162,"_23357":58569,"_2365":99264},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2837":58571,"_24687":58569,"_5":25020,"_17267":99266,"_23357":99267,"_2365":98757},[],"/docs/pr-preview/pr-36/es/platform/overview#empieza-aquí",{"_2837":58572,"_24687":58569,"_5":25020,"_17267":99269,"_23357":99270,"_2365":99271},[],"/docs/pr-preview/pr-36/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2837":58573,"_24687":58569,"_5":25020,"_17267":99273,"_23357":99274,"_2365":99275},[],"/docs/pr-preview/pr-36/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2837":58574,"_24687":58569,"_5":25020,"_17267":99277,"_23357":99278,"_2365":99279},[],"/docs/pr-preview/pr-36/es/platform/overview#capacidades-principales","Capacidades principales",{"_2837":58575,"_24687":58569,"_5":25020,"_17267":99281,"_23357":99282,"_2365":99283},[],"/docs/pr-preview/pr-36/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2837":58576,"_24687":58569,"_5":25020,"_17267":99285,"_23357":99286,"_2365":99287},[],"/docs/pr-preview/pr-36/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2837":58577,"_24687":58569,"_5":25020,"_17267":99289,"_23357":99290,"_2365":99291},[],"/docs/pr-preview/pr-36/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2837":58578,"_24687":58569,"_5":25020,"_17267":99293,"_23357":99294,"_2365":99295},[],"/docs/pr-preview/pr-36/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2837":58579,"_24687":58569,"_5":25020,"_17267":99297,"_23357":99298,"_2365":99299},[],"/docs/pr-preview/pr-36/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2837":58580,"_24687":58569,"_5":25020,"_17267":99301,"_23357":99302,"_2365":99303},[],"/docs/pr-preview/pr-36/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2837":58581,"_24687":58569,"_5":25020,"_17267":99305,"_23357":99306,"_2365":99307},[],"/docs/pr-preview/pr-36/es/platform/overview#referencia-operativa","Referencia operativa",{"_2837":58582,"_24687":58569,"_17267":99309,"_5":17162,"_23357":58569,"_2365":99310},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2837":58583,"_24687":58569,"_17267":99312,"_5":17162,"_23357":99267,"_2365":99313},[],"Elige el resultado que necesitas obtener:",{"_2837":58584,"_24687":58569,"_17267":99315,"_5":17162,"_23357":99267,"_2365":99316},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2837":58585,"_24687":58569,"_17267":99318,"_5":17162,"_23357":99267,"_2365":99319},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2837":58586,"_24687":58569,"_17267":99321,"_5":17162,"_23357":99267,"_2365":99322},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2837":58587,"_24687":58569,"_17267":99324,"_5":17162,"_23357":99270,"_2365":99325},[],"Bloque",{"_2837":58588,"_24687":58569,"_17267":99327,"_5":17162,"_23357":99270,"_2365":99328},[],"Qué gestionas",{"_2837":58589,"_24687":58569,"_17267":99330,"_5":17162,"_23357":99270,"_2365":99331},[],"Punto de entrada",{"_2837":58590,"_24687":58569,"_17267":99333,"_5":17162,"_23357":99270,"_2365":45114},[],{"_2837":58591,"_24687":58569,"_17267":99335,"_5":17162,"_23357":99270,"_2365":99336},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2837":58592,"_24687":58569,"_17267":99338,"_5":17162,"_23357":99270,"_2365":99339},[],"Visión general de PKI",{"_2837":58593,"_24687":58569,"_17267":99341,"_5":17162,"_23357":99270,"_2365":45123},[],{"_2837":58594,"_24687":58569,"_17267":99343,"_5":17162,"_23357":99270,"_2365":99344},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2837":58595,"_24687":58569,"_17267":99346,"_5":17162,"_23357":99270,"_2365":99347},[],"Visión general de IoT Fleets",{"_2837":58596,"_24687":58569,"_17267":99349,"_5":17162,"_23357":99270,"_2365":99350},[],"**Administración**",{"_2837":58597,"_24687":58569,"_17267":99352,"_5":17162,"_23357":99270,"_2365":99353},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2837":58598,"_24687":58569,"_17267":99355,"_5":17162,"_23357":99270,"_2365":95912},[],{"_2837":58599,"_24687":58569,"_17267":99357,"_5":17162,"_23357":99270,"_2365":99358},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2837":58600,"_24687":58569,"_17267":99360,"_5":17162,"_23357":99274,"_2365":99361},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2837":58601,"_24687":58569,"_17267":99363,"_5":17162,"_23357":99274,"_2365":99364},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2837":58602,"_24687":58569,"_17267":99366,"_5":17162,"_23357":99274,"_2365":99367},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2837":58603,"_24687":58569,"_17267":99369,"_5":17162,"_23357":99274,"_2365":99370},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2837":58604,"_24687":58569,"_17267":99372,"_5":17162,"_23357":99274,"_2365":99373},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2837":58605,"_24687":58569,"_17267":99375,"_5":17162,"_23357":99274,"_2365":99376},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2837":58606,"_24687":58569,"_17267":99378,"_5":17162,"_23357":99282,"_2365":99379},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2837":58607,"_24687":58569,"_17267":99381,"_5":17162,"_23357":99286,"_2365":99382},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2837":58608,"_24687":58569,"_17267":99384,"_5":17162,"_23357":99290,"_2365":99385},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2837":58609,"_24687":58569,"_17267":99387,"_5":17162,"_23357":99294,"_2365":99388},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2837":58610,"_24687":58569,"_17267":99390,"_5":17162,"_23357":99298,"_2365":99391},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2837":58611,"_24687":58569,"_17267":99393,"_5":17162,"_23357":99302,"_2365":99394},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2837":58612,"_24687":58569,"_17267":99396,"_5":17162,"_23357":99306,"_2365":98850},[],{"_2837":58613,"_24687":58569,"_17267":99398,"_5":17162,"_23357":99306,"_2365":99399},[],"Qué prepara o comprueba",{"_2837":58614,"_24687":58569,"_17267":99401,"_5":17162,"_23357":99306,"_2365":98853},[],{"_2837":58615,"_24687":58569,"_17267":99403,"_5":17162,"_23357":99306,"_2365":99404},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2837":58616,"_24687":58569,"_17267":99406,"_5":17162,"_23357":99306,"_2365":99407},[],"Administrador de la flota",{"_2837":58617,"_24687":58569,"_17267":99409,"_5":17162,"_23357":99306,"_2365":99410},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2837":58618,"_24687":58569,"_17267":99412,"_5":17162,"_23357":99306,"_2365":98865},[],{"_2837":58619,"_24687":58569,"_17267":99414,"_5":17162,"_23357":99306,"_2365":99415},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2837":58620,"_24687":58569,"_17267":99417,"_5":17162,"_23357":99306,"_2365":98871},[],{"_2837":58621,"_24687":58569,"_17267":99419,"_5":17162,"_23357":99306,"_2365":99420},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2837":58622,"_24687":58569,"_17267":99422,"_5":17162,"_23357":99306,"_2365":99423},[],"Operador de infraestructura",{"_2837":58623,"_24687":58569,"_17267":99425,"_5":17162,"_23357":99306,"_2365":99426},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2837":58624,"_24687":58569,"_17267":99428,"_5":17162,"_23357":99306,"_2365":99429},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2837":58625,"_24687":58625,"_5":12136,"_2365":99431,"_25023":99432,"_17267":99434,"_23357":58625},"Jerarquía y rotación de CAs",[40249,95914,45215,99433],"Claves, autoridades y certificados",[],{"_2837":58626,"_24687":58625,"_17267":99436,"_5":17162,"_23357":58625,"_2365":99437},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2837":58627,"_24687":58625,"_5":25020,"_17267":99439,"_23357":99440,"_2365":99441},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2837":58628,"_24687":58625,"_5":25020,"_17267":99443,"_23357":99444,"_2365":99445},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2837":58629,"_24687":58625,"_5":25020,"_17267":99447,"_23357":99448,"_2365":99449},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2837":58630,"_24687":58625,"_5":25020,"_17267":99451,"_23357":99452,"_2365":99453},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2837":58631,"_24687":58625,"_5":25020,"_17267":99455,"_23357":99456,"_2365":99457},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2837":58632,"_24687":58625,"_5":25020,"_17267":99459,"_23357":99460,"_2365":99461},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2837":58633,"_24687":58625,"_5":25020,"_17267":99463,"_23357":99464,"_2365":99465},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2837":58634,"_24687":58625,"_5":25020,"_17267":99467,"_23357":99468,"_2365":99469},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2837":58635,"_24687":58625,"_5":25020,"_17267":99471,"_23357":99472,"_2365":99473},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2837":58636,"_24687":58625,"_5":25020,"_17267":99475,"_23357":99476,"_2365":99477},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2837":58637,"_24687":58625,"_5":25020,"_17267":99479,"_23357":99480,"_2365":99481},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2837":58638,"_24687":58625,"_5":25020,"_17267":99483,"_23357":99484,"_2365":99485},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2837":58639,"_24687":58625,"_17267":99487,"_5":17162,"_23357":58625,"_2365":99488},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2837":58640,"_24687":58625,"_17267":99490,"_5":17162,"_23357":58625,"_2365":99491},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2837":58641,"_24687":58625,"_17267":99493,"_5":17162,"_23357":99440,"_2365":99494},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2837":58642,"_24687":58625,"_17267":99496,"_5":17162,"_23357":99440,"_2365":99497},[],"entorno, como producción y preproducción;",{"_2837":58643,"_24687":58625,"_17267":99499,"_5":17162,"_23357":99440,"_2365":99500},[],"propietario o equipo operador;",{"_2837":58644,"_24687":58625,"_17267":99502,"_5":17162,"_23357":99440,"_2365":99503},[],"familia de dispositivos o proceso de fabricación;",{"_2837":58645,"_24687":58625,"_17267":99505,"_5":17162,"_23357":99440,"_2365":99506},[],"región o requisito regulatorio;",{"_2837":58646,"_24687":58625,"_17267":99508,"_5":17162,"_23357":99440,"_2365":99509},[],"motor criptográfico o política de clave;",{"_2837":58647,"_24687":58625,"_17267":99511,"_5":17162,"_23357":99440,"_2365":99512},[],"ventana de mantenimiento y ritmo de renovación.",{"_2837":58648,"_24687":58625,"_17267":99514,"_5":17162,"_23357":99440,"_2365":99515},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2837":58649,"_24687":58625,"_17267":99517,"_5":17162,"_23357":99440,"_2365":99518},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2837":58650,"_24687":58625,"_17267":99520,"_5":17162,"_23357":99444,"_2365":99521},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2837":58651,"_24687":58625,"_17267":99523,"_5":17162,"_23357":99444,"_2365":99524},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2837":58652,"_24687":58625,"_17267":99526,"_5":17162,"_23357":99444,"_2365":99527},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2837":58653,"_24687":58625,"_17267":99529,"_5":17162,"_23357":99448,"_2365":99530},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2837":58654,"_24687":58625,"_17267":99532,"_5":17162,"_23357":99448,"_2365":99533},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2837":58655,"_24687":58625,"_17267":99535,"_5":17162,"_23357":99448,"_2365":99536},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2837":58656,"_24687":58625,"_17267":99538,"_5":17162,"_23357":99448,"_2365":99539},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2837":58657,"_24687":58625,"_17267":99541,"_5":17162,"_23357":99456,"_2365":99542},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2837":58658,"_24687":58625,"_17267":99544,"_5":17162,"_23357":99460,"_2365":99545},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2837":58659,"_24687":58625,"_17267":99547,"_5":17162,"_23357":99464,"_2365":99548},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2837":58660,"_24687":58625,"_17267":99550,"_5":17162,"_23357":99468,"_2365":99551},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2837":58661,"_24687":58625,"_17267":99553,"_5":17162,"_23357":99472,"_2365":99554},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2837":58662,"_24687":58625,"_17267":99556,"_5":17162,"_23357":99476,"_2365":99557},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2837":58663,"_24687":58625,"_17267":99559,"_5":17162,"_23357":99480,"_2365":99560},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2837":58664,"_24687":58625,"_17267":99562,"_5":17162,"_23357":99480,"_2365":99563},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2837":58665,"_24687":58625,"_17267":99565,"_5":17162,"_23357":99480,"_2365":99566},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2837":58666,"_24687":58625,"_17267":99568,"_5":17162,"_23357":99480,"_2365":99569},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2837":58667,"_24687":58625,"_17267":99571,"_5":17162,"_23357":99484,"_2365":99572},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2837":58668,"_24687":58625,"_17267":99574,"_5":17162,"_23357":99484,"_2365":99575},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2837":58669,"_24687":58625,"_17267":99577,"_5":17162,"_23357":99484,"_2365":99578},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2837":58670,"_24687":58625,"_17267":99580,"_5":17162,"_23357":99484,"_2365":99581},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2837":58671,"_24687":58625,"_17267":99583,"_5":17162,"_23357":99484,"_2365":99584},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2837":58672,"_24687":58625,"_17267":99586,"_5":17162,"_23357":99484,"_2365":99587},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2837":58673,"_24687":58625,"_17267":99589,"_5":17162,"_23357":99484,"_2365":99590},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2837":58674,"_24687":58674,"_5":12136,"_2365":99592,"_25023":99593,"_17267":99594,"_23357":58674},"Autoridades de certificación",[40249,95914,45215,99433],[],{"_2837":58675,"_24687":58674,"_17267":99596,"_5":17162,"_23357":58674,"_2365":99597},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2837":58676,"_24687":58674,"_5":25020,"_17267":99599,"_23357":99600,"_2365":99601},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2837":58677,"_24687":58674,"_5":25020,"_17267":99603,"_23357":99604,"_2365":99605},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2837":58678,"_24687":58674,"_5":25020,"_17267":99607,"_23357":99608,"_2365":94615},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2837":58679,"_24687":58674,"_5":25020,"_17267":99610,"_23357":99611,"_2365":99612},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2837":58680,"_24687":58674,"_5":25020,"_17267":99614,"_23357":99615,"_2365":99616},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2837":58681,"_24687":58674,"_5":25020,"_17267":99618,"_23357":99619,"_2365":99620},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2837":58682,"_24687":58674,"_5":25020,"_17267":99622,"_23357":99623,"_2365":99624},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2837":58683,"_24687":58674,"_5":25020,"_17267":99626,"_23357":99627,"_2365":99628},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2837":58684,"_24687":58674,"_5":25020,"_17267":99630,"_23357":99631,"_2365":99632},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2837":58685,"_24687":58674,"_5":25020,"_17267":99634,"_23357":99635,"_2365":99636},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2837":58686,"_24687":58674,"_5":25020,"_17267":99638,"_23357":99639,"_2365":99640},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2837":58687,"_24687":58674,"_5":25020,"_17267":99642,"_23357":99643,"_2365":99644},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2837":58688,"_24687":58674,"_5":25020,"_17267":99646,"_23357":99647,"_2365":99648},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2837":58689,"_24687":58674,"_5":25020,"_17267":99650,"_23357":99651,"_2365":99652},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2837":58690,"_24687":58674,"_5":25020,"_17267":99654,"_23357":99655,"_2365":99656},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2837":58691,"_24687":58674,"_5":25020,"_17267":99658,"_23357":99659,"_2365":99660},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2837":58692,"_24687":58674,"_5":25020,"_17267":99662,"_23357":99663,"_2365":99664},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2837":58693,"_24687":58674,"_5":25020,"_17267":99666,"_23357":99667,"_2365":99668},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2837":58694,"_24687":58674,"_5":25020,"_17267":99670,"_23357":99671,"_2365":99672},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2837":58695,"_24687":58674,"_5":25020,"_17267":99674,"_23357":99675,"_2365":99676},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2837":58696,"_24687":58674,"_5":25020,"_17267":99678,"_23357":99679,"_2365":99680},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2837":58697,"_24687":58674,"_5":25020,"_17267":99682,"_23357":99683,"_2365":99684},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2837":58698,"_24687":58674,"_17267":99686,"_5":17162,"_23357":58674,"_2365":99687},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2837":58699,"_24687":58674,"_17267":99689,"_5":17162,"_23357":58674,"_2365":99690},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2837":58700,"_24687":58674,"_17267":99692,"_5":17162,"_23357":58674,"_2365":99693},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2837":58701,"_24687":58674,"_17267":99695,"_5":17162,"_23357":99600,"_2365":99696},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2837":58702,"_24687":58674,"_17267":99698,"_5":17162,"_23357":99600,"_2365":99699},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2837":58703,"_24687":58674,"_17267":99701,"_5":17162,"_23357":99600,"_2365":99702},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2837":58704,"_24687":58674,"_17267":99704,"_5":17162,"_23357":99600,"_2365":99705},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2837":58705,"_24687":58674,"_17267":99707,"_5":17162,"_23357":99600,"_2365":99708},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2837":58706,"_24687":58674,"_17267":99710,"_5":17162,"_23357":99608,"_2365":99711},[],"Decide si la CA será raíz o intermedia.",{"_2837":58707,"_24687":58674,"_17267":99713,"_5":17162,"_23357":99608,"_2365":99714},[],"Elige el motor que custodiará la clave.",{"_2837":58708,"_24687":58674,"_17267":99716,"_5":17162,"_23357":99608,"_2365":99717},[],"Define una validez superior a la de los certificados que emitirá.",{"_2837":58709,"_24687":58674,"_17267":99719,"_5":17162,"_23357":99608,"_2365":99720},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2837":58710,"_24687":58674,"_17267":99722,"_5":17162,"_23357":99611,"_2365":99723},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2837":58711,"_24687":58674,"_17267":99725,"_5":17162,"_23357":99615,"_2365":99726},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2837":58712,"_24687":58674,"_17267":99728,"_5":17162,"_23357":99615,"_2365":99729},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2837":58713,"_24687":58674,"_17267":99731,"_5":17162,"_23357":99619,"_2365":99732},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2837":58714,"_24687":58674,"_17267":99734,"_5":17162,"_23357":99623,"_2365":99735},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2837":58715,"_24687":58674,"_17267":99737,"_5":17162,"_23357":99623,"_2365":99738},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2837":58716,"_24687":58674,"_17267":99740,"_5":17162,"_23357":99623,"_2365":99741},[],"`ST`: estado o provincia.",{"_2837":58717,"_24687":58674,"_17267":99743,"_5":17162,"_23357":99623,"_2365":99744},[],"`L`: localidad.",{"_2837":58718,"_24687":58674,"_17267":99746,"_5":17162,"_23357":99623,"_2365":99747},[],"`O`: organización.",{"_2837":58719,"_24687":58674,"_17267":99749,"_5":17162,"_23357":99623,"_2365":99750},[],"`OU`: unidad organizativa.",{"_2837":58720,"_24687":58674,"_17267":99752,"_5":17162,"_23357":99623,"_2365":99753},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2837":58721,"_24687":58674,"_17267":99755,"_5":17162,"_23357":99627,"_2365":99756},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2837":58722,"_24687":58674,"_17267":99758,"_5":17162,"_23357":99627,"_2365":99759},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2837":58723,"_24687":58674,"_17267":99761,"_5":17162,"_23357":99631,"_2365":99762},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2837":58724,"_24687":58674,"_17267":99764,"_5":17162,"_23357":99631,"_2365":99765},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2837":58725,"_24687":58674,"_17267":99767,"_5":17162,"_23357":99635,"_2365":99768},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2837":58726,"_24687":58674,"_17267":99770,"_5":17162,"_23357":99635,"_2365":99771},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2837":58727,"_24687":58674,"_17267":99773,"_5":17162,"_23357":99639,"_2365":99774},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2837":58728,"_24687":58674,"_17267":99776,"_5":17162,"_23357":99643,"_2365":99777},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2837":58729,"_24687":58674,"_17267":99779,"_5":17162,"_23357":99647,"_2365":99780},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2837":58730,"_24687":58674,"_17267":99782,"_5":17162,"_23357":99651,"_2365":99783},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2837":58731,"_24687":58674,"_17267":99785,"_5":17162,"_23357":99655,"_2365":99786},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2837":58732,"_24687":58674,"_17267":99788,"_5":17162,"_23357":99655,"_2365":99789},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2837":58733,"_24687":58674,"_17267":99791,"_5":17162,"_23357":99659,"_2365":99792},[],"Abre una CA desde el inventario para consultar:",{"_2837":58734,"_24687":58674,"_17267":99794,"_5":17162,"_23357":99659,"_2365":99795},[],"Estado y periodo de validez.",{"_2837":58735,"_24687":58674,"_17267":99797,"_5":17162,"_23357":99659,"_2365":99798},[],"Certificado y cadena en formato PEM.",{"_2837":58736,"_24687":58674,"_17267":99800,"_5":17162,"_23357":99659,"_2365":99801},[],"Número de certificados activos, expirados y revocados.",{"_2837":58737,"_24687":58674,"_17267":99803,"_5":17162,"_23357":99659,"_2365":99804},[],"Certificados emitidos en **Issued Certificates**.",{"_2837":58738,"_24687":58674,"_17267":99806,"_5":17162,"_23357":99659,"_2365":99807},[],"CRL vinculada a la autoridad.",{"_2837":58739,"_24687":58674,"_17267":99809,"_5":17162,"_23357":99659,"_2365":99810},[],"Metadatos y motor criptográfico asociado.",{"_2837":58740,"_24687":58674,"_17267":99812,"_5":17162,"_23357":99659,"_2365":99813},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2837":58741,"_24687":58674,"_17267":99815,"_5":17162,"_23357":99663,"_2365":99816},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2837":58742,"_24687":58674,"_17267":99818,"_5":17162,"_23357":99663,"_2365":99819},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2837":58743,"_24687":58674,"_17267":99821,"_5":17162,"_23357":99663,"_2365":99822},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2837":58744,"_24687":58674,"_17267":99824,"_5":17162,"_23357":99663,"_2365":99825},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2837":58745,"_24687":58674,"_17267":99827,"_5":17162,"_23357":99667,"_2365":99828},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2837":58746,"_24687":58674,"_17267":99830,"_5":17162,"_23357":99671,"_2365":99831},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2837":58747,"_24687":58674,"_17267":99833,"_5":17162,"_23357":99675,"_2365":99834},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2837":58748,"_24687":58674,"_17267":99836,"_5":17162,"_23357":99679,"_2365":99837},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2837":58749,"_24687":58674,"_17267":99839,"_5":17162,"_23357":99683,"_2365":99840},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2837":58750,"_24687":58674,"_17267":99842,"_5":17162,"_23357":99683,"_2365":99843},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2837":58751,"_24687":58751,"_5":12136,"_2365":99845,"_25023":99846,"_17267":99847,"_23357":58751},"Perfiles de certificado",[40249,95914,45215,99433],[],{"_2837":58752,"_24687":58751,"_17267":99849,"_5":17162,"_23357":58751,"_2365":99850},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2837":58753,"_24687":58751,"_5":25020,"_17267":99852,"_23357":99853,"_2365":99854},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2837":58754,"_24687":58751,"_5":25020,"_17267":99856,"_23357":99857,"_2365":99858},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#validez","Validez",{"_2837":58755,"_24687":58751,"_5":25020,"_17267":99860,"_23357":99861,"_2365":99862},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2837":58756,"_24687":58751,"_5":25020,"_17267":99864,"_23357":99865,"_2365":99866},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2837":58757,"_24687":58751,"_5":25020,"_17267":99868,"_23357":99869,"_2365":99870},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2837":58758,"_24687":58751,"_5":25020,"_17267":99872,"_23357":99873,"_2365":99874},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2837":58759,"_24687":58751,"_5":25020,"_17267":99876,"_23357":99877,"_2365":99878},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2837":58760,"_24687":58751,"_5":25020,"_17267":99880,"_23357":99881,"_2365":99882},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2837":58761,"_24687":58751,"_5":25020,"_17267":99884,"_23357":99885,"_2365":99886},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2837":58762,"_24687":58751,"_5":25020,"_17267":99888,"_23357":99889,"_2365":99890},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2837":58763,"_24687":58751,"_5":25020,"_17267":99892,"_23357":99893,"_2365":99894},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2837":58764,"_24687":58751,"_5":25020,"_17267":99896,"_23357":99897,"_2365":99898},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2837":58765,"_24687":58751,"_5":25020,"_17267":99900,"_23357":99901,"_2365":99902},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2837":58766,"_24687":58751,"_5":25020,"_17267":99904,"_23357":99905,"_2365":99906},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2837":58767,"_24687":58751,"_5":25020,"_17267":99908,"_23357":99909,"_2365":99910},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2837":58768,"_24687":58751,"_5":25020,"_17267":99912,"_23357":99913,"_2365":99914},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2837":58769,"_24687":58751,"_17267":99916,"_5":17162,"_23357":58751,"_2365":99917},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2837":58770,"_24687":58751,"_17267":99919,"_5":17162,"_23357":58751,"_2365":99920},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2837":58771,"_24687":58751,"_17267":99922,"_5":17162,"_23357":99857,"_2365":99923},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2837":58772,"_24687":58751,"_17267":99925,"_5":17162,"_23357":99857,"_2365":99926},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2837":58773,"_24687":58751,"_17267":99928,"_5":17162,"_23357":99861,"_2365":99929},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2837":58774,"_24687":58751,"_17267":99931,"_5":17162,"_23357":99865,"_2365":99932},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2837":58775,"_24687":58751,"_17267":99934,"_5":17162,"_23357":99865,"_2365":99935},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2837":58776,"_24687":58751,"_17267":99937,"_5":17162,"_23357":99865,"_2365":99938},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2837":58777,"_24687":58751,"_17267":99940,"_5":17162,"_23357":99869,"_2365":99941},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2837":58778,"_24687":58751,"_17267":99943,"_5":17162,"_23357":99873,"_2365":99944},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2837":58779,"_24687":58751,"_17267":99946,"_5":17162,"_23357":99873,"_2365":99947},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2837":58780,"_24687":58751,"_17267":99949,"_5":17162,"_23357":99877,"_2365":99950},[],"La aplicación criptográfica puede:",{"_2837":58781,"_24687":58751,"_17267":99952,"_5":17162,"_23357":99877,"_2365":99953},[],"permitir o bloquear claves RSA;",{"_2837":58782,"_24687":58751,"_17267":99955,"_5":17162,"_23357":99877,"_2365":99956},[],"limitar los tamaños RSA admitidos;",{"_2837":58783,"_24687":58751,"_17267":99958,"_5":17162,"_23357":99877,"_2365":99959},[],"permitir o bloquear claves ECDSA;",{"_2837":58784,"_24687":58751,"_17267":99961,"_5":17162,"_23357":99877,"_2365":99962},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2837":58785,"_24687":58751,"_17267":99964,"_5":17162,"_23357":99877,"_2365":99965},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2837":58786,"_24687":58751,"_17267":99967,"_5":17162,"_23357":99881,"_2365":99968},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2837":58787,"_24687":58751,"_17267":99970,"_5":17162,"_23357":99881,"_2365":95705},[],{"_2837":58788,"_24687":58751,"_17267":99972,"_5":17162,"_23357":99881,"_2365":99973},[],"Primera opción",{"_2837":58789,"_24687":58751,"_17267":99975,"_5":17162,"_23357":99881,"_2365":99976},[],"Segunda opción",{"_2837":58790,"_24687":58751,"_17267":99978,"_5":17162,"_23357":99881,"_2365":99979},[],"Si no hay ninguna",{"_2837":58791,"_24687":58751,"_17267":99981,"_5":17162,"_23357":99881,"_2365":99982},[],"Firma directa con una CA",{"_2837":58792,"_24687":58751,"_17267":99984,"_5":17162,"_23357":99881,"_2365":99985},[],"`issuance_profile` incluido en la solicitud",{"_2837":58793,"_24687":58751,"_17267":99987,"_5":17162,"_23357":99881,"_2365":99988},[],"`issuance_profile_id` de la solicitud",{"_2837":58794,"_24687":58751,"_17267":99990,"_5":17162,"_23357":99881,"_2365":99991},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2837":58795,"_24687":58751,"_17267":99993,"_5":17162,"_23357":99881,"_2365":99994},[],"Emisión mediante DMS",{"_2837":58796,"_24687":58751,"_17267":99996,"_5":17162,"_23357":99881,"_2365":45780},[],{"_2837":58797,"_24687":58751,"_17267":99998,"_5":17162,"_23357":99881,"_2365":99999},[],"`settings.issuance_profile` incluido en el DMS",{"_2837":58798,"_24687":58751,"_17267":100001,"_5":17162,"_23357":99881,"_2365":100002},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2837":58799,"_24687":58751,"_17267":100004,"_5":17162,"_23357":99881,"_2365":100005},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2837":58800,"_24687":58751,"_17267":100007,"_5":17162,"_23357":99881,"_2365":100008},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2837":58801,"_24687":58751,"_17267":100010,"_5":17162,"_23357":99889,"_2365":100011},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2837":58802,"_24687":58751,"_17267":100013,"_5":17162,"_23357":99893,"_2365":100014},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2837":58803,"_24687":58751,"_17267":100016,"_5":17162,"_23357":99897,"_2365":100017},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2837":58804,"_24687":58751,"_17267":100019,"_5":17162,"_23357":99901,"_2365":100020},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2837":58805,"_24687":58751,"_17267":100022,"_5":17162,"_23357":99905,"_2365":100023},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2837":58806,"_24687":58751,"_17267":100025,"_5":17162,"_23357":99905,"_2365":100026},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2837":58807,"_24687":58751,"_17267":100028,"_5":17162,"_23357":99909,"_2365":100029},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2837":58808,"_24687":58751,"_17267":100031,"_5":17162,"_23357":99909,"_2365":100032},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2837":58809,"_24687":58751,"_17267":100034,"_5":17162,"_23357":99909,"_2365":100035},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2837":58810,"_24687":58751,"_17267":100037,"_5":17162,"_23357":99909,"_2365":100038},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2837":58811,"_24687":58751,"_17267":100040,"_5":17162,"_23357":99913,"_2365":100041},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2837":58812,"_24687":58751,"_17267":100043,"_5":17162,"_23357":99913,"_2365":100044},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2837":58813,"_24687":58813,"_5":12136,"_2365":100046,"_25023":100047,"_17267":100049,"_23357":58813},"Validación de certificados",[40249,95914,45215,100048],"Validación",[],{"_2837":58814,"_24687":58813,"_17267":100051,"_5":17162,"_23357":58813,"_2365":100052},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2837":58815,"_24687":58813,"_5":25020,"_17267":100054,"_23357":100055,"_2365":100056},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2837":58816,"_24687":58813,"_5":25020,"_17267":100058,"_23357":100059,"_2365":100060},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2837":58817,"_24687":58813,"_5":25020,"_17267":100062,"_23357":100063,"_2365":100064},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2837":58818,"_24687":58813,"_17267":100066,"_5":17162,"_23357":58813,"_2365":100067},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2837":58819,"_24687":58813,"_17267":100069,"_5":17162,"_23357":100055,"_2365":100070},[],"Verifica estos criterios juntos:",{"_2837":58820,"_24687":58813,"_17267":100072,"_5":17162,"_23357":100055,"_2365":99060},[],{"_2837":58821,"_24687":58813,"_17267":100074,"_5":17162,"_23357":100055,"_2365":100075},[],"Resultado necesario",{"_2837":58822,"_24687":58813,"_17267":100077,"_5":17162,"_23357":100055,"_2365":100078},[],"Cadena y firma",{"_2837":58823,"_24687":58813,"_17267":100080,"_5":17162,"_23357":100055,"_2365":100081},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2837":58824,"_24687":58813,"_17267":100083,"_5":17162,"_23357":100055,"_2365":100084},[],"Fechas",{"_2837":58825,"_24687":58813,"_17267":100086,"_5":17162,"_23357":100055,"_2365":100087},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2837":58826,"_24687":58813,"_17267":100089,"_5":17162,"_23357":100055,"_2365":95618},[],{"_2837":58827,"_24687":58813,"_17267":100091,"_5":17162,"_23357":100055,"_2365":100092},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2837":58828,"_24687":58813,"_17267":100094,"_5":17162,"_23357":100055,"_2365":100095},[],"Uso",{"_2837":58829,"_24687":58813,"_17267":100097,"_5":17162,"_23357":100055,"_2365":100098},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2837":58830,"_24687":58813,"_17267":100100,"_5":17162,"_23357":100055,"_2365":100101},[],"Revocación",{"_2837":58831,"_24687":58813,"_17267":100103,"_5":17162,"_23357":100055,"_2365":100104},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2837":58832,"_24687":58813,"_17267":100106,"_5":17162,"_23357":100055,"_2365":100107},[],"Autorización",{"_2837":58833,"_24687":58813,"_17267":100109,"_5":17162,"_23357":100055,"_2365":100110},[],"La aplicación permite la acción a esa identidad.",{"_2837":58834,"_24687":58813,"_17267":100112,"_5":17162,"_23357":100055,"_2365":100113},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2837":58835,"_24687":58813,"_17267":100115,"_5":17162,"_23357":100059,"_2365":100116},[],"Mecanismo",{"_2837":58836,"_24687":58813,"_17267":100118,"_5":17162,"_23357":100059,"_2365":100119},[],"Cuándo utilizarlo",{"_2837":58837,"_24687":58813,"_17267":100121,"_5":17162,"_23357":100059,"_2365":100122},[],"Qué debes mantener",{"_2837":58838,"_24687":58813,"_17267":100124,"_5":17162,"_23357":100059,"_2365":45908},[],{"_2837":58839,"_24687":58813,"_17267":100126,"_5":17162,"_23357":100059,"_2365":100127},[],"Consulta del estado de un certificado concreto.",{"_2837":58840,"_24687":58813,"_17267":100129,"_5":17162,"_23357":100059,"_2365":100130},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2837":58841,"_24687":58813,"_17267":100132,"_5":17162,"_23357":100059,"_2365":45917},[],{"_2837":58842,"_24687":58813,"_17267":100134,"_5":17162,"_23357":100059,"_2365":100135},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2837":58843,"_24687":58813,"_17267":100137,"_5":17162,"_23357":100059,"_2365":100138},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2837":58844,"_24687":58813,"_17267":100140,"_5":17162,"_23357":100059,"_2365":100141},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2837":58845,"_24687":58813,"_17267":100143,"_5":17162,"_23357":100059,"_2365":100144},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2837":58846,"_24687":58813,"_17267":100146,"_5":17162,"_23357":100063,"_2365":100147},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2837":58847,"_24687":58813,"_17267":100149,"_5":17162,"_23357":100063,"_2365":100150},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2837":58848,"_24687":58813,"_17267":100152,"_5":17162,"_23357":100063,"_2365":100153},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2837":58849,"_24687":58813,"_17267":100155,"_5":17162,"_23357":100063,"_2365":100156},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2837":58850,"_24687":58813,"_17267":100158,"_5":17162,"_23357":100063,"_2365":100159},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2837":58851,"_24687":58813,"_17267":100161,"_5":17162,"_23357":100063,"_2365":100162},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2837":58852,"_24687":58813,"_17267":100164,"_5":17162,"_23357":100063,"_2365":100165},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2837":58853,"_24687":58813,"_17267":100167,"_5":17162,"_23357":100063,"_2365":100168},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2837":58854,"_24687":58813,"_17267":100170,"_5":17162,"_23357":100063,"_2365":100171},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2837":58855,"_24687":58855,"_5":12136,"_2365":100173,"_25023":100174,"_17267":100175,"_23357":58855},"Certificados",[40249,95914,45215,99433],[],{"_2837":58856,"_24687":58855,"_17267":100177,"_5":17162,"_23357":58855,"_2365":100178},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2837":58857,"_24687":58855,"_5":25020,"_17267":100180,"_23357":100181,"_2365":100182},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2837":58858,"_24687":58855,"_5":25020,"_17267":100184,"_23357":100185,"_2365":100186},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2837":58859,"_24687":58855,"_5":25020,"_17267":100188,"_23357":100189,"_2365":100190},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2837":58860,"_24687":58855,"_5":25020,"_17267":100192,"_23357":100193,"_2365":100194},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2837":58861,"_24687":58855,"_5":25020,"_17267":100196,"_23357":100197,"_2365":100198},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2837":58862,"_24687":58855,"_5":25020,"_17267":100200,"_23357":100201,"_2365":100202},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2837":58863,"_24687":58855,"_5":25020,"_17267":100204,"_23357":100205,"_2365":100206},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2837":58864,"_24687":58855,"_5":25020,"_17267":100208,"_23357":100209,"_2365":100210},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2837":58865,"_24687":58855,"_5":25020,"_17267":100212,"_23357":100213,"_2365":100214},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#continúa","Continúa",{"_2837":58866,"_24687":58855,"_17267":100216,"_5":17162,"_23357":58855,"_2365":100217},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2837":58867,"_24687":58855,"_17267":100219,"_5":17162,"_23357":100181,"_2365":100220},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2837":58868,"_24687":58855,"_17267":100222,"_5":17162,"_23357":100181,"_2365":100223},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2837":58869,"_24687":58855,"_17267":100225,"_5":17162,"_23357":100185,"_2365":100226},[],"Descarga el PEM e inspecciónalo:",{"_2837":58870,"_24687":58855,"_17267":100228,"_5":17162,"_23357":100185,"_2365":100229},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2837":58871,"_24687":58855,"_17267":100231,"_5":17162,"_23357":100189,"_2365":100232},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2837":58872,"_24687":58855,"_17267":100234,"_5":17162,"_23357":100189,"_2365":100235},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2837":58873,"_24687":58855,"_17267":100237,"_5":17162,"_23357":100189,"_2365":100238},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2837":58874,"_24687":58855,"_17267":100240,"_5":17162,"_23357":100189,"_2365":100241},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2837":58875,"_24687":58855,"_17267":100243,"_5":17162,"_23357":100189,"_2365":100244},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2837":58876,"_24687":58855,"_17267":100246,"_5":17162,"_23357":100189,"_2365":100247},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2837":58877,"_24687":58855,"_17267":100249,"_5":17162,"_23357":100189,"_2365":100250},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2837":58878,"_24687":58855,"_17267":100252,"_5":17162,"_23357":100193,"_2365":100253},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2837":58879,"_24687":58855,"_17267":100255,"_5":17162,"_23357":100197,"_2365":100256},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2837":58880,"_24687":58855,"_17267":100258,"_5":17162,"_23357":100201,"_2365":100259},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2837":58881,"_24687":58855,"_17267":100261,"_5":17162,"_23357":100205,"_2365":100262},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2837":58882,"_24687":58855,"_17267":100264,"_5":17162,"_23357":100205,"_2365":100265},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2837":58883,"_24687":58855,"_17267":100267,"_5":17162,"_23357":100205,"_2365":100268},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2837":58884,"_24687":58855,"_17267":100270,"_5":17162,"_23357":100209,"_2365":100271},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2837":58885,"_24687":58855,"_17267":100273,"_5":17162,"_23357":100209,"_2365":100274},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2837":58886,"_24687":58855,"_17267":100276,"_5":17162,"_23357":100209,"_2365":100277},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2837":58887,"_24687":58855,"_17267":100279,"_5":17162,"_23357":100213,"_2365":100280},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2837":58888,"_24687":58855,"_17267":100282,"_5":17162,"_23357":100213,"_2365":100283},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2837":58889,"_24687":58889,"_5":12136,"_2365":100285,"_25023":100286,"_17267":100288,"_23357":58889},"Ciclo de vida de un certificado",[40249,95914,45215,100287],"Conceptos",[],{"_2837":58890,"_24687":58889,"_17267":100290,"_5":17162,"_23357":58889,"_2365":100291},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2837":58891,"_24687":58889,"_5":25020,"_17267":100293,"_23357":100294,"_2365":100295},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2837":58892,"_24687":58889,"_5":25020,"_17267":100297,"_23357":100298,"_2365":100299},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2837":58893,"_24687":58889,"_5":25020,"_17267":100301,"_23357":100302,"_2365":100303},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2837":58894,"_24687":58889,"_5":25020,"_17267":100305,"_23357":100306,"_2365":100307},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2837":58895,"_24687":58889,"_5":25020,"_17267":100309,"_23357":100310,"_2365":100311},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2837":58896,"_24687":58889,"_5":25020,"_17267":100313,"_23357":100314,"_2365":100315},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2837":58897,"_24687":58889,"_5":25020,"_17267":100317,"_23357":100318,"_2365":100319},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2837":58898,"_24687":58889,"_5":25020,"_17267":100321,"_23357":100322,"_2365":100323},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2837":58899,"_24687":58889,"_5":25020,"_17267":100325,"_23357":100326,"_2365":100327},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2837":58900,"_24687":58889,"_5":25020,"_17267":100329,"_23357":100330,"_2365":100331},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2837":58901,"_24687":58889,"_17267":100333,"_5":17162,"_23357":58889,"_2365":100334},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2837":58902,"_24687":58889,"_17267":100336,"_5":17162,"_23357":100298,"_2365":100337},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2837":58903,"_24687":58889,"_17267":100339,"_5":17162,"_23357":100302,"_2365":100340},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2837":58904,"_24687":58889,"_17267":100342,"_5":17162,"_23357":100306,"_2365":100343},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2837":58905,"_24687":58889,"_17267":100345,"_5":17162,"_23357":100310,"_2365":100346},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2837":58906,"_24687":58889,"_17267":100348,"_5":17162,"_23357":100314,"_2365":100349},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2837":58907,"_24687":58889,"_17267":100351,"_5":17162,"_23357":100318,"_2365":100352},[],"Lamassu persiste cuatro estados X.509:",{"_2837":58908,"_24687":58889,"_17267":100354,"_5":17162,"_23357":100318,"_2365":100355},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2837":58909,"_24687":58889,"_17267":100357,"_5":17162,"_23357":100318,"_2365":100358},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2837":58910,"_24687":58889,"_17267":100360,"_5":17162,"_23357":100318,"_2365":100361},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2837":58911,"_24687":58889,"_17267":100363,"_5":17162,"_23357":100318,"_2365":100364},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2837":58912,"_24687":58889,"_17267":100366,"_5":17162,"_23357":100318,"_2365":100367},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2837":58913,"_24687":58889,"_17267":100369,"_5":17162,"_23357":100322,"_2365":100370},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2837":58914,"_24687":58889,"_17267":100372,"_5":17162,"_23357":100322,"_2365":100373},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2837":58915,"_24687":58889,"_17267":100375,"_5":17162,"_23357":100322,"_2365":100376},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2837":58916,"_24687":58889,"_17267":100378,"_5":17162,"_23357":100326,"_2365":100379},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2837":58917,"_24687":58889,"_17267":100381,"_5":17162,"_23357":100326,"_2365":100382},[],"Antes de confirmar:",{"_2837":58918,"_24687":58889,"_17267":100384,"_5":17162,"_23357":100326,"_2365":100385},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2837":58919,"_24687":58889,"_17267":100387,"_5":17162,"_23357":100326,"_2365":100388},[],"Distribuye la nueva cadena de confianza.",{"_2837":58920,"_24687":58889,"_17267":100390,"_5":17162,"_23357":100326,"_2365":100391},[],"Reemite las identidades necesarias.",{"_2837":58921,"_24687":58889,"_17267":100393,"_5":17162,"_23357":100326,"_2365":100394},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2837":58922,"_24687":58889,"_17267":100396,"_5":17162,"_23357":100326,"_2365":100397},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2837":58923,"_24687":58889,"_17267":100399,"_5":17162,"_23357":100326,"_2365":100400},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2837":58924,"_24687":58889,"_17267":100402,"_5":17162,"_23357":100330,"_2365":100403},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2837":58925,"_24687":58889,"_17267":100405,"_5":17162,"_23357":100330,"_2365":100406},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2837":58926,"_24687":58889,"_17267":100408,"_5":17162,"_23357":100330,"_2365":100409},[],"Cambios de estado y razones de revocación.",{"_2837":58927,"_24687":58889,"_17267":100411,"_5":17162,"_23357":100330,"_2365":100412},[],"Publicación y vigencia de OCSP y CRLs.",{"_2837":58928,"_24687":58889,"_17267":100414,"_5":17162,"_23357":100330,"_2365":100415},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2837":58929,"_24687":58889,"_17267":100417,"_5":17162,"_23357":100330,"_2365":100418},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2837":58930,"_24687":58930,"_5":12136,"_2365":100420,"_25023":100421,"_17267":100422,"_23357":58930},"Modelo de confianza",[40249,95914,45215,100287],[],{"_2837":58931,"_24687":58930,"_17267":100424,"_5":17162,"_23357":58930,"_2365":100425},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2837":58932,"_24687":58930,"_5":25020,"_17267":100427,"_23357":100428,"_2365":100429},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2837":58933,"_24687":58930,"_5":25020,"_17267":100431,"_23357":100432,"_2365":100433},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2837":58934,"_24687":58930,"_5":25020,"_17267":100435,"_23357":100436,"_2365":100437},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2837":58935,"_24687":58930,"_5":25020,"_17267":100439,"_23357":100440,"_2365":100441},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2837":58936,"_24687":58930,"_5":25020,"_17267":100443,"_23357":100444,"_2365":100445},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2837":58937,"_24687":58930,"_5":25020,"_17267":100447,"_23357":100448,"_2365":100449},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2837":58938,"_24687":58930,"_5":25020,"_17267":100451,"_23357":100452,"_2365":100453},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2837":58939,"_24687":58930,"_5":25020,"_17267":100455,"_23357":100456,"_2365":100457},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2837":58940,"_24687":58930,"_5":25020,"_17267":100459,"_23357":100460,"_2365":100461},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2837":58941,"_24687":58930,"_5":25020,"_17267":100463,"_23357":100464,"_2365":100465},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2837":58942,"_24687":58930,"_17267":100467,"_5":17162,"_23357":58930,"_2365":100468},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2837":58943,"_24687":58930,"_17267":100470,"_5":17162,"_23357":100432,"_2365":100471},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2837":58944,"_24687":58930,"_17267":100473,"_5":17162,"_23357":100436,"_2365":100474},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2837":58945,"_24687":58930,"_17267":100476,"_5":17162,"_23357":100440,"_2365":100477},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2837":58946,"_24687":58930,"_17267":100479,"_5":17162,"_23357":100444,"_2365":100480},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2837":58947,"_24687":58930,"_17267":100482,"_5":17162,"_23357":100448,"_2365":100483},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2837":58948,"_24687":58930,"_17267":100485,"_5":17162,"_23357":100448,"_2365":100486},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2837":58949,"_24687":58930,"_17267":100488,"_5":17162,"_23357":100448,"_2365":100489},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2837":58950,"_24687":58930,"_17267":100491,"_5":17162,"_23357":100448,"_2365":100492},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2837":58951,"_24687":58930,"_17267":100494,"_5":17162,"_23357":100448,"_2365":100495},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2837":58952,"_24687":58930,"_17267":100497,"_5":17162,"_23357":100448,"_2365":100498},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2837":58953,"_24687":58930,"_17267":100500,"_5":17162,"_23357":100452,"_2365":100501},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2837":58954,"_24687":58930,"_17267":100503,"_5":17162,"_23357":100452,"_2365":100504},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2837":58955,"_24687":58930,"_17267":100506,"_5":17162,"_23357":100452,"_2365":100507},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2837":58956,"_24687":58930,"_17267":100509,"_5":17162,"_23357":100452,"_2365":100510},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2837":58957,"_24687":58930,"_17267":100512,"_5":17162,"_23357":100452,"_2365":100513},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2837":58958,"_24687":58930,"_17267":100515,"_5":17162,"_23357":100456,"_2365":100516},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2837":58959,"_24687":58930,"_17267":100518,"_5":17162,"_23357":100456,"_2365":100519},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2837":58960,"_24687":58930,"_17267":100521,"_5":17162,"_23357":100456,"_2365":100522},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2837":58961,"_24687":58930,"_17267":100524,"_5":17162,"_23357":100456,"_2365":100525},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2837":58962,"_24687":58930,"_17267":100527,"_5":17162,"_23357":100456,"_2365":100528},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2837":58963,"_24687":58930,"_17267":100530,"_5":17162,"_23357":100456,"_2365":100531},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2837":58964,"_24687":58930,"_17267":100533,"_5":17162,"_23357":100456,"_2365":100534},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2837":58965,"_24687":58930,"_17267":100536,"_5":17162,"_23357":100460,"_2365":100537},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2837":58966,"_24687":58930,"_17267":100539,"_5":17162,"_23357":100464,"_2365":100540},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2837":58967,"_24687":58930,"_17267":100542,"_5":17162,"_23357":100464,"_2365":100543},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2837":58968,"_24687":58930,"_17267":100545,"_5":17162,"_23357":100464,"_2365":100546},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2837":58969,"_24687":58930,"_17267":100548,"_5":17162,"_23357":100464,"_2365":100549},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2837":58970,"_24687":58930,"_17267":100551,"_5":17162,"_23357":100464,"_2365":100552},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2837":58971,"_24687":58930,"_17267":100554,"_5":17162,"_23357":100464,"_2365":100555},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2837":58972,"_24687":58930,"_17267":100557,"_5":17162,"_23357":100464,"_2365":100558},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2837":58973,"_24687":58973,"_5":12136,"_2365":100560,"_25023":100561,"_17267":100562,"_23357":58973},"Listas de revocación (CRL)",[40249,95914,45215,100048],[],{"_2837":58974,"_24687":58973,"_17267":100564,"_5":17162,"_23357":58973,"_2365":100565},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2837":58975,"_24687":58973,"_5":25020,"_17267":100567,"_23357":100568,"_2365":100569},[],"/docs/pr-preview/pr-36/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2837":58976,"_24687":58973,"_5":25020,"_17267":100571,"_23357":100572,"_2365":100573},[],"/docs/pr-preview/pr-36/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2837":58977,"_24687":58973,"_5":25020,"_17267":100575,"_23357":100576,"_2365":100577},[],"/docs/pr-preview/pr-36/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2837":58978,"_24687":58973,"_5":25020,"_17267":100579,"_23357":100580,"_2365":100581},[],"/docs/pr-preview/pr-36/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2837":58979,"_24687":58973,"_5":25020,"_17267":100583,"_23357":100584,"_2365":100585},[],"/docs/pr-preview/pr-36/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2837":58980,"_24687":58973,"_5":25020,"_17267":100587,"_23357":100588,"_2365":100589},[],"/docs/pr-preview/pr-36/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2837":58981,"_24687":58973,"_5":25020,"_17267":100591,"_23357":100592,"_2365":100593},[],"/docs/pr-preview/pr-36/es/platform/pki/crl#referencias","Referencias",{"_2837":58982,"_24687":58973,"_17267":100595,"_5":17162,"_23357":58973,"_2365":100596},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2837":58983,"_24687":58973,"_17267":100598,"_5":17162,"_23357":100568,"_2365":100599},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2837":58984,"_24687":58973,"_17267":100601,"_5":17162,"_23357":100568,"_2365":100602},[],"Campo de `crl_options`",{"_2837":58985,"_24687":58973,"_17267":100604,"_5":17162,"_23357":100568,"_2365":97351},[],{"_2837":58986,"_24687":58973,"_17267":100606,"_5":17162,"_23357":100568,"_2365":100607},[],"Valor inicial del backend",{"_2837":58987,"_24687":58973,"_17267":100609,"_5":17162,"_23357":100568,"_2365":46395},[],{"_2837":58988,"_24687":58973,"_17267":100611,"_5":17162,"_23357":100568,"_2365":100612},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2837":58989,"_24687":58973,"_17267":100614,"_5":17162,"_23357":100568,"_2365":100615},[],"7 días.",{"_2837":58990,"_24687":58973,"_17267":100617,"_5":17162,"_23357":100568,"_2365":46404},[],{"_2837":58991,"_24687":58973,"_17267":100619,"_5":17162,"_23357":100568,"_2365":100620},[],"Plazo desde la publicación que activa la renovación programada.",{"_2837":58992,"_24687":58973,"_17267":100622,"_5":17162,"_23357":100568,"_2365":100623},[],"6 días y 23 horas.",{"_2837":58993,"_24687":58973,"_17267":100625,"_5":17162,"_23357":100568,"_2365":46413},[],{"_2837":58994,"_24687":58973,"_17267":100627,"_5":17162,"_23357":100568,"_2365":100628},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2837":58995,"_24687":58973,"_17267":100630,"_5":17162,"_23357":100568,"_2365":46419},[],{"_2837":58996,"_24687":58973,"_17267":100632,"_5":17162,"_23357":100568,"_2365":46422},[],{"_2837":58997,"_24687":58973,"_17267":100634,"_5":17162,"_23357":100568,"_2365":100635},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2837":58998,"_24687":58973,"_17267":100637,"_5":17162,"_23357":100568,"_2365":100638},[],"SKI de la CA.",{"_2837":58999,"_24687":58973,"_17267":100640,"_5":17162,"_23357":100568,"_2365":100641},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2837":59000,"_24687":58973,"_17267":100643,"_5":17162,"_23357":100568,"_2365":100644},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2837":59001,"_24687":58973,"_17267":100646,"_5":17162,"_23357":100572,"_2365":100647},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2837":59002,"_24687":58973,"_17267":100649,"_5":17162,"_23357":100572,"_2365":100650},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2837":59003,"_24687":58973,"_17267":100652,"_5":17162,"_23357":100572,"_2365":100653},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2837":59004,"_24687":58973,"_17267":100655,"_5":17162,"_23357":100576,"_2365":100656},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2837":59005,"_24687":58973,"_17267":100658,"_5":17162,"_23357":100576,"_2365":100659},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2837":59006,"_24687":58973,"_17267":100661,"_5":17162,"_23357":100580,"_2365":100662},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2837":59007,"_24687":58973,"_17267":100664,"_5":17162,"_23357":100580,"_2365":100665},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2837":59008,"_24687":58973,"_17267":100667,"_5":17162,"_23357":100580,"_2365":100668},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2837":59009,"_24687":58973,"_17267":100670,"_5":17162,"_23357":100580,"_2365":100671},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2837":59010,"_24687":58973,"_17267":100673,"_5":17162,"_23357":100580,"_2365":100674},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2837":59011,"_24687":58973,"_17267":100676,"_5":17162,"_23357":100584,"_2365":100677},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2837":59012,"_24687":58973,"_17267":100679,"_5":17162,"_23357":100584,"_2365":97540},[],{"_2837":59013,"_24687":58973,"_17267":100681,"_5":17162,"_23357":100584,"_2365":100682},[],"Path relativo",{"_2837":59014,"_24687":58973,"_17267":100684,"_5":17162,"_23357":100584,"_2365":95705},[],{"_2837":59015,"_24687":58973,"_17267":100686,"_5":17162,"_23357":100584,"_2365":46477},[],{"_2837":59016,"_24687":58973,"_17267":100688,"_5":17162,"_23357":100584,"_2365":46480},[],{"_2837":59017,"_24687":58973,"_17267":100690,"_5":17162,"_23357":100584,"_2365":100691},[],"Consultar `crl_options` y `latest_crl`.",{"_2837":59018,"_24687":58973,"_17267":100693,"_5":17162,"_23357":100584,"_2365":46486},[],{"_2837":59019,"_24687":58973,"_17267":100695,"_5":17162,"_23357":100584,"_2365":46480},[],{"_2837":59020,"_24687":58973,"_17267":100697,"_5":17162,"_23357":100584,"_2365":100698},[],"Sustituir la configuración de CRL.",{"_2837":59021,"_24687":58973,"_17267":100700,"_5":17162,"_23357":100584,"_2365":100701},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2837":59022,"_24687":58973,"_17267":100703,"_5":17162,"_23357":100584,"_2365":100704},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2837":59023,"_24687":58973,"_17267":100706,"_5":17162,"_23357":100588,"_2365":100707},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2837":59024,"_24687":58973,"_17267":100709,"_5":17162,"_23357":100592,"_2365":100710},[],"RFC 5280: perfil X.509 y CRL.",{"_2837":59025,"_24687":58973,"_17267":100712,"_5":17162,"_23357":100592,"_2365":46506},[],{"_2837":59026,"_24687":58973,"_17267":100714,"_5":17162,"_23357":100592,"_2365":46509},[],{"_2837":59027,"_24687":58973,"_17267":100716,"_5":17162,"_23357":100592,"_2365":100717},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2837":59028,"_24687":58973,"_17267":100719,"_5":17162,"_23357":100592,"_2365":100720},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2837":59029,"_24687":59029,"_5":12136,"_2365":100722,"_25023":100723,"_17267":100724,"_23357":59029},"Claves y motores criptográficos",[40249,95914,45215,99433],[],{"_2837":59030,"_24687":59029,"_17267":100726,"_5":17162,"_23357":59029,"_2365":100727},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2837":59031,"_24687":59029,"_5":25020,"_17267":100729,"_23357":100730,"_2365":100731},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2837":59032,"_24687":59029,"_5":25020,"_17267":100733,"_23357":100734,"_2365":100735},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2837":59033,"_24687":59029,"_5":25020,"_17267":100737,"_23357":100738,"_2365":46534},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#file-system",{"_2837":59034,"_24687":59029,"_5":25020,"_17267":100740,"_23357":100741,"_2365":46538},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#hashicorp-vault",{"_2837":59035,"_24687":59029,"_5":25020,"_17267":100743,"_23357":100744,"_2365":46542},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#aws-secrets-manager",{"_2837":59036,"_24687":59029,"_5":25020,"_17267":100746,"_23357":100747,"_2365":46546},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#aws-kms",{"_2837":59037,"_24687":59029,"_5":25020,"_17267":100749,"_23357":100750,"_2365":46550},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#pkcs11",{"_2837":59038,"_24687":59029,"_5":25020,"_17267":100752,"_23357":100753,"_2365":46554},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#azure-key-vault",{"_2837":59039,"_24687":59029,"_5":25020,"_17267":100755,"_23357":100756,"_2365":100757},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2837":59040,"_24687":59029,"_5":25020,"_17267":100759,"_23357":100760,"_2365":100761},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2837":59041,"_24687":59029,"_5":25020,"_17267":100763,"_23357":100764,"_2365":100765},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2837":59042,"_24687":59029,"_5":25020,"_17267":100767,"_23357":100768,"_2365":100769},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2837":59043,"_24687":59029,"_5":25020,"_17267":100771,"_23357":100772,"_2365":100773},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2837":59044,"_24687":59029,"_5":25020,"_17267":100775,"_23357":100776,"_2365":100777},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2837":59045,"_24687":59029,"_5":25020,"_17267":100779,"_23357":100780,"_2365":100781},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2837":59046,"_24687":59029,"_5":25020,"_17267":100783,"_23357":100784,"_2365":46586},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#sign",{"_2837":59047,"_24687":59029,"_5":25020,"_17267":100786,"_23357":100787,"_2365":46590},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#verify",{"_2837":59048,"_24687":59029,"_5":25020,"_17267":100789,"_23357":100790,"_2365":100791},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2837":59049,"_24687":59029,"_5":25020,"_17267":100793,"_23357":100794,"_2365":100795},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2837":59050,"_24687":59029,"_5":25020,"_17267":100797,"_23357":100798,"_2365":100799},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2837":59051,"_24687":59029,"_17267":100801,"_5":17162,"_23357":59029,"_2365":100802},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2837":59052,"_24687":59029,"_17267":100804,"_5":17162,"_23357":59029,"_2365":100805},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2837":59053,"_24687":59029,"_17267":100807,"_5":17162,"_23357":100730,"_2365":100808},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2837":59054,"_24687":59029,"_17267":100810,"_5":17162,"_23357":100730,"_2365":100811},[],"En la práctica, permite:",{"_2837":59055,"_24687":59029,"_17267":100813,"_5":17162,"_23357":100730,"_2365":100814},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2837":59056,"_24687":59029,"_17267":100816,"_5":17162,"_23357":100730,"_2365":100817},[],"Importar claves creadas externamente.",{"_2837":59057,"_24687":59029,"_17267":100819,"_5":17162,"_23357":100730,"_2365":100820},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2837":59058,"_24687":59029,"_17267":100822,"_5":17162,"_23357":100730,"_2365":100823},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2837":59059,"_24687":59029,"_17267":100825,"_5":17162,"_23357":100734,"_2365":100826},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2837":59060,"_24687":59029,"_17267":100828,"_5":17162,"_23357":100734,"_2365":100829},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2837":59061,"_24687":59029,"_17267":100831,"_5":17162,"_23357":100734,"_2365":100832},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2837":59062,"_24687":59029,"_17267":100834,"_5":17162,"_23357":100738,"_2365":100835},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2837":59063,"_24687":59029,"_17267":100837,"_5":17162,"_23357":100741,"_2365":100838},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2837":59064,"_24687":59029,"_17267":100840,"_5":17162,"_23357":100744,"_2365":100841},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2837":59065,"_24687":59029,"_17267":100843,"_5":17162,"_23357":100747,"_2365":100844},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2837":59066,"_24687":59029,"_17267":100846,"_5":17162,"_23357":100750,"_2365":100847},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2837":59067,"_24687":59029,"_17267":100849,"_5":17162,"_23357":100753,"_2365":100850},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2837":59068,"_24687":59029,"_17267":100852,"_5":17162,"_23357":100753,"_2365":100853},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2837":59069,"_24687":59029,"_17267":100855,"_5":17162,"_23357":100753,"_2365":100856},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2837":59070,"_24687":59029,"_17267":100858,"_5":17162,"_23357":100753,"_2365":100859},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2837":59071,"_24687":59029,"_17267":100861,"_5":17162,"_23357":100756,"_2365":100862},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2837":59072,"_24687":59029,"_17267":100864,"_5":17162,"_23357":100756,"_2365":100865},[],"La tabla incluye los siguientes campos:",{"_2837":59073,"_24687":59029,"_17267":100867,"_5":17162,"_23357":100756,"_2365":100868},[],"**Name**: nombre descriptivo de la clave.",{"_2837":59074,"_24687":59029,"_17267":100870,"_5":17162,"_23357":100756,"_2365":100871},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2837":59075,"_24687":59029,"_17267":100873,"_5":17162,"_23357":100756,"_2365":100874},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2837":59076,"_24687":59029,"_17267":100876,"_5":17162,"_23357":100756,"_2365":100877},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2837":59077,"_24687":59029,"_17267":100879,"_5":17162,"_23357":100756,"_2365":100880},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2837":59078,"_24687":59029,"_17267":100882,"_5":17162,"_23357":100756,"_2365":100883},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2837":59079,"_24687":59029,"_17267":100885,"_5":17162,"_23357":100756,"_2365":100886},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2837":59080,"_24687":59029,"_17267":100888,"_5":17162,"_23357":100756,"_2365":100889},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2837":59081,"_24687":59029,"_17267":100891,"_5":17162,"_23357":100756,"_2365":100892},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2837":59082,"_24687":59029,"_17267":100894,"_5":17162,"_23357":100756,"_2365":100895},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2837":59083,"_24687":59029,"_17267":100897,"_5":17162,"_23357":100756,"_2365":100898},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2837":59084,"_24687":59029,"_17267":100900,"_5":17162,"_23357":100756,"_2365":100901},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2837":59085,"_24687":59029,"_17267":100903,"_5":17162,"_23357":100756,"_2365":100904},[],"**Delete Key** para eliminar la clave del sistema.",{"_2837":59086,"_24687":59029,"_17267":100906,"_5":17162,"_23357":100760,"_2365":100907},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2837":59087,"_24687":59029,"_17267":100909,"_5":17162,"_23357":100764,"_2365":100910},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2837":59088,"_24687":59029,"_17267":100912,"_5":17162,"_23357":100764,"_2365":100913},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2837":59089,"_24687":59029,"_17267":100915,"_5":17162,"_23357":100764,"_2365":100916},[],"**Key Name**: nombre único y descriptivo.",{"_2837":59090,"_24687":59029,"_17267":100918,"_5":17162,"_23357":100764,"_2365":100919},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2837":59091,"_24687":59029,"_17267":100921,"_5":17162,"_23357":100764,"_2365":100922},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2837":59092,"_24687":59029,"_17267":100924,"_5":17162,"_23357":100764,"_2365":100925},[],"**Tags**: metadatos para clasificar la clave.",{"_2837":59093,"_24687":59029,"_17267":100927,"_5":17162,"_23357":100764,"_2365":100928},[],"**Metadata**: información adicional para usos avanzados.",{"_2837":59094,"_24687":59029,"_17267":100930,"_5":17162,"_23357":100768,"_2365":100931},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2837":59095,"_24687":59029,"_17267":100933,"_5":17162,"_23357":100768,"_2365":100934},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2837":59096,"_24687":59029,"_17267":100936,"_5":17162,"_23357":100768,"_2365":100937},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2837":59097,"_24687":59029,"_17267":100939,"_5":17162,"_23357":100768,"_2365":100940},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2837":59098,"_24687":59029,"_17267":100942,"_5":17162,"_23357":100768,"_2365":100943},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2837":59099,"_24687":59029,"_17267":100945,"_5":17162,"_23357":100768,"_2365":100946},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2837":59100,"_24687":59029,"_17267":100948,"_5":17162,"_23357":100768,"_2365":100949},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2837":59101,"_24687":59029,"_17267":100951,"_5":17162,"_23357":100768,"_2365":100952},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2837":59102,"_24687":59029,"_17267":100954,"_5":17162,"_23357":100768,"_2365":100955},[],"**Metadata**: información adicional opcional.",{"_2837":59103,"_24687":59029,"_17267":100957,"_5":17162,"_23357":100768,"_2365":100958},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2837":59104,"_24687":59029,"_17267":100960,"_5":17162,"_23357":100768,"_2365":100961},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2837":59105,"_24687":59029,"_17267":100963,"_5":17162,"_23357":100772,"_2365":100964},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2837":59106,"_24687":59029,"_17267":100966,"_5":17162,"_23357":100776,"_2365":100967},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2837":59107,"_24687":59029,"_17267":100969,"_5":17162,"_23357":100776,"_2365":100970},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2837":59108,"_24687":59029,"_17267":100972,"_5":17162,"_23357":100776,"_2365":100973},[],"**Key Name**: nombre descriptivo.",{"_2837":59109,"_24687":59029,"_17267":100975,"_5":17162,"_23357":100776,"_2365":100976},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2837":59110,"_24687":59029,"_17267":100978,"_5":17162,"_23357":100776,"_2365":100979},[],"**Tags**: etiquetas asociadas.",{"_2837":59111,"_24687":59029,"_17267":100981,"_5":17162,"_23357":100776,"_2365":100982},[],"**Aliases**: nombres alternativos.",{"_2837":59112,"_24687":59029,"_17267":100984,"_5":17162,"_23357":100776,"_2365":100985},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2837":59113,"_24687":59029,"_17267":100987,"_5":17162,"_23357":100776,"_2365":100988},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2837":59114,"_24687":59029,"_17267":100990,"_5":17162,"_23357":100776,"_2365":100991},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2837":59115,"_24687":59029,"_17267":100993,"_5":17162,"_23357":100776,"_2365":100994},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2837":59116,"_24687":59029,"_17267":100996,"_5":17162,"_23357":100780,"_2365":100997},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2837":59117,"_24687":59029,"_17267":100999,"_5":17162,"_23357":100780,"_2365":101000},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2837":59118,"_24687":59029,"_17267":101002,"_5":17162,"_23357":100780,"_2365":101003},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2837":59119,"_24687":59029,"_17267":101005,"_5":17162,"_23357":100784,"_2365":101006},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2837":59120,"_24687":59029,"_17267":101008,"_5":17162,"_23357":100784,"_2365":101009},[],"Campos principales:",{"_2837":59121,"_24687":59029,"_17267":101011,"_5":17162,"_23357":100784,"_2365":101012},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2837":59122,"_24687":59029,"_17267":101014,"_5":17162,"_23357":100784,"_2365":101015},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2837":59123,"_24687":59029,"_17267":101017,"_5":17162,"_23357":100784,"_2365":101018},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2837":59124,"_24687":59029,"_17267":101020,"_5":17162,"_23357":100784,"_2365":101021},[],"**Message**: contenido que se va a firmar.",{"_2837":59125,"_24687":59029,"_17267":101023,"_5":17162,"_23357":100784,"_2365":101024},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2837":59126,"_24687":59029,"_17267":101026,"_5":17162,"_23357":100787,"_2365":101027},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2837":59127,"_24687":59029,"_17267":101029,"_5":17162,"_23357":100787,"_2365":101009},[],{"_2837":59128,"_24687":59029,"_17267":101031,"_5":17162,"_23357":100787,"_2365":101032},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2837":59129,"_24687":59029,"_17267":101034,"_5":17162,"_23357":100787,"_2365":101035},[],"**Message Type**: `Raw` o `Digest`.",{"_2837":59130,"_24687":59029,"_17267":101037,"_5":17162,"_23357":100787,"_2365":101038},[],"**Payload Encoding**: codificación del mensaje.",{"_2837":59131,"_24687":59029,"_17267":101040,"_5":17162,"_23357":100787,"_2365":101041},[],"**Message**: mensaje original o hash.",{"_2837":59132,"_24687":59029,"_17267":101043,"_5":17162,"_23357":100787,"_2365":101044},[],"**Signature**: firma que se desea comprobar.",{"_2837":59133,"_24687":59029,"_17267":101046,"_5":17162,"_23357":100787,"_2365":101047},[],"**Result**: indicador del resultado de la validación.",{"_2837":59134,"_24687":59029,"_17267":101049,"_5":17162,"_23357":100790,"_2365":101050},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2837":59135,"_24687":59029,"_17267":101052,"_5":17162,"_23357":100790,"_2365":101053},[],"Este flujo es útil para:",{"_2837":59136,"_24687":59029,"_17267":101055,"_5":17162,"_23357":100790,"_2365":101056},[],"Solicitar certificados a una CA externa.",{"_2837":59137,"_24687":59029,"_17267":101058,"_5":17162,"_23357":100790,"_2365":101059},[],"Renovar una identidad manteniendo la misma clave.",{"_2837":59138,"_24687":59029,"_17267":101061,"_5":17162,"_23357":100790,"_2365":101062},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2837":59139,"_24687":59029,"_17267":101064,"_5":17162,"_23357":100790,"_2365":101065},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2837":59140,"_24687":59029,"_17267":101067,"_5":17162,"_23357":100790,"_2365":101068},[],"**Organization (O)**: organización o empresa.",{"_2837":59141,"_24687":59029,"_17267":101070,"_5":17162,"_23357":100790,"_2365":101071},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2837":59142,"_24687":59029,"_17267":101073,"_5":17162,"_23357":100790,"_2365":101074},[],"**Country (C)**: código de país de dos letras.",{"_2837":59143,"_24687":59029,"_17267":101076,"_5":17162,"_23357":100790,"_2365":101077},[],"**State / Province (ST)**: estado o provincia.",{"_2837":59144,"_24687":59029,"_17267":101079,"_5":17162,"_23357":100790,"_2365":101080},[],"**Locality (L)**: ciudad o localidad.",{"_2837":59145,"_24687":59029,"_17267":101082,"_5":17162,"_23357":100790,"_2365":101083},[],"**Email Address**: correo de contacto.",{"_2837":59146,"_24687":59029,"_17267":101085,"_5":17162,"_23357":100790,"_2365":101086},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2837":59147,"_24687":59029,"_17267":101088,"_5":17162,"_23357":100790,"_2365":101089},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2837":59148,"_24687":59029,"_17267":101091,"_5":17162,"_23357":100794,"_2365":101092},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2837":59149,"_24687":59029,"_17267":101094,"_5":17162,"_23357":100794,"_2365":46898},[],{"_2837":59150,"_24687":59029,"_17267":101096,"_5":17162,"_23357":100798,"_2365":101097},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2837":59151,"_24687":59151,"_5":12136,"_2365":101099,"_25023":101100,"_17267":101101,"_23357":59151},"Validación online con OCSP",[40249,95914,45215,100048],[],{"_2837":59152,"_24687":59151,"_17267":101103,"_5":17162,"_23357":59151,"_2365":101104},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2837":59153,"_24687":59151,"_5":25020,"_17267":101106,"_23357":101107,"_2365":101108},[],"/docs/pr-preview/pr-36/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2837":59154,"_24687":59151,"_5":25020,"_17267":101110,"_23357":101111,"_2365":101112},[],"/docs/pr-preview/pr-36/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2837":59155,"_24687":59151,"_5":25020,"_17267":101114,"_23357":101115,"_2365":101116},[],"/docs/pr-preview/pr-36/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2837":59156,"_24687":59151,"_5":25020,"_17267":101118,"_23357":101119,"_2365":101120},[],"/docs/pr-preview/pr-36/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2837":59157,"_24687":59151,"_5":25020,"_17267":101122,"_23357":101123,"_2365":101124},[],"/docs/pr-preview/pr-36/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2837":59158,"_24687":59151,"_5":25020,"_17267":101126,"_23357":101127,"_2365":100593},[],"/docs/pr-preview/pr-36/es/platform/pki/ocsp#referencias",{"_2837":59159,"_24687":59151,"_17267":101129,"_5":17162,"_23357":59151,"_2365":101130},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2837":59160,"_24687":59151,"_17267":101132,"_5":17162,"_23357":101107,"_2365":101133},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2837":59161,"_24687":59151,"_17267":101135,"_5":17162,"_23357":101107,"_2365":101136},[],"Estado del registro",{"_2837":59162,"_24687":59151,"_17267":101138,"_5":17162,"_23357":101107,"_2365":101139},[],"Respuesta firmada",{"_2837":59163,"_24687":59151,"_17267":101141,"_5":17162,"_23357":101107,"_2365":44393},[],{"_2837":59164,"_24687":59151,"_17267":101143,"_5":17162,"_23357":101107,"_2365":46948},[],{"_2837":59165,"_24687":59151,"_17267":101145,"_5":17162,"_23357":101107,"_2365":44410},[],{"_2837":59166,"_24687":59151,"_17267":101147,"_5":17162,"_23357":101107,"_2365":101148},[],"`Revoked`, con razón y fecha de revocación.",{"_2837":59167,"_24687":59151,"_17267":101150,"_5":17162,"_23357":101107,"_2365":101151},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2837":59168,"_24687":59151,"_17267":101153,"_5":17162,"_23357":101107,"_2365":101154},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2837":59169,"_24687":59151,"_17267":101156,"_5":17162,"_23357":101107,"_2365":101157},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2837":59170,"_24687":59151,"_17267":101159,"_5":17162,"_23357":101107,"_2365":101160},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2837":59171,"_24687":59151,"_17267":101162,"_5":17162,"_23357":101107,"_2365":101163},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2837":59172,"_24687":59151,"_17267":101165,"_5":17162,"_23357":101111,"_2365":101166},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2837":59173,"_24687":59151,"_17267":101168,"_5":17162,"_23357":101111,"_2365":101169},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2837":59174,"_24687":59151,"_17267":101171,"_5":17162,"_23357":101115,"_2365":101172},[],"El servicio acepta:",{"_2837":59175,"_24687":59151,"_17267":101174,"_5":17162,"_23357":101115,"_2365":97540},[],{"_2837":59176,"_24687":59151,"_17267":101176,"_5":17162,"_23357":101115,"_2365":101177},[],"Ruta del servicio VA",{"_2837":59177,"_24687":59151,"_17267":101179,"_5":17162,"_23357":101115,"_2365":101180},[],"Formato",{"_2837":59178,"_24687":59151,"_17267":101182,"_5":17162,"_23357":101115,"_2365":46988},[],{"_2837":59179,"_24687":59151,"_17267":101184,"_5":17162,"_23357":101115,"_2365":46991},[],{"_2837":59180,"_24687":59151,"_17267":101186,"_5":17162,"_23357":101115,"_2365":101187},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2837":59181,"_24687":59151,"_17267":101189,"_5":17162,"_23357":101115,"_2365":46477},[],{"_2837":59182,"_24687":59151,"_17267":101191,"_5":17162,"_23357":101115,"_2365":46999},[],{"_2837":59183,"_24687":59151,"_17267":101193,"_5":17162,"_23357":101115,"_2365":101194},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2837":59184,"_24687":59151,"_17267":101196,"_5":17162,"_23357":101115,"_2365":101197},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2837":59185,"_24687":59151,"_17267":101199,"_5":17162,"_23357":101119,"_2365":101200},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2837":59186,"_24687":59151,"_17267":101202,"_5":17162,"_23357":101119,"_2365":101203},[],"Genera la solicitud:",{"_2837":59187,"_24687":59151,"_17267":101205,"_5":17162,"_23357":101119,"_2365":101206},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2837":59188,"_24687":59151,"_17267":101208,"_5":17162,"_23357":101119,"_2365":101209},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2837":59189,"_24687":59151,"_17267":101211,"_5":17162,"_23357":101119,"_2365":101212},[],"Verifica el DER recibido:",{"_2837":59190,"_24687":59151,"_17267":101214,"_5":17162,"_23357":101119,"_2365":101215},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2837":59191,"_24687":59151,"_17267":101217,"_5":17162,"_23357":101123,"_2365":101218},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2837":59192,"_24687":59151,"_17267":101220,"_5":17162,"_23357":101123,"_2365":101221},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2837":59193,"_24687":59151,"_17267":101223,"_5":17162,"_23357":101127,"_2365":47032},[],{"_2837":59194,"_24687":59151,"_17267":101225,"_5":17162,"_23357":101127,"_2365":47035},[],{"_2837":59195,"_24687":59151,"_17267":101227,"_5":17162,"_23357":101127,"_2365":101228},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2837":59196,"_24687":59151,"_17267":101230,"_5":17162,"_23357":101127,"_2365":100720},[],{"_2837":59197,"_24687":59197,"_5":12136,"_2365":45215,"_25023":101232,"_17267":101233,"_23357":59197},[40249,95914,45215],[],{"_2837":59198,"_24687":59197,"_17267":101235,"_5":17162,"_23357":59197,"_2365":101236},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2837":59199,"_24687":59197,"_5":25020,"_17267":101238,"_23357":101239,"_2365":98757},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#empieza-aquí",{"_2837":59200,"_24687":59197,"_5":25020,"_17267":101241,"_23357":101242,"_2365":101243},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2837":59201,"_24687":59197,"_5":25020,"_17267":101245,"_23357":101246,"_2365":99279},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#capacidades-principales",{"_2837":59202,"_24687":59197,"_5":25020,"_17267":101248,"_23357":101249,"_2365":99283},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2837":59203,"_24687":59197,"_5":25020,"_17267":101251,"_23357":101252,"_2365":99287},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2837":59204,"_24687":59197,"_5":25020,"_17267":101254,"_23357":101255,"_2365":99291},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#emite-y-controla-certificados",{"_2837":59205,"_24687":59197,"_5":25020,"_17267":101257,"_23357":101258,"_2365":99299},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#publica-el-estado-de-validación",{"_2837":59206,"_24687":59197,"_5":25020,"_17267":101260,"_23357":101261,"_2365":101262},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2837":59207,"_24687":59197,"_5":25020,"_17267":101264,"_23357":101265,"_2365":100214},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#continúa",{"_2837":59208,"_24687":59197,"_17267":101267,"_5":17162,"_23357":59197,"_2365":101268},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2837":59209,"_24687":59197,"_17267":101270,"_5":17162,"_23357":101239,"_2365":101271},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2837":59210,"_24687":59197,"_17267":101273,"_5":17162,"_23357":101239,"_2365":101274},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2837":59211,"_24687":59197,"_17267":101276,"_5":17162,"_23357":101242,"_2365":101277},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2837":59212,"_24687":59197,"_17267":101279,"_5":17162,"_23357":101242,"_2365":101280},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2837":59213,"_24687":59197,"_17267":101282,"_5":17162,"_23357":101242,"_2365":101283},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2837":59214,"_24687":59197,"_17267":101285,"_5":17162,"_23357":101242,"_2365":101286},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2837":59215,"_24687":59197,"_17267":101288,"_5":17162,"_23357":101242,"_2365":101289},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2837":59216,"_24687":59197,"_17267":101291,"_5":17162,"_23357":101249,"_2365":101292},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2837":59217,"_24687":59197,"_17267":101294,"_5":17162,"_23357":101252,"_2365":101295},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2837":59218,"_24687":59197,"_17267":101297,"_5":17162,"_23357":101255,"_2365":101298},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2837":59219,"_24687":59197,"_17267":101300,"_5":17162,"_23357":101258,"_2365":101301},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2837":59220,"_24687":59197,"_17267":101303,"_5":17162,"_23357":101261,"_2365":101304},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2837":59221,"_24687":59197,"_17267":101306,"_5":17162,"_23357":101261,"_2365":101307},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2837":59222,"_24687":59197,"_17267":101309,"_5":17162,"_23357":101261,"_2365":101310},[],"su clave pública corresponda a la clave privada del cliente;",{"_2837":59223,"_24687":59197,"_17267":101312,"_5":17162,"_23357":101261,"_2365":101313},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2837":59224,"_24687":59197,"_17267":101315,"_5":17162,"_23357":101261,"_2365":101316},[],"sus fechas y usos permitan la operación;",{"_2837":59225,"_24687":59197,"_17267":101318,"_5":17162,"_23357":101261,"_2365":101319},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2837":59226,"_24687":59197,"_17267":101321,"_5":17162,"_23357":101261,"_2365":101322},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2837":59227,"_24687":59197,"_17267":101324,"_5":17162,"_23357":101265,"_2365":101325},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2837":59228,"_24687":59197,"_17267":101327,"_5":17162,"_23357":101265,"_2365":101328},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2837":59229,"_24687":59197,"_17267":101330,"_5":17162,"_23357":101265,"_2365":101331},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2837":59230,"_24687":59230,"_5":12136,"_2365":101333,"_25023":101334,"_17267":101335,"_23357":59230},"Crea tu primera CA",[40249,95914,45215,98881],[],{"_2837":59231,"_24687":59230,"_17267":101337,"_5":17162,"_23357":59230,"_2365":101338},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2837":59232,"_24687":59230,"_5":25020,"_17267":101340,"_23357":101341,"_2365":94615},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2837":59233,"_24687":59230,"_5":25020,"_17267":101343,"_23357":101344,"_2365":101345},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2837":59234,"_24687":59230,"_5":25020,"_17267":101347,"_23357":101348,"_2365":101349},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2837":59235,"_24687":59230,"_5":25020,"_17267":101351,"_23357":101352,"_2365":101353},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2837":59236,"_24687":59230,"_5":25020,"_17267":101355,"_23357":101356,"_2365":101357},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2837":59237,"_24687":59230,"_5":25020,"_17267":101359,"_23357":101360,"_2365":101361},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2837":59238,"_24687":59230,"_5":25020,"_17267":101363,"_23357":101364,"_2365":101365},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2837":59239,"_24687":59230,"_5":25020,"_17267":101367,"_23357":101368,"_2365":99129},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2837":59240,"_24687":59230,"_5":25020,"_17267":101370,"_23357":101371,"_2365":94639},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2837":59241,"_24687":59230,"_17267":101373,"_5":17162,"_23357":59230,"_2365":101374},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2837":59242,"_24687":59230,"_17267":101376,"_5":17162,"_23357":101341,"_2365":101377},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2837":59243,"_24687":59230,"_17267":101379,"_5":17162,"_23357":101341,"_2365":101380},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2837":59244,"_24687":59230,"_17267":101382,"_5":17162,"_23357":101341,"_2365":101383},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2837":59245,"_24687":59230,"_17267":101385,"_5":17162,"_23357":101341,"_2365":101386},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2837":59246,"_24687":59230,"_17267":101388,"_5":17162,"_23357":101344,"_2365":101389},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2837":59247,"_24687":59230,"_17267":101391,"_5":17162,"_23357":101344,"_2365":101392},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2837":59248,"_24687":59230,"_17267":101394,"_5":17162,"_23357":101348,"_2365":101395},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2837":59249,"_24687":59230,"_17267":101397,"_5":17162,"_23357":101348,"_2365":101398},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2837":59250,"_24687":59230,"_17267":101400,"_5":17162,"_23357":101352,"_2365":101401},[],"Selecciona **Root CA** y completa:",{"_2837":59251,"_24687":59230,"_17267":101403,"_5":17162,"_23357":101352,"_2365":47214},[],{"_2837":59252,"_24687":59230,"_17267":101405,"_5":17162,"_23357":101352,"_2365":101406},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2837":59253,"_24687":59230,"_17267":101408,"_5":17162,"_23357":101352,"_2365":101409},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2837":59254,"_24687":59230,"_17267":101411,"_5":17162,"_23357":101352,"_2365":101412},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2837":59255,"_24687":59230,"_17267":101414,"_5":17162,"_23357":101352,"_2365":101415},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2837":59256,"_24687":59230,"_17267":101417,"_5":17162,"_23357":101356,"_2365":101418},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2837":59257,"_24687":59230,"_17267":101420,"_5":17162,"_23357":101360,"_2365":101421},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2837":59258,"_24687":59230,"_17267":101423,"_5":17162,"_23357":101360,"_2365":101424},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2837":59259,"_24687":59230,"_17267":101426,"_5":17162,"_23357":101364,"_2365":101427},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2837":59260,"_24687":59230,"_17267":101429,"_5":17162,"_23357":101364,"_2365":101430},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2837":59261,"_24687":59230,"_17267":101432,"_5":17162,"_23357":101364,"_2365":101433},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2837":59262,"_24687":59230,"_17267":101435,"_5":17162,"_23357":101368,"_2365":101436},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2837":59263,"_24687":59230,"_17267":101438,"_5":17162,"_23357":101368,"_2365":101439},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2837":59264,"_24687":59230,"_17267":101441,"_5":17162,"_23357":101368,"_2365":101442},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2837":59265,"_24687":59230,"_17267":101444,"_5":17162,"_23357":101368,"_2365":101445},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2837":59266,"_24687":59230,"_17267":101447,"_5":17162,"_23357":101371,"_2365":101448},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2837":59267,"_24687":59267,"_5":12136,"_2365":101450,"_25023":101451,"_17267":101452,"_23357":59267},"Emite y verifica un certificado",[40249,95914,45215,98881],[],{"_2837":59268,"_24687":59267,"_17267":101454,"_5":17162,"_23357":59267,"_2365":101455},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2837":59269,"_24687":59267,"_5":25020,"_17267":101457,"_23357":101458,"_2365":94615},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2837":59270,"_24687":59267,"_5":25020,"_17267":101460,"_23357":101461,"_2365":101462},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2837":59271,"_24687":59267,"_5":25020,"_17267":101464,"_23357":101465,"_2365":101466},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2837":59272,"_24687":59267,"_5":25020,"_17267":101468,"_23357":101469,"_2365":101470},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2837":59273,"_24687":59267,"_5":25020,"_17267":101472,"_23357":101473,"_2365":101474},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2837":59274,"_24687":59267,"_5":25020,"_17267":101476,"_23357":101477,"_2365":101478},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2837":59275,"_24687":59267,"_5":25020,"_17267":101480,"_23357":101481,"_2365":101361},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2837":59276,"_24687":59267,"_5":25020,"_17267":101483,"_23357":101484,"_2365":101485},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2837":59277,"_24687":59267,"_5":25020,"_17267":101487,"_23357":101488,"_2365":101489},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2837":59278,"_24687":59267,"_5":25020,"_17267":101491,"_23357":101492,"_2365":101493},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2837":59279,"_24687":59267,"_5":25020,"_17267":101495,"_23357":101496,"_2365":99129},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2837":59280,"_24687":59267,"_5":25020,"_17267":101498,"_23357":101499,"_2365":94639},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2837":59281,"_24687":59267,"_17267":101501,"_5":17162,"_23357":59267,"_2365":101502},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2837":59282,"_24687":59267,"_17267":101504,"_5":17162,"_23357":101458,"_2365":101505},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2837":59283,"_24687":59267,"_17267":101507,"_5":17162,"_23357":101458,"_2365":101508},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2837":59284,"_24687":59267,"_17267":101510,"_5":17162,"_23357":101458,"_2365":101511},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2837":59285,"_24687":59267,"_17267":101513,"_5":17162,"_23357":101458,"_2365":101514},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2837":59286,"_24687":59267,"_17267":101516,"_5":17162,"_23357":101458,"_2365":101517},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2837":59287,"_24687":59267,"_17267":101519,"_5":17162,"_23357":101461,"_2365":101520},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2837":59288,"_24687":59267,"_17267":101522,"_5":17162,"_23357":101465,"_2365":101523},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2837":59289,"_24687":59267,"_17267":101525,"_5":17162,"_23357":101465,"_2365":101526},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2837":59290,"_24687":59267,"_17267":101528,"_5":17162,"_23357":101469,"_2365":101529},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2837":59291,"_24687":59267,"_17267":101531,"_5":17162,"_23357":101469,"_2365":101532},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2837":59292,"_24687":59267,"_17267":101534,"_5":17162,"_23357":101473,"_2365":101535},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2837":59293,"_24687":59267,"_17267":101537,"_5":17162,"_23357":101473,"_2365":101538},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2837":59294,"_24687":59267,"_17267":101540,"_5":17162,"_23357":101477,"_2365":101541},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2837":59295,"_24687":59267,"_17267":101543,"_5":17162,"_23357":101481,"_2365":101544},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2837":59296,"_24687":59267,"_17267":101546,"_5":17162,"_23357":101484,"_2365":101547},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2837":59297,"_24687":59267,"_17267":101549,"_5":17162,"_23357":101488,"_2365":101550},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2837":59298,"_24687":59267,"_17267":101552,"_5":17162,"_23357":101488,"_2365":101553},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2837":59299,"_24687":59267,"_17267":101555,"_5":17162,"_23357":101488,"_2365":101556},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2837":59300,"_24687":59267,"_17267":101558,"_5":17162,"_23357":101492,"_2365":101559},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2837":59301,"_24687":59267,"_17267":101561,"_5":17162,"_23357":101492,"_2365":101562},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2837":59302,"_24687":59267,"_17267":101564,"_5":17162,"_23357":101492,"_2365":101565},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2837":59303,"_24687":59267,"_17267":101567,"_5":17162,"_23357":101496,"_2365":99212},[],{"_2837":59304,"_24687":59267,"_17267":101569,"_5":17162,"_23357":101496,"_2365":97989},[],{"_2837":59305,"_24687":59267,"_17267":101571,"_5":17162,"_23357":101496,"_2365":101572},[],"La CA rechaza la emisión",{"_2837":59306,"_24687":59267,"_17267":101574,"_5":17162,"_23357":101496,"_2365":101575},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2837":59307,"_24687":59267,"_17267":101577,"_5":17162,"_23357":101496,"_2365":101578},[],"Sujeto o usos diferentes",{"_2837":59308,"_24687":59267,"_17267":101580,"_5":17162,"_23357":101496,"_2365":101581},[],"Perfil aplicado y valores solicitados.",{"_2837":59309,"_24687":59267,"_17267":101583,"_5":17162,"_23357":101496,"_2365":101584},[],"No se encuentra el emisor",{"_2837":59310,"_24687":59267,"_17267":101586,"_5":17162,"_23357":101496,"_2365":101587},[],"CA descargada y cadena intermedia necesaria.",{"_2837":59311,"_24687":59267,"_17267":101589,"_5":17162,"_23357":101496,"_2365":101590},[],"Falla la vigencia",{"_2837":59312,"_24687":59267,"_17267":101592,"_5":17162,"_23357":101496,"_2365":101593},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2837":59313,"_24687":59267,"_17267":101595,"_5":17162,"_23357":101496,"_2365":101596},[],"Los resúmenes de clave difieren",{"_2837":59314,"_24687":59267,"_17267":101598,"_5":17162,"_23357":101496,"_2365":101599},[],"Archivos de certificado y clave de la misma emisión.",{"_2837":59315,"_24687":59267,"_17267":101601,"_5":17162,"_23357":101496,"_2365":101602},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2837":59316,"_24687":59267,"_17267":101604,"_5":17162,"_23357":101499,"_2365":101605},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2837":59317,"_24687":59267,"_17267":101607,"_5":17162,"_23357":101499,"_2365":101608},[],"Gestionar certificados para inspección, estado y revocación.",{"_2837":59318,"_24687":59267,"_17267":101610,"_5":17162,"_23357":101499,"_2365":101611},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2837":59319,"_24687":59267,"_17267":101613,"_5":17162,"_23357":101499,"_2365":101614},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2837":59320,"_24687":59267,"_17267":101616,"_5":17162,"_23357":101499,"_2365":101617},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2837":59321,"_24687":59321,"_5":12136,"_2365":101619,"_25023":101620,"_17267":101621,"_23357":59321},"Primeros pasos de PKI",[40249,95914,45215,98881],[],{"_2837":59322,"_24687":59321,"_17267":101623,"_5":17162,"_23357":59321,"_2365":101624},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2837":59323,"_24687":59321,"_5":25020,"_17267":101626,"_23357":101627,"_2365":94615},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2837":59324,"_24687":59321,"_5":25020,"_17267":101629,"_23357":101630,"_2365":101631},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2837":59325,"_24687":59321,"_5":25020,"_17267":101633,"_23357":101634,"_2365":99063},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2837":59326,"_24687":59321,"_5":25020,"_17267":101636,"_23357":101637,"_2365":101638},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2837":59327,"_24687":59321,"_17267":101640,"_5":17162,"_23357":59321,"_2365":101641},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2837":59328,"_24687":59321,"_17267":101643,"_5":17162,"_23357":101627,"_2365":101644},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2837":59329,"_24687":59321,"_17267":101646,"_5":17162,"_23357":101627,"_2365":101647},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2837":59330,"_24687":59321,"_17267":101649,"_5":17162,"_23357":101627,"_2365":101650},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2837":59331,"_24687":59321,"_17267":101652,"_5":17162,"_23357":101627,"_2365":101653},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2837":59332,"_24687":59321,"_17267":101655,"_5":17162,"_23357":101627,"_2365":101656},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2837":59333,"_24687":59321,"_17267":101658,"_5":17162,"_23357":101630,"_2365":101659},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2837":59334,"_24687":59321,"_17267":101661,"_5":17162,"_23357":101630,"_2365":101662},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2837":59335,"_24687":59321,"_17267":101664,"_5":17162,"_23357":101630,"_2365":101665},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2837":59336,"_24687":59321,"_17267":101667,"_5":17162,"_23357":101630,"_2365":101668},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2837":59337,"_24687":59321,"_17267":101670,"_5":17162,"_23357":101634,"_2365":101671},[],"Archivo o recurso",{"_2837":59338,"_24687":59321,"_17267":101673,"_5":17162,"_23357":101634,"_2365":99060},[],{"_2837":59339,"_24687":59321,"_17267":101675,"_5":17162,"_23357":101634,"_2365":101676},[],"CA raíz activa y `ca.pem`",{"_2837":59340,"_24687":59321,"_17267":101678,"_5":17162,"_23357":101634,"_2365":101679},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2837":59341,"_24687":59321,"_17267":101681,"_5":17162,"_23357":101634,"_2365":101682},[],"Certificado final y `device.crt`",{"_2837":59342,"_24687":59321,"_17267":101684,"_5":17162,"_23357":101634,"_2365":101685},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2837":59343,"_24687":59321,"_17267":101687,"_5":17162,"_23357":101634,"_2365":101688},[],"Clave privada `device.key`",{"_2837":59344,"_24687":59321,"_17267":101690,"_5":17162,"_23357":101634,"_2365":101691},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2837":59345,"_24687":59321,"_17267":101693,"_5":17162,"_23357":101634,"_2365":101694},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2837":59346,"_24687":59321,"_17267":101696,"_5":17162,"_23357":101637,"_2365":101697},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2837":59347,"_24687":59321,"_17267":101699,"_5":17162,"_23357":101637,"_2365":101700},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2837":59348,"_24687":59321,"_17267":101702,"_5":17162,"_23357":101637,"_2365":101703},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2837":59349,"_24687":59349,"_5":12136,"_2365":101705,"_25023":101706,"_17267":101708,"_23357":59349},"Resolución de problemas PKI",[40249,95914,45215,101707],"Resolución de problemas",[],{"_2837":59350,"_24687":59349,"_17267":101710,"_5":17162,"_23357":59349,"_2365":101711},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2837":59351,"_24687":59349,"_5":25020,"_17267":101713,"_23357":101714,"_2365":101715},[],"/docs/pr-preview/pr-36/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2837":59352,"_24687":59349,"_5":25020,"_17267":101717,"_23357":101718,"_2365":101719},[],"/docs/pr-preview/pr-36/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2837":59353,"_24687":59349,"_5":25020,"_17267":101721,"_23357":101722,"_2365":101723},[],"/docs/pr-preview/pr-36/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2837":59354,"_24687":59349,"_17267":101725,"_5":17162,"_23357":59349,"_2365":101726},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2837":59355,"_24687":59349,"_17267":101728,"_5":17162,"_23357":59349,"_2365":101729},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2837":59356,"_24687":59349,"_17267":101731,"_5":17162,"_23357":101714,"_2365":99060},[],{"_2837":59357,"_24687":59349,"_17267":101733,"_5":17162,"_23357":101714,"_2365":97989},[],{"_2837":59358,"_24687":59349,"_17267":101735,"_5":17162,"_23357":101714,"_2365":94639},[],{"_2837":59359,"_24687":59349,"_17267":101737,"_5":17162,"_23357":101714,"_2365":47550},[],{"_2837":59360,"_24687":59349,"_17267":101739,"_5":17162,"_23357":101714,"_2365":101740},[],"Existe, está activa y sus fechas son utilizables.",{"_2837":59361,"_24687":59349,"_17267":101742,"_5":17162,"_23357":101714,"_2365":101743},[],"Autoridades.",{"_2837":59362,"_24687":59349,"_17267":101745,"_5":17162,"_23357":101714,"_2365":101746},[],"Clave",{"_2837":59363,"_24687":59349,"_17267":101748,"_5":17162,"_23357":101714,"_2365":101749},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2837":59364,"_24687":59349,"_17267":101751,"_5":17162,"_23357":101714,"_2365":101752},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2837":59365,"_24687":59349,"_17267":101754,"_5":17162,"_23357":101714,"_2365":47568},[],{"_2837":59366,"_24687":59349,"_17267":101756,"_5":17162,"_23357":101714,"_2365":101757},[],"PEM correcto y firma verificable.",{"_2837":59367,"_24687":59349,"_17267":101759,"_5":17162,"_23357":101714,"_2365":47574},[],{"_2837":59368,"_24687":59349,"_17267":101761,"_5":17162,"_23357":101714,"_2365":101762},[],"Perfil",{"_2837":59369,"_24687":59349,"_17267":101764,"_5":17162,"_23357":101714,"_2365":101765},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2837":59370,"_24687":59349,"_17267":101767,"_5":17162,"_23357":101714,"_2365":101768},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2837":59371,"_24687":59349,"_17267":101770,"_5":17162,"_23357":101714,"_2365":99212},[],{"_2837":59372,"_24687":59349,"_17267":101772,"_5":17162,"_23357":101714,"_2365":101773},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2837":59373,"_24687":59349,"_17267":101775,"_5":17162,"_23357":101714,"_2365":101776},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2837":59374,"_24687":59349,"_17267":101778,"_5":17162,"_23357":101714,"_2365":101779},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2837":59375,"_24687":59349,"_17267":101781,"_5":17162,"_23357":101714,"_2365":101782},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2837":59376,"_24687":59349,"_17267":101784,"_5":17162,"_23357":101718,"_2365":101785},[],"Revisa cada frontera por separado:",{"_2837":59377,"_24687":59349,"_17267":101787,"_5":17162,"_23357":101718,"_2365":101788},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2837":59378,"_24687":59349,"_17267":101790,"_5":17162,"_23357":101718,"_2365":101791},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2837":59379,"_24687":59349,"_17267":101793,"_5":17162,"_23357":101718,"_2365":101794},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2837":59380,"_24687":59349,"_17267":101796,"_5":17162,"_23357":101718,"_2365":101797},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2837":59381,"_24687":59349,"_17267":101799,"_5":17162,"_23357":101718,"_2365":101800},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2837":59382,"_24687":59349,"_17267":101802,"_5":17162,"_23357":101718,"_2365":101803},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2837":59383,"_24687":59349,"_17267":101805,"_5":17162,"_23357":101722,"_2365":101806},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2837":59384,"_24687":59349,"_17267":101808,"_5":17162,"_23357":101722,"_2365":101809},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_47628":101811,"_47630":101812,"_47632":101813,"_47634":101814,"_15009":2387,"_57033":2387},"spanish",[2365,24687,5,23357],{"_2365":20592,"_24687":20592,"_5":20592,"_23357":20592},{"_2365":101815,"_24687":104163,"_5":106511,"_23357":108859},{"_3781":101816,"_47638":101817,"_5":20592},{"_11899":17457,"_12219":2630,"_12226":11625,"_23911":4728,"_23476":6144,"_16390":5635,"_11920":4199,"_11927":3763,"_23873":5253,"_24217":4463,"_24238":3765,"_23886":3902,"_28467":5696,"_24249":2507,"_28472":5050,"_28475":24366,"_28