01665,"_33050":101668,"_33052":101671,"_33054":101673,"_33056":101676,"_33058":101679,"_33060":101682,"_33062":101685,"_33064":101688,"_33066":101691,"_33068":101694,"_33070":101697,"_33072":101700,"_33074":101703,"_33076":101708,"_33078":101711,"_33080":101715,"_33082":101719,"_33084":101723,"_33086":101726,"_33088":101729,"_33090":101731,"_33092":101733,"_33094":101735,"_33096":101737,"_33098":101740,"_33100":101743,"_33102":101746,"_33104":101749,"_33106":101752,"_33108":101754,"_33110":101757,"_33112":101759,"_33114":101762,"_33116":101765,"_33118":101768,"_33120":101770,"_33122":101773,"_33124":101776,"_33126":101779,"_33128":101782,"_33130":101785,"_33132":101788,"_33134":101791,"_33136":101794,"_33138":101797,"_33140":101800,"_33142":101803,"_33144":101806},{"_2837":57050,"_24697":57050,"_5":12136,"_2365":94603,"_25033":94604,"_17272":94607,"_23367":57050},"Despliega desde AWS Marketplace",[40259,94605,94606],"Despliegue","Otros modelos",[],{"_2837":57051,"_24697":57050,"_17272":94609,"_5":17167,"_23367":57050,"_2365":94610},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2837":57052,"_24697":57050,"_5":25030,"_17272":94612,"_23367":94613,"_2365":94614},[],"/docs/pr-preview/pr-36/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2837":57053,"_24697":57050,"_5":25030,"_17272":94616,"_23367":94617,"_2365":94618},[],"/docs/pr-preview/pr-36/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2837":57054,"_24697":57050,"_5":25030,"_17272":94620,"_23367":94621,"_2365":94622},[],"/docs/pr-preview/pr-36/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2837":57055,"_24697":57050,"_5":25030,"_17272":94624,"_23367":94625,"_2365":94626},[],"/docs/pr-preview/pr-36/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2837":57056,"_24697":57050,"_5":25030,"_17272":94628,"_23367":94629,"_2365":94630},[],"/docs/pr-preview/pr-36/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2837":57057,"_24697":57050,"_5":25030,"_17272":94632,"_23367":94633,"_2365":94634},[],"/docs/pr-preview/pr-36/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2837":57058,"_24697":57050,"_5":25030,"_17272":94636,"_23367":94637,"_2365":94638},[],"/docs/pr-preview/pr-36/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2837":57059,"_24697":57050,"_17272":94640,"_5":17167,"_23367":57050,"_2365":94641},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2837":57060,"_24697":57050,"_17272":94643,"_5":17167,"_23367":94613,"_2365":94644},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2837":57061,"_24697":57050,"_17272":94646,"_5":17167,"_23367":94613,"_2365":94647},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2837":57062,"_24697":57050,"_17272":94649,"_5":17167,"_23367":94613,"_2365":94650},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2837":57063,"_24697":57050,"_17272":94652,"_5":17167,"_23367":94617,"_2365":94653},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2837":57064,"_24697":57050,"_17272":94655,"_5":17167,"_23367":94617,"_2365":94656},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2837":57065,"_24697":57050,"_17272":94658,"_5":17167,"_23367":94617,"_2365":94659},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2837":57066,"_24697":57050,"_17272":94661,"_5":17167,"_23367":94621,"_2365":94662},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2837":57067,"_24697":57050,"_17272":94664,"_5":17167,"_23367":94625,"_2365":94665},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2837":57068,"_24697":57050,"_17272":94667,"_5":17167,"_23367":94629,"_2365":94668},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2837":57069,"_24697":57050,"_17272":94670,"_5":17167,"_23367":94633,"_2365":94671},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2837":57070,"_24697":57050,"_17272":94673,"_5":17167,"_23367":94637,"_2365":94674},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2837":57071,"_24697":57071,"_5":12136,"_2365":94676,"_25033":94677,"_17272":94678,"_23367":57071},"Despliega Lamassu",[40259,94605],[],{"_2837":57072,"_24697":57071,"_17272":94680,"_5":17167,"_23367":57071,"_2365":94681},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2837":57073,"_24697":57071,"_5":25030,"_17272":94683,"_23367":94684,"_2365":94685},[],"/docs/pr-preview/pr-36/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2837":57074,"_24697":57071,"_5":25030,"_17272":94687,"_23367":94688,"_2365":94689},[],"/docs/pr-preview/pr-36/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2837":57075,"_24697":57071,"_5":25030,"_17272":94691,"_23367":94692,"_2365":94693},[],"/docs/pr-preview/pr-36/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2837":57076,"_24697":57071,"_17272":94695,"_5":17167,"_23367":57071,"_2365":94696},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2837":57077,"_24697":57071,"_17272":94698,"_5":17167,"_23367":94684,"_2365":94699},[],"Modelo",{"_2837":57078,"_24697":57071,"_17272":94701,"_5":17167,"_23367":94684,"_2365":94702},[],"Recomendado para",{"_2837":57079,"_24697":57071,"_17272":94704,"_5":17167,"_23367":94684,"_2365":94705},[],"Quién opera la infraestructura",{"_2837":57080,"_24697":57071,"_17272":94707,"_5":17167,"_23367":94684,"_2365":94708},[],"Punto de partida",{"_2837":57081,"_24697":57071,"_17272":94710,"_5":17167,"_23367":94684,"_2365":40366},[],{"_2837":57082,"_24697":57071,"_17272":94712,"_5":17167,"_23367":94684,"_2365":94713},[],"Producción, entornos regulados y despliegues personalizados",{"_2837":57083,"_24697":57071,"_17272":94715,"_5":17167,"_23367":94684,"_2365":94716},[],"Tu equipo",{"_2837":57084,"_24697":57071,"_17272":94718,"_5":17167,"_23367":94684,"_2365":94719},[],"Helm o Fastlane",{"_2837":57085,"_24697":57071,"_17272":94721,"_5":17167,"_23367":94684,"_2365":40378},[],{"_2837":57086,"_24697":57071,"_17272":94723,"_5":17167,"_23367":94684,"_2365":94724},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2837":57087,"_24697":57071,"_17272":94726,"_5":17167,"_23367":94684,"_2365":94716},[],{"_2837":57088,"_24697":57071,"_17272":94728,"_5":17167,"_23367":94684,"_2365":94729},[],"Imagen preconfigurada en EC2",{"_2837":57089,"_24697":57071,"_17272":94731,"_5":17167,"_23367":94684,"_2365":40389},[],{"_2837":57090,"_24697":57071,"_17272":94733,"_5":17167,"_23367":94684,"_2365":94734},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2837":57091,"_24697":57071,"_17272":94736,"_5":17167,"_23367":94684,"_2365":40395},[],{"_2837":57092,"_24697":57071,"_17272":94738,"_5":17167,"_23367":94684,"_2365":94739},[],"Suscripción gestionada",{"_2837":57093,"_24697":57071,"_17272":94741,"_5":17167,"_23367":94684,"_2365":94742},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2837":57094,"_24697":57071,"_17272":94744,"_5":17167,"_23367":94684,"_2365":94745},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2837":57095,"_24697":57071,"_17272":94747,"_5":17167,"_23367":94684,"_2365":94748},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2837":57096,"_24697":57071,"_17272":94750,"_5":17167,"_23367":94688,"_2365":94751},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2837":57097,"_24697":57071,"_17272":94753,"_5":17167,"_23367":94692,"_2365":94754},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2837":57098,"_24697":57098,"_5":12136,"_2365":94756,"_25033":94757,"_17272":94758,"_23367":57098},"Utiliza Lamassu como SaaS",[40259,94605,94606],[],{"_2837":57099,"_24697":57098,"_17272":94760,"_5":17167,"_23367":57098,"_2365":94761},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2837":57100,"_24697":57098,"_5":25030,"_17272":94763,"_23367":94764,"_2365":94765},[],"/docs/pr-preview/pr-36/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2837":57101,"_24697":57098,"_5":25030,"_17272":94767,"_23367":94768,"_2365":94769},[],"/docs/pr-preview/pr-36/es/deployment/saas#planes","Planes",{"_2837":57102,"_24697":57098,"_5":25030,"_17272":94771,"_23367":94772,"_2365":94773},[],"/docs/pr-preview/pr-36/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2837":57103,"_24697":57098,"_17272":94775,"_5":17167,"_23367":57098,"_2365":94776},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2837":57104,"_24697":57098,"_17272":94778,"_5":17167,"_23367":94764,"_2365":94779},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2837":57105,"_24697":57098,"_17272":94781,"_5":17167,"_23367":94764,"_2365":94782},[],"Copias de seguridad automáticas.",{"_2837":57106,"_24697":57098,"_17272":94784,"_5":17167,"_23367":94764,"_2365":94785},[],"Actualizaciones de versión.",{"_2837":57107,"_24697":57098,"_17272":94787,"_5":17167,"_23367":94764,"_2365":94788},[],"Soporte técnico y SLA según el plan contratado.",{"_2837":57108,"_24697":57098,"_17272":94790,"_5":17167,"_23367":94768,"_2365":40450},[],{"_2837":57109,"_24697":57098,"_17272":94792,"_5":17167,"_23367":94768,"_2365":94793},[],"Dispositivos",{"_2837":57110,"_24697":57098,"_17272":94795,"_5":17167,"_23367":94768,"_2365":94796},[],"Soporte",{"_2837":57111,"_24697":57098,"_17272":94798,"_5":17167,"_23367":94768,"_2365":40459},[],{"_2837":57112,"_24697":57098,"_17272":94800,"_5":17167,"_23367":94768,"_2365":40462},[],{"_2837":57113,"_24697":57098,"_17272":94802,"_5":17167,"_23367":94768,"_2365":94803},[],"Hasta 1.000",{"_2837":57114,"_24697":57098,"_17272":94805,"_5":17167,"_23367":94768,"_2365":40468},[],{"_2837":57115,"_24697":57098,"_17272":94807,"_5":17167,"_23367":94768,"_2365":94808},[],"99,5 %",{"_2837":57116,"_24697":57098,"_17272":94810,"_5":17167,"_23367":94768,"_2365":40474},[],{"_2837":57117,"_24697":57098,"_17272":94812,"_5":17167,"_23367":94768,"_2365":94813},[],"Hasta 10.000",{"_2837":57118,"_24697":57098,"_17272":94815,"_5":17167,"_23367":94768,"_2365":94816},[],"Email y chat",{"_2837":57119,"_24697":57098,"_17272":94818,"_5":17167,"_23367":94768,"_2365":94819},[],"99,9 %",{"_2837":57120,"_24697":57098,"_17272":94821,"_5":17167,"_23367":94768,"_2365":40486},[],{"_2837":57121,"_24697":57098,"_17272":94823,"_5":17167,"_23367":94768,"_2365":94824},[],"Ilimitados",{"_2837":57122,"_24697":57098,"_17272":94826,"_5":17167,"_23367":94768,"_2365":94827},[],"Dedicado",{"_2837":57123,"_24697":57098,"_17272":94829,"_5":17167,"_23367":94768,"_2365":94830},[],"99,99 %",{"_2837":57124,"_24697":57098,"_17272":94832,"_5":17167,"_23367":94772,"_2365":94833},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2837":57125,"_24697":57098,"_17272":94835,"_5":17167,"_23367":94772,"_2365":94836},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2837":57126,"_24697":57126,"_5":12136,"_2365":40503,"_25033":94838,"_17272":94840,"_23367":57126},[40259,94605,94839],"Kubernetes autogestionado",[],{"_2837":57127,"_24697":57126,"_17272":94842,"_5":17167,"_23367":57126,"_2365":94843},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2837":57128,"_24697":57126,"_5":25030,"_17272":94845,"_23367":94846,"_2365":94847},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2837":57129,"_24697":57126,"_5":25030,"_17272":94849,"_23367":94850,"_2365":94851},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2837":57130,"_24697":57126,"_5":25030,"_17272":94853,"_23367":94854,"_2365":94855},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2837":57131,"_24697":57126,"_5":25030,"_17272":94857,"_23367":94858,"_2365":94859},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2837":57132,"_24697":57126,"_5":25030,"_17272":94861,"_23367":94862,"_2365":94863},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2837":57133,"_24697":57126,"_5":25030,"_17272":94865,"_23367":94866,"_2365":94867},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2837":57134,"_24697":57126,"_5":25030,"_17272":94869,"_23367":94870,"_2365":94871},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2837":57135,"_24697":57126,"_5":25030,"_17272":94873,"_23367":94874,"_2365":94875},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2837":57136,"_24697":57126,"_5":25030,"_17272":94877,"_23367":94878,"_2365":94879},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2837":57137,"_24697":57126,"_5":25030,"_17272":94881,"_23367":94882,"_2365":94883},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2837":57138,"_24697":57126,"_17272":94885,"_5":17167,"_23367":94846,"_2365":94886},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2837":57139,"_24697":57126,"_17272":94888,"_5":17167,"_23367":94846,"_2365":94889},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2837":57140,"_24697":57126,"_17272":94891,"_5":17167,"_23367":94850,"_2365":94892},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2837":57141,"_24697":57126,"_17272":94894,"_5":17167,"_23367":94850,"_2365":94895},[],"Fastlane instala o configura",{"_2837":57142,"_24697":57126,"_17272":94897,"_5":17167,"_23367":94850,"_2365":94898},[],"Tú sigues proporcionando",{"_2837":57143,"_24697":57126,"_17272":94900,"_5":17167,"_23367":94850,"_2365":94901},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2837":57144,"_24697":57126,"_17272":94903,"_5":17167,"_23367":94850,"_2365":94904},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2837":57145,"_24697":57126,"_17272":94906,"_5":17167,"_23367":94850,"_2365":94907},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2837":57146,"_24697":57126,"_17272":94909,"_5":17167,"_23367":94850,"_2365":94910},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2837":57147,"_24697":57126,"_17272":94912,"_5":17167,"_23367":94850,"_2365":94913},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2837":57148,"_24697":57126,"_17272":94915,"_5":17167,"_23367":94850,"_2365":94916},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2837":57149,"_24697":57126,"_17272":94918,"_5":17167,"_23367":94850,"_2365":94919},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2837":57150,"_24697":57126,"_17272":94921,"_5":17167,"_23367":94850,"_2365":94922},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2837":57151,"_24697":57126,"_17272":94924,"_5":17167,"_23367":94850,"_2365":94925},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2837":57152,"_24697":57126,"_17272":94927,"_5":17167,"_23367":94854,"_2365":94928},[],"Necesitas:",{"_2837":57153,"_24697":57126,"_17272":94930,"_5":17167,"_23367":94854,"_2365":94931},[],"un clúster Kubernetes existente",{"_2837":57154,"_24697":57126,"_17272":94933,"_5":17167,"_23367":94854,"_2365":94934},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2837":57155,"_24697":57126,"_17272":94936,"_5":17167,"_23367":94854,"_2365":40601},[],{"_2837":57156,"_24697":57126,"_17272":94938,"_5":17167,"_23367":94854,"_2365":19517},[],{"_2837":57157,"_24697":57126,"_17272":94940,"_5":17167,"_23367":94854,"_2365":94941},[],"`jq` solo si usas `--sample-data`",{"_2837":57158,"_24697":57126,"_17272":94943,"_5":17167,"_23367":94854,"_2365":94944},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2837":57159,"_24697":57126,"_17272":94946,"_5":17167,"_23367":94854,"_2365":94947},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2837":57160,"_24697":57126,"_17272":94949,"_5":17167,"_23367":94854,"_2365":94950},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2837":57161,"_24697":57126,"_17272":94952,"_5":17167,"_23367":94858,"_2365":94953},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2837":57162,"_24697":57126,"_17272":94955,"_5":17167,"_23367":94858,"_2365":94956},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2837":57163,"_24697":57126,"_17272":94958,"_5":17167,"_23367":94862,"_2365":94959},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2837":57164,"_24697":57126,"_17272":94961,"_5":17167,"_23367":94862,"_2365":94962},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2837":57165,"_24697":57126,"_17272":94964,"_5":17167,"_23367":94862,"_2365":94965},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2837":57166,"_24697":57126,"_17272":94967,"_5":17167,"_23367":94862,"_2365":94968},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2837":57167,"_24697":57126,"_17272":94970,"_5":17167,"_23367":94866,"_2365":94971},[],"Opción",{"_2837":57168,"_24697":57126,"_17272":94973,"_5":17167,"_23367":94866,"_2365":94974},[],"Valor predeterminado",{"_2837":57169,"_24697":57126,"_17272":94976,"_5":17167,"_23367":94866,"_2365":94977},[],"Propósito",{"_2837":57170,"_24697":57126,"_17272":94979,"_5":17167,"_23367":94866,"_2365":40645},[],{"_2837":57171,"_24697":57126,"_17272":94981,"_5":17167,"_23367":94866,"_2365":40648},[],{"_2837":57172,"_24697":57126,"_17272":94983,"_5":17167,"_23367":94866,"_2365":94984},[],"Muestra la ayuda",{"_2837":57173,"_24697":57126,"_17272":94986,"_5":17167,"_23367":94866,"_2365":40654},[],{"_2837":57174,"_24697":57126,"_17272":94988,"_5":17167,"_23367":94866,"_2365":94989},[],"contexto actual",{"_2837":57175,"_24697":57126,"_17272":94991,"_5":17167,"_23367":94866,"_2365":94992},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2837":57176,"_24697":57126,"_17272":94994,"_5":17167,"_23367":94866,"_2365":40663},[],{"_2837":57177,"_24697":57126,"_17272":94996,"_5":17167,"_23367":94866,"_2365":5300},[],{"_2837":57178,"_24697":57126,"_17272":94998,"_5":17167,"_23367":94866,"_2365":94999},[],"Omite prompts y genera credenciales para las dependencias",{"_2837":57179,"_24697":57126,"_17272":95001,"_5":17167,"_23367":94866,"_2365":40671},[],{"_2837":57180,"_24697":57126,"_17272":95003,"_5":17167,"_23367":94866,"_2365":40674},[],{"_2837":57181,"_24697":57126,"_17272":95005,"_5":17167,"_23367":94866,"_2365":95006},[],"Namespace de la instalación",{"_2837":57182,"_24697":57126,"_17272":95008,"_5":17167,"_23367":94866,"_2365":40680},[],{"_2837":57183,"_24697":57126,"_17272":95010,"_5":17167,"_23367":94866,"_2365":40683},[],{"_2837":57184,"_24697":57126,"_17272":95012,"_5":17167,"_23367":94866,"_2365":95013},[],"Dominio usado por la UI, OIDC y el certificado",{"_2837":57185,"_24697":57126,"_17272":95015,"_5":17167,"_23367":94866,"_2365":40689},[],{"_2837":57186,"_24697":57126,"_17272":95017,"_5":17167,"_23367":94866,"_2365":12357},[],{"_2837":57187,"_24697":57126,"_17272":95019,"_5":17167,"_23367":94866,"_2365":95020},[],"Versión del chart de Lamassu",{"_2837":57188,"_24697":57126,"_17272":95022,"_5":17167,"_23367":94866,"_2365":40697},[],{"_2837":57189,"_24697":57126,"_17272":95024,"_5":17167,"_23367":94866,"_2365":40700},[],{"_2837":57190,"_24697":57126,"_17272":95026,"_5":17167,"_23367":94866,"_2365":95027},[],"Puerto del listener HTTPS",{"_2837":57191,"_24697":57126,"_17272":95029,"_5":17167,"_23367":94866,"_2365":40706},[],{"_2837":57192,"_24697":57126,"_17272":95031,"_5":17167,"_23367":94866,"_2365":40709},[],{"_2837":57193,"_24697":57126,"_17272":95033,"_5":17167,"_23367":94866,"_2365":95034},[],"Puerto del listener HTTP",{"_2837":57194,"_24697":57126,"_17272":95036,"_5":17167,"_23367":94866,"_2365":40715},[],{"_2837":57195,"_24697":57126,"_17272":95038,"_5":17167,"_23367":94866,"_2365":40648},[],{"_2837":57196,"_24697":57126,"_17272":95040,"_5":17167,"_23367":94866,"_2365":95041},[],"Certificado PEM para TLS downstream",{"_2837":57197,"_24697":57126,"_17272":95043,"_5":17167,"_23367":94866,"_2365":40723},[],{"_2837":57198,"_24697":57126,"_17272":95045,"_5":17167,"_23367":94866,"_2365":40648},[],{"_2837":57199,"_24697":57126,"_17272":95047,"_5":17167,"_23367":94866,"_2365":95048},[],"Clave privada PEM para TLS downstream",{"_2837":57200,"_24697":57126,"_17272":95050,"_5":17167,"_23367":94866,"_2365":40731},[],{"_2837":57201,"_24697":57126,"_17272":95052,"_5":17167,"_23367":94866,"_2365":95053},[],"chart del repositorio",{"_2837":57202,"_24697":57126,"_17272":95055,"_5":17167,"_23367":94866,"_2365":95056},[],"Usa un chart local de Lamassu sin empaquetar",{"_2837":57203,"_24697":57126,"_17272":95058,"_5":17167,"_23367":94866,"_2365":40740},[],{"_2837":57204,"_24697":57126,"_17272":95060,"_5":17167,"_23367":94866,"_2365":95061},[],"detección automática",{"_2837":57205,"_24697":57126,"_17272":95063,"_5":17167,"_23367":94866,"_2365":95064},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2837":57206,"_24697":57126,"_17272":95066,"_5":17167,"_23367":94866,"_2365":40748},[],{"_2837":57207,"_24697":57126,"_17272":95068,"_5":17167,"_23367":94866,"_2365":5300},[],{"_2837":57208,"_24697":57126,"_17272":95070,"_5":17167,"_23367":94866,"_2365":95071},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2837":57209,"_24697":57126,"_17272":95073,"_5":17167,"_23367":94866,"_2365":40756},[],{"_2837":57210,"_24697":57126,"_17272":95075,"_5":17167,"_23367":94866,"_2365":5300},[],{"_2837":57211,"_24697":57126,"_17272":95077,"_5":17167,"_23367":94866,"_2365":95078},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2837":57212,"_24697":57126,"_17272":95080,"_5":17167,"_23367":94866,"_2365":40764},[],{"_2837":57213,"_24697":57126,"_17272":95082,"_5":17167,"_23367":94866,"_2365":5300},[],{"_2837":57214,"_24697":57126,"_17272":95084,"_5":17167,"_23367":94866,"_2365":95085},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2837":57215,"_24697":57126,"_17272":95087,"_5":17167,"_23367":94866,"_2365":40772},[],{"_2837":57216,"_24697":57126,"_17272":95089,"_5":17167,"_23367":94866,"_2365":40775},[],{"_2837":57217,"_24697":57126,"_17272":95091,"_5":17167,"_23367":94866,"_2365":95092},[],"Usa otro chart local de SoftHSM",{"_2837":57218,"_24697":57126,"_17272":95094,"_5":17167,"_23367":94866,"_2365":95095},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2837":57219,"_24697":57126,"_17272":95097,"_5":17167,"_23367":94870,"_2365":40784},[],{"_2837":57220,"_24697":57126,"_17272":95099,"_5":17167,"_23367":94870,"_2365":95100},[],"valida las herramientas locales y el clúster seleccionado",{"_2837":57221,"_24697":57126,"_17272":95102,"_5":17167,"_23367":94870,"_2365":95103},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2837":57222,"_24697":57126,"_17272":95105,"_5":17167,"_23367":94870,"_2365":95106},[],"crea el namespace",{"_2837":57223,"_24697":57126,"_17272":95108,"_5":17167,"_23367":94870,"_2365":95109},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2837":57224,"_24697":57126,"_17272":95111,"_5":17167,"_23367":94870,"_2365":95112},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2837":57225,"_24697":57126,"_17272":95114,"_5":17167,"_23367":94870,"_2365":95115},[],"instala RabbitMQ",{"_2837":57226,"_24697":57126,"_17272":95117,"_5":17167,"_23367":94870,"_2365":95118},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2837":57227,"_24697":57126,"_17272":95120,"_5":17167,"_23367":94870,"_2365":95121},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2837":57228,"_24697":57126,"_17272":95123,"_5":17167,"_23367":94870,"_2365":95124},[],"carga datos de ejemplo opcionalmente",{"_2837":57229,"_24697":57126,"_17272":95126,"_5":17167,"_23367":94870,"_2365":95127},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2837":57230,"_24697":57126,"_17272":95129,"_5":17167,"_23367":94874,"_2365":95130},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2837":57231,"_24697":57126,"_17272":95132,"_5":17167,"_23367":94874,"_2365":95133},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2837":57232,"_24697":57126,"_17272":95135,"_5":17167,"_23367":94878,"_2365":95136},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2837":57233,"_24697":57126,"_17272":95138,"_5":17167,"_23367":94878,"_2365":95139},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2837":57234,"_24697":57126,"_17272":95141,"_5":17167,"_23367":94878,"_2365":95142},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2837":57235,"_24697":57126,"_17272":95144,"_5":17167,"_23367":94882,"_2365":95145},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2837":57236,"_24697":57236,"_5":12136,"_2365":95147,"_25033":95148,"_17272":95149,"_23367":57236},"Instala con Helm",[40259,94605,94839],[],{"_2837":57237,"_24697":57236,"_17272":95151,"_5":17167,"_23367":57236,"_2365":95152},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2837":57238,"_24697":57236,"_5":25030,"_17272":95154,"_23367":95155,"_2365":95156},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2837":57239,"_24697":57236,"_5":25030,"_17272":95158,"_23367":95159,"_2365":94855},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2837":57240,"_24697":57236,"_5":25030,"_17272":95161,"_23367":95162,"_2365":95163},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2837":57241,"_24697":57236,"_5":25030,"_17272":95165,"_23367":95166,"_2365":95167},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2837":57242,"_24697":57236,"_5":25030,"_17272":95169,"_23367":95170,"_2365":95171},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2837":57243,"_24697":57236,"_5":25030,"_17272":95173,"_23367":95174,"_2365":95175},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2837":57244,"_24697":57236,"_5":25030,"_17272":95177,"_23367":95178,"_2365":95179},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2837":57245,"_24697":57236,"_5":25030,"_17272":95181,"_23367":95182,"_2365":95183},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2837":57246,"_24697":57236,"_5":25030,"_17272":95185,"_23367":95186,"_2365":95187},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2837":57247,"_24697":57236,"_17272":95189,"_5":17167,"_23367":95155,"_2365":95190},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2837":57248,"_24697":57236,"_17272":95192,"_5":17167,"_23367":95159,"_2365":95193},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2837":57249,"_24697":57236,"_17272":95195,"_5":17167,"_23367":95159,"_2365":95196},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2837":57250,"_24697":57236,"_17272":95198,"_5":17167,"_23367":95159,"_2365":95199},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2837":57251,"_24697":57236,"_17272":95201,"_5":17167,"_23367":95159,"_2365":95202},[],"un broker RabbitMQ accesible y sus credenciales",{"_2837":57252,"_24697":57236,"_17272":95204,"_5":17167,"_23367":95159,"_2365":95205},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2837":57253,"_24697":57236,"_17272":95207,"_5":17167,"_23367":95159,"_2365":95208},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2837":57254,"_24697":57236,"_17272":95210,"_5":17167,"_23367":95159,"_2365":95211},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2837":57255,"_24697":57236,"_17272":95213,"_5":17167,"_23367":95159,"_2365":95214},[],"una StorageClass y un diseño de tráfico externo",{"_2837":57256,"_24697":57236,"_17272":95216,"_5":17167,"_23367":95159,"_2365":95217},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2837":57257,"_24697":57236,"_17272":95219,"_5":17167,"_23367":95159,"_2365":95220},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2837":57258,"_24697":57236,"_17272":95222,"_5":17167,"_23367":95159,"_2365":95223},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2837":57259,"_24697":57236,"_17272":95225,"_5":17167,"_23367":95162,"_2365":95226},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2837":57260,"_24697":57236,"_17272":95228,"_5":17167,"_23367":95162,"_2365":95229},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2837":57261,"_24697":57236,"_17272":95231,"_5":17167,"_23367":95162,"_2365":95232},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2837":57262,"_24697":57236,"_17272":95234,"_5":17167,"_23367":95166,"_2365":95235},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2837":57263,"_24697":57236,"_17272":95237,"_5":17167,"_23367":95166,"_2365":95238},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2837":57264,"_24697":57236,"_17272":95240,"_5":17167,"_23367":95166,"_2365":95241},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2837":57265,"_24697":57236,"_17272":95243,"_5":17167,"_23367":95170,"_2365":95244},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2837":57266,"_24697":57236,"_17272":95246,"_5":17167,"_23367":95174,"_2365":95247},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2837":57267,"_24697":57236,"_17272":95249,"_5":17167,"_23367":95174,"_2365":95250},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2837":57268,"_24697":57236,"_17272":95252,"_5":17167,"_23367":95174,"_2365":95253},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2837":57269,"_24697":57236,"_17272":95255,"_5":17167,"_23367":95174,"_2365":95256},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2837":57270,"_24697":57236,"_17272":95258,"_5":17167,"_23367":95178,"_2365":95259},[],"Para instalar un checkout local:",{"_2837":57271,"_24697":57236,"_17272":95261,"_5":17167,"_23367":95182,"_2365":95262},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2837":57272,"_24697":57236,"_17272":95264,"_5":17167,"_23367":95182,"_2365":95265},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2837":57273,"_24697":57236,"_17272":95267,"_5":17167,"_23367":95186,"_2365":95268},[],"Antes de pasar a producción, revisa:",{"_2837":57274,"_24697":57236,"_17272":95270,"_5":17167,"_23367":95186,"_2365":95271},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2837":57275,"_24697":57236,"_17272":95273,"_5":17167,"_23367":95186,"_2365":95274},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2837":57276,"_24697":57236,"_17272":95276,"_5":17167,"_23367":95186,"_2365":95277},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2837":57277,"_24697":57236,"_17272":95279,"_5":17167,"_23367":95186,"_2365":95280},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2837":57278,"_24697":57236,"_17272":95282,"_5":17167,"_23367":95186,"_2365":95283},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2837":57279,"_24697":57236,"_17272":95285,"_5":17167,"_23367":95186,"_2365":95286},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2837":57280,"_24697":57236,"_17272":95288,"_5":17167,"_23367":95186,"_2365":95289},[],"SMTP, observabilidad y entrega de alertas",{"_2837":57281,"_24697":57236,"_17272":95291,"_5":17167,"_23367":95186,"_2365":95292},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2837":57282,"_24697":57236,"_17272":95294,"_5":17167,"_23367":95186,"_2365":95295},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2837":57283,"_24697":57283,"_5":12136,"_2365":95297,"_25033":95298,"_17272":95299,"_23367":57283},"Expón el Gateway",[40259,94605,94839],[],{"_2837":57284,"_24697":57283,"_17272":95301,"_5":17167,"_23367":57283,"_2365":95302},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2837":57285,"_24697":57283,"_5":25030,"_17272":95304,"_23367":95305,"_2365":95306},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2837":57286,"_24697":57283,"_5":25030,"_17272":95308,"_23367":95309,"_2365":95310},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2837":57287,"_24697":57283,"_5":25030,"_17272":95312,"_23367":95313,"_2365":95314},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2837":57288,"_24697":57283,"_5":25030,"_17272":95316,"_23367":95317,"_2365":41005},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#k3s",{"_2837":57289,"_24697":57283,"_5":25030,"_17272":95319,"_23367":95320,"_2365":95321},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2837":57290,"_24697":57283,"_5":25030,"_17272":95323,"_23367":95324,"_2365":95325},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2837":57291,"_24697":57283,"_5":25030,"_17272":95327,"_23367":95328,"_2365":95329},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2837":57292,"_24697":57283,"_5":25030,"_17272":95331,"_23367":95332,"_2365":95333},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2837":57293,"_24697":57283,"_5":25030,"_17272":95335,"_23367":95336,"_2365":95337},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2837":57294,"_24697":57283,"_17272":95339,"_5":17167,"_23367":95305,"_2365":95340},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2837":57295,"_24697":57283,"_17272":95342,"_5":17167,"_23367":95305,"_2365":95343},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2837":57296,"_24697":57283,"_17272":95345,"_5":17167,"_23367":95309,"_2365":95346},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2837":57297,"_24697":57283,"_17272":95348,"_5":17167,"_23367":95309,"_2365":95349},[],"Defínelo únicamente cuando:",{"_2837":57298,"_24697":57283,"_17272":95351,"_5":17167,"_23367":95309,"_2365":95352},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2837":57299,"_24697":57283,"_17272":95354,"_5":17167,"_23367":95309,"_2365":95355},[],"esa dirección está asignada a este Gateway",{"_2837":57300,"_24697":57283,"_17272":95357,"_5":17167,"_23367":95309,"_2365":95358},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2837":57301,"_24697":57283,"_17272":95360,"_5":17167,"_23367":95309,"_2365":95361},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2837":57302,"_24697":57283,"_17272":95363,"_5":17167,"_23367":95309,"_2365":95364},[],"No confundas estos valores:",{"_2837":57303,"_24697":57283,"_17272":95366,"_5":17167,"_23367":95309,"_2365":95367},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2837":57304,"_24697":57283,"_17272":95369,"_5":17167,"_23367":95309,"_2365":95370},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2837":57305,"_24697":57283,"_17272":95372,"_5":17167,"_23367":95309,"_2365":95373},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2837":57306,"_24697":57283,"_17272":95375,"_5":17167,"_23367":95313,"_2365":95376},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2837":57307,"_24697":57283,"_17272":95378,"_5":17167,"_23367":95313,"_2365":95379},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2837":57308,"_24697":57283,"_17272":95381,"_5":17167,"_23367":95317,"_2365":95382},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2837":57309,"_24697":57283,"_17272":95384,"_5":17167,"_23367":95317,"_2365":95385},[],"Para el diseño recomendado:",{"_2837":57310,"_24697":57283,"_17272":95387,"_5":17167,"_23367":95317,"_2365":95388},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2837":57311,"_24697":57283,"_17272":95390,"_5":17167,"_23367":95317,"_2365":95391},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2837":57312,"_24697":57283,"_17272":95393,"_5":17167,"_23367":95317,"_2365":95394},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2837":57313,"_24697":57283,"_17272":95396,"_5":17167,"_23367":95317,"_2365":95397},[],"Apunta DNS a la dirección accesible de la VM.",{"_2837":57314,"_24697":57283,"_17272":95399,"_5":17167,"_23367":95317,"_2365":95400},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2837":57315,"_24697":57283,"_17272":95402,"_5":17167,"_23367":95320,"_2365":95403},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2837":57316,"_24697":57283,"_17272":95405,"_5":17167,"_23367":95324,"_2365":95406},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2837":57317,"_24697":57283,"_17272":95408,"_5":17167,"_23367":95324,"_2365":95409},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2837":57318,"_24697":57283,"_17272":95411,"_5":17167,"_23367":95328,"_2365":95412},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2837":57319,"_24697":57283,"_17272":95414,"_5":17167,"_23367":95328,"_2365":95415},[],"Requisito",{"_2837":57320,"_24697":57283,"_17272":95417,"_5":17167,"_23367":95328,"_2365":95418},[],"Diseño recomendado",{"_2837":57321,"_24697":57283,"_17272":95420,"_5":17167,"_23367":95328,"_2365":95421},[],"Consecuencia",{"_2837":57322,"_24697":57283,"_17272":95423,"_5":17167,"_23367":95328,"_2365":95424},[],"Varias URL o servicios de Lamassu",{"_2837":57323,"_24697":57283,"_17272":95426,"_5":17167,"_23367":95328,"_2365":95427},[],"Un Gateway con varias rutas",{"_2837":57324,"_24697":57283,"_17272":95429,"_5":17167,"_23367":95328,"_2365":95430},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2837":57325,"_24697":57283,"_17272":95432,"_5":17167,"_23367":95328,"_2365":95433},[],"Gateways independientes e IP externas distintas",{"_2837":57326,"_24697":57283,"_17272":95435,"_5":17167,"_23367":95328,"_2365":95436},[],"Una VIP por Gateway",{"_2837":57327,"_24697":57283,"_17272":95438,"_5":17167,"_23367":95328,"_2365":95439},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2837":57328,"_24697":57283,"_17272":95441,"_5":17167,"_23367":95328,"_2365":95442},[],"Gateways independientes, un nodo y una IP",{"_2837":57329,"_24697":57283,"_17272":95444,"_5":17167,"_23367":95328,"_2365":95445},[],"Puertos externos diferentes",{"_2837":57330,"_24697":57283,"_17272":95447,"_5":17167,"_23367":95328,"_2365":95448},[],"Los clientes deben indicar puertos no estándar",{"_2837":57331,"_24697":57283,"_17272":95450,"_5":17167,"_23367":95328,"_2365":95451},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2837":57332,"_24697":57283,"_17272":95453,"_5":17167,"_23367":95328,"_2365":95454},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2837":57333,"_24697":57283,"_17272":95456,"_5":17167,"_23367":95328,"_2365":95457},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2837":57334,"_24697":57283,"_17272":95459,"_5":17167,"_23367":95328,"_2365":95460},[],"Recursos Gateway separados pero proxy compartido",{"_2837":57335,"_24697":57283,"_17272":95462,"_5":17167,"_23367":95328,"_2365":95463},[],"Modo merged Gateway de Envoy",{"_2837":57336,"_24697":57283,"_17272":95465,"_5":17167,"_23367":95328,"_2365":95466},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2837":57337,"_24697":57283,"_17272":95468,"_5":17167,"_23367":95328,"_2365":95469},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2837":57338,"_24697":57283,"_17272":95471,"_5":17167,"_23367":95328,"_2365":95472},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2837":57339,"_24697":57283,"_17272":95474,"_5":17167,"_23367":95328,"_2365":95475},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2837":57340,"_24697":57283,"_17272":95477,"_5":17167,"_23367":95328,"_2365":95478},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2837":57341,"_24697":57283,"_17272":95480,"_5":17167,"_23367":95332,"_2365":95481},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2837":57342,"_24697":57283,"_17272":95483,"_5":17167,"_23367":95332,"_2365":95484},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2837":57343,"_24697":57283,"_17272":95486,"_5":17167,"_23367":95332,"_2365":95487},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2837":57344,"_24697":57283,"_17272":95489,"_5":17167,"_23367":95332,"_2365":95490},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2837":57345,"_24697":57283,"_17272":95492,"_5":17167,"_23367":95332,"_2365":95493},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2837":57346,"_24697":57283,"_17272":95495,"_5":17167,"_23367":95336,"_2365":95496},[],"Comprueba, en orden:",{"_2837":57347,"_24697":57283,"_17272":95498,"_5":17167,"_23367":95336,"_2365":95499},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2837":57348,"_24697":57283,"_17272":95501,"_5":17167,"_23367":95336,"_2365":95502},[],"Su estado contiene la dirección esperada.",{"_2837":57349,"_24697":57283,"_17272":95504,"_5":17167,"_23367":95336,"_2365":95505},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2837":57350,"_24697":57283,"_17272":95507,"_5":17167,"_23367":95336,"_2365":95508},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2837":57351,"_24697":57283,"_17272":95510,"_5":17167,"_23367":95336,"_2365":95511},[],"DNS resuelve al endpoint accesible externamente.",{"_2837":57352,"_24697":57283,"_17272":95513,"_5":17167,"_23367":95336,"_2365":95514},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2837":57353,"_24697":57283,"_17272":95516,"_5":17167,"_23367":95336,"_2365":95517},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2837":57354,"_24697":57354,"_5":12136,"_2365":40366,"_25033":95519,"_17272":95520,"_23367":57354},[40259,94605,94839],[],{"_2837":57355,"_24697":57354,"_17272":95522,"_5":17167,"_23367":57354,"_2365":95523},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2837":57356,"_24697":57354,"_5":25030,"_17272":95525,"_23367":95526,"_2365":95527},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2837":57357,"_24697":57354,"_5":25030,"_17272":95529,"_23367":95530,"_2365":95531},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2837":57358,"_24697":57354,"_5":25030,"_17272":95533,"_23367":95534,"_2365":95535},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2837":57359,"_24697":57354,"_5":25030,"_17272":95537,"_23367":95538,"_2365":95539},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2837":57360,"_24697":57354,"_5":25030,"_17272":95541,"_23367":95542,"_2365":95543},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2837":57361,"_24697":57354,"_5":25030,"_17272":95545,"_23367":95546,"_2365":95547},[],"/docs/pr-preview/pr-36/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2837":57362,"_24697":57354,"_17272":95549,"_5":17167,"_23367":95526,"_2365":95550},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2837":57363,"_24697":57354,"_17272":95552,"_5":17167,"_23367":95530,"_2365":95553},[],"Flujo",{"_2837":57364,"_24697":57354,"_17272":95555,"_5":17167,"_23367":95530,"_2365":95556},[],"Úsalo para",{"_2837":57365,"_24697":57354,"_17272":95558,"_5":17167,"_23367":95530,"_2365":95559},[],"Qué instala",{"_2837":57366,"_24697":57354,"_17272":95561,"_5":17167,"_23367":95530,"_2365":41250},[],{"_2837":57367,"_24697":57354,"_17272":95563,"_5":17167,"_23367":95530,"_2365":95564},[],"Producción y entornos controlados",{"_2837":57368,"_24697":57354,"_17272":95566,"_5":17167,"_23367":95530,"_2365":95567},[],"Servicios de Lamassu y recursos de Gateway API",{"_2837":57369,"_24697":57354,"_17272":95569,"_5":17167,"_23367":95530,"_2365":40503},[],{"_2837":57370,"_24697":57354,"_17272":95571,"_5":17167,"_23367":95530,"_2365":95572},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2837":57371,"_24697":57354,"_17272":95574,"_5":17167,"_23367":95530,"_2365":95575},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2837":57372,"_24697":57354,"_17272":95577,"_5":17167,"_23367":95534,"_2365":95578},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2837":57373,"_24697":57354,"_17272":95580,"_5":17167,"_23367":95534,"_2365":95581},[],"Área",{"_2837":57374,"_24697":57354,"_17272":95583,"_5":17167,"_23367":95534,"_2365":95584},[],"El chart de Lamassu proporciona",{"_2837":57375,"_24697":57354,"_17272":95586,"_5":17167,"_23367":95534,"_2365":95587},[],"Tú proporcionas",{"_2837":57376,"_24697":57354,"_17272":95589,"_5":17167,"_23367":95534,"_2365":95590},[],"Aplicaciones Lamassu",{"_2837":57377,"_24697":57354,"_17272":95592,"_5":17167,"_23367":95534,"_2365":95593},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2837":57378,"_24697":57354,"_17272":95595,"_5":17167,"_23367":95534,"_2365":95596},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2837":57379,"_24697":57354,"_17272":95598,"_5":17167,"_23367":95534,"_2365":95599},[],"Datos PostgreSQL",{"_2837":57380,"_24697":57354,"_17272":95601,"_5":17167,"_23367":95534,"_2365":95602},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2837":57381,"_24697":57354,"_17272":95604,"_5":17167,"_23367":95534,"_2365":95605},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2837":57382,"_24697":57354,"_17272":95607,"_5":17167,"_23367":95534,"_2365":95608},[],"Mensajería",{"_2837":57383,"_24697":57354,"_17272":95610,"_5":17167,"_23367":95534,"_2365":95611},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2837":57384,"_24697":57354,"_17272":95613,"_5":17167,"_23367":95534,"_2365":95614},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2837":57385,"_24697":57354,"_17272":95616,"_5":17167,"_23367":95534,"_2365":95617},[],"Identidad",{"_2837":57386,"_24697":57354,"_17272":95619,"_5":17167,"_23367":95534,"_2365":95620},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2837":57387,"_24697":57354,"_17272":95622,"_5":17167,"_23367":95534,"_2365":95623},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2837":57388,"_24697":57354,"_17272":95625,"_5":17167,"_23367":95534,"_2365":95626},[],"Enrutamiento externo",{"_2837":57389,"_24697":57354,"_17272":95628,"_5":17167,"_23367":95534,"_2365":95629},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2837":57390,"_24697":57354,"_17272":95631,"_5":17167,"_23367":95534,"_2365":95632},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2837":57391,"_24697":57354,"_17272":95634,"_5":17167,"_23367":95534,"_2365":41324},[],{"_2837":57392,"_24697":57354,"_17272":95636,"_5":17167,"_23367":95534,"_2365":95637},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2837":57393,"_24697":57354,"_17272":95639,"_5":17167,"_23367":95534,"_2365":95640},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2837":57394,"_24697":57354,"_17272":95642,"_5":17167,"_23367":95534,"_2365":95643},[],"Datos persistentes de la aplicación",{"_2837":57395,"_24697":57354,"_17272":95645,"_5":17167,"_23367":95534,"_2365":95646},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2837":57396,"_24697":57354,"_17272":95648,"_5":17167,"_23367":95534,"_2365":95649},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2837":57397,"_24697":57354,"_17272":95651,"_5":17167,"_23367":95534,"_2365":95652},[],"Integraciones opcionales",{"_2837":57398,"_24697":57354,"_17272":95654,"_5":17167,"_23367":95534,"_2365":95655},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2837":57399,"_24697":57354,"_17272":95657,"_5":17167,"_23367":95534,"_2365":95658},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2837":57400,"_24697":57354,"_17272":95660,"_5":17167,"_23367":95534,"_2365":95661},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2837":57401,"_24697":57354,"_17272":95663,"_5":17167,"_23367":95534,"_2365":95664},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2837":57402,"_24697":57354,"_17272":95666,"_5":17167,"_23367":95538,"_2365":95667},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2837":57403,"_24697":57354,"_17272":95669,"_5":17167,"_23367":95538,"_2365":95670},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2837":57404,"_24697":57354,"_17272":95672,"_5":17167,"_23367":95542,"_2365":95673},[],"Kubernetes 1.24 o posterior",{"_2837":57405,"_24697":57354,"_17272":95675,"_5":17167,"_23367":95542,"_2365":95676},[],"Helm 3.2 o posterior",{"_2837":57406,"_24697":57354,"_17272":95678,"_5":17167,"_23367":95542,"_2365":95679},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2837":57407,"_24697":57354,"_17272":95681,"_5":17167,"_23367":95542,"_2365":95682},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2837":57408,"_24697":57354,"_17272":95684,"_5":17167,"_23367":95542,"_2365":95685},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2837":57409,"_24697":57354,"_17272":95687,"_5":17167,"_23367":95542,"_2365":95688},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2837":57410,"_24697":57354,"_17272":95690,"_5":17167,"_23367":95542,"_2365":95691},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2837":57411,"_24697":57354,"_17272":95693,"_5":17167,"_23367":95546,"_2365":95694},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2837":57412,"_24697":57354,"_17272":95696,"_5":17167,"_23367":95546,"_2365":95697},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2837":57413,"_24697":57354,"_17272":95699,"_5":17167,"_23367":95546,"_2365":95700},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2837":57414,"_24697":57414,"_5":12136,"_2365":95702,"_25033":95703,"_17272":95705,"_23367":57414},"Resolución de problemas de despliegue",[40259,94605,95704],"Operación",[],{"_2837":57415,"_24697":57414,"_17272":95707,"_5":17167,"_23367":57414,"_2365":95708},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2837":57416,"_24697":57414,"_5":25030,"_17272":95710,"_23367":95711,"_2365":95712},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2837":57417,"_24697":57414,"_5":25030,"_17272":95714,"_23367":95715,"_2365":95716},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2837":57418,"_24697":57414,"_5":25030,"_17272":95718,"_23367":95719,"_2365":95720},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2837":57419,"_24697":57414,"_5":25030,"_17272":95722,"_23367":95723,"_2365":95724},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2837":57420,"_24697":57414,"_5":25030,"_17272":95726,"_23367":95727,"_2365":95728},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2837":57421,"_24697":57414,"_5":25030,"_17272":95730,"_23367":95731,"_2365":95732},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2837":57422,"_24697":57414,"_5":25030,"_17272":95734,"_23367":95735,"_2365":95736},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2837":57423,"_24697":57414,"_5":25030,"_17272":95738,"_23367":95739,"_2365":95740},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2837":57424,"_24697":57414,"_5":25030,"_17272":95742,"_23367":95743,"_2365":95744},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2837":57425,"_24697":57414,"_5":25030,"_17272":95746,"_23367":95747,"_2365":95748},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2837":57426,"_24697":57414,"_5":25030,"_17272":95750,"_23367":95751,"_2365":95752},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2837":57427,"_24697":57414,"_5":25030,"_17272":95754,"_23367":95755,"_2365":95756},[],"/docs/pr-preview/pr-36/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2837":57428,"_24697":57414,"_17272":95758,"_5":17167,"_23367":57414,"_2365":95759},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2837":57429,"_24697":57414,"_17272":95761,"_5":17167,"_23367":95715,"_2365":95762},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2837":57430,"_24697":57414,"_17272":95764,"_5":17167,"_23367":95719,"_2365":95765},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2837":57431,"_24697":57414,"_17272":95767,"_5":17167,"_23367":95723,"_2365":95768},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2837":57432,"_24697":57414,"_17272":95770,"_5":17167,"_23367":95727,"_2365":95771},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2837":57433,"_24697":57414,"_17272":95773,"_5":17167,"_23367":95731,"_2365":95774},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2837":57434,"_24697":57414,"_17272":95776,"_5":17167,"_23367":95735,"_2365":95777},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2837":57435,"_24697":57414,"_17272":95779,"_5":17167,"_23367":95735,"_2365":95780},[],"Ejecuta también la prueba de conectividad del chart:",{"_2837":57436,"_24697":57414,"_17272":95782,"_5":17167,"_23367":95735,"_2365":95783},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2837":57437,"_24697":57414,"_17272":95785,"_5":17167,"_23367":95735,"_2365":95786},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2837":57438,"_24697":57414,"_17272":95788,"_5":17167,"_23367":95739,"_2365":95789},[],"Si recibes un 401:",{"_2837":57439,"_24697":57414,"_17272":95791,"_5":17167,"_23367":95739,"_2365":95792},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2837":57440,"_24697":57414,"_17272":95794,"_5":17167,"_23367":95739,"_2365":95795},[],"verifica emisor, audiencia y expiración del token;",{"_2837":57441,"_24697":57414,"_17272":95797,"_5":17167,"_23367":95739,"_2365":95798},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2837":57442,"_24697":57414,"_17272":95800,"_5":17167,"_23367":95739,"_2365":95801},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2837":57443,"_24697":57414,"_17272":95803,"_5":17167,"_23367":95739,"_2365":95804},[],"Si el login termina pero las APIs devuelven 403:",{"_2837":57444,"_24697":57414,"_17272":95806,"_5":17167,"_23367":95739,"_2365":95807},[],"inspecciona los claims reales del token;",{"_2837":57445,"_24697":57414,"_17272":95809,"_5":17167,"_23367":95739,"_2365":95810},[],"confirma que coinciden con un principal activo;",{"_2837":57446,"_24697":57414,"_17272":95812,"_5":17167,"_23367":95739,"_2365":95813},[],"revisa las políticas concedidas al principal;",{"_2837":57447,"_24697":57414,"_17272":95815,"_5":17167,"_23367":95739,"_2365":95816},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2837":57448,"_24697":57414,"_17272":95818,"_5":17167,"_23367":95739,"_2365":95819},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2837":57449,"_24697":57414,"_17272":95821,"_5":17167,"_23367":95743,"_2365":95822},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2837":57450,"_24697":57414,"_17272":95824,"_5":17167,"_23367":95743,"_2365":95825},[],"Localiza el pod y Service de authz.",{"_2837":57451,"_24697":57414,"_17272":95827,"_5":17167,"_23367":95743,"_2365":95828},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2837":57452,"_24697":57414,"_17272":95830,"_5":17167,"_23367":95743,"_2365":95831},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2837":57453,"_24697":57414,"_17272":95833,"_5":17167,"_23367":95743,"_2365":95834},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2837":57454,"_24697":57414,"_17272":95836,"_5":17167,"_23367":95743,"_2365":95837},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2837":57455,"_24697":57414,"_17272":95839,"_5":17167,"_23367":95747,"_2365":95840},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2837":57456,"_24697":57414,"_17272":95842,"_5":17167,"_23367":95747,"_2365":95843},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2837":57457,"_24697":57414,"_17272":95845,"_5":17167,"_23367":95747,"_2365":95846},[],"volumen persistente sin enlazar;",{"_2837":57458,"_24697":57414,"_17272":95848,"_5":17167,"_23367":95747,"_2365":95849},[],"imagen inaccesible o política de pull incorrecta;",{"_2837":57459,"_24697":57414,"_17272":95851,"_5":17167,"_23367":95747,"_2365":95852},[],"configuración inválida del motor criptográfico;",{"_2837":57460,"_24697":57414,"_17272":95854,"_5":17167,"_23367":95747,"_2365":95855},[],"límites de CPU o memoria demasiado bajos;",{"_2837":57461,"_24697":57414,"_17272":95857,"_5":17167,"_23367":95747,"_2365":95858},[],"migración previa incompleta.",{"_2837":57462,"_24697":57414,"_17272":95860,"_5":17167,"_23367":95747,"_2365":95861},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2837":57463,"_24697":57414,"_17272":95863,"_5":17167,"_23367":95747,"_2365":95864},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2837":57464,"_24697":57414,"_17272":95866,"_5":17167,"_23367":95751,"_2365":95867},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2837":57465,"_24697":57414,"_17272":95869,"_5":17167,"_23367":95751,"_2365":95870},[],"verifica que esté habilitado en el servicio emisor;",{"_2837":57466,"_24697":57414,"_17272":95872,"_5":17167,"_23367":95751,"_2365":95873},[],"comprueba conectividad y credenciales AMQP;",{"_2837":57467,"_24697":57414,"_17272":95875,"_5":17167,"_23367":95751,"_2365":95876},[],"revisa exchange, routing key, colas y consumidores;",{"_2837":57468,"_24697":57414,"_17272":95878,"_5":17167,"_23367":95751,"_2365":95879},[],"inspecciona dead-letter queues;",{"_2837":57469,"_24697":57414,"_17272":95881,"_5":17167,"_23367":95751,"_2365":95882},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2837":57470,"_24697":57414,"_17272":95884,"_5":17167,"_23367":95751,"_2365":95885},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2837":57471,"_24697":57414,"_17272":95887,"_5":17167,"_23367":95755,"_2365":95888},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2837":57472,"_24697":57414,"_17272":95890,"_5":17167,"_23367":95755,"_2365":95891},[],"Antes de cerrar una incidencia, guarda:",{"_2837":57473,"_24697":57414,"_17272":95893,"_5":17167,"_23367":95755,"_2365":95894},[],"causa confirmada;",{"_2837":57474,"_24697":57414,"_17272":95896,"_5":17167,"_23367":95755,"_2365":95897},[],"alcance temporal y recursos afectados;",{"_2837":57475,"_24697":57414,"_17272":95899,"_5":17167,"_23367":95755,"_2365":95900},[],"comandos o consultas utilizados;",{"_2837":57476,"_24697":57414,"_17272":95902,"_5":17167,"_23367":95755,"_2365":95903},[],"cambio aplicado y forma de revertirlo;",{"_2837":57477,"_24697":57414,"_17272":95905,"_5":17167,"_23367":95755,"_2365":95906},[],"validación desde un consumidor;",{"_2837":57478,"_24697":57414,"_17272":95908,"_5":17167,"_23367":95755,"_2365":95909},[],"acción preventiva y propietario.",{"_2837":57479,"_24697":57479,"_5":12136,"_2365":95911,"_25033":95912,"_17272":95915,"_23367":57479},"Control de acceso",[40259,95913,95914],"Plataforma","Administración",[],{"_2837":57480,"_24697":57479,"_17272":95917,"_5":17167,"_23367":57479,"_2365":95918},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2837":57481,"_24697":57479,"_5":25030,"_17272":95920,"_23367":95921,"_2365":95922},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2837":57482,"_24697":57479,"_5":25030,"_17272":95924,"_23367":95925,"_2365":95926},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2837":57483,"_24697":57479,"_5":25030,"_17272":95928,"_23367":95929,"_2365":95930},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2837":57484,"_24697":57479,"_5":25030,"_17272":95932,"_23367":95933,"_2365":95934},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2837":57485,"_24697":57479,"_5":25030,"_17272":95936,"_23367":95937,"_2365":95938},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2837":57486,"_24697":57479,"_5":25030,"_17272":95940,"_23367":95941,"_2365":95942},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2837":57487,"_24697":57479,"_5":25030,"_17272":95944,"_23367":95945,"_2365":95946},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2837":57488,"_24697":57479,"_5":25030,"_17272":95948,"_23367":95949,"_2365":95950},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2837":57489,"_24697":57479,"_5":25030,"_17272":95952,"_23367":95953,"_2365":95954},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2837":57490,"_24697":57479,"_5":25030,"_17272":95956,"_23367":95957,"_2365":95958},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2837":57491,"_24697":57479,"_5":25030,"_17272":95960,"_23367":95961,"_2365":95962},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2837":57492,"_24697":57479,"_5":25030,"_17272":95964,"_23367":95965,"_2365":95966},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2837":57493,"_24697":57479,"_5":25030,"_17272":95968,"_23367":95969,"_2365":95970},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2837":57494,"_24697":57479,"_5":25030,"_17272":95972,"_23367":95973,"_2365":95974},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2837":57495,"_24697":57479,"_5":25030,"_17272":95976,"_23367":95977,"_2365":95175},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2837":57496,"_24697":57479,"_5":25030,"_17272":95979,"_23367":95980,"_2365":95981},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2837":57497,"_24697":57479,"_5":25030,"_17272":95983,"_23367":95984,"_2365":95985},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2837":57498,"_24697":57479,"_5":25030,"_17272":95987,"_23367":95988,"_2365":95989},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2837":57499,"_24697":57479,"_5":25030,"_17272":95991,"_23367":95992,"_2365":95993},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2837":57500,"_24697":57479,"_5":25030,"_17272":95995,"_23367":95996,"_2365":95997},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2837":57501,"_24697":57479,"_5":25030,"_17272":95999,"_23367":96000,"_2365":96001},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2837":57502,"_24697":57479,"_5":25030,"_17272":96003,"_23367":96004,"_2365":96005},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2837":57503,"_24697":57479,"_5":25030,"_17272":96007,"_23367":96008,"_2365":96009},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2837":57504,"_24697":57479,"_5":25030,"_17272":96011,"_23367":96012,"_2365":96013},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2837":57505,"_24697":57479,"_5":25030,"_17272":96015,"_23367":96016,"_2365":96017},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2837":57506,"_24697":57479,"_5":25030,"_17272":96019,"_23367":96020,"_2365":96021},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2837":57507,"_24697":57479,"_5":25030,"_17272":96023,"_23367":96024,"_2365":96025},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2837":57508,"_24697":57479,"_5":25030,"_17272":96027,"_23367":96028,"_2365":96029},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2837":57509,"_24697":57479,"_5":25030,"_17272":96031,"_23367":96032,"_2365":96033},[],"/docs/pr-preview/pr-36/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2837":57510,"_24697":57479,"_17272":96035,"_5":17167,"_23367":57479,"_2365":96036},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2837":57511,"_24697":57479,"_17272":96038,"_5":17167,"_23367":57479,"_2365":96039},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2837":57512,"_24697":57479,"_17272":96041,"_5":17167,"_23367":57479,"_2365":96042},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2837":57513,"_24697":57479,"_17272":96044,"_5":17167,"_23367":95921,"_2365":96045},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2837":57514,"_24697":57479,"_17272":96047,"_5":17167,"_23367":95921,"_2365":96048},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2837":57515,"_24697":57479,"_17272":96050,"_5":17167,"_23367":95921,"_2365":96051},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2837":57516,"_24697":57479,"_17272":96053,"_5":17167,"_23367":95921,"_2365":96054},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2837":57517,"_24697":57479,"_17272":96056,"_5":17167,"_23367":95921,"_2365":96057},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2837":57518,"_24697":57479,"_17272":96059,"_5":17167,"_23367":95921,"_2365":96060},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y alguna de sus políticas debe permitir la operación solicitada.",{"_2837":57519,"_24697":57479,"_17272":96062,"_5":17167,"_23367":95925,"_2365":96063},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2837":57520,"_24697":57479,"_17272":96065,"_5":17167,"_23367":95925,"_2365":96066},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2837":57521,"_24697":57479,"_17272":96068,"_5":17167,"_23367":95929,"_2365":96069},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2837":57522,"_24697":57479,"_17272":96071,"_5":17167,"_23367":95929,"_2365":96072},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2837":57523,"_24697":57479,"_17272":96074,"_5":17167,"_23367":95929,"_2365":96075},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2837":57524,"_24697":57479,"_17272":96077,"_5":17167,"_23367":95929,"_2365":96078},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2837":57525,"_24697":57479,"_17272":96080,"_5":17167,"_23367":95929,"_2365":96081},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2837":57526,"_24697":57479,"_17272":96083,"_5":17167,"_23367":95929,"_2365":96084},[],"Carga por separado las políticas concedidas a cada principal.",{"_2837":57527,"_24697":57479,"_17272":96086,"_5":17167,"_23367":95929,"_2365":96087},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2837":57528,"_24697":57479,"_17272":96089,"_5":17167,"_23367":95929,"_2365":96090},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2837":57529,"_24697":57479,"_17272":96092,"_5":17167,"_23367":95929,"_2365":96093},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política.",{"_2837":57530,"_24697":57479,"_17272":96095,"_5":17167,"_23367":95929,"_2365":96096},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2837":57531,"_24697":57479,"_17272":96098,"_5":17167,"_23367":95929,"_2365":96099},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en `x-current-user`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2837":57532,"_24697":57479,"_17272":96101,"_5":17167,"_23367":95929,"_2365":96102},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, el esquema debe declarar una restricción que relacione un valor de la petición con un atributo normalizado del principal.",{"_2837":57533,"_24697":57479,"_17272":96104,"_5":17167,"_23367":95933,"_2365":96105},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2837":57534,"_24697":57479,"_17272":96107,"_5":17167,"_23367":95933,"_2365":96108},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2837":57535,"_24697":57479,"_17272":96110,"_5":17167,"_23367":95933,"_2365":96111},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2837":57536,"_24697":57479,"_17272":96113,"_5":17167,"_23367":95933,"_2365":96114},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2837":57537,"_24697":57479,"_17272":96116,"_5":17167,"_23367":95933,"_2365":96117},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2837":57538,"_24697":57479,"_17272":96119,"_5":17167,"_23367":95933,"_2365":96120},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2837":57539,"_24697":57479,"_17272":96122,"_5":17167,"_23367":95933,"_2365":96123},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2837":57540,"_24697":57479,"_17272":96125,"_5":17167,"_23367":95933,"_2365":96126},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2837":57541,"_24697":57479,"_17272":96128,"_5":17167,"_23367":95933,"_2365":96129},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2837":57542,"_24697":57479,"_17272":96131,"_5":17167,"_23367":95933,"_2365":96132},[],"Las acciones se dividen en dos grupos:",{"_2837":57543,"_24697":57479,"_17272":96134,"_5":17167,"_23367":95933,"_2365":96135},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2837":57544,"_24697":57479,"_17272":96137,"_5":17167,"_23367":95933,"_2365":96138},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2837":57545,"_24697":57479,"_17272":96140,"_5":17167,"_23367":95933,"_2365":96141},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2837":57546,"_24697":57479,"_17272":96143,"_5":17167,"_23367":95937,"_2365":96144},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2837":57547,"_24697":57479,"_17272":96146,"_5":17167,"_23367":95937,"_2365":96147},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2837":57548,"_24697":57479,"_17272":96149,"_5":17167,"_23367":95937,"_2365":96150},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega. Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2837":57549,"_24697":57479,"_17272":96152,"_5":17167,"_23367":95941,"_2365":96153},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2837":57550,"_24697":57479,"_17272":96155,"_5":17167,"_23367":95941,"_2365":96156},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2837":57551,"_24697":57479,"_17272":96158,"_5":17167,"_23367":95941,"_2365":96159},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2837":57552,"_24697":57479,"_17272":96161,"_5":17167,"_23367":95941,"_2365":96162},[],"Los operadores implementados son:",{"_2837":57553,"_24697":57479,"_17272":96164,"_5":17167,"_23367":95941,"_2365":96165},[],"`equals`, para igualdad exacta;",{"_2837":57554,"_24697":57479,"_17272":96167,"_5":17167,"_23367":95941,"_2365":96168},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2837":57555,"_24697":57479,"_17272":96170,"_5":17167,"_23367":95941,"_2365":96171},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2837":57556,"_24697":57479,"_17272":96173,"_5":17167,"_23367":95941,"_2365":96174},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2837":57557,"_24697":57479,"_17272":96176,"_5":17167,"_23367":95945,"_2365":96177},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2837":57558,"_24697":57479,"_17272":96179,"_5":17167,"_23367":95945,"_2365":96180},[],"Los modos disponibles son:",{"_2837":57559,"_24697":57479,"_17272":96182,"_5":17167,"_23367":95945,"_2365":96183},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2837":57560,"_24697":57479,"_17272":96185,"_5":17167,"_23367":95945,"_2365":96186},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2837":57561,"_24697":57479,"_17272":96188,"_5":17167,"_23367":95945,"_2365":96189},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2837":57562,"_24697":57479,"_17272":96191,"_5":17167,"_23367":95945,"_2365":96192},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2837":57563,"_24697":57479,"_17272":96194,"_5":17167,"_23367":95945,"_2365":96195},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2837":57564,"_24697":57479,"_17272":96197,"_5":17167,"_23367":95945,"_2365":96198},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2837":57565,"_24697":57479,"_17272":96200,"_5":17167,"_23367":95949,"_2365":96201},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2837":57566,"_24697":57479,"_17272":96203,"_5":17167,"_23367":95949,"_2365":96204},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2837":57567,"_24697":57479,"_17272":96206,"_5":17167,"_23367":95949,"_2365":96207},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2837":57568,"_24697":57479,"_17272":96209,"_5":17167,"_23367":95949,"_2365":96210},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2837":57569,"_24697":57479,"_17272":96212,"_5":17167,"_23367":95957,"_2365":96213},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2837":57570,"_24697":57479,"_17272":96215,"_5":17167,"_23367":95957,"_2365":96216},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2837":57571,"_24697":57479,"_17272":96218,"_5":17167,"_23367":95961,"_2365":96219},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2837":57572,"_24697":57479,"_17272":96221,"_5":17167,"_23367":95961,"_2365":96222},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2837":57573,"_24697":57479,"_17272":96224,"_5":17167,"_23367":95965,"_2365":96225},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2837":57574,"_24697":57479,"_17272":96227,"_5":17167,"_23367":95965,"_2365":96228},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2837":57575,"_24697":57479,"_17272":96230,"_5":17167,"_23367":95965,"_2365":96231},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2837":57576,"_24697":57479,"_17272":96233,"_5":17167,"_23367":95969,"_2365":96234},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2837":57577,"_24697":57479,"_17272":96236,"_5":17167,"_23367":95969,"_2365":96237},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2837":57578,"_24697":57479,"_17272":96239,"_5":17167,"_23367":95969,"_2365":96240},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2837":57579,"_24697":57479,"_17272":96242,"_5":17167,"_23367":95973,"_2365":96243},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2837":57580,"_24697":57479,"_17272":96245,"_5":17167,"_23367":95973,"_2365":96246},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2837":57581,"_24697":57479,"_17272":96248,"_5":17167,"_23367":95973,"_2365":96249},[],"acceso completo y de solo lectura a KMS;",{"_2837":57582,"_24697":57479,"_17272":96251,"_5":17167,"_23367":95973,"_2365":96252},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2837":57583,"_24697":57479,"_17272":96254,"_5":17167,"_23367":95973,"_2365":96255},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2837":57584,"_24697":57479,"_17272":96257,"_5":17167,"_23367":95973,"_2365":96258},[],"acceso a la interfaz;",{"_2837":57585,"_24697":57479,"_17272":96260,"_5":17167,"_23367":95973,"_2365":96261},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2837":57586,"_24697":57479,"_17272":96263,"_5":17167,"_23367":95973,"_2365":96264},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2837":57587,"_24697":57479,"_17272":96266,"_5":17167,"_23367":95973,"_2365":96267},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2837":57588,"_24697":57479,"_17272":96269,"_5":17167,"_23367":95977,"_2365":96270},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2837":57589,"_24697":57479,"_17272":96272,"_5":17167,"_23367":95977,"_2365":96273},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2837":57590,"_24697":57479,"_17272":96275,"_5":17167,"_23367":95977,"_2365":96276},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2837":57591,"_24697":57479,"_17272":96278,"_5":17167,"_23367":95980,"_2365":96279},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2837":57592,"_24697":57479,"_17272":96281,"_5":17167,"_23367":95984,"_2365":96282},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2837":57593,"_24697":57479,"_17272":96284,"_5":17167,"_23367":95988,"_2365":96285},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2837":57594,"_24697":57479,"_17272":96287,"_5":17167,"_23367":95992,"_2365":96288},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2837":57595,"_24697":57479,"_17272":96290,"_5":17167,"_23367":95996,"_2365":96291},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2837":57596,"_24697":57479,"_17272":96293,"_5":17167,"_23367":96000,"_2365":96294},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2837":57597,"_24697":57479,"_17272":96296,"_5":17167,"_23367":96000,"_2365":96297},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2837":57598,"_24697":57479,"_17272":96299,"_5":17167,"_23367":96004,"_2365":96300},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2837":57599,"_24697":57479,"_17272":96302,"_5":17167,"_23367":96004,"_2365":96303},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2837":57600,"_24697":57479,"_17272":96305,"_5":17167,"_23367":96004,"_2365":96306},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2837":57601,"_24697":57479,"_17272":96308,"_5":17167,"_23367":96004,"_2365":96309},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2837":57602,"_24697":57479,"_17272":96311,"_5":17167,"_23367":96004,"_2365":96312},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2837":57603,"_24697":57479,"_17272":96314,"_5":17167,"_23367":96004,"_2365":96315},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2837":57604,"_24697":57479,"_17272":96317,"_5":17167,"_23367":96004,"_2365":96318},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2837":57605,"_24697":57479,"_17272":96320,"_5":17167,"_23367":96004,"_2365":96321},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2837":57606,"_24697":57479,"_17272":96323,"_5":17167,"_23367":96008,"_2365":96324},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2837":57607,"_24697":57479,"_17272":96326,"_5":17167,"_23367":96008,"_2365":96327},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2837":57608,"_24697":57479,"_17272":96329,"_5":17167,"_23367":96008,"_2365":96330},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2837":57609,"_24697":57479,"_17272":96332,"_5":17167,"_23367":96012,"_2365":96333},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2837":57610,"_24697":57479,"_17272":96335,"_5":17167,"_23367":96012,"_2365":96336},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2837":57611,"_24697":57479,"_17272":96338,"_5":17167,"_23367":96012,"_2365":96339},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2837":57612,"_24697":57479,"_17272":96341,"_5":17167,"_23367":96012,"_2365":96342},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2837":57613,"_24697":57479,"_17272":96344,"_5":17167,"_23367":96012,"_2365":96345},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2837":57614,"_24697":57479,"_17272":96347,"_5":17167,"_23367":96012,"_2365":96348},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2837":57615,"_24697":57479,"_17272":96350,"_5":17167,"_23367":96012,"_2365":96351},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2837":57616,"_24697":57479,"_17272":96353,"_5":17167,"_23367":96020,"_2365":96354},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2837":57617,"_24697":57479,"_17272":96356,"_5":17167,"_23367":96024,"_2365":96357},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2837":57618,"_24697":57479,"_17272":96359,"_5":17167,"_23367":96024,"_2365":96360},[],"que exista un principal activo del tipo correcto;",{"_2837":57619,"_24697":57479,"_17272":96362,"_5":17167,"_23367":96024,"_2365":96363},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2837":57620,"_24697":57479,"_17272":96365,"_5":17167,"_23367":96024,"_2365":96366},[],"que todas las condiciones del principal se cumplan;",{"_2837":57621,"_24697":57479,"_17272":96368,"_5":17167,"_23367":96024,"_2365":96369},[],"que el principal tenga concedida la política esperada;",{"_2837":57622,"_24697":57479,"_17272":96371,"_5":17167,"_23367":96024,"_2365":96372},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2837":57623,"_24697":57479,"_17272":96374,"_5":17167,"_23367":96024,"_2365":96375},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2837":57624,"_24697":57479,"_17272":96377,"_5":17167,"_23367":96024,"_2365":96378},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos.",{"_2837":57625,"_24697":57479,"_17272":96380,"_5":17167,"_23367":96028,"_2365":96381},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2837":57626,"_24697":57479,"_17272":96383,"_5":17167,"_23367":96032,"_2365":96384},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2837":57627,"_24697":57479,"_17272":96386,"_5":17167,"_23367":96032,"_2365":96387},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2837":57628,"_24697":57628,"_5":12136,"_2365":96389,"_25033":96390,"_17272":96391,"_23367":57628},"Alertas y suscripciones",[40259,95913,95914],[],{"_2837":57629,"_24697":57628,"_17272":96393,"_5":17167,"_23367":57628,"_2365":96394},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2837":57630,"_24697":57628,"_5":25030,"_17272":96396,"_23367":96397,"_2365":96398},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2837":57631,"_24697":57628,"_5":25030,"_17272":96400,"_23367":96401,"_2365":96402},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2837":57632,"_24697":57628,"_5":25030,"_17272":96404,"_23367":96405,"_2365":96406},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2837":57633,"_24697":57628,"_5":25030,"_17272":96408,"_23367":96409,"_2365":96410},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2837":57634,"_24697":57628,"_5":25030,"_17272":96412,"_23367":96413,"_2365":96414},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2837":57635,"_24697":57628,"_5":25030,"_17272":96416,"_23367":96417,"_2365":96418},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2837":57636,"_24697":57628,"_5":25030,"_17272":96420,"_23367":96421,"_2365":96422},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2837":57637,"_24697":57628,"_5":25030,"_17272":96424,"_23367":96425,"_2365":96426},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2837":57638,"_24697":57628,"_5":25030,"_17272":96428,"_23367":96429,"_2365":96430},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2837":57639,"_24697":57628,"_5":25030,"_17272":96432,"_23367":96433,"_2365":96434},[],"/docs/pr-preview/pr-36/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2837":57640,"_24697":57628,"_17272":96436,"_5":17167,"_23367":57628,"_2365":96437},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2837":57641,"_24697":57628,"_17272":96439,"_5":17167,"_23367":96397,"_2365":96440},[],"Un servicio publica un evento de dominio.",{"_2837":57642,"_24697":57628,"_17272":96442,"_5":17167,"_23367":96397,"_2365":96443},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2837":57643,"_24697":57628,"_17272":96445,"_5":17167,"_23367":96397,"_2365":96446},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2837":57644,"_24697":57628,"_17272":96448,"_5":17167,"_23367":96397,"_2365":96449},[],"Lamassu entrega el evento al canal configurado.",{"_2837":57645,"_24697":57628,"_17272":96451,"_5":17167,"_23367":96397,"_2365":96452},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2837":57646,"_24697":57628,"_17272":96454,"_5":17167,"_23367":96401,"_2365":96455},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2837":57647,"_24697":57628,"_17272":96457,"_5":17167,"_23367":96401,"_2365":96458},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2837":57648,"_24697":57628,"_17272":96460,"_5":17167,"_23367":96401,"_2365":96461},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2837":57649,"_24697":57628,"_17272":96463,"_5":17167,"_23367":96401,"_2365":96464},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2837":57650,"_24697":57628,"_17272":96466,"_5":17167,"_23367":96401,"_2365":96467},[],"`apikey_options` necesita `header` y `key`.",{"_2837":57651,"_24697":57628,"_17272":96469,"_5":17167,"_23367":96401,"_2365":96470},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2837":57652,"_24697":57628,"_17272":96472,"_5":17167,"_23367":96401,"_2365":96473},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2837":57653,"_24697":57628,"_17272":96475,"_5":17167,"_23367":96401,"_2365":96476},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2837":57654,"_24697":57628,"_17272":96478,"_5":17167,"_23367":96409,"_2365":96479},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2837":57655,"_24697":57628,"_17272":96481,"_5":17167,"_23367":96413,"_2365":96482},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2837":57656,"_24697":57628,"_17272":96484,"_5":17167,"_23367":96417,"_2365":96485},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2837":57657,"_24697":57628,"_17272":96487,"_5":17167,"_23367":96417,"_2365":96488},[],"**None** notifica todas las instancias del evento.",{"_2837":57658,"_24697":57628,"_17272":96490,"_5":17167,"_23367":96417,"_2365":96491},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2837":57659,"_24697":57628,"_17272":96493,"_5":17167,"_23367":96417,"_2365":96494},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2837":57660,"_24697":57628,"_17272":96496,"_5":17167,"_23367":96417,"_2365":96497},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2837":57661,"_24697":57628,"_17272":96499,"_5":17167,"_23367":96417,"_2365":96500},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2837":57662,"_24697":57628,"_17272":96502,"_5":17167,"_23367":96421,"_2365":96503},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2837":57663,"_24697":57628,"_17272":96505,"_5":17167,"_23367":96425,"_2365":96506},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2837":57664,"_24697":57628,"_17272":96508,"_5":17167,"_23367":96425,"_2365":96509},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2837":57665,"_24697":57628,"_17272":96511,"_5":17167,"_23367":96425,"_2365":96512},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2837":57666,"_24697":57628,"_17272":96514,"_5":17167,"_23367":96425,"_2365":96515},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2837":57667,"_24697":57628,"_17272":96517,"_5":17167,"_23367":96425,"_2365":96518},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2837":57668,"_24697":57628,"_17272":96520,"_5":17167,"_23367":96425,"_2365":96521},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2837":57669,"_24697":57628,"_17272":96523,"_5":17167,"_23367":96425,"_2365":96524},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2837":57670,"_24697":57628,"_17272":96526,"_5":17167,"_23367":96425,"_2365":96527},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2837":57671,"_24697":57628,"_17272":96529,"_5":17167,"_23367":96429,"_2365":96530},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2837":57672,"_24697":57628,"_17272":96532,"_5":17167,"_23367":96433,"_2365":96533},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2837":57673,"_24697":57628,"_17272":96535,"_5":17167,"_23367":96433,"_2365":96536},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2837":57674,"_24697":57628,"_17272":96538,"_5":17167,"_23367":96433,"_2365":96539},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2837":57675,"_24697":57628,"_17272":96541,"_5":17167,"_23367":96433,"_2365":96542},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2837":57676,"_24697":57628,"_17272":96544,"_5":17167,"_23367":96433,"_2365":96545},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2837":57677,"_24697":57628,"_17272":96547,"_5":17167,"_23367":96433,"_2365":96548},[],"**Validación:** `va.role.crl.create`.",{"_2837":57678,"_24697":57628,"_17272":96550,"_5":17167,"_23367":96433,"_2365":96551},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2837":57679,"_24697":57628,"_17272":96553,"_5":17167,"_23367":96433,"_2365":96554},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2837":57680,"_24697":57680,"_5":12136,"_2365":96556,"_25033":96557,"_17272":96558,"_23367":57680},"Registros de auditoría",[40259,95913,95914],[],{"_2837":57681,"_24697":57680,"_17272":96560,"_5":17167,"_23367":57680,"_2365":96561},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2837":57682,"_24697":57680,"_5":25030,"_17272":96563,"_23367":96564,"_2365":96565},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2837":57683,"_24697":57680,"_5":25030,"_17272":96567,"_23367":96568,"_2365":96569},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2837":57684,"_24697":57680,"_5":25030,"_17272":96571,"_23367":96572,"_2365":96573},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2837":57685,"_24697":57680,"_5":25030,"_17272":96575,"_23367":96576,"_2365":96577},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2837":57686,"_24697":57680,"_5":25030,"_17272":96579,"_23367":96580,"_2365":96581},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2837":57687,"_24697":57680,"_5":25030,"_17272":96583,"_23367":96584,"_2365":96585},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2837":57688,"_24697":57680,"_5":25030,"_17272":96587,"_23367":96588,"_2365":96589},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2837":57689,"_24697":57680,"_5":25030,"_17272":96591,"_23367":96592,"_2365":96593},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2837":57690,"_24697":57680,"_5":25030,"_17272":96595,"_23367":96596,"_2365":96597},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2837":57691,"_24697":57680,"_5":25030,"_17272":96599,"_23367":96600,"_2365":96601},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2837":57692,"_24697":57680,"_5":25030,"_17272":96603,"_23367":96604,"_2365":96605},[],"/docs/pr-preview/pr-36/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2837":57693,"_24697":57680,"_17272":96607,"_5":17167,"_23367":57680,"_2365":96608},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2837":57694,"_24697":57680,"_17272":96610,"_5":17167,"_23367":96564,"_2365":96611},[],"El cuerpo de auditoría incluye:",{"_2837":57695,"_24697":57680,"_17272":96613,"_5":17167,"_23367":96564,"_2365":96614},[],"input: datos recibidos por la operación;",{"_2837":57696,"_24697":57680,"_17272":96616,"_5":17167,"_23367":96564,"_2365":96617},[],"has\\_error: indica si el servicio devolvió un error;",{"_2837":57697,"_24697":57680,"_17272":96619,"_5":17167,"_23367":96564,"_2365":96620},[],"output: resultado producido o mensaje de error;",{"_2837":57698,"_24697":57680,"_17272":96622,"_5":17167,"_23367":96564,"_2365":96623},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2837":57699,"_24697":57680,"_17272":96625,"_5":17167,"_23367":96564,"_2365":96626},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2837":57700,"_24697":57680,"_17272":96628,"_5":17167,"_23367":96564,"_2365":96629},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2837":57701,"_24697":57680,"_17272":96631,"_5":17167,"_23367":96568,"_2365":96632},[],"El backend aplica auditoría a mutaciones de:",{"_2837":57702,"_24697":57680,"_17272":96634,"_5":17167,"_23367":96568,"_2365":96635},[],"autoridades, certificados y perfiles de emisión;",{"_2837":57703,"_24697":57680,"_17272":96637,"_5":17167,"_23367":96568,"_2365":96638},[],"claves y motores KMS;",{"_2837":57704,"_24697":57680,"_17272":96640,"_5":17167,"_23367":96568,"_2365":96641},[],"dispositivos e identidades;",{"_2837":57705,"_24697":57680,"_17272":96643,"_5":17167,"_23367":96568,"_2365":96644},[],"DMS y operaciones de enrolamiento;",{"_2837":57706,"_24697":57680,"_17272":96646,"_5":17167,"_23367":96568,"_2365":96647},[],"funciones de validación y CRL;",{"_2837":57707,"_24697":57680,"_17272":96649,"_5":17167,"_23367":96568,"_2365":96650},[],"principales, políticas y concesiones de autorización.",{"_2837":57708,"_24697":57680,"_17272":96652,"_5":17167,"_23367":96568,"_2365":96653},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2837":57709,"_24697":57680,"_17272":96655,"_5":17167,"_23367":96572,"_2365":96656},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2837":57710,"_24697":57680,"_17272":96658,"_5":17167,"_23367":96572,"_2365":96659},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2837":57711,"_24697":57680,"_17272":96661,"_5":17167,"_23367":96572,"_2365":96662},[],"Diseña el consumidor para:",{"_2837":57712,"_24697":57680,"_17272":96664,"_5":17167,"_23367":96572,"_2365":96665},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2837":57713,"_24697":57680,"_17272":96667,"_5":17167,"_23367":96572,"_2365":96668},[],"conservar el CloudEvent completo sin modificar;",{"_2837":57714,"_24697":57680,"_17272":96670,"_5":17167,"_23367":96572,"_2365":96671},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2837":57715,"_24697":57680,"_17272":96673,"_5":17167,"_23367":96572,"_2365":96674},[],"cifrar en tránsito y en reposo;",{"_2837":57716,"_24697":57680,"_17272":96676,"_5":17167,"_23367":96572,"_2365":96677},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2837":57717,"_24697":57680,"_17272":96679,"_5":17167,"_23367":96572,"_2365":96680},[],"aplicar una política explícita de retención y legal hold;",{"_2837":57718,"_24697":57680,"_17272":96682,"_5":17167,"_23367":96572,"_2365":96683},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2837":57719,"_24697":57680,"_17272":96685,"_5":17167,"_23367":96576,"_2365":96686},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2837":57720,"_24697":57680,"_17272":96688,"_5":17167,"_23367":96576,"_2365":96689},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2837":57721,"_24697":57680,"_17272":96691,"_5":17167,"_23367":96584,"_2365":96692},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2837":57722,"_24697":57680,"_17272":96694,"_5":17167,"_23367":96588,"_2365":96695},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2837":57723,"_24697":57680,"_17272":96697,"_5":17167,"_23367":96592,"_2365":96698},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2837":57724,"_24697":57680,"_17272":96700,"_5":17167,"_23367":96596,"_2365":96701},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2837":57725,"_24697":57680,"_17272":96703,"_5":17167,"_23367":96600,"_2365":96704},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2837":57726,"_24697":57680,"_17272":96706,"_5":17167,"_23367":96604,"_2365":96707},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2837":57727,"_24697":57680,"_17272":96709,"_5":17167,"_23367":96604,"_2365":96710},[],"aparece un evento de auditoría correcto;",{"_2837":57728,"_24697":57680,"_17272":96712,"_5":17167,"_23367":96604,"_2365":96713},[],"el principal coincide con la identidad utilizada;",{"_2837":57729,"_24697":57680,"_17272":96715,"_5":17167,"_23367":96604,"_2365":96716},[],"el consumidor lo persiste una sola vez;",{"_2837":57730,"_24697":57680,"_17272":96718,"_5":17167,"_23367":96604,"_2365":96719},[],"puede recuperarse por recurso, actor y periodo;",{"_2837":57731,"_24697":57680,"_17272":96721,"_5":17167,"_23367":96604,"_2365":96722},[],"una interrupción del consumidor produce una alerta.",{"_2837":57732,"_24697":57680,"_17272":96724,"_5":17167,"_23367":96604,"_2365":96725},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2837":57733,"_24697":57733,"_5":12136,"_2365":96727,"_25033":96728,"_17272":96729,"_23367":57733},"Arquitectura de la plataforma",[40259,95913],[],{"_2837":57734,"_24697":57733,"_17272":96731,"_5":17167,"_23367":57733,"_2365":96732},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2837":57735,"_24697":57733,"_5":25030,"_17272":96734,"_23367":96735,"_2365":96736},[],"/docs/pr-preview/pr-36/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2837":57736,"_24697":57733,"_5":25030,"_17272":96738,"_23367":96739,"_2365":96740},[],"/docs/pr-preview/pr-36/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2837":57737,"_24697":57733,"_5":25030,"_17272":96742,"_23367":96743,"_2365":96744},[],"/docs/pr-preview/pr-36/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2837":57738,"_24697":57733,"_5":25030,"_17272":96746,"_23367":96747,"_2365":96748},[],"/docs/pr-preview/pr-36/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2837":57739,"_24697":57733,"_5":25030,"_17272":96750,"_23367":96751,"_2365":96752},[],"/docs/pr-preview/pr-36/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2837":57740,"_24697":57733,"_17272":96754,"_5":17167,"_23367":57733,"_2365":96755},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2837":57741,"_24697":57733,"_17272":96757,"_5":17167,"_23367":57733,"_2365":96758},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2837":57742,"_24697":57733,"_17272":96760,"_5":17167,"_23367":96735,"_2365":96761},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2837":57743,"_24697":57733,"_17272":96763,"_5":17167,"_23367":96739,"_2365":96764},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2837":57744,"_24697":57733,"_17272":96766,"_5":17167,"_23367":96743,"_2365":96767},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2837":57745,"_24697":57733,"_17272":96769,"_5":17167,"_23367":96747,"_2365":96770},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2837":57746,"_24697":57733,"_17272":96772,"_5":17167,"_23367":96751,"_2365":96773},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2837":57747,"_24697":57747,"_5":12136,"_2365":96775,"_25033":96776,"_17272":96777,"_23367":57747},"Cómo funciona Lamassu",[40259,95913],[],{"_2837":57748,"_24697":57747,"_17272":96779,"_5":17167,"_23367":57747,"_2365":96780},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2837":57749,"_24697":57747,"_5":25030,"_17272":96782,"_23367":96783,"_2365":96784},[],"/docs/pr-preview/pr-36/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2837":57750,"_24697":57747,"_5":25030,"_17272":96786,"_23367":96787,"_2365":96788},[],"/docs/pr-preview/pr-36/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2837":57751,"_24697":57747,"_17272":96790,"_5":17167,"_23367":57747,"_2365":96791},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2837":57752,"_24697":57747,"_17272":96793,"_5":17167,"_23367":96783,"_2365":96794},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2837":57753,"_24697":57747,"_17272":96796,"_5":17167,"_23367":96783,"_2365":96797},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2837":57754,"_24697":57747,"_17272":96799,"_5":17167,"_23367":96783,"_2365":96800},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2837":57755,"_24697":57747,"_17272":96802,"_5":17167,"_23367":96783,"_2365":96803},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2837":57756,"_24697":57747,"_17272":96805,"_5":17167,"_23367":96783,"_2365":96806},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2837":57757,"_24697":57747,"_17272":96808,"_5":17167,"_23367":96787,"_2365":96809},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2837":57758,"_24697":57747,"_17272":96811,"_5":17167,"_23367":96787,"_2365":96812},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2837":57759,"_24697":57747,"_17272":96814,"_5":17167,"_23367":96787,"_2365":96815},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2837":57760,"_24697":57747,"_17272":96817,"_5":17167,"_23367":96787,"_2365":96818},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2837":57761,"_24697":57747,"_17272":96820,"_5":17167,"_23367":96787,"_2365":96821},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2837":57762,"_24697":57747,"_17272":96823,"_5":17167,"_23367":96787,"_2365":96824},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2837":57763,"_24697":57747,"_17272":96826,"_5":17167,"_23367":96787,"_2365":96827},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2837":57764,"_24697":57764,"_5":12136,"_2365":96829,"_25033":96830,"_17272":96831,"_23367":57764},"Dispositivos e identidades",[40259,95913,42521,96829],[],{"_2837":57765,"_24697":57764,"_17272":96833,"_5":17167,"_23367":57764,"_2365":96834},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2837":57766,"_24697":57764,"_5":25030,"_17272":96836,"_23367":96837,"_2365":96838},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2837":57767,"_24697":57764,"_5":25030,"_17272":96840,"_23367":96841,"_2365":96842},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2837":57768,"_24697":57764,"_5":25030,"_17272":96844,"_23367":96845,"_2365":96846},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2837":57769,"_24697":57764,"_5":25030,"_17272":96848,"_23367":96849,"_2365":96850},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2837":57770,"_24697":57764,"_5":25030,"_17272":96852,"_23367":96853,"_2365":96854},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2837":57771,"_24697":57764,"_5":25030,"_17272":96856,"_23367":96857,"_2365":96858},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2837":57772,"_24697":57764,"_5":25030,"_17272":96860,"_23367":96861,"_2365":96862},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2837":57773,"_24697":57764,"_5":25030,"_17272":96864,"_23367":96865,"_2365":96866},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2837":57774,"_24697":57764,"_5":25030,"_17272":96868,"_23367":96869,"_2365":96870},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2837":57775,"_24697":57764,"_5":25030,"_17272":96872,"_23367":96873,"_2365":96874},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2837":57776,"_24697":57764,"_5":25030,"_17272":96876,"_23367":96877,"_2365":96878},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2837":57777,"_24697":57764,"_17272":96880,"_5":17167,"_23367":57764,"_2365":96881},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2837":57778,"_24697":57764,"_17272":96883,"_5":17167,"_23367":57764,"_2365":96884},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2837":57779,"_24697":57764,"_17272":96886,"_5":17167,"_23367":96837,"_2365":96887},[],"Vista operativa",{"_2837":57780,"_24697":57764,"_17272":96889,"_5":17167,"_23367":96837,"_2365":96890},[],"Interpretación",{"_2837":57781,"_24697":57764,"_17272":96892,"_5":17167,"_23367":96837,"_2365":42584},[],{"_2837":57782,"_24697":57764,"_17272":96894,"_5":17167,"_23367":96837,"_2365":96895},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2837":57783,"_24697":57764,"_17272":96897,"_5":17167,"_23367":96837,"_2365":42590},[],{"_2837":57784,"_24697":57764,"_17272":96899,"_5":17167,"_23367":96837,"_2365":96900},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2837":57785,"_24697":57764,"_17272":96902,"_5":17167,"_23367":96837,"_2365":42596},[],{"_2837":57786,"_24697":57764,"_17272":96904,"_5":17167,"_23367":96837,"_2365":96905},[],"La identidad está en la ventana operativa de renovación.",{"_2837":57787,"_24697":57764,"_17272":96907,"_5":17167,"_23367":96837,"_2365":42602},[],{"_2837":57788,"_24697":57764,"_17272":96909,"_5":17167,"_23367":96837,"_2365":96910},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2837":57789,"_24697":57764,"_17272":96912,"_5":17167,"_23367":96837,"_2365":42608},[],{"_2837":57790,"_24697":57764,"_17272":96914,"_5":17167,"_23367":96837,"_2365":96915},[],"La identidad ha vencido.",{"_2837":57791,"_24697":57764,"_17272":96917,"_5":17167,"_23367":96837,"_2365":42614},[],{"_2837":57792,"_24697":57764,"_17272":96919,"_5":17167,"_23367":96837,"_2365":96920},[],"La identidad está marcada como revocada.",{"_2837":57793,"_24697":57764,"_17272":96922,"_5":17167,"_23367":96837,"_2365":42620},[],{"_2837":57794,"_24697":57764,"_17272":96924,"_5":17167,"_23367":96837,"_2365":96925},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2837":57795,"_24697":57764,"_17272":96927,"_5":17167,"_23367":96837,"_2365":96928},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2837":57796,"_24697":57764,"_17272":96930,"_5":17167,"_23367":96841,"_2365":96931},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2837":57797,"_24697":57764,"_17272":96933,"_5":17167,"_23367":96841,"_2365":96934},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2837":57798,"_24697":57764,"_17272":96936,"_5":17167,"_23367":96841,"_2365":96937},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2837":57799,"_24697":57764,"_17272":96939,"_5":17167,"_23367":96841,"_2365":96940},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2837":57800,"_24697":57764,"_17272":96942,"_5":17167,"_23367":96845,"_2365":96943},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2837":57801,"_24697":57764,"_17272":96945,"_5":17167,"_23367":96849,"_2365":96946},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2837":57802,"_24697":57764,"_17272":96948,"_5":17167,"_23367":96853,"_2365":96949},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2837":57803,"_24697":57764,"_17272":96951,"_5":17167,"_23367":96857,"_2365":96952},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2837":57804,"_24697":57764,"_17272":96954,"_5":17167,"_23367":96861,"_2365":96955},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2837":57805,"_24697":57764,"_17272":96957,"_5":17167,"_23367":96861,"_2365":96958},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2837":57806,"_24697":57764,"_17272":96960,"_5":17167,"_23367":96865,"_2365":96961},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2837":57807,"_24697":57764,"_17272":96963,"_5":17167,"_23367":96865,"_2365":96964},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2837":57808,"_24697":57764,"_17272":96966,"_5":17167,"_23367":96865,"_2365":96967},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2837":57809,"_24697":57764,"_17272":96969,"_5":17167,"_23367":96865,"_2365":96970},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2837":57810,"_24697":57764,"_17272":96972,"_5":17167,"_23367":96865,"_2365":96973},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2837":57811,"_24697":57764,"_17272":96975,"_5":17167,"_23367":96865,"_2365":96976},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2837":57812,"_24697":57764,"_17272":96978,"_5":17167,"_23367":96869,"_2365":96979},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2837":57813,"_24697":57764,"_17272":96981,"_5":17167,"_23367":96869,"_2365":96982},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2837":57814,"_24697":57764,"_17272":96984,"_5":17167,"_23367":96873,"_2365":96985},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2837":57815,"_24697":57764,"_17272":96987,"_5":17167,"_23367":96873,"_2365":96988},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2837":57816,"_24697":57764,"_17272":96990,"_5":17167,"_23367":96873,"_2365":96991},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2837":57817,"_24697":57764,"_17272":96993,"_5":17167,"_23367":96873,"_2365":96994},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2837":57818,"_24697":57764,"_17272":96996,"_5":17167,"_23367":96877,"_2365":96997},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2837":57819,"_24697":57764,"_17272":96999,"_5":17167,"_23367":96877,"_2365":97000},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2837":57820,"_24697":57820,"_5":12136,"_2365":97002,"_25033":97003,"_17272":97005,"_23367":57820},"Identidad inicial y autenticación",[40259,95913,42521,96829,97004],"Enrolamiento con PKI",[],{"_2837":57821,"_24697":57820,"_17272":97007,"_5":17167,"_23367":57820,"_2365":97008},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2837":57822,"_24697":57820,"_5":25030,"_17272":97010,"_23367":97011,"_2365":97012},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2837":57823,"_24697":57820,"_5":25030,"_17272":97014,"_23367":97015,"_2365":97016},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2837":57824,"_24697":57820,"_5":25030,"_17272":97018,"_23367":97019,"_2365":97020},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2837":57825,"_24697":57820,"_5":25030,"_17272":97022,"_23367":97023,"_2365":97024},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2837":57826,"_24697":57820,"_5":25030,"_17272":97026,"_23367":97027,"_2365":97028},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2837":57827,"_24697":57820,"_17272":97030,"_5":17167,"_23367":57820,"_2365":97031},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2837":57828,"_24697":57820,"_17272":97033,"_5":17167,"_23367":97011,"_2365":97034},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2837":57829,"_24697":57820,"_17272":97036,"_5":17167,"_23367":97011,"_2365":97037},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2837":57830,"_24697":57820,"_17272":97039,"_5":17167,"_23367":97015,"_2365":97040},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2837":57831,"_24697":57820,"_17272":97042,"_5":17167,"_23367":97015,"_2365":97043},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2837":57832,"_24697":57820,"_17272":97045,"_5":17167,"_23367":97015,"_2365":97046},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2837":57833,"_24697":57820,"_17272":97048,"_5":17167,"_23367":97019,"_2365":97049},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2837":57834,"_24697":57820,"_17272":97051,"_5":17167,"_23367":97019,"_2365":97052},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2837":57835,"_24697":57820,"_17272":97054,"_5":17167,"_23367":97023,"_2365":97055},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2837":57836,"_24697":57820,"_17272":97057,"_5":17167,"_23367":97023,"_2365":97058},[],"Ejemplo de cuerpo:",{"_2837":57837,"_24697":57820,"_17272":97060,"_5":17167,"_23367":97023,"_2365":97061},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2837":57838,"_24697":57820,"_17272":97063,"_5":17167,"_23367":97023,"_2365":97064},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2837":57839,"_24697":57820,"_17272":97066,"_5":17167,"_23367":97023,"_2365":97067},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2837":57840,"_24697":57820,"_17272":97069,"_5":17167,"_23367":97023,"_2365":97070},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2837":57841,"_24697":57820,"_17272":97072,"_5":17167,"_23367":97027,"_2365":97073},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2837":57842,"_24697":57820,"_17272":97075,"_5":17167,"_23367":97027,"_2365":97076},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2837":57843,"_24697":57843,"_5":12136,"_2365":97078,"_25033":97079,"_17272":97080,"_23367":57843},"Configura y opera el DMS",[40259,95913,42521,96829,97004],[],{"_2837":57844,"_24697":57843,"_17272":97082,"_5":17167,"_23367":57843,"_2365":97083},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2837":57845,"_24697":57843,"_5":25030,"_17272":97085,"_23367":97086,"_2365":94614},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2837":57846,"_24697":57843,"_5":25030,"_17272":97088,"_23367":97089,"_2365":97090},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2837":57847,"_24697":57843,"_5":25030,"_17272":97092,"_23367":97093,"_2365":97094},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2837":57848,"_24697":57843,"_5":25030,"_17272":97096,"_23367":97097,"_2365":97098},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2837":57849,"_24697":57843,"_5":25030,"_17272":97100,"_23367":97101,"_2365":97102},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2837":57850,"_24697":57843,"_5":25030,"_17272":97104,"_23367":97105,"_2365":97106},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2837":57851,"_24697":57843,"_5":25030,"_17272":97108,"_23367":97109,"_2365":97110},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2837":57852,"_24697":57843,"_5":25030,"_17272":97112,"_23367":97113,"_2365":97114},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2837":57853,"_24697":57843,"_5":25030,"_17272":97116,"_23367":97117,"_2365":42816},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2837":57854,"_24697":57843,"_5":25030,"_17272":97119,"_23367":97120,"_2365":42820},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2837":57855,"_24697":57843,"_5":25030,"_17272":97122,"_23367":97123,"_2365":97124},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2837":57856,"_24697":57843,"_5":25030,"_17272":97126,"_23367":97127,"_2365":97128},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2837":57857,"_24697":57843,"_5":25030,"_17272":97130,"_23367":97131,"_2365":97132},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2837":57858,"_24697":57843,"_5":25030,"_17272":97134,"_23367":97135,"_2365":97136},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2837":57859,"_24697":57843,"_5":25030,"_17272":97138,"_23367":97139,"_2365":42840},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2837":57860,"_24697":57843,"_5":25030,"_17272":97141,"_23367":97142,"_2365":97143},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2837":57861,"_24697":57843,"_5":25030,"_17272":97145,"_23367":97146,"_2365":97147},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2837":57862,"_24697":57843,"_5":25030,"_17272":97149,"_23367":97150,"_2365":97151},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2837":57863,"_24697":57843,"_17272":97153,"_5":17167,"_23367":57843,"_2365":97154},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2837":57864,"_24697":57843,"_17272":97156,"_5":17167,"_23367":97086,"_2365":97157},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2837":57865,"_24697":57843,"_17272":97159,"_5":17167,"_23367":97086,"_2365":97160},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2837":57866,"_24697":57843,"_17272":97162,"_5":17167,"_23367":97093,"_2365":97163},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2837":57867,"_24697":57843,"_17272":97165,"_5":17167,"_23367":97097,"_2365":97166},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2837":57868,"_24697":57843,"_17272":97168,"_5":17167,"_23367":97101,"_2365":97169},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2837":57869,"_24697":57843,"_17272":97171,"_5":17167,"_23367":97105,"_2365":97172},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2837":57870,"_24697":57843,"_17272":97174,"_5":17167,"_23367":97109,"_2365":97175},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2837":57871,"_24697":57843,"_17272":97177,"_5":17167,"_23367":97117,"_2365":97178},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2837":57872,"_24697":57843,"_17272":97180,"_5":17167,"_23367":97117,"_2365":97181},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2837":57873,"_24697":57843,"_17272":97183,"_5":17167,"_23367":97120,"_2365":97184},[],"Campo de `settings.enrollment_settings`",{"_2837":57874,"_24697":57843,"_17272":97186,"_5":17167,"_23367":97120,"_2365":97187},[],"Decisión",{"_2837":57875,"_24697":57843,"_17272":97189,"_5":17167,"_23367":97120,"_2365":42891},[],{"_2837":57876,"_24697":57843,"_17272":97191,"_5":17167,"_23367":97120,"_2365":97192},[],"`EST_RFC7030` para estas operaciones.",{"_2837":57877,"_24697":57843,"_17272":97194,"_5":17167,"_23367":97120,"_2365":42897},[],{"_2837":57878,"_24697":57843,"_17272":97196,"_5":17167,"_23367":97120,"_2365":97197},[],"ID de la CA que firmará.",{"_2837":57879,"_24697":57843,"_17272":97199,"_5":17167,"_23367":97120,"_2365":42903},[],{"_2837":57880,"_24697":57843,"_17272":97201,"_5":17167,"_23367":97120,"_2365":97202},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2837":57881,"_24697":57843,"_17272":97204,"_5":17167,"_23367":97120,"_2365":42909},[],{"_2837":57882,"_24697":57843,"_17272":97206,"_5":17167,"_23367":97120,"_2365":97207},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2837":57883,"_24697":57843,"_17272":97209,"_5":17167,"_23367":97120,"_2365":42915},[],{"_2837":57884,"_24697":57843,"_17272":97211,"_5":17167,"_23367":97120,"_2365":97212},[],"Uno de los cuatro modos de autenticación.",{"_2837":57885,"_24697":57843,"_17272":97214,"_5":17167,"_23367":97120,"_2365":97215},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2837":57886,"_24697":57843,"_17272":97217,"_5":17167,"_23367":97123,"_2365":97218},[],"Los bloques son independientes:",{"_2837":57887,"_24697":57843,"_17272":97220,"_5":17167,"_23367":97123,"_2365":97221},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2837":57888,"_24697":57843,"_17272":97223,"_5":17167,"_23367":97123,"_2365":97224},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2837":57889,"_24697":57843,"_17272":97226,"_5":17167,"_23367":97123,"_2365":42933},[],{"_2837":57890,"_24697":57843,"_17272":97228,"_5":17167,"_23367":97123,"_2365":97229},[],"Control aplicado en la operación configurada",{"_2837":57891,"_24697":57843,"_17272":97231,"_5":17167,"_23367":97123,"_2365":42939},[],{"_2837":57892,"_24697":57843,"_17272":97233,"_5":17167,"_23367":97123,"_2365":97234},[],"Validación del certificado presentado.",{"_2837":57893,"_24697":57843,"_17272":97236,"_5":17167,"_23367":97123,"_2365":42945},[],{"_2837":57894,"_24697":57843,"_17272":97238,"_5":17167,"_23367":97123,"_2365":97239},[],"Autorización del webhook configurado.",{"_2837":57895,"_24697":57843,"_17272":97241,"_5":17167,"_23367":97123,"_2365":42951},[],{"_2837":57896,"_24697":57843,"_17272":97243,"_5":17167,"_23367":97123,"_2365":97244},[],"Validación del certificado y, después, aprobación del webhook.",{"_2837":57897,"_24697":57843,"_17272":97246,"_5":17167,"_23367":97123,"_2365":42957},[],{"_2837":57898,"_24697":57843,"_17272":97248,"_5":17167,"_23367":97123,"_2365":97249},[],"Sin autenticación del solicitante por el DMS.",{"_2837":57899,"_24697":57843,"_17272":97251,"_5":17167,"_23367":97123,"_2365":97252},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2837":57900,"_24697":57843,"_17272":97254,"_5":17167,"_23367":97123,"_2365":97255},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2837":57901,"_24697":57843,"_17272":97257,"_5":17167,"_23367":97123,"_2365":97258},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2837":57902,"_24697":57843,"_17272":97260,"_5":17167,"_23367":97123,"_2365":97261},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2837":57903,"_24697":57843,"_17272":97263,"_5":17167,"_23367":97127,"_2365":97264},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2837":57904,"_24697":57843,"_17272":97266,"_5":17167,"_23367":97127,"_2365":97267},[],"Campo de `external_webhook_settings`",{"_2837":57905,"_24697":57843,"_17272":97269,"_5":17167,"_23367":97127,"_2365":97187},[],{"_2837":57906,"_24697":57843,"_17272":97271,"_5":17167,"_23367":97127,"_2365":42983},[],{"_2837":57907,"_24697":57843,"_17272":97273,"_5":17167,"_23367":97127,"_2365":97274},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2837":57908,"_24697":57843,"_17272":97276,"_5":17167,"_23367":97127,"_2365":42989},[],{"_2837":57909,"_24697":57843,"_17272":97278,"_5":17167,"_23367":97127,"_2365":97279},[],"`POST` o `PUT`; `POST` por defecto.",{"_2837":57910,"_24697":57843,"_17272":97281,"_5":17167,"_23367":97127,"_2365":42995},[],{"_2837":57911,"_24697":57843,"_17272":97283,"_5":17167,"_23367":97127,"_2365":97284},[],"Etiqueta usada en los logs del servicio.",{"_2837":57912,"_24697":57843,"_17272":97286,"_5":17167,"_23367":97127,"_2365":43001},[],{"_2837":57913,"_24697":57843,"_17272":97288,"_5":17167,"_23367":97127,"_2365":97289},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2837":57914,"_24697":57843,"_17272":97291,"_5":17167,"_23367":97127,"_2365":43007},[],{"_2837":57915,"_24697":57843,"_17272":97293,"_5":17167,"_23367":97127,"_2365":97294},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2837":57916,"_24697":57843,"_17272":97296,"_5":17167,"_23367":97127,"_2365":43013},[],{"_2837":57917,"_24697":57843,"_17272":97298,"_5":17167,"_23367":97127,"_2365":97299},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2837":57918,"_24697":57843,"_17272":97301,"_5":17167,"_23367":97127,"_2365":43019},[],{"_2837":57919,"_24697":57843,"_17272":97303,"_5":17167,"_23367":97127,"_2365":97304},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2837":57920,"_24697":57843,"_17272":97306,"_5":17167,"_23367":97127,"_2365":43025},[],{"_2837":57921,"_24697":57843,"_17272":97308,"_5":17167,"_23367":97127,"_2365":97309},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2837":57922,"_24697":57843,"_17272":97311,"_5":17167,"_23367":97127,"_2365":43031},[],{"_2837":57923,"_24697":57843,"_17272":97313,"_5":17167,"_23367":97127,"_2365":97314},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2837":57924,"_24697":57843,"_17272":97316,"_5":17167,"_23367":97127,"_2365":97317},[],"Reglas de esa configuración:",{"_2837":57925,"_24697":57843,"_17272":97319,"_5":17167,"_23367":97127,"_2365":97320},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2837":57926,"_24697":57843,"_17272":97322,"_5":17167,"_23367":97127,"_2365":97323},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2837":57927,"_24697":57843,"_17272":97325,"_5":17167,"_23367":97127,"_2365":97326},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2837":57928,"_24697":57843,"_17272":97328,"_5":17167,"_23367":97127,"_2365":97329},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2837":57929,"_24697":57843,"_17272":97331,"_5":17167,"_23367":97127,"_2365":97332},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2837":57930,"_24697":57843,"_17272":97334,"_5":17167,"_23367":97127,"_2365":97335},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2837":57931,"_24697":57843,"_17272":97337,"_5":17167,"_23367":97127,"_2365":97338},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2837":57932,"_24697":57843,"_17272":97340,"_5":17167,"_23367":97127,"_2365":97341},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS.",{"_2837":57933,"_24697":57843,"_17272":97343,"_5":17167,"_23367":97131,"_2365":97344},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2837":57934,"_24697":57843,"_17272":97346,"_5":17167,"_23367":97135,"_2365":97347},[],"Campo de `settings.reenrollment_settings`",{"_2837":57935,"_24697":57843,"_17272":97349,"_5":17167,"_23367":97135,"_2365":97350},[],"Función",{"_2837":57936,"_24697":57843,"_17272":97352,"_5":17167,"_23367":97135,"_2365":43072},[],{"_2837":57937,"_24697":57843,"_17272":97354,"_5":17167,"_23367":97135,"_2365":97355},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2837":57938,"_24697":57843,"_17272":97357,"_5":17167,"_23367":97135,"_2365":43078},[],{"_2837":57939,"_24697":57843,"_17272":97359,"_5":17167,"_23367":97135,"_2365":97360},[],"Umbral operativo preventivo de monitorización.",{"_2837":57940,"_24697":57843,"_17272":97362,"_5":17167,"_23367":97135,"_2365":43084},[],{"_2837":57941,"_24697":57843,"_17272":97364,"_5":17167,"_23367":97135,"_2365":97365},[],"Umbral operativo crítico de monitorización.",{"_2837":57942,"_24697":57843,"_17272":97367,"_5":17167,"_23367":97135,"_2365":43090},[],{"_2837":57943,"_24697":57843,"_17272":97369,"_5":17167,"_23367":97135,"_2365":97370},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2837":57944,"_24697":57843,"_17272":97372,"_5":17167,"_23367":97135,"_2365":43096},[],{"_2837":57945,"_24697":57843,"_17272":97374,"_5":17167,"_23367":97135,"_2365":97375},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2837":57946,"_24697":57843,"_17272":97377,"_5":17167,"_23367":97135,"_2365":43102},[],{"_2837":57947,"_24697":57843,"_17272":97379,"_5":17167,"_23367":97135,"_2365":97380},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2837":57948,"_24697":57843,"_17272":97382,"_5":17167,"_23367":97135,"_2365":97383},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2837":57949,"_24697":57843,"_17272":97385,"_5":17167,"_23367":97139,"_2365":97386},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2837":57950,"_24697":57843,"_17272":97388,"_5":17167,"_23367":97142,"_2365":94971},[],{"_2837":57951,"_24697":57843,"_17272":97390,"_5":17167,"_23367":97142,"_2365":97391},[],"Qué publica",{"_2837":57952,"_24697":57843,"_17272":97393,"_5":17167,"_23367":97142,"_2365":43119},[],{"_2837":57953,"_24697":57843,"_17272":97395,"_5":17167,"_23367":97142,"_2365":97396},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2837":57954,"_24697":57843,"_17272":97398,"_5":17167,"_23367":97142,"_2365":43125},[],{"_2837":57955,"_24697":57843,"_17272":97400,"_5":17167,"_23367":97142,"_2365":97401},[],"Certificado de la CA emisora seleccionada.",{"_2837":57956,"_24697":57843,"_17272":97403,"_5":17167,"_23367":97142,"_2365":43131},[],{"_2837":57957,"_24697":57843,"_17272":97405,"_5":17167,"_23367":97142,"_2365":97406},[],"Certificados de las CAs elegidas explícitamente.",{"_2837":57958,"_24697":57843,"_17272":97408,"_5":17167,"_23367":97142,"_2365":97409},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2837":57959,"_24697":57843,"_17272":97411,"_5":17167,"_23367":97146,"_2365":97412},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2837":57960,"_24697":57843,"_17272":97414,"_5":17167,"_23367":97146,"_2365":97415},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2837":57961,"_24697":57843,"_17272":97417,"_5":17167,"_23367":97146,"_2365":97418},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2837":57962,"_24697":57843,"_17272":97420,"_5":17167,"_23367":97150,"_2365":97421},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2837":57963,"_24697":57963,"_5":12136,"_2365":97423,"_25033":97424,"_17272":97425,"_23367":57963},"Integra el cliente EST",[40259,95913,42521,96829,97004],[],{"_2837":57964,"_24697":57963,"_17272":97427,"_5":17167,"_23367":57963,"_2365":97428},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2837":57965,"_24697":57963,"_5":25030,"_17272":97430,"_23367":97431,"_2365":94614},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2837":57966,"_24697":57963,"_5":25030,"_17272":97433,"_23367":97434,"_2365":97435},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2837":57967,"_24697":57963,"_5":25030,"_17272":97437,"_23367":97438,"_2365":97439},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2837":57968,"_24697":57963,"_5":25030,"_17272":97441,"_23367":97442,"_2365":97443},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2837":57969,"_24697":57963,"_5":25030,"_17272":97445,"_23367":97446,"_2365":97447},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2837":57970,"_24697":57963,"_5":25030,"_17272":97449,"_23367":97450,"_2365":97451},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2837":57971,"_24697":57963,"_17272":97453,"_5":17167,"_23367":57963,"_2365":97454},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2837":57972,"_24697":57963,"_17272":97456,"_5":17167,"_23367":97431,"_2365":97457},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2837":57973,"_24697":57963,"_17272":97459,"_5":17167,"_23367":97431,"_2365":97460},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2837":57974,"_24697":57963,"_17272":97462,"_5":17167,"_23367":97431,"_2365":97463},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2837":57975,"_24697":57963,"_17272":97465,"_5":17167,"_23367":97434,"_2365":97466},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2837":57976,"_24697":57963,"_17272":97468,"_5":17167,"_23367":97434,"_2365":97469},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2837":57977,"_24697":57963,"_17272":97471,"_5":17167,"_23367":97438,"_2365":97472},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2837":57978,"_24697":57963,"_17272":97474,"_5":17167,"_23367":97438,"_2365":97475},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2837":57979,"_24697":57963,"_17272":97477,"_5":17167,"_23367":97442,"_2365":97478},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2837":57980,"_24697":57963,"_17272":97480,"_5":17167,"_23367":97442,"_2365":97481},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2837":57981,"_24697":57963,"_17272":97483,"_5":17167,"_23367":97446,"_2365":97484},[],"Para el caso de una raíz que emite directamente:",{"_2837":57982,"_24697":57963,"_17272":97486,"_5":17167,"_23367":97446,"_2365":97487},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2837":57983,"_24697":57963,"_17272":97489,"_5":17167,"_23367":97446,"_2365":97490},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2837":57984,"_24697":57963,"_17272":97492,"_5":17167,"_23367":97450,"_2365":97493},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2837":57985,"_24697":57985,"_5":12136,"_2365":97495,"_25033":97496,"_17272":97497,"_23367":57985},"Referencia EST",[40259,95913,42521,96829,97004],[],{"_2837":57986,"_24697":57985,"_17272":97499,"_5":17167,"_23367":57985,"_2365":97500},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2837":57987,"_24697":57985,"_5":25030,"_17272":97502,"_23367":97503,"_2365":97504},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2837":57988,"_24697":57985,"_5":25030,"_17272":97506,"_23367":97507,"_2365":18728},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2837":57989,"_24697":57985,"_5":25030,"_17272":97509,"_23367":97510,"_2365":21476},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2837":57990,"_24697":57985,"_5":25030,"_17272":97512,"_23367":97513,"_2365":21483},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2837":57991,"_24697":57985,"_5":25030,"_17272":97515,"_23367":97516,"_2365":20853},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2837":57992,"_24697":57985,"_5":25030,"_17272":97518,"_23367":97519,"_2365":97520},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2837":57993,"_24697":57985,"_5":25030,"_17272":97522,"_23367":97523,"_2365":97524},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2837":57994,"_24697":57985,"_5":25030,"_17272":97526,"_23367":97527,"_2365":97528},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2837":57995,"_24697":57985,"_17272":97530,"_5":17167,"_23367":57985,"_2365":97531},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2837":57996,"_24697":57985,"_17272":97533,"_5":17167,"_23367":97503,"_2365":97534},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2837":57997,"_24697":57985,"_17272":97536,"_5":17167,"_23367":97503,"_2365":95704},[],{"_2837":57998,"_24697":57985,"_17272":97538,"_5":17167,"_23367":97503,"_2365":97539},[],"Método",{"_2837":57999,"_24697":57985,"_17272":97541,"_5":17167,"_23367":97503,"_2365":97542},[],"Autenticación y condición",{"_2837":58000,"_24697":57985,"_17272":97544,"_5":17167,"_23367":97503,"_2365":43274},[],{"_2837":58001,"_24697":57985,"_17272":97546,"_5":17167,"_23367":97503,"_2365":43277},[],{"_2837":58002,"_24697":57985,"_17272":97548,"_5":17167,"_23367":97503,"_2365":97549},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2837":58003,"_24697":57985,"_17272":97551,"_5":17167,"_23367":97503,"_2365":43283},[],{"_2837":58004,"_24697":57985,"_17272":97553,"_5":17167,"_23367":97503,"_2365":43286},[],{"_2837":58005,"_24697":57985,"_17272":97555,"_5":17167,"_23367":97503,"_2365":97556},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2837":58006,"_24697":57985,"_17272":97558,"_5":17167,"_23367":97503,"_2365":43292},[],{"_2837":58007,"_24697":57985,"_17272":97560,"_5":17167,"_23367":97503,"_2365":43286},[],{"_2837":58008,"_24697":57985,"_17272":97562,"_5":17167,"_23367":97503,"_2365":97563},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2837":58009,"_24697":57985,"_17272":97565,"_5":17167,"_23367":97503,"_2365":43300},[],{"_2837":58010,"_24697":57985,"_17272":97567,"_5":17167,"_23367":97503,"_2365":43286},[],{"_2837":58011,"_24697":57985,"_17272":97569,"_5":17167,"_23367":97503,"_2365":97570},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2837":58012,"_24697":57985,"_17272":97572,"_5":17167,"_23367":97503,"_2365":97573},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2837":58013,"_24697":57985,"_17272":97575,"_5":17167,"_23367":97507,"_2365":97576},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2837":58014,"_24697":57985,"_17272":97578,"_5":17167,"_23367":97507,"_2365":97579},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2837":58015,"_24697":57985,"_17272":97581,"_5":17167,"_23367":97510,"_2365":97582},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2837":58016,"_24697":57985,"_17272":97584,"_5":17167,"_23367":97510,"_2365":97585},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2837":58017,"_24697":57985,"_17272":97587,"_5":17167,"_23367":97513,"_2365":97588},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2837":58018,"_24697":57985,"_17272":97590,"_5":17167,"_23367":97513,"_2365":97591},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2837":58019,"_24697":57985,"_17272":97593,"_5":17167,"_23367":97516,"_2365":97594},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2837":58020,"_24697":57985,"_17272":97596,"_5":17167,"_23367":97516,"_2365":97597},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2837":58021,"_24697":57985,"_17272":97599,"_5":17167,"_23367":97519,"_2365":97600},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2837":58022,"_24697":57985,"_17272":97602,"_5":17167,"_23367":97519,"_2365":97603},[],"Parte",{"_2837":58023,"_24697":57985,"_17272":97605,"_5":17167,"_23367":97519,"_2365":97606},[],"Contenido tras decodificar su Base64",{"_2837":58024,"_24697":57985,"_17272":97608,"_5":17167,"_23367":97519,"_2365":43344},[],{"_2837":58025,"_24697":57985,"_17272":97610,"_5":17167,"_23367":97519,"_2365":97611},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2837":58026,"_24697":57985,"_17272":97613,"_5":17167,"_23367":97519,"_2365":43350},[],{"_2837":58027,"_24697":57985,"_17272":97615,"_5":17167,"_23367":97519,"_2365":97616},[],"PKCS#7 DER con el certificado emitido.",{"_2837":58028,"_24697":57985,"_17272":97618,"_5":17167,"_23367":97519,"_2365":97619},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2837":58029,"_24697":57985,"_17272":97621,"_5":17167,"_23367":97523,"_2365":97622},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2837":58030,"_24697":57985,"_17272":97624,"_5":17167,"_23367":97523,"_2365":97625},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2837":58031,"_24697":57985,"_17272":97627,"_5":17167,"_23367":97523,"_2365":97628},[],"Convierte y comprueba el resultado:",{"_2837":58032,"_24697":57985,"_17272":97630,"_5":17167,"_23367":97523,"_2365":97631},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2837":58033,"_24697":57985,"_17272":97633,"_5":17167,"_23367":97527,"_2365":97634},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2837":58034,"_24697":57985,"_17272":97636,"_5":17167,"_23367":97527,"_2365":97637},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2837":58035,"_24697":58035,"_5":12136,"_2365":97004,"_25033":97639,"_17272":97640,"_23367":58035},[40259,95913,42521,96829,97004],[],{"_2837":58036,"_24697":58035,"_17272":97642,"_5":17167,"_23367":58035,"_2365":97643},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2837":58037,"_24697":58035,"_5":25030,"_17272":97645,"_23367":97646,"_2365":97647},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2837":58038,"_24697":58035,"_5":25030,"_17272":97649,"_23367":97650,"_2365":97651},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2837":58039,"_24697":58035,"_5":25030,"_17272":97653,"_23367":97654,"_2365":97655},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2837":58040,"_24697":58035,"_5":25030,"_17272":97657,"_23367":97658,"_2365":97659},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2837":58041,"_24697":58035,"_17272":97661,"_5":17167,"_23367":58035,"_2365":97662},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2837":58042,"_24697":58035,"_17272":97664,"_5":17167,"_23367":97646,"_2365":97665},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2837":58043,"_24697":58035,"_17272":97667,"_5":17167,"_23367":97646,"_2365":97668},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2837":58044,"_24697":58035,"_17272":97670,"_5":17167,"_23367":97646,"_2365":97671},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2837":58045,"_24697":58035,"_17272":97673,"_5":17167,"_23367":97646,"_2365":97674},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2837":58046,"_24697":58035,"_17272":97676,"_5":17167,"_23367":97646,"_2365":97677},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2837":58047,"_24697":58035,"_17272":97679,"_5":17167,"_23367":97646,"_2365":97680},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2837":58048,"_24697":58035,"_17272":97682,"_5":17167,"_23367":97650,"_2365":97683},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2837":58049,"_24697":58035,"_17272":97685,"_5":17167,"_23367":97650,"_2365":97686},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2837":58050,"_24697":58035,"_17272":97688,"_5":17167,"_23367":97650,"_2365":97689},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2837":58051,"_24697":58035,"_17272":97691,"_5":17167,"_23367":97650,"_2365":97692},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2837":58052,"_24697":58035,"_17272":97694,"_5":17167,"_23367":97654,"_2365":97695},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2837":58053,"_24697":58035,"_17272":97697,"_5":17167,"_23367":97654,"_2365":97698},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2837":58054,"_24697":58035,"_17272":97700,"_5":17167,"_23367":97654,"_2365":97701},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2837":58055,"_24697":58035,"_17272":97703,"_5":17167,"_23367":97654,"_2365":97704},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2837":58056,"_24697":58035,"_17272":97706,"_5":17167,"_23367":97658,"_2365":97707},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2837":58057,"_24697":58035,"_17272":97709,"_5":17167,"_23367":97658,"_2365":97710},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2837":58058,"_24697":58058,"_5":12136,"_2365":97712,"_25033":97713,"_17272":97714,"_23367":58058},"Estrategias de aprovisionamiento",[40259,95913,42521,96829,97004],[],{"_2837":58059,"_24697":58058,"_17272":97716,"_5":17167,"_23367":58058,"_2365":97717},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2837":58060,"_24697":58058,"_5":25030,"_17272":97719,"_23367":97720,"_2365":97721},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2837":58061,"_24697":58058,"_5":25030,"_17272":97723,"_23367":97724,"_2365":97725},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2837":58062,"_24697":58058,"_5":25030,"_17272":97727,"_23367":97728,"_2365":97729},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2837":58063,"_24697":58058,"_5":25030,"_17272":97731,"_23367":97732,"_2365":97733},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2837":58064,"_24697":58058,"_5":25030,"_17272":97735,"_23367":97736,"_2365":97737},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2837":58065,"_24697":58058,"_17272":97739,"_5":17167,"_23367":58058,"_2365":97740},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2837":58066,"_24697":58058,"_17272":97742,"_5":17167,"_23367":97720,"_2365":97743},[],"Recorrido",{"_2837":58067,"_24697":58058,"_17272":97745,"_5":17167,"_23367":97720,"_2365":97746},[],"Cuándo existe el dispositivo",{"_2837":58068,"_24697":58058,"_17272":97748,"_5":17167,"_23367":97720,"_2365":97749},[],"Qué compruebas",{"_2837":58069,"_24697":58058,"_17272":97751,"_5":17167,"_23367":97720,"_2365":97752},[],"Asignación manual",{"_2837":58070,"_24697":58058,"_17272":97754,"_5":17167,"_23367":97720,"_2365":97755},[],"El operador lo crea antes de asociar un certificado.",{"_2837":58071,"_24697":58058,"_17272":97757,"_5":17167,"_23367":97720,"_2365":97758},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2837":58072,"_24697":58058,"_17272":97760,"_5":17167,"_23367":97720,"_2365":97761},[],"EST con `JITP`",{"_2837":58073,"_24697":58058,"_17272":97763,"_5":17167,"_23367":97720,"_2365":97764},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2837":58074,"_24697":58058,"_17272":97766,"_5":17167,"_23367":97720,"_2365":97767},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2837":58075,"_24697":58058,"_17272":97769,"_5":17167,"_23367":97720,"_2365":97770},[],"EST con `PRE_REGISTRATION`",{"_2837":58076,"_24697":58058,"_17272":97772,"_5":17167,"_23367":97720,"_2365":97773},[],"Debe existir antes de `/simpleenroll`.",{"_2837":58077,"_24697":58058,"_17272":97775,"_5":17167,"_23367":97720,"_2365":97776},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2837":58078,"_24697":58058,"_17272":97778,"_5":17167,"_23367":97720,"_2365":97779},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2837":58079,"_24697":58058,"_17272":97781,"_5":17167,"_23367":97720,"_2365":97782},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2837":58080,"_24697":58058,"_17272":97784,"_5":17167,"_23367":97724,"_2365":97785},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2837":58081,"_24697":58058,"_17272":97787,"_5":17167,"_23367":97724,"_2365":97788},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2837":58082,"_24697":58058,"_17272":97790,"_5":17167,"_23367":97724,"_2365":97791},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2837":58083,"_24697":58058,"_17272":97793,"_5":17167,"_23367":97728,"_2365":97794},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2837":58084,"_24697":58058,"_17272":97796,"_5":17167,"_23367":97728,"_2365":97797},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2837":58085,"_24697":58058,"_17272":97799,"_5":17167,"_23367":97728,"_2365":97800},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2837":58086,"_24697":58058,"_17272":97802,"_5":17167,"_23367":97728,"_2365":97803},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2837":58087,"_24697":58058,"_17272":97805,"_5":17167,"_23367":97728,"_2365":97806},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2837":58088,"_24697":58058,"_17272":97808,"_5":17167,"_23367":97728,"_2365":97809},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2837":58089,"_24697":58058,"_17272":97811,"_5":17167,"_23367":97732,"_2365":94971},[],{"_2837":58090,"_24697":58058,"_17272":97813,"_5":17167,"_23367":97732,"_2365":97814},[],"Material que atraviesa EST",{"_2837":58091,"_24697":58058,"_17272":97816,"_5":17167,"_23367":97732,"_2365":97817},[],"Clave generada por el dispositivo",{"_2837":58092,"_24697":58058,"_17272":97819,"_5":17167,"_23367":97732,"_2365":97820},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2837":58093,"_24697":58058,"_17272":97822,"_5":17167,"_23367":97732,"_2365":97823},[],"Clave ya disponible en el dispositivo",{"_2837":58094,"_24697":58058,"_17272":97825,"_5":17167,"_23367":97732,"_2365":97826},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2837":58095,"_24697":58058,"_17272":97828,"_5":17167,"_23367":97732,"_2365":42840},[],{"_2837":58096,"_24697":58058,"_17272":97830,"_5":17167,"_23367":97732,"_2365":97831},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2837":58097,"_24697":58058,"_17272":97833,"_5":17167,"_23367":97732,"_2365":97834},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2837":58098,"_24697":58058,"_17272":97836,"_5":17167,"_23367":97736,"_2365":97837},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2837":58099,"_24697":58099,"_5":12136,"_2365":97839,"_25033":97840,"_17272":97841,"_23367":58099},"Renovación y recuperación",[40259,95913,42521,96829,97004],[],{"_2837":58100,"_24697":58099,"_17272":97843,"_5":17167,"_23367":58099,"_2365":97844},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2837":58101,"_24697":58099,"_5":25030,"_17272":97846,"_23367":97847,"_2365":97848},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2837":58102,"_24697":58099,"_5":25030,"_17272":97850,"_23367":97851,"_2365":97852},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2837":58103,"_24697":58099,"_5":25030,"_17272":97854,"_23367":97855,"_2365":97856},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2837":58104,"_24697":58099,"_5":25030,"_17272":97858,"_23367":97859,"_2365":97860},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2837":58105,"_24697":58099,"_5":25030,"_17272":97862,"_23367":97863,"_2365":97864},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2837":58106,"_24697":58099,"_17272":97866,"_5":17167,"_23367":58099,"_2365":97867},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2837":58107,"_24697":58099,"_17272":97869,"_5":17167,"_23367":97847,"_2365":97870},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2837":58108,"_24697":58099,"_17272":97872,"_5":17167,"_23367":97847,"_2365":97873},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2837":58109,"_24697":58099,"_17272":97875,"_5":17167,"_23367":97847,"_2365":97876},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2837":58110,"_24697":58099,"_17272":97878,"_5":17167,"_23367":97847,"_2365":97879},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2837":58111,"_24697":58099,"_17272":97881,"_5":17167,"_23367":97851,"_2365":97882},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2837":58112,"_24697":58099,"_17272":97884,"_5":17167,"_23367":97851,"_2365":97885},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2837":58113,"_24697":58099,"_17272":97887,"_5":17167,"_23367":97855,"_2365":97888},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2837":58114,"_24697":58099,"_17272":97890,"_5":17167,"_23367":97855,"_2365":97891},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2837":58115,"_24697":58099,"_17272":97893,"_5":17167,"_23367":97855,"_2365":97894},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2837":58116,"_24697":58099,"_17272":97896,"_5":17167,"_23367":97859,"_2365":97897},[],"Situación",{"_2837":58117,"_24697":58099,"_17272":97899,"_5":17167,"_23367":97859,"_2365":97900},[],"Procedimiento",{"_2837":58118,"_24697":58099,"_17272":97902,"_5":17167,"_23367":97859,"_2365":97903},[],"Certificado vigente, fuera de ventana",{"_2837":58119,"_24697":58099,"_17272":97905,"_5":17167,"_23367":97859,"_2365":97906},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2837":58120,"_24697":58099,"_17272":97908,"_5":17167,"_23367":97859,"_2365":97909},[],"Certificado vencido, clave disponible",{"_2837":58121,"_24697":58099,"_17272":97911,"_5":17167,"_23367":97859,"_2365":97912},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2837":58122,"_24697":58099,"_17272":97914,"_5":17167,"_23367":97859,"_2365":97915},[],"Renovación por webhook o `NO_AUTH`",{"_2837":58123,"_24697":58099,"_17272":97917,"_5":17167,"_23367":97859,"_2365":97918},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2837":58124,"_24697":58099,"_17272":97920,"_5":17167,"_23367":97859,"_2365":97921},[],"Clave perdida o inaccesible",{"_2837":58125,"_24697":58099,"_17272":97923,"_5":17167,"_23367":97859,"_2365":97924},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2837":58126,"_24697":58099,"_17272":97926,"_5":17167,"_23367":97859,"_2365":97927},[],"Identidad actual revocada",{"_2837":58127,"_24697":58099,"_17272":97929,"_5":17167,"_23367":97859,"_2365":97930},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2837":58128,"_24697":58099,"_17272":97932,"_5":17167,"_23367":97859,"_2365":97933},[],"Dispositivo sin identidad",{"_2837":58129,"_24697":58099,"_17272":97935,"_5":17167,"_23367":97859,"_2365":97936},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2837":58130,"_24697":58099,"_17272":97938,"_5":17167,"_23367":97859,"_2365":97939},[],"Dispositivo retirado",{"_2837":58131,"_24697":58099,"_17272":97941,"_5":17167,"_23367":97859,"_2365":97942},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2837":58132,"_24697":58099,"_17272":97944,"_5":17167,"_23367":97859,"_2365":97945},[],"Timeout, HTTP 500 o fallo de instalación",{"_2837":58133,"_24697":58099,"_17272":97947,"_5":17167,"_23367":97859,"_2365":97948},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2837":58134,"_24697":58099,"_17272":97950,"_5":17167,"_23367":97863,"_2365":97951},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2837":58135,"_24697":58099,"_17272":97953,"_5":17167,"_23367":97863,"_2365":97954},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2837":58136,"_24697":58136,"_5":12136,"_2365":97956,"_25033":97957,"_17272":97958,"_23367":58136},"Diagnóstico de enrolamiento",[40259,95913,42521,96829,97004],[],{"_2837":58137,"_24697":58136,"_17272":97960,"_5":17167,"_23367":58136,"_2365":97961},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2837":58138,"_24697":58136,"_5":25030,"_17272":97963,"_23367":97964,"_2365":97965},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2837":58139,"_24697":58136,"_5":25030,"_17272":97967,"_23367":97968,"_2365":97969},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2837":58140,"_24697":58136,"_5":25030,"_17272":97971,"_23367":97972,"_2365":97528},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2837":58141,"_24697":58136,"_5":25030,"_17272":97974,"_23367":97975,"_2365":97976},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2837":58142,"_24697":58136,"_17272":97978,"_5":17167,"_23367":58136,"_2365":97979},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2837":58143,"_24697":58136,"_17272":97981,"_5":17167,"_23367":97968,"_2365":97982},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2837":58144,"_24697":58136,"_17272":97984,"_5":17167,"_23367":97968,"_2365":97985},[],"Síntoma o mensaje",{"_2837":58145,"_24697":58136,"_17272":97987,"_5":17167,"_23367":97968,"_2365":97988},[],"Qué revisar",{"_2837":58146,"_24697":58136,"_17272":97990,"_5":17167,"_23367":97968,"_2365":97991},[],"curl rechaza TLS, nombre o emisor",{"_2837":58147,"_24697":58136,"_17272":97993,"_5":17167,"_23367":97968,"_2365":97994},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2837":58148,"_24697":58136,"_17272":97996,"_5":17167,"_23367":97968,"_2365":97997},[],"404 o APS ausente",{"_2837":58149,"_24697":58136,"_17272":97999,"_5":17167,"_23367":97968,"_2365":98000},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2837":58150,"_24697":58136,"_17272":98002,"_5":17167,"_23367":97968,"_2365":98003},[],"400, error de CSR o formato",{"_2837":58151,"_24697":58136,"_17272":98005,"_5":17167,"_23367":97968,"_2365":98006},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2837":58152,"_24697":58136,"_17272":98008,"_5":17167,"_23367":97968,"_2365":98009},[],"Credencial ausente o certificado no válido",{"_2837":58153,"_24697":58136,"_17272":98011,"_5":17167,"_23367":97968,"_2365":98012},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2837":58154,"_24697":58136,"_17272":98014,"_5":17167,"_23367":97968,"_2365":98015},[],"Webhook deniega, expira o responde sin autorización",{"_2837":58155,"_24697":58136,"_17272":98017,"_5":17167,"_23367":97968,"_2365":98018},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2837":58156,"_24697":58136,"_17272":98020,"_5":17167,"_23367":97968,"_2365":43757},[],{"_2837":58157,"_24697":58136,"_17272":98022,"_5":17167,"_23367":97968,"_2365":98023},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2837":58158,"_24697":58136,"_17272":98025,"_5":17167,"_23367":97968,"_2365":43763},[],{"_2837":58159,"_24697":58136,"_17272":98027,"_5":17167,"_23367":97968,"_2365":98028},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2837":58160,"_24697":58136,"_17272":98030,"_5":17167,"_23367":97968,"_2365":43769},[],{"_2837":58161,"_24697":58136,"_17272":98032,"_5":17167,"_23367":97968,"_2365":98033},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el PEM como `cert_content` y `key_content`; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2837":58162,"_24697":58136,"_17272":98035,"_5":17167,"_23367":97968,"_2365":98036},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2837":58163,"_24697":58136,"_17272":98038,"_5":17167,"_23367":97968,"_2365":98039},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2837":58164,"_24697":58136,"_17272":98041,"_5":17167,"_23367":97968,"_2365":98042},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2837":58165,"_24697":58136,"_17272":98044,"_5":17167,"_23367":97968,"_2365":98045},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2837":58166,"_24697":58136,"_17272":98047,"_5":17167,"_23367":97968,"_2365":43787},[],{"_2837":58167,"_24697":58136,"_17272":98049,"_5":17167,"_23367":97968,"_2365":98050},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2837":58168,"_24697":58136,"_17272":98052,"_5":17167,"_23367":97968,"_2365":43793},[],{"_2837":58169,"_24697":58136,"_17272":98054,"_5":17167,"_23367":97968,"_2365":98055},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2837":58170,"_24697":58136,"_17272":98057,"_5":17167,"_23367":97968,"_2365":98058},[],"DMS propietario distinto",{"_2837":58171,"_24697":58136,"_17272":98060,"_5":17167,"_23367":97968,"_2365":98061},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2837":58172,"_24697":58136,"_17272":98063,"_5":17167,"_23367":97968,"_2365":43805},[],{"_2837":58173,"_24697":58136,"_17272":98065,"_5":17167,"_23367":97968,"_2365":98066},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2837":58174,"_24697":58136,"_17272":98068,"_5":17167,"_23367":97968,"_2365":43811},[],{"_2837":58175,"_24697":58136,"_17272":98070,"_5":17167,"_23367":97968,"_2365":98071},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2837":58176,"_24697":58136,"_17272":98073,"_5":17167,"_23367":97968,"_2365":98074},[],"Certificado actual revocado",{"_2837":58177,"_24697":58136,"_17272":98076,"_5":17167,"_23367":97968,"_2365":98077},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2837":58178,"_24697":58136,"_17272":98079,"_5":17167,"_23367":97968,"_2365":98080},[],"Error de CA, perfil o firma",{"_2837":58179,"_24697":58136,"_17272":98082,"_5":17167,"_23367":97968,"_2365":98083},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2837":58180,"_24697":58136,"_17272":98085,"_5":17167,"_23367":97968,"_2365":98086},[],"HTTP 200 sin conexión del dispositivo",{"_2837":58181,"_24697":58136,"_17272":98088,"_5":17167,"_23367":97968,"_2365":98089},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2837":58182,"_24697":58136,"_17272":98091,"_5":17167,"_23367":97968,"_2365":98092},[],"Timeout o error después de emitir",{"_2837":58183,"_24697":58136,"_17272":98094,"_5":17167,"_23367":97968,"_2365":98095},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2837":58184,"_24697":58136,"_17272":98097,"_5":17167,"_23367":97972,"_2365":98098},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2837":58185,"_24697":58136,"_17272":98100,"_5":17167,"_23367":97972,"_2365":98101},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2837":58186,"_24697":58136,"_17272":98103,"_5":17167,"_23367":97975,"_2365":98104},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2837":58187,"_24697":58136,"_17272":98106,"_5":17167,"_23367":97975,"_2365":98107},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2837":58188,"_24697":58136,"_17272":98109,"_5":17167,"_23367":97975,"_2365":98110},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2837":58189,"_24697":58136,"_17272":98112,"_5":17167,"_23367":97975,"_2365":98113},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2837":58190,"_24697":58136,"_17272":98115,"_5":17167,"_23367":97975,"_2365":98116},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2837":58191,"_24697":58136,"_17272":98118,"_5":17167,"_23367":97975,"_2365":98119},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2837":58192,"_24697":58136,"_17272":98121,"_5":17167,"_23367":97975,"_2365":98122},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2837":58193,"_24697":58193,"_5":12136,"_2365":98124,"_25033":98125,"_17272":98126,"_23367":58193},"Distribución y actualización de confianza",[40259,95913,42521,96829,97004],[],{"_2837":58194,"_24697":58193,"_17272":98128,"_5":17167,"_23367":58193,"_2365":98129},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2837":58195,"_24697":58193,"_5":25030,"_17272":98131,"_23367":98132,"_2365":98133},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2837":58196,"_24697":58193,"_5":25030,"_17272":98135,"_23367":98136,"_2365":98137},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2837":58197,"_24697":58193,"_5":25030,"_17272":98139,"_23367":98140,"_2365":98141},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2837":58198,"_24697":58193,"_5":25030,"_17272":98143,"_23367":98144,"_2365":98145},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2837":58199,"_24697":58193,"_5":25030,"_17272":98147,"_23367":98148,"_2365":98149},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2837":58200,"_24697":58193,"_17272":98151,"_5":17167,"_23367":58193,"_2365":98152},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2837":58201,"_24697":58193,"_17272":98154,"_5":17167,"_23367":98132,"_2365":98155},[],"Relación",{"_2837":58202,"_24697":58193,"_17272":98157,"_5":17167,"_23367":98132,"_2365":98158},[],"Material que prepara el responsable",{"_2837":58203,"_24697":58193,"_17272":98160,"_5":17167,"_23367":98132,"_2365":98161},[],"Dispositivo → servidor EST",{"_2837":58204,"_24697":58193,"_17272":98163,"_5":17167,"_23367":98132,"_2365":98164},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2837":58205,"_24697":58193,"_17272":98166,"_5":17167,"_23367":98132,"_2365":98167},[],"DMS → solicitante",{"_2837":58206,"_24697":58193,"_17272":98169,"_5":17167,"_23367":98132,"_2365":98170},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2837":58207,"_24697":58193,"_17272":98172,"_5":17167,"_23367":98132,"_2365":98173},[],"Consumidor → dispositivo",{"_2837":58208,"_24697":58193,"_17272":98175,"_5":17167,"_23367":98132,"_2365":98176},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2837":58209,"_24697":58193,"_17272":98178,"_5":17167,"_23367":98132,"_2365":98179},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2837":58210,"_24697":58193,"_17272":98181,"_5":17167,"_23367":98136,"_2365":98182},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2837":58211,"_24697":58193,"_17272":98184,"_5":17167,"_23367":98136,"_2365":98185},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2837":58212,"_24697":58193,"_17272":98187,"_5":17167,"_23367":98140,"_2365":98188},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2837":58213,"_24697":58193,"_17272":98190,"_5":17167,"_23367":98140,"_2365":98191},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2837":58214,"_24697":58193,"_17272":98193,"_5":17167,"_23367":98140,"_2365":98194},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2837":58215,"_24697":58193,"_17272":98196,"_5":17167,"_23367":98140,"_2365":98197},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2837":58216,"_24697":58193,"_17272":98199,"_5":17167,"_23367":98140,"_2365":98200},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2837":58217,"_24697":58193,"_17272":98202,"_5":17167,"_23367":98140,"_2365":98203},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2837":58218,"_24697":58193,"_17272":98205,"_5":17167,"_23367":98144,"_2365":98206},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2837":58219,"_24697":58193,"_17272":98208,"_5":17167,"_23367":98144,"_2365":98209},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2837":58220,"_24697":58193,"_17272":98211,"_5":17167,"_23367":98144,"_2365":98212},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2837":58221,"_24697":58193,"_17272":98214,"_5":17167,"_23367":98148,"_2365":98215},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2837":58222,"_24697":58222,"_5":12136,"_2365":43960,"_25033":98217,"_17272":98219,"_23367":58222},[40259,95913,42521,96829,98218],"Integraciones",[],{"_2837":58223,"_24697":58222,"_17272":98221,"_5":17167,"_23367":58222,"_2365":98222},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2837":58224,"_24697":58222,"_5":25030,"_17272":98224,"_23367":98225,"_2365":98226},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2837":58225,"_24697":58222,"_5":25030,"_17272":98228,"_23367":98229,"_2365":98230},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2837":58226,"_24697":58222,"_5":25030,"_17272":98232,"_23367":98233,"_2365":98234},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2837":58227,"_24697":58222,"_5":25030,"_17272":98236,"_23367":98237,"_2365":98238},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2837":58228,"_24697":58222,"_5":25030,"_17272":98240,"_23367":98241,"_2365":98242},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2837":58229,"_24697":58222,"_5":25030,"_17272":98244,"_23367":98245,"_2365":98246},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2837":58230,"_24697":58222,"_5":25030,"_17272":98248,"_23367":98249,"_2365":43994},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2837":58231,"_24697":58222,"_5":25030,"_17272":98251,"_23367":98252,"_2365":43998},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2837":58232,"_24697":58222,"_5":25030,"_17272":98254,"_23367":98255,"_2365":98256},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2837":58233,"_24697":58222,"_5":25030,"_17272":98258,"_23367":98259,"_2365":98260},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2837":58234,"_24697":58222,"_5":25030,"_17272":98262,"_23367":98263,"_2365":98264},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2837":58235,"_24697":58222,"_5":25030,"_17272":98266,"_23367":98267,"_2365":98268},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2837":58236,"_24697":58222,"_5":25030,"_17272":98270,"_23367":98271,"_2365":98272},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2837":58237,"_24697":58222,"_5":25030,"_17272":98274,"_23367":98275,"_2365":98276},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2837":58238,"_24697":58222,"_5":25030,"_17272":98278,"_23367":98279,"_2365":98280},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2837":58239,"_24697":58222,"_5":25030,"_17272":98282,"_23367":98283,"_2365":98284},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2837":58240,"_24697":58222,"_5":25030,"_17272":98286,"_23367":98287,"_2365":98288},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2837":58241,"_24697":58222,"_5":25030,"_17272":98290,"_23367":98291,"_2365":98292},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2837":58242,"_24697":58222,"_5":25030,"_17272":98294,"_23367":98295,"_2365":98296},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2837":58243,"_24697":58222,"_5":25030,"_17272":98298,"_23367":98299,"_2365":98300},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2837":58244,"_24697":58222,"_17272":98302,"_5":17167,"_23367":58222,"_2365":98303},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2837":58245,"_24697":58222,"_17272":98305,"_5":17167,"_23367":58222,"_2365":98306},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2837":58246,"_24697":58222,"_17272":98308,"_5":17167,"_23367":58222,"_2365":98309},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2837":58247,"_24697":58222,"_17272":98311,"_5":17167,"_23367":98225,"_2365":98312},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2837":58248,"_24697":58222,"_17272":98314,"_5":17167,"_23367":98225,"_2365":98315},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2837":58249,"_24697":58222,"_17272":98317,"_5":17167,"_23367":98225,"_2365":98318},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2837":58250,"_24697":58222,"_17272":98320,"_5":17167,"_23367":98225,"_2365":98321},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2837":58251,"_24697":58222,"_17272":98323,"_5":17167,"_23367":98229,"_2365":98324},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2837":58252,"_24697":58222,"_17272":98326,"_5":17167,"_23367":98233,"_2365":98327},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2837":58253,"_24697":58222,"_17272":98329,"_5":17167,"_23367":98233,"_2365":98330},[],"Acción IAM",{"_2837":58254,"_24697":58222,"_17272":98332,"_5":17167,"_23367":98233,"_2365":94977},[],{"_2837":58255,"_24697":58222,"_17272":98334,"_5":17167,"_23367":98233,"_2365":44081},[],{"_2837":58256,"_24697":58222,"_17272":98336,"_5":17167,"_23367":98233,"_2365":98337},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2837":58257,"_24697":58222,"_17272":98339,"_5":17167,"_23367":98233,"_2365":44087},[],{"_2837":58258,"_24697":58222,"_17272":98341,"_5":17167,"_23367":98233,"_2365":98342},[],"Registrar la CA en AWS IoT",{"_2837":58259,"_24697":58222,"_17272":98344,"_5":17167,"_23367":98233,"_2365":44093},[],{"_2837":58260,"_24697":58222,"_17272":98346,"_5":17167,"_23367":98233,"_2365":98347},[],"Consultar el estado del registro de la CA",{"_2837":58261,"_24697":58222,"_17272":98349,"_5":17167,"_23367":98233,"_2365":44099},[],{"_2837":58262,"_24697":58222,"_17272":98351,"_5":17167,"_23367":98233,"_2365":98352},[],"Crear o actualizar Things en IoT Core",{"_2837":58263,"_24697":58222,"_17272":98354,"_5":17167,"_23367":98233,"_2365":44105},[],{"_2837":58264,"_24697":58222,"_17272":98356,"_5":17167,"_23367":98233,"_2365":98357},[],"Aprovisionar Things mediante plantilla",{"_2837":58265,"_24697":58222,"_17272":98359,"_5":17167,"_23367":98233,"_2365":44111},[],{"_2837":58266,"_24697":58222,"_17272":98361,"_5":17167,"_23367":98233,"_2365":98362},[],"Registrar certificados de dispositivo",{"_2837":58267,"_24697":58222,"_17272":98364,"_5":17167,"_23367":98233,"_2365":44117},[],{"_2837":58268,"_24697":58222,"_17272":98366,"_5":17167,"_23367":98233,"_2365":98367},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2837":58269,"_24697":58222,"_17272":98369,"_5":17167,"_23367":98233,"_2365":44123},[],{"_2837":58270,"_24697":58222,"_17272":98371,"_5":17167,"_23367":98233,"_2365":98372},[],"Crear y adjuntar políticas IoT",{"_2837":58271,"_24697":58222,"_17272":98374,"_5":17167,"_23367":98233,"_2365":44129},[],{"_2837":58272,"_24697":58222,"_17272":98376,"_5":17167,"_23367":98233,"_2365":98377},[],"Gestionar grupos de Things",{"_2837":58273,"_24697":58222,"_17272":98379,"_5":17167,"_23367":98233,"_2365":44135},[],{"_2837":58274,"_24697":58222,"_17272":98381,"_5":17167,"_23367":98233,"_2365":98382},[],"Crear plantillas JITP",{"_2837":58275,"_24697":58222,"_17272":98384,"_5":17167,"_23367":98233,"_2365":44141},[],{"_2837":58276,"_24697":58222,"_17272":98386,"_5":17167,"_23367":98233,"_2365":98387},[],"Leer y escribir el Device Shadow",{"_2837":58277,"_24697":58222,"_17272":98389,"_5":17167,"_23367":98233,"_2365":98390},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2837":58278,"_24697":58222,"_17272":98392,"_5":17167,"_23367":98237,"_2365":98393},[],"Parámetro",{"_2837":58279,"_24697":58222,"_17272":98395,"_5":17167,"_23367":98237,"_2365":98396},[],"Tipo",{"_2837":58280,"_24697":58222,"_17272":98398,"_5":17167,"_23367":98237,"_2365":98399},[],"Requerido",{"_2837":58281,"_24697":58222,"_17272":98401,"_5":17167,"_23367":98237,"_2365":98402},[],"Descripción",{"_2837":58282,"_24697":58222,"_17272":98404,"_5":17167,"_23367":98237,"_2365":44162},[],{"_2837":58283,"_24697":58222,"_17272":98406,"_5":17167,"_23367":98237,"_2365":20597},[],{"_2837":58284,"_24697":58222,"_17272":98408,"_5":17167,"_23367":98237,"_2365":98409},[],"Sí",{"_2837":58285,"_24697":58222,"_17272":98411,"_5":17167,"_23367":98237,"_2365":98412},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2837":58286,"_24697":58222,"_17272":98414,"_5":17167,"_23367":98237,"_2365":44173},[],{"_2837":58287,"_24697":58222,"_17272":98416,"_5":17167,"_23367":98237,"_2365":20597},[],{"_2837":58288,"_24697":58222,"_17272":98418,"_5":17167,"_23367":98237,"_2365":98409},[],{"_2837":58289,"_24697":58222,"_17272":98420,"_5":17167,"_23367":98237,"_2365":98421},[],"Región AWS donde opera el conector.",{"_2837":58290,"_24697":58222,"_17272":98423,"_5":17167,"_23367":98237,"_2365":44183},[],{"_2837":58291,"_24697":58222,"_17272":98425,"_5":17167,"_23367":98237,"_2365":20597},[],{"_2837":58292,"_24697":58222,"_17272":98427,"_5":17167,"_23367":98237,"_2365":98409},[],{"_2837":58293,"_24697":58222,"_17272":98429,"_5":17167,"_23367":98237,"_2365":98430},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2837":58294,"_24697":58222,"_17272":98432,"_5":17167,"_23367":98237,"_2365":44193},[],{"_2837":58295,"_24697":58222,"_17272":98434,"_5":17167,"_23367":98237,"_2365":20597},[],{"_2837":58296,"_24697":58222,"_17272":98436,"_5":17167,"_23367":98237,"_2365":98437},[],"Solo con `auth_method=static`",{"_2837":58297,"_24697":58222,"_17272":98439,"_5":17167,"_23367":98237,"_2365":98440},[],"Clave de acceso AWS.",{"_2837":58298,"_24697":58222,"_17272":98442,"_5":17167,"_23367":98237,"_2365":44204},[],{"_2837":58299,"_24697":58222,"_17272":98444,"_5":17167,"_23367":98237,"_2365":20597},[],{"_2837":58300,"_24697":58222,"_17272":98446,"_5":17167,"_23367":98237,"_2365":98437},[],{"_2837":58301,"_24697":58222,"_17272":98448,"_5":17167,"_23367":98237,"_2365":98449},[],"Clave secreta AWS.",{"_2837":58302,"_24697":58222,"_17272":98451,"_5":17167,"_23367":98237,"_2365":44214},[],{"_2837":58303,"_24697":58222,"_17272":98453,"_5":17167,"_23367":98237,"_2365":20597},[],{"_2837":58304,"_24697":58222,"_17272":98455,"_5":17167,"_23367":98237,"_2365":44219},[],{"_2837":58305,"_24697":58222,"_17272":98457,"_5":17167,"_23367":98237,"_2365":98458},[],"Token de sesión (con `auth_method=static`).",{"_2837":58306,"_24697":58222,"_17272":98460,"_5":17167,"_23367":98237,"_2365":44225},[],{"_2837":58307,"_24697":58222,"_17272":98462,"_5":17167,"_23367":98237,"_2365":20597},[],{"_2837":58308,"_24697":58222,"_17272":98464,"_5":17167,"_23367":98237,"_2365":98465},[],"Solo con `auth_method=role`",{"_2837":58309,"_24697":58222,"_17272":98467,"_5":17167,"_23367":98237,"_2365":98468},[],"ARN del rol a asumir.",{"_2837":58310,"_24697":58222,"_17272":98470,"_5":17167,"_23367":98237,"_2365":44236},[],{"_2837":58311,"_24697":58222,"_17272":98472,"_5":17167,"_23367":98237,"_2365":20597},[],{"_2837":58312,"_24697":58222,"_17272":98474,"_5":17167,"_23367":98237,"_2365":44219},[],{"_2837":58313,"_24697":58222,"_17272":98476,"_5":17167,"_23367":98237,"_2365":98477},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2837":58314,"_24697":58222,"_17272":98479,"_5":17167,"_23367":98237,"_2365":44246},[],{"_2837":58315,"_24697":58222,"_17272":98481,"_5":17167,"_23367":98237,"_2365":14507},[],{"_2837":58316,"_24697":58222,"_17272":98483,"_5":17167,"_23367":98237,"_2365":98409},[],{"_2837":58317,"_24697":58222,"_17272":98485,"_5":17167,"_23367":98237,"_2365":98486},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2837":58318,"_24697":58222,"_17272":98488,"_5":17167,"_23367":98237,"_2365":44256},[],{"_2837":58319,"_24697":58222,"_17272":98490,"_5":17167,"_23367":98237,"_2365":20597},[],{"_2837":58320,"_24697":58222,"_17272":98492,"_5":17167,"_23367":98237,"_2365":98409},[],{"_2837":58321,"_24697":58222,"_17272":98494,"_5":17167,"_23367":98237,"_2365":98495},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2837":58322,"_24697":58222,"_17272":98497,"_5":17167,"_23367":98237,"_2365":44266},[],{"_2837":58323,"_24697":58222,"_17272":98499,"_5":17167,"_23367":98237,"_2365":20597},[],{"_2837":58324,"_24697":58222,"_17272":98501,"_5":17167,"_23367":98237,"_2365":98409},[],{"_2837":58325,"_24697":58222,"_17272":98503,"_5":17167,"_23367":98237,"_2365":98504},[],"URL HTTP del Device Manager de Lamassu.",{"_2837":58326,"_24697":58222,"_17272":98506,"_5":17167,"_23367":98237,"_2365":44276},[],{"_2837":58327,"_24697":58222,"_17272":98508,"_5":17167,"_23367":98237,"_2365":20597},[],{"_2837":58328,"_24697":58222,"_17272":98510,"_5":17167,"_23367":98237,"_2365":98409},[],{"_2837":58329,"_24697":58222,"_17272":98512,"_5":17167,"_23367":98237,"_2365":98513},[],"URL HTTP del servicio de CA de Lamassu.",{"_2837":58330,"_24697":58222,"_17272":98515,"_5":17167,"_23367":98241,"_2365":98516},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2837":58331,"_24697":58222,"_17272":98518,"_5":17167,"_23367":98245,"_2365":98519},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2837":58332,"_24697":58222,"_17272":98521,"_5":17167,"_23367":98245,"_2365":98522},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2837":58333,"_24697":58222,"_17272":98524,"_5":17167,"_23367":98249,"_2365":98525},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2837":58334,"_24697":58222,"_17272":98527,"_5":17167,"_23367":98249,"_2365":98528},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2837":58335,"_24697":58222,"_17272":98530,"_5":17167,"_23367":98249,"_2365":98531},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2837":58336,"_24697":58222,"_17272":98533,"_5":17167,"_23367":98249,"_2365":98534},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2837":58337,"_24697":58222,"_17272":98536,"_5":17167,"_23367":98249,"_2365":98537},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2837":58338,"_24697":58222,"_17272":98539,"_5":17167,"_23367":98249,"_2365":98540},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2837":58339,"_24697":58222,"_17272":98542,"_5":17167,"_23367":98252,"_2365":98543},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2837":58340,"_24697":58222,"_17272":98545,"_5":17167,"_23367":98255,"_2365":98546},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2837":58341,"_24697":58222,"_17272":98548,"_5":17167,"_23367":98255,"_2365":98549},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2837":58342,"_24697":58222,"_17272":98551,"_5":17167,"_23367":98259,"_2365":98552},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2837":58343,"_24697":58222,"_17272":98554,"_5":17167,"_23367":98263,"_2365":98555},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2837":58344,"_24697":58222,"_17272":98557,"_5":17167,"_23367":98263,"_2365":98558},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2837":58345,"_24697":58222,"_17272":98560,"_5":17167,"_23367":98263,"_2365":98561},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2837":58346,"_24697":58222,"_17272":98563,"_5":17167,"_23367":98263,"_2365":98564},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2837":58347,"_24697":58222,"_17272":98566,"_5":17167,"_23367":98263,"_2365":98567},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2837":58348,"_24697":58222,"_17272":98569,"_5":17167,"_23367":98263,"_2365":98570},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2837":58349,"_24697":58222,"_17272":98572,"_5":17167,"_23367":98267,"_2365":98573},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2837":58350,"_24697":58222,"_17272":98575,"_5":17167,"_23367":98267,"_2365":98576},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2837":58351,"_24697":58222,"_17272":98578,"_5":17167,"_23367":98267,"_2365":98579},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2837":58352,"_24697":58222,"_17272":98581,"_5":17167,"_23367":98271,"_2365":98582},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2837":58353,"_24697":58222,"_17272":98584,"_5":17167,"_23367":98271,"_2365":98585},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2837":58354,"_24697":58222,"_17272":98587,"_5":17167,"_23367":98271,"_2365":98588},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2837":58355,"_24697":58222,"_17272":98590,"_5":17167,"_23367":98275,"_2365":98591},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2837":58356,"_24697":58222,"_17272":98593,"_5":17167,"_23367":98275,"_2365":98594},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2837":58357,"_24697":58222,"_17272":98596,"_5":17167,"_23367":98275,"_2365":98597},[],"Para que el flujo JITP funcione correctamente:",{"_2837":58358,"_24697":58222,"_17272":98599,"_5":17167,"_23367":98275,"_2365":98600},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2837":58359,"_24697":58222,"_17272":98602,"_5":17167,"_23367":98275,"_2365":98603},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2837":58360,"_24697":58222,"_17272":98605,"_5":17167,"_23367":98275,"_2365":98606},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2837":58361,"_24697":58222,"_17272":98608,"_5":17167,"_23367":98275,"_2365":98609},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2837":58362,"_24697":58222,"_17272":98611,"_5":17167,"_23367":98279,"_2365":98612},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2837":58363,"_24697":58222,"_17272":98614,"_5":17167,"_23367":98279,"_2365":98615},[],"Estado en Lamassu",{"_2837":58364,"_24697":58222,"_17272":98617,"_5":17167,"_23367":98279,"_2365":98618},[],"Razón de revocación",{"_2837":58365,"_24697":58222,"_17272":98620,"_5":17167,"_23367":98279,"_2365":98621},[],"Estado en AWS IoT Core",{"_2837":58366,"_24697":58222,"_17272":98623,"_5":17167,"_23367":98279,"_2365":44397},[],{"_2837":58367,"_24697":58222,"_17272":98625,"_5":17167,"_23367":98279,"_2365":98626},[],"Ninguna",{"_2837":58368,"_24697":58222,"_17272":98628,"_5":17167,"_23367":98279,"_2365":44403},[],{"_2837":58369,"_24697":58222,"_17272":98630,"_5":17167,"_23367":98279,"_2365":44406},[],{"_2837":58370,"_24697":58222,"_17272":98632,"_5":17167,"_23367":98279,"_2365":44409},[],{"_2837":58371,"_24697":58222,"_17272":98634,"_5":17167,"_23367":98279,"_2365":44412},[],{"_2837":58372,"_24697":58222,"_17272":98636,"_5":17167,"_23367":98279,"_2365":44406},[],{"_2837":58373,"_24697":58222,"_17272":98638,"_5":17167,"_23367":98279,"_2365":98639},[],"Cualquier otra razón",{"_2837":58374,"_24697":58222,"_17272":98641,"_5":17167,"_23367":98279,"_2365":44420},[],{"_2837":58375,"_24697":58222,"_17272":98643,"_5":17167,"_23367":98279,"_2365":98644},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2837":58376,"_24697":58222,"_17272":98646,"_5":17167,"_23367":98283,"_2365":98647},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2837":58377,"_24697":58222,"_17272":98649,"_5":17167,"_23367":98283,"_2365":98650},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2837":58378,"_24697":58222,"_17272":98652,"_5":17167,"_23367":98283,"_2365":98653},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2837":58379,"_24697":58222,"_17272":98655,"_5":17167,"_23367":98287,"_2365":98656},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2837":58380,"_24697":58222,"_17272":98658,"_5":17167,"_23367":98287,"_2365":98659},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2837":58381,"_24697":58222,"_17272":98661,"_5":17167,"_23367":98291,"_2365":98662},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2837":58382,"_24697":58222,"_17272":98664,"_5":17167,"_23367":98291,"_2365":98665},[],"Existen dos tipos de acciones:",{"_2837":58383,"_24697":58222,"_17272":98667,"_5":17167,"_23367":98291,"_2365":98668},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2837":58384,"_24697":58222,"_17272":98670,"_5":17167,"_23367":98291,"_2365":98671},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2837":58385,"_24697":58222,"_17272":98673,"_5":17167,"_23367":98291,"_2365":98674},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2837":58386,"_24697":58222,"_17272":98676,"_5":17167,"_23367":98295,"_2365":98677},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2837":58387,"_24697":58222,"_17272":98679,"_5":17167,"_23367":98295,"_2365":98680},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2837":58388,"_24697":58222,"_17272":98682,"_5":17167,"_23367":98295,"_2365":98683},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2837":58389,"_24697":58222,"_17272":98685,"_5":17167,"_23367":98299,"_2365":98686},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2837":58390,"_24697":58222,"_17272":98688,"_5":17167,"_23367":98299,"_2365":98689},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2837":58391,"_24697":58222,"_17272":98691,"_5":17167,"_23367":98299,"_2365":98692},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2837":58392,"_24697":58222,"_17272":98694,"_5":17167,"_23367":98299,"_2365":98695},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2837":58393,"_24697":58222,"_17272":98697,"_5":17167,"_23367":98299,"_2365":98698},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2837":58394,"_24697":58222,"_17272":98700,"_5":17167,"_23367":98299,"_2365":98701},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2837":58395,"_24697":58222,"_17272":98703,"_5":17167,"_23367":98299,"_2365":98704},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2837":58396,"_24697":58222,"_17272":98706,"_5":17167,"_23367":98299,"_2365":98707},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2837":58397,"_24697":58222,"_17272":98709,"_5":17167,"_23367":98299,"_2365":98710},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2837":58398,"_24697":58222,"_17272":98712,"_5":17167,"_23367":98299,"_2365":98713},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2837":58399,"_24697":58222,"_17272":98715,"_5":17167,"_23367":98299,"_2365":98716},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2837":58400,"_24697":58222,"_17272":98718,"_5":17167,"_23367":98299,"_2365":98719},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2837":58401,"_24697":58222,"_17272":98721,"_5":17167,"_23367":98299,"_2365":98722},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2837":58402,"_24697":58222,"_17272":98724,"_5":17167,"_23367":98299,"_2365":98725},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2837":58403,"_24697":58222,"_17272":98727,"_5":17167,"_23367":98299,"_2365":98728},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2837":58404,"_24697":58222,"_17272":98730,"_5":17167,"_23367":98299,"_2365":98731},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2837":58405,"_24697":58222,"_17272":98733,"_5":17167,"_23367":98299,"_2365":98734},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2837":58406,"_24697":58222,"_17272":98736,"_5":17167,"_23367":98299,"_2365":98737},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2837":58407,"_24697":58222,"_17272":98739,"_5":17167,"_23367":98299,"_2365":98740},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2837":58408,"_24697":58222,"_17272":98742,"_5":17167,"_23367":98299,"_2365":98743},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2837":58409,"_24697":58222,"_17272":98745,"_5":17167,"_23367":98299,"_2365":98746},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2837":58410,"_24697":58410,"_5":12136,"_2365":42521,"_25033":98748,"_17272":98749,"_23367":58410},[40259,95913,42521],[],{"_2837":58411,"_24697":58410,"_17272":98751,"_5":17167,"_23367":58410,"_2365":98752},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2837":58412,"_24697":58410,"_5":25030,"_17272":98754,"_23367":98755,"_2365":98756},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2837":58413,"_24697":58410,"_5":25030,"_17272":98758,"_23367":98759,"_2365":96829},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2837":58414,"_24697":58410,"_5":25030,"_17272":98761,"_23367":98762,"_2365":97004},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2837":58415,"_24697":58410,"_5":25030,"_17272":98764,"_23367":98765,"_2365":98218},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/overview#integraciones",{"_2837":58416,"_24697":58410,"_5":25030,"_17272":98767,"_23367":98768,"_2365":98769},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2837":58417,"_24697":58410,"_17272":98771,"_5":17167,"_23367":58410,"_2365":98772},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2837":58418,"_24697":58410,"_17272":98774,"_5":17167,"_23367":98755,"_2365":98775},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2837":58419,"_24697":58410,"_17272":98777,"_5":17167,"_23367":98755,"_2365":98778},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2837":58420,"_24697":58410,"_17272":98780,"_5":17167,"_23367":98759,"_2365":98781},[],"Recurso",{"_2837":58421,"_24697":58410,"_17272":98783,"_5":17167,"_23367":98759,"_2365":98784},[],"Qué representa",{"_2837":58422,"_24697":58410,"_17272":98786,"_5":17167,"_23367":98759,"_2365":98787},[],"**Dispositivo**",{"_2837":58423,"_24697":58410,"_17272":98789,"_5":17167,"_23367":98759,"_2365":98790},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2837":58424,"_24697":58410,"_17272":98792,"_5":17167,"_23367":98759,"_2365":98793},[],"**Identidad**",{"_2837":58425,"_24697":58410,"_17272":98795,"_5":17167,"_23367":98759,"_2365":98796},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2837":58426,"_24697":58410,"_17272":98798,"_5":17167,"_23367":98759,"_2365":44578},[],{"_2837":58427,"_24697":58410,"_17272":98800,"_5":17167,"_23367":98759,"_2365":98801},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2837":58428,"_24697":58410,"_17272":98803,"_5":17167,"_23367":98759,"_2365":98804},[],"**Flota**",{"_2837":58429,"_24697":58410,"_17272":98806,"_5":17167,"_23367":98759,"_2365":98807},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2837":58430,"_24697":58410,"_17272":98809,"_5":17167,"_23367":98759,"_2365":98810},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2837":58431,"_24697":58410,"_17272":98812,"_5":17167,"_23367":98759,"_2365":98813},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2837":58432,"_24697":58410,"_17272":98815,"_5":17167,"_23367":98762,"_2365":98816},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2837":58433,"_24697":58410,"_17272":98818,"_5":17167,"_23367":98762,"_2365":98819},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2837":58434,"_24697":58410,"_17272":98821,"_5":17167,"_23367":98762,"_2365":98822},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2837":58435,"_24697":58410,"_17272":98824,"_5":17167,"_23367":98762,"_2365":98825},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2837":58436,"_24697":58410,"_17272":98827,"_5":17167,"_23367":98762,"_2365":98828},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2837":58437,"_24697":58410,"_17272":98830,"_5":17167,"_23367":98762,"_2365":98831},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2837":58438,"_24697":58410,"_17272":98833,"_5":17167,"_23367":98762,"_2365":98834},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2837":58439,"_24697":58410,"_17272":98836,"_5":17167,"_23367":98762,"_2365":98837},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2837":58440,"_24697":58410,"_17272":98839,"_5":17167,"_23367":98765,"_2365":98840},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2837":58441,"_24697":58410,"_17272":98842,"_5":17167,"_23367":98765,"_2365":98843},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2837":58442,"_24697":58410,"_17272":98845,"_5":17167,"_23367":98768,"_2365":98846},[],"Participante",{"_2837":58443,"_24697":58410,"_17272":98848,"_5":17167,"_23367":98768,"_2365":98849},[],"Responsabilidad",{"_2837":58444,"_24697":58410,"_17272":98851,"_5":17167,"_23367":98768,"_2365":98852},[],"Administrador PKI",{"_2837":58445,"_24697":58410,"_17272":98854,"_5":17167,"_23367":98768,"_2365":98855},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2837":58446,"_24697":58410,"_17272":98857,"_5":17167,"_23367":98768,"_2365":98858},[],"Administrador del aprovisionamiento",{"_2837":58447,"_24697":58410,"_17272":98860,"_5":17167,"_23367":98768,"_2365":98861},[],"DMS, admisión, autenticación por operación e inventario.",{"_2837":58448,"_24697":58410,"_17272":98863,"_5":17167,"_23367":98768,"_2365":98864},[],"Integrador del dispositivo",{"_2837":58449,"_24697":58410,"_17272":98866,"_5":17167,"_23367":98768,"_2365":98867},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2837":58450,"_24697":58410,"_17272":98869,"_5":17167,"_23367":98768,"_2365":98870},[],"Integrador del consumidor",{"_2837":58451,"_24697":58410,"_17272":98872,"_5":17167,"_23367":98768,"_2365":98873},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2837":58452,"_24697":58410,"_17272":98875,"_5":17167,"_23367":98768,"_2365":98876},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2837":58453,"_24697":58453,"_5":12136,"_2365":98878,"_25033":98879,"_17272":98881,"_23367":58453},"Enrola y conecta tu primer dispositivo",[40259,95913,42521,98880],"Primeros pasos",[],{"_2837":58454,"_24697":58453,"_17272":98883,"_5":17167,"_23367":58453,"_2365":98884},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2837":58455,"_24697":58453,"_5":25030,"_17272":98886,"_23367":98887,"_2365":94614},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2837":58456,"_24697":58453,"_5":25030,"_17272":98889,"_23367":98890,"_2365":98891},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2837":58457,"_24697":58453,"_5":25030,"_17272":98893,"_23367":98894,"_2365":98895},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2837":58458,"_24697":58453,"_5":25030,"_17272":98897,"_23367":98898,"_2365":98899},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2837":58459,"_24697":58453,"_5":25030,"_17272":98901,"_23367":98902,"_2365":98903},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2837":58460,"_24697":58453,"_5":25030,"_17272":98905,"_23367":98906,"_2365":98907},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2837":58461,"_24697":58453,"_5":25030,"_17272":98909,"_23367":98910,"_2365":98911},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2837":58462,"_24697":58453,"_5":25030,"_17272":98913,"_23367":98914,"_2365":98915},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2837":58463,"_24697":58453,"_17272":98917,"_5":17167,"_23367":58453,"_2365":98918},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2837":58464,"_24697":58453,"_17272":98920,"_5":17167,"_23367":98887,"_2365":98921},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2837":58465,"_24697":58453,"_17272":98923,"_5":17167,"_23367":98887,"_2365":98924},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2837":58466,"_24697":58453,"_17272":98926,"_5":17167,"_23367":98887,"_2365":98927},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2837":58467,"_24697":58453,"_17272":98929,"_5":17167,"_23367":98887,"_2365":98930},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2837":58468,"_24697":58453,"_17272":98932,"_5":17167,"_23367":98887,"_2365":98933},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2837":58469,"_24697":58453,"_17272":98935,"_5":17167,"_23367":98890,"_2365":98936},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2837":58470,"_24697":58453,"_17272":98938,"_5":17167,"_23367":98890,"_2365":98939},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2837":58471,"_24697":58453,"_17272":98941,"_5":17167,"_23367":98894,"_2365":98942},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2837":58472,"_24697":58453,"_17272":98944,"_5":17167,"_23367":98894,"_2365":98945},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2837":58473,"_24697":58453,"_17272":98947,"_5":17167,"_23367":98894,"_2365":98948},[],"Ajuste",{"_2837":58474,"_24697":58453,"_17272":98950,"_5":17167,"_23367":98894,"_2365":98951},[],"Valor de evaluación",{"_2837":58475,"_24697":58453,"_17272":98953,"_5":17167,"_23367":98894,"_2365":44734},[],{"_2837":58476,"_24697":58453,"_17272":98955,"_5":17167,"_23367":98894,"_2365":98956},[],"Raíz emisora de `device-root.pem`.",{"_2837":58477,"_24697":58453,"_17272":98958,"_5":17167,"_23367":98894,"_2365":97132},[],{"_2837":58478,"_24697":58453,"_17272":98960,"_5":17167,"_23367":98894,"_2365":98961},[],"Perfil final de 1 hora que acabas de preparar.",{"_2837":58479,"_24697":58453,"_17272":98963,"_5":17167,"_23367":98894,"_2365":44745},[],{"_2837":58480,"_24697":58453,"_17272":98965,"_5":17167,"_23367":98894,"_2365":44748},[],{"_2837":58481,"_24697":58453,"_17272":98967,"_5":17167,"_23367":98894,"_2365":44751},[],{"_2837":58482,"_24697":58453,"_17272":98969,"_5":17167,"_23367":98894,"_2365":98970},[],"Habilitado.",{"_2837":58483,"_24697":58453,"_17272":98972,"_5":17167,"_23367":98894,"_2365":44757},[],{"_2837":58484,"_24697":58453,"_17272":98974,"_5":17167,"_23367":98894,"_2365":98975},[],"Deshabilitado; el ID debe ser nuevo.",{"_2837":58485,"_24697":58453,"_17272":98977,"_5":17167,"_23367":98894,"_2365":98978},[],"Autenticación inicial",{"_2837":58486,"_24697":58453,"_17272":98980,"_5":17167,"_23367":98894,"_2365":98981},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2837":58487,"_24697":58453,"_17272":98983,"_5":17167,"_23367":98894,"_2365":98984},[],"Autenticación de renovación",{"_2837":58488,"_24697":58453,"_17272":98986,"_5":17167,"_23367":98894,"_2365":98987},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2837":58489,"_24697":58453,"_17272":98989,"_5":17167,"_23367":98894,"_2365":44775},[],{"_2837":58490,"_24697":58453,"_17272":98991,"_5":17167,"_23367":98894,"_2365":98992},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2837":58491,"_24697":58453,"_17272":98994,"_5":17167,"_23367":98894,"_2365":44781},[],{"_2837":58492,"_24697":58453,"_17272":98996,"_5":17167,"_23367":98894,"_2365":98997},[],"1 hora.",{"_2837":58493,"_24697":58453,"_17272":98999,"_5":17167,"_23367":98894,"_2365":44787},[],{"_2837":58494,"_24697":58453,"_17272":99001,"_5":17167,"_23367":98894,"_2365":99002},[],"30 minutos / 10 minutos.",{"_2837":58495,"_24697":58453,"_17272":99004,"_5":17167,"_23367":98894,"_2365":44793},[],{"_2837":58496,"_24697":58453,"_17272":99006,"_5":17167,"_23367":98894,"_2365":99007},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2837":58497,"_24697":58453,"_17272":99009,"_5":17167,"_23367":98894,"_2365":42840},[],{"_2837":58498,"_24697":58453,"_17272":99011,"_5":17167,"_23367":98894,"_2365":99012},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2837":58499,"_24697":58453,"_17272":99014,"_5":17167,"_23367":98894,"_2365":44804},[],{"_2837":58500,"_24697":58453,"_17272":99016,"_5":17167,"_23367":98894,"_2365":99017},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2837":58501,"_24697":58453,"_17272":99019,"_5":17167,"_23367":98894,"_2365":99020},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2837":58502,"_24697":58453,"_17272":99022,"_5":17167,"_23367":98898,"_2365":99023},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2837":58503,"_24697":58453,"_17272":99025,"_5":17167,"_23367":98898,"_2365":99026},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2837":58504,"_24697":58453,"_17272":99028,"_5":17167,"_23367":98902,"_2365":99029},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2837":58505,"_24697":58453,"_17272":99031,"_5":17167,"_23367":98902,"_2365":99032},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2837":58506,"_24697":58453,"_17272":99034,"_5":17167,"_23367":98902,"_2365":99035},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2837":58507,"_24697":58453,"_17272":99037,"_5":17167,"_23367":98906,"_2365":99038},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2837":58508,"_24697":58453,"_17272":99040,"_5":17167,"_23367":98906,"_2365":99041},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2837":58509,"_24697":58453,"_17272":99043,"_5":17167,"_23367":98910,"_2365":99044},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2837":58510,"_24697":58453,"_17272":99046,"_5":17167,"_23367":98910,"_2365":99047},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2837":58511,"_24697":58453,"_17272":99049,"_5":17167,"_23367":98910,"_2365":99050},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2837":58512,"_24697":58453,"_17272":99052,"_5":17167,"_23367":98910,"_2365":99053},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2837":58513,"_24697":58453,"_17272":99055,"_5":17167,"_23367":98910,"_2365":99056},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2837":58514,"_24697":58453,"_17272":99058,"_5":17167,"_23367":98914,"_2365":99059},[],"Comprobación",{"_2837":58515,"_24697":58453,"_17272":99061,"_5":17167,"_23367":98914,"_2365":99062},[],"Resultado esperado",{"_2837":58516,"_24697":58453,"_17272":99064,"_5":17167,"_23367":98914,"_2365":99065},[],"Registro",{"_2837":58517,"_24697":58453,"_17272":99067,"_5":17167,"_23367":98914,"_2365":99068},[],"ID creado automáticamente y DMS correcto.",{"_2837":58518,"_24697":58453,"_17272":99070,"_5":17167,"_23367":98914,"_2365":99071},[],"Certificado",{"_2837":58519,"_24697":58453,"_17272":99073,"_5":17167,"_23367":98914,"_2365":99074},[],"CN, perfil, serie y clave verificados.",{"_2837":58520,"_24697":58453,"_17272":99076,"_5":17167,"_23367":98914,"_2365":99077},[],"Inventario",{"_2837":58521,"_24697":58453,"_17272":99079,"_5":17167,"_23367":98914,"_2365":99080},[],"Serie recibida visible como identidad actual y en el historial.",{"_2837":58522,"_24697":58453,"_17272":99082,"_5":17167,"_23367":98914,"_2365":99083},[],"Consumidor",{"_2837":58523,"_24697":58453,"_17272":99085,"_5":17167,"_23367":98914,"_2365":99086},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2837":58524,"_24697":58453,"_17272":99088,"_5":17167,"_23367":98914,"_2365":99089},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2837":58525,"_24697":58453,"_17272":99091,"_5":17167,"_23367":98914,"_2365":99092},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2837":58526,"_24697":58526,"_5":12136,"_2365":96846,"_25033":99094,"_17272":99095,"_23367":58526},[40259,95913,42521,98880],[],{"_2837":58527,"_24697":58526,"_17272":99097,"_5":17167,"_23367":58526,"_2365":99098},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2837":58528,"_24697":58526,"_5":25030,"_17272":99100,"_23367":99101,"_2365":94614},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2837":58529,"_24697":58526,"_5":25030,"_17272":99103,"_23367":99104,"_2365":99105},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2837":58530,"_24697":58526,"_5":25030,"_17272":99107,"_23367":99108,"_2365":99109},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2837":58531,"_24697":58526,"_5":25030,"_17272":99111,"_23367":99112,"_2365":99113},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2837":58532,"_24697":58526,"_5":25030,"_17272":99115,"_23367":99116,"_2365":99117},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2837":58533,"_24697":58526,"_5":25030,"_17272":99119,"_23367":99120,"_2365":99121},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2837":58534,"_24697":58526,"_5":25030,"_17272":99123,"_23367":99124,"_2365":99062},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2837":58535,"_24697":58526,"_5":25030,"_17272":99126,"_23367":99127,"_2365":99128},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2837":58536,"_24697":58526,"_5":25030,"_17272":99130,"_23367":99131,"_2365":99132},[],"/docs/pr-preview/pr-36/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2837":58537,"_24697":58526,"_17272":99134,"_5":17167,"_23367":58526,"_2365":99135},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2837":58538,"_24697":58526,"_17272":99137,"_5":17167,"_23367":58526,"_2365":99138},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2837":58539,"_24697":58526,"_17272":99140,"_5":17167,"_23367":99101,"_2365":99141},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2837":58540,"_24697":58526,"_17272":99143,"_5":17167,"_23367":99101,"_2365":99144},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2837":58541,"_24697":58526,"_17272":99146,"_5":17167,"_23367":99101,"_2365":99147},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2837":58542,"_24697":58526,"_17272":99149,"_5":17167,"_23367":99101,"_2365":99150},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2837":58543,"_24697":58526,"_17272":99152,"_5":17167,"_23367":99104,"_2365":99153},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2837":58544,"_24697":58526,"_17272":99155,"_5":17167,"_23367":99104,"_2365":99156},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2837":58545,"_24697":58526,"_17272":99158,"_5":17167,"_23367":99104,"_2365":99159},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2837":58546,"_24697":58526,"_17272":99161,"_5":17167,"_23367":99104,"_2365":99162},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2837":58547,"_24697":58526,"_17272":99164,"_5":17167,"_23367":99104,"_2365":99165},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2837":58548,"_24697":58526,"_17272":99167,"_5":17167,"_23367":99104,"_2365":99168},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2837":58549,"_24697":58526,"_17272":99170,"_5":17167,"_23367":99104,"_2365":99171},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2837":58550,"_24697":58526,"_17272":99173,"_5":17167,"_23367":99104,"_2365":99174},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2837":58551,"_24697":58526,"_17272":99176,"_5":17167,"_23367":99108,"_2365":99177},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2837":58552,"_24697":58526,"_17272":99179,"_5":17167,"_23367":99108,"_2365":44970},[],{"_2837":58553,"_24697":58526,"_17272":99181,"_5":17167,"_23367":99108,"_2365":99182},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2837":58554,"_24697":58526,"_17272":99184,"_5":17167,"_23367":99108,"_2365":99185},[],"**Icon** y **Tags**: clasificación opcional.",{"_2837":58555,"_24697":58526,"_17272":99187,"_5":17167,"_23367":99108,"_2365":99188},[],"Confirma el registro.",{"_2837":58556,"_24697":58526,"_17272":99190,"_5":17167,"_23367":99112,"_2365":99191},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2837":58557,"_24697":58526,"_17272":99193,"_5":17167,"_23367":99112,"_2365":99194},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2837":58558,"_24697":58526,"_17272":99196,"_5":17167,"_23367":99116,"_2365":99197},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2837":58559,"_24697":58526,"_17272":99199,"_5":17167,"_23367":99116,"_2365":99200},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2837":58560,"_24697":58526,"_17272":99202,"_5":17167,"_23367":99120,"_2365":99203},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2837":58561,"_24697":58526,"_17272":99205,"_5":17167,"_23367":99120,"_2365":99206},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2837":58562,"_24697":58526,"_17272":99208,"_5":17167,"_23367":99124,"_2365":99059},[],{"_2837":58563,"_24697":58526,"_17272":99210,"_5":17167,"_23367":99124,"_2365":99211},[],"Resultado",{"_2837":58564,"_24697":58526,"_17272":99213,"_5":17167,"_23367":99124,"_2365":99214},[],"Dispositivo",{"_2837":58565,"_24697":58526,"_17272":99216,"_5":17167,"_23367":99124,"_2365":99217},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2837":58566,"_24697":58526,"_17272":99219,"_5":17167,"_23367":99124,"_2365":99220},[],"Identidad actual",{"_2837":58567,"_24697":58526,"_17272":99222,"_5":17167,"_23367":99124,"_2365":99223},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2837":58568,"_24697":58526,"_17272":99225,"_5":17167,"_23367":99124,"_2365":99226},[],"Historial",{"_2837":58569,"_24697":58526,"_17272":99228,"_5":17167,"_23367":99124,"_2365":99229},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2837":58570,"_24697":58526,"_17272":99231,"_5":17167,"_23367":99124,"_2365":99232},[],"Clave y certificado",{"_2837":58571,"_24697":58526,"_17272":99234,"_5":17167,"_23367":99124,"_2365":99235},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2837":58572,"_24697":58526,"_17272":99237,"_5":17167,"_23367":99127,"_2365":99238},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2837":58573,"_24697":58526,"_17272":99240,"_5":17167,"_23367":99127,"_2365":99241},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2837":58574,"_24697":58526,"_17272":99243,"_5":17167,"_23367":99127,"_2365":99244},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2837":58575,"_24697":58526,"_17272":99246,"_5":17167,"_23367":99127,"_2365":99247},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2837":58576,"_24697":58526,"_17272":99249,"_5":17167,"_23367":99131,"_2365":99250},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2837":58577,"_24697":58526,"_17272":99252,"_5":17167,"_23367":99131,"_2365":99253},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2837":58578,"_24697":58526,"_17272":99255,"_5":17167,"_23367":99131,"_2365":99256},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2837":58579,"_24697":58579,"_5":12136,"_2365":99258,"_25033":99259,"_17272":99260,"_23367":58579},"Plataforma Lamassu IoT",[40259,95913],[],{"_2837":58580,"_24697":58579,"_17272":99262,"_5":17167,"_23367":58579,"_2365":99263},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2837":58581,"_24697":58579,"_5":25030,"_17272":99265,"_23367":99266,"_2365":98756},[],"/docs/pr-preview/pr-36/es/platform/overview#empieza-aquí",{"_2837":58582,"_24697":58579,"_5":25030,"_17272":99268,"_23367":99269,"_2365":99270},[],"/docs/pr-preview/pr-36/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2837":58583,"_24697":58579,"_5":25030,"_17272":99272,"_23367":99273,"_2365":99274},[],"/docs/pr-preview/pr-36/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2837":58584,"_24697":58579,"_5":25030,"_17272":99276,"_23367":99277,"_2365":99278},[],"/docs/pr-preview/pr-36/es/platform/overview#capacidades-principales","Capacidades principales",{"_2837":58585,"_24697":58579,"_5":25030,"_17272":99280,"_23367":99281,"_2365":99282},[],"/docs/pr-preview/pr-36/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2837":58586,"_24697":58579,"_5":25030,"_17272":99284,"_23367":99285,"_2365":99286},[],"/docs/pr-preview/pr-36/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2837":58587,"_24697":58579,"_5":25030,"_17272":99288,"_23367":99289,"_2365":99290},[],"/docs/pr-preview/pr-36/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2837":58588,"_24697":58579,"_5":25030,"_17272":99292,"_23367":99293,"_2365":99294},[],"/docs/pr-preview/pr-36/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2837":58589,"_24697":58579,"_5":25030,"_17272":99296,"_23367":99297,"_2365":99298},[],"/docs/pr-preview/pr-36/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2837":58590,"_24697":58579,"_5":25030,"_17272":99300,"_23367":99301,"_2365":99302},[],"/docs/pr-preview/pr-36/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2837":58591,"_24697":58579,"_5":25030,"_17272":99304,"_23367":99305,"_2365":99306},[],"/docs/pr-preview/pr-36/es/platform/overview#referencia-operativa","Referencia operativa",{"_2837":58592,"_24697":58579,"_17272":99308,"_5":17167,"_23367":58579,"_2365":99309},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2837":58593,"_24697":58579,"_17272":99311,"_5":17167,"_23367":99266,"_2365":99312},[],"Elige el resultado que necesitas obtener:",{"_2837":58594,"_24697":58579,"_17272":99314,"_5":17167,"_23367":99266,"_2365":99315},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2837":58595,"_24697":58579,"_17272":99317,"_5":17167,"_23367":99266,"_2365":99318},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2837":58596,"_24697":58579,"_17272":99320,"_5":17167,"_23367":99266,"_2365":99321},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2837":58597,"_24697":58579,"_17272":99323,"_5":17167,"_23367":99269,"_2365":99324},[],"Bloque",{"_2837":58598,"_24697":58579,"_17272":99326,"_5":17167,"_23367":99269,"_2365":99327},[],"Qué gestionas",{"_2837":58599,"_24697":58579,"_17272":99329,"_5":17167,"_23367":99269,"_2365":99330},[],"Punto de entrada",{"_2837":58600,"_24697":58579,"_17272":99332,"_5":17167,"_23367":99269,"_2365":45124},[],{"_2837":58601,"_24697":58579,"_17272":99334,"_5":17167,"_23367":99269,"_2365":99335},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2837":58602,"_24697":58579,"_17272":99337,"_5":17167,"_23367":99269,"_2365":99338},[],"Visión general de PKI",{"_2837":58603,"_24697":58579,"_17272":99340,"_5":17167,"_23367":99269,"_2365":45133},[],{"_2837":58604,"_24697":58579,"_17272":99342,"_5":17167,"_23367":99269,"_2365":99343},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2837":58605,"_24697":58579,"_17272":99345,"_5":17167,"_23367":99269,"_2365":99346},[],"Visión general de IoT Fleets",{"_2837":58606,"_24697":58579,"_17272":99348,"_5":17167,"_23367":99269,"_2365":99349},[],"**Administración**",{"_2837":58607,"_24697":58579,"_17272":99351,"_5":17167,"_23367":99269,"_2365":99352},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2837":58608,"_24697":58579,"_17272":99354,"_5":17167,"_23367":99269,"_2365":95911},[],{"_2837":58609,"_24697":58579,"_17272":99356,"_5":17167,"_23367":99269,"_2365":99357},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2837":58610,"_24697":58579,"_17272":99359,"_5":17167,"_23367":99273,"_2365":99360},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2837":58611,"_24697":58579,"_17272":99362,"_5":17167,"_23367":99273,"_2365":99363},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2837":58612,"_24697":58579,"_17272":99365,"_5":17167,"_23367":99273,"_2365":99366},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2837":58613,"_24697":58579,"_17272":99368,"_5":17167,"_23367":99273,"_2365":99369},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2837":58614,"_24697":58579,"_17272":99371,"_5":17167,"_23367":99273,"_2365":99372},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2837":58615,"_24697":58579,"_17272":99374,"_5":17167,"_23367":99273,"_2365":99375},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2837":58616,"_24697":58579,"_17272":99377,"_5":17167,"_23367":99281,"_2365":99378},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2837":58617,"_24697":58579,"_17272":99380,"_5":17167,"_23367":99285,"_2365":99381},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2837":58618,"_24697":58579,"_17272":99383,"_5":17167,"_23367":99289,"_2365":99384},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2837":58619,"_24697":58579,"_17272":99386,"_5":17167,"_23367":99293,"_2365":99387},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2837":58620,"_24697":58579,"_17272":99389,"_5":17167,"_23367":99297,"_2365":99390},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2837":58621,"_24697":58579,"_17272":99392,"_5":17167,"_23367":99301,"_2365":99393},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2837":58622,"_24697":58579,"_17272":99395,"_5":17167,"_23367":99305,"_2365":98849},[],{"_2837":58623,"_24697":58579,"_17272":99397,"_5":17167,"_23367":99305,"_2365":99398},[],"Qué prepara o comprueba",{"_2837":58624,"_24697":58579,"_17272":99400,"_5":17167,"_23367":99305,"_2365":98852},[],{"_2837":58625,"_24697":58579,"_17272":99402,"_5":17167,"_23367":99305,"_2365":99403},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2837":58626,"_24697":58579,"_17272":99405,"_5":17167,"_23367":99305,"_2365":99406},[],"Administrador de la flota",{"_2837":58627,"_24697":58579,"_17272":99408,"_5":17167,"_23367":99305,"_2365":99409},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2837":58628,"_24697":58579,"_17272":99411,"_5":17167,"_23367":99305,"_2365":98864},[],{"_2837":58629,"_24697":58579,"_17272":99413,"_5":17167,"_23367":99305,"_2365":99414},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2837":58630,"_24697":58579,"_17272":99416,"_5":17167,"_23367":99305,"_2365":98870},[],{"_2837":58631,"_24697":58579,"_17272":99418,"_5":17167,"_23367":99305,"_2365":99419},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2837":58632,"_24697":58579,"_17272":99421,"_5":17167,"_23367":99305,"_2365":99422},[],"Operador de infraestructura",{"_2837":58633,"_24697":58579,"_17272":99424,"_5":17167,"_23367":99305,"_2365":99425},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2837":58634,"_24697":58579,"_17272":99427,"_5":17167,"_23367":99305,"_2365":99428},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2837":58635,"_24697":58635,"_5":12136,"_2365":99430,"_25033":99431,"_17272":99433,"_23367":58635},"Jerarquía y rotación de CAs",[40259,95913,45225,99432],"Claves, autoridades y certificados",[],{"_2837":58636,"_24697":58635,"_17272":99435,"_5":17167,"_23367":58635,"_2365":99436},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2837":58637,"_24697":58635,"_5":25030,"_17272":99438,"_23367":99439,"_2365":99440},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2837":58638,"_24697":58635,"_5":25030,"_17272":99442,"_23367":99443,"_2365":99444},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2837":58639,"_24697":58635,"_5":25030,"_17272":99446,"_23367":99447,"_2365":99448},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2837":58640,"_24697":58635,"_5":25030,"_17272":99450,"_23367":99451,"_2365":99452},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2837":58641,"_24697":58635,"_5":25030,"_17272":99454,"_23367":99455,"_2365":99456},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2837":58642,"_24697":58635,"_5":25030,"_17272":99458,"_23367":99459,"_2365":99460},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2837":58643,"_24697":58635,"_5":25030,"_17272":99462,"_23367":99463,"_2365":99464},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2837":58644,"_24697":58635,"_5":25030,"_17272":99466,"_23367":99467,"_2365":99468},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2837":58645,"_24697":58635,"_5":25030,"_17272":99470,"_23367":99471,"_2365":99472},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2837":58646,"_24697":58635,"_5":25030,"_17272":99474,"_23367":99475,"_2365":99476},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2837":58647,"_24697":58635,"_5":25030,"_17272":99478,"_23367":99479,"_2365":99480},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2837":58648,"_24697":58635,"_5":25030,"_17272":99482,"_23367":99483,"_2365":99484},[],"/docs/pr-preview/pr-36/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2837":58649,"_24697":58635,"_17272":99486,"_5":17167,"_23367":58635,"_2365":99487},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2837":58650,"_24697":58635,"_17272":99489,"_5":17167,"_23367":58635,"_2365":99490},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2837":58651,"_24697":58635,"_17272":99492,"_5":17167,"_23367":99439,"_2365":99493},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2837":58652,"_24697":58635,"_17272":99495,"_5":17167,"_23367":99439,"_2365":99496},[],"entorno, como producción y preproducción;",{"_2837":58653,"_24697":58635,"_17272":99498,"_5":17167,"_23367":99439,"_2365":99499},[],"propietario o equipo operador;",{"_2837":58654,"_24697":58635,"_17272":99501,"_5":17167,"_23367":99439,"_2365":99502},[],"familia de dispositivos o proceso de fabricación;",{"_2837":58655,"_24697":58635,"_17272":99504,"_5":17167,"_23367":99439,"_2365":99505},[],"región o requisito regulatorio;",{"_2837":58656,"_24697":58635,"_17272":99507,"_5":17167,"_23367":99439,"_2365":99508},[],"motor criptográfico o política de clave;",{"_2837":58657,"_24697":58635,"_17272":99510,"_5":17167,"_23367":99439,"_2365":99511},[],"ventana de mantenimiento y ritmo de renovación.",{"_2837":58658,"_24697":58635,"_17272":99513,"_5":17167,"_23367":99439,"_2365":99514},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2837":58659,"_24697":58635,"_17272":99516,"_5":17167,"_23367":99439,"_2365":99517},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2837":58660,"_24697":58635,"_17272":99519,"_5":17167,"_23367":99443,"_2365":99520},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2837":58661,"_24697":58635,"_17272":99522,"_5":17167,"_23367":99443,"_2365":99523},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2837":58662,"_24697":58635,"_17272":99525,"_5":17167,"_23367":99443,"_2365":99526},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2837":58663,"_24697":58635,"_17272":99528,"_5":17167,"_23367":99447,"_2365":99529},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2837":58664,"_24697":58635,"_17272":99531,"_5":17167,"_23367":99447,"_2365":99532},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2837":58665,"_24697":58635,"_17272":99534,"_5":17167,"_23367":99447,"_2365":99535},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2837":58666,"_24697":58635,"_17272":99537,"_5":17167,"_23367":99447,"_2365":99538},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2837":58667,"_24697":58635,"_17272":99540,"_5":17167,"_23367":99455,"_2365":99541},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2837":58668,"_24697":58635,"_17272":99543,"_5":17167,"_23367":99459,"_2365":99544},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2837":58669,"_24697":58635,"_17272":99546,"_5":17167,"_23367":99463,"_2365":99547},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2837":58670,"_24697":58635,"_17272":99549,"_5":17167,"_23367":99467,"_2365":99550},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2837":58671,"_24697":58635,"_17272":99552,"_5":17167,"_23367":99471,"_2365":99553},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2837":58672,"_24697":58635,"_17272":99555,"_5":17167,"_23367":99475,"_2365":99556},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2837":58673,"_24697":58635,"_17272":99558,"_5":17167,"_23367":99479,"_2365":99559},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2837":58674,"_24697":58635,"_17272":99561,"_5":17167,"_23367":99479,"_2365":99562},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2837":58675,"_24697":58635,"_17272":99564,"_5":17167,"_23367":99479,"_2365":99565},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2837":58676,"_24697":58635,"_17272":99567,"_5":17167,"_23367":99479,"_2365":99568},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2837":58677,"_24697":58635,"_17272":99570,"_5":17167,"_23367":99483,"_2365":99571},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2837":58678,"_24697":58635,"_17272":99573,"_5":17167,"_23367":99483,"_2365":99574},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2837":58679,"_24697":58635,"_17272":99576,"_5":17167,"_23367":99483,"_2365":99577},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2837":58680,"_24697":58635,"_17272":99579,"_5":17167,"_23367":99483,"_2365":99580},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2837":58681,"_24697":58635,"_17272":99582,"_5":17167,"_23367":99483,"_2365":99583},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2837":58682,"_24697":58635,"_17272":99585,"_5":17167,"_23367":99483,"_2365":99586},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2837":58683,"_24697":58635,"_17272":99588,"_5":17167,"_23367":99483,"_2365":99589},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2837":58684,"_24697":58684,"_5":12136,"_2365":99591,"_25033":99592,"_17272":99593,"_23367":58684},"Autoridades de certificación",[40259,95913,45225,99432],[],{"_2837":58685,"_24697":58684,"_17272":99595,"_5":17167,"_23367":58684,"_2365":99596},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2837":58686,"_24697":58684,"_5":25030,"_17272":99598,"_23367":99599,"_2365":99600},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2837":58687,"_24697":58684,"_5":25030,"_17272":99602,"_23367":99603,"_2365":99604},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2837":58688,"_24697":58684,"_5":25030,"_17272":99606,"_23367":99607,"_2365":94614},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2837":58689,"_24697":58684,"_5":25030,"_17272":99609,"_23367":99610,"_2365":99611},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2837":58690,"_24697":58684,"_5":25030,"_17272":99613,"_23367":99614,"_2365":99615},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2837":58691,"_24697":58684,"_5":25030,"_17272":99617,"_23367":99618,"_2365":99619},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2837":58692,"_24697":58684,"_5":25030,"_17272":99621,"_23367":99622,"_2365":99623},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2837":58693,"_24697":58684,"_5":25030,"_17272":99625,"_23367":99626,"_2365":99627},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2837":58694,"_24697":58684,"_5":25030,"_17272":99629,"_23367":99630,"_2365":99631},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2837":58695,"_24697":58684,"_5":25030,"_17272":99633,"_23367":99634,"_2365":99635},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2837":58696,"_24697":58684,"_5":25030,"_17272":99637,"_23367":99638,"_2365":99639},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2837":58697,"_24697":58684,"_5":25030,"_17272":99641,"_23367":99642,"_2365":99643},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2837":58698,"_24697":58684,"_5":25030,"_17272":99645,"_23367":99646,"_2365":99647},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2837":58699,"_24697":58684,"_5":25030,"_17272":99649,"_23367":99650,"_2365":99651},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2837":58700,"_24697":58684,"_5":25030,"_17272":99653,"_23367":99654,"_2365":99655},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2837":58701,"_24697":58684,"_5":25030,"_17272":99657,"_23367":99658,"_2365":99659},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2837":58702,"_24697":58684,"_5":25030,"_17272":99661,"_23367":99662,"_2365":99663},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2837":58703,"_24697":58684,"_5":25030,"_17272":99665,"_23367":99666,"_2365":99667},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2837":58704,"_24697":58684,"_5":25030,"_17272":99669,"_23367":99670,"_2365":99671},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2837":58705,"_24697":58684,"_5":25030,"_17272":99673,"_23367":99674,"_2365":99675},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2837":58706,"_24697":58684,"_5":25030,"_17272":99677,"_23367":99678,"_2365":99679},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2837":58707,"_24697":58684,"_5":25030,"_17272":99681,"_23367":99682,"_2365":99683},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2837":58708,"_24697":58684,"_17272":99685,"_5":17167,"_23367":58684,"_2365":99686},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2837":58709,"_24697":58684,"_17272":99688,"_5":17167,"_23367":58684,"_2365":99689},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2837":58710,"_24697":58684,"_17272":99691,"_5":17167,"_23367":58684,"_2365":99692},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2837":58711,"_24697":58684,"_17272":99694,"_5":17167,"_23367":99599,"_2365":99695},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2837":58712,"_24697":58684,"_17272":99697,"_5":17167,"_23367":99599,"_2365":99698},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2837":58713,"_24697":58684,"_17272":99700,"_5":17167,"_23367":99599,"_2365":99701},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2837":58714,"_24697":58684,"_17272":99703,"_5":17167,"_23367":99599,"_2365":99704},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2837":58715,"_24697":58684,"_17272":99706,"_5":17167,"_23367":99599,"_2365":99707},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2837":58716,"_24697":58684,"_17272":99709,"_5":17167,"_23367":99607,"_2365":99710},[],"Decide si la CA será raíz o intermedia.",{"_2837":58717,"_24697":58684,"_17272":99712,"_5":17167,"_23367":99607,"_2365":99713},[],"Elige el motor que custodiará la clave.",{"_2837":58718,"_24697":58684,"_17272":99715,"_5":17167,"_23367":99607,"_2365":99716},[],"Define una validez superior a la de los certificados que emitirá.",{"_2837":58719,"_24697":58684,"_17272":99718,"_5":17167,"_23367":99607,"_2365":99719},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2837":58720,"_24697":58684,"_17272":99721,"_5":17167,"_23367":99610,"_2365":99722},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2837":58721,"_24697":58684,"_17272":99724,"_5":17167,"_23367":99614,"_2365":99725},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2837":58722,"_24697":58684,"_17272":99727,"_5":17167,"_23367":99614,"_2365":99728},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2837":58723,"_24697":58684,"_17272":99730,"_5":17167,"_23367":99618,"_2365":99731},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2837":58724,"_24697":58684,"_17272":99733,"_5":17167,"_23367":99622,"_2365":99734},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2837":58725,"_24697":58684,"_17272":99736,"_5":17167,"_23367":99622,"_2365":99737},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2837":58726,"_24697":58684,"_17272":99739,"_5":17167,"_23367":99622,"_2365":99740},[],"`ST`: estado o provincia.",{"_2837":58727,"_24697":58684,"_17272":99742,"_5":17167,"_23367":99622,"_2365":99743},[],"`L`: localidad.",{"_2837":58728,"_24697":58684,"_17272":99745,"_5":17167,"_23367":99622,"_2365":99746},[],"`O`: organización.",{"_2837":58729,"_24697":58684,"_17272":99748,"_5":17167,"_23367":99622,"_2365":99749},[],"`OU`: unidad organizativa.",{"_2837":58730,"_24697":58684,"_17272":99751,"_5":17167,"_23367":99622,"_2365":99752},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2837":58731,"_24697":58684,"_17272":99754,"_5":17167,"_23367":99626,"_2365":99755},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2837":58732,"_24697":58684,"_17272":99757,"_5":17167,"_23367":99626,"_2365":99758},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2837":58733,"_24697":58684,"_17272":99760,"_5":17167,"_23367":99630,"_2365":99761},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2837":58734,"_24697":58684,"_17272":99763,"_5":17167,"_23367":99630,"_2365":99764},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2837":58735,"_24697":58684,"_17272":99766,"_5":17167,"_23367":99634,"_2365":99767},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2837":58736,"_24697":58684,"_17272":99769,"_5":17167,"_23367":99634,"_2365":99770},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2837":58737,"_24697":58684,"_17272":99772,"_5":17167,"_23367":99638,"_2365":99773},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2837":58738,"_24697":58684,"_17272":99775,"_5":17167,"_23367":99642,"_2365":99776},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2837":58739,"_24697":58684,"_17272":99778,"_5":17167,"_23367":99646,"_2365":99779},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2837":58740,"_24697":58684,"_17272":99781,"_5":17167,"_23367":99650,"_2365":99782},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2837":58741,"_24697":58684,"_17272":99784,"_5":17167,"_23367":99654,"_2365":99785},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2837":58742,"_24697":58684,"_17272":99787,"_5":17167,"_23367":99654,"_2365":99788},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2837":58743,"_24697":58684,"_17272":99790,"_5":17167,"_23367":99658,"_2365":99791},[],"Abre una CA desde el inventario para consultar:",{"_2837":58744,"_24697":58684,"_17272":99793,"_5":17167,"_23367":99658,"_2365":99794},[],"Estado y periodo de validez.",{"_2837":58745,"_24697":58684,"_17272":99796,"_5":17167,"_23367":99658,"_2365":99797},[],"Certificado y cadena en formato PEM.",{"_2837":58746,"_24697":58684,"_17272":99799,"_5":17167,"_23367":99658,"_2365":99800},[],"Número de certificados activos, expirados y revocados.",{"_2837":58747,"_24697":58684,"_17272":99802,"_5":17167,"_23367":99658,"_2365":99803},[],"Certificados emitidos en **Issued Certificates**.",{"_2837":58748,"_24697":58684,"_17272":99805,"_5":17167,"_23367":99658,"_2365":99806},[],"CRL vinculada a la autoridad.",{"_2837":58749,"_24697":58684,"_17272":99808,"_5":17167,"_23367":99658,"_2365":99809},[],"Metadatos y motor criptográfico asociado.",{"_2837":58750,"_24697":58684,"_17272":99811,"_5":17167,"_23367":99658,"_2365":99812},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2837":58751,"_24697":58684,"_17272":99814,"_5":17167,"_23367":99662,"_2365":99815},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2837":58752,"_24697":58684,"_17272":99817,"_5":17167,"_23367":99662,"_2365":99818},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2837":58753,"_24697":58684,"_17272":99820,"_5":17167,"_23367":99662,"_2365":99821},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2837":58754,"_24697":58684,"_17272":99823,"_5":17167,"_23367":99662,"_2365":99824},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2837":58755,"_24697":58684,"_17272":99826,"_5":17167,"_23367":99666,"_2365":99827},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2837":58756,"_24697":58684,"_17272":99829,"_5":17167,"_23367":99670,"_2365":99830},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2837":58757,"_24697":58684,"_17272":99832,"_5":17167,"_23367":99674,"_2365":99833},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2837":58758,"_24697":58684,"_17272":99835,"_5":17167,"_23367":99678,"_2365":99836},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2837":58759,"_24697":58684,"_17272":99838,"_5":17167,"_23367":99682,"_2365":99839},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2837":58760,"_24697":58684,"_17272":99841,"_5":17167,"_23367":99682,"_2365":99842},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2837":58761,"_24697":58761,"_5":12136,"_2365":99844,"_25033":99845,"_17272":99846,"_23367":58761},"Perfiles de certificado",[40259,95913,45225,99432],[],{"_2837":58762,"_24697":58761,"_17272":99848,"_5":17167,"_23367":58761,"_2365":99849},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2837":58763,"_24697":58761,"_5":25030,"_17272":99851,"_23367":99852,"_2365":99853},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2837":58764,"_24697":58761,"_5":25030,"_17272":99855,"_23367":99856,"_2365":99857},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#validez","Validez",{"_2837":58765,"_24697":58761,"_5":25030,"_17272":99859,"_23367":99860,"_2365":99861},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2837":58766,"_24697":58761,"_5":25030,"_17272":99863,"_23367":99864,"_2365":99865},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2837":58767,"_24697":58761,"_5":25030,"_17272":99867,"_23367":99868,"_2365":99869},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2837":58768,"_24697":58761,"_5":25030,"_17272":99871,"_23367":99872,"_2365":99873},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2837":58769,"_24697":58761,"_5":25030,"_17272":99875,"_23367":99876,"_2365":99877},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2837":58770,"_24697":58761,"_5":25030,"_17272":99879,"_23367":99880,"_2365":99881},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2837":58771,"_24697":58761,"_5":25030,"_17272":99883,"_23367":99884,"_2365":99885},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2837":58772,"_24697":58761,"_5":25030,"_17272":99887,"_23367":99888,"_2365":99889},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2837":58773,"_24697":58761,"_5":25030,"_17272":99891,"_23367":99892,"_2365":99893},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2837":58774,"_24697":58761,"_5":25030,"_17272":99895,"_23367":99896,"_2365":99897},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2837":58775,"_24697":58761,"_5":25030,"_17272":99899,"_23367":99900,"_2365":99901},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2837":58776,"_24697":58761,"_5":25030,"_17272":99903,"_23367":99904,"_2365":99905},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2837":58777,"_24697":58761,"_5":25030,"_17272":99907,"_23367":99908,"_2365":99909},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2837":58778,"_24697":58761,"_5":25030,"_17272":99911,"_23367":99912,"_2365":99913},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2837":58779,"_24697":58761,"_17272":99915,"_5":17167,"_23367":58761,"_2365":99916},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2837":58780,"_24697":58761,"_17272":99918,"_5":17167,"_23367":58761,"_2365":99919},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2837":58781,"_24697":58761,"_17272":99921,"_5":17167,"_23367":99856,"_2365":99922},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2837":58782,"_24697":58761,"_17272":99924,"_5":17167,"_23367":99856,"_2365":99925},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2837":58783,"_24697":58761,"_17272":99927,"_5":17167,"_23367":99860,"_2365":99928},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2837":58784,"_24697":58761,"_17272":99930,"_5":17167,"_23367":99864,"_2365":99931},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2837":58785,"_24697":58761,"_17272":99933,"_5":17167,"_23367":99864,"_2365":99934},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2837":58786,"_24697":58761,"_17272":99936,"_5":17167,"_23367":99864,"_2365":99937},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2837":58787,"_24697":58761,"_17272":99939,"_5":17167,"_23367":99868,"_2365":99940},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2837":58788,"_24697":58761,"_17272":99942,"_5":17167,"_23367":99872,"_2365":99943},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2837":58789,"_24697":58761,"_17272":99945,"_5":17167,"_23367":99872,"_2365":99946},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2837":58790,"_24697":58761,"_17272":99948,"_5":17167,"_23367":99876,"_2365":99949},[],"La aplicación criptográfica puede:",{"_2837":58791,"_24697":58761,"_17272":99951,"_5":17167,"_23367":99876,"_2365":99952},[],"permitir o bloquear claves RSA;",{"_2837":58792,"_24697":58761,"_17272":99954,"_5":17167,"_23367":99876,"_2365":99955},[],"limitar los tamaños RSA admitidos;",{"_2837":58793,"_24697":58761,"_17272":99957,"_5":17167,"_23367":99876,"_2365":99958},[],"permitir o bloquear claves ECDSA;",{"_2837":58794,"_24697":58761,"_17272":99960,"_5":17167,"_23367":99876,"_2365":99961},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2837":58795,"_24697":58761,"_17272":99963,"_5":17167,"_23367":99876,"_2365":99964},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2837":58796,"_24697":58761,"_17272":99966,"_5":17167,"_23367":99880,"_2365":99967},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2837":58797,"_24697":58761,"_17272":99969,"_5":17167,"_23367":99880,"_2365":95704},[],{"_2837":58798,"_24697":58761,"_17272":99971,"_5":17167,"_23367":99880,"_2365":99972},[],"Primera opción",{"_2837":58799,"_24697":58761,"_17272":99974,"_5":17167,"_23367":99880,"_2365":99975},[],"Segunda opción",{"_2837":58800,"_24697":58761,"_17272":99977,"_5":17167,"_23367":99880,"_2365":99978},[],"Si no hay ninguna",{"_2837":58801,"_24697":58761,"_17272":99980,"_5":17167,"_23367":99880,"_2365":99981},[],"Firma directa con una CA",{"_2837":58802,"_24697":58761,"_17272":99983,"_5":17167,"_23367":99880,"_2365":99984},[],"`issuance_profile` incluido en la solicitud",{"_2837":58803,"_24697":58761,"_17272":99986,"_5":17167,"_23367":99880,"_2365":99987},[],"`issuance_profile_id` de la solicitud",{"_2837":58804,"_24697":58761,"_17272":99989,"_5":17167,"_23367":99880,"_2365":99990},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2837":58805,"_24697":58761,"_17272":99992,"_5":17167,"_23367":99880,"_2365":99993},[],"Emisión mediante DMS",{"_2837":58806,"_24697":58761,"_17272":99995,"_5":17167,"_23367":99880,"_2365":45790},[],{"_2837":58807,"_24697":58761,"_17272":99997,"_5":17167,"_23367":99880,"_2365":99998},[],"`settings.issuance_profile` incluido en el DMS",{"_2837":58808,"_24697":58761,"_17272":100000,"_5":17167,"_23367":99880,"_2365":100001},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2837":58809,"_24697":58761,"_17272":100003,"_5":17167,"_23367":99880,"_2365":100004},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2837":58810,"_24697":58761,"_17272":100006,"_5":17167,"_23367":99880,"_2365":100007},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2837":58811,"_24697":58761,"_17272":100009,"_5":17167,"_23367":99888,"_2365":100010},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2837":58812,"_24697":58761,"_17272":100012,"_5":17167,"_23367":99892,"_2365":100013},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2837":58813,"_24697":58761,"_17272":100015,"_5":17167,"_23367":99896,"_2365":100016},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2837":58814,"_24697":58761,"_17272":100018,"_5":17167,"_23367":99900,"_2365":100019},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2837":58815,"_24697":58761,"_17272":100021,"_5":17167,"_23367":99904,"_2365":100022},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2837":58816,"_24697":58761,"_17272":100024,"_5":17167,"_23367":99904,"_2365":100025},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2837":58817,"_24697":58761,"_17272":100027,"_5":17167,"_23367":99908,"_2365":100028},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2837":58818,"_24697":58761,"_17272":100030,"_5":17167,"_23367":99908,"_2365":100031},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2837":58819,"_24697":58761,"_17272":100033,"_5":17167,"_23367":99908,"_2365":100034},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2837":58820,"_24697":58761,"_17272":100036,"_5":17167,"_23367":99908,"_2365":100037},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2837":58821,"_24697":58761,"_17272":100039,"_5":17167,"_23367":99912,"_2365":100040},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2837":58822,"_24697":58761,"_17272":100042,"_5":17167,"_23367":99912,"_2365":100043},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2837":58823,"_24697":58823,"_5":12136,"_2365":100045,"_25033":100046,"_17272":100048,"_23367":58823},"Validación de certificados",[40259,95913,45225,100047],"Validación",[],{"_2837":58824,"_24697":58823,"_17272":100050,"_5":17167,"_23367":58823,"_2365":100051},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2837":58825,"_24697":58823,"_5":25030,"_17272":100053,"_23367":100054,"_2365":100055},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2837":58826,"_24697":58823,"_5":25030,"_17272":100057,"_23367":100058,"_2365":100059},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2837":58827,"_24697":58823,"_5":25030,"_17272":100061,"_23367":100062,"_2365":100063},[],"/docs/pr-preview/pr-36/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2837":58828,"_24697":58823,"_17272":100065,"_5":17167,"_23367":58823,"_2365":100066},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2837":58829,"_24697":58823,"_17272":100068,"_5":17167,"_23367":100054,"_2365":100069},[],"Verifica estos criterios juntos:",{"_2837":58830,"_24697":58823,"_17272":100071,"_5":17167,"_23367":100054,"_2365":99059},[],{"_2837":58831,"_24697":58823,"_17272":100073,"_5":17167,"_23367":100054,"_2365":100074},[],"Resultado necesario",{"_2837":58832,"_24697":58823,"_17272":100076,"_5":17167,"_23367":100054,"_2365":100077},[],"Cadena y firma",{"_2837":58833,"_24697":58823,"_17272":100079,"_5":17167,"_23367":100054,"_2365":100080},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2837":58834,"_24697":58823,"_17272":100082,"_5":17167,"_23367":100054,"_2365":100083},[],"Fechas",{"_2837":58835,"_24697":58823,"_17272":100085,"_5":17167,"_23367":100054,"_2365":100086},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2837":58836,"_24697":58823,"_17272":100088,"_5":17167,"_23367":100054,"_2365":95617},[],{"_2837":58837,"_24697":58823,"_17272":100090,"_5":17167,"_23367":100054,"_2365":100091},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2837":58838,"_24697":58823,"_17272":100093,"_5":17167,"_23367":100054,"_2365":100094},[],"Uso",{"_2837":58839,"_24697":58823,"_17272":100096,"_5":17167,"_23367":100054,"_2365":100097},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2837":58840,"_24697":58823,"_17272":100099,"_5":17167,"_23367":100054,"_2365":100100},[],"Revocación",{"_2837":58841,"_24697":58823,"_17272":100102,"_5":17167,"_23367":100054,"_2365":100103},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2837":58842,"_24697":58823,"_17272":100105,"_5":17167,"_23367":100054,"_2365":100106},[],"Autorización",{"_2837":58843,"_24697":58823,"_17272":100108,"_5":17167,"_23367":100054,"_2365":100109},[],"La aplicación permite la acción a esa identidad.",{"_2837":58844,"_24697":58823,"_17272":100111,"_5":17167,"_23367":100054,"_2365":100112},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2837":58845,"_24697":58823,"_17272":100114,"_5":17167,"_23367":100058,"_2365":100115},[],"Mecanismo",{"_2837":58846,"_24697":58823,"_17272":100117,"_5":17167,"_23367":100058,"_2365":100118},[],"Cuándo utilizarlo",{"_2837":58847,"_24697":58823,"_17272":100120,"_5":17167,"_23367":100058,"_2365":100121},[],"Qué debes mantener",{"_2837":58848,"_24697":58823,"_17272":100123,"_5":17167,"_23367":100058,"_2365":45918},[],{"_2837":58849,"_24697":58823,"_17272":100125,"_5":17167,"_23367":100058,"_2365":100126},[],"Consulta del estado de un certificado concreto.",{"_2837":58850,"_24697":58823,"_17272":100128,"_5":17167,"_23367":100058,"_2365":100129},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2837":58851,"_24697":58823,"_17272":100131,"_5":17167,"_23367":100058,"_2365":45927},[],{"_2837":58852,"_24697":58823,"_17272":100133,"_5":17167,"_23367":100058,"_2365":100134},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2837":58853,"_24697":58823,"_17272":100136,"_5":17167,"_23367":100058,"_2365":100137},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2837":58854,"_24697":58823,"_17272":100139,"_5":17167,"_23367":100058,"_2365":100140},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2837":58855,"_24697":58823,"_17272":100142,"_5":17167,"_23367":100058,"_2365":100143},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2837":58856,"_24697":58823,"_17272":100145,"_5":17167,"_23367":100062,"_2365":100146},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2837":58857,"_24697":58823,"_17272":100148,"_5":17167,"_23367":100062,"_2365":100149},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2837":58858,"_24697":58823,"_17272":100151,"_5":17167,"_23367":100062,"_2365":100152},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2837":58859,"_24697":58823,"_17272":100154,"_5":17167,"_23367":100062,"_2365":100155},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2837":58860,"_24697":58823,"_17272":100157,"_5":17167,"_23367":100062,"_2365":100158},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2837":58861,"_24697":58823,"_17272":100160,"_5":17167,"_23367":100062,"_2365":100161},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2837":58862,"_24697":58823,"_17272":100163,"_5":17167,"_23367":100062,"_2365":100164},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2837":58863,"_24697":58823,"_17272":100166,"_5":17167,"_23367":100062,"_2365":100167},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2837":58864,"_24697":58823,"_17272":100169,"_5":17167,"_23367":100062,"_2365":100170},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2837":58865,"_24697":58865,"_5":12136,"_2365":100172,"_25033":100173,"_17272":100174,"_23367":58865},"Certificados",[40259,95913,45225,99432],[],{"_2837":58866,"_24697":58865,"_17272":100176,"_5":17167,"_23367":58865,"_2365":100177},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2837":58867,"_24697":58865,"_5":25030,"_17272":100179,"_23367":100180,"_2365":100181},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2837":58868,"_24697":58865,"_5":25030,"_17272":100183,"_23367":100184,"_2365":100185},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2837":58869,"_24697":58865,"_5":25030,"_17272":100187,"_23367":100188,"_2365":100189},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2837":58870,"_24697":58865,"_5":25030,"_17272":100191,"_23367":100192,"_2365":100193},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2837":58871,"_24697":58865,"_5":25030,"_17272":100195,"_23367":100196,"_2365":100197},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2837":58872,"_24697":58865,"_5":25030,"_17272":100199,"_23367":100200,"_2365":100201},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2837":58873,"_24697":58865,"_5":25030,"_17272":100203,"_23367":100204,"_2365":100205},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2837":58874,"_24697":58865,"_5":25030,"_17272":100207,"_23367":100208,"_2365":100209},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2837":58875,"_24697":58865,"_5":25030,"_17272":100211,"_23367":100212,"_2365":100213},[],"/docs/pr-preview/pr-36/es/platform/pki/certificates#continúa","Continúa",{"_2837":58876,"_24697":58865,"_17272":100215,"_5":17167,"_23367":58865,"_2365":100216},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2837":58877,"_24697":58865,"_17272":100218,"_5":17167,"_23367":100180,"_2365":100219},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2837":58878,"_24697":58865,"_17272":100221,"_5":17167,"_23367":100180,"_2365":100222},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2837":58879,"_24697":58865,"_17272":100224,"_5":17167,"_23367":100184,"_2365":100225},[],"Descarga el PEM e inspecciónalo:",{"_2837":58880,"_24697":58865,"_17272":100227,"_5":17167,"_23367":100184,"_2365":100228},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2837":58881,"_24697":58865,"_17272":100230,"_5":17167,"_23367":100188,"_2365":100231},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2837":58882,"_24697":58865,"_17272":100233,"_5":17167,"_23367":100188,"_2365":100234},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2837":58883,"_24697":58865,"_17272":100236,"_5":17167,"_23367":100188,"_2365":100237},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2837":58884,"_24697":58865,"_17272":100239,"_5":17167,"_23367":100188,"_2365":100240},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2837":58885,"_24697":58865,"_17272":100242,"_5":17167,"_23367":100188,"_2365":100243},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2837":58886,"_24697":58865,"_17272":100245,"_5":17167,"_23367":100188,"_2365":100246},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2837":58887,"_24697":58865,"_17272":100248,"_5":17167,"_23367":100188,"_2365":100249},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2837":58888,"_24697":58865,"_17272":100251,"_5":17167,"_23367":100192,"_2365":100252},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2837":58889,"_24697":58865,"_17272":100254,"_5":17167,"_23367":100196,"_2365":100255},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2837":58890,"_24697":58865,"_17272":100257,"_5":17167,"_23367":100200,"_2365":100258},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2837":58891,"_24697":58865,"_17272":100260,"_5":17167,"_23367":100204,"_2365":100261},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2837":58892,"_24697":58865,"_17272":100263,"_5":17167,"_23367":100204,"_2365":100264},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2837":58893,"_24697":58865,"_17272":100266,"_5":17167,"_23367":100204,"_2365":100267},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2837":58894,"_24697":58865,"_17272":100269,"_5":17167,"_23367":100208,"_2365":100270},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2837":58895,"_24697":58865,"_17272":100272,"_5":17167,"_23367":100208,"_2365":100273},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2837":58896,"_24697":58865,"_17272":100275,"_5":17167,"_23367":100208,"_2365":100276},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2837":58897,"_24697":58865,"_17272":100278,"_5":17167,"_23367":100212,"_2365":100279},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2837":58898,"_24697":58865,"_17272":100281,"_5":17167,"_23367":100212,"_2365":100282},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2837":58899,"_24697":58899,"_5":12136,"_2365":100284,"_25033":100285,"_17272":100287,"_23367":58899},"Ciclo de vida de un certificado",[40259,95913,45225,100286],"Conceptos",[],{"_2837":58900,"_24697":58899,"_17272":100289,"_5":17167,"_23367":58899,"_2365":100290},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2837":58901,"_24697":58899,"_5":25030,"_17272":100292,"_23367":100293,"_2365":100294},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2837":58902,"_24697":58899,"_5":25030,"_17272":100296,"_23367":100297,"_2365":100298},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2837":58903,"_24697":58899,"_5":25030,"_17272":100300,"_23367":100301,"_2365":100302},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2837":58904,"_24697":58899,"_5":25030,"_17272":100304,"_23367":100305,"_2365":100306},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2837":58905,"_24697":58899,"_5":25030,"_17272":100308,"_23367":100309,"_2365":100310},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2837":58906,"_24697":58899,"_5":25030,"_17272":100312,"_23367":100313,"_2365":100314},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2837":58907,"_24697":58899,"_5":25030,"_17272":100316,"_23367":100317,"_2365":100318},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2837":58908,"_24697":58899,"_5":25030,"_17272":100320,"_23367":100321,"_2365":100322},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2837":58909,"_24697":58899,"_5":25030,"_17272":100324,"_23367":100325,"_2365":100326},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2837":58910,"_24697":58899,"_5":25030,"_17272":100328,"_23367":100329,"_2365":100330},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2837":58911,"_24697":58899,"_17272":100332,"_5":17167,"_23367":58899,"_2365":100333},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2837":58912,"_24697":58899,"_17272":100335,"_5":17167,"_23367":100297,"_2365":100336},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2837":58913,"_24697":58899,"_17272":100338,"_5":17167,"_23367":100301,"_2365":100339},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2837":58914,"_24697":58899,"_17272":100341,"_5":17167,"_23367":100305,"_2365":100342},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2837":58915,"_24697":58899,"_17272":100344,"_5":17167,"_23367":100309,"_2365":100345},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2837":58916,"_24697":58899,"_17272":100347,"_5":17167,"_23367":100313,"_2365":100348},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2837":58917,"_24697":58899,"_17272":100350,"_5":17167,"_23367":100317,"_2365":100351},[],"Lamassu persiste cuatro estados X.509:",{"_2837":58918,"_24697":58899,"_17272":100353,"_5":17167,"_23367":100317,"_2365":100354},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2837":58919,"_24697":58899,"_17272":100356,"_5":17167,"_23367":100317,"_2365":100357},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2837":58920,"_24697":58899,"_17272":100359,"_5":17167,"_23367":100317,"_2365":100360},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2837":58921,"_24697":58899,"_17272":100362,"_5":17167,"_23367":100317,"_2365":100363},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2837":58922,"_24697":58899,"_17272":100365,"_5":17167,"_23367":100317,"_2365":100366},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2837":58923,"_24697":58899,"_17272":100368,"_5":17167,"_23367":100321,"_2365":100369},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2837":58924,"_24697":58899,"_17272":100371,"_5":17167,"_23367":100321,"_2365":100372},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2837":58925,"_24697":58899,"_17272":100374,"_5":17167,"_23367":100321,"_2365":100375},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2837":58926,"_24697":58899,"_17272":100377,"_5":17167,"_23367":100325,"_2365":100378},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2837":58927,"_24697":58899,"_17272":100380,"_5":17167,"_23367":100325,"_2365":100381},[],"Antes de confirmar:",{"_2837":58928,"_24697":58899,"_17272":100383,"_5":17167,"_23367":100325,"_2365":100384},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2837":58929,"_24697":58899,"_17272":100386,"_5":17167,"_23367":100325,"_2365":100387},[],"Distribuye la nueva cadena de confianza.",{"_2837":58930,"_24697":58899,"_17272":100389,"_5":17167,"_23367":100325,"_2365":100390},[],"Reemite las identidades necesarias.",{"_2837":58931,"_24697":58899,"_17272":100392,"_5":17167,"_23367":100325,"_2365":100393},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2837":58932,"_24697":58899,"_17272":100395,"_5":17167,"_23367":100325,"_2365":100396},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2837":58933,"_24697":58899,"_17272":100398,"_5":17167,"_23367":100325,"_2365":100399},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2837":58934,"_24697":58899,"_17272":100401,"_5":17167,"_23367":100329,"_2365":100402},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2837":58935,"_24697":58899,"_17272":100404,"_5":17167,"_23367":100329,"_2365":100405},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2837":58936,"_24697":58899,"_17272":100407,"_5":17167,"_23367":100329,"_2365":100408},[],"Cambios de estado y razones de revocación.",{"_2837":58937,"_24697":58899,"_17272":100410,"_5":17167,"_23367":100329,"_2365":100411},[],"Publicación y vigencia de OCSP y CRLs.",{"_2837":58938,"_24697":58899,"_17272":100413,"_5":17167,"_23367":100329,"_2365":100414},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2837":58939,"_24697":58899,"_17272":100416,"_5":17167,"_23367":100329,"_2365":100417},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2837":58940,"_24697":58940,"_5":12136,"_2365":100419,"_25033":100420,"_17272":100421,"_23367":58940},"Modelo de confianza",[40259,95913,45225,100286],[],{"_2837":58941,"_24697":58940,"_17272":100423,"_5":17167,"_23367":58940,"_2365":100424},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2837":58942,"_24697":58940,"_5":25030,"_17272":100426,"_23367":100427,"_2365":100428},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2837":58943,"_24697":58940,"_5":25030,"_17272":100430,"_23367":100431,"_2365":100432},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2837":58944,"_24697":58940,"_5":25030,"_17272":100434,"_23367":100435,"_2365":100436},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2837":58945,"_24697":58940,"_5":25030,"_17272":100438,"_23367":100439,"_2365":100440},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2837":58946,"_24697":58940,"_5":25030,"_17272":100442,"_23367":100443,"_2365":100444},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2837":58947,"_24697":58940,"_5":25030,"_17272":100446,"_23367":100447,"_2365":100448},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2837":58948,"_24697":58940,"_5":25030,"_17272":100450,"_23367":100451,"_2365":100452},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2837":58949,"_24697":58940,"_5":25030,"_17272":100454,"_23367":100455,"_2365":100456},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2837":58950,"_24697":58940,"_5":25030,"_17272":100458,"_23367":100459,"_2365":100460},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2837":58951,"_24697":58940,"_5":25030,"_17272":100462,"_23367":100463,"_2365":100464},[],"/docs/pr-preview/pr-36/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2837":58952,"_24697":58940,"_17272":100466,"_5":17167,"_23367":58940,"_2365":100467},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2837":58953,"_24697":58940,"_17272":100469,"_5":17167,"_23367":100431,"_2365":100470},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2837":58954,"_24697":58940,"_17272":100472,"_5":17167,"_23367":100435,"_2365":100473},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2837":58955,"_24697":58940,"_17272":100475,"_5":17167,"_23367":100439,"_2365":100476},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2837":58956,"_24697":58940,"_17272":100478,"_5":17167,"_23367":100443,"_2365":100479},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2837":58957,"_24697":58940,"_17272":100481,"_5":17167,"_23367":100447,"_2365":100482},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2837":58958,"_24697":58940,"_17272":100484,"_5":17167,"_23367":100447,"_2365":100485},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2837":58959,"_24697":58940,"_17272":100487,"_5":17167,"_23367":100447,"_2365":100488},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2837":58960,"_24697":58940,"_17272":100490,"_5":17167,"_23367":100447,"_2365":100491},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2837":58961,"_24697":58940,"_17272":100493,"_5":17167,"_23367":100447,"_2365":100494},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2837":58962,"_24697":58940,"_17272":100496,"_5":17167,"_23367":100447,"_2365":100497},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2837":58963,"_24697":58940,"_17272":100499,"_5":17167,"_23367":100451,"_2365":100500},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2837":58964,"_24697":58940,"_17272":100502,"_5":17167,"_23367":100451,"_2365":100503},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2837":58965,"_24697":58940,"_17272":100505,"_5":17167,"_23367":100451,"_2365":100506},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2837":58966,"_24697":58940,"_17272":100508,"_5":17167,"_23367":100451,"_2365":100509},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2837":58967,"_24697":58940,"_17272":100511,"_5":17167,"_23367":100451,"_2365":100512},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2837":58968,"_24697":58940,"_17272":100514,"_5":17167,"_23367":100455,"_2365":100515},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2837":58969,"_24697":58940,"_17272":100517,"_5":17167,"_23367":100455,"_2365":100518},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2837":58970,"_24697":58940,"_17272":100520,"_5":17167,"_23367":100455,"_2365":100521},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2837":58971,"_24697":58940,"_17272":100523,"_5":17167,"_23367":100455,"_2365":100524},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2837":58972,"_24697":58940,"_17272":100526,"_5":17167,"_23367":100455,"_2365":100527},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2837":58973,"_24697":58940,"_17272":100529,"_5":17167,"_23367":100455,"_2365":100530},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2837":58974,"_24697":58940,"_17272":100532,"_5":17167,"_23367":100455,"_2365":100533},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2837":58975,"_24697":58940,"_17272":100535,"_5":17167,"_23367":100459,"_2365":100536},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2837":58976,"_24697":58940,"_17272":100538,"_5":17167,"_23367":100463,"_2365":100539},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2837":58977,"_24697":58940,"_17272":100541,"_5":17167,"_23367":100463,"_2365":100542},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2837":58978,"_24697":58940,"_17272":100544,"_5":17167,"_23367":100463,"_2365":100545},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2837":58979,"_24697":58940,"_17272":100547,"_5":17167,"_23367":100463,"_2365":100548},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2837":58980,"_24697":58940,"_17272":100550,"_5":17167,"_23367":100463,"_2365":100551},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2837":58981,"_24697":58940,"_17272":100553,"_5":17167,"_23367":100463,"_2365":100554},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2837":58982,"_24697":58940,"_17272":100556,"_5":17167,"_23367":100463,"_2365":100557},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2837":58983,"_24697":58983,"_5":12136,"_2365":100559,"_25033":100560,"_17272":100561,"_23367":58983},"Listas de revocación (CRL)",[40259,95913,45225,100047],[],{"_2837":58984,"_24697":58983,"_17272":100563,"_5":17167,"_23367":58983,"_2365":100564},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2837":58985,"_24697":58983,"_5":25030,"_17272":100566,"_23367":100567,"_2365":100568},[],"/docs/pr-preview/pr-36/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2837":58986,"_24697":58983,"_5":25030,"_17272":100570,"_23367":100571,"_2365":100572},[],"/docs/pr-preview/pr-36/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2837":58987,"_24697":58983,"_5":25030,"_17272":100574,"_23367":100575,"_2365":100576},[],"/docs/pr-preview/pr-36/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2837":58988,"_24697":58983,"_5":25030,"_17272":100578,"_23367":100579,"_2365":100580},[],"/docs/pr-preview/pr-36/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2837":58989,"_24697":58983,"_5":25030,"_17272":100582,"_23367":100583,"_2365":100584},[],"/docs/pr-preview/pr-36/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2837":58990,"_24697":58983,"_5":25030,"_17272":100586,"_23367":100587,"_2365":100588},[],"/docs/pr-preview/pr-36/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2837":58991,"_24697":58983,"_5":25030,"_17272":100590,"_23367":100591,"_2365":100592},[],"/docs/pr-preview/pr-36/es/platform/pki/crl#referencias","Referencias",{"_2837":58992,"_24697":58983,"_17272":100594,"_5":17167,"_23367":58983,"_2365":100595},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2837":58993,"_24697":58983,"_17272":100597,"_5":17167,"_23367":100567,"_2365":100598},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2837":58994,"_24697":58983,"_17272":100600,"_5":17167,"_23367":100567,"_2365":100601},[],"Campo de `crl_options`",{"_2837":58995,"_24697":58983,"_17272":100603,"_5":17167,"_23367":100567,"_2365":97350},[],{"_2837":58996,"_24697":58983,"_17272":100605,"_5":17167,"_23367":100567,"_2365":100606},[],"Valor inicial del backend",{"_2837":58997,"_24697":58983,"_17272":100608,"_5":17167,"_23367":100567,"_2365":46405},[],{"_2837":58998,"_24697":58983,"_17272":100610,"_5":17167,"_23367":100567,"_2365":100611},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2837":58999,"_24697":58983,"_17272":100613,"_5":17167,"_23367":100567,"_2365":100614},[],"7 días.",{"_2837":59000,"_24697":58983,"_17272":100616,"_5":17167,"_23367":100567,"_2365":46414},[],{"_2837":59001,"_24697":58983,"_17272":100618,"_5":17167,"_23367":100567,"_2365":100619},[],"Plazo desde la publicación que activa la renovación programada.",{"_2837":59002,"_24697":58983,"_17272":100621,"_5":17167,"_23367":100567,"_2365":100622},[],"6 días y 23 horas.",{"_2837":59003,"_24697":58983,"_17272":100624,"_5":17167,"_23367":100567,"_2365":46423},[],{"_2837":59004,"_24697":58983,"_17272":100626,"_5":17167,"_23367":100567,"_2365":100627},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2837":59005,"_24697":58983,"_17272":100629,"_5":17167,"_23367":100567,"_2365":46429},[],{"_2837":59006,"_24697":58983,"_17272":100631,"_5":17167,"_23367":100567,"_2365":46432},[],{"_2837":59007,"_24697":58983,"_17272":100633,"_5":17167,"_23367":100567,"_2365":100634},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2837":59008,"_24697":58983,"_17272":100636,"_5":17167,"_23367":100567,"_2365":100637},[],"SKI de la CA.",{"_2837":59009,"_24697":58983,"_17272":100639,"_5":17167,"_23367":100567,"_2365":100640},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2837":59010,"_24697":58983,"_17272":100642,"_5":17167,"_23367":100567,"_2365":100643},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2837":59011,"_24697":58983,"_17272":100645,"_5":17167,"_23367":100571,"_2365":100646},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2837":59012,"_24697":58983,"_17272":100648,"_5":17167,"_23367":100571,"_2365":100649},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2837":59013,"_24697":58983,"_17272":100651,"_5":17167,"_23367":100571,"_2365":100652},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2837":59014,"_24697":58983,"_17272":100654,"_5":17167,"_23367":100575,"_2365":100655},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2837":59015,"_24697":58983,"_17272":100657,"_5":17167,"_23367":100575,"_2365":100658},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2837":59016,"_24697":58983,"_17272":100660,"_5":17167,"_23367":100579,"_2365":100661},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2837":59017,"_24697":58983,"_17272":100663,"_5":17167,"_23367":100579,"_2365":100664},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2837":59018,"_24697":58983,"_17272":100666,"_5":17167,"_23367":100579,"_2365":100667},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2837":59019,"_24697":58983,"_17272":100669,"_5":17167,"_23367":100579,"_2365":100670},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2837":59020,"_24697":58983,"_17272":100672,"_5":17167,"_23367":100579,"_2365":100673},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2837":59021,"_24697":58983,"_17272":100675,"_5":17167,"_23367":100583,"_2365":100676},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2837":59022,"_24697":58983,"_17272":100678,"_5":17167,"_23367":100583,"_2365":97539},[],{"_2837":59023,"_24697":58983,"_17272":100680,"_5":17167,"_23367":100583,"_2365":100681},[],"Path relativo",{"_2837":59024,"_24697":58983,"_17272":100683,"_5":17167,"_23367":100583,"_2365":95704},[],{"_2837":59025,"_24697":58983,"_17272":100685,"_5":17167,"_23367":100583,"_2365":46487},[],{"_2837":59026,"_24697":58983,"_17272":100687,"_5":17167,"_23367":100583,"_2365":46490},[],{"_2837":59027,"_24697":58983,"_17272":100689,"_5":17167,"_23367":100583,"_2365":100690},[],"Consultar `crl_options` y `latest_crl`.",{"_2837":59028,"_24697":58983,"_17272":100692,"_5":17167,"_23367":100583,"_2365":46496},[],{"_2837":59029,"_24697":58983,"_17272":100694,"_5":17167,"_23367":100583,"_2365":46490},[],{"_2837":59030,"_24697":58983,"_17272":100696,"_5":17167,"_23367":100583,"_2365":100697},[],"Sustituir la configuración de CRL.",{"_2837":59031,"_24697":58983,"_17272":100699,"_5":17167,"_23367":100583,"_2365":100700},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2837":59032,"_24697":58983,"_17272":100702,"_5":17167,"_23367":100583,"_2365":100703},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2837":59033,"_24697":58983,"_17272":100705,"_5":17167,"_23367":100587,"_2365":100706},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2837":59034,"_24697":58983,"_17272":100708,"_5":17167,"_23367":100591,"_2365":100709},[],"RFC 5280: perfil X.509 y CRL.",{"_2837":59035,"_24697":58983,"_17272":100711,"_5":17167,"_23367":100591,"_2365":46516},[],{"_2837":59036,"_24697":58983,"_17272":100713,"_5":17167,"_23367":100591,"_2365":46519},[],{"_2837":59037,"_24697":58983,"_17272":100715,"_5":17167,"_23367":100591,"_2365":100716},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2837":59038,"_24697":58983,"_17272":100718,"_5":17167,"_23367":100591,"_2365":100719},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2837":59039,"_24697":59039,"_5":12136,"_2365":100721,"_25033":100722,"_17272":100723,"_23367":59039},"Claves y motores criptográficos",[40259,95913,45225,99432],[],{"_2837":59040,"_24697":59039,"_17272":100725,"_5":17167,"_23367":59039,"_2365":100726},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2837":59041,"_24697":59039,"_5":25030,"_17272":100728,"_23367":100729,"_2365":100730},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2837":59042,"_24697":59039,"_5":25030,"_17272":100732,"_23367":100733,"_2365":100734},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2837":59043,"_24697":59039,"_5":25030,"_17272":100736,"_23367":100737,"_2365":46544},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#file-system",{"_2837":59044,"_24697":59039,"_5":25030,"_17272":100739,"_23367":100740,"_2365":46548},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#hashicorp-vault",{"_2837":59045,"_24697":59039,"_5":25030,"_17272":100742,"_23367":100743,"_2365":46552},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#aws-secrets-manager",{"_2837":59046,"_24697":59039,"_5":25030,"_17272":100745,"_23367":100746,"_2365":46556},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#aws-kms",{"_2837":59047,"_24697":59039,"_5":25030,"_17272":100748,"_23367":100749,"_2365":46560},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#pkcs11",{"_2837":59048,"_24697":59039,"_5":25030,"_17272":100751,"_23367":100752,"_2365":46564},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#azure-key-vault",{"_2837":59049,"_24697":59039,"_5":25030,"_17272":100754,"_23367":100755,"_2365":100756},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2837":59050,"_24697":59039,"_5":25030,"_17272":100758,"_23367":100759,"_2365":100760},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2837":59051,"_24697":59039,"_5":25030,"_17272":100762,"_23367":100763,"_2365":100764},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2837":59052,"_24697":59039,"_5":25030,"_17272":100766,"_23367":100767,"_2365":100768},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2837":59053,"_24697":59039,"_5":25030,"_17272":100770,"_23367":100771,"_2365":100772},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2837":59054,"_24697":59039,"_5":25030,"_17272":100774,"_23367":100775,"_2365":100776},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2837":59055,"_24697":59039,"_5":25030,"_17272":100778,"_23367":100779,"_2365":100780},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2837":59056,"_24697":59039,"_5":25030,"_17272":100782,"_23367":100783,"_2365":46596},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#sign",{"_2837":59057,"_24697":59039,"_5":25030,"_17272":100785,"_23367":100786,"_2365":46600},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#verify",{"_2837":59058,"_24697":59039,"_5":25030,"_17272":100788,"_23367":100789,"_2365":100790},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2837":59059,"_24697":59039,"_5":25030,"_17272":100792,"_23367":100793,"_2365":100794},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2837":59060,"_24697":59039,"_5":25030,"_17272":100796,"_23367":100797,"_2365":100798},[],"/docs/pr-preview/pr-36/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2837":59061,"_24697":59039,"_17272":100800,"_5":17167,"_23367":59039,"_2365":100801},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2837":59062,"_24697":59039,"_17272":100803,"_5":17167,"_23367":59039,"_2365":100804},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2837":59063,"_24697":59039,"_17272":100806,"_5":17167,"_23367":100729,"_2365":100807},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2837":59064,"_24697":59039,"_17272":100809,"_5":17167,"_23367":100729,"_2365":100810},[],"En la práctica, permite:",{"_2837":59065,"_24697":59039,"_17272":100812,"_5":17167,"_23367":100729,"_2365":100813},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2837":59066,"_24697":59039,"_17272":100815,"_5":17167,"_23367":100729,"_2365":100816},[],"Importar claves creadas externamente.",{"_2837":59067,"_24697":59039,"_17272":100818,"_5":17167,"_23367":100729,"_2365":100819},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2837":59068,"_24697":59039,"_17272":100821,"_5":17167,"_23367":100729,"_2365":100822},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2837":59069,"_24697":59039,"_17272":100824,"_5":17167,"_23367":100733,"_2365":100825},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2837":59070,"_24697":59039,"_17272":100827,"_5":17167,"_23367":100733,"_2365":100828},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2837":59071,"_24697":59039,"_17272":100830,"_5":17167,"_23367":100733,"_2365":100831},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2837":59072,"_24697":59039,"_17272":100833,"_5":17167,"_23367":100737,"_2365":100834},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2837":59073,"_24697":59039,"_17272":100836,"_5":17167,"_23367":100740,"_2365":100837},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2837":59074,"_24697":59039,"_17272":100839,"_5":17167,"_23367":100743,"_2365":100840},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2837":59075,"_24697":59039,"_17272":100842,"_5":17167,"_23367":100746,"_2365":100843},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2837":59076,"_24697":59039,"_17272":100845,"_5":17167,"_23367":100749,"_2365":100846},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2837":59077,"_24697":59039,"_17272":100848,"_5":17167,"_23367":100752,"_2365":100849},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2837":59078,"_24697":59039,"_17272":100851,"_5":17167,"_23367":100752,"_2365":100852},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2837":59079,"_24697":59039,"_17272":100854,"_5":17167,"_23367":100752,"_2365":100855},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2837":59080,"_24697":59039,"_17272":100857,"_5":17167,"_23367":100752,"_2365":100858},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2837":59081,"_24697":59039,"_17272":100860,"_5":17167,"_23367":100755,"_2365":100861},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2837":59082,"_24697":59039,"_17272":100863,"_5":17167,"_23367":100755,"_2365":100864},[],"La tabla incluye los siguientes campos:",{"_2837":59083,"_24697":59039,"_17272":100866,"_5":17167,"_23367":100755,"_2365":100867},[],"**Name**: nombre descriptivo de la clave.",{"_2837":59084,"_24697":59039,"_17272":100869,"_5":17167,"_23367":100755,"_2365":100870},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2837":59085,"_24697":59039,"_17272":100872,"_5":17167,"_23367":100755,"_2365":100873},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2837":59086,"_24697":59039,"_17272":100875,"_5":17167,"_23367":100755,"_2365":100876},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2837":59087,"_24697":59039,"_17272":100878,"_5":17167,"_23367":100755,"_2365":100879},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2837":59088,"_24697":59039,"_17272":100881,"_5":17167,"_23367":100755,"_2365":100882},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2837":59089,"_24697":59039,"_17272":100884,"_5":17167,"_23367":100755,"_2365":100885},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2837":59090,"_24697":59039,"_17272":100887,"_5":17167,"_23367":100755,"_2365":100888},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2837":59091,"_24697":59039,"_17272":100890,"_5":17167,"_23367":100755,"_2365":100891},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2837":59092,"_24697":59039,"_17272":100893,"_5":17167,"_23367":100755,"_2365":100894},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2837":59093,"_24697":59039,"_17272":100896,"_5":17167,"_23367":100755,"_2365":100897},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2837":59094,"_24697":59039,"_17272":100899,"_5":17167,"_23367":100755,"_2365":100900},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2837":59095,"_24697":59039,"_17272":100902,"_5":17167,"_23367":100755,"_2365":100903},[],"**Delete Key** para eliminar la clave del sistema.",{"_2837":59096,"_24697":59039,"_17272":100905,"_5":17167,"_23367":100759,"_2365":100906},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2837":59097,"_24697":59039,"_17272":100908,"_5":17167,"_23367":100763,"_2365":100909},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2837":59098,"_24697":59039,"_17272":100911,"_5":17167,"_23367":100763,"_2365":100912},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2837":59099,"_24697":59039,"_17272":100914,"_5":17167,"_23367":100763,"_2365":100915},[],"**Key Name**: nombre único y descriptivo.",{"_2837":59100,"_24697":59039,"_17272":100917,"_5":17167,"_23367":100763,"_2365":100918},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2837":59101,"_24697":59039,"_17272":100920,"_5":17167,"_23367":100763,"_2365":100921},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2837":59102,"_24697":59039,"_17272":100923,"_5":17167,"_23367":100763,"_2365":100924},[],"**Tags**: metadatos para clasificar la clave.",{"_2837":59103,"_24697":59039,"_17272":100926,"_5":17167,"_23367":100763,"_2365":100927},[],"**Metadata**: información adicional para usos avanzados.",{"_2837":59104,"_24697":59039,"_17272":100929,"_5":17167,"_23367":100767,"_2365":100930},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2837":59105,"_24697":59039,"_17272":100932,"_5":17167,"_23367":100767,"_2365":100933},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2837":59106,"_24697":59039,"_17272":100935,"_5":17167,"_23367":100767,"_2365":100936},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2837":59107,"_24697":59039,"_17272":100938,"_5":17167,"_23367":100767,"_2365":100939},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2837":59108,"_24697":59039,"_17272":100941,"_5":17167,"_23367":100767,"_2365":100942},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2837":59109,"_24697":59039,"_17272":100944,"_5":17167,"_23367":100767,"_2365":100945},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2837":59110,"_24697":59039,"_17272":100947,"_5":17167,"_23367":100767,"_2365":100948},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2837":59111,"_24697":59039,"_17272":100950,"_5":17167,"_23367":100767,"_2365":100951},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2837":59112,"_24697":59039,"_17272":100953,"_5":17167,"_23367":100767,"_2365":100954},[],"**Metadata**: información adicional opcional.",{"_2837":59113,"_24697":59039,"_17272":100956,"_5":17167,"_23367":100767,"_2365":100957},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2837":59114,"_24697":59039,"_17272":100959,"_5":17167,"_23367":100767,"_2365":100960},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2837":59115,"_24697":59039,"_17272":100962,"_5":17167,"_23367":100771,"_2365":100963},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2837":59116,"_24697":59039,"_17272":100965,"_5":17167,"_23367":100775,"_2365":100966},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2837":59117,"_24697":59039,"_17272":100968,"_5":17167,"_23367":100775,"_2365":100969},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2837":59118,"_24697":59039,"_17272":100971,"_5":17167,"_23367":100775,"_2365":100972},[],"**Key Name**: nombre descriptivo.",{"_2837":59119,"_24697":59039,"_17272":100974,"_5":17167,"_23367":100775,"_2365":100975},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2837":59120,"_24697":59039,"_17272":100977,"_5":17167,"_23367":100775,"_2365":100978},[],"**Tags**: etiquetas asociadas.",{"_2837":59121,"_24697":59039,"_17272":100980,"_5":17167,"_23367":100775,"_2365":100981},[],"**Aliases**: nombres alternativos.",{"_2837":59122,"_24697":59039,"_17272":100983,"_5":17167,"_23367":100775,"_2365":100984},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2837":59123,"_24697":59039,"_17272":100986,"_5":17167,"_23367":100775,"_2365":100987},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2837":59124,"_24697":59039,"_17272":100989,"_5":17167,"_23367":100775,"_2365":100990},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2837":59125,"_24697":59039,"_17272":100992,"_5":17167,"_23367":100775,"_2365":100993},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2837":59126,"_24697":59039,"_17272":100995,"_5":17167,"_23367":100779,"_2365":100996},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2837":59127,"_24697":59039,"_17272":100998,"_5":17167,"_23367":100779,"_2365":100999},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2837":59128,"_24697":59039,"_17272":101001,"_5":17167,"_23367":100779,"_2365":101002},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2837":59129,"_24697":59039,"_17272":101004,"_5":17167,"_23367":100783,"_2365":101005},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2837":59130,"_24697":59039,"_17272":101007,"_5":17167,"_23367":100783,"_2365":101008},[],"Campos principales:",{"_2837":59131,"_24697":59039,"_17272":101010,"_5":17167,"_23367":100783,"_2365":101011},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2837":59132,"_24697":59039,"_17272":101013,"_5":17167,"_23367":100783,"_2365":101014},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2837":59133,"_24697":59039,"_17272":101016,"_5":17167,"_23367":100783,"_2365":101017},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2837":59134,"_24697":59039,"_17272":101019,"_5":17167,"_23367":100783,"_2365":101020},[],"**Message**: contenido que se va a firmar.",{"_2837":59135,"_24697":59039,"_17272":101022,"_5":17167,"_23367":100783,"_2365":101023},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2837":59136,"_24697":59039,"_17272":101025,"_5":17167,"_23367":100786,"_2365":101026},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2837":59137,"_24697":59039,"_17272":101028,"_5":17167,"_23367":100786,"_2365":101008},[],{"_2837":59138,"_24697":59039,"_17272":101030,"_5":17167,"_23367":100786,"_2365":101031},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2837":59139,"_24697":59039,"_17272":101033,"_5":17167,"_23367":100786,"_2365":101034},[],"**Message Type**: `Raw` o `Digest`.",{"_2837":59140,"_24697":59039,"_17272":101036,"_5":17167,"_23367":100786,"_2365":101037},[],"**Payload Encoding**: codificación del mensaje.",{"_2837":59141,"_24697":59039,"_17272":101039,"_5":17167,"_23367":100786,"_2365":101040},[],"**Message**: mensaje original o hash.",{"_2837":59142,"_24697":59039,"_17272":101042,"_5":17167,"_23367":100786,"_2365":101043},[],"**Signature**: firma que se desea comprobar.",{"_2837":59143,"_24697":59039,"_17272":101045,"_5":17167,"_23367":100786,"_2365":101046},[],"**Result**: indicador del resultado de la validación.",{"_2837":59144,"_24697":59039,"_17272":101048,"_5":17167,"_23367":100789,"_2365":101049},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2837":59145,"_24697":59039,"_17272":101051,"_5":17167,"_23367":100789,"_2365":101052},[],"Este flujo es útil para:",{"_2837":59146,"_24697":59039,"_17272":101054,"_5":17167,"_23367":100789,"_2365":101055},[],"Solicitar certificados a una CA externa.",{"_2837":59147,"_24697":59039,"_17272":101057,"_5":17167,"_23367":100789,"_2365":101058},[],"Renovar una identidad manteniendo la misma clave.",{"_2837":59148,"_24697":59039,"_17272":101060,"_5":17167,"_23367":100789,"_2365":101061},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2837":59149,"_24697":59039,"_17272":101063,"_5":17167,"_23367":100789,"_2365":101064},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2837":59150,"_24697":59039,"_17272":101066,"_5":17167,"_23367":100789,"_2365":101067},[],"**Organization (O)**: organización o empresa.",{"_2837":59151,"_24697":59039,"_17272":101069,"_5":17167,"_23367":100789,"_2365":101070},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2837":59152,"_24697":59039,"_17272":101072,"_5":17167,"_23367":100789,"_2365":101073},[],"**Country (C)**: código de país de dos letras.",{"_2837":59153,"_24697":59039,"_17272":101075,"_5":17167,"_23367":100789,"_2365":101076},[],"**State / Province (ST)**: estado o provincia.",{"_2837":59154,"_24697":59039,"_17272":101078,"_5":17167,"_23367":100789,"_2365":101079},[],"**Locality (L)**: ciudad o localidad.",{"_2837":59155,"_24697":59039,"_17272":101081,"_5":17167,"_23367":100789,"_2365":101082},[],"**Email Address**: correo de contacto.",{"_2837":59156,"_24697":59039,"_17272":101084,"_5":17167,"_23367":100789,"_2365":101085},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2837":59157,"_24697":59039,"_17272":101087,"_5":17167,"_23367":100789,"_2365":101088},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2837":59158,"_24697":59039,"_17272":101090,"_5":17167,"_23367":100793,"_2365":101091},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2837":59159,"_24697":59039,"_17272":101093,"_5":17167,"_23367":100793,"_2365":46908},[],{"_2837":59160,"_24697":59039,"_17272":101095,"_5":17167,"_23367":100797,"_2365":101096},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2837":59161,"_24697":59161,"_5":12136,"_2365":101098,"_25033":101099,"_17272":101100,"_23367":59161},"Validación online con OCSP",[40259,95913,45225,100047],[],{"_2837":59162,"_24697":59161,"_17272":101102,"_5":17167,"_23367":59161,"_2365":101103},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2837":59163,"_24697":59161,"_5":25030,"_17272":101105,"_23367":101106,"_2365":101107},[],"/docs/pr-preview/pr-36/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2837":59164,"_24697":59161,"_5":25030,"_17272":101109,"_23367":101110,"_2365":101111},[],"/docs/pr-preview/pr-36/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2837":59165,"_24697":59161,"_5":25030,"_17272":101113,"_23367":101114,"_2365":101115},[],"/docs/pr-preview/pr-36/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2837":59166,"_24697":59161,"_5":25030,"_17272":101117,"_23367":101118,"_2365":101119},[],"/docs/pr-preview/pr-36/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2837":59167,"_24697":59161,"_5":25030,"_17272":101121,"_23367":101122,"_2365":101123},[],"/docs/pr-preview/pr-36/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2837":59168,"_24697":59161,"_5":25030,"_17272":101125,"_23367":101126,"_2365":100592},[],"/docs/pr-preview/pr-36/es/platform/pki/ocsp#referencias",{"_2837":59169,"_24697":59161,"_17272":101128,"_5":17167,"_23367":59161,"_2365":101129},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2837":59170,"_24697":59161,"_17272":101131,"_5":17167,"_23367":101106,"_2365":101132},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2837":59171,"_24697":59161,"_17272":101134,"_5":17167,"_23367":101106,"_2365":101135},[],"Estado del registro",{"_2837":59172,"_24697":59161,"_17272":101137,"_5":17167,"_23367":101106,"_2365":101138},[],"Respuesta firmada",{"_2837":59173,"_24697":59161,"_17272":101140,"_5":17167,"_23367":101106,"_2365":44403},[],{"_2837":59174,"_24697":59161,"_17272":101142,"_5":17167,"_23367":101106,"_2365":46958},[],{"_2837":59175,"_24697":59161,"_17272":101144,"_5":17167,"_23367":101106,"_2365":44420},[],{"_2837":59176,"_24697":59161,"_17272":101146,"_5":17167,"_23367":101106,"_2365":101147},[],"`Revoked`, con razón y fecha de revocación.",{"_2837":59177,"_24697":59161,"_17272":101149,"_5":17167,"_23367":101106,"_2365":101150},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2837":59178,"_24697":59161,"_17272":101152,"_5":17167,"_23367":101106,"_2365":101153},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2837":59179,"_24697":59161,"_17272":101155,"_5":17167,"_23367":101106,"_2365":101156},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2837":59180,"_24697":59161,"_17272":101158,"_5":17167,"_23367":101106,"_2365":101159},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2837":59181,"_24697":59161,"_17272":101161,"_5":17167,"_23367":101106,"_2365":101162},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2837":59182,"_24697":59161,"_17272":101164,"_5":17167,"_23367":101110,"_2365":101165},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2837":59183,"_24697":59161,"_17272":101167,"_5":17167,"_23367":101110,"_2365":101168},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2837":59184,"_24697":59161,"_17272":101170,"_5":17167,"_23367":101114,"_2365":101171},[],"El servicio acepta:",{"_2837":59185,"_24697":59161,"_17272":101173,"_5":17167,"_23367":101114,"_2365":97539},[],{"_2837":59186,"_24697":59161,"_17272":101175,"_5":17167,"_23367":101114,"_2365":101176},[],"Ruta del servicio VA",{"_2837":59187,"_24697":59161,"_17272":101178,"_5":17167,"_23367":101114,"_2365":101179},[],"Formato",{"_2837":59188,"_24697":59161,"_17272":101181,"_5":17167,"_23367":101114,"_2365":46998},[],{"_2837":59189,"_24697":59161,"_17272":101183,"_5":17167,"_23367":101114,"_2365":47001},[],{"_2837":59190,"_24697":59161,"_17272":101185,"_5":17167,"_23367":101114,"_2365":101186},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2837":59191,"_24697":59161,"_17272":101188,"_5":17167,"_23367":101114,"_2365":46487},[],{"_2837":59192,"_24697":59161,"_17272":101190,"_5":17167,"_23367":101114,"_2365":47009},[],{"_2837":59193,"_24697":59161,"_17272":101192,"_5":17167,"_23367":101114,"_2365":101193},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2837":59194,"_24697":59161,"_17272":101195,"_5":17167,"_23367":101114,"_2365":101196},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2837":59195,"_24697":59161,"_17272":101198,"_5":17167,"_23367":101118,"_2365":101199},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2837":59196,"_24697":59161,"_17272":101201,"_5":17167,"_23367":101118,"_2365":101202},[],"Genera la solicitud:",{"_2837":59197,"_24697":59161,"_17272":101204,"_5":17167,"_23367":101118,"_2365":101205},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2837":59198,"_24697":59161,"_17272":101207,"_5":17167,"_23367":101118,"_2365":101208},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2837":59199,"_24697":59161,"_17272":101210,"_5":17167,"_23367":101118,"_2365":101211},[],"Verifica el DER recibido:",{"_2837":59200,"_24697":59161,"_17272":101213,"_5":17167,"_23367":101118,"_2365":101214},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2837":59201,"_24697":59161,"_17272":101216,"_5":17167,"_23367":101122,"_2365":101217},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2837":59202,"_24697":59161,"_17272":101219,"_5":17167,"_23367":101122,"_2365":101220},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2837":59203,"_24697":59161,"_17272":101222,"_5":17167,"_23367":101126,"_2365":47042},[],{"_2837":59204,"_24697":59161,"_17272":101224,"_5":17167,"_23367":101126,"_2365":47045},[],{"_2837":59205,"_24697":59161,"_17272":101226,"_5":17167,"_23367":101126,"_2365":101227},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2837":59206,"_24697":59161,"_17272":101229,"_5":17167,"_23367":101126,"_2365":100719},[],{"_2837":59207,"_24697":59207,"_5":12136,"_2365":45225,"_25033":101231,"_17272":101232,"_23367":59207},[40259,95913,45225],[],{"_2837":59208,"_24697":59207,"_17272":101234,"_5":17167,"_23367":59207,"_2365":101235},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2837":59209,"_24697":59207,"_5":25030,"_17272":101237,"_23367":101238,"_2365":98756},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#empieza-aquí",{"_2837":59210,"_24697":59207,"_5":25030,"_17272":101240,"_23367":101241,"_2365":101242},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2837":59211,"_24697":59207,"_5":25030,"_17272":101244,"_23367":101245,"_2365":99278},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#capacidades-principales",{"_2837":59212,"_24697":59207,"_5":25030,"_17272":101247,"_23367":101248,"_2365":99282},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2837":59213,"_24697":59207,"_5":25030,"_17272":101250,"_23367":101251,"_2365":99286},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2837":59214,"_24697":59207,"_5":25030,"_17272":101253,"_23367":101254,"_2365":99290},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#emite-y-controla-certificados",{"_2837":59215,"_24697":59207,"_5":25030,"_17272":101256,"_23367":101257,"_2365":99298},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#publica-el-estado-de-validación",{"_2837":59216,"_24697":59207,"_5":25030,"_17272":101259,"_23367":101260,"_2365":101261},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2837":59217,"_24697":59207,"_5":25030,"_17272":101263,"_23367":101264,"_2365":100213},[],"/docs/pr-preview/pr-36/es/platform/pki/overview#continúa",{"_2837":59218,"_24697":59207,"_17272":101266,"_5":17167,"_23367":59207,"_2365":101267},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2837":59219,"_24697":59207,"_17272":101269,"_5":17167,"_23367":101238,"_2365":101270},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2837":59220,"_24697":59207,"_17272":101272,"_5":17167,"_23367":101238,"_2365":101273},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2837":59221,"_24697":59207,"_17272":101275,"_5":17167,"_23367":101241,"_2365":101276},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2837":59222,"_24697":59207,"_17272":101278,"_5":17167,"_23367":101241,"_2365":101279},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2837":59223,"_24697":59207,"_17272":101281,"_5":17167,"_23367":101241,"_2365":101282},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2837":59224,"_24697":59207,"_17272":101284,"_5":17167,"_23367":101241,"_2365":101285},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2837":59225,"_24697":59207,"_17272":101287,"_5":17167,"_23367":101241,"_2365":101288},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2837":59226,"_24697":59207,"_17272":101290,"_5":17167,"_23367":101248,"_2365":101291},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2837":59227,"_24697":59207,"_17272":101293,"_5":17167,"_23367":101251,"_2365":101294},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2837":59228,"_24697":59207,"_17272":101296,"_5":17167,"_23367":101254,"_2365":101297},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2837":59229,"_24697":59207,"_17272":101299,"_5":17167,"_23367":101257,"_2365":101300},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2837":59230,"_24697":59207,"_17272":101302,"_5":17167,"_23367":101260,"_2365":101303},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2837":59231,"_24697":59207,"_17272":101305,"_5":17167,"_23367":101260,"_2365":101306},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2837":59232,"_24697":59207,"_17272":101308,"_5":17167,"_23367":101260,"_2365":101309},[],"su clave pública corresponda a la clave privada del cliente;",{"_2837":59233,"_24697":59207,"_17272":101311,"_5":17167,"_23367":101260,"_2365":101312},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2837":59234,"_24697":59207,"_17272":101314,"_5":17167,"_23367":101260,"_2365":101315},[],"sus fechas y usos permitan la operación;",{"_2837":59235,"_24697":59207,"_17272":101317,"_5":17167,"_23367":101260,"_2365":101318},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2837":59236,"_24697":59207,"_17272":101320,"_5":17167,"_23367":101260,"_2365":101321},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2837":59237,"_24697":59207,"_17272":101323,"_5":17167,"_23367":101264,"_2365":101324},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2837":59238,"_24697":59207,"_17272":101326,"_5":17167,"_23367":101264,"_2365":101327},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2837":59239,"_24697":59207,"_17272":101329,"_5":17167,"_23367":101264,"_2365":101330},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2837":59240,"_24697":59240,"_5":12136,"_2365":101332,"_25033":101333,"_17272":101334,"_23367":59240},"Crea tu primera CA",[40259,95913,45225,98880],[],{"_2837":59241,"_24697":59240,"_17272":101336,"_5":17167,"_23367":59240,"_2365":101337},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2837":59242,"_24697":59240,"_5":25030,"_17272":101339,"_23367":101340,"_2365":94614},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2837":59243,"_24697":59240,"_5":25030,"_17272":101342,"_23367":101343,"_2365":101344},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2837":59244,"_24697":59240,"_5":25030,"_17272":101346,"_23367":101347,"_2365":101348},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2837":59245,"_24697":59240,"_5":25030,"_17272":101350,"_23367":101351,"_2365":101352},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2837":59246,"_24697":59240,"_5":25030,"_17272":101354,"_23367":101355,"_2365":101356},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2837":59247,"_24697":59240,"_5":25030,"_17272":101358,"_23367":101359,"_2365":101360},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2837":59248,"_24697":59240,"_5":25030,"_17272":101362,"_23367":101363,"_2365":101364},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2837":59249,"_24697":59240,"_5":25030,"_17272":101366,"_23367":101367,"_2365":99128},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2837":59250,"_24697":59240,"_5":25030,"_17272":101369,"_23367":101370,"_2365":94638},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2837":59251,"_24697":59240,"_17272":101372,"_5":17167,"_23367":59240,"_2365":101373},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2837":59252,"_24697":59240,"_17272":101375,"_5":17167,"_23367":101340,"_2365":101376},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2837":59253,"_24697":59240,"_17272":101378,"_5":17167,"_23367":101340,"_2365":101379},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2837":59254,"_24697":59240,"_17272":101381,"_5":17167,"_23367":101340,"_2365":101382},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2837":59255,"_24697":59240,"_17272":101384,"_5":17167,"_23367":101340,"_2365":101385},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2837":59256,"_24697":59240,"_17272":101387,"_5":17167,"_23367":101343,"_2365":101388},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2837":59257,"_24697":59240,"_17272":101390,"_5":17167,"_23367":101343,"_2365":101391},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2837":59258,"_24697":59240,"_17272":101393,"_5":17167,"_23367":101347,"_2365":101394},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2837":59259,"_24697":59240,"_17272":101396,"_5":17167,"_23367":101347,"_2365":101397},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2837":59260,"_24697":59240,"_17272":101399,"_5":17167,"_23367":101351,"_2365":101400},[],"Selecciona **Root CA** y completa:",{"_2837":59261,"_24697":59240,"_17272":101402,"_5":17167,"_23367":101351,"_2365":47224},[],{"_2837":59262,"_24697":59240,"_17272":101404,"_5":17167,"_23367":101351,"_2365":101405},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2837":59263,"_24697":59240,"_17272":101407,"_5":17167,"_23367":101351,"_2365":101408},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2837":59264,"_24697":59240,"_17272":101410,"_5":17167,"_23367":101351,"_2365":101411},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2837":59265,"_24697":59240,"_17272":101413,"_5":17167,"_23367":101351,"_2365":101414},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2837":59266,"_24697":59240,"_17272":101416,"_5":17167,"_23367":101355,"_2365":101417},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2837":59267,"_24697":59240,"_17272":101419,"_5":17167,"_23367":101359,"_2365":101420},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2837":59268,"_24697":59240,"_17272":101422,"_5":17167,"_23367":101359,"_2365":101423},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2837":59269,"_24697":59240,"_17272":101425,"_5":17167,"_23367":101363,"_2365":101426},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2837":59270,"_24697":59240,"_17272":101428,"_5":17167,"_23367":101363,"_2365":101429},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2837":59271,"_24697":59240,"_17272":101431,"_5":17167,"_23367":101363,"_2365":101432},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2837":59272,"_24697":59240,"_17272":101434,"_5":17167,"_23367":101367,"_2365":101435},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2837":59273,"_24697":59240,"_17272":101437,"_5":17167,"_23367":101367,"_2365":101438},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2837":59274,"_24697":59240,"_17272":101440,"_5":17167,"_23367":101367,"_2365":101441},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2837":59275,"_24697":59240,"_17272":101443,"_5":17167,"_23367":101367,"_2365":101444},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2837":59276,"_24697":59240,"_17272":101446,"_5":17167,"_23367":101370,"_2365":101447},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2837":59277,"_24697":59277,"_5":12136,"_2365":101449,"_25033":101450,"_17272":101451,"_23367":59277},"Emite y verifica un certificado",[40259,95913,45225,98880],[],{"_2837":59278,"_24697":59277,"_17272":101453,"_5":17167,"_23367":59277,"_2365":101454},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2837":59279,"_24697":59277,"_5":25030,"_17272":101456,"_23367":101457,"_2365":94614},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2837":59280,"_24697":59277,"_5":25030,"_17272":101459,"_23367":101460,"_2365":101461},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2837":59281,"_24697":59277,"_5":25030,"_17272":101463,"_23367":101464,"_2365":101465},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2837":59282,"_24697":59277,"_5":25030,"_17272":101467,"_23367":101468,"_2365":101469},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2837":59283,"_24697":59277,"_5":25030,"_17272":101471,"_23367":101472,"_2365":101473},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2837":59284,"_24697":59277,"_5":25030,"_17272":101475,"_23367":101476,"_2365":101477},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2837":59285,"_24697":59277,"_5":25030,"_17272":101479,"_23367":101480,"_2365":101360},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2837":59286,"_24697":59277,"_5":25030,"_17272":101482,"_23367":101483,"_2365":101484},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2837":59287,"_24697":59277,"_5":25030,"_17272":101486,"_23367":101487,"_2365":101488},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2837":59288,"_24697":59277,"_5":25030,"_17272":101490,"_23367":101491,"_2365":101492},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2837":59289,"_24697":59277,"_5":25030,"_17272":101494,"_23367":101495,"_2365":99128},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2837":59290,"_24697":59277,"_5":25030,"_17272":101497,"_23367":101498,"_2365":94638},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2837":59291,"_24697":59277,"_17272":101500,"_5":17167,"_23367":59277,"_2365":101501},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2837":59292,"_24697":59277,"_17272":101503,"_5":17167,"_23367":101457,"_2365":101504},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2837":59293,"_24697":59277,"_17272":101506,"_5":17167,"_23367":101457,"_2365":101507},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2837":59294,"_24697":59277,"_17272":101509,"_5":17167,"_23367":101457,"_2365":101510},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2837":59295,"_24697":59277,"_17272":101512,"_5":17167,"_23367":101457,"_2365":101513},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2837":59296,"_24697":59277,"_17272":101515,"_5":17167,"_23367":101457,"_2365":101516},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2837":59297,"_24697":59277,"_17272":101518,"_5":17167,"_23367":101460,"_2365":101519},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2837":59298,"_24697":59277,"_17272":101521,"_5":17167,"_23367":101464,"_2365":101522},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2837":59299,"_24697":59277,"_17272":101524,"_5":17167,"_23367":101464,"_2365":101525},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2837":59300,"_24697":59277,"_17272":101527,"_5":17167,"_23367":101468,"_2365":101528},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2837":59301,"_24697":59277,"_17272":101530,"_5":17167,"_23367":101468,"_2365":101531},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2837":59302,"_24697":59277,"_17272":101533,"_5":17167,"_23367":101472,"_2365":101534},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2837":59303,"_24697":59277,"_17272":101536,"_5":17167,"_23367":101472,"_2365":101537},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2837":59304,"_24697":59277,"_17272":101539,"_5":17167,"_23367":101476,"_2365":101540},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2837":59305,"_24697":59277,"_17272":101542,"_5":17167,"_23367":101480,"_2365":101543},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2837":59306,"_24697":59277,"_17272":101545,"_5":17167,"_23367":101483,"_2365":101546},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2837":59307,"_24697":59277,"_17272":101548,"_5":17167,"_23367":101487,"_2365":101549},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2837":59308,"_24697":59277,"_17272":101551,"_5":17167,"_23367":101487,"_2365":101552},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2837":59309,"_24697":59277,"_17272":101554,"_5":17167,"_23367":101487,"_2365":101555},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2837":59310,"_24697":59277,"_17272":101557,"_5":17167,"_23367":101491,"_2365":101558},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2837":59311,"_24697":59277,"_17272":101560,"_5":17167,"_23367":101491,"_2365":101561},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2837":59312,"_24697":59277,"_17272":101563,"_5":17167,"_23367":101491,"_2365":101564},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2837":59313,"_24697":59277,"_17272":101566,"_5":17167,"_23367":101495,"_2365":99211},[],{"_2837":59314,"_24697":59277,"_17272":101568,"_5":17167,"_23367":101495,"_2365":97988},[],{"_2837":59315,"_24697":59277,"_17272":101570,"_5":17167,"_23367":101495,"_2365":101571},[],"La CA rechaza la emisión",{"_2837":59316,"_24697":59277,"_17272":101573,"_5":17167,"_23367":101495,"_2365":101574},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2837":59317,"_24697":59277,"_17272":101576,"_5":17167,"_23367":101495,"_2365":101577},[],"Sujeto o usos diferentes",{"_2837":59318,"_24697":59277,"_17272":101579,"_5":17167,"_23367":101495,"_2365":101580},[],"Perfil aplicado y valores solicitados.",{"_2837":59319,"_24697":59277,"_17272":101582,"_5":17167,"_23367":101495,"_2365":101583},[],"No se encuentra el emisor",{"_2837":59320,"_24697":59277,"_17272":101585,"_5":17167,"_23367":101495,"_2365":101586},[],"CA descargada y cadena intermedia necesaria.",{"_2837":59321,"_24697":59277,"_17272":101588,"_5":17167,"_23367":101495,"_2365":101589},[],"Falla la vigencia",{"_2837":59322,"_24697":59277,"_17272":101591,"_5":17167,"_23367":101495,"_2365":101592},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2837":59323,"_24697":59277,"_17272":101594,"_5":17167,"_23367":101495,"_2365":101595},[],"Los resúmenes de clave difieren",{"_2837":59324,"_24697":59277,"_17272":101597,"_5":17167,"_23367":101495,"_2365":101598},[],"Archivos de certificado y clave de la misma emisión.",{"_2837":59325,"_24697":59277,"_17272":101600,"_5":17167,"_23367":101495,"_2365":101601},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2837":59326,"_24697":59277,"_17272":101603,"_5":17167,"_23367":101498,"_2365":101604},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2837":59327,"_24697":59277,"_17272":101606,"_5":17167,"_23367":101498,"_2365":101607},[],"Gestionar certificados para inspección, estado y revocación.",{"_2837":59328,"_24697":59277,"_17272":101609,"_5":17167,"_23367":101498,"_2365":101610},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2837":59329,"_24697":59277,"_17272":101612,"_5":17167,"_23367":101498,"_2365":101613},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2837":59330,"_24697":59277,"_17272":101615,"_5":17167,"_23367":101498,"_2365":101616},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2837":59331,"_24697":59331,"_5":12136,"_2365":101618,"_25033":101619,"_17272":101620,"_23367":59331},"Primeros pasos de PKI",[40259,95913,45225,98880],[],{"_2837":59332,"_24697":59331,"_17272":101622,"_5":17167,"_23367":59331,"_2365":101623},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2837":59333,"_24697":59331,"_5":25030,"_17272":101625,"_23367":101626,"_2365":94614},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2837":59334,"_24697":59331,"_5":25030,"_17272":101628,"_23367":101629,"_2365":101630},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2837":59335,"_24697":59331,"_5":25030,"_17272":101632,"_23367":101633,"_2365":99062},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2837":59336,"_24697":59331,"_5":25030,"_17272":101635,"_23367":101636,"_2365":101637},[],"/docs/pr-preview/pr-36/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2837":59337,"_24697":59331,"_17272":101639,"_5":17167,"_23367":59331,"_2365":101640},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2837":59338,"_24697":59331,"_17272":101642,"_5":17167,"_23367":101626,"_2365":101643},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2837":59339,"_24697":59331,"_17272":101645,"_5":17167,"_23367":101626,"_2365":101646},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2837":59340,"_24697":59331,"_17272":101648,"_5":17167,"_23367":101626,"_2365":101649},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2837":59341,"_24697":59331,"_17272":101651,"_5":17167,"_23367":101626,"_2365":101652},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2837":59342,"_24697":59331,"_17272":101654,"_5":17167,"_23367":101626,"_2365":101655},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2837":59343,"_24697":59331,"_17272":101657,"_5":17167,"_23367":101629,"_2365":101658},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2837":59344,"_24697":59331,"_17272":101660,"_5":17167,"_23367":101629,"_2365":101661},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2837":59345,"_24697":59331,"_17272":101663,"_5":17167,"_23367":101629,"_2365":101664},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2837":59346,"_24697":59331,"_17272":101666,"_5":17167,"_23367":101629,"_2365":101667},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2837":59347,"_24697":59331,"_17272":101669,"_5":17167,"_23367":101633,"_2365":101670},[],"Archivo o recurso",{"_2837":59348,"_24697":59331,"_17272":101672,"_5":17167,"_23367":101633,"_2365":99059},[],{"_2837":59349,"_24697":59331,"_17272":101674,"_5":17167,"_23367":101633,"_2365":101675},[],"CA raíz activa y `ca.pem`",{"_2837":59350,"_24697":59331,"_17272":101677,"_5":17167,"_23367":101633,"_2365":101678},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2837":59351,"_24697":59331,"_17272":101680,"_5":17167,"_23367":101633,"_2365":101681},[],"Certificado final y `device.crt`",{"_2837":59352,"_24697":59331,"_17272":101683,"_5":17167,"_23367":101633,"_2365":101684},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2837":59353,"_24697":59331,"_17272":101686,"_5":17167,"_23367":101633,"_2365":101687},[],"Clave privada `device.key`",{"_2837":59354,"_24697":59331,"_17272":101689,"_5":17167,"_23367":101633,"_2365":101690},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2837":59355,"_24697":59331,"_17272":101692,"_5":17167,"_23367":101633,"_2365":101693},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2837":59356,"_24697":59331,"_17272":101695,"_5":17167,"_23367":101636,"_2365":101696},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2837":59357,"_24697":59331,"_17272":101698,"_5":17167,"_23367":101636,"_2365":101699},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2837":59358,"_24697":59331,"_17272":101701,"_5":17167,"_23367":101636,"_2365":101702},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2837":59359,"_24697":59359,"_5":12136,"_2365":101704,"_25033":101705,"_17272":101707,"_23367":59359},"Resolución de problemas PKI",[40259,95913,45225,101706],"Resolución de problemas",[],{"_2837":59360,"_24697":59359,"_17272":101709,"_5":17167,"_23367":59359,"_2365":101710},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2837":59361,"_24697":59359,"_5":25030,"_17272":101712,"_23367":101713,"_2365":101714},[],"/docs/pr-preview/pr-36/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2837":59362,"_24697":59359,"_5":25030,"_17272":101716,"_23367":101717,"_2365":101718},[],"/docs/pr-preview/pr-36/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2837":59363,"_24697":59359,"_5":25030,"_17272":101720,"_23367":101721,"_2365":101722},[],"/docs/pr-preview/pr-36/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2837":59364,"_24697":59359,"_17272":101724,"_5":17167,"_23367":59359,"_2365":101725},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2837":59365,"_24697":59359,"_17272":101727,"_5":17167,"_23367":59359,"_2365":101728},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2837":59366,"_24697":59359,"_17272":101730,"_5":17167,"_23367":101713,"_2365":99059},[],{"_2837":59367,"_24697":59359,"_17272":101732,"_5":17167,"_23367":101713,"_2365":97988},[],{"_2837":59368,"_24697":59359,"_17272":101734,"_5":17167,"_23367":101713,"_2365":94638},[],{"_2837":59369,"_24697":59359,"_17272":101736,"_5":17167,"_23367":101713,"_2365":47560},[],{"_2837":59370,"_24697":59359,"_17272":101738,"_5":17167,"_23367":101713,"_2365":101739},[],"Existe, está activa y sus fechas son utilizables.",{"_2837":59371,"_24697":59359,"_17272":101741,"_5":17167,"_23367":101713,"_2365":101742},[],"Autoridades.",{"_2837":59372,"_24697":59359,"_17272":101744,"_5":17167,"_23367":101713,"_2365":101745},[],"Clave",{"_2837":59373,"_24697":59359,"_17272":101747,"_5":17167,"_23367":101713,"_2365":101748},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2837":59374,"_24697":59359,"_17272":101750,"_5":17167,"_23367":101713,"_2365":101751},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2837":59375,"_24697":59359,"_17272":101753,"_5":17167,"_23367":101713,"_2365":47578},[],{"_2837":59376,"_24697":59359,"_17272":101755,"_5":17167,"_23367":101713,"_2365":101756},[],"PEM correcto y firma verificable.",{"_2837":59377,"_24697":59359,"_17272":101758,"_5":17167,"_23367":101713,"_2365":47584},[],{"_2837":59378,"_24697":59359,"_17272":101760,"_5":17167,"_23367":101713,"_2365":101761},[],"Perfil",{"_2837":59379,"_24697":59359,"_17272":101763,"_5":17167,"_23367":101713,"_2365":101764},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2837":59380,"_24697":59359,"_17272":101766,"_5":17167,"_23367":101713,"_2365":101767},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2837":59381,"_24697":59359,"_17272":101769,"_5":17167,"_23367":101713,"_2365":99211},[],{"_2837":59382,"_24697":59359,"_17272":101771,"_5":17167,"_23367":101713,"_2365":101772},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2837":59383,"_24697":59359,"_17272":101774,"_5":17167,"_23367":101713,"_2365":101775},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2837":59384,"_24697":59359,"_17272":101777,"_5":17167,"_23367":101713,"_2365":101778},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2837":59385,"_24697":59359,"_17272":101780,"_5":17167,"_23367":101713,"_2365":101781},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2837":59386,"_24697":59359,"_17272":101783,"_5":17167,"_23367":101717,"_2365":101784},[],"Revisa cada frontera por separado:",{"_2837":59387,"_24697":59359,"_17272":101786,"_5":17167,"_23367":101717,"_2365":101787},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2837":59388,"_24697":59359,"_17272":101789,"_5":17167,"_23367":101717,"_2365":101790},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2837":59389,"_24697":59359,"_17272":101792,"_5":17167,"_23367":101717,"_2365":101793},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2837":59390,"_24697":59359,"_17272":101795,"_5":17167,"_23367":101717,"_2365":101796},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2837":59391,"_24697":59359,"_17272":101798,"_5":17167,"_23367":101717,"_2365":101799},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2837":59392,"_24697":59359,"_17272":101801,"_5":17167,"_23367":101717,"_2365":101802},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2837":59393,"_24697":59359,"_17272":101804,"_5":17167,"_23367":101721,"_2365":101805},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2837":59394,"_24697":59359,"_17272":101807,"_5":17167,"_23367":101721,"_2365":101808},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_47638":101810,"_47640":101811,"_47642":101812,"_47644":101813,"_15014":2387,"_57043":2387},"spanish",[2365,24697,5,23367],{"_2365":20597,"_24697":20597,"_5":20597,"_23367":20597},{"_2365":101814,"_24697":104162,"_5":106510,"_23367":108858},{"_3781":101815,"_47648":101816,"_5":20597},{"_11899":4838,"_12219":4165,"_12226":11625,"_23921":4316,"_23486":6139,"_16395":3916,"_11920":2729,"_11927":4197,"_23883":5253,"_24227":4382,"_24248":3335,"_23896":3902,"_28477":5691,"_24259":2507,"_28482":5050,"_28485":24376,"_28488":7436,"_28491":20064,"_28494":5149,"_24560":8687,"_28499":15389,"_28501":17462,"_24608":4458,"_24550":2651,"_28505":12926,"_24576":4840,"_28509":4868,"_24277":16641,"_24555":9376,"_24626":3217,"_28514":3884,"_28516":6379,"_28518":7831,"_28520":2818,"_28522":3863,"_24755":4820,"_28525":17201,"_28527":5848,"_28529":3284,"_23934":5108,"_28532":3860,"_28534":6089,"_23928":3703,"_28537":2584,"_28539":4074,"_28541":4048,"_28544":3985,"_23964":7016,"_28548":5927,"_23874":2605,"_28551":6231,"_23901":14141,"_28554":12242,"_28556":2723,"_28559":19120,"_24603":2794,"_28562":8464,"_28564":22703,"_28567":2553,"_28569":4649,"_28571":5985,"_28573":2566,"_28575":9387,"_16398":2909,"_28578":14961,"_28580":7478,"_28582":14609,"_24271":2679,"_28585":5373,"_28587":14450,"_28589":2658,"_28591":3760,"_28593":14978,"_28595":4266,"_28597":8488,"_24683":4377,"_24298":16605,"_28601":4049,"_28603":7455,"_23912":4869,"_28606":7885,"_28608":5651,"_28610":5678,"_24631":11710,"_28613":4870,"_28615":3536,"_28617":5638,"_28619":5700,"_28621":7129,"_24010":12904,"_28626":5757,"_24265":5758,"_28629":5873,"_28631":9131,"_28633":6172,"_28635":3316,"_28637":3661,"_28639":5343,"_24004":6159,"_24232":2787,"_28