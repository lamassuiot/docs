905,"_33494":102908,"_33496":102911,"_33498":102914,"_33500":102917,"_33502":102920,"_33504":102923,"_33506":102926,"_33508":102929,"_33510":102932,"_33512":102935,"_33514":102939,"_33516":102942,"_33518":102945,"_33520":102949,"_33522":102952,"_33524":102956,"_33526":102959,"_33528":102962,"_33530":102965,"_33532":102968,"_33534":102971,"_33536":102974,"_33538":102977,"_33540":102980,"_33542":102983,"_33544":102986,"_33546":102989,"_33548":102991,"_33550":102994,"_33552":102997,"_33554":103000,"_33556":103003,"_33558":103006,"_33560":103009,"_33562":103012,"_33564":103015,"_33566":103018,"_33568":103021,"_33570":103026,"_33572":103029,"_33574":103033,"_33576":103037,"_33578":103041,"_33580":103044,"_33582":103047,"_33584":103049,"_33586":103051,"_33588":103053,"_33590":103055,"_33592":103058,"_33594":103061,"_33596":103064,"_33598":103067,"_33600":103070,"_33602":103072,"_33604":103075,"_33606":103077,"_33608":103080,"_33610":103083,"_33612":103086,"_33614":103088,"_33616":103091,"_33618":103094,"_33620":103097,"_33622":103100,"_33624":103103,"_33626":103106,"_33628":103109,"_33630":103112,"_33632":103115,"_33634":103118,"_33636":103121,"_33638":103124},{"_2861":57776,"_25124":57776,"_5":12314,"_2388":95852,"_25460":95853,"_17549":95856,"_23791":57776},"Despliega desde AWS Marketplace",[40822,95854,95855],"Despliegue","Otros modelos",[],{"_2861":57777,"_25124":57776,"_17549":95858,"_5":17444,"_23791":57776,"_2388":95859},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2861":57778,"_25124":57776,"_5":25457,"_17549":95861,"_23791":95862,"_2388":95863},[],"/docs/pr-preview/pr-37/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2861":57779,"_25124":57776,"_5":25457,"_17549":95865,"_23791":95866,"_2388":95867},[],"/docs/pr-preview/pr-37/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2861":57780,"_25124":57776,"_5":25457,"_17549":95869,"_23791":95870,"_2388":95871},[],"/docs/pr-preview/pr-37/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2861":57781,"_25124":57776,"_5":25457,"_17549":95873,"_23791":95874,"_2388":95875},[],"/docs/pr-preview/pr-37/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2861":57782,"_25124":57776,"_5":25457,"_17549":95877,"_23791":95878,"_2388":95879},[],"/docs/pr-preview/pr-37/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2861":57783,"_25124":57776,"_5":25457,"_17549":95881,"_23791":95882,"_2388":95883},[],"/docs/pr-preview/pr-37/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2861":57784,"_25124":57776,"_5":25457,"_17549":95885,"_23791":95886,"_2388":95887},[],"/docs/pr-preview/pr-37/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2861":57785,"_25124":57776,"_17549":95889,"_5":17444,"_23791":57776,"_2388":95890},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2861":57786,"_25124":57776,"_17549":95892,"_5":17444,"_23791":95862,"_2388":95893},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2861":57787,"_25124":57776,"_17549":95895,"_5":17444,"_23791":95862,"_2388":95896},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2861":57788,"_25124":57776,"_17549":95898,"_5":17444,"_23791":95862,"_2388":95899},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2861":57789,"_25124":57776,"_17549":95901,"_5":17444,"_23791":95866,"_2388":95902},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2861":57790,"_25124":57776,"_17549":95904,"_5":17444,"_23791":95866,"_2388":95905},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2861":57791,"_25124":57776,"_17549":95907,"_5":17444,"_23791":95866,"_2388":95908},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2861":57792,"_25124":57776,"_17549":95910,"_5":17444,"_23791":95870,"_2388":95911},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2861":57793,"_25124":57776,"_17549":95913,"_5":17444,"_23791":95874,"_2388":95914},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2861":57794,"_25124":57776,"_17549":95916,"_5":17444,"_23791":95878,"_2388":95917},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2861":57795,"_25124":57776,"_17549":95919,"_5":17444,"_23791":95882,"_2388":95920},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2861":57796,"_25124":57776,"_17549":95922,"_5":17444,"_23791":95886,"_2388":95923},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2861":57797,"_25124":57797,"_5":12314,"_2388":95925,"_25460":95926,"_17549":95927,"_23791":57797},"Despliega Lamassu",[40822,95854],[],{"_2861":57798,"_25124":57797,"_17549":95929,"_5":17444,"_23791":57797,"_2388":95930},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2861":57799,"_25124":57797,"_5":25457,"_17549":95932,"_23791":95933,"_2388":95934},[],"/docs/pr-preview/pr-37/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2861":57800,"_25124":57797,"_5":25457,"_17549":95936,"_23791":95937,"_2388":95938},[],"/docs/pr-preview/pr-37/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2861":57801,"_25124":57797,"_5":25457,"_17549":95940,"_23791":95941,"_2388":95942},[],"/docs/pr-preview/pr-37/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2861":57802,"_25124":57797,"_17549":95944,"_5":17444,"_23791":57797,"_2388":95945},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2861":57803,"_25124":57797,"_17549":95947,"_5":17444,"_23791":95933,"_2388":95948},[],"Modelo",{"_2861":57804,"_25124":57797,"_17549":95950,"_5":17444,"_23791":95933,"_2388":95951},[],"Recomendado para",{"_2861":57805,"_25124":57797,"_17549":95953,"_5":17444,"_23791":95933,"_2388":95954},[],"Quién opera la infraestructura",{"_2861":57806,"_25124":57797,"_17549":95956,"_5":17444,"_23791":95933,"_2388":95957},[],"Punto de partida",{"_2861":57807,"_25124":57797,"_17549":95959,"_5":17444,"_23791":95933,"_2388":40929},[],{"_2861":57808,"_25124":57797,"_17549":95961,"_5":17444,"_23791":95933,"_2388":95962},[],"Producción, entornos regulados y despliegues personalizados",{"_2861":57809,"_25124":57797,"_17549":95964,"_5":17444,"_23791":95933,"_2388":95965},[],"Tu equipo",{"_2861":57810,"_25124":57797,"_17549":95967,"_5":17444,"_23791":95933,"_2388":95968},[],"Helm o Fastlane",{"_2861":57811,"_25124":57797,"_17549":95970,"_5":17444,"_23791":95933,"_2388":40941},[],{"_2861":57812,"_25124":57797,"_17549":95972,"_5":17444,"_23791":95933,"_2388":95973},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2861":57813,"_25124":57797,"_17549":95975,"_5":17444,"_23791":95933,"_2388":95965},[],{"_2861":57814,"_25124":57797,"_17549":95977,"_5":17444,"_23791":95933,"_2388":95978},[],"Imagen preconfigurada en EC2",{"_2861":57815,"_25124":57797,"_17549":95980,"_5":17444,"_23791":95933,"_2388":40952},[],{"_2861":57816,"_25124":57797,"_17549":95982,"_5":17444,"_23791":95933,"_2388":95983},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2861":57817,"_25124":57797,"_17549":95985,"_5":17444,"_23791":95933,"_2388":40958},[],{"_2861":57818,"_25124":57797,"_17549":95987,"_5":17444,"_23791":95933,"_2388":95988},[],"Suscripción gestionada",{"_2861":57819,"_25124":57797,"_17549":95990,"_5":17444,"_23791":95933,"_2388":95991},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2861":57820,"_25124":57797,"_17549":95993,"_5":17444,"_23791":95933,"_2388":95994},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2861":57821,"_25124":57797,"_17549":95996,"_5":17444,"_23791":95933,"_2388":95997},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2861":57822,"_25124":57797,"_17549":95999,"_5":17444,"_23791":95937,"_2388":96000},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2861":57823,"_25124":57797,"_17549":96002,"_5":17444,"_23791":95941,"_2388":96003},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2861":57824,"_25124":57824,"_5":12314,"_2388":96005,"_25460":96006,"_17549":96007,"_23791":57824},"Utiliza Lamassu como SaaS",[40822,95854,95855],[],{"_2861":57825,"_25124":57824,"_17549":96009,"_5":17444,"_23791":57824,"_2388":96010},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2861":57826,"_25124":57824,"_5":25457,"_17549":96012,"_23791":96013,"_2388":96014},[],"/docs/pr-preview/pr-37/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2861":57827,"_25124":57824,"_5":25457,"_17549":96016,"_23791":96017,"_2388":96018},[],"/docs/pr-preview/pr-37/es/deployment/saas#planes","Planes",{"_2861":57828,"_25124":57824,"_5":25457,"_17549":96020,"_23791":96021,"_2388":96022},[],"/docs/pr-preview/pr-37/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2861":57829,"_25124":57824,"_17549":96024,"_5":17444,"_23791":57824,"_2388":96025},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2861":57830,"_25124":57824,"_17549":96027,"_5":17444,"_23791":96013,"_2388":96028},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2861":57831,"_25124":57824,"_17549":96030,"_5":17444,"_23791":96013,"_2388":96031},[],"Copias de seguridad automáticas.",{"_2861":57832,"_25124":57824,"_17549":96033,"_5":17444,"_23791":96013,"_2388":96034},[],"Actualizaciones de versión.",{"_2861":57833,"_25124":57824,"_17549":96036,"_5":17444,"_23791":96013,"_2388":96037},[],"Soporte técnico y SLA según el plan contratado.",{"_2861":57834,"_25124":57824,"_17549":96039,"_5":17444,"_23791":96017,"_2388":41013},[],{"_2861":57835,"_25124":57824,"_17549":96041,"_5":17444,"_23791":96017,"_2388":96042},[],"Dispositivos",{"_2861":57836,"_25124":57824,"_17549":96044,"_5":17444,"_23791":96017,"_2388":96045},[],"Soporte",{"_2861":57837,"_25124":57824,"_17549":96047,"_5":17444,"_23791":96017,"_2388":41022},[],{"_2861":57838,"_25124":57824,"_17549":96049,"_5":17444,"_23791":96017,"_2388":41025},[],{"_2861":57839,"_25124":57824,"_17549":96051,"_5":17444,"_23791":96017,"_2388":96052},[],"Hasta 1.000",{"_2861":57840,"_25124":57824,"_17549":96054,"_5":17444,"_23791":96017,"_2388":41031},[],{"_2861":57841,"_25124":57824,"_17549":96056,"_5":17444,"_23791":96017,"_2388":96057},[],"99,5 %",{"_2861":57842,"_25124":57824,"_17549":96059,"_5":17444,"_23791":96017,"_2388":41037},[],{"_2861":57843,"_25124":57824,"_17549":96061,"_5":17444,"_23791":96017,"_2388":96062},[],"Hasta 10.000",{"_2861":57844,"_25124":57824,"_17549":96064,"_5":17444,"_23791":96017,"_2388":96065},[],"Email y chat",{"_2861":57845,"_25124":57824,"_17549":96067,"_5":17444,"_23791":96017,"_2388":96068},[],"99,9 %",{"_2861":57846,"_25124":57824,"_17549":96070,"_5":17444,"_23791":96017,"_2388":41049},[],{"_2861":57847,"_25124":57824,"_17549":96072,"_5":17444,"_23791":96017,"_2388":96073},[],"Ilimitados",{"_2861":57848,"_25124":57824,"_17549":96075,"_5":17444,"_23791":96017,"_2388":96076},[],"Dedicado",{"_2861":57849,"_25124":57824,"_17549":96078,"_5":17444,"_23791":96017,"_2388":96079},[],"99,99 %",{"_2861":57850,"_25124":57824,"_17549":96081,"_5":17444,"_23791":96021,"_2388":96082},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2861":57851,"_25124":57824,"_17549":96084,"_5":17444,"_23791":96021,"_2388":96085},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2861":57852,"_25124":57852,"_5":12314,"_2388":41066,"_25460":96087,"_17549":96089,"_23791":57852},[40822,95854,96088],"Kubernetes autogestionado",[],{"_2861":57853,"_25124":57852,"_17549":96091,"_5":17444,"_23791":57852,"_2388":96092},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2861":57854,"_25124":57852,"_5":25457,"_17549":96094,"_23791":96095,"_2388":96096},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2861":57855,"_25124":57852,"_5":25457,"_17549":96098,"_23791":96099,"_2388":96100},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2861":57856,"_25124":57852,"_5":25457,"_17549":96102,"_23791":96103,"_2388":96104},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2861":57857,"_25124":57852,"_5":25457,"_17549":96106,"_23791":96107,"_2388":96108},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2861":57858,"_25124":57852,"_5":25457,"_17549":96110,"_23791":96111,"_2388":96112},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2861":57859,"_25124":57852,"_5":25457,"_17549":96114,"_23791":96115,"_2388":96116},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2861":57860,"_25124":57852,"_5":25457,"_17549":96118,"_23791":96119,"_2388":96120},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2861":57861,"_25124":57852,"_5":25457,"_17549":96122,"_23791":96123,"_2388":96124},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2861":57862,"_25124":57852,"_5":25457,"_17549":96126,"_23791":96127,"_2388":96128},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2861":57863,"_25124":57852,"_5":25457,"_17549":96130,"_23791":96131,"_2388":96132},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2861":57864,"_25124":57852,"_17549":96134,"_5":17444,"_23791":96095,"_2388":96135},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2861":57865,"_25124":57852,"_17549":96137,"_5":17444,"_23791":96095,"_2388":96138},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2861":57866,"_25124":57852,"_17549":96140,"_5":17444,"_23791":96099,"_2388":96141},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2861":57867,"_25124":57852,"_17549":96143,"_5":17444,"_23791":96099,"_2388":96144},[],"Fastlane instala o configura",{"_2861":57868,"_25124":57852,"_17549":96146,"_5":17444,"_23791":96099,"_2388":96147},[],"Tú sigues proporcionando",{"_2861":57869,"_25124":57852,"_17549":96149,"_5":17444,"_23791":96099,"_2388":96150},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2861":57870,"_25124":57852,"_17549":96152,"_5":17444,"_23791":96099,"_2388":96153},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2861":57871,"_25124":57852,"_17549":96155,"_5":17444,"_23791":96099,"_2388":96156},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2861":57872,"_25124":57852,"_17549":96158,"_5":17444,"_23791":96099,"_2388":96159},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2861":57873,"_25124":57852,"_17549":96161,"_5":17444,"_23791":96099,"_2388":96162},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2861":57874,"_25124":57852,"_17549":96164,"_5":17444,"_23791":96099,"_2388":96165},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2861":57875,"_25124":57852,"_17549":96167,"_5":17444,"_23791":96099,"_2388":96168},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2861":57876,"_25124":57852,"_17549":96170,"_5":17444,"_23791":96099,"_2388":96171},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2861":57877,"_25124":57852,"_17549":96173,"_5":17444,"_23791":96099,"_2388":96174},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2861":57878,"_25124":57852,"_17549":96176,"_5":17444,"_23791":96103,"_2388":96177},[],"Necesitas:",{"_2861":57879,"_25124":57852,"_17549":96179,"_5":17444,"_23791":96103,"_2388":96180},[],"un clúster Kubernetes existente",{"_2861":57880,"_25124":57852,"_17549":96182,"_5":17444,"_23791":96103,"_2388":96183},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2861":57881,"_25124":57852,"_17549":96185,"_5":17444,"_23791":96103,"_2388":41164},[],{"_2861":57882,"_25124":57852,"_17549":96187,"_5":17444,"_23791":96103,"_2388":19854},[],{"_2861":57883,"_25124":57852,"_17549":96189,"_5":17444,"_23791":96103,"_2388":96190},[],"`jq` solo si usas `--sample-data`",{"_2861":57884,"_25124":57852,"_17549":96192,"_5":17444,"_23791":96103,"_2388":96193},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2861":57885,"_25124":57852,"_17549":96195,"_5":17444,"_23791":96103,"_2388":96196},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2861":57886,"_25124":57852,"_17549":96198,"_5":17444,"_23791":96103,"_2388":96199},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2861":57887,"_25124":57852,"_17549":96201,"_5":17444,"_23791":96107,"_2388":96202},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2861":57888,"_25124":57852,"_17549":96204,"_5":17444,"_23791":96107,"_2388":96205},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2861":57889,"_25124":57852,"_17549":96207,"_5":17444,"_23791":96111,"_2388":96208},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2861":57890,"_25124":57852,"_17549":96210,"_5":17444,"_23791":96111,"_2388":96211},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2861":57891,"_25124":57852,"_17549":96213,"_5":17444,"_23791":96111,"_2388":96214},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2861":57892,"_25124":57852,"_17549":96216,"_5":17444,"_23791":96111,"_2388":96217},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2861":57893,"_25124":57852,"_17549":96219,"_5":17444,"_23791":96115,"_2388":96220},[],"Opción",{"_2861":57894,"_25124":57852,"_17549":96222,"_5":17444,"_23791":96115,"_2388":96223},[],"Valor predeterminado",{"_2861":57895,"_25124":57852,"_17549":96225,"_5":17444,"_23791":96115,"_2388":96226},[],"Propósito",{"_2861":57896,"_25124":57852,"_17549":96228,"_5":17444,"_23791":96115,"_2388":41208},[],{"_2861":57897,"_25124":57852,"_17549":96230,"_5":17444,"_23791":96115,"_2388":41211},[],{"_2861":57898,"_25124":57852,"_17549":96232,"_5":17444,"_23791":96115,"_2388":96233},[],"Muestra la ayuda",{"_2861":57899,"_25124":57852,"_17549":96235,"_5":17444,"_23791":96115,"_2388":41217},[],{"_2861":57900,"_25124":57852,"_17549":96237,"_5":17444,"_23791":96115,"_2388":96238},[],"contexto actual",{"_2861":57901,"_25124":57852,"_17549":96240,"_5":17444,"_23791":96115,"_2388":96241},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2861":57902,"_25124":57852,"_17549":96243,"_5":17444,"_23791":96115,"_2388":41226},[],{"_2861":57903,"_25124":57852,"_17549":96245,"_5":17444,"_23791":96115,"_2388":5355},[],{"_2861":57904,"_25124":57852,"_17549":96247,"_5":17444,"_23791":96115,"_2388":96248},[],"Omite prompts y genera credenciales para las dependencias",{"_2861":57905,"_25124":57852,"_17549":96250,"_5":17444,"_23791":96115,"_2388":41234},[],{"_2861":57906,"_25124":57852,"_17549":96252,"_5":17444,"_23791":96115,"_2388":41237},[],{"_2861":57907,"_25124":57852,"_17549":96254,"_5":17444,"_23791":96115,"_2388":96255},[],"Namespace de la instalación",{"_2861":57908,"_25124":57852,"_17549":96257,"_5":17444,"_23791":96115,"_2388":41243},[],{"_2861":57909,"_25124":57852,"_17549":96259,"_5":17444,"_23791":96115,"_2388":41246},[],{"_2861":57910,"_25124":57852,"_17549":96261,"_5":17444,"_23791":96115,"_2388":96262},[],"Dominio usado por la UI, OIDC y el certificado",{"_2861":57911,"_25124":57852,"_17549":96264,"_5":17444,"_23791":96115,"_2388":41252},[],{"_2861":57912,"_25124":57852,"_17549":96266,"_5":17444,"_23791":96115,"_2388":12540},[],{"_2861":57913,"_25124":57852,"_17549":96268,"_5":17444,"_23791":96115,"_2388":96269},[],"Versión del chart de Lamassu",{"_2861":57914,"_25124":57852,"_17549":96271,"_5":17444,"_23791":96115,"_2388":41260},[],{"_2861":57915,"_25124":57852,"_17549":96273,"_5":17444,"_23791":96115,"_2388":41263},[],{"_2861":57916,"_25124":57852,"_17549":96275,"_5":17444,"_23791":96115,"_2388":96276},[],"Puerto del listener HTTPS",{"_2861":57917,"_25124":57852,"_17549":96278,"_5":17444,"_23791":96115,"_2388":41269},[],{"_2861":57918,"_25124":57852,"_17549":96280,"_5":17444,"_23791":96115,"_2388":41272},[],{"_2861":57919,"_25124":57852,"_17549":96282,"_5":17444,"_23791":96115,"_2388":96283},[],"Puerto del listener HTTP",{"_2861":57920,"_25124":57852,"_17549":96285,"_5":17444,"_23791":96115,"_2388":41278},[],{"_2861":57921,"_25124":57852,"_17549":96287,"_5":17444,"_23791":96115,"_2388":41211},[],{"_2861":57922,"_25124":57852,"_17549":96289,"_5":17444,"_23791":96115,"_2388":96290},[],"Certificado PEM para TLS downstream",{"_2861":57923,"_25124":57852,"_17549":96292,"_5":17444,"_23791":96115,"_2388":41286},[],{"_2861":57924,"_25124":57852,"_17549":96294,"_5":17444,"_23791":96115,"_2388":41211},[],{"_2861":57925,"_25124":57852,"_17549":96296,"_5":17444,"_23791":96115,"_2388":96297},[],"Clave privada PEM para TLS downstream",{"_2861":57926,"_25124":57852,"_17549":96299,"_5":17444,"_23791":96115,"_2388":41294},[],{"_2861":57927,"_25124":57852,"_17549":96301,"_5":17444,"_23791":96115,"_2388":96302},[],"chart del repositorio",{"_2861":57928,"_25124":57852,"_17549":96304,"_5":17444,"_23791":96115,"_2388":96305},[],"Usa un chart local de Lamassu sin empaquetar",{"_2861":57929,"_25124":57852,"_17549":96307,"_5":17444,"_23791":96115,"_2388":41303},[],{"_2861":57930,"_25124":57852,"_17549":96309,"_5":17444,"_23791":96115,"_2388":96310},[],"detección automática",{"_2861":57931,"_25124":57852,"_17549":96312,"_5":17444,"_23791":96115,"_2388":96313},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2861":57932,"_25124":57852,"_17549":96315,"_5":17444,"_23791":96115,"_2388":41311},[],{"_2861":57933,"_25124":57852,"_17549":96317,"_5":17444,"_23791":96115,"_2388":5355},[],{"_2861":57934,"_25124":57852,"_17549":96319,"_5":17444,"_23791":96115,"_2388":96320},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2861":57935,"_25124":57852,"_17549":96322,"_5":17444,"_23791":96115,"_2388":41319},[],{"_2861":57936,"_25124":57852,"_17549":96324,"_5":17444,"_23791":96115,"_2388":5355},[],{"_2861":57937,"_25124":57852,"_17549":96326,"_5":17444,"_23791":96115,"_2388":96327},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2861":57938,"_25124":57852,"_17549":96329,"_5":17444,"_23791":96115,"_2388":41327},[],{"_2861":57939,"_25124":57852,"_17549":96331,"_5":17444,"_23791":96115,"_2388":5355},[],{"_2861":57940,"_25124":57852,"_17549":96333,"_5":17444,"_23791":96115,"_2388":96334},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2861":57941,"_25124":57852,"_17549":96336,"_5":17444,"_23791":96115,"_2388":41335},[],{"_2861":57942,"_25124":57852,"_17549":96338,"_5":17444,"_23791":96115,"_2388":41338},[],{"_2861":57943,"_25124":57852,"_17549":96340,"_5":17444,"_23791":96115,"_2388":96341},[],"Usa otro chart local de SoftHSM",{"_2861":57944,"_25124":57852,"_17549":96343,"_5":17444,"_23791":96115,"_2388":96344},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2861":57945,"_25124":57852,"_17549":96346,"_5":17444,"_23791":96119,"_2388":41347},[],{"_2861":57946,"_25124":57852,"_17549":96348,"_5":17444,"_23791":96119,"_2388":96349},[],"valida las herramientas locales y el clúster seleccionado",{"_2861":57947,"_25124":57852,"_17549":96351,"_5":17444,"_23791":96119,"_2388":96352},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2861":57948,"_25124":57852,"_17549":96354,"_5":17444,"_23791":96119,"_2388":96355},[],"crea el namespace",{"_2861":57949,"_25124":57852,"_17549":96357,"_5":17444,"_23791":96119,"_2388":96358},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2861":57950,"_25124":57852,"_17549":96360,"_5":17444,"_23791":96119,"_2388":96361},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2861":57951,"_25124":57852,"_17549":96363,"_5":17444,"_23791":96119,"_2388":96364},[],"instala RabbitMQ",{"_2861":57952,"_25124":57852,"_17549":96366,"_5":17444,"_23791":96119,"_2388":96367},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2861":57953,"_25124":57852,"_17549":96369,"_5":17444,"_23791":96119,"_2388":96370},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2861":57954,"_25124":57852,"_17549":96372,"_5":17444,"_23791":96119,"_2388":96373},[],"carga datos de ejemplo opcionalmente",{"_2861":57955,"_25124":57852,"_17549":96375,"_5":17444,"_23791":96119,"_2388":96376},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2861":57956,"_25124":57852,"_17549":96378,"_5":17444,"_23791":96123,"_2388":96379},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2861":57957,"_25124":57852,"_17549":96381,"_5":17444,"_23791":96123,"_2388":96382},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2861":57958,"_25124":57852,"_17549":96384,"_5":17444,"_23791":96127,"_2388":96385},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2861":57959,"_25124":57852,"_17549":96387,"_5":17444,"_23791":96127,"_2388":96388},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2861":57960,"_25124":57852,"_17549":96390,"_5":17444,"_23791":96127,"_2388":96391},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2861":57961,"_25124":57852,"_17549":96393,"_5":17444,"_23791":96131,"_2388":96394},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2861":57962,"_25124":57962,"_5":12314,"_2388":96396,"_25460":96397,"_17549":96398,"_23791":57962},"Instala con Helm",[40822,95854,96088],[],{"_2861":57963,"_25124":57962,"_17549":96400,"_5":17444,"_23791":57962,"_2388":96401},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2861":57964,"_25124":57962,"_5":25457,"_17549":96403,"_23791":96404,"_2388":96405},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2861":57965,"_25124":57962,"_5":25457,"_17549":96407,"_23791":96408,"_2388":96104},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2861":57966,"_25124":57962,"_5":25457,"_17549":96410,"_23791":96411,"_2388":96412},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2861":57967,"_25124":57962,"_5":25457,"_17549":96414,"_23791":96415,"_2388":96416},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2861":57968,"_25124":57962,"_5":25457,"_17549":96418,"_23791":96419,"_2388":96420},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2861":57969,"_25124":57962,"_5":25457,"_17549":96422,"_23791":96423,"_2388":96424},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2861":57970,"_25124":57962,"_5":25457,"_17549":96426,"_23791":96427,"_2388":96428},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2861":57971,"_25124":57962,"_5":25457,"_17549":96430,"_23791":96431,"_2388":96432},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2861":57972,"_25124":57962,"_5":25457,"_17549":96434,"_23791":96435,"_2388":96436},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2861":57973,"_25124":57962,"_17549":96438,"_5":17444,"_23791":96404,"_2388":96439},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2861":57974,"_25124":57962,"_17549":96441,"_5":17444,"_23791":96408,"_2388":96442},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2861":57975,"_25124":57962,"_17549":96444,"_5":17444,"_23791":96408,"_2388":96445},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2861":57976,"_25124":57962,"_17549":96447,"_5":17444,"_23791":96408,"_2388":96448},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2861":57977,"_25124":57962,"_17549":96450,"_5":17444,"_23791":96408,"_2388":96451},[],"un broker RabbitMQ accesible y sus credenciales",{"_2861":57978,"_25124":57962,"_17549":96453,"_5":17444,"_23791":96408,"_2388":96454},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2861":57979,"_25124":57962,"_17549":96456,"_5":17444,"_23791":96408,"_2388":96457},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2861":57980,"_25124":57962,"_17549":96459,"_5":17444,"_23791":96408,"_2388":96460},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2861":57981,"_25124":57962,"_17549":96462,"_5":17444,"_23791":96408,"_2388":96463},[],"una StorageClass y un diseño de tráfico externo",{"_2861":57982,"_25124":57962,"_17549":96465,"_5":17444,"_23791":96408,"_2388":96466},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2861":57983,"_25124":57962,"_17549":96468,"_5":17444,"_23791":96408,"_2388":96469},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2861":57984,"_25124":57962,"_17549":96471,"_5":17444,"_23791":96408,"_2388":96472},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2861":57985,"_25124":57962,"_17549":96474,"_5":17444,"_23791":96411,"_2388":96475},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2861":57986,"_25124":57962,"_17549":96477,"_5":17444,"_23791":96411,"_2388":96478},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2861":57987,"_25124":57962,"_17549":96480,"_5":17444,"_23791":96411,"_2388":96481},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2861":57988,"_25124":57962,"_17549":96483,"_5":17444,"_23791":96415,"_2388":96484},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2861":57989,"_25124":57962,"_17549":96486,"_5":17444,"_23791":96415,"_2388":96487},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2861":57990,"_25124":57962,"_17549":96489,"_5":17444,"_23791":96415,"_2388":96490},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2861":57991,"_25124":57962,"_17549":96492,"_5":17444,"_23791":96419,"_2388":96493},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2861":57992,"_25124":57962,"_17549":96495,"_5":17444,"_23791":96423,"_2388":96496},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2861":57993,"_25124":57962,"_17549":96498,"_5":17444,"_23791":96423,"_2388":96499},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2861":57994,"_25124":57962,"_17549":96501,"_5":17444,"_23791":96423,"_2388":96502},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2861":57995,"_25124":57962,"_17549":96504,"_5":17444,"_23791":96423,"_2388":96505},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2861":57996,"_25124":57962,"_17549":96507,"_5":17444,"_23791":96427,"_2388":96508},[],"Para instalar un checkout local:",{"_2861":57997,"_25124":57962,"_17549":96510,"_5":17444,"_23791":96431,"_2388":96511},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2861":57998,"_25124":57962,"_17549":96513,"_5":17444,"_23791":96431,"_2388":96514},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2861":57999,"_25124":57962,"_17549":96516,"_5":17444,"_23791":96435,"_2388":96517},[],"Antes de pasar a producción, revisa:",{"_2861":58000,"_25124":57962,"_17549":96519,"_5":17444,"_23791":96435,"_2388":96520},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2861":58001,"_25124":57962,"_17549":96522,"_5":17444,"_23791":96435,"_2388":96523},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2861":58002,"_25124":57962,"_17549":96525,"_5":17444,"_23791":96435,"_2388":96526},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2861":58003,"_25124":57962,"_17549":96528,"_5":17444,"_23791":96435,"_2388":96529},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2861":58004,"_25124":57962,"_17549":96531,"_5":17444,"_23791":96435,"_2388":96532},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2861":58005,"_25124":57962,"_17549":96534,"_5":17444,"_23791":96435,"_2388":96535},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2861":58006,"_25124":57962,"_17549":96537,"_5":17444,"_23791":96435,"_2388":96538},[],"SMTP, observabilidad y entrega de alertas",{"_2861":58007,"_25124":57962,"_17549":96540,"_5":17444,"_23791":96435,"_2388":96541},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2861":58008,"_25124":57962,"_17549":96543,"_5":17444,"_23791":96435,"_2388":96544},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2861":58009,"_25124":58009,"_5":12314,"_2388":96546,"_25460":96547,"_17549":96548,"_23791":58009},"Expón el Gateway",[40822,95854,96088],[],{"_2861":58010,"_25124":58009,"_17549":96550,"_5":17444,"_23791":58009,"_2388":96551},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2861":58011,"_25124":58009,"_5":25457,"_17549":96553,"_23791":96554,"_2388":96555},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2861":58012,"_25124":58009,"_5":25457,"_17549":96557,"_23791":96558,"_2388":96559},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2861":58013,"_25124":58009,"_5":25457,"_17549":96561,"_23791":96562,"_2388":96563},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2861":58014,"_25124":58009,"_5":25457,"_17549":96565,"_23791":96566,"_2388":41568},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#k3s",{"_2861":58015,"_25124":58009,"_5":25457,"_17549":96568,"_23791":96569,"_2388":96570},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2861":58016,"_25124":58009,"_5":25457,"_17549":96572,"_23791":96573,"_2388":96574},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2861":58017,"_25124":58009,"_5":25457,"_17549":96576,"_23791":96577,"_2388":96578},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2861":58018,"_25124":58009,"_5":25457,"_17549":96580,"_23791":96581,"_2388":96582},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2861":58019,"_25124":58009,"_5":25457,"_17549":96584,"_23791":96585,"_2388":96586},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2861":58020,"_25124":58009,"_17549":96588,"_5":17444,"_23791":96554,"_2388":96589},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2861":58021,"_25124":58009,"_17549":96591,"_5":17444,"_23791":96554,"_2388":96592},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2861":58022,"_25124":58009,"_17549":96594,"_5":17444,"_23791":96558,"_2388":96595},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2861":58023,"_25124":58009,"_17549":96597,"_5":17444,"_23791":96558,"_2388":96598},[],"Defínelo únicamente cuando:",{"_2861":58024,"_25124":58009,"_17549":96600,"_5":17444,"_23791":96558,"_2388":96601},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2861":58025,"_25124":58009,"_17549":96603,"_5":17444,"_23791":96558,"_2388":96604},[],"esa dirección está asignada a este Gateway",{"_2861":58026,"_25124":58009,"_17549":96606,"_5":17444,"_23791":96558,"_2388":96607},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2861":58027,"_25124":58009,"_17549":96609,"_5":17444,"_23791":96558,"_2388":96610},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2861":58028,"_25124":58009,"_17549":96612,"_5":17444,"_23791":96558,"_2388":96613},[],"No confundas estos valores:",{"_2861":58029,"_25124":58009,"_17549":96615,"_5":17444,"_23791":96558,"_2388":96616},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2861":58030,"_25124":58009,"_17549":96618,"_5":17444,"_23791":96558,"_2388":96619},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2861":58031,"_25124":58009,"_17549":96621,"_5":17444,"_23791":96558,"_2388":96622},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2861":58032,"_25124":58009,"_17549":96624,"_5":17444,"_23791":96562,"_2388":96625},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2861":58033,"_25124":58009,"_17549":96627,"_5":17444,"_23791":96562,"_2388":96628},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2861":58034,"_25124":58009,"_17549":96630,"_5":17444,"_23791":96566,"_2388":96631},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2861":58035,"_25124":58009,"_17549":96633,"_5":17444,"_23791":96566,"_2388":96634},[],"Para el diseño recomendado:",{"_2861":58036,"_25124":58009,"_17549":96636,"_5":17444,"_23791":96566,"_2388":96637},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2861":58037,"_25124":58009,"_17549":96639,"_5":17444,"_23791":96566,"_2388":96640},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2861":58038,"_25124":58009,"_17549":96642,"_5":17444,"_23791":96566,"_2388":96643},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2861":58039,"_25124":58009,"_17549":96645,"_5":17444,"_23791":96566,"_2388":96646},[],"Apunta DNS a la dirección accesible de la VM.",{"_2861":58040,"_25124":58009,"_17549":96648,"_5":17444,"_23791":96566,"_2388":96649},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2861":58041,"_25124":58009,"_17549":96651,"_5":17444,"_23791":96569,"_2388":96652},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2861":58042,"_25124":58009,"_17549":96654,"_5":17444,"_23791":96573,"_2388":96655},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2861":58043,"_25124":58009,"_17549":96657,"_5":17444,"_23791":96573,"_2388":96658},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2861":58044,"_25124":58009,"_17549":96660,"_5":17444,"_23791":96577,"_2388":96661},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2861":58045,"_25124":58009,"_17549":96663,"_5":17444,"_23791":96577,"_2388":96664},[],"Requisito",{"_2861":58046,"_25124":58009,"_17549":96666,"_5":17444,"_23791":96577,"_2388":96667},[],"Diseño recomendado",{"_2861":58047,"_25124":58009,"_17549":96669,"_5":17444,"_23791":96577,"_2388":96670},[],"Consecuencia",{"_2861":58048,"_25124":58009,"_17549":96672,"_5":17444,"_23791":96577,"_2388":96673},[],"Varias URL o servicios de Lamassu",{"_2861":58049,"_25124":58009,"_17549":96675,"_5":17444,"_23791":96577,"_2388":96676},[],"Un Gateway con varias rutas",{"_2861":58050,"_25124":58009,"_17549":96678,"_5":17444,"_23791":96577,"_2388":96679},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2861":58051,"_25124":58009,"_17549":96681,"_5":17444,"_23791":96577,"_2388":96682},[],"Gateways independientes e IP externas distintas",{"_2861":58052,"_25124":58009,"_17549":96684,"_5":17444,"_23791":96577,"_2388":96685},[],"Una VIP por Gateway",{"_2861":58053,"_25124":58009,"_17549":96687,"_5":17444,"_23791":96577,"_2388":96688},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2861":58054,"_25124":58009,"_17549":96690,"_5":17444,"_23791":96577,"_2388":96691},[],"Gateways independientes, un nodo y una IP",{"_2861":58055,"_25124":58009,"_17549":96693,"_5":17444,"_23791":96577,"_2388":96694},[],"Puertos externos diferentes",{"_2861":58056,"_25124":58009,"_17549":96696,"_5":17444,"_23791":96577,"_2388":96697},[],"Los clientes deben indicar puertos no estándar",{"_2861":58057,"_25124":58009,"_17549":96699,"_5":17444,"_23791":96577,"_2388":96700},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2861":58058,"_25124":58009,"_17549":96702,"_5":17444,"_23791":96577,"_2388":96703},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2861":58059,"_25124":58009,"_17549":96705,"_5":17444,"_23791":96577,"_2388":96706},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2861":58060,"_25124":58009,"_17549":96708,"_5":17444,"_23791":96577,"_2388":96709},[],"Recursos Gateway separados pero proxy compartido",{"_2861":58061,"_25124":58009,"_17549":96711,"_5":17444,"_23791":96577,"_2388":96712},[],"Modo merged Gateway de Envoy",{"_2861":58062,"_25124":58009,"_17549":96714,"_5":17444,"_23791":96577,"_2388":96715},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2861":58063,"_25124":58009,"_17549":96717,"_5":17444,"_23791":96577,"_2388":96718},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2861":58064,"_25124":58009,"_17549":96720,"_5":17444,"_23791":96577,"_2388":96721},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2861":58065,"_25124":58009,"_17549":96723,"_5":17444,"_23791":96577,"_2388":96724},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2861":58066,"_25124":58009,"_17549":96726,"_5":17444,"_23791":96577,"_2388":96727},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2861":58067,"_25124":58009,"_17549":96729,"_5":17444,"_23791":96581,"_2388":96730},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2861":58068,"_25124":58009,"_17549":96732,"_5":17444,"_23791":96581,"_2388":96733},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2861":58069,"_25124":58009,"_17549":96735,"_5":17444,"_23791":96581,"_2388":96736},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2861":58070,"_25124":58009,"_17549":96738,"_5":17444,"_23791":96581,"_2388":96739},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2861":58071,"_25124":58009,"_17549":96741,"_5":17444,"_23791":96581,"_2388":96742},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2861":58072,"_25124":58009,"_17549":96744,"_5":17444,"_23791":96585,"_2388":96745},[],"Comprueba, en orden:",{"_2861":58073,"_25124":58009,"_17549":96747,"_5":17444,"_23791":96585,"_2388":96748},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2861":58074,"_25124":58009,"_17549":96750,"_5":17444,"_23791":96585,"_2388":96751},[],"Su estado contiene la dirección esperada.",{"_2861":58075,"_25124":58009,"_17549":96753,"_5":17444,"_23791":96585,"_2388":96754},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2861":58076,"_25124":58009,"_17549":96756,"_5":17444,"_23791":96585,"_2388":96757},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2861":58077,"_25124":58009,"_17549":96759,"_5":17444,"_23791":96585,"_2388":96760},[],"DNS resuelve al endpoint accesible externamente.",{"_2861":58078,"_25124":58009,"_17549":96762,"_5":17444,"_23791":96585,"_2388":96763},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2861":58079,"_25124":58009,"_17549":96765,"_5":17444,"_23791":96585,"_2388":96766},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2861":58080,"_25124":58080,"_5":12314,"_2388":40929,"_25460":96768,"_17549":96769,"_23791":58080},[40822,95854,96088],[],{"_2861":58081,"_25124":58080,"_17549":96771,"_5":17444,"_23791":58080,"_2388":96772},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2861":58082,"_25124":58080,"_5":25457,"_17549":96774,"_23791":96775,"_2388":96776},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2861":58083,"_25124":58080,"_5":25457,"_17549":96778,"_23791":96779,"_2388":96780},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2861":58084,"_25124":58080,"_5":25457,"_17549":96782,"_23791":96783,"_2388":96784},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2861":58085,"_25124":58080,"_5":25457,"_17549":96786,"_23791":96787,"_2388":96788},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2861":58086,"_25124":58080,"_5":25457,"_17549":96790,"_23791":96791,"_2388":96792},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2861":58087,"_25124":58080,"_5":25457,"_17549":96794,"_23791":96795,"_2388":96796},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2861":58088,"_25124":58080,"_17549":96798,"_5":17444,"_23791":96775,"_2388":96799},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2861":58089,"_25124":58080,"_17549":96801,"_5":17444,"_23791":96779,"_2388":96802},[],"Flujo",{"_2861":58090,"_25124":58080,"_17549":96804,"_5":17444,"_23791":96779,"_2388":96805},[],"Úsalo para",{"_2861":58091,"_25124":58080,"_17549":96807,"_5":17444,"_23791":96779,"_2388":96808},[],"Qué instala",{"_2861":58092,"_25124":58080,"_17549":96810,"_5":17444,"_23791":96779,"_2388":41813},[],{"_2861":58093,"_25124":58080,"_17549":96812,"_5":17444,"_23791":96779,"_2388":96813},[],"Producción y entornos controlados",{"_2861":58094,"_25124":58080,"_17549":96815,"_5":17444,"_23791":96779,"_2388":96816},[],"Servicios de Lamassu y recursos de Gateway API",{"_2861":58095,"_25124":58080,"_17549":96818,"_5":17444,"_23791":96779,"_2388":41066},[],{"_2861":58096,"_25124":58080,"_17549":96820,"_5":17444,"_23791":96779,"_2388":96821},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2861":58097,"_25124":58080,"_17549":96823,"_5":17444,"_23791":96779,"_2388":96824},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2861":58098,"_25124":58080,"_17549":96826,"_5":17444,"_23791":96783,"_2388":96827},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2861":58099,"_25124":58080,"_17549":96829,"_5":17444,"_23791":96783,"_2388":96830},[],"Área",{"_2861":58100,"_25124":58080,"_17549":96832,"_5":17444,"_23791":96783,"_2388":96833},[],"El chart de Lamassu proporciona",{"_2861":58101,"_25124":58080,"_17549":96835,"_5":17444,"_23791":96783,"_2388":96836},[],"Tú proporcionas",{"_2861":58102,"_25124":58080,"_17549":96838,"_5":17444,"_23791":96783,"_2388":96839},[],"Aplicaciones Lamassu",{"_2861":58103,"_25124":58080,"_17549":96841,"_5":17444,"_23791":96783,"_2388":96842},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2861":58104,"_25124":58080,"_17549":96844,"_5":17444,"_23791":96783,"_2388":96845},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2861":58105,"_25124":58080,"_17549":96847,"_5":17444,"_23791":96783,"_2388":96848},[],"Datos PostgreSQL",{"_2861":58106,"_25124":58080,"_17549":96850,"_5":17444,"_23791":96783,"_2388":96851},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2861":58107,"_25124":58080,"_17549":96853,"_5":17444,"_23791":96783,"_2388":96854},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2861":58108,"_25124":58080,"_17549":96856,"_5":17444,"_23791":96783,"_2388":96857},[],"Mensajería",{"_2861":58109,"_25124":58080,"_17549":96859,"_5":17444,"_23791":96783,"_2388":96860},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2861":58110,"_25124":58080,"_17549":96862,"_5":17444,"_23791":96783,"_2388":96863},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2861":58111,"_25124":58080,"_17549":96865,"_5":17444,"_23791":96783,"_2388":96866},[],"Identidad",{"_2861":58112,"_25124":58080,"_17549":96868,"_5":17444,"_23791":96783,"_2388":96869},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2861":58113,"_25124":58080,"_17549":96871,"_5":17444,"_23791":96783,"_2388":96872},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2861":58114,"_25124":58080,"_17549":96874,"_5":17444,"_23791":96783,"_2388":96875},[],"Enrutamiento externo",{"_2861":58115,"_25124":58080,"_17549":96877,"_5":17444,"_23791":96783,"_2388":96878},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2861":58116,"_25124":58080,"_17549":96880,"_5":17444,"_23791":96783,"_2388":96881},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2861":58117,"_25124":58080,"_17549":96883,"_5":17444,"_23791":96783,"_2388":41887},[],{"_2861":58118,"_25124":58080,"_17549":96885,"_5":17444,"_23791":96783,"_2388":96886},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2861":58119,"_25124":58080,"_17549":96888,"_5":17444,"_23791":96783,"_2388":96889},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2861":58120,"_25124":58080,"_17549":96891,"_5":17444,"_23791":96783,"_2388":96892},[],"Datos persistentes de la aplicación",{"_2861":58121,"_25124":58080,"_17549":96894,"_5":17444,"_23791":96783,"_2388":96895},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2861":58122,"_25124":58080,"_17549":96897,"_5":17444,"_23791":96783,"_2388":96898},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2861":58123,"_25124":58080,"_17549":96900,"_5":17444,"_23791":96783,"_2388":96901},[],"Integraciones opcionales",{"_2861":58124,"_25124":58080,"_17549":96903,"_5":17444,"_23791":96783,"_2388":96904},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2861":58125,"_25124":58080,"_17549":96906,"_5":17444,"_23791":96783,"_2388":96907},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2861":58126,"_25124":58080,"_17549":96909,"_5":17444,"_23791":96783,"_2388":96910},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2861":58127,"_25124":58080,"_17549":96912,"_5":17444,"_23791":96783,"_2388":96913},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2861":58128,"_25124":58080,"_17549":96915,"_5":17444,"_23791":96787,"_2388":96916},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2861":58129,"_25124":58080,"_17549":96918,"_5":17444,"_23791":96787,"_2388":96919},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2861":58130,"_25124":58080,"_17549":96921,"_5":17444,"_23791":96791,"_2388":96922},[],"Kubernetes 1.24 o posterior",{"_2861":58131,"_25124":58080,"_17549":96924,"_5":17444,"_23791":96791,"_2388":96925},[],"Helm 3.2 o posterior",{"_2861":58132,"_25124":58080,"_17549":96927,"_5":17444,"_23791":96791,"_2388":96928},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2861":58133,"_25124":58080,"_17549":96930,"_5":17444,"_23791":96791,"_2388":96931},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2861":58134,"_25124":58080,"_17549":96933,"_5":17444,"_23791":96791,"_2388":96934},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2861":58135,"_25124":58080,"_17549":96936,"_5":17444,"_23791":96791,"_2388":96937},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2861":58136,"_25124":58080,"_17549":96939,"_5":17444,"_23791":96791,"_2388":96940},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2861":58137,"_25124":58080,"_17549":96942,"_5":17444,"_23791":96795,"_2388":96943},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2861":58138,"_25124":58080,"_17549":96945,"_5":17444,"_23791":96795,"_2388":96946},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2861":58139,"_25124":58080,"_17549":96948,"_5":17444,"_23791":96795,"_2388":96949},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2861":58140,"_25124":58140,"_5":12314,"_2388":96951,"_25460":96952,"_17549":96954,"_23791":58140},"Resolución de problemas de despliegue",[40822,95854,96953],"Operación",[],{"_2861":58141,"_25124":58140,"_17549":96956,"_5":17444,"_23791":58140,"_2388":96957},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2861":58142,"_25124":58140,"_5":25457,"_17549":96959,"_23791":96960,"_2388":96961},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2861":58143,"_25124":58140,"_5":25457,"_17549":96963,"_23791":96964,"_2388":96965},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2861":58144,"_25124":58140,"_5":25457,"_17549":96967,"_23791":96968,"_2388":96969},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2861":58145,"_25124":58140,"_5":25457,"_17549":96971,"_23791":96972,"_2388":96973},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2861":58146,"_25124":58140,"_5":25457,"_17549":96975,"_23791":96976,"_2388":96977},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2861":58147,"_25124":58140,"_5":25457,"_17549":96979,"_23791":96980,"_2388":96981},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2861":58148,"_25124":58140,"_5":25457,"_17549":96983,"_23791":96984,"_2388":96985},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2861":58149,"_25124":58140,"_5":25457,"_17549":96987,"_23791":96988,"_2388":96989},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2861":58150,"_25124":58140,"_5":25457,"_17549":96991,"_23791":96992,"_2388":96993},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2861":58151,"_25124":58140,"_5":25457,"_17549":96995,"_23791":96996,"_2388":96997},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2861":58152,"_25124":58140,"_5":25457,"_17549":96999,"_23791":97000,"_2388":97001},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2861":58153,"_25124":58140,"_5":25457,"_17549":97003,"_23791":97004,"_2388":97005},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2861":58154,"_25124":58140,"_17549":97007,"_5":17444,"_23791":58140,"_2388":97008},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2861":58155,"_25124":58140,"_17549":97010,"_5":17444,"_23791":96964,"_2388":97011},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2861":58156,"_25124":58140,"_17549":97013,"_5":17444,"_23791":96968,"_2388":97014},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2861":58157,"_25124":58140,"_17549":97016,"_5":17444,"_23791":96972,"_2388":97017},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2861":58158,"_25124":58140,"_17549":97019,"_5":17444,"_23791":96976,"_2388":97020},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2861":58159,"_25124":58140,"_17549":97022,"_5":17444,"_23791":96980,"_2388":97023},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2861":58160,"_25124":58140,"_17549":97025,"_5":17444,"_23791":96984,"_2388":97026},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2861":58161,"_25124":58140,"_17549":97028,"_5":17444,"_23791":96984,"_2388":97029},[],"Ejecuta también la prueba de conectividad del chart:",{"_2861":58162,"_25124":58140,"_17549":97031,"_5":17444,"_23791":96984,"_2388":97032},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2861":58163,"_25124":58140,"_17549":97034,"_5":17444,"_23791":96984,"_2388":97035},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2861":58164,"_25124":58140,"_17549":97037,"_5":17444,"_23791":96988,"_2388":97038},[],"Si recibes un 401:",{"_2861":58165,"_25124":58140,"_17549":97040,"_5":17444,"_23791":96988,"_2388":97041},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2861":58166,"_25124":58140,"_17549":97043,"_5":17444,"_23791":96988,"_2388":97044},[],"verifica emisor, audiencia y expiración del token;",{"_2861":58167,"_25124":58140,"_17549":97046,"_5":17444,"_23791":96988,"_2388":97047},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2861":58168,"_25124":58140,"_17549":97049,"_5":17444,"_23791":96988,"_2388":97050},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2861":58169,"_25124":58140,"_17549":97052,"_5":17444,"_23791":96988,"_2388":97053},[],"Si el login termina pero las APIs devuelven 403:",{"_2861":58170,"_25124":58140,"_17549":97055,"_5":17444,"_23791":96988,"_2388":97056},[],"inspecciona los claims reales del token;",{"_2861":58171,"_25124":58140,"_17549":97058,"_5":17444,"_23791":96988,"_2388":97059},[],"confirma que coinciden con un principal activo;",{"_2861":58172,"_25124":58140,"_17549":97061,"_5":17444,"_23791":96988,"_2388":97062},[],"revisa las políticas concedidas al principal;",{"_2861":58173,"_25124":58140,"_17549":97064,"_5":17444,"_23791":96988,"_2388":97065},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2861":58174,"_25124":58140,"_17549":97067,"_5":17444,"_23791":96988,"_2388":97068},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2861":58175,"_25124":58140,"_17549":97070,"_5":17444,"_23791":96992,"_2388":97071},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2861":58176,"_25124":58140,"_17549":97073,"_5":17444,"_23791":96992,"_2388":97074},[],"Localiza el pod y Service de authz.",{"_2861":58177,"_25124":58140,"_17549":97076,"_5":17444,"_23791":96992,"_2388":97077},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2861":58178,"_25124":58140,"_17549":97079,"_5":17444,"_23791":96992,"_2388":97080},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2861":58179,"_25124":58140,"_17549":97082,"_5":17444,"_23791":96992,"_2388":97083},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2861":58180,"_25124":58140,"_17549":97085,"_5":17444,"_23791":96992,"_2388":97086},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2861":58181,"_25124":58140,"_17549":97088,"_5":17444,"_23791":96996,"_2388":97089},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2861":58182,"_25124":58140,"_17549":97091,"_5":17444,"_23791":96996,"_2388":97092},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2861":58183,"_25124":58140,"_17549":97094,"_5":17444,"_23791":96996,"_2388":97095},[],"volumen persistente sin enlazar;",{"_2861":58184,"_25124":58140,"_17549":97097,"_5":17444,"_23791":96996,"_2388":97098},[],"imagen inaccesible o política de pull incorrecta;",{"_2861":58185,"_25124":58140,"_17549":97100,"_5":17444,"_23791":96996,"_2388":97101},[],"configuración inválida del motor criptográfico;",{"_2861":58186,"_25124":58140,"_17549":97103,"_5":17444,"_23791":96996,"_2388":97104},[],"límites de CPU o memoria demasiado bajos;",{"_2861":58187,"_25124":58140,"_17549":97106,"_5":17444,"_23791":96996,"_2388":97107},[],"migración previa incompleta.",{"_2861":58188,"_25124":58140,"_17549":97109,"_5":17444,"_23791":96996,"_2388":97110},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2861":58189,"_25124":58140,"_17549":97112,"_5":17444,"_23791":96996,"_2388":97113},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2861":58190,"_25124":58140,"_17549":97115,"_5":17444,"_23791":97000,"_2388":97116},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2861":58191,"_25124":58140,"_17549":97118,"_5":17444,"_23791":97000,"_2388":97119},[],"verifica que esté habilitado en el servicio emisor;",{"_2861":58192,"_25124":58140,"_17549":97121,"_5":17444,"_23791":97000,"_2388":97122},[],"comprueba conectividad y credenciales AMQP;",{"_2861":58193,"_25124":58140,"_17549":97124,"_5":17444,"_23791":97000,"_2388":97125},[],"revisa exchange, routing key, colas y consumidores;",{"_2861":58194,"_25124":58140,"_17549":97127,"_5":17444,"_23791":97000,"_2388":97128},[],"inspecciona dead-letter queues;",{"_2861":58195,"_25124":58140,"_17549":97130,"_5":17444,"_23791":97000,"_2388":97131},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2861":58196,"_25124":58140,"_17549":97133,"_5":17444,"_23791":97000,"_2388":97134},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2861":58197,"_25124":58140,"_17549":97136,"_5":17444,"_23791":97004,"_2388":97137},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2861":58198,"_25124":58140,"_17549":97139,"_5":17444,"_23791":97004,"_2388":97140},[],"Antes de cerrar una incidencia, guarda:",{"_2861":58199,"_25124":58140,"_17549":97142,"_5":17444,"_23791":97004,"_2388":97143},[],"causa confirmada;",{"_2861":58200,"_25124":58140,"_17549":97145,"_5":17444,"_23791":97004,"_2388":97146},[],"alcance temporal y recursos afectados;",{"_2861":58201,"_25124":58140,"_17549":97148,"_5":17444,"_23791":97004,"_2388":97149},[],"comandos o consultas utilizados;",{"_2861":58202,"_25124":58140,"_17549":97151,"_5":17444,"_23791":97004,"_2388":97152},[],"cambio aplicado y forma de revertirlo;",{"_2861":58203,"_25124":58140,"_17549":97154,"_5":17444,"_23791":97004,"_2388":97155},[],"validación desde un consumidor;",{"_2861":58204,"_25124":58140,"_17549":97157,"_5":17444,"_23791":97004,"_2388":97158},[],"acción preventiva y propietario.",{"_2861":58205,"_25124":58205,"_5":12314,"_2388":97160,"_25460":97161,"_17549":97164,"_23791":58205},"Control de acceso",[40822,97162,97163],"Plataforma","Administración",[],{"_2861":58206,"_25124":58205,"_17549":97166,"_5":17444,"_23791":58205,"_2388":97167},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2861":58207,"_25124":58205,"_5":25457,"_17549":97169,"_23791":97170,"_2388":97171},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2861":58208,"_25124":58205,"_5":25457,"_17549":97173,"_23791":97174,"_2388":97175},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2861":58209,"_25124":58205,"_5":25457,"_17549":97177,"_23791":97178,"_2388":97179},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2861":58210,"_25124":58205,"_5":25457,"_17549":97181,"_23791":97182,"_2388":97183},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2861":58211,"_25124":58205,"_5":25457,"_17549":97185,"_23791":97186,"_2388":97187},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2861":58212,"_25124":58205,"_5":25457,"_17549":97189,"_23791":97190,"_2388":97191},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2861":58213,"_25124":58205,"_5":25457,"_17549":97193,"_23791":97194,"_2388":97195},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2861":58214,"_25124":58205,"_5":25457,"_17549":97197,"_23791":97198,"_2388":97199},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2861":58215,"_25124":58205,"_5":25457,"_17549":97201,"_23791":97202,"_2388":97203},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2861":58216,"_25124":58205,"_5":25457,"_17549":97205,"_23791":97206,"_2388":97207},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2861":58217,"_25124":58205,"_5":25457,"_17549":97209,"_23791":97210,"_2388":97211},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2861":58218,"_25124":58205,"_5":25457,"_17549":97213,"_23791":97214,"_2388":97215},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2861":58219,"_25124":58205,"_5":25457,"_17549":97217,"_23791":97218,"_2388":97219},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2861":58220,"_25124":58205,"_5":25457,"_17549":97221,"_23791":97222,"_2388":97223},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2861":58221,"_25124":58205,"_5":25457,"_17549":97225,"_23791":97226,"_2388":97227},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2861":58222,"_25124":58205,"_5":25457,"_17549":97229,"_23791":97230,"_2388":96424},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2861":58223,"_25124":58205,"_5":25457,"_17549":97232,"_23791":97233,"_2388":97234},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2861":58224,"_25124":58205,"_5":25457,"_17549":97236,"_23791":97237,"_2388":97238},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2861":58225,"_25124":58205,"_5":25457,"_17549":97240,"_23791":97241,"_2388":97242},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2861":58226,"_25124":58205,"_5":25457,"_17549":97244,"_23791":97245,"_2388":97246},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2861":58227,"_25124":58205,"_5":25457,"_17549":97248,"_23791":97249,"_2388":97250},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2861":58228,"_25124":58205,"_5":25457,"_17549":97252,"_23791":97253,"_2388":97254},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2861":58229,"_25124":58205,"_5":25457,"_17549":97256,"_23791":97257,"_2388":97258},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2861":58230,"_25124":58205,"_5":25457,"_17549":97260,"_23791":97261,"_2388":97262},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2861":58231,"_25124":58205,"_5":25457,"_17549":97264,"_23791":97265,"_2388":97266},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2861":58232,"_25124":58205,"_5":25457,"_17549":97268,"_23791":97269,"_2388":97270},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2861":58233,"_25124":58205,"_5":25457,"_17549":97272,"_23791":97273,"_2388":97274},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2861":58234,"_25124":58205,"_5":25457,"_17549":97276,"_23791":97277,"_2388":97278},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2861":58235,"_25124":58205,"_5":25457,"_17549":97280,"_23791":97281,"_2388":97282},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2861":58236,"_25124":58205,"_5":25457,"_17549":97284,"_23791":97285,"_2388":97286},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2861":58237,"_25124":58205,"_5":25457,"_17549":97288,"_23791":97289,"_2388":97290},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2861":58238,"_25124":58205,"_17549":97292,"_5":17444,"_23791":58205,"_2388":97293},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2861":58239,"_25124":58205,"_17549":97295,"_5":17444,"_23791":58205,"_2388":97296},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2861":58240,"_25124":58205,"_17549":97298,"_5":17444,"_23791":58205,"_2388":97299},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2861":58241,"_25124":58205,"_17549":97301,"_5":17444,"_23791":97170,"_2388":97302},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2861":58242,"_25124":58205,"_17549":97304,"_5":17444,"_23791":97170,"_2388":97305},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2861":58243,"_25124":58205,"_17549":97307,"_5":17444,"_23791":97170,"_2388":97308},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2861":58244,"_25124":58205,"_17549":97310,"_5":17444,"_23791":97170,"_2388":97311},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2861":58245,"_25124":58205,"_17549":97313,"_5":17444,"_23791":97170,"_2388":97314},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2861":58246,"_25124":58205,"_17549":97316,"_5":17444,"_23791":97170,"_2388":97317},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2861":58247,"_25124":58205,"_17549":97319,"_5":17444,"_23791":97174,"_2388":97320},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2861":58248,"_25124":58205,"_17549":97322,"_5":17444,"_23791":97174,"_2388":97323},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2861":58249,"_25124":58205,"_17549":97325,"_5":17444,"_23791":97178,"_2388":97326},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2861":58250,"_25124":58205,"_17549":97328,"_5":17444,"_23791":97178,"_2388":97329},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2861":58251,"_25124":58205,"_17549":97331,"_5":17444,"_23791":97178,"_2388":97332},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2861":58252,"_25124":58205,"_17549":97334,"_5":17444,"_23791":97178,"_2388":97335},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2861":58253,"_25124":58205,"_17549":97337,"_5":17444,"_23791":97178,"_2388":97338},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2861":58254,"_25124":58205,"_17549":97340,"_5":17444,"_23791":97178,"_2388":97341},[],"Carga por separado las políticas concedidas a cada principal.",{"_2861":58255,"_25124":58205,"_17549":97343,"_5":17444,"_23791":97178,"_2388":97344},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2861":58256,"_25124":58205,"_17549":97346,"_5":17444,"_23791":97178,"_2388":97347},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2861":58257,"_25124":58205,"_17549":97349,"_5":17444,"_23791":97178,"_2388":97350},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2861":58258,"_25124":58205,"_17549":97352,"_5":17444,"_23791":97178,"_2388":97353},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2861":58259,"_25124":58205,"_17549":97355,"_5":17444,"_23791":97178,"_2388":97356},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2861":58260,"_25124":58205,"_17549":97358,"_5":17444,"_23791":97178,"_2388":97359},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2861":58261,"_25124":58205,"_17549":97361,"_5":17444,"_23791":97182,"_2388":97362},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2861":58262,"_25124":58205,"_17549":97364,"_5":17444,"_23791":97182,"_2388":97365},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2861":58263,"_25124":58205,"_17549":97367,"_5":17444,"_23791":97182,"_2388":97368},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2861":58264,"_25124":58205,"_17549":97370,"_5":17444,"_23791":97182,"_2388":97371},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2861":58265,"_25124":58205,"_17549":97373,"_5":17444,"_23791":97182,"_2388":97374},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2861":58266,"_25124":58205,"_17549":97376,"_5":17444,"_23791":97182,"_2388":97377},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2861":58267,"_25124":58205,"_17549":97379,"_5":17444,"_23791":97182,"_2388":97380},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2861":58268,"_25124":58205,"_17549":97382,"_5":17444,"_23791":97182,"_2388":97383},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2861":58269,"_25124":58205,"_17549":97385,"_5":17444,"_23791":97186,"_2388":97386},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2861":58270,"_25124":58205,"_17549":97388,"_5":17444,"_23791":97186,"_2388":97389},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2861":58271,"_25124":58205,"_17549":97391,"_5":17444,"_23791":97186,"_2388":97392},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2861":58272,"_25124":58205,"_17549":97394,"_5":17444,"_23791":97186,"_2388":97395},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2861":58273,"_25124":58205,"_17549":97397,"_5":17444,"_23791":97186,"_2388":97398},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2861":58274,"_25124":58205,"_17549":97400,"_5":17444,"_23791":97186,"_2388":97401},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2861":58275,"_25124":58205,"_17549":97403,"_5":17444,"_23791":97186,"_2388":97404},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2861":58276,"_25124":58205,"_17549":97406,"_5":17444,"_23791":97186,"_2388":97407},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2861":58277,"_25124":58205,"_17549":97409,"_5":17444,"_23791":97186,"_2388":97410},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2861":58278,"_25124":58205,"_17549":97412,"_5":17444,"_23791":97186,"_2388":97413},[],"Las acciones se dividen en dos grupos:",{"_2861":58279,"_25124":58205,"_17549":97415,"_5":17444,"_23791":97186,"_2388":97416},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2861":58280,"_25124":58205,"_17549":97418,"_5":17444,"_23791":97186,"_2388":97419},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2861":58281,"_25124":58205,"_17549":97421,"_5":17444,"_23791":97186,"_2388":97422},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2861":58282,"_25124":58205,"_17549":97424,"_5":17444,"_23791":97190,"_2388":97425},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2861":58283,"_25124":58205,"_17549":97427,"_5":17444,"_23791":97190,"_2388":97428},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2861":58284,"_25124":58205,"_17549":97430,"_5":17444,"_23791":97190,"_2388":97431},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2861":58285,"_25124":58205,"_17549":97433,"_5":17444,"_23791":97194,"_2388":97434},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2861":58286,"_25124":58205,"_17549":97436,"_5":17444,"_23791":97194,"_2388":97437},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2861":58287,"_25124":58205,"_17549":97439,"_5":17444,"_23791":97194,"_2388":97440},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2861":58288,"_25124":58205,"_17549":97442,"_5":17444,"_23791":97194,"_2388":97443},[],"Los operadores implementados son:",{"_2861":58289,"_25124":58205,"_17549":97445,"_5":17444,"_23791":97194,"_2388":97446},[],"`equals`, para igualdad exacta;",{"_2861":58290,"_25124":58205,"_17549":97448,"_5":17444,"_23791":97194,"_2388":97449},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2861":58291,"_25124":58205,"_17549":97451,"_5":17444,"_23791":97194,"_2388":97452},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2861":58292,"_25124":58205,"_17549":97454,"_5":17444,"_23791":97194,"_2388":97455},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2861":58293,"_25124":58205,"_17549":97457,"_5":17444,"_23791":97198,"_2388":97458},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2861":58294,"_25124":58205,"_17549":97460,"_5":17444,"_23791":97198,"_2388":97461},[],"Los modos disponibles son:",{"_2861":58295,"_25124":58205,"_17549":97463,"_5":17444,"_23791":97198,"_2388":97464},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2861":58296,"_25124":58205,"_17549":97466,"_5":17444,"_23791":97198,"_2388":97467},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2861":58297,"_25124":58205,"_17549":97469,"_5":17444,"_23791":97198,"_2388":97470},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2861":58298,"_25124":58205,"_17549":97472,"_5":17444,"_23791":97198,"_2388":97473},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2861":58299,"_25124":58205,"_17549":97475,"_5":17444,"_23791":97198,"_2388":97476},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2861":58300,"_25124":58205,"_17549":97478,"_5":17444,"_23791":97198,"_2388":97479},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2861":58301,"_25124":58205,"_17549":97481,"_5":17444,"_23791":97202,"_2388":97482},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2861":58302,"_25124":58205,"_17549":97484,"_5":17444,"_23791":97202,"_2388":97485},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2861":58303,"_25124":58205,"_17549":97487,"_5":17444,"_23791":97202,"_2388":97488},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2861":58304,"_25124":58205,"_17549":97490,"_5":17444,"_23791":97202,"_2388":97491},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2861":58305,"_25124":58205,"_17549":97493,"_5":17444,"_23791":97210,"_2388":97494},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2861":58306,"_25124":58205,"_17549":97496,"_5":17444,"_23791":97210,"_2388":97497},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2861":58307,"_25124":58205,"_17549":97499,"_5":17444,"_23791":97214,"_2388":97500},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2861":58308,"_25124":58205,"_17549":97502,"_5":17444,"_23791":97214,"_2388":97503},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2861":58309,"_25124":58205,"_17549":97505,"_5":17444,"_23791":97218,"_2388":97506},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2861":58310,"_25124":58205,"_17549":97508,"_5":17444,"_23791":97218,"_2388":97509},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2861":58311,"_25124":58205,"_17549":97511,"_5":17444,"_23791":97218,"_2388":97512},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2861":58312,"_25124":58205,"_17549":97514,"_5":17444,"_23791":97222,"_2388":97515},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2861":58313,"_25124":58205,"_17549":97517,"_5":17444,"_23791":97222,"_2388":97518},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2861":58314,"_25124":58205,"_17549":97520,"_5":17444,"_23791":97222,"_2388":97521},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2861":58315,"_25124":58205,"_17549":97523,"_5":17444,"_23791":97222,"_2388":97524},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2861":58316,"_25124":58205,"_17549":97526,"_5":17444,"_23791":97222,"_2388":97527},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2861":58317,"_25124":58205,"_17549":97529,"_5":17444,"_23791":97222,"_2388":97530},[],"Ten en cuenta que:",{"_2861":58318,"_25124":58205,"_17549":97532,"_5":17444,"_23791":97222,"_2388":97533},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2861":58319,"_25124":58205,"_17549":97535,"_5":17444,"_23791":97222,"_2388":97536},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2861":58320,"_25124":58205,"_17549":97538,"_5":17444,"_23791":97222,"_2388":97539},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2861":58321,"_25124":58205,"_17549":97541,"_5":17444,"_23791":97226,"_2388":97542},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2861":58322,"_25124":58205,"_17549":97544,"_5":17444,"_23791":97226,"_2388":97545},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2861":58323,"_25124":58205,"_17549":97547,"_5":17444,"_23791":97226,"_2388":97548},[],"acceso completo y de solo lectura a KMS;",{"_2861":58324,"_25124":58205,"_17549":97550,"_5":17444,"_23791":97226,"_2388":97551},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2861":58325,"_25124":58205,"_17549":97553,"_5":17444,"_23791":97226,"_2388":97554},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2861":58326,"_25124":58205,"_17549":97556,"_5":17444,"_23791":97226,"_2388":97557},[],"acceso a la interfaz;",{"_2861":58327,"_25124":58205,"_17549":97559,"_5":17444,"_23791":97226,"_2388":97560},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2861":58328,"_25124":58205,"_17549":97562,"_5":17444,"_23791":97226,"_2388":97563},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2861":58329,"_25124":58205,"_17549":97565,"_5":17444,"_23791":97226,"_2388":97566},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2861":58330,"_25124":58205,"_17549":97568,"_5":17444,"_23791":97230,"_2388":97569},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2861":58331,"_25124":58205,"_17549":97571,"_5":17444,"_23791":97230,"_2388":97572},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2861":58332,"_25124":58205,"_17549":97574,"_5":17444,"_23791":97230,"_2388":97575},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2861":58333,"_25124":58205,"_17549":97577,"_5":17444,"_23791":97233,"_2388":97578},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2861":58334,"_25124":58205,"_17549":97580,"_5":17444,"_23791":97237,"_2388":97581},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2861":58335,"_25124":58205,"_17549":97583,"_5":17444,"_23791":97241,"_2388":97584},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2861":58336,"_25124":58205,"_17549":97586,"_5":17444,"_23791":97245,"_2388":97587},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2861":58337,"_25124":58205,"_17549":97589,"_5":17444,"_23791":97249,"_2388":97590},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2861":58338,"_25124":58205,"_17549":97592,"_5":17444,"_23791":97253,"_2388":97593},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2861":58339,"_25124":58205,"_17549":97595,"_5":17444,"_23791":97253,"_2388":97596},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2861":58340,"_25124":58205,"_17549":97598,"_5":17444,"_23791":97257,"_2388":97599},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2861":58341,"_25124":58205,"_17549":97601,"_5":17444,"_23791":97257,"_2388":97602},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2861":58342,"_25124":58205,"_17549":97604,"_5":17444,"_23791":97257,"_2388":97605},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2861":58343,"_25124":58205,"_17549":97607,"_5":17444,"_23791":97257,"_2388":97608},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2861":58344,"_25124":58205,"_17549":97610,"_5":17444,"_23791":97257,"_2388":97611},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2861":58345,"_25124":58205,"_17549":97613,"_5":17444,"_23791":97257,"_2388":97614},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2861":58346,"_25124":58205,"_17549":97616,"_5":17444,"_23791":97257,"_2388":97617},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2861":58347,"_25124":58205,"_17549":97619,"_5":17444,"_23791":97257,"_2388":97620},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2861":58348,"_25124":58205,"_17549":97622,"_5":17444,"_23791":97261,"_2388":97623},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2861":58349,"_25124":58205,"_17549":97625,"_5":17444,"_23791":97261,"_2388":97626},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2861":58350,"_25124":58205,"_17549":97628,"_5":17444,"_23791":97261,"_2388":97629},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2861":58351,"_25124":58205,"_17549":97631,"_5":17444,"_23791":97265,"_2388":97632},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2861":58352,"_25124":58205,"_17549":97634,"_5":17444,"_23791":97265,"_2388":97635},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2861":58353,"_25124":58205,"_17549":97637,"_5":17444,"_23791":97265,"_2388":97638},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2861":58354,"_25124":58205,"_17549":97640,"_5":17444,"_23791":97265,"_2388":97641},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2861":58355,"_25124":58205,"_17549":97643,"_5":17444,"_23791":97265,"_2388":97644},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2861":58356,"_25124":58205,"_17549":97646,"_5":17444,"_23791":97265,"_2388":97647},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2861":58357,"_25124":58205,"_17549":97649,"_5":17444,"_23791":97265,"_2388":97650},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2861":58358,"_25124":58205,"_17549":97652,"_5":17444,"_23791":97265,"_2388":97653},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2861":58359,"_25124":58205,"_17549":97655,"_5":17444,"_23791":97273,"_2388":97656},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2861":58360,"_25124":58205,"_17549":97658,"_5":17444,"_23791":97277,"_2388":97659},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2861":58361,"_25124":58205,"_17549":97661,"_5":17444,"_23791":97277,"_2388":97662},[],"que exista un principal activo del tipo correcto;",{"_2861":58362,"_25124":58205,"_17549":97664,"_5":17444,"_23791":97277,"_2388":97665},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2861":58363,"_25124":58205,"_17549":97667,"_5":17444,"_23791":97277,"_2388":97668},[],"que todas las condiciones del principal se cumplan;",{"_2861":58364,"_25124":58205,"_17549":97670,"_5":17444,"_23791":97277,"_2388":97671},[],"que el principal tenga concedida la política esperada;",{"_2861":58365,"_25124":58205,"_17549":97673,"_5":17444,"_23791":97277,"_2388":97674},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2861":58366,"_25124":58205,"_17549":97676,"_5":17444,"_23791":97277,"_2388":97677},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2861":58367,"_25124":58205,"_17549":97679,"_5":17444,"_23791":97277,"_2388":97680},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2861":58368,"_25124":58205,"_17549":97682,"_5":17444,"_23791":97281,"_2388":97683},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2861":58369,"_25124":58205,"_17549":97685,"_5":17444,"_23791":97285,"_2388":97686},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2861":58370,"_25124":58205,"_17549":97688,"_5":17444,"_23791":97289,"_2388":97689},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2861":58371,"_25124":58205,"_17549":97691,"_5":17444,"_23791":97289,"_2388":97692},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2861":58372,"_25124":58372,"_5":12314,"_2388":97694,"_25460":97695,"_17549":97696,"_23791":58372},"Alertas y suscripciones",[40822,97162,97163],[],{"_2861":58373,"_25124":58372,"_17549":97698,"_5":17444,"_23791":58372,"_2388":97699},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2861":58374,"_25124":58372,"_5":25457,"_17549":97701,"_23791":97702,"_2388":97703},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2861":58375,"_25124":58372,"_5":25457,"_17549":97705,"_23791":97706,"_2388":97707},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2861":58376,"_25124":58372,"_5":25457,"_17549":97709,"_23791":97710,"_2388":97711},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2861":58377,"_25124":58372,"_5":25457,"_17549":97713,"_23791":97714,"_2388":97715},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2861":58378,"_25124":58372,"_5":25457,"_17549":97717,"_23791":97718,"_2388":97719},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2861":58379,"_25124":58372,"_5":25457,"_17549":97721,"_23791":97722,"_2388":97723},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2861":58380,"_25124":58372,"_5":25457,"_17549":97725,"_23791":97726,"_2388":97727},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2861":58381,"_25124":58372,"_5":25457,"_17549":97729,"_23791":97730,"_2388":97731},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2861":58382,"_25124":58372,"_5":25457,"_17549":97733,"_23791":97734,"_2388":97735},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2861":58383,"_25124":58372,"_5":25457,"_17549":97737,"_23791":97738,"_2388":97739},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2861":58384,"_25124":58372,"_17549":97741,"_5":17444,"_23791":58372,"_2388":97742},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2861":58385,"_25124":58372,"_17549":97744,"_5":17444,"_23791":97702,"_2388":97745},[],"Un servicio publica un evento de dominio.",{"_2861":58386,"_25124":58372,"_17549":97747,"_5":17444,"_23791":97702,"_2388":97748},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2861":58387,"_25124":58372,"_17549":97750,"_5":17444,"_23791":97702,"_2388":97751},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2861":58388,"_25124":58372,"_17549":97753,"_5":17444,"_23791":97702,"_2388":97754},[],"Lamassu entrega el evento al canal configurado.",{"_2861":58389,"_25124":58372,"_17549":97756,"_5":17444,"_23791":97702,"_2388":97757},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2861":58390,"_25124":58372,"_17549":97759,"_5":17444,"_23791":97706,"_2388":97760},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2861":58391,"_25124":58372,"_17549":97762,"_5":17444,"_23791":97706,"_2388":97763},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2861":58392,"_25124":58372,"_17549":97765,"_5":17444,"_23791":97706,"_2388":97766},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2861":58393,"_25124":58372,"_17549":97768,"_5":17444,"_23791":97706,"_2388":97769},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2861":58394,"_25124":58372,"_17549":97771,"_5":17444,"_23791":97706,"_2388":97772},[],"`apikey_options` necesita `header` y `key`.",{"_2861":58395,"_25124":58372,"_17549":97774,"_5":17444,"_23791":97706,"_2388":97775},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2861":58396,"_25124":58372,"_17549":97777,"_5":17444,"_23791":97706,"_2388":97778},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan.",{"_2861":58397,"_25124":58372,"_17549":97780,"_5":17444,"_23791":97706,"_2388":97781},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2861":58398,"_25124":58372,"_17549":97783,"_5":17444,"_23791":97714,"_2388":97784},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2861":58399,"_25124":58372,"_17549":97786,"_5":17444,"_23791":97718,"_2388":97787},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2861":58400,"_25124":58372,"_17549":97789,"_5":17444,"_23791":97722,"_2388":97790},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2861":58401,"_25124":58372,"_17549":97792,"_5":17444,"_23791":97722,"_2388":97793},[],"**None** notifica todas las instancias del evento.",{"_2861":58402,"_25124":58372,"_17549":97795,"_5":17444,"_23791":97722,"_2388":97796},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2861":58403,"_25124":58372,"_17549":97798,"_5":17444,"_23791":97722,"_2388":97799},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2861":58404,"_25124":58372,"_17549":97801,"_5":17444,"_23791":97722,"_2388":97802},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2861":58405,"_25124":58372,"_17549":97804,"_5":17444,"_23791":97722,"_2388":97805},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2861":58406,"_25124":58372,"_17549":97807,"_5":17444,"_23791":97726,"_2388":97808},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2861":58407,"_25124":58372,"_17549":97810,"_5":17444,"_23791":97730,"_2388":97811},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2861":58408,"_25124":58372,"_17549":97813,"_5":17444,"_23791":97730,"_2388":97814},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2861":58409,"_25124":58372,"_17549":97816,"_5":17444,"_23791":97730,"_2388":97817},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2861":58410,"_25124":58372,"_17549":97819,"_5":17444,"_23791":97730,"_2388":97820},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2861":58411,"_25124":58372,"_17549":97822,"_5":17444,"_23791":97730,"_2388":97823},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2861":58412,"_25124":58372,"_17549":97825,"_5":17444,"_23791":97730,"_2388":97826},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2861":58413,"_25124":58372,"_17549":97828,"_5":17444,"_23791":97730,"_2388":97829},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2861":58414,"_25124":58372,"_17549":97831,"_5":17444,"_23791":97730,"_2388":97832},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2861":58415,"_25124":58372,"_17549":97834,"_5":17444,"_23791":97734,"_2388":97835},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2861":58416,"_25124":58372,"_17549":97837,"_5":17444,"_23791":97738,"_2388":97838},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2861":58417,"_25124":58372,"_17549":97840,"_5":17444,"_23791":97738,"_2388":97841},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2861":58418,"_25124":58372,"_17549":97843,"_5":17444,"_23791":97738,"_2388":97844},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2861":58419,"_25124":58372,"_17549":97846,"_5":17444,"_23791":97738,"_2388":97847},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2861":58420,"_25124":58372,"_17549":97849,"_5":17444,"_23791":97738,"_2388":97850},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2861":58421,"_25124":58372,"_17549":97852,"_5":17444,"_23791":97738,"_2388":97853},[],"**Validación:** `va.role.crl.create`.",{"_2861":58422,"_25124":58372,"_17549":97855,"_5":17444,"_23791":97738,"_2388":97856},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2861":58423,"_25124":58372,"_17549":97858,"_5":17444,"_23791":97738,"_2388":97859},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2861":58424,"_25124":58424,"_5":12314,"_2388":97861,"_25460":97862,"_17549":97863,"_23791":58424},"Registros de auditoría",[40822,97162,97163],[],{"_2861":58425,"_25124":58424,"_17549":97865,"_5":17444,"_23791":58424,"_2388":97866},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2861":58426,"_25124":58424,"_5":25457,"_17549":97868,"_23791":97869,"_2388":97870},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2861":58427,"_25124":58424,"_5":25457,"_17549":97872,"_23791":97873,"_2388":97874},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2861":58428,"_25124":58424,"_5":25457,"_17549":97876,"_23791":97877,"_2388":97878},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2861":58429,"_25124":58424,"_5":25457,"_17549":97880,"_23791":97881,"_2388":97882},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2861":58430,"_25124":58424,"_5":25457,"_17549":97884,"_23791":97885,"_2388":97886},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2861":58431,"_25124":58424,"_5":25457,"_17549":97888,"_23791":97889,"_2388":97890},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2861":58432,"_25124":58424,"_5":25457,"_17549":97892,"_23791":97893,"_2388":97894},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2861":58433,"_25124":58424,"_5":25457,"_17549":97896,"_23791":97897,"_2388":97898},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2861":58434,"_25124":58424,"_5":25457,"_17549":97900,"_23791":97901,"_2388":97902},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2861":58435,"_25124":58424,"_5":25457,"_17549":97904,"_23791":97905,"_2388":97906},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2861":58436,"_25124":58424,"_5":25457,"_17549":97908,"_23791":97909,"_2388":97910},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2861":58437,"_25124":58424,"_17549":97912,"_5":17444,"_23791":58424,"_2388":97913},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2861":58438,"_25124":58424,"_17549":97915,"_5":17444,"_23791":97869,"_2388":97916},[],"El cuerpo de auditoría incluye:",{"_2861":58439,"_25124":58424,"_17549":97918,"_5":17444,"_23791":97869,"_2388":97919},[],"input: datos recibidos por la operación;",{"_2861":58440,"_25124":58424,"_17549":97921,"_5":17444,"_23791":97869,"_2388":97922},[],"has\\_error: indica si el servicio devolvió un error;",{"_2861":58441,"_25124":58424,"_17549":97924,"_5":17444,"_23791":97869,"_2388":97925},[],"output: resultado producido o mensaje de error;",{"_2861":58442,"_25124":58424,"_17549":97927,"_5":17444,"_23791":97869,"_2388":97928},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2861":58443,"_25124":58424,"_17549":97930,"_5":17444,"_23791":97869,"_2388":97931},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2861":58444,"_25124":58424,"_17549":97933,"_5":17444,"_23791":97869,"_2388":97934},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2861":58445,"_25124":58424,"_17549":97936,"_5":17444,"_23791":97873,"_2388":97937},[],"El backend aplica auditoría a mutaciones de:",{"_2861":58446,"_25124":58424,"_17549":97939,"_5":17444,"_23791":97873,"_2388":97940},[],"autoridades, certificados y perfiles de emisión;",{"_2861":58447,"_25124":58424,"_17549":97942,"_5":17444,"_23791":97873,"_2388":97943},[],"claves y motores KMS;",{"_2861":58448,"_25124":58424,"_17549":97945,"_5":17444,"_23791":97873,"_2388":97946},[],"dispositivos e identidades;",{"_2861":58449,"_25124":58424,"_17549":97948,"_5":17444,"_23791":97873,"_2388":97949},[],"DMS y operaciones de enrolamiento;",{"_2861":58450,"_25124":58424,"_17549":97951,"_5":17444,"_23791":97873,"_2388":97952},[],"funciones de validación y CRL;",{"_2861":58451,"_25124":58424,"_17549":97954,"_5":17444,"_23791":97873,"_2388":97955},[],"principales, políticas y concesiones de autorización.",{"_2861":58452,"_25124":58424,"_17549":97957,"_5":17444,"_23791":97873,"_2388":97958},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2861":58453,"_25124":58424,"_17549":97960,"_5":17444,"_23791":97877,"_2388":97961},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2861":58454,"_25124":58424,"_17549":97963,"_5":17444,"_23791":97877,"_2388":97964},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2861":58455,"_25124":58424,"_17549":97966,"_5":17444,"_23791":97877,"_2388":97967},[],"Diseña el consumidor para:",{"_2861":58456,"_25124":58424,"_17549":97969,"_5":17444,"_23791":97877,"_2388":97970},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2861":58457,"_25124":58424,"_17549":97972,"_5":17444,"_23791":97877,"_2388":97973},[],"conservar el CloudEvent completo sin modificar;",{"_2861":58458,"_25124":58424,"_17549":97975,"_5":17444,"_23791":97877,"_2388":97976},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2861":58459,"_25124":58424,"_17549":97978,"_5":17444,"_23791":97877,"_2388":97979},[],"cifrar en tránsito y en reposo;",{"_2861":58460,"_25124":58424,"_17549":97981,"_5":17444,"_23791":97877,"_2388":97982},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2861":58461,"_25124":58424,"_17549":97984,"_5":17444,"_23791":97877,"_2388":97985},[],"aplicar una política explícita de retención y legal hold;",{"_2861":58462,"_25124":58424,"_17549":97987,"_5":17444,"_23791":97877,"_2388":97988},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2861":58463,"_25124":58424,"_17549":97990,"_5":17444,"_23791":97881,"_2388":97991},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2861":58464,"_25124":58424,"_17549":97993,"_5":17444,"_23791":97881,"_2388":97994},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2861":58465,"_25124":58424,"_17549":97996,"_5":17444,"_23791":97889,"_2388":97997},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2861":58466,"_25124":58424,"_17549":97999,"_5":17444,"_23791":97893,"_2388":98000},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2861":58467,"_25124":58424,"_17549":98002,"_5":17444,"_23791":97897,"_2388":98003},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2861":58468,"_25124":58424,"_17549":98005,"_5":17444,"_23791":97901,"_2388":98006},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2861":58469,"_25124":58424,"_17549":98008,"_5":17444,"_23791":97905,"_2388":98009},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2861":58470,"_25124":58424,"_17549":98011,"_5":17444,"_23791":97909,"_2388":98012},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2861":58471,"_25124":58424,"_17549":98014,"_5":17444,"_23791":97909,"_2388":98015},[],"aparece un evento de auditoría correcto;",{"_2861":58472,"_25124":58424,"_17549":98017,"_5":17444,"_23791":97909,"_2388":98018},[],"el principal coincide con la identidad utilizada;",{"_2861":58473,"_25124":58424,"_17549":98020,"_5":17444,"_23791":97909,"_2388":98021},[],"el consumidor lo persiste una sola vez;",{"_2861":58474,"_25124":58424,"_17549":98023,"_5":17444,"_23791":97909,"_2388":98024},[],"puede recuperarse por recurso, actor y periodo;",{"_2861":58475,"_25124":58424,"_17549":98026,"_5":17444,"_23791":97909,"_2388":98027},[],"una interrupción del consumidor produce una alerta.",{"_2861":58476,"_25124":58424,"_17549":98029,"_5":17444,"_23791":97909,"_2388":98030},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2861":58477,"_25124":58477,"_5":12314,"_2388":98032,"_25460":98033,"_17549":98034,"_23791":58477},"Arquitectura de la plataforma",[40822,97162],[],{"_2861":58478,"_25124":58477,"_17549":98036,"_5":17444,"_23791":58477,"_2388":98037},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2861":58479,"_25124":58477,"_5":25457,"_17549":98039,"_23791":98040,"_2388":98041},[],"/docs/pr-preview/pr-37/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2861":58480,"_25124":58477,"_5":25457,"_17549":98043,"_23791":98044,"_2388":98045},[],"/docs/pr-preview/pr-37/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2861":58481,"_25124":58477,"_5":25457,"_17549":98047,"_23791":98048,"_2388":98049},[],"/docs/pr-preview/pr-37/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2861":58482,"_25124":58477,"_5":25457,"_17549":98051,"_23791":98052,"_2388":98053},[],"/docs/pr-preview/pr-37/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2861":58483,"_25124":58477,"_5":25457,"_17549":98055,"_23791":98056,"_2388":98057},[],"/docs/pr-preview/pr-37/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2861":58484,"_25124":58477,"_17549":98059,"_5":17444,"_23791":58477,"_2388":98060},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2861":58485,"_25124":58477,"_17549":98062,"_5":17444,"_23791":58477,"_2388":98063},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2861":58486,"_25124":58477,"_17549":98065,"_5":17444,"_23791":98040,"_2388":98066},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2861":58487,"_25124":58477,"_17549":98068,"_5":17444,"_23791":98044,"_2388":98069},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2861":58488,"_25124":58477,"_17549":98071,"_5":17444,"_23791":98048,"_2388":98072},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2861":58489,"_25124":58477,"_17549":98074,"_5":17444,"_23791":98052,"_2388":98075},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2861":58490,"_25124":58477,"_17549":98077,"_5":17444,"_23791":98056,"_2388":98078},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2861":58491,"_25124":58491,"_5":12314,"_2388":98080,"_25460":98081,"_17549":98082,"_23791":58491},"Cómo funciona Lamassu",[40822,97162],[],{"_2861":58492,"_25124":58491,"_17549":98084,"_5":17444,"_23791":58491,"_2388":98085},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2861":58493,"_25124":58491,"_5":25457,"_17549":98087,"_23791":98088,"_2388":98089},[],"/docs/pr-preview/pr-37/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2861":58494,"_25124":58491,"_5":25457,"_17549":98091,"_23791":98092,"_2388":98093},[],"/docs/pr-preview/pr-37/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2861":58495,"_25124":58491,"_17549":98095,"_5":17444,"_23791":58491,"_2388":98096},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2861":58496,"_25124":58491,"_17549":98098,"_5":17444,"_23791":98088,"_2388":98099},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2861":58497,"_25124":58491,"_17549":98101,"_5":17444,"_23791":98088,"_2388":98102},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2861":58498,"_25124":58491,"_17549":98104,"_5":17444,"_23791":98088,"_2388":98105},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2861":58499,"_25124":58491,"_17549":98107,"_5":17444,"_23791":98088,"_2388":98108},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2861":58500,"_25124":58491,"_17549":98110,"_5":17444,"_23791":98088,"_2388":98111},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2861":58501,"_25124":58491,"_17549":98113,"_5":17444,"_23791":98092,"_2388":98114},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2861":58502,"_25124":58491,"_17549":98116,"_5":17444,"_23791":98092,"_2388":98117},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2861":58503,"_25124":58491,"_17549":98119,"_5":17444,"_23791":98092,"_2388":98120},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2861":58504,"_25124":58491,"_17549":98122,"_5":17444,"_23791":98092,"_2388":98123},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2861":58505,"_25124":58491,"_17549":98125,"_5":17444,"_23791":98092,"_2388":98126},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2861":58506,"_25124":58491,"_17549":98128,"_5":17444,"_23791":98092,"_2388":98129},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2861":58507,"_25124":58491,"_17549":98131,"_5":17444,"_23791":98092,"_2388":98132},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2861":58508,"_25124":58508,"_5":12314,"_2388":98134,"_25460":98135,"_17549":98136,"_23791":58508},"Dispositivos e identidades",[40822,97162,43140,98134],[],{"_2861":58509,"_25124":58508,"_17549":98138,"_5":17444,"_23791":58508,"_2388":98139},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2861":58510,"_25124":58508,"_5":25457,"_17549":98141,"_23791":98142,"_2388":98143},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2861":58511,"_25124":58508,"_5":25457,"_17549":98145,"_23791":98146,"_2388":98147},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2861":58512,"_25124":58508,"_5":25457,"_17549":98149,"_23791":98150,"_2388":98151},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2861":58513,"_25124":58508,"_5":25457,"_17549":98153,"_23791":98154,"_2388":98155},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2861":58514,"_25124":58508,"_5":25457,"_17549":98157,"_23791":98158,"_2388":98159},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2861":58515,"_25124":58508,"_5":25457,"_17549":98161,"_23791":98162,"_2388":98163},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2861":58516,"_25124":58508,"_5":25457,"_17549":98165,"_23791":98166,"_2388":98167},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2861":58517,"_25124":58508,"_5":25457,"_17549":98169,"_23791":98170,"_2388":98171},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2861":58518,"_25124":58508,"_5":25457,"_17549":98173,"_23791":98174,"_2388":98175},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2861":58519,"_25124":58508,"_5":25457,"_17549":98177,"_23791":98178,"_2388":98179},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2861":58520,"_25124":58508,"_5":25457,"_17549":98181,"_23791":98182,"_2388":98183},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2861":58521,"_25124":58508,"_17549":98185,"_5":17444,"_23791":58508,"_2388":98186},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2861":58522,"_25124":58508,"_17549":98188,"_5":17444,"_23791":58508,"_2388":98189},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2861":58523,"_25124":58508,"_17549":98191,"_5":17444,"_23791":98142,"_2388":98192},[],"Vista operativa",{"_2861":58524,"_25124":58508,"_17549":98194,"_5":17444,"_23791":98142,"_2388":98195},[],"Interpretación",{"_2861":58525,"_25124":58508,"_17549":98197,"_5":17444,"_23791":98142,"_2388":43203},[],{"_2861":58526,"_25124":58508,"_17549":98199,"_5":17444,"_23791":98142,"_2388":98200},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2861":58527,"_25124":58508,"_17549":98202,"_5":17444,"_23791":98142,"_2388":43209},[],{"_2861":58528,"_25124":58508,"_17549":98204,"_5":17444,"_23791":98142,"_2388":98205},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2861":58529,"_25124":58508,"_17549":98207,"_5":17444,"_23791":98142,"_2388":43215},[],{"_2861":58530,"_25124":58508,"_17549":98209,"_5":17444,"_23791":98142,"_2388":98210},[],"La identidad está en la ventana operativa de renovación.",{"_2861":58531,"_25124":58508,"_17549":98212,"_5":17444,"_23791":98142,"_2388":43221},[],{"_2861":58532,"_25124":58508,"_17549":98214,"_5":17444,"_23791":98142,"_2388":98215},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2861":58533,"_25124":58508,"_17549":98217,"_5":17444,"_23791":98142,"_2388":43227},[],{"_2861":58534,"_25124":58508,"_17549":98219,"_5":17444,"_23791":98142,"_2388":98220},[],"La identidad ha vencido.",{"_2861":58535,"_25124":58508,"_17549":98222,"_5":17444,"_23791":98142,"_2388":43233},[],{"_2861":58536,"_25124":58508,"_17549":98224,"_5":17444,"_23791":98142,"_2388":98225},[],"La identidad está marcada como revocada.",{"_2861":58537,"_25124":58508,"_17549":98227,"_5":17444,"_23791":98142,"_2388":43239},[],{"_2861":58538,"_25124":58508,"_17549":98229,"_5":17444,"_23791":98142,"_2388":98230},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2861":58539,"_25124":58508,"_17549":98232,"_5":17444,"_23791":98142,"_2388":98233},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2861":58540,"_25124":58508,"_17549":98235,"_5":17444,"_23791":98146,"_2388":98236},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2861":58541,"_25124":58508,"_17549":98238,"_5":17444,"_23791":98146,"_2388":98239},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2861":58542,"_25124":58508,"_17549":98241,"_5":17444,"_23791":98146,"_2388":98242},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2861":58543,"_25124":58508,"_17549":98244,"_5":17444,"_23791":98146,"_2388":98245},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2861":58544,"_25124":58508,"_17549":98247,"_5":17444,"_23791":98150,"_2388":98248},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2861":58545,"_25124":58508,"_17549":98250,"_5":17444,"_23791":98154,"_2388":98251},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2861":58546,"_25124":58508,"_17549":98253,"_5":17444,"_23791":98158,"_2388":98254},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2861":58547,"_25124":58508,"_17549":98256,"_5":17444,"_23791":98162,"_2388":98257},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2861":58548,"_25124":58508,"_17549":98259,"_5":17444,"_23791":98166,"_2388":98260},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2861":58549,"_25124":58508,"_17549":98262,"_5":17444,"_23791":98166,"_2388":98263},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2861":58550,"_25124":58508,"_17549":98265,"_5":17444,"_23791":98170,"_2388":98266},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2861":58551,"_25124":58508,"_17549":98268,"_5":17444,"_23791":98170,"_2388":98269},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2861":58552,"_25124":58508,"_17549":98271,"_5":17444,"_23791":98170,"_2388":98272},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2861":58553,"_25124":58508,"_17549":98274,"_5":17444,"_23791":98170,"_2388":98275},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2861":58554,"_25124":58508,"_17549":98277,"_5":17444,"_23791":98170,"_2388":98278},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2861":58555,"_25124":58508,"_17549":98280,"_5":17444,"_23791":98170,"_2388":98281},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2861":58556,"_25124":58508,"_17549":98283,"_5":17444,"_23791":98174,"_2388":98284},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2861":58557,"_25124":58508,"_17549":98286,"_5":17444,"_23791":98174,"_2388":98287},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2861":58558,"_25124":58508,"_17549":98289,"_5":17444,"_23791":98178,"_2388":98290},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2861":58559,"_25124":58508,"_17549":98292,"_5":17444,"_23791":98178,"_2388":98293},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2861":58560,"_25124":58508,"_17549":98295,"_5":17444,"_23791":98178,"_2388":98296},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2861":58561,"_25124":58508,"_17549":98298,"_5":17444,"_23791":98178,"_2388":98299},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2861":58562,"_25124":58508,"_17549":98301,"_5":17444,"_23791":98182,"_2388":98302},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2861":58563,"_25124":58508,"_17549":98304,"_5":17444,"_23791":98182,"_2388":98305},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2861":58564,"_25124":58564,"_5":12314,"_2388":98307,"_25460":98308,"_17549":98310,"_23791":58564},"Identidad inicial y autenticación",[40822,97162,43140,98134,98309],"Enrolamiento con PKI",[],{"_2861":58565,"_25124":58564,"_17549":98312,"_5":17444,"_23791":58564,"_2388":98313},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2861":58566,"_25124":58564,"_5":25457,"_17549":98315,"_23791":98316,"_2388":98317},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2861":58567,"_25124":58564,"_5":25457,"_17549":98319,"_23791":98320,"_2388":98321},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2861":58568,"_25124":58564,"_5":25457,"_17549":98323,"_23791":98324,"_2388":98325},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2861":58569,"_25124":58564,"_5":25457,"_17549":98327,"_23791":98328,"_2388":98329},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2861":58570,"_25124":58564,"_5":25457,"_17549":98331,"_23791":98332,"_2388":98333},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2861":58571,"_25124":58564,"_17549":98335,"_5":17444,"_23791":58564,"_2388":98336},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2861":58572,"_25124":58564,"_17549":98338,"_5":17444,"_23791":98316,"_2388":98339},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2861":58573,"_25124":58564,"_17549":98341,"_5":17444,"_23791":98316,"_2388":98342},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2861":58574,"_25124":58564,"_17549":98344,"_5":17444,"_23791":98320,"_2388":98345},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2861":58575,"_25124":58564,"_17549":98347,"_5":17444,"_23791":98320,"_2388":98348},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2861":58576,"_25124":58564,"_17549":98350,"_5":17444,"_23791":98320,"_2388":98351},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2861":58577,"_25124":58564,"_17549":98353,"_5":17444,"_23791":98324,"_2388":98354},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2861":58578,"_25124":58564,"_17549":98356,"_5":17444,"_23791":98324,"_2388":98357},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2861":58579,"_25124":58564,"_17549":98359,"_5":17444,"_23791":98328,"_2388":98360},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2861":58580,"_25124":58564,"_17549":98362,"_5":17444,"_23791":98328,"_2388":98363},[],"Ejemplo de cuerpo:",{"_2861":58581,"_25124":58564,"_17549":98365,"_5":17444,"_23791":98328,"_2388":98366},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2861":58582,"_25124":58564,"_17549":98368,"_5":17444,"_23791":98328,"_2388":98369},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2861":58583,"_25124":58564,"_17549":98371,"_5":17444,"_23791":98328,"_2388":98372},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2861":58584,"_25124":58564,"_17549":98374,"_5":17444,"_23791":98328,"_2388":98375},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2861":58585,"_25124":58564,"_17549":98377,"_5":17444,"_23791":98332,"_2388":98378},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2861":58586,"_25124":58564,"_17549":98380,"_5":17444,"_23791":98332,"_2388":98381},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2861":58587,"_25124":58587,"_5":12314,"_2388":98383,"_25460":98384,"_17549":98385,"_23791":58587},"Configura y opera el DMS",[40822,97162,43140,98134,98309],[],{"_2861":58588,"_25124":58587,"_17549":98387,"_5":17444,"_23791":58587,"_2388":98388},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2861":58589,"_25124":58587,"_5":25457,"_17549":98390,"_23791":98391,"_2388":95863},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2861":58590,"_25124":58587,"_5":25457,"_17549":98393,"_23791":98394,"_2388":98395},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2861":58591,"_25124":58587,"_5":25457,"_17549":98397,"_23791":98398,"_2388":98399},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2861":58592,"_25124":58587,"_5":25457,"_17549":98401,"_23791":98402,"_2388":98403},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2861":58593,"_25124":58587,"_5":25457,"_17549":98405,"_23791":98406,"_2388":98407},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2861":58594,"_25124":58587,"_5":25457,"_17549":98409,"_23791":98410,"_2388":98411},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2861":58595,"_25124":58587,"_5":25457,"_17549":98413,"_23791":98414,"_2388":98415},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2861":58596,"_25124":58587,"_5":25457,"_17549":98417,"_23791":98418,"_2388":98419},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2861":58597,"_25124":58587,"_5":25457,"_17549":98421,"_23791":98422,"_2388":43435},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2861":58598,"_25124":58587,"_5":25457,"_17549":98424,"_23791":98425,"_2388":43439},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2861":58599,"_25124":58587,"_5":25457,"_17549":98427,"_23791":98428,"_2388":98429},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2861":58600,"_25124":58587,"_5":25457,"_17549":98431,"_23791":98432,"_2388":98433},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2861":58601,"_25124":58587,"_5":25457,"_17549":98435,"_23791":98436,"_2388":98437},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2861":58602,"_25124":58587,"_5":25457,"_17549":98439,"_23791":98440,"_2388":98441},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2861":58603,"_25124":58587,"_5":25457,"_17549":98443,"_23791":98444,"_2388":43459},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2861":58604,"_25124":58587,"_5":25457,"_17549":98446,"_23791":98447,"_2388":98448},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2861":58605,"_25124":58587,"_5":25457,"_17549":98450,"_23791":98451,"_2388":98452},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2861":58606,"_25124":58587,"_5":25457,"_17549":98454,"_23791":98455,"_2388":98456},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2861":58607,"_25124":58587,"_17549":98458,"_5":17444,"_23791":58587,"_2388":98459},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2861":58608,"_25124":58587,"_17549":98461,"_5":17444,"_23791":98391,"_2388":98462},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2861":58609,"_25124":58587,"_17549":98464,"_5":17444,"_23791":98391,"_2388":98465},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2861":58610,"_25124":58587,"_17549":98467,"_5":17444,"_23791":98398,"_2388":98468},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2861":58611,"_25124":58587,"_17549":98470,"_5":17444,"_23791":98402,"_2388":98471},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2861":58612,"_25124":58587,"_17549":98473,"_5":17444,"_23791":98406,"_2388":98474},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2861":58613,"_25124":58587,"_17549":98476,"_5":17444,"_23791":98410,"_2388":98477},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2861":58614,"_25124":58587,"_17549":98479,"_5":17444,"_23791":98414,"_2388":98480},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2861":58615,"_25124":58587,"_17549":98482,"_5":17444,"_23791":98422,"_2388":98483},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2861":58616,"_25124":58587,"_17549":98485,"_5":17444,"_23791":98422,"_2388":98486},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2861":58617,"_25124":58587,"_17549":98488,"_5":17444,"_23791":98425,"_2388":98489},[],"Campo de `settings.enrollment_settings`",{"_2861":58618,"_25124":58587,"_17549":98491,"_5":17444,"_23791":98425,"_2388":98492},[],"Decisión",{"_2861":58619,"_25124":58587,"_17549":98494,"_5":17444,"_23791":98425,"_2388":43510},[],{"_2861":58620,"_25124":58587,"_17549":98496,"_5":17444,"_23791":98425,"_2388":98497},[],"`EST_RFC7030` para estas operaciones.",{"_2861":58621,"_25124":58587,"_17549":98499,"_5":17444,"_23791":98425,"_2388":43516},[],{"_2861":58622,"_25124":58587,"_17549":98501,"_5":17444,"_23791":98425,"_2388":98502},[],"ID de la CA que firmará.",{"_2861":58623,"_25124":58587,"_17549":98504,"_5":17444,"_23791":98425,"_2388":43522},[],{"_2861":58624,"_25124":58587,"_17549":98506,"_5":17444,"_23791":98425,"_2388":98507},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2861":58625,"_25124":58587,"_17549":98509,"_5":17444,"_23791":98425,"_2388":43528},[],{"_2861":58626,"_25124":58587,"_17549":98511,"_5":17444,"_23791":98425,"_2388":98512},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2861":58627,"_25124":58587,"_17549":98514,"_5":17444,"_23791":98425,"_2388":43534},[],{"_2861":58628,"_25124":58587,"_17549":98516,"_5":17444,"_23791":98425,"_2388":98517},[],"Uno de los cuatro modos de autenticación.",{"_2861":58629,"_25124":58587,"_17549":98519,"_5":17444,"_23791":98425,"_2388":98520},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2861":58630,"_25124":58587,"_17549":98522,"_5":17444,"_23791":98428,"_2388":98523},[],"Los bloques son independientes:",{"_2861":58631,"_25124":58587,"_17549":98525,"_5":17444,"_23791":98428,"_2388":98526},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2861":58632,"_25124":58587,"_17549":98528,"_5":17444,"_23791":98428,"_2388":98529},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2861":58633,"_25124":58587,"_17549":98531,"_5":17444,"_23791":98428,"_2388":43552},[],{"_2861":58634,"_25124":58587,"_17549":98533,"_5":17444,"_23791":98428,"_2388":98534},[],"Control aplicado en la operación configurada",{"_2861":58635,"_25124":58587,"_17549":98536,"_5":17444,"_23791":98428,"_2388":43558},[],{"_2861":58636,"_25124":58587,"_17549":98538,"_5":17444,"_23791":98428,"_2388":98539},[],"Validación del certificado presentado.",{"_2861":58637,"_25124":58587,"_17549":98541,"_5":17444,"_23791":98428,"_2388":43564},[],{"_2861":58638,"_25124":58587,"_17549":98543,"_5":17444,"_23791":98428,"_2388":98544},[],"Autorización del webhook configurado.",{"_2861":58639,"_25124":58587,"_17549":98546,"_5":17444,"_23791":98428,"_2388":43570},[],{"_2861":58640,"_25124":58587,"_17549":98548,"_5":17444,"_23791":98428,"_2388":98549},[],"Validación del certificado y, después, aprobación del webhook.",{"_2861":58641,"_25124":58587,"_17549":98551,"_5":17444,"_23791":98428,"_2388":43576},[],{"_2861":58642,"_25124":58587,"_17549":98553,"_5":17444,"_23791":98428,"_2388":98554},[],"Sin autenticación del solicitante por el DMS.",{"_2861":58643,"_25124":58587,"_17549":98556,"_5":17444,"_23791":98428,"_2388":98557},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2861":58644,"_25124":58587,"_17549":98559,"_5":17444,"_23791":98428,"_2388":98560},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2861":58645,"_25124":58587,"_17549":98562,"_5":17444,"_23791":98428,"_2388":98563},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2861":58646,"_25124":58587,"_17549":98565,"_5":17444,"_23791":98428,"_2388":98566},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2861":58647,"_25124":58587,"_17549":98568,"_5":17444,"_23791":98432,"_2388":98569},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2861":58648,"_25124":58587,"_17549":98571,"_5":17444,"_23791":98432,"_2388":98572},[],"Campo de `external_webhook_settings`",{"_2861":58649,"_25124":58587,"_17549":98574,"_5":17444,"_23791":98432,"_2388":98492},[],{"_2861":58650,"_25124":58587,"_17549":98576,"_5":17444,"_23791":98432,"_2388":43602},[],{"_2861":58651,"_25124":58587,"_17549":98578,"_5":17444,"_23791":98432,"_2388":98579},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2861":58652,"_25124":58587,"_17549":98581,"_5":17444,"_23791":98432,"_2388":43608},[],{"_2861":58653,"_25124":58587,"_17549":98583,"_5":17444,"_23791":98432,"_2388":98584},[],"`POST` o `PUT`; `POST` por defecto.",{"_2861":58654,"_25124":58587,"_17549":98586,"_5":17444,"_23791":98432,"_2388":43614},[],{"_2861":58655,"_25124":58587,"_17549":98588,"_5":17444,"_23791":98432,"_2388":98589},[],"Etiqueta usada en los logs del servicio.",{"_2861":58656,"_25124":58587,"_17549":98591,"_5":17444,"_23791":98432,"_2388":43620},[],{"_2861":58657,"_25124":58587,"_17549":98593,"_5":17444,"_23791":98432,"_2388":98594},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2861":58658,"_25124":58587,"_17549":98596,"_5":17444,"_23791":98432,"_2388":43626},[],{"_2861":58659,"_25124":58587,"_17549":98598,"_5":17444,"_23791":98432,"_2388":98599},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2861":58660,"_25124":58587,"_17549":98601,"_5":17444,"_23791":98432,"_2388":43632},[],{"_2861":58661,"_25124":58587,"_17549":98603,"_5":17444,"_23791":98432,"_2388":98604},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2861":58662,"_25124":58587,"_17549":98606,"_5":17444,"_23791":98432,"_2388":43638},[],{"_2861":58663,"_25124":58587,"_17549":98608,"_5":17444,"_23791":98432,"_2388":98609},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_2861":58664,"_25124":58587,"_17549":98611,"_5":17444,"_23791":98432,"_2388":43644},[],{"_2861":58665,"_25124":58587,"_17549":98613,"_5":17444,"_23791":98432,"_2388":98614},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2861":58666,"_25124":58587,"_17549":98616,"_5":17444,"_23791":98432,"_2388":43650},[],{"_2861":58667,"_25124":58587,"_17549":98618,"_5":17444,"_23791":98432,"_2388":98619},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2861":58668,"_25124":58587,"_17549":98621,"_5":17444,"_23791":98432,"_2388":98622},[],"Reglas de esa configuración:",{"_2861":58669,"_25124":58587,"_17549":98624,"_5":17444,"_23791":98432,"_2388":98625},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_2861":58670,"_25124":58587,"_17549":98627,"_5":17444,"_23791":98432,"_2388":98628},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2861":58671,"_25124":58587,"_17549":98630,"_5":17444,"_23791":98432,"_2388":98631},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2861":58672,"_25124":58587,"_17549":98633,"_5":17444,"_23791":98432,"_2388":98634},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2861":58673,"_25124":58587,"_17549":98636,"_5":17444,"_23791":98432,"_2388":98637},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2861":58674,"_25124":58587,"_17549":98639,"_5":17444,"_23791":98432,"_2388":98640},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2861":58675,"_25124":58587,"_17549":98642,"_5":17444,"_23791":98432,"_2388":98643},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2861":58676,"_25124":58587,"_17549":98645,"_5":17444,"_23791":98432,"_2388":98646},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de archivo), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de archivo sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS.",{"_2861":58677,"_25124":58587,"_17549":98648,"_5":17444,"_23791":98432,"_2388":98649},[],"La migración reescribe solo los campos heredados `mtls`; una configuración que ya contenga `mtls_options` se conserva tal como está almacenada. Si esa configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando.",{"_2861":58678,"_25124":58587,"_17549":98651,"_5":17444,"_23791":98436,"_2388":98652},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2861":58679,"_25124":58587,"_17549":98654,"_5":17444,"_23791":98440,"_2388":98655},[],"Campo de `settings.reenrollment_settings`",{"_2861":58680,"_25124":58587,"_17549":98657,"_5":17444,"_23791":98440,"_2388":98658},[],"Función",{"_2861":58681,"_25124":58587,"_17549":98660,"_5":17444,"_23791":98440,"_2388":43694},[],{"_2861":58682,"_25124":58587,"_17549":98662,"_5":17444,"_23791":98440,"_2388":98663},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2861":58683,"_25124":58587,"_17549":98665,"_5":17444,"_23791":98440,"_2388":43700},[],{"_2861":58684,"_25124":58587,"_17549":98667,"_5":17444,"_23791":98440,"_2388":98668},[],"Umbral operativo preventivo de monitorización.",{"_2861":58685,"_25124":58587,"_17549":98670,"_5":17444,"_23791":98440,"_2388":43706},[],{"_2861":58686,"_25124":58587,"_17549":98672,"_5":17444,"_23791":98440,"_2388":98673},[],"Umbral operativo crítico de monitorización.",{"_2861":58687,"_25124":58587,"_17549":98675,"_5":17444,"_23791":98440,"_2388":43712},[],{"_2861":58688,"_25124":58587,"_17549":98677,"_5":17444,"_23791":98440,"_2388":98678},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2861":58689,"_25124":58587,"_17549":98680,"_5":17444,"_23791":98440,"_2388":43718},[],{"_2861":58690,"_25124":58587,"_17549":98682,"_5":17444,"_23791":98440,"_2388":98683},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2861":58691,"_25124":58587,"_17549":98685,"_5":17444,"_23791":98440,"_2388":43724},[],{"_2861":58692,"_25124":58587,"_17549":98687,"_5":17444,"_23791":98440,"_2388":98688},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2861":58693,"_25124":58587,"_17549":98690,"_5":17444,"_23791":98440,"_2388":98691},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2861":58694,"_25124":58587,"_17549":98693,"_5":17444,"_23791":98444,"_2388":98694},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2861":58695,"_25124":58587,"_17549":98696,"_5":17444,"_23791":98447,"_2388":96220},[],{"_2861":58696,"_25124":58587,"_17549":98698,"_5":17444,"_23791":98447,"_2388":98699},[],"Qué publica",{"_2861":58697,"_25124":58587,"_17549":98701,"_5":17444,"_23791":98447,"_2388":43741},[],{"_2861":58698,"_25124":58587,"_17549":98703,"_5":17444,"_23791":98447,"_2388":98704},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2861":58699,"_25124":58587,"_17549":98706,"_5":17444,"_23791":98447,"_2388":43747},[],{"_2861":58700,"_25124":58587,"_17549":98708,"_5":17444,"_23791":98447,"_2388":98709},[],"Certificado de la CA emisora seleccionada.",{"_2861":58701,"_25124":58587,"_17549":98711,"_5":17444,"_23791":98447,"_2388":43753},[],{"_2861":58702,"_25124":58587,"_17549":98713,"_5":17444,"_23791":98447,"_2388":98714},[],"Certificados de las CAs elegidas explícitamente.",{"_2861":58703,"_25124":58587,"_17549":98716,"_5":17444,"_23791":98447,"_2388":98717},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2861":58704,"_25124":58587,"_17549":98719,"_5":17444,"_23791":98451,"_2388":98720},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2861":58705,"_25124":58587,"_17549":98722,"_5":17444,"_23791":98451,"_2388":98723},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2861":58706,"_25124":58587,"_17549":98725,"_5":17444,"_23791":98451,"_2388":98726},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2861":58707,"_25124":58587,"_17549":98728,"_5":17444,"_23791":98455,"_2388":98729},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2861":58708,"_25124":58708,"_5":12314,"_2388":98731,"_25460":98732,"_17549":98733,"_23791":58708},"Integra el cliente EST",[40822,97162,43140,98134,98309],[],{"_2861":58709,"_25124":58708,"_17549":98735,"_5":17444,"_23791":58708,"_2388":98736},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2861":58710,"_25124":58708,"_5":25457,"_17549":98738,"_23791":98739,"_2388":95863},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2861":58711,"_25124":58708,"_5":25457,"_17549":98741,"_23791":98742,"_2388":98743},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2861":58712,"_25124":58708,"_5":25457,"_17549":98745,"_23791":98746,"_2388":98747},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2861":58713,"_25124":58708,"_5":25457,"_17549":98749,"_23791":98750,"_2388":98751},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2861":58714,"_25124":58708,"_5":25457,"_17549":98753,"_23791":98754,"_2388":98755},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2861":58715,"_25124":58708,"_5":25457,"_17549":98757,"_23791":98758,"_2388":98759},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2861":58716,"_25124":58708,"_17549":98761,"_5":17444,"_23791":58708,"_2388":98762},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2861":58717,"_25124":58708,"_17549":98764,"_5":17444,"_23791":98739,"_2388":98765},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2861":58718,"_25124":58708,"_17549":98767,"_5":17444,"_23791":98739,"_2388":98768},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2861":58719,"_25124":58708,"_17549":98770,"_5":17444,"_23791":98739,"_2388":98771},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2861":58720,"_25124":58708,"_17549":98773,"_5":17444,"_23791":98742,"_2388":98774},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2861":58721,"_25124":58708,"_17549":98776,"_5":17444,"_23791":98742,"_2388":98777},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2861":58722,"_25124":58708,"_17549":98779,"_5":17444,"_23791":98746,"_2388":98780},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2861":58723,"_25124":58708,"_17549":98782,"_5":17444,"_23791":98746,"_2388":98783},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2861":58724,"_25124":58708,"_17549":98785,"_5":17444,"_23791":98750,"_2388":98786},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2861":58725,"_25124":58708,"_17549":98788,"_5":17444,"_23791":98750,"_2388":98789},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2861":58726,"_25124":58708,"_17549":98791,"_5":17444,"_23791":98754,"_2388":98792},[],"Para el caso de una raíz que emite directamente:",{"_2861":58727,"_25124":58708,"_17549":98794,"_5":17444,"_23791":98754,"_2388":98795},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2861":58728,"_25124":58708,"_17549":98797,"_5":17444,"_23791":98754,"_2388":98798},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2861":58729,"_25124":58708,"_17549":98800,"_5":17444,"_23791":98758,"_2388":98801},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2861":58730,"_25124":58730,"_5":12314,"_2388":98803,"_25460":98804,"_17549":98805,"_23791":58730},"Referencia EST",[40822,97162,43140,98134,98309],[],{"_2861":58731,"_25124":58730,"_17549":98807,"_5":17444,"_23791":58730,"_2388":98808},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2861":58732,"_25124":58730,"_5":25457,"_17549":98810,"_23791":98811,"_2388":98812},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2861":58733,"_25124":58730,"_5":25457,"_17549":98814,"_23791":98815,"_2388":19053},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2861":58734,"_25124":58730,"_5":25457,"_17549":98817,"_23791":98818,"_2388":21819},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2861":58735,"_25124":58730,"_5":25457,"_17549":98820,"_23791":98821,"_2388":21826},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2861":58736,"_25124":58730,"_5":25457,"_17549":98823,"_23791":98824,"_2388":21196},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2861":58737,"_25124":58730,"_5":25457,"_17549":98826,"_23791":98827,"_2388":98828},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2861":58738,"_25124":58730,"_5":25457,"_17549":98830,"_23791":98831,"_2388":98832},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2861":58739,"_25124":58730,"_5":25457,"_17549":98834,"_23791":98835,"_2388":98836},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2861":58740,"_25124":58730,"_17549":98838,"_5":17444,"_23791":58730,"_2388":98839},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2861":58741,"_25124":58730,"_17549":98841,"_5":17444,"_23791":98811,"_2388":98842},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2861":58742,"_25124":58730,"_17549":98844,"_5":17444,"_23791":98811,"_2388":96953},[],{"_2861":58743,"_25124":58730,"_17549":98846,"_5":17444,"_23791":98811,"_2388":98847},[],"Método",{"_2861":58744,"_25124":58730,"_17549":98849,"_5":17444,"_23791":98811,"_2388":98850},[],"Autenticación y condición",{"_2861":58745,"_25124":58730,"_17549":98852,"_5":17444,"_23791":98811,"_2388":43896},[],{"_2861":58746,"_25124":58730,"_17549":98854,"_5":17444,"_23791":98811,"_2388":43899},[],{"_2861":58747,"_25124":58730,"_17549":98856,"_5":17444,"_23791":98811,"_2388":98857},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2861":58748,"_25124":58730,"_17549":98859,"_5":17444,"_23791":98811,"_2388":43905},[],{"_2861":58749,"_25124":58730,"_17549":98861,"_5":17444,"_23791":98811,"_2388":43908},[],{"_2861":58750,"_25124":58730,"_17549":98863,"_5":17444,"_23791":98811,"_2388":98864},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2861":58751,"_25124":58730,"_17549":98866,"_5":17444,"_23791":98811,"_2388":43914},[],{"_2861":58752,"_25124":58730,"_17549":98868,"_5":17444,"_23791":98811,"_2388":43908},[],{"_2861":58753,"_25124":58730,"_17549":98870,"_5":17444,"_23791":98811,"_2388":98871},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2861":58754,"_25124":58730,"_17549":98873,"_5":17444,"_23791":98811,"_2388":43922},[],{"_2861":58755,"_25124":58730,"_17549":98875,"_5":17444,"_23791":98811,"_2388":43908},[],{"_2861":58756,"_25124":58730,"_17549":98877,"_5":17444,"_23791":98811,"_2388":98878},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2861":58757,"_25124":58730,"_17549":98880,"_5":17444,"_23791":98811,"_2388":98881},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2861":58758,"_25124":58730,"_17549":98883,"_5":17444,"_23791":98815,"_2388":98884},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2861":58759,"_25124":58730,"_17549":98886,"_5":17444,"_23791":98815,"_2388":98887},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2861":58760,"_25124":58730,"_17549":98889,"_5":17444,"_23791":98818,"_2388":98890},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2861":58761,"_25124":58730,"_17549":98892,"_5":17444,"_23791":98818,"_2388":98893},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2861":58762,"_25124":58730,"_17549":98895,"_5":17444,"_23791":98821,"_2388":98896},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2861":58763,"_25124":58730,"_17549":98898,"_5":17444,"_23791":98821,"_2388":98899},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2861":58764,"_25124":58730,"_17549":98901,"_5":17444,"_23791":98824,"_2388":98902},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2861":58765,"_25124":58730,"_17549":98904,"_5":17444,"_23791":98824,"_2388":98905},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2861":58766,"_25124":58730,"_17549":98907,"_5":17444,"_23791":98827,"_2388":98908},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2861":58767,"_25124":58730,"_17549":98910,"_5":17444,"_23791":98827,"_2388":98911},[],"Parte",{"_2861":58768,"_25124":58730,"_17549":98913,"_5":17444,"_23791":98827,"_2388":98914},[],"Contenido tras decodificar su Base64",{"_2861":58769,"_25124":58730,"_17549":98916,"_5":17444,"_23791":98827,"_2388":43966},[],{"_2861":58770,"_25124":58730,"_17549":98918,"_5":17444,"_23791":98827,"_2388":98919},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2861":58771,"_25124":58730,"_17549":98921,"_5":17444,"_23791":98827,"_2388":43972},[],{"_2861":58772,"_25124":58730,"_17549":98923,"_5":17444,"_23791":98827,"_2388":98924},[],"PKCS#7 DER con el certificado emitido.",{"_2861":58773,"_25124":58730,"_17549":98926,"_5":17444,"_23791":98827,"_2388":98927},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2861":58774,"_25124":58730,"_17549":98929,"_5":17444,"_23791":98831,"_2388":98930},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2861":58775,"_25124":58730,"_17549":98932,"_5":17444,"_23791":98831,"_2388":98933},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2861":58776,"_25124":58730,"_17549":98935,"_5":17444,"_23791":98831,"_2388":98936},[],"Convierte y comprueba el resultado:",{"_2861":58777,"_25124":58730,"_17549":98938,"_5":17444,"_23791":98831,"_2388":98939},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2861":58778,"_25124":58730,"_17549":98941,"_5":17444,"_23791":98835,"_2388":98942},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2861":58779,"_25124":58730,"_17549":98944,"_5":17444,"_23791":98835,"_2388":98945},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2861":58780,"_25124":58780,"_5":12314,"_2388":98309,"_25460":98947,"_17549":98948,"_23791":58780},[40822,97162,43140,98134,98309],[],{"_2861":58781,"_25124":58780,"_17549":98950,"_5":17444,"_23791":58780,"_2388":98951},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2861":58782,"_25124":58780,"_5":25457,"_17549":98953,"_23791":98954,"_2388":98955},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2861":58783,"_25124":58780,"_5":25457,"_17549":98957,"_23791":98958,"_2388":98959},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2861":58784,"_25124":58780,"_5":25457,"_17549":98961,"_23791":98962,"_2388":98963},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2861":58785,"_25124":58780,"_5":25457,"_17549":98965,"_23791":98966,"_2388":98967},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2861":58786,"_25124":58780,"_17549":98969,"_5":17444,"_23791":58780,"_2388":98970},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2861":58787,"_25124":58780,"_17549":98972,"_5":17444,"_23791":98954,"_2388":98973},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2861":58788,"_25124":58780,"_17549":98975,"_5":17444,"_23791":98954,"_2388":98976},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2861":58789,"_25124":58780,"_17549":98978,"_5":17444,"_23791":98954,"_2388":98979},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2861":58790,"_25124":58780,"_17549":98981,"_5":17444,"_23791":98954,"_2388":98982},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2861":58791,"_25124":58780,"_17549":98984,"_5":17444,"_23791":98954,"_2388":98985},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2861":58792,"_25124":58780,"_17549":98987,"_5":17444,"_23791":98954,"_2388":98988},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2861":58793,"_25124":58780,"_17549":98990,"_5":17444,"_23791":98958,"_2388":98991},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2861":58794,"_25124":58780,"_17549":98993,"_5":17444,"_23791":98958,"_2388":98994},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2861":58795,"_25124":58780,"_17549":98996,"_5":17444,"_23791":98958,"_2388":98997},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2861":58796,"_25124":58780,"_17549":98999,"_5":17444,"_23791":98958,"_2388":99000},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2861":58797,"_25124":58780,"_17549":99002,"_5":17444,"_23791":98962,"_2388":99003},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2861":58798,"_25124":58780,"_17549":99005,"_5":17444,"_23791":98962,"_2388":99006},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2861":58799,"_25124":58780,"_17549":99008,"_5":17444,"_23791":98962,"_2388":99009},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2861":58800,"_25124":58780,"_17549":99011,"_5":17444,"_23791":98962,"_2388":99012},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2861":58801,"_25124":58780,"_17549":99014,"_5":17444,"_23791":98966,"_2388":99015},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2861":58802,"_25124":58780,"_17549":99017,"_5":17444,"_23791":98966,"_2388":99018},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2861":58803,"_25124":58803,"_5":12314,"_2388":99020,"_25460":99021,"_17549":99022,"_23791":58803},"Estrategias de aprovisionamiento",[40822,97162,43140,98134,98309],[],{"_2861":58804,"_25124":58803,"_17549":99024,"_5":17444,"_23791":58803,"_2388":99025},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2861":58805,"_25124":58803,"_5":25457,"_17549":99027,"_23791":99028,"_2388":99029},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2861":58806,"_25124":58803,"_5":25457,"_17549":99031,"_23791":99032,"_2388":99033},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2861":58807,"_25124":58803,"_5":25457,"_17549":99035,"_23791":99036,"_2388":99037},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2861":58808,"_25124":58803,"_5":25457,"_17549":99039,"_23791":99040,"_2388":99041},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2861":58809,"_25124":58803,"_5":25457,"_17549":99043,"_23791":99044,"_2388":99045},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2861":58810,"_25124":58803,"_17549":99047,"_5":17444,"_23791":58803,"_2388":99048},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2861":58811,"_25124":58803,"_17549":99050,"_5":17444,"_23791":99028,"_2388":99051},[],"Recorrido",{"_2861":58812,"_25124":58803,"_17549":99053,"_5":17444,"_23791":99028,"_2388":99054},[],"Cuándo existe el dispositivo",{"_2861":58813,"_25124":58803,"_17549":99056,"_5":17444,"_23791":99028,"_2388":99057},[],"Qué compruebas",{"_2861":58814,"_25124":58803,"_17549":99059,"_5":17444,"_23791":99028,"_2388":99060},[],"Asignación manual",{"_2861":58815,"_25124":58803,"_17549":99062,"_5":17444,"_23791":99028,"_2388":99063},[],"El operador lo crea antes de asociar un certificado.",{"_2861":58816,"_25124":58803,"_17549":99065,"_5":17444,"_23791":99028,"_2388":99066},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2861":58817,"_25124":58803,"_17549":99068,"_5":17444,"_23791":99028,"_2388":99069},[],"EST con `JITP`",{"_2861":58818,"_25124":58803,"_17549":99071,"_5":17444,"_23791":99028,"_2388":99072},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2861":58819,"_25124":58803,"_17549":99074,"_5":17444,"_23791":99028,"_2388":99075},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2861":58820,"_25124":58803,"_17549":99077,"_5":17444,"_23791":99028,"_2388":99078},[],"EST con `PRE_REGISTRATION`",{"_2861":58821,"_25124":58803,"_17549":99080,"_5":17444,"_23791":99028,"_2388":99081},[],"Debe existir antes de `/simpleenroll`.",{"_2861":58822,"_25124":58803,"_17549":99083,"_5":17444,"_23791":99028,"_2388":99084},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2861":58823,"_25124":58803,"_17549":99086,"_5":17444,"_23791":99028,"_2388":99087},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2861":58824,"_25124":58803,"_17549":99089,"_5":17444,"_23791":99028,"_2388":99090},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2861":58825,"_25124":58803,"_17549":99092,"_5":17444,"_23791":99032,"_2388":99093},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2861":58826,"_25124":58803,"_17549":99095,"_5":17444,"_23791":99032,"_2388":99096},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2861":58827,"_25124":58803,"_17549":99098,"_5":17444,"_23791":99032,"_2388":99099},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2861":58828,"_25124":58803,"_17549":99101,"_5":17444,"_23791":99036,"_2388":99102},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2861":58829,"_25124":58803,"_17549":99104,"_5":17444,"_23791":99036,"_2388":99105},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2861":58830,"_25124":58803,"_17549":99107,"_5":17444,"_23791":99036,"_2388":99108},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2861":58831,"_25124":58803,"_17549":99110,"_5":17444,"_23791":99036,"_2388":99111},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2861":58832,"_25124":58803,"_17549":99113,"_5":17444,"_23791":99036,"_2388":99114},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2861":58833,"_25124":58803,"_17549":99116,"_5":17444,"_23791":99036,"_2388":99117},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2861":58834,"_25124":58803,"_17549":99119,"_5":17444,"_23791":99040,"_2388":96220},[],{"_2861":58835,"_25124":58803,"_17549":99121,"_5":17444,"_23791":99040,"_2388":99122},[],"Material que atraviesa EST",{"_2861":58836,"_25124":58803,"_17549":99124,"_5":17444,"_23791":99040,"_2388":99125},[],"Clave generada por el dispositivo",{"_2861":58837,"_25124":58803,"_17549":99127,"_5":17444,"_23791":99040,"_2388":99128},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2861":58838,"_25124":58803,"_17549":99130,"_5":17444,"_23791":99040,"_2388":99131},[],"Clave ya disponible en el dispositivo",{"_2861":58839,"_25124":58803,"_17549":99133,"_5":17444,"_23791":99040,"_2388":99134},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2861":58840,"_25124":58803,"_17549":99136,"_5":17444,"_23791":99040,"_2388":43459},[],{"_2861":58841,"_25124":58803,"_17549":99138,"_5":17444,"_23791":99040,"_2388":99139},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2861":58842,"_25124":58803,"_17549":99141,"_5":17444,"_23791":99040,"_2388":99142},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2861":58843,"_25124":58803,"_17549":99144,"_5":17444,"_23791":99044,"_2388":99145},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2861":58844,"_25124":58844,"_5":12314,"_2388":99147,"_25460":99148,"_17549":99149,"_23791":58844},"Renovación y recuperación",[40822,97162,43140,98134,98309],[],{"_2861":58845,"_25124":58844,"_17549":99151,"_5":17444,"_23791":58844,"_2388":99152},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2861":58846,"_25124":58844,"_5":25457,"_17549":99154,"_23791":99155,"_2388":99156},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2861":58847,"_25124":58844,"_5":25457,"_17549":99158,"_23791":99159,"_2388":99160},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2861":58848,"_25124":58844,"_5":25457,"_17549":99162,"_23791":99163,"_2388":99164},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2861":58849,"_25124":58844,"_5":25457,"_17549":99166,"_23791":99167,"_2388":99168},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2861":58850,"_25124":58844,"_5":25457,"_17549":99170,"_23791":99171,"_2388":99172},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2861":58851,"_25124":58844,"_17549":99174,"_5":17444,"_23791":58844,"_2388":99175},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2861":58852,"_25124":58844,"_17549":99177,"_5":17444,"_23791":99155,"_2388":99178},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2861":58853,"_25124":58844,"_17549":99180,"_5":17444,"_23791":99155,"_2388":99181},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2861":58854,"_25124":58844,"_17549":99183,"_5":17444,"_23791":99155,"_2388":99184},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2861":58855,"_25124":58844,"_17549":99186,"_5":17444,"_23791":99155,"_2388":99187},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2861":58856,"_25124":58844,"_17549":99189,"_5":17444,"_23791":99159,"_2388":99190},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2861":58857,"_25124":58844,"_17549":99192,"_5":17444,"_23791":99159,"_2388":99193},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2861":58858,"_25124":58844,"_17549":99195,"_5":17444,"_23791":99163,"_2388":99196},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2861":58859,"_25124":58844,"_17549":99198,"_5":17444,"_23791":99163,"_2388":99199},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2861":58860,"_25124":58844,"_17549":99201,"_5":17444,"_23791":99163,"_2388":99202},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2861":58861,"_25124":58844,"_17549":99204,"_5":17444,"_23791":99167,"_2388":99205},[],"Situación",{"_2861":58862,"_25124":58844,"_17549":99207,"_5":17444,"_23791":99167,"_2388":99208},[],"Procedimiento",{"_2861":58863,"_25124":58844,"_17549":99210,"_5":17444,"_23791":99167,"_2388":99211},[],"Certificado vigente, fuera de ventana",{"_2861":58864,"_25124":58844,"_17549":99213,"_5":17444,"_23791":99167,"_2388":99214},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2861":58865,"_25124":58844,"_17549":99216,"_5":17444,"_23791":99167,"_2388":99217},[],"Certificado vencido, clave disponible",{"_2861":58866,"_25124":58844,"_17549":99219,"_5":17444,"_23791":99167,"_2388":99220},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2861":58867,"_25124":58844,"_17549":99222,"_5":17444,"_23791":99167,"_2388":99223},[],"Renovación por webhook o `NO_AUTH`",{"_2861":58868,"_25124":58844,"_17549":99225,"_5":17444,"_23791":99167,"_2388":99226},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2861":58869,"_25124":58844,"_17549":99228,"_5":17444,"_23791":99167,"_2388":99229},[],"Clave perdida o inaccesible",{"_2861":58870,"_25124":58844,"_17549":99231,"_5":17444,"_23791":99167,"_2388":99232},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2861":58871,"_25124":58844,"_17549":99234,"_5":17444,"_23791":99167,"_2388":99235},[],"Identidad actual revocada",{"_2861":58872,"_25124":58844,"_17549":99237,"_5":17444,"_23791":99167,"_2388":99238},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2861":58873,"_25124":58844,"_17549":99240,"_5":17444,"_23791":99167,"_2388":99241},[],"Dispositivo sin identidad",{"_2861":58874,"_25124":58844,"_17549":99243,"_5":17444,"_23791":99167,"_2388":99244},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2861":58875,"_25124":58844,"_17549":99246,"_5":17444,"_23791":99167,"_2388":99247},[],"Dispositivo retirado",{"_2861":58876,"_25124":58844,"_17549":99249,"_5":17444,"_23791":99167,"_2388":99250},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2861":58877,"_25124":58844,"_17549":99252,"_5":17444,"_23791":99167,"_2388":99253},[],"Timeout, HTTP 500 o fallo de instalación",{"_2861":58878,"_25124":58844,"_17549":99255,"_5":17444,"_23791":99167,"_2388":99256},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2861":58879,"_25124":58844,"_17549":99258,"_5":17444,"_23791":99171,"_2388":99259},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2861":58880,"_25124":58844,"_17549":99261,"_5":17444,"_23791":99171,"_2388":99262},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2861":58881,"_25124":58881,"_5":12314,"_2388":99264,"_25460":99265,"_17549":99266,"_23791":58881},"Diagnóstico de enrolamiento",[40822,97162,43140,98134,98309],[],{"_2861":58882,"_25124":58881,"_17549":99268,"_5":17444,"_23791":58881,"_2388":99269},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2861":58883,"_25124":58881,"_5":25457,"_17549":99271,"_23791":99272,"_2388":99273},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2861":58884,"_25124":58881,"_5":25457,"_17549":99275,"_23791":99276,"_2388":99277},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2861":58885,"_25124":58881,"_5":25457,"_17549":99279,"_23791":99280,"_2388":98836},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2861":58886,"_25124":58881,"_5":25457,"_17549":99282,"_23791":99283,"_2388":99284},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2861":58887,"_25124":58881,"_17549":99286,"_5":17444,"_23791":58881,"_2388":99287},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2861":58888,"_25124":58881,"_17549":99289,"_5":17444,"_23791":99276,"_2388":99290},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2861":58889,"_25124":58881,"_17549":99292,"_5":17444,"_23791":99276,"_2388":99293},[],"Síntoma o mensaje",{"_2861":58890,"_25124":58881,"_17549":99295,"_5":17444,"_23791":99276,"_2388":99296},[],"Qué revisar",{"_2861":58891,"_25124":58881,"_17549":99298,"_5":17444,"_23791":99276,"_2388":99299},[],"curl rechaza TLS, nombre o emisor",{"_2861":58892,"_25124":58881,"_17549":99301,"_5":17444,"_23791":99276,"_2388":99302},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2861":58893,"_25124":58881,"_17549":99304,"_5":17444,"_23791":99276,"_2388":99305},[],"404 o APS ausente",{"_2861":58894,"_25124":58881,"_17549":99307,"_5":17444,"_23791":99276,"_2388":99308},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2861":58895,"_25124":58881,"_17549":99310,"_5":17444,"_23791":99276,"_2388":99311},[],"400, error de CSR o formato",{"_2861":58896,"_25124":58881,"_17549":99313,"_5":17444,"_23791":99276,"_2388":99314},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2861":58897,"_25124":58881,"_17549":99316,"_5":17444,"_23791":99276,"_2388":99317},[],"Credencial ausente o certificado no válido",{"_2861":58898,"_25124":58881,"_17549":99319,"_5":17444,"_23791":99276,"_2388":99320},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2861":58899,"_25124":58881,"_17549":99322,"_5":17444,"_23791":99276,"_2388":99323},[],"Webhook deniega, expira o responde sin autorización",{"_2861":58900,"_25124":58881,"_17549":99325,"_5":17444,"_23791":99276,"_2388":99326},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2861":58901,"_25124":58881,"_17549":99328,"_5":17444,"_23791":99276,"_2388":44379},[],{"_2861":58902,"_25124":58881,"_17549":99330,"_5":17444,"_23791":99276,"_2388":99331},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2861":58903,"_25124":58881,"_17549":99333,"_5":17444,"_23791":99276,"_2388":44385},[],{"_2861":58904,"_25124":58881,"_17549":99335,"_5":17444,"_23791":99276,"_2388":99336},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2861":58905,"_25124":58881,"_17549":99338,"_5":17444,"_23791":99276,"_2388":44391},[],{"_2861":58906,"_25124":58881,"_17549":99340,"_5":17444,"_23791":99276,"_2388":99341},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2861":58907,"_25124":58881,"_17549":99343,"_5":17444,"_23791":99276,"_2388":44397},[],{"_2861":58908,"_25124":58881,"_17549":99345,"_5":17444,"_23791":99276,"_2388":99346},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_2861":58909,"_25124":58881,"_17549":99348,"_5":17444,"_23791":99276,"_2388":44403},[],{"_2861":58910,"_25124":58881,"_17549":99350,"_5":17444,"_23791":99276,"_2388":99351},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_2861":58911,"_25124":58881,"_17549":99353,"_5":17444,"_23791":99276,"_2388":99354},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2861":58912,"_25124":58881,"_17549":99356,"_5":17444,"_23791":99276,"_2388":99357},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2861":58913,"_25124":58881,"_17549":99359,"_5":17444,"_23791":99276,"_2388":99360},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2861":58914,"_25124":58881,"_17549":99362,"_5":17444,"_23791":99276,"_2388":99363},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2861":58915,"_25124":58881,"_17549":99365,"_5":17444,"_23791":99276,"_2388":44421},[],{"_2861":58916,"_25124":58881,"_17549":99367,"_5":17444,"_23791":99276,"_2388":99368},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2861":58917,"_25124":58881,"_17549":99370,"_5":17444,"_23791":99276,"_2388":44427},[],{"_2861":58918,"_25124":58881,"_17549":99372,"_5":17444,"_23791":99276,"_2388":99373},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2861":58919,"_25124":58881,"_17549":99375,"_5":17444,"_23791":99276,"_2388":99376},[],"DMS propietario distinto",{"_2861":58920,"_25124":58881,"_17549":99378,"_5":17444,"_23791":99276,"_2388":99379},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2861":58921,"_25124":58881,"_17549":99381,"_5":17444,"_23791":99276,"_2388":44439},[],{"_2861":58922,"_25124":58881,"_17549":99383,"_5":17444,"_23791":99276,"_2388":99384},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2861":58923,"_25124":58881,"_17549":99386,"_5":17444,"_23791":99276,"_2388":44445},[],{"_2861":58924,"_25124":58881,"_17549":99388,"_5":17444,"_23791":99276,"_2388":99389},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2861":58925,"_25124":58881,"_17549":99391,"_5":17444,"_23791":99276,"_2388":99392},[],"Certificado actual revocado",{"_2861":58926,"_25124":58881,"_17549":99394,"_5":17444,"_23791":99276,"_2388":99395},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2861":58927,"_25124":58881,"_17549":99397,"_5":17444,"_23791":99276,"_2388":99398},[],"Error de CA, perfil o firma",{"_2861":58928,"_25124":58881,"_17549":99400,"_5":17444,"_23791":99276,"_2388":99401},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2861":58929,"_25124":58881,"_17549":99403,"_5":17444,"_23791":99276,"_2388":99404},[],"HTTP 200 sin conexión del dispositivo",{"_2861":58930,"_25124":58881,"_17549":99406,"_5":17444,"_23791":99276,"_2388":99407},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2861":58931,"_25124":58881,"_17549":99409,"_5":17444,"_23791":99276,"_2388":99410},[],"Timeout o error después de emitir",{"_2861":58932,"_25124":58881,"_17549":99412,"_5":17444,"_23791":99276,"_2388":99413},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2861":58933,"_25124":58881,"_17549":99415,"_5":17444,"_23791":99280,"_2388":99416},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2861":58934,"_25124":58881,"_17549":99418,"_5":17444,"_23791":99280,"_2388":99419},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2861":58935,"_25124":58881,"_17549":99421,"_5":17444,"_23791":99283,"_2388":99422},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2861":58936,"_25124":58881,"_17549":99424,"_5":17444,"_23791":99283,"_2388":99425},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2861":58937,"_25124":58881,"_17549":99427,"_5":17444,"_23791":99283,"_2388":99428},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2861":58938,"_25124":58881,"_17549":99430,"_5":17444,"_23791":99283,"_2388":99431},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2861":58939,"_25124":58881,"_17549":99433,"_5":17444,"_23791":99283,"_2388":99434},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2861":58940,"_25124":58881,"_17549":99436,"_5":17444,"_23791":99283,"_2388":99437},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2861":58941,"_25124":58881,"_17549":99439,"_5":17444,"_23791":99283,"_2388":99440},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2861":58942,"_25124":58942,"_5":12314,"_2388":99442,"_25460":99443,"_17549":99444,"_23791":58942},"Distribución y actualización de confianza",[40822,97162,43140,98134,98309],[],{"_2861":58943,"_25124":58942,"_17549":99446,"_5":17444,"_23791":58942,"_2388":99447},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2861":58944,"_25124":58942,"_5":25457,"_17549":99449,"_23791":99450,"_2388":99451},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2861":58945,"_25124":58942,"_5":25457,"_17549":99453,"_23791":99454,"_2388":99455},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2861":58946,"_25124":58942,"_5":25457,"_17549":99457,"_23791":99458,"_2388":99459},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2861":58947,"_25124":58942,"_5":25457,"_17549":99461,"_23791":99462,"_2388":99463},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2861":58948,"_25124":58942,"_5":25457,"_17549":99465,"_23791":99466,"_2388":99467},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2861":58949,"_25124":58942,"_17549":99469,"_5":17444,"_23791":58942,"_2388":99470},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2861":58950,"_25124":58942,"_17549":99472,"_5":17444,"_23791":99450,"_2388":99473},[],"Relación",{"_2861":58951,"_25124":58942,"_17549":99475,"_5":17444,"_23791":99450,"_2388":99476},[],"Material que prepara el responsable",{"_2861":58952,"_25124":58942,"_17549":99478,"_5":17444,"_23791":99450,"_2388":99479},[],"Dispositivo → servidor EST",{"_2861":58953,"_25124":58942,"_17549":99481,"_5":17444,"_23791":99450,"_2388":99482},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2861":58954,"_25124":58942,"_17549":99484,"_5":17444,"_23791":99450,"_2388":99485},[],"DMS → solicitante",{"_2861":58955,"_25124":58942,"_17549":99487,"_5":17444,"_23791":99450,"_2388":99488},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2861":58956,"_25124":58942,"_17549":99490,"_5":17444,"_23791":99450,"_2388":99491},[],"Consumidor → dispositivo",{"_2861":58957,"_25124":58942,"_17549":99493,"_5":17444,"_23791":99450,"_2388":99494},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2861":58958,"_25124":58942,"_17549":99496,"_5":17444,"_23791":99450,"_2388":99497},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2861":58959,"_25124":58942,"_17549":99499,"_5":17444,"_23791":99454,"_2388":99500},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2861":58960,"_25124":58942,"_17549":99502,"_5":17444,"_23791":99454,"_2388":99503},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2861":58961,"_25124":58942,"_17549":99505,"_5":17444,"_23791":99458,"_2388":99506},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2861":58962,"_25124":58942,"_17549":99508,"_5":17444,"_23791":99458,"_2388":99509},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2861":58963,"_25124":58942,"_17549":99511,"_5":17444,"_23791":99458,"_2388":99512},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2861":58964,"_25124":58942,"_17549":99514,"_5":17444,"_23791":99458,"_2388":99515},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2861":58965,"_25124":58942,"_17549":99517,"_5":17444,"_23791":99458,"_2388":99518},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2861":58966,"_25124":58942,"_17549":99520,"_5":17444,"_23791":99458,"_2388":99521},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2861":58967,"_25124":58942,"_17549":99523,"_5":17444,"_23791":99462,"_2388":99524},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2861":58968,"_25124":58942,"_17549":99526,"_5":17444,"_23791":99462,"_2388":99527},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2861":58969,"_25124":58942,"_17549":99529,"_5":17444,"_23791":99462,"_2388":99530},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2861":58970,"_25124":58942,"_17549":99532,"_5":17444,"_23791":99466,"_2388":99533},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2861":58971,"_25124":58971,"_5":12314,"_2388":44594,"_25460":99535,"_17549":99537,"_23791":58971},[40822,97162,43140,98134,99536],"Integraciones",[],{"_2861":58972,"_25124":58971,"_17549":99539,"_5":17444,"_23791":58971,"_2388":99540},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2861":58973,"_25124":58971,"_5":25457,"_17549":99542,"_23791":99543,"_2388":99544},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2861":58974,"_25124":58971,"_5":25457,"_17549":99546,"_23791":99547,"_2388":99548},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2861":58975,"_25124":58971,"_5":25457,"_17549":99550,"_23791":99551,"_2388":99552},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2861":58976,"_25124":58971,"_5":25457,"_17549":99554,"_23791":99555,"_2388":99556},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2861":58977,"_25124":58971,"_5":25457,"_17549":99558,"_23791":99559,"_2388":99560},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2861":58978,"_25124":58971,"_5":25457,"_17549":99562,"_23791":99563,"_2388":99564},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2861":58979,"_25124":58971,"_5":25457,"_17549":99566,"_23791":99567,"_2388":44628},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2861":58980,"_25124":58971,"_5":25457,"_17549":99569,"_23791":99570,"_2388":44632},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2861":58981,"_25124":58971,"_5":25457,"_17549":99572,"_23791":99573,"_2388":99574},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2861":58982,"_25124":58971,"_5":25457,"_17549":99576,"_23791":99577,"_2388":99578},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2861":58983,"_25124":58971,"_5":25457,"_17549":99580,"_23791":99581,"_2388":99582},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2861":58984,"_25124":58971,"_5":25457,"_17549":99584,"_23791":99585,"_2388":99586},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2861":58985,"_25124":58971,"_5":25457,"_17549":99588,"_23791":99589,"_2388":99590},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2861":58986,"_25124":58971,"_5":25457,"_17549":99592,"_23791":99593,"_2388":99594},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2861":58987,"_25124":58971,"_5":25457,"_17549":99596,"_23791":99597,"_2388":99598},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2861":58988,"_25124":58971,"_5":25457,"_17549":99600,"_23791":99601,"_2388":99602},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2861":58989,"_25124":58971,"_5":25457,"_17549":99604,"_23791":99605,"_2388":99606},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2861":58990,"_25124":58971,"_5":25457,"_17549":99608,"_23791":99609,"_2388":99610},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2861":58991,"_25124":58971,"_5":25457,"_17549":99612,"_23791":99613,"_2388":99614},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2861":58992,"_25124":58971,"_5":25457,"_17549":99616,"_23791":99617,"_2388":99618},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2861":58993,"_25124":58971,"_17549":99620,"_5":17444,"_23791":58971,"_2388":99621},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2861":58994,"_25124":58971,"_17549":99623,"_5":17444,"_23791":58971,"_2388":99624},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2861":58995,"_25124":58971,"_17549":99626,"_5":17444,"_23791":58971,"_2388":99627},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2861":58996,"_25124":58971,"_17549":99629,"_5":17444,"_23791":99543,"_2388":99630},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2861":58997,"_25124":58971,"_17549":99632,"_5":17444,"_23791":99543,"_2388":99633},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2861":58998,"_25124":58971,"_17549":99635,"_5":17444,"_23791":99543,"_2388":99636},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2861":58999,"_25124":58971,"_17549":99638,"_5":17444,"_23791":99543,"_2388":99639},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2861":59000,"_25124":58971,"_17549":99641,"_5":17444,"_23791":99547,"_2388":99642},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2861":59001,"_25124":58971,"_17549":99644,"_5":17444,"_23791":99551,"_2388":99645},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2861":59002,"_25124":58971,"_17549":99647,"_5":17444,"_23791":99551,"_2388":99648},[],"Acción IAM",{"_2861":59003,"_25124":58971,"_17549":99650,"_5":17444,"_23791":99551,"_2388":96226},[],{"_2861":59004,"_25124":58971,"_17549":99652,"_5":17444,"_23791":99551,"_2388":44715},[],{"_2861":59005,"_25124":58971,"_17549":99654,"_5":17444,"_23791":99551,"_2388":99655},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2861":59006,"_25124":58971,"_17549":99657,"_5":17444,"_23791":99551,"_2388":44721},[],{"_2861":59007,"_25124":58971,"_17549":99659,"_5":17444,"_23791":99551,"_2388":99660},[],"Registrar la CA en AWS IoT",{"_2861":59008,"_25124":58971,"_17549":99662,"_5":17444,"_23791":99551,"_2388":44727},[],{"_2861":59009,"_25124":58971,"_17549":99664,"_5":17444,"_23791":99551,"_2388":99665},[],"Consultar el estado del registro de la CA",{"_2861":59010,"_25124":58971,"_17549":99667,"_5":17444,"_23791":99551,"_2388":44733},[],{"_2861":59011,"_25124":58971,"_17549":99669,"_5":17444,"_23791":99551,"_2388":99670},[],"Crear o actualizar Things en IoT Core",{"_2861":59012,"_25124":58971,"_17549":99672,"_5":17444,"_23791":99551,"_2388":44739},[],{"_2861":59013,"_25124":58971,"_17549":99674,"_5":17444,"_23791":99551,"_2388":99675},[],"Aprovisionar Things mediante plantilla",{"_2861":59014,"_25124":58971,"_17549":99677,"_5":17444,"_23791":99551,"_2388":44745},[],{"_2861":59015,"_25124":58971,"_17549":99679,"_5":17444,"_23791":99551,"_2388":99680},[],"Registrar certificados de dispositivo",{"_2861":59016,"_25124":58971,"_17549":99682,"_5":17444,"_23791":99551,"_2388":44751},[],{"_2861":59017,"_25124":58971,"_17549":99684,"_5":17444,"_23791":99551,"_2388":99685},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2861":59018,"_25124":58971,"_17549":99687,"_5":17444,"_23791":99551,"_2388":44757},[],{"_2861":59019,"_25124":58971,"_17549":99689,"_5":17444,"_23791":99551,"_2388":99690},[],"Crear y adjuntar políticas IoT",{"_2861":59020,"_25124":58971,"_17549":99692,"_5":17444,"_23791":99551,"_2388":44763},[],{"_2861":59021,"_25124":58971,"_17549":99694,"_5":17444,"_23791":99551,"_2388":99695},[],"Gestionar grupos de Things",{"_2861":59022,"_25124":58971,"_17549":99697,"_5":17444,"_23791":99551,"_2388":44769},[],{"_2861":59023,"_25124":58971,"_17549":99699,"_5":17444,"_23791":99551,"_2388":99700},[],"Crear plantillas JITP",{"_2861":59024,"_25124":58971,"_17549":99702,"_5":17444,"_23791":99551,"_2388":44775},[],{"_2861":59025,"_25124":58971,"_17549":99704,"_5":17444,"_23791":99551,"_2388":99705},[],"Leer y escribir el Device Shadow",{"_2861":59026,"_25124":58971,"_17549":99707,"_5":17444,"_23791":99551,"_2388":99708},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2861":59027,"_25124":58971,"_17549":99710,"_5":17444,"_23791":99555,"_2388":99711},[],"Parámetro",{"_2861":59028,"_25124":58971,"_17549":99713,"_5":17444,"_23791":99555,"_2388":99714},[],"Tipo",{"_2861":59029,"_25124":58971,"_17549":99716,"_5":17444,"_23791":99555,"_2388":99717},[],"Requerido",{"_2861":59030,"_25124":58971,"_17549":99719,"_5":17444,"_23791":99555,"_2388":99720},[],"Descripción",{"_2861":59031,"_25124":58971,"_17549":99722,"_5":17444,"_23791":99555,"_2388":44796},[],{"_2861":59032,"_25124":58971,"_17549":99724,"_5":17444,"_23791":99555,"_2388":20940},[],{"_2861":59033,"_25124":58971,"_17549":99726,"_5":17444,"_23791":99555,"_2388":99727},[],"Sí",{"_2861":59034,"_25124":58971,"_17549":99729,"_5":17444,"_23791":99555,"_2388":99730},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2861":59035,"_25124":58971,"_17549":99732,"_5":17444,"_23791":99555,"_2388":44807},[],{"_2861":59036,"_25124":58971,"_17549":99734,"_5":17444,"_23791":99555,"_2388":20940},[],{"_2861":59037,"_25124":58971,"_17549":99736,"_5":17444,"_23791":99555,"_2388":99727},[],{"_2861":59038,"_25124":58971,"_17549":99738,"_5":17444,"_23791":99555,"_2388":99739},[],"Región AWS donde opera el conector.",{"_2861":59039,"_25124":58971,"_17549":99741,"_5":17444,"_23791":99555,"_2388":44817},[],{"_2861":59040,"_25124":58971,"_17549":99743,"_5":17444,"_23791":99555,"_2388":20940},[],{"_2861":59041,"_25124":58971,"_17549":99745,"_5":17444,"_23791":99555,"_2388":99727},[],{"_2861":59042,"_25124":58971,"_17549":99747,"_5":17444,"_23791":99555,"_2388":99748},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2861":59043,"_25124":58971,"_17549":99750,"_5":17444,"_23791":99555,"_2388":44827},[],{"_2861":59044,"_25124":58971,"_17549":99752,"_5":17444,"_23791":99555,"_2388":20940},[],{"_2861":59045,"_25124":58971,"_17549":99754,"_5":17444,"_23791":99555,"_2388":99755},[],"Solo con `auth_method=static`",{"_2861":59046,"_25124":58971,"_17549":99757,"_5":17444,"_23791":99555,"_2388":99758},[],"Clave de acceso AWS.",{"_2861":59047,"_25124":58971,"_17549":99760,"_5":17444,"_23791":99555,"_2388":44838},[],{"_2861":59048,"_25124":58971,"_17549":99762,"_5":17444,"_23791":99555,"_2388":20940},[],{"_2861":59049,"_25124":58971,"_17549":99764,"_5":17444,"_23791":99555,"_2388":99755},[],{"_2861":59050,"_25124":58971,"_17549":99766,"_5":17444,"_23791":99555,"_2388":99767},[],"Clave secreta AWS.",{"_2861":59051,"_25124":58971,"_17549":99769,"_5":17444,"_23791":99555,"_2388":44848},[],{"_2861":59052,"_25124":58971,"_17549":99771,"_5":17444,"_23791":99555,"_2388":20940},[],{"_2861":59053,"_25124":58971,"_17549":99773,"_5":17444,"_23791":99555,"_2388":44853},[],{"_2861":59054,"_25124":58971,"_17549":99775,"_5":17444,"_23791":99555,"_2388":99776},[],"Token de sesión (con `auth_method=static`).",{"_2861":59055,"_25124":58971,"_17549":99778,"_5":17444,"_23791":99555,"_2388":44859},[],{"_2861":59056,"_25124":58971,"_17549":99780,"_5":17444,"_23791":99555,"_2388":20940},[],{"_2861":59057,"_25124":58971,"_17549":99782,"_5":17444,"_23791":99555,"_2388":99783},[],"Solo con `auth_method=role`",{"_2861":59058,"_25124":58971,"_17549":99785,"_5":17444,"_23791":99555,"_2388":99786},[],"ARN del rol a asumir.",{"_2861":59059,"_25124":58971,"_17549":99788,"_5":17444,"_23791":99555,"_2388":44870},[],{"_2861":59060,"_25124":58971,"_17549":99790,"_5":17444,"_23791":99555,"_2388":20940},[],{"_2861":59061,"_25124":58971,"_17549":99792,"_5":17444,"_23791":99555,"_2388":44853},[],{"_2861":59062,"_25124":58971,"_17549":99794,"_5":17444,"_23791":99555,"_2388":99795},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2861":59063,"_25124":58971,"_17549":99797,"_5":17444,"_23791":99555,"_2388":44880},[],{"_2861":59064,"_25124":58971,"_17549":99799,"_5":17444,"_23791":99555,"_2388":14748},[],{"_2861":59065,"_25124":58971,"_17549":99801,"_5":17444,"_23791":99555,"_2388":99727},[],{"_2861":59066,"_25124":58971,"_17549":99803,"_5":17444,"_23791":99555,"_2388":99804},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2861":59067,"_25124":58971,"_17549":99806,"_5":17444,"_23791":99555,"_2388":44890},[],{"_2861":59068,"_25124":58971,"_17549":99808,"_5":17444,"_23791":99555,"_2388":20940},[],{"_2861":59069,"_25124":58971,"_17549":99810,"_5":17444,"_23791":99555,"_2388":99727},[],{"_2861":59070,"_25124":58971,"_17549":99812,"_5":17444,"_23791":99555,"_2388":99813},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2861":59071,"_25124":58971,"_17549":99815,"_5":17444,"_23791":99555,"_2388":44900},[],{"_2861":59072,"_25124":58971,"_17549":99817,"_5":17444,"_23791":99555,"_2388":20940},[],{"_2861":59073,"_25124":58971,"_17549":99819,"_5":17444,"_23791":99555,"_2388":99727},[],{"_2861":59074,"_25124":58971,"_17549":99821,"_5":17444,"_23791":99555,"_2388":99822},[],"URL HTTP del Device Manager de Lamassu.",{"_2861":59075,"_25124":58971,"_17549":99824,"_5":17444,"_23791":99555,"_2388":44910},[],{"_2861":59076,"_25124":58971,"_17549":99826,"_5":17444,"_23791":99555,"_2388":20940},[],{"_2861":59077,"_25124":58971,"_17549":99828,"_5":17444,"_23791":99555,"_2388":99727},[],{"_2861":59078,"_25124":58971,"_17549":99830,"_5":17444,"_23791":99555,"_2388":99831},[],"URL HTTP del servicio de CA de Lamassu.",{"_2861":59079,"_25124":58971,"_17549":99833,"_5":17444,"_23791":99559,"_2388":99834},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2861":59080,"_25124":58971,"_17549":99836,"_5":17444,"_23791":99563,"_2388":99837},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2861":59081,"_25124":58971,"_17549":99839,"_5":17444,"_23791":99563,"_2388":99840},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2861":59082,"_25124":58971,"_17549":99842,"_5":17444,"_23791":99567,"_2388":99843},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2861":59083,"_25124":58971,"_17549":99845,"_5":17444,"_23791":99567,"_2388":99846},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2861":59084,"_25124":58971,"_17549":99848,"_5":17444,"_23791":99567,"_2388":99849},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2861":59085,"_25124":58971,"_17549":99851,"_5":17444,"_23791":99567,"_2388":99852},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2861":59086,"_25124":58971,"_17549":99854,"_5":17444,"_23791":99567,"_2388":99855},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2861":59087,"_25124":58971,"_17549":99857,"_5":17444,"_23791":99567,"_2388":99858},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2861":59088,"_25124":58971,"_17549":99860,"_5":17444,"_23791":99570,"_2388":99861},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2861":59089,"_25124":58971,"_17549":99863,"_5":17444,"_23791":99573,"_2388":99864},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2861":59090,"_25124":58971,"_17549":99866,"_5":17444,"_23791":99573,"_2388":99867},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2861":59091,"_25124":58971,"_17549":99869,"_5":17444,"_23791":99577,"_2388":99870},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2861":59092,"_25124":58971,"_17549":99872,"_5":17444,"_23791":99581,"_2388":99873},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2861":59093,"_25124":58971,"_17549":99875,"_5":17444,"_23791":99581,"_2388":99876},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2861":59094,"_25124":58971,"_17549":99878,"_5":17444,"_23791":99581,"_2388":99879},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2861":59095,"_25124":58971,"_17549":99881,"_5":17444,"_23791":99581,"_2388":99882},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2861":59096,"_25124":58971,"_17549":99884,"_5":17444,"_23791":99581,"_2388":99885},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2861":59097,"_25124":58971,"_17549":99887,"_5":17444,"_23791":99581,"_2388":99888},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2861":59098,"_25124":58971,"_17549":99890,"_5":17444,"_23791":99585,"_2388":99891},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2861":59099,"_25124":58971,"_17549":99893,"_5":17444,"_23791":99585,"_2388":99894},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2861":59100,"_25124":58971,"_17549":99896,"_5":17444,"_23791":99585,"_2388":99897},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2861":59101,"_25124":58971,"_17549":99899,"_5":17444,"_23791":99589,"_2388":99900},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2861":59102,"_25124":58971,"_17549":99902,"_5":17444,"_23791":99589,"_2388":99903},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2861":59103,"_25124":58971,"_17549":99905,"_5":17444,"_23791":99589,"_2388":99906},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2861":59104,"_25124":58971,"_17549":99908,"_5":17444,"_23791":99593,"_2388":99909},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2861":59105,"_25124":58971,"_17549":99911,"_5":17444,"_23791":99593,"_2388":99912},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2861":59106,"_25124":58971,"_17549":99914,"_5":17444,"_23791":99593,"_2388":99915},[],"Para que el flujo JITP funcione correctamente:",{"_2861":59107,"_25124":58971,"_17549":99917,"_5":17444,"_23791":99593,"_2388":99918},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2861":59108,"_25124":58971,"_17549":99920,"_5":17444,"_23791":99593,"_2388":99921},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2861":59109,"_25124":58971,"_17549":99923,"_5":17444,"_23791":99593,"_2388":99924},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2861":59110,"_25124":58971,"_17549":99926,"_5":17444,"_23791":99593,"_2388":99927},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2861":59111,"_25124":58971,"_17549":99929,"_5":17444,"_23791":99597,"_2388":99930},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2861":59112,"_25124":58971,"_17549":99932,"_5":17444,"_23791":99597,"_2388":99933},[],"Estado en Lamassu",{"_2861":59113,"_25124":58971,"_17549":99935,"_5":17444,"_23791":99597,"_2388":99936},[],"Razón de revocación",{"_2861":59114,"_25124":58971,"_17549":99938,"_5":17444,"_23791":99597,"_2388":99939},[],"Estado en AWS IoT Core",{"_2861":59115,"_25124":58971,"_17549":99941,"_5":17444,"_23791":99597,"_2388":45031},[],{"_2861":59116,"_25124":58971,"_17549":99943,"_5":17444,"_23791":99597,"_2388":99944},[],"Ninguna",{"_2861":59117,"_25124":58971,"_17549":99946,"_5":17444,"_23791":99597,"_2388":45037},[],{"_2861":59118,"_25124":58971,"_17549":99948,"_5":17444,"_23791":99597,"_2388":45040},[],{"_2861":59119,"_25124":58971,"_17549":99950,"_5":17444,"_23791":99597,"_2388":45043},[],{"_2861":59120,"_25124":58971,"_17549":99952,"_5":17444,"_23791":99597,"_2388":45046},[],{"_2861":59121,"_25124":58971,"_17549":99954,"_5":17444,"_23791":99597,"_2388":45040},[],{"_2861":59122,"_25124":58971,"_17549":99956,"_5":17444,"_23791":99597,"_2388":99957},[],"Cualquier otra razón",{"_2861":59123,"_25124":58971,"_17549":99959,"_5":17444,"_23791":99597,"_2388":45054},[],{"_2861":59124,"_25124":58971,"_17549":99961,"_5":17444,"_23791":99597,"_2388":99962},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2861":59125,"_25124":58971,"_17549":99964,"_5":17444,"_23791":99601,"_2388":99965},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2861":59126,"_25124":58971,"_17549":99967,"_5":17444,"_23791":99601,"_2388":99968},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2861":59127,"_25124":58971,"_17549":99970,"_5":17444,"_23791":99601,"_2388":99971},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2861":59128,"_25124":58971,"_17549":99973,"_5":17444,"_23791":99605,"_2388":99974},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2861":59129,"_25124":58971,"_17549":99976,"_5":17444,"_23791":99605,"_2388":99977},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2861":59130,"_25124":58971,"_17549":99979,"_5":17444,"_23791":99609,"_2388":99980},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2861":59131,"_25124":58971,"_17549":99982,"_5":17444,"_23791":99609,"_2388":99983},[],"Existen dos tipos de acciones:",{"_2861":59132,"_25124":58971,"_17549":99985,"_5":17444,"_23791":99609,"_2388":99986},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2861":59133,"_25124":58971,"_17549":99988,"_5":17444,"_23791":99609,"_2388":99989},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2861":59134,"_25124":58971,"_17549":99991,"_5":17444,"_23791":99609,"_2388":99992},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2861":59135,"_25124":58971,"_17549":99994,"_5":17444,"_23791":99613,"_2388":99995},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2861":59136,"_25124":58971,"_17549":99997,"_5":17444,"_23791":99613,"_2388":99998},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2861":59137,"_25124":58971,"_17549":100000,"_5":17444,"_23791":99613,"_2388":100001},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2861":59138,"_25124":58971,"_17549":100003,"_5":17444,"_23791":99617,"_2388":100004},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2861":59139,"_25124":58971,"_17549":100006,"_5":17444,"_23791":99617,"_2388":100007},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2861":59140,"_25124":58971,"_17549":100009,"_5":17444,"_23791":99617,"_2388":100010},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2861":59141,"_25124":58971,"_17549":100012,"_5":17444,"_23791":99617,"_2388":100013},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2861":59142,"_25124":58971,"_17549":100015,"_5":17444,"_23791":99617,"_2388":100016},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2861":59143,"_25124":58971,"_17549":100018,"_5":17444,"_23791":99617,"_2388":100019},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2861":59144,"_25124":58971,"_17549":100021,"_5":17444,"_23791":99617,"_2388":100022},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2861":59145,"_25124":58971,"_17549":100024,"_5":17444,"_23791":99617,"_2388":100025},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2861":59146,"_25124":58971,"_17549":100027,"_5":17444,"_23791":99617,"_2388":100028},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2861":59147,"_25124":58971,"_17549":100030,"_5":17444,"_23791":99617,"_2388":100031},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2861":59148,"_25124":58971,"_17549":100033,"_5":17444,"_23791":99617,"_2388":100034},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2861":59149,"_25124":58971,"_17549":100036,"_5":17444,"_23791":99617,"_2388":100037},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2861":59150,"_25124":58971,"_17549":100039,"_5":17444,"_23791":99617,"_2388":100040},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2861":59151,"_25124":58971,"_17549":100042,"_5":17444,"_23791":99617,"_2388":100043},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2861":59152,"_25124":58971,"_17549":100045,"_5":17444,"_23791":99617,"_2388":100046},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2861":59153,"_25124":58971,"_17549":100048,"_5":17444,"_23791":99617,"_2388":100049},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2861":59154,"_25124":58971,"_17549":100051,"_5":17444,"_23791":99617,"_2388":100052},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2861":59155,"_25124":58971,"_17549":100054,"_5":17444,"_23791":99617,"_2388":100055},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2861":59156,"_25124":58971,"_17549":100057,"_5":17444,"_23791":99617,"_2388":100058},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2861":59157,"_25124":58971,"_17549":100060,"_5":17444,"_23791":99617,"_2388":100061},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2861":59158,"_25124":58971,"_17549":100063,"_5":17444,"_23791":99617,"_2388":100064},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2861":59159,"_25124":59159,"_5":12314,"_2388":43140,"_25460":100066,"_17549":100067,"_23791":59159},[40822,97162,43140],[],{"_2861":59160,"_25124":59159,"_17549":100069,"_5":17444,"_23791":59159,"_2388":100070},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2861":59161,"_25124":59159,"_5":25457,"_17549":100072,"_23791":100073,"_2388":100074},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2861":59162,"_25124":59159,"_5":25457,"_17549":100076,"_23791":100077,"_2388":98134},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2861":59163,"_25124":59159,"_5":25457,"_17549":100079,"_23791":100080,"_2388":98309},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2861":59164,"_25124":59159,"_5":25457,"_17549":100082,"_23791":100083,"_2388":99536},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/overview#integraciones",{"_2861":59165,"_25124":59159,"_5":25457,"_17549":100085,"_23791":100086,"_2388":100087},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2861":59166,"_25124":59159,"_17549":100089,"_5":17444,"_23791":59159,"_2388":100090},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2861":59167,"_25124":59159,"_17549":100092,"_5":17444,"_23791":100073,"_2388":100093},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2861":59168,"_25124":59159,"_17549":100095,"_5":17444,"_23791":100073,"_2388":100096},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2861":59169,"_25124":59159,"_17549":100098,"_5":17444,"_23791":100077,"_2388":100099},[],"Recurso",{"_2861":59170,"_25124":59159,"_17549":100101,"_5":17444,"_23791":100077,"_2388":100102},[],"Qué representa",{"_2861":59171,"_25124":59159,"_17549":100104,"_5":17444,"_23791":100077,"_2388":100105},[],"**Dispositivo**",{"_2861":59172,"_25124":59159,"_17549":100107,"_5":17444,"_23791":100077,"_2388":100108},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2861":59173,"_25124":59159,"_17549":100110,"_5":17444,"_23791":100077,"_2388":100111},[],"**Identidad**",{"_2861":59174,"_25124":59159,"_17549":100113,"_5":17444,"_23791":100077,"_2388":100114},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2861":59175,"_25124":59159,"_17549":100116,"_5":17444,"_23791":100077,"_2388":45212},[],{"_2861":59176,"_25124":59159,"_17549":100118,"_5":17444,"_23791":100077,"_2388":100119},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2861":59177,"_25124":59159,"_17549":100121,"_5":17444,"_23791":100077,"_2388":100122},[],"**Flota**",{"_2861":59178,"_25124":59159,"_17549":100124,"_5":17444,"_23791":100077,"_2388":100125},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2861":59179,"_25124":59159,"_17549":100127,"_5":17444,"_23791":100077,"_2388":100128},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2861":59180,"_25124":59159,"_17549":100130,"_5":17444,"_23791":100077,"_2388":100131},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2861":59181,"_25124":59159,"_17549":100133,"_5":17444,"_23791":100080,"_2388":100134},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2861":59182,"_25124":59159,"_17549":100136,"_5":17444,"_23791":100080,"_2388":100137},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2861":59183,"_25124":59159,"_17549":100139,"_5":17444,"_23791":100080,"_2388":100140},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2861":59184,"_25124":59159,"_17549":100142,"_5":17444,"_23791":100080,"_2388":100143},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2861":59185,"_25124":59159,"_17549":100145,"_5":17444,"_23791":100080,"_2388":100146},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2861":59186,"_25124":59159,"_17549":100148,"_5":17444,"_23791":100080,"_2388":100149},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2861":59187,"_25124":59159,"_17549":100151,"_5":17444,"_23791":100080,"_2388":100152},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2861":59188,"_25124":59159,"_17549":100154,"_5":17444,"_23791":100080,"_2388":100155},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2861":59189,"_25124":59159,"_17549":100157,"_5":17444,"_23791":100083,"_2388":100158},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2861":59190,"_25124":59159,"_17549":100160,"_5":17444,"_23791":100083,"_2388":100161},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2861":59191,"_25124":59159,"_17549":100163,"_5":17444,"_23791":100086,"_2388":100164},[],"Participante",{"_2861":59192,"_25124":59159,"_17549":100166,"_5":17444,"_23791":100086,"_2388":100167},[],"Responsabilidad",{"_2861":59193,"_25124":59159,"_17549":100169,"_5":17444,"_23791":100086,"_2388":100170},[],"Administrador PKI",{"_2861":59194,"_25124":59159,"_17549":100172,"_5":17444,"_23791":100086,"_2388":100173},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2861":59195,"_25124":59159,"_17549":100175,"_5":17444,"_23791":100086,"_2388":100176},[],"Administrador del aprovisionamiento",{"_2861":59196,"_25124":59159,"_17549":100178,"_5":17444,"_23791":100086,"_2388":100179},[],"DMS, admisión, autenticación por operación e inventario.",{"_2861":59197,"_25124":59159,"_17549":100181,"_5":17444,"_23791":100086,"_2388":100182},[],"Integrador del dispositivo",{"_2861":59198,"_25124":59159,"_17549":100184,"_5":17444,"_23791":100086,"_2388":100185},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2861":59199,"_25124":59159,"_17549":100187,"_5":17444,"_23791":100086,"_2388":100188},[],"Integrador del consumidor",{"_2861":59200,"_25124":59159,"_17549":100190,"_5":17444,"_23791":100086,"_2388":100191},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2861":59201,"_25124":59159,"_17549":100193,"_5":17444,"_23791":100086,"_2388":100194},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2861":59202,"_25124":59202,"_5":12314,"_2388":100196,"_25460":100197,"_17549":100199,"_23791":59202},"Enrola y conecta tu primer dispositivo",[40822,97162,43140,100198],"Primeros pasos",[],{"_2861":59203,"_25124":59202,"_17549":100201,"_5":17444,"_23791":59202,"_2388":100202},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2861":59204,"_25124":59202,"_5":25457,"_17549":100204,"_23791":100205,"_2388":95863},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2861":59205,"_25124":59202,"_5":25457,"_17549":100207,"_23791":100208,"_2388":100209},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2861":59206,"_25124":59202,"_5":25457,"_17549":100211,"_23791":100212,"_2388":100213},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2861":59207,"_25124":59202,"_5":25457,"_17549":100215,"_23791":100216,"_2388":100217},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2861":59208,"_25124":59202,"_5":25457,"_17549":100219,"_23791":100220,"_2388":100221},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2861":59209,"_25124":59202,"_5":25457,"_17549":100223,"_23791":100224,"_2388":100225},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2861":59210,"_25124":59202,"_5":25457,"_17549":100227,"_23791":100228,"_2388":100229},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2861":59211,"_25124":59202,"_5":25457,"_17549":100231,"_23791":100232,"_2388":100233},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2861":59212,"_25124":59202,"_17549":100235,"_5":17444,"_23791":59202,"_2388":100236},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2861":59213,"_25124":59202,"_17549":100238,"_5":17444,"_23791":100205,"_2388":100239},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2861":59214,"_25124":59202,"_17549":100241,"_5":17444,"_23791":100205,"_2388":100242},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2861":59215,"_25124":59202,"_17549":100244,"_5":17444,"_23791":100205,"_2388":100245},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2861":59216,"_25124":59202,"_17549":100247,"_5":17444,"_23791":100205,"_2388":100248},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2861":59217,"_25124":59202,"_17549":100250,"_5":17444,"_23791":100205,"_2388":100251},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2861":59218,"_25124":59202,"_17549":100253,"_5":17444,"_23791":100208,"_2388":100254},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2861":59219,"_25124":59202,"_17549":100256,"_5":17444,"_23791":100208,"_2388":100257},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2861":59220,"_25124":59202,"_17549":100259,"_5":17444,"_23791":100212,"_2388":100260},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2861":59221,"_25124":59202,"_17549":100262,"_5":17444,"_23791":100212,"_2388":100263},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2861":59222,"_25124":59202,"_17549":100265,"_5":17444,"_23791":100212,"_2388":100266},[],"Ajuste",{"_2861":59223,"_25124":59202,"_17549":100268,"_5":17444,"_23791":100212,"_2388":100269},[],"Valor de evaluación",{"_2861":59224,"_25124":59202,"_17549":100271,"_5":17444,"_23791":100212,"_2388":45368},[],{"_2861":59225,"_25124":59202,"_17549":100273,"_5":17444,"_23791":100212,"_2388":100274},[],"Raíz emisora de `device-root.pem`.",{"_2861":59226,"_25124":59202,"_17549":100276,"_5":17444,"_23791":100212,"_2388":98437},[],{"_2861":59227,"_25124":59202,"_17549":100278,"_5":17444,"_23791":100212,"_2388":100279},[],"Perfil final de 1 hora que acabas de preparar.",{"_2861":59228,"_25124":59202,"_17549":100281,"_5":17444,"_23791":100212,"_2388":45379},[],{"_2861":59229,"_25124":59202,"_17549":100283,"_5":17444,"_23791":100212,"_2388":45382},[],{"_2861":59230,"_25124":59202,"_17549":100285,"_5":17444,"_23791":100212,"_2388":45385},[],{"_2861":59231,"_25124":59202,"_17549":100287,"_5":17444,"_23791":100212,"_2388":100288},[],"Habilitado.",{"_2861":59232,"_25124":59202,"_17549":100290,"_5":17444,"_23791":100212,"_2388":45391},[],{"_2861":59233,"_25124":59202,"_17549":100292,"_5":17444,"_23791":100212,"_2388":100293},[],"Deshabilitado; el ID debe ser nuevo.",{"_2861":59234,"_25124":59202,"_17549":100295,"_5":17444,"_23791":100212,"_2388":100296},[],"Autenticación inicial",{"_2861":59235,"_25124":59202,"_17549":100298,"_5":17444,"_23791":100212,"_2388":100299},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2861":59236,"_25124":59202,"_17549":100301,"_5":17444,"_23791":100212,"_2388":100302},[],"Autenticación de renovación",{"_2861":59237,"_25124":59202,"_17549":100304,"_5":17444,"_23791":100212,"_2388":100305},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2861":59238,"_25124":59202,"_17549":100307,"_5":17444,"_23791":100212,"_2388":45409},[],{"_2861":59239,"_25124":59202,"_17549":100309,"_5":17444,"_23791":100212,"_2388":100310},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2861":59240,"_25124":59202,"_17549":100312,"_5":17444,"_23791":100212,"_2388":45415},[],{"_2861":59241,"_25124":59202,"_17549":100314,"_5":17444,"_23791":100212,"_2388":100315},[],"1 hora.",{"_2861":59242,"_25124":59202,"_17549":100317,"_5":17444,"_23791":100212,"_2388":45421},[],{"_2861":59243,"_25124":59202,"_17549":100319,"_5":17444,"_23791":100212,"_2388":100320},[],"30 minutos / 10 minutos.",{"_2861":59244,"_25124":59202,"_17549":100322,"_5":17444,"_23791":100212,"_2388":45427},[],{"_2861":59245,"_25124":59202,"_17549":100324,"_5":17444,"_23791":100212,"_2388":100325},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2861":59246,"_25124":59202,"_17549":100327,"_5":17444,"_23791":100212,"_2388":43459},[],{"_2861":59247,"_25124":59202,"_17549":100329,"_5":17444,"_23791":100212,"_2388":100330},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2861":59248,"_25124":59202,"_17549":100332,"_5":17444,"_23791":100212,"_2388":45438},[],{"_2861":59249,"_25124":59202,"_17549":100334,"_5":17444,"_23791":100212,"_2388":100335},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2861":59250,"_25124":59202,"_17549":100337,"_5":17444,"_23791":100212,"_2388":100338},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2861":59251,"_25124":59202,"_17549":100340,"_5":17444,"_23791":100216,"_2388":100341},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2861":59252,"_25124":59202,"_17549":100343,"_5":17444,"_23791":100216,"_2388":100344},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2861":59253,"_25124":59202,"_17549":100346,"_5":17444,"_23791":100220,"_2388":100347},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2861":59254,"_25124":59202,"_17549":100349,"_5":17444,"_23791":100220,"_2388":100350},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2861":59255,"_25124":59202,"_17549":100352,"_5":17444,"_23791":100220,"_2388":100353},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2861":59256,"_25124":59202,"_17549":100355,"_5":17444,"_23791":100224,"_2388":100356},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2861":59257,"_25124":59202,"_17549":100358,"_5":17444,"_23791":100224,"_2388":100359},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2861":59258,"_25124":59202,"_17549":100361,"_5":17444,"_23791":100228,"_2388":100362},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2861":59259,"_25124":59202,"_17549":100364,"_5":17444,"_23791":100228,"_2388":100365},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2861":59260,"_25124":59202,"_17549":100367,"_5":17444,"_23791":100228,"_2388":100368},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2861":59261,"_25124":59202,"_17549":100370,"_5":17444,"_23791":100228,"_2388":100371},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2861":59262,"_25124":59202,"_17549":100373,"_5":17444,"_23791":100228,"_2388":100374},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2861":59263,"_25124":59202,"_17549":100376,"_5":17444,"_23791":100232,"_2388":100377},[],"Comprobación",{"_2861":59264,"_25124":59202,"_17549":100379,"_5":17444,"_23791":100232,"_2388":100380},[],"Resultado esperado",{"_2861":59265,"_25124":59202,"_17549":100382,"_5":17444,"_23791":100232,"_2388":100383},[],"Registro",{"_2861":59266,"_25124":59202,"_17549":100385,"_5":17444,"_23791":100232,"_2388":100386},[],"ID creado automáticamente y DMS correcto.",{"_2861":59267,"_25124":59202,"_17549":100388,"_5":17444,"_23791":100232,"_2388":100389},[],"Certificado",{"_2861":59268,"_25124":59202,"_17549":100391,"_5":17444,"_23791":100232,"_2388":100392},[],"CN, perfil, serie y clave verificados.",{"_2861":59269,"_25124":59202,"_17549":100394,"_5":17444,"_23791":100232,"_2388":100395},[],"Inventario",{"_2861":59270,"_25124":59202,"_17549":100397,"_5":17444,"_23791":100232,"_2388":100398},[],"Serie recibida visible como identidad actual y en el historial.",{"_2861":59271,"_25124":59202,"_17549":100400,"_5":17444,"_23791":100232,"_2388":100401},[],"Consumidor",{"_2861":59272,"_25124":59202,"_17549":100403,"_5":17444,"_23791":100232,"_2388":100404},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2861":59273,"_25124":59202,"_17549":100406,"_5":17444,"_23791":100232,"_2388":100407},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2861":59274,"_25124":59202,"_17549":100409,"_5":17444,"_23791":100232,"_2388":100410},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2861":59275,"_25124":59275,"_5":12314,"_2388":98151,"_25460":100412,"_17549":100413,"_23791":59275},[40822,97162,43140,100198],[],{"_2861":59276,"_25124":59275,"_17549":100415,"_5":17444,"_23791":59275,"_2388":100416},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2861":59277,"_25124":59275,"_5":25457,"_17549":100418,"_23791":100419,"_2388":95863},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2861":59278,"_25124":59275,"_5":25457,"_17549":100421,"_23791":100422,"_2388":100423},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2861":59279,"_25124":59275,"_5":25457,"_17549":100425,"_23791":100426,"_2388":100427},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2861":59280,"_25124":59275,"_5":25457,"_17549":100429,"_23791":100430,"_2388":100431},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2861":59281,"_25124":59275,"_5":25457,"_17549":100433,"_23791":100434,"_2388":100435},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2861":59282,"_25124":59275,"_5":25457,"_17549":100437,"_23791":100438,"_2388":100439},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2861":59283,"_25124":59275,"_5":25457,"_17549":100441,"_23791":100442,"_2388":100380},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2861":59284,"_25124":59275,"_5":25457,"_17549":100444,"_23791":100445,"_2388":100446},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2861":59285,"_25124":59275,"_5":25457,"_17549":100448,"_23791":100449,"_2388":100450},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2861":59286,"_25124":59275,"_17549":100452,"_5":17444,"_23791":59275,"_2388":100453},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2861":59287,"_25124":59275,"_17549":100455,"_5":17444,"_23791":59275,"_2388":100456},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2861":59288,"_25124":59275,"_17549":100458,"_5":17444,"_23791":100419,"_2388":100459},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2861":59289,"_25124":59275,"_17549":100461,"_5":17444,"_23791":100419,"_2388":100462},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2861":59290,"_25124":59275,"_17549":100464,"_5":17444,"_23791":100419,"_2388":100465},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2861":59291,"_25124":59275,"_17549":100467,"_5":17444,"_23791":100419,"_2388":100468},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2861":59292,"_25124":59275,"_17549":100470,"_5":17444,"_23791":100422,"_2388":100471},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2861":59293,"_25124":59275,"_17549":100473,"_5":17444,"_23791":100422,"_2388":100474},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2861":59294,"_25124":59275,"_17549":100476,"_5":17444,"_23791":100422,"_2388":100477},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2861":59295,"_25124":59275,"_17549":100479,"_5":17444,"_23791":100422,"_2388":100480},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2861":59296,"_25124":59275,"_17549":100482,"_5":17444,"_23791":100422,"_2388":100483},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2861":59297,"_25124":59275,"_17549":100485,"_5":17444,"_23791":100422,"_2388":100486},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2861":59298,"_25124":59275,"_17549":100488,"_5":17444,"_23791":100422,"_2388":100489},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2861":59299,"_25124":59275,"_17549":100491,"_5":17444,"_23791":100422,"_2388":100492},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2861":59300,"_25124":59275,"_17549":100494,"_5":17444,"_23791":100426,"_2388":100495},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2861":59301,"_25124":59275,"_17549":100497,"_5":17444,"_23791":100426,"_2388":45604},[],{"_2861":59302,"_25124":59275,"_17549":100499,"_5":17444,"_23791":100426,"_2388":100500},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2861":59303,"_25124":59275,"_17549":100502,"_5":17444,"_23791":100426,"_2388":100503},[],"**Icon** y **Tags**: clasificación opcional.",{"_2861":59304,"_25124":59275,"_17549":100505,"_5":17444,"_23791":100426,"_2388":100506},[],"Confirma el registro.",{"_2861":59305,"_25124":59275,"_17549":100508,"_5":17444,"_23791":100430,"_2388":100509},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2861":59306,"_25124":59275,"_17549":100511,"_5":17444,"_23791":100430,"_2388":100512},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2861":59307,"_25124":59275,"_17549":100514,"_5":17444,"_23791":100434,"_2388":100515},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2861":59308,"_25124":59275,"_17549":100517,"_5":17444,"_23791":100434,"_2388":100518},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2861":59309,"_25124":59275,"_17549":100520,"_5":17444,"_23791":100438,"_2388":100521},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2861":59310,"_25124":59275,"_17549":100523,"_5":17444,"_23791":100438,"_2388":100524},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2861":59311,"_25124":59275,"_17549":100526,"_5":17444,"_23791":100442,"_2388":100377},[],{"_2861":59312,"_25124":59275,"_17549":100528,"_5":17444,"_23791":100442,"_2388":100529},[],"Resultado",{"_2861":59313,"_25124":59275,"_17549":100531,"_5":17444,"_23791":100442,"_2388":100532},[],"Dispositivo",{"_2861":59314,"_25124":59275,"_17549":100534,"_5":17444,"_23791":100442,"_2388":100535},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2861":59315,"_25124":59275,"_17549":100537,"_5":17444,"_23791":100442,"_2388":100538},[],"Identidad actual",{"_2861":59316,"_25124":59275,"_17549":100540,"_5":17444,"_23791":100442,"_2388":100541},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2861":59317,"_25124":59275,"_17549":100543,"_5":17444,"_23791":100442,"_2388":100544},[],"Historial",{"_2861":59318,"_25124":59275,"_17549":100546,"_5":17444,"_23791":100442,"_2388":100547},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2861":59319,"_25124":59275,"_17549":100549,"_5":17444,"_23791":100442,"_2388":100550},[],"Clave y certificado",{"_2861":59320,"_25124":59275,"_17549":100552,"_5":17444,"_23791":100442,"_2388":100553},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2861":59321,"_25124":59275,"_17549":100555,"_5":17444,"_23791":100445,"_2388":100556},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2861":59322,"_25124":59275,"_17549":100558,"_5":17444,"_23791":100445,"_2388":100559},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2861":59323,"_25124":59275,"_17549":100561,"_5":17444,"_23791":100445,"_2388":100562},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2861":59324,"_25124":59275,"_17549":100564,"_5":17444,"_23791":100445,"_2388":100565},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2861":59325,"_25124":59275,"_17549":100567,"_5":17444,"_23791":100449,"_2388":100568},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2861":59326,"_25124":59275,"_17549":100570,"_5":17444,"_23791":100449,"_2388":100571},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2861":59327,"_25124":59275,"_17549":100573,"_5":17444,"_23791":100449,"_2388":100574},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2861":59328,"_25124":59328,"_5":12314,"_2388":100576,"_25460":100577,"_17549":100578,"_23791":59328},"Plataforma Lamassu IoT",[40822,97162],[],{"_2861":59329,"_25124":59328,"_17549":100580,"_5":17444,"_23791":59328,"_2388":100581},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2861":59330,"_25124":59328,"_5":25457,"_17549":100583,"_23791":100584,"_2388":100074},[],"/docs/pr-preview/pr-37/es/platform/overview#empieza-aquí",{"_2861":59331,"_25124":59328,"_5":25457,"_17549":100586,"_23791":100587,"_2388":100588},[],"/docs/pr-preview/pr-37/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2861":59332,"_25124":59328,"_5":25457,"_17549":100590,"_23791":100591,"_2388":100592},[],"/docs/pr-preview/pr-37/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2861":59333,"_25124":59328,"_5":25457,"_17549":100594,"_23791":100595,"_2388":100596},[],"/docs/pr-preview/pr-37/es/platform/overview#capacidades-principales","Capacidades principales",{"_2861":59334,"_25124":59328,"_5":25457,"_17549":100598,"_23791":100599,"_2388":100600},[],"/docs/pr-preview/pr-37/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2861":59335,"_25124":59328,"_5":25457,"_17549":100602,"_23791":100603,"_2388":100604},[],"/docs/pr-preview/pr-37/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2861":59336,"_25124":59328,"_5":25457,"_17549":100606,"_23791":100607,"_2388":100608},[],"/docs/pr-preview/pr-37/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2861":59337,"_25124":59328,"_5":25457,"_17549":100610,"_23791":100611,"_2388":100612},[],"/docs/pr-preview/pr-37/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2861":59338,"_25124":59328,"_5":25457,"_17549":100614,"_23791":100615,"_2388":100616},[],"/docs/pr-preview/pr-37/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2861":59339,"_25124":59328,"_5":25457,"_17549":100618,"_23791":100619,"_2388":100620},[],"/docs/pr-preview/pr-37/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2861":59340,"_25124":59328,"_5":25457,"_17549":100622,"_23791":100623,"_2388":100624},[],"/docs/pr-preview/pr-37/es/platform/overview#referencia-operativa","Referencia operativa",{"_2861":59341,"_25124":59328,"_17549":100626,"_5":17444,"_23791":59328,"_2388":100627},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2861":59342,"_25124":59328,"_17549":100629,"_5":17444,"_23791":100584,"_2388":100630},[],"Elige el resultado que necesitas obtener:",{"_2861":59343,"_25124":59328,"_17549":100632,"_5":17444,"_23791":100584,"_2388":100633},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2861":59344,"_25124":59328,"_17549":100635,"_5":17444,"_23791":100584,"_2388":100636},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2861":59345,"_25124":59328,"_17549":100638,"_5":17444,"_23791":100584,"_2388":100639},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2861":59346,"_25124":59328,"_17549":100641,"_5":17444,"_23791":100587,"_2388":100642},[],"Bloque",{"_2861":59347,"_25124":59328,"_17549":100644,"_5":17444,"_23791":100587,"_2388":100645},[],"Qué gestionas",{"_2861":59348,"_25124":59328,"_17549":100647,"_5":17444,"_23791":100587,"_2388":100648},[],"Punto de entrada",{"_2861":59349,"_25124":59328,"_17549":100650,"_5":17444,"_23791":100587,"_2388":45758},[],{"_2861":59350,"_25124":59328,"_17549":100652,"_5":17444,"_23791":100587,"_2388":100653},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2861":59351,"_25124":59328,"_17549":100655,"_5":17444,"_23791":100587,"_2388":100656},[],"Visión general de PKI",{"_2861":59352,"_25124":59328,"_17549":100658,"_5":17444,"_23791":100587,"_2388":45767},[],{"_2861":59353,"_25124":59328,"_17549":100660,"_5":17444,"_23791":100587,"_2388":100661},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2861":59354,"_25124":59328,"_17549":100663,"_5":17444,"_23791":100587,"_2388":100664},[],"Visión general de IoT Fleets",{"_2861":59355,"_25124":59328,"_17549":100666,"_5":17444,"_23791":100587,"_2388":100667},[],"**Administración**",{"_2861":59356,"_25124":59328,"_17549":100669,"_5":17444,"_23791":100587,"_2388":100670},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2861":59357,"_25124":59328,"_17549":100672,"_5":17444,"_23791":100587,"_2388":97160},[],{"_2861":59358,"_25124":59328,"_17549":100674,"_5":17444,"_23791":100587,"_2388":100675},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2861":59359,"_25124":59328,"_17549":100677,"_5":17444,"_23791":100591,"_2388":100678},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2861":59360,"_25124":59328,"_17549":100680,"_5":17444,"_23791":100591,"_2388":100681},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2861":59361,"_25124":59328,"_17549":100683,"_5":17444,"_23791":100591,"_2388":100684},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2861":59362,"_25124":59328,"_17549":100686,"_5":17444,"_23791":100591,"_2388":100687},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2861":59363,"_25124":59328,"_17549":100689,"_5":17444,"_23791":100591,"_2388":100690},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2861":59364,"_25124":59328,"_17549":100692,"_5":17444,"_23791":100591,"_2388":100693},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2861":59365,"_25124":59328,"_17549":100695,"_5":17444,"_23791":100599,"_2388":100696},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2861":59366,"_25124":59328,"_17549":100698,"_5":17444,"_23791":100603,"_2388":100699},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2861":59367,"_25124":59328,"_17549":100701,"_5":17444,"_23791":100607,"_2388":100702},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2861":59368,"_25124":59328,"_17549":100704,"_5":17444,"_23791":100611,"_2388":100705},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2861":59369,"_25124":59328,"_17549":100707,"_5":17444,"_23791":100615,"_2388":100708},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2861":59370,"_25124":59328,"_17549":100710,"_5":17444,"_23791":100619,"_2388":100711},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2861":59371,"_25124":59328,"_17549":100713,"_5":17444,"_23791":100623,"_2388":100167},[],{"_2861":59372,"_25124":59328,"_17549":100715,"_5":17444,"_23791":100623,"_2388":100716},[],"Qué prepara o comprueba",{"_2861":59373,"_25124":59328,"_17549":100718,"_5":17444,"_23791":100623,"_2388":100170},[],{"_2861":59374,"_25124":59328,"_17549":100720,"_5":17444,"_23791":100623,"_2388":100721},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2861":59375,"_25124":59328,"_17549":100723,"_5":17444,"_23791":100623,"_2388":100724},[],"Administrador de la flota",{"_2861":59376,"_25124":59328,"_17549":100726,"_5":17444,"_23791":100623,"_2388":100727},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2861":59377,"_25124":59328,"_17549":100729,"_5":17444,"_23791":100623,"_2388":100182},[],{"_2861":59378,"_25124":59328,"_17549":100731,"_5":17444,"_23791":100623,"_2388":100732},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2861":59379,"_25124":59328,"_17549":100734,"_5":17444,"_23791":100623,"_2388":100188},[],{"_2861":59380,"_25124":59328,"_17549":100736,"_5":17444,"_23791":100623,"_2388":100737},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2861":59381,"_25124":59328,"_17549":100739,"_5":17444,"_23791":100623,"_2388":100740},[],"Operador de infraestructura",{"_2861":59382,"_25124":59328,"_17549":100742,"_5":17444,"_23791":100623,"_2388":100743},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2861":59383,"_25124":59328,"_17549":100745,"_5":17444,"_23791":100623,"_2388":100746},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2861":59384,"_25124":59384,"_5":12314,"_2388":100748,"_25460":100749,"_17549":100751,"_23791":59384},"Jerarquía y rotación de CAs",[40822,97162,45859,100750],"Claves, autoridades y certificados",[],{"_2861":59385,"_25124":59384,"_17549":100753,"_5":17444,"_23791":59384,"_2388":100754},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2861":59386,"_25124":59384,"_5":25457,"_17549":100756,"_23791":100757,"_2388":100758},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2861":59387,"_25124":59384,"_5":25457,"_17549":100760,"_23791":100761,"_2388":100762},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2861":59388,"_25124":59384,"_5":25457,"_17549":100764,"_23791":100765,"_2388":100766},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2861":59389,"_25124":59384,"_5":25457,"_17549":100768,"_23791":100769,"_2388":100770},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2861":59390,"_25124":59384,"_5":25457,"_17549":100772,"_23791":100773,"_2388":100774},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2861":59391,"_25124":59384,"_5":25457,"_17549":100776,"_23791":100777,"_2388":100778},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2861":59392,"_25124":59384,"_5":25457,"_17549":100780,"_23791":100781,"_2388":100782},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2861":59393,"_25124":59384,"_5":25457,"_17549":100784,"_23791":100785,"_2388":100786},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2861":59394,"_25124":59384,"_5":25457,"_17549":100788,"_23791":100789,"_2388":100790},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2861":59395,"_25124":59384,"_5":25457,"_17549":100792,"_23791":100793,"_2388":100794},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2861":59396,"_25124":59384,"_5":25457,"_17549":100796,"_23791":100797,"_2388":100798},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2861":59397,"_25124":59384,"_5":25457,"_17549":100800,"_23791":100801,"_2388":100802},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2861":59398,"_25124":59384,"_17549":100804,"_5":17444,"_23791":59384,"_2388":100805},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2861":59399,"_25124":59384,"_17549":100807,"_5":17444,"_23791":59384,"_2388":100808},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2861":59400,"_25124":59384,"_17549":100810,"_5":17444,"_23791":100757,"_2388":100811},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2861":59401,"_25124":59384,"_17549":100813,"_5":17444,"_23791":100757,"_2388":100814},[],"entorno, como producción y preproducción;",{"_2861":59402,"_25124":59384,"_17549":100816,"_5":17444,"_23791":100757,"_2388":100817},[],"propietario o equipo operador;",{"_2861":59403,"_25124":59384,"_17549":100819,"_5":17444,"_23791":100757,"_2388":100820},[],"familia de dispositivos o proceso de fabricación;",{"_2861":59404,"_25124":59384,"_17549":100822,"_5":17444,"_23791":100757,"_2388":100823},[],"región o requisito regulatorio;",{"_2861":59405,"_25124":59384,"_17549":100825,"_5":17444,"_23791":100757,"_2388":100826},[],"motor criptográfico o política de clave;",{"_2861":59406,"_25124":59384,"_17549":100828,"_5":17444,"_23791":100757,"_2388":100829},[],"ventana de mantenimiento y ritmo de renovación.",{"_2861":59407,"_25124":59384,"_17549":100831,"_5":17444,"_23791":100757,"_2388":100832},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2861":59408,"_25124":59384,"_17549":100834,"_5":17444,"_23791":100757,"_2388":100835},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2861":59409,"_25124":59384,"_17549":100837,"_5":17444,"_23791":100761,"_2388":100838},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2861":59410,"_25124":59384,"_17549":100840,"_5":17444,"_23791":100761,"_2388":100841},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2861":59411,"_25124":59384,"_17549":100843,"_5":17444,"_23791":100761,"_2388":100844},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2861":59412,"_25124":59384,"_17549":100846,"_5":17444,"_23791":100765,"_2388":100847},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2861":59413,"_25124":59384,"_17549":100849,"_5":17444,"_23791":100765,"_2388":100850},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2861":59414,"_25124":59384,"_17549":100852,"_5":17444,"_23791":100765,"_2388":100853},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2861":59415,"_25124":59384,"_17549":100855,"_5":17444,"_23791":100765,"_2388":100856},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2861":59416,"_25124":59384,"_17549":100858,"_5":17444,"_23791":100773,"_2388":100859},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2861":59417,"_25124":59384,"_17549":100861,"_5":17444,"_23791":100777,"_2388":100862},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2861":59418,"_25124":59384,"_17549":100864,"_5":17444,"_23791":100781,"_2388":100865},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2861":59419,"_25124":59384,"_17549":100867,"_5":17444,"_23791":100785,"_2388":100868},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2861":59420,"_25124":59384,"_17549":100870,"_5":17444,"_23791":100789,"_2388":100871},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2861":59421,"_25124":59384,"_17549":100873,"_5":17444,"_23791":100793,"_2388":100874},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2861":59422,"_25124":59384,"_17549":100876,"_5":17444,"_23791":100797,"_2388":100877},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2861":59423,"_25124":59384,"_17549":100879,"_5":17444,"_23791":100797,"_2388":100880},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2861":59424,"_25124":59384,"_17549":100882,"_5":17444,"_23791":100797,"_2388":100883},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2861":59425,"_25124":59384,"_17549":100885,"_5":17444,"_23791":100797,"_2388":100886},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2861":59426,"_25124":59384,"_17549":100888,"_5":17444,"_23791":100801,"_2388":100889},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2861":59427,"_25124":59384,"_17549":100891,"_5":17444,"_23791":100801,"_2388":100892},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2861":59428,"_25124":59384,"_17549":100894,"_5":17444,"_23791":100801,"_2388":100895},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2861":59429,"_25124":59384,"_17549":100897,"_5":17444,"_23791":100801,"_2388":100898},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2861":59430,"_25124":59384,"_17549":100900,"_5":17444,"_23791":100801,"_2388":100901},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2861":59431,"_25124":59384,"_17549":100903,"_5":17444,"_23791":100801,"_2388":100904},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2861":59432,"_25124":59384,"_17549":100906,"_5":17444,"_23791":100801,"_2388":100907},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2861":59433,"_25124":59433,"_5":12314,"_2388":100909,"_25460":100910,"_17549":100911,"_23791":59433},"Autoridades de certificación",[40822,97162,45859,100750],[],{"_2861":59434,"_25124":59433,"_17549":100913,"_5":17444,"_23791":59433,"_2388":100914},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2861":59435,"_25124":59433,"_5":25457,"_17549":100916,"_23791":100917,"_2388":100918},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2861":59436,"_25124":59433,"_5":25457,"_17549":100920,"_23791":100921,"_2388":100922},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2861":59437,"_25124":59433,"_5":25457,"_17549":100924,"_23791":100925,"_2388":95863},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2861":59438,"_25124":59433,"_5":25457,"_17549":100927,"_23791":100928,"_2388":100929},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2861":59439,"_25124":59433,"_5":25457,"_17549":100931,"_23791":100932,"_2388":100933},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2861":59440,"_25124":59433,"_5":25457,"_17549":100935,"_23791":100936,"_2388":100937},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2861":59441,"_25124":59433,"_5":25457,"_17549":100939,"_23791":100940,"_2388":100941},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2861":59442,"_25124":59433,"_5":25457,"_17549":100943,"_23791":100944,"_2388":100945},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2861":59443,"_25124":59433,"_5":25457,"_17549":100947,"_23791":100948,"_2388":100949},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2861":59444,"_25124":59433,"_5":25457,"_17549":100951,"_23791":100952,"_2388":100953},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2861":59445,"_25124":59433,"_5":25457,"_17549":100955,"_23791":100956,"_2388":100957},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2861":59446,"_25124":59433,"_5":25457,"_17549":100959,"_23791":100960,"_2388":100961},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2861":59447,"_25124":59433,"_5":25457,"_17549":100963,"_23791":100964,"_2388":100965},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2861":59448,"_25124":59433,"_5":25457,"_17549":100967,"_23791":100968,"_2388":100969},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2861":59449,"_25124":59433,"_5":25457,"_17549":100971,"_23791":100972,"_2388":100973},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2861":59450,"_25124":59433,"_5":25457,"_17549":100975,"_23791":100976,"_2388":100977},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2861":59451,"_25124":59433,"_5":25457,"_17549":100979,"_23791":100980,"_2388":100981},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2861":59452,"_25124":59433,"_5":25457,"_17549":100983,"_23791":100984,"_2388":100985},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2861":59453,"_25124":59433,"_5":25457,"_17549":100987,"_23791":100988,"_2388":100989},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2861":59454,"_25124":59433,"_5":25457,"_17549":100991,"_23791":100992,"_2388":100993},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2861":59455,"_25124":59433,"_5":25457,"_17549":100995,"_23791":100996,"_2388":100997},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2861":59456,"_25124":59433,"_5":25457,"_17549":100999,"_23791":101000,"_2388":101001},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2861":59457,"_25124":59433,"_17549":101003,"_5":17444,"_23791":59433,"_2388":101004},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2861":59458,"_25124":59433,"_17549":101006,"_5":17444,"_23791":59433,"_2388":101007},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2861":59459,"_25124":59433,"_17549":101009,"_5":17444,"_23791":59433,"_2388":101010},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2861":59460,"_25124":59433,"_17549":101012,"_5":17444,"_23791":100917,"_2388":101013},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2861":59461,"_25124":59433,"_17549":101015,"_5":17444,"_23791":100917,"_2388":101016},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2861":59462,"_25124":59433,"_17549":101018,"_5":17444,"_23791":100917,"_2388":101019},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2861":59463,"_25124":59433,"_17549":101021,"_5":17444,"_23791":100917,"_2388":101022},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2861":59464,"_25124":59433,"_17549":101024,"_5":17444,"_23791":100917,"_2388":101025},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2861":59465,"_25124":59433,"_17549":101027,"_5":17444,"_23791":100925,"_2388":101028},[],"Decide si la CA será raíz o intermedia.",{"_2861":59466,"_25124":59433,"_17549":101030,"_5":17444,"_23791":100925,"_2388":101031},[],"Elige el motor que custodiará la clave.",{"_2861":59467,"_25124":59433,"_17549":101033,"_5":17444,"_23791":100925,"_2388":101034},[],"Define una validez superior a la de los certificados que emitirá.",{"_2861":59468,"_25124":59433,"_17549":101036,"_5":17444,"_23791":100925,"_2388":101037},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2861":59469,"_25124":59433,"_17549":101039,"_5":17444,"_23791":100928,"_2388":101040},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2861":59470,"_25124":59433,"_17549":101042,"_5":17444,"_23791":100932,"_2388":101043},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2861":59471,"_25124":59433,"_17549":101045,"_5":17444,"_23791":100932,"_2388":101046},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2861":59472,"_25124":59433,"_17549":101048,"_5":17444,"_23791":100936,"_2388":101049},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2861":59473,"_25124":59433,"_17549":101051,"_5":17444,"_23791":100940,"_2388":101052},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2861":59474,"_25124":59433,"_17549":101054,"_5":17444,"_23791":100940,"_2388":101055},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2861":59475,"_25124":59433,"_17549":101057,"_5":17444,"_23791":100940,"_2388":101058},[],"`ST`: estado o provincia.",{"_2861":59476,"_25124":59433,"_17549":101060,"_5":17444,"_23791":100940,"_2388":101061},[],"`L`: localidad.",{"_2861":59477,"_25124":59433,"_17549":101063,"_5":17444,"_23791":100940,"_2388":101064},[],"`O`: organización.",{"_2861":59478,"_25124":59433,"_17549":101066,"_5":17444,"_23791":100940,"_2388":101067},[],"`OU`: unidad organizativa.",{"_2861":59479,"_25124":59433,"_17549":101069,"_5":17444,"_23791":100940,"_2388":101070},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2861":59480,"_25124":59433,"_17549":101072,"_5":17444,"_23791":100944,"_2388":101073},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2861":59481,"_25124":59433,"_17549":101075,"_5":17444,"_23791":100944,"_2388":101076},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2861":59482,"_25124":59433,"_17549":101078,"_5":17444,"_23791":100948,"_2388":101079},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2861":59483,"_25124":59433,"_17549":101081,"_5":17444,"_23791":100948,"_2388":101082},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2861":59484,"_25124":59433,"_17549":101084,"_5":17444,"_23791":100952,"_2388":101085},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2861":59485,"_25124":59433,"_17549":101087,"_5":17444,"_23791":100952,"_2388":101088},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2861":59486,"_25124":59433,"_17549":101090,"_5":17444,"_23791":100956,"_2388":101091},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2861":59487,"_25124":59433,"_17549":101093,"_5":17444,"_23791":100960,"_2388":101094},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2861":59488,"_25124":59433,"_17549":101096,"_5":17444,"_23791":100964,"_2388":101097},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2861":59489,"_25124":59433,"_17549":101099,"_5":17444,"_23791":100968,"_2388":101100},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2861":59490,"_25124":59433,"_17549":101102,"_5":17444,"_23791":100972,"_2388":101103},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2861":59491,"_25124":59433,"_17549":101105,"_5":17444,"_23791":100972,"_2388":101106},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2861":59492,"_25124":59433,"_17549":101108,"_5":17444,"_23791":100976,"_2388":101109},[],"Abre una CA desde el inventario para consultar:",{"_2861":59493,"_25124":59433,"_17549":101111,"_5":17444,"_23791":100976,"_2388":101112},[],"Estado y periodo de validez.",{"_2861":59494,"_25124":59433,"_17549":101114,"_5":17444,"_23791":100976,"_2388":101115},[],"Certificado y cadena en formato PEM.",{"_2861":59495,"_25124":59433,"_17549":101117,"_5":17444,"_23791":100976,"_2388":101118},[],"Número de certificados activos, expirados y revocados.",{"_2861":59496,"_25124":59433,"_17549":101120,"_5":17444,"_23791":100976,"_2388":101121},[],"Certificados emitidos en **Issued Certificates**.",{"_2861":59497,"_25124":59433,"_17549":101123,"_5":17444,"_23791":100976,"_2388":101124},[],"CRL vinculada a la autoridad.",{"_2861":59498,"_25124":59433,"_17549":101126,"_5":17444,"_23791":100976,"_2388":101127},[],"Metadatos y motor criptográfico asociado.",{"_2861":59499,"_25124":59433,"_17549":101129,"_5":17444,"_23791":100976,"_2388":101130},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2861":59500,"_25124":59433,"_17549":101132,"_5":17444,"_23791":100980,"_2388":101133},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2861":59501,"_25124":59433,"_17549":101135,"_5":17444,"_23791":100980,"_2388":101136},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2861":59502,"_25124":59433,"_17549":101138,"_5":17444,"_23791":100980,"_2388":101139},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2861":59503,"_25124":59433,"_17549":101141,"_5":17444,"_23791":100980,"_2388":101142},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2861":59504,"_25124":59433,"_17549":101144,"_5":17444,"_23791":100984,"_2388":101145},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2861":59505,"_25124":59433,"_17549":101147,"_5":17444,"_23791":100988,"_2388":101148},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2861":59506,"_25124":59433,"_17549":101150,"_5":17444,"_23791":100992,"_2388":101151},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2861":59507,"_25124":59433,"_17549":101153,"_5":17444,"_23791":100996,"_2388":101154},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2861":59508,"_25124":59433,"_17549":101156,"_5":17444,"_23791":101000,"_2388":101157},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2861":59509,"_25124":59433,"_17549":101159,"_5":17444,"_23791":101000,"_2388":101160},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2861":59510,"_25124":59510,"_5":12314,"_2388":101162,"_25460":101163,"_17549":101164,"_23791":59510},"Perfiles de certificado",[40822,97162,45859,100750],[],{"_2861":59511,"_25124":59510,"_17549":101166,"_5":17444,"_23791":59510,"_2388":101167},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2861":59512,"_25124":59510,"_5":25457,"_17549":101169,"_23791":101170,"_2388":101171},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2861":59513,"_25124":59510,"_5":25457,"_17549":101173,"_23791":101174,"_2388":101175},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#validez","Validez",{"_2861":59514,"_25124":59510,"_5":25457,"_17549":101177,"_23791":101178,"_2388":101179},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2861":59515,"_25124":59510,"_5":25457,"_17549":101181,"_23791":101182,"_2388":101183},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2861":59516,"_25124":59510,"_5":25457,"_17549":101185,"_23791":101186,"_2388":101187},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2861":59517,"_25124":59510,"_5":25457,"_17549":101189,"_23791":101190,"_2388":101191},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2861":59518,"_25124":59510,"_5":25457,"_17549":101193,"_23791":101194,"_2388":101195},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2861":59519,"_25124":59510,"_5":25457,"_17549":101197,"_23791":101198,"_2388":101199},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2861":59520,"_25124":59510,"_5":25457,"_17549":101201,"_23791":101202,"_2388":101203},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2861":59521,"_25124":59510,"_5":25457,"_17549":101205,"_23791":101206,"_2388":101207},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2861":59522,"_25124":59510,"_5":25457,"_17549":101209,"_23791":101210,"_2388":101211},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2861":59523,"_25124":59510,"_5":25457,"_17549":101213,"_23791":101214,"_2388":101215},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2861":59524,"_25124":59510,"_5":25457,"_17549":101217,"_23791":101218,"_2388":101219},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2861":59525,"_25124":59510,"_5":25457,"_17549":101221,"_23791":101222,"_2388":101223},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2861":59526,"_25124":59510,"_5":25457,"_17549":101225,"_23791":101226,"_2388":101227},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2861":59527,"_25124":59510,"_5":25457,"_17549":101229,"_23791":101230,"_2388":101231},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2861":59528,"_25124":59510,"_17549":101233,"_5":17444,"_23791":59510,"_2388":101234},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2861":59529,"_25124":59510,"_17549":101236,"_5":17444,"_23791":59510,"_2388":101237},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2861":59530,"_25124":59510,"_17549":101239,"_5":17444,"_23791":101174,"_2388":101240},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2861":59531,"_25124":59510,"_17549":101242,"_5":17444,"_23791":101174,"_2388":101243},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2861":59532,"_25124":59510,"_17549":101245,"_5":17444,"_23791":101178,"_2388":101246},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2861":59533,"_25124":59510,"_17549":101248,"_5":17444,"_23791":101182,"_2388":101249},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2861":59534,"_25124":59510,"_17549":101251,"_5":17444,"_23791":101182,"_2388":101252},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2861":59535,"_25124":59510,"_17549":101254,"_5":17444,"_23791":101182,"_2388":101255},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2861":59536,"_25124":59510,"_17549":101257,"_5":17444,"_23791":101186,"_2388":101258},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2861":59537,"_25124":59510,"_17549":101260,"_5":17444,"_23791":101190,"_2388":101261},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2861":59538,"_25124":59510,"_17549":101263,"_5":17444,"_23791":101190,"_2388":101264},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2861":59539,"_25124":59510,"_17549":101266,"_5":17444,"_23791":101194,"_2388":101267},[],"La aplicación criptográfica puede:",{"_2861":59540,"_25124":59510,"_17549":101269,"_5":17444,"_23791":101194,"_2388":101270},[],"permitir o bloquear claves RSA;",{"_2861":59541,"_25124":59510,"_17549":101272,"_5":17444,"_23791":101194,"_2388":101273},[],"limitar los tamaños RSA admitidos;",{"_2861":59542,"_25124":59510,"_17549":101275,"_5":17444,"_23791":101194,"_2388":101276},[],"permitir o bloquear claves ECDSA;",{"_2861":59543,"_25124":59510,"_17549":101278,"_5":17444,"_23791":101194,"_2388":101279},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2861":59544,"_25124":59510,"_17549":101281,"_5":17444,"_23791":101194,"_2388":101282},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2861":59545,"_25124":59510,"_17549":101284,"_5":17444,"_23791":101198,"_2388":101285},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2861":59546,"_25124":59510,"_17549":101287,"_5":17444,"_23791":101198,"_2388":96953},[],{"_2861":59547,"_25124":59510,"_17549":101289,"_5":17444,"_23791":101198,"_2388":101290},[],"Primera opción",{"_2861":59548,"_25124":59510,"_17549":101292,"_5":17444,"_23791":101198,"_2388":101293},[],"Segunda opción",{"_2861":59549,"_25124":59510,"_17549":101295,"_5":17444,"_23791":101198,"_2388":101296},[],"Si no hay ninguna",{"_2861":59550,"_25124":59510,"_17549":101298,"_5":17444,"_23791":101198,"_2388":101299},[],"Firma directa con una CA",{"_2861":59551,"_25124":59510,"_17549":101301,"_5":17444,"_23791":101198,"_2388":101302},[],"`issuance_profile` incluido en la solicitud",{"_2861":59552,"_25124":59510,"_17549":101304,"_5":17444,"_23791":101198,"_2388":101305},[],"`issuance_profile_id` de la solicitud",{"_2861":59553,"_25124":59510,"_17549":101307,"_5":17444,"_23791":101198,"_2388":101308},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2861":59554,"_25124":59510,"_17549":101310,"_5":17444,"_23791":101198,"_2388":101311},[],"Emisión mediante DMS",{"_2861":59555,"_25124":59510,"_17549":101313,"_5":17444,"_23791":101198,"_2388":46424},[],{"_2861":59556,"_25124":59510,"_17549":101315,"_5":17444,"_23791":101198,"_2388":101316},[],"`settings.issuance_profile` incluido en el DMS",{"_2861":59557,"_25124":59510,"_17549":101318,"_5":17444,"_23791":101198,"_2388":101319},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2861":59558,"_25124":59510,"_17549":101321,"_5":17444,"_23791":101198,"_2388":101322},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2861":59559,"_25124":59510,"_17549":101324,"_5":17444,"_23791":101198,"_2388":101325},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2861":59560,"_25124":59510,"_17549":101327,"_5":17444,"_23791":101206,"_2388":101328},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2861":59561,"_25124":59510,"_17549":101330,"_5":17444,"_23791":101210,"_2388":101331},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2861":59562,"_25124":59510,"_17549":101333,"_5":17444,"_23791":101214,"_2388":101334},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2861":59563,"_25124":59510,"_17549":101336,"_5":17444,"_23791":101218,"_2388":101337},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2861":59564,"_25124":59510,"_17549":101339,"_5":17444,"_23791":101222,"_2388":101340},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2861":59565,"_25124":59510,"_17549":101342,"_5":17444,"_23791":101222,"_2388":101343},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2861":59566,"_25124":59510,"_17549":101345,"_5":17444,"_23791":101226,"_2388":101346},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2861":59567,"_25124":59510,"_17549":101348,"_5":17444,"_23791":101226,"_2388":101349},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2861":59568,"_25124":59510,"_17549":101351,"_5":17444,"_23791":101226,"_2388":101352},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2861":59569,"_25124":59510,"_17549":101354,"_5":17444,"_23791":101226,"_2388":101355},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2861":59570,"_25124":59510,"_17549":101357,"_5":17444,"_23791":101230,"_2388":101358},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2861":59571,"_25124":59510,"_17549":101360,"_5":17444,"_23791":101230,"_2388":101361},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2861":59572,"_25124":59572,"_5":12314,"_2388":101363,"_25460":101364,"_17549":101366,"_23791":59572},"Validación de certificados",[40822,97162,45859,101365],"Validación",[],{"_2861":59573,"_25124":59572,"_17549":101368,"_5":17444,"_23791":59572,"_2388":101369},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2861":59574,"_25124":59572,"_5":25457,"_17549":101371,"_23791":101372,"_2388":101373},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2861":59575,"_25124":59572,"_5":25457,"_17549":101375,"_23791":101376,"_2388":101377},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2861":59576,"_25124":59572,"_5":25457,"_17549":101379,"_23791":101380,"_2388":101381},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2861":59577,"_25124":59572,"_17549":101383,"_5":17444,"_23791":59572,"_2388":101384},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2861":59578,"_25124":59572,"_17549":101386,"_5":17444,"_23791":101372,"_2388":101387},[],"Verifica estos criterios juntos:",{"_2861":59579,"_25124":59572,"_17549":101389,"_5":17444,"_23791":101372,"_2388":100377},[],{"_2861":59580,"_25124":59572,"_17549":101391,"_5":17444,"_23791":101372,"_2388":101392},[],"Resultado necesario",{"_2861":59581,"_25124":59572,"_17549":101394,"_5":17444,"_23791":101372,"_2388":101395},[],"Cadena y firma",{"_2861":59582,"_25124":59572,"_17549":101397,"_5":17444,"_23791":101372,"_2388":101398},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2861":59583,"_25124":59572,"_17549":101400,"_5":17444,"_23791":101372,"_2388":101401},[],"Fechas",{"_2861":59584,"_25124":59572,"_17549":101403,"_5":17444,"_23791":101372,"_2388":101404},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2861":59585,"_25124":59572,"_17549":101406,"_5":17444,"_23791":101372,"_2388":96866},[],{"_2861":59586,"_25124":59572,"_17549":101408,"_5":17444,"_23791":101372,"_2388":101409},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2861":59587,"_25124":59572,"_17549":101411,"_5":17444,"_23791":101372,"_2388":101412},[],"Uso",{"_2861":59588,"_25124":59572,"_17549":101414,"_5":17444,"_23791":101372,"_2388":101415},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2861":59589,"_25124":59572,"_17549":101417,"_5":17444,"_23791":101372,"_2388":101418},[],"Revocación",{"_2861":59590,"_25124":59572,"_17549":101420,"_5":17444,"_23791":101372,"_2388":101421},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2861":59591,"_25124":59572,"_17549":101423,"_5":17444,"_23791":101372,"_2388":101424},[],"Autorización",{"_2861":59592,"_25124":59572,"_17549":101426,"_5":17444,"_23791":101372,"_2388":101427},[],"La aplicación permite la acción a esa identidad.",{"_2861":59593,"_25124":59572,"_17549":101429,"_5":17444,"_23791":101372,"_2388":101430},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2861":59594,"_25124":59572,"_17549":101432,"_5":17444,"_23791":101376,"_2388":101433},[],"Mecanismo",{"_2861":59595,"_25124":59572,"_17549":101435,"_5":17444,"_23791":101376,"_2388":101436},[],"Cuándo utilizarlo",{"_2861":59596,"_25124":59572,"_17549":101438,"_5":17444,"_23791":101376,"_2388":101439},[],"Qué debes mantener",{"_2861":59597,"_25124":59572,"_17549":101441,"_5":17444,"_23791":101376,"_2388":46552},[],{"_2861":59598,"_25124":59572,"_17549":101443,"_5":17444,"_23791":101376,"_2388":101444},[],"Consulta del estado de un certificado concreto.",{"_2861":59599,"_25124":59572,"_17549":101446,"_5":17444,"_23791":101376,"_2388":101447},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2861":59600,"_25124":59572,"_17549":101449,"_5":17444,"_23791":101376,"_2388":46561},[],{"_2861":59601,"_25124":59572,"_17549":101451,"_5":17444,"_23791":101376,"_2388":101452},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2861":59602,"_25124":59572,"_17549":101454,"_5":17444,"_23791":101376,"_2388":101455},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2861":59603,"_25124":59572,"_17549":101457,"_5":17444,"_23791":101376,"_2388":101458},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2861":59604,"_25124":59572,"_17549":101460,"_5":17444,"_23791":101376,"_2388":101461},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2861":59605,"_25124":59572,"_17549":101463,"_5":17444,"_23791":101380,"_2388":101464},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2861":59606,"_25124":59572,"_17549":101466,"_5":17444,"_23791":101380,"_2388":101467},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2861":59607,"_25124":59572,"_17549":101469,"_5":17444,"_23791":101380,"_2388":101470},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2861":59608,"_25124":59572,"_17549":101472,"_5":17444,"_23791":101380,"_2388":101473},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2861":59609,"_25124":59572,"_17549":101475,"_5":17444,"_23791":101380,"_2388":101476},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2861":59610,"_25124":59572,"_17549":101478,"_5":17444,"_23791":101380,"_2388":101479},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2861":59611,"_25124":59572,"_17549":101481,"_5":17444,"_23791":101380,"_2388":101482},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2861":59612,"_25124":59572,"_17549":101484,"_5":17444,"_23791":101380,"_2388":101485},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2861":59613,"_25124":59572,"_17549":101487,"_5":17444,"_23791":101380,"_2388":101488},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2861":59614,"_25124":59614,"_5":12314,"_2388":101490,"_25460":101491,"_17549":101492,"_23791":59614},"Certificados",[40822,97162,45859,100750],[],{"_2861":59615,"_25124":59614,"_17549":101494,"_5":17444,"_23791":59614,"_2388":101495},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2861":59616,"_25124":59614,"_5":25457,"_17549":101497,"_23791":101498,"_2388":101499},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2861":59617,"_25124":59614,"_5":25457,"_17549":101501,"_23791":101502,"_2388":101503},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2861":59618,"_25124":59614,"_5":25457,"_17549":101505,"_23791":101506,"_2388":101507},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2861":59619,"_25124":59614,"_5":25457,"_17549":101509,"_23791":101510,"_2388":101511},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2861":59620,"_25124":59614,"_5":25457,"_17549":101513,"_23791":101514,"_2388":101515},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2861":59621,"_25124":59614,"_5":25457,"_17549":101517,"_23791":101518,"_2388":101519},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2861":59622,"_25124":59614,"_5":25457,"_17549":101521,"_23791":101522,"_2388":101523},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2861":59623,"_25124":59614,"_5":25457,"_17549":101525,"_23791":101526,"_2388":101527},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2861":59624,"_25124":59614,"_5":25457,"_17549":101529,"_23791":101530,"_2388":101531},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#continúa","Continúa",{"_2861":59625,"_25124":59614,"_17549":101533,"_5":17444,"_23791":59614,"_2388":101534},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2861":59626,"_25124":59614,"_17549":101536,"_5":17444,"_23791":101498,"_2388":101537},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2861":59627,"_25124":59614,"_17549":101539,"_5":17444,"_23791":101498,"_2388":101540},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2861":59628,"_25124":59614,"_17549":101542,"_5":17444,"_23791":101502,"_2388":101543},[],"Descarga el PEM e inspecciónalo:",{"_2861":59629,"_25124":59614,"_17549":101545,"_5":17444,"_23791":101502,"_2388":101546},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2861":59630,"_25124":59614,"_17549":101548,"_5":17444,"_23791":101506,"_2388":101549},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2861":59631,"_25124":59614,"_17549":101551,"_5":17444,"_23791":101506,"_2388":101552},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2861":59632,"_25124":59614,"_17549":101554,"_5":17444,"_23791":101506,"_2388":101555},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2861":59633,"_25124":59614,"_17549":101557,"_5":17444,"_23791":101506,"_2388":101558},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2861":59634,"_25124":59614,"_17549":101560,"_5":17444,"_23791":101506,"_2388":101561},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2861":59635,"_25124":59614,"_17549":101563,"_5":17444,"_23791":101506,"_2388":101564},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2861":59636,"_25124":59614,"_17549":101566,"_5":17444,"_23791":101506,"_2388":101567},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2861":59637,"_25124":59614,"_17549":101569,"_5":17444,"_23791":101510,"_2388":101570},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2861":59638,"_25124":59614,"_17549":101572,"_5":17444,"_23791":101514,"_2388":101573},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2861":59639,"_25124":59614,"_17549":101575,"_5":17444,"_23791":101518,"_2388":101576},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2861":59640,"_25124":59614,"_17549":101578,"_5":17444,"_23791":101522,"_2388":101579},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2861":59641,"_25124":59614,"_17549":101581,"_5":17444,"_23791":101522,"_2388":101582},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2861":59642,"_25124":59614,"_17549":101584,"_5":17444,"_23791":101522,"_2388":101585},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2861":59643,"_25124":59614,"_17549":101587,"_5":17444,"_23791":101526,"_2388":101588},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2861":59644,"_25124":59614,"_17549":101590,"_5":17444,"_23791":101526,"_2388":101591},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2861":59645,"_25124":59614,"_17549":101593,"_5":17444,"_23791":101526,"_2388":101594},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2861":59646,"_25124":59614,"_17549":101596,"_5":17444,"_23791":101530,"_2388":101597},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2861":59647,"_25124":59614,"_17549":101599,"_5":17444,"_23791":101530,"_2388":101600},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2861":59648,"_25124":59648,"_5":12314,"_2388":101602,"_25460":101603,"_17549":101605,"_23791":59648},"Ciclo de vida de un certificado",[40822,97162,45859,101604],"Conceptos",[],{"_2861":59649,"_25124":59648,"_17549":101607,"_5":17444,"_23791":59648,"_2388":101608},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2861":59650,"_25124":59648,"_5":25457,"_17549":101610,"_23791":101611,"_2388":101612},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2861":59651,"_25124":59648,"_5":25457,"_17549":101614,"_23791":101615,"_2388":101616},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2861":59652,"_25124":59648,"_5":25457,"_17549":101618,"_23791":101619,"_2388":101620},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2861":59653,"_25124":59648,"_5":25457,"_17549":101622,"_23791":101623,"_2388":101624},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2861":59654,"_25124":59648,"_5":25457,"_17549":101626,"_23791":101627,"_2388":101628},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2861":59655,"_25124":59648,"_5":25457,"_17549":101630,"_23791":101631,"_2388":101632},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2861":59656,"_25124":59648,"_5":25457,"_17549":101634,"_23791":101635,"_2388":101636},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2861":59657,"_25124":59648,"_5":25457,"_17549":101638,"_23791":101639,"_2388":101640},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2861":59658,"_25124":59648,"_5":25457,"_17549":101642,"_23791":101643,"_2388":101644},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2861":59659,"_25124":59648,"_5":25457,"_17549":101646,"_23791":101647,"_2388":101648},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2861":59660,"_25124":59648,"_17549":101650,"_5":17444,"_23791":59648,"_2388":101651},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2861":59661,"_25124":59648,"_17549":101653,"_5":17444,"_23791":101615,"_2388":101654},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2861":59662,"_25124":59648,"_17549":101656,"_5":17444,"_23791":101619,"_2388":101657},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2861":59663,"_25124":59648,"_17549":101659,"_5":17444,"_23791":101623,"_2388":101660},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2861":59664,"_25124":59648,"_17549":101662,"_5":17444,"_23791":101627,"_2388":101663},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2861":59665,"_25124":59648,"_17549":101665,"_5":17444,"_23791":101631,"_2388":101666},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2861":59666,"_25124":59648,"_17549":101668,"_5":17444,"_23791":101635,"_2388":101669},[],"Lamassu persiste cuatro estados X.509:",{"_2861":59667,"_25124":59648,"_17549":101671,"_5":17444,"_23791":101635,"_2388":101672},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2861":59668,"_25124":59648,"_17549":101674,"_5":17444,"_23791":101635,"_2388":101675},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2861":59669,"_25124":59648,"_17549":101677,"_5":17444,"_23791":101635,"_2388":101678},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2861":59670,"_25124":59648,"_17549":101680,"_5":17444,"_23791":101635,"_2388":101681},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2861":59671,"_25124":59648,"_17549":101683,"_5":17444,"_23791":101635,"_2388":101684},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2861":59672,"_25124":59648,"_17549":101686,"_5":17444,"_23791":101639,"_2388":101687},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2861":59673,"_25124":59648,"_17549":101689,"_5":17444,"_23791":101639,"_2388":101690},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2861":59674,"_25124":59648,"_17549":101692,"_5":17444,"_23791":101639,"_2388":101693},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2861":59675,"_25124":59648,"_17549":101695,"_5":17444,"_23791":101643,"_2388":101696},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2861":59676,"_25124":59648,"_17549":101698,"_5":17444,"_23791":101643,"_2388":101699},[],"Antes de confirmar:",{"_2861":59677,"_25124":59648,"_17549":101701,"_5":17444,"_23791":101643,"_2388":101702},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2861":59678,"_25124":59648,"_17549":101704,"_5":17444,"_23791":101643,"_2388":101705},[],"Distribuye la nueva cadena de confianza.",{"_2861":59679,"_25124":59648,"_17549":101707,"_5":17444,"_23791":101643,"_2388":101708},[],"Reemite las identidades necesarias.",{"_2861":59680,"_25124":59648,"_17549":101710,"_5":17444,"_23791":101643,"_2388":101711},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2861":59681,"_25124":59648,"_17549":101713,"_5":17444,"_23791":101643,"_2388":101714},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2861":59682,"_25124":59648,"_17549":101716,"_5":17444,"_23791":101643,"_2388":101717},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2861":59683,"_25124":59648,"_17549":101719,"_5":17444,"_23791":101647,"_2388":101720},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2861":59684,"_25124":59648,"_17549":101722,"_5":17444,"_23791":101647,"_2388":101723},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2861":59685,"_25124":59648,"_17549":101725,"_5":17444,"_23791":101647,"_2388":101726},[],"Cambios de estado y razones de revocación.",{"_2861":59686,"_25124":59648,"_17549":101728,"_5":17444,"_23791":101647,"_2388":101729},[],"Publicación y vigencia de OCSP y CRLs.",{"_2861":59687,"_25124":59648,"_17549":101731,"_5":17444,"_23791":101647,"_2388":101732},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2861":59688,"_25124":59648,"_17549":101734,"_5":17444,"_23791":101647,"_2388":101735},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2861":59689,"_25124":59689,"_5":12314,"_2388":101737,"_25460":101738,"_17549":101739,"_23791":59689},"Modelo de confianza",[40822,97162,45859,101604],[],{"_2861":59690,"_25124":59689,"_17549":101741,"_5":17444,"_23791":59689,"_2388":101742},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2861":59691,"_25124":59689,"_5":25457,"_17549":101744,"_23791":101745,"_2388":101746},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2861":59692,"_25124":59689,"_5":25457,"_17549":101748,"_23791":101749,"_2388":101750},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2861":59693,"_25124":59689,"_5":25457,"_17549":101752,"_23791":101753,"_2388":101754},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2861":59694,"_25124":59689,"_5":25457,"_17549":101756,"_23791":101757,"_2388":101758},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2861":59695,"_25124":59689,"_5":25457,"_17549":101760,"_23791":101761,"_2388":101762},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2861":59696,"_25124":59689,"_5":25457,"_17549":101764,"_23791":101765,"_2388":101766},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2861":59697,"_25124":59689,"_5":25457,"_17549":101768,"_23791":101769,"_2388":101770},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2861":59698,"_25124":59689,"_5":25457,"_17549":101772,"_23791":101773,"_2388":101774},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2861":59699,"_25124":59689,"_5":25457,"_17549":101776,"_23791":101777,"_2388":101778},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2861":59700,"_25124":59689,"_5":25457,"_17549":101780,"_23791":101781,"_2388":101782},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2861":59701,"_25124":59689,"_17549":101784,"_5":17444,"_23791":59689,"_2388":101785},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2861":59702,"_25124":59689,"_17549":101787,"_5":17444,"_23791":101749,"_2388":101788},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2861":59703,"_25124":59689,"_17549":101790,"_5":17444,"_23791":101753,"_2388":101791},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2861":59704,"_25124":59689,"_17549":101793,"_5":17444,"_23791":101757,"_2388":101794},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2861":59705,"_25124":59689,"_17549":101796,"_5":17444,"_23791":101761,"_2388":101797},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2861":59706,"_25124":59689,"_17549":101799,"_5":17444,"_23791":101765,"_2388":101800},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2861":59707,"_25124":59689,"_17549":101802,"_5":17444,"_23791":101765,"_2388":101803},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2861":59708,"_25124":59689,"_17549":101805,"_5":17444,"_23791":101765,"_2388":101806},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2861":59709,"_25124":59689,"_17549":101808,"_5":17444,"_23791":101765,"_2388":101809},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2861":59710,"_25124":59689,"_17549":101811,"_5":17444,"_23791":101765,"_2388":101812},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2861":59711,"_25124":59689,"_17549":101814,"_5":17444,"_23791":101765,"_2388":101815},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2861":59712,"_25124":59689,"_17549":101817,"_5":17444,"_23791":101769,"_2388":101818},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2861":59713,"_25124":59689,"_17549":101820,"_5":17444,"_23791":101769,"_2388":101821},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2861":59714,"_25124":59689,"_17549":101823,"_5":17444,"_23791":101769,"_2388":101824},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2861":59715,"_25124":59689,"_17549":101826,"_5":17444,"_23791":101769,"_2388":101827},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2861":59716,"_25124":59689,"_17549":101829,"_5":17444,"_23791":101769,"_2388":101830},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2861":59717,"_25124":59689,"_17549":101832,"_5":17444,"_23791":101773,"_2388":101833},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2861":59718,"_25124":59689,"_17549":101835,"_5":17444,"_23791":101773,"_2388":101836},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2861":59719,"_25124":59689,"_17549":101838,"_5":17444,"_23791":101773,"_2388":101839},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2861":59720,"_25124":59689,"_17549":101841,"_5":17444,"_23791":101773,"_2388":101842},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2861":59721,"_25124":59689,"_17549":101844,"_5":17444,"_23791":101773,"_2388":101845},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2861":59722,"_25124":59689,"_17549":101847,"_5":17444,"_23791":101773,"_2388":101848},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2861":59723,"_25124":59689,"_17549":101850,"_5":17444,"_23791":101773,"_2388":101851},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2861":59724,"_25124":59689,"_17549":101853,"_5":17444,"_23791":101777,"_2388":101854},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2861":59725,"_25124":59689,"_17549":101856,"_5":17444,"_23791":101781,"_2388":101857},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2861":59726,"_25124":59689,"_17549":101859,"_5":17444,"_23791":101781,"_2388":101860},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2861":59727,"_25124":59689,"_17549":101862,"_5":17444,"_23791":101781,"_2388":101863},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2861":59728,"_25124":59689,"_17549":101865,"_5":17444,"_23791":101781,"_2388":101866},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2861":59729,"_25124":59689,"_17549":101868,"_5":17444,"_23791":101781,"_2388":101869},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2861":59730,"_25124":59689,"_17549":101871,"_5":17444,"_23791":101781,"_2388":101872},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2861":59731,"_25124":59689,"_17549":101874,"_5":17444,"_23791":101781,"_2388":101875},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2861":59732,"_25124":59732,"_5":12314,"_2388":101877,"_25460":101878,"_17549":101879,"_23791":59732},"Listas de revocación (CRL)",[40822,97162,45859,101365],[],{"_2861":59733,"_25124":59732,"_17549":101881,"_5":17444,"_23791":59732,"_2388":101882},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2861":59734,"_25124":59732,"_5":25457,"_17549":101884,"_23791":101885,"_2388":101886},[],"/docs/pr-preview/pr-37/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2861":59735,"_25124":59732,"_5":25457,"_17549":101888,"_23791":101889,"_2388":101890},[],"/docs/pr-preview/pr-37/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2861":59736,"_25124":59732,"_5":25457,"_17549":101892,"_23791":101893,"_2388":101894},[],"/docs/pr-preview/pr-37/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2861":59737,"_25124":59732,"_5":25457,"_17549":101896,"_23791":101897,"_2388":101898},[],"/docs/pr-preview/pr-37/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2861":59738,"_25124":59732,"_5":25457,"_17549":101900,"_23791":101901,"_2388":101902},[],"/docs/pr-preview/pr-37/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2861":59739,"_25124":59732,"_5":25457,"_17549":101904,"_23791":101905,"_2388":101906},[],"/docs/pr-preview/pr-37/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2861":59740,"_25124":59732,"_5":25457,"_17549":101908,"_23791":101909,"_2388":101910},[],"/docs/pr-preview/pr-37/es/platform/pki/crl#referencias","Referencias",{"_2861":59741,"_25124":59732,"_17549":101912,"_5":17444,"_23791":59732,"_2388":101913},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2861":59742,"_25124":59732,"_17549":101915,"_5":17444,"_23791":101885,"_2388":101916},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2861":59743,"_25124":59732,"_17549":101918,"_5":17444,"_23791":101885,"_2388":101919},[],"Campo de `crl_options`",{"_2861":59744,"_25124":59732,"_17549":101921,"_5":17444,"_23791":101885,"_2388":98658},[],{"_2861":59745,"_25124":59732,"_17549":101923,"_5":17444,"_23791":101885,"_2388":101924},[],"Valor inicial del backend",{"_2861":59746,"_25124":59732,"_17549":101926,"_5":17444,"_23791":101885,"_2388":47039},[],{"_2861":59747,"_25124":59732,"_17549":101928,"_5":17444,"_23791":101885,"_2388":101929},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2861":59748,"_25124":59732,"_17549":101931,"_5":17444,"_23791":101885,"_2388":101932},[],"7 días.",{"_2861":59749,"_25124":59732,"_17549":101934,"_5":17444,"_23791":101885,"_2388":47048},[],{"_2861":59750,"_25124":59732,"_17549":101936,"_5":17444,"_23791":101885,"_2388":101937},[],"Plazo desde la publicación que activa la renovación programada.",{"_2861":59751,"_25124":59732,"_17549":101939,"_5":17444,"_23791":101885,"_2388":101940},[],"6 días y 23 horas.",{"_2861":59752,"_25124":59732,"_17549":101942,"_5":17444,"_23791":101885,"_2388":47057},[],{"_2861":59753,"_25124":59732,"_17549":101944,"_5":17444,"_23791":101885,"_2388":101945},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2861":59754,"_25124":59732,"_17549":101947,"_5":17444,"_23791":101885,"_2388":47063},[],{"_2861":59755,"_25124":59732,"_17549":101949,"_5":17444,"_23791":101885,"_2388":47066},[],{"_2861":59756,"_25124":59732,"_17549":101951,"_5":17444,"_23791":101885,"_2388":101952},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2861":59757,"_25124":59732,"_17549":101954,"_5":17444,"_23791":101885,"_2388":101955},[],"SKI de la CA.",{"_2861":59758,"_25124":59732,"_17549":101957,"_5":17444,"_23791":101885,"_2388":101958},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2861":59759,"_25124":59732,"_17549":101960,"_5":17444,"_23791":101885,"_2388":101961},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2861":59760,"_25124":59732,"_17549":101963,"_5":17444,"_23791":101889,"_2388":101964},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2861":59761,"_25124":59732,"_17549":101966,"_5":17444,"_23791":101889,"_2388":101967},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2861":59762,"_25124":59732,"_17549":101969,"_5":17444,"_23791":101889,"_2388":101970},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2861":59763,"_25124":59732,"_17549":101972,"_5":17444,"_23791":101893,"_2388":101973},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2861":59764,"_25124":59732,"_17549":101975,"_5":17444,"_23791":101893,"_2388":101976},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2861":59765,"_25124":59732,"_17549":101978,"_5":17444,"_23791":101897,"_2388":101979},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2861":59766,"_25124":59732,"_17549":101981,"_5":17444,"_23791":101897,"_2388":101982},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2861":59767,"_25124":59732,"_17549":101984,"_5":17444,"_23791":101897,"_2388":101985},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2861":59768,"_25124":59732,"_17549":101987,"_5":17444,"_23791":101897,"_2388":101988},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2861":59769,"_25124":59732,"_17549":101990,"_5":17444,"_23791":101897,"_2388":101991},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2861":59770,"_25124":59732,"_17549":101993,"_5":17444,"_23791":101901,"_2388":101994},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2861":59771,"_25124":59732,"_17549":101996,"_5":17444,"_23791":101901,"_2388":98847},[],{"_2861":59772,"_25124":59732,"_17549":101998,"_5":17444,"_23791":101901,"_2388":101999},[],"Path relativo",{"_2861":59773,"_25124":59732,"_17549":102001,"_5":17444,"_23791":101901,"_2388":96953},[],{"_2861":59774,"_25124":59732,"_17549":102003,"_5":17444,"_23791":101901,"_2388":47121},[],{"_2861":59775,"_25124":59732,"_17549":102005,"_5":17444,"_23791":101901,"_2388":47124},[],{"_2861":59776,"_25124":59732,"_17549":102007,"_5":17444,"_23791":101901,"_2388":102008},[],"Consultar `crl_options` y `latest_crl`.",{"_2861":59777,"_25124":59732,"_17549":102010,"_5":17444,"_23791":101901,"_2388":47130},[],{"_2861":59778,"_25124":59732,"_17549":102012,"_5":17444,"_23791":101901,"_2388":47124},[],{"_2861":59779,"_25124":59732,"_17549":102014,"_5":17444,"_23791":101901,"_2388":102015},[],"Sustituir la configuración de CRL.",{"_2861":59780,"_25124":59732,"_17549":102017,"_5":17444,"_23791":101901,"_2388":102018},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2861":59781,"_25124":59732,"_17549":102020,"_5":17444,"_23791":101901,"_2388":102021},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2861":59782,"_25124":59732,"_17549":102023,"_5":17444,"_23791":101905,"_2388":102024},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2861":59783,"_25124":59732,"_17549":102026,"_5":17444,"_23791":101909,"_2388":102027},[],"RFC 5280: perfil X.509 y CRL.",{"_2861":59784,"_25124":59732,"_17549":102029,"_5":17444,"_23791":101909,"_2388":47150},[],{"_2861":59785,"_25124":59732,"_17549":102031,"_5":17444,"_23791":101909,"_2388":47153},[],{"_2861":59786,"_25124":59732,"_17549":102033,"_5":17444,"_23791":101909,"_2388":102034},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2861":59787,"_25124":59732,"_17549":102036,"_5":17444,"_23791":101909,"_2388":102037},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2861":59788,"_25124":59788,"_5":12314,"_2388":102039,"_25460":102040,"_17549":102041,"_23791":59788},"Claves y motores criptográficos",[40822,97162,45859,100750],[],{"_2861":59789,"_25124":59788,"_17549":102043,"_5":17444,"_23791":59788,"_2388":102044},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2861":59790,"_25124":59788,"_5":25457,"_17549":102046,"_23791":102047,"_2388":102048},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2861":59791,"_25124":59788,"_5":25457,"_17549":102050,"_23791":102051,"_2388":102052},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2861":59792,"_25124":59788,"_5":25457,"_17549":102054,"_23791":102055,"_2388":47178},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#file-system",{"_2861":59793,"_25124":59788,"_5":25457,"_17549":102057,"_23791":102058,"_2388":47182},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#hashicorp-vault",{"_2861":59794,"_25124":59788,"_5":25457,"_17549":102060,"_23791":102061,"_2388":47186},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#aws-secrets-manager",{"_2861":59795,"_25124":59788,"_5":25457,"_17549":102063,"_23791":102064,"_2388":47190},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#aws-kms",{"_2861":59796,"_25124":59788,"_5":25457,"_17549":102066,"_23791":102067,"_2388":47194},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#pkcs11",{"_2861":59797,"_25124":59788,"_5":25457,"_17549":102069,"_23791":102070,"_2388":47198},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#azure-key-vault",{"_2861":59798,"_25124":59788,"_5":25457,"_17549":102072,"_23791":102073,"_2388":102074},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2861":59799,"_25124":59788,"_5":25457,"_17549":102076,"_23791":102077,"_2388":102078},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2861":59800,"_25124":59788,"_5":25457,"_17549":102080,"_23791":102081,"_2388":102082},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2861":59801,"_25124":59788,"_5":25457,"_17549":102084,"_23791":102085,"_2388":102086},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2861":59802,"_25124":59788,"_5":25457,"_17549":102088,"_23791":102089,"_2388":102090},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2861":59803,"_25124":59788,"_5":25457,"_17549":102092,"_23791":102093,"_2388":102094},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2861":59804,"_25124":59788,"_5":25457,"_17549":102096,"_23791":102097,"_2388":102098},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2861":59805,"_25124":59788,"_5":25457,"_17549":102100,"_23791":102101,"_2388":47230},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#sign",{"_2861":59806,"_25124":59788,"_5":25457,"_17549":102103,"_23791":102104,"_2388":47234},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#verify",{"_2861":59807,"_25124":59788,"_5":25457,"_17549":102106,"_23791":102107,"_2388":102108},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2861":59808,"_25124":59788,"_5":25457,"_17549":102110,"_23791":102111,"_2388":102112},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2861":59809,"_25124":59788,"_5":25457,"_17549":102114,"_23791":102115,"_2388":102116},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2861":59810,"_25124":59788,"_17549":102118,"_5":17444,"_23791":59788,"_2388":102119},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2861":59811,"_25124":59788,"_17549":102121,"_5":17444,"_23791":59788,"_2388":102122},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2861":59812,"_25124":59788,"_17549":102124,"_5":17444,"_23791":102047,"_2388":102125},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2861":59813,"_25124":59788,"_17549":102127,"_5":17444,"_23791":102047,"_2388":102128},[],"En la práctica, permite:",{"_2861":59814,"_25124":59788,"_17549":102130,"_5":17444,"_23791":102047,"_2388":102131},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2861":59815,"_25124":59788,"_17549":102133,"_5":17444,"_23791":102047,"_2388":102134},[],"Importar claves creadas externamente.",{"_2861":59816,"_25124":59788,"_17549":102136,"_5":17444,"_23791":102047,"_2388":102137},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2861":59817,"_25124":59788,"_17549":102139,"_5":17444,"_23791":102047,"_2388":102140},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2861":59818,"_25124":59788,"_17549":102142,"_5":17444,"_23791":102051,"_2388":102143},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2861":59819,"_25124":59788,"_17549":102145,"_5":17444,"_23791":102051,"_2388":102146},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2861":59820,"_25124":59788,"_17549":102148,"_5":17444,"_23791":102051,"_2388":102149},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2861":59821,"_25124":59788,"_17549":102151,"_5":17444,"_23791":102055,"_2388":102152},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2861":59822,"_25124":59788,"_17549":102154,"_5":17444,"_23791":102058,"_2388":102155},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2861":59823,"_25124":59788,"_17549":102157,"_5":17444,"_23791":102061,"_2388":102158},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2861":59824,"_25124":59788,"_17549":102160,"_5":17444,"_23791":102064,"_2388":102161},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2861":59825,"_25124":59788,"_17549":102163,"_5":17444,"_23791":102067,"_2388":102164},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2861":59826,"_25124":59788,"_17549":102166,"_5":17444,"_23791":102070,"_2388":102167},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2861":59827,"_25124":59788,"_17549":102169,"_5":17444,"_23791":102070,"_2388":102170},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2861":59828,"_25124":59788,"_17549":102172,"_5":17444,"_23791":102070,"_2388":102173},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2861":59829,"_25124":59788,"_17549":102175,"_5":17444,"_23791":102070,"_2388":102176},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2861":59830,"_25124":59788,"_17549":102178,"_5":17444,"_23791":102073,"_2388":102179},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2861":59831,"_25124":59788,"_17549":102181,"_5":17444,"_23791":102073,"_2388":102182},[],"La tabla incluye los siguientes campos:",{"_2861":59832,"_25124":59788,"_17549":102184,"_5":17444,"_23791":102073,"_2388":102185},[],"**Name**: nombre descriptivo de la clave.",{"_2861":59833,"_25124":59788,"_17549":102187,"_5":17444,"_23791":102073,"_2388":102188},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2861":59834,"_25124":59788,"_17549":102190,"_5":17444,"_23791":102073,"_2388":102191},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2861":59835,"_25124":59788,"_17549":102193,"_5":17444,"_23791":102073,"_2388":102194},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2861":59836,"_25124":59788,"_17549":102196,"_5":17444,"_23791":102073,"_2388":102197},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2861":59837,"_25124":59788,"_17549":102199,"_5":17444,"_23791":102073,"_2388":102200},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2861":59838,"_25124":59788,"_17549":102202,"_5":17444,"_23791":102073,"_2388":102203},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2861":59839,"_25124":59788,"_17549":102205,"_5":17444,"_23791":102073,"_2388":102206},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2861":59840,"_25124":59788,"_17549":102208,"_5":17444,"_23791":102073,"_2388":102209},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2861":59841,"_25124":59788,"_17549":102211,"_5":17444,"_23791":102073,"_2388":102212},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2861":59842,"_25124":59788,"_17549":102214,"_5":17444,"_23791":102073,"_2388":102215},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2861":59843,"_25124":59788,"_17549":102217,"_5":17444,"_23791":102073,"_2388":102218},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2861":59844,"_25124":59788,"_17549":102220,"_5":17444,"_23791":102073,"_2388":102221},[],"**Delete Key** para eliminar la clave del sistema.",{"_2861":59845,"_25124":59788,"_17549":102223,"_5":17444,"_23791":102077,"_2388":102224},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2861":59846,"_25124":59788,"_17549":102226,"_5":17444,"_23791":102081,"_2388":102227},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2861":59847,"_25124":59788,"_17549":102229,"_5":17444,"_23791":102081,"_2388":102230},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2861":59848,"_25124":59788,"_17549":102232,"_5":17444,"_23791":102081,"_2388":102233},[],"**Key Name**: nombre único y descriptivo.",{"_2861":59849,"_25124":59788,"_17549":102235,"_5":17444,"_23791":102081,"_2388":102236},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2861":59850,"_25124":59788,"_17549":102238,"_5":17444,"_23791":102081,"_2388":102239},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2861":59851,"_25124":59788,"_17549":102241,"_5":17444,"_23791":102081,"_2388":102242},[],"**Tags**: metadatos para clasificar la clave.",{"_2861":59852,"_25124":59788,"_17549":102244,"_5":17444,"_23791":102081,"_2388":102245},[],"**Metadata**: información adicional para usos avanzados.",{"_2861":59853,"_25124":59788,"_17549":102247,"_5":17444,"_23791":102085,"_2388":102248},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2861":59854,"_25124":59788,"_17549":102250,"_5":17444,"_23791":102085,"_2388":102251},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2861":59855,"_25124":59788,"_17549":102253,"_5":17444,"_23791":102085,"_2388":102254},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2861":59856,"_25124":59788,"_17549":102256,"_5":17444,"_23791":102085,"_2388":102257},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2861":59857,"_25124":59788,"_17549":102259,"_5":17444,"_23791":102085,"_2388":102260},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2861":59858,"_25124":59788,"_17549":102262,"_5":17444,"_23791":102085,"_2388":102263},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2861":59859,"_25124":59788,"_17549":102265,"_5":17444,"_23791":102085,"_2388":102266},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2861":59860,"_25124":59788,"_17549":102268,"_5":17444,"_23791":102085,"_2388":102269},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2861":59861,"_25124":59788,"_17549":102271,"_5":17444,"_23791":102085,"_2388":102272},[],"**Metadata**: información adicional opcional.",{"_2861":59862,"_25124":59788,"_17549":102274,"_5":17444,"_23791":102085,"_2388":102275},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2861":59863,"_25124":59788,"_17549":102277,"_5":17444,"_23791":102085,"_2388":102278},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2861":59864,"_25124":59788,"_17549":102280,"_5":17444,"_23791":102089,"_2388":102281},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2861":59865,"_25124":59788,"_17549":102283,"_5":17444,"_23791":102093,"_2388":102284},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2861":59866,"_25124":59788,"_17549":102286,"_5":17444,"_23791":102093,"_2388":102287},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2861":59867,"_25124":59788,"_17549":102289,"_5":17444,"_23791":102093,"_2388":102290},[],"**Key Name**: nombre descriptivo.",{"_2861":59868,"_25124":59788,"_17549":102292,"_5":17444,"_23791":102093,"_2388":102293},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2861":59869,"_25124":59788,"_17549":102295,"_5":17444,"_23791":102093,"_2388":102296},[],"**Tags**: etiquetas asociadas.",{"_2861":59870,"_25124":59788,"_17549":102298,"_5":17444,"_23791":102093,"_2388":102299},[],"**Aliases**: nombres alternativos.",{"_2861":59871,"_25124":59788,"_17549":102301,"_5":17444,"_23791":102093,"_2388":102302},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2861":59872,"_25124":59788,"_17549":102304,"_5":17444,"_23791":102093,"_2388":102305},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2861":59873,"_25124":59788,"_17549":102307,"_5":17444,"_23791":102093,"_2388":102308},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2861":59874,"_25124":59788,"_17549":102310,"_5":17444,"_23791":102093,"_2388":102311},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2861":59875,"_25124":59788,"_17549":102313,"_5":17444,"_23791":102097,"_2388":102314},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2861":59876,"_25124":59788,"_17549":102316,"_5":17444,"_23791":102097,"_2388":102317},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2861":59877,"_25124":59788,"_17549":102319,"_5":17444,"_23791":102097,"_2388":102320},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2861":59878,"_25124":59788,"_17549":102322,"_5":17444,"_23791":102101,"_2388":102323},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2861":59879,"_25124":59788,"_17549":102325,"_5":17444,"_23791":102101,"_2388":102326},[],"Campos principales:",{"_2861":59880,"_25124":59788,"_17549":102328,"_5":17444,"_23791":102101,"_2388":102329},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2861":59881,"_25124":59788,"_17549":102331,"_5":17444,"_23791":102101,"_2388":102332},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2861":59882,"_25124":59788,"_17549":102334,"_5":17444,"_23791":102101,"_2388":102335},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2861":59883,"_25124":59788,"_17549":102337,"_5":17444,"_23791":102101,"_2388":102338},[],"**Message**: contenido que se va a firmar.",{"_2861":59884,"_25124":59788,"_17549":102340,"_5":17444,"_23791":102101,"_2388":102341},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2861":59885,"_25124":59788,"_17549":102343,"_5":17444,"_23791":102104,"_2388":102344},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2861":59886,"_25124":59788,"_17549":102346,"_5":17444,"_23791":102104,"_2388":102326},[],{"_2861":59887,"_25124":59788,"_17549":102348,"_5":17444,"_23791":102104,"_2388":102349},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2861":59888,"_25124":59788,"_17549":102351,"_5":17444,"_23791":102104,"_2388":102352},[],"**Message Type**: `Raw` o `Digest`.",{"_2861":59889,"_25124":59788,"_17549":102354,"_5":17444,"_23791":102104,"_2388":102355},[],"**Payload Encoding**: codificación del mensaje.",{"_2861":59890,"_25124":59788,"_17549":102357,"_5":17444,"_23791":102104,"_2388":102358},[],"**Message**: mensaje original o hash.",{"_2861":59891,"_25124":59788,"_17549":102360,"_5":17444,"_23791":102104,"_2388":102361},[],"**Signature**: firma que se desea comprobar.",{"_2861":59892,"_25124":59788,"_17549":102363,"_5":17444,"_23791":102104,"_2388":102364},[],"**Result**: indicador del resultado de la validación.",{"_2861":59893,"_25124":59788,"_17549":102366,"_5":17444,"_23791":102107,"_2388":102367},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2861":59894,"_25124":59788,"_17549":102369,"_5":17444,"_23791":102107,"_2388":102370},[],"Este flujo es útil para:",{"_2861":59895,"_25124":59788,"_17549":102372,"_5":17444,"_23791":102107,"_2388":102373},[],"Solicitar certificados a una CA externa.",{"_2861":59896,"_25124":59788,"_17549":102375,"_5":17444,"_23791":102107,"_2388":102376},[],"Renovar una identidad manteniendo la misma clave.",{"_2861":59897,"_25124":59788,"_17549":102378,"_5":17444,"_23791":102107,"_2388":102379},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2861":59898,"_25124":59788,"_17549":102381,"_5":17444,"_23791":102107,"_2388":102382},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2861":59899,"_25124":59788,"_17549":102384,"_5":17444,"_23791":102107,"_2388":102385},[],"**Organization (O)**: organización o empresa.",{"_2861":59900,"_25124":59788,"_17549":102387,"_5":17444,"_23791":102107,"_2388":102388},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2861":59901,"_25124":59788,"_17549":102390,"_5":17444,"_23791":102107,"_2388":102391},[],"**Country (C)**: código de país de dos letras.",{"_2861":59902,"_25124":59788,"_17549":102393,"_5":17444,"_23791":102107,"_2388":102394},[],"**State / Province (ST)**: estado o provincia.",{"_2861":59903,"_25124":59788,"_17549":102396,"_5":17444,"_23791":102107,"_2388":102397},[],"**Locality (L)**: ciudad o localidad.",{"_2861":59904,"_25124":59788,"_17549":102399,"_5":17444,"_23791":102107,"_2388":102400},[],"**Email Address**: correo de contacto.",{"_2861":59905,"_25124":59788,"_17549":102402,"_5":17444,"_23791":102107,"_2388":102403},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2861":59906,"_25124":59788,"_17549":102405,"_5":17444,"_23791":102107,"_2388":102406},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2861":59907,"_25124":59788,"_17549":102408,"_5":17444,"_23791":102111,"_2388":102409},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2861":59908,"_25124":59788,"_17549":102411,"_5":17444,"_23791":102111,"_2388":47542},[],{"_2861":59909,"_25124":59788,"_17549":102413,"_5":17444,"_23791":102115,"_2388":102414},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2861":59910,"_25124":59910,"_5":12314,"_2388":102416,"_25460":102417,"_17549":102418,"_23791":59910},"Validación online con OCSP",[40822,97162,45859,101365],[],{"_2861":59911,"_25124":59910,"_17549":102420,"_5":17444,"_23791":59910,"_2388":102421},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2861":59912,"_25124":59910,"_5":25457,"_17549":102423,"_23791":102424,"_2388":102425},[],"/docs/pr-preview/pr-37/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2861":59913,"_25124":59910,"_5":25457,"_17549":102427,"_23791":102428,"_2388":102429},[],"/docs/pr-preview/pr-37/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2861":59914,"_25124":59910,"_5":25457,"_17549":102431,"_23791":102432,"_2388":102433},[],"/docs/pr-preview/pr-37/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2861":59915,"_25124":59910,"_5":25457,"_17549":102435,"_23791":102436,"_2388":102437},[],"/docs/pr-preview/pr-37/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2861":59916,"_25124":59910,"_5":25457,"_17549":102439,"_23791":102440,"_2388":102441},[],"/docs/pr-preview/pr-37/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2861":59917,"_25124":59910,"_5":25457,"_17549":102443,"_23791":102444,"_2388":101910},[],"/docs/pr-preview/pr-37/es/platform/pki/ocsp#referencias",{"_2861":59918,"_25124":59910,"_17549":102446,"_5":17444,"_23791":59910,"_2388":102447},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2861":59919,"_25124":59910,"_17549":102449,"_5":17444,"_23791":102424,"_2388":102450},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2861":59920,"_25124":59910,"_17549":102452,"_5":17444,"_23791":102424,"_2388":102453},[],"Estado del registro",{"_2861":59921,"_25124":59910,"_17549":102455,"_5":17444,"_23791":102424,"_2388":102456},[],"Respuesta firmada",{"_2861":59922,"_25124":59910,"_17549":102458,"_5":17444,"_23791":102424,"_2388":45037},[],{"_2861":59923,"_25124":59910,"_17549":102460,"_5":17444,"_23791":102424,"_2388":47592},[],{"_2861":59924,"_25124":59910,"_17549":102462,"_5":17444,"_23791":102424,"_2388":45054},[],{"_2861":59925,"_25124":59910,"_17549":102464,"_5":17444,"_23791":102424,"_2388":102465},[],"`Revoked`, con razón y fecha de revocación.",{"_2861":59926,"_25124":59910,"_17549":102467,"_5":17444,"_23791":102424,"_2388":102468},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2861":59927,"_25124":59910,"_17549":102470,"_5":17444,"_23791":102424,"_2388":102471},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2861":59928,"_25124":59910,"_17549":102473,"_5":17444,"_23791":102424,"_2388":102474},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2861":59929,"_25124":59910,"_17549":102476,"_5":17444,"_23791":102424,"_2388":102477},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2861":59930,"_25124":59910,"_17549":102479,"_5":17444,"_23791":102424,"_2388":102480},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2861":59931,"_25124":59910,"_17549":102482,"_5":17444,"_23791":102428,"_2388":102483},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2861":59932,"_25124":59910,"_17549":102485,"_5":17444,"_23791":102428,"_2388":102486},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2861":59933,"_25124":59910,"_17549":102488,"_5":17444,"_23791":102432,"_2388":102489},[],"El servicio acepta:",{"_2861":59934,"_25124":59910,"_17549":102491,"_5":17444,"_23791":102432,"_2388":98847},[],{"_2861":59935,"_25124":59910,"_17549":102493,"_5":17444,"_23791":102432,"_2388":102494},[],"Ruta del servicio VA",{"_2861":59936,"_25124":59910,"_17549":102496,"_5":17444,"_23791":102432,"_2388":102497},[],"Formato",{"_2861":59937,"_25124":59910,"_17549":102499,"_5":17444,"_23791":102432,"_2388":47632},[],{"_2861":59938,"_25124":59910,"_17549":102501,"_5":17444,"_23791":102432,"_2388":47635},[],{"_2861":59939,"_25124":59910,"_17549":102503,"_5":17444,"_23791":102432,"_2388":102504},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2861":59940,"_25124":59910,"_17549":102506,"_5":17444,"_23791":102432,"_2388":47121},[],{"_2861":59941,"_25124":59910,"_17549":102508,"_5":17444,"_23791":102432,"_2388":47643},[],{"_2861":59942,"_25124":59910,"_17549":102510,"_5":17444,"_23791":102432,"_2388":102511},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2861":59943,"_25124":59910,"_17549":102513,"_5":17444,"_23791":102432,"_2388":102514},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2861":59944,"_25124":59910,"_17549":102516,"_5":17444,"_23791":102436,"_2388":102517},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2861":59945,"_25124":59910,"_17549":102519,"_5":17444,"_23791":102436,"_2388":102520},[],"Genera la solicitud:",{"_2861":59946,"_25124":59910,"_17549":102522,"_5":17444,"_23791":102436,"_2388":102523},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2861":59947,"_25124":59910,"_17549":102525,"_5":17444,"_23791":102436,"_2388":102526},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2861":59948,"_25124":59910,"_17549":102528,"_5":17444,"_23791":102436,"_2388":102529},[],"Verifica el DER recibido:",{"_2861":59949,"_25124":59910,"_17549":102531,"_5":17444,"_23791":102436,"_2388":102532},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2861":59950,"_25124":59910,"_17549":102534,"_5":17444,"_23791":102440,"_2388":102535},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2861":59951,"_25124":59910,"_17549":102537,"_5":17444,"_23791":102440,"_2388":102538},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2861":59952,"_25124":59910,"_17549":102540,"_5":17444,"_23791":102444,"_2388":47676},[],{"_2861":59953,"_25124":59910,"_17549":102542,"_5":17444,"_23791":102444,"_2388":47679},[],{"_2861":59954,"_25124":59910,"_17549":102544,"_5":17444,"_23791":102444,"_2388":102545},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2861":59955,"_25124":59910,"_17549":102547,"_5":17444,"_23791":102444,"_2388":102037},[],{"_2861":59956,"_25124":59956,"_5":12314,"_2388":45859,"_25460":102549,"_17549":102550,"_23791":59956},[40822,97162,45859],[],{"_2861":59957,"_25124":59956,"_17549":102552,"_5":17444,"_23791":59956,"_2388":102553},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2861":59958,"_25124":59956,"_5":25457,"_17549":102555,"_23791":102556,"_2388":100074},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#empieza-aquí",{"_2861":59959,"_25124":59956,"_5":25457,"_17549":102558,"_23791":102559,"_2388":102560},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2861":59960,"_25124":59956,"_5":25457,"_17549":102562,"_23791":102563,"_2388":100596},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#capacidades-principales",{"_2861":59961,"_25124":59956,"_5":25457,"_17549":102565,"_23791":102566,"_2388":100600},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2861":59962,"_25124":59956,"_5":25457,"_17549":102568,"_23791":102569,"_2388":100604},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2861":59963,"_25124":59956,"_5":25457,"_17549":102571,"_23791":102572,"_2388":100608},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#emite-y-controla-certificados",{"_2861":59964,"_25124":59956,"_5":25457,"_17549":102574,"_23791":102575,"_2388":100616},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#publica-el-estado-de-validación",{"_2861":59965,"_25124":59956,"_5":25457,"_17549":102577,"_23791":102578,"_2388":102579},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2861":59966,"_25124":59956,"_5":25457,"_17549":102581,"_23791":102582,"_2388":101531},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#continúa",{"_2861":59967,"_25124":59956,"_17549":102584,"_5":17444,"_23791":59956,"_2388":102585},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2861":59968,"_25124":59956,"_17549":102587,"_5":17444,"_23791":102556,"_2388":102588},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2861":59969,"_25124":59956,"_17549":102590,"_5":17444,"_23791":102556,"_2388":102591},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2861":59970,"_25124":59956,"_17549":102593,"_5":17444,"_23791":102559,"_2388":102594},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2861":59971,"_25124":59956,"_17549":102596,"_5":17444,"_23791":102559,"_2388":102597},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2861":59972,"_25124":59956,"_17549":102599,"_5":17444,"_23791":102559,"_2388":102600},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2861":59973,"_25124":59956,"_17549":102602,"_5":17444,"_23791":102559,"_2388":102603},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2861":59974,"_25124":59956,"_17549":102605,"_5":17444,"_23791":102559,"_2388":102606},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2861":59975,"_25124":59956,"_17549":102608,"_5":17444,"_23791":102566,"_2388":102609},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2861":59976,"_25124":59956,"_17549":102611,"_5":17444,"_23791":102569,"_2388":102612},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2861":59977,"_25124":59956,"_17549":102614,"_5":17444,"_23791":102572,"_2388":102615},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2861":59978,"_25124":59956,"_17549":102617,"_5":17444,"_23791":102575,"_2388":102618},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2861":59979,"_25124":59956,"_17549":102620,"_5":17444,"_23791":102578,"_2388":102621},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2861":59980,"_25124":59956,"_17549":102623,"_5":17444,"_23791":102578,"_2388":102624},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2861":59981,"_25124":59956,"_17549":102626,"_5":17444,"_23791":102578,"_2388":102627},[],"su clave pública corresponda a la clave privada del cliente;",{"_2861":59982,"_25124":59956,"_17549":102629,"_5":17444,"_23791":102578,"_2388":102630},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2861":59983,"_25124":59956,"_17549":102632,"_5":17444,"_23791":102578,"_2388":102633},[],"sus fechas y usos permitan la operación;",{"_2861":59984,"_25124":59956,"_17549":102635,"_5":17444,"_23791":102578,"_2388":102636},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2861":59985,"_25124":59956,"_17549":102638,"_5":17444,"_23791":102578,"_2388":102639},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2861":59986,"_25124":59956,"_17549":102641,"_5":17444,"_23791":102582,"_2388":102642},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2861":59987,"_25124":59956,"_17549":102644,"_5":17444,"_23791":102582,"_2388":102645},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2861":59988,"_25124":59956,"_17549":102647,"_5":17444,"_23791":102582,"_2388":102648},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2861":59989,"_25124":59989,"_5":12314,"_2388":102650,"_25460":102651,"_17549":102652,"_23791":59989},"Crea tu primera CA",[40822,97162,45859,100198],[],{"_2861":59990,"_25124":59989,"_17549":102654,"_5":17444,"_23791":59989,"_2388":102655},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2861":59991,"_25124":59989,"_5":25457,"_17549":102657,"_23791":102658,"_2388":95863},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2861":59992,"_25124":59989,"_5":25457,"_17549":102660,"_23791":102661,"_2388":102662},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2861":59993,"_25124":59989,"_5":25457,"_17549":102664,"_23791":102665,"_2388":102666},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2861":59994,"_25124":59989,"_5":25457,"_17549":102668,"_23791":102669,"_2388":102670},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2861":59995,"_25124":59989,"_5":25457,"_17549":102672,"_23791":102673,"_2388":102674},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2861":59996,"_25124":59989,"_5":25457,"_17549":102676,"_23791":102677,"_2388":102678},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2861":59997,"_25124":59989,"_5":25457,"_17549":102680,"_23791":102681,"_2388":102682},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2861":59998,"_25124":59989,"_5":25457,"_17549":102684,"_23791":102685,"_2388":100446},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2861":59999,"_25124":59989,"_5":25457,"_17549":102687,"_23791":102688,"_2388":95887},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2861":60000,"_25124":59989,"_17549":102690,"_5":17444,"_23791":59989,"_2388":102691},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2861":60001,"_25124":59989,"_17549":102693,"_5":17444,"_23791":102658,"_2388":102694},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2861":60002,"_25124":59989,"_17549":102696,"_5":17444,"_23791":102658,"_2388":102697},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2861":60003,"_25124":59989,"_17549":102699,"_5":17444,"_23791":102658,"_2388":102700},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2861":60004,"_25124":59989,"_17549":102702,"_5":17444,"_23791":102658,"_2388":102703},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2861":60005,"_25124":59989,"_17549":102705,"_5":17444,"_23791":102661,"_2388":102706},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2861":60006,"_25124":59989,"_17549":102708,"_5":17444,"_23791":102661,"_2388":102709},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2861":60007,"_25124":59989,"_17549":102711,"_5":17444,"_23791":102665,"_2388":102712},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2861":60008,"_25124":59989,"_17549":102714,"_5":17444,"_23791":102665,"_2388":102715},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2861":60009,"_25124":59989,"_17549":102717,"_5":17444,"_23791":102669,"_2388":102718},[],"Selecciona **Root CA** y completa:",{"_2861":60010,"_25124":59989,"_17549":102720,"_5":17444,"_23791":102669,"_2388":47858},[],{"_2861":60011,"_25124":59989,"_17549":102722,"_5":17444,"_23791":102669,"_2388":102723},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2861":60012,"_25124":59989,"_17549":102725,"_5":17444,"_23791":102669,"_2388":102726},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2861":60013,"_25124":59989,"_17549":102728,"_5":17444,"_23791":102669,"_2388":102729},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2861":60014,"_25124":59989,"_17549":102731,"_5":17444,"_23791":102669,"_2388":102732},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2861":60015,"_25124":59989,"_17549":102734,"_5":17444,"_23791":102673,"_2388":102735},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2861":60016,"_25124":59989,"_17549":102737,"_5":17444,"_23791":102677,"_2388":102738},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2861":60017,"_25124":59989,"_17549":102740,"_5":17444,"_23791":102677,"_2388":102741},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2861":60018,"_25124":59989,"_17549":102743,"_5":17444,"_23791":102681,"_2388":102744},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2861":60019,"_25124":59989,"_17549":102746,"_5":17444,"_23791":102681,"_2388":102747},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2861":60020,"_25124":59989,"_17549":102749,"_5":17444,"_23791":102681,"_2388":102750},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2861":60021,"_25124":59989,"_17549":102752,"_5":17444,"_23791":102685,"_2388":102753},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2861":60022,"_25124":59989,"_17549":102755,"_5":17444,"_23791":102685,"_2388":102756},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2861":60023,"_25124":59989,"_17549":102758,"_5":17444,"_23791":102685,"_2388":102759},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2861":60024,"_25124":59989,"_17549":102761,"_5":17444,"_23791":102685,"_2388":102762},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2861":60025,"_25124":59989,"_17549":102764,"_5":17444,"_23791":102688,"_2388":102765},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2861":60026,"_25124":60026,"_5":12314,"_2388":102767,"_25460":102768,"_17549":102769,"_23791":60026},"Emite y verifica un certificado",[40822,97162,45859,100198],[],{"_2861":60027,"_25124":60026,"_17549":102771,"_5":17444,"_23791":60026,"_2388":102772},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2861":60028,"_25124":60026,"_5":25457,"_17549":102774,"_23791":102775,"_2388":95863},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2861":60029,"_25124":60026,"_5":25457,"_17549":102777,"_23791":102778,"_2388":102779},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2861":60030,"_25124":60026,"_5":25457,"_17549":102781,"_23791":102782,"_2388":102783},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2861":60031,"_25124":60026,"_5":25457,"_17549":102785,"_23791":102786,"_2388":102787},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2861":60032,"_25124":60026,"_5":25457,"_17549":102789,"_23791":102790,"_2388":102791},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2861":60033,"_25124":60026,"_5":25457,"_17549":102793,"_23791":102794,"_2388":102795},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2861":60034,"_25124":60026,"_5":25457,"_17549":102797,"_23791":102798,"_2388":102678},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2861":60035,"_25124":60026,"_5":25457,"_17549":102800,"_23791":102801,"_2388":102802},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2861":60036,"_25124":60026,"_5":25457,"_17549":102804,"_23791":102805,"_2388":102806},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2861":60037,"_25124":60026,"_5":25457,"_17549":102808,"_23791":102809,"_2388":102810},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2861":60038,"_25124":60026,"_5":25457,"_17549":102812,"_23791":102813,"_2388":100446},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2861":60039,"_25124":60026,"_5":25457,"_17549":102815,"_23791":102816,"_2388":95887},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2861":60040,"_25124":60026,"_17549":102818,"_5":17444,"_23791":60026,"_2388":102819},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2861":60041,"_25124":60026,"_17549":102821,"_5":17444,"_23791":102775,"_2388":102822},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2861":60042,"_25124":60026,"_17549":102824,"_5":17444,"_23791":102775,"_2388":102825},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2861":60043,"_25124":60026,"_17549":102827,"_5":17444,"_23791":102775,"_2388":102828},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2861":60044,"_25124":60026,"_17549":102830,"_5":17444,"_23791":102775,"_2388":102831},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2861":60045,"_25124":60026,"_17549":102833,"_5":17444,"_23791":102775,"_2388":102834},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2861":60046,"_25124":60026,"_17549":102836,"_5":17444,"_23791":102778,"_2388":102837},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2861":60047,"_25124":60026,"_17549":102839,"_5":17444,"_23791":102782,"_2388":102840},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2861":60048,"_25124":60026,"_17549":102842,"_5":17444,"_23791":102782,"_2388":102843},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2861":60049,"_25124":60026,"_17549":102845,"_5":17444,"_23791":102786,"_2388":102846},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2861":60050,"_25124":60026,"_17549":102848,"_5":17444,"_23791":102786,"_2388":102849},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2861":60051,"_25124":60026,"_17549":102851,"_5":17444,"_23791":102790,"_2388":102852},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2861":60052,"_25124":60026,"_17549":102854,"_5":17444,"_23791":102790,"_2388":102855},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2861":60053,"_25124":60026,"_17549":102857,"_5":17444,"_23791":102794,"_2388":102858},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2861":60054,"_25124":60026,"_17549":102860,"_5":17444,"_23791":102798,"_2388":102861},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2861":60055,"_25124":60026,"_17549":102863,"_5":17444,"_23791":102801,"_2388":102864},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2861":60056,"_25124":60026,"_17549":102866,"_5":17444,"_23791":102805,"_2388":102867},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2861":60057,"_25124":60026,"_17549":102869,"_5":17444,"_23791":102805,"_2388":102870},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2861":60058,"_25124":60026,"_17549":102872,"_5":17444,"_23791":102805,"_2388":102873},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2861":60059,"_25124":60026,"_17549":102875,"_5":17444,"_23791":102809,"_2388":102876},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2861":60060,"_25124":60026,"_17549":102878,"_5":17444,"_23791":102809,"_2388":102879},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2861":60061,"_25124":60026,"_17549":102881,"_5":17444,"_23791":102809,"_2388":102882},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2861":60062,"_25124":60026,"_17549":102884,"_5":17444,"_23791":102813,"_2388":100529},[],{"_2861":60063,"_25124":60026,"_17549":102886,"_5":17444,"_23791":102813,"_2388":99296},[],{"_2861":60064,"_25124":60026,"_17549":102888,"_5":17444,"_23791":102813,"_2388":102889},[],"La CA rechaza la emisión",{"_2861":60065,"_25124":60026,"_17549":102891,"_5":17444,"_23791":102813,"_2388":102892},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2861":60066,"_25124":60026,"_17549":102894,"_5":17444,"_23791":102813,"_2388":102895},[],"Sujeto o usos diferentes",{"_2861":60067,"_25124":60026,"_17549":102897,"_5":17444,"_23791":102813,"_2388":102898},[],"Perfil aplicado y valores solicitados.",{"_2861":60068,"_25124":60026,"_17549":102900,"_5":17444,"_23791":102813,"_2388":102901},[],"No se encuentra el emisor",{"_2861":60069,"_25124":60026,"_17549":102903,"_5":17444,"_23791":102813,"_2388":102904},[],"CA descargada y cadena intermedia necesaria.",{"_2861":60070,"_25124":60026,"_17549":102906,"_5":17444,"_23791":102813,"_2388":102907},[],"Falla la vigencia",{"_2861":60071,"_25124":60026,"_17549":102909,"_5":17444,"_23791":102813,"_2388":102910},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2861":60072,"_25124":60026,"_17549":102912,"_5":17444,"_23791":102813,"_2388":102913},[],"Los resúmenes de clave difieren",{"_2861":60073,"_25124":60026,"_17549":102915,"_5":17444,"_23791":102813,"_2388":102916},[],"Archivos de certificado y clave de la misma emisión.",{"_2861":60074,"_25124":60026,"_17549":102918,"_5":17444,"_23791":102813,"_2388":102919},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2861":60075,"_25124":60026,"_17549":102921,"_5":17444,"_23791":102816,"_2388":102922},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2861":60076,"_25124":60026,"_17549":102924,"_5":17444,"_23791":102816,"_2388":102925},[],"Gestionar certificados para inspección, estado y revocación.",{"_2861":60077,"_25124":60026,"_17549":102927,"_5":17444,"_23791":102816,"_2388":102928},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2861":60078,"_25124":60026,"_17549":102930,"_5":17444,"_23791":102816,"_2388":102931},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2861":60079,"_25124":60026,"_17549":102933,"_5":17444,"_23791":102816,"_2388":102934},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2861":60080,"_25124":60080,"_5":12314,"_2388":102936,"_25460":102937,"_17549":102938,"_23791":60080},"Primeros pasos de PKI",[40822,97162,45859,100198],[],{"_2861":60081,"_25124":60080,"_17549":102940,"_5":17444,"_23791":60080,"_2388":102941},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2861":60082,"_25124":60080,"_5":25457,"_17549":102943,"_23791":102944,"_2388":95863},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2861":60083,"_25124":60080,"_5":25457,"_17549":102946,"_23791":102947,"_2388":102948},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2861":60084,"_25124":60080,"_5":25457,"_17549":102950,"_23791":102951,"_2388":100380},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2861":60085,"_25124":60080,"_5":25457,"_17549":102953,"_23791":102954,"_2388":102955},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2861":60086,"_25124":60080,"_17549":102957,"_5":17444,"_23791":60080,"_2388":102958},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2861":60087,"_25124":60080,"_17549":102960,"_5":17444,"_23791":102944,"_2388":102961},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2861":60088,"_25124":60080,"_17549":102963,"_5":17444,"_23791":102944,"_2388":102964},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2861":60089,"_25124":60080,"_17549":102966,"_5":17444,"_23791":102944,"_2388":102967},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2861":60090,"_25124":60080,"_17549":102969,"_5":17444,"_23791":102944,"_2388":102970},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2861":60091,"_25124":60080,"_17549":102972,"_5":17444,"_23791":102944,"_2388":102973},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2861":60092,"_25124":60080,"_17549":102975,"_5":17444,"_23791":102947,"_2388":102976},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2861":60093,"_25124":60080,"_17549":102978,"_5":17444,"_23791":102947,"_2388":102979},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2861":60094,"_25124":60080,"_17549":102981,"_5":17444,"_23791":102947,"_2388":102982},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2861":60095,"_25124":60080,"_17549":102984,"_5":17444,"_23791":102947,"_2388":102985},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2861":60096,"_25124":60080,"_17549":102987,"_5":17444,"_23791":102951,"_2388":102988},[],"Archivo o recurso",{"_2861":60097,"_25124":60080,"_17549":102990,"_5":17444,"_23791":102951,"_2388":100377},[],{"_2861":60098,"_25124":60080,"_17549":102992,"_5":17444,"_23791":102951,"_2388":102993},[],"CA raíz activa y `ca.pem`",{"_2861":60099,"_25124":60080,"_17549":102995,"_5":17444,"_23791":102951,"_2388":102996},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2861":60100,"_25124":60080,"_17549":102998,"_5":17444,"_23791":102951,"_2388":102999},[],"Certificado final y `device.crt`",{"_2861":60101,"_25124":60080,"_17549":103001,"_5":17444,"_23791":102951,"_2388":103002},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2861":60102,"_25124":60080,"_17549":103004,"_5":17444,"_23791":102951,"_2388":103005},[],"Clave privada `device.key`",{"_2861":60103,"_25124":60080,"_17549":103007,"_5":17444,"_23791":102951,"_2388":103008},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2861":60104,"_25124":60080,"_17549":103010,"_5":17444,"_23791":102951,"_2388":103011},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2861":60105,"_25124":60080,"_17549":103013,"_5":17444,"_23791":102954,"_2388":103014},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2861":60106,"_25124":60080,"_17549":103016,"_5":17444,"_23791":102954,"_2388":103017},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2861":60107,"_25124":60080,"_17549":103019,"_5":17444,"_23791":102954,"_2388":103020},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2861":60108,"_25124":60108,"_5":12314,"_2388":103022,"_25460":103023,"_17549":103025,"_23791":60108},"Resolución de problemas PKI",[40822,97162,45859,103024],"Resolución de problemas",[],{"_2861":60109,"_25124":60108,"_17549":103027,"_5":17444,"_23791":60108,"_2388":103028},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2861":60110,"_25124":60108,"_5":25457,"_17549":103030,"_23791":103031,"_2388":103032},[],"/docs/pr-preview/pr-37/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2861":60111,"_25124":60108,"_5":25457,"_17549":103034,"_23791":103035,"_2388":103036},[],"/docs/pr-preview/pr-37/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2861":60112,"_25124":60108,"_5":25457,"_17549":103038,"_23791":103039,"_2388":103040},[],"/docs/pr-preview/pr-37/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2861":60113,"_25124":60108,"_17549":103042,"_5":17444,"_23791":60108,"_2388":103043},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2861":60114,"_25124":60108,"_17549":103045,"_5":17444,"_23791":60108,"_2388":103046},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2861":60115,"_25124":60108,"_17549":103048,"_5":17444,"_23791":103031,"_2388":100377},[],{"_2861":60116,"_25124":60108,"_17549":103050,"_5":17444,"_23791":103031,"_2388":99296},[],{"_2861":60117,"_25124":60108,"_17549":103052,"_5":17444,"_23791":103031,"_2388":95887},[],{"_2861":60118,"_25124":60108,"_17549":103054,"_5":17444,"_23791":103031,"_2388":48194},[],{"_2861":60119,"_25124":60108,"_17549":103056,"_5":17444,"_23791":103031,"_2388":103057},[],"Existe, está activa y sus fechas son utilizables.",{"_2861":60120,"_25124":60108,"_17549":103059,"_5":17444,"_23791":103031,"_2388":103060},[],"Autoridades.",{"_2861":60121,"_25124":60108,"_17549":103062,"_5":17444,"_23791":103031,"_2388":103063},[],"Clave",{"_2861":60122,"_25124":60108,"_17549":103065,"_5":17444,"_23791":103031,"_2388":103066},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2861":60123,"_25124":60108,"_17549":103068,"_5":17444,"_23791":103031,"_2388":103069},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2861":60124,"_25124":60108,"_17549":103071,"_5":17444,"_23791":103031,"_2388":48212},[],{"_2861":60125,"_25124":60108,"_17549":103073,"_5":17444,"_23791":103031,"_2388":103074},[],"PEM correcto y firma verificable.",{"_2861":60126,"_25124":60108,"_17549":103076,"_5":17444,"_23791":103031,"_2388":48218},[],{"_2861":60127,"_25124":60108,"_17549":103078,"_5":17444,"_23791":103031,"_2388":103079},[],"Perfil",{"_2861":60128,"_25124":60108,"_17549":103081,"_5":17444,"_23791":103031,"_2388":103082},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2861":60129,"_25124":60108,"_17549":103084,"_5":17444,"_23791":103031,"_2388":103085},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2861":60130,"_25124":60108,"_17549":103087,"_5":17444,"_23791":103031,"_2388":100529},[],{"_2861":60131,"_25124":60108,"_17549":103089,"_5":17444,"_23791":103031,"_2388":103090},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2861":60132,"_25124":60108,"_17549":103092,"_5":17444,"_23791":103031,"_2388":103093},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2861":60133,"_25124":60108,"_17549":103095,"_5":17444,"_23791":103031,"_2388":103096},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2861":60134,"_25124":60108,"_17549":103098,"_5":17444,"_23791":103031,"_2388":103099},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2861":60135,"_25124":60108,"_17549":103101,"_5":17444,"_23791":103035,"_2388":103102},[],"Revisa cada frontera por separado:",{"_2861":60136,"_25124":60108,"_17549":103104,"_5":17444,"_23791":103035,"_2388":103105},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2861":60137,"_25124":60108,"_17549":103107,"_5":17444,"_23791":103035,"_2388":103108},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2861":60138,"_25124":60108,"_17549":103110,"_5":17444,"_23791":103035,"_2388":103111},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2861":60139,"_25124":60108,"_17549":103113,"_5":17444,"_23791":103035,"_2388":103114},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2861":60140,"_25124":60108,"_17549":103116,"_5":17444,"_23791":103035,"_2388":103117},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2861":60141,"_25124":60108,"_17549":103119,"_5":17444,"_23791":103035,"_2388":103120},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2861":60142,"_25124":60108,"_17549":103122,"_5":17444,"_23791":103039,"_2388":103123},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2861":60143,"_25124":60108,"_17549":103125,"_5":17444,"_23791":103039,"_2388":103126},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_48272":103128,"_48274":103129,"_48276":103130,"_48278":103131,"_15254":2410,"_57769":2410},"spanish",[2388,25124,5,23791],{"_2388":20940,"_25124":20940,"_5":20940,"_23791":20940},{"_2388":103132,"_25124":105503,"_5":107874,"_23791":110245},{"_3835":103133,"_48282":103134,"_5":20940},{"_12054":23793,"_12402":5701,"_12409":6442,"_24337":3943,"_23904":6203,"_16663":3622,"_12075":9220,"_12082":2916,"_24299":4935,"_24649":4514,"_24670":3105,"_24312":6166,"_28922":9225,"_24681":6906,"_28927