_33518":48074,"_33520":48077,"_33522":48080,"_33524":48083,"_33526":48086,"_33528":48090,"_33530":48093,"_33532":48096,"_33534":48100,"_33536":48103,"_33538":48107,"_33540":48110,"_33542":48113,"_33544":48116,"_33546":48119,"_33548":48122,"_33550":48125,"_33552":48128,"_33554":48131,"_33556":48134,"_33558":48137,"_33560":48140,"_33562":48142,"_33564":48145,"_33566":48148,"_33568":48151,"_33570":48154,"_33572":48157,"_33574":48160,"_33576":48163,"_33578":48166,"_33580":48169,"_33582":48172,"_33584":48176,"_33586":48179,"_33588":48183,"_33590":48187,"_33592":48191,"_33594":48194,"_33596":48197,"_33598":48199,"_33600":48202,"_33602":48204,"_33604":48207,"_33606":48210,"_33608":48213,"_33610":48216,"_33612":48219,"_33614":48222,"_33616":48225,"_33618":48228,"_33620":48231,"_33622":48234,"_33624":48237,"_33626":48240,"_33628":48242,"_33630":48245,"_33632":48248,"_33634":48251,"_33636":48254,"_33638":48257,"_33640":48260,"_33642":48263,"_33644":48266,"_33646":48269,"_33648":48272,"_33650":48275,"_33652":48278},{"_2861":15,"_25133":15,"_5":12309,"_2388":40832,"_25469":40833,"_17569":40837,"_23818":15},"Deploy from AWS Marketplace",[40834,40835,40836],"Docs","Deployment","Other models",[],{"_2861":16,"_25133":15,"_17569":40839,"_5":17464,"_23818":15,"_2388":40840},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2861":17,"_25133":15,"_5":25466,"_17569":40842,"_23818":40843,"_2388":40844},[],"/docs/pr-preview/pr-37/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2861":18,"_25133":15,"_5":25466,"_17569":40846,"_23818":40847,"_2388":40848},[],"/docs/pr-preview/pr-37/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2861":19,"_25133":15,"_5":25466,"_17569":40850,"_23818":40851,"_2388":40852},[],"/docs/pr-preview/pr-37/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2861":20,"_25133":15,"_5":25466,"_17569":40854,"_23818":40855,"_2388":40856},[],"/docs/pr-preview/pr-37/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2861":21,"_25133":15,"_5":25466,"_17569":40858,"_23818":40859,"_2388":40860},[],"/docs/pr-preview/pr-37/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2861":22,"_25133":15,"_5":25466,"_17569":40862,"_23818":40863,"_2388":40864},[],"/docs/pr-preview/pr-37/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2861":23,"_25133":15,"_5":25466,"_17569":40866,"_23818":40867,"_2388":40868},[],"/docs/pr-preview/pr-37/deployment/aws-marketplace#next-step","Next step",{"_2861":24,"_25133":15,"_17569":40870,"_5":17464,"_23818":15,"_2388":40871},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2861":25,"_25133":15,"_17569":40873,"_5":17464,"_23818":40843,"_2388":40874},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2861":26,"_25133":15,"_17569":40876,"_5":17464,"_23818":40843,"_2388":40877},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2861":27,"_25133":15,"_17569":40879,"_5":17464,"_23818":40843,"_2388":40880},[],"A security group allowing the necessary endpoints.",{"_2861":28,"_25133":15,"_17569":40882,"_5":17464,"_23818":40847,"_2388":40883},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2861":29,"_25133":15,"_17569":40885,"_5":17464,"_23818":40847,"_2388":40886},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2861":30,"_25133":15,"_17569":40888,"_5":17464,"_23818":40847,"_2388":40889},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2861":31,"_25133":15,"_17569":40891,"_5":17464,"_23818":40851,"_2388":40892},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2861":32,"_25133":15,"_17569":40894,"_5":17464,"_23818":40855,"_2388":40895},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2861":33,"_25133":15,"_17569":40897,"_5":17464,"_23818":40859,"_2388":40898},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2861":34,"_25133":15,"_17569":40900,"_5":17464,"_23818":40863,"_2388":40901},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2861":35,"_25133":15,"_17569":40903,"_5":17464,"_23818":40867,"_2388":40904},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2861":36,"_25133":36,"_5":12309,"_2388":40906,"_25469":40907,"_17569":40908,"_23818":36},"Deploy Lamassu",[40834,40835],[],{"_2861":37,"_25133":36,"_17569":40910,"_5":17464,"_23818":36,"_2388":40911},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2861":38,"_25133":36,"_5":25466,"_17569":40913,"_23818":40914,"_2388":40915},[],"/docs/pr-preview/pr-37/deployment/overview#choose-a-model","Choose a model",{"_2861":39,"_25133":36,"_5":25466,"_17569":40917,"_23818":40918,"_2388":40919},[],"/docs/pr-preview/pr-37/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2861":40,"_25133":36,"_5":25466,"_17569":40921,"_23818":40922,"_2388":40923},[],"/docs/pr-preview/pr-37/deployment/overview#after-deployment","After deployment",{"_2861":41,"_25133":36,"_17569":40925,"_5":17464,"_23818":36,"_2388":40926},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2861":42,"_25133":36,"_17569":40928,"_5":17464,"_23818":40914,"_2388":40929},[],"Model",{"_2861":43,"_25133":36,"_17569":40931,"_5":17464,"_23818":40914,"_2388":40932},[],"Recommended for",{"_2861":44,"_25133":36,"_17569":40934,"_5":17464,"_23818":40914,"_2388":40935},[],"Who operates the infrastructure",{"_2861":45,"_25133":36,"_17569":40937,"_5":17464,"_23818":40914,"_2388":40938},[],"Starting point",{"_2861":46,"_25133":36,"_17569":40940,"_5":17464,"_23818":40914,"_2388":40941},[],"Kubernetes self-managed",{"_2861":47,"_25133":36,"_17569":40943,"_5":17464,"_23818":40914,"_2388":40944},[],"Production, regulated environments and custom deployments",{"_2861":48,"_25133":36,"_17569":40946,"_5":17464,"_23818":40914,"_2388":40947},[],"Your team",{"_2861":49,"_25133":36,"_17569":40949,"_5":17464,"_23818":40914,"_2388":40950},[],"Helm or Fastlane",{"_2861":50,"_25133":36,"_17569":40952,"_5":17464,"_23818":40914,"_2388":40953},[],"AWS Marketplace",{"_2861":51,"_25133":36,"_17569":40955,"_5":17464,"_23818":40914,"_2388":40956},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2861":52,"_25133":36,"_17569":40958,"_5":17464,"_23818":40914,"_2388":40947},[],{"_2861":53,"_25133":36,"_17569":40960,"_5":17464,"_23818":40914,"_2388":40961},[],"Preconfigured image on EC2",{"_2861":54,"_25133":36,"_17569":40963,"_5":17464,"_23818":40914,"_2388":40964},[],"SaaS",{"_2861":55,"_25133":36,"_17569":40966,"_5":17464,"_23818":40914,"_2388":40967},[],"Teams that want to use the platform without operating it",{"_2861":56,"_25133":36,"_17569":40969,"_5":17464,"_23818":40914,"_2388":40970},[],"Lamassu",{"_2861":57,"_25133":36,"_17569":40972,"_5":17464,"_23818":40914,"_2388":40973},[],"Managed subscription",{"_2861":58,"_25133":36,"_17569":40975,"_5":17464,"_23818":40914,"_2388":40976},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2861":59,"_25133":36,"_17569":40978,"_5":17464,"_23818":40914,"_2388":40979},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2861":60,"_25133":36,"_17569":40981,"_5":17464,"_23818":40914,"_2388":40982},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2861":61,"_25133":36,"_17569":40984,"_5":17464,"_23818":40918,"_2388":40985},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2861":62,"_25133":36,"_17569":40987,"_5":17464,"_23818":40922,"_2388":40988},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2861":63,"_25133":63,"_5":12309,"_2388":40990,"_25469":40991,"_17569":40992,"_23818":63},"Use Lamassu as SaaS",[40834,40835,40836],[],{"_2861":64,"_25133":63,"_17569":40994,"_5":17464,"_23818":63,"_2388":40995},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2861":65,"_25133":63,"_5":25466,"_17569":40997,"_23818":40998,"_2388":40999},[],"/docs/pr-preview/pr-37/deployment/saas#what-the-service-manages","What the service manages",{"_2861":66,"_25133":63,"_5":25466,"_17569":41001,"_23818":41002,"_2388":41003},[],"/docs/pr-preview/pr-37/deployment/saas#plans","Plans",{"_2861":67,"_25133":63,"_5":25466,"_17569":41005,"_23818":41006,"_2388":41007},[],"/docs/pr-preview/pr-37/deployment/saas#request-access","Request access",{"_2861":68,"_25133":63,"_17569":41009,"_5":17464,"_23818":63,"_2388":41010},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2861":69,"_25133":63,"_17569":41012,"_5":17464,"_23818":40998,"_2388":41013},[],"Platform availability and maintenance.",{"_2861":70,"_25133":63,"_17569":41015,"_5":17464,"_23818":40998,"_2388":41016},[],"Automatic backups.",{"_2861":71,"_25133":63,"_17569":41018,"_5":17464,"_23818":40998,"_2388":41019},[],"Version upgrades.",{"_2861":72,"_25133":63,"_17569":41021,"_5":17464,"_23818":40998,"_2388":41022},[],"Technical support and SLA according to your plan.",{"_2861":73,"_25133":63,"_17569":41024,"_5":17464,"_23818":41002,"_2388":41025},[],"Plan",{"_2861":74,"_25133":63,"_17569":41027,"_5":17464,"_23818":41002,"_2388":41028},[],"Devices",{"_2861":75,"_25133":63,"_17569":41030,"_5":17464,"_23818":41002,"_2388":41031},[],"Support",{"_2861":76,"_25133":63,"_17569":41033,"_5":17464,"_23818":41002,"_2388":41034},[],"SLA",{"_2861":77,"_25133":63,"_17569":41036,"_5":17464,"_23818":41002,"_2388":41037},[],"Starter",{"_2861":78,"_25133":63,"_17569":41039,"_5":17464,"_23818":41002,"_2388":41040},[],"Up to 1,000",{"_2861":79,"_25133":63,"_17569":41042,"_5":17464,"_23818":41002,"_2388":41043},[],"Email",{"_2861":80,"_25133":63,"_17569":41045,"_5":17464,"_23818":41002,"_2388":41046},[],"99.5 %",{"_2861":81,"_25133":63,"_17569":41048,"_5":17464,"_23818":41002,"_2388":41049},[],"Professional",{"_2861":82,"_25133":63,"_17569":41051,"_5":17464,"_23818":41002,"_2388":41052},[],"Up to 10,000",{"_2861":83,"_25133":63,"_17569":41054,"_5":17464,"_23818":41002,"_2388":41055},[],"Email and chat",{"_2861":84,"_25133":63,"_17569":41057,"_5":17464,"_23818":41002,"_2388":41058},[],"99.9 %",{"_2861":85,"_25133":63,"_17569":41060,"_5":17464,"_23818":41002,"_2388":41061},[],"Enterprise",{"_2861":86,"_25133":63,"_17569":41063,"_5":17464,"_23818":41002,"_2388":41064},[],"Unlimited",{"_2861":87,"_25133":63,"_17569":41066,"_5":17464,"_23818":41002,"_2388":41067},[],"Dedicated",{"_2861":88,"_25133":63,"_17569":41069,"_5":17464,"_23818":41002,"_2388":41070},[],"99.99 %",{"_2861":89,"_25133":63,"_17569":41072,"_5":17464,"_23818":41006,"_2388":41073},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2861":90,"_25133":63,"_17569":41075,"_5":17464,"_23818":41006,"_2388":41076},[],"When you receive your instance's credentials, continue with Get started.",{"_2861":91,"_25133":91,"_5":12309,"_2388":41078,"_25469":41079,"_17569":41080,"_23818":91},"Fastlane",[40834,40835,40941],[],{"_2861":92,"_25133":91,"_17569":41082,"_5":17464,"_23818":91,"_2388":41083},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2861":93,"_25133":91,"_5":25466,"_17569":41085,"_23818":41086,"_2388":41087},[],"/docs/pr-preview/pr-37/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2861":94,"_25133":91,"_5":25466,"_17569":41089,"_23818":41090,"_2388":41091},[],"/docs/pr-preview/pr-37/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2861":95,"_25133":91,"_5":25466,"_17569":41093,"_23818":41094,"_2388":40844},[],"/docs/pr-preview/pr-37/deployment/self-hosted/fastlane#before-you-begin",{"_2861":96,"_25133":91,"_5":25466,"_17569":41096,"_23818":41097,"_2388":41098},[],"/docs/pr-preview/pr-37/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2861":97,"_25133":91,"_5":25466,"_17569":41100,"_23818":41101,"_2388":41102},[],"/docs/pr-preview/pr-37/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2861":98,"_25133":91,"_5":25466,"_17569":41104,"_23818":41105,"_2388":41106},[],"/docs/pr-preview/pr-37/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2861":99,"_25133":91,"_5":25466,"_17569":41108,"_23818":41109,"_2388":41110},[],"/docs/pr-preview/pr-37/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2861":100,"_25133":91,"_5":25466,"_17569":41112,"_23818":41113,"_2388":41114},[],"/docs/pr-preview/pr-37/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2861":101,"_25133":91,"_5":25466,"_17569":41116,"_23818":41117,"_2388":41118},[],"/docs/pr-preview/pr-37/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2861":102,"_25133":91,"_5":25466,"_17569":41120,"_23818":41121,"_2388":41122},[],"/docs/pr-preview/pr-37/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2861":103,"_25133":91,"_17569":41124,"_5":17464,"_23818":41086,"_2388":41125},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2861":104,"_25133":91,"_17569":41127,"_5":17464,"_23818":41086,"_2388":41128},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2861":105,"_25133":91,"_17569":41130,"_5":17464,"_23818":41090,"_2388":41131},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2861":106,"_25133":91,"_17569":41133,"_5":17464,"_23818":41090,"_2388":41134},[],"Fastlane installs or configures",{"_2861":107,"_25133":91,"_17569":41136,"_5":17464,"_23818":41090,"_2388":41137},[],"You still provide",{"_2861":108,"_25133":91,"_17569":41139,"_5":17464,"_23818":41090,"_2388":41140},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2861":109,"_25133":91,"_17569":41142,"_5":17464,"_23818":41090,"_2388":41143},[],"The Kubernetes cluster, nodes and persistent storage",{"_2861":110,"_25133":91,"_17569":41145,"_5":17464,"_23818":41090,"_2388":41146},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2861":111,"_25133":91,"_17569":41148,"_5":17464,"_23818":41090,"_2388":41149},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2861":112,"_25133":91,"_17569":41151,"_5":17464,"_23818":41090,"_2388":41152},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2861":113,"_25133":91,"_17569":41154,"_5":17464,"_23818":41090,"_2388":41155},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2861":114,"_25133":91,"_17569":41157,"_5":17464,"_23818":41090,"_2388":41158},[],"Optional observability and lab HSM components",{"_2861":115,"_25133":91,"_17569":41160,"_5":17464,"_23818":41090,"_2388":41161},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2861":116,"_25133":91,"_17569":41163,"_5":17464,"_23818":41090,"_2388":41164},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2861":117,"_25133":91,"_17569":41166,"_5":17464,"_23818":41094,"_2388":41167},[],"You need:",{"_2861":118,"_25133":91,"_17569":41169,"_5":17464,"_23818":41094,"_2388":41170},[],"an existing Kubernetes cluster",{"_2861":119,"_25133":91,"_17569":41172,"_5":17464,"_23818":41094,"_2388":41173},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2861":120,"_25133":91,"_17569":41175,"_5":17464,"_23818":41094,"_2388":41176},[],"`yq`",{"_2861":121,"_25133":91,"_17569":41178,"_5":17464,"_23818":41094,"_2388":19881},[],{"_2861":122,"_25133":91,"_17569":41180,"_5":17464,"_23818":41094,"_2388":41181},[],"`jq` only when using `--sample-data`",{"_2861":123,"_25133":91,"_17569":41183,"_5":17464,"_23818":41094,"_2388":41184},[],"free external ports 80 and 443 on a single-node K3s host",{"_2861":124,"_25133":91,"_17569":41186,"_5":17464,"_23818":41094,"_2388":41187},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2861":125,"_25133":91,"_17569":41189,"_5":17464,"_23818":41094,"_2388":41190},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2861":126,"_25133":91,"_17569":41192,"_5":17464,"_23818":41097,"_2388":41193},[],"Run the script from a clone of the Helm repository:",{"_2861":127,"_25133":91,"_17569":41195,"_5":17464,"_23818":41097,"_2388":41196},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2861":128,"_25133":91,"_17569":41198,"_5":17464,"_23818":41101,"_2388":41199},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2861":129,"_25133":91,"_17569":41201,"_5":17464,"_23818":41101,"_2388":41202},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2861":130,"_25133":91,"_17569":41204,"_5":17464,"_23818":41101,"_2388":41205},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2861":131,"_25133":91,"_17569":41207,"_5":17464,"_23818":41101,"_2388":41208},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2861":132,"_25133":91,"_17569":41210,"_5":17464,"_23818":41105,"_2388":41211},[],"Option",{"_2861":133,"_25133":91,"_17569":41213,"_5":17464,"_23818":41105,"_2388":41214},[],"Default",{"_2861":134,"_25133":91,"_17569":41216,"_5":17464,"_23818":41105,"_2388":41217},[],"Purpose",{"_2861":135,"_25133":91,"_17569":41219,"_5":17464,"_23818":41105,"_2388":41220},[],"`-h`, `--help`",{"_2861":136,"_25133":91,"_17569":41222,"_5":17464,"_23818":41105,"_2388":41223},[],"—",{"_2861":137,"_25133":91,"_17569":41225,"_5":17464,"_23818":41105,"_2388":41226},[],"Show help",{"_2861":138,"_25133":91,"_17569":41228,"_5":17464,"_23818":41105,"_2388":41229},[],"`-c`, `--context`",{"_2861":139,"_25133":91,"_17569":41231,"_5":17464,"_23818":41105,"_2388":41232},[],"current context",{"_2861":140,"_25133":91,"_17569":41234,"_5":17464,"_23818":41105,"_2388":41235},[],"Select the kubeconfig context for kubectl and Helm",{"_2861":141,"_25133":91,"_17569":41237,"_5":17464,"_23818":41105,"_2388":41238},[],"`-n`, `--non-interactive`",{"_2861":142,"_25133":91,"_17569":41240,"_5":17464,"_23818":41105,"_2388":5349},[],{"_2861":143,"_25133":91,"_17569":41242,"_5":17464,"_23818":41105,"_2388":41243},[],"Skip prompts and generate dependency credentials",{"_2861":144,"_25133":91,"_17569":41245,"_5":17464,"_23818":41105,"_2388":41246},[],"`-ns`, `--namespace`",{"_2861":145,"_25133":91,"_17569":41248,"_5":17464,"_23818":41105,"_2388":41249},[],"`lamassu-dev`",{"_2861":146,"_25133":91,"_17569":41251,"_5":17464,"_23818":41105,"_2388":41252},[],"Namespace for the installation",{"_2861":147,"_25133":91,"_17569":41254,"_5":17464,"_23818":41105,"_2388":41255},[],"`-d`, `--domain`",{"_2861":148,"_25133":91,"_17569":41257,"_5":17464,"_23818":41105,"_2388":41258},[],"`dev.lamassu.io`",{"_2861":149,"_25133":91,"_17569":41260,"_5":17464,"_23818":41105,"_2388":41261},[],"Domain used by the UI, OIDC and certificate",{"_2861":150,"_25133":91,"_17569":41263,"_5":17464,"_23818":41105,"_2388":41264},[],"`-v`, `--version`",{"_2861":151,"_25133":91,"_17569":41266,"_5":17464,"_23818":41105,"_2388":12535},[],{"_2861":152,"_25133":91,"_17569":41268,"_5":17464,"_23818":41105,"_2388":41269},[],"Lamassu chart version",{"_2861":153,"_25133":91,"_17569":41271,"_5":17464,"_23818":41105,"_2388":41272},[],"`--https-port`",{"_2861":154,"_25133":91,"_17569":41274,"_5":17464,"_23818":41105,"_2388":41275},[],"`443`",{"_2861":155,"_25133":91,"_17569":41277,"_5":17464,"_23818":41105,"_2388":41278},[],"Gateway HTTPS listener port",{"_2861":156,"_25133":91,"_17569":41280,"_5":17464,"_23818":41105,"_2388":41281},[],"`--http-port`",{"_2861":157,"_25133":91,"_17569":41283,"_5":17464,"_23818":41105,"_2388":41284},[],"`80`",{"_2861":158,"_25133":91,"_17569":41286,"_5":17464,"_23818":41105,"_2388":41287},[],"Gateway HTTP listener port",{"_2861":159,"_25133":91,"_17569":41289,"_5":17464,"_23818":41105,"_2388":41290},[],"`--tls-crt`",{"_2861":160,"_25133":91,"_17569":41292,"_5":17464,"_23818":41105,"_2388":41223},[],{"_2861":161,"_25133":91,"_17569":41294,"_5":17464,"_23818":41105,"_2388":41295},[],"PEM certificate for downstream TLS",{"_2861":162,"_25133":91,"_17569":41297,"_5":17464,"_23818":41105,"_2388":41298},[],"`--tls-key`",{"_2861":163,"_25133":91,"_17569":41300,"_5":17464,"_23818":41105,"_2388":41223},[],{"_2861":164,"_25133":91,"_17569":41302,"_5":17464,"_23818":41105,"_2388":41303},[],"PEM private key for downstream TLS",{"_2861":165,"_25133":91,"_17569":41305,"_5":17464,"_23818":41105,"_2388":41306},[],"`-l`, `--local-chart-path`",{"_2861":166,"_25133":91,"_17569":41308,"_5":17464,"_23818":41105,"_2388":41309},[],"repository chart",{"_2861":167,"_25133":91,"_17569":41311,"_5":17464,"_23818":41105,"_2388":41312},[],"Use an unpacked local Lamassu chart",{"_2861":168,"_25133":91,"_17569":41314,"_5":17464,"_23818":41105,"_2388":41315},[],"`-ip`, `--gateway-ip`",{"_2861":169,"_25133":91,"_17569":41317,"_5":17464,"_23818":41105,"_2388":7262},[],{"_2861":170,"_25133":91,"_17569":41319,"_5":17464,"_23818":41105,"_2388":41320},[],"Override the address written to `gateway.addresses`",{"_2861":171,"_25133":91,"_17569":41322,"_5":17464,"_23818":41105,"_2388":41323},[],"`--otel`",{"_2861":172,"_25133":91,"_17569":41325,"_5":17464,"_23818":41105,"_2388":5349},[],{"_2861":173,"_25133":91,"_17569":41327,"_5":17464,"_23818":41105,"_2388":41328},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2861":174,"_25133":91,"_17569":41330,"_5":17464,"_23818":41105,"_2388":41331},[],"`--sample-data`",{"_2861":175,"_25133":91,"_17569":41333,"_5":17464,"_23818":41105,"_2388":5349},[],{"_2861":176,"_25133":91,"_17569":41335,"_5":17464,"_23818":41105,"_2388":41336},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2861":177,"_25133":91,"_17569":41338,"_5":17464,"_23818":41105,"_2388":41339},[],"`--with-hsm`",{"_2861":178,"_25133":91,"_17569":41341,"_5":17464,"_23818":41105,"_2388":5349},[],{"_2861":179,"_25133":91,"_17569":41343,"_5":17464,"_23818":41105,"_2388":41344},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2861":180,"_25133":91,"_17569":41346,"_5":17464,"_23818":41105,"_2388":41347},[],"`--softhsm-chart-path`",{"_2861":181,"_25133":91,"_17569":41349,"_5":17464,"_23818":41105,"_2388":41350},[],"`./charts/softhsm`",{"_2861":182,"_25133":91,"_17569":41352,"_5":17464,"_23818":41105,"_2388":41353},[],"Use a different local SoftHSM chart",{"_2861":183,"_25133":91,"_17569":41355,"_5":17464,"_23818":41105,"_2388":41356},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2861":184,"_25133":91,"_17569":41358,"_5":17464,"_23818":41109,"_2388":41359},[],"Fastlane:",{"_2861":185,"_25133":91,"_17569":41361,"_5":17464,"_23818":41109,"_2388":41362},[],"validates local tools and the selected cluster",{"_2861":186,"_25133":91,"_17569":41364,"_5":17464,"_23818":41109,"_2388":41365},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2861":187,"_25133":91,"_17569":41367,"_5":17464,"_23818":41109,"_2388":41368},[],"creates the namespace",{"_2861":188,"_25133":91,"_17569":41370,"_5":17464,"_23818":41109,"_2388":41371},[],"installs PostgreSQL and creates the required databases",{"_2861":189,"_25133":91,"_17569":41373,"_5":17464,"_23818":41109,"_2388":41374},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2861":190,"_25133":91,"_17569":41376,"_5":17464,"_23818":41109,"_2388":41377},[],"installs RabbitMQ",{"_2861":191,"_25133":91,"_17569":41379,"_5":17464,"_23818":41109,"_2388":41380},[],"optionally installs observability and lab HSM components",{"_2861":192,"_25133":91,"_17569":41382,"_5":17464,"_23818":41109,"_2388":41383},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2861":193,"_25133":91,"_17569":41385,"_5":17464,"_23818":41109,"_2388":41386},[],"optionally loads sample data",{"_2861":194,"_25133":91,"_17569":41388,"_5":17464,"_23818":41109,"_2388":41389},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2861":195,"_25133":91,"_17569":41391,"_5":17464,"_23818":41113,"_2388":41392},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2861":196,"_25133":91,"_17569":41394,"_5":17464,"_23818":41113,"_2388":41395},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2861":197,"_25133":91,"_17569":41397,"_5":17464,"_23818":41117,"_2388":41398},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2861":198,"_25133":91,"_17569":41400,"_5":17464,"_23818":41117,"_2388":41401},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2861":199,"_25133":91,"_17569":41403,"_5":17464,"_23818":41117,"_2388":41404},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2861":200,"_25133":91,"_17569":41406,"_5":17464,"_23818":41121,"_2388":41407},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2861":201,"_25133":201,"_5":12309,"_2388":41409,"_25469":41410,"_17569":41411,"_23818":201},"Install with Helm",[40834,40835,40941],[],{"_2861":202,"_25133":201,"_17569":41413,"_5":17464,"_23818":201,"_2388":41414},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2861":203,"_25133":201,"_5":25466,"_17569":41416,"_23818":41417,"_2388":41418},[],"/docs/pr-preview/pr-37/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2861":204,"_25133":201,"_5":25466,"_17569":41420,"_23818":41421,"_2388":40844},[],"/docs/pr-preview/pr-37/deployment/self-hosted/helm#before-you-begin",{"_2861":205,"_25133":201,"_5":25466,"_17569":41423,"_23818":41424,"_2388":41425},[],"/docs/pr-preview/pr-37/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2861":206,"_25133":201,"_5":25466,"_17569":41427,"_23818":41428,"_2388":41429},[],"/docs/pr-preview/pr-37/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2861":207,"_25133":201,"_5":25466,"_17569":41431,"_23818":41432,"_2388":41433},[],"/docs/pr-preview/pr-37/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2861":208,"_25133":201,"_5":25466,"_17569":41435,"_23818":41436,"_2388":41437},[],"/docs/pr-preview/pr-37/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2861":209,"_25133":201,"_5":25466,"_17569":41439,"_23818":41440,"_2388":41441},[],"/docs/pr-preview/pr-37/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2861":210,"_25133":201,"_5":25466,"_17569":41443,"_23818":41444,"_2388":41445},[],"/docs/pr-preview/pr-37/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2861":211,"_25133":201,"_5":25466,"_17569":41447,"_23818":41448,"_2388":41449},[],"/docs/pr-preview/pr-37/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2861":212,"_25133":201,"_17569":41451,"_5":17464,"_23818":41417,"_2388":41452},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2861":213,"_25133":201,"_17569":41454,"_5":17464,"_23818":41421,"_2388":41455},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2861":214,"_25133":201,"_17569":41457,"_5":17464,"_23818":41421,"_2388":41458},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2861":215,"_25133":201,"_17569":41460,"_5":17464,"_23818":41421,"_2388":41461},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2861":216,"_25133":201,"_17569":41463,"_5":17464,"_23818":41421,"_2388":41464},[],"a reachable RabbitMQ broker and credentials",{"_2861":217,"_25133":201,"_17569":41466,"_5":17464,"_23818":41421,"_2388":41467},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2861":218,"_25133":201,"_17569":41469,"_5":17464,"_23818":41421,"_2388":41470},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2861":219,"_25133":201,"_17569":41472,"_5":17464,"_23818":41421,"_2388":41473},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2861":220,"_25133":201,"_17569":41475,"_5":17464,"_23818":41421,"_2388":41476},[],"a StorageClass and an external traffic design",{"_2861":221,"_25133":201,"_17569":41478,"_5":17464,"_23818":41421,"_2388":41479},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2861":222,"_25133":201,"_17569":41481,"_5":17464,"_23818":41421,"_2388":41482},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2861":223,"_25133":201,"_17569":41484,"_5":17464,"_23818":41421,"_2388":41485},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2861":224,"_25133":201,"_17569":41487,"_5":17464,"_23818":41424,"_2388":41488},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2861":225,"_25133":201,"_17569":41490,"_5":17464,"_23818":41424,"_2388":41491},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2861":226,"_25133":201,"_17569":41493,"_5":17464,"_23818":41424,"_2388":41494},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2861":227,"_25133":201,"_17569":41496,"_5":17464,"_23818":41428,"_2388":41497},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2861":228,"_25133":201,"_17569":41499,"_5":17464,"_23818":41428,"_2388":41500},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2861":229,"_25133":201,"_17569":41502,"_5":17464,"_23818":41428,"_2388":41503},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2861":230,"_25133":201,"_17569":41505,"_5":17464,"_23818":41432,"_2388":41506},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2861":231,"_25133":201,"_17569":41508,"_5":17464,"_23818":41436,"_2388":41509},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2861":232,"_25133":201,"_17569":41511,"_5":17464,"_23818":41436,"_2388":41512},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2861":233,"_25133":201,"_17569":41514,"_5":17464,"_23818":41436,"_2388":41515},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2861":234,"_25133":201,"_17569":41517,"_5":17464,"_23818":41436,"_2388":41518},[],"See Access control for the principal and policy model.",{"_2861":235,"_25133":201,"_17569":41520,"_5":17464,"_23818":41440,"_2388":41521},[],"To install a local checkout instead:",{"_2861":236,"_25133":201,"_17569":41523,"_5":17464,"_23818":41444,"_2388":41524},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2861":237,"_25133":201,"_17569":41526,"_5":17464,"_23818":41444,"_2388":41527},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2861":238,"_25133":201,"_17569":41529,"_5":17464,"_23818":41448,"_2388":41530},[],"Before going live, review:",{"_2861":239,"_25133":201,"_17569":41532,"_5":17464,"_23818":41448,"_2388":41533},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2861":240,"_25133":201,"_17569":41535,"_5":17464,"_23818":41448,"_2388":41536},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2861":241,"_25133":201,"_17569":41538,"_5":17464,"_23818":41448,"_2388":41539},[],"shared VA storage before increasing VA replicas",{"_2861":242,"_25133":201,"_17569":41541,"_5":17464,"_23818":41448,"_2388":41542},[],"managed OIDC roles and removal of evaluation credentials",{"_2861":243,"_25133":201,"_17569":41544,"_5":17464,"_23818":41448,"_2388":41545},[],"a trusted TLS issuer or externally managed certificate",{"_2861":244,"_25133":201,"_17569":41547,"_5":17464,"_23818":41448,"_2388":41548},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2861":245,"_25133":201,"_17569":41550,"_5":17464,"_23818":41448,"_2388":41551},[],"SMTP, observability and alert delivery",{"_2861":246,"_25133":201,"_17569":41553,"_5":17464,"_23818":41448,"_2388":41554},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2861":247,"_25133":201,"_17569":41556,"_5":17464,"_23818":41448,"_2388":41557},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2861":248,"_25133":248,"_5":12309,"_2388":41559,"_25469":41560,"_17569":41561,"_23818":248},"Expose the Gateway",[40834,40835,40941],[],{"_2861":249,"_25133":248,"_17569":41563,"_5":17464,"_23818":248,"_2388":41564},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2861":250,"_25133":248,"_5":25466,"_17569":41566,"_23818":41567,"_2388":41568},[],"/docs/pr-preview/pr-37/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2861":251,"_25133":248,"_5":25466,"_17569":41570,"_23818":41571,"_2388":41572},[],"/docs/pr-preview/pr-37/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2861":252,"_25133":248,"_5":25466,"_17569":41574,"_23818":41575,"_2388":41576},[],"/docs/pr-preview/pr-37/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2861":253,"_25133":248,"_5":25466,"_17569":41578,"_23818":41579,"_2388":41580},[],"/docs/pr-preview/pr-37/deployment/self-hosted/networking#k3s","K3s",{"_2861":254,"_25133":248,"_5":25466,"_17569":41582,"_23818":41583,"_2388":41584},[],"/docs/pr-preview/pr-37/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2861":255,"_25133":248,"_5":25466,"_17569":41586,"_23818":41587,"_2388":41588},[],"/docs/pr-preview/pr-37/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2861":256,"_25133":248,"_5":25466,"_17569":41590,"_23818":41591,"_2388":41592},[],"/docs/pr-preview/pr-37/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2861":257,"_25133":248,"_5":25466,"_17569":41594,"_23818":41595,"_2388":41596},[],"/docs/pr-preview/pr-37/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2861":258,"_25133":248,"_5":25466,"_17569":41598,"_23818":41599,"_2388":41600},[],"/docs/pr-preview/pr-37/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2861":259,"_25133":248,"_17569":41602,"_5":17464,"_23818":41567,"_2388":41603},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2861":260,"_25133":248,"_17569":41605,"_5":17464,"_23818":41567,"_2388":41606},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2861":261,"_25133":248,"_17569":41608,"_5":17464,"_23818":41571,"_2388":41609},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2861":262,"_25133":248,"_17569":41611,"_5":17464,"_23818":41571,"_2388":41612},[],"Set it only when:",{"_2861":263,"_25133":248,"_17569":41614,"_5":17464,"_23818":41571,"_2388":41615},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2861":264,"_25133":248,"_17569":41617,"_5":17464,"_23818":41571,"_2388":41618},[],"that address is allocated to this Gateway",{"_2861":265,"_25133":248,"_17569":41620,"_5":17464,"_23818":41571,"_2388":41621},[],"the surrounding network already routes traffic for it to the cluster",{"_2861":266,"_25133":248,"_17569":41623,"_5":17464,"_23818":41571,"_2388":41624},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2861":267,"_25133":248,"_17569":41626,"_5":17464,"_23818":41571,"_2388":41627},[],"Keep these two settings separate:",{"_2861":268,"_25133":248,"_17569":41629,"_5":17464,"_23818":41571,"_2388":41630},[],"`gateway.addresses` requests an address for the Gateway.",{"_2861":269,"_25133":248,"_17569":41632,"_5":17464,"_23818":41571,"_2388":41633},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2861":270,"_25133":248,"_17569":41635,"_5":17464,"_23818":41571,"_2388":41636},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2861":271,"_25133":248,"_17569":41638,"_5":17464,"_23818":41575,"_2388":41639},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2861":272,"_25133":248,"_17569":41641,"_5":17464,"_23818":41575,"_2388":41642},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2861":273,"_25133":248,"_17569":41644,"_5":17464,"_23818":41579,"_2388":41645},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2861":274,"_25133":248,"_17569":41647,"_5":17464,"_23818":41579,"_2388":41648},[],"For the recommended design:",{"_2861":275,"_25133":248,"_17569":41650,"_5":17464,"_23818":41579,"_2388":41651},[],"Use only one externally exposed Lamassu Gateway.",{"_2861":276,"_25133":248,"_17569":41653,"_5":17464,"_23818":41579,"_2388":41654},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2861":277,"_25133":248,"_17569":41656,"_5":17464,"_23818":41579,"_2388":41657},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2861":278,"_25133":248,"_17569":41659,"_5":17464,"_23818":41579,"_2388":41660},[],"Point DNS at the VM's reachable address.",{"_2861":279,"_25133":248,"_17569":41662,"_5":17464,"_23818":41579,"_2388":41663},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2861":280,"_25133":248,"_17569":41665,"_5":17464,"_23818":41583,"_2388":41666},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2861":281,"_25133":248,"_17569":41668,"_5":17464,"_23818":41587,"_2388":41669},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2861":282,"_25133":248,"_17569":41671,"_5":17464,"_23818":41587,"_2388":41672},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2861":283,"_25133":248,"_17569":41674,"_5":17464,"_23818":41591,"_2388":41675},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2861":284,"_25133":248,"_17569":41677,"_5":17464,"_23818":41591,"_2388":41678},[],"Requirement",{"_2861":285,"_25133":248,"_17569":41680,"_5":17464,"_23818":41591,"_2388":41681},[],"Recommended design",{"_2861":286,"_25133":248,"_17569":41683,"_5":17464,"_23818":41591,"_2388":41684},[],"Consequence",{"_2861":287,"_25133":248,"_17569":41686,"_5":17464,"_23818":41591,"_2388":41687},[],"Several Lamassu URLs or services",{"_2861":288,"_25133":248,"_17569":41689,"_5":17464,"_23818":41591,"_2388":41690},[],"One Gateway with multiple routes",{"_2861":289,"_25133":248,"_17569":41692,"_5":17464,"_23818":41591,"_2388":41693},[],"One IP and one proxy fleet; this is the chart default",{"_2861":290,"_25133":248,"_17569":41695,"_5":17464,"_23818":41591,"_2388":41696},[],"Independent Gateways and separate external IPs",{"_2861":291,"_25133":248,"_17569":41698,"_5":17464,"_23818":41591,"_2388":41699},[],"One VIP per Gateway",{"_2861":292,"_25133":248,"_17569":41701,"_5":17464,"_23818":41591,"_2388":41702},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2861":293,"_25133":248,"_17569":41704,"_5":17464,"_23818":41591,"_2388":41705},[],"Independent Gateways on one node and one IP",{"_2861":294,"_25133":248,"_17569":41707,"_5":17464,"_23818":41591,"_2388":41708},[],"Use different external ports",{"_2861":295,"_25133":248,"_17569":41710,"_5":17464,"_23818":41591,"_2388":41711},[],"Clients must include non-standard ports",{"_2861":296,"_25133":248,"_17569":41713,"_5":17464,"_23818":41591,"_2388":41714},[],"Separate TLS/mTLS termination behind one IP",{"_2861":297,"_25133":248,"_17569":41716,"_5":17464,"_23818":41591,"_2388":41717},[],"Front-door SNI routing to internal Gateways",{"_2861":298,"_25133":248,"_17569":41719,"_5":17464,"_23818":41591,"_2388":41720},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2861":299,"_25133":248,"_17569":41722,"_5":17464,"_23818":41591,"_2388":41723},[],"Separate Gateway resources but shared proxy infrastructure",{"_2861":300,"_25133":248,"_17569":41725,"_5":17464,"_23818":41591,"_2388":41726},[],"Envoy merged-Gateway mode",{"_2861":301,"_25133":248,"_17569":41728,"_5":17464,"_23818":41591,"_2388":41729},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2861":302,"_25133":248,"_17569":41731,"_5":17464,"_23818":41591,"_2388":41732},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2861":303,"_25133":248,"_17569":41734,"_5":17464,"_23818":41591,"_2388":41735},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2861":304,"_25133":248,"_17569":41737,"_5":17464,"_23818":41591,"_2388":41738},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2861":305,"_25133":248,"_17569":41740,"_5":17464,"_23818":41591,"_2388":41741},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2861":306,"_25133":248,"_17569":41743,"_5":17464,"_23818":41595,"_2388":41744},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2861":307,"_25133":248,"_17569":41746,"_5":17464,"_23818":41595,"_2388":41747},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2861":308,"_25133":248,"_17569":41749,"_5":17464,"_23818":41595,"_2388":41750},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2861":309,"_25133":248,"_17569":41752,"_5":17464,"_23818":41595,"_2388":41753},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2861":310,"_25133":248,"_17569":41755,"_5":17464,"_23818":41595,"_2388":41756},[],"If none of those are possible, use different external ports or change the external network design.",{"_2861":311,"_25133":248,"_17569":41758,"_5":17464,"_23818":41599,"_2388":41759},[],"Check, in order:",{"_2861":312,"_25133":248,"_17569":41761,"_5":17464,"_23818":41599,"_2388":41762},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2861":313,"_25133":248,"_17569":41764,"_5":17464,"_23818":41599,"_2388":41765},[],"Its status contains the expected address.",{"_2861":314,"_25133":248,"_17569":41767,"_5":17464,"_23818":41599,"_2388":41768},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2861":315,"_25133":248,"_17569":41770,"_5":17464,"_23818":41599,"_2388":41771},[],"Port 443 reaches that address from the client network.",{"_2861":316,"_25133":248,"_17569":41773,"_5":17464,"_23818":41599,"_2388":41774},[],"DNS resolves to the externally reachable endpoint.",{"_2861":317,"_25133":248,"_17569":41776,"_5":17464,"_23818":41599,"_2388":41777},[],"The certificate contains the DNS name or IP used by the client.",{"_2861":318,"_25133":248,"_17569":41779,"_5":17464,"_23818":41599,"_2388":41780},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2861":319,"_25133":319,"_5":12309,"_2388":40941,"_25469":41782,"_17569":41783,"_23818":319},[40834,40835,40941],[],{"_2861":320,"_25133":319,"_17569":41785,"_5":17464,"_23818":319,"_2388":41786},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2861":321,"_25133":319,"_5":25466,"_17569":41788,"_23818":41789,"_2388":41790},[],"/docs/pr-preview/pr-37/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2861":322,"_25133":319,"_5":25466,"_17569":41792,"_23818":41793,"_2388":41794},[],"/docs/pr-preview/pr-37/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2861":323,"_25133":319,"_5":25466,"_17569":41796,"_23818":41797,"_2388":41798},[],"/docs/pr-preview/pr-37/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2861":324,"_25133":319,"_5":25466,"_17569":41800,"_23818":41801,"_2388":41802},[],"/docs/pr-preview/pr-37/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2861":325,"_25133":319,"_5":25466,"_17569":41804,"_23818":41805,"_2388":41806},[],"/docs/pr-preview/pr-37/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2861":326,"_25133":319,"_5":25466,"_17569":41808,"_23818":41809,"_2388":41810},[],"/docs/pr-preview/pr-37/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2861":327,"_25133":319,"_17569":41812,"_5":17464,"_23818":41789,"_2388":41813},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2861":328,"_25133":319,"_17569":41815,"_5":17464,"_23818":41793,"_2388":41816},[],"Workflow",{"_2861":329,"_25133":319,"_17569":41818,"_5":17464,"_23818":41793,"_2388":41819},[],"Use it for",{"_2861":330,"_25133":319,"_17569":41821,"_5":17464,"_23818":41793,"_2388":41822},[],"What it installs",{"_2861":331,"_25133":319,"_17569":41824,"_5":17464,"_23818":41793,"_2388":41825},[],"Helm",{"_2861":332,"_25133":319,"_17569":41827,"_5":17464,"_23818":41793,"_2388":41828},[],"Production and controlled environments",{"_2861":333,"_25133":319,"_17569":41830,"_5":17464,"_23818":41793,"_2388":41831},[],"Lamassu services and Gateway API resources",{"_2861":334,"_25133":319,"_17569":41833,"_5":17464,"_23818":41793,"_2388":41078},[],{"_2861":335,"_25133":319,"_17569":41835,"_5":17464,"_23818":41793,"_2388":41836},[],"Evaluation, demos, CI and small lab clusters",{"_2861":336,"_25133":319,"_17569":41838,"_5":17464,"_23818":41793,"_2388":41839},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2861":337,"_25133":319,"_17569":41841,"_5":17464,"_23818":41797,"_2388":41842},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2861":338,"_25133":319,"_17569":41844,"_5":17464,"_23818":41797,"_2388":41845},[],"Area",{"_2861":339,"_25133":319,"_17569":41847,"_5":17464,"_23818":41797,"_2388":41848},[],"The Lamassu chart provides",{"_2861":340,"_25133":319,"_17569":41850,"_5":17464,"_23818":41797,"_2388":41851},[],"You provide",{"_2861":341,"_25133":319,"_17569":41853,"_5":17464,"_23818":41797,"_2388":41854},[],"Lamassu applications",{"_2861":342,"_25133":319,"_17569":41856,"_5":17464,"_23818":41797,"_2388":41857},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2861":343,"_25133":319,"_17569":41859,"_5":17464,"_23818":41797,"_2388":41860},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2861":344,"_25133":319,"_17569":41862,"_5":17464,"_23818":41797,"_2388":41863},[],"PostgreSQL data",{"_2861":345,"_25133":319,"_17569":41865,"_5":17464,"_23818":41797,"_2388":41866},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2861":346,"_25133":319,"_17569":41868,"_5":17464,"_23818":41797,"_2388":41869},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2861":347,"_25133":319,"_17569":41871,"_5":17464,"_23818":41797,"_2388":41872},[],"Messaging",{"_2861":348,"_25133":319,"_17569":41874,"_5":17464,"_23818":41797,"_2388":41875},[],"RabbitMQ connection configuration for the Lamassu services",{"_2861":349,"_25133":319,"_17569":41877,"_5":17464,"_23818":41797,"_2388":41878},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2861":350,"_25133":319,"_17569":41880,"_5":17464,"_23818":41797,"_2388":41881},[],"Identity",{"_2861":351,"_25133":319,"_17569":41883,"_5":17464,"_23818":41797,"_2388":41884},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2861":352,"_25133":319,"_17569":41886,"_5":17464,"_23818":41797,"_2388":41887},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2861":353,"_25133":319,"_17569":41889,"_5":17464,"_23818":41797,"_2388":41890},[],"External routing",{"_2861":354,"_25133":319,"_17569":41892,"_5":17464,"_23818":41797,"_2388":41893},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2861":355,"_25133":319,"_17569":41895,"_5":17464,"_23818":41797,"_2388":41896},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2861":356,"_25133":319,"_17569":41898,"_5":17464,"_23818":41797,"_2388":41899},[],"TLS",{"_2861":357,"_25133":319,"_17569":41901,"_5":17464,"_23818":41797,"_2388":41902},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2861":358,"_25133":319,"_17569":41904,"_5":17464,"_23818":41797,"_2388":41905},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2861":359,"_25133":319,"_17569":41907,"_5":17464,"_23818":41797,"_2388":41908},[],"Persistent application data",{"_2861":360,"_25133":319,"_17569":41910,"_5":17464,"_23818":41797,"_2388":41911},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2861":361,"_25133":319,"_17569":41913,"_5":17464,"_23818":41797,"_2388":41914},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2861":362,"_25133":319,"_17569":41916,"_5":17464,"_23818":41797,"_2388":41917},[],"Optional integrations",{"_2861":363,"_25133":319,"_17569":41919,"_5":17464,"_23818":41797,"_2388":41920},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2861":364,"_25133":319,"_17569":41922,"_5":17464,"_23818":41797,"_2388":41923},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2861":365,"_25133":319,"_17569":41925,"_5":17464,"_23818":41797,"_2388":41926},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2861":366,"_25133":319,"_17569":41928,"_5":17464,"_23818":41797,"_2388":41929},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2861":367,"_25133":319,"_17569":41931,"_5":17464,"_23818":41801,"_2388":41932},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2861":368,"_25133":319,"_17569":41934,"_5":17464,"_23818":41801,"_2388":41935},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2861":369,"_25133":319,"_17569":41937,"_5":17464,"_23818":41805,"_2388":41938},[],"Kubernetes 1.24 or newer",{"_2861":370,"_25133":319,"_17569":41940,"_5":17464,"_23818":41805,"_2388":41941},[],"Helm 3.2 or newer",{"_2861":371,"_25133":319,"_17569":41943,"_5":17464,"_23818":41805,"_2388":41944},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2861":372,"_25133":319,"_17569":41946,"_5":17464,"_23818":41805,"_2388":41947},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2861":373,"_25133":319,"_17569":41949,"_5":17464,"_23818":41805,"_2388":41950},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2861":374,"_25133":319,"_17569":41952,"_5":17464,"_23818":41805,"_2388":41953},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2861":375,"_25133":319,"_17569":41955,"_5":17464,"_23818":41805,"_2388":41956},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2861":376,"_25133":319,"_17569":41958,"_5":17464,"_23818":41809,"_2388":41959},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2861":377,"_25133":319,"_17569":41961,"_5":17464,"_23818":41809,"_2388":41962},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2861":378,"_25133":319,"_17569":41964,"_5":17464,"_23818":41809,"_2388":41965},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2861":379,"_25133":379,"_5":12309,"_2388":41967,"_25469":41968,"_17569":41970,"_23818":379},"Deployment troubleshooting",[40834,40835,41969],"Operations",[],{"_2861":380,"_25133":379,"_17569":41972,"_5":17464,"_23818":379,"_2388":41973},[],"Diagnose access, service health and infrastructure dependencies.",{"_2861":381,"_25133":379,"_5":25466,"_17569":41975,"_23818":41976,"_2388":41977},[],"/docs/pr-preview/pr-37/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2861":382,"_25133":379,"_5":25466,"_17569":41979,"_23818":41980,"_2388":41981},[],"/docs/pr-preview/pr-37/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2861":383,"_25133":379,"_5":25466,"_17569":41983,"_23818":41984,"_2388":41985},[],"/docs/pr-preview/pr-37/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2861":384,"_25133":379,"_5":25466,"_17569":41987,"_23818":41988,"_2388":41989},[],"/docs/pr-preview/pr-37/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2861":385,"_25133":379,"_5":25466,"_17569":41991,"_23818":41992,"_2388":41993},[],"/docs/pr-preview/pr-37/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2861":386,"_25133":379,"_5":25466,"_17569":41995,"_23818":41996,"_2388":41997},[],"/docs/pr-preview/pr-37/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2861":387,"_25133":379,"_5":25466,"_17569":41999,"_23818":42000,"_2388":42001},[],"/docs/pr-preview/pr-37/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2861":388,"_25133":379,"_5":25466,"_17569":42003,"_23818":42004,"_2388":42005},[],"/docs/pr-preview/pr-37/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2861":389,"_25133":379,"_5":25466,"_17569":42007,"_23818":42008,"_2388":42009},[],"/docs/pr-preview/pr-37/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2861":390,"_25133":379,"_5":25466,"_17569":42011,"_23818":42012,"_2388":42013},[],"/docs/pr-preview/pr-37/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2861":391,"_25133":379,"_5":25466,"_17569":42015,"_23818":42016,"_2388":42017},[],"/docs/pr-preview/pr-37/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2861":392,"_25133":379,"_5":25466,"_17569":42019,"_23818":42020,"_2388":42021},[],"/docs/pr-preview/pr-37/deployment/troubleshooting#observability","Observability",{"_2861":393,"_25133":379,"_17569":42023,"_5":17464,"_23818":379,"_2388":42024},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2861":394,"_25133":379,"_17569":42026,"_5":17464,"_23818":41980,"_2388":42027},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2861":395,"_25133":379,"_17569":42029,"_5":17464,"_23818":41984,"_2388":42030},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2861":396,"_25133":379,"_17569":42032,"_5":17464,"_23818":41988,"_2388":42033},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2861":397,"_25133":379,"_17569":42035,"_5":17464,"_23818":41992,"_2388":42036},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2861":398,"_25133":379,"_17569":42038,"_5":17464,"_23818":41996,"_2388":42039},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2861":399,"_25133":379,"_17569":42041,"_5":17464,"_23818":42000,"_2388":42042},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2861":400,"_25133":379,"_17569":42044,"_5":17464,"_23818":42000,"_2388":42045},[],"Also run the chart's connectivity test:",{"_2861":401,"_25133":379,"_17569":42047,"_5":17464,"_23818":42000,"_2388":42048},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2861":402,"_25133":379,"_17569":42050,"_5":17464,"_23818":42000,"_2388":42051},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2861":403,"_25133":379,"_17569":42053,"_5":17464,"_23818":42004,"_2388":42054},[],"If you receive a 401:",{"_2861":404,"_25133":379,"_17569":42056,"_5":17464,"_23818":42004,"_2388":42057},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2861":405,"_25133":379,"_17569":42059,"_5":17464,"_23818":42004,"_2388":42060},[],"verify issuer, audience and expiration of the token;",{"_2861":406,"_25133":379,"_17569":42062,"_5":17464,"_23818":42004,"_2388":42063},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2861":407,"_25133":379,"_17569":42065,"_5":17464,"_23818":42004,"_2388":42066},[],"check that the provider's public and internal routes point to the same realm.",{"_2861":408,"_25133":379,"_17569":42068,"_5":17464,"_23818":42004,"_2388":42069},[],"If login succeeds but the APIs return 403:",{"_2861":409,"_25133":379,"_17569":42071,"_5":17464,"_23818":42004,"_2388":42072},[],"inspect the token's real claims;",{"_2861":410,"_25133":379,"_17569":42074,"_5":17464,"_23818":42004,"_2388":42075},[],"confirm they match an active principal;",{"_2861":411,"_25133":379,"_17569":42077,"_5":17464,"_23818":42004,"_2388":42078},[],"review the policies granted to that principal;",{"_2861":412,"_25133":379,"_17569":42080,"_5":17464,"_23818":42004,"_2388":42081},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2861":413,"_25133":379,"_17569":42083,"_5":17464,"_23818":42004,"_2388":42084},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2861":414,"_25133":379,"_17569":42086,"_5":17464,"_23818":42008,"_2388":42087},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2861":415,"_25133":379,"_17569":42089,"_5":17464,"_23818":42008,"_2388":42090},[],"Locate the authz pod and Service.",{"_2861":416,"_25133":379,"_17569":42092,"_5":17464,"_23818":42008,"_2388":42093},[],"Check /health, logs and its database connection.",{"_2861":417,"_25133":379,"_17569":42095,"_5":17464,"_23818":42008,"_2388":42096},[],"Verify the DNS and port configured in externalAuthorization.",{"_2861":418,"_25133":379,"_17569":42098,"_5":17464,"_23818":42008,"_2388":42099},[],"Check the check route is /v1/ext\\_authz/check.",{"_2861":419,"_25133":379,"_17569":42101,"_5":17464,"_23818":42008,"_2388":42102},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2861":420,"_25133":379,"_17569":42104,"_5":17464,"_23818":42012,"_2388":42105},[],"Review kubectl describe pod first. Common causes are:",{"_2861":421,"_25133":379,"_17569":42107,"_5":17464,"_23818":42012,"_2388":42108},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2861":422,"_25133":379,"_17569":42110,"_5":17464,"_23818":42012,"_2388":42111},[],"unbound persistent volume;",{"_2861":423,"_25133":379,"_17569":42113,"_5":17464,"_23818":42012,"_2388":42114},[],"inaccessible image or incorrect pull policy;",{"_2861":424,"_25133":379,"_17569":42116,"_5":17464,"_23818":42012,"_2388":42117},[],"invalid cryptographic engine configuration;",{"_2861":425,"_25133":379,"_17569":42119,"_5":17464,"_23818":42012,"_2388":42120},[],"CPU or memory limits set too low;",{"_2861":426,"_25133":379,"_17569":42122,"_5":17464,"_23818":42012,"_2388":42123},[],"an incomplete prior migration.",{"_2861":427,"_25133":379,"_17569":42125,"_5":17464,"_23818":42012,"_2388":42126},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2861":428,"_25133":379,"_17569":42128,"_5":17464,"_23818":42012,"_2388":42129},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2861":429,"_25133":379,"_17569":42131,"_5":17464,"_23818":42016,"_2388":42132},[],"Domain and audit events depend on the bus publisher:",{"_2861":430,"_25133":379,"_17569":42134,"_5":17464,"_23818":42016,"_2388":42135},[],"verify it is enabled in the emitting service;",{"_2861":431,"_25133":379,"_17569":42137,"_5":17464,"_23818":42016,"_2388":42138},[],"check AMQP connectivity and credentials;",{"_2861":432,"_25133":379,"_17569":42140,"_5":17464,"_23818":42016,"_2388":42141},[],"review exchange, routing key, queues and consumers;",{"_2861":433,"_25133":379,"_17569":42143,"_5":17464,"_23818":42016,"_2388":42144},[],"inspect dead-letter queues;",{"_2861":434,"_25133":379,"_17569":42146,"_5":17464,"_23818":42016,"_2388":42147},[],"alert on orphan durable queues and backlog growth.",{"_2861":435,"_25133":379,"_17569":42149,"_5":17464,"_23818":42016,"_2388":42150},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2861":436,"_25133":379,"_17569":42152,"_5":17464,"_23818":42020,"_2388":42153},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2861":437,"_25133":379,"_17569":42155,"_5":17464,"_23818":42020,"_2388":42156},[],"Before closing an incident, record:",{"_2861":438,"_25133":379,"_17569":42158,"_5":17464,"_23818":42020,"_2388":42159},[],"the confirmed cause;",{"_2861":439,"_25133":379,"_17569":42161,"_5":17464,"_23818":42020,"_2388":42162},[],"the time scope and affected resources;",{"_2861":440,"_25133":379,"_17569":42164,"_5":17464,"_23818":42020,"_2388":42165},[],"the commands or queries used;",{"_2861":441,"_25133":379,"_17569":42167,"_5":17464,"_23818":42020,"_2388":42168},[],"the applied change and how to revert it;",{"_2861":442,"_25133":379,"_17569":42170,"_5":17464,"_23818":42020,"_2388":42171},[],"validation from a consumer;",{"_2861":443,"_25133":379,"_17569":42173,"_5":17464,"_23818":42020,"_2388":42174},[],"the preventive action and its owner.",{"_2861":444,"_25133":444,"_5":12309,"_2388":42176,"_25469":42177,"_17569":42180,"_23818":444},"Access control",[40834,42178,42179],"Platform","Administration",[],{"_2861":445,"_25133":444,"_17569":42182,"_5":17464,"_23818":444,"_2388":42183},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2861":446,"_25133":444,"_5":25466,"_17569":42185,"_23818":42186,"_2388":42187},[],"/docs/pr-preview/pr-37/platform/administration/access-control#essential-concepts","Essential concepts",{"_2861":447,"_25133":444,"_5":25466,"_17569":42189,"_23818":42190,"_2388":42191},[],"/docs/pr-preview/pr-37/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2861":448,"_25133":444,"_5":25466,"_17569":42193,"_23818":42194,"_2388":42195},[],"/docs/pr-preview/pr-37/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2861":449,"_25133":444,"_5":25466,"_17569":42197,"_23818":42198,"_2388":42199},[],"/docs/pr-preview/pr-37/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2861":450,"_25133":444,"_5":25466,"_17569":42201,"_23818":42202,"_2388":42203},[],"/docs/pr-preview/pr-37/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2861":451,"_25133":444,"_5":25466,"_17569":42205,"_23818":42206,"_2388":42207},[],"/docs/pr-preview/pr-37/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2861":452,"_25133":444,"_5":25466,"_17569":42209,"_23818":42210,"_2388":42211},[],"/docs/pr-preview/pr-37/platform/administration/access-control#oidc-principals","OIDC principals",{"_2861":453,"_25133":444,"_5":25466,"_17569":42213,"_23818":42214,"_2388":42215},[],"/docs/pr-preview/pr-37/platform/administration/access-control#x509-principals","X.509 principals",{"_2861":454,"_25133":444,"_5":25466,"_17569":42217,"_23818":42218,"_2388":42219},[],"/docs/pr-preview/pr-37/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2861":455,"_25133":444,"_5":25466,"_17569":42221,"_23818":42222,"_2388":42223},[],"/docs/pr-preview/pr-37/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2861":456,"_25133":444,"_5":25466,"_17569":42225,"_23818":42226,"_2388":42227},[],"/docs/pr-preview/pr-37/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2861":457,"_25133":444,"_5":25466,"_17569":42229,"_23818":42230,"_2388":42231},[],"/docs/pr-preview/pr-37/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2861":458,"_25133":444,"_5":25466,"_17569":42233,"_23818":42234,"_2388":42235},[],"/docs/pr-preview/pr-37/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2861":459,"_25133":444,"_5":25466,"_17569":42237,"_23818":42238,"_2388":42239},[],"/docs/pr-preview/pr-37/platform/administration/access-control#http-rules","HTTP rules",{"_2861":460,"_25133":444,"_5":25466,"_17569":42241,"_23818":42242,"_2388":42243},[],"/docs/pr-preview/pr-37/platform/administration/access-control#included-policies","Included policies",{"_2861":461,"_25133":444,"_5":25466,"_17569":42245,"_23818":42246,"_2388":41437},[],"/docs/pr-preview/pr-37/platform/administration/access-control#provision-the-first-administrator",{"_2861":462,"_25133":444,"_5":25466,"_17569":42248,"_23818":42249,"_2388":42250},[],"/docs/pr-preview/pr-37/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2861":463,"_25133":444,"_5":25466,"_17569":42252,"_23818":42253,"_2388":42254},[],"/docs/pr-preview/pr-37/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2861":464,"_25133":444,"_5":25466,"_17569":42256,"_23818":42257,"_2388":42258},[],"/docs/pr-preview/pr-37/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2861":465,"_25133":444,"_5":25466,"_17569":42260,"_23818":42261,"_2388":42262},[],"/docs/pr-preview/pr-37/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2861":466,"_25133":444,"_5":25466,"_17569":42264,"_23818":42265,"_2388":42266},[],"/docs/pr-preview/pr-37/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2861":467,"_25133":444,"_5":25466,"_17569":42268,"_23818":42269,"_2388":42270},[],"/docs/pr-preview/pr-37/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2861":468,"_25133":444,"_5":25466,"_17569":42272,"_23818":42273,"_2388":42274},[],"/docs/pr-preview/pr-37/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2861":469,"_25133":444,"_5":25466,"_17569":42276,"_23818":42277,"_2388":42278},[],"/docs/pr-preview/pr-37/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2861":470,"_25133":444,"_5":25466,"_17569":42280,"_23818":42281,"_2388":42282},[],"/docs/pr-preview/pr-37/platform/administration/access-control#operational-checklist","Operational checklist",{"_2861":471,"_25133":444,"_5":25466,"_17569":42284,"_23818":42285,"_2388":42286},[],"/docs/pr-preview/pr-37/platform/administration/access-control#diagnostics","Diagnostics",{"_2861":472,"_25133":444,"_5":25466,"_17569":42288,"_23818":42289,"_2388":42290},[],"/docs/pr-preview/pr-37/platform/administration/access-control#the-response-is-401","The response is 401",{"_2861":473,"_25133":444,"_5":25466,"_17569":42292,"_23818":42293,"_2388":42294},[],"/docs/pr-preview/pr-37/platform/administration/access-control#the-response-is-403","The response is 403",{"_2861":474,"_25133":444,"_5":25466,"_17569":42296,"_23818":42297,"_2388":42298},[],"/docs/pr-preview/pr-37/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2861":475,"_25133":444,"_5":25466,"_17569":42300,"_23818":42301,"_2388":42302},[],"/docs/pr-preview/pr-37/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2861":476,"_25133":444,"_5":25466,"_17569":42304,"_23818":42305,"_2388":42306},[],"/docs/pr-preview/pr-37/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2861":477,"_25133":444,"_17569":42308,"_5":17464,"_23818":444,"_2388":42309},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2861":478,"_25133":444,"_17569":42311,"_5":17464,"_23818":444,"_2388":42312},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2861":479,"_25133":444,"_17569":42314,"_5":17464,"_23818":444,"_2388":42315},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2861":480,"_25133":444,"_17569":42317,"_5":17464,"_23818":42186,"_2388":42318},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2861":481,"_25133":444,"_17569":42320,"_5":17464,"_23818":42186,"_2388":42321},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2861":482,"_25133":444,"_17569":42323,"_5":17464,"_23818":42186,"_2388":42324},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2861":483,"_25133":444,"_17569":42326,"_5":17464,"_23818":42186,"_2388":42327},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2861":484,"_25133":444,"_17569":42329,"_5":17464,"_23818":42186,"_2388":42330},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2861":485,"_25133":444,"_17569":42332,"_5":17464,"_23818":42186,"_2388":42333},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2861":486,"_25133":444,"_17569":42335,"_5":17464,"_23818":42190,"_2388":42336},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2861":487,"_25133":444,"_17569":42338,"_5":17464,"_23818":42190,"_2388":42339},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2861":488,"_25133":444,"_17569":42341,"_5":17464,"_23818":42194,"_2388":42342},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2861":489,"_25133":444,"_17569":42344,"_5":17464,"_23818":42194,"_2388":42345},[],"The decision is made **before forwarding the request to the service**:",{"_2861":490,"_25133":444,"_17569":42347,"_5":17464,"_23818":42194,"_2388":42348},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2861":491,"_25133":444,"_17569":42350,"_5":17464,"_23818":42194,"_2388":42351},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2861":492,"_25133":444,"_17569":42353,"_5":17464,"_23818":42194,"_2388":42354},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2861":493,"_25133":444,"_17569":42356,"_5":17464,"_23818":42194,"_2388":42357},[],"It separately loads the policies granted to each principal.",{"_2861":494,"_25133":444,"_17569":42359,"_5":17464,"_23818":42194,"_2388":42360},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2861":495,"_25133":444,"_17569":42362,"_5":17464,"_23818":42194,"_2388":42363},[],"`authz` looks for an HTTP rule granting that action.",{"_2861":496,"_25133":444,"_17569":42365,"_5":17464,"_23818":42194,"_2388":42366},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2861":497,"_25133":444,"_17569":42368,"_5":17464,"_23818":42194,"_2388":42369},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2861":498,"_25133":444,"_17569":42371,"_5":17464,"_23818":42194,"_2388":42372},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_2861":499,"_25133":444,"_17569":42374,"_5":17464,"_23818":42194,"_2388":42375},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2861":500,"_25133":444,"_17569":42377,"_5":17464,"_23818":42198,"_2388":42378},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2861":501,"_25133":444,"_17569":42380,"_5":17464,"_23818":42198,"_2388":42381},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2861":502,"_25133":444,"_17569":42383,"_5":17464,"_23818":42198,"_2388":42384},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2861":503,"_25133":444,"_17569":42386,"_5":17464,"_23818":42198,"_2388":42387},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2861":504,"_25133":444,"_17569":42389,"_5":17464,"_23818":42198,"_2388":42390},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2861":505,"_25133":444,"_17569":42392,"_5":17464,"_23818":42198,"_2388":42393},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2861":506,"_25133":444,"_17569":42395,"_5":17464,"_23818":42198,"_2388":42396},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2861":507,"_25133":444,"_17569":42398,"_5":17464,"_23818":42198,"_2388":42399},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2861":508,"_25133":444,"_17569":42401,"_5":17464,"_23818":42202,"_2388":42402},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2861":509,"_25133":444,"_17569":42404,"_5":17464,"_23818":42202,"_2388":42405},[],"The decision is made with the domain operation context:",{"_2861":510,"_25133":444,"_17569":42407,"_5":17464,"_23818":42202,"_2388":42408},[],"The middleware extracts the credential and resolves the matching principals.",{"_2861":511,"_25133":444,"_17569":42410,"_5":17464,"_23818":42202,"_2388":42411},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2861":512,"_25133":444,"_17569":42413,"_5":17464,"_23818":42202,"_2388":42414},[],"`authz` gathers the entity rules of the granted policies.",{"_2861":513,"_25133":444,"_17569":42416,"_5":17464,"_23818":42202,"_2388":42417},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2861":514,"_25133":444,"_17569":42419,"_5":17464,"_23818":42202,"_2388":42420},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2861":515,"_25133":444,"_17569":42422,"_5":17464,"_23818":42202,"_2388":42423},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2861":516,"_25133":444,"_17569":42425,"_5":17464,"_23818":42202,"_2388":42426},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2861":517,"_25133":444,"_17569":42428,"_5":17464,"_23818":42202,"_2388":42429},[],"Actions fall into two groups:",{"_2861":518,"_25133":444,"_17569":42431,"_5":17464,"_23818":42202,"_2388":42432},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2861":519,"_25133":444,"_17569":42434,"_5":17464,"_23818":42202,"_2388":42435},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2861":520,"_25133":444,"_17569":42437,"_5":17464,"_23818":42202,"_2388":42438},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2861":521,"_25133":444,"_17569":42440,"_5":17464,"_23818":42206,"_2388":42441},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2861":522,"_25133":444,"_17569":42443,"_5":17464,"_23818":42206,"_2388":42444},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2861":523,"_25133":444,"_17569":42446,"_5":17464,"_23818":42206,"_2388":42447},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2861":524,"_25133":444,"_17569":42449,"_5":17464,"_23818":42210,"_2388":42450},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2861":525,"_25133":444,"_17569":42452,"_5":17464,"_23818":42210,"_2388":42453},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2861":526,"_25133":444,"_17569":42455,"_5":17464,"_23818":42210,"_2388":42456},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2861":527,"_25133":444,"_17569":42458,"_5":17464,"_23818":42210,"_2388":42459},[],"The implemented operators are:",{"_2861":528,"_25133":444,"_17569":42461,"_5":17464,"_23818":42210,"_2388":42462},[],"`equals`, for exact equality;",{"_2861":529,"_25133":444,"_17569":42464,"_5":17464,"_23818":42210,"_2388":42465},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2861":530,"_25133":444,"_17569":42467,"_5":17464,"_23818":42210,"_2388":42468},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2861":531,"_25133":444,"_17569":42470,"_5":17464,"_23818":42210,"_2388":42471},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2861":532,"_25133":444,"_17569":42473,"_5":17464,"_23818":42214,"_2388":42474},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2861":533,"_25133":444,"_17569":42476,"_5":17464,"_23818":42214,"_2388":42477},[],"The available modes are:",{"_2861":534,"_25133":444,"_17569":42479,"_5":17464,"_23818":42214,"_2388":42480},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2861":535,"_25133":444,"_17569":42482,"_5":17464,"_23818":42214,"_2388":42483},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2861":536,"_25133":444,"_17569":42485,"_5":17464,"_23818":42214,"_2388":42486},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2861":537,"_25133":444,"_17569":42488,"_5":17464,"_23818":42214,"_2388":42489},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2861":538,"_25133":444,"_17569":42491,"_5":17464,"_23818":42214,"_2388":42492},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2861":539,"_25133":444,"_17569":42494,"_5":17464,"_23818":42214,"_2388":42495},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2861":540,"_25133":444,"_17569":42497,"_5":17464,"_23818":42218,"_2388":42498},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2861":541,"_25133":444,"_17569":42500,"_5":17464,"_23818":42218,"_2388":42501},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2861":542,"_25133":444,"_17569":42503,"_5":17464,"_23818":42218,"_2388":42504},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2861":543,"_25133":444,"_17569":42506,"_5":17464,"_23818":42218,"_2388":42507},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2861":544,"_25133":444,"_17569":42509,"_5":17464,"_23818":42226,"_2388":42510},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2861":545,"_25133":444,"_17569":42512,"_5":17464,"_23818":42226,"_2388":42513},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2861":546,"_25133":444,"_17569":42515,"_5":17464,"_23818":42230,"_2388":42516},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2861":547,"_25133":444,"_17569":42518,"_5":17464,"_23818":42230,"_2388":42519},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2861":548,"_25133":444,"_17569":42521,"_5":17464,"_23818":42234,"_2388":42522},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2861":549,"_25133":444,"_17569":42524,"_5":17464,"_23818":42234,"_2388":42525},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2861":550,"_25133":444,"_17569":42527,"_5":17464,"_23818":42234,"_2388":42528},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2861":551,"_25133":444,"_17569":42530,"_5":17464,"_23818":42238,"_2388":42531},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2861":552,"_25133":444,"_17569":42533,"_5":17464,"_23818":42238,"_2388":42534},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2861":553,"_25133":444,"_17569":42536,"_5":17464,"_23818":42238,"_2388":42537},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2861":554,"_25133":444,"_17569":42539,"_5":17464,"_23818":42238,"_2388":42540},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2861":555,"_25133":444,"_17569":42542,"_5":17464,"_23818":42238,"_2388":42543},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2861":556,"_25133":444,"_17569":42545,"_5":17464,"_23818":42238,"_2388":42546},[],"Note that:",{"_2861":557,"_25133":444,"_17569":42548,"_5":17464,"_23818":42238,"_2388":42549},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2861":558,"_25133":444,"_17569":42551,"_5":17464,"_23818":42238,"_2388":42552},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2861":559,"_25133":444,"_17569":42554,"_5":17464,"_23818":42238,"_2388":42555},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2861":560,"_25133":444,"_17569":42557,"_5":17464,"_23818":42242,"_2388":42558},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2861":561,"_25133":444,"_17569":42560,"_5":17464,"_23818":42242,"_2388":42561},[],"full and read-only access to certificates and authorities;",{"_2861":562,"_25133":444,"_17569":42563,"_5":17464,"_23818":42242,"_2388":42564},[],"full and read-only access to the KMS;",{"_2861":563,"_25133":444,"_17569":42566,"_5":17464,"_23818":42242,"_2388":42567},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2861":564,"_25133":444,"_17569":42569,"_5":17464,"_23818":42242,"_2388":42570},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2861":565,"_25133":444,"_17569":42572,"_5":17464,"_23818":42242,"_2388":42573},[],"console access;",{"_2861":566,"_25133":444,"_17569":42575,"_5":17464,"_23818":42242,"_2388":42576},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2861":567,"_25133":444,"_17569":42578,"_5":17464,"_23818":42242,"_2388":42579},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2861":568,"_25133":444,"_17569":42581,"_5":17464,"_23818":42242,"_2388":42582},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2861":569,"_25133":444,"_17569":42584,"_5":17464,"_23818":42246,"_2388":42585},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2861":570,"_25133":444,"_17569":42587,"_5":17464,"_23818":42246,"_2388":42588},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2861":571,"_25133":444,"_17569":42590,"_5":17464,"_23818":42246,"_2388":42591},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2861":572,"_25133":444,"_17569":42593,"_5":17464,"_23818":42249,"_2388":42594},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2861":573,"_25133":444,"_17569":42596,"_5":17464,"_23818":42253,"_2388":42597},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2861":574,"_25133":444,"_17569":42599,"_5":17464,"_23818":42257,"_2388":42600},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2861":575,"_25133":444,"_17569":42602,"_5":17464,"_23818":42261,"_2388":42603},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2861":576,"_25133":444,"_17569":42605,"_5":17464,"_23818":42265,"_2388":42606},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2861":577,"_25133":444,"_17569":42608,"_5":17464,"_23818":42269,"_2388":42609},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2861":578,"_25133":444,"_17569":42611,"_5":17464,"_23818":42269,"_2388":42612},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2861":579,"_25133":444,"_17569":42614,"_5":17464,"_23818":42273,"_2388":42615},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2861":580,"_25133":444,"_17569":42617,"_5":17464,"_23818":42273,"_2388":42618},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2861":581,"_25133":444,"_17569":42620,"_5":17464,"_23818":42273,"_2388":42621},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2861":582,"_25133":444,"_17569":42623,"_5":17464,"_23818":42273,"_2388":42624},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2861":583,"_25133":444,"_17569":42626,"_5":17464,"_23818":42273,"_2388":42627},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2861":584,"_25133":444,"_17569":42629,"_5":17464,"_23818":42273,"_2388":42630},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2861":585,"_25133":444,"_17569":42632,"_5":17464,"_23818":42273,"_2388":42633},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2861":586,"_25133":444,"_17569":42635,"_5":17464,"_23818":42273,"_2388":42636},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2861":587,"_25133":444,"_17569":42638,"_5":17464,"_23818":42277,"_2388":42639},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2861":588,"_25133":444,"_17569":42641,"_5":17464,"_23818":42277,"_2388":42642},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2861":589,"_25133":444,"_17569":42644,"_5":17464,"_23818":42277,"_2388":42645},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2861":590,"_25133":444,"_17569":42647,"_5":17464,"_23818":42281,"_2388":42648},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2861":591,"_25133":444,"_17569":42650,"_5":17464,"_23818":42281,"_2388":42651},[],"Use groups or stable roles for people and independent identities for automations.",{"_2861":592,"_25133":444,"_17569":42653,"_5":17464,"_23818":42281,"_2388":42654},[],"Keep at least two recovery administrators and test their access periodically.",{"_2861":593,"_25133":444,"_17569":42656,"_5":17464,"_23818":42281,"_2388":42657},[],"Review active principals, their matches and their grants after IdP changes.",{"_2861":594,"_25133":444,"_17569":42659,"_5":17464,"_23818":42281,"_2388":42660},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2861":595,"_25133":444,"_17569":42662,"_5":17464,"_23818":42281,"_2388":42663},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2861":596,"_25133":444,"_17569":42665,"_5":17464,"_23818":42281,"_2388":42666},[],"Always test one allowed and one denied operation for each role.",{"_2861":597,"_25133":444,"_17569":42668,"_5":17464,"_23818":42281,"_2388":42669},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2861":598,"_25133":444,"_17569":42671,"_5":17464,"_23818":42289,"_2388":42672},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2861":599,"_25133":444,"_17569":42674,"_5":17464,"_23818":42293,"_2388":42675},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2861":600,"_25133":444,"_17569":42677,"_5":17464,"_23818":42293,"_2388":42678},[],"that an active principal of the correct type exists;",{"_2861":601,"_25133":444,"_17569":42680,"_5":17464,"_23818":42293,"_2388":42681},[],"that the claim paths and values match the real token exactly;",{"_2861":602,"_25133":444,"_17569":42683,"_5":17464,"_23818":42293,"_2388":42684},[],"that all of the principal's conditions hold;",{"_2861":603,"_25133":444,"_17569":42686,"_5":17464,"_23818":42293,"_2388":42687},[],"that the principal has the expected policy granted;",{"_2861":604,"_25133":444,"_17569":42689,"_5":17464,"_23818":42293,"_2388":42690},[],"that the policy includes the action and the requested resource type or route;",{"_2861":605,"_25133":444,"_17569":42692,"_5":17464,"_23818":42293,"_2388":42693},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2861":606,"_25133":444,"_17569":42695,"_5":17464,"_23818":42293,"_2388":42696},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2861":607,"_25133":444,"_17569":42698,"_5":17464,"_23818":42297,"_2388":42699},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2861":608,"_25133":444,"_17569":42701,"_5":17464,"_23818":42301,"_2388":42702},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2861":609,"_25133":444,"_17569":42704,"_5":17464,"_23818":42305,"_2388":42705},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2861":610,"_25133":444,"_17569":42707,"_5":17464,"_23818":42305,"_2388":42708},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2861":611,"_25133":611,"_5":12309,"_2388":42710,"_25469":42711,"_17569":42712,"_23818":611},"Alerts and subscriptions",[40834,42178,42179],[],{"_2861":612,"_25133":611,"_17569":42714,"_5":17464,"_23818":611,"_2388":42715},[],"Send PKI events to people and external systems.",{"_2861":613,"_25133":611,"_5":25466,"_17569":42717,"_23818":42718,"_2388":42719},[],"/docs/pr-preview/pr-37/platform/administration/alerts#how-it-works","How it works",{"_2861":614,"_25133":611,"_5":25466,"_17569":42721,"_23818":42722,"_2388":42723},[],"/docs/pr-preview/pr-37/platform/administration/alerts#available-channels","Available channels",{"_2861":615,"_25133":611,"_5":25466,"_17569":42725,"_23818":42726,"_2388":42727},[],"/docs/pr-preview/pr-37/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2861":616,"_25133":611,"_5":25466,"_17569":42729,"_23818":42730,"_2388":42731},[],"/docs/pr-preview/pr-37/platform/administration/alerts#choose-the-event","Choose the event",{"_2861":617,"_25133":611,"_5":25466,"_17569":42733,"_23818":42734,"_2388":42735},[],"/docs/pr-preview/pr-37/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2861":618,"_25133":611,"_5":25466,"_17569":42737,"_23818":42738,"_2388":42739},[],"/docs/pr-preview/pr-37/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2861":619,"_25133":611,"_5":25466,"_17569":42741,"_23818":42742,"_2388":42743},[],"/docs/pr-preview/pr-37/platform/administration/alerts#review-and-activate","Review and activate",{"_2861":620,"_25133":611,"_5":25466,"_17569":42745,"_23818":42746,"_2388":42747},[],"/docs/pr-preview/pr-37/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_2861":621,"_25133":611,"_5":25466,"_17569":42749,"_23818":42750,"_2388":42751},[],"/docs/pr-preview/pr-37/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2861":622,"_25133":611,"_5":25466,"_17569":42753,"_23818":42754,"_2388":42755},[],"/docs/pr-preview/pr-37/platform/administration/alerts#event-families","Event families",{"_2861":623,"_25133":611,"_17569":42757,"_5":17464,"_23818":611,"_2388":42758},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2861":624,"_25133":611,"_17569":42760,"_5":17464,"_23818":42718,"_2388":42761},[],"A service publishes a domain event.",{"_2861":625,"_25133":611,"_17569":42763,"_5":17464,"_23818":42718,"_2388":42764},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2861":626,"_25133":611,"_17569":42766,"_5":17464,"_23818":42718,"_2388":42767},[],"Each subscription's filter decides whether it should be notified.",{"_2861":627,"_25133":611,"_17569":42769,"_5":17464,"_23818":42718,"_2388":42770},[],"Lamassu delivers the event to the configured channel.",{"_2861":628,"_25133":611,"_17569":42772,"_5":17464,"_23818":42718,"_2388":42773},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2861":629,"_25133":611,"_17569":42775,"_5":17464,"_23818":42722,"_2388":42776},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_2861":630,"_25133":611,"_17569":42778,"_5":17464,"_23818":42722,"_2388":42779},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2861":631,"_25133":611,"_17569":42781,"_5":17464,"_23818":42722,"_2388":42782},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2861":632,"_25133":611,"_17569":42784,"_5":17464,"_23818":42722,"_2388":42785},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_2861":633,"_25133":611,"_17569":42787,"_5":17464,"_23818":42722,"_2388":42788},[],"`apikey_options` requires `header` and `key`.",{"_2861":634,"_25133":611,"_17569":42790,"_5":17464,"_23818":42722,"_2388":42791},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2861":635,"_25133":611,"_17569":42793,"_5":17464,"_23818":42722,"_2388":42794},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_2861":636,"_25133":611,"_17569":42796,"_5":17464,"_23818":42722,"_2388":42797},[],"The alerts API reference documents the full `http_client` schema.",{"_2861":637,"_25133":611,"_17569":42799,"_5":17464,"_23818":42730,"_2388":42800},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2861":638,"_25133":611,"_17569":42802,"_5":17464,"_23818":42734,"_2388":42803},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2861":639,"_25133":611,"_17569":42805,"_5":17464,"_23818":42738,"_2388":42806},[],"Add a filter if you don't want to receive every instance of the event.",{"_2861":640,"_25133":611,"_17569":42808,"_5":17464,"_23818":42738,"_2388":42809},[],"**None** notifies all instances of the event.",{"_2861":641,"_25133":611,"_17569":42811,"_5":17464,"_23818":42738,"_2388":42812},[],"**JSON Path** evaluates one or more specific fields.",{"_2861":642,"_25133":611,"_17569":42814,"_5":17464,"_23818":42738,"_2388":42815},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2861":643,"_25133":611,"_17569":42817,"_5":17464,"_23818":42738,"_2388":42818},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_2861":644,"_25133":611,"_17569":42820,"_5":17464,"_23818":42738,"_2388":42821},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2861":645,"_25133":611,"_17569":42823,"_5":17464,"_23818":42742,"_2388":42824},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2861":646,"_25133":611,"_17569":42826,"_5":17464,"_23818":42746,"_2388":42827},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_2861":647,"_25133":611,"_17569":42829,"_5":17464,"_23818":42746,"_2388":42830},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_2861":648,"_25133":611,"_17569":42832,"_5":17464,"_23818":42746,"_2388":42833},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_2861":649,"_25133":611,"_17569":42835,"_5":17464,"_23818":42746,"_2388":42836},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_2861":650,"_25133":611,"_17569":42838,"_5":17464,"_23818":42746,"_2388":42839},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_2861":651,"_25133":611,"_17569":42841,"_5":17464,"_23818":42746,"_2388":42842},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_2861":652,"_25133":611,"_17569":42844,"_5":17464,"_23818":42746,"_2388":42845},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_2861":653,"_25133":611,"_17569":42847,"_5":17464,"_23818":42746,"_2388":42848},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_2861":654,"_25133":611,"_17569":42850,"_5":17464,"_23818":42750,"_2388":42851},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2861":655,"_25133":611,"_17569":42853,"_5":17464,"_23818":42754,"_2388":42854},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2861":656,"_25133":611,"_17569":42856,"_5":17464,"_23818":42754,"_2388":42857},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2861":657,"_25133":611,"_17569":42859,"_5":17464,"_23818":42754,"_2388":42860},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_2861":658,"_25133":611,"_17569":42862,"_5":17464,"_23818":42754,"_2388":42863},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2861":659,"_25133":611,"_17569":42865,"_5":17464,"_23818":42754,"_2388":42866},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2861":660,"_25133":611,"_17569":42868,"_5":17464,"_23818":42754,"_2388":42869},[],"**Validation:** `va.role.crl.create`.",{"_2861":661,"_25133":611,"_17569":42871,"_5":17464,"_23818":42754,"_2388":42872},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_2861":662,"_25133":611,"_17569":42874,"_5":17464,"_23818":42754,"_2388":42875},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2861":663,"_25133":663,"_5":12309,"_2388":42877,"_25469":42878,"_17569":42879,"_23818":663},"Audit logs",[40834,42178,42179],[],{"_2861":664,"_25133":663,"_17569":42881,"_5":17464,"_23818":663,"_2388":42882},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2861":665,"_25133":663,"_5":25466,"_17569":42884,"_23818":42885,"_2388":42886},[],"/docs/pr-preview/pr-37/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2861":666,"_25133":663,"_5":25466,"_17569":42888,"_23818":42889,"_2388":42890},[],"/docs/pr-preview/pr-37/platform/administration/audit-logs#coverage","Coverage",{"_2861":667,"_25133":663,"_5":25466,"_17569":42892,"_23818":42893,"_2388":42894},[],"/docs/pr-preview/pr-37/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2861":668,"_25133":663,"_5":25466,"_17569":42896,"_23818":42897,"_2388":42898},[],"/docs/pr-preview/pr-37/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2861":669,"_25133":663,"_5":25466,"_17569":42900,"_23818":42901,"_2388":42902},[],"/docs/pr-preview/pr-37/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2861":670,"_25133":663,"_5":25466,"_17569":42904,"_23818":42905,"_2388":42906},[],"/docs/pr-preview/pr-37/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2861":671,"_25133":663,"_5":25466,"_17569":42908,"_23818":42909,"_2388":42910},[],"/docs/pr-preview/pr-37/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2861":672,"_25133":663,"_5":25466,"_17569":42912,"_23818":42913,"_2388":42914},[],"/docs/pr-preview/pr-37/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2861":673,"_25133":663,"_5":25466,"_17569":42916,"_23818":42917,"_2388":42918},[],"/docs/pr-preview/pr-37/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2861":674,"_25133":663,"_5":25466,"_17569":42920,"_23818":42921,"_2388":42922},[],"/docs/pr-preview/pr-37/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2861":675,"_25133":663,"_5":25466,"_17569":42924,"_23818":42925,"_2388":42926},[],"/docs/pr-preview/pr-37/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2861":676,"_25133":663,"_17569":42928,"_5":17464,"_23818":663,"_2388":42929},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2861":677,"_25133":663,"_17569":42931,"_5":17464,"_23818":42885,"_2388":42932},[],"The audit body includes:",{"_2861":678,"_25133":663,"_17569":42934,"_5":17464,"_23818":42885,"_2388":42935},[],"input: data received by the operation;",{"_2861":679,"_25133":663,"_17569":42937,"_5":17464,"_23818":42885,"_2388":42938},[],"has\\_error: whether the service returned an error;",{"_2861":680,"_25133":663,"_17569":42940,"_5":17464,"_23818":42885,"_2388":42941},[],"output: produced result or error message;",{"_2861":681,"_25133":663,"_17569":42943,"_5":17464,"_23818":42885,"_2388":42944},[],"principals: identifiers of the principals that matched the request.",{"_2861":682,"_25133":663,"_17569":42946,"_5":17464,"_23818":42885,"_2388":42947},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2861":683,"_25133":663,"_17569":42949,"_5":17464,"_23818":42885,"_2388":42950},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2861":684,"_25133":663,"_17569":42952,"_5":17464,"_23818":42889,"_2388":42953},[],"The backend applies auditing to mutations of:",{"_2861":685,"_25133":663,"_17569":42955,"_5":17464,"_23818":42889,"_2388":42956},[],"authorities, certificates and issuance profiles;",{"_2861":686,"_25133":663,"_17569":42958,"_5":17464,"_23818":42889,"_2388":42959},[],"keys and KMS engines;",{"_2861":687,"_25133":663,"_17569":42961,"_5":17464,"_23818":42889,"_2388":42962},[],"devices and identities;",{"_2861":688,"_25133":663,"_17569":42964,"_5":17464,"_23818":42889,"_2388":42965},[],"DMSs and enrollment operations;",{"_2861":689,"_25133":663,"_17569":42967,"_5":17464,"_23818":42889,"_2388":42968},[],"validation functions and CRL;",{"_2861":690,"_25133":663,"_17569":42970,"_5":17464,"_23818":42889,"_2388":42971},[],"principals, policies and authorization grants.",{"_2861":691,"_25133":663,"_17569":42973,"_5":17464,"_23818":42889,"_2388":42974},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2861":692,"_25133":663,"_17569":42976,"_5":17464,"_23818":42893,"_2388":42977},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2861":693,"_25133":663,"_17569":42979,"_5":17464,"_23818":42893,"_2388":42980},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2861":694,"_25133":663,"_17569":42982,"_5":17464,"_23818":42893,"_2388":42983},[],"Design the consumer to:",{"_2861":695,"_25133":663,"_17569":42985,"_5":17464,"_23818":42893,"_2388":42986},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2861":696,"_25133":663,"_17569":42988,"_5":17464,"_23818":42893,"_2388":42989},[],"keep the complete CloudEvent unmodified;",{"_2861":697,"_25133":663,"_17569":42991,"_5":17464,"_23818":42893,"_2388":42992},[],"record the ingestion time and detect duplicates by ID;",{"_2861":698,"_25133":663,"_17569":42994,"_5":17464,"_23818":42893,"_2388":42995},[],"encrypt in transit and at rest;",{"_2861":699,"_25133":663,"_17569":42997,"_5":17464,"_23818":42893,"_2388":42998},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2861":700,"_25133":663,"_17569":43000,"_5":17464,"_23818":42893,"_2388":43001},[],"apply an explicit retention and legal hold policy;",{"_2861":701,"_25133":663,"_17569":43003,"_5":17464,"_23818":42893,"_2388":43004},[],"alert if it stops consuming or the pending queue grows.",{"_2861":702,"_25133":663,"_17569":43006,"_5":17464,"_23818":42897,"_2388":43007},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2861":703,"_25133":663,"_17569":43009,"_5":17464,"_23818":42897,"_2388":43010},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2861":704,"_25133":663,"_17569":43012,"_5":17464,"_23818":42905,"_2388":43013},[],"Start from the reported time and normalize every source to UTC.",{"_2861":705,"_25133":663,"_17569":43015,"_5":17464,"_23818":42909,"_2388":43016},[],"Filter by event type, service source and resource identifier.",{"_2861":706,"_25133":663,"_17569":43018,"_5":17464,"_23818":42913,"_2388":43019},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2861":707,"_25133":663,"_17569":43021,"_5":17464,"_23818":42917,"_2388":43022},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2861":708,"_25133":663,"_17569":43024,"_5":17464,"_23818":42921,"_2388":43025},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2861":709,"_25133":663,"_17569":43027,"_5":17464,"_23818":42925,"_2388":43028},[],"Generate a controlled mutation in a test environment and check that:",{"_2861":710,"_25133":663,"_17569":43030,"_5":17464,"_23818":42925,"_2388":43031},[],"a successful audit event appears;",{"_2861":711,"_25133":663,"_17569":43033,"_5":17464,"_23818":42925,"_2388":43034},[],"the principal matches the identity used;",{"_2861":712,"_25133":663,"_17569":43036,"_5":17464,"_23818":42925,"_2388":43037},[],"the consumer persists it exactly once;",{"_2861":713,"_25133":663,"_17569":43039,"_5":17464,"_23818":42925,"_2388":43040},[],"it can be retrieved by resource, actor and period;",{"_2861":714,"_25133":663,"_17569":43042,"_5":17464,"_23818":42925,"_2388":43043},[],"a consumer outage raises an alert.",{"_2861":715,"_25133":663,"_17569":43045,"_5":17464,"_23818":42925,"_2388":43046},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2861":716,"_25133":716,"_5":12309,"_2388":43048,"_25469":43049,"_17569":43050,"_23818":716},"Platform architecture",[40834,42178],[],{"_2861":717,"_25133":716,"_17569":43052,"_5":17464,"_23818":716,"_2388":43053},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2861":718,"_25133":716,"_5":25466,"_17569":43055,"_23818":43056,"_2388":43057},[],"/docs/pr-preview/pr-37/platform/concepts/architecture#control-plane","Control plane",{"_2861":719,"_25133":716,"_5":25466,"_17569":43059,"_23818":43060,"_2388":43061},[],"/docs/pr-preview/pr-37/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2861":720,"_25133":716,"_5":25466,"_17569":43063,"_23818":43064,"_2388":43065},[],"/docs/pr-preview/pr-37/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2861":721,"_25133":716,"_5":25466,"_17569":43067,"_23818":43068,"_2388":43069},[],"/docs/pr-preview/pr-37/platform/concepts/architecture#status-and-validation","Status and validation",{"_2861":722,"_25133":716,"_5":25466,"_17569":43071,"_23818":43072,"_2388":43073},[],"/docs/pr-preview/pr-37/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2861":723,"_25133":716,"_17569":43075,"_5":17464,"_23818":716,"_2388":43076},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2861":724,"_25133":716,"_17569":43078,"_5":17464,"_23818":716,"_2388":43079},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2861":725,"_25133":716,"_17569":43081,"_5":17464,"_23818":43056,"_2388":43082},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2861":726,"_25133":716,"_17569":43084,"_5":17464,"_23818":43060,"_2388":43085},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2861":727,"_25133":716,"_17569":43087,"_5":17464,"_23818":43064,"_2388":43088},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2861":728,"_25133":716,"_17569":43090,"_5":17464,"_23818":43068,"_2388":43091},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2861":729,"_25133":716,"_17569":43093,"_5":17464,"_23818":43072,"_2388":43094},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2861":730,"_25133":730,"_5":12309,"_2388":43096,"_25469":43097,"_17569":43098,"_23818":730},"How Lamassu works",[40834,42178],[],{"_2861":731,"_25133":730,"_17569":43100,"_5":17464,"_23818":730,"_2388":43101},[],"The mental model of trust, keys, certificates and devices.",{"_2861":732,"_25133":730,"_5":25466,"_17569":43103,"_23818":43104,"_2388":43105},[],"/docs/pr-preview/pr-37/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2861":733,"_25133":730,"_5":25466,"_17569":43107,"_23818":43108,"_2388":43109},[],"/docs/pr-preview/pr-37/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2861":734,"_25133":730,"_17569":43111,"_5":17464,"_23818":730,"_2388":43112},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2861":735,"_25133":730,"_17569":43114,"_5":17464,"_23818":43104,"_2388":43115},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2861":736,"_25133":730,"_17569":43117,"_5":17464,"_23818":43104,"_2388":43118},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2861":737,"_25133":730,"_17569":43120,"_5":17464,"_23818":43104,"_2388":43121},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2861":738,"_25133":730,"_17569":43123,"_5":17464,"_23818":43104,"_2388":43124},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2861":739,"_25133":730,"_17569":43126,"_5":17464,"_23818":43104,"_2388":43127},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2861":740,"_25133":730,"_17569":43129,"_5":17464,"_23818":43108,"_2388":43130},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2861":741,"_25133":730,"_17569":43132,"_5":17464,"_23818":43108,"_2388":43133},[],"A DMS relates that CA to an enrollment policy.",{"_2861":742,"_25133":730,"_17569":43135,"_5":17464,"_23818":43108,"_2388":43136},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2861":743,"_25133":730,"_17569":43138,"_5":17464,"_23818":43108,"_2388":43139},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2861":744,"_25133":730,"_17569":43141,"_5":17464,"_23818":43108,"_2388":43142},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2861":745,"_25133":730,"_17569":43144,"_5":17464,"_23818":43108,"_2388":43145},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2861":746,"_25133":730,"_17569":43147,"_5":17464,"_23818":43108,"_2388":43148},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2861":747,"_25133":747,"_5":12309,"_2388":43150,"_25469":43151,"_17569":43153,"_23818":747},"Devices and identities",[40834,42178,43152,43150],"IoT Fleets",[],{"_2861":748,"_25133":747,"_17569":43155,"_5":17464,"_23818":747,"_2388":43156},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2861":749,"_25133":747,"_5":25466,"_17569":43158,"_23818":43159,"_2388":43160},[],"/docs/pr-preview/pr-37/platform/iot-fleets/device-management#device-states","Device states",{"_2861":750,"_25133":747,"_5":25466,"_17569":43162,"_23818":43163,"_2388":43164},[],"/docs/pr-preview/pr-37/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2861":751,"_25133":747,"_5":25466,"_17569":43166,"_23818":43167,"_2388":43168},[],"/docs/pr-preview/pr-37/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2861":752,"_25133":747,"_5":25466,"_17569":43170,"_23818":43171,"_2388":43172},[],"/docs/pr-preview/pr-37/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2861":753,"_25133":747,"_5":25466,"_17569":43174,"_23818":43175,"_2388":43176},[],"/docs/pr-preview/pr-37/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2861":754,"_25133":747,"_5":25466,"_17569":43178,"_23818":43179,"_2388":43180},[],"/docs/pr-preview/pr-37/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2861":755,"_25133":747,"_5":25466,"_17569":43182,"_23818":43183,"_2388":43184},[],"/docs/pr-preview/pr-37/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2861":756,"_25133":747,"_5":25466,"_17569":43186,"_23818":43187,"_2388":43188},[],"/docs/pr-preview/pr-37/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2861":757,"_25133":747,"_5":25466,"_17569":43190,"_23818":43191,"_2388":43192},[],"/docs/pr-preview/pr-37/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2861":758,"_25133":747,"_5":25466,"_17569":43194,"_23818":43195,"_2388":43196},[],"/docs/pr-preview/pr-37/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2861":759,"_25133":747,"_5":25466,"_17569":43198,"_23818":43199,"_2388":43200},[],"/docs/pr-preview/pr-37/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2861":760,"_25133":747,"_17569":43202,"_5":17464,"_23818":747,"_2388":43203},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2861":761,"_25133":747,"_17569":43205,"_5":17464,"_23818":747,"_2388":43206},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2861":762,"_25133":747,"_17569":43208,"_5":17464,"_23818":43159,"_2388":43209},[],"Operational view",{"_2861":763,"_25133":747,"_17569":43211,"_5":17464,"_23818":43159,"_2388":43212},[],"Meaning",{"_2861":764,"_25133":747,"_17569":43214,"_5":17464,"_23818":43159,"_2388":43215},[],"**No Identity**",{"_2861":765,"_25133":747,"_17569":43217,"_5":17464,"_23818":43159,"_2388":43218},[],"A record exists without an associated identity.",{"_2861":766,"_25133":747,"_17569":43220,"_5":17464,"_23818":43159,"_2388":43221},[],"**Active**",{"_2861":767,"_25133":747,"_17569":43223,"_5":17464,"_23818":43159,"_2388":43224},[],"The slot is active; also check certificate dates, status and usages.",{"_2861":768,"_25133":747,"_17569":43226,"_5":17464,"_23818":43159,"_2388":43227},[],"**Renewal Pending**",{"_2861":769,"_25133":747,"_17569":43229,"_5":17464,"_23818":43159,"_2388":43230},[],"The identity is in the operational renewal window.",{"_2861":770,"_25133":747,"_17569":43232,"_5":17464,"_23818":43159,"_2388":43233},[],"**Expiring Soon**",{"_2861":771,"_25133":747,"_17569":43235,"_5":17464,"_23818":43159,"_2388":43236},[],"Expiration is approaching according to configured thresholds.",{"_2861":772,"_25133":747,"_17569":43238,"_5":17464,"_23818":43159,"_2388":43239},[],"**Expired**",{"_2861":773,"_25133":747,"_17569":43241,"_5":17464,"_23818":43159,"_2388":43242},[],"The identity has expired.",{"_2861":774,"_25133":747,"_17569":43244,"_5":17464,"_23818":43159,"_2388":43245},[],"**Revoked**",{"_2861":775,"_25133":747,"_17569":43247,"_5":17464,"_23818":43159,"_2388":43248},[],"The identity is marked revoked.",{"_2861":776,"_25133":747,"_17569":43250,"_5":17464,"_23818":43159,"_2388":43251},[],"**Decommissioned**",{"_2861":777,"_25133":747,"_17569":43253,"_5":17464,"_23818":43159,"_2388":43254},[],"The record is retired and ordinary updates do not restore operation.",{"_2861":778,"_25133":747,"_17569":43256,"_5":17464,"_23818":43159,"_2388":43257},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2861":779,"_25133":747,"_17569":43259,"_5":17464,"_23818":43163,"_2388":43260},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2861":780,"_25133":747,"_17569":43262,"_5":17464,"_23818":43163,"_2388":43263},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2861":781,"_25133":747,"_17569":43265,"_5":17464,"_23818":43163,"_2388":43266},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2861":782,"_25133":747,"_17569":43268,"_5":17464,"_23818":43163,"_2388":43269},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2861":783,"_25133":747,"_17569":43271,"_5":17464,"_23818":43167,"_2388":43272},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2861":784,"_25133":747,"_17569":43274,"_5":17464,"_23818":43171,"_2388":43275},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2861":785,"_25133":747,"_17569":43277,"_5":17464,"_23818":43175,"_2388":43278},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2861":786,"_25133":747,"_17569":43280,"_5":17464,"_23818":43179,"_2388":43281},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2861":787,"_25133":747,"_17569":43283,"_5":17464,"_23818":43183,"_2388":43284},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2861":788,"_25133":747,"_17569":43286,"_5":17464,"_23818":43183,"_2388":43287},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2861":789,"_25133":747,"_17569":43289,"_5":17464,"_23818":43187,"_2388":43290},[],"From **No Identity**, use **Assign Identity**:",{"_2861":790,"_25133":747,"_17569":43292,"_5":17464,"_23818":43187,"_2388":43293},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2861":791,"_25133":747,"_17569":43295,"_5":17464,"_23818":43187,"_2388":43296},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2861":792,"_25133":747,"_17569":43298,"_5":17464,"_23818":43187,"_2388":43299},[],"Confirm and read the serial, active version and history again.",{"_2861":793,"_25133":747,"_17569":43301,"_5":17464,"_23818":43187,"_2388":43302},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2861":794,"_25133":747,"_17569":43304,"_5":17464,"_23818":43187,"_2388":43305},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2861":795,"_25133":747,"_17569":43307,"_5":17464,"_23818":43191,"_2388":43308},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2861":796,"_25133":747,"_17569":43310,"_5":17464,"_23818":43191,"_2388":43311},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2861":797,"_25133":747,"_17569":43313,"_5":17464,"_23818":43195,"_2388":43314},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2861":798,"_25133":747,"_17569":43316,"_5":17464,"_23818":43195,"_2388":43317},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2861":799,"_25133":747,"_17569":43319,"_5":17464,"_23818":43195,"_2388":43320},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2861":800,"_25133":747,"_17569":43322,"_5":17464,"_23818":43195,"_2388":43323},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2861":801,"_25133":747,"_17569":43325,"_5":17464,"_23818":43199,"_2388":43326},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2861":802,"_25133":747,"_17569":43328,"_5":17464,"_23818":43199,"_2388":43329},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2861":803,"_25133":803,"_5":12309,"_2388":43331,"_25469":43332,"_17569":43334,"_23818":803},"Bootstrap identity and authentication",[40834,42178,43152,43150,43333],"Enrollment with PKI",[],{"_2861":804,"_25133":803,"_17569":43336,"_5":17464,"_23818":803,"_2388":43337},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2861":805,"_25133":803,"_5":25466,"_17569":43339,"_23818":43340,"_2388":43341},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2861":806,"_25133":803,"_5":25466,"_17569":43343,"_23818":43344,"_2388":43345},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2861":807,"_25133":803,"_5":25466,"_17569":43347,"_23818":43348,"_2388":43349},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2861":808,"_25133":803,"_5":25466,"_17569":43351,"_23818":43352,"_2388":43353},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2861":809,"_25133":803,"_5":25466,"_17569":43355,"_23818":43356,"_2388":43357},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2861":810,"_25133":803,"_17569":43359,"_5":17464,"_23818":803,"_2388":43360},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2861":811,"_25133":803,"_17569":43362,"_5":17464,"_23818":43340,"_2388":43363},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2861":812,"_25133":803,"_17569":43365,"_5":17464,"_23818":43340,"_2388":43366},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2861":813,"_25133":803,"_17569":43368,"_5":17464,"_23818":43344,"_2388":43369},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2861":814,"_25133":803,"_17569":43371,"_5":17464,"_23818":43344,"_2388":43372},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2861":815,"_25133":803,"_17569":43374,"_5":17464,"_23818":43344,"_2388":43375},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2861":816,"_25133":803,"_17569":43377,"_5":17464,"_23818":43348,"_2388":43378},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2861":817,"_25133":803,"_17569":43380,"_5":17464,"_23818":43348,"_2388":43381},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2861":818,"_25133":803,"_17569":43383,"_5":17464,"_23818":43352,"_2388":43384},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_2861":819,"_25133":803,"_17569":43386,"_5":17464,"_23818":43352,"_2388":43387},[],"Example body:",{"_2861":820,"_25133":803,"_17569":43389,"_5":17464,"_23818":43352,"_2388":43390},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2861":821,"_25133":803,"_17569":43392,"_5":17464,"_23818":43352,"_2388":43393},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2861":822,"_25133":803,"_17569":43395,"_5":17464,"_23818":43352,"_2388":43396},[],"Continuation requires a successful HTTP response and JSON:",{"_2861":823,"_25133":803,"_17569":43398,"_5":17464,"_23818":43352,"_2388":43399},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2861":824,"_25133":803,"_17569":43401,"_5":17464,"_23818":43356,"_2388":43402},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2861":825,"_25133":803,"_17569":43404,"_5":17464,"_23818":43356,"_2388":43405},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2861":826,"_25133":826,"_5":12309,"_2388":43407,"_25469":43408,"_17569":43409,"_23818":826},"Configure and operate the DMS",[40834,42178,43152,43150,43333],[],{"_2861":827,"_25133":826,"_17569":43411,"_5":17464,"_23818":826,"_2388":43412},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2861":828,"_25133":826,"_5":25466,"_17569":43414,"_23818":43415,"_2388":40844},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2861":829,"_25133":826,"_5":25466,"_17569":43417,"_23818":43418,"_2388":43419},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2861":830,"_25133":826,"_5":25466,"_17569":43421,"_23818":43422,"_2388":43423},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2861":831,"_25133":826,"_5":25466,"_17569":43425,"_23818":43426,"_2388":43427},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2861":832,"_25133":826,"_5":25466,"_17569":43429,"_23818":43430,"_2388":43431},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2861":833,"_25133":826,"_5":25466,"_17569":43433,"_23818":43434,"_2388":43435},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2861":834,"_25133":826,"_5":25466,"_17569":43437,"_23818":43438,"_2388":43439},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2861":835,"_25133":826,"_5":25466,"_17569":43441,"_23818":43442,"_2388":43443},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2861":836,"_25133":826,"_5":25466,"_17569":43445,"_23818":43446,"_2388":43447},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2861":837,"_25133":826,"_5":25466,"_17569":43449,"_23818":43450,"_2388":43451},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2861":838,"_25133":826,"_5":25466,"_17569":43453,"_23818":43454,"_2388":43455},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2861":839,"_25133":826,"_5":25466,"_17569":43457,"_23818":43458,"_2388":43459},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_2861":840,"_25133":826,"_5":25466,"_17569":43461,"_23818":43462,"_2388":43463},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2861":841,"_25133":826,"_5":25466,"_17569":43465,"_23818":43466,"_2388":43467},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2861":842,"_25133":826,"_5":25466,"_17569":43469,"_23818":43470,"_2388":43471},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2861":843,"_25133":826,"_5":25466,"_17569":43473,"_23818":43474,"_2388":43475},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2861":844,"_25133":826,"_5":25466,"_17569":43477,"_23818":43478,"_2388":43479},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2861":845,"_25133":826,"_5":25466,"_17569":43481,"_23818":43482,"_2388":43483},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2861":846,"_25133":826,"_17569":43485,"_5":17464,"_23818":826,"_2388":43486},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2861":847,"_25133":826,"_17569":43488,"_5":17464,"_23818":43415,"_2388":43489},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2861":848,"_25133":826,"_17569":43491,"_5":17464,"_23818":43415,"_2388":43492},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2861":849,"_25133":826,"_17569":43494,"_5":17464,"_23818":43422,"_2388":43495},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2861":850,"_25133":826,"_17569":43497,"_5":17464,"_23818":43426,"_2388":43498},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2861":851,"_25133":826,"_17569":43500,"_5":17464,"_23818":43430,"_2388":43501},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2861":852,"_25133":826,"_17569":43503,"_5":17464,"_23818":43434,"_2388":43504},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2861":853,"_25133":826,"_17569":43506,"_5":17464,"_23818":43438,"_2388":43507},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2861":854,"_25133":826,"_17569":43509,"_5":17464,"_23818":43446,"_2388":43510},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2861":855,"_25133":826,"_17569":43512,"_5":17464,"_23818":43446,"_2388":43513},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2861":856,"_25133":826,"_17569":43515,"_5":17464,"_23818":43450,"_2388":43516},[],"`settings.enrollment_settings` field",{"_2861":857,"_25133":826,"_17569":43518,"_5":17464,"_23818":43450,"_2388":43519},[],"Decision",{"_2861":858,"_25133":826,"_17569":43521,"_5":17464,"_23818":43450,"_2388":43522},[],"`protocol`",{"_2861":859,"_25133":826,"_17569":43524,"_5":17464,"_23818":43450,"_2388":43525},[],"`EST_RFC7030` for these operations.",{"_2861":860,"_25133":826,"_17569":43527,"_5":17464,"_23818":43450,"_2388":43528},[],"`enrollment_ca`",{"_2861":861,"_25133":826,"_17569":43530,"_5":17464,"_23818":43450,"_2388":43531},[],"ID of the signing CA.",{"_2861":862,"_25133":826,"_17569":43533,"_5":17464,"_23818":43450,"_2388":43534},[],"`verify_csr_signature`",{"_2861":863,"_25133":826,"_17569":43536,"_5":17464,"_23818":43450,"_2388":43537},[],"Keep `true` to verify CSR key possession.",{"_2861":864,"_25133":826,"_17569":43539,"_5":17464,"_23818":43450,"_2388":43540},[],"`enable_replaceable_enrollment`",{"_2861":865,"_25133":826,"_17569":43542,"_5":17464,"_23818":43450,"_2388":43543},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2861":866,"_25133":826,"_17569":43545,"_5":17464,"_23818":43450,"_2388":43546},[],"`est_rfc7030_settings.auth_mode`",{"_2861":867,"_25133":826,"_17569":43548,"_5":17464,"_23818":43450,"_2388":43549},[],"One of the four authentication modes.",{"_2861":868,"_25133":826,"_17569":43551,"_5":17464,"_23818":43450,"_2388":43552},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2861":869,"_25133":826,"_17569":43554,"_5":17464,"_23818":43454,"_2388":43555},[],"The blocks are independent:",{"_2861":870,"_25133":826,"_17569":43557,"_5":17464,"_23818":43454,"_2388":43558},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2861":871,"_25133":826,"_17569":43560,"_5":17464,"_23818":43454,"_2388":43561},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2861":872,"_25133":826,"_17569":43563,"_5":17464,"_23818":43454,"_2388":43564},[],"`auth_mode`",{"_2861":873,"_25133":826,"_17569":43566,"_5":17464,"_23818":43454,"_2388":43567},[],"Control applied in the configured operation",{"_2861":874,"_25133":826,"_17569":43569,"_5":17464,"_23818":43454,"_2388":43570},[],"`CLIENT_CERTIFICATE`",{"_2861":875,"_25133":826,"_17569":43572,"_5":17464,"_23818":43454,"_2388":43573},[],"Presented certificate validation.",{"_2861":876,"_25133":826,"_17569":43575,"_5":17464,"_23818":43454,"_2388":43576},[],"`EXTERNAL_WEBHOOK`",{"_2861":877,"_25133":826,"_17569":43578,"_5":17464,"_23818":43454,"_2388":43579},[],"Configured webhook authorization.",{"_2861":878,"_25133":826,"_17569":43581,"_5":17464,"_23818":43454,"_2388":43582},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2861":879,"_25133":826,"_17569":43584,"_5":17464,"_23818":43454,"_2388":43585},[],"Certificate validation followed by webhook approval.",{"_2861":880,"_25133":826,"_17569":43587,"_5":17464,"_23818":43454,"_2388":43588},[],"`NO_AUTH`",{"_2861":881,"_25133":826,"_17569":43590,"_5":17464,"_23818":43454,"_2388":43591},[],"No DMS requester authentication.",{"_2861":882,"_25133":826,"_17569":43593,"_5":17464,"_23818":43454,"_2388":43594},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2861":883,"_25133":826,"_17569":43596,"_5":17464,"_23818":43454,"_2388":43597},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2861":884,"_25133":826,"_17569":43599,"_5":17464,"_23818":43454,"_2388":43600},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_2861":885,"_25133":826,"_17569":43602,"_5":17464,"_23818":43454,"_2388":43603},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2861":886,"_25133":826,"_17569":43605,"_5":17464,"_23818":43458,"_2388":43606},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_2861":887,"_25133":826,"_17569":43608,"_5":17464,"_23818":43458,"_2388":43609},[],"`external_webhook_settings` field",{"_2861":888,"_25133":826,"_17569":43611,"_5":17464,"_23818":43458,"_2388":43519},[],{"_2861":889,"_25133":826,"_17569":43613,"_5":17464,"_23818":43458,"_2388":43614},[],"`url`",{"_2861":890,"_25133":826,"_17569":43616,"_5":17464,"_23818":43458,"_2388":43617},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_2861":891,"_25133":826,"_17569":43619,"_5":17464,"_23818":43458,"_2388":43620},[],"`method`",{"_2861":892,"_25133":826,"_17569":43622,"_5":17464,"_23818":43458,"_2388":43623},[],"`POST` or `PUT`; `POST` by default.",{"_2861":893,"_25133":826,"_17569":43625,"_5":17464,"_23818":43458,"_2388":43626},[],"`name`",{"_2861":894,"_25133":826,"_17569":43628,"_5":17464,"_23818":43458,"_2388":43629},[],"Label used in service logs.",{"_2861":895,"_25133":826,"_17569":43631,"_5":17464,"_23818":43458,"_2388":43632},[],"`config.auth_mode`",{"_2861":896,"_25133":826,"_17569":43634,"_5":17464,"_23818":43458,"_2388":43635},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_2861":897,"_25133":826,"_17569":43637,"_5":17464,"_23818":43458,"_2388":43638},[],"`config.apikey_options`",{"_2861":898,"_25133":826,"_17569":43640,"_5":17464,"_23818":43458,"_2388":43641},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_2861":899,"_25133":826,"_17569":43643,"_5":17464,"_23818":43458,"_2388":43644},[],"`config.jwt_options`",{"_2861":900,"_25133":826,"_17569":43646,"_5":17464,"_23818":43458,"_2388":43647},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2861":901,"_25133":826,"_17569":43649,"_5":17464,"_23818":43458,"_2388":43650},[],"`config.mtls_options`",{"_2861":902,"_25133":826,"_17569":43652,"_5":17464,"_23818":43458,"_2388":43653},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_2861":903,"_25133":826,"_17569":43655,"_5":17464,"_23818":43458,"_2388":43656},[],"`config.insecure_skip_verify`",{"_2861":904,"_25133":826,"_17569":43658,"_5":17464,"_23818":43458,"_2388":43659},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_2861":905,"_25133":826,"_17569":43661,"_5":17464,"_23818":43458,"_2388":43662},[],"`config.call_timeout`",{"_2861":906,"_25133":826,"_17569":43664,"_5":17464,"_23818":43458,"_2388":43665},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_2861":907,"_25133":826,"_17569":43667,"_5":17464,"_23818":43458,"_2388":43668},[],"Rules for that configuration:",{"_2861":908,"_25133":826,"_17569":43670,"_5":17464,"_23818":43458,"_2388":43671},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_2861":909,"_25133":826,"_17569":43673,"_5":17464,"_23818":43458,"_2388":43674},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_2861":910,"_25133":826,"_17569":43676,"_5":17464,"_23818":43458,"_2388":43677},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_2861":911,"_25133":826,"_17569":43679,"_5":17464,"_23818":43458,"_2388":43680},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_2861":912,"_25133":826,"_17569":43682,"_5":17464,"_23818":43458,"_2388":43683},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_2861":913,"_25133":826,"_17569":43685,"_5":17464,"_23818":43458,"_2388":43686},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_2861":914,"_25133":826,"_17569":43688,"_5":17464,"_23818":43458,"_2388":43689},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing, and if your version's console does not expose independent settings, use the DMS API.",{"_2861":915,"_25133":826,"_17569":43691,"_5":17464,"_23818":43458,"_2388":43692},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds.",{"_2861":916,"_25133":826,"_17569":43694,"_5":17464,"_23818":43458,"_2388":43695},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_2861":917,"_25133":826,"_17569":43697,"_5":17464,"_23818":43462,"_2388":43698},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2861":918,"_25133":826,"_17569":43700,"_5":17464,"_23818":43466,"_2388":43701},[],"`settings.reenrollment_settings` field",{"_2861":919,"_25133":826,"_17569":43703,"_5":17464,"_23818":43466,"_2388":41217},[],{"_2861":920,"_25133":826,"_17569":43705,"_5":17464,"_23818":43466,"_2388":43706},[],"`reenrollment_delta`",{"_2861":921,"_25133":826,"_17569":43708,"_5":17464,"_23818":43466,"_2388":43709},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2861":922,"_25133":826,"_17569":43711,"_5":17464,"_23818":43466,"_2388":43712},[],"`preventive_delta`",{"_2861":923,"_25133":826,"_17569":43714,"_5":17464,"_23818":43466,"_2388":43715},[],"Preventive operational monitoring threshold.",{"_2861":924,"_25133":826,"_17569":43717,"_5":17464,"_23818":43466,"_2388":43718},[],"`critical_delta`",{"_2861":925,"_25133":826,"_17569":43720,"_5":17464,"_23818":43466,"_2388":43721},[],"Critical operational monitoring threshold.",{"_2861":926,"_25133":826,"_17569":43723,"_5":17464,"_23818":43466,"_2388":43724},[],"`enable_expired_renewal`",{"_2861":927,"_25133":826,"_17569":43726,"_5":17464,"_23818":43466,"_2388":43727},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2861":928,"_25133":826,"_17569":43729,"_5":17464,"_23818":43466,"_2388":43730},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_2861":929,"_25133":826,"_17569":43732,"_5":17464,"_23818":43466,"_2388":43733},[],"Additional validation CAs for the renewal mTLS credential, tried after the enrollment CA; typically populated during CA rotation while old-CA cohorts renew.",{"_2861":930,"_25133":826,"_17569":43735,"_5":17464,"_23818":43466,"_2388":43736},[],"`revoke_on_reenrollment`",{"_2861":931,"_25133":826,"_17569":43738,"_5":17464,"_23818":43466,"_2388":43739},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2861":932,"_25133":826,"_17569":43741,"_5":17464,"_23818":43466,"_2388":43742},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2861":933,"_25133":826,"_17569":43744,"_5":17464,"_23818":43470,"_2388":43745},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2861":934,"_25133":826,"_17569":43747,"_5":17464,"_23818":43474,"_2388":41211},[],{"_2861":935,"_25133":826,"_17569":43749,"_5":17464,"_23818":43474,"_2388":43750},[],"Published material",{"_2861":936,"_25133":826,"_17569":43752,"_5":17464,"_23818":43474,"_2388":43753},[],"**Include Lamassu System CA**",{"_2861":937,"_25133":826,"_17569":43755,"_5":17464,"_23818":43474,"_2388":43756},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2861":938,"_25133":826,"_17569":43758,"_5":17464,"_23818":43474,"_2388":43759},[],"**Include Enrollment CA**",{"_2861":939,"_25133":826,"_17569":43761,"_5":17464,"_23818":43474,"_2388":43762},[],"Selected issuing CA certificate.",{"_2861":940,"_25133":826,"_17569":43764,"_5":17464,"_23818":43474,"_2388":43765},[],"**Managed CAs**",{"_2861":941,"_25133":826,"_17569":43767,"_5":17464,"_23818":43474,"_2388":43768},[],"Explicitly selected CA certificates.",{"_2861":942,"_25133":826,"_17569":43770,"_5":17464,"_23818":43474,"_2388":43771},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2861":943,"_25133":826,"_17569":43773,"_5":17464,"_23818":43478,"_2388":43774},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2861":944,"_25133":826,"_17569":43776,"_5":17464,"_23818":43478,"_2388":43777},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2861":945,"_25133":826,"_17569":43779,"_5":17464,"_23818":43478,"_2388":43780},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2861":946,"_25133":826,"_17569":43782,"_5":17464,"_23818":43482,"_2388":43783},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2861":947,"_25133":947,"_5":12309,"_2388":43785,"_25469":43786,"_17569":43787,"_23818":947},"Integrate the EST client",[40834,42178,43152,43150,43333],[],{"_2861":948,"_25133":947,"_17569":43789,"_5":17464,"_23818":947,"_2388":43790},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2861":949,"_25133":947,"_5":25466,"_17569":43792,"_23818":43793,"_2388":40844},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2861":950,"_25133":947,"_5":25466,"_17569":43795,"_23818":43796,"_2388":43797},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2861":951,"_25133":947,"_5":25466,"_17569":43799,"_23818":43800,"_2388":43801},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2861":952,"_25133":947,"_5":25466,"_17569":43803,"_23818":43804,"_2388":43805},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2861":953,"_25133":947,"_5":25466,"_17569":43807,"_23818":43808,"_2388":43809},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2861":954,"_25133":947,"_5":25466,"_17569":43811,"_23818":43812,"_2388":43813},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2861":955,"_25133":947,"_17569":43815,"_5":17464,"_23818":947,"_2388":43816},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2861":956,"_25133":947,"_17569":43818,"_5":17464,"_23818":43793,"_2388":43819},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2861":957,"_25133":947,"_17569":43821,"_5":17464,"_23818":43793,"_2388":43822},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2861":958,"_25133":947,"_17569":43824,"_5":17464,"_23818":43793,"_2388":43825},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2861":959,"_25133":947,"_17569":43827,"_5":17464,"_23818":43796,"_2388":43828},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2861":960,"_25133":947,"_17569":43830,"_5":17464,"_23818":43796,"_2388":43831},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2861":961,"_25133":947,"_17569":43833,"_5":17464,"_23818":43800,"_2388":43834},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2861":962,"_25133":947,"_17569":43836,"_5":17464,"_23818":43800,"_2388":43837},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2861":963,"_25133":947,"_17569":43839,"_5":17464,"_23818":43804,"_2388":43840},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2861":964,"_25133":947,"_17569":43842,"_5":17464,"_23818":43804,"_2388":43843},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2861":965,"_25133":947,"_17569":43845,"_5":17464,"_23818":43808,"_2388":43846},[],"For a root that issues directly:",{"_2861":966,"_25133":947,"_17569":43848,"_5":17464,"_23818":43808,"_2388":43849},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2861":967,"_25133":947,"_17569":43851,"_5":17464,"_23818":43808,"_2388":43852},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2861":968,"_25133":947,"_17569":43854,"_5":17464,"_23818":43812,"_2388":43855},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2861":969,"_25133":969,"_5":12309,"_2388":43857,"_25469":43858,"_17569":43859,"_23818":969},"EST reference",[40834,42178,43152,43150,43333],[],{"_2861":970,"_25133":969,"_17569":43861,"_5":17464,"_23818":969,"_2388":43862},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2861":971,"_25133":969,"_5":25466,"_17569":43864,"_23818":43865,"_2388":43866},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2861":972,"_25133":969,"_5":25466,"_17569":43868,"_23818":43869,"_2388":19079},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2861":973,"_25133":969,"_5":25466,"_17569":43871,"_23818":43872,"_2388":21841},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2861":974,"_25133":969,"_5":25466,"_17569":43874,"_23818":43875,"_2388":21848},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2861":975,"_25133":969,"_5":25466,"_17569":43877,"_23818":43878,"_2388":21218},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2861":976,"_25133":969,"_5":25466,"_17569":43880,"_23818":43881,"_2388":43882},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2861":977,"_25133":969,"_5":25466,"_17569":43884,"_23818":43885,"_2388":43886},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2861":978,"_25133":969,"_5":25466,"_17569":43888,"_23818":43889,"_2388":43890},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2861":979,"_25133":969,"_17569":43892,"_5":17464,"_23818":969,"_2388":43893},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2861":980,"_25133":969,"_17569":43895,"_5":17464,"_23818":43865,"_2388":43896},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2861":981,"_25133":969,"_17569":43898,"_5":17464,"_23818":43865,"_2388":43899},[],"Operation",{"_2861":982,"_25133":969,"_17569":43901,"_5":17464,"_23818":43865,"_2388":43902},[],"Method",{"_2861":983,"_25133":969,"_17569":43904,"_5":17464,"_23818":43865,"_2388":43905},[],"Authentication and condition",{"_2861":984,"_25133":969,"_17569":43907,"_5":17464,"_23818":43865,"_2388":43908},[],"`/cacerts`",{"_2861":985,"_25133":969,"_17569":43910,"_5":17464,"_23818":43865,"_2388":43911},[],"GET",{"_2861":986,"_25133":969,"_17569":43913,"_5":17464,"_23818":43865,"_2388":43914},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2861":987,"_25133":969,"_17569":43916,"_5":17464,"_23818":43865,"_2388":43917},[],"`/simpleenroll`",{"_2861":988,"_25133":969,"_17569":43919,"_5":17464,"_23818":43865,"_2388":43920},[],"POST",{"_2861":989,"_25133":969,"_17569":43922,"_5":17464,"_23818":43865,"_2388":43923},[],"Initial authentication and DMS registration/replacement policy.",{"_2861":990,"_25133":969,"_17569":43925,"_5":17464,"_23818":43865,"_2388":43926},[],"`/simplereenroll`",{"_2861":991,"_25133":969,"_17569":43928,"_5":17464,"_23818":43865,"_2388":43920},[],{"_2861":992,"_25133":969,"_17569":43930,"_5":17464,"_23818":43865,"_2388":43931},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2861":993,"_25133":969,"_17569":43933,"_5":17464,"_23818":43865,"_2388":43934},[],"`/serverkeygen`",{"_2861":994,"_25133":969,"_17569":43936,"_5":17464,"_23818":43865,"_2388":43920},[],{"_2861":995,"_25133":969,"_17569":43938,"_5":17464,"_23818":43865,"_2388":43939},[],"Initial authentication and admission; server generation enabled.",{"_2861":996,"_25133":969,"_17569":43941,"_5":17464,"_23818":43865,"_2388":43942},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2861":997,"_25133":969,"_17569":43944,"_5":17464,"_23818":43869,"_2388":43945},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2861":998,"_25133":969,"_17569":43947,"_5":17464,"_23818":43869,"_2388":43948},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2861":999,"_25133":969,"_17569":43950,"_5":17464,"_23818":43872,"_2388":43951},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2861":1000,"_25133":969,"_17569":43953,"_5":17464,"_23818":43872,"_2388":43954},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2861":1001,"_25133":969,"_17569":43956,"_5":17464,"_23818":43875,"_2388":43957},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2861":1002,"_25133":969,"_17569":43959,"_5":17464,"_23818":43875,"_2388":43960},[],"The enrollment CA or a validation CA configured in the re-enrollment block validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2861":1003,"_25133":969,"_17569":43962,"_5":17464,"_23818":43878,"_2388":43963},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2861":1004,"_25133":969,"_17569":43965,"_5":17464,"_23818":43878,"_2388":43966},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2861":1005,"_25133":969,"_17569":43968,"_5":17464,"_23818":43881,"_2388":43969},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2861":1006,"_25133":969,"_17569":43971,"_5":17464,"_23818":43881,"_2388":43972},[],"Part",{"_2861":1007,"_25133":969,"_17569":43974,"_5":17464,"_23818":43881,"_2388":43975},[],"Content after decoding its Base64",{"_2861":1008,"_25133":969,"_17569":43977,"_5":17464,"_23818":43881,"_2388":43978},[],"`application/pkcs8`",{"_2861":1009,"_25133":969,"_17569":43980,"_5":17464,"_23818":43881,"_2388":43981},[],"Unencrypted DER PKCS#8 private key.",{"_2861":1010,"_25133":969,"_17569":43983,"_5":17464,"_23818":43881,"_2388":43984},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2861":1011,"_25133":969,"_17569":43986,"_5":17464,"_23818":43881,"_2388":43987},[],"DER PKCS#7 containing the issued certificate.",{"_2861":1012,"_25133":969,"_17569":43989,"_5":17464,"_23818":43881,"_2388":43990},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2861":1013,"_25133":969,"_17569":43992,"_5":17464,"_23818":43885,"_2388":43993},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2861":1014,"_25133":969,"_17569":43995,"_5":17464,"_23818":43885,"_2388":43996},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2861":1015,"_25133":969,"_17569":43998,"_5":17464,"_23818":43885,"_2388":43999},[],"Convert and check the result:",{"_2861":1016,"_25133":969,"_17569":44001,"_5":17464,"_23818":43885,"_2388":44002},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2861":1017,"_25133":969,"_17569":44004,"_5":17464,"_23818":43889,"_2388":44005},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2861":1018,"_25133":969,"_17569":44007,"_5":17464,"_23818":43889,"_2388":44008},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2861":1019,"_25133":1019,"_5":12309,"_2388":43333,"_25469":44010,"_17569":44011,"_23818":1019},[40834,42178,43152,43150,43333],[],{"_2861":1020,"_25133":1019,"_17569":44013,"_5":17464,"_23818":1019,"_2388":44014},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2861":1021,"_25133":1019,"_5":25466,"_17569":44016,"_23818":44017,"_2388":44018},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2861":1022,"_25133":1019,"_5":25466,"_17569":44020,"_23818":44021,"_2388":44022},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2861":1023,"_25133":1019,"_5":25466,"_17569":44024,"_23818":44025,"_2388":44026},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2861":1024,"_25133":1019,"_5":25466,"_17569":44028,"_23818":44029,"_2388":44030},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2861":1025,"_25133":1019,"_17569":44032,"_5":17464,"_23818":1019,"_2388":44033},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2861":1026,"_25133":1019,"_17569":44035,"_5":17464,"_23818":44017,"_2388":44036},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2861":1027,"_25133":1019,"_17569":44038,"_5":17464,"_23818":44017,"_2388":44039},[],"The integrator installs initial EST server trust and an admission credential.",{"_2861":1028,"_25133":1019,"_17569":44041,"_5":17464,"_23818":44017,"_2388":44042},[],"The client requests an identity for its `Device ID` through EST.",{"_2861":1029,"_25133":1019,"_17569":44044,"_5":17464,"_23818":44017,"_2388":44045},[],"Certificate, device binding and key/certificate installation are checked.",{"_2861":1030,"_25133":1019,"_17569":44047,"_5":17464,"_23818":44017,"_2388":44048},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2861":1031,"_25133":1019,"_17569":44050,"_5":17464,"_23818":44017,"_2388":44051},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2861":1032,"_25133":1019,"_17569":44053,"_5":17464,"_23818":44021,"_2388":44054},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2861":1033,"_25133":1019,"_17569":44056,"_5":17464,"_23818":44021,"_2388":44057},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2861":1034,"_25133":1019,"_17569":44059,"_5":17464,"_23818":44021,"_2388":44060},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2861":1035,"_25133":1019,"_17569":44062,"_5":17464,"_23818":44021,"_2388":44063},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2861":1036,"_25133":1019,"_17569":44065,"_5":17464,"_23818":44025,"_2388":44066},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2861":1037,"_25133":1019,"_17569":44068,"_5":17464,"_23818":44025,"_2388":44069},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2861":1038,"_25133":1019,"_17569":44071,"_5":17464,"_23818":44025,"_2388":44072},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2861":1039,"_25133":1019,"_17569":44074,"_5":17464,"_23818":44025,"_2388":44075},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2861":1040,"_25133":1019,"_17569":44077,"_5":17464,"_23818":44029,"_2388":44078},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2861":1041,"_25133":1019,"_17569":44080,"_5":17464,"_23818":44029,"_2388":44081},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2861":1042,"_25133":1042,"_5":12309,"_2388":44083,"_25469":44084,"_17569":44085,"_23818":1042},"Provisioning strategies",[40834,42178,43152,43150,43333],[],{"_2861":1043,"_25133":1042,"_17569":44087,"_5":17464,"_23818":1042,"_2388":44088},[],"Choose device registration, identity authorization and key generation.",{"_2861":1044,"_25133":1042,"_5":25466,"_17569":44090,"_23818":44091,"_2388":44092},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2861":1045,"_25133":1042,"_5":25466,"_17569":44094,"_23818":44095,"_2388":44096},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2861":1046,"_25133":1042,"_5":25466,"_17569":44098,"_23818":44099,"_2388":44100},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2861":1047,"_25133":1042,"_5":25466,"_17569":44102,"_23818":44103,"_2388":44104},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2861":1048,"_25133":1042,"_5":25466,"_17569":44106,"_23818":44107,"_2388":44108},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2861":1049,"_25133":1042,"_17569":44110,"_5":17464,"_23818":1042,"_2388":44111},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2861":1050,"_25133":1042,"_17569":44113,"_5":17464,"_23818":44091,"_2388":44114},[],"Path",{"_2861":1051,"_25133":1042,"_17569":44116,"_5":17464,"_23818":44091,"_2388":44117},[],"When the device exists",{"_2861":1052,"_25133":1042,"_17569":44119,"_5":17464,"_23818":44091,"_2388":44120},[],"What to check",{"_2861":1053,"_25133":1042,"_17569":44122,"_5":17464,"_23818":44091,"_2388":44123},[],"Manual assignment",{"_2861":1054,"_25133":1042,"_17569":44125,"_5":17464,"_23818":44091,"_2388":44126},[],"An operator creates it before associating a certificate.",{"_2861":1055,"_25133":1042,"_17569":44128,"_5":17464,"_23818":44091,"_2388":44129},[],"ID, owning DMS, certificate CN and bound serial.",{"_2861":1056,"_25133":1042,"_17569":44131,"_5":17464,"_23818":44091,"_2388":44132},[],"EST with `JITP`",{"_2861":1057,"_25133":1042,"_17569":44134,"_5":17464,"_23818":44091,"_2388":44135},[],"Created for an unknown CN during `/simpleenroll`.",{"_2861":1058,"_25133":1042,"_17569":44137,"_5":17464,"_23818":44091,"_2388":44138},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2861":1059,"_25133":1042,"_17569":44140,"_5":17464,"_23818":44091,"_2388":44141},[],"EST with `PRE_REGISTRATION`",{"_2861":1060,"_25133":1042,"_17569":44143,"_5":17464,"_23818":44091,"_2388":44144},[],"Must exist before `/simpleenroll`.",{"_2861":1061,"_25133":1042,"_17569":44146,"_5":17464,"_23818":44091,"_2388":44147},[],"Approved record, same DMS and replacement conditions for your version.",{"_2861":1062,"_25133":1042,"_17569":44149,"_5":17464,"_23818":44091,"_2388":44150},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2861":1063,"_25133":1042,"_17569":44152,"_5":17464,"_23818":44091,"_2388":44153},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2861":1064,"_25133":1042,"_17569":44155,"_5":17464,"_23818":44095,"_2388":44156},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2861":1065,"_25133":1042,"_17569":44158,"_5":17464,"_23818":44095,"_2388":44159},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2861":1066,"_25133":1042,"_17569":44161,"_5":17464,"_23818":44095,"_2388":44162},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2861":1067,"_25133":1042,"_17569":44164,"_5":17464,"_23818":44099,"_2388":44165},[],"Decide initial enrollment and re-enrollment separately:",{"_2861":1068,"_25133":1042,"_17569":44167,"_5":17464,"_23818":44099,"_2388":44168},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2861":1069,"_25133":1042,"_17569":44170,"_5":17464,"_23818":44099,"_2388":44171},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2861":1070,"_25133":1042,"_17569":44173,"_5":17464,"_23818":44099,"_2388":44174},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2861":1071,"_25133":1042,"_17569":44176,"_5":17464,"_23818":44099,"_2388":44177},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2861":1072,"_25133":1042,"_17569":44179,"_5":17464,"_23818":44099,"_2388":44180},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2861":1073,"_25133":1042,"_17569":44182,"_5":17464,"_23818":44103,"_2388":41211},[],{"_2861":1074,"_25133":1042,"_17569":44184,"_5":17464,"_23818":44103,"_2388":44185},[],"Material crossing EST",{"_2861":1075,"_25133":1042,"_17569":44187,"_5":17464,"_23818":44103,"_2388":44188},[],"Device-generated key",{"_2861":1076,"_25133":1042,"_17569":44190,"_5":17464,"_23818":44103,"_2388":44191},[],"Public CSR and certificate; the key stays on the client.",{"_2861":1077,"_25133":1042,"_17569":44193,"_5":17464,"_23818":44103,"_2388":44194},[],"Existing device key",{"_2861":1078,"_25133":1042,"_17569":44196,"_5":17464,"_23818":44103,"_2388":44197},[],"CSR signed with that key and a new certificate.",{"_2861":1079,"_25133":1042,"_17569":44199,"_5":17464,"_23818":44103,"_2388":43471},[],{"_2861":1080,"_25133":1042,"_17569":44201,"_5":17464,"_23818":44103,"_2388":44202},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2861":1081,"_25133":1042,"_17569":44204,"_5":17464,"_23818":44103,"_2388":44205},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2861":1082,"_25133":1042,"_17569":44207,"_5":17464,"_23818":44107,"_2388":44208},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2861":1083,"_25133":1083,"_5":12309,"_2388":44210,"_25469":44211,"_17569":44212,"_23818":1083},"Renewal and recovery",[40834,42178,43152,43150,43333],[],{"_2861":1084,"_25133":1083,"_17569":44214,"_5":17464,"_23818":1083,"_2388":44215},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2861":1085,"_25133":1083,"_5":25466,"_17569":44217,"_23818":44218,"_2388":44219},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2861":1086,"_25133":1083,"_5":25466,"_17569":44221,"_23818":44222,"_2388":44223},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2861":1087,"_25133":1083,"_5":25466,"_17569":44225,"_23818":44226,"_2388":44227},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2861":1088,"_25133":1083,"_5":25466,"_17569":44229,"_23818":44230,"_2388":44231},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2861":1089,"_25133":1083,"_5":25466,"_17569":44233,"_23818":44234,"_2388":44235},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2861":1090,"_25133":1083,"_17569":44237,"_5":17464,"_23818":1083,"_2388":44238},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2861":1091,"_25133":1083,"_17569":44240,"_5":17464,"_23818":44218,"_2388":44241},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2861":1092,"_25133":1083,"_17569":44243,"_5":17464,"_23818":44218,"_2388":44244},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2861":1093,"_25133":1083,"_17569":44246,"_5":17464,"_23818":44218,"_2388":44247},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2861":1094,"_25133":1083,"_17569":44249,"_5":17464,"_23818":44218,"_2388":44250},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2861":1095,"_25133":1083,"_17569":44252,"_5":17464,"_23818":44222,"_2388":44253},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2861":1096,"_25133":1083,"_17569":44255,"_5":17464,"_23818":44222,"_2388":44256},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2861":1097,"_25133":1083,"_17569":44258,"_5":17464,"_23818":44226,"_2388":44259},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2861":1098,"_25133":1083,"_17569":44261,"_5":17464,"_23818":44226,"_2388":44262},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2861":1099,"_25133":1083,"_17569":44264,"_5":17464,"_23818":44226,"_2388":44265},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2861":1100,"_25133":1083,"_17569":44267,"_5":17464,"_23818":44230,"_2388":44268},[],"Situation",{"_2861":1101,"_25133":1083,"_17569":44270,"_5":17464,"_23818":44230,"_2388":44271},[],"Procedure",{"_2861":1102,"_25133":1083,"_17569":44273,"_5":17464,"_23818":44230,"_2388":44274},[],"Valid certificate, outside the window",{"_2861":1103,"_25133":1083,"_17569":44276,"_5":17464,"_23818":44230,"_2388":44277},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2861":1104,"_25133":1083,"_17569":44279,"_5":17464,"_23818":44230,"_2388":44280},[],"Expired certificate, key available",{"_2861":1105,"_25133":1083,"_17569":44282,"_5":17464,"_23818":44230,"_2388":44283},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2861":1106,"_25133":1083,"_17569":44285,"_5":17464,"_23818":44230,"_2388":44286},[],"Renewal through webhook or `NO_AUTH`",{"_2861":1107,"_25133":1083,"_17569":44288,"_5":17464,"_23818":44230,"_2388":44289},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2861":1108,"_25133":1083,"_17569":44291,"_5":17464,"_23818":44230,"_2388":44292},[],"Lost or inaccessible key",{"_2861":1109,"_25133":1083,"_17569":44294,"_5":17464,"_23818":44230,"_2388":44295},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2861":1110,"_25133":1083,"_17569":44297,"_5":17464,"_23818":44230,"_2388":44298},[],"Current identity revoked",{"_2861":1111,"_25133":1083,"_17569":44300,"_5":17464,"_23818":44230,"_2388":44301},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2861":1112,"_25133":1083,"_17569":44303,"_5":17464,"_23818":44230,"_2388":44304},[],"Device without an identity",{"_2861":1113,"_25133":1083,"_17569":44306,"_5":17464,"_23818":44230,"_2388":44307},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2861":1114,"_25133":1083,"_17569":44309,"_5":17464,"_23818":44230,"_2388":44310},[],"Retired device",{"_2861":1115,"_25133":1083,"_17569":44312,"_5":17464,"_23818":44230,"_2388":44313},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2861":1116,"_25133":1083,"_17569":44315,"_5":17464,"_23818":44230,"_2388":44316},[],"Timeout, HTTP 500 or installation failure",{"_2861":1117,"_25133":1083,"_17569":44318,"_5":17464,"_23818":44230,"_2388":44319},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2861":1118,"_25133":1083,"_17569":44321,"_5":17464,"_23818":44234,"_2388":44322},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2861":1119,"_25133":1083,"_17569":44324,"_5":17464,"_23818":44234,"_2388":44325},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2861":1120,"_25133":1120,"_5":12309,"_2388":44327,"_25469":44328,"_17569":44329,"_23818":1120},"Enrollment troubleshooting",[40834,42178,43152,43150,43333],[],{"_2861":1121,"_25133":1120,"_17569":44331,"_5":17464,"_23818":1120,"_2388":44332},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2861":1122,"_25133":1120,"_5":25466,"_17569":44334,"_23818":44335,"_2388":44336},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2861":1123,"_25133":1120,"_5":25466,"_17569":44338,"_23818":44339,"_2388":44340},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2861":1124,"_25133":1120,"_5":25466,"_17569":44342,"_23818":44343,"_2388":43890},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2861":1125,"_25133":1120,"_5":25466,"_17569":44345,"_23818":44346,"_2388":44347},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2861":1126,"_25133":1120,"_17569":44349,"_5":17464,"_23818":1120,"_2388":44350},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2861":1127,"_25133":1120,"_17569":44352,"_5":17464,"_23818":44339,"_2388":44353},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2861":1128,"_25133":1120,"_17569":44355,"_5":17464,"_23818":44339,"_2388":44356},[],"Symptom or message",{"_2861":1129,"_25133":1120,"_17569":44358,"_5":17464,"_23818":44339,"_2388":44120},[],{"_2861":1130,"_25133":1120,"_17569":44360,"_5":17464,"_23818":44339,"_2388":44361},[],"curl rejects TLS, name or issuer",{"_2861":1131,"_25133":1120,"_17569":44363,"_5":17464,"_23818":44339,"_2388":44364},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2861":1132,"_25133":1120,"_17569":44366,"_5":17464,"_23818":44339,"_2388":44367},[],"404 or missing APS",{"_2861":1133,"_25133":1120,"_17569":44369,"_5":17464,"_23818":44339,"_2388":44370},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2861":1134,"_25133":1120,"_17569":44372,"_5":17464,"_23818":44339,"_2388":44373},[],"400, CSR or format error",{"_2861":1135,"_25133":1120,"_17569":44375,"_5":17464,"_23818":44339,"_2388":44376},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2861":1136,"_25133":1120,"_17569":44378,"_5":17464,"_23818":44339,"_2388":44379},[],"Missing credential or invalid certificate",{"_2861":1137,"_25133":1120,"_17569":44381,"_5":17464,"_23818":44339,"_2388":44382},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2861":1138,"_25133":1120,"_17569":44384,"_5":17464,"_23818":44339,"_2388":44385},[],"Webhook denies, times out or responds without authorization",{"_2861":1139,"_25133":1120,"_17569":44387,"_5":17464,"_23818":44339,"_2388":44388},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2861":1140,"_25133":1120,"_17569":44390,"_5":17464,"_23818":44339,"_2388":44391},[],"`unexpected status code: <n>: redirects are not followed`",{"_2861":1141,"_25133":1120,"_17569":44393,"_5":17464,"_23818":44339,"_2388":44394},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_2861":1142,"_25133":1120,"_17569":44396,"_5":17464,"_23818":44339,"_2388":44397},[],"`webhook response exceeds 1048576 bytes`",{"_2861":1143,"_25133":1120,"_17569":44399,"_5":17464,"_23818":44339,"_2388":44400},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_2861":1144,"_25133":1120,"_17569":44402,"_5":17464,"_23818":44339,"_2388":44403},[],"`webhook config must not reference files`",{"_2861":1145,"_25133":1120,"_17569":44405,"_5":17464,"_23818":44339,"_2388":44406},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_2861":1146,"_25133":1120,"_17569":44408,"_5":17464,"_23818":44339,"_2388":44409},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_2861":1147,"_25133":1120,"_17569":44411,"_5":17464,"_23818":44339,"_2388":44412},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_2861":1148,"_25133":1120,"_17569":44414,"_5":17464,"_23818":44339,"_2388":44415},[],"`webhook mTLS certificate and key are invalid: …`",{"_2861":1149,"_25133":1120,"_17569":44417,"_5":17464,"_23818":44339,"_2388":44418},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_2861":1150,"_25133":1120,"_17569":44420,"_5":17464,"_23818":44339,"_2388":44421},[],"400 `struct validation error` creating or updating a DMS",{"_2861":1151,"_25133":1120,"_17569":44423,"_5":17464,"_23818":44339,"_2388":44424},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_2861":1152,"_25133":1120,"_17569":44426,"_5":17464,"_23818":44339,"_2388":44427},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_2861":1153,"_25133":1120,"_17569":44429,"_5":17464,"_23818":44339,"_2388":44430},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_2861":1154,"_25133":1120,"_17569":44432,"_5":17464,"_23818":44339,"_2388":44433},[],"`device not preregistered`",{"_2861":1155,"_25133":1120,"_17569":44435,"_5":17464,"_23818":44339,"_2388":44436},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2861":1156,"_25133":1120,"_17569":44438,"_5":17464,"_23818":44339,"_2388":44439},[],"`forbiddenNewEnrollment`",{"_2861":1157,"_25133":1120,"_17569":44441,"_5":17464,"_23818":44339,"_2388":44442},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2861":1158,"_25133":1120,"_17569":44444,"_5":17464,"_23818":44339,"_2388":44445},[],"Different owning DMS",{"_2861":1159,"_25133":1120,"_17569":44447,"_5":17464,"_23818":44339,"_2388":44448},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2861":1160,"_25133":1120,"_17569":44450,"_5":17464,"_23818":44339,"_2388":44451},[],"`invalid RawSubject bytes`",{"_2861":1161,"_25133":1120,"_17569":44453,"_5":17464,"_23818":44339,"_2388":44454},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2861":1162,"_25133":1120,"_17569":44456,"_5":17464,"_23818":44339,"_2388":44457},[],"`invalid reenroll window`",{"_2861":1163,"_25133":1120,"_17569":44459,"_5":17464,"_23818":44339,"_2388":44460},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2861":1164,"_25133":1120,"_17569":44462,"_5":17464,"_23818":44339,"_2388":44463},[],"Current certificate revoked",{"_2861":1165,"_25133":1120,"_17569":44465,"_5":17464,"_23818":44339,"_2388":44466},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2861":1166,"_25133":1120,"_17569":44468,"_5":17464,"_23818":44339,"_2388":44469},[],"CA, profile or signing error",{"_2861":1167,"_25133":1120,"_17569":44471,"_5":17464,"_23818":44339,"_2388":44472},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2861":1168,"_25133":1120,"_17569":44474,"_5":17464,"_23818":44339,"_2388":44475},[],"HTTP 200 without a device connection",{"_2861":1169,"_25133":1120,"_17569":44477,"_5":17464,"_23818":44339,"_2388":44478},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2861":1170,"_25133":1120,"_17569":44480,"_5":17464,"_23818":44339,"_2388":44481},[],"Timeout or error after issuance",{"_2861":1171,"_25133":1120,"_17569":44483,"_5":17464,"_23818":44339,"_2388":44484},[],"New certificates, current slot and previous identity's state before retrying.",{"_2861":1172,"_25133":1120,"_17569":44486,"_5":17464,"_23818":44343,"_2388":44487},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_2861":1173,"_25133":1120,"_17569":44489,"_5":17464,"_23818":44343,"_2388":44490},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2861":1174,"_25133":1120,"_17569":44492,"_5":17464,"_23818":44346,"_2388":44493},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2861":1175,"_25133":1120,"_17569":44495,"_5":17464,"_23818":44346,"_2388":44496},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2861":1176,"_25133":1120,"_17569":44498,"_5":17464,"_23818":44346,"_2388":44499},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2861":1177,"_25133":1120,"_17569":44501,"_5":17464,"_23818":44346,"_2388":44502},[],"Make one request, save headers/body and query the device and certificates.",{"_2861":1178,"_25133":1120,"_17569":44504,"_5":17464,"_23818":44346,"_2388":44505},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2861":1179,"_25133":1120,"_17569":44507,"_5":17464,"_23818":44346,"_2388":44508},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2861":1180,"_25133":1120,"_17569":44510,"_5":17464,"_23818":44346,"_2388":44511},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2861":1181,"_25133":1181,"_5":12309,"_2388":44513,"_25469":44514,"_17569":44515,"_23818":1181},"Trust distribution and updates",[40834,42178,43152,43150,43333],[],{"_2861":1182,"_25133":1181,"_17569":44517,"_5":17464,"_23818":1181,"_2388":44518},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2861":1183,"_25133":1181,"_5":25466,"_17569":44520,"_23818":44521,"_2388":44522},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2861":1184,"_25133":1181,"_5":25466,"_17569":44524,"_23818":44525,"_2388":44526},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2861":1185,"_25133":1181,"_5":25466,"_17569":44528,"_23818":44529,"_2388":44530},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2861":1186,"_25133":1181,"_5":25466,"_17569":44532,"_23818":44533,"_2388":44534},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2861":1187,"_25133":1181,"_5":25466,"_17569":44536,"_23818":44537,"_2388":44538},[],"/docs/pr-preview/pr-37/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2861":1188,"_25133":1181,"_17569":44540,"_5":17464,"_23818":1181,"_2388":44541},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2861":1189,"_25133":1181,"_17569":44543,"_5":17464,"_23818":44521,"_2388":44544},[],"Relationship",{"_2861":1190,"_25133":1181,"_17569":44546,"_5":17464,"_23818":44521,"_2388":44547},[],"Material prepared by its owner",{"_2861":1191,"_25133":1181,"_17569":44549,"_5":17464,"_23818":44521,"_2388":44550},[],"Device → EST server",{"_2861":1192,"_25133":1181,"_17569":44552,"_5":17464,"_23818":44521,"_2388":44553},[],"Previously verified server root, chain or pin and TLS name.",{"_2861":1193,"_25133":1181,"_17569":44555,"_5":17464,"_23818":44521,"_2388":44556},[],"DMS → requester",{"_2861":1194,"_25133":1181,"_17569":44558,"_5":17464,"_23818":44521,"_2388":44559},[],"CAs and rules authorizing initial or renewal credentials.",{"_2861":1195,"_25133":1181,"_17569":44561,"_5":17464,"_23818":44521,"_2388":44562},[],"Consumer → device",{"_2861":1196,"_25133":1181,"_17569":44564,"_5":17464,"_23818":44521,"_2388":44565},[],"Operational identity roots, intermediates, validation and permissions.",{"_2861":1197,"_25133":1181,"_17569":44567,"_5":17464,"_23818":44521,"_2388":44568},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2861":1198,"_25133":1181,"_17569":44570,"_5":17464,"_23818":44525,"_2388":44571},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2861":1199,"_25133":1181,"_17569":44573,"_5":17464,"_23818":44525,"_2388":44574},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2861":1200,"_25133":1181,"_17569":44576,"_5":17464,"_23818":44529,"_2388":44577},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2861":1201,"_25133":1181,"_17569":44579,"_5":17464,"_23818":44529,"_2388":44580},[],"Select policy-approved roots as anchors.",{"_2861":1202,"_25133":1181,"_17569":44582,"_5":17464,"_23818":44529,"_2388":44583},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2861":1203,"_25133":1181,"_17569":44585,"_5":17464,"_23818":44529,"_2388":44586},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2861":1204,"_25133":1181,"_17569":44588,"_5":17464,"_23818":44529,"_2388":44589},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2861":1205,"_25133":1181,"_17569":44591,"_5":17464,"_23818":44529,"_2388":44592},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2861":1206,"_25133":1181,"_17569":44594,"_5":17464,"_23818":44533,"_2388":44595},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2861":1207,"_25133":1181,"_17569":44597,"_5":17464,"_23818":44533,"_2388":44598},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. When switching the enrollment CA, add the previous issuance CA to that list so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2861":1208,"_25133":1181,"_17569":44600,"_5":17464,"_23818":44533,"_2388":44601},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2861":1209,"_25133":1181,"_17569":44603,"_5":17464,"_23818":44537,"_2388":44604},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2861":1210,"_25133":1210,"_5":12309,"_2388":44606,"_25469":44607,"_17569":44609,"_23818":1210},"AWS IoT Core",[40834,42178,43152,43150,44608],"Integrations",[],{"_2861":1211,"_25133":1210,"_17569":44611,"_5":17464,"_23818":1210,"_2388":44612},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2861":1212,"_25133":1210,"_5":25466,"_17569":44614,"_23818":44615,"_2388":44616},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2861":1213,"_25133":1210,"_5":25466,"_17569":44618,"_23818":44619,"_2388":44620},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2861":1214,"_25133":1210,"_5":25466,"_17569":44622,"_23818":44623,"_2388":44624},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2861":1215,"_25133":1210,"_5":25466,"_17569":44626,"_23818":44627,"_2388":44628},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2861":1216,"_25133":1210,"_5":25466,"_17569":44630,"_23818":44631,"_2388":44632},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2861":1217,"_25133":1210,"_5":25466,"_17569":44634,"_23818":44635,"_2388":44636},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2861":1218,"_25133":1210,"_5":25466,"_17569":44638,"_23818":44639,"_2388":44640},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2861":1219,"_25133":1210,"_5":25466,"_17569":44642,"_23818":44643,"_2388":44644},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2861":1220,"_25133":1210,"_5":25466,"_17569":44646,"_23818":44647,"_2388":44648},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2861":1221,"_25133":1210,"_5":25466,"_17569":44650,"_23818":44651,"_2388":44652},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2861":1222,"_25133":1210,"_5":25466,"_17569":44654,"_23818":44655,"_2388":44656},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2861":1223,"_25133":1210,"_5":25466,"_17569":44658,"_23818":44659,"_2388":44660},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2861":1224,"_25133":1210,"_5":25466,"_17569":44662,"_23818":44663,"_2388":44664},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2861":1225,"_25133":1210,"_5":25466,"_17569":44666,"_23818":44667,"_2388":44668},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2861":1226,"_25133":1210,"_5":25466,"_17569":44670,"_23818":44671,"_2388":44672},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2861":1227,"_25133":1210,"_5":25466,"_17569":44674,"_23818":44675,"_2388":44676},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2861":1228,"_25133":1210,"_5":25466,"_17569":44678,"_23818":44679,"_2388":44680},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2861":1229,"_25133":1210,"_5":25466,"_17569":44682,"_23818":44683,"_2388":44684},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2861":1230,"_25133":1210,"_5":25466,"_17569":44686,"_23818":44687,"_2388":44688},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2861":1231,"_25133":1210,"_5":25466,"_17569":44690,"_23818":44691,"_2388":44692},[],"/docs/pr-preview/pr-37/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2861":1232,"_25133":1210,"_17569":44694,"_5":17464,"_23818":1210,"_2388":44695},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2861":1233,"_25133":1210,"_17569":44697,"_5":17464,"_23818":1210,"_2388":44698},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2861":1234,"_25133":1210,"_17569":44700,"_5":17464,"_23818":1210,"_2388":44701},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2861":1235,"_25133":1210,"_17569":44703,"_5":17464,"_23818":44615,"_2388":44704},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2861":1236,"_25133":1210,"_17569":44706,"_5":17464,"_23818":44615,"_2388":44707},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2861":1237,"_25133":1210,"_17569":44709,"_5":17464,"_23818":44615,"_2388":44710},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2861":1238,"_25133":1210,"_17569":44712,"_5":17464,"_23818":44615,"_2388":44713},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2861":1239,"_25133":1210,"_17569":44715,"_5":17464,"_23818":44619,"_2388":44716},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2861":1240,"_25133":1210,"_17569":44718,"_5":17464,"_23818":44623,"_2388":44719},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2861":1241,"_25133":1210,"_17569":44721,"_5":17464,"_23818":44623,"_2388":44722},[],"IAM action",{"_2861":1242,"_25133":1210,"_17569":44724,"_5":17464,"_23818":44623,"_2388":41217},[],{"_2861":1243,"_25133":1210,"_17569":44726,"_5":17464,"_23818":44623,"_2388":44727},[],"`iot:GetRegistrationCode`",{"_2861":1244,"_25133":1210,"_17569":44729,"_5":17464,"_23818":44623,"_2388":44730},[],"Obtain the verification code for CA registration in the Primary Account",{"_2861":1245,"_25133":1210,"_17569":44732,"_5":17464,"_23818":44623,"_2388":44733},[],"`iot:RegisterCACertificate`",{"_2861":1246,"_25133":1210,"_17569":44735,"_5":17464,"_23818":44623,"_2388":44736},[],"Register the CA in AWS IoT",{"_2861":1247,"_25133":1210,"_17569":44738,"_5":17464,"_23818":44623,"_2388":44739},[],"`iot:DescribeCACertificate`",{"_2861":1248,"_25133":1210,"_17569":44741,"_5":17464,"_23818":44623,"_2388":44742},[],"Check the CA registration status",{"_2861":1249,"_25133":1210,"_17569":44744,"_5":17464,"_23818":44623,"_2388":44745},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2861":1250,"_25133":1210,"_17569":44747,"_5":17464,"_23818":44623,"_2388":44748},[],"Create or update Things in IoT Core",{"_2861":1251,"_25133":1210,"_17569":44750,"_5":17464,"_23818":44623,"_2388":44751},[],"`iot:RegisterThing`",{"_2861":1252,"_25133":1210,"_17569":44753,"_5":17464,"_23818":44623,"_2388":44754},[],"Provision Things through a template",{"_2861":1253,"_25133":1210,"_17569":44756,"_5":17464,"_23818":44623,"_2388":44757},[],"`iot:RegisterCertificate`",{"_2861":1254,"_25133":1210,"_17569":44759,"_5":17464,"_23818":44623,"_2388":44760},[],"Register device certificates",{"_2861":1255,"_25133":1210,"_17569":44762,"_5":17464,"_23818":44623,"_2388":44763},[],"`iot:UpdateCertificate`",{"_2861":1256,"_25133":1210,"_17569":44765,"_5":17464,"_23818":44623,"_2388":44766},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2861":1257,"_25133":1210,"_17569":44768,"_5":17464,"_23818":44623,"_2388":44769},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2861":1258,"_25133":1210,"_17569":44771,"_5":17464,"_23818":44623,"_2388":44772},[],"Create and attach IoT policies",{"_2861":1259,"_25133":1210,"_17569":44774,"_5":17464,"_23818":44623,"_2388":44775},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2861":1260,"_25133":1210,"_17569":44777,"_5":17464,"_23818":44623,"_2388":44778},[],"Manage Thing groups",{"_2861":1261,"_25133":1210,"_17569":44780,"_5":17464,"_23818":44623,"_2388":44781},[],"`iot:CreateProvisioningTemplate`",{"_2861":1262,"_25133":1210,"_17569":44783,"_5":17464,"_23818":44623,"_2388":44784},[],"Create JITP templates",{"_2861":1263,"_25133":1210,"_17569":44786,"_5":17464,"_23818":44623,"_2388":44787},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2861":1264,"_25133":1210,"_17569":44789,"_5":17464,"_23818":44623,"_2388":44790},[],"Read and write the Device Shadow",{"_2861":1265,"_25133":1210,"_17569":44792,"_5":17464,"_23818":44623,"_2388":44793},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2861":1266,"_25133":1210,"_17569":44795,"_5":17464,"_23818":44627,"_2388":44796},[],"Parameter",{"_2861":1267,"_25133":1210,"_17569":44798,"_5":17464,"_23818":44627,"_2388":44799},[],"Type",{"_2861":1268,"_25133":1210,"_17569":44801,"_5":17464,"_23818":44627,"_2388":44802},[],"Required",{"_2861":1269,"_25133":1210,"_17569":44804,"_5":17464,"_23818":44627,"_2388":44805},[],"Description",{"_2861":1270,"_25133":1210,"_17569":44807,"_5":17464,"_23818":44627,"_2388":44808},[],"`connector_id`",{"_2861":1271,"_25133":1210,"_17569":44810,"_5":17464,"_23818":44627,"_2388":20962},[],{"_2861":1272,"_25133":1210,"_17569":44812,"_5":17464,"_23818":44627,"_2388":44813},[],"Yes",{"_2861":1273,"_25133":1210,"_17569":44815,"_5":17464,"_23818":44627,"_2388":44816},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2861":1274,"_25133":1210,"_17569":44818,"_5":17464,"_23818":44627,"_2388":44819},[],"`aws_config.region`",{"_2861":1275,"_25133":1210,"_17569":44821,"_5":17464,"_23818":44627,"_2388":20962},[],{"_2861":1276,"_25133":1210,"_17569":44823,"_5":17464,"_23818":44627,"_2388":44813},[],{"_2861":1277,"_25133":1210,"_17569":44825,"_5":17464,"_23818":44627,"_2388":44826},[],"AWS region where the connector operates.",{"_2861":1278,"_25133":1210,"_17569":44828,"_5":17464,"_23818":44627,"_2388":44829},[],"`aws_config.auth_method`",{"_2861":1279,"_25133":1210,"_17569":44831,"_5":17464,"_23818":44627,"_2388":20962},[],{"_2861":1280,"_25133":1210,"_17569":44833,"_5":17464,"_23818":44627,"_2388":44813},[],{"_2861":1281,"_25133":1210,"_17569":44835,"_5":17464,"_23818":44627,"_2388":44836},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2861":1282,"_25133":1210,"_17569":44838,"_5":17464,"_23818":44627,"_2388":44839},[],"`aws_config.access_key_id`",{"_2861":1283,"_25133":1210,"_17569":44841,"_5":17464,"_23818":44627,"_2388":20962},[],{"_2861":1284,"_25133":1210,"_17569":44843,"_5":17464,"_23818":44627,"_2388":44844},[],"Only with `auth_method=static`",{"_2861":1285,"_25133":1210,"_17569":44846,"_5":17464,"_23818":44627,"_2388":44847},[],"AWS access key.",{"_2861":1286,"_25133":1210,"_17569":44849,"_5":17464,"_23818":44627,"_2388":44850},[],"`aws_config.secret_access_key`",{"_2861":1287,"_25133":1210,"_17569":44852,"_5":17464,"_23818":44627,"_2388":20962},[],{"_2861":1288,"_25133":1210,"_17569":44854,"_5":17464,"_23818":44627,"_2388":44844},[],{"_2861":1289,"_25133":1210,"_17569":44856,"_5":17464,"_23818":44627,"_2388":44857},[],"AWS secret key.",{"_2861":1290,"_25133":1210,"_17569":44859,"_5":17464,"_23818":44627,"_2388":44860},[],"`aws_config.session_token`",{"_2861":1291,"_25133":1210,"_17569":44862,"_5":17464,"_23818":44627,"_2388":20962},[],{"_2861":1292,"_25133":1210,"_17569":44864,"_5":17464,"_23818":44627,"_2388":44865},[],"No",{"_2861":1293,"_25133":1210,"_17569":44867,"_5":17464,"_23818":44627,"_2388":44868},[],"Session token (with `auth_method=static`).",{"_2861":1294,"_25133":1210,"_17569":44870,"_5":17464,"_23818":44627,"_2388":44871},[],"`aws_config.role_arn`",{"_2861":1295,"_25133":1210,"_17569":44873,"_5":17464,"_23818":44627,"_2388":20962},[],{"_2861":1296,"_25133":1210,"_17569":44875,"_5":17464,"_23818":44627,"_2388":44876},[],"Only with `auth_method=role`",{"_2861":1297,"_25133":1210,"_17569":44878,"_5":17464,"_23818":44627,"_2388":44879},[],"ARN of the role to assume.",{"_2861":1298,"_25133":1210,"_17569":44881,"_5":17464,"_23818":44627,"_2388":44882},[],"`aws_config.endpoint_url`",{"_2861":1299,"_25133":1210,"_17569":44884,"_5":17464,"_23818":44627,"_2388":20962},[],{"_2861":1300,"_25133":1210,"_17569":44886,"_5":17464,"_23818":44627,"_2388":44865},[],{"_2861":1301,"_25133":1210,"_17569":44888,"_5":17464,"_23818":44627,"_2388":44889},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2861":1302,"_25133":1210,"_17569":44891,"_5":17464,"_23818":44627,"_2388":44892},[],"`subscriber_event_bus`",{"_2861":1303,"_25133":1210,"_17569":44894,"_5":17464,"_23818":44627,"_2388":14712},[],{"_2861":1304,"_25133":1210,"_17569":44896,"_5":17464,"_23818":44627,"_2388":44813},[],{"_2861":1305,"_25133":1210,"_17569":44898,"_5":17464,"_23818":44627,"_2388":44899},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2861":1306,"_25133":1210,"_17569":44901,"_5":17464,"_23818":44627,"_2388":44902},[],"`dms_manager_client`",{"_2861":1307,"_25133":1210,"_17569":44904,"_5":17464,"_23818":44627,"_2388":20962},[],{"_2861":1308,"_25133":1210,"_17569":44906,"_5":17464,"_23818":44627,"_2388":44813},[],{"_2861":1309,"_25133":1210,"_17569":44908,"_5":17464,"_23818":44627,"_2388":44909},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2861":1310,"_25133":1210,"_17569":44911,"_5":17464,"_23818":44627,"_2388":44912},[],"`device_manager_client`",{"_2861":1311,"_25133":1210,"_17569":44914,"_5":17464,"_23818":44627,"_2388":20962},[],{"_2861":1312,"_25133":1210,"_17569":44916,"_5":17464,"_23818":44627,"_2388":44813},[],{"_2861":1313,"_25133":1210,"_17569":44918,"_5":17464,"_23818":44627,"_2388":44919},[],"HTTP URL of Lamassu's Device Manager.",{"_2861":1314,"_25133":1210,"_17569":44921,"_5":17464,"_23818":44627,"_2388":44922},[],"`ca_client`",{"_2861":1315,"_25133":1210,"_17569":44924,"_5":17464,"_23818":44627,"_2388":20962},[],{"_2861":1316,"_25133":1210,"_17569":44926,"_5":17464,"_23818":44627,"_2388":44813},[],{"_2861":1317,"_25133":1210,"_17569":44928,"_5":17464,"_23818":44627,"_2388":44929},[],"HTTP URL of Lamassu's CA service.",{"_2861":1318,"_25133":1210,"_17569":44931,"_5":17464,"_23818":44631,"_2388":44932},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2861":1319,"_25133":1210,"_17569":44934,"_5":17464,"_23818":44635,"_2388":44935},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2861":1320,"_25133":1210,"_17569":44937,"_5":17464,"_23818":44635,"_2388":44938},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2861":1321,"_25133":1210,"_17569":44940,"_5":17464,"_23818":44639,"_2388":44941},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2861":1322,"_25133":1210,"_17569":44943,"_5":17464,"_23818":44639,"_2388":44944},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2861":1323,"_25133":1210,"_17569":44946,"_5":17464,"_23818":44639,"_2388":44947},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2861":1324,"_25133":1210,"_17569":44949,"_5":17464,"_23818":44639,"_2388":44950},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2861":1325,"_25133":1210,"_17569":44952,"_5":17464,"_23818":44639,"_2388":44953},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2861":1326,"_25133":1210,"_17569":44955,"_5":17464,"_23818":44639,"_2388":44956},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2861":1327,"_25133":1210,"_17569":44958,"_5":17464,"_23818":44643,"_2388":44959},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2861":1328,"_25133":1210,"_17569":44961,"_5":17464,"_23818":44647,"_2388":44962},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2861":1329,"_25133":1210,"_17569":44964,"_5":17464,"_23818":44647,"_2388":44965},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2861":1330,"_25133":1210,"_17569":44967,"_5":17464,"_23818":44651,"_2388":44968},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2861":1331,"_25133":1210,"_17569":44970,"_5":17464,"_23818":44655,"_2388":44971},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2861":1332,"_25133":1210,"_17569":44973,"_5":17464,"_23818":44655,"_2388":44974},[],"Creates or updates the IoT policies configured in the DMS.",{"_2861":1333,"_25133":1210,"_17569":44976,"_5":17464,"_23818":44655,"_2388":44977},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2861":1334,"_25133":1210,"_17569":44979,"_5":17464,"_23818":44655,"_2388":44980},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2861":1335,"_25133":1210,"_17569":44982,"_5":17464,"_23818":44655,"_2388":44983},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2861":1336,"_25133":1210,"_17569":44985,"_5":17464,"_23818":44655,"_2388":44986},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2861":1337,"_25133":1210,"_17569":44988,"_5":17464,"_23818":44655,"_2388":44989},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2861":1338,"_25133":1210,"_17569":44991,"_5":17464,"_23818":44659,"_2388":44992},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2861":1339,"_25133":1210,"_17569":44994,"_5":17464,"_23818":44659,"_2388":44995},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2861":1340,"_25133":1210,"_17569":44997,"_5":17464,"_23818":44659,"_2388":44998},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2861":1341,"_25133":1210,"_17569":45000,"_5":17464,"_23818":44663,"_2388":45001},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2861":1342,"_25133":1210,"_17569":45003,"_5":17464,"_23818":44663,"_2388":45004},[],"The full flow from the device's perspective is:",{"_2861":1343,"_25133":1210,"_17569":45006,"_5":17464,"_23818":44663,"_2388":45007},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2861":1344,"_25133":1210,"_17569":45009,"_5":17464,"_23818":44667,"_2388":45010},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2861":1345,"_25133":1210,"_17569":45012,"_5":17464,"_23818":44667,"_2388":45013},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2861":1346,"_25133":1210,"_17569":45015,"_5":17464,"_23818":44667,"_2388":45016},[],"For the JITP flow to work correctly:",{"_2861":1347,"_25133":1210,"_17569":45018,"_5":17464,"_23818":44667,"_2388":45019},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2861":1348,"_25133":1210,"_17569":45021,"_5":17464,"_23818":44667,"_2388":45022},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2861":1349,"_25133":1210,"_17569":45024,"_5":17464,"_23818":44667,"_2388":45025},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2861":1350,"_25133":1210,"_17569":45027,"_5":17464,"_23818":44667,"_2388":45028},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2861":1351,"_25133":1210,"_17569":45030,"_5":17464,"_23818":44671,"_2388":45031},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2861":1352,"_25133":1210,"_17569":45033,"_5":17464,"_23818":44671,"_2388":45034},[],"Status in Lamassu",{"_2861":1353,"_25133":1210,"_17569":45036,"_5":17464,"_23818":44671,"_2388":45037},[],"Revocation reason",{"_2861":1354,"_25133":1210,"_17569":45039,"_5":17464,"_23818":44671,"_2388":45040},[],"Status in AWS IoT Core",{"_2861":1355,"_25133":1210,"_17569":45042,"_5":17464,"_23818":44671,"_2388":45043},[],"`Active`",{"_2861":1356,"_25133":1210,"_17569":45045,"_5":17464,"_23818":44671,"_2388":45046},[],"None",{"_2861":1357,"_25133":1210,"_17569":45048,"_5":17464,"_23818":44671,"_2388":45049},[],"`ACTIVE`",{"_2861":1358,"_25133":1210,"_17569":45051,"_5":17464,"_23818":44671,"_2388":45052},[],"`Revoked`",{"_2861":1359,"_25133":1210,"_17569":45054,"_5":17464,"_23818":44671,"_2388":45055},[],"`certificateHold`",{"_2861":1360,"_25133":1210,"_17569":45057,"_5":17464,"_23818":44671,"_2388":45058},[],"`INACTIVE`",{"_2861":1361,"_25133":1210,"_17569":45060,"_5":17464,"_23818":44671,"_2388":45052},[],{"_2861":1362,"_25133":1210,"_17569":45062,"_5":17464,"_23818":44671,"_2388":45063},[],"Any other reason",{"_2861":1363,"_25133":1210,"_17569":45065,"_5":17464,"_23818":44671,"_2388":45066},[],"`REVOKED`",{"_2861":1364,"_25133":1210,"_17569":45068,"_5":17464,"_23818":44671,"_2388":45069},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2861":1365,"_25133":1210,"_17569":45071,"_5":17464,"_23818":44675,"_2388":45072},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2861":1366,"_25133":1210,"_17569":45074,"_5":17464,"_23818":44675,"_2388":45075},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2861":1367,"_25133":1210,"_17569":45077,"_5":17464,"_23818":44675,"_2388":45078},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2861":1368,"_25133":1210,"_17569":45080,"_5":17464,"_23818":44679,"_2388":45081},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2861":1369,"_25133":1210,"_17569":45083,"_5":17464,"_23818":44679,"_2388":45084},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2861":1370,"_25133":1210,"_17569":45086,"_5":17464,"_23818":44683,"_2388":45087},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2861":1371,"_25133":1210,"_17569":45089,"_5":17464,"_23818":44683,"_2388":45090},[],"There are two action types:",{"_2861":1372,"_25133":1210,"_17569":45092,"_5":17464,"_23818":44683,"_2388":45093},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2861":1373,"_25133":1210,"_17569":45095,"_5":17464,"_23818":44683,"_2388":45096},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2861":1374,"_25133":1210,"_17569":45098,"_5":17464,"_23818":44683,"_2388":45099},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2861":1375,"_25133":1210,"_17569":45101,"_5":17464,"_23818":44687,"_2388":45102},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2861":1376,"_25133":1210,"_17569":45104,"_5":17464,"_23818":44687,"_2388":45105},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2861":1377,"_25133":1210,"_17569":45107,"_5":17464,"_23818":44687,"_2388":45108},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2861":1378,"_25133":1210,"_17569":45110,"_5":17464,"_23818":44691,"_2388":45111},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2861":1379,"_25133":1210,"_17569":45113,"_5":17464,"_23818":44691,"_2388":45114},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2861":1380,"_25133":1210,"_17569":45116,"_5":17464,"_23818":44691,"_2388":45117},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2861":1381,"_25133":1210,"_17569":45119,"_5":17464,"_23818":44691,"_2388":45120},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2861":1382,"_25133":1210,"_17569":45122,"_5":17464,"_23818":44691,"_2388":45123},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2861":1383,"_25133":1210,"_17569":45125,"_5":17464,"_23818":44691,"_2388":45126},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2861":1384,"_25133":1210,"_17569":45128,"_5":17464,"_23818":44691,"_2388":45129},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2861":1385,"_25133":1210,"_17569":45131,"_5":17464,"_23818":44691,"_2388":45132},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2861":1386,"_25133":1210,"_17569":45134,"_5":17464,"_23818":44691,"_2388":45135},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2861":1387,"_25133":1210,"_17569":45137,"_5":17464,"_23818":44691,"_2388":45138},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2861":1388,"_25133":1210,"_17569":45140,"_5":17464,"_23818":44691,"_2388":45141},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2861":1389,"_25133":1210,"_17569":45143,"_5":17464,"_23818":44691,"_2388":45144},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2861":1390,"_25133":1210,"_17569":45146,"_5":17464,"_23818":44691,"_2388":45147},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2861":1391,"_25133":1210,"_17569":45149,"_5":17464,"_23818":44691,"_2388":45150},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2861":1392,"_25133":1210,"_17569":45152,"_5":17464,"_23818":44691,"_2388":45153},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2861":1393,"_25133":1210,"_17569":45155,"_5":17464,"_23818":44691,"_2388":45156},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2861":1394,"_25133":1210,"_17569":45158,"_5":17464,"_23818":44691,"_2388":45159},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2861":1395,"_25133":1210,"_17569":45161,"_5":17464,"_23818":44691,"_2388":45162},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2861":1396,"_25133":1210,"_17569":45164,"_5":17464,"_23818":44691,"_2388":45165},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2861":1397,"_25133":1210,"_17569":45167,"_5":17464,"_23818":44691,"_2388":45168},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2861":1398,"_25133":1210,"_17569":45170,"_5":17464,"_23818":44691,"_2388":45171},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2861":1399,"_25133":1399,"_5":12309,"_2388":43152,"_25469":45173,"_17569":45174,"_23818":1399},[40834,42178,43152],[],{"_2861":1400,"_25133":1399,"_17569":45176,"_5":17464,"_23818":1399,"_2388":45177},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2861":1401,"_25133":1399,"_5":25466,"_17569":45179,"_23818":45180,"_2388":45181},[],"/docs/pr-preview/pr-37/platform/iot-fleets/overview#start-here","Start here",{"_2861":1402,"_25133":1399,"_5":25466,"_17569":45183,"_23818":45184,"_2388":43150},[],"/docs/pr-preview/pr-37/platform/iot-fleets/overview#devices-and-identities",{"_2861":1403,"_25133":1399,"_5":25466,"_17569":45186,"_23818":45187,"_2388":43333},[],"/docs/pr-preview/pr-37/platform/iot-fleets/overview#enrollment-with-pki",{"_2861":1404,"_25133":1399,"_5":25466,"_17569":45189,"_23818":45190,"_2388":44608},[],"/docs/pr-preview/pr-37/platform/iot-fleets/overview#integrations",{"_2861":1405,"_25133":1399,"_5":25466,"_17569":45192,"_23818":45193,"_2388":45194},[],"/docs/pr-preview/pr-37/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2861":1406,"_25133":1399,"_17569":45196,"_5":17464,"_23818":1399,"_2388":45197},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2861":1407,"_25133":1399,"_17569":45199,"_5":17464,"_23818":45180,"_2388":45200},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2861":1408,"_25133":1399,"_17569":45202,"_5":17464,"_23818":45180,"_2388":45203},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2861":1409,"_25133":1399,"_17569":45205,"_5":17464,"_23818":45184,"_2388":45206},[],"Resource",{"_2861":1410,"_25133":1399,"_17569":45208,"_5":17464,"_23818":45184,"_2388":45209},[],"What it represents",{"_2861":1411,"_25133":1399,"_17569":45211,"_5":17464,"_23818":45184,"_2388":45212},[],"**Device**",{"_2861":1412,"_25133":1399,"_17569":45214,"_5":17464,"_23818":45184,"_2388":45215},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2861":1413,"_25133":1399,"_17569":45217,"_5":17464,"_23818":45184,"_2388":45218},[],"**Identity**",{"_2861":1414,"_25133":1399,"_17569":45220,"_5":17464,"_23818":45184,"_2388":45221},[],"The device's association with its certificates: an active version and a history.",{"_2861":1415,"_25133":1399,"_17569":45223,"_5":17464,"_23818":45184,"_2388":45224},[],"**DMS**",{"_2861":1416,"_25133":1399,"_17569":45226,"_5":17464,"_23818":45184,"_2388":45227},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2861":1417,"_25133":1399,"_17569":45229,"_5":17464,"_23818":45184,"_2388":45230},[],"**Fleet**",{"_2861":1418,"_25133":1399,"_17569":45232,"_5":17464,"_23818":45184,"_2388":45233},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2861":1419,"_25133":1399,"_17569":45235,"_5":17464,"_23818":45184,"_2388":45236},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2861":1420,"_25133":1399,"_17569":45238,"_5":17464,"_23818":45184,"_2388":45239},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2861":1421,"_25133":1399,"_17569":45241,"_5":17464,"_23818":45187,"_2388":45242},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2861":1422,"_25133":1399,"_17569":45244,"_5":17464,"_23818":45187,"_2388":45245},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2861":1423,"_25133":1399,"_17569":45247,"_5":17464,"_23818":45187,"_2388":45248},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2861":1424,"_25133":1399,"_17569":45250,"_5":17464,"_23818":45187,"_2388":45251},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2861":1425,"_25133":1399,"_17569":45253,"_5":17464,"_23818":45187,"_2388":45254},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2861":1426,"_25133":1399,"_17569":45256,"_5":17464,"_23818":45187,"_2388":45257},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2861":1427,"_25133":1399,"_17569":45259,"_5":17464,"_23818":45187,"_2388":45260},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2861":1428,"_25133":1399,"_17569":45262,"_5":17464,"_23818":45187,"_2388":45263},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2861":1429,"_25133":1399,"_17569":45265,"_5":17464,"_23818":45190,"_2388":45266},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2861":1430,"_25133":1399,"_17569":45268,"_5":17464,"_23818":45190,"_2388":45269},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2861":1431,"_25133":1399,"_17569":45271,"_5":17464,"_23818":45193,"_2388":45272},[],"Participant",{"_2861":1432,"_25133":1399,"_17569":45274,"_5":17464,"_23818":45193,"_2388":45275},[],"Responsibility",{"_2861":1433,"_25133":1399,"_17569":45277,"_5":17464,"_23818":45193,"_2388":45278},[],"PKI administrator",{"_2861":1434,"_25133":1399,"_17569":45280,"_5":17464,"_23818":45193,"_2388":45281},[],"CA, issuance profile, chain and revocation publication.",{"_2861":1435,"_25133":1399,"_17569":45283,"_5":17464,"_23818":45193,"_2388":45284},[],"Provisioning administrator",{"_2861":1436,"_25133":1399,"_17569":45286,"_5":17464,"_23818":45193,"_2388":45287},[],"DMS, admission, authentication per operation and inventory.",{"_2861":1437,"_25133":1399,"_17569":45289,"_5":17464,"_23818":45193,"_2388":45290},[],"Device integrator",{"_2861":1438,"_25133":1399,"_17569":45292,"_5":17464,"_23818":45193,"_2388":45293},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2861":1439,"_25133":1399,"_17569":45295,"_5":17464,"_23818":45193,"_2388":45296},[],"Consumer integrator",{"_2861":1440,"_25133":1399,"_17569":45298,"_5":17464,"_23818":45193,"_2388":45299},[],"Trusted issuers, validation and device permissions in the destination.",{"_2861":1441,"_25133":1399,"_17569":45301,"_5":17464,"_23818":45193,"_2388":45302},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2861":1442,"_25133":1442,"_5":12309,"_2388":45304,"_25469":45305,"_17569":45307,"_23818":1442},"Enroll and connect your first device",[40834,42178,43152,45306],"Getting started",[],{"_2861":1443,"_25133":1442,"_17569":45309,"_5":17464,"_23818":1442,"_2388":45310},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2861":1444,"_25133":1442,"_5":25466,"_17569":45312,"_23818":45313,"_2388":40844},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2861":1445,"_25133":1442,"_5":25466,"_17569":45315,"_23818":45316,"_2388":45317},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2861":1446,"_25133":1442,"_5":25466,"_17569":45319,"_23818":45320,"_2388":45321},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2861":1447,"_25133":1442,"_5":25466,"_17569":45323,"_23818":45324,"_2388":45325},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2861":1448,"_25133":1442,"_5":25466,"_17569":45327,"_23818":45328,"_2388":45329},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2861":1449,"_25133":1442,"_5":25466,"_17569":45331,"_23818":45332,"_2388":45333},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2861":1450,"_25133":1442,"_5":25466,"_17569":45335,"_23818":45336,"_2388":45337},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2861":1451,"_25133":1442,"_5":25466,"_17569":45339,"_23818":45340,"_2388":45341},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2861":1452,"_25133":1442,"_17569":45343,"_5":17464,"_23818":1442,"_2388":45344},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2861":1453,"_25133":1442,"_17569":45346,"_5":17464,"_23818":45313,"_2388":45347},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2861":1454,"_25133":1442,"_17569":45349,"_5":17464,"_23818":45313,"_2388":45350},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2861":1455,"_25133":1442,"_17569":45352,"_5":17464,"_23818":45313,"_2388":45353},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2861":1456,"_25133":1442,"_17569":45355,"_5":17464,"_23818":45313,"_2388":45356},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2861":1457,"_25133":1442,"_17569":45358,"_5":17464,"_23818":45313,"_2388":45359},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2861":1458,"_25133":1442,"_17569":45361,"_5":17464,"_23818":45316,"_2388":45362},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2861":1459,"_25133":1442,"_17569":45364,"_5":17464,"_23818":45316,"_2388":45365},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2861":1460,"_25133":1442,"_17569":45367,"_5":17464,"_23818":45320,"_2388":45368},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2861":1461,"_25133":1442,"_17569":45370,"_5":17464,"_23818":45320,"_2388":45371},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2861":1462,"_25133":1442,"_17569":45373,"_5":17464,"_23818":45320,"_2388":45374},[],"Setting",{"_2861":1463,"_25133":1442,"_17569":45376,"_5":17464,"_23818":45320,"_2388":45377},[],"Evaluation value",{"_2861":1464,"_25133":1442,"_17569":45379,"_5":17464,"_23818":45320,"_2388":45380},[],"Enrollment CA",{"_2861":1465,"_25133":1442,"_17569":45382,"_5":17464,"_23818":45320,"_2388":45383},[],"Issuing root from `device-root.pem`.",{"_2861":1466,"_25133":1442,"_17569":45385,"_5":17464,"_23818":45320,"_2388":43463},[],{"_2861":1467,"_25133":1442,"_17569":45387,"_5":17464,"_23818":45320,"_2388":45388},[],"The 1-hour leaf profile you just prepared.",{"_2861":1468,"_25133":1442,"_17569":45390,"_5":17464,"_23818":45320,"_2388":45391},[],"Protocol / Registration Mode",{"_2861":1469,"_25133":1442,"_17569":45393,"_5":17464,"_23818":45320,"_2388":45394},[],"`EST_RFC7030` / `JITP`.",{"_2861":1470,"_25133":1442,"_17569":45396,"_5":17464,"_23818":45320,"_2388":45397},[],"Verify CSR Signature",{"_2861":1471,"_25133":1442,"_17569":45399,"_5":17464,"_23818":45320,"_2388":45400},[],"Enabled.",{"_2861":1472,"_25133":1442,"_17569":45402,"_5":17464,"_23818":45320,"_2388":45403},[],"Enable Replaceable Enrollment",{"_2861":1473,"_25133":1442,"_17569":45405,"_5":17464,"_23818":45320,"_2388":45406},[],"Disabled; the ID must be new.",{"_2861":1474,"_25133":1442,"_17569":45408,"_5":17464,"_23818":45320,"_2388":45409},[],"Initial authentication",{"_2861":1475,"_25133":1442,"_17569":45411,"_5":17464,"_23818":45320,"_2388":45412},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2861":1476,"_25133":1442,"_17569":45414,"_5":17464,"_23818":45320,"_2388":45415},[],"Renewal authentication",{"_2861":1477,"_25133":1442,"_17569":45417,"_5":17464,"_23818":45320,"_2388":45418},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2861":1478,"_25133":1442,"_17569":45420,"_5":17464,"_23818":45320,"_2388":45421},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_2861":1479,"_25133":1442,"_17569":45423,"_5":17464,"_23818":45320,"_2388":45424},[],"Empty list for this direct issuance / disabled.",{"_2861":1480,"_25133":1442,"_17569":45426,"_5":17464,"_23818":45320,"_2388":45427},[],"Re-enrollment Delta",{"_2861":1481,"_25133":1442,"_17569":45429,"_5":17464,"_23818":45320,"_2388":45430},[],"1 hour.",{"_2861":1482,"_25133":1442,"_17569":45432,"_5":17464,"_23818":45320,"_2388":45433},[],"Preventive / Critical Delta",{"_2861":1483,"_25133":1442,"_17569":45435,"_5":17464,"_23818":45320,"_2388":45436},[],"30 minutes / 10 minutes.",{"_2861":1484,"_25133":1442,"_17569":45438,"_5":17464,"_23818":45320,"_2388":45439},[],"Revoke on Re-enrollment",{"_2861":1485,"_25133":1442,"_17569":45441,"_5":17464,"_23818":45320,"_2388":45442},[],"Disabled to test the successor before retiring the previous identity.",{"_2861":1486,"_25133":1442,"_17569":45444,"_5":17464,"_23818":45320,"_2388":43471},[],{"_2861":1487,"_25133":1442,"_17569":45446,"_5":17464,"_23818":45320,"_2388":45447},[],"Disabled; the operational key is generated in the client.",{"_2861":1488,"_25133":1442,"_17569":45449,"_5":17464,"_23818":45320,"_2388":45450},[],"CA Distribution",{"_2861":1489,"_25133":1442,"_17569":45452,"_5":17464,"_23818":45320,"_2388":45453},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2861":1490,"_25133":1442,"_17569":45455,"_5":17464,"_23818":45320,"_2388":45456},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2861":1491,"_25133":1442,"_17569":45458,"_5":17464,"_23818":45324,"_2388":45459},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2861":1492,"_25133":1442,"_17569":45461,"_5":17464,"_23818":45324,"_2388":45462},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2861":1493,"_25133":1442,"_17569":45464,"_5":17464,"_23818":45328,"_2388":45465},[],"Generate a new key and CSR with the selected identifier:",{"_2861":1494,"_25133":1442,"_17569":45467,"_5":17464,"_23818":45328,"_2388":45468},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2861":1495,"_25133":1442,"_17569":45470,"_5":17464,"_23818":45328,"_2388":45471},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2861":1496,"_25133":1442,"_17569":45473,"_5":17464,"_23818":45332,"_2388":45474},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2861":1497,"_25133":1442,"_17569":45476,"_5":17464,"_23818":45332,"_2388":45477},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2861":1498,"_25133":1442,"_17569":45479,"_5":17464,"_23818":45336,"_2388":45480},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2861":1499,"_25133":1442,"_17569":45482,"_5":17464,"_23818":45336,"_2388":45483},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2861":1500,"_25133":1442,"_17569":45485,"_5":17464,"_23818":45336,"_2388":45486},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2861":1501,"_25133":1442,"_17569":45488,"_5":17464,"_23818":45336,"_2388":45489},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2861":1502,"_25133":1442,"_17569":45491,"_5":17464,"_23818":45336,"_2388":45492},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2861":1503,"_25133":1442,"_17569":45494,"_5":17464,"_23818":45340,"_2388":45495},[],"Check",{"_2861":1504,"_25133":1442,"_17569":45497,"_5":17464,"_23818":45340,"_2388":45498},[],"Expected result",{"_2861":1505,"_25133":1442,"_17569":45500,"_5":17464,"_23818":45340,"_2388":45501},[],"Registration",{"_2861":1506,"_25133":1442,"_17569":45503,"_5":17464,"_23818":45340,"_2388":45504},[],"ID created automatically and correct DMS.",{"_2861":1507,"_25133":1442,"_17569":45506,"_5":17464,"_23818":45340,"_2388":45507},[],"Certificate",{"_2861":1508,"_25133":1442,"_17569":45509,"_5":17464,"_23818":45340,"_2388":45510},[],"CN, profile, serial and key verified.",{"_2861":1509,"_25133":1442,"_17569":45512,"_5":17464,"_23818":45340,"_2388":45513},[],"Inventory",{"_2861":1510,"_25133":1442,"_17569":45515,"_5":17464,"_23818":45340,"_2388":45516},[],"Received serial visible as the current identity and in history.",{"_2861":1511,"_25133":1442,"_17569":45518,"_5":17464,"_23818":45340,"_2388":45519},[],"Consumer",{"_2861":1512,"_25133":1442,"_17569":45521,"_5":17464,"_23818":45340,"_2388":45522},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2861":1513,"_25133":1442,"_17569":45524,"_5":17464,"_23818":45340,"_2388":45525},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2861":1514,"_25133":1442,"_17569":45527,"_5":17464,"_23818":45340,"_2388":45528},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2861":1515,"_25133":1515,"_5":12309,"_2388":43168,"_25469":45530,"_17569":45531,"_23818":1515},[40834,42178,43152,45306],[],{"_2861":1516,"_25133":1515,"_17569":45533,"_5":17464,"_23818":1515,"_2388":45534},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2861":1517,"_25133":1515,"_5":25466,"_17569":45536,"_23818":45537,"_2388":40844},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2861":1518,"_25133":1515,"_5":25466,"_17569":45539,"_23818":45540,"_2388":45541},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2861":1519,"_25133":1515,"_5":25466,"_17569":45543,"_23818":45544,"_2388":45545},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2861":1520,"_25133":1515,"_5":25466,"_17569":45547,"_23818":45548,"_2388":45549},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2861":1521,"_25133":1515,"_5":25466,"_17569":45551,"_23818":45552,"_2388":45553},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2861":1522,"_25133":1515,"_5":25466,"_17569":45555,"_23818":45556,"_2388":45557},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2861":1523,"_25133":1515,"_5":25466,"_17569":45559,"_23818":45560,"_2388":45498},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2861":1524,"_25133":1515,"_5":25466,"_17569":45562,"_23818":45563,"_2388":45564},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2861":1525,"_25133":1515,"_5":25466,"_17569":45566,"_23818":45567,"_2388":45568},[],"/docs/pr-preview/pr-37/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2861":1526,"_25133":1515,"_17569":45570,"_5":17464,"_23818":1515,"_2388":45571},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2861":1527,"_25133":1515,"_17569":45573,"_5":17464,"_23818":1515,"_2388":45574},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2861":1528,"_25133":1515,"_17569":45576,"_5":17464,"_23818":45537,"_2388":45577},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2861":1529,"_25133":1515,"_17569":45579,"_5":17464,"_23818":45537,"_2388":45580},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2861":1530,"_25133":1515,"_17569":45582,"_5":17464,"_23818":45537,"_2388":45583},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2861":1531,"_25133":1515,"_17569":45585,"_5":17464,"_23818":45537,"_2388":45586},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2861":1532,"_25133":1515,"_17569":45588,"_5":17464,"_23818":45540,"_2388":45589},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2861":1533,"_25133":1515,"_17569":45591,"_5":17464,"_23818":45540,"_2388":45592},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2861":1534,"_25133":1515,"_17569":45594,"_5":17464,"_23818":45540,"_2388":45595},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2861":1535,"_25133":1515,"_17569":45597,"_5":17464,"_23818":45540,"_2388":45598},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2861":1536,"_25133":1515,"_17569":45600,"_5":17464,"_23818":45540,"_2388":45601},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2861":1537,"_25133":1515,"_17569":45603,"_5":17464,"_23818":45540,"_2388":45604},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2861":1538,"_25133":1515,"_17569":45606,"_5":17464,"_23818":45540,"_2388":45607},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2861":1539,"_25133":1515,"_17569":45609,"_5":17464,"_23818":45540,"_2388":45610},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2861":1540,"_25133":1515,"_17569":45612,"_5":17464,"_23818":45544,"_2388":45613},[],"Open **Managed Devices** and the registration action. Complete:",{"_2861":1541,"_25133":1515,"_17569":45615,"_5":17464,"_23818":45544,"_2388":45616},[],"**Device ID**: `device-001`.",{"_2861":1542,"_25133":1515,"_17569":45618,"_5":17464,"_23818":45544,"_2388":45619},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2861":1543,"_25133":1515,"_17569":45621,"_5":17464,"_23818":45544,"_2388":45622},[],"**Icon** and **Tags**: optional classification.",{"_2861":1544,"_25133":1515,"_17569":45624,"_5":17464,"_23818":45544,"_2388":45625},[],"Confirm registration.",{"_2861":1545,"_25133":1515,"_17569":45627,"_5":17464,"_23818":45548,"_2388":45628},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2861":1546,"_25133":1515,"_17569":45630,"_5":17464,"_23818":45548,"_2388":45631},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2861":1547,"_25133":1515,"_17569":45633,"_5":17464,"_23818":45552,"_2388":45634},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2861":1548,"_25133":1515,"_17569":45636,"_5":17464,"_23818":45552,"_2388":45637},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2861":1549,"_25133":1515,"_17569":45639,"_5":17464,"_23818":45556,"_2388":45640},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2861":1550,"_25133":1515,"_17569":45642,"_5":17464,"_23818":45556,"_2388":45643},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2861":1551,"_25133":1515,"_17569":45645,"_5":17464,"_23818":45560,"_2388":45495},[],{"_2861":1552,"_25133":1515,"_17569":45647,"_5":17464,"_23818":45560,"_2388":45648},[],"Result",{"_2861":1553,"_25133":1515,"_17569":45650,"_5":17464,"_23818":45560,"_2388":45651},[],"Device",{"_2861":1554,"_25133":1515,"_17569":45653,"_5":17464,"_23818":45560,"_2388":45654},[],"`device-001` appears in inventory with the expected DMS.",{"_2861":1555,"_25133":1515,"_17569":45656,"_5":17464,"_23818":45560,"_2388":45657},[],"Current identity",{"_2861":1556,"_25133":1515,"_17569":45659,"_5":17464,"_23818":45560,"_2388":45660},[],"The associated certificate matches the one you verified in PKI.",{"_2861":1557,"_25133":1515,"_17569":45662,"_5":17464,"_23818":45560,"_2388":45663},[],"History",{"_2861":1558,"_25133":1515,"_17569":45665,"_5":17464,"_23818":45560,"_2388":45666},[],"The associated issuance appears with its serial number and dates.",{"_2861":1559,"_25133":1515,"_17569":45668,"_5":17464,"_23818":45560,"_2388":45669},[],"Key and certificate",{"_2861":1560,"_25133":1515,"_17569":45671,"_5":17464,"_23818":45560,"_2388":45672},[],"You have the verified pair ready to install on the device.",{"_2861":1561,"_25133":1515,"_17569":45674,"_5":17464,"_23818":45563,"_2388":45675},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2861":1562,"_25133":1515,"_17569":45677,"_5":17464,"_23818":45563,"_2388":45678},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2861":1563,"_25133":1515,"_17569":45680,"_5":17464,"_23818":45563,"_2388":45681},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2861":1564,"_25133":1515,"_17569":45683,"_5":17464,"_23818":45563,"_2388":45684},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2861":1565,"_25133":1515,"_17569":45686,"_5":17464,"_23818":45567,"_2388":45687},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2861":1566,"_25133":1515,"_17569":45689,"_5":17464,"_23818":45567,"_2388":45690},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2861":1567,"_25133":1515,"_17569":45692,"_5":17464,"_23818":45567,"_2388":45693},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2861":1568,"_25133":1568,"_5":12309,"_2388":45695,"_25469":45696,"_17569":45697,"_23818":1568},"Lamassu IoT Platform",[40834,42178],[],{"_2861":1569,"_25133":1568,"_17569":45699,"_5":17464,"_23818":1568,"_2388":45700},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2861":1570,"_25133":1568,"_5":25466,"_17569":45702,"_23818":45703,"_2388":45181},[],"/docs/pr-preview/pr-37/platform/overview#start-here",{"_2861":1571,"_25133":1568,"_5":25466,"_17569":45705,"_23818":45706,"_2388":45707},[],"/docs/pr-preview/pr-37/platform/overview#choose-your-path","Choose your path",{"_2861":1572,"_25133":1568,"_5":25466,"_17569":45709,"_23818":45710,"_2388":45711},[],"/docs/pr-preview/pr-37/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2861":1573,"_25133":1568,"_5":25466,"_17569":45713,"_23818":45714,"_2388":45715},[],"/docs/pr-preview/pr-37/platform/overview#core-capabilities","Core capabilities",{"_2861":1574,"_25133":1568,"_5":25466,"_17569":45717,"_23818":45718,"_2388":45719},[],"/docs/pr-preview/pr-37/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2861":1575,"_25133":1568,"_5":25466,"_17569":45721,"_23818":45722,"_2388":45723},[],"/docs/pr-preview/pr-37/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2861":1576,"_25133":1568,"_5":25466,"_17569":45725,"_23818":45726,"_2388":45727},[],"/docs/pr-preview/pr-37/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2861":1577,"_25133":1568,"_5":25466,"_17569":45729,"_23818":45730,"_2388":45731},[],"/docs/pr-preview/pr-37/platform/overview#automate-device-identities","Automate device identities",{"_2861":1578,"_25133":1568,"_5":25466,"_17569":45733,"_23818":45734,"_2388":45735},[],"/docs/pr-preview/pr-37/platform/overview#publish-validation-status","Publish validation status",{"_2861":1579,"_25133":1568,"_5":25466,"_17569":45737,"_23818":45738,"_2388":45739},[],"/docs/pr-preview/pr-37/platform/overview#react-to-events","React to events",{"_2861":1580,"_25133":1568,"_5":25466,"_17569":45741,"_23818":45742,"_2388":45743},[],"/docs/pr-preview/pr-37/platform/overview#operational-reference","Operational reference",{"_2861":1581,"_25133":1568,"_17569":45745,"_5":17464,"_23818":1568,"_2388":45746},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2861":1582,"_25133":1568,"_17569":45748,"_5":17464,"_23818":45703,"_2388":45749},[],"Choose the result you need:",{"_2861":1583,"_25133":1568,"_17569":45751,"_5":17464,"_23818":45703,"_2388":45752},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2861":1584,"_25133":1568,"_17569":45754,"_5":17464,"_23818":45703,"_2388":45755},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2861":1585,"_25133":1568,"_17569":45757,"_5":17464,"_23818":45703,"_2388":45758},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2861":1586,"_25133":1568,"_17569":45760,"_5":17464,"_23818":45706,"_2388":45761},[],"Section",{"_2861":1587,"_25133":1568,"_17569":45763,"_5":17464,"_23818":45706,"_2388":45764},[],"What you manage",{"_2861":1588,"_25133":1568,"_17569":45766,"_5":17464,"_23818":45706,"_2388":45767},[],"Entry point",{"_2861":1589,"_25133":1568,"_17569":45769,"_5":17464,"_23818":45706,"_2388":45770},[],"**PKI**",{"_2861":1590,"_25133":1568,"_17569":45772,"_5":17464,"_23818":45706,"_2388":45773},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2861":1591,"_25133":1568,"_17569":45775,"_5":17464,"_23818":45706,"_2388":45776},[],"PKI overview",{"_2861":1592,"_25133":1568,"_17569":45778,"_5":17464,"_23818":45706,"_2388":45779},[],"**IoT Fleets**",{"_2861":1593,"_25133":1568,"_17569":45781,"_5":17464,"_23818":45706,"_2388":45782},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2861":1594,"_25133":1568,"_17569":45784,"_5":17464,"_23818":45706,"_2388":45785},[],"IoT Fleets overview",{"_2861":1595,"_25133":1568,"_17569":45787,"_5":17464,"_23818":45706,"_2388":45788},[],"**Administration**",{"_2861":1596,"_25133":1568,"_17569":45790,"_5":17464,"_23818":45706,"_2388":45791},[],"Operator permissions, audit and event subscriptions.",{"_2861":1597,"_25133":1568,"_17569":45793,"_5":17464,"_23818":45706,"_2388":42176},[],{"_2861":1598,"_25133":1568,"_17569":45795,"_5":17464,"_23818":45706,"_2388":45796},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2861":1599,"_25133":1568,"_17569":45798,"_5":17464,"_23818":45710,"_2388":45799},[],"An identity's journey connects four responsibilities:",{"_2861":1600,"_25133":1568,"_17569":45801,"_5":17464,"_23818":45710,"_2388":45802},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2861":1601,"_25133":1568,"_17569":45804,"_5":17464,"_23818":45710,"_2388":45805},[],"The provisioning administrator configures the DMS and initial trust.",{"_2861":1602,"_25133":1568,"_17569":45807,"_5":17464,"_23818":45710,"_2388":45808},[],"The device client requests a certificate and installs it with the matching key.",{"_2861":1603,"_25133":1568,"_17569":45810,"_5":17464,"_23818":45710,"_2388":45811},[],"The consumer validates the identity and applies its access permissions.",{"_2861":1604,"_25133":1568,"_17569":45813,"_5":17464,"_23818":45710,"_2388":45814},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2861":1605,"_25133":1568,"_17569":45816,"_5":17464,"_23818":45718,"_2388":45817},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2861":1606,"_25133":1568,"_17569":45819,"_5":17464,"_23818":45722,"_2388":45820},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2861":1607,"_25133":1568,"_17569":45822,"_5":17464,"_23818":45726,"_2388":45823},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2861":1608,"_25133":1568,"_17569":45825,"_5":17464,"_23818":45730,"_2388":45826},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2861":1609,"_25133":1568,"_17569":45828,"_5":17464,"_23818":45734,"_2388":45829},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2861":1610,"_25133":1568,"_17569":45831,"_5":17464,"_23818":45738,"_2388":45832},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2861":1611,"_25133":1568,"_17569":45834,"_5":17464,"_23818":45742,"_2388":45275},[],{"_2861":1612,"_25133":1568,"_17569":45836,"_5":17464,"_23818":45742,"_2388":45837},[],"What it prepares or checks",{"_2861":1613,"_25133":1568,"_17569":45839,"_5":17464,"_23818":45742,"_2388":45278},[],{"_2861":1614,"_25133":1568,"_17569":45841,"_5":17464,"_23818":45742,"_2388":45842},[],"Key custody, CA hierarchy, profiles and validation.",{"_2861":1615,"_25133":1568,"_17569":45844,"_5":17464,"_23818":45742,"_2388":45845},[],"Fleet administrator",{"_2861":1616,"_25133":1568,"_17569":45847,"_5":17464,"_23818":45742,"_2388":45848},[],"DMS, device admission, renewal policy and inventory.",{"_2861":1617,"_25133":1568,"_17569":45850,"_5":17464,"_23818":45742,"_2388":45290},[],{"_2861":1618,"_25133":1568,"_17569":45852,"_5":17464,"_23818":45742,"_2388":45853},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2861":1619,"_25133":1568,"_17569":45855,"_5":17464,"_23818":45742,"_2388":45296},[],{"_2861":1620,"_25133":1568,"_17569":45857,"_5":17464,"_23818":45742,"_2388":45858},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2861":1621,"_25133":1568,"_17569":45860,"_5":17464,"_23818":45742,"_2388":45861},[],"Infrastructure operator",{"_2861":1622,"_25133":1568,"_17569":45863,"_5":17464,"_23818":45742,"_2388":45864},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2861":1623,"_25133":1568,"_17569":45866,"_5":17464,"_23818":45742,"_2388":45867},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2861":1624,"_25133":1624,"_5":12309,"_2388":45869,"_25469":45870,"_17569":45873,"_23818":1624},"CA hierarchy and rotation",[40834,42178,45871,45872],"PKI","Keys, authorities and certificates",[],{"_2861":1625,"_25133":1624,"_17569":45875,"_5":17464,"_23818":1624,"_2388":45876},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2861":1626,"_25133":1624,"_5":25466,"_17569":45878,"_23818":45879,"_2388":45880},[],"/docs/pr-preview/pr-37/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2861":1627,"_25133":1624,"_5":25466,"_17569":45882,"_23818":45883,"_2388":45884},[],"/docs/pr-preview/pr-37/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2861":1628,"_25133":1624,"_5":25466,"_17569":45886,"_23818":45887,"_2388":45888},[],"/docs/pr-preview/pr-37/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2861":1629,"_25133":1624,"_5":25466,"_17569":45890,"_23818":45891,"_2388":45892},[],"/docs/pr-preview/pr-37/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2861":1630,"_25133":1624,"_5":25466,"_17569":45894,"_23818":45895,"_2388":45896},[],"/docs/pr-preview/pr-37/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2861":1631,"_25133":1624,"_5":25466,"_17569":45898,"_23818":45899,"_2388":45900},[],"/docs/pr-preview/pr-37/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2861":1632,"_25133":1624,"_5":25466,"_17569":45902,"_23818":45903,"_2388":45904},[],"/docs/pr-preview/pr-37/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2861":1633,"_25133":1624,"_5":25466,"_17569":45906,"_23818":45907,"_2388":45908},[],"/docs/pr-preview/pr-37/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2861":1634,"_25133":1624,"_5":25466,"_17569":45910,"_23818":45911,"_2388":45912},[],"/docs/pr-preview/pr-37/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2861":1635,"_25133":1624,"_5":25466,"_17569":45914,"_23818":45915,"_2388":45916},[],"/docs/pr-preview/pr-37/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2861":1636,"_25133":1624,"_5":25466,"_17569":45918,"_23818":45919,"_2388":45920},[],"/docs/pr-preview/pr-37/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2861":1637,"_25133":1624,"_5":25466,"_17569":45922,"_23818":45923,"_2388":45924},[],"/docs/pr-preview/pr-37/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2861":1638,"_25133":1624,"_17569":45926,"_5":17464,"_23818":1624,"_2388":45927},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2861":1639,"_25133":1624,"_17569":45929,"_5":17464,"_23818":1624,"_2388":45930},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2861":1640,"_25133":1624,"_17569":45932,"_5":17464,"_23818":45879,"_2388":45933},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2861":1641,"_25133":1624,"_17569":45935,"_5":17464,"_23818":45879,"_2388":45936},[],"environment, such as production and preproduction;",{"_2861":1642,"_25133":1624,"_17569":45938,"_5":17464,"_23818":45879,"_2388":45939},[],"owner or operating team;",{"_2861":1643,"_25133":1624,"_17569":45941,"_5":17464,"_23818":45879,"_2388":45942},[],"device family or manufacturing process;",{"_2861":1644,"_25133":1624,"_17569":45944,"_5":17464,"_23818":45879,"_2388":45945},[],"region or regulatory requirement;",{"_2861":1645,"_25133":1624,"_17569":45947,"_5":17464,"_23818":45879,"_2388":45948},[],"cryptographic engine or key policy;",{"_2861":1646,"_25133":1624,"_17569":45950,"_5":17464,"_23818":45879,"_2388":45951},[],"maintenance window and renewal cadence.",{"_2861":1647,"_25133":1624,"_17569":45953,"_5":17464,"_23818":45879,"_2388":45954},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2861":1648,"_25133":1624,"_17569":45956,"_5":17464,"_23818":45879,"_2388":45957},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2861":1649,"_25133":1624,"_17569":45959,"_5":17464,"_23818":45883,"_2388":45960},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2861":1650,"_25133":1624,"_17569":45962,"_5":17464,"_23818":45883,"_2388":45963},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2861":1651,"_25133":1624,"_17569":45965,"_5":17464,"_23818":45883,"_2388":45966},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2861":1652,"_25133":1624,"_17569":45968,"_5":17464,"_23818":45887,"_2388":45969},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2861":1653,"_25133":1624,"_17569":45971,"_5":17464,"_23818":45887,"_2388":45972},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2861":1654,"_25133":1624,"_17569":45974,"_5":17464,"_23818":45887,"_2388":45975},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2861":1655,"_25133":1624,"_17569":45977,"_5":17464,"_23818":45887,"_2388":45978},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2861":1656,"_25133":1624,"_17569":45980,"_5":17464,"_23818":45895,"_2388":45981},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2861":1657,"_25133":1624,"_17569":45983,"_5":17464,"_23818":45899,"_2388":45984},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2861":1658,"_25133":1624,"_17569":45986,"_5":17464,"_23818":45903,"_2388":45987},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2861":1659,"_25133":1624,"_17569":45989,"_5":17464,"_23818":45907,"_2388":45990},[],"Update the enrollment CA and profile of the DMSs, and add the old CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) while old-CA cohorts still renew. The DMS guide documents the setting.",{"_2861":1660,"_25133":1624,"_17569":45992,"_5":17464,"_23818":45911,"_2388":45993},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2861":1661,"_25133":1624,"_17569":45995,"_5":17464,"_23818":45915,"_2388":45996},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2861":1662,"_25133":1624,"_17569":45998,"_5":17464,"_23818":45919,"_2388":45999},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2861":1663,"_25133":1624,"_17569":46001,"_5":17464,"_23818":45919,"_2388":46002},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2861":1664,"_25133":1624,"_17569":46004,"_5":17464,"_23818":45919,"_2388":46005},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2861":1665,"_25133":1624,"_17569":46007,"_5":17464,"_23818":45919,"_2388":46008},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2861":1666,"_25133":1624,"_17569":46010,"_5":17464,"_23818":45923,"_2388":46011},[],"The new chain ends in an anchor installed by the consumer.",{"_2861":1667,"_25133":1624,"_17569":46013,"_5":17464,"_23818":45923,"_2388":46014},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2861":1668,"_25133":1624,"_17569":46016,"_5":17464,"_23818":45923,"_2388":46017},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2861":1669,"_25133":1624,"_17569":46019,"_5":17464,"_23818":45923,"_2388":46020},[],"Re-enrollment accepts the old identity during the planned period.",{"_2861":1670,"_25133":1624,"_17569":46022,"_5":17464,"_23818":45923,"_2388":46023},[],"OCSP and CRL respond for the authorities that remain active.",{"_2861":1671,"_25133":1624,"_17569":46025,"_5":17464,"_23818":45923,"_2388":46026},[],"No DMS is left accidentally issuing from the old CA.",{"_2861":1672,"_25133":1624,"_17569":46028,"_5":17464,"_23818":45923,"_2388":46029},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2861":1673,"_25133":1673,"_5":12309,"_2388":46031,"_25469":46032,"_17569":46033,"_23818":1673},"Certification authorities",[40834,42178,45871,45872],[],{"_2861":1674,"_25133":1673,"_17569":46035,"_5":17464,"_23818":1673,"_2388":46036},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2861":1675,"_25133":1673,"_5":25466,"_17569":46038,"_23818":46039,"_2388":46040},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2861":1676,"_25133":1673,"_5":25466,"_17569":46042,"_23818":46043,"_2388":46044},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2861":1677,"_25133":1673,"_5":25466,"_17569":46046,"_23818":46047,"_2388":40844},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#before-you-begin",{"_2861":1678,"_25133":1673,"_5":25466,"_17569":46049,"_23818":46050,"_2388":46051},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2861":1679,"_25133":1673,"_5":25466,"_17569":46053,"_23818":46054,"_2388":46055},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2861":1680,"_25133":1673,"_5":25466,"_17569":46057,"_23818":46058,"_2388":46059},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2861":1681,"_25133":1673,"_5":25466,"_17569":46061,"_23818":46062,"_2388":46063},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2861":1682,"_25133":1673,"_5":25466,"_17569":46065,"_23818":46066,"_2388":46067},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2861":1683,"_25133":1673,"_5":25466,"_17569":46069,"_23818":46070,"_2388":46071},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2861":1684,"_25133":1673,"_5":25466,"_17569":46073,"_23818":46074,"_2388":46075},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2861":1685,"_25133":1673,"_5":25466,"_17569":46077,"_23818":46078,"_2388":46079},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2861":1686,"_25133":1673,"_5":25466,"_17569":46081,"_23818":46082,"_2388":46083},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2861":1687,"_25133":1673,"_5":25466,"_17569":46085,"_23818":46086,"_2388":46087},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2861":1688,"_25133":1673,"_5":25466,"_17569":46089,"_23818":46090,"_2388":46091},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2861":1689,"_25133":1673,"_5":25466,"_17569":46093,"_23818":46094,"_2388":46095},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2861":1690,"_25133":1673,"_5":25466,"_17569":46097,"_23818":46098,"_2388":46099},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2861":1691,"_25133":1673,"_5":25466,"_17569":46101,"_23818":46102,"_2388":46103},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2861":1692,"_25133":1673,"_5":25466,"_17569":46105,"_23818":46106,"_2388":46107},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2861":1693,"_25133":1673,"_5":25466,"_17569":46109,"_23818":46110,"_2388":46111},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2861":1694,"_25133":1673,"_5":25466,"_17569":46113,"_23818":46114,"_2388":46115},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2861":1695,"_25133":1673,"_5":25466,"_17569":46117,"_23818":46118,"_2388":46119},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2861":1696,"_25133":1673,"_5":25466,"_17569":46121,"_23818":46122,"_2388":46123},[],"/docs/pr-preview/pr-37/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2861":1697,"_25133":1673,"_17569":46125,"_5":17464,"_23818":1673,"_2388":46126},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2861":1698,"_25133":1673,"_17569":46128,"_5":17464,"_23818":1673,"_2388":46129},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2861":1699,"_25133":1673,"_17569":46131,"_5":17464,"_23818":1673,"_2388":46132},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2861":1700,"_25133":1673,"_17569":46134,"_5":17464,"_23818":46039,"_2388":46135},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2861":1701,"_25133":1673,"_17569":46137,"_5":17464,"_23818":46039,"_2388":46138},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2861":1702,"_25133":1673,"_17569":46140,"_5":17464,"_23818":46039,"_2388":46141},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2861":1703,"_25133":1673,"_17569":46143,"_5":17464,"_23818":46039,"_2388":46144},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2861":1704,"_25133":1673,"_17569":46146,"_5":17464,"_23818":46039,"_2388":46147},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2861":1705,"_25133":1673,"_17569":46149,"_5":17464,"_23818":46047,"_2388":46150},[],"Decide whether the CA will be a root or an intermediate.",{"_2861":1706,"_25133":1673,"_17569":46152,"_5":17464,"_23818":46047,"_2388":46153},[],"Choose the engine that will keep the key.",{"_2861":1707,"_25133":1673,"_17569":46155,"_5":17464,"_23818":46047,"_2388":46156},[],"Define a validity longer than that of the certificates it will issue.",{"_2861":1708,"_25133":1673,"_17569":46158,"_5":17464,"_23818":46047,"_2388":46159},[],"For an intermediate CA, make sure the parent CA is active.",{"_2861":1709,"_25133":1673,"_17569":46161,"_5":17464,"_23818":46050,"_2388":46162},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2861":1710,"_25133":1673,"_17569":46164,"_5":17464,"_23818":46054,"_2388":46165},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2861":1711,"_25133":1673,"_17569":46167,"_5":17464,"_23818":46054,"_2388":46168},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2861":1712,"_25133":1673,"_17569":46170,"_5":17464,"_23818":46058,"_2388":46171},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2861":1713,"_25133":1673,"_17569":46173,"_5":17464,"_23818":46062,"_2388":46174},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2861":1714,"_25133":1673,"_17569":46176,"_5":17464,"_23818":46062,"_2388":46177},[],"`C`: two-letter ISO 3166-1 country code.",{"_2861":1715,"_25133":1673,"_17569":46179,"_5":17464,"_23818":46062,"_2388":46180},[],"`ST`: state or province.",{"_2861":1716,"_25133":1673,"_17569":46182,"_5":17464,"_23818":46062,"_2388":46183},[],"`L`: locality.",{"_2861":1717,"_25133":1673,"_17569":46185,"_5":17464,"_23818":46062,"_2388":46186},[],"`O`: organization.",{"_2861":1718,"_25133":1673,"_17569":46188,"_5":17464,"_23818":46062,"_2388":46189},[],"`OU`: organizational unit.",{"_2861":1719,"_25133":1673,"_17569":46191,"_5":17464,"_23818":46062,"_2388":46192},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2861":1720,"_25133":1673,"_17569":46194,"_5":17464,"_23818":46066,"_2388":46195},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2861":1721,"_25133":1673,"_17569":46197,"_5":17464,"_23818":46066,"_2388":46198},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2861":1722,"_25133":1673,"_17569":46200,"_5":17464,"_23818":46070,"_2388":46201},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2861":1723,"_25133":1673,"_17569":46203,"_5":17464,"_23818":46070,"_2388":46204},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2861":1724,"_25133":1673,"_17569":46206,"_5":17464,"_23818":46074,"_2388":46207},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2861":1725,"_25133":1673,"_17569":46209,"_5":17464,"_23818":46074,"_2388":46210},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2861":1726,"_25133":1673,"_17569":46212,"_5":17464,"_23818":46078,"_2388":46213},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2861":1727,"_25133":1673,"_17569":46215,"_5":17464,"_23818":46082,"_2388":46216},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2861":1728,"_25133":1673,"_17569":46218,"_5":17464,"_23818":46086,"_2388":46219},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2861":1729,"_25133":1673,"_17569":46221,"_5":17464,"_23818":46090,"_2388":46222},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2861":1730,"_25133":1673,"_17569":46224,"_5":17464,"_23818":46094,"_2388":46225},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2861":1731,"_25133":1673,"_17569":46227,"_5":17464,"_23818":46094,"_2388":46228},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2861":1732,"_25133":1673,"_17569":46230,"_5":17464,"_23818":46098,"_2388":46231},[],"Open a CA from the inventory to review:",{"_2861":1733,"_25133":1673,"_17569":46233,"_5":17464,"_23818":46098,"_2388":46234},[],"Status and validity period.",{"_2861":1734,"_25133":1673,"_17569":46236,"_5":17464,"_23818":46098,"_2388":46237},[],"Certificate and chain in PEM format.",{"_2861":1735,"_25133":1673,"_17569":46239,"_5":17464,"_23818":46098,"_2388":46240},[],"Number of active, expired and revoked certificates.",{"_2861":1736,"_25133":1673,"_17569":46242,"_5":17464,"_23818":46098,"_2388":46243},[],"Certificates issued in **Issued Certificates**.",{"_2861":1737,"_25133":1673,"_17569":46245,"_5":17464,"_23818":46098,"_2388":46246},[],"The CRL linked to the authority.",{"_2861":1738,"_25133":1673,"_17569":46248,"_5":17464,"_23818":46098,"_2388":46249},[],"Metadata and the associated cryptographic engine.",{"_2861":1739,"_25133":1673,"_17569":46251,"_5":17464,"_23818":46098,"_2388":46252},[],"You can filter the inventory by name, status and CA type.",{"_2861":1740,"_25133":1673,"_17569":46254,"_5":17464,"_23818":46102,"_2388":46255},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2861":1741,"_25133":1673,"_17569":46257,"_5":17464,"_23818":46102,"_2388":46258},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2861":1742,"_25133":1673,"_17569":46260,"_5":17464,"_23818":46102,"_2388":46261},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2861":1743,"_25133":1673,"_17569":46263,"_5":17464,"_23818":46102,"_2388":46264},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2861":1744,"_25133":1673,"_17569":46266,"_5":17464,"_23818":46106,"_2388":46267},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2861":1745,"_25133":1673,"_17569":46269,"_5":17464,"_23818":46110,"_2388":46270},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2861":1746,"_25133":1673,"_17569":46272,"_5":17464,"_23818":46114,"_2388":46273},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2861":1747,"_25133":1673,"_17569":46275,"_5":17464,"_23818":46118,"_2388":46276},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2861":1748,"_25133":1673,"_17569":46278,"_5":17464,"_23818":46122,"_2388":46279},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2861":1749,"_25133":1673,"_17569":46281,"_5":17464,"_23818":46122,"_2388":46282},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2861":1750,"_25133":1750,"_5":12309,"_2388":46284,"_25469":46285,"_17569":46286,"_23818":1750},"Certificate profiles",[40834,42178,45871,45872],[],{"_2861":1751,"_25133":1750,"_17569":46288,"_5":17464,"_23818":1750,"_2388":46289},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2861":1752,"_25133":1750,"_5":25466,"_17569":46291,"_23818":46292,"_2388":46293},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2861":1753,"_25133":1750,"_5":25466,"_17569":46295,"_23818":46296,"_2388":46297},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#validity","Validity",{"_2861":1754,"_25133":1750,"_5":25466,"_17569":46299,"_23818":46300,"_2388":46301},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2861":1755,"_25133":1750,"_5":25466,"_17569":46303,"_23818":46304,"_2388":46305},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2861":1756,"_25133":1750,"_5":25466,"_17569":46307,"_23818":46308,"_2388":46309},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#subject","Subject",{"_2861":1757,"_25133":1750,"_5":25466,"_17569":46311,"_23818":46312,"_2388":46313},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2861":1758,"_25133":1750,"_5":25466,"_17569":46315,"_23818":46316,"_2388":46317},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2861":1759,"_25133":1750,"_5":25466,"_17569":46319,"_23818":46320,"_2388":46321},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2861":1760,"_25133":1750,"_5":25466,"_17569":46323,"_23818":46324,"_2388":46325},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2861":1761,"_25133":1750,"_5":25466,"_17569":46327,"_23818":46328,"_2388":46329},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2861":1762,"_25133":1750,"_5":25466,"_17569":46331,"_23818":46332,"_2388":46333},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2861":1763,"_25133":1750,"_5":25466,"_17569":46335,"_23818":46336,"_2388":46337},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2861":1764,"_25133":1750,"_5":25466,"_17569":46339,"_23818":46340,"_2388":46341},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2861":1765,"_25133":1750,"_5":25466,"_17569":46343,"_23818":46344,"_2388":46345},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2861":1766,"_25133":1750,"_5":25466,"_17569":46347,"_23818":46348,"_2388":46349},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#design-examples","Design examples",{"_2861":1767,"_25133":1750,"_5":25466,"_17569":46351,"_23818":46352,"_2388":46353},[],"/docs/pr-preview/pr-37/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2861":1768,"_25133":1750,"_17569":46355,"_5":17464,"_23818":1750,"_2388":46356},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2861":1769,"_25133":1750,"_17569":46358,"_5":17464,"_23818":1750,"_2388":46359},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2861":1770,"_25133":1750,"_17569":46361,"_5":17464,"_23818":46296,"_2388":46362},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2861":1771,"_25133":1750,"_17569":46364,"_5":17464,"_23818":46296,"_2388":46365},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2861":1772,"_25133":1750,"_17569":46367,"_5":17464,"_23818":46300,"_2388":46368},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2861":1773,"_25133":1750,"_17569":46370,"_5":17464,"_23818":46304,"_2388":46371},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2861":1774,"_25133":1750,"_17569":46373,"_5":17464,"_23818":46304,"_2388":46374},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2861":1775,"_25133":1750,"_17569":46376,"_5":17464,"_23818":46304,"_2388":46377},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2861":1776,"_25133":1750,"_17569":46379,"_5":17464,"_23818":46308,"_2388":46380},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2861":1777,"_25133":1750,"_17569":46382,"_5":17464,"_23818":46312,"_2388":46383},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2861":1778,"_25133":1750,"_17569":46385,"_5":17464,"_23818":46312,"_2388":46386},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2861":1779,"_25133":1750,"_17569":46388,"_5":17464,"_23818":46316,"_2388":46389},[],"The cryptographic enforcement can:",{"_2861":1780,"_25133":1750,"_17569":46391,"_5":17464,"_23818":46316,"_2388":46392},[],"allow or block RSA keys;",{"_2861":1781,"_25133":1750,"_17569":46394,"_5":17464,"_23818":46316,"_2388":46395},[],"limit the supported RSA sizes;",{"_2861":1782,"_25133":1750,"_17569":46397,"_5":17464,"_23818":46316,"_2388":46398},[],"allow or block ECDSA keys;",{"_2861":1783,"_25133":1750,"_17569":46400,"_5":17464,"_23818":46316,"_2388":46401},[],"limit the supported ECDSA sizes or curves.",{"_2861":1784,"_25133":1750,"_17569":46403,"_5":17464,"_23818":46316,"_2388":46404},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2861":1785,"_25133":1750,"_17569":46406,"_5":17464,"_23818":46320,"_2388":46407},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2861":1786,"_25133":1750,"_17569":46409,"_5":17464,"_23818":46320,"_2388":43899},[],{"_2861":1787,"_25133":1750,"_17569":46411,"_5":17464,"_23818":46320,"_2388":46412},[],"First choice",{"_2861":1788,"_25133":1750,"_17569":46414,"_5":17464,"_23818":46320,"_2388":46415},[],"Second choice",{"_2861":1789,"_25133":1750,"_17569":46417,"_5":17464,"_23818":46320,"_2388":46418},[],"If neither is supplied",{"_2861":1790,"_25133":1750,"_17569":46420,"_5":17464,"_23818":46320,"_2388":46421},[],"Direct signing with a CA",{"_2861":1791,"_25133":1750,"_17569":46423,"_5":17464,"_23818":46320,"_2388":46424},[],"`issuance_profile` embedded in the request",{"_2861":1792,"_25133":1750,"_17569":46426,"_5":17464,"_23818":46320,"_2388":46427},[],"Request `issuance_profile_id`",{"_2861":1793,"_25133":1750,"_17569":46429,"_5":17464,"_23818":46320,"_2388":46430},[],"CA default profile (`profile_id`).",{"_2861":1794,"_25133":1750,"_17569":46432,"_5":17464,"_23818":46320,"_2388":46433},[],"Issuance through a DMS",{"_2861":1795,"_25133":1750,"_17569":46435,"_5":17464,"_23818":46320,"_2388":46436},[],"`settings.issuance_profile_id`",{"_2861":1796,"_25133":1750,"_17569":46438,"_5":17464,"_23818":46320,"_2388":46439},[],"`settings.issuance_profile` embedded in the DMS",{"_2861":1797,"_25133":1750,"_17569":46441,"_5":17464,"_23818":46320,"_2388":46442},[],"Enrollment CA default profile.",{"_2861":1798,"_25133":1750,"_17569":46444,"_5":17464,"_23818":46320,"_2388":46445},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2861":1799,"_25133":1750,"_17569":46447,"_5":17464,"_23818":46320,"_2388":46448},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2861":1800,"_25133":1750,"_17569":46450,"_5":17464,"_23818":46328,"_2388":46451},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2861":1801,"_25133":1750,"_17569":46453,"_5":17464,"_23818":46332,"_2388":46454},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2861":1802,"_25133":1750,"_17569":46456,"_5":17464,"_23818":46336,"_2388":46457},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2861":1803,"_25133":1750,"_17569":46459,"_5":17464,"_23818":46340,"_2388":46460},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2861":1804,"_25133":1750,"_17569":46462,"_5":17464,"_23818":46344,"_2388":46463},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2861":1805,"_25133":1750,"_17569":46465,"_5":17464,"_23818":46344,"_2388":46466},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2861":1806,"_25133":1750,"_17569":46468,"_5":17464,"_23818":46348,"_2388":46469},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2861":1807,"_25133":1750,"_17569":46471,"_5":17464,"_23818":46348,"_2388":46472},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2861":1808,"_25133":1750,"_17569":46474,"_5":17464,"_23818":46348,"_2388":46475},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2861":1809,"_25133":1750,"_17569":46477,"_5":17464,"_23818":46348,"_2388":46478},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2861":1810,"_25133":1750,"_17569":46480,"_5":17464,"_23818":46352,"_2388":46481},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2861":1811,"_25133":1750,"_17569":46483,"_5":17464,"_23818":46352,"_2388":46484},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2861":1812,"_25133":1812,"_5":12309,"_2388":46486,"_25469":46487,"_17569":46489,"_23818":1812},"Certificate validation",[40834,42178,45871,46488],"Validation",[],{"_2861":1813,"_25133":1812,"_17569":46491,"_5":17464,"_23818":1812,"_2388":46492},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2861":1814,"_25133":1812,"_5":25466,"_17569":46494,"_23818":46495,"_2388":46496},[],"/docs/pr-preview/pr-37/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2861":1815,"_25133":1812,"_5":25466,"_17569":46498,"_23818":46499,"_2388":46500},[],"/docs/pr-preview/pr-37/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2861":1816,"_25133":1812,"_5":25466,"_17569":46502,"_23818":46503,"_2388":46504},[],"/docs/pr-preview/pr-37/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2861":1817,"_25133":1812,"_17569":46506,"_5":17464,"_23818":1812,"_2388":46507},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2861":1818,"_25133":1812,"_17569":46509,"_5":17464,"_23818":46495,"_2388":46510},[],"Verify these criteria together:",{"_2861":1819,"_25133":1812,"_17569":46512,"_5":17464,"_23818":46495,"_2388":45495},[],{"_2861":1820,"_25133":1812,"_17569":46514,"_5":17464,"_23818":46495,"_2388":46515},[],"Required result",{"_2861":1821,"_25133":1812,"_17569":46517,"_5":17464,"_23818":46495,"_2388":46518},[],"Chain and signature",{"_2861":1822,"_25133":1812,"_17569":46520,"_5":17464,"_23818":46495,"_2388":46521},[],"Valid chain to a root deliberately installed in the consumer.",{"_2861":1823,"_25133":1812,"_17569":46523,"_5":17464,"_23818":46495,"_2388":46524},[],"Dates",{"_2861":1824,"_25133":1812,"_17569":46526,"_5":17464,"_23818":46495,"_2388":46527},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2861":1825,"_25133":1812,"_17569":46529,"_5":17464,"_23818":46495,"_2388":41881},[],{"_2861":1826,"_25133":1812,"_17569":46531,"_5":17464,"_23818":46495,"_2388":46532},[],"Name, SAN or identifier matches the expected peer.",{"_2861":1827,"_25133":1812,"_17569":46534,"_5":17464,"_23818":46495,"_2388":41217},[],{"_2861":1828,"_25133":1812,"_17569":46536,"_5":17464,"_23818":46495,"_2388":46537},[],"KU, EKU and constraints permit the specific operation.",{"_2861":1829,"_25133":1812,"_17569":46539,"_5":17464,"_23818":46495,"_2388":46540},[],"Revocation",{"_2861":1830,"_25133":1812,"_17569":46542,"_5":17464,"_23818":46495,"_2388":46543},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2861":1831,"_25133":1812,"_17569":46545,"_5":17464,"_23818":46495,"_2388":46546},[],"Authorization",{"_2861":1832,"_25133":1812,"_17569":46548,"_5":17464,"_23818":46495,"_2388":46549},[],"The application permits that identity to perform the action.",{"_2861":1833,"_25133":1812,"_17569":46551,"_5":17464,"_23818":46495,"_2388":46552},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2861":1834,"_25133":1812,"_17569":46554,"_5":17464,"_23818":46499,"_2388":46555},[],"Mechanism",{"_2861":1835,"_25133":1812,"_17569":46557,"_5":17464,"_23818":46499,"_2388":46558},[],"When to use it",{"_2861":1836,"_25133":1812,"_17569":46560,"_5":17464,"_23818":46499,"_2388":46561},[],"What you must maintain",{"_2861":1837,"_25133":1812,"_17569":46563,"_5":17464,"_23818":46499,"_2388":46564},[],"OCSP",{"_2861":1838,"_25133":1812,"_17569":46566,"_5":17464,"_23818":46499,"_2388":46567},[],"Status query for a specific certificate.",{"_2861":1839,"_25133":1812,"_17569":46569,"_5":17464,"_23818":46499,"_2388":46570},[],"Responder access, signature verification and cache/freshness policy.",{"_2861":1840,"_25133":1812,"_17569":46572,"_5":17464,"_23818":46499,"_2388":46573},[],"CRL",{"_2861":1841,"_25133":1812,"_17569":46575,"_5":17464,"_23818":46499,"_2388":46576},[],"Local checks for many certificates or offline operation.",{"_2861":1842,"_25133":1812,"_17569":46578,"_5":17464,"_23818":46499,"_2388":46579},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2861":1843,"_25133":1812,"_17569":46581,"_5":17464,"_23818":46499,"_2388":46582},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2861":1844,"_25133":1812,"_17569":46584,"_5":17464,"_23818":46499,"_2388":46585},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2861":1845,"_25133":1812,"_17569":46587,"_5":17464,"_23818":46503,"_2388":46588},[],"Accept a current, authorized certificate with a known chain.",{"_2861":1846,"_25133":1812,"_17569":46590,"_5":17464,"_23818":46503,"_2388":46591},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2861":1847,"_25133":1812,"_17569":46593,"_5":17464,"_23818":46503,"_2388":46594},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2861":1848,"_25133":1812,"_17569":46596,"_5":17464,"_23818":46503,"_2388":46597},[],"Check that a new connection with that identity is rejected.",{"_2861":1849,"_25133":1812,"_17569":46599,"_5":17464,"_23818":46503,"_2388":46600},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2861":1850,"_25133":1812,"_17569":46602,"_5":17464,"_23818":46503,"_2388":46603},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2861":1851,"_25133":1812,"_17569":46605,"_5":17464,"_23818":46503,"_2388":46606},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2861":1852,"_25133":1812,"_17569":46608,"_5":17464,"_23818":46503,"_2388":46609},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2861":1853,"_25133":1812,"_17569":46611,"_5":17464,"_23818":46503,"_2388":46612},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2861":1854,"_25133":1854,"_5":12309,"_2388":46614,"_25469":46615,"_17569":46616,"_23818":1854},"Certificates",[40834,42178,45871,45872],[],{"_2861":1855,"_25133":1854,"_17569":46618,"_5":17464,"_23818":1854,"_2388":46619},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2861":1856,"_25133":1854,"_5":25466,"_17569":46621,"_23818":46622,"_2388":46623},[],"/docs/pr-preview/pr-37/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2861":1857,"_25133":1854,"_5":25466,"_17569":46625,"_23818":46626,"_2388":46627},[],"/docs/pr-preview/pr-37/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2861":1858,"_25133":1854,"_5":25466,"_17569":46629,"_23818":46630,"_2388":46631},[],"/docs/pr-preview/pr-37/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2861":1859,"_25133":1854,"_5":25466,"_17569":46633,"_23818":46634,"_2388":46635},[],"/docs/pr-preview/pr-37/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2861":1860,"_25133":1854,"_5":25466,"_17569":46637,"_23818":46638,"_2388":46639},[],"/docs/pr-preview/pr-37/platform/pki/certificates#open-the-action","Open the action",{"_2861":1861,"_25133":1854,"_5":25466,"_17569":46641,"_23818":46642,"_2388":46643},[],"/docs/pr-preview/pr-37/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2861":1862,"_25133":1854,"_5":25466,"_17569":46645,"_23818":46646,"_2388":46647},[],"/docs/pr-preview/pr-37/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2861":1863,"_25133":1854,"_5":25466,"_17569":46649,"_23818":46650,"_2388":46651},[],"/docs/pr-preview/pr-37/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2861":1864,"_25133":1854,"_5":25466,"_17569":46653,"_23818":46654,"_2388":46655},[],"/docs/pr-preview/pr-37/platform/pki/certificates#continue","Continue",{"_2861":1865,"_25133":1854,"_17569":46657,"_5":17464,"_23818":1854,"_2388":46658},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2861":1866,"_25133":1854,"_17569":46660,"_5":17464,"_23818":46622,"_2388":46661},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2861":1867,"_25133":1854,"_17569":46663,"_5":17464,"_23818":46622,"_2388":46664},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2861":1868,"_25133":1854,"_17569":46666,"_5":17464,"_23818":46626,"_2388":46667},[],"Download the PEM and inspect it:",{"_2861":1869,"_25133":1854,"_17569":46669,"_5":17464,"_23818":46626,"_2388":46670},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2861":1870,"_25133":1854,"_17569":46672,"_5":17464,"_23818":46630,"_2388":46673},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2861":1871,"_25133":1854,"_17569":46675,"_5":17464,"_23818":46630,"_2388":46676},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2861":1872,"_25133":1854,"_17569":46678,"_5":17464,"_23818":46630,"_2388":46679},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2861":1873,"_25133":1854,"_17569":46681,"_5":17464,"_23818":46630,"_2388":46682},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2861":1874,"_25133":1854,"_17569":46684,"_5":17464,"_23818":46630,"_2388":46685},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2861":1875,"_25133":1854,"_17569":46687,"_5":17464,"_23818":46630,"_2388":46688},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2861":1876,"_25133":1854,"_17569":46690,"_5":17464,"_23818":46630,"_2388":46691},[],"For browser key generation, follow Issue your first certificate.",{"_2861":1877,"_25133":1854,"_17569":46693,"_5":17464,"_23818":46634,"_2388":46694},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2861":1878,"_25133":1854,"_17569":46696,"_5":17464,"_23818":46638,"_2388":46697},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2861":1879,"_25133":1854,"_17569":46699,"_5":17464,"_23818":46642,"_2388":46700},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2861":1880,"_25133":1854,"_17569":46702,"_5":17464,"_23818":46646,"_2388":46703},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2861":1881,"_25133":1854,"_17569":46705,"_5":17464,"_23818":46646,"_2388":46706},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2861":1882,"_25133":1854,"_17569":46708,"_5":17464,"_23818":46646,"_2388":46709},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2861":1883,"_25133":1854,"_17569":46711,"_5":17464,"_23818":46650,"_2388":46712},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2861":1884,"_25133":1854,"_17569":46714,"_5":17464,"_23818":46650,"_2388":46715},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2861":1885,"_25133":1854,"_17569":46717,"_5":17464,"_23818":46650,"_2388":46718},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2861":1886,"_25133":1854,"_17569":46720,"_5":17464,"_23818":46654,"_2388":46721},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2861":1887,"_25133":1854,"_17569":46723,"_5":17464,"_23818":46654,"_2388":46724},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2861":1888,"_25133":1888,"_5":12309,"_2388":46726,"_25469":46727,"_17569":46729,"_23818":1888},"Certificate lifecycle",[40834,42178,45871,46728],"Concepts",[],{"_2861":1889,"_25133":1888,"_17569":46731,"_5":17464,"_23818":1888,"_2388":46732},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2861":1890,"_25133":1888,"_5":25466,"_17569":46734,"_23818":46735,"_2388":46736},[],"/docs/pr-preview/pr-37/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2861":1891,"_25133":1888,"_5":25466,"_17569":46738,"_23818":46739,"_2388":46740},[],"/docs/pr-preview/pr-37/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2861":1892,"_25133":1888,"_5":25466,"_17569":46742,"_23818":46743,"_2388":46744},[],"/docs/pr-preview/pr-37/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2861":1893,"_25133":1888,"_5":25466,"_17569":46746,"_23818":46747,"_2388":46748},[],"/docs/pr-preview/pr-37/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2861":1894,"_25133":1888,"_5":25466,"_17569":46750,"_23818":46751,"_2388":46752},[],"/docs/pr-preview/pr-37/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2861":1895,"_25133":1888,"_5":25466,"_17569":46754,"_23818":46755,"_2388":46756},[],"/docs/pr-preview/pr-37/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2861":1896,"_25133":1888,"_5":25466,"_17569":46758,"_23818":46759,"_2388":46760},[],"/docs/pr-preview/pr-37/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2861":1897,"_25133":1888,"_5":25466,"_17569":46762,"_23818":46763,"_2388":46764},[],"/docs/pr-preview/pr-37/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2861":1898,"_25133":1888,"_5":25466,"_17569":46766,"_23818":46767,"_2388":46768},[],"/docs/pr-preview/pr-37/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2861":1899,"_25133":1888,"_5":25466,"_17569":46770,"_23818":46771,"_2388":46772},[],"/docs/pr-preview/pr-37/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2861":1900,"_25133":1888,"_17569":46774,"_5":17464,"_23818":1888,"_2388":46775},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2861":1901,"_25133":1888,"_17569":46777,"_5":17464,"_23818":46739,"_2388":46778},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2861":1902,"_25133":1888,"_17569":46780,"_5":17464,"_23818":46743,"_2388":46781},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2861":1903,"_25133":1888,"_17569":46783,"_5":17464,"_23818":46747,"_2388":46784},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2861":1904,"_25133":1888,"_17569":46786,"_5":17464,"_23818":46751,"_2388":46787},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2861":1905,"_25133":1888,"_17569":46789,"_5":17464,"_23818":46755,"_2388":46790},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2861":1906,"_25133":1888,"_17569":46792,"_5":17464,"_23818":46759,"_2388":46793},[],"Lamassu persists four X.509 states:",{"_2861":1907,"_25133":1888,"_17569":46795,"_5":17464,"_23818":46759,"_2388":46796},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2861":1908,"_25133":1888,"_17569":46798,"_5":17464,"_23818":46759,"_2388":46799},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2861":1909,"_25133":1888,"_17569":46801,"_5":17464,"_23818":46759,"_2388":46802},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2861":1910,"_25133":1888,"_17569":46804,"_5":17464,"_23818":46759,"_2388":46805},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2861":1911,"_25133":1888,"_17569":46807,"_5":17464,"_23818":46759,"_2388":46808},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2861":1912,"_25133":1888,"_17569":46810,"_5":17464,"_23818":46763,"_2388":46811},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2861":1913,"_25133":1888,"_17569":46813,"_5":17464,"_23818":46763,"_2388":46814},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2861":1914,"_25133":1888,"_17569":46816,"_5":17464,"_23818":46763,"_2388":46817},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2861":1915,"_25133":1888,"_17569":46819,"_5":17464,"_23818":46767,"_2388":46820},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2861":1916,"_25133":1888,"_17569":46822,"_5":17464,"_23818":46767,"_2388":46823},[],"Before confirming:",{"_2861":1917,"_25133":1888,"_17569":46825,"_5":17464,"_23818":46767,"_2388":46826},[],"Identify DMSs, devices and services that trust that chain.",{"_2861":1918,"_25133":1888,"_17569":46828,"_5":17464,"_23818":46767,"_2388":46829},[],"Distribute the new chain of trust.",{"_2861":1919,"_25133":1888,"_17569":46831,"_5":17464,"_23818":46767,"_2388":46832},[],"Reissue the necessary identities.",{"_2861":1920,"_25133":1888,"_17569":46834,"_5":17464,"_23818":46767,"_2388":46835},[],"Check OCSP and CRL from a real consumer.",{"_2861":1921,"_25133":1888,"_17569":46837,"_5":17464,"_23818":46767,"_2388":46838},[],"Revoke the old CA once no legitimate traffic remains.",{"_2861":1922,"_25133":1888,"_17569":46840,"_5":17464,"_23818":46767,"_2388":46841},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2861":1923,"_25133":1888,"_17569":46843,"_5":17464,"_23818":46771,"_2388":46844},[],"Certificates entering the preventive or critical renewal window.",{"_2861":1924,"_25133":1888,"_17569":46846,"_5":17464,"_23818":46771,"_2388":46847},[],"Repeated enrollment or re-enrollment failures.",{"_2861":1925,"_25133":1888,"_17569":46849,"_5":17464,"_23818":46771,"_2388":46850},[],"Status changes and revocation reasons.",{"_2861":1926,"_25133":1888,"_17569":46852,"_5":17464,"_23818":46771,"_2388":46853},[],"OCSP and CRL publication and validity.",{"_2861":1927,"_25133":1888,"_17569":46855,"_5":17464,"_23818":46771,"_2388":46856},[],"Dependencies still presenting a replaced certificate.",{"_2861":1928,"_25133":1888,"_17569":46858,"_5":17464,"_23818":46771,"_2388":46859},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2861":1929,"_25133":1929,"_5":12309,"_2388":46861,"_25469":46862,"_17569":46863,"_23818":1929},"Trust model",[40834,42178,45871,46728],[],{"_2861":1930,"_25133":1929,"_17569":46865,"_5":17464,"_23818":1929,"_2388":46866},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2861":1931,"_25133":1929,"_5":25466,"_17569":46868,"_23818":46869,"_2388":46870},[],"/docs/pr-preview/pr-37/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2861":1932,"_25133":1929,"_5":25466,"_17569":46872,"_23818":46873,"_2388":46874},[],"/docs/pr-preview/pr-37/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2861":1933,"_25133":1929,"_5":25466,"_17569":46876,"_23818":46877,"_2388":46878},[],"/docs/pr-preview/pr-37/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2861":1934,"_25133":1929,"_5":25466,"_17569":46880,"_23818":46881,"_2388":46882},[],"/docs/pr-preview/pr-37/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2861":1935,"_25133":1929,"_5":25466,"_17569":46884,"_23818":46885,"_2388":46886},[],"/docs/pr-preview/pr-37/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2861":1936,"_25133":1929,"_5":25466,"_17569":46888,"_23818":46889,"_2388":46890},[],"/docs/pr-preview/pr-37/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2861":1937,"_25133":1929,"_5":25466,"_17569":46892,"_23818":46893,"_2388":46894},[],"/docs/pr-preview/pr-37/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2861":1938,"_25133":1929,"_5":25466,"_17569":46896,"_23818":46897,"_2388":46898},[],"/docs/pr-preview/pr-37/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2861":1939,"_25133":1929,"_5":25466,"_17569":46900,"_23818":46901,"_2388":46902},[],"/docs/pr-preview/pr-37/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2861":1940,"_25133":1929,"_5":25466,"_17569":46904,"_23818":46905,"_2388":46906},[],"/docs/pr-preview/pr-37/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2861":1941,"_25133":1929,"_17569":46908,"_5":17464,"_23818":1929,"_2388":46909},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2861":1942,"_25133":1929,"_17569":46911,"_5":17464,"_23818":46873,"_2388":46912},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2861":1943,"_25133":1929,"_17569":46914,"_5":17464,"_23818":46877,"_2388":46915},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2861":1944,"_25133":1929,"_17569":46917,"_5":17464,"_23818":46881,"_2388":46918},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2861":1945,"_25133":1929,"_17569":46920,"_5":17464,"_23818":46885,"_2388":46921},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2861":1946,"_25133":1929,"_17569":46923,"_5":17464,"_23818":46889,"_2388":46924},[],"The device proves it can enroll according to the DMS policy.",{"_2861":1947,"_25133":1929,"_17569":46926,"_5":17464,"_23818":46889,"_2388":46927},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2861":1948,"_25133":1929,"_17569":46929,"_5":17464,"_23818":46889,"_2388":46930},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2861":1949,"_25133":1929,"_17569":46932,"_5":17464,"_23818":46889,"_2388":46933},[],"The device installs the certificate and the chain it needs.",{"_2861":1950,"_25133":1929,"_17569":46935,"_5":17464,"_23818":46889,"_2388":46936},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2861":1951,"_25133":1929,"_17569":46938,"_5":17464,"_23818":46889,"_2388":46939},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2861":1952,"_25133":1929,"_17569":46941,"_5":17464,"_23818":46893,"_2388":46942},[],"A DMS relates three sets that are worth designing separately:",{"_2861":1953,"_25133":1929,"_17569":46944,"_5":17464,"_23818":46893,"_2388":46945},[],"**Enrollment CA:** signs the new identities.",{"_2861":1954,"_25133":1929,"_17569":46947,"_5":17464,"_23818":46893,"_2388":46948},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the validation CAs configured in the re-enrollment block.",{"_2861":1955,"_25133":1929,"_17569":46950,"_5":17464,"_23818":46893,"_2388":46951},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2861":1956,"_25133":1929,"_17569":46953,"_5":17464,"_23818":46893,"_2388":46954},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2861":1957,"_25133":1929,"_17569":46956,"_5":17464,"_23818":46897,"_2388":46957},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2861":1958,"_25133":1929,"_17569":46959,"_5":17464,"_23818":46897,"_2388":46960},[],"that the current date is between `Not Before` and `Not After`;",{"_2861":1959,"_25133":1929,"_17569":46962,"_5":17464,"_23818":46897,"_2388":46963},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2861":1960,"_25133":1929,"_17569":46965,"_5":17464,"_23818":46897,"_2388":46966},[],"that names, SANs and subject match the expected identity;",{"_2861":1961,"_25133":1929,"_17569":46968,"_5":17464,"_23818":46897,"_2388":46969},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2861":1962,"_25133":1929,"_17569":46971,"_5":17464,"_23818":46897,"_2388":46972},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2861":1963,"_25133":1929,"_17569":46974,"_5":17464,"_23818":46897,"_2388":46975},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2861":1964,"_25133":1929,"_17569":46977,"_5":17464,"_23818":46901,"_2388":46978},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2861":1965,"_25133":1929,"_17569":46980,"_5":17464,"_23818":46905,"_2388":46981},[],"Keep the root out of daily operations, or with very restricted access.",{"_2861":1966,"_25133":1929,"_17569":46983,"_5":17464,"_23818":46905,"_2388":46984},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2861":1967,"_25133":1929,"_17569":46986,"_5":17464,"_23818":46905,"_2388":46987},[],"Assign explicit profiles to every use case.",{"_2861":1968,"_25133":1929,"_17569":46989,"_5":17464,"_23818":46905,"_2388":46990},[],"Distribute the new trust before starting a rotation.",{"_2861":1969,"_25133":1929,"_17569":46992,"_5":17464,"_23818":46905,"_2388":46993},[],"Keep enough overlap to renew a disconnected fleet.",{"_2861":1970,"_25133":1929,"_17569":46995,"_5":17464,"_23818":46905,"_2388":46996},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2861":1971,"_25133":1929,"_17569":46998,"_5":17464,"_23818":46905,"_2388":46999},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2861":1972,"_25133":1972,"_5":12309,"_2388":47001,"_25469":47002,"_17569":47003,"_23818":1972},"Revocation lists (CRL)",[40834,42178,45871,46488],[],{"_2861":1973,"_25133":1972,"_17569":47005,"_5":17464,"_23818":1972,"_2388":47006},[],"Generate and distribute signed lists to validate certificates offline.",{"_2861":1974,"_25133":1972,"_5":25466,"_17569":47008,"_23818":47009,"_2388":47010},[],"/docs/pr-preview/pr-37/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2861":1975,"_25133":1972,"_5":25466,"_17569":47012,"_23818":47013,"_2388":47014},[],"/docs/pr-preview/pr-37/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2861":1976,"_25133":1972,"_5":25466,"_17569":47016,"_23818":47017,"_2388":47018},[],"/docs/pr-preview/pr-37/platform/pki/crl#crl-contents","CRL contents",{"_2861":1977,"_25133":1972,"_5":25466,"_17569":47020,"_23818":47021,"_2388":47022},[],"/docs/pr-preview/pr-37/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2861":1978,"_25133":1972,"_5":25466,"_17569":47024,"_23818":47025,"_2388":47026},[],"/docs/pr-preview/pr-37/platform/pki/crl#va-role-management-api","VA role management API",{"_2861":1979,"_25133":1972,"_5":25466,"_17569":47028,"_23818":47029,"_2388":47030},[],"/docs/pr-preview/pr-37/platform/pki/crl#from-the-interface","From the interface",{"_2861":1980,"_25133":1972,"_5":25466,"_17569":47032,"_23818":47033,"_2388":47034},[],"/docs/pr-preview/pr-37/platform/pki/crl#references","References",{"_2861":1981,"_25133":1972,"_17569":47036,"_5":17464,"_23818":1972,"_2388":47037},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2861":1982,"_25133":1972,"_17569":47039,"_5":17464,"_23818":47009,"_2388":47040},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2861":1983,"_25133":1972,"_17569":47042,"_5":17464,"_23818":47009,"_2388":47043},[],"`crl_options` field",{"_2861":1984,"_25133":1972,"_17569":47045,"_5":17464,"_23818":47009,"_2388":41217},[],{"_2861":1985,"_25133":1972,"_17569":47047,"_5":17464,"_23818":47009,"_2388":47048},[],"Backend initial value",{"_2861":1986,"_25133":1972,"_17569":47050,"_5":17464,"_23818":47009,"_2388":47051},[],"`validity`",{"_2861":1987,"_25133":1972,"_17569":47053,"_5":17464,"_23818":47009,"_2388":47054},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2861":1988,"_25133":1972,"_17569":47056,"_5":17464,"_23818":47009,"_2388":47057},[],"7 days.",{"_2861":1989,"_25133":1972,"_17569":47059,"_5":17464,"_23818":47009,"_2388":47060},[],"`refresh_interval`",{"_2861":1990,"_25133":1972,"_17569":47062,"_5":17464,"_23818":47009,"_2388":47063},[],"Time since publication that triggers scheduled renewal.",{"_2861":1991,"_25133":1972,"_17569":47065,"_5":17464,"_23818":47009,"_2388":47066},[],"6 days and 23 hours.",{"_2861":1992,"_25133":1972,"_17569":47068,"_5":17464,"_23818":47009,"_2388":47069},[],"`regenerate_on_revoke`",{"_2861":1993,"_25133":1972,"_17569":47071,"_5":17464,"_23818":47009,"_2388":47072},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2861":1994,"_25133":1972,"_17569":47074,"_5":17464,"_23818":47009,"_2388":47075},[],"`true`.",{"_2861":1995,"_25133":1972,"_17569":47077,"_5":17464,"_23818":47009,"_2388":47078},[],"`subject_key_id_signer`",{"_2861":1996,"_25133":1972,"_17569":47080,"_5":17464,"_23818":47009,"_2388":47081},[],"Configuration field initialized with the CA’s SKI.",{"_2861":1997,"_25133":1972,"_17569":47083,"_5":17464,"_23818":47009,"_2388":47084},[],"CA SKI.",{"_2861":1998,"_25133":1972,"_17569":47086,"_5":17464,"_23818":47009,"_2388":47087},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2861":1999,"_25133":1972,"_17569":47089,"_5":17464,"_23818":47009,"_2388":47090},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2861":2000,"_25133":1972,"_17569":47092,"_5":17464,"_23818":47013,"_2388":47093},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2861":2001,"_25133":1972,"_17569":47095,"_5":17464,"_23818":47013,"_2388":47096},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2861":2002,"_25133":1972,"_17569":47098,"_5":17464,"_23818":47013,"_2388":47099},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2861":2003,"_25133":1972,"_17569":47101,"_5":17464,"_23818":47017,"_2388":47102},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2861":2004,"_25133":1972,"_17569":47104,"_5":17464,"_23818":47017,"_2388":47105},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2861":2005,"_25133":1972,"_17569":47107,"_5":17464,"_23818":47021,"_2388":47108},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2861":2006,"_25133":1972,"_17569":47110,"_5":17464,"_23818":47021,"_2388":47111},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2861":2007,"_25133":1972,"_17569":47113,"_5":17464,"_23818":47021,"_2388":47114},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2861":2008,"_25133":1972,"_17569":47116,"_5":17464,"_23818":47021,"_2388":47117},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2861":2009,"_25133":1972,"_17569":47119,"_5":17464,"_23818":47021,"_2388":47120},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2861":2010,"_25133":1972,"_17569":47122,"_5":17464,"_23818":47025,"_2388":47123},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2861":2011,"_25133":1972,"_17569":47125,"_5":17464,"_23818":47025,"_2388":43902},[],{"_2861":2012,"_25133":1972,"_17569":47127,"_5":17464,"_23818":47025,"_2388":47128},[],"Relative path",{"_2861":2013,"_25133":1972,"_17569":47130,"_5":17464,"_23818":47025,"_2388":43899},[],{"_2861":2014,"_25133":1972,"_17569":47132,"_5":17464,"_23818":47025,"_2388":47133},[],"`GET`",{"_2861":2015,"_25133":1972,"_17569":47135,"_5":17464,"_23818":47025,"_2388":47136},[],"`/v1/roles/{ca-ski}`",{"_2861":2016,"_25133":1972,"_17569":47138,"_5":17464,"_23818":47025,"_2388":47139},[],"Read `crl_options` and `latest_crl`.",{"_2861":2017,"_25133":1972,"_17569":47141,"_5":17464,"_23818":47025,"_2388":47142},[],"`PUT`",{"_2861":2018,"_25133":1972,"_17569":47144,"_5":17464,"_23818":47025,"_2388":47136},[],{"_2861":2019,"_25133":1972,"_17569":47146,"_5":17464,"_23818":47025,"_2388":47147},[],"Replace CRL configuration.",{"_2861":2020,"_25133":1972,"_17569":47149,"_5":17464,"_23818":47025,"_2388":47150},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2861":2021,"_25133":1972,"_17569":47152,"_5":17464,"_23818":47025,"_2388":47153},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2861":2022,"_25133":1972,"_17569":47155,"_5":17464,"_23818":47029,"_2388":47156},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2861":2023,"_25133":1972,"_17569":47158,"_5":17464,"_23818":47033,"_2388":47159},[],"RFC 5280: X.509 and CRL profile.",{"_2861":2024,"_25133":1972,"_17569":47161,"_5":17464,"_23818":47033,"_2388":47162},[],"OpenSSL: openssl-crl.",{"_2861":2025,"_25133":1972,"_17569":47164,"_5":17464,"_23818":47033,"_2388":47165},[],"OpenSSL: openssl-verify.",{"_2861":2026,"_25133":1972,"_17569":47167,"_5":17464,"_23818":47033,"_2388":47168},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2861":2027,"_25133":1972,"_17569":47170,"_5":17464,"_23818":47033,"_2388":47171},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2861":2028,"_25133":2028,"_5":12309,"_2388":47173,"_25469":47174,"_17569":47175,"_23818":2028},"Keys and cryptographic engines",[40834,42178,45871,45872],[],{"_2861":2029,"_25133":2028,"_17569":47177,"_5":17464,"_23818":2028,"_2388":47178},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2861":2030,"_25133":2028,"_5":25466,"_17569":47180,"_23818":47181,"_2388":47182},[],"/docs/pr-preview/pr-37/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2861":2031,"_25133":2028,"_5":25466,"_17569":47184,"_23818":47185,"_2388":47186},[],"/docs/pr-preview/pr-37/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2861":2032,"_25133":2028,"_5":25466,"_17569":47188,"_23818":47189,"_2388":47190},[],"/docs/pr-preview/pr-37/platform/pki/key-management#file-system","File System",{"_2861":2033,"_25133":2028,"_5":25466,"_17569":47192,"_23818":47193,"_2388":47194},[],"/docs/pr-preview/pr-37/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2861":2034,"_25133":2028,"_5":25466,"_17569":47196,"_23818":47197,"_2388":47198},[],"/docs/pr-preview/pr-37/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2861":2035,"_25133":2028,"_5":25466,"_17569":47200,"_23818":47201,"_2388":47202},[],"/docs/pr-preview/pr-37/platform/pki/key-management#aws-kms","AWS KMS",{"_2861":2036,"_25133":2028,"_5":25466,"_17569":47204,"_23818":47205,"_2388":47206},[],"/docs/pr-preview/pr-37/platform/pki/key-management#pkcs11","PKCS#11",{"_2861":2037,"_25133":2028,"_5":25466,"_17569":47208,"_23818":47209,"_2388":47210},[],"/docs/pr-preview/pr-37/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2861":2038,"_25133":2028,"_5":25466,"_17569":47212,"_23818":47213,"_2388":47214},[],"/docs/pr-preview/pr-37/platform/pki/key-management#key-inventory","Key inventory",{"_2861":2039,"_25133":2028,"_5":25466,"_17569":47216,"_23818":47217,"_2388":47218},[],"/docs/pr-preview/pr-37/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2861":2040,"_25133":2028,"_5":25466,"_17569":47220,"_23818":47221,"_2388":47222},[],"/docs/pr-preview/pr-37/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2861":2041,"_25133":2028,"_5":25466,"_17569":47224,"_23818":47225,"_2388":47226},[],"/docs/pr-preview/pr-37/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2861":2042,"_25133":2028,"_5":25466,"_17569":47228,"_23818":47229,"_2388":47230},[],"/docs/pr-preview/pr-37/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2861":2043,"_25133":2028,"_5":25466,"_17569":47232,"_23818":47233,"_2388":47234},[],"/docs/pr-preview/pr-37/platform/pki/key-management#view-details","View details",{"_2861":2044,"_25133":2028,"_5":25466,"_17569":47236,"_23818":47237,"_2388":47238},[],"/docs/pr-preview/pr-37/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2861":2045,"_25133":2028,"_5":25466,"_17569":47240,"_23818":47241,"_2388":47242},[],"/docs/pr-preview/pr-37/platform/pki/key-management#sign","Sign",{"_2861":2046,"_25133":2028,"_5":25466,"_17569":47244,"_23818":47245,"_2388":47246},[],"/docs/pr-preview/pr-37/platform/pki/key-management#verify","Verify",{"_2861":2047,"_25133":2028,"_5":25466,"_17569":47248,"_23818":47249,"_2388":47250},[],"/docs/pr-preview/pr-37/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2861":2048,"_25133":2028,"_5":25466,"_17569":47252,"_23818":47253,"_2388":47254},[],"/docs/pr-preview/pr-37/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2861":2049,"_25133":2028,"_5":25466,"_17569":47256,"_23818":47257,"_2388":47258},[],"/docs/pr-preview/pr-37/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2861":2050,"_25133":2028,"_17569":47260,"_5":17464,"_23818":2028,"_2388":47261},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2861":2051,"_25133":2028,"_17569":47263,"_5":17464,"_23818":2028,"_2388":47264},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2861":2052,"_25133":2028,"_17569":47266,"_5":17464,"_23818":47181,"_2388":47267},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2861":2053,"_25133":2028,"_17569":47269,"_5":17464,"_23818":47181,"_2388":47270},[],"In practice, it lets you:",{"_2861":2054,"_25133":2028,"_17569":47272,"_5":17464,"_23818":47181,"_2388":47273},[],"Generate new key pairs from Lamassu IoT.",{"_2861":2055,"_25133":2028,"_17569":47275,"_5":17464,"_23818":47181,"_2388":47276},[],"Import keys created externally.",{"_2861":2056,"_25133":2028,"_17569":47278,"_5":17464,"_23818":47181,"_2388":47279},[],"Delegate custody and cryptographic operations to external engines.",{"_2861":2057,"_25133":2028,"_17569":47281,"_5":17464,"_23818":47181,"_2388":47282},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2861":2058,"_25133":2028,"_17569":47284,"_5":17464,"_23818":47185,"_2388":47285},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2861":2059,"_25133":2028,"_17569":47287,"_5":17464,"_23818":47185,"_2388":47288},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2861":2060,"_25133":2028,"_17569":47290,"_5":17464,"_23818":47185,"_2388":47291},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2861":2061,"_25133":2028,"_17569":47293,"_5":17464,"_23818":47189,"_2388":47294},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2861":2062,"_25133":2028,"_17569":47296,"_5":17464,"_23818":47193,"_2388":47297},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2861":2063,"_25133":2028,"_17569":47299,"_5":17464,"_23818":47197,"_2388":47300},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2861":2064,"_25133":2028,"_17569":47302,"_5":17464,"_23818":47201,"_2388":47303},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2861":2065,"_25133":2028,"_17569":47305,"_5":17464,"_23818":47205,"_2388":47306},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2861":2066,"_25133":2028,"_17569":47308,"_5":17464,"_23818":47209,"_2388":47309},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2861":2067,"_25133":2028,"_17569":47311,"_5":17464,"_23818":47209,"_2388":47312},[],"Lamassu shows the enabled engines in the console.",{"_2861":2068,"_25133":2028,"_17569":47314,"_5":17464,"_23818":47209,"_2388":47315},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2861":2069,"_25133":2028,"_17569":47317,"_5":17464,"_23818":47209,"_2388":47318},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2861":2070,"_25133":2028,"_17569":47320,"_5":17464,"_23818":47213,"_2388":47321},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2861":2071,"_25133":2028,"_17569":47323,"_5":17464,"_23818":47213,"_2388":47324},[],"The table includes the following fields:",{"_2861":2072,"_25133":2028,"_17569":47326,"_5":17464,"_23818":47213,"_2388":47327},[],"**Name**: descriptive name of the key.",{"_2861":2073,"_25133":2028,"_17569":47329,"_5":17464,"_23818":47213,"_2388":47330},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2861":2074,"_25133":2028,"_17569":47332,"_5":17464,"_23818":47213,"_2388":47333},[],"**Strength**: visual indicator of cryptographic strength.",{"_2861":2075,"_25133":2028,"_17569":47335,"_5":17464,"_23818":47213,"_2388":47336},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2861":2076,"_25133":2028,"_17569":47338,"_5":17464,"_23818":47213,"_2388":47339},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2861":2077,"_25133":2028,"_17569":47341,"_5":17464,"_23818":47213,"_2388":47342},[],"**Aliases**: alternative names associated with the key.",{"_2861":2078,"_25133":2028,"_17569":47344,"_5":17464,"_23818":47213,"_2388":47345},[],"**Tags**: labels for classification and search.",{"_2861":2079,"_25133":2028,"_17569":47347,"_5":17464,"_23818":47213,"_2388":47348},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2861":2080,"_25133":2028,"_17569":47350,"_5":17464,"_23818":47213,"_2388":47351},[],"From this view you also reach the most common actions:",{"_2861":2081,"_25133":2028,"_17569":47353,"_5":17464,"_23818":47213,"_2388":47354},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2861":2082,"_25133":2028,"_17569":47356,"_5":17464,"_23818":47213,"_2388":47357},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2861":2083,"_25133":2028,"_17569":47359,"_5":17464,"_23818":47213,"_2388":47360},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2861":2084,"_25133":2028,"_17569":47362,"_5":17464,"_23818":47213,"_2388":47363},[],"**Delete Key** to remove the key from the system.",{"_2861":2085,"_25133":2028,"_17569":47365,"_5":17464,"_23818":47217,"_2388":47366},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2861":2086,"_25133":2028,"_17569":47368,"_5":17464,"_23818":47221,"_2388":47369},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2861":2087,"_25133":2028,"_17569":47371,"_5":17464,"_23818":47221,"_2388":47372},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2861":2088,"_25133":2028,"_17569":47374,"_5":17464,"_23818":47221,"_2388":47375},[],"**Key Name**: unique and descriptive name.",{"_2861":2089,"_25133":2028,"_17569":47377,"_5":17464,"_23818":47221,"_2388":47378},[],"**Crypto Engine**: engine that will keep the key.",{"_2861":2090,"_25133":2028,"_17569":47380,"_5":17464,"_23818":47221,"_2388":47381},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2861":2091,"_25133":2028,"_17569":47383,"_5":17464,"_23818":47221,"_2388":47384},[],"**Tags**: metadata to classify the key.",{"_2861":2092,"_25133":2028,"_17569":47386,"_5":17464,"_23818":47221,"_2388":47387},[],"**Metadata**: additional information for advanced uses.",{"_2861":2093,"_25133":2028,"_17569":47389,"_5":17464,"_23818":47225,"_2388":47390},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2861":2094,"_25133":2028,"_17569":47392,"_5":17464,"_23818":47225,"_2388":47393},[],"When you have an exportable private key and the destination engine supports import.",{"_2861":2095,"_25133":2028,"_17569":47395,"_5":17464,"_23818":47225,"_2388":47396},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2861":2096,"_25133":2028,"_17569":47398,"_5":17464,"_23818":47225,"_2388":47399},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2861":2097,"_25133":2028,"_17569":47401,"_5":17464,"_23818":47225,"_2388":47402},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2861":2098,"_25133":2028,"_17569":47404,"_5":17464,"_23818":47225,"_2388":47405},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2861":2099,"_25133":2028,"_17569":47407,"_5":17464,"_23818":47225,"_2388":47408},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2861":2100,"_25133":2028,"_17569":47410,"_5":17464,"_23818":47225,"_2388":47411},[],"**Tags**: labels for organization and search.",{"_2861":2101,"_25133":2028,"_17569":47413,"_5":17464,"_23818":47225,"_2388":47414},[],"**Metadata**: additional optional information.",{"_2861":2102,"_25133":2028,"_17569":47416,"_5":17464,"_23818":47225,"_2388":47417},[],"**Private Key (PEM)**: private key in PEM format.",{"_2861":2103,"_25133":2028,"_17569":47419,"_5":17464,"_23818":47225,"_2388":47420},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2861":2104,"_25133":2028,"_17569":47422,"_5":17464,"_23818":47229,"_2388":47423},[],"Each registered key has a detail view and several operational actions.",{"_2861":2105,"_25133":2028,"_17569":47425,"_5":17464,"_23818":47233,"_2388":47426},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2861":2106,"_25133":2028,"_17569":47428,"_5":17464,"_23818":47233,"_2388":47429},[],"The **Overview** tab shows, among others, these fields:",{"_2861":2107,"_25133":2028,"_17569":47431,"_5":17464,"_23818":47233,"_2388":47432},[],"**Key Name**: descriptive name.",{"_2861":2108,"_25133":2028,"_17569":47434,"_5":17464,"_23818":47233,"_2388":47435},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2861":2109,"_25133":2028,"_17569":47437,"_5":17464,"_23818":47233,"_2388":47438},[],"**Tags**: associated labels.",{"_2861":2110,"_25133":2028,"_17569":47440,"_5":17464,"_23818":47233,"_2388":47441},[],"**Aliases**: alternative names.",{"_2861":2111,"_25133":2028,"_17569":47443,"_5":17464,"_23818":47233,"_2388":47444},[],"**Crypto Engine**: engine where the key resides.",{"_2861":2112,"_25133":2028,"_17569":47446,"_5":17464,"_23818":47233,"_2388":47447},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2861":2113,"_25133":2028,"_17569":47449,"_5":17464,"_23818":47233,"_2388":47450},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2861":2114,"_25133":2028,"_17569":47452,"_5":17464,"_23818":47233,"_2388":47453},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2861":2115,"_25133":2028,"_17569":47455,"_5":17464,"_23818":47237,"_2388":47456},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2861":2116,"_25133":2028,"_17569":47458,"_5":17464,"_23818":47237,"_2388":47459},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2861":2117,"_25133":2028,"_17569":47461,"_5":17464,"_23818":47237,"_2388":47462},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2861":2118,"_25133":2028,"_17569":47464,"_5":17464,"_23818":47241,"_2388":47465},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2861":2119,"_25133":2028,"_17569":47467,"_5":17464,"_23818":47241,"_2388":47468},[],"Main fields:",{"_2861":2120,"_25133":2028,"_17569":47470,"_5":17464,"_23818":47241,"_2388":47471},[],"**Algorithm**: signing algorithm available for the key type.",{"_2861":2121,"_25133":2028,"_17569":47473,"_5":17464,"_23818":47241,"_2388":47474},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2861":2122,"_25133":2028,"_17569":47476,"_5":17464,"_23818":47241,"_2388":47477},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2861":2123,"_25133":2028,"_17569":47479,"_5":17464,"_23818":47241,"_2388":47480},[],"**Message**: content to sign.",{"_2861":2124,"_25133":2028,"_17569":47482,"_5":17464,"_23818":47241,"_2388":47483},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2861":2125,"_25133":2028,"_17569":47485,"_5":17464,"_23818":47245,"_2388":47486},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2861":2126,"_25133":2028,"_17569":47488,"_5":17464,"_23818":47245,"_2388":47468},[],{"_2861":2127,"_25133":2028,"_17569":47490,"_5":17464,"_23818":47245,"_2388":47491},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2861":2128,"_25133":2028,"_17569":47493,"_5":17464,"_23818":47245,"_2388":47494},[],"**Message Type**: `Raw` or `Digest`.",{"_2861":2129,"_25133":2028,"_17569":47496,"_5":17464,"_23818":47245,"_2388":47497},[],"**Payload Encoding**: encoding of the message.",{"_2861":2130,"_25133":2028,"_17569":47499,"_5":17464,"_23818":47245,"_2388":47500},[],"**Message**: original message or hash.",{"_2861":2131,"_25133":2028,"_17569":47502,"_5":17464,"_23818":47245,"_2388":47503},[],"**Signature**: signature to check.",{"_2861":2132,"_25133":2028,"_17569":47505,"_5":17464,"_23818":47245,"_2388":47506},[],"**Result**: indicator of the validation result.",{"_2861":2133,"_25133":2028,"_17569":47508,"_5":17464,"_23818":47249,"_2388":47509},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2861":2134,"_25133":2028,"_17569":47511,"_5":17464,"_23818":47249,"_2388":47512},[],"This flow is useful for:",{"_2861":2135,"_25133":2028,"_17569":47514,"_5":17464,"_23818":47249,"_2388":47515},[],"Requesting certificates from an external CA.",{"_2861":2136,"_25133":2028,"_17569":47517,"_5":17464,"_23818":47249,"_2388":47518},[],"Renewing an identity while keeping the same key.",{"_2861":2137,"_25133":2028,"_17569":47520,"_5":17464,"_23818":47249,"_2388":47521},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2861":2138,"_25133":2028,"_17569":47523,"_5":17464,"_23818":47249,"_2388":47524},[],"**Common Name (CN)**: main name of the identity.",{"_2861":2139,"_25133":2028,"_17569":47526,"_5":17464,"_23818":47249,"_2388":47527},[],"**Organization (O)**: organization or company.",{"_2861":2140,"_25133":2028,"_17569":47529,"_5":17464,"_23818":47249,"_2388":47530},[],"**Organizational Unit (OU)**: department or unit.",{"_2861":2141,"_25133":2028,"_17569":47532,"_5":17464,"_23818":47249,"_2388":47533},[],"**Country (C)**: two-letter country code.",{"_2861":2142,"_25133":2028,"_17569":47535,"_5":17464,"_23818":47249,"_2388":47536},[],"**State / Province (ST)**: state or province.",{"_2861":2143,"_25133":2028,"_17569":47538,"_5":17464,"_23818":47249,"_2388":47539},[],"**Locality (L)**: city or locality.",{"_2861":2144,"_25133":2028,"_17569":47541,"_5":17464,"_23818":47249,"_2388":47542},[],"**Email Address**: contact email.",{"_2861":2145,"_25133":2028,"_17569":47544,"_5":17464,"_23818":47249,"_2388":47545},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2861":2146,"_25133":2028,"_17569":47547,"_5":17464,"_23818":47249,"_2388":47548},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2861":2147,"_25133":2028,"_17569":47550,"_5":17464,"_23818":47253,"_2388":47551},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2861":2148,"_25133":2028,"_17569":47553,"_5":17464,"_23818":47253,"_2388":47554},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2861":2149,"_25133":2028,"_17569":47556,"_5":17464,"_23818":47257,"_2388":47557},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2861":2150,"_25133":2150,"_5":12309,"_2388":47559,"_25469":47560,"_17569":47561,"_23818":2150},"Online validation with OCSP",[40834,42178,45871,46488],[],{"_2861":2151,"_25133":2150,"_17569":47563,"_5":17464,"_23818":2150,"_2388":47564},[],"Query signed status and verify the responder’s response.",{"_2861":2152,"_25133":2150,"_5":25466,"_17569":47566,"_23818":47567,"_2388":47568},[],"/docs/pr-preview/pr-37/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2861":2153,"_25133":2150,"_5":25466,"_17569":47570,"_23818":47571,"_2388":47572},[],"/docs/pr-preview/pr-37/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2861":2154,"_25133":2150,"_5":25466,"_17569":47574,"_23818":47575,"_2388":47576},[],"/docs/pr-preview/pr-37/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2861":2155,"_25133":2150,"_5":25466,"_17569":47578,"_23818":47579,"_2388":47580},[],"/docs/pr-preview/pr-37/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2861":2156,"_25133":2150,"_5":25466,"_17569":47582,"_23818":47583,"_2388":47584},[],"/docs/pr-preview/pr-37/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2861":2157,"_25133":2150,"_5":25466,"_17569":47586,"_23818":47587,"_2388":47034},[],"/docs/pr-preview/pr-37/platform/pki/ocsp#references",{"_2861":2158,"_25133":2150,"_17569":47589,"_5":17464,"_23818":2150,"_2388":47590},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2861":2159,"_25133":2150,"_17569":47592,"_5":17464,"_23818":47567,"_2388":47593},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2861":2160,"_25133":2150,"_17569":47595,"_5":17464,"_23818":47567,"_2388":47596},[],"Record status",{"_2861":2161,"_25133":2150,"_17569":47598,"_5":17464,"_23818":47567,"_2388":47599},[],"Signed response",{"_2861":2162,"_25133":2150,"_17569":47601,"_5":17464,"_23818":47567,"_2388":45049},[],{"_2861":2163,"_25133":2150,"_17569":47603,"_5":17464,"_23818":47567,"_2388":47604},[],"`Good`.",{"_2861":2164,"_25133":2150,"_17569":47606,"_5":17464,"_23818":47567,"_2388":45066},[],{"_2861":2165,"_25133":2150,"_17569":47608,"_5":17464,"_23818":47567,"_2388":47609},[],"`Revoked`, with revocation reason and timestamp.",{"_2861":2166,"_25133":2150,"_17569":47611,"_5":17464,"_23818":47567,"_2388":47612},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2861":2167,"_25133":2150,"_17569":47614,"_5":17464,"_23818":47567,"_2388":47615},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2861":2168,"_25133":2150,"_17569":47617,"_5":17464,"_23818":47567,"_2388":47618},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2861":2169,"_25133":2150,"_17569":47620,"_5":17464,"_23818":47567,"_2388":47621},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2861":2170,"_25133":2150,"_17569":47623,"_5":17464,"_23818":47567,"_2388":47624},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2861":2171,"_25133":2150,"_17569":47626,"_5":17464,"_23818":47571,"_2388":47627},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2861":2172,"_25133":2150,"_17569":47629,"_5":17464,"_23818":47571,"_2388":47630},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2861":2173,"_25133":2150,"_17569":47632,"_5":17464,"_23818":47575,"_2388":47633},[],"The service accepts:",{"_2861":2174,"_25133":2150,"_17569":47635,"_5":17464,"_23818":47575,"_2388":43902},[],{"_2861":2175,"_25133":2150,"_17569":47637,"_5":17464,"_23818":47575,"_2388":47638},[],"VA service path",{"_2861":2176,"_25133":2150,"_17569":47640,"_5":17464,"_23818":47575,"_2388":47641},[],"Format",{"_2861":2177,"_25133":2150,"_17569":47643,"_5":17464,"_23818":47575,"_2388":47644},[],"`POST`",{"_2861":2178,"_25133":2150,"_17569":47646,"_5":17464,"_23818":47575,"_2388":47647},[],"`/ocsp`",{"_2861":2179,"_25133":2150,"_17569":47649,"_5":17464,"_23818":47575,"_2388":47650},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2861":2180,"_25133":2150,"_17569":47652,"_5":17464,"_23818":47575,"_2388":47133},[],{"_2861":2181,"_25133":2150,"_17569":47654,"_5":17464,"_23818":47575,"_2388":47655},[],"`/ocsp/{ocsp_request}`",{"_2861":2182,"_25133":2150,"_17569":47657,"_5":17464,"_23818":47575,"_2388":47658},[],"DER request encoded using padded URL Base64.",{"_2861":2183,"_25133":2150,"_17569":47660,"_5":17464,"_23818":47575,"_2388":47661},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2861":2184,"_25133":2150,"_17569":47663,"_5":17464,"_23818":47579,"_2388":47664},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2861":2185,"_25133":2150,"_17569":47666,"_5":17464,"_23818":47579,"_2388":47667},[],"Generate the request:",{"_2861":2186,"_25133":2150,"_17569":47669,"_5":17464,"_23818":47579,"_2388":47670},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2861":2187,"_25133":2150,"_17569":47672,"_5":17464,"_23818":47579,"_2388":47673},[],"Replace the example URL with the inspected endpoint:",{"_2861":2188,"_25133":2150,"_17569":47675,"_5":17464,"_23818":47579,"_2388":47676},[],"Verify the returned DER:",{"_2861":2189,"_25133":2150,"_17569":47678,"_5":17464,"_23818":47579,"_2388":47679},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2861":2190,"_25133":2150,"_17569":47681,"_5":17464,"_23818":47583,"_2388":47682},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2861":2191,"_25133":2150,"_17569":47684,"_5":17464,"_23818":47583,"_2388":47685},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2861":2192,"_25133":2150,"_17569":47687,"_5":17464,"_23818":47587,"_2388":47688},[],"RFC 6960: OCSP.",{"_2861":2193,"_25133":2150,"_17569":47690,"_5":17464,"_23818":47587,"_2388":47691},[],"OpenSSL: openssl-ocsp.",{"_2861":2194,"_25133":2150,"_17569":47693,"_5":17464,"_23818":47587,"_2388":47694},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2861":2195,"_25133":2150,"_17569":47696,"_5":17464,"_23818":47587,"_2388":47171},[],{"_2861":2196,"_25133":2196,"_5":12309,"_2388":45871,"_25469":47698,"_17569":47699,"_23818":2196},[40834,42178,45871],[],{"_2861":2197,"_25133":2196,"_17569":47701,"_5":17464,"_23818":2196,"_2388":47702},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2861":2198,"_25133":2196,"_5":25466,"_17569":47704,"_23818":47705,"_2388":45181},[],"/docs/pr-preview/pr-37/platform/pki/overview#start-here",{"_2861":2199,"_25133":2196,"_5":25466,"_17569":47707,"_23818":47708,"_2388":47709},[],"/docs/pr-preview/pr-37/platform/pki/overview#what-you-need","What you need",{"_2861":2200,"_25133":2196,"_5":25466,"_17569":47711,"_23818":47712,"_2388":45715},[],"/docs/pr-preview/pr-37/platform/pki/overview#core-capabilities",{"_2861":2201,"_25133":2196,"_5":25466,"_17569":47714,"_23818":47715,"_2388":45719},[],"/docs/pr-preview/pr-37/platform/pki/overview#build-your-trust-hierarchy",{"_2861":2202,"_25133":2196,"_5":25466,"_17569":47717,"_23818":47718,"_2388":45723},[],"/docs/pr-preview/pr-37/platform/pki/overview#protect-cryptographic-keys",{"_2861":2203,"_25133":2196,"_5":25466,"_17569":47720,"_23818":47721,"_2388":45727},[],"/docs/pr-preview/pr-37/platform/pki/overview#issue-and-control-certificates",{"_2861":2204,"_25133":2196,"_5":25466,"_17569":47723,"_23818":47724,"_2388":45735},[],"/docs/pr-preview/pr-37/platform/pki/overview#publish-validation-status",{"_2861":2205,"_25133":2196,"_5":25466,"_17569":47726,"_23818":47727,"_2388":47728},[],"/docs/pr-preview/pr-37/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2861":2206,"_25133":2196,"_5":25466,"_17569":47730,"_23818":47731,"_2388":46655},[],"/docs/pr-preview/pr-37/platform/pki/overview#continue",{"_2861":2207,"_25133":2196,"_17569":47733,"_5":17464,"_23818":2196,"_2388":47734},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2861":2208,"_25133":2196,"_17569":47736,"_5":17464,"_23818":47705,"_2388":47737},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2861":2209,"_25133":2196,"_17569":47739,"_5":17464,"_23818":47705,"_2388":47740},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2861":2210,"_25133":2196,"_17569":47742,"_5":17464,"_23818":47708,"_2388":47743},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2861":2211,"_25133":2196,"_17569":47745,"_5":17464,"_23818":47708,"_2388":47746},[],"An available cryptographic engine to keep the authority's key.",{"_2861":2212,"_25133":2196,"_17569":47748,"_5":17464,"_23818":47708,"_2388":47749},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2861":2213,"_25133":2196,"_17569":47751,"_5":17464,"_23818":47708,"_2388":47752},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2861":2214,"_25133":2196,"_17569":47754,"_5":17464,"_23818":47708,"_2388":47755},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2861":2215,"_25133":2196,"_17569":47757,"_5":17464,"_23818":47715,"_2388":47758},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2861":2216,"_25133":2196,"_17569":47760,"_5":17464,"_23818":47718,"_2388":47761},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2861":2217,"_25133":2196,"_17569":47763,"_5":17464,"_23818":47721,"_2388":47764},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2861":2218,"_25133":2196,"_17569":47766,"_5":17464,"_23818":47724,"_2388":47767},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2861":2219,"_25133":2196,"_17569":47769,"_5":17464,"_23818":47727,"_2388":47770},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2861":2220,"_25133":2196,"_17569":47772,"_5":17464,"_23818":47727,"_2388":47773},[],"its subject and extensions identify the expected client;",{"_2861":2221,"_25133":2196,"_17569":47775,"_5":17464,"_23818":47727,"_2388":47776},[],"its public key matches the client's private key;",{"_2861":2222,"_25133":2196,"_17569":47778,"_5":17464,"_23818":47727,"_2388":47779},[],"its chain reaches a root trusted by the consumer;",{"_2861":2223,"_25133":2196,"_17569":47781,"_5":17464,"_23818":47727,"_2388":47782},[],"its dates and usages allow the operation;",{"_2861":2224,"_25133":2196,"_17569":47784,"_5":17464,"_23818":47727,"_2388":47785},[],"the consumer applies revocation checks and authorization.",{"_2861":2225,"_25133":2196,"_17569":47787,"_5":17464,"_23818":47727,"_2388":47788},[],"The issuance path includes the first independent checks.",{"_2861":2226,"_25133":2196,"_17569":47790,"_5":17464,"_23818":47731,"_2388":47791},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2861":2227,"_25133":2196,"_17569":47793,"_5":17464,"_23818":47731,"_2388":47794},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2861":2228,"_25133":2196,"_17569":47796,"_5":17464,"_23818":47731,"_2388":47797},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2861":2229,"_25133":2229,"_5":12309,"_2388":47799,"_25469":47800,"_17569":47801,"_23818":2229},"Create your first CA",[40834,42178,45871,45306],[],{"_2861":2230,"_25133":2229,"_17569":47803,"_5":17464,"_23818":2229,"_2388":47804},[],"Create an evaluation root and check its certificate before issuing.",{"_2861":2231,"_25133":2229,"_5":25466,"_17569":47806,"_23818":47807,"_2388":40844},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2861":2232,"_25133":2229,"_5":25466,"_17569":47809,"_23818":47810,"_2388":47811},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2861":2233,"_25133":2229,"_5":25466,"_17569":47813,"_23818":47814,"_2388":47815},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2861":2234,"_25133":2229,"_5":25466,"_17569":47817,"_23818":47818,"_2388":47819},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2861":2235,"_25133":2229,"_5":25466,"_17569":47821,"_23818":47822,"_2388":47823},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2861":2236,"_25133":2229,"_5":25466,"_17569":47825,"_23818":47826,"_2388":47827},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2861":2237,"_25133":2229,"_5":25466,"_17569":47829,"_23818":47830,"_2388":47831},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2861":2238,"_25133":2229,"_5":25466,"_17569":47833,"_23818":47834,"_2388":45564},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2861":2239,"_25133":2229,"_5":25466,"_17569":47836,"_23818":47837,"_2388":40868},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2861":2240,"_25133":2229,"_17569":47839,"_5":17464,"_23818":2229,"_2388":47840},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2861":2241,"_25133":2229,"_17569":47842,"_5":17464,"_23818":47807,"_2388":47843},[],"Console access and permission to create keys and authorities.",{"_2861":2242,"_25133":2229,"_17569":47845,"_5":17464,"_23818":47807,"_2388":47846},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2861":2243,"_25133":2229,"_17569":47848,"_5":17464,"_23818":47807,"_2388":47849},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2861":2244,"_25133":2229,"_17569":47851,"_5":17464,"_23818":47807,"_2388":47852},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2861":2245,"_25133":2229,"_17569":47854,"_5":17464,"_23818":47810,"_2388":47855},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2861":2246,"_25133":2229,"_17569":47857,"_5":17464,"_23818":47810,"_2388":47858},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2861":2247,"_25133":2229,"_17569":47860,"_5":17464,"_23818":47814,"_2388":47861},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2861":2248,"_25133":2229,"_17569":47863,"_5":17464,"_23818":47814,"_2388":47864},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2861":2249,"_25133":2229,"_17569":47866,"_5":17464,"_23818":47818,"_2388":47867},[],"Select **Root CA** and complete:",{"_2861":2250,"_25133":2229,"_17569":47869,"_5":17464,"_23818":47818,"_2388":47870},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2861":2251,"_25133":2229,"_17569":47872,"_5":17464,"_23818":47818,"_2388":47873},[],"**Subject**: organization and country details for your evaluation.",{"_2861":2252,"_25133":2229,"_17569":47875,"_5":17464,"_23818":47818,"_2388":47876},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2861":2253,"_25133":2229,"_17569":47878,"_5":17464,"_23818":47818,"_2388":47879},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2861":2254,"_25133":2229,"_17569":47881,"_5":17464,"_23818":47818,"_2388":47882},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2861":2255,"_25133":2229,"_17569":47884,"_5":17464,"_23818":47822,"_2388":47885},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2861":2256,"_25133":2229,"_17569":47887,"_5":17464,"_23818":47826,"_2388":47888},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2861":2257,"_25133":2229,"_17569":47890,"_5":17464,"_23818":47826,"_2388":47891},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2861":2258,"_25133":2229,"_17569":47893,"_5":17464,"_23818":47830,"_2388":47894},[],"Run from the directory where you saved `ca.pem`:",{"_2861":2259,"_25133":2229,"_17569":47896,"_5":17464,"_23818":47830,"_2388":47897},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2861":2260,"_25133":2229,"_17569":47899,"_5":17464,"_23818":47830,"_2388":47900},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2861":2261,"_25133":2229,"_17569":47902,"_5":17464,"_23818":47834,"_2388":47903},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2861":2262,"_25133":2229,"_17569":47905,"_5":17464,"_23818":47834,"_2388":47906},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2861":2263,"_25133":2229,"_17569":47908,"_5":17464,"_23818":47834,"_2388":47909},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2861":2264,"_25133":2229,"_17569":47911,"_5":17464,"_23818":47834,"_2388":47912},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2861":2265,"_25133":2229,"_17569":47914,"_5":17464,"_23818":47837,"_2388":47915},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2861":2266,"_25133":2266,"_5":12309,"_2388":47917,"_25469":47918,"_17569":47919,"_23818":2266},"Issue and verify a certificate",[40834,42178,45871,45306],[],{"_2861":2267,"_25133":2266,"_17569":47921,"_5":17464,"_23818":2266,"_2388":47922},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2861":2268,"_25133":2266,"_5":25466,"_17569":47924,"_23818":47925,"_2388":40844},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2861":2269,"_25133":2266,"_5":25466,"_17569":47927,"_23818":47928,"_2388":47929},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2861":2270,"_25133":2266,"_5":25466,"_17569":47931,"_23818":47932,"_2388":47933},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2861":2271,"_25133":2266,"_5":25466,"_17569":47935,"_23818":47936,"_2388":47937},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2861":2272,"_25133":2266,"_5":25466,"_17569":47939,"_23818":47940,"_2388":47941},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2861":2273,"_25133":2266,"_5":25466,"_17569":47943,"_23818":47944,"_2388":47945},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2861":2274,"_25133":2266,"_5":25466,"_17569":47947,"_23818":47948,"_2388":47827},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2861":2275,"_25133":2266,"_5":25466,"_17569":47950,"_23818":47951,"_2388":47952},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2861":2276,"_25133":2266,"_5":25466,"_17569":47954,"_23818":47955,"_2388":47956},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2861":2277,"_25133":2266,"_5":25466,"_17569":47958,"_23818":47959,"_2388":47960},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2861":2278,"_25133":2266,"_5":25466,"_17569":47962,"_23818":47963,"_2388":45564},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2861":2279,"_25133":2266,"_5":25466,"_17569":47965,"_23818":47966,"_2388":40868},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/issue-certificate#next-step",{"_2861":2280,"_25133":2266,"_17569":47968,"_5":17464,"_23818":2266,"_2388":47969},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2861":2281,"_25133":2266,"_17569":47971,"_5":17464,"_23818":47925,"_2388":47972},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2861":2282,"_25133":2266,"_17569":47974,"_5":17464,"_23818":47925,"_2388":47975},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2861":2283,"_25133":2266,"_17569":47977,"_5":17464,"_23818":47925,"_2388":47978},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2861":2284,"_25133":2266,"_17569":47980,"_5":17464,"_23818":47925,"_2388":47981},[],"A client identifier: here we use `device-001`.",{"_2861":2285,"_25133":2266,"_17569":47983,"_5":17464,"_23818":47925,"_2388":47984},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2861":2286,"_25133":2266,"_17569":47986,"_5":17464,"_23818":47928,"_2388":47987},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2861":2287,"_25133":2266,"_17569":47989,"_5":17464,"_23818":47932,"_2388":47990},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2861":2288,"_25133":2266,"_17569":47992,"_5":17464,"_23818":47932,"_2388":47993},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2861":2289,"_25133":2266,"_17569":47995,"_5":17464,"_23818":47936,"_2388":47996},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2861":2290,"_25133":2266,"_17569":47998,"_5":17464,"_23818":47936,"_2388":47999},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2861":2291,"_25133":2266,"_17569":48001,"_5":17464,"_23818":47940,"_2388":48002},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2861":2292,"_25133":2266,"_17569":48004,"_5":17464,"_23818":47940,"_2388":48005},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2861":2293,"_25133":2266,"_17569":48007,"_5":17464,"_23818":47944,"_2388":48008},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2861":2294,"_25133":2266,"_17569":48010,"_5":17464,"_23818":47948,"_2388":48011},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2861":2295,"_25133":2266,"_17569":48013,"_5":17464,"_23818":47951,"_2388":48014},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2861":2296,"_25133":2266,"_17569":48016,"_5":17464,"_23818":47955,"_2388":48017},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2861":2297,"_25133":2266,"_17569":48019,"_5":17464,"_23818":47955,"_2388":48020},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2861":2298,"_25133":2266,"_17569":48022,"_5":17464,"_23818":47955,"_2388":48023},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2861":2299,"_25133":2266,"_17569":48025,"_5":17464,"_23818":47959,"_2388":48026},[],"In Bash, compare the two public-key digests:",{"_2861":2300,"_25133":2266,"_17569":48028,"_5":17464,"_23818":47959,"_2388":48029},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2861":2301,"_25133":2266,"_17569":48031,"_5":17464,"_23818":47959,"_2388":48032},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2861":2302,"_25133":2266,"_17569":48034,"_5":17464,"_23818":47963,"_2388":45648},[],{"_2861":2303,"_25133":2266,"_17569":48036,"_5":17464,"_23818":47963,"_2388":48037},[],"What to review",{"_2861":2304,"_25133":2266,"_17569":48039,"_5":17464,"_23818":47963,"_2388":48040},[],"The CA rejects issuance",{"_2861":2305,"_25133":2266,"_17569":48042,"_5":17464,"_23818":47963,"_2388":48043},[],"Permissions, CA state and key, algorithm and profile.",{"_2861":2306,"_25133":2266,"_17569":48045,"_5":17464,"_23818":47963,"_2388":48046},[],"Different subject or usages",{"_2861":2307,"_25133":2266,"_17569":48048,"_5":17464,"_23818":47963,"_2388":48049},[],"Applied profile and requested values.",{"_2861":2308,"_25133":2266,"_17569":48051,"_5":17464,"_23818":47963,"_2388":48052},[],"Issuer cannot be found",{"_2861":2309,"_25133":2266,"_17569":48054,"_5":17464,"_23818":47963,"_2388":48055},[],"Downloaded CA and required intermediate chain.",{"_2861":2310,"_25133":2266,"_17569":48057,"_5":17464,"_23818":47963,"_2388":48058},[],"Validity fails",{"_2861":2311,"_25133":2266,"_17569":48060,"_5":17464,"_23818":47963,"_2388":48061},[],"Certificate and CA dates, and the computer's clock.",{"_2861":2312,"_25133":2266,"_17569":48063,"_5":17464,"_23818":47963,"_2388":48064},[],"Public-key digests differ",{"_2861":2313,"_25133":2266,"_17569":48066,"_5":17464,"_23818":47963,"_2388":48067},[],"Certificate and key files from the same issuance.",{"_2861":2314,"_25133":2266,"_17569":48069,"_5":17464,"_23818":47963,"_2388":48070},[],"See PKI diagnostics to narrow an issuance failure.",{"_2861":2315,"_25133":2266,"_17569":48072,"_5":17464,"_23818":47966,"_2388":48073},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2861":2316,"_25133":2266,"_17569":48075,"_5":17464,"_23818":47966,"_2388":48076},[],"Manage certificates for inspection, status and revocation.",{"_2861":2317,"_25133":2266,"_17569":48078,"_5":17464,"_23818":47966,"_2388":48079},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2861":2318,"_25133":2266,"_17569":48081,"_5":17464,"_23818":47966,"_2388":48082},[],"Prepare EST for the device to request its next identities.",{"_2861":2319,"_25133":2266,"_17569":48084,"_5":17464,"_23818":47966,"_2388":48085},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2861":2320,"_25133":2320,"_5":12309,"_2388":48087,"_25469":48088,"_17569":48089,"_23818":2320},"PKI getting started",[40834,42178,45871,45306],[],{"_2861":2321,"_25133":2320,"_17569":48091,"_5":17464,"_23818":2320,"_2388":48092},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2861":2322,"_25133":2320,"_5":25466,"_17569":48094,"_23818":48095,"_2388":40844},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/overview#before-you-begin",{"_2861":2323,"_25133":2320,"_5":25466,"_17569":48097,"_23818":48098,"_2388":48099},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2861":2324,"_25133":2320,"_5":25466,"_17569":48101,"_23818":48102,"_2388":45498},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/overview#expected-result",{"_2861":2325,"_25133":2320,"_5":25466,"_17569":48104,"_23818":48105,"_2388":48106},[],"/docs/pr-preview/pr-37/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2861":2326,"_25133":2320,"_17569":48108,"_5":17464,"_23818":2320,"_2388":48109},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2861":2327,"_25133":2320,"_17569":48111,"_5":17464,"_23818":48095,"_2388":48112},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2861":2328,"_25133":2320,"_17569":48114,"_5":17464,"_23818":48095,"_2388":48115},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2861":2329,"_25133":2320,"_17569":48117,"_5":17464,"_23818":48095,"_2388":48118},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2861":2330,"_25133":2320,"_17569":48120,"_5":17464,"_23818":48095,"_2388":48121},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2861":2331,"_25133":2320,"_17569":48123,"_5":17464,"_23818":48095,"_2388":48124},[],"A working directory with restricted access for the downloaded key.",{"_2861":2332,"_25133":2320,"_17569":48126,"_5":17464,"_23818":48098,"_2388":48127},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2861":2333,"_25133":2320,"_17569":48129,"_5":17464,"_23818":48098,"_2388":48130},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2861":2334,"_25133":2320,"_17569":48132,"_5":17464,"_23818":48098,"_2388":48133},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2861":2335,"_25133":2320,"_17569":48135,"_5":17464,"_23818":48098,"_2388":48136},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2861":2336,"_25133":2320,"_17569":48138,"_5":17464,"_23818":48102,"_2388":48139},[],"File or resource",{"_2861":2337,"_25133":2320,"_17569":48141,"_5":17464,"_23818":48102,"_2388":45495},[],{"_2861":2338,"_25133":2320,"_17569":48143,"_5":17464,"_23818":48102,"_2388":48144},[],"Active root CA and `ca.pem`",{"_2861":2339,"_25133":2320,"_17569":48146,"_5":17464,"_23818":48102,"_2388":48147},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2861":2340,"_25133":2320,"_17569":48149,"_5":17464,"_23818":48102,"_2388":48150},[],"End-entity certificate and `device.crt`",{"_2861":2341,"_25133":2320,"_17569":48152,"_5":17464,"_23818":48102,"_2388":48153},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2861":2342,"_25133":2320,"_17569":48155,"_5":17464,"_23818":48102,"_2388":48156},[],"Private key `device.key`",{"_2861":2343,"_25133":2320,"_17569":48158,"_5":17464,"_23818":48102,"_2388":48159},[],"Its public key matches the one included in `device.crt`.",{"_2861":2344,"_25133":2320,"_17569":48161,"_5":17464,"_23818":48102,"_2388":48162},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2861":2345,"_25133":2320,"_17569":48164,"_5":17464,"_23818":48105,"_2388":48165},[],"To operate certificates, continue with Certificates and Validation.",{"_2861":2346,"_25133":2320,"_17569":48167,"_5":17464,"_23818":48105,"_2388":48168},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2861":2347,"_25133":2320,"_17569":48170,"_5":17464,"_23818":48105,"_2388":48171},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2861":2348,"_25133":2348,"_5":12309,"_2388":48173,"_25469":48174,"_17569":48175,"_23818":2348},"PKI troubleshooting",[40834,42178,45871,44692],[],{"_2861":2349,"_25133":2348,"_17569":48177,"_5":17464,"_23818":2348,"_2388":48178},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2861":2350,"_25133":2348,"_5":25466,"_17569":48180,"_23818":48181,"_2388":48182},[],"/docs/pr-preview/pr-37/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2861":2351,"_25133":2348,"_5":25466,"_17569":48184,"_23818":48185,"_2388":48186},[],"/docs/pr-preview/pr-37/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2861":2352,"_25133":2348,"_5":25466,"_17569":48188,"_23818":48189,"_2388":48190},[],"/docs/pr-preview/pr-37/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2861":2353,"_25133":2348,"_17569":48192,"_5":17464,"_23818":2348,"_2388":48193},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2861":2354,"_25133":2348,"_17569":48195,"_5":17464,"_23818":2348,"_2388":48196},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2861":2355,"_25133":2348,"_17569":48198,"_5":17464,"_23818":48181,"_2388":45495},[],{"_2861":2356,"_25133":2348,"_17569":48200,"_5":17464,"_23818":48181,"_2388":48201},[],"What to inspect",{"_2861":2357,"_25133":2348,"_17569":48203,"_5":17464,"_23818":48181,"_2388":40868},[],{"_2861":2358,"_25133":2348,"_17569":48205,"_5":17464,"_23818":48181,"_2388":48206},[],"CA",{"_2861":2359,"_25133":2348,"_17569":48208,"_5":17464,"_23818":48181,"_2388":48209},[],"Exists, is active and has usable dates.",{"_2861":2360,"_25133":2348,"_17569":48211,"_5":17464,"_23818":48181,"_2388":48212},[],"Authorities.",{"_2861":2361,"_25133":2348,"_17569":48214,"_5":17464,"_23818":48181,"_2388":48215},[],"Key",{"_2861":2362,"_25133":2348,"_17569":48217,"_5":17464,"_23818":48181,"_2388":48218},[],"The record has a usable private key and the engine can sign.",{"_2861":2363,"_25133":2348,"_17569":48220,"_5":17464,"_23818":48181,"_2388":48221},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2861":2364,"_25133":2348,"_17569":48223,"_5":17464,"_23818":48181,"_2388":48224},[],"CSR",{"_2861":2365,"_25133":2348,"_17569":48226,"_5":17464,"_23818":48181,"_2388":48227},[],"Correct PEM and verifiable signature.",{"_2861":2366,"_25133":2348,"_17569":48229,"_5":17464,"_23818":48181,"_2388":48230},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2861":2367,"_25133":2348,"_17569":48232,"_5":17464,"_23818":48181,"_2388":48233},[],"Profile",{"_2861":2368,"_25133":2348,"_17569":48235,"_5":17464,"_23818":48181,"_2388":48236},[],"Selected source, existing ID, allowed algorithm and size.",{"_2861":2369,"_25133":2348,"_17569":48238,"_5":17464,"_23818":48181,"_2388":48239},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2861":2370,"_25133":2348,"_17569":48241,"_5":17464,"_23818":48181,"_2388":45648},[],{"_2861":2371,"_25133":2348,"_17569":48243,"_5":17464,"_23818":48181,"_2388":48244},[],"Appropriate subject, SAN, usages and dates.",{"_2861":2372,"_25133":2348,"_17569":48246,"_5":17464,"_23818":48181,"_2388":48247},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2861":2373,"_25133":2348,"_17569":48249,"_5":17464,"_23818":48181,"_2388":48250},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2861":2374,"_25133":2348,"_17569":48252,"_5":17464,"_23818":48181,"_2388":48253},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2861":2375,"_25133":2348,"_17569":48255,"_5":17464,"_23818":48185,"_2388":48256},[],"Check each boundary independently:",{"_2861":2376,"_25133":2348,"_17569":48258,"_5":17464,"_23818":48185,"_2388":48259},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2861":2377,"_25133":2348,"_17569":48261,"_5":17464,"_23818":48185,"_2388":48262},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2861":2378,"_25133":2348,"_17569":48264,"_5":17464,"_23818":48185,"_2388":48265},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2861":2379,"_25133":2348,"_17569":48267,"_5":17464,"_23818":48185,"_2388":48268},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2861":2380,"_25133":2348,"_17569":48270,"_5":17464,"_23818":48185,"_2388":48271},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2861":2381,"_25133":2348,"_17569":48273,"_5":17464,"_23818":48185,"_2388":48274},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2861":2382,"_25133":2348,"_17569":48276,"_5":17464,"_23818":48189,"_2388":48277},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2861":2383,"_25133":2348,"_17569":48279,"_5":17464,"_23818":48189,"_2388":48280},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.","count","sorting",{"_48284":48285,"_48286":48287,"_48288":48289,"_48290":48291,"_15242":2410,"_57781":2410},"language","english","sortableProperties",[2388,25133,5,23818],"sortablePropertiesWithTypes",{"_2388":20962,"_25133":20962,"_5":20962,"_23818":20962},"sorts",{"_2388":48292,"_25133":50665,"_5":53037,"_23818":55409},{"_3836":48293,"_48294":48295,"_5":20962},{"_12049":5299,"_12397":3316,"_12404":6214,"_24364":6258,"_23931":5719,"_16670":2628,"_12070":2826,"_12077":3839,"_24326":14007,"_24676":6306,"_24697":6978,"_24339":4559,"_28931":3097,"_24708":12432,"_28936":24856,"_28939":19884,"_28942":8367,"_28945":16970,"_28948":2629,"_25009":3644,"_28953":5702,"_28955":3432,"_25039":2618,"_24999":5695,"_28959":2701,"_28962":2808,"_28964":7169,"_24726":2732,"_25004":4706,"_25057":3121,"_28969":3010,"_28971":3815,"_28973":2467,"_28975":3066,"_28977":4232,"_28979":4883,"_25191":3524,"_28982":4464,"_28984":12013,"_24377":3317,"_28987":3073,"_28989":2710,"