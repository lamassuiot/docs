522":102976,"_33524":102979,"_33526":102983,"_33528":102986,"_33530":102989,"_33532":102993,"_33534":102996,"_33536":103000,"_33538":103003,"_33540":103006,"_33542":103009,"_33544":103012,"_33546":103015,"_33548":103018,"_33550":103021,"_33552":103024,"_33554":103027,"_33556":103030,"_33558":103033,"_33560":103035,"_33562":103038,"_33564":103041,"_33566":103044,"_33568":103047,"_33570":103050,"_33572":103053,"_33574":103056,"_33576":103059,"_33578":103062,"_33580":103065,"_33582":103070,"_33584":103073,"_33586":103077,"_33588":103081,"_33590":103085,"_33592":103088,"_33594":103091,"_33596":103093,"_33598":103095,"_33600":103097,"_33602":103099,"_33604":103102,"_33606":103105,"_33608":103108,"_33610":103111,"_33612":103114,"_33614":103116,"_33616":103119,"_33618":103121,"_33620":103124,"_33622":103127,"_33624":103130,"_33626":103132,"_33628":103135,"_33630":103138,"_33632":103141,"_33634":103144,"_33636":103147,"_33638":103150,"_33640":103153,"_33642":103156,"_33644":103159,"_33646":103162,"_33648":103165,"_33650":103168},{"_2861":57788,"_25133":57788,"_5":12309,"_2388":95896,"_25469":95897,"_17569":95900,"_23818":57788},"Despliega desde AWS Marketplace",[40834,95898,95899],"Despliegue","Otros modelos",[],{"_2861":57789,"_25133":57788,"_17569":95902,"_5":17464,"_23818":57788,"_2388":95903},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2861":57790,"_25133":57788,"_5":25466,"_17569":95905,"_23818":95906,"_2388":95907},[],"/docs/pr-preview/pr-37/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2861":57791,"_25133":57788,"_5":25466,"_17569":95909,"_23818":95910,"_2388":95911},[],"/docs/pr-preview/pr-37/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2861":57792,"_25133":57788,"_5":25466,"_17569":95913,"_23818":95914,"_2388":95915},[],"/docs/pr-preview/pr-37/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2861":57793,"_25133":57788,"_5":25466,"_17569":95917,"_23818":95918,"_2388":95919},[],"/docs/pr-preview/pr-37/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2861":57794,"_25133":57788,"_5":25466,"_17569":95921,"_23818":95922,"_2388":95923},[],"/docs/pr-preview/pr-37/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2861":57795,"_25133":57788,"_5":25466,"_17569":95925,"_23818":95926,"_2388":95927},[],"/docs/pr-preview/pr-37/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2861":57796,"_25133":57788,"_5":25466,"_17569":95929,"_23818":95930,"_2388":95931},[],"/docs/pr-preview/pr-37/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2861":57797,"_25133":57788,"_17569":95933,"_5":17464,"_23818":57788,"_2388":95934},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2861":57798,"_25133":57788,"_17569":95936,"_5":17464,"_23818":95906,"_2388":95937},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2861":57799,"_25133":57788,"_17569":95939,"_5":17464,"_23818":95906,"_2388":95940},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2861":57800,"_25133":57788,"_17569":95942,"_5":17464,"_23818":95906,"_2388":95943},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2861":57801,"_25133":57788,"_17569":95945,"_5":17464,"_23818":95910,"_2388":95946},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2861":57802,"_25133":57788,"_17569":95948,"_5":17464,"_23818":95910,"_2388":95949},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2861":57803,"_25133":57788,"_17569":95951,"_5":17464,"_23818":95910,"_2388":95952},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2861":57804,"_25133":57788,"_17569":95954,"_5":17464,"_23818":95914,"_2388":95955},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2861":57805,"_25133":57788,"_17569":95957,"_5":17464,"_23818":95918,"_2388":95958},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2861":57806,"_25133":57788,"_17569":95960,"_5":17464,"_23818":95922,"_2388":95961},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2861":57807,"_25133":57788,"_17569":95963,"_5":17464,"_23818":95926,"_2388":95964},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2861":57808,"_25133":57788,"_17569":95966,"_5":17464,"_23818":95930,"_2388":95967},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2861":57809,"_25133":57809,"_5":12309,"_2388":95969,"_25469":95970,"_17569":95971,"_23818":57809},"Despliega Lamassu",[40834,95898],[],{"_2861":57810,"_25133":57809,"_17569":95973,"_5":17464,"_23818":57809,"_2388":95974},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2861":57811,"_25133":57809,"_5":25466,"_17569":95976,"_23818":95977,"_2388":95978},[],"/docs/pr-preview/pr-37/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2861":57812,"_25133":57809,"_5":25466,"_17569":95980,"_23818":95981,"_2388":95982},[],"/docs/pr-preview/pr-37/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2861":57813,"_25133":57809,"_5":25466,"_17569":95984,"_23818":95985,"_2388":95986},[],"/docs/pr-preview/pr-37/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2861":57814,"_25133":57809,"_17569":95988,"_5":17464,"_23818":57809,"_2388":95989},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2861":57815,"_25133":57809,"_17569":95991,"_5":17464,"_23818":95977,"_2388":95992},[],"Modelo",{"_2861":57816,"_25133":57809,"_17569":95994,"_5":17464,"_23818":95977,"_2388":95995},[],"Recomendado para",{"_2861":57817,"_25133":57809,"_17569":95997,"_5":17464,"_23818":95977,"_2388":95998},[],"Quién opera la infraestructura",{"_2861":57818,"_25133":57809,"_17569":96000,"_5":17464,"_23818":95977,"_2388":96001},[],"Punto de partida",{"_2861":57819,"_25133":57809,"_17569":96003,"_5":17464,"_23818":95977,"_2388":40941},[],{"_2861":57820,"_25133":57809,"_17569":96005,"_5":17464,"_23818":95977,"_2388":96006},[],"Producción, entornos regulados y despliegues personalizados",{"_2861":57821,"_25133":57809,"_17569":96008,"_5":17464,"_23818":95977,"_2388":96009},[],"Tu equipo",{"_2861":57822,"_25133":57809,"_17569":96011,"_5":17464,"_23818":95977,"_2388":96012},[],"Helm o Fastlane",{"_2861":57823,"_25133":57809,"_17569":96014,"_5":17464,"_23818":95977,"_2388":40953},[],{"_2861":57824,"_25133":57809,"_17569":96016,"_5":17464,"_23818":95977,"_2388":96017},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2861":57825,"_25133":57809,"_17569":96019,"_5":17464,"_23818":95977,"_2388":96009},[],{"_2861":57826,"_25133":57809,"_17569":96021,"_5":17464,"_23818":95977,"_2388":96022},[],"Imagen preconfigurada en EC2",{"_2861":57827,"_25133":57809,"_17569":96024,"_5":17464,"_23818":95977,"_2388":40964},[],{"_2861":57828,"_25133":57809,"_17569":96026,"_5":17464,"_23818":95977,"_2388":96027},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2861":57829,"_25133":57809,"_17569":96029,"_5":17464,"_23818":95977,"_2388":40970},[],{"_2861":57830,"_25133":57809,"_17569":96031,"_5":17464,"_23818":95977,"_2388":96032},[],"Suscripción gestionada",{"_2861":57831,"_25133":57809,"_17569":96034,"_5":17464,"_23818":95977,"_2388":96035},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2861":57832,"_25133":57809,"_17569":96037,"_5":17464,"_23818":95977,"_2388":96038},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2861":57833,"_25133":57809,"_17569":96040,"_5":17464,"_23818":95977,"_2388":96041},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2861":57834,"_25133":57809,"_17569":96043,"_5":17464,"_23818":95981,"_2388":96044},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2861":57835,"_25133":57809,"_17569":96046,"_5":17464,"_23818":95985,"_2388":96047},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2861":57836,"_25133":57836,"_5":12309,"_2388":96049,"_25469":96050,"_17569":96051,"_23818":57836},"Utiliza Lamassu como SaaS",[40834,95898,95899],[],{"_2861":57837,"_25133":57836,"_17569":96053,"_5":17464,"_23818":57836,"_2388":96054},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2861":57838,"_25133":57836,"_5":25466,"_17569":96056,"_23818":96057,"_2388":96058},[],"/docs/pr-preview/pr-37/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2861":57839,"_25133":57836,"_5":25466,"_17569":96060,"_23818":96061,"_2388":96062},[],"/docs/pr-preview/pr-37/es/deployment/saas#planes","Planes",{"_2861":57840,"_25133":57836,"_5":25466,"_17569":96064,"_23818":96065,"_2388":96066},[],"/docs/pr-preview/pr-37/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2861":57841,"_25133":57836,"_17569":96068,"_5":17464,"_23818":57836,"_2388":96069},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2861":57842,"_25133":57836,"_17569":96071,"_5":17464,"_23818":96057,"_2388":96072},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2861":57843,"_25133":57836,"_17569":96074,"_5":17464,"_23818":96057,"_2388":96075},[],"Copias de seguridad automáticas.",{"_2861":57844,"_25133":57836,"_17569":96077,"_5":17464,"_23818":96057,"_2388":96078},[],"Actualizaciones de versión.",{"_2861":57845,"_25133":57836,"_17569":96080,"_5":17464,"_23818":96057,"_2388":96081},[],"Soporte técnico y SLA según el plan contratado.",{"_2861":57846,"_25133":57836,"_17569":96083,"_5":17464,"_23818":96061,"_2388":41025},[],{"_2861":57847,"_25133":57836,"_17569":96085,"_5":17464,"_23818":96061,"_2388":96086},[],"Dispositivos",{"_2861":57848,"_25133":57836,"_17569":96088,"_5":17464,"_23818":96061,"_2388":96089},[],"Soporte",{"_2861":57849,"_25133":57836,"_17569":96091,"_5":17464,"_23818":96061,"_2388":41034},[],{"_2861":57850,"_25133":57836,"_17569":96093,"_5":17464,"_23818":96061,"_2388":41037},[],{"_2861":57851,"_25133":57836,"_17569":96095,"_5":17464,"_23818":96061,"_2388":96096},[],"Hasta 1.000",{"_2861":57852,"_25133":57836,"_17569":96098,"_5":17464,"_23818":96061,"_2388":41043},[],{"_2861":57853,"_25133":57836,"_17569":96100,"_5":17464,"_23818":96061,"_2388":96101},[],"99,5 %",{"_2861":57854,"_25133":57836,"_17569":96103,"_5":17464,"_23818":96061,"_2388":41049},[],{"_2861":57855,"_25133":57836,"_17569":96105,"_5":17464,"_23818":96061,"_2388":96106},[],"Hasta 10.000",{"_2861":57856,"_25133":57836,"_17569":96108,"_5":17464,"_23818":96061,"_2388":96109},[],"Email y chat",{"_2861":57857,"_25133":57836,"_17569":96111,"_5":17464,"_23818":96061,"_2388":96112},[],"99,9 %",{"_2861":57858,"_25133":57836,"_17569":96114,"_5":17464,"_23818":96061,"_2388":41061},[],{"_2861":57859,"_25133":57836,"_17569":96116,"_5":17464,"_23818":96061,"_2388":96117},[],"Ilimitados",{"_2861":57860,"_25133":57836,"_17569":96119,"_5":17464,"_23818":96061,"_2388":96120},[],"Dedicado",{"_2861":57861,"_25133":57836,"_17569":96122,"_5":17464,"_23818":96061,"_2388":96123},[],"99,99 %",{"_2861":57862,"_25133":57836,"_17569":96125,"_5":17464,"_23818":96065,"_2388":96126},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2861":57863,"_25133":57836,"_17569":96128,"_5":17464,"_23818":96065,"_2388":96129},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2861":57864,"_25133":57864,"_5":12309,"_2388":41078,"_25469":96131,"_17569":96133,"_23818":57864},[40834,95898,96132],"Kubernetes autogestionado",[],{"_2861":57865,"_25133":57864,"_17569":96135,"_5":17464,"_23818":57864,"_2388":96136},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2861":57866,"_25133":57864,"_5":25466,"_17569":96138,"_23818":96139,"_2388":96140},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2861":57867,"_25133":57864,"_5":25466,"_17569":96142,"_23818":96143,"_2388":96144},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2861":57868,"_25133":57864,"_5":25466,"_17569":96146,"_23818":96147,"_2388":96148},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2861":57869,"_25133":57864,"_5":25466,"_17569":96150,"_23818":96151,"_2388":96152},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2861":57870,"_25133":57864,"_5":25466,"_17569":96154,"_23818":96155,"_2388":96156},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2861":57871,"_25133":57864,"_5":25466,"_17569":96158,"_23818":96159,"_2388":96160},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2861":57872,"_25133":57864,"_5":25466,"_17569":96162,"_23818":96163,"_2388":96164},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2861":57873,"_25133":57864,"_5":25466,"_17569":96166,"_23818":96167,"_2388":96168},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2861":57874,"_25133":57864,"_5":25466,"_17569":96170,"_23818":96171,"_2388":96172},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2861":57875,"_25133":57864,"_5":25466,"_17569":96174,"_23818":96175,"_2388":96176},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2861":57876,"_25133":57864,"_17569":96178,"_5":17464,"_23818":96139,"_2388":96179},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2861":57877,"_25133":57864,"_17569":96181,"_5":17464,"_23818":96139,"_2388":96182},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2861":57878,"_25133":57864,"_17569":96184,"_5":17464,"_23818":96143,"_2388":96185},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2861":57879,"_25133":57864,"_17569":96187,"_5":17464,"_23818":96143,"_2388":96188},[],"Fastlane instala o configura",{"_2861":57880,"_25133":57864,"_17569":96190,"_5":17464,"_23818":96143,"_2388":96191},[],"Tú sigues proporcionando",{"_2861":57881,"_25133":57864,"_17569":96193,"_5":17464,"_23818":96143,"_2388":96194},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2861":57882,"_25133":57864,"_17569":96196,"_5":17464,"_23818":96143,"_2388":96197},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2861":57883,"_25133":57864,"_17569":96199,"_5":17464,"_23818":96143,"_2388":96200},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2861":57884,"_25133":57864,"_17569":96202,"_5":17464,"_23818":96143,"_2388":96203},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2861":57885,"_25133":57864,"_17569":96205,"_5":17464,"_23818":96143,"_2388":96206},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2861":57886,"_25133":57864,"_17569":96208,"_5":17464,"_23818":96143,"_2388":96209},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2861":57887,"_25133":57864,"_17569":96211,"_5":17464,"_23818":96143,"_2388":96212},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2861":57888,"_25133":57864,"_17569":96214,"_5":17464,"_23818":96143,"_2388":96215},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2861":57889,"_25133":57864,"_17569":96217,"_5":17464,"_23818":96143,"_2388":96218},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2861":57890,"_25133":57864,"_17569":96220,"_5":17464,"_23818":96147,"_2388":96221},[],"Necesitas:",{"_2861":57891,"_25133":57864,"_17569":96223,"_5":17464,"_23818":96147,"_2388":96224},[],"un clúster Kubernetes existente",{"_2861":57892,"_25133":57864,"_17569":96226,"_5":17464,"_23818":96147,"_2388":96227},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2861":57893,"_25133":57864,"_17569":96229,"_5":17464,"_23818":96147,"_2388":41176},[],{"_2861":57894,"_25133":57864,"_17569":96231,"_5":17464,"_23818":96147,"_2388":19881},[],{"_2861":57895,"_25133":57864,"_17569":96233,"_5":17464,"_23818":96147,"_2388":96234},[],"`jq` solo si usas `--sample-data`",{"_2861":57896,"_25133":57864,"_17569":96236,"_5":17464,"_23818":96147,"_2388":96237},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2861":57897,"_25133":57864,"_17569":96239,"_5":17464,"_23818":96147,"_2388":96240},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2861":57898,"_25133":57864,"_17569":96242,"_5":17464,"_23818":96147,"_2388":96243},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2861":57899,"_25133":57864,"_17569":96245,"_5":17464,"_23818":96151,"_2388":96246},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2861":57900,"_25133":57864,"_17569":96248,"_5":17464,"_23818":96151,"_2388":96249},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2861":57901,"_25133":57864,"_17569":96251,"_5":17464,"_23818":96155,"_2388":96252},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2861":57902,"_25133":57864,"_17569":96254,"_5":17464,"_23818":96155,"_2388":96255},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2861":57903,"_25133":57864,"_17569":96257,"_5":17464,"_23818":96155,"_2388":96258},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2861":57904,"_25133":57864,"_17569":96260,"_5":17464,"_23818":96155,"_2388":96261},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2861":57905,"_25133":57864,"_17569":96263,"_5":17464,"_23818":96159,"_2388":96264},[],"Opción",{"_2861":57906,"_25133":57864,"_17569":96266,"_5":17464,"_23818":96159,"_2388":96267},[],"Valor predeterminado",{"_2861":57907,"_25133":57864,"_17569":96269,"_5":17464,"_23818":96159,"_2388":96270},[],"Propósito",{"_2861":57908,"_25133":57864,"_17569":96272,"_5":17464,"_23818":96159,"_2388":41220},[],{"_2861":57909,"_25133":57864,"_17569":96274,"_5":17464,"_23818":96159,"_2388":41223},[],{"_2861":57910,"_25133":57864,"_17569":96276,"_5":17464,"_23818":96159,"_2388":96277},[],"Muestra la ayuda",{"_2861":57911,"_25133":57864,"_17569":96279,"_5":17464,"_23818":96159,"_2388":41229},[],{"_2861":57912,"_25133":57864,"_17569":96281,"_5":17464,"_23818":96159,"_2388":96282},[],"contexto actual",{"_2861":57913,"_25133":57864,"_17569":96284,"_5":17464,"_23818":96159,"_2388":96285},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2861":57914,"_25133":57864,"_17569":96287,"_5":17464,"_23818":96159,"_2388":41238},[],{"_2861":57915,"_25133":57864,"_17569":96289,"_5":17464,"_23818":96159,"_2388":5349},[],{"_2861":57916,"_25133":57864,"_17569":96291,"_5":17464,"_23818":96159,"_2388":96292},[],"Omite prompts y genera credenciales para las dependencias",{"_2861":57917,"_25133":57864,"_17569":96294,"_5":17464,"_23818":96159,"_2388":41246},[],{"_2861":57918,"_25133":57864,"_17569":96296,"_5":17464,"_23818":96159,"_2388":41249},[],{"_2861":57919,"_25133":57864,"_17569":96298,"_5":17464,"_23818":96159,"_2388":96299},[],"Namespace de la instalación",{"_2861":57920,"_25133":57864,"_17569":96301,"_5":17464,"_23818":96159,"_2388":41255},[],{"_2861":57921,"_25133":57864,"_17569":96303,"_5":17464,"_23818":96159,"_2388":41258},[],{"_2861":57922,"_25133":57864,"_17569":96305,"_5":17464,"_23818":96159,"_2388":96306},[],"Dominio usado por la UI, OIDC y el certificado",{"_2861":57923,"_25133":57864,"_17569":96308,"_5":17464,"_23818":96159,"_2388":41264},[],{"_2861":57924,"_25133":57864,"_17569":96310,"_5":17464,"_23818":96159,"_2388":12535},[],{"_2861":57925,"_25133":57864,"_17569":96312,"_5":17464,"_23818":96159,"_2388":96313},[],"Versión del chart de Lamassu",{"_2861":57926,"_25133":57864,"_17569":96315,"_5":17464,"_23818":96159,"_2388":41272},[],{"_2861":57927,"_25133":57864,"_17569":96317,"_5":17464,"_23818":96159,"_2388":41275},[],{"_2861":57928,"_25133":57864,"_17569":96319,"_5":17464,"_23818":96159,"_2388":96320},[],"Puerto del listener HTTPS",{"_2861":57929,"_25133":57864,"_17569":96322,"_5":17464,"_23818":96159,"_2388":41281},[],{"_2861":57930,"_25133":57864,"_17569":96324,"_5":17464,"_23818":96159,"_2388":41284},[],{"_2861":57931,"_25133":57864,"_17569":96326,"_5":17464,"_23818":96159,"_2388":96327},[],"Puerto del listener HTTP",{"_2861":57932,"_25133":57864,"_17569":96329,"_5":17464,"_23818":96159,"_2388":41290},[],{"_2861":57933,"_25133":57864,"_17569":96331,"_5":17464,"_23818":96159,"_2388":41223},[],{"_2861":57934,"_25133":57864,"_17569":96333,"_5":17464,"_23818":96159,"_2388":96334},[],"Certificado PEM para TLS downstream",{"_2861":57935,"_25133":57864,"_17569":96336,"_5":17464,"_23818":96159,"_2388":41298},[],{"_2861":57936,"_25133":57864,"_17569":96338,"_5":17464,"_23818":96159,"_2388":41223},[],{"_2861":57937,"_25133":57864,"_17569":96340,"_5":17464,"_23818":96159,"_2388":96341},[],"Clave privada PEM para TLS downstream",{"_2861":57938,"_25133":57864,"_17569":96343,"_5":17464,"_23818":96159,"_2388":41306},[],{"_2861":57939,"_25133":57864,"_17569":96345,"_5":17464,"_23818":96159,"_2388":96346},[],"chart del repositorio",{"_2861":57940,"_25133":57864,"_17569":96348,"_5":17464,"_23818":96159,"_2388":96349},[],"Usa un chart local de Lamassu sin empaquetar",{"_2861":57941,"_25133":57864,"_17569":96351,"_5":17464,"_23818":96159,"_2388":41315},[],{"_2861":57942,"_25133":57864,"_17569":96353,"_5":17464,"_23818":96159,"_2388":96354},[],"detección automática",{"_2861":57943,"_25133":57864,"_17569":96356,"_5":17464,"_23818":96159,"_2388":96357},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2861":57944,"_25133":57864,"_17569":96359,"_5":17464,"_23818":96159,"_2388":41323},[],{"_2861":57945,"_25133":57864,"_17569":96361,"_5":17464,"_23818":96159,"_2388":5349},[],{"_2861":57946,"_25133":57864,"_17569":96363,"_5":17464,"_23818":96159,"_2388":96364},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2861":57947,"_25133":57864,"_17569":96366,"_5":17464,"_23818":96159,"_2388":41331},[],{"_2861":57948,"_25133":57864,"_17569":96368,"_5":17464,"_23818":96159,"_2388":5349},[],{"_2861":57949,"_25133":57864,"_17569":96370,"_5":17464,"_23818":96159,"_2388":96371},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2861":57950,"_25133":57864,"_17569":96373,"_5":17464,"_23818":96159,"_2388":41339},[],{"_2861":57951,"_25133":57864,"_17569":96375,"_5":17464,"_23818":96159,"_2388":5349},[],{"_2861":57952,"_25133":57864,"_17569":96377,"_5":17464,"_23818":96159,"_2388":96378},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2861":57953,"_25133":57864,"_17569":96380,"_5":17464,"_23818":96159,"_2388":41347},[],{"_2861":57954,"_25133":57864,"_17569":96382,"_5":17464,"_23818":96159,"_2388":41350},[],{"_2861":57955,"_25133":57864,"_17569":96384,"_5":17464,"_23818":96159,"_2388":96385},[],"Usa otro chart local de SoftHSM",{"_2861":57956,"_25133":57864,"_17569":96387,"_5":17464,"_23818":96159,"_2388":96388},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2861":57957,"_25133":57864,"_17569":96390,"_5":17464,"_23818":96163,"_2388":41359},[],{"_2861":57958,"_25133":57864,"_17569":96392,"_5":17464,"_23818":96163,"_2388":96393},[],"valida las herramientas locales y el clúster seleccionado",{"_2861":57959,"_25133":57864,"_17569":96395,"_5":17464,"_23818":96163,"_2388":96396},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2861":57960,"_25133":57864,"_17569":96398,"_5":17464,"_23818":96163,"_2388":96399},[],"crea el namespace",{"_2861":57961,"_25133":57864,"_17569":96401,"_5":17464,"_23818":96163,"_2388":96402},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2861":57962,"_25133":57864,"_17569":96404,"_5":17464,"_23818":96163,"_2388":96405},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2861":57963,"_25133":57864,"_17569":96407,"_5":17464,"_23818":96163,"_2388":96408},[],"instala RabbitMQ",{"_2861":57964,"_25133":57864,"_17569":96410,"_5":17464,"_23818":96163,"_2388":96411},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2861":57965,"_25133":57864,"_17569":96413,"_5":17464,"_23818":96163,"_2388":96414},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2861":57966,"_25133":57864,"_17569":96416,"_5":17464,"_23818":96163,"_2388":96417},[],"carga datos de ejemplo opcionalmente",{"_2861":57967,"_25133":57864,"_17569":96419,"_5":17464,"_23818":96163,"_2388":96420},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2861":57968,"_25133":57864,"_17569":96422,"_5":17464,"_23818":96167,"_2388":96423},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2861":57969,"_25133":57864,"_17569":96425,"_5":17464,"_23818":96167,"_2388":96426},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2861":57970,"_25133":57864,"_17569":96428,"_5":17464,"_23818":96171,"_2388":96429},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2861":57971,"_25133":57864,"_17569":96431,"_5":17464,"_23818":96171,"_2388":96432},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2861":57972,"_25133":57864,"_17569":96434,"_5":17464,"_23818":96171,"_2388":96435},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2861":57973,"_25133":57864,"_17569":96437,"_5":17464,"_23818":96175,"_2388":96438},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2861":57974,"_25133":57974,"_5":12309,"_2388":96440,"_25469":96441,"_17569":96442,"_23818":57974},"Instala con Helm",[40834,95898,96132],[],{"_2861":57975,"_25133":57974,"_17569":96444,"_5":17464,"_23818":57974,"_2388":96445},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2861":57976,"_25133":57974,"_5":25466,"_17569":96447,"_23818":96448,"_2388":96449},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2861":57977,"_25133":57974,"_5":25466,"_17569":96451,"_23818":96452,"_2388":96148},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2861":57978,"_25133":57974,"_5":25466,"_17569":96454,"_23818":96455,"_2388":96456},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2861":57979,"_25133":57974,"_5":25466,"_17569":96458,"_23818":96459,"_2388":96460},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2861":57980,"_25133":57974,"_5":25466,"_17569":96462,"_23818":96463,"_2388":96464},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2861":57981,"_25133":57974,"_5":25466,"_17569":96466,"_23818":96467,"_2388":96468},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2861":57982,"_25133":57974,"_5":25466,"_17569":96470,"_23818":96471,"_2388":96472},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2861":57983,"_25133":57974,"_5":25466,"_17569":96474,"_23818":96475,"_2388":96476},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2861":57984,"_25133":57974,"_5":25466,"_17569":96478,"_23818":96479,"_2388":96480},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2861":57985,"_25133":57974,"_17569":96482,"_5":17464,"_23818":96448,"_2388":96483},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2861":57986,"_25133":57974,"_17569":96485,"_5":17464,"_23818":96452,"_2388":96486},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2861":57987,"_25133":57974,"_17569":96488,"_5":17464,"_23818":96452,"_2388":96489},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2861":57988,"_25133":57974,"_17569":96491,"_5":17464,"_23818":96452,"_2388":96492},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2861":57989,"_25133":57974,"_17569":96494,"_5":17464,"_23818":96452,"_2388":96495},[],"un broker RabbitMQ accesible y sus credenciales",{"_2861":57990,"_25133":57974,"_17569":96497,"_5":17464,"_23818":96452,"_2388":96498},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2861":57991,"_25133":57974,"_17569":96500,"_5":17464,"_23818":96452,"_2388":96501},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2861":57992,"_25133":57974,"_17569":96503,"_5":17464,"_23818":96452,"_2388":96504},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2861":57993,"_25133":57974,"_17569":96506,"_5":17464,"_23818":96452,"_2388":96507},[],"una StorageClass y un diseño de tráfico externo",{"_2861":57994,"_25133":57974,"_17569":96509,"_5":17464,"_23818":96452,"_2388":96510},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2861":57995,"_25133":57974,"_17569":96512,"_5":17464,"_23818":96452,"_2388":96513},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2861":57996,"_25133":57974,"_17569":96515,"_5":17464,"_23818":96452,"_2388":96516},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2861":57997,"_25133":57974,"_17569":96518,"_5":17464,"_23818":96455,"_2388":96519},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2861":57998,"_25133":57974,"_17569":96521,"_5":17464,"_23818":96455,"_2388":96522},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2861":57999,"_25133":57974,"_17569":96524,"_5":17464,"_23818":96455,"_2388":96525},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2861":58000,"_25133":57974,"_17569":96527,"_5":17464,"_23818":96459,"_2388":96528},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2861":58001,"_25133":57974,"_17569":96530,"_5":17464,"_23818":96459,"_2388":96531},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2861":58002,"_25133":57974,"_17569":96533,"_5":17464,"_23818":96459,"_2388":96534},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2861":58003,"_25133":57974,"_17569":96536,"_5":17464,"_23818":96463,"_2388":96537},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2861":58004,"_25133":57974,"_17569":96539,"_5":17464,"_23818":96467,"_2388":96540},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2861":58005,"_25133":57974,"_17569":96542,"_5":17464,"_23818":96467,"_2388":96543},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2861":58006,"_25133":57974,"_17569":96545,"_5":17464,"_23818":96467,"_2388":96546},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2861":58007,"_25133":57974,"_17569":96548,"_5":17464,"_23818":96467,"_2388":96549},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2861":58008,"_25133":57974,"_17569":96551,"_5":17464,"_23818":96471,"_2388":96552},[],"Para instalar un checkout local:",{"_2861":58009,"_25133":57974,"_17569":96554,"_5":17464,"_23818":96475,"_2388":96555},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2861":58010,"_25133":57974,"_17569":96557,"_5":17464,"_23818":96475,"_2388":96558},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2861":58011,"_25133":57974,"_17569":96560,"_5":17464,"_23818":96479,"_2388":96561},[],"Antes de pasar a producción, revisa:",{"_2861":58012,"_25133":57974,"_17569":96563,"_5":17464,"_23818":96479,"_2388":96564},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2861":58013,"_25133":57974,"_17569":96566,"_5":17464,"_23818":96479,"_2388":96567},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2861":58014,"_25133":57974,"_17569":96569,"_5":17464,"_23818":96479,"_2388":96570},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2861":58015,"_25133":57974,"_17569":96572,"_5":17464,"_23818":96479,"_2388":96573},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2861":58016,"_25133":57974,"_17569":96575,"_5":17464,"_23818":96479,"_2388":96576},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2861":58017,"_25133":57974,"_17569":96578,"_5":17464,"_23818":96479,"_2388":96579},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2861":58018,"_25133":57974,"_17569":96581,"_5":17464,"_23818":96479,"_2388":96582},[],"SMTP, observabilidad y entrega de alertas",{"_2861":58019,"_25133":57974,"_17569":96584,"_5":17464,"_23818":96479,"_2388":96585},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2861":58020,"_25133":57974,"_17569":96587,"_5":17464,"_23818":96479,"_2388":96588},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2861":58021,"_25133":58021,"_5":12309,"_2388":96590,"_25469":96591,"_17569":96592,"_23818":58021},"Expón el Gateway",[40834,95898,96132],[],{"_2861":58022,"_25133":58021,"_17569":96594,"_5":17464,"_23818":58021,"_2388":96595},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2861":58023,"_25133":58021,"_5":25466,"_17569":96597,"_23818":96598,"_2388":96599},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2861":58024,"_25133":58021,"_5":25466,"_17569":96601,"_23818":96602,"_2388":96603},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2861":58025,"_25133":58021,"_5":25466,"_17569":96605,"_23818":96606,"_2388":96607},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2861":58026,"_25133":58021,"_5":25466,"_17569":96609,"_23818":96610,"_2388":41580},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#k3s",{"_2861":58027,"_25133":58021,"_5":25466,"_17569":96612,"_23818":96613,"_2388":96614},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2861":58028,"_25133":58021,"_5":25466,"_17569":96616,"_23818":96617,"_2388":96618},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2861":58029,"_25133":58021,"_5":25466,"_17569":96620,"_23818":96621,"_2388":96622},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2861":58030,"_25133":58021,"_5":25466,"_17569":96624,"_23818":96625,"_2388":96626},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2861":58031,"_25133":58021,"_5":25466,"_17569":96628,"_23818":96629,"_2388":96630},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2861":58032,"_25133":58021,"_17569":96632,"_5":17464,"_23818":96598,"_2388":96633},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2861":58033,"_25133":58021,"_17569":96635,"_5":17464,"_23818":96598,"_2388":96636},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2861":58034,"_25133":58021,"_17569":96638,"_5":17464,"_23818":96602,"_2388":96639},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2861":58035,"_25133":58021,"_17569":96641,"_5":17464,"_23818":96602,"_2388":96642},[],"Defínelo únicamente cuando:",{"_2861":58036,"_25133":58021,"_17569":96644,"_5":17464,"_23818":96602,"_2388":96645},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2861":58037,"_25133":58021,"_17569":96647,"_5":17464,"_23818":96602,"_2388":96648},[],"esa dirección está asignada a este Gateway",{"_2861":58038,"_25133":58021,"_17569":96650,"_5":17464,"_23818":96602,"_2388":96651},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2861":58039,"_25133":58021,"_17569":96653,"_5":17464,"_23818":96602,"_2388":96654},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2861":58040,"_25133":58021,"_17569":96656,"_5":17464,"_23818":96602,"_2388":96657},[],"No confundas estos valores:",{"_2861":58041,"_25133":58021,"_17569":96659,"_5":17464,"_23818":96602,"_2388":96660},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2861":58042,"_25133":58021,"_17569":96662,"_5":17464,"_23818":96602,"_2388":96663},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2861":58043,"_25133":58021,"_17569":96665,"_5":17464,"_23818":96602,"_2388":96666},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2861":58044,"_25133":58021,"_17569":96668,"_5":17464,"_23818":96606,"_2388":96669},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2861":58045,"_25133":58021,"_17569":96671,"_5":17464,"_23818":96606,"_2388":96672},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2861":58046,"_25133":58021,"_17569":96674,"_5":17464,"_23818":96610,"_2388":96675},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2861":58047,"_25133":58021,"_17569":96677,"_5":17464,"_23818":96610,"_2388":96678},[],"Para el diseño recomendado:",{"_2861":58048,"_25133":58021,"_17569":96680,"_5":17464,"_23818":96610,"_2388":96681},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2861":58049,"_25133":58021,"_17569":96683,"_5":17464,"_23818":96610,"_2388":96684},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2861":58050,"_25133":58021,"_17569":96686,"_5":17464,"_23818":96610,"_2388":96687},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2861":58051,"_25133":58021,"_17569":96689,"_5":17464,"_23818":96610,"_2388":96690},[],"Apunta DNS a la dirección accesible de la VM.",{"_2861":58052,"_25133":58021,"_17569":96692,"_5":17464,"_23818":96610,"_2388":96693},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2861":58053,"_25133":58021,"_17569":96695,"_5":17464,"_23818":96613,"_2388":96696},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2861":58054,"_25133":58021,"_17569":96698,"_5":17464,"_23818":96617,"_2388":96699},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2861":58055,"_25133":58021,"_17569":96701,"_5":17464,"_23818":96617,"_2388":96702},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2861":58056,"_25133":58021,"_17569":96704,"_5":17464,"_23818":96621,"_2388":96705},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2861":58057,"_25133":58021,"_17569":96707,"_5":17464,"_23818":96621,"_2388":96708},[],"Requisito",{"_2861":58058,"_25133":58021,"_17569":96710,"_5":17464,"_23818":96621,"_2388":96711},[],"Diseño recomendado",{"_2861":58059,"_25133":58021,"_17569":96713,"_5":17464,"_23818":96621,"_2388":96714},[],"Consecuencia",{"_2861":58060,"_25133":58021,"_17569":96716,"_5":17464,"_23818":96621,"_2388":96717},[],"Varias URL o servicios de Lamassu",{"_2861":58061,"_25133":58021,"_17569":96719,"_5":17464,"_23818":96621,"_2388":96720},[],"Un Gateway con varias rutas",{"_2861":58062,"_25133":58021,"_17569":96722,"_5":17464,"_23818":96621,"_2388":96723},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2861":58063,"_25133":58021,"_17569":96725,"_5":17464,"_23818":96621,"_2388":96726},[],"Gateways independientes e IP externas distintas",{"_2861":58064,"_25133":58021,"_17569":96728,"_5":17464,"_23818":96621,"_2388":96729},[],"Una VIP por Gateway",{"_2861":58065,"_25133":58021,"_17569":96731,"_5":17464,"_23818":96621,"_2388":96732},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2861":58066,"_25133":58021,"_17569":96734,"_5":17464,"_23818":96621,"_2388":96735},[],"Gateways independientes, un nodo y una IP",{"_2861":58067,"_25133":58021,"_17569":96737,"_5":17464,"_23818":96621,"_2388":96738},[],"Puertos externos diferentes",{"_2861":58068,"_25133":58021,"_17569":96740,"_5":17464,"_23818":96621,"_2388":96741},[],"Los clientes deben indicar puertos no estándar",{"_2861":58069,"_25133":58021,"_17569":96743,"_5":17464,"_23818":96621,"_2388":96744},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2861":58070,"_25133":58021,"_17569":96746,"_5":17464,"_23818":96621,"_2388":96747},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2861":58071,"_25133":58021,"_17569":96749,"_5":17464,"_23818":96621,"_2388":96750},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2861":58072,"_25133":58021,"_17569":96752,"_5":17464,"_23818":96621,"_2388":96753},[],"Recursos Gateway separados pero proxy compartido",{"_2861":58073,"_25133":58021,"_17569":96755,"_5":17464,"_23818":96621,"_2388":96756},[],"Modo merged Gateway de Envoy",{"_2861":58074,"_25133":58021,"_17569":96758,"_5":17464,"_23818":96621,"_2388":96759},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2861":58075,"_25133":58021,"_17569":96761,"_5":17464,"_23818":96621,"_2388":96762},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2861":58076,"_25133":58021,"_17569":96764,"_5":17464,"_23818":96621,"_2388":96765},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2861":58077,"_25133":58021,"_17569":96767,"_5":17464,"_23818":96621,"_2388":96768},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2861":58078,"_25133":58021,"_17569":96770,"_5":17464,"_23818":96621,"_2388":96771},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2861":58079,"_25133":58021,"_17569":96773,"_5":17464,"_23818":96625,"_2388":96774},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2861":58080,"_25133":58021,"_17569":96776,"_5":17464,"_23818":96625,"_2388":96777},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2861":58081,"_25133":58021,"_17569":96779,"_5":17464,"_23818":96625,"_2388":96780},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2861":58082,"_25133":58021,"_17569":96782,"_5":17464,"_23818":96625,"_2388":96783},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2861":58083,"_25133":58021,"_17569":96785,"_5":17464,"_23818":96625,"_2388":96786},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2861":58084,"_25133":58021,"_17569":96788,"_5":17464,"_23818":96629,"_2388":96789},[],"Comprueba, en orden:",{"_2861":58085,"_25133":58021,"_17569":96791,"_5":17464,"_23818":96629,"_2388":96792},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2861":58086,"_25133":58021,"_17569":96794,"_5":17464,"_23818":96629,"_2388":96795},[],"Su estado contiene la dirección esperada.",{"_2861":58087,"_25133":58021,"_17569":96797,"_5":17464,"_23818":96629,"_2388":96798},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2861":58088,"_25133":58021,"_17569":96800,"_5":17464,"_23818":96629,"_2388":96801},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2861":58089,"_25133":58021,"_17569":96803,"_5":17464,"_23818":96629,"_2388":96804},[],"DNS resuelve al endpoint accesible externamente.",{"_2861":58090,"_25133":58021,"_17569":96806,"_5":17464,"_23818":96629,"_2388":96807},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2861":58091,"_25133":58021,"_17569":96809,"_5":17464,"_23818":96629,"_2388":96810},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2861":58092,"_25133":58092,"_5":12309,"_2388":40941,"_25469":96812,"_17569":96813,"_23818":58092},[40834,95898,96132],[],{"_2861":58093,"_25133":58092,"_17569":96815,"_5":17464,"_23818":58092,"_2388":96816},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2861":58094,"_25133":58092,"_5":25466,"_17569":96818,"_23818":96819,"_2388":96820},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2861":58095,"_25133":58092,"_5":25466,"_17569":96822,"_23818":96823,"_2388":96824},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2861":58096,"_25133":58092,"_5":25466,"_17569":96826,"_23818":96827,"_2388":96828},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2861":58097,"_25133":58092,"_5":25466,"_17569":96830,"_23818":96831,"_2388":96832},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2861":58098,"_25133":58092,"_5":25466,"_17569":96834,"_23818":96835,"_2388":96836},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2861":58099,"_25133":58092,"_5":25466,"_17569":96838,"_23818":96839,"_2388":96840},[],"/docs/pr-preview/pr-37/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2861":58100,"_25133":58092,"_17569":96842,"_5":17464,"_23818":96819,"_2388":96843},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2861":58101,"_25133":58092,"_17569":96845,"_5":17464,"_23818":96823,"_2388":96846},[],"Flujo",{"_2861":58102,"_25133":58092,"_17569":96848,"_5":17464,"_23818":96823,"_2388":96849},[],"Úsalo para",{"_2861":58103,"_25133":58092,"_17569":96851,"_5":17464,"_23818":96823,"_2388":96852},[],"Qué instala",{"_2861":58104,"_25133":58092,"_17569":96854,"_5":17464,"_23818":96823,"_2388":41825},[],{"_2861":58105,"_25133":58092,"_17569":96856,"_5":17464,"_23818":96823,"_2388":96857},[],"Producción y entornos controlados",{"_2861":58106,"_25133":58092,"_17569":96859,"_5":17464,"_23818":96823,"_2388":96860},[],"Servicios de Lamassu y recursos de Gateway API",{"_2861":58107,"_25133":58092,"_17569":96862,"_5":17464,"_23818":96823,"_2388":41078},[],{"_2861":58108,"_25133":58092,"_17569":96864,"_5":17464,"_23818":96823,"_2388":96865},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2861":58109,"_25133":58092,"_17569":96867,"_5":17464,"_23818":96823,"_2388":96868},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2861":58110,"_25133":58092,"_17569":96870,"_5":17464,"_23818":96827,"_2388":96871},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2861":58111,"_25133":58092,"_17569":96873,"_5":17464,"_23818":96827,"_2388":96874},[],"Área",{"_2861":58112,"_25133":58092,"_17569":96876,"_5":17464,"_23818":96827,"_2388":96877},[],"El chart de Lamassu proporciona",{"_2861":58113,"_25133":58092,"_17569":96879,"_5":17464,"_23818":96827,"_2388":96880},[],"Tú proporcionas",{"_2861":58114,"_25133":58092,"_17569":96882,"_5":17464,"_23818":96827,"_2388":96883},[],"Aplicaciones Lamassu",{"_2861":58115,"_25133":58092,"_17569":96885,"_5":17464,"_23818":96827,"_2388":96886},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2861":58116,"_25133":58092,"_17569":96888,"_5":17464,"_23818":96827,"_2388":96889},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2861":58117,"_25133":58092,"_17569":96891,"_5":17464,"_23818":96827,"_2388":96892},[],"Datos PostgreSQL",{"_2861":58118,"_25133":58092,"_17569":96894,"_5":17464,"_23818":96827,"_2388":96895},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2861":58119,"_25133":58092,"_17569":96897,"_5":17464,"_23818":96827,"_2388":96898},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2861":58120,"_25133":58092,"_17569":96900,"_5":17464,"_23818":96827,"_2388":96901},[],"Mensajería",{"_2861":58121,"_25133":58092,"_17569":96903,"_5":17464,"_23818":96827,"_2388":96904},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2861":58122,"_25133":58092,"_17569":96906,"_5":17464,"_23818":96827,"_2388":96907},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2861":58123,"_25133":58092,"_17569":96909,"_5":17464,"_23818":96827,"_2388":96910},[],"Identidad",{"_2861":58124,"_25133":58092,"_17569":96912,"_5":17464,"_23818":96827,"_2388":96913},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2861":58125,"_25133":58092,"_17569":96915,"_5":17464,"_23818":96827,"_2388":96916},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2861":58126,"_25133":58092,"_17569":96918,"_5":17464,"_23818":96827,"_2388":96919},[],"Enrutamiento externo",{"_2861":58127,"_25133":58092,"_17569":96921,"_5":17464,"_23818":96827,"_2388":96922},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2861":58128,"_25133":58092,"_17569":96924,"_5":17464,"_23818":96827,"_2388":96925},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2861":58129,"_25133":58092,"_17569":96927,"_5":17464,"_23818":96827,"_2388":41899},[],{"_2861":58130,"_25133":58092,"_17569":96929,"_5":17464,"_23818":96827,"_2388":96930},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2861":58131,"_25133":58092,"_17569":96932,"_5":17464,"_23818":96827,"_2388":96933},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2861":58132,"_25133":58092,"_17569":96935,"_5":17464,"_23818":96827,"_2388":96936},[],"Datos persistentes de la aplicación",{"_2861":58133,"_25133":58092,"_17569":96938,"_5":17464,"_23818":96827,"_2388":96939},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2861":58134,"_25133":58092,"_17569":96941,"_5":17464,"_23818":96827,"_2388":96942},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2861":58135,"_25133":58092,"_17569":96944,"_5":17464,"_23818":96827,"_2388":96945},[],"Integraciones opcionales",{"_2861":58136,"_25133":58092,"_17569":96947,"_5":17464,"_23818":96827,"_2388":96948},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2861":58137,"_25133":58092,"_17569":96950,"_5":17464,"_23818":96827,"_2388":96951},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2861":58138,"_25133":58092,"_17569":96953,"_5":17464,"_23818":96827,"_2388":96954},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2861":58139,"_25133":58092,"_17569":96956,"_5":17464,"_23818":96827,"_2388":96957},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2861":58140,"_25133":58092,"_17569":96959,"_5":17464,"_23818":96831,"_2388":96960},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2861":58141,"_25133":58092,"_17569":96962,"_5":17464,"_23818":96831,"_2388":96963},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2861":58142,"_25133":58092,"_17569":96965,"_5":17464,"_23818":96835,"_2388":96966},[],"Kubernetes 1.24 o posterior",{"_2861":58143,"_25133":58092,"_17569":96968,"_5":17464,"_23818":96835,"_2388":96969},[],"Helm 3.2 o posterior",{"_2861":58144,"_25133":58092,"_17569":96971,"_5":17464,"_23818":96835,"_2388":96972},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2861":58145,"_25133":58092,"_17569":96974,"_5":17464,"_23818":96835,"_2388":96975},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2861":58146,"_25133":58092,"_17569":96977,"_5":17464,"_23818":96835,"_2388":96978},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2861":58147,"_25133":58092,"_17569":96980,"_5":17464,"_23818":96835,"_2388":96981},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2861":58148,"_25133":58092,"_17569":96983,"_5":17464,"_23818":96835,"_2388":96984},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2861":58149,"_25133":58092,"_17569":96986,"_5":17464,"_23818":96839,"_2388":96987},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2861":58150,"_25133":58092,"_17569":96989,"_5":17464,"_23818":96839,"_2388":96990},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2861":58151,"_25133":58092,"_17569":96992,"_5":17464,"_23818":96839,"_2388":96993},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2861":58152,"_25133":58152,"_5":12309,"_2388":96995,"_25469":96996,"_17569":96998,"_23818":58152},"Resolución de problemas de despliegue",[40834,95898,96997],"Operación",[],{"_2861":58153,"_25133":58152,"_17569":97000,"_5":17464,"_23818":58152,"_2388":97001},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2861":58154,"_25133":58152,"_5":25466,"_17569":97003,"_23818":97004,"_2388":97005},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2861":58155,"_25133":58152,"_5":25466,"_17569":97007,"_23818":97008,"_2388":97009},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2861":58156,"_25133":58152,"_5":25466,"_17569":97011,"_23818":97012,"_2388":97013},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2861":58157,"_25133":58152,"_5":25466,"_17569":97015,"_23818":97016,"_2388":97017},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2861":58158,"_25133":58152,"_5":25466,"_17569":97019,"_23818":97020,"_2388":97021},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2861":58159,"_25133":58152,"_5":25466,"_17569":97023,"_23818":97024,"_2388":97025},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2861":58160,"_25133":58152,"_5":25466,"_17569":97027,"_23818":97028,"_2388":97029},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2861":58161,"_25133":58152,"_5":25466,"_17569":97031,"_23818":97032,"_2388":97033},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2861":58162,"_25133":58152,"_5":25466,"_17569":97035,"_23818":97036,"_2388":97037},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2861":58163,"_25133":58152,"_5":25466,"_17569":97039,"_23818":97040,"_2388":97041},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2861":58164,"_25133":58152,"_5":25466,"_17569":97043,"_23818":97044,"_2388":97045},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2861":58165,"_25133":58152,"_5":25466,"_17569":97047,"_23818":97048,"_2388":97049},[],"/docs/pr-preview/pr-37/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2861":58166,"_25133":58152,"_17569":97051,"_5":17464,"_23818":58152,"_2388":97052},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2861":58167,"_25133":58152,"_17569":97054,"_5":17464,"_23818":97008,"_2388":97055},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2861":58168,"_25133":58152,"_17569":97057,"_5":17464,"_23818":97012,"_2388":97058},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2861":58169,"_25133":58152,"_17569":97060,"_5":17464,"_23818":97016,"_2388":97061},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2861":58170,"_25133":58152,"_17569":97063,"_5":17464,"_23818":97020,"_2388":97064},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2861":58171,"_25133":58152,"_17569":97066,"_5":17464,"_23818":97024,"_2388":97067},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2861":58172,"_25133":58152,"_17569":97069,"_5":17464,"_23818":97028,"_2388":97070},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2861":58173,"_25133":58152,"_17569":97072,"_5":17464,"_23818":97028,"_2388":97073},[],"Ejecuta también la prueba de conectividad del chart:",{"_2861":58174,"_25133":58152,"_17569":97075,"_5":17464,"_23818":97028,"_2388":97076},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2861":58175,"_25133":58152,"_17569":97078,"_5":17464,"_23818":97028,"_2388":97079},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2861":58176,"_25133":58152,"_17569":97081,"_5":17464,"_23818":97032,"_2388":97082},[],"Si recibes un 401:",{"_2861":58177,"_25133":58152,"_17569":97084,"_5":17464,"_23818":97032,"_2388":97085},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2861":58178,"_25133":58152,"_17569":97087,"_5":17464,"_23818":97032,"_2388":97088},[],"verifica emisor, audiencia y expiración del token;",{"_2861":58179,"_25133":58152,"_17569":97090,"_5":17464,"_23818":97032,"_2388":97091},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2861":58180,"_25133":58152,"_17569":97093,"_5":17464,"_23818":97032,"_2388":97094},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2861":58181,"_25133":58152,"_17569":97096,"_5":17464,"_23818":97032,"_2388":97097},[],"Si el login termina pero las APIs devuelven 403:",{"_2861":58182,"_25133":58152,"_17569":97099,"_5":17464,"_23818":97032,"_2388":97100},[],"inspecciona los claims reales del token;",{"_2861":58183,"_25133":58152,"_17569":97102,"_5":17464,"_23818":97032,"_2388":97103},[],"confirma que coinciden con un principal activo;",{"_2861":58184,"_25133":58152,"_17569":97105,"_5":17464,"_23818":97032,"_2388":97106},[],"revisa las políticas concedidas al principal;",{"_2861":58185,"_25133":58152,"_17569":97108,"_5":17464,"_23818":97032,"_2388":97109},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2861":58186,"_25133":58152,"_17569":97111,"_5":17464,"_23818":97032,"_2388":97112},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2861":58187,"_25133":58152,"_17569":97114,"_5":17464,"_23818":97036,"_2388":97115},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2861":58188,"_25133":58152,"_17569":97117,"_5":17464,"_23818":97036,"_2388":97118},[],"Localiza el pod y Service de authz.",{"_2861":58189,"_25133":58152,"_17569":97120,"_5":17464,"_23818":97036,"_2388":97121},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2861":58190,"_25133":58152,"_17569":97123,"_5":17464,"_23818":97036,"_2388":97124},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2861":58191,"_25133":58152,"_17569":97126,"_5":17464,"_23818":97036,"_2388":97127},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2861":58192,"_25133":58152,"_17569":97129,"_5":17464,"_23818":97036,"_2388":97130},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2861":58193,"_25133":58152,"_17569":97132,"_5":17464,"_23818":97040,"_2388":97133},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2861":58194,"_25133":58152,"_17569":97135,"_5":17464,"_23818":97040,"_2388":97136},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2861":58195,"_25133":58152,"_17569":97138,"_5":17464,"_23818":97040,"_2388":97139},[],"volumen persistente sin enlazar;",{"_2861":58196,"_25133":58152,"_17569":97141,"_5":17464,"_23818":97040,"_2388":97142},[],"imagen inaccesible o política de pull incorrecta;",{"_2861":58197,"_25133":58152,"_17569":97144,"_5":17464,"_23818":97040,"_2388":97145},[],"configuración inválida del motor criptográfico;",{"_2861":58198,"_25133":58152,"_17569":97147,"_5":17464,"_23818":97040,"_2388":97148},[],"límites de CPU o memoria demasiado bajos;",{"_2861":58199,"_25133":58152,"_17569":97150,"_5":17464,"_23818":97040,"_2388":97151},[],"migración previa incompleta.",{"_2861":58200,"_25133":58152,"_17569":97153,"_5":17464,"_23818":97040,"_2388":97154},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2861":58201,"_25133":58152,"_17569":97156,"_5":17464,"_23818":97040,"_2388":97157},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2861":58202,"_25133":58152,"_17569":97159,"_5":17464,"_23818":97044,"_2388":97160},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2861":58203,"_25133":58152,"_17569":97162,"_5":17464,"_23818":97044,"_2388":97163},[],"verifica que esté habilitado en el servicio emisor;",{"_2861":58204,"_25133":58152,"_17569":97165,"_5":17464,"_23818":97044,"_2388":97166},[],"comprueba conectividad y credenciales AMQP;",{"_2861":58205,"_25133":58152,"_17569":97168,"_5":17464,"_23818":97044,"_2388":97169},[],"revisa exchange, routing key, colas y consumidores;",{"_2861":58206,"_25133":58152,"_17569":97171,"_5":17464,"_23818":97044,"_2388":97172},[],"inspecciona dead-letter queues;",{"_2861":58207,"_25133":58152,"_17569":97174,"_5":17464,"_23818":97044,"_2388":97175},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2861":58208,"_25133":58152,"_17569":97177,"_5":17464,"_23818":97044,"_2388":97178},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2861":58209,"_25133":58152,"_17569":97180,"_5":17464,"_23818":97048,"_2388":97181},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2861":58210,"_25133":58152,"_17569":97183,"_5":17464,"_23818":97048,"_2388":97184},[],"Antes de cerrar una incidencia, guarda:",{"_2861":58211,"_25133":58152,"_17569":97186,"_5":17464,"_23818":97048,"_2388":97187},[],"causa confirmada;",{"_2861":58212,"_25133":58152,"_17569":97189,"_5":17464,"_23818":97048,"_2388":97190},[],"alcance temporal y recursos afectados;",{"_2861":58213,"_25133":58152,"_17569":97192,"_5":17464,"_23818":97048,"_2388":97193},[],"comandos o consultas utilizados;",{"_2861":58214,"_25133":58152,"_17569":97195,"_5":17464,"_23818":97048,"_2388":97196},[],"cambio aplicado y forma de revertirlo;",{"_2861":58215,"_25133":58152,"_17569":97198,"_5":17464,"_23818":97048,"_2388":97199},[],"validación desde un consumidor;",{"_2861":58216,"_25133":58152,"_17569":97201,"_5":17464,"_23818":97048,"_2388":97202},[],"acción preventiva y propietario.",{"_2861":58217,"_25133":58217,"_5":12309,"_2388":97204,"_25469":97205,"_17569":97208,"_23818":58217},"Control de acceso",[40834,97206,97207],"Plataforma","Administración",[],{"_2861":58218,"_25133":58217,"_17569":97210,"_5":17464,"_23818":58217,"_2388":97211},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2861":58219,"_25133":58217,"_5":25466,"_17569":97213,"_23818":97214,"_2388":97215},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2861":58220,"_25133":58217,"_5":25466,"_17569":97217,"_23818":97218,"_2388":97219},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2861":58221,"_25133":58217,"_5":25466,"_17569":97221,"_23818":97222,"_2388":97223},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2861":58222,"_25133":58217,"_5":25466,"_17569":97225,"_23818":97226,"_2388":97227},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2861":58223,"_25133":58217,"_5":25466,"_17569":97229,"_23818":97230,"_2388":97231},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2861":58224,"_25133":58217,"_5":25466,"_17569":97233,"_23818":97234,"_2388":97235},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2861":58225,"_25133":58217,"_5":25466,"_17569":97237,"_23818":97238,"_2388":97239},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2861":58226,"_25133":58217,"_5":25466,"_17569":97241,"_23818":97242,"_2388":97243},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2861":58227,"_25133":58217,"_5":25466,"_17569":97245,"_23818":97246,"_2388":97247},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2861":58228,"_25133":58217,"_5":25466,"_17569":97249,"_23818":97250,"_2388":97251},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2861":58229,"_25133":58217,"_5":25466,"_17569":97253,"_23818":97254,"_2388":97255},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2861":58230,"_25133":58217,"_5":25466,"_17569":97257,"_23818":97258,"_2388":97259},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2861":58231,"_25133":58217,"_5":25466,"_17569":97261,"_23818":97262,"_2388":97263},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2861":58232,"_25133":58217,"_5":25466,"_17569":97265,"_23818":97266,"_2388":97267},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2861":58233,"_25133":58217,"_5":25466,"_17569":97269,"_23818":97270,"_2388":97271},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2861":58234,"_25133":58217,"_5":25466,"_17569":97273,"_23818":97274,"_2388":96468},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2861":58235,"_25133":58217,"_5":25466,"_17569":97276,"_23818":97277,"_2388":97278},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2861":58236,"_25133":58217,"_5":25466,"_17569":97280,"_23818":97281,"_2388":97282},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2861":58237,"_25133":58217,"_5":25466,"_17569":97284,"_23818":97285,"_2388":97286},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2861":58238,"_25133":58217,"_5":25466,"_17569":97288,"_23818":97289,"_2388":97290},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2861":58239,"_25133":58217,"_5":25466,"_17569":97292,"_23818":97293,"_2388":97294},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2861":58240,"_25133":58217,"_5":25466,"_17569":97296,"_23818":97297,"_2388":97298},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2861":58241,"_25133":58217,"_5":25466,"_17569":97300,"_23818":97301,"_2388":97302},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2861":58242,"_25133":58217,"_5":25466,"_17569":97304,"_23818":97305,"_2388":97306},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2861":58243,"_25133":58217,"_5":25466,"_17569":97308,"_23818":97309,"_2388":97310},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2861":58244,"_25133":58217,"_5":25466,"_17569":97312,"_23818":97313,"_2388":97314},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2861":58245,"_25133":58217,"_5":25466,"_17569":97316,"_23818":97317,"_2388":97318},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2861":58246,"_25133":58217,"_5":25466,"_17569":97320,"_23818":97321,"_2388":97322},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2861":58247,"_25133":58217,"_5":25466,"_17569":97324,"_23818":97325,"_2388":97326},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2861":58248,"_25133":58217,"_5":25466,"_17569":97328,"_23818":97329,"_2388":97330},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2861":58249,"_25133":58217,"_5":25466,"_17569":97332,"_23818":97333,"_2388":97334},[],"/docs/pr-preview/pr-37/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2861":58250,"_25133":58217,"_17569":97336,"_5":17464,"_23818":58217,"_2388":97337},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2861":58251,"_25133":58217,"_17569":97339,"_5":17464,"_23818":58217,"_2388":97340},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2861":58252,"_25133":58217,"_17569":97342,"_5":17464,"_23818":58217,"_2388":97343},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2861":58253,"_25133":58217,"_17569":97345,"_5":17464,"_23818":97214,"_2388":97346},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2861":58254,"_25133":58217,"_17569":97348,"_5":17464,"_23818":97214,"_2388":97349},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2861":58255,"_25133":58217,"_17569":97351,"_5":17464,"_23818":97214,"_2388":97352},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2861":58256,"_25133":58217,"_17569":97354,"_5":17464,"_23818":97214,"_2388":97355},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2861":58257,"_25133":58217,"_17569":97357,"_5":17464,"_23818":97214,"_2388":97358},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2861":58258,"_25133":58217,"_17569":97360,"_5":17464,"_23818":97214,"_2388":97361},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2861":58259,"_25133":58217,"_17569":97363,"_5":17464,"_23818":97218,"_2388":97364},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2861":58260,"_25133":58217,"_17569":97366,"_5":17464,"_23818":97218,"_2388":97367},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2861":58261,"_25133":58217,"_17569":97369,"_5":17464,"_23818":97222,"_2388":97370},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2861":58262,"_25133":58217,"_17569":97372,"_5":17464,"_23818":97222,"_2388":97373},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2861":58263,"_25133":58217,"_17569":97375,"_5":17464,"_23818":97222,"_2388":97376},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2861":58264,"_25133":58217,"_17569":97378,"_5":17464,"_23818":97222,"_2388":97379},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2861":58265,"_25133":58217,"_17569":97381,"_5":17464,"_23818":97222,"_2388":97382},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2861":58266,"_25133":58217,"_17569":97384,"_5":17464,"_23818":97222,"_2388":97385},[],"Carga por separado las políticas concedidas a cada principal.",{"_2861":58267,"_25133":58217,"_17569":97387,"_5":17464,"_23818":97222,"_2388":97388},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2861":58268,"_25133":58217,"_17569":97390,"_5":17464,"_23818":97222,"_2388":97391},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2861":58269,"_25133":58217,"_17569":97393,"_5":17464,"_23818":97222,"_2388":97394},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2861":58270,"_25133":58217,"_17569":97396,"_5":17464,"_23818":97222,"_2388":97397},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2861":58271,"_25133":58217,"_17569":97399,"_5":17464,"_23818":97222,"_2388":97400},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2861":58272,"_25133":58217,"_17569":97402,"_5":17464,"_23818":97222,"_2388":97403},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2861":58273,"_25133":58217,"_17569":97405,"_5":17464,"_23818":97226,"_2388":97406},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2861":58274,"_25133":58217,"_17569":97408,"_5":17464,"_23818":97226,"_2388":97409},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2861":58275,"_25133":58217,"_17569":97411,"_5":17464,"_23818":97226,"_2388":97412},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2861":58276,"_25133":58217,"_17569":97414,"_5":17464,"_23818":97226,"_2388":97415},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2861":58277,"_25133":58217,"_17569":97417,"_5":17464,"_23818":97226,"_2388":97418},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2861":58278,"_25133":58217,"_17569":97420,"_5":17464,"_23818":97226,"_2388":97421},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2861":58279,"_25133":58217,"_17569":97423,"_5":17464,"_23818":97226,"_2388":97424},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2861":58280,"_25133":58217,"_17569":97426,"_5":17464,"_23818":97226,"_2388":97427},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2861":58281,"_25133":58217,"_17569":97429,"_5":17464,"_23818":97230,"_2388":97430},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2861":58282,"_25133":58217,"_17569":97432,"_5":17464,"_23818":97230,"_2388":97433},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2861":58283,"_25133":58217,"_17569":97435,"_5":17464,"_23818":97230,"_2388":97436},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2861":58284,"_25133":58217,"_17569":97438,"_5":17464,"_23818":97230,"_2388":97439},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2861":58285,"_25133":58217,"_17569":97441,"_5":17464,"_23818":97230,"_2388":97442},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2861":58286,"_25133":58217,"_17569":97444,"_5":17464,"_23818":97230,"_2388":97445},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2861":58287,"_25133":58217,"_17569":97447,"_5":17464,"_23818":97230,"_2388":97448},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2861":58288,"_25133":58217,"_17569":97450,"_5":17464,"_23818":97230,"_2388":97451},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2861":58289,"_25133":58217,"_17569":97453,"_5":17464,"_23818":97230,"_2388":97454},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2861":58290,"_25133":58217,"_17569":97456,"_5":17464,"_23818":97230,"_2388":97457},[],"Las acciones se dividen en dos grupos:",{"_2861":58291,"_25133":58217,"_17569":97459,"_5":17464,"_23818":97230,"_2388":97460},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2861":58292,"_25133":58217,"_17569":97462,"_5":17464,"_23818":97230,"_2388":97463},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2861":58293,"_25133":58217,"_17569":97465,"_5":17464,"_23818":97230,"_2388":97466},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2861":58294,"_25133":58217,"_17569":97468,"_5":17464,"_23818":97234,"_2388":97469},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2861":58295,"_25133":58217,"_17569":97471,"_5":17464,"_23818":97234,"_2388":97472},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2861":58296,"_25133":58217,"_17569":97474,"_5":17464,"_23818":97234,"_2388":97475},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2861":58297,"_25133":58217,"_17569":97477,"_5":17464,"_23818":97238,"_2388":97478},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2861":58298,"_25133":58217,"_17569":97480,"_5":17464,"_23818":97238,"_2388":97481},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2861":58299,"_25133":58217,"_17569":97483,"_5":17464,"_23818":97238,"_2388":97484},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2861":58300,"_25133":58217,"_17569":97486,"_5":17464,"_23818":97238,"_2388":97487},[],"Los operadores implementados son:",{"_2861":58301,"_25133":58217,"_17569":97489,"_5":17464,"_23818":97238,"_2388":97490},[],"`equals`, para igualdad exacta;",{"_2861":58302,"_25133":58217,"_17569":97492,"_5":17464,"_23818":97238,"_2388":97493},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2861":58303,"_25133":58217,"_17569":97495,"_5":17464,"_23818":97238,"_2388":97496},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2861":58304,"_25133":58217,"_17569":97498,"_5":17464,"_23818":97238,"_2388":97499},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2861":58305,"_25133":58217,"_17569":97501,"_5":17464,"_23818":97242,"_2388":97502},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2861":58306,"_25133":58217,"_17569":97504,"_5":17464,"_23818":97242,"_2388":97505},[],"Los modos disponibles son:",{"_2861":58307,"_25133":58217,"_17569":97507,"_5":17464,"_23818":97242,"_2388":97508},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2861":58308,"_25133":58217,"_17569":97510,"_5":17464,"_23818":97242,"_2388":97511},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2861":58309,"_25133":58217,"_17569":97513,"_5":17464,"_23818":97242,"_2388":97514},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2861":58310,"_25133":58217,"_17569":97516,"_5":17464,"_23818":97242,"_2388":97517},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2861":58311,"_25133":58217,"_17569":97519,"_5":17464,"_23818":97242,"_2388":97520},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2861":58312,"_25133":58217,"_17569":97522,"_5":17464,"_23818":97242,"_2388":97523},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2861":58313,"_25133":58217,"_17569":97525,"_5":17464,"_23818":97246,"_2388":97526},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2861":58314,"_25133":58217,"_17569":97528,"_5":17464,"_23818":97246,"_2388":97529},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2861":58315,"_25133":58217,"_17569":97531,"_5":17464,"_23818":97246,"_2388":97532},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2861":58316,"_25133":58217,"_17569":97534,"_5":17464,"_23818":97246,"_2388":97535},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2861":58317,"_25133":58217,"_17569":97537,"_5":17464,"_23818":97254,"_2388":97538},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2861":58318,"_25133":58217,"_17569":97540,"_5":17464,"_23818":97254,"_2388":97541},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2861":58319,"_25133":58217,"_17569":97543,"_5":17464,"_23818":97258,"_2388":97544},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2861":58320,"_25133":58217,"_17569":97546,"_5":17464,"_23818":97258,"_2388":97547},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2861":58321,"_25133":58217,"_17569":97549,"_5":17464,"_23818":97262,"_2388":97550},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2861":58322,"_25133":58217,"_17569":97552,"_5":17464,"_23818":97262,"_2388":97553},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2861":58323,"_25133":58217,"_17569":97555,"_5":17464,"_23818":97262,"_2388":97556},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2861":58324,"_25133":58217,"_17569":97558,"_5":17464,"_23818":97266,"_2388":97559},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2861":58325,"_25133":58217,"_17569":97561,"_5":17464,"_23818":97266,"_2388":97562},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2861":58326,"_25133":58217,"_17569":97564,"_5":17464,"_23818":97266,"_2388":97565},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2861":58327,"_25133":58217,"_17569":97567,"_5":17464,"_23818":97266,"_2388":97568},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2861":58328,"_25133":58217,"_17569":97570,"_5":17464,"_23818":97266,"_2388":97571},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2861":58329,"_25133":58217,"_17569":97573,"_5":17464,"_23818":97266,"_2388":97574},[],"Ten en cuenta que:",{"_2861":58330,"_25133":58217,"_17569":97576,"_5":17464,"_23818":97266,"_2388":97577},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2861":58331,"_25133":58217,"_17569":97579,"_5":17464,"_23818":97266,"_2388":97580},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2861":58332,"_25133":58217,"_17569":97582,"_5":17464,"_23818":97266,"_2388":97583},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2861":58333,"_25133":58217,"_17569":97585,"_5":17464,"_23818":97270,"_2388":97586},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2861":58334,"_25133":58217,"_17569":97588,"_5":17464,"_23818":97270,"_2388":97589},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2861":58335,"_25133":58217,"_17569":97591,"_5":17464,"_23818":97270,"_2388":97592},[],"acceso completo y de solo lectura a KMS;",{"_2861":58336,"_25133":58217,"_17569":97594,"_5":17464,"_23818":97270,"_2388":97595},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2861":58337,"_25133":58217,"_17569":97597,"_5":17464,"_23818":97270,"_2388":97598},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2861":58338,"_25133":58217,"_17569":97600,"_5":17464,"_23818":97270,"_2388":97601},[],"acceso a la interfaz;",{"_2861":58339,"_25133":58217,"_17569":97603,"_5":17464,"_23818":97270,"_2388":97604},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2861":58340,"_25133":58217,"_17569":97606,"_5":17464,"_23818":97270,"_2388":97607},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2861":58341,"_25133":58217,"_17569":97609,"_5":17464,"_23818":97270,"_2388":97610},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2861":58342,"_25133":58217,"_17569":97612,"_5":17464,"_23818":97274,"_2388":97613},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2861":58343,"_25133":58217,"_17569":97615,"_5":17464,"_23818":97274,"_2388":97616},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2861":58344,"_25133":58217,"_17569":97618,"_5":17464,"_23818":97274,"_2388":97619},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2861":58345,"_25133":58217,"_17569":97621,"_5":17464,"_23818":97277,"_2388":97622},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2861":58346,"_25133":58217,"_17569":97624,"_5":17464,"_23818":97281,"_2388":97625},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2861":58347,"_25133":58217,"_17569":97627,"_5":17464,"_23818":97285,"_2388":97628},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2861":58348,"_25133":58217,"_17569":97630,"_5":17464,"_23818":97289,"_2388":97631},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2861":58349,"_25133":58217,"_17569":97633,"_5":17464,"_23818":97293,"_2388":97634},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2861":58350,"_25133":58217,"_17569":97636,"_5":17464,"_23818":97297,"_2388":97637},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2861":58351,"_25133":58217,"_17569":97639,"_5":17464,"_23818":97297,"_2388":97640},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2861":58352,"_25133":58217,"_17569":97642,"_5":17464,"_23818":97301,"_2388":97643},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2861":58353,"_25133":58217,"_17569":97645,"_5":17464,"_23818":97301,"_2388":97646},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2861":58354,"_25133":58217,"_17569":97648,"_5":17464,"_23818":97301,"_2388":97649},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2861":58355,"_25133":58217,"_17569":97651,"_5":17464,"_23818":97301,"_2388":97652},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2861":58356,"_25133":58217,"_17569":97654,"_5":17464,"_23818":97301,"_2388":97655},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2861":58357,"_25133":58217,"_17569":97657,"_5":17464,"_23818":97301,"_2388":97658},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2861":58358,"_25133":58217,"_17569":97660,"_5":17464,"_23818":97301,"_2388":97661},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2861":58359,"_25133":58217,"_17569":97663,"_5":17464,"_23818":97301,"_2388":97664},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2861":58360,"_25133":58217,"_17569":97666,"_5":17464,"_23818":97305,"_2388":97667},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2861":58361,"_25133":58217,"_17569":97669,"_5":17464,"_23818":97305,"_2388":97670},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2861":58362,"_25133":58217,"_17569":97672,"_5":17464,"_23818":97305,"_2388":97673},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2861":58363,"_25133":58217,"_17569":97675,"_5":17464,"_23818":97309,"_2388":97676},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2861":58364,"_25133":58217,"_17569":97678,"_5":17464,"_23818":97309,"_2388":97679},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2861":58365,"_25133":58217,"_17569":97681,"_5":17464,"_23818":97309,"_2388":97682},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2861":58366,"_25133":58217,"_17569":97684,"_5":17464,"_23818":97309,"_2388":97685},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2861":58367,"_25133":58217,"_17569":97687,"_5":17464,"_23818":97309,"_2388":97688},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2861":58368,"_25133":58217,"_17569":97690,"_5":17464,"_23818":97309,"_2388":97691},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2861":58369,"_25133":58217,"_17569":97693,"_5":17464,"_23818":97309,"_2388":97694},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2861":58370,"_25133":58217,"_17569":97696,"_5":17464,"_23818":97309,"_2388":97697},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2861":58371,"_25133":58217,"_17569":97699,"_5":17464,"_23818":97317,"_2388":97700},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2861":58372,"_25133":58217,"_17569":97702,"_5":17464,"_23818":97321,"_2388":97703},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2861":58373,"_25133":58217,"_17569":97705,"_5":17464,"_23818":97321,"_2388":97706},[],"que exista un principal activo del tipo correcto;",{"_2861":58374,"_25133":58217,"_17569":97708,"_5":17464,"_23818":97321,"_2388":97709},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2861":58375,"_25133":58217,"_17569":97711,"_5":17464,"_23818":97321,"_2388":97712},[],"que todas las condiciones del principal se cumplan;",{"_2861":58376,"_25133":58217,"_17569":97714,"_5":17464,"_23818":97321,"_2388":97715},[],"que el principal tenga concedida la política esperada;",{"_2861":58377,"_25133":58217,"_17569":97717,"_5":17464,"_23818":97321,"_2388":97718},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2861":58378,"_25133":58217,"_17569":97720,"_5":17464,"_23818":97321,"_2388":97721},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2861":58379,"_25133":58217,"_17569":97723,"_5":17464,"_23818":97321,"_2388":97724},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2861":58380,"_25133":58217,"_17569":97726,"_5":17464,"_23818":97325,"_2388":97727},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2861":58381,"_25133":58217,"_17569":97729,"_5":17464,"_23818":97329,"_2388":97730},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2861":58382,"_25133":58217,"_17569":97732,"_5":17464,"_23818":97333,"_2388":97733},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2861":58383,"_25133":58217,"_17569":97735,"_5":17464,"_23818":97333,"_2388":97736},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2861":58384,"_25133":58384,"_5":12309,"_2388":97738,"_25469":97739,"_17569":97740,"_23818":58384},"Alertas y suscripciones",[40834,97206,97207],[],{"_2861":58385,"_25133":58384,"_17569":97742,"_5":17464,"_23818":58384,"_2388":97743},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2861":58386,"_25133":58384,"_5":25466,"_17569":97745,"_23818":97746,"_2388":97747},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2861":58387,"_25133":58384,"_5":25466,"_17569":97749,"_23818":97750,"_2388":97751},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2861":58388,"_25133":58384,"_5":25466,"_17569":97753,"_23818":97754,"_2388":97755},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2861":58389,"_25133":58384,"_5":25466,"_17569":97757,"_23818":97758,"_2388":97759},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2861":58390,"_25133":58384,"_5":25466,"_17569":97761,"_23818":97762,"_2388":97763},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2861":58391,"_25133":58384,"_5":25466,"_17569":97765,"_23818":97766,"_2388":97767},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2861":58392,"_25133":58384,"_5":25466,"_17569":97769,"_23818":97770,"_2388":97771},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2861":58393,"_25133":58384,"_5":25466,"_17569":97773,"_23818":97774,"_2388":97775},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2861":58394,"_25133":58384,"_5":25466,"_17569":97777,"_23818":97778,"_2388":97779},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2861":58395,"_25133":58384,"_5":25466,"_17569":97781,"_23818":97782,"_2388":97783},[],"/docs/pr-preview/pr-37/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2861":58396,"_25133":58384,"_17569":97785,"_5":17464,"_23818":58384,"_2388":97786},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2861":58397,"_25133":58384,"_17569":97788,"_5":17464,"_23818":97746,"_2388":97789},[],"Un servicio publica un evento de dominio.",{"_2861":58398,"_25133":58384,"_17569":97791,"_5":17464,"_23818":97746,"_2388":97792},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2861":58399,"_25133":58384,"_17569":97794,"_5":17464,"_23818":97746,"_2388":97795},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2861":58400,"_25133":58384,"_17569":97797,"_5":17464,"_23818":97746,"_2388":97798},[],"Lamassu entrega el evento al canal configurado.",{"_2861":58401,"_25133":58384,"_17569":97800,"_5":17464,"_23818":97746,"_2388":97801},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2861":58402,"_25133":58384,"_17569":97803,"_5":17464,"_23818":97750,"_2388":97804},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2861":58403,"_25133":58384,"_17569":97806,"_5":17464,"_23818":97750,"_2388":97807},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2861":58404,"_25133":58384,"_17569":97809,"_5":17464,"_23818":97750,"_2388":97810},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2861":58405,"_25133":58384,"_17569":97812,"_5":17464,"_23818":97750,"_2388":97813},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2861":58406,"_25133":58384,"_17569":97815,"_5":17464,"_23818":97750,"_2388":97816},[],"`apikey_options` necesita `header` y `key`.",{"_2861":58407,"_25133":58384,"_17569":97818,"_5":17464,"_23818":97750,"_2388":97819},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2861":58408,"_25133":58384,"_17569":97821,"_5":17464,"_23818":97750,"_2388":97822},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_2861":58409,"_25133":58384,"_17569":97824,"_5":17464,"_23818":97750,"_2388":97825},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2861":58410,"_25133":58384,"_17569":97827,"_5":17464,"_23818":97758,"_2388":97828},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2861":58411,"_25133":58384,"_17569":97830,"_5":17464,"_23818":97762,"_2388":97831},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2861":58412,"_25133":58384,"_17569":97833,"_5":17464,"_23818":97766,"_2388":97834},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2861":58413,"_25133":58384,"_17569":97836,"_5":17464,"_23818":97766,"_2388":97837},[],"**None** notifica todas las instancias del evento.",{"_2861":58414,"_25133":58384,"_17569":97839,"_5":17464,"_23818":97766,"_2388":97840},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2861":58415,"_25133":58384,"_17569":97842,"_5":17464,"_23818":97766,"_2388":97843},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2861":58416,"_25133":58384,"_17569":97845,"_5":17464,"_23818":97766,"_2388":97846},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2861":58417,"_25133":58384,"_17569":97848,"_5":17464,"_23818":97766,"_2388":97849},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2861":58418,"_25133":58384,"_17569":97851,"_5":17464,"_23818":97770,"_2388":97852},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2861":58419,"_25133":58384,"_17569":97854,"_5":17464,"_23818":97774,"_2388":97855},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2861":58420,"_25133":58384,"_17569":97857,"_5":17464,"_23818":97774,"_2388":97858},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2861":58421,"_25133":58384,"_17569":97860,"_5":17464,"_23818":97774,"_2388":97861},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2861":58422,"_25133":58384,"_17569":97863,"_5":17464,"_23818":97774,"_2388":97864},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2861":58423,"_25133":58384,"_17569":97866,"_5":17464,"_23818":97774,"_2388":97867},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2861":58424,"_25133":58384,"_17569":97869,"_5":17464,"_23818":97774,"_2388":97870},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2861":58425,"_25133":58384,"_17569":97872,"_5":17464,"_23818":97774,"_2388":97873},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2861":58426,"_25133":58384,"_17569":97875,"_5":17464,"_23818":97774,"_2388":97876},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2861":58427,"_25133":58384,"_17569":97878,"_5":17464,"_23818":97778,"_2388":97879},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2861":58428,"_25133":58384,"_17569":97881,"_5":17464,"_23818":97782,"_2388":97882},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2861":58429,"_25133":58384,"_17569":97884,"_5":17464,"_23818":97782,"_2388":97885},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2861":58430,"_25133":58384,"_17569":97887,"_5":17464,"_23818":97782,"_2388":97888},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2861":58431,"_25133":58384,"_17569":97890,"_5":17464,"_23818":97782,"_2388":97891},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2861":58432,"_25133":58384,"_17569":97893,"_5":17464,"_23818":97782,"_2388":97894},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2861":58433,"_25133":58384,"_17569":97896,"_5":17464,"_23818":97782,"_2388":97897},[],"**Validación:** `va.role.crl.create`.",{"_2861":58434,"_25133":58384,"_17569":97899,"_5":17464,"_23818":97782,"_2388":97900},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2861":58435,"_25133":58384,"_17569":97902,"_5":17464,"_23818":97782,"_2388":97903},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2861":58436,"_25133":58436,"_5":12309,"_2388":97905,"_25469":97906,"_17569":97907,"_23818":58436},"Registros de auditoría",[40834,97206,97207],[],{"_2861":58437,"_25133":58436,"_17569":97909,"_5":17464,"_23818":58436,"_2388":97910},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2861":58438,"_25133":58436,"_5":25466,"_17569":97912,"_23818":97913,"_2388":97914},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2861":58439,"_25133":58436,"_5":25466,"_17569":97916,"_23818":97917,"_2388":97918},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2861":58440,"_25133":58436,"_5":25466,"_17569":97920,"_23818":97921,"_2388":97922},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2861":58441,"_25133":58436,"_5":25466,"_17569":97924,"_23818":97925,"_2388":97926},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2861":58442,"_25133":58436,"_5":25466,"_17569":97928,"_23818":97929,"_2388":97930},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2861":58443,"_25133":58436,"_5":25466,"_17569":97932,"_23818":97933,"_2388":97934},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2861":58444,"_25133":58436,"_5":25466,"_17569":97936,"_23818":97937,"_2388":97938},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2861":58445,"_25133":58436,"_5":25466,"_17569":97940,"_23818":97941,"_2388":97942},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2861":58446,"_25133":58436,"_5":25466,"_17569":97944,"_23818":97945,"_2388":97946},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2861":58447,"_25133":58436,"_5":25466,"_17569":97948,"_23818":97949,"_2388":97950},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2861":58448,"_25133":58436,"_5":25466,"_17569":97952,"_23818":97953,"_2388":97954},[],"/docs/pr-preview/pr-37/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2861":58449,"_25133":58436,"_17569":97956,"_5":17464,"_23818":58436,"_2388":97957},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2861":58450,"_25133":58436,"_17569":97959,"_5":17464,"_23818":97913,"_2388":97960},[],"El cuerpo de auditoría incluye:",{"_2861":58451,"_25133":58436,"_17569":97962,"_5":17464,"_23818":97913,"_2388":97963},[],"input: datos recibidos por la operación;",{"_2861":58452,"_25133":58436,"_17569":97965,"_5":17464,"_23818":97913,"_2388":97966},[],"has\\_error: indica si el servicio devolvió un error;",{"_2861":58453,"_25133":58436,"_17569":97968,"_5":17464,"_23818":97913,"_2388":97969},[],"output: resultado producido o mensaje de error;",{"_2861":58454,"_25133":58436,"_17569":97971,"_5":17464,"_23818":97913,"_2388":97972},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2861":58455,"_25133":58436,"_17569":97974,"_5":17464,"_23818":97913,"_2388":97975},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2861":58456,"_25133":58436,"_17569":97977,"_5":17464,"_23818":97913,"_2388":97978},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2861":58457,"_25133":58436,"_17569":97980,"_5":17464,"_23818":97917,"_2388":97981},[],"El backend aplica auditoría a mutaciones de:",{"_2861":58458,"_25133":58436,"_17569":97983,"_5":17464,"_23818":97917,"_2388":97984},[],"autoridades, certificados y perfiles de emisión;",{"_2861":58459,"_25133":58436,"_17569":97986,"_5":17464,"_23818":97917,"_2388":97987},[],"claves y motores KMS;",{"_2861":58460,"_25133":58436,"_17569":97989,"_5":17464,"_23818":97917,"_2388":97990},[],"dispositivos e identidades;",{"_2861":58461,"_25133":58436,"_17569":97992,"_5":17464,"_23818":97917,"_2388":97993},[],"DMS y operaciones de enrolamiento;",{"_2861":58462,"_25133":58436,"_17569":97995,"_5":17464,"_23818":97917,"_2388":97996},[],"funciones de validación y CRL;",{"_2861":58463,"_25133":58436,"_17569":97998,"_5":17464,"_23818":97917,"_2388":97999},[],"principales, políticas y concesiones de autorización.",{"_2861":58464,"_25133":58436,"_17569":98001,"_5":17464,"_23818":97917,"_2388":98002},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2861":58465,"_25133":58436,"_17569":98004,"_5":17464,"_23818":97921,"_2388":98005},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2861":58466,"_25133":58436,"_17569":98007,"_5":17464,"_23818":97921,"_2388":98008},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2861":58467,"_25133":58436,"_17569":98010,"_5":17464,"_23818":97921,"_2388":98011},[],"Diseña el consumidor para:",{"_2861":58468,"_25133":58436,"_17569":98013,"_5":17464,"_23818":97921,"_2388":98014},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2861":58469,"_25133":58436,"_17569":98016,"_5":17464,"_23818":97921,"_2388":98017},[],"conservar el CloudEvent completo sin modificar;",{"_2861":58470,"_25133":58436,"_17569":98019,"_5":17464,"_23818":97921,"_2388":98020},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2861":58471,"_25133":58436,"_17569":98022,"_5":17464,"_23818":97921,"_2388":98023},[],"cifrar en tránsito y en reposo;",{"_2861":58472,"_25133":58436,"_17569":98025,"_5":17464,"_23818":97921,"_2388":98026},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2861":58473,"_25133":58436,"_17569":98028,"_5":17464,"_23818":97921,"_2388":98029},[],"aplicar una política explícita de retención y legal hold;",{"_2861":58474,"_25133":58436,"_17569":98031,"_5":17464,"_23818":97921,"_2388":98032},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2861":58475,"_25133":58436,"_17569":98034,"_5":17464,"_23818":97925,"_2388":98035},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2861":58476,"_25133":58436,"_17569":98037,"_5":17464,"_23818":97925,"_2388":98038},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2861":58477,"_25133":58436,"_17569":98040,"_5":17464,"_23818":97933,"_2388":98041},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2861":58478,"_25133":58436,"_17569":98043,"_5":17464,"_23818":97937,"_2388":98044},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2861":58479,"_25133":58436,"_17569":98046,"_5":17464,"_23818":97941,"_2388":98047},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2861":58480,"_25133":58436,"_17569":98049,"_5":17464,"_23818":97945,"_2388":98050},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2861":58481,"_25133":58436,"_17569":98052,"_5":17464,"_23818":97949,"_2388":98053},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2861":58482,"_25133":58436,"_17569":98055,"_5":17464,"_23818":97953,"_2388":98056},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2861":58483,"_25133":58436,"_17569":98058,"_5":17464,"_23818":97953,"_2388":98059},[],"aparece un evento de auditoría correcto;",{"_2861":58484,"_25133":58436,"_17569":98061,"_5":17464,"_23818":97953,"_2388":98062},[],"el principal coincide con la identidad utilizada;",{"_2861":58485,"_25133":58436,"_17569":98064,"_5":17464,"_23818":97953,"_2388":98065},[],"el consumidor lo persiste una sola vez;",{"_2861":58486,"_25133":58436,"_17569":98067,"_5":17464,"_23818":97953,"_2388":98068},[],"puede recuperarse por recurso, actor y periodo;",{"_2861":58487,"_25133":58436,"_17569":98070,"_5":17464,"_23818":97953,"_2388":98071},[],"una interrupción del consumidor produce una alerta.",{"_2861":58488,"_25133":58436,"_17569":98073,"_5":17464,"_23818":97953,"_2388":98074},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2861":58489,"_25133":58489,"_5":12309,"_2388":98076,"_25469":98077,"_17569":98078,"_23818":58489},"Arquitectura de la plataforma",[40834,97206],[],{"_2861":58490,"_25133":58489,"_17569":98080,"_5":17464,"_23818":58489,"_2388":98081},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2861":58491,"_25133":58489,"_5":25466,"_17569":98083,"_23818":98084,"_2388":98085},[],"/docs/pr-preview/pr-37/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2861":58492,"_25133":58489,"_5":25466,"_17569":98087,"_23818":98088,"_2388":98089},[],"/docs/pr-preview/pr-37/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2861":58493,"_25133":58489,"_5":25466,"_17569":98091,"_23818":98092,"_2388":98093},[],"/docs/pr-preview/pr-37/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2861":58494,"_25133":58489,"_5":25466,"_17569":98095,"_23818":98096,"_2388":98097},[],"/docs/pr-preview/pr-37/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2861":58495,"_25133":58489,"_5":25466,"_17569":98099,"_23818":98100,"_2388":98101},[],"/docs/pr-preview/pr-37/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2861":58496,"_25133":58489,"_17569":98103,"_5":17464,"_23818":58489,"_2388":98104},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2861":58497,"_25133":58489,"_17569":98106,"_5":17464,"_23818":58489,"_2388":98107},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2861":58498,"_25133":58489,"_17569":98109,"_5":17464,"_23818":98084,"_2388":98110},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2861":58499,"_25133":58489,"_17569":98112,"_5":17464,"_23818":98088,"_2388":98113},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2861":58500,"_25133":58489,"_17569":98115,"_5":17464,"_23818":98092,"_2388":98116},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2861":58501,"_25133":58489,"_17569":98118,"_5":17464,"_23818":98096,"_2388":98119},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2861":58502,"_25133":58489,"_17569":98121,"_5":17464,"_23818":98100,"_2388":98122},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2861":58503,"_25133":58503,"_5":12309,"_2388":98124,"_25469":98125,"_17569":98126,"_23818":58503},"Cómo funciona Lamassu",[40834,97206],[],{"_2861":58504,"_25133":58503,"_17569":98128,"_5":17464,"_23818":58503,"_2388":98129},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2861":58505,"_25133":58503,"_5":25466,"_17569":98131,"_23818":98132,"_2388":98133},[],"/docs/pr-preview/pr-37/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2861":58506,"_25133":58503,"_5":25466,"_17569":98135,"_23818":98136,"_2388":98137},[],"/docs/pr-preview/pr-37/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2861":58507,"_25133":58503,"_17569":98139,"_5":17464,"_23818":58503,"_2388":98140},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2861":58508,"_25133":58503,"_17569":98142,"_5":17464,"_23818":98132,"_2388":98143},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2861":58509,"_25133":58503,"_17569":98145,"_5":17464,"_23818":98132,"_2388":98146},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2861":58510,"_25133":58503,"_17569":98148,"_5":17464,"_23818":98132,"_2388":98149},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2861":58511,"_25133":58503,"_17569":98151,"_5":17464,"_23818":98132,"_2388":98152},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2861":58512,"_25133":58503,"_17569":98154,"_5":17464,"_23818":98132,"_2388":98155},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2861":58513,"_25133":58503,"_17569":98157,"_5":17464,"_23818":98136,"_2388":98158},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2861":58514,"_25133":58503,"_17569":98160,"_5":17464,"_23818":98136,"_2388":98161},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2861":58515,"_25133":58503,"_17569":98163,"_5":17464,"_23818":98136,"_2388":98164},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2861":58516,"_25133":58503,"_17569":98166,"_5":17464,"_23818":98136,"_2388":98167},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2861":58517,"_25133":58503,"_17569":98169,"_5":17464,"_23818":98136,"_2388":98170},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2861":58518,"_25133":58503,"_17569":98172,"_5":17464,"_23818":98136,"_2388":98173},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2861":58519,"_25133":58503,"_17569":98175,"_5":17464,"_23818":98136,"_2388":98176},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2861":58520,"_25133":58520,"_5":12309,"_2388":98178,"_25469":98179,"_17569":98180,"_23818":58520},"Dispositivos e identidades",[40834,97206,43152,98178],[],{"_2861":58521,"_25133":58520,"_17569":98182,"_5":17464,"_23818":58520,"_2388":98183},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2861":58522,"_25133":58520,"_5":25466,"_17569":98185,"_23818":98186,"_2388":98187},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2861":58523,"_25133":58520,"_5":25466,"_17569":98189,"_23818":98190,"_2388":98191},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2861":58524,"_25133":58520,"_5":25466,"_17569":98193,"_23818":98194,"_2388":98195},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2861":58525,"_25133":58520,"_5":25466,"_17569":98197,"_23818":98198,"_2388":98199},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2861":58526,"_25133":58520,"_5":25466,"_17569":98201,"_23818":98202,"_2388":98203},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2861":58527,"_25133":58520,"_5":25466,"_17569":98205,"_23818":98206,"_2388":98207},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2861":58528,"_25133":58520,"_5":25466,"_17569":98209,"_23818":98210,"_2388":98211},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2861":58529,"_25133":58520,"_5":25466,"_17569":98213,"_23818":98214,"_2388":98215},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2861":58530,"_25133":58520,"_5":25466,"_17569":98217,"_23818":98218,"_2388":98219},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2861":58531,"_25133":58520,"_5":25466,"_17569":98221,"_23818":98222,"_2388":98223},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2861":58532,"_25133":58520,"_5":25466,"_17569":98225,"_23818":98226,"_2388":98227},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2861":58533,"_25133":58520,"_17569":98229,"_5":17464,"_23818":58520,"_2388":98230},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2861":58534,"_25133":58520,"_17569":98232,"_5":17464,"_23818":58520,"_2388":98233},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2861":58535,"_25133":58520,"_17569":98235,"_5":17464,"_23818":98186,"_2388":98236},[],"Vista operativa",{"_2861":58536,"_25133":58520,"_17569":98238,"_5":17464,"_23818":98186,"_2388":98239},[],"Interpretación",{"_2861":58537,"_25133":58520,"_17569":98241,"_5":17464,"_23818":98186,"_2388":43215},[],{"_2861":58538,"_25133":58520,"_17569":98243,"_5":17464,"_23818":98186,"_2388":98244},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2861":58539,"_25133":58520,"_17569":98246,"_5":17464,"_23818":98186,"_2388":43221},[],{"_2861":58540,"_25133":58520,"_17569":98248,"_5":17464,"_23818":98186,"_2388":98249},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2861":58541,"_25133":58520,"_17569":98251,"_5":17464,"_23818":98186,"_2388":43227},[],{"_2861":58542,"_25133":58520,"_17569":98253,"_5":17464,"_23818":98186,"_2388":98254},[],"La identidad está en la ventana operativa de renovación.",{"_2861":58543,"_25133":58520,"_17569":98256,"_5":17464,"_23818":98186,"_2388":43233},[],{"_2861":58544,"_25133":58520,"_17569":98258,"_5":17464,"_23818":98186,"_2388":98259},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2861":58545,"_25133":58520,"_17569":98261,"_5":17464,"_23818":98186,"_2388":43239},[],{"_2861":58546,"_25133":58520,"_17569":98263,"_5":17464,"_23818":98186,"_2388":98264},[],"La identidad ha vencido.",{"_2861":58547,"_25133":58520,"_17569":98266,"_5":17464,"_23818":98186,"_2388":43245},[],{"_2861":58548,"_25133":58520,"_17569":98268,"_5":17464,"_23818":98186,"_2388":98269},[],"La identidad está marcada como revocada.",{"_2861":58549,"_25133":58520,"_17569":98271,"_5":17464,"_23818":98186,"_2388":43251},[],{"_2861":58550,"_25133":58520,"_17569":98273,"_5":17464,"_23818":98186,"_2388":98274},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2861":58551,"_25133":58520,"_17569":98276,"_5":17464,"_23818":98186,"_2388":98277},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2861":58552,"_25133":58520,"_17569":98279,"_5":17464,"_23818":98190,"_2388":98280},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2861":58553,"_25133":58520,"_17569":98282,"_5":17464,"_23818":98190,"_2388":98283},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2861":58554,"_25133":58520,"_17569":98285,"_5":17464,"_23818":98190,"_2388":98286},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2861":58555,"_25133":58520,"_17569":98288,"_5":17464,"_23818":98190,"_2388":98289},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2861":58556,"_25133":58520,"_17569":98291,"_5":17464,"_23818":98194,"_2388":98292},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2861":58557,"_25133":58520,"_17569":98294,"_5":17464,"_23818":98198,"_2388":98295},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2861":58558,"_25133":58520,"_17569":98297,"_5":17464,"_23818":98202,"_2388":98298},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2861":58559,"_25133":58520,"_17569":98300,"_5":17464,"_23818":98206,"_2388":98301},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2861":58560,"_25133":58520,"_17569":98303,"_5":17464,"_23818":98210,"_2388":98304},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2861":58561,"_25133":58520,"_17569":98306,"_5":17464,"_23818":98210,"_2388":98307},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2861":58562,"_25133":58520,"_17569":98309,"_5":17464,"_23818":98214,"_2388":98310},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2861":58563,"_25133":58520,"_17569":98312,"_5":17464,"_23818":98214,"_2388":98313},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2861":58564,"_25133":58520,"_17569":98315,"_5":17464,"_23818":98214,"_2388":98316},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2861":58565,"_25133":58520,"_17569":98318,"_5":17464,"_23818":98214,"_2388":98319},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2861":58566,"_25133":58520,"_17569":98321,"_5":17464,"_23818":98214,"_2388":98322},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2861":58567,"_25133":58520,"_17569":98324,"_5":17464,"_23818":98214,"_2388":98325},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2861":58568,"_25133":58520,"_17569":98327,"_5":17464,"_23818":98218,"_2388":98328},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2861":58569,"_25133":58520,"_17569":98330,"_5":17464,"_23818":98218,"_2388":98331},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2861":58570,"_25133":58520,"_17569":98333,"_5":17464,"_23818":98222,"_2388":98334},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2861":58571,"_25133":58520,"_17569":98336,"_5":17464,"_23818":98222,"_2388":98337},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2861":58572,"_25133":58520,"_17569":98339,"_5":17464,"_23818":98222,"_2388":98340},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2861":58573,"_25133":58520,"_17569":98342,"_5":17464,"_23818":98222,"_2388":98343},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2861":58574,"_25133":58520,"_17569":98345,"_5":17464,"_23818":98226,"_2388":98346},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2861":58575,"_25133":58520,"_17569":98348,"_5":17464,"_23818":98226,"_2388":98349},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2861":58576,"_25133":58576,"_5":12309,"_2388":98351,"_25469":98352,"_17569":98354,"_23818":58576},"Identidad inicial y autenticación",[40834,97206,43152,98178,98353],"Enrolamiento con PKI",[],{"_2861":58577,"_25133":58576,"_17569":98356,"_5":17464,"_23818":58576,"_2388":98357},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2861":58578,"_25133":58576,"_5":25466,"_17569":98359,"_23818":98360,"_2388":98361},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2861":58579,"_25133":58576,"_5":25466,"_17569":98363,"_23818":98364,"_2388":98365},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2861":58580,"_25133":58576,"_5":25466,"_17569":98367,"_23818":98368,"_2388":98369},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2861":58581,"_25133":58576,"_5":25466,"_17569":98371,"_23818":98372,"_2388":98373},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2861":58582,"_25133":58576,"_5":25466,"_17569":98375,"_23818":98376,"_2388":98377},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2861":58583,"_25133":58576,"_17569":98379,"_5":17464,"_23818":58576,"_2388":98380},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2861":58584,"_25133":58576,"_17569":98382,"_5":17464,"_23818":98360,"_2388":98383},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2861":58585,"_25133":58576,"_17569":98385,"_5":17464,"_23818":98360,"_2388":98386},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2861":58586,"_25133":58576,"_17569":98388,"_5":17464,"_23818":98364,"_2388":98389},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2861":58587,"_25133":58576,"_17569":98391,"_5":17464,"_23818":98364,"_2388":98392},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2861":58588,"_25133":58576,"_17569":98394,"_5":17464,"_23818":98364,"_2388":98395},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2861":58589,"_25133":58576,"_17569":98397,"_5":17464,"_23818":98368,"_2388":98398},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2861":58590,"_25133":58576,"_17569":98400,"_5":17464,"_23818":98368,"_2388":98401},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2861":58591,"_25133":58576,"_17569":98403,"_5":17464,"_23818":98372,"_2388":98404},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2861":58592,"_25133":58576,"_17569":98406,"_5":17464,"_23818":98372,"_2388":98407},[],"Ejemplo de cuerpo:",{"_2861":58593,"_25133":58576,"_17569":98409,"_5":17464,"_23818":98372,"_2388":98410},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2861":58594,"_25133":58576,"_17569":98412,"_5":17464,"_23818":98372,"_2388":98413},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2861":58595,"_25133":58576,"_17569":98415,"_5":17464,"_23818":98372,"_2388":98416},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2861":58596,"_25133":58576,"_17569":98418,"_5":17464,"_23818":98372,"_2388":98419},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2861":58597,"_25133":58576,"_17569":98421,"_5":17464,"_23818":98376,"_2388":98422},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2861":58598,"_25133":58576,"_17569":98424,"_5":17464,"_23818":98376,"_2388":98425},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2861":58599,"_25133":58599,"_5":12309,"_2388":98427,"_25469":98428,"_17569":98429,"_23818":58599},"Configura y opera el DMS",[40834,97206,43152,98178,98353],[],{"_2861":58600,"_25133":58599,"_17569":98431,"_5":17464,"_23818":58599,"_2388":98432},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2861":58601,"_25133":58599,"_5":25466,"_17569":98434,"_23818":98435,"_2388":95907},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2861":58602,"_25133":58599,"_5":25466,"_17569":98437,"_23818":98438,"_2388":98439},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2861":58603,"_25133":58599,"_5":25466,"_17569":98441,"_23818":98442,"_2388":98443},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2861":58604,"_25133":58599,"_5":25466,"_17569":98445,"_23818":98446,"_2388":98447},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2861":58605,"_25133":58599,"_5":25466,"_17569":98449,"_23818":98450,"_2388":98451},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2861":58606,"_25133":58599,"_5":25466,"_17569":98453,"_23818":98454,"_2388":98455},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2861":58607,"_25133":58599,"_5":25466,"_17569":98457,"_23818":98458,"_2388":98459},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2861":58608,"_25133":58599,"_5":25466,"_17569":98461,"_23818":98462,"_2388":98463},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2861":58609,"_25133":58599,"_5":25466,"_17569":98465,"_23818":98466,"_2388":43447},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2861":58610,"_25133":58599,"_5":25466,"_17569":98468,"_23818":98469,"_2388":43451},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2861":58611,"_25133":58599,"_5":25466,"_17569":98471,"_23818":98472,"_2388":98473},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2861":58612,"_25133":58599,"_5":25466,"_17569":98475,"_23818":98476,"_2388":98477},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2861":58613,"_25133":58599,"_5":25466,"_17569":98479,"_23818":98480,"_2388":98481},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2861":58614,"_25133":58599,"_5":25466,"_17569":98483,"_23818":98484,"_2388":98485},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2861":58615,"_25133":58599,"_5":25466,"_17569":98487,"_23818":98488,"_2388":43471},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2861":58616,"_25133":58599,"_5":25466,"_17569":98490,"_23818":98491,"_2388":98492},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2861":58617,"_25133":58599,"_5":25466,"_17569":98494,"_23818":98495,"_2388":98496},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2861":58618,"_25133":58599,"_5":25466,"_17569":98498,"_23818":98499,"_2388":98500},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2861":58619,"_25133":58599,"_17569":98502,"_5":17464,"_23818":58599,"_2388":98503},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2861":58620,"_25133":58599,"_17569":98505,"_5":17464,"_23818":98435,"_2388":98506},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2861":58621,"_25133":58599,"_17569":98508,"_5":17464,"_23818":98435,"_2388":98509},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2861":58622,"_25133":58599,"_17569":98511,"_5":17464,"_23818":98442,"_2388":98512},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2861":58623,"_25133":58599,"_17569":98514,"_5":17464,"_23818":98446,"_2388":98515},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2861":58624,"_25133":58599,"_17569":98517,"_5":17464,"_23818":98450,"_2388":98518},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2861":58625,"_25133":58599,"_17569":98520,"_5":17464,"_23818":98454,"_2388":98521},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2861":58626,"_25133":58599,"_17569":98523,"_5":17464,"_23818":98458,"_2388":98524},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2861":58627,"_25133":58599,"_17569":98526,"_5":17464,"_23818":98466,"_2388":98527},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2861":58628,"_25133":58599,"_17569":98529,"_5":17464,"_23818":98466,"_2388":98530},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2861":58629,"_25133":58599,"_17569":98532,"_5":17464,"_23818":98469,"_2388":98533},[],"Campo de `settings.enrollment_settings`",{"_2861":58630,"_25133":58599,"_17569":98535,"_5":17464,"_23818":98469,"_2388":98536},[],"Decisión",{"_2861":58631,"_25133":58599,"_17569":98538,"_5":17464,"_23818":98469,"_2388":43522},[],{"_2861":58632,"_25133":58599,"_17569":98540,"_5":17464,"_23818":98469,"_2388":98541},[],"`EST_RFC7030` para estas operaciones.",{"_2861":58633,"_25133":58599,"_17569":98543,"_5":17464,"_23818":98469,"_2388":43528},[],{"_2861":58634,"_25133":58599,"_17569":98545,"_5":17464,"_23818":98469,"_2388":98546},[],"ID de la CA que firmará.",{"_2861":58635,"_25133":58599,"_17569":98548,"_5":17464,"_23818":98469,"_2388":43534},[],{"_2861":58636,"_25133":58599,"_17569":98550,"_5":17464,"_23818":98469,"_2388":98551},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2861":58637,"_25133":58599,"_17569":98553,"_5":17464,"_23818":98469,"_2388":43540},[],{"_2861":58638,"_25133":58599,"_17569":98555,"_5":17464,"_23818":98469,"_2388":98556},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2861":58639,"_25133":58599,"_17569":98558,"_5":17464,"_23818":98469,"_2388":43546},[],{"_2861":58640,"_25133":58599,"_17569":98560,"_5":17464,"_23818":98469,"_2388":98561},[],"Uno de los cuatro modos de autenticación.",{"_2861":58641,"_25133":58599,"_17569":98563,"_5":17464,"_23818":98469,"_2388":98564},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2861":58642,"_25133":58599,"_17569":98566,"_5":17464,"_23818":98472,"_2388":98567},[],"Los bloques son independientes:",{"_2861":58643,"_25133":58599,"_17569":98569,"_5":17464,"_23818":98472,"_2388":98570},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2861":58644,"_25133":58599,"_17569":98572,"_5":17464,"_23818":98472,"_2388":98573},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2861":58645,"_25133":58599,"_17569":98575,"_5":17464,"_23818":98472,"_2388":43564},[],{"_2861":58646,"_25133":58599,"_17569":98577,"_5":17464,"_23818":98472,"_2388":98578},[],"Control aplicado en la operación configurada",{"_2861":58647,"_25133":58599,"_17569":98580,"_5":17464,"_23818":98472,"_2388":43570},[],{"_2861":58648,"_25133":58599,"_17569":98582,"_5":17464,"_23818":98472,"_2388":98583},[],"Validación del certificado presentado.",{"_2861":58649,"_25133":58599,"_17569":98585,"_5":17464,"_23818":98472,"_2388":43576},[],{"_2861":58650,"_25133":58599,"_17569":98587,"_5":17464,"_23818":98472,"_2388":98588},[],"Autorización del webhook configurado.",{"_2861":58651,"_25133":58599,"_17569":98590,"_5":17464,"_23818":98472,"_2388":43582},[],{"_2861":58652,"_25133":58599,"_17569":98592,"_5":17464,"_23818":98472,"_2388":98593},[],"Validación del certificado y, después, aprobación del webhook.",{"_2861":58653,"_25133":58599,"_17569":98595,"_5":17464,"_23818":98472,"_2388":43588},[],{"_2861":58654,"_25133":58599,"_17569":98597,"_5":17464,"_23818":98472,"_2388":98598},[],"Sin autenticación del solicitante por el DMS.",{"_2861":58655,"_25133":58599,"_17569":98600,"_5":17464,"_23818":98472,"_2388":98601},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2861":58656,"_25133":58599,"_17569":98603,"_5":17464,"_23818":98472,"_2388":98604},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2861":58657,"_25133":58599,"_17569":98606,"_5":17464,"_23818":98472,"_2388":98607},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_2861":58658,"_25133":58599,"_17569":98609,"_5":17464,"_23818":98472,"_2388":98610},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2861":58659,"_25133":58599,"_17569":98612,"_5":17464,"_23818":98476,"_2388":98613},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2861":58660,"_25133":58599,"_17569":98615,"_5":17464,"_23818":98476,"_2388":98616},[],"Campo de `external_webhook_settings`",{"_2861":58661,"_25133":58599,"_17569":98618,"_5":17464,"_23818":98476,"_2388":98536},[],{"_2861":58662,"_25133":58599,"_17569":98620,"_5":17464,"_23818":98476,"_2388":43614},[],{"_2861":58663,"_25133":58599,"_17569":98622,"_5":17464,"_23818":98476,"_2388":98623},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2861":58664,"_25133":58599,"_17569":98625,"_5":17464,"_23818":98476,"_2388":43620},[],{"_2861":58665,"_25133":58599,"_17569":98627,"_5":17464,"_23818":98476,"_2388":98628},[],"`POST` o `PUT`; `POST` por defecto.",{"_2861":58666,"_25133":58599,"_17569":98630,"_5":17464,"_23818":98476,"_2388":43626},[],{"_2861":58667,"_25133":58599,"_17569":98632,"_5":17464,"_23818":98476,"_2388":98633},[],"Etiqueta usada en los logs del servicio.",{"_2861":58668,"_25133":58599,"_17569":98635,"_5":17464,"_23818":98476,"_2388":43632},[],{"_2861":58669,"_25133":58599,"_17569":98637,"_5":17464,"_23818":98476,"_2388":98638},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2861":58670,"_25133":58599,"_17569":98640,"_5":17464,"_23818":98476,"_2388":43638},[],{"_2861":58671,"_25133":58599,"_17569":98642,"_5":17464,"_23818":98476,"_2388":98643},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2861":58672,"_25133":58599,"_17569":98645,"_5":17464,"_23818":98476,"_2388":43644},[],{"_2861":58673,"_25133":58599,"_17569":98647,"_5":17464,"_23818":98476,"_2388":98648},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2861":58674,"_25133":58599,"_17569":98650,"_5":17464,"_23818":98476,"_2388":43650},[],{"_2861":58675,"_25133":58599,"_17569":98652,"_5":17464,"_23818":98476,"_2388":98653},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_2861":58676,"_25133":58599,"_17569":98655,"_5":17464,"_23818":98476,"_2388":43656},[],{"_2861":58677,"_25133":58599,"_17569":98657,"_5":17464,"_23818":98476,"_2388":98658},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2861":58678,"_25133":58599,"_17569":98660,"_5":17464,"_23818":98476,"_2388":43662},[],{"_2861":58679,"_25133":58599,"_17569":98662,"_5":17464,"_23818":98476,"_2388":98663},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2861":58680,"_25133":58599,"_17569":98665,"_5":17464,"_23818":98476,"_2388":98666},[],"Reglas de esa configuración:",{"_2861":58681,"_25133":58599,"_17569":98668,"_5":17464,"_23818":98476,"_2388":98669},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_2861":58682,"_25133":58599,"_17569":98671,"_5":17464,"_23818":98476,"_2388":98672},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2861":58683,"_25133":58599,"_17569":98674,"_5":17464,"_23818":98476,"_2388":98675},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2861":58684,"_25133":58599,"_17569":98677,"_5":17464,"_23818":98476,"_2388":98678},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_2861":58685,"_25133":58599,"_17569":98680,"_5":17464,"_23818":98476,"_2388":98681},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2861":58686,"_25133":58599,"_17569":98683,"_5":17464,"_23818":98476,"_2388":98684},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2861":58687,"_25133":58599,"_17569":98686,"_5":17464,"_23818":98476,"_2388":98687},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar, y si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2861":58688,"_25133":58599,"_17569":98689,"_5":17464,"_23818":98476,"_2388":98690},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando.",{"_2861":58689,"_25133":58599,"_17569":98692,"_5":17464,"_23818":98476,"_2388":98693},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_2861":58690,"_25133":58599,"_17569":98695,"_5":17464,"_23818":98480,"_2388":98696},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2861":58691,"_25133":58599,"_17569":98698,"_5":17464,"_23818":98484,"_2388":98699},[],"Campo de `settings.reenrollment_settings`",{"_2861":58692,"_25133":58599,"_17569":98701,"_5":17464,"_23818":98484,"_2388":98702},[],"Función",{"_2861":58693,"_25133":58599,"_17569":98704,"_5":17464,"_23818":98484,"_2388":43706},[],{"_2861":58694,"_25133":58599,"_17569":98706,"_5":17464,"_23818":98484,"_2388":98707},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2861":58695,"_25133":58599,"_17569":98709,"_5":17464,"_23818":98484,"_2388":43712},[],{"_2861":58696,"_25133":58599,"_17569":98711,"_5":17464,"_23818":98484,"_2388":98712},[],"Umbral operativo preventivo de monitorización.",{"_2861":58697,"_25133":58599,"_17569":98714,"_5":17464,"_23818":98484,"_2388":43718},[],{"_2861":58698,"_25133":58599,"_17569":98716,"_5":17464,"_23818":98484,"_2388":98717},[],"Umbral operativo crítico de monitorización.",{"_2861":58699,"_25133":58599,"_17569":98719,"_5":17464,"_23818":98484,"_2388":43724},[],{"_2861":58700,"_25133":58599,"_17569":98721,"_5":17464,"_23818":98484,"_2388":98722},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2861":58701,"_25133":58599,"_17569":98724,"_5":17464,"_23818":98484,"_2388":43730},[],{"_2861":58702,"_25133":58599,"_17569":98726,"_5":17464,"_23818":98484,"_2388":98727},[],"CAs de validación adicionales para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_2861":58703,"_25133":58599,"_17569":98729,"_5":17464,"_23818":98484,"_2388":43736},[],{"_2861":58704,"_25133":58599,"_17569":98731,"_5":17464,"_23818":98484,"_2388":98732},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2861":58705,"_25133":58599,"_17569":98734,"_5":17464,"_23818":98484,"_2388":98735},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2861":58706,"_25133":58599,"_17569":98737,"_5":17464,"_23818":98488,"_2388":98738},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2861":58707,"_25133":58599,"_17569":98740,"_5":17464,"_23818":98491,"_2388":96264},[],{"_2861":58708,"_25133":58599,"_17569":98742,"_5":17464,"_23818":98491,"_2388":98743},[],"Qué publica",{"_2861":58709,"_25133":58599,"_17569":98745,"_5":17464,"_23818":98491,"_2388":43753},[],{"_2861":58710,"_25133":58599,"_17569":98747,"_5":17464,"_23818":98491,"_2388":98748},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2861":58711,"_25133":58599,"_17569":98750,"_5":17464,"_23818":98491,"_2388":43759},[],{"_2861":58712,"_25133":58599,"_17569":98752,"_5":17464,"_23818":98491,"_2388":98753},[],"Certificado de la CA emisora seleccionada.",{"_2861":58713,"_25133":58599,"_17569":98755,"_5":17464,"_23818":98491,"_2388":43765},[],{"_2861":58714,"_25133":58599,"_17569":98757,"_5":17464,"_23818":98491,"_2388":98758},[],"Certificados de las CAs elegidas explícitamente.",{"_2861":58715,"_25133":58599,"_17569":98760,"_5":17464,"_23818":98491,"_2388":98761},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2861":58716,"_25133":58599,"_17569":98763,"_5":17464,"_23818":98495,"_2388":98764},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2861":58717,"_25133":58599,"_17569":98766,"_5":17464,"_23818":98495,"_2388":98767},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2861":58718,"_25133":58599,"_17569":98769,"_5":17464,"_23818":98495,"_2388":98770},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2861":58719,"_25133":58599,"_17569":98772,"_5":17464,"_23818":98499,"_2388":98773},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2861":58720,"_25133":58720,"_5":12309,"_2388":98775,"_25469":98776,"_17569":98777,"_23818":58720},"Integra el cliente EST",[40834,97206,43152,98178,98353],[],{"_2861":58721,"_25133":58720,"_17569":98779,"_5":17464,"_23818":58720,"_2388":98780},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2861":58722,"_25133":58720,"_5":25466,"_17569":98782,"_23818":98783,"_2388":95907},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2861":58723,"_25133":58720,"_5":25466,"_17569":98785,"_23818":98786,"_2388":98787},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2861":58724,"_25133":58720,"_5":25466,"_17569":98789,"_23818":98790,"_2388":98791},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2861":58725,"_25133":58720,"_5":25466,"_17569":98793,"_23818":98794,"_2388":98795},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2861":58726,"_25133":58720,"_5":25466,"_17569":98797,"_23818":98798,"_2388":98799},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2861":58727,"_25133":58720,"_5":25466,"_17569":98801,"_23818":98802,"_2388":98803},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2861":58728,"_25133":58720,"_17569":98805,"_5":17464,"_23818":58720,"_2388":98806},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2861":58729,"_25133":58720,"_17569":98808,"_5":17464,"_23818":98783,"_2388":98809},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2861":58730,"_25133":58720,"_17569":98811,"_5":17464,"_23818":98783,"_2388":98812},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2861":58731,"_25133":58720,"_17569":98814,"_5":17464,"_23818":98783,"_2388":98815},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2861":58732,"_25133":58720,"_17569":98817,"_5":17464,"_23818":98786,"_2388":98818},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2861":58733,"_25133":58720,"_17569":98820,"_5":17464,"_23818":98786,"_2388":98821},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2861":58734,"_25133":58720,"_17569":98823,"_5":17464,"_23818":98790,"_2388":98824},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2861":58735,"_25133":58720,"_17569":98826,"_5":17464,"_23818":98790,"_2388":98827},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2861":58736,"_25133":58720,"_17569":98829,"_5":17464,"_23818":98794,"_2388":98830},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2861":58737,"_25133":58720,"_17569":98832,"_5":17464,"_23818":98794,"_2388":98833},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2861":58738,"_25133":58720,"_17569":98835,"_5":17464,"_23818":98798,"_2388":98836},[],"Para el caso de una raíz que emite directamente:",{"_2861":58739,"_25133":58720,"_17569":98838,"_5":17464,"_23818":98798,"_2388":98839},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2861":58740,"_25133":58720,"_17569":98841,"_5":17464,"_23818":98798,"_2388":98842},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2861":58741,"_25133":58720,"_17569":98844,"_5":17464,"_23818":98802,"_2388":98845},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2861":58742,"_25133":58742,"_5":12309,"_2388":98847,"_25469":98848,"_17569":98849,"_23818":58742},"Referencia EST",[40834,97206,43152,98178,98353],[],{"_2861":58743,"_25133":58742,"_17569":98851,"_5":17464,"_23818":58742,"_2388":98852},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2861":58744,"_25133":58742,"_5":25466,"_17569":98854,"_23818":98855,"_2388":98856},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2861":58745,"_25133":58742,"_5":25466,"_17569":98858,"_23818":98859,"_2388":19079},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2861":58746,"_25133":58742,"_5":25466,"_17569":98861,"_23818":98862,"_2388":21841},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2861":58747,"_25133":58742,"_5":25466,"_17569":98864,"_23818":98865,"_2388":21848},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2861":58748,"_25133":58742,"_5":25466,"_17569":98867,"_23818":98868,"_2388":21218},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2861":58749,"_25133":58742,"_5":25466,"_17569":98870,"_23818":98871,"_2388":98872},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2861":58750,"_25133":58742,"_5":25466,"_17569":98874,"_23818":98875,"_2388":98876},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2861":58751,"_25133":58742,"_5":25466,"_17569":98878,"_23818":98879,"_2388":98880},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2861":58752,"_25133":58742,"_17569":98882,"_5":17464,"_23818":58742,"_2388":98883},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2861":58753,"_25133":58742,"_17569":98885,"_5":17464,"_23818":98855,"_2388":98886},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2861":58754,"_25133":58742,"_17569":98888,"_5":17464,"_23818":98855,"_2388":96997},[],{"_2861":58755,"_25133":58742,"_17569":98890,"_5":17464,"_23818":98855,"_2388":98891},[],"Método",{"_2861":58756,"_25133":58742,"_17569":98893,"_5":17464,"_23818":98855,"_2388":98894},[],"Autenticación y condición",{"_2861":58757,"_25133":58742,"_17569":98896,"_5":17464,"_23818":98855,"_2388":43908},[],{"_2861":58758,"_25133":58742,"_17569":98898,"_5":17464,"_23818":98855,"_2388":43911},[],{"_2861":58759,"_25133":58742,"_17569":98900,"_5":17464,"_23818":98855,"_2388":98901},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2861":58760,"_25133":58742,"_17569":98903,"_5":17464,"_23818":98855,"_2388":43917},[],{"_2861":58761,"_25133":58742,"_17569":98905,"_5":17464,"_23818":98855,"_2388":43920},[],{"_2861":58762,"_25133":58742,"_17569":98907,"_5":17464,"_23818":98855,"_2388":98908},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2861":58763,"_25133":58742,"_17569":98910,"_5":17464,"_23818":98855,"_2388":43926},[],{"_2861":58764,"_25133":58742,"_17569":98912,"_5":17464,"_23818":98855,"_2388":43920},[],{"_2861":58765,"_25133":58742,"_17569":98914,"_5":17464,"_23818":98855,"_2388":98915},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2861":58766,"_25133":58742,"_17569":98917,"_5":17464,"_23818":98855,"_2388":43934},[],{"_2861":58767,"_25133":58742,"_17569":98919,"_5":17464,"_23818":98855,"_2388":43920},[],{"_2861":58768,"_25133":58742,"_17569":98921,"_5":17464,"_23818":98855,"_2388":98922},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2861":58769,"_25133":58742,"_17569":98924,"_5":17464,"_23818":98855,"_2388":98925},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2861":58770,"_25133":58742,"_17569":98927,"_5":17464,"_23818":98859,"_2388":98928},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2861":58771,"_25133":58742,"_17569":98930,"_5":17464,"_23818":98859,"_2388":98931},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2861":58772,"_25133":58742,"_17569":98933,"_5":17464,"_23818":98862,"_2388":98934},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2861":58773,"_25133":58742,"_17569":98936,"_5":17464,"_23818":98862,"_2388":98937},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2861":58774,"_25133":58742,"_17569":98939,"_5":17464,"_23818":98865,"_2388":98940},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2861":58775,"_25133":58742,"_17569":98942,"_5":17464,"_23818":98865,"_2388":98943},[],"La CA de enrolamiento o una CA de validación configurada en el bloque de reenrolamiento valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2861":58776,"_25133":58742,"_17569":98945,"_5":17464,"_23818":98868,"_2388":98946},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2861":58777,"_25133":58742,"_17569":98948,"_5":17464,"_23818":98868,"_2388":98949},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2861":58778,"_25133":58742,"_17569":98951,"_5":17464,"_23818":98871,"_2388":98952},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2861":58779,"_25133":58742,"_17569":98954,"_5":17464,"_23818":98871,"_2388":98955},[],"Parte",{"_2861":58780,"_25133":58742,"_17569":98957,"_5":17464,"_23818":98871,"_2388":98958},[],"Contenido tras decodificar su Base64",{"_2861":58781,"_25133":58742,"_17569":98960,"_5":17464,"_23818":98871,"_2388":43978},[],{"_2861":58782,"_25133":58742,"_17569":98962,"_5":17464,"_23818":98871,"_2388":98963},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2861":58783,"_25133":58742,"_17569":98965,"_5":17464,"_23818":98871,"_2388":43984},[],{"_2861":58784,"_25133":58742,"_17569":98967,"_5":17464,"_23818":98871,"_2388":98968},[],"PKCS#7 DER con el certificado emitido.",{"_2861":58785,"_25133":58742,"_17569":98970,"_5":17464,"_23818":98871,"_2388":98971},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2861":58786,"_25133":58742,"_17569":98973,"_5":17464,"_23818":98875,"_2388":98974},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2861":58787,"_25133":58742,"_17569":98976,"_5":17464,"_23818":98875,"_2388":98977},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2861":58788,"_25133":58742,"_17569":98979,"_5":17464,"_23818":98875,"_2388":98980},[],"Convierte y comprueba el resultado:",{"_2861":58789,"_25133":58742,"_17569":98982,"_5":17464,"_23818":98875,"_2388":98983},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2861":58790,"_25133":58742,"_17569":98985,"_5":17464,"_23818":98879,"_2388":98986},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2861":58791,"_25133":58742,"_17569":98988,"_5":17464,"_23818":98879,"_2388":98989},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2861":58792,"_25133":58792,"_5":12309,"_2388":98353,"_25469":98991,"_17569":98992,"_23818":58792},[40834,97206,43152,98178,98353],[],{"_2861":58793,"_25133":58792,"_17569":98994,"_5":17464,"_23818":58792,"_2388":98995},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2861":58794,"_25133":58792,"_5":25466,"_17569":98997,"_23818":98998,"_2388":98999},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2861":58795,"_25133":58792,"_5":25466,"_17569":99001,"_23818":99002,"_2388":99003},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2861":58796,"_25133":58792,"_5":25466,"_17569":99005,"_23818":99006,"_2388":99007},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2861":58797,"_25133":58792,"_5":25466,"_17569":99009,"_23818":99010,"_2388":99011},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2861":58798,"_25133":58792,"_17569":99013,"_5":17464,"_23818":58792,"_2388":99014},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2861":58799,"_25133":58792,"_17569":99016,"_5":17464,"_23818":98998,"_2388":99017},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2861":58800,"_25133":58792,"_17569":99019,"_5":17464,"_23818":98998,"_2388":99020},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2861":58801,"_25133":58792,"_17569":99022,"_5":17464,"_23818":98998,"_2388":99023},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2861":58802,"_25133":58792,"_17569":99025,"_5":17464,"_23818":98998,"_2388":99026},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2861":58803,"_25133":58792,"_17569":99028,"_5":17464,"_23818":98998,"_2388":99029},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2861":58804,"_25133":58792,"_17569":99031,"_5":17464,"_23818":98998,"_2388":99032},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2861":58805,"_25133":58792,"_17569":99034,"_5":17464,"_23818":99002,"_2388":99035},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2861":58806,"_25133":58792,"_17569":99037,"_5":17464,"_23818":99002,"_2388":99038},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2861":58807,"_25133":58792,"_17569":99040,"_5":17464,"_23818":99002,"_2388":99041},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2861":58808,"_25133":58792,"_17569":99043,"_5":17464,"_23818":99002,"_2388":99044},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2861":58809,"_25133":58792,"_17569":99046,"_5":17464,"_23818":99006,"_2388":99047},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2861":58810,"_25133":58792,"_17569":99049,"_5":17464,"_23818":99006,"_2388":99050},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2861":58811,"_25133":58792,"_17569":99052,"_5":17464,"_23818":99006,"_2388":99053},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2861":58812,"_25133":58792,"_17569":99055,"_5":17464,"_23818":99006,"_2388":99056},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2861":58813,"_25133":58792,"_17569":99058,"_5":17464,"_23818":99010,"_2388":99059},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2861":58814,"_25133":58792,"_17569":99061,"_5":17464,"_23818":99010,"_2388":99062},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2861":58815,"_25133":58815,"_5":12309,"_2388":99064,"_25469":99065,"_17569":99066,"_23818":58815},"Estrategias de aprovisionamiento",[40834,97206,43152,98178,98353],[],{"_2861":58816,"_25133":58815,"_17569":99068,"_5":17464,"_23818":58815,"_2388":99069},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2861":58817,"_25133":58815,"_5":25466,"_17569":99071,"_23818":99072,"_2388":99073},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2861":58818,"_25133":58815,"_5":25466,"_17569":99075,"_23818":99076,"_2388":99077},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2861":58819,"_25133":58815,"_5":25466,"_17569":99079,"_23818":99080,"_2388":99081},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2861":58820,"_25133":58815,"_5":25466,"_17569":99083,"_23818":99084,"_2388":99085},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2861":58821,"_25133":58815,"_5":25466,"_17569":99087,"_23818":99088,"_2388":99089},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2861":58822,"_25133":58815,"_17569":99091,"_5":17464,"_23818":58815,"_2388":99092},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2861":58823,"_25133":58815,"_17569":99094,"_5":17464,"_23818":99072,"_2388":99095},[],"Recorrido",{"_2861":58824,"_25133":58815,"_17569":99097,"_5":17464,"_23818":99072,"_2388":99098},[],"Cuándo existe el dispositivo",{"_2861":58825,"_25133":58815,"_17569":99100,"_5":17464,"_23818":99072,"_2388":99101},[],"Qué compruebas",{"_2861":58826,"_25133":58815,"_17569":99103,"_5":17464,"_23818":99072,"_2388":99104},[],"Asignación manual",{"_2861":58827,"_25133":58815,"_17569":99106,"_5":17464,"_23818":99072,"_2388":99107},[],"El operador lo crea antes de asociar un certificado.",{"_2861":58828,"_25133":58815,"_17569":99109,"_5":17464,"_23818":99072,"_2388":99110},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2861":58829,"_25133":58815,"_17569":99112,"_5":17464,"_23818":99072,"_2388":99113},[],"EST con `JITP`",{"_2861":58830,"_25133":58815,"_17569":99115,"_5":17464,"_23818":99072,"_2388":99116},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2861":58831,"_25133":58815,"_17569":99118,"_5":17464,"_23818":99072,"_2388":99119},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2861":58832,"_25133":58815,"_17569":99121,"_5":17464,"_23818":99072,"_2388":99122},[],"EST con `PRE_REGISTRATION`",{"_2861":58833,"_25133":58815,"_17569":99124,"_5":17464,"_23818":99072,"_2388":99125},[],"Debe existir antes de `/simpleenroll`.",{"_2861":58834,"_25133":58815,"_17569":99127,"_5":17464,"_23818":99072,"_2388":99128},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2861":58835,"_25133":58815,"_17569":99130,"_5":17464,"_23818":99072,"_2388":99131},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2861":58836,"_25133":58815,"_17569":99133,"_5":17464,"_23818":99072,"_2388":99134},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2861":58837,"_25133":58815,"_17569":99136,"_5":17464,"_23818":99076,"_2388":99137},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2861":58838,"_25133":58815,"_17569":99139,"_5":17464,"_23818":99076,"_2388":99140},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2861":58839,"_25133":58815,"_17569":99142,"_5":17464,"_23818":99076,"_2388":99143},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2861":58840,"_25133":58815,"_17569":99145,"_5":17464,"_23818":99080,"_2388":99146},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2861":58841,"_25133":58815,"_17569":99148,"_5":17464,"_23818":99080,"_2388":99149},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2861":58842,"_25133":58815,"_17569":99151,"_5":17464,"_23818":99080,"_2388":99152},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2861":58843,"_25133":58815,"_17569":99154,"_5":17464,"_23818":99080,"_2388":99155},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2861":58844,"_25133":58815,"_17569":99157,"_5":17464,"_23818":99080,"_2388":99158},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2861":58845,"_25133":58815,"_17569":99160,"_5":17464,"_23818":99080,"_2388":99161},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2861":58846,"_25133":58815,"_17569":99163,"_5":17464,"_23818":99084,"_2388":96264},[],{"_2861":58847,"_25133":58815,"_17569":99165,"_5":17464,"_23818":99084,"_2388":99166},[],"Material que atraviesa EST",{"_2861":58848,"_25133":58815,"_17569":99168,"_5":17464,"_23818":99084,"_2388":99169},[],"Clave generada por el dispositivo",{"_2861":58849,"_25133":58815,"_17569":99171,"_5":17464,"_23818":99084,"_2388":99172},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2861":58850,"_25133":58815,"_17569":99174,"_5":17464,"_23818":99084,"_2388":99175},[],"Clave ya disponible en el dispositivo",{"_2861":58851,"_25133":58815,"_17569":99177,"_5":17464,"_23818":99084,"_2388":99178},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2861":58852,"_25133":58815,"_17569":99180,"_5":17464,"_23818":99084,"_2388":43471},[],{"_2861":58853,"_25133":58815,"_17569":99182,"_5":17464,"_23818":99084,"_2388":99183},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2861":58854,"_25133":58815,"_17569":99185,"_5":17464,"_23818":99084,"_2388":99186},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2861":58855,"_25133":58815,"_17569":99188,"_5":17464,"_23818":99088,"_2388":99189},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2861":58856,"_25133":58856,"_5":12309,"_2388":99191,"_25469":99192,"_17569":99193,"_23818":58856},"Renovación y recuperación",[40834,97206,43152,98178,98353],[],{"_2861":58857,"_25133":58856,"_17569":99195,"_5":17464,"_23818":58856,"_2388":99196},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2861":58858,"_25133":58856,"_5":25466,"_17569":99198,"_23818":99199,"_2388":99200},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2861":58859,"_25133":58856,"_5":25466,"_17569":99202,"_23818":99203,"_2388":99204},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2861":58860,"_25133":58856,"_5":25466,"_17569":99206,"_23818":99207,"_2388":99208},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2861":58861,"_25133":58856,"_5":25466,"_17569":99210,"_23818":99211,"_2388":99212},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2861":58862,"_25133":58856,"_5":25466,"_17569":99214,"_23818":99215,"_2388":99216},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2861":58863,"_25133":58856,"_17569":99218,"_5":17464,"_23818":58856,"_2388":99219},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2861":58864,"_25133":58856,"_17569":99221,"_5":17464,"_23818":99199,"_2388":99222},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2861":58865,"_25133":58856,"_17569":99224,"_5":17464,"_23818":99199,"_2388":99225},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2861":58866,"_25133":58856,"_17569":99227,"_5":17464,"_23818":99199,"_2388":99228},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2861":58867,"_25133":58856,"_17569":99230,"_5":17464,"_23818":99199,"_2388":99231},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2861":58868,"_25133":58856,"_17569":99233,"_5":17464,"_23818":99203,"_2388":99234},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2861":58869,"_25133":58856,"_17569":99236,"_5":17464,"_23818":99203,"_2388":99237},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2861":58870,"_25133":58856,"_17569":99239,"_5":17464,"_23818":99207,"_2388":99240},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2861":58871,"_25133":58856,"_17569":99242,"_5":17464,"_23818":99207,"_2388":99243},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2861":58872,"_25133":58856,"_17569":99245,"_5":17464,"_23818":99207,"_2388":99246},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2861":58873,"_25133":58856,"_17569":99248,"_5":17464,"_23818":99211,"_2388":99249},[],"Situación",{"_2861":58874,"_25133":58856,"_17569":99251,"_5":17464,"_23818":99211,"_2388":99252},[],"Procedimiento",{"_2861":58875,"_25133":58856,"_17569":99254,"_5":17464,"_23818":99211,"_2388":99255},[],"Certificado vigente, fuera de ventana",{"_2861":58876,"_25133":58856,"_17569":99257,"_5":17464,"_23818":99211,"_2388":99258},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2861":58877,"_25133":58856,"_17569":99260,"_5":17464,"_23818":99211,"_2388":99261},[],"Certificado vencido, clave disponible",{"_2861":58878,"_25133":58856,"_17569":99263,"_5":17464,"_23818":99211,"_2388":99264},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2861":58879,"_25133":58856,"_17569":99266,"_5":17464,"_23818":99211,"_2388":99267},[],"Renovación por webhook o `NO_AUTH`",{"_2861":58880,"_25133":58856,"_17569":99269,"_5":17464,"_23818":99211,"_2388":99270},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2861":58881,"_25133":58856,"_17569":99272,"_5":17464,"_23818":99211,"_2388":99273},[],"Clave perdida o inaccesible",{"_2861":58882,"_25133":58856,"_17569":99275,"_5":17464,"_23818":99211,"_2388":99276},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2861":58883,"_25133":58856,"_17569":99278,"_5":17464,"_23818":99211,"_2388":99279},[],"Identidad actual revocada",{"_2861":58884,"_25133":58856,"_17569":99281,"_5":17464,"_23818":99211,"_2388":99282},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2861":58885,"_25133":58856,"_17569":99284,"_5":17464,"_23818":99211,"_2388":99285},[],"Dispositivo sin identidad",{"_2861":58886,"_25133":58856,"_17569":99287,"_5":17464,"_23818":99211,"_2388":99288},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2861":58887,"_25133":58856,"_17569":99290,"_5":17464,"_23818":99211,"_2388":99291},[],"Dispositivo retirado",{"_2861":58888,"_25133":58856,"_17569":99293,"_5":17464,"_23818":99211,"_2388":99294},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2861":58889,"_25133":58856,"_17569":99296,"_5":17464,"_23818":99211,"_2388":99297},[],"Timeout, HTTP 500 o fallo de instalación",{"_2861":58890,"_25133":58856,"_17569":99299,"_5":17464,"_23818":99211,"_2388":99300},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2861":58891,"_25133":58856,"_17569":99302,"_5":17464,"_23818":99215,"_2388":99303},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2861":58892,"_25133":58856,"_17569":99305,"_5":17464,"_23818":99215,"_2388":99306},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2861":58893,"_25133":58893,"_5":12309,"_2388":99308,"_25469":99309,"_17569":99310,"_23818":58893},"Diagnóstico de enrolamiento",[40834,97206,43152,98178,98353],[],{"_2861":58894,"_25133":58893,"_17569":99312,"_5":17464,"_23818":58893,"_2388":99313},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2861":58895,"_25133":58893,"_5":25466,"_17569":99315,"_23818":99316,"_2388":99317},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2861":58896,"_25133":58893,"_5":25466,"_17569":99319,"_23818":99320,"_2388":99321},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2861":58897,"_25133":58893,"_5":25466,"_17569":99323,"_23818":99324,"_2388":98880},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2861":58898,"_25133":58893,"_5":25466,"_17569":99326,"_23818":99327,"_2388":99328},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2861":58899,"_25133":58893,"_17569":99330,"_5":17464,"_23818":58893,"_2388":99331},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2861":58900,"_25133":58893,"_17569":99333,"_5":17464,"_23818":99320,"_2388":99334},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2861":58901,"_25133":58893,"_17569":99336,"_5":17464,"_23818":99320,"_2388":99337},[],"Síntoma o mensaje",{"_2861":58902,"_25133":58893,"_17569":99339,"_5":17464,"_23818":99320,"_2388":99340},[],"Qué revisar",{"_2861":58903,"_25133":58893,"_17569":99342,"_5":17464,"_23818":99320,"_2388":99343},[],"curl rechaza TLS, nombre o emisor",{"_2861":58904,"_25133":58893,"_17569":99345,"_5":17464,"_23818":99320,"_2388":99346},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2861":58905,"_25133":58893,"_17569":99348,"_5":17464,"_23818":99320,"_2388":99349},[],"404 o APS ausente",{"_2861":58906,"_25133":58893,"_17569":99351,"_5":17464,"_23818":99320,"_2388":99352},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2861":58907,"_25133":58893,"_17569":99354,"_5":17464,"_23818":99320,"_2388":99355},[],"400, error de CSR o formato",{"_2861":58908,"_25133":58893,"_17569":99357,"_5":17464,"_23818":99320,"_2388":99358},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2861":58909,"_25133":58893,"_17569":99360,"_5":17464,"_23818":99320,"_2388":99361},[],"Credencial ausente o certificado no válido",{"_2861":58910,"_25133":58893,"_17569":99363,"_5":17464,"_23818":99320,"_2388":99364},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2861":58911,"_25133":58893,"_17569":99366,"_5":17464,"_23818":99320,"_2388":99367},[],"Webhook deniega, expira o responde sin autorización",{"_2861":58912,"_25133":58893,"_17569":99369,"_5":17464,"_23818":99320,"_2388":99370},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2861":58913,"_25133":58893,"_17569":99372,"_5":17464,"_23818":99320,"_2388":44391},[],{"_2861":58914,"_25133":58893,"_17569":99374,"_5":17464,"_23818":99320,"_2388":99375},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2861":58915,"_25133":58893,"_17569":99377,"_5":17464,"_23818":99320,"_2388":44397},[],{"_2861":58916,"_25133":58893,"_17569":99379,"_5":17464,"_23818":99320,"_2388":99380},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2861":58917,"_25133":58893,"_17569":99382,"_5":17464,"_23818":99320,"_2388":44403},[],{"_2861":58918,"_25133":58893,"_17569":99384,"_5":17464,"_23818":99320,"_2388":99385},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_2861":58919,"_25133":58893,"_17569":99387,"_5":17464,"_23818":99320,"_2388":44409},[],{"_2861":58920,"_25133":58893,"_17569":99389,"_5":17464,"_23818":99320,"_2388":99390},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_2861":58921,"_25133":58893,"_17569":99392,"_5":17464,"_23818":99320,"_2388":44415},[],{"_2861":58922,"_25133":58893,"_17569":99394,"_5":17464,"_23818":99320,"_2388":99395},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_2861":58923,"_25133":58893,"_17569":99397,"_5":17464,"_23818":99320,"_2388":99398},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2861":58924,"_25133":58893,"_17569":99400,"_5":17464,"_23818":99320,"_2388":99401},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2861":58925,"_25133":58893,"_17569":99403,"_5":17464,"_23818":99320,"_2388":99404},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2861":58926,"_25133":58893,"_17569":99406,"_5":17464,"_23818":99320,"_2388":99407},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2861":58927,"_25133":58893,"_17569":99409,"_5":17464,"_23818":99320,"_2388":44433},[],{"_2861":58928,"_25133":58893,"_17569":99411,"_5":17464,"_23818":99320,"_2388":99412},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2861":58929,"_25133":58893,"_17569":99414,"_5":17464,"_23818":99320,"_2388":44439},[],{"_2861":58930,"_25133":58893,"_17569":99416,"_5":17464,"_23818":99320,"_2388":99417},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2861":58931,"_25133":58893,"_17569":99419,"_5":17464,"_23818":99320,"_2388":99420},[],"DMS propietario distinto",{"_2861":58932,"_25133":58893,"_17569":99422,"_5":17464,"_23818":99320,"_2388":99423},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2861":58933,"_25133":58893,"_17569":99425,"_5":17464,"_23818":99320,"_2388":44451},[],{"_2861":58934,"_25133":58893,"_17569":99427,"_5":17464,"_23818":99320,"_2388":99428},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2861":58935,"_25133":58893,"_17569":99430,"_5":17464,"_23818":99320,"_2388":44457},[],{"_2861":58936,"_25133":58893,"_17569":99432,"_5":17464,"_23818":99320,"_2388":99433},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2861":58937,"_25133":58893,"_17569":99435,"_5":17464,"_23818":99320,"_2388":99436},[],"Certificado actual revocado",{"_2861":58938,"_25133":58893,"_17569":99438,"_5":17464,"_23818":99320,"_2388":99439},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2861":58939,"_25133":58893,"_17569":99441,"_5":17464,"_23818":99320,"_2388":99442},[],"Error de CA, perfil o firma",{"_2861":58940,"_25133":58893,"_17569":99444,"_5":17464,"_23818":99320,"_2388":99445},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2861":58941,"_25133":58893,"_17569":99447,"_5":17464,"_23818":99320,"_2388":99448},[],"HTTP 200 sin conexión del dispositivo",{"_2861":58942,"_25133":58893,"_17569":99450,"_5":17464,"_23818":99320,"_2388":99451},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2861":58943,"_25133":58893,"_17569":99453,"_5":17464,"_23818":99320,"_2388":99454},[],"Timeout o error después de emitir",{"_2861":58944,"_25133":58893,"_17569":99456,"_5":17464,"_23818":99320,"_2388":99457},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2861":58945,"_25133":58893,"_17569":99459,"_5":17464,"_23818":99324,"_2388":99460},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2861":58946,"_25133":58893,"_17569":99462,"_5":17464,"_23818":99324,"_2388":99463},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2861":58947,"_25133":58893,"_17569":99465,"_5":17464,"_23818":99327,"_2388":99466},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2861":58948,"_25133":58893,"_17569":99468,"_5":17464,"_23818":99327,"_2388":99469},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2861":58949,"_25133":58893,"_17569":99471,"_5":17464,"_23818":99327,"_2388":99472},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2861":58950,"_25133":58893,"_17569":99474,"_5":17464,"_23818":99327,"_2388":99475},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2861":58951,"_25133":58893,"_17569":99477,"_5":17464,"_23818":99327,"_2388":99478},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2861":58952,"_25133":58893,"_17569":99480,"_5":17464,"_23818":99327,"_2388":99481},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2861":58953,"_25133":58893,"_17569":99483,"_5":17464,"_23818":99327,"_2388":99484},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2861":58954,"_25133":58954,"_5":12309,"_2388":99486,"_25469":99487,"_17569":99488,"_23818":58954},"Distribución y actualización de confianza",[40834,97206,43152,98178,98353],[],{"_2861":58955,"_25133":58954,"_17569":99490,"_5":17464,"_23818":58954,"_2388":99491},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2861":58956,"_25133":58954,"_5":25466,"_17569":99493,"_23818":99494,"_2388":99495},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2861":58957,"_25133":58954,"_5":25466,"_17569":99497,"_23818":99498,"_2388":99499},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2861":58958,"_25133":58954,"_5":25466,"_17569":99501,"_23818":99502,"_2388":99503},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2861":58959,"_25133":58954,"_5":25466,"_17569":99505,"_23818":99506,"_2388":99507},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2861":58960,"_25133":58954,"_5":25466,"_17569":99509,"_23818":99510,"_2388":99511},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2861":58961,"_25133":58954,"_17569":99513,"_5":17464,"_23818":58954,"_2388":99514},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2861":58962,"_25133":58954,"_17569":99516,"_5":17464,"_23818":99494,"_2388":99517},[],"Relación",{"_2861":58963,"_25133":58954,"_17569":99519,"_5":17464,"_23818":99494,"_2388":99520},[],"Material que prepara el responsable",{"_2861":58964,"_25133":58954,"_17569":99522,"_5":17464,"_23818":99494,"_2388":99523},[],"Dispositivo → servidor EST",{"_2861":58965,"_25133":58954,"_17569":99525,"_5":17464,"_23818":99494,"_2388":99526},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2861":58966,"_25133":58954,"_17569":99528,"_5":17464,"_23818":99494,"_2388":99529},[],"DMS → solicitante",{"_2861":58967,"_25133":58954,"_17569":99531,"_5":17464,"_23818":99494,"_2388":99532},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2861":58968,"_25133":58954,"_17569":99534,"_5":17464,"_23818":99494,"_2388":99535},[],"Consumidor → dispositivo",{"_2861":58969,"_25133":58954,"_17569":99537,"_5":17464,"_23818":99494,"_2388":99538},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2861":58970,"_25133":58954,"_17569":99540,"_5":17464,"_23818":99494,"_2388":99541},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2861":58971,"_25133":58954,"_17569":99543,"_5":17464,"_23818":99498,"_2388":99544},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2861":58972,"_25133":58954,"_17569":99546,"_5":17464,"_23818":99498,"_2388":99547},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2861":58973,"_25133":58954,"_17569":99549,"_5":17464,"_23818":99502,"_2388":99550},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2861":58974,"_25133":58954,"_17569":99552,"_5":17464,"_23818":99502,"_2388":99553},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2861":58975,"_25133":58954,"_17569":99555,"_5":17464,"_23818":99502,"_2388":99556},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2861":58976,"_25133":58954,"_17569":99558,"_5":17464,"_23818":99502,"_2388":99559},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2861":58977,"_25133":58954,"_17569":99561,"_5":17464,"_23818":99502,"_2388":99562},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2861":58978,"_25133":58954,"_17569":99564,"_5":17464,"_23818":99502,"_2388":99565},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2861":58979,"_25133":58954,"_17569":99567,"_5":17464,"_23818":99506,"_2388":99568},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2861":58980,"_25133":58954,"_17569":99570,"_5":17464,"_23818":99506,"_2388":99571},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Al cambiar la CA de enrolamiento, añade a esa lista la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2861":58981,"_25133":58954,"_17569":99573,"_5":17464,"_23818":99506,"_2388":99574},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2861":58982,"_25133":58954,"_17569":99576,"_5":17464,"_23818":99510,"_2388":99577},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2861":58983,"_25133":58983,"_5":12309,"_2388":44606,"_25469":99579,"_17569":99581,"_23818":58983},[40834,97206,43152,98178,99580],"Integraciones",[],{"_2861":58984,"_25133":58983,"_17569":99583,"_5":17464,"_23818":58983,"_2388":99584},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2861":58985,"_25133":58983,"_5":25466,"_17569":99586,"_23818":99587,"_2388":99588},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2861":58986,"_25133":58983,"_5":25466,"_17569":99590,"_23818":99591,"_2388":99592},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2861":58987,"_25133":58983,"_5":25466,"_17569":99594,"_23818":99595,"_2388":99596},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2861":58988,"_25133":58983,"_5":25466,"_17569":99598,"_23818":99599,"_2388":99600},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2861":58989,"_25133":58983,"_5":25466,"_17569":99602,"_23818":99603,"_2388":99604},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2861":58990,"_25133":58983,"_5":25466,"_17569":99606,"_23818":99607,"_2388":99608},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2861":58991,"_25133":58983,"_5":25466,"_17569":99610,"_23818":99611,"_2388":44640},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2861":58992,"_25133":58983,"_5":25466,"_17569":99613,"_23818":99614,"_2388":44644},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2861":58993,"_25133":58983,"_5":25466,"_17569":99616,"_23818":99617,"_2388":99618},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2861":58994,"_25133":58983,"_5":25466,"_17569":99620,"_23818":99621,"_2388":99622},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2861":58995,"_25133":58983,"_5":25466,"_17569":99624,"_23818":99625,"_2388":99626},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2861":58996,"_25133":58983,"_5":25466,"_17569":99628,"_23818":99629,"_2388":99630},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2861":58997,"_25133":58983,"_5":25466,"_17569":99632,"_23818":99633,"_2388":99634},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2861":58998,"_25133":58983,"_5":25466,"_17569":99636,"_23818":99637,"_2388":99638},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2861":58999,"_25133":58983,"_5":25466,"_17569":99640,"_23818":99641,"_2388":99642},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2861":59000,"_25133":58983,"_5":25466,"_17569":99644,"_23818":99645,"_2388":99646},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2861":59001,"_25133":58983,"_5":25466,"_17569":99648,"_23818":99649,"_2388":99650},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2861":59002,"_25133":58983,"_5":25466,"_17569":99652,"_23818":99653,"_2388":99654},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2861":59003,"_25133":58983,"_5":25466,"_17569":99656,"_23818":99657,"_2388":99658},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2861":59004,"_25133":58983,"_5":25466,"_17569":99660,"_23818":99661,"_2388":99662},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2861":59005,"_25133":58983,"_17569":99664,"_5":17464,"_23818":58983,"_2388":99665},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2861":59006,"_25133":58983,"_17569":99667,"_5":17464,"_23818":58983,"_2388":99668},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2861":59007,"_25133":58983,"_17569":99670,"_5":17464,"_23818":58983,"_2388":99671},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2861":59008,"_25133":58983,"_17569":99673,"_5":17464,"_23818":99587,"_2388":99674},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2861":59009,"_25133":58983,"_17569":99676,"_5":17464,"_23818":99587,"_2388":99677},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2861":59010,"_25133":58983,"_17569":99679,"_5":17464,"_23818":99587,"_2388":99680},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2861":59011,"_25133":58983,"_17569":99682,"_5":17464,"_23818":99587,"_2388":99683},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2861":59012,"_25133":58983,"_17569":99685,"_5":17464,"_23818":99591,"_2388":99686},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2861":59013,"_25133":58983,"_17569":99688,"_5":17464,"_23818":99595,"_2388":99689},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2861":59014,"_25133":58983,"_17569":99691,"_5":17464,"_23818":99595,"_2388":99692},[],"Acción IAM",{"_2861":59015,"_25133":58983,"_17569":99694,"_5":17464,"_23818":99595,"_2388":96270},[],{"_2861":59016,"_25133":58983,"_17569":99696,"_5":17464,"_23818":99595,"_2388":44727},[],{"_2861":59017,"_25133":58983,"_17569":99698,"_5":17464,"_23818":99595,"_2388":99699},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2861":59018,"_25133":58983,"_17569":99701,"_5":17464,"_23818":99595,"_2388":44733},[],{"_2861":59019,"_25133":58983,"_17569":99703,"_5":17464,"_23818":99595,"_2388":99704},[],"Registrar la CA en AWS IoT",{"_2861":59020,"_25133":58983,"_17569":99706,"_5":17464,"_23818":99595,"_2388":44739},[],{"_2861":59021,"_25133":58983,"_17569":99708,"_5":17464,"_23818":99595,"_2388":99709},[],"Consultar el estado del registro de la CA",{"_2861":59022,"_25133":58983,"_17569":99711,"_5":17464,"_23818":99595,"_2388":44745},[],{"_2861":59023,"_25133":58983,"_17569":99713,"_5":17464,"_23818":99595,"_2388":99714},[],"Crear o actualizar Things en IoT Core",{"_2861":59024,"_25133":58983,"_17569":99716,"_5":17464,"_23818":99595,"_2388":44751},[],{"_2861":59025,"_25133":58983,"_17569":99718,"_5":17464,"_23818":99595,"_2388":99719},[],"Aprovisionar Things mediante plantilla",{"_2861":59026,"_25133":58983,"_17569":99721,"_5":17464,"_23818":99595,"_2388":44757},[],{"_2861":59027,"_25133":58983,"_17569":99723,"_5":17464,"_23818":99595,"_2388":99724},[],"Registrar certificados de dispositivo",{"_2861":59028,"_25133":58983,"_17569":99726,"_5":17464,"_23818":99595,"_2388":44763},[],{"_2861":59029,"_25133":58983,"_17569":99728,"_5":17464,"_23818":99595,"_2388":99729},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2861":59030,"_25133":58983,"_17569":99731,"_5":17464,"_23818":99595,"_2388":44769},[],{"_2861":59031,"_25133":58983,"_17569":99733,"_5":17464,"_23818":99595,"_2388":99734},[],"Crear y adjuntar políticas IoT",{"_2861":59032,"_25133":58983,"_17569":99736,"_5":17464,"_23818":99595,"_2388":44775},[],{"_2861":59033,"_25133":58983,"_17569":99738,"_5":17464,"_23818":99595,"_2388":99739},[],"Gestionar grupos de Things",{"_2861":59034,"_25133":58983,"_17569":99741,"_5":17464,"_23818":99595,"_2388":44781},[],{"_2861":59035,"_25133":58983,"_17569":99743,"_5":17464,"_23818":99595,"_2388":99744},[],"Crear plantillas JITP",{"_2861":59036,"_25133":58983,"_17569":99746,"_5":17464,"_23818":99595,"_2388":44787},[],{"_2861":59037,"_25133":58983,"_17569":99748,"_5":17464,"_23818":99595,"_2388":99749},[],"Leer y escribir el Device Shadow",{"_2861":59038,"_25133":58983,"_17569":99751,"_5":17464,"_23818":99595,"_2388":99752},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2861":59039,"_25133":58983,"_17569":99754,"_5":17464,"_23818":99599,"_2388":99755},[],"Parámetro",{"_2861":59040,"_25133":58983,"_17569":99757,"_5":17464,"_23818":99599,"_2388":99758},[],"Tipo",{"_2861":59041,"_25133":58983,"_17569":99760,"_5":17464,"_23818":99599,"_2388":99761},[],"Requerido",{"_2861":59042,"_25133":58983,"_17569":99763,"_5":17464,"_23818":99599,"_2388":99764},[],"Descripción",{"_2861":59043,"_25133":58983,"_17569":99766,"_5":17464,"_23818":99599,"_2388":44808},[],{"_2861":59044,"_25133":58983,"_17569":99768,"_5":17464,"_23818":99599,"_2388":20962},[],{"_2861":59045,"_25133":58983,"_17569":99770,"_5":17464,"_23818":99599,"_2388":99771},[],"Sí",{"_2861":59046,"_25133":58983,"_17569":99773,"_5":17464,"_23818":99599,"_2388":99774},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2861":59047,"_25133":58983,"_17569":99776,"_5":17464,"_23818":99599,"_2388":44819},[],{"_2861":59048,"_25133":58983,"_17569":99778,"_5":17464,"_23818":99599,"_2388":20962},[],{"_2861":59049,"_25133":58983,"_17569":99780,"_5":17464,"_23818":99599,"_2388":99771},[],{"_2861":59050,"_25133":58983,"_17569":99782,"_5":17464,"_23818":99599,"_2388":99783},[],"Región AWS donde opera el conector.",{"_2861":59051,"_25133":58983,"_17569":99785,"_5":17464,"_23818":99599,"_2388":44829},[],{"_2861":59052,"_25133":58983,"_17569":99787,"_5":17464,"_23818":99599,"_2388":20962},[],{"_2861":59053,"_25133":58983,"_17569":99789,"_5":17464,"_23818":99599,"_2388":99771},[],{"_2861":59054,"_25133":58983,"_17569":99791,"_5":17464,"_23818":99599,"_2388":99792},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2861":59055,"_25133":58983,"_17569":99794,"_5":17464,"_23818":99599,"_2388":44839},[],{"_2861":59056,"_25133":58983,"_17569":99796,"_5":17464,"_23818":99599,"_2388":20962},[],{"_2861":59057,"_25133":58983,"_17569":99798,"_5":17464,"_23818":99599,"_2388":99799},[],"Solo con `auth_method=static`",{"_2861":59058,"_25133":58983,"_17569":99801,"_5":17464,"_23818":99599,"_2388":99802},[],"Clave de acceso AWS.",{"_2861":59059,"_25133":58983,"_17569":99804,"_5":17464,"_23818":99599,"_2388":44850},[],{"_2861":59060,"_25133":58983,"_17569":99806,"_5":17464,"_23818":99599,"_2388":20962},[],{"_2861":59061,"_25133":58983,"_17569":99808,"_5":17464,"_23818":99599,"_2388":99799},[],{"_2861":59062,"_25133":58983,"_17569":99810,"_5":17464,"_23818":99599,"_2388":99811},[],"Clave secreta AWS.",{"_2861":59063,"_25133":58983,"_17569":99813,"_5":17464,"_23818":99599,"_2388":44860},[],{"_2861":59064,"_25133":58983,"_17569":99815,"_5":17464,"_23818":99599,"_2388":20962},[],{"_2861":59065,"_25133":58983,"_17569":99817,"_5":17464,"_23818":99599,"_2388":44865},[],{"_2861":59066,"_25133":58983,"_17569":99819,"_5":17464,"_23818":99599,"_2388":99820},[],"Token de sesión (con `auth_method=static`).",{"_2861":59067,"_25133":58983,"_17569":99822,"_5":17464,"_23818":99599,"_2388":44871},[],{"_2861":59068,"_25133":58983,"_17569":99824,"_5":17464,"_23818":99599,"_2388":20962},[],{"_2861":59069,"_25133":58983,"_17569":99826,"_5":17464,"_23818":99599,"_2388":99827},[],"Solo con `auth_method=role`",{"_2861":59070,"_25133":58983,"_17569":99829,"_5":17464,"_23818":99599,"_2388":99830},[],"ARN del rol a asumir.",{"_2861":59071,"_25133":58983,"_17569":99832,"_5":17464,"_23818":99599,"_2388":44882},[],{"_2861":59072,"_25133":58983,"_17569":99834,"_5":17464,"_23818":99599,"_2388":20962},[],{"_2861":59073,"_25133":58983,"_17569":99836,"_5":17464,"_23818":99599,"_2388":44865},[],{"_2861":59074,"_25133":58983,"_17569":99838,"_5":17464,"_23818":99599,"_2388":99839},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2861":59075,"_25133":58983,"_17569":99841,"_5":17464,"_23818":99599,"_2388":44892},[],{"_2861":59076,"_25133":58983,"_17569":99843,"_5":17464,"_23818":99599,"_2388":14723},[],{"_2861":59077,"_25133":58983,"_17569":99845,"_5":17464,"_23818":99599,"_2388":99771},[],{"_2861":59078,"_25133":58983,"_17569":99847,"_5":17464,"_23818":99599,"_2388":99848},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2861":59079,"_25133":58983,"_17569":99850,"_5":17464,"_23818":99599,"_2388":44902},[],{"_2861":59080,"_25133":58983,"_17569":99852,"_5":17464,"_23818":99599,"_2388":20962},[],{"_2861":59081,"_25133":58983,"_17569":99854,"_5":17464,"_23818":99599,"_2388":99771},[],{"_2861":59082,"_25133":58983,"_17569":99856,"_5":17464,"_23818":99599,"_2388":99857},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2861":59083,"_25133":58983,"_17569":99859,"_5":17464,"_23818":99599,"_2388":44912},[],{"_2861":59084,"_25133":58983,"_17569":99861,"_5":17464,"_23818":99599,"_2388":20962},[],{"_2861":59085,"_25133":58983,"_17569":99863,"_5":17464,"_23818":99599,"_2388":99771},[],{"_2861":59086,"_25133":58983,"_17569":99865,"_5":17464,"_23818":99599,"_2388":99866},[],"URL HTTP del Device Manager de Lamassu.",{"_2861":59087,"_25133":58983,"_17569":99868,"_5":17464,"_23818":99599,"_2388":44922},[],{"_2861":59088,"_25133":58983,"_17569":99870,"_5":17464,"_23818":99599,"_2388":20962},[],{"_2861":59089,"_25133":58983,"_17569":99872,"_5":17464,"_23818":99599,"_2388":99771},[],{"_2861":59090,"_25133":58983,"_17569":99874,"_5":17464,"_23818":99599,"_2388":99875},[],"URL HTTP del servicio de CA de Lamassu.",{"_2861":59091,"_25133":58983,"_17569":99877,"_5":17464,"_23818":99603,"_2388":99878},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2861":59092,"_25133":58983,"_17569":99880,"_5":17464,"_23818":99607,"_2388":99881},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2861":59093,"_25133":58983,"_17569":99883,"_5":17464,"_23818":99607,"_2388":99884},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2861":59094,"_25133":58983,"_17569":99886,"_5":17464,"_23818":99611,"_2388":99887},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2861":59095,"_25133":58983,"_17569":99889,"_5":17464,"_23818":99611,"_2388":99890},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2861":59096,"_25133":58983,"_17569":99892,"_5":17464,"_23818":99611,"_2388":99893},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2861":59097,"_25133":58983,"_17569":99895,"_5":17464,"_23818":99611,"_2388":99896},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2861":59098,"_25133":58983,"_17569":99898,"_5":17464,"_23818":99611,"_2388":99899},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2861":59099,"_25133":58983,"_17569":99901,"_5":17464,"_23818":99611,"_2388":99902},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2861":59100,"_25133":58983,"_17569":99904,"_5":17464,"_23818":99614,"_2388":99905},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2861":59101,"_25133":58983,"_17569":99907,"_5":17464,"_23818":99617,"_2388":99908},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2861":59102,"_25133":58983,"_17569":99910,"_5":17464,"_23818":99617,"_2388":99911},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2861":59103,"_25133":58983,"_17569":99913,"_5":17464,"_23818":99621,"_2388":99914},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2861":59104,"_25133":58983,"_17569":99916,"_5":17464,"_23818":99625,"_2388":99917},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2861":59105,"_25133":58983,"_17569":99919,"_5":17464,"_23818":99625,"_2388":99920},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2861":59106,"_25133":58983,"_17569":99922,"_5":17464,"_23818":99625,"_2388":99923},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2861":59107,"_25133":58983,"_17569":99925,"_5":17464,"_23818":99625,"_2388":99926},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2861":59108,"_25133":58983,"_17569":99928,"_5":17464,"_23818":99625,"_2388":99929},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2861":59109,"_25133":58983,"_17569":99931,"_5":17464,"_23818":99625,"_2388":99932},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2861":59110,"_25133":58983,"_17569":99934,"_5":17464,"_23818":99629,"_2388":99935},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2861":59111,"_25133":58983,"_17569":99937,"_5":17464,"_23818":99629,"_2388":99938},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2861":59112,"_25133":58983,"_17569":99940,"_5":17464,"_23818":99629,"_2388":99941},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2861":59113,"_25133":58983,"_17569":99943,"_5":17464,"_23818":99633,"_2388":99944},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2861":59114,"_25133":58983,"_17569":99946,"_5":17464,"_23818":99633,"_2388":99947},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2861":59115,"_25133":58983,"_17569":99949,"_5":17464,"_23818":99633,"_2388":99950},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2861":59116,"_25133":58983,"_17569":99952,"_5":17464,"_23818":99637,"_2388":99953},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2861":59117,"_25133":58983,"_17569":99955,"_5":17464,"_23818":99637,"_2388":99956},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2861":59118,"_25133":58983,"_17569":99958,"_5":17464,"_23818":99637,"_2388":99959},[],"Para que el flujo JITP funcione correctamente:",{"_2861":59119,"_25133":58983,"_17569":99961,"_5":17464,"_23818":99637,"_2388":99962},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2861":59120,"_25133":58983,"_17569":99964,"_5":17464,"_23818":99637,"_2388":99965},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2861":59121,"_25133":58983,"_17569":99967,"_5":17464,"_23818":99637,"_2388":99968},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2861":59122,"_25133":58983,"_17569":99970,"_5":17464,"_23818":99637,"_2388":99971},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2861":59123,"_25133":58983,"_17569":99973,"_5":17464,"_23818":99641,"_2388":99974},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2861":59124,"_25133":58983,"_17569":99976,"_5":17464,"_23818":99641,"_2388":99977},[],"Estado en Lamassu",{"_2861":59125,"_25133":58983,"_17569":99979,"_5":17464,"_23818":99641,"_2388":99980},[],"Razón de revocación",{"_2861":59126,"_25133":58983,"_17569":99982,"_5":17464,"_23818":99641,"_2388":99983},[],"Estado en AWS IoT Core",{"_2861":59127,"_25133":58983,"_17569":99985,"_5":17464,"_23818":99641,"_2388":45043},[],{"_2861":59128,"_25133":58983,"_17569":99987,"_5":17464,"_23818":99641,"_2388":99988},[],"Ninguna",{"_2861":59129,"_25133":58983,"_17569":99990,"_5":17464,"_23818":99641,"_2388":45049},[],{"_2861":59130,"_25133":58983,"_17569":99992,"_5":17464,"_23818":99641,"_2388":45052},[],{"_2861":59131,"_25133":58983,"_17569":99994,"_5":17464,"_23818":99641,"_2388":45055},[],{"_2861":59132,"_25133":58983,"_17569":99996,"_5":17464,"_23818":99641,"_2388":45058},[],{"_2861":59133,"_25133":58983,"_17569":99998,"_5":17464,"_23818":99641,"_2388":45052},[],{"_2861":59134,"_25133":58983,"_17569":100000,"_5":17464,"_23818":99641,"_2388":100001},[],"Cualquier otra razón",{"_2861":59135,"_25133":58983,"_17569":100003,"_5":17464,"_23818":99641,"_2388":45066},[],{"_2861":59136,"_25133":58983,"_17569":100005,"_5":17464,"_23818":99641,"_2388":100006},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2861":59137,"_25133":58983,"_17569":100008,"_5":17464,"_23818":99645,"_2388":100009},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2861":59138,"_25133":58983,"_17569":100011,"_5":17464,"_23818":99645,"_2388":100012},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2861":59139,"_25133":58983,"_17569":100014,"_5":17464,"_23818":99645,"_2388":100015},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2861":59140,"_25133":58983,"_17569":100017,"_5":17464,"_23818":99649,"_2388":100018},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2861":59141,"_25133":58983,"_17569":100020,"_5":17464,"_23818":99649,"_2388":100021},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2861":59142,"_25133":58983,"_17569":100023,"_5":17464,"_23818":99653,"_2388":100024},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2861":59143,"_25133":58983,"_17569":100026,"_5":17464,"_23818":99653,"_2388":100027},[],"Existen dos tipos de acciones:",{"_2861":59144,"_25133":58983,"_17569":100029,"_5":17464,"_23818":99653,"_2388":100030},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2861":59145,"_25133":58983,"_17569":100032,"_5":17464,"_23818":99653,"_2388":100033},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2861":59146,"_25133":58983,"_17569":100035,"_5":17464,"_23818":99653,"_2388":100036},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2861":59147,"_25133":58983,"_17569":100038,"_5":17464,"_23818":99657,"_2388":100039},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2861":59148,"_25133":58983,"_17569":100041,"_5":17464,"_23818":99657,"_2388":100042},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2861":59149,"_25133":58983,"_17569":100044,"_5":17464,"_23818":99657,"_2388":100045},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2861":59150,"_25133":58983,"_17569":100047,"_5":17464,"_23818":99661,"_2388":100048},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2861":59151,"_25133":58983,"_17569":100050,"_5":17464,"_23818":99661,"_2388":100051},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2861":59152,"_25133":58983,"_17569":100053,"_5":17464,"_23818":99661,"_2388":100054},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2861":59153,"_25133":58983,"_17569":100056,"_5":17464,"_23818":99661,"_2388":100057},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2861":59154,"_25133":58983,"_17569":100059,"_5":17464,"_23818":99661,"_2388":100060},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2861":59155,"_25133":58983,"_17569":100062,"_5":17464,"_23818":99661,"_2388":100063},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2861":59156,"_25133":58983,"_17569":100065,"_5":17464,"_23818":99661,"_2388":100066},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2861":59157,"_25133":58983,"_17569":100068,"_5":17464,"_23818":99661,"_2388":100069},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2861":59158,"_25133":58983,"_17569":100071,"_5":17464,"_23818":99661,"_2388":100072},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2861":59159,"_25133":58983,"_17569":100074,"_5":17464,"_23818":99661,"_2388":100075},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2861":59160,"_25133":58983,"_17569":100077,"_5":17464,"_23818":99661,"_2388":100078},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2861":59161,"_25133":58983,"_17569":100080,"_5":17464,"_23818":99661,"_2388":100081},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2861":59162,"_25133":58983,"_17569":100083,"_5":17464,"_23818":99661,"_2388":100084},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2861":59163,"_25133":58983,"_17569":100086,"_5":17464,"_23818":99661,"_2388":100087},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2861":59164,"_25133":58983,"_17569":100089,"_5":17464,"_23818":99661,"_2388":100090},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2861":59165,"_25133":58983,"_17569":100092,"_5":17464,"_23818":99661,"_2388":100093},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2861":59166,"_25133":58983,"_17569":100095,"_5":17464,"_23818":99661,"_2388":100096},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2861":59167,"_25133":58983,"_17569":100098,"_5":17464,"_23818":99661,"_2388":100099},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2861":59168,"_25133":58983,"_17569":100101,"_5":17464,"_23818":99661,"_2388":100102},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2861":59169,"_25133":58983,"_17569":100104,"_5":17464,"_23818":99661,"_2388":100105},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2861":59170,"_25133":58983,"_17569":100107,"_5":17464,"_23818":99661,"_2388":100108},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2861":59171,"_25133":59171,"_5":12309,"_2388":43152,"_25469":100110,"_17569":100111,"_23818":59171},[40834,97206,43152],[],{"_2861":59172,"_25133":59171,"_17569":100113,"_5":17464,"_23818":59171,"_2388":100114},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2861":59173,"_25133":59171,"_5":25466,"_17569":100116,"_23818":100117,"_2388":100118},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2861":59174,"_25133":59171,"_5":25466,"_17569":100120,"_23818":100121,"_2388":98178},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2861":59175,"_25133":59171,"_5":25466,"_17569":100123,"_23818":100124,"_2388":98353},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2861":59176,"_25133":59171,"_5":25466,"_17569":100126,"_23818":100127,"_2388":99580},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/overview#integraciones",{"_2861":59177,"_25133":59171,"_5":25466,"_17569":100129,"_23818":100130,"_2388":100131},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2861":59178,"_25133":59171,"_17569":100133,"_5":17464,"_23818":59171,"_2388":100134},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2861":59179,"_25133":59171,"_17569":100136,"_5":17464,"_23818":100117,"_2388":100137},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2861":59180,"_25133":59171,"_17569":100139,"_5":17464,"_23818":100117,"_2388":100140},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2861":59181,"_25133":59171,"_17569":100142,"_5":17464,"_23818":100121,"_2388":100143},[],"Recurso",{"_2861":59182,"_25133":59171,"_17569":100145,"_5":17464,"_23818":100121,"_2388":100146},[],"Qué representa",{"_2861":59183,"_25133":59171,"_17569":100148,"_5":17464,"_23818":100121,"_2388":100149},[],"**Dispositivo**",{"_2861":59184,"_25133":59171,"_17569":100151,"_5":17464,"_23818":100121,"_2388":100152},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2861":59185,"_25133":59171,"_17569":100154,"_5":17464,"_23818":100121,"_2388":100155},[],"**Identidad**",{"_2861":59186,"_25133":59171,"_17569":100157,"_5":17464,"_23818":100121,"_2388":100158},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2861":59187,"_25133":59171,"_17569":100160,"_5":17464,"_23818":100121,"_2388":45224},[],{"_2861":59188,"_25133":59171,"_17569":100162,"_5":17464,"_23818":100121,"_2388":100163},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2861":59189,"_25133":59171,"_17569":100165,"_5":17464,"_23818":100121,"_2388":100166},[],"**Flota**",{"_2861":59190,"_25133":59171,"_17569":100168,"_5":17464,"_23818":100121,"_2388":100169},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2861":59191,"_25133":59171,"_17569":100171,"_5":17464,"_23818":100121,"_2388":100172},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2861":59192,"_25133":59171,"_17569":100174,"_5":17464,"_23818":100121,"_2388":100175},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2861":59193,"_25133":59171,"_17569":100177,"_5":17464,"_23818":100124,"_2388":100178},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2861":59194,"_25133":59171,"_17569":100180,"_5":17464,"_23818":100124,"_2388":100181},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2861":59195,"_25133":59171,"_17569":100183,"_5":17464,"_23818":100124,"_2388":100184},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2861":59196,"_25133":59171,"_17569":100186,"_5":17464,"_23818":100124,"_2388":100187},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2861":59197,"_25133":59171,"_17569":100189,"_5":17464,"_23818":100124,"_2388":100190},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2861":59198,"_25133":59171,"_17569":100192,"_5":17464,"_23818":100124,"_2388":100193},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2861":59199,"_25133":59171,"_17569":100195,"_5":17464,"_23818":100124,"_2388":100196},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2861":59200,"_25133":59171,"_17569":100198,"_5":17464,"_23818":100124,"_2388":100199},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2861":59201,"_25133":59171,"_17569":100201,"_5":17464,"_23818":100127,"_2388":100202},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2861":59202,"_25133":59171,"_17569":100204,"_5":17464,"_23818":100127,"_2388":100205},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2861":59203,"_25133":59171,"_17569":100207,"_5":17464,"_23818":100130,"_2388":100208},[],"Participante",{"_2861":59204,"_25133":59171,"_17569":100210,"_5":17464,"_23818":100130,"_2388":100211},[],"Responsabilidad",{"_2861":59205,"_25133":59171,"_17569":100213,"_5":17464,"_23818":100130,"_2388":100214},[],"Administrador PKI",{"_2861":59206,"_25133":59171,"_17569":100216,"_5":17464,"_23818":100130,"_2388":100217},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2861":59207,"_25133":59171,"_17569":100219,"_5":17464,"_23818":100130,"_2388":100220},[],"Administrador del aprovisionamiento",{"_2861":59208,"_25133":59171,"_17569":100222,"_5":17464,"_23818":100130,"_2388":100223},[],"DMS, admisión, autenticación por operación e inventario.",{"_2861":59209,"_25133":59171,"_17569":100225,"_5":17464,"_23818":100130,"_2388":100226},[],"Integrador del dispositivo",{"_2861":59210,"_25133":59171,"_17569":100228,"_5":17464,"_23818":100130,"_2388":100229},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2861":59211,"_25133":59171,"_17569":100231,"_5":17464,"_23818":100130,"_2388":100232},[],"Integrador del consumidor",{"_2861":59212,"_25133":59171,"_17569":100234,"_5":17464,"_23818":100130,"_2388":100235},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2861":59213,"_25133":59171,"_17569":100237,"_5":17464,"_23818":100130,"_2388":100238},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2861":59214,"_25133":59214,"_5":12309,"_2388":100240,"_25469":100241,"_17569":100243,"_23818":59214},"Enrola y conecta tu primer dispositivo",[40834,97206,43152,100242],"Primeros pasos",[],{"_2861":59215,"_25133":59214,"_17569":100245,"_5":17464,"_23818":59214,"_2388":100246},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2861":59216,"_25133":59214,"_5":25466,"_17569":100248,"_23818":100249,"_2388":95907},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2861":59217,"_25133":59214,"_5":25466,"_17569":100251,"_23818":100252,"_2388":100253},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2861":59218,"_25133":59214,"_5":25466,"_17569":100255,"_23818":100256,"_2388":100257},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2861":59219,"_25133":59214,"_5":25466,"_17569":100259,"_23818":100260,"_2388":100261},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2861":59220,"_25133":59214,"_5":25466,"_17569":100263,"_23818":100264,"_2388":100265},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2861":59221,"_25133":59214,"_5":25466,"_17569":100267,"_23818":100268,"_2388":100269},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2861":59222,"_25133":59214,"_5":25466,"_17569":100271,"_23818":100272,"_2388":100273},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2861":59223,"_25133":59214,"_5":25466,"_17569":100275,"_23818":100276,"_2388":100277},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2861":59224,"_25133":59214,"_17569":100279,"_5":17464,"_23818":59214,"_2388":100280},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2861":59225,"_25133":59214,"_17569":100282,"_5":17464,"_23818":100249,"_2388":100283},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2861":59226,"_25133":59214,"_17569":100285,"_5":17464,"_23818":100249,"_2388":100286},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2861":59227,"_25133":59214,"_17569":100288,"_5":17464,"_23818":100249,"_2388":100289},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2861":59228,"_25133":59214,"_17569":100291,"_5":17464,"_23818":100249,"_2388":100292},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2861":59229,"_25133":59214,"_17569":100294,"_5":17464,"_23818":100249,"_2388":100295},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2861":59230,"_25133":59214,"_17569":100297,"_5":17464,"_23818":100252,"_2388":100298},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2861":59231,"_25133":59214,"_17569":100300,"_5":17464,"_23818":100252,"_2388":100301},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2861":59232,"_25133":59214,"_17569":100303,"_5":17464,"_23818":100256,"_2388":100304},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2861":59233,"_25133":59214,"_17569":100306,"_5":17464,"_23818":100256,"_2388":100307},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2861":59234,"_25133":59214,"_17569":100309,"_5":17464,"_23818":100256,"_2388":100310},[],"Ajuste",{"_2861":59235,"_25133":59214,"_17569":100312,"_5":17464,"_23818":100256,"_2388":100313},[],"Valor de evaluación",{"_2861":59236,"_25133":59214,"_17569":100315,"_5":17464,"_23818":100256,"_2388":45380},[],{"_2861":59237,"_25133":59214,"_17569":100317,"_5":17464,"_23818":100256,"_2388":100318},[],"Raíz emisora de `device-root.pem`.",{"_2861":59238,"_25133":59214,"_17569":100320,"_5":17464,"_23818":100256,"_2388":98481},[],{"_2861":59239,"_25133":59214,"_17569":100322,"_5":17464,"_23818":100256,"_2388":100323},[],"Perfil final de 1 hora que acabas de preparar.",{"_2861":59240,"_25133":59214,"_17569":100325,"_5":17464,"_23818":100256,"_2388":45391},[],{"_2861":59241,"_25133":59214,"_17569":100327,"_5":17464,"_23818":100256,"_2388":45394},[],{"_2861":59242,"_25133":59214,"_17569":100329,"_5":17464,"_23818":100256,"_2388":45397},[],{"_2861":59243,"_25133":59214,"_17569":100331,"_5":17464,"_23818":100256,"_2388":100332},[],"Habilitado.",{"_2861":59244,"_25133":59214,"_17569":100334,"_5":17464,"_23818":100256,"_2388":45403},[],{"_2861":59245,"_25133":59214,"_17569":100336,"_5":17464,"_23818":100256,"_2388":100337},[],"Deshabilitado; el ID debe ser nuevo.",{"_2861":59246,"_25133":59214,"_17569":100339,"_5":17464,"_23818":100256,"_2388":100340},[],"Autenticación inicial",{"_2861":59247,"_25133":59214,"_17569":100342,"_5":17464,"_23818":100256,"_2388":100343},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2861":59248,"_25133":59214,"_17569":100345,"_5":17464,"_23818":100256,"_2388":100346},[],"Autenticación de renovación",{"_2861":59249,"_25133":59214,"_17569":100348,"_5":17464,"_23818":100256,"_2388":100349},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2861":59250,"_25133":59214,"_17569":100351,"_5":17464,"_23818":100256,"_2388":45421},[],{"_2861":59251,"_25133":59214,"_17569":100353,"_5":17464,"_23818":100256,"_2388":100354},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2861":59252,"_25133":59214,"_17569":100356,"_5":17464,"_23818":100256,"_2388":45427},[],{"_2861":59253,"_25133":59214,"_17569":100358,"_5":17464,"_23818":100256,"_2388":100359},[],"1 hora.",{"_2861":59254,"_25133":59214,"_17569":100361,"_5":17464,"_23818":100256,"_2388":45433},[],{"_2861":59255,"_25133":59214,"_17569":100363,"_5":17464,"_23818":100256,"_2388":100364},[],"30 minutos / 10 minutos.",{"_2861":59256,"_25133":59214,"_17569":100366,"_5":17464,"_23818":100256,"_2388":45439},[],{"_2861":59257,"_25133":59214,"_17569":100368,"_5":17464,"_23818":100256,"_2388":100369},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2861":59258,"_25133":59214,"_17569":100371,"_5":17464,"_23818":100256,"_2388":43471},[],{"_2861":59259,"_25133":59214,"_17569":100373,"_5":17464,"_23818":100256,"_2388":100374},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2861":59260,"_25133":59214,"_17569":100376,"_5":17464,"_23818":100256,"_2388":45450},[],{"_2861":59261,"_25133":59214,"_17569":100378,"_5":17464,"_23818":100256,"_2388":100379},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2861":59262,"_25133":59214,"_17569":100381,"_5":17464,"_23818":100256,"_2388":100382},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2861":59263,"_25133":59214,"_17569":100384,"_5":17464,"_23818":100260,"_2388":100385},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2861":59264,"_25133":59214,"_17569":100387,"_5":17464,"_23818":100260,"_2388":100388},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2861":59265,"_25133":59214,"_17569":100390,"_5":17464,"_23818":100264,"_2388":100391},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2861":59266,"_25133":59214,"_17569":100393,"_5":17464,"_23818":100264,"_2388":100394},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2861":59267,"_25133":59214,"_17569":100396,"_5":17464,"_23818":100264,"_2388":100397},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2861":59268,"_25133":59214,"_17569":100399,"_5":17464,"_23818":100268,"_2388":100400},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2861":59269,"_25133":59214,"_17569":100402,"_5":17464,"_23818":100268,"_2388":100403},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2861":59270,"_25133":59214,"_17569":100405,"_5":17464,"_23818":100272,"_2388":100406},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2861":59271,"_25133":59214,"_17569":100408,"_5":17464,"_23818":100272,"_2388":100409},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2861":59272,"_25133":59214,"_17569":100411,"_5":17464,"_23818":100272,"_2388":100412},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2861":59273,"_25133":59214,"_17569":100414,"_5":17464,"_23818":100272,"_2388":100415},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2861":59274,"_25133":59214,"_17569":100417,"_5":17464,"_23818":100272,"_2388":100418},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2861":59275,"_25133":59214,"_17569":100420,"_5":17464,"_23818":100276,"_2388":100421},[],"Comprobación",{"_2861":59276,"_25133":59214,"_17569":100423,"_5":17464,"_23818":100276,"_2388":100424},[],"Resultado esperado",{"_2861":59277,"_25133":59214,"_17569":100426,"_5":17464,"_23818":100276,"_2388":100427},[],"Registro",{"_2861":59278,"_25133":59214,"_17569":100429,"_5":17464,"_23818":100276,"_2388":100430},[],"ID creado automáticamente y DMS correcto.",{"_2861":59279,"_25133":59214,"_17569":100432,"_5":17464,"_23818":100276,"_2388":100433},[],"Certificado",{"_2861":59280,"_25133":59214,"_17569":100435,"_5":17464,"_23818":100276,"_2388":100436},[],"CN, perfil, serie y clave verificados.",{"_2861":59281,"_25133":59214,"_17569":100438,"_5":17464,"_23818":100276,"_2388":100439},[],"Inventario",{"_2861":59282,"_25133":59214,"_17569":100441,"_5":17464,"_23818":100276,"_2388":100442},[],"Serie recibida visible como identidad actual y en el historial.",{"_2861":59283,"_25133":59214,"_17569":100444,"_5":17464,"_23818":100276,"_2388":100445},[],"Consumidor",{"_2861":59284,"_25133":59214,"_17569":100447,"_5":17464,"_23818":100276,"_2388":100448},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2861":59285,"_25133":59214,"_17569":100450,"_5":17464,"_23818":100276,"_2388":100451},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2861":59286,"_25133":59214,"_17569":100453,"_5":17464,"_23818":100276,"_2388":100454},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2861":59287,"_25133":59287,"_5":12309,"_2388":98195,"_25469":100456,"_17569":100457,"_23818":59287},[40834,97206,43152,100242],[],{"_2861":59288,"_25133":59287,"_17569":100459,"_5":17464,"_23818":59287,"_2388":100460},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2861":59289,"_25133":59287,"_5":25466,"_17569":100462,"_23818":100463,"_2388":95907},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2861":59290,"_25133":59287,"_5":25466,"_17569":100465,"_23818":100466,"_2388":100467},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2861":59291,"_25133":59287,"_5":25466,"_17569":100469,"_23818":100470,"_2388":100471},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2861":59292,"_25133":59287,"_5":25466,"_17569":100473,"_23818":100474,"_2388":100475},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2861":59293,"_25133":59287,"_5":25466,"_17569":100477,"_23818":100478,"_2388":100479},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2861":59294,"_25133":59287,"_5":25466,"_17569":100481,"_23818":100482,"_2388":100483},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2861":59295,"_25133":59287,"_5":25466,"_17569":100485,"_23818":100486,"_2388":100424},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2861":59296,"_25133":59287,"_5":25466,"_17569":100488,"_23818":100489,"_2388":100490},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2861":59297,"_25133":59287,"_5":25466,"_17569":100492,"_23818":100493,"_2388":100494},[],"/docs/pr-preview/pr-37/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2861":59298,"_25133":59287,"_17569":100496,"_5":17464,"_23818":59287,"_2388":100497},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2861":59299,"_25133":59287,"_17569":100499,"_5":17464,"_23818":59287,"_2388":100500},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2861":59300,"_25133":59287,"_17569":100502,"_5":17464,"_23818":100463,"_2388":100503},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2861":59301,"_25133":59287,"_17569":100505,"_5":17464,"_23818":100463,"_2388":100506},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2861":59302,"_25133":59287,"_17569":100508,"_5":17464,"_23818":100463,"_2388":100509},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2861":59303,"_25133":59287,"_17569":100511,"_5":17464,"_23818":100463,"_2388":100512},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2861":59304,"_25133":59287,"_17569":100514,"_5":17464,"_23818":100466,"_2388":100515},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2861":59305,"_25133":59287,"_17569":100517,"_5":17464,"_23818":100466,"_2388":100518},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2861":59306,"_25133":59287,"_17569":100520,"_5":17464,"_23818":100466,"_2388":100521},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2861":59307,"_25133":59287,"_17569":100523,"_5":17464,"_23818":100466,"_2388":100524},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2861":59308,"_25133":59287,"_17569":100526,"_5":17464,"_23818":100466,"_2388":100527},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2861":59309,"_25133":59287,"_17569":100529,"_5":17464,"_23818":100466,"_2388":100530},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2861":59310,"_25133":59287,"_17569":100532,"_5":17464,"_23818":100466,"_2388":100533},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2861":59311,"_25133":59287,"_17569":100535,"_5":17464,"_23818":100466,"_2388":100536},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2861":59312,"_25133":59287,"_17569":100538,"_5":17464,"_23818":100470,"_2388":100539},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2861":59313,"_25133":59287,"_17569":100541,"_5":17464,"_23818":100470,"_2388":45616},[],{"_2861":59314,"_25133":59287,"_17569":100543,"_5":17464,"_23818":100470,"_2388":100544},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2861":59315,"_25133":59287,"_17569":100546,"_5":17464,"_23818":100470,"_2388":100547},[],"**Icon** y **Tags**: clasificación opcional.",{"_2861":59316,"_25133":59287,"_17569":100549,"_5":17464,"_23818":100470,"_2388":100550},[],"Confirma el registro.",{"_2861":59317,"_25133":59287,"_17569":100552,"_5":17464,"_23818":100474,"_2388":100553},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2861":59318,"_25133":59287,"_17569":100555,"_5":17464,"_23818":100474,"_2388":100556},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2861":59319,"_25133":59287,"_17569":100558,"_5":17464,"_23818":100478,"_2388":100559},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2861":59320,"_25133":59287,"_17569":100561,"_5":17464,"_23818":100478,"_2388":100562},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2861":59321,"_25133":59287,"_17569":100564,"_5":17464,"_23818":100482,"_2388":100565},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2861":59322,"_25133":59287,"_17569":100567,"_5":17464,"_23818":100482,"_2388":100568},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2861":59323,"_25133":59287,"_17569":100570,"_5":17464,"_23818":100486,"_2388":100421},[],{"_2861":59324,"_25133":59287,"_17569":100572,"_5":17464,"_23818":100486,"_2388":100573},[],"Resultado",{"_2861":59325,"_25133":59287,"_17569":100575,"_5":17464,"_23818":100486,"_2388":100576},[],"Dispositivo",{"_2861":59326,"_25133":59287,"_17569":100578,"_5":17464,"_23818":100486,"_2388":100579},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2861":59327,"_25133":59287,"_17569":100581,"_5":17464,"_23818":100486,"_2388":100582},[],"Identidad actual",{"_2861":59328,"_25133":59287,"_17569":100584,"_5":17464,"_23818":100486,"_2388":100585},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2861":59329,"_25133":59287,"_17569":100587,"_5":17464,"_23818":100486,"_2388":100588},[],"Historial",{"_2861":59330,"_25133":59287,"_17569":100590,"_5":17464,"_23818":100486,"_2388":100591},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2861":59331,"_25133":59287,"_17569":100593,"_5":17464,"_23818":100486,"_2388":100594},[],"Clave y certificado",{"_2861":59332,"_25133":59287,"_17569":100596,"_5":17464,"_23818":100486,"_2388":100597},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2861":59333,"_25133":59287,"_17569":100599,"_5":17464,"_23818":100489,"_2388":100600},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2861":59334,"_25133":59287,"_17569":100602,"_5":17464,"_23818":100489,"_2388":100603},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2861":59335,"_25133":59287,"_17569":100605,"_5":17464,"_23818":100489,"_2388":100606},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2861":59336,"_25133":59287,"_17569":100608,"_5":17464,"_23818":100489,"_2388":100609},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2861":59337,"_25133":59287,"_17569":100611,"_5":17464,"_23818":100493,"_2388":100612},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2861":59338,"_25133":59287,"_17569":100614,"_5":17464,"_23818":100493,"_2388":100615},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2861":59339,"_25133":59287,"_17569":100617,"_5":17464,"_23818":100493,"_2388":100618},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2861":59340,"_25133":59340,"_5":12309,"_2388":100620,"_25469":100621,"_17569":100622,"_23818":59340},"Plataforma Lamassu IoT",[40834,97206],[],{"_2861":59341,"_25133":59340,"_17569":100624,"_5":17464,"_23818":59340,"_2388":100625},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2861":59342,"_25133":59340,"_5":25466,"_17569":100627,"_23818":100628,"_2388":100118},[],"/docs/pr-preview/pr-37/es/platform/overview#empieza-aquí",{"_2861":59343,"_25133":59340,"_5":25466,"_17569":100630,"_23818":100631,"_2388":100632},[],"/docs/pr-preview/pr-37/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2861":59344,"_25133":59340,"_5":25466,"_17569":100634,"_23818":100635,"_2388":100636},[],"/docs/pr-preview/pr-37/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2861":59345,"_25133":59340,"_5":25466,"_17569":100638,"_23818":100639,"_2388":100640},[],"/docs/pr-preview/pr-37/es/platform/overview#capacidades-principales","Capacidades principales",{"_2861":59346,"_25133":59340,"_5":25466,"_17569":100642,"_23818":100643,"_2388":100644},[],"/docs/pr-preview/pr-37/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2861":59347,"_25133":59340,"_5":25466,"_17569":100646,"_23818":100647,"_2388":100648},[],"/docs/pr-preview/pr-37/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2861":59348,"_25133":59340,"_5":25466,"_17569":100650,"_23818":100651,"_2388":100652},[],"/docs/pr-preview/pr-37/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2861":59349,"_25133":59340,"_5":25466,"_17569":100654,"_23818":100655,"_2388":100656},[],"/docs/pr-preview/pr-37/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2861":59350,"_25133":59340,"_5":25466,"_17569":100658,"_23818":100659,"_2388":100660},[],"/docs/pr-preview/pr-37/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2861":59351,"_25133":59340,"_5":25466,"_17569":100662,"_23818":100663,"_2388":100664},[],"/docs/pr-preview/pr-37/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2861":59352,"_25133":59340,"_5":25466,"_17569":100666,"_23818":100667,"_2388":100668},[],"/docs/pr-preview/pr-37/es/platform/overview#referencia-operativa","Referencia operativa",{"_2861":59353,"_25133":59340,"_17569":100670,"_5":17464,"_23818":59340,"_2388":100671},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2861":59354,"_25133":59340,"_17569":100673,"_5":17464,"_23818":100628,"_2388":100674},[],"Elige el resultado que necesitas obtener:",{"_2861":59355,"_25133":59340,"_17569":100676,"_5":17464,"_23818":100628,"_2388":100677},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2861":59356,"_25133":59340,"_17569":100679,"_5":17464,"_23818":100628,"_2388":100680},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2861":59357,"_25133":59340,"_17569":100682,"_5":17464,"_23818":100628,"_2388":100683},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2861":59358,"_25133":59340,"_17569":100685,"_5":17464,"_23818":100631,"_2388":100686},[],"Bloque",{"_2861":59359,"_25133":59340,"_17569":100688,"_5":17464,"_23818":100631,"_2388":100689},[],"Qué gestionas",{"_2861":59360,"_25133":59340,"_17569":100691,"_5":17464,"_23818":100631,"_2388":100692},[],"Punto de entrada",{"_2861":59361,"_25133":59340,"_17569":100694,"_5":17464,"_23818":100631,"_2388":45770},[],{"_2861":59362,"_25133":59340,"_17569":100696,"_5":17464,"_23818":100631,"_2388":100697},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2861":59363,"_25133":59340,"_17569":100699,"_5":17464,"_23818":100631,"_2388":100700},[],"Visión general de PKI",{"_2861":59364,"_25133":59340,"_17569":100702,"_5":17464,"_23818":100631,"_2388":45779},[],{"_2861":59365,"_25133":59340,"_17569":100704,"_5":17464,"_23818":100631,"_2388":100705},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2861":59366,"_25133":59340,"_17569":100707,"_5":17464,"_23818":100631,"_2388":100708},[],"Visión general de IoT Fleets",{"_2861":59367,"_25133":59340,"_17569":100710,"_5":17464,"_23818":100631,"_2388":100711},[],"**Administración**",{"_2861":59368,"_25133":59340,"_17569":100713,"_5":17464,"_23818":100631,"_2388":100714},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2861":59369,"_25133":59340,"_17569":100716,"_5":17464,"_23818":100631,"_2388":97204},[],{"_2861":59370,"_25133":59340,"_17569":100718,"_5":17464,"_23818":100631,"_2388":100719},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2861":59371,"_25133":59340,"_17569":100721,"_5":17464,"_23818":100635,"_2388":100722},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2861":59372,"_25133":59340,"_17569":100724,"_5":17464,"_23818":100635,"_2388":100725},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2861":59373,"_25133":59340,"_17569":100727,"_5":17464,"_23818":100635,"_2388":100728},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2861":59374,"_25133":59340,"_17569":100730,"_5":17464,"_23818":100635,"_2388":100731},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2861":59375,"_25133":59340,"_17569":100733,"_5":17464,"_23818":100635,"_2388":100734},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2861":59376,"_25133":59340,"_17569":100736,"_5":17464,"_23818":100635,"_2388":100737},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2861":59377,"_25133":59340,"_17569":100739,"_5":17464,"_23818":100643,"_2388":100740},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2861":59378,"_25133":59340,"_17569":100742,"_5":17464,"_23818":100647,"_2388":100743},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2861":59379,"_25133":59340,"_17569":100745,"_5":17464,"_23818":100651,"_2388":100746},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2861":59380,"_25133":59340,"_17569":100748,"_5":17464,"_23818":100655,"_2388":100749},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2861":59381,"_25133":59340,"_17569":100751,"_5":17464,"_23818":100659,"_2388":100752},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2861":59382,"_25133":59340,"_17569":100754,"_5":17464,"_23818":100663,"_2388":100755},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2861":59383,"_25133":59340,"_17569":100757,"_5":17464,"_23818":100667,"_2388":100211},[],{"_2861":59384,"_25133":59340,"_17569":100759,"_5":17464,"_23818":100667,"_2388":100760},[],"Qué prepara o comprueba",{"_2861":59385,"_25133":59340,"_17569":100762,"_5":17464,"_23818":100667,"_2388":100214},[],{"_2861":59386,"_25133":59340,"_17569":100764,"_5":17464,"_23818":100667,"_2388":100765},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2861":59387,"_25133":59340,"_17569":100767,"_5":17464,"_23818":100667,"_2388":100768},[],"Administrador de la flota",{"_2861":59388,"_25133":59340,"_17569":100770,"_5":17464,"_23818":100667,"_2388":100771},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2861":59389,"_25133":59340,"_17569":100773,"_5":17464,"_23818":100667,"_2388":100226},[],{"_2861":59390,"_25133":59340,"_17569":100775,"_5":17464,"_23818":100667,"_2388":100776},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2861":59391,"_25133":59340,"_17569":100778,"_5":17464,"_23818":100667,"_2388":100232},[],{"_2861":59392,"_25133":59340,"_17569":100780,"_5":17464,"_23818":100667,"_2388":100781},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2861":59393,"_25133":59340,"_17569":100783,"_5":17464,"_23818":100667,"_2388":100784},[],"Operador de infraestructura",{"_2861":59394,"_25133":59340,"_17569":100786,"_5":17464,"_23818":100667,"_2388":100787},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2861":59395,"_25133":59340,"_17569":100789,"_5":17464,"_23818":100667,"_2388":100790},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2861":59396,"_25133":59396,"_5":12309,"_2388":100792,"_25469":100793,"_17569":100795,"_23818":59396},"Jerarquía y rotación de CAs",[40834,97206,45871,100794],"Claves, autoridades y certificados",[],{"_2861":59397,"_25133":59396,"_17569":100797,"_5":17464,"_23818":59396,"_2388":100798},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2861":59398,"_25133":59396,"_5":25466,"_17569":100800,"_23818":100801,"_2388":100802},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2861":59399,"_25133":59396,"_5":25466,"_17569":100804,"_23818":100805,"_2388":100806},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2861":59400,"_25133":59396,"_5":25466,"_17569":100808,"_23818":100809,"_2388":100810},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2861":59401,"_25133":59396,"_5":25466,"_17569":100812,"_23818":100813,"_2388":100814},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2861":59402,"_25133":59396,"_5":25466,"_17569":100816,"_23818":100817,"_2388":100818},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2861":59403,"_25133":59396,"_5":25466,"_17569":100820,"_23818":100821,"_2388":100822},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2861":59404,"_25133":59396,"_5":25466,"_17569":100824,"_23818":100825,"_2388":100826},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2861":59405,"_25133":59396,"_5":25466,"_17569":100828,"_23818":100829,"_2388":100830},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2861":59406,"_25133":59396,"_5":25466,"_17569":100832,"_23818":100833,"_2388":100834},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2861":59407,"_25133":59396,"_5":25466,"_17569":100836,"_23818":100837,"_2388":100838},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2861":59408,"_25133":59396,"_5":25466,"_17569":100840,"_23818":100841,"_2388":100842},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2861":59409,"_25133":59396,"_5":25466,"_17569":100844,"_23818":100845,"_2388":100846},[],"/docs/pr-preview/pr-37/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2861":59410,"_25133":59396,"_17569":100848,"_5":17464,"_23818":59396,"_2388":100849},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2861":59411,"_25133":59396,"_17569":100851,"_5":17464,"_23818":59396,"_2388":100852},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2861":59412,"_25133":59396,"_17569":100854,"_5":17464,"_23818":100801,"_2388":100855},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2861":59413,"_25133":59396,"_17569":100857,"_5":17464,"_23818":100801,"_2388":100858},[],"entorno, como producción y preproducción;",{"_2861":59414,"_25133":59396,"_17569":100860,"_5":17464,"_23818":100801,"_2388":100861},[],"propietario o equipo operador;",{"_2861":59415,"_25133":59396,"_17569":100863,"_5":17464,"_23818":100801,"_2388":100864},[],"familia de dispositivos o proceso de fabricación;",{"_2861":59416,"_25133":59396,"_17569":100866,"_5":17464,"_23818":100801,"_2388":100867},[],"región o requisito regulatorio;",{"_2861":59417,"_25133":59396,"_17569":100869,"_5":17464,"_23818":100801,"_2388":100870},[],"motor criptográfico o política de clave;",{"_2861":59418,"_25133":59396,"_17569":100872,"_5":17464,"_23818":100801,"_2388":100873},[],"ventana de mantenimiento y ritmo de renovación.",{"_2861":59419,"_25133":59396,"_17569":100875,"_5":17464,"_23818":100801,"_2388":100876},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2861":59420,"_25133":59396,"_17569":100878,"_5":17464,"_23818":100801,"_2388":100879},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2861":59421,"_25133":59396,"_17569":100881,"_5":17464,"_23818":100805,"_2388":100882},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2861":59422,"_25133":59396,"_17569":100884,"_5":17464,"_23818":100805,"_2388":100885},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2861":59423,"_25133":59396,"_17569":100887,"_5":17464,"_23818":100805,"_2388":100888},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2861":59424,"_25133":59396,"_17569":100890,"_5":17464,"_23818":100809,"_2388":100891},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2861":59425,"_25133":59396,"_17569":100893,"_5":17464,"_23818":100809,"_2388":100894},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2861":59426,"_25133":59396,"_17569":100896,"_5":17464,"_23818":100809,"_2388":100897},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2861":59427,"_25133":59396,"_17569":100899,"_5":17464,"_23818":100809,"_2388":100900},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2861":59428,"_25133":59396,"_17569":100902,"_5":17464,"_23818":100817,"_2388":100903},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2861":59429,"_25133":59396,"_17569":100905,"_5":17464,"_23818":100821,"_2388":100906},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2861":59430,"_25133":59396,"_17569":100908,"_5":17464,"_23818":100825,"_2388":100909},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2861":59431,"_25133":59396,"_17569":100911,"_5":17464,"_23818":100829,"_2388":100912},[],"Actualiza la CA de enrolamiento y el perfil de los DMS y añade la CA anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS mientras sigan renovando cohortes con certificados antiguos. La guía DMS documenta ese ajuste.",{"_2861":59432,"_25133":59396,"_17569":100914,"_5":17464,"_23818":100833,"_2388":100915},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2861":59433,"_25133":59396,"_17569":100917,"_5":17464,"_23818":100837,"_2388":100918},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2861":59434,"_25133":59396,"_17569":100920,"_5":17464,"_23818":100841,"_2388":100921},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2861":59435,"_25133":59396,"_17569":100923,"_5":17464,"_23818":100841,"_2388":100924},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2861":59436,"_25133":59396,"_17569":100926,"_5":17464,"_23818":100841,"_2388":100927},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2861":59437,"_25133":59396,"_17569":100929,"_5":17464,"_23818":100841,"_2388":100930},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2861":59438,"_25133":59396,"_17569":100932,"_5":17464,"_23818":100845,"_2388":100933},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2861":59439,"_25133":59396,"_17569":100935,"_5":17464,"_23818":100845,"_2388":100936},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2861":59440,"_25133":59396,"_17569":100938,"_5":17464,"_23818":100845,"_2388":100939},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2861":59441,"_25133":59396,"_17569":100941,"_5":17464,"_23818":100845,"_2388":100942},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2861":59442,"_25133":59396,"_17569":100944,"_5":17464,"_23818":100845,"_2388":100945},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2861":59443,"_25133":59396,"_17569":100947,"_5":17464,"_23818":100845,"_2388":100948},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2861":59444,"_25133":59396,"_17569":100950,"_5":17464,"_23818":100845,"_2388":100951},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2861":59445,"_25133":59445,"_5":12309,"_2388":100953,"_25469":100954,"_17569":100955,"_23818":59445},"Autoridades de certificación",[40834,97206,45871,100794],[],{"_2861":59446,"_25133":59445,"_17569":100957,"_5":17464,"_23818":59445,"_2388":100958},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2861":59447,"_25133":59445,"_5":25466,"_17569":100960,"_23818":100961,"_2388":100962},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2861":59448,"_25133":59445,"_5":25466,"_17569":100964,"_23818":100965,"_2388":100966},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2861":59449,"_25133":59445,"_5":25466,"_17569":100968,"_23818":100969,"_2388":95907},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2861":59450,"_25133":59445,"_5":25466,"_17569":100971,"_23818":100972,"_2388":100973},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2861":59451,"_25133":59445,"_5":25466,"_17569":100975,"_23818":100976,"_2388":100977},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2861":59452,"_25133":59445,"_5":25466,"_17569":100979,"_23818":100980,"_2388":100981},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2861":59453,"_25133":59445,"_5":25466,"_17569":100983,"_23818":100984,"_2388":100985},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2861":59454,"_25133":59445,"_5":25466,"_17569":100987,"_23818":100988,"_2388":100989},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2861":59455,"_25133":59445,"_5":25466,"_17569":100991,"_23818":100992,"_2388":100993},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2861":59456,"_25133":59445,"_5":25466,"_17569":100995,"_23818":100996,"_2388":100997},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2861":59457,"_25133":59445,"_5":25466,"_17569":100999,"_23818":101000,"_2388":101001},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2861":59458,"_25133":59445,"_5":25466,"_17569":101003,"_23818":101004,"_2388":101005},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2861":59459,"_25133":59445,"_5":25466,"_17569":101007,"_23818":101008,"_2388":101009},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2861":59460,"_25133":59445,"_5":25466,"_17569":101011,"_23818":101012,"_2388":101013},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2861":59461,"_25133":59445,"_5":25466,"_17569":101015,"_23818":101016,"_2388":101017},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2861":59462,"_25133":59445,"_5":25466,"_17569":101019,"_23818":101020,"_2388":101021},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2861":59463,"_25133":59445,"_5":25466,"_17569":101023,"_23818":101024,"_2388":101025},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2861":59464,"_25133":59445,"_5":25466,"_17569":101027,"_23818":101028,"_2388":101029},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2861":59465,"_25133":59445,"_5":25466,"_17569":101031,"_23818":101032,"_2388":101033},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2861":59466,"_25133":59445,"_5":25466,"_17569":101035,"_23818":101036,"_2388":101037},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2861":59467,"_25133":59445,"_5":25466,"_17569":101039,"_23818":101040,"_2388":101041},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2861":59468,"_25133":59445,"_5":25466,"_17569":101043,"_23818":101044,"_2388":101045},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2861":59469,"_25133":59445,"_17569":101047,"_5":17464,"_23818":59445,"_2388":101048},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2861":59470,"_25133":59445,"_17569":101050,"_5":17464,"_23818":59445,"_2388":101051},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2861":59471,"_25133":59445,"_17569":101053,"_5":17464,"_23818":59445,"_2388":101054},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2861":59472,"_25133":59445,"_17569":101056,"_5":17464,"_23818":100961,"_2388":101057},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2861":59473,"_25133":59445,"_17569":101059,"_5":17464,"_23818":100961,"_2388":101060},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2861":59474,"_25133":59445,"_17569":101062,"_5":17464,"_23818":100961,"_2388":101063},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2861":59475,"_25133":59445,"_17569":101065,"_5":17464,"_23818":100961,"_2388":101066},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2861":59476,"_25133":59445,"_17569":101068,"_5":17464,"_23818":100961,"_2388":101069},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2861":59477,"_25133":59445,"_17569":101071,"_5":17464,"_23818":100969,"_2388":101072},[],"Decide si la CA será raíz o intermedia.",{"_2861":59478,"_25133":59445,"_17569":101074,"_5":17464,"_23818":100969,"_2388":101075},[],"Elige el motor que custodiará la clave.",{"_2861":59479,"_25133":59445,"_17569":101077,"_5":17464,"_23818":100969,"_2388":101078},[],"Define una validez superior a la de los certificados que emitirá.",{"_2861":59480,"_25133":59445,"_17569":101080,"_5":17464,"_23818":100969,"_2388":101081},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2861":59481,"_25133":59445,"_17569":101083,"_5":17464,"_23818":100972,"_2388":101084},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2861":59482,"_25133":59445,"_17569":101086,"_5":17464,"_23818":100976,"_2388":101087},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2861":59483,"_25133":59445,"_17569":101089,"_5":17464,"_23818":100976,"_2388":101090},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2861":59484,"_25133":59445,"_17569":101092,"_5":17464,"_23818":100980,"_2388":101093},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2861":59485,"_25133":59445,"_17569":101095,"_5":17464,"_23818":100984,"_2388":101096},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2861":59486,"_25133":59445,"_17569":101098,"_5":17464,"_23818":100984,"_2388":101099},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2861":59487,"_25133":59445,"_17569":101101,"_5":17464,"_23818":100984,"_2388":101102},[],"`ST`: estado o provincia.",{"_2861":59488,"_25133":59445,"_17569":101104,"_5":17464,"_23818":100984,"_2388":101105},[],"`L`: localidad.",{"_2861":59489,"_25133":59445,"_17569":101107,"_5":17464,"_23818":100984,"_2388":101108},[],"`O`: organización.",{"_2861":59490,"_25133":59445,"_17569":101110,"_5":17464,"_23818":100984,"_2388":101111},[],"`OU`: unidad organizativa.",{"_2861":59491,"_25133":59445,"_17569":101113,"_5":17464,"_23818":100984,"_2388":101114},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2861":59492,"_25133":59445,"_17569":101116,"_5":17464,"_23818":100988,"_2388":101117},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2861":59493,"_25133":59445,"_17569":101119,"_5":17464,"_23818":100988,"_2388":101120},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2861":59494,"_25133":59445,"_17569":101122,"_5":17464,"_23818":100992,"_2388":101123},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2861":59495,"_25133":59445,"_17569":101125,"_5":17464,"_23818":100992,"_2388":101126},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2861":59496,"_25133":59445,"_17569":101128,"_5":17464,"_23818":100996,"_2388":101129},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2861":59497,"_25133":59445,"_17569":101131,"_5":17464,"_23818":100996,"_2388":101132},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2861":59498,"_25133":59445,"_17569":101134,"_5":17464,"_23818":101000,"_2388":101135},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2861":59499,"_25133":59445,"_17569":101137,"_5":17464,"_23818":101004,"_2388":101138},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2861":59500,"_25133":59445,"_17569":101140,"_5":17464,"_23818":101008,"_2388":101141},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2861":59501,"_25133":59445,"_17569":101143,"_5":17464,"_23818":101012,"_2388":101144},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2861":59502,"_25133":59445,"_17569":101146,"_5":17464,"_23818":101016,"_2388":101147},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2861":59503,"_25133":59445,"_17569":101149,"_5":17464,"_23818":101016,"_2388":101150},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2861":59504,"_25133":59445,"_17569":101152,"_5":17464,"_23818":101020,"_2388":101153},[],"Abre una CA desde el inventario para consultar:",{"_2861":59505,"_25133":59445,"_17569":101155,"_5":17464,"_23818":101020,"_2388":101156},[],"Estado y periodo de validez.",{"_2861":59506,"_25133":59445,"_17569":101158,"_5":17464,"_23818":101020,"_2388":101159},[],"Certificado y cadena en formato PEM.",{"_2861":59507,"_25133":59445,"_17569":101161,"_5":17464,"_23818":101020,"_2388":101162},[],"Número de certificados activos, expirados y revocados.",{"_2861":59508,"_25133":59445,"_17569":101164,"_5":17464,"_23818":101020,"_2388":101165},[],"Certificados emitidos en **Issued Certificates**.",{"_2861":59509,"_25133":59445,"_17569":101167,"_5":17464,"_23818":101020,"_2388":101168},[],"CRL vinculada a la autoridad.",{"_2861":59510,"_25133":59445,"_17569":101170,"_5":17464,"_23818":101020,"_2388":101171},[],"Metadatos y motor criptográfico asociado.",{"_2861":59511,"_25133":59445,"_17569":101173,"_5":17464,"_23818":101020,"_2388":101174},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2861":59512,"_25133":59445,"_17569":101176,"_5":17464,"_23818":101024,"_2388":101177},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2861":59513,"_25133":59445,"_17569":101179,"_5":17464,"_23818":101024,"_2388":101180},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2861":59514,"_25133":59445,"_17569":101182,"_5":17464,"_23818":101024,"_2388":101183},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2861":59515,"_25133":59445,"_17569":101185,"_5":17464,"_23818":101024,"_2388":101186},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2861":59516,"_25133":59445,"_17569":101188,"_5":17464,"_23818":101028,"_2388":101189},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2861":59517,"_25133":59445,"_17569":101191,"_5":17464,"_23818":101032,"_2388":101192},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2861":59518,"_25133":59445,"_17569":101194,"_5":17464,"_23818":101036,"_2388":101195},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2861":59519,"_25133":59445,"_17569":101197,"_5":17464,"_23818":101040,"_2388":101198},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2861":59520,"_25133":59445,"_17569":101200,"_5":17464,"_23818":101044,"_2388":101201},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2861":59521,"_25133":59445,"_17569":101203,"_5":17464,"_23818":101044,"_2388":101204},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2861":59522,"_25133":59522,"_5":12309,"_2388":101206,"_25469":101207,"_17569":101208,"_23818":59522},"Perfiles de certificado",[40834,97206,45871,100794],[],{"_2861":59523,"_25133":59522,"_17569":101210,"_5":17464,"_23818":59522,"_2388":101211},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2861":59524,"_25133":59522,"_5":25466,"_17569":101213,"_23818":101214,"_2388":101215},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2861":59525,"_25133":59522,"_5":25466,"_17569":101217,"_23818":101218,"_2388":101219},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#validez","Validez",{"_2861":59526,"_25133":59522,"_5":25466,"_17569":101221,"_23818":101222,"_2388":101223},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2861":59527,"_25133":59522,"_5":25466,"_17569":101225,"_23818":101226,"_2388":101227},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2861":59528,"_25133":59522,"_5":25466,"_17569":101229,"_23818":101230,"_2388":101231},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2861":59529,"_25133":59522,"_5":25466,"_17569":101233,"_23818":101234,"_2388":101235},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2861":59530,"_25133":59522,"_5":25466,"_17569":101237,"_23818":101238,"_2388":101239},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2861":59531,"_25133":59522,"_5":25466,"_17569":101241,"_23818":101242,"_2388":101243},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2861":59532,"_25133":59522,"_5":25466,"_17569":101245,"_23818":101246,"_2388":101247},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2861":59533,"_25133":59522,"_5":25466,"_17569":101249,"_23818":101250,"_2388":101251},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2861":59534,"_25133":59522,"_5":25466,"_17569":101253,"_23818":101254,"_2388":101255},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2861":59535,"_25133":59522,"_5":25466,"_17569":101257,"_23818":101258,"_2388":101259},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2861":59536,"_25133":59522,"_5":25466,"_17569":101261,"_23818":101262,"_2388":101263},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2861":59537,"_25133":59522,"_5":25466,"_17569":101265,"_23818":101266,"_2388":101267},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2861":59538,"_25133":59522,"_5":25466,"_17569":101269,"_23818":101270,"_2388":101271},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2861":59539,"_25133":59522,"_5":25466,"_17569":101273,"_23818":101274,"_2388":101275},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2861":59540,"_25133":59522,"_17569":101277,"_5":17464,"_23818":59522,"_2388":101278},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2861":59541,"_25133":59522,"_17569":101280,"_5":17464,"_23818":59522,"_2388":101281},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2861":59542,"_25133":59522,"_17569":101283,"_5":17464,"_23818":101218,"_2388":101284},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2861":59543,"_25133":59522,"_17569":101286,"_5":17464,"_23818":101218,"_2388":101287},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2861":59544,"_25133":59522,"_17569":101289,"_5":17464,"_23818":101222,"_2388":101290},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2861":59545,"_25133":59522,"_17569":101292,"_5":17464,"_23818":101226,"_2388":101293},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2861":59546,"_25133":59522,"_17569":101295,"_5":17464,"_23818":101226,"_2388":101296},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2861":59547,"_25133":59522,"_17569":101298,"_5":17464,"_23818":101226,"_2388":101299},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2861":59548,"_25133":59522,"_17569":101301,"_5":17464,"_23818":101230,"_2388":101302},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2861":59549,"_25133":59522,"_17569":101304,"_5":17464,"_23818":101234,"_2388":101305},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2861":59550,"_25133":59522,"_17569":101307,"_5":17464,"_23818":101234,"_2388":101308},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2861":59551,"_25133":59522,"_17569":101310,"_5":17464,"_23818":101238,"_2388":101311},[],"La aplicación criptográfica puede:",{"_2861":59552,"_25133":59522,"_17569":101313,"_5":17464,"_23818":101238,"_2388":101314},[],"permitir o bloquear claves RSA;",{"_2861":59553,"_25133":59522,"_17569":101316,"_5":17464,"_23818":101238,"_2388":101317},[],"limitar los tamaños RSA admitidos;",{"_2861":59554,"_25133":59522,"_17569":101319,"_5":17464,"_23818":101238,"_2388":101320},[],"permitir o bloquear claves ECDSA;",{"_2861":59555,"_25133":59522,"_17569":101322,"_5":17464,"_23818":101238,"_2388":101323},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2861":59556,"_25133":59522,"_17569":101325,"_5":17464,"_23818":101238,"_2388":101326},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2861":59557,"_25133":59522,"_17569":101328,"_5":17464,"_23818":101242,"_2388":101329},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2861":59558,"_25133":59522,"_17569":101331,"_5":17464,"_23818":101242,"_2388":96997},[],{"_2861":59559,"_25133":59522,"_17569":101333,"_5":17464,"_23818":101242,"_2388":101334},[],"Primera opción",{"_2861":59560,"_25133":59522,"_17569":101336,"_5":17464,"_23818":101242,"_2388":101337},[],"Segunda opción",{"_2861":59561,"_25133":59522,"_17569":101339,"_5":17464,"_23818":101242,"_2388":101340},[],"Si no hay ninguna",{"_2861":59562,"_25133":59522,"_17569":101342,"_5":17464,"_23818":101242,"_2388":101343},[],"Firma directa con una CA",{"_2861":59563,"_25133":59522,"_17569":101345,"_5":17464,"_23818":101242,"_2388":101346},[],"`issuance_profile` incluido en la solicitud",{"_2861":59564,"_25133":59522,"_17569":101348,"_5":17464,"_23818":101242,"_2388":101349},[],"`issuance_profile_id` de la solicitud",{"_2861":59565,"_25133":59522,"_17569":101351,"_5":17464,"_23818":101242,"_2388":101352},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2861":59566,"_25133":59522,"_17569":101354,"_5":17464,"_23818":101242,"_2388":101355},[],"Emisión mediante DMS",{"_2861":59567,"_25133":59522,"_17569":101357,"_5":17464,"_23818":101242,"_2388":46436},[],{"_2861":59568,"_25133":59522,"_17569":101359,"_5":17464,"_23818":101242,"_2388":101360},[],"`settings.issuance_profile` incluido en el DMS",{"_2861":59569,"_25133":59522,"_17569":101362,"_5":17464,"_23818":101242,"_2388":101363},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2861":59570,"_25133":59522,"_17569":101365,"_5":17464,"_23818":101242,"_2388":101366},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2861":59571,"_25133":59522,"_17569":101368,"_5":17464,"_23818":101242,"_2388":101369},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2861":59572,"_25133":59522,"_17569":101371,"_5":17464,"_23818":101250,"_2388":101372},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2861":59573,"_25133":59522,"_17569":101374,"_5":17464,"_23818":101254,"_2388":101375},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2861":59574,"_25133":59522,"_17569":101377,"_5":17464,"_23818":101258,"_2388":101378},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2861":59575,"_25133":59522,"_17569":101380,"_5":17464,"_23818":101262,"_2388":101381},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2861":59576,"_25133":59522,"_17569":101383,"_5":17464,"_23818":101266,"_2388":101384},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2861":59577,"_25133":59522,"_17569":101386,"_5":17464,"_23818":101266,"_2388":101387},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2861":59578,"_25133":59522,"_17569":101389,"_5":17464,"_23818":101270,"_2388":101390},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2861":59579,"_25133":59522,"_17569":101392,"_5":17464,"_23818":101270,"_2388":101393},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2861":59580,"_25133":59522,"_17569":101395,"_5":17464,"_23818":101270,"_2388":101396},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2861":59581,"_25133":59522,"_17569":101398,"_5":17464,"_23818":101270,"_2388":101399},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2861":59582,"_25133":59522,"_17569":101401,"_5":17464,"_23818":101274,"_2388":101402},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2861":59583,"_25133":59522,"_17569":101404,"_5":17464,"_23818":101274,"_2388":101405},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2861":59584,"_25133":59584,"_5":12309,"_2388":101407,"_25469":101408,"_17569":101410,"_23818":59584},"Validación de certificados",[40834,97206,45871,101409],"Validación",[],{"_2861":59585,"_25133":59584,"_17569":101412,"_5":17464,"_23818":59584,"_2388":101413},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2861":59586,"_25133":59584,"_5":25466,"_17569":101415,"_23818":101416,"_2388":101417},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2861":59587,"_25133":59584,"_5":25466,"_17569":101419,"_23818":101420,"_2388":101421},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2861":59588,"_25133":59584,"_5":25466,"_17569":101423,"_23818":101424,"_2388":101425},[],"/docs/pr-preview/pr-37/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2861":59589,"_25133":59584,"_17569":101427,"_5":17464,"_23818":59584,"_2388":101428},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2861":59590,"_25133":59584,"_17569":101430,"_5":17464,"_23818":101416,"_2388":101431},[],"Verifica estos criterios juntos:",{"_2861":59591,"_25133":59584,"_17569":101433,"_5":17464,"_23818":101416,"_2388":100421},[],{"_2861":59592,"_25133":59584,"_17569":101435,"_5":17464,"_23818":101416,"_2388":101436},[],"Resultado necesario",{"_2861":59593,"_25133":59584,"_17569":101438,"_5":17464,"_23818":101416,"_2388":101439},[],"Cadena y firma",{"_2861":59594,"_25133":59584,"_17569":101441,"_5":17464,"_23818":101416,"_2388":101442},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2861":59595,"_25133":59584,"_17569":101444,"_5":17464,"_23818":101416,"_2388":101445},[],"Fechas",{"_2861":59596,"_25133":59584,"_17569":101447,"_5":17464,"_23818":101416,"_2388":101448},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2861":59597,"_25133":59584,"_17569":101450,"_5":17464,"_23818":101416,"_2388":96910},[],{"_2861":59598,"_25133":59584,"_17569":101452,"_5":17464,"_23818":101416,"_2388":101453},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2861":59599,"_25133":59584,"_17569":101455,"_5":17464,"_23818":101416,"_2388":101456},[],"Uso",{"_2861":59600,"_25133":59584,"_17569":101458,"_5":17464,"_23818":101416,"_2388":101459},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2861":59601,"_25133":59584,"_17569":101461,"_5":17464,"_23818":101416,"_2388":101462},[],"Revocación",{"_2861":59602,"_25133":59584,"_17569":101464,"_5":17464,"_23818":101416,"_2388":101465},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2861":59603,"_25133":59584,"_17569":101467,"_5":17464,"_23818":101416,"_2388":101468},[],"Autorización",{"_2861":59604,"_25133":59584,"_17569":101470,"_5":17464,"_23818":101416,"_2388":101471},[],"La aplicación permite la acción a esa identidad.",{"_2861":59605,"_25133":59584,"_17569":101473,"_5":17464,"_23818":101416,"_2388":101474},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2861":59606,"_25133":59584,"_17569":101476,"_5":17464,"_23818":101420,"_2388":101477},[],"Mecanismo",{"_2861":59607,"_25133":59584,"_17569":101479,"_5":17464,"_23818":101420,"_2388":101480},[],"Cuándo utilizarlo",{"_2861":59608,"_25133":59584,"_17569":101482,"_5":17464,"_23818":101420,"_2388":101483},[],"Qué debes mantener",{"_2861":59609,"_25133":59584,"_17569":101485,"_5":17464,"_23818":101420,"_2388":46564},[],{"_2861":59610,"_25133":59584,"_17569":101487,"_5":17464,"_23818":101420,"_2388":101488},[],"Consulta del estado de un certificado concreto.",{"_2861":59611,"_25133":59584,"_17569":101490,"_5":17464,"_23818":101420,"_2388":101491},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2861":59612,"_25133":59584,"_17569":101493,"_5":17464,"_23818":101420,"_2388":46573},[],{"_2861":59613,"_25133":59584,"_17569":101495,"_5":17464,"_23818":101420,"_2388":101496},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2861":59614,"_25133":59584,"_17569":101498,"_5":17464,"_23818":101420,"_2388":101499},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2861":59615,"_25133":59584,"_17569":101501,"_5":17464,"_23818":101420,"_2388":101502},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2861":59616,"_25133":59584,"_17569":101504,"_5":17464,"_23818":101420,"_2388":101505},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2861":59617,"_25133":59584,"_17569":101507,"_5":17464,"_23818":101424,"_2388":101508},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2861":59618,"_25133":59584,"_17569":101510,"_5":17464,"_23818":101424,"_2388":101511},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2861":59619,"_25133":59584,"_17569":101513,"_5":17464,"_23818":101424,"_2388":101514},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2861":59620,"_25133":59584,"_17569":101516,"_5":17464,"_23818":101424,"_2388":101517},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2861":59621,"_25133":59584,"_17569":101519,"_5":17464,"_23818":101424,"_2388":101520},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2861":59622,"_25133":59584,"_17569":101522,"_5":17464,"_23818":101424,"_2388":101523},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2861":59623,"_25133":59584,"_17569":101525,"_5":17464,"_23818":101424,"_2388":101526},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2861":59624,"_25133":59584,"_17569":101528,"_5":17464,"_23818":101424,"_2388":101529},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2861":59625,"_25133":59584,"_17569":101531,"_5":17464,"_23818":101424,"_2388":101532},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2861":59626,"_25133":59626,"_5":12309,"_2388":101534,"_25469":101535,"_17569":101536,"_23818":59626},"Certificados",[40834,97206,45871,100794],[],{"_2861":59627,"_25133":59626,"_17569":101538,"_5":17464,"_23818":59626,"_2388":101539},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2861":59628,"_25133":59626,"_5":25466,"_17569":101541,"_23818":101542,"_2388":101543},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2861":59629,"_25133":59626,"_5":25466,"_17569":101545,"_23818":101546,"_2388":101547},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2861":59630,"_25133":59626,"_5":25466,"_17569":101549,"_23818":101550,"_2388":101551},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2861":59631,"_25133":59626,"_5":25466,"_17569":101553,"_23818":101554,"_2388":101555},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2861":59632,"_25133":59626,"_5":25466,"_17569":101557,"_23818":101558,"_2388":101559},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2861":59633,"_25133":59626,"_5":25466,"_17569":101561,"_23818":101562,"_2388":101563},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2861":59634,"_25133":59626,"_5":25466,"_17569":101565,"_23818":101566,"_2388":101567},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2861":59635,"_25133":59626,"_5":25466,"_17569":101569,"_23818":101570,"_2388":101571},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2861":59636,"_25133":59626,"_5":25466,"_17569":101573,"_23818":101574,"_2388":101575},[],"/docs/pr-preview/pr-37/es/platform/pki/certificates#continúa","Continúa",{"_2861":59637,"_25133":59626,"_17569":101577,"_5":17464,"_23818":59626,"_2388":101578},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2861":59638,"_25133":59626,"_17569":101580,"_5":17464,"_23818":101542,"_2388":101581},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2861":59639,"_25133":59626,"_17569":101583,"_5":17464,"_23818":101542,"_2388":101584},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2861":59640,"_25133":59626,"_17569":101586,"_5":17464,"_23818":101546,"_2388":101587},[],"Descarga el PEM e inspecciónalo:",{"_2861":59641,"_25133":59626,"_17569":101589,"_5":17464,"_23818":101546,"_2388":101590},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2861":59642,"_25133":59626,"_17569":101592,"_5":17464,"_23818":101550,"_2388":101593},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2861":59643,"_25133":59626,"_17569":101595,"_5":17464,"_23818":101550,"_2388":101596},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2861":59644,"_25133":59626,"_17569":101598,"_5":17464,"_23818":101550,"_2388":101599},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2861":59645,"_25133":59626,"_17569":101601,"_5":17464,"_23818":101550,"_2388":101602},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2861":59646,"_25133":59626,"_17569":101604,"_5":17464,"_23818":101550,"_2388":101605},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2861":59647,"_25133":59626,"_17569":101607,"_5":17464,"_23818":101550,"_2388":101608},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2861":59648,"_25133":59626,"_17569":101610,"_5":17464,"_23818":101550,"_2388":101611},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2861":59649,"_25133":59626,"_17569":101613,"_5":17464,"_23818":101554,"_2388":101614},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2861":59650,"_25133":59626,"_17569":101616,"_5":17464,"_23818":101558,"_2388":101617},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2861":59651,"_25133":59626,"_17569":101619,"_5":17464,"_23818":101562,"_2388":101620},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2861":59652,"_25133":59626,"_17569":101622,"_5":17464,"_23818":101566,"_2388":101623},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2861":59653,"_25133":59626,"_17569":101625,"_5":17464,"_23818":101566,"_2388":101626},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2861":59654,"_25133":59626,"_17569":101628,"_5":17464,"_23818":101566,"_2388":101629},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2861":59655,"_25133":59626,"_17569":101631,"_5":17464,"_23818":101570,"_2388":101632},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2861":59656,"_25133":59626,"_17569":101634,"_5":17464,"_23818":101570,"_2388":101635},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2861":59657,"_25133":59626,"_17569":101637,"_5":17464,"_23818":101570,"_2388":101638},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2861":59658,"_25133":59626,"_17569":101640,"_5":17464,"_23818":101574,"_2388":101641},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2861":59659,"_25133":59626,"_17569":101643,"_5":17464,"_23818":101574,"_2388":101644},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2861":59660,"_25133":59660,"_5":12309,"_2388":101646,"_25469":101647,"_17569":101649,"_23818":59660},"Ciclo de vida de un certificado",[40834,97206,45871,101648],"Conceptos",[],{"_2861":59661,"_25133":59660,"_17569":101651,"_5":17464,"_23818":59660,"_2388":101652},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2861":59662,"_25133":59660,"_5":25466,"_17569":101654,"_23818":101655,"_2388":101656},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2861":59663,"_25133":59660,"_5":25466,"_17569":101658,"_23818":101659,"_2388":101660},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2861":59664,"_25133":59660,"_5":25466,"_17569":101662,"_23818":101663,"_2388":101664},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2861":59665,"_25133":59660,"_5":25466,"_17569":101666,"_23818":101667,"_2388":101668},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2861":59666,"_25133":59660,"_5":25466,"_17569":101670,"_23818":101671,"_2388":101672},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2861":59667,"_25133":59660,"_5":25466,"_17569":101674,"_23818":101675,"_2388":101676},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2861":59668,"_25133":59660,"_5":25466,"_17569":101678,"_23818":101679,"_2388":101680},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2861":59669,"_25133":59660,"_5":25466,"_17569":101682,"_23818":101683,"_2388":101684},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2861":59670,"_25133":59660,"_5":25466,"_17569":101686,"_23818":101687,"_2388":101688},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2861":59671,"_25133":59660,"_5":25466,"_17569":101690,"_23818":101691,"_2388":101692},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2861":59672,"_25133":59660,"_17569":101694,"_5":17464,"_23818":59660,"_2388":101695},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2861":59673,"_25133":59660,"_17569":101697,"_5":17464,"_23818":101659,"_2388":101698},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2861":59674,"_25133":59660,"_17569":101700,"_5":17464,"_23818":101663,"_2388":101701},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2861":59675,"_25133":59660,"_17569":101703,"_5":17464,"_23818":101667,"_2388":101704},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2861":59676,"_25133":59660,"_17569":101706,"_5":17464,"_23818":101671,"_2388":101707},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2861":59677,"_25133":59660,"_17569":101709,"_5":17464,"_23818":101675,"_2388":101710},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2861":59678,"_25133":59660,"_17569":101712,"_5":17464,"_23818":101679,"_2388":101713},[],"Lamassu persiste cuatro estados X.509:",{"_2861":59679,"_25133":59660,"_17569":101715,"_5":17464,"_23818":101679,"_2388":101716},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2861":59680,"_25133":59660,"_17569":101718,"_5":17464,"_23818":101679,"_2388":101719},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2861":59681,"_25133":59660,"_17569":101721,"_5":17464,"_23818":101679,"_2388":101722},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2861":59682,"_25133":59660,"_17569":101724,"_5":17464,"_23818":101679,"_2388":101725},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2861":59683,"_25133":59660,"_17569":101727,"_5":17464,"_23818":101679,"_2388":101728},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2861":59684,"_25133":59660,"_17569":101730,"_5":17464,"_23818":101683,"_2388":101731},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2861":59685,"_25133":59660,"_17569":101733,"_5":17464,"_23818":101683,"_2388":101734},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2861":59686,"_25133":59660,"_17569":101736,"_5":17464,"_23818":101683,"_2388":101737},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2861":59687,"_25133":59660,"_17569":101739,"_5":17464,"_23818":101687,"_2388":101740},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2861":59688,"_25133":59660,"_17569":101742,"_5":17464,"_23818":101687,"_2388":101743},[],"Antes de confirmar:",{"_2861":59689,"_25133":59660,"_17569":101745,"_5":17464,"_23818":101687,"_2388":101746},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2861":59690,"_25133":59660,"_17569":101748,"_5":17464,"_23818":101687,"_2388":101749},[],"Distribuye la nueva cadena de confianza.",{"_2861":59691,"_25133":59660,"_17569":101751,"_5":17464,"_23818":101687,"_2388":101752},[],"Reemite las identidades necesarias.",{"_2861":59692,"_25133":59660,"_17569":101754,"_5":17464,"_23818":101687,"_2388":101755},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2861":59693,"_25133":59660,"_17569":101757,"_5":17464,"_23818":101687,"_2388":101758},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2861":59694,"_25133":59660,"_17569":101760,"_5":17464,"_23818":101687,"_2388":101761},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2861":59695,"_25133":59660,"_17569":101763,"_5":17464,"_23818":101691,"_2388":101764},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2861":59696,"_25133":59660,"_17569":101766,"_5":17464,"_23818":101691,"_2388":101767},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2861":59697,"_25133":59660,"_17569":101769,"_5":17464,"_23818":101691,"_2388":101770},[],"Cambios de estado y razones de revocación.",{"_2861":59698,"_25133":59660,"_17569":101772,"_5":17464,"_23818":101691,"_2388":101773},[],"Publicación y vigencia de OCSP y CRLs.",{"_2861":59699,"_25133":59660,"_17569":101775,"_5":17464,"_23818":101691,"_2388":101776},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2861":59700,"_25133":59660,"_17569":101778,"_5":17464,"_23818":101691,"_2388":101779},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2861":59701,"_25133":59701,"_5":12309,"_2388":101781,"_25469":101782,"_17569":101783,"_23818":59701},"Modelo de confianza",[40834,97206,45871,101648],[],{"_2861":59702,"_25133":59701,"_17569":101785,"_5":17464,"_23818":59701,"_2388":101786},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2861":59703,"_25133":59701,"_5":25466,"_17569":101788,"_23818":101789,"_2388":101790},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2861":59704,"_25133":59701,"_5":25466,"_17569":101792,"_23818":101793,"_2388":101794},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2861":59705,"_25133":59701,"_5":25466,"_17569":101796,"_23818":101797,"_2388":101798},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2861":59706,"_25133":59701,"_5":25466,"_17569":101800,"_23818":101801,"_2388":101802},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2861":59707,"_25133":59701,"_5":25466,"_17569":101804,"_23818":101805,"_2388":101806},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2861":59708,"_25133":59701,"_5":25466,"_17569":101808,"_23818":101809,"_2388":101810},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2861":59709,"_25133":59701,"_5":25466,"_17569":101812,"_23818":101813,"_2388":101814},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2861":59710,"_25133":59701,"_5":25466,"_17569":101816,"_23818":101817,"_2388":101818},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2861":59711,"_25133":59701,"_5":25466,"_17569":101820,"_23818":101821,"_2388":101822},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2861":59712,"_25133":59701,"_5":25466,"_17569":101824,"_23818":101825,"_2388":101826},[],"/docs/pr-preview/pr-37/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2861":59713,"_25133":59701,"_17569":101828,"_5":17464,"_23818":59701,"_2388":101829},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2861":59714,"_25133":59701,"_17569":101831,"_5":17464,"_23818":101793,"_2388":101832},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2861":59715,"_25133":59701,"_17569":101834,"_5":17464,"_23818":101797,"_2388":101835},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2861":59716,"_25133":59701,"_17569":101837,"_5":17464,"_23818":101801,"_2388":101838},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2861":59717,"_25133":59701,"_17569":101840,"_5":17464,"_23818":101805,"_2388":101841},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2861":59718,"_25133":59701,"_17569":101843,"_5":17464,"_23818":101809,"_2388":101844},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2861":59719,"_25133":59701,"_17569":101846,"_5":17464,"_23818":101809,"_2388":101847},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2861":59720,"_25133":59701,"_17569":101849,"_5":17464,"_23818":101809,"_2388":101850},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2861":59721,"_25133":59701,"_17569":101852,"_5":17464,"_23818":101809,"_2388":101853},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2861":59722,"_25133":59701,"_17569":101855,"_5":17464,"_23818":101809,"_2388":101856},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2861":59723,"_25133":59701,"_17569":101858,"_5":17464,"_23818":101809,"_2388":101859},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2861":59724,"_25133":59701,"_17569":101861,"_5":17464,"_23818":101813,"_2388":101862},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2861":59725,"_25133":59701,"_17569":101864,"_5":17464,"_23818":101813,"_2388":101865},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2861":59726,"_25133":59701,"_17569":101867,"_5":17464,"_23818":101813,"_2388":101868},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación configuradas en el bloque de re-enrolamiento.",{"_2861":59727,"_25133":59701,"_17569":101870,"_5":17464,"_23818":101813,"_2388":101871},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2861":59728,"_25133":59701,"_17569":101873,"_5":17464,"_23818":101813,"_2388":101874},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2861":59729,"_25133":59701,"_17569":101876,"_5":17464,"_23818":101817,"_2388":101877},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2861":59730,"_25133":59701,"_17569":101879,"_5":17464,"_23818":101817,"_2388":101880},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2861":59731,"_25133":59701,"_17569":101882,"_5":17464,"_23818":101817,"_2388":101883},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2861":59732,"_25133":59701,"_17569":101885,"_5":17464,"_23818":101817,"_2388":101886},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2861":59733,"_25133":59701,"_17569":101888,"_5":17464,"_23818":101817,"_2388":101889},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2861":59734,"_25133":59701,"_17569":101891,"_5":17464,"_23818":101817,"_2388":101892},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2861":59735,"_25133":59701,"_17569":101894,"_5":17464,"_23818":101817,"_2388":101895},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2861":59736,"_25133":59701,"_17569":101897,"_5":17464,"_23818":101821,"_2388":101898},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2861":59737,"_25133":59701,"_17569":101900,"_5":17464,"_23818":101825,"_2388":101901},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2861":59738,"_25133":59701,"_17569":101903,"_5":17464,"_23818":101825,"_2388":101904},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2861":59739,"_25133":59701,"_17569":101906,"_5":17464,"_23818":101825,"_2388":101907},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2861":59740,"_25133":59701,"_17569":101909,"_5":17464,"_23818":101825,"_2388":101910},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2861":59741,"_25133":59701,"_17569":101912,"_5":17464,"_23818":101825,"_2388":101913},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2861":59742,"_25133":59701,"_17569":101915,"_5":17464,"_23818":101825,"_2388":101916},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2861":59743,"_25133":59701,"_17569":101918,"_5":17464,"_23818":101825,"_2388":101919},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2861":59744,"_25133":59744,"_5":12309,"_2388":101921,"_25469":101922,"_17569":101923,"_23818":59744},"Listas de revocación (CRL)",[40834,97206,45871,101409],[],{"_2861":59745,"_25133":59744,"_17569":101925,"_5":17464,"_23818":59744,"_2388":101926},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2861":59746,"_25133":59744,"_5":25466,"_17569":101928,"_23818":101929,"_2388":101930},[],"/docs/pr-preview/pr-37/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2861":59747,"_25133":59744,"_5":25466,"_17569":101932,"_23818":101933,"_2388":101934},[],"/docs/pr-preview/pr-37/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2861":59748,"_25133":59744,"_5":25466,"_17569":101936,"_23818":101937,"_2388":101938},[],"/docs/pr-preview/pr-37/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2861":59749,"_25133":59744,"_5":25466,"_17569":101940,"_23818":101941,"_2388":101942},[],"/docs/pr-preview/pr-37/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2861":59750,"_25133":59744,"_5":25466,"_17569":101944,"_23818":101945,"_2388":101946},[],"/docs/pr-preview/pr-37/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2861":59751,"_25133":59744,"_5":25466,"_17569":101948,"_23818":101949,"_2388":101950},[],"/docs/pr-preview/pr-37/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2861":59752,"_25133":59744,"_5":25466,"_17569":101952,"_23818":101953,"_2388":101954},[],"/docs/pr-preview/pr-37/es/platform/pki/crl#referencias","Referencias",{"_2861":59753,"_25133":59744,"_17569":101956,"_5":17464,"_23818":59744,"_2388":101957},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2861":59754,"_25133":59744,"_17569":101959,"_5":17464,"_23818":101929,"_2388":101960},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2861":59755,"_25133":59744,"_17569":101962,"_5":17464,"_23818":101929,"_2388":101963},[],"Campo de `crl_options`",{"_2861":59756,"_25133":59744,"_17569":101965,"_5":17464,"_23818":101929,"_2388":98702},[],{"_2861":59757,"_25133":59744,"_17569":101967,"_5":17464,"_23818":101929,"_2388":101968},[],"Valor inicial del backend",{"_2861":59758,"_25133":59744,"_17569":101970,"_5":17464,"_23818":101929,"_2388":47051},[],{"_2861":59759,"_25133":59744,"_17569":101972,"_5":17464,"_23818":101929,"_2388":101973},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2861":59760,"_25133":59744,"_17569":101975,"_5":17464,"_23818":101929,"_2388":101976},[],"7 días.",{"_2861":59761,"_25133":59744,"_17569":101978,"_5":17464,"_23818":101929,"_2388":47060},[],{"_2861":59762,"_25133":59744,"_17569":101980,"_5":17464,"_23818":101929,"_2388":101981},[],"Plazo desde la publicación que activa la renovación programada.",{"_2861":59763,"_25133":59744,"_17569":101983,"_5":17464,"_23818":101929,"_2388":101984},[],"6 días y 23 horas.",{"_2861":59764,"_25133":59744,"_17569":101986,"_5":17464,"_23818":101929,"_2388":47069},[],{"_2861":59765,"_25133":59744,"_17569":101988,"_5":17464,"_23818":101929,"_2388":101989},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2861":59766,"_25133":59744,"_17569":101991,"_5":17464,"_23818":101929,"_2388":47075},[],{"_2861":59767,"_25133":59744,"_17569":101993,"_5":17464,"_23818":101929,"_2388":47078},[],{"_2861":59768,"_25133":59744,"_17569":101995,"_5":17464,"_23818":101929,"_2388":101996},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2861":59769,"_25133":59744,"_17569":101998,"_5":17464,"_23818":101929,"_2388":101999},[],"SKI de la CA.",{"_2861":59770,"_25133":59744,"_17569":102001,"_5":17464,"_23818":101929,"_2388":102002},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2861":59771,"_25133":59744,"_17569":102004,"_5":17464,"_23818":101929,"_2388":102005},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2861":59772,"_25133":59744,"_17569":102007,"_5":17464,"_23818":101933,"_2388":102008},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2861":59773,"_25133":59744,"_17569":102010,"_5":17464,"_23818":101933,"_2388":102011},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2861":59774,"_25133":59744,"_17569":102013,"_5":17464,"_23818":101933,"_2388":102014},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2861":59775,"_25133":59744,"_17569":102016,"_5":17464,"_23818":101937,"_2388":102017},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2861":59776,"_25133":59744,"_17569":102019,"_5":17464,"_23818":101937,"_2388":102020},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2861":59777,"_25133":59744,"_17569":102022,"_5":17464,"_23818":101941,"_2388":102023},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2861":59778,"_25133":59744,"_17569":102025,"_5":17464,"_23818":101941,"_2388":102026},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2861":59779,"_25133":59744,"_17569":102028,"_5":17464,"_23818":101941,"_2388":102029},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2861":59780,"_25133":59744,"_17569":102031,"_5":17464,"_23818":101941,"_2388":102032},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2861":59781,"_25133":59744,"_17569":102034,"_5":17464,"_23818":101941,"_2388":102035},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2861":59782,"_25133":59744,"_17569":102037,"_5":17464,"_23818":101945,"_2388":102038},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2861":59783,"_25133":59744,"_17569":102040,"_5":17464,"_23818":101945,"_2388":98891},[],{"_2861":59784,"_25133":59744,"_17569":102042,"_5":17464,"_23818":101945,"_2388":102043},[],"Path relativo",{"_2861":59785,"_25133":59744,"_17569":102045,"_5":17464,"_23818":101945,"_2388":96997},[],{"_2861":59786,"_25133":59744,"_17569":102047,"_5":17464,"_23818":101945,"_2388":47133},[],{"_2861":59787,"_25133":59744,"_17569":102049,"_5":17464,"_23818":101945,"_2388":47136},[],{"_2861":59788,"_25133":59744,"_17569":102051,"_5":17464,"_23818":101945,"_2388":102052},[],"Consultar `crl_options` y `latest_crl`.",{"_2861":59789,"_25133":59744,"_17569":102054,"_5":17464,"_23818":101945,"_2388":47142},[],{"_2861":59790,"_25133":59744,"_17569":102056,"_5":17464,"_23818":101945,"_2388":47136},[],{"_2861":59791,"_25133":59744,"_17569":102058,"_5":17464,"_23818":101945,"_2388":102059},[],"Sustituir la configuración de CRL.",{"_2861":59792,"_25133":59744,"_17569":102061,"_5":17464,"_23818":101945,"_2388":102062},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2861":59793,"_25133":59744,"_17569":102064,"_5":17464,"_23818":101945,"_2388":102065},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2861":59794,"_25133":59744,"_17569":102067,"_5":17464,"_23818":101949,"_2388":102068},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2861":59795,"_25133":59744,"_17569":102070,"_5":17464,"_23818":101953,"_2388":102071},[],"RFC 5280: perfil X.509 y CRL.",{"_2861":59796,"_25133":59744,"_17569":102073,"_5":17464,"_23818":101953,"_2388":47162},[],{"_2861":59797,"_25133":59744,"_17569":102075,"_5":17464,"_23818":101953,"_2388":47165},[],{"_2861":59798,"_25133":59744,"_17569":102077,"_5":17464,"_23818":101953,"_2388":102078},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2861":59799,"_25133":59744,"_17569":102080,"_5":17464,"_23818":101953,"_2388":102081},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2861":59800,"_25133":59800,"_5":12309,"_2388":102083,"_25469":102084,"_17569":102085,"_23818":59800},"Claves y motores criptográficos",[40834,97206,45871,100794],[],{"_2861":59801,"_25133":59800,"_17569":102087,"_5":17464,"_23818":59800,"_2388":102088},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2861":59802,"_25133":59800,"_5":25466,"_17569":102090,"_23818":102091,"_2388":102092},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2861":59803,"_25133":59800,"_5":25466,"_17569":102094,"_23818":102095,"_2388":102096},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2861":59804,"_25133":59800,"_5":25466,"_17569":102098,"_23818":102099,"_2388":47190},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#file-system",{"_2861":59805,"_25133":59800,"_5":25466,"_17569":102101,"_23818":102102,"_2388":47194},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#hashicorp-vault",{"_2861":59806,"_25133":59800,"_5":25466,"_17569":102104,"_23818":102105,"_2388":47198},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#aws-secrets-manager",{"_2861":59807,"_25133":59800,"_5":25466,"_17569":102107,"_23818":102108,"_2388":47202},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#aws-kms",{"_2861":59808,"_25133":59800,"_5":25466,"_17569":102110,"_23818":102111,"_2388":47206},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#pkcs11",{"_2861":59809,"_25133":59800,"_5":25466,"_17569":102113,"_23818":102114,"_2388":47210},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#azure-key-vault",{"_2861":59810,"_25133":59800,"_5":25466,"_17569":102116,"_23818":102117,"_2388":102118},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2861":59811,"_25133":59800,"_5":25466,"_17569":102120,"_23818":102121,"_2388":102122},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2861":59812,"_25133":59800,"_5":25466,"_17569":102124,"_23818":102125,"_2388":102126},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2861":59813,"_25133":59800,"_5":25466,"_17569":102128,"_23818":102129,"_2388":102130},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2861":59814,"_25133":59800,"_5":25466,"_17569":102132,"_23818":102133,"_2388":102134},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2861":59815,"_25133":59800,"_5":25466,"_17569":102136,"_23818":102137,"_2388":102138},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2861":59816,"_25133":59800,"_5":25466,"_17569":102140,"_23818":102141,"_2388":102142},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2861":59817,"_25133":59800,"_5":25466,"_17569":102144,"_23818":102145,"_2388":47242},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#sign",{"_2861":59818,"_25133":59800,"_5":25466,"_17569":102147,"_23818":102148,"_2388":47246},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#verify",{"_2861":59819,"_25133":59800,"_5":25466,"_17569":102150,"_23818":102151,"_2388":102152},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2861":59820,"_25133":59800,"_5":25466,"_17569":102154,"_23818":102155,"_2388":102156},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2861":59821,"_25133":59800,"_5":25466,"_17569":102158,"_23818":102159,"_2388":102160},[],"/docs/pr-preview/pr-37/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2861":59822,"_25133":59800,"_17569":102162,"_5":17464,"_23818":59800,"_2388":102163},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2861":59823,"_25133":59800,"_17569":102165,"_5":17464,"_23818":59800,"_2388":102166},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2861":59824,"_25133":59800,"_17569":102168,"_5":17464,"_23818":102091,"_2388":102169},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2861":59825,"_25133":59800,"_17569":102171,"_5":17464,"_23818":102091,"_2388":102172},[],"En la práctica, permite:",{"_2861":59826,"_25133":59800,"_17569":102174,"_5":17464,"_23818":102091,"_2388":102175},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2861":59827,"_25133":59800,"_17569":102177,"_5":17464,"_23818":102091,"_2388":102178},[],"Importar claves creadas externamente.",{"_2861":59828,"_25133":59800,"_17569":102180,"_5":17464,"_23818":102091,"_2388":102181},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2861":59829,"_25133":59800,"_17569":102183,"_5":17464,"_23818":102091,"_2388":102184},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2861":59830,"_25133":59800,"_17569":102186,"_5":17464,"_23818":102095,"_2388":102187},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2861":59831,"_25133":59800,"_17569":102189,"_5":17464,"_23818":102095,"_2388":102190},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2861":59832,"_25133":59800,"_17569":102192,"_5":17464,"_23818":102095,"_2388":102193},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2861":59833,"_25133":59800,"_17569":102195,"_5":17464,"_23818":102099,"_2388":102196},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2861":59834,"_25133":59800,"_17569":102198,"_5":17464,"_23818":102102,"_2388":102199},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2861":59835,"_25133":59800,"_17569":102201,"_5":17464,"_23818":102105,"_2388":102202},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2861":59836,"_25133":59800,"_17569":102204,"_5":17464,"_23818":102108,"_2388":102205},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2861":59837,"_25133":59800,"_17569":102207,"_5":17464,"_23818":102111,"_2388":102208},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2861":59838,"_25133":59800,"_17569":102210,"_5":17464,"_23818":102114,"_2388":102211},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2861":59839,"_25133":59800,"_17569":102213,"_5":17464,"_23818":102114,"_2388":102214},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2861":59840,"_25133":59800,"_17569":102216,"_5":17464,"_23818":102114,"_2388":102217},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2861":59841,"_25133":59800,"_17569":102219,"_5":17464,"_23818":102114,"_2388":102220},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2861":59842,"_25133":59800,"_17569":102222,"_5":17464,"_23818":102117,"_2388":102223},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2861":59843,"_25133":59800,"_17569":102225,"_5":17464,"_23818":102117,"_2388":102226},[],"La tabla incluye los siguientes campos:",{"_2861":59844,"_25133":59800,"_17569":102228,"_5":17464,"_23818":102117,"_2388":102229},[],"**Name**: nombre descriptivo de la clave.",{"_2861":59845,"_25133":59800,"_17569":102231,"_5":17464,"_23818":102117,"_2388":102232},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2861":59846,"_25133":59800,"_17569":102234,"_5":17464,"_23818":102117,"_2388":102235},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2861":59847,"_25133":59800,"_17569":102237,"_5":17464,"_23818":102117,"_2388":102238},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2861":59848,"_25133":59800,"_17569":102240,"_5":17464,"_23818":102117,"_2388":102241},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2861":59849,"_25133":59800,"_17569":102243,"_5":17464,"_23818":102117,"_2388":102244},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2861":59850,"_25133":59800,"_17569":102246,"_5":17464,"_23818":102117,"_2388":102247},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2861":59851,"_25133":59800,"_17569":102249,"_5":17464,"_23818":102117,"_2388":102250},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2861":59852,"_25133":59800,"_17569":102252,"_5":17464,"_23818":102117,"_2388":102253},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2861":59853,"_25133":59800,"_17569":102255,"_5":17464,"_23818":102117,"_2388":102256},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2861":59854,"_25133":59800,"_17569":102258,"_5":17464,"_23818":102117,"_2388":102259},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2861":59855,"_25133":59800,"_17569":102261,"_5":17464,"_23818":102117,"_2388":102262},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2861":59856,"_25133":59800,"_17569":102264,"_5":17464,"_23818":102117,"_2388":102265},[],"**Delete Key** para eliminar la clave del sistema.",{"_2861":59857,"_25133":59800,"_17569":102267,"_5":17464,"_23818":102121,"_2388":102268},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2861":59858,"_25133":59800,"_17569":102270,"_5":17464,"_23818":102125,"_2388":102271},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2861":59859,"_25133":59800,"_17569":102273,"_5":17464,"_23818":102125,"_2388":102274},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2861":59860,"_25133":59800,"_17569":102276,"_5":17464,"_23818":102125,"_2388":102277},[],"**Key Name**: nombre único y descriptivo.",{"_2861":59861,"_25133":59800,"_17569":102279,"_5":17464,"_23818":102125,"_2388":102280},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2861":59862,"_25133":59800,"_17569":102282,"_5":17464,"_23818":102125,"_2388":102283},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2861":59863,"_25133":59800,"_17569":102285,"_5":17464,"_23818":102125,"_2388":102286},[],"**Tags**: metadatos para clasificar la clave.",{"_2861":59864,"_25133":59800,"_17569":102288,"_5":17464,"_23818":102125,"_2388":102289},[],"**Metadata**: información adicional para usos avanzados.",{"_2861":59865,"_25133":59800,"_17569":102291,"_5":17464,"_23818":102129,"_2388":102292},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2861":59866,"_25133":59800,"_17569":102294,"_5":17464,"_23818":102129,"_2388":102295},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2861":59867,"_25133":59800,"_17569":102297,"_5":17464,"_23818":102129,"_2388":102298},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2861":59868,"_25133":59800,"_17569":102300,"_5":17464,"_23818":102129,"_2388":102301},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2861":59869,"_25133":59800,"_17569":102303,"_5":17464,"_23818":102129,"_2388":102304},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2861":59870,"_25133":59800,"_17569":102306,"_5":17464,"_23818":102129,"_2388":102307},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2861":59871,"_25133":59800,"_17569":102309,"_5":17464,"_23818":102129,"_2388":102310},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2861":59872,"_25133":59800,"_17569":102312,"_5":17464,"_23818":102129,"_2388":102313},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2861":59873,"_25133":59800,"_17569":102315,"_5":17464,"_23818":102129,"_2388":102316},[],"**Metadata**: información adicional opcional.",{"_2861":59874,"_25133":59800,"_17569":102318,"_5":17464,"_23818":102129,"_2388":102319},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2861":59875,"_25133":59800,"_17569":102321,"_5":17464,"_23818":102129,"_2388":102322},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2861":59876,"_25133":59800,"_17569":102324,"_5":17464,"_23818":102133,"_2388":102325},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2861":59877,"_25133":59800,"_17569":102327,"_5":17464,"_23818":102137,"_2388":102328},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2861":59878,"_25133":59800,"_17569":102330,"_5":17464,"_23818":102137,"_2388":102331},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2861":59879,"_25133":59800,"_17569":102333,"_5":17464,"_23818":102137,"_2388":102334},[],"**Key Name**: nombre descriptivo.",{"_2861":59880,"_25133":59800,"_17569":102336,"_5":17464,"_23818":102137,"_2388":102337},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2861":59881,"_25133":59800,"_17569":102339,"_5":17464,"_23818":102137,"_2388":102340},[],"**Tags**: etiquetas asociadas.",{"_2861":59882,"_25133":59800,"_17569":102342,"_5":17464,"_23818":102137,"_2388":102343},[],"**Aliases**: nombres alternativos.",{"_2861":59883,"_25133":59800,"_17569":102345,"_5":17464,"_23818":102137,"_2388":102346},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2861":59884,"_25133":59800,"_17569":102348,"_5":17464,"_23818":102137,"_2388":102349},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2861":59885,"_25133":59800,"_17569":102351,"_5":17464,"_23818":102137,"_2388":102352},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2861":59886,"_25133":59800,"_17569":102354,"_5":17464,"_23818":102137,"_2388":102355},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2861":59887,"_25133":59800,"_17569":102357,"_5":17464,"_23818":102141,"_2388":102358},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2861":59888,"_25133":59800,"_17569":102360,"_5":17464,"_23818":102141,"_2388":102361},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2861":59889,"_25133":59800,"_17569":102363,"_5":17464,"_23818":102141,"_2388":102364},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2861":59890,"_25133":59800,"_17569":102366,"_5":17464,"_23818":102145,"_2388":102367},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2861":59891,"_25133":59800,"_17569":102369,"_5":17464,"_23818":102145,"_2388":102370},[],"Campos principales:",{"_2861":59892,"_25133":59800,"_17569":102372,"_5":17464,"_23818":102145,"_2388":102373},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2861":59893,"_25133":59800,"_17569":102375,"_5":17464,"_23818":102145,"_2388":102376},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2861":59894,"_25133":59800,"_17569":102378,"_5":17464,"_23818":102145,"_2388":102379},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2861":59895,"_25133":59800,"_17569":102381,"_5":17464,"_23818":102145,"_2388":102382},[],"**Message**: contenido que se va a firmar.",{"_2861":59896,"_25133":59800,"_17569":102384,"_5":17464,"_23818":102145,"_2388":102385},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2861":59897,"_25133":59800,"_17569":102387,"_5":17464,"_23818":102148,"_2388":102388},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2861":59898,"_25133":59800,"_17569":102390,"_5":17464,"_23818":102148,"_2388":102370},[],{"_2861":59899,"_25133":59800,"_17569":102392,"_5":17464,"_23818":102148,"_2388":102393},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2861":59900,"_25133":59800,"_17569":102395,"_5":17464,"_23818":102148,"_2388":102396},[],"**Message Type**: `Raw` o `Digest`.",{"_2861":59901,"_25133":59800,"_17569":102398,"_5":17464,"_23818":102148,"_2388":102399},[],"**Payload Encoding**: codificación del mensaje.",{"_2861":59902,"_25133":59800,"_17569":102401,"_5":17464,"_23818":102148,"_2388":102402},[],"**Message**: mensaje original o hash.",{"_2861":59903,"_25133":59800,"_17569":102404,"_5":17464,"_23818":102148,"_2388":102405},[],"**Signature**: firma que se desea comprobar.",{"_2861":59904,"_25133":59800,"_17569":102407,"_5":17464,"_23818":102148,"_2388":102408},[],"**Result**: indicador del resultado de la validación.",{"_2861":59905,"_25133":59800,"_17569":102410,"_5":17464,"_23818":102151,"_2388":102411},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2861":59906,"_25133":59800,"_17569":102413,"_5":17464,"_23818":102151,"_2388":102414},[],"Este flujo es útil para:",{"_2861":59907,"_25133":59800,"_17569":102416,"_5":17464,"_23818":102151,"_2388":102417},[],"Solicitar certificados a una CA externa.",{"_2861":59908,"_25133":59800,"_17569":102419,"_5":17464,"_23818":102151,"_2388":102420},[],"Renovar una identidad manteniendo la misma clave.",{"_2861":59909,"_25133":59800,"_17569":102422,"_5":17464,"_23818":102151,"_2388":102423},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2861":59910,"_25133":59800,"_17569":102425,"_5":17464,"_23818":102151,"_2388":102426},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2861":59911,"_25133":59800,"_17569":102428,"_5":17464,"_23818":102151,"_2388":102429},[],"**Organization (O)**: organización o empresa.",{"_2861":59912,"_25133":59800,"_17569":102431,"_5":17464,"_23818":102151,"_2388":102432},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2861":59913,"_25133":59800,"_17569":102434,"_5":17464,"_23818":102151,"_2388":102435},[],"**Country (C)**: código de país de dos letras.",{"_2861":59914,"_25133":59800,"_17569":102437,"_5":17464,"_23818":102151,"_2388":102438},[],"**State / Province (ST)**: estado o provincia.",{"_2861":59915,"_25133":59800,"_17569":102440,"_5":17464,"_23818":102151,"_2388":102441},[],"**Locality (L)**: ciudad o localidad.",{"_2861":59916,"_25133":59800,"_17569":102443,"_5":17464,"_23818":102151,"_2388":102444},[],"**Email Address**: correo de contacto.",{"_2861":59917,"_25133":59800,"_17569":102446,"_5":17464,"_23818":102151,"_2388":102447},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2861":59918,"_25133":59800,"_17569":102449,"_5":17464,"_23818":102151,"_2388":102450},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2861":59919,"_25133":59800,"_17569":102452,"_5":17464,"_23818":102155,"_2388":102453},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2861":59920,"_25133":59800,"_17569":102455,"_5":17464,"_23818":102155,"_2388":47554},[],{"_2861":59921,"_25133":59800,"_17569":102457,"_5":17464,"_23818":102159,"_2388":102458},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2861":59922,"_25133":59922,"_5":12309,"_2388":102460,"_25469":102461,"_17569":102462,"_23818":59922},"Validación online con OCSP",[40834,97206,45871,101409],[],{"_2861":59923,"_25133":59922,"_17569":102464,"_5":17464,"_23818":59922,"_2388":102465},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2861":59924,"_25133":59922,"_5":25466,"_17569":102467,"_23818":102468,"_2388":102469},[],"/docs/pr-preview/pr-37/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2861":59925,"_25133":59922,"_5":25466,"_17569":102471,"_23818":102472,"_2388":102473},[],"/docs/pr-preview/pr-37/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2861":59926,"_25133":59922,"_5":25466,"_17569":102475,"_23818":102476,"_2388":102477},[],"/docs/pr-preview/pr-37/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2861":59927,"_25133":59922,"_5":25466,"_17569":102479,"_23818":102480,"_2388":102481},[],"/docs/pr-preview/pr-37/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2861":59928,"_25133":59922,"_5":25466,"_17569":102483,"_23818":102484,"_2388":102485},[],"/docs/pr-preview/pr-37/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2861":59929,"_25133":59922,"_5":25466,"_17569":102487,"_23818":102488,"_2388":101954},[],"/docs/pr-preview/pr-37/es/platform/pki/ocsp#referencias",{"_2861":59930,"_25133":59922,"_17569":102490,"_5":17464,"_23818":59922,"_2388":102491},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2861":59931,"_25133":59922,"_17569":102493,"_5":17464,"_23818":102468,"_2388":102494},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2861":59932,"_25133":59922,"_17569":102496,"_5":17464,"_23818":102468,"_2388":102497},[],"Estado del registro",{"_2861":59933,"_25133":59922,"_17569":102499,"_5":17464,"_23818":102468,"_2388":102500},[],"Respuesta firmada",{"_2861":59934,"_25133":59922,"_17569":102502,"_5":17464,"_23818":102468,"_2388":45049},[],{"_2861":59935,"_25133":59922,"_17569":102504,"_5":17464,"_23818":102468,"_2388":47604},[],{"_2861":59936,"_25133":59922,"_17569":102506,"_5":17464,"_23818":102468,"_2388":45066},[],{"_2861":59937,"_25133":59922,"_17569":102508,"_5":17464,"_23818":102468,"_2388":102509},[],"`Revoked`, con razón y fecha de revocación.",{"_2861":59938,"_25133":59922,"_17569":102511,"_5":17464,"_23818":102468,"_2388":102512},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2861":59939,"_25133":59922,"_17569":102514,"_5":17464,"_23818":102468,"_2388":102515},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2861":59940,"_25133":59922,"_17569":102517,"_5":17464,"_23818":102468,"_2388":102518},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2861":59941,"_25133":59922,"_17569":102520,"_5":17464,"_23818":102468,"_2388":102521},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2861":59942,"_25133":59922,"_17569":102523,"_5":17464,"_23818":102468,"_2388":102524},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2861":59943,"_25133":59922,"_17569":102526,"_5":17464,"_23818":102472,"_2388":102527},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2861":59944,"_25133":59922,"_17569":102529,"_5":17464,"_23818":102472,"_2388":102530},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2861":59945,"_25133":59922,"_17569":102532,"_5":17464,"_23818":102476,"_2388":102533},[],"El servicio acepta:",{"_2861":59946,"_25133":59922,"_17569":102535,"_5":17464,"_23818":102476,"_2388":98891},[],{"_2861":59947,"_25133":59922,"_17569":102537,"_5":17464,"_23818":102476,"_2388":102538},[],"Ruta del servicio VA",{"_2861":59948,"_25133":59922,"_17569":102540,"_5":17464,"_23818":102476,"_2388":102541},[],"Formato",{"_2861":59949,"_25133":59922,"_17569":102543,"_5":17464,"_23818":102476,"_2388":47644},[],{"_2861":59950,"_25133":59922,"_17569":102545,"_5":17464,"_23818":102476,"_2388":47647},[],{"_2861":59951,"_25133":59922,"_17569":102547,"_5":17464,"_23818":102476,"_2388":102548},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2861":59952,"_25133":59922,"_17569":102550,"_5":17464,"_23818":102476,"_2388":47133},[],{"_2861":59953,"_25133":59922,"_17569":102552,"_5":17464,"_23818":102476,"_2388":47655},[],{"_2861":59954,"_25133":59922,"_17569":102554,"_5":17464,"_23818":102476,"_2388":102555},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2861":59955,"_25133":59922,"_17569":102557,"_5":17464,"_23818":102476,"_2388":102558},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2861":59956,"_25133":59922,"_17569":102560,"_5":17464,"_23818":102480,"_2388":102561},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2861":59957,"_25133":59922,"_17569":102563,"_5":17464,"_23818":102480,"_2388":102564},[],"Genera la solicitud:",{"_2861":59958,"_25133":59922,"_17569":102566,"_5":17464,"_23818":102480,"_2388":102567},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2861":59959,"_25133":59922,"_17569":102569,"_5":17464,"_23818":102480,"_2388":102570},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2861":59960,"_25133":59922,"_17569":102572,"_5":17464,"_23818":102480,"_2388":102573},[],"Verifica el DER recibido:",{"_2861":59961,"_25133":59922,"_17569":102575,"_5":17464,"_23818":102480,"_2388":102576},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2861":59962,"_25133":59922,"_17569":102578,"_5":17464,"_23818":102484,"_2388":102579},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2861":59963,"_25133":59922,"_17569":102581,"_5":17464,"_23818":102484,"_2388":102582},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2861":59964,"_25133":59922,"_17569":102584,"_5":17464,"_23818":102488,"_2388":47688},[],{"_2861":59965,"_25133":59922,"_17569":102586,"_5":17464,"_23818":102488,"_2388":47691},[],{"_2861":59966,"_25133":59922,"_17569":102588,"_5":17464,"_23818":102488,"_2388":102589},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2861":59967,"_25133":59922,"_17569":102591,"_5":17464,"_23818":102488,"_2388":102081},[],{"_2861":59968,"_25133":59968,"_5":12309,"_2388":45871,"_25469":102593,"_17569":102594,"_23818":59968},[40834,97206,45871],[],{"_2861":59969,"_25133":59968,"_17569":102596,"_5":17464,"_23818":59968,"_2388":102597},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2861":59970,"_25133":59968,"_5":25466,"_17569":102599,"_23818":102600,"_2388":100118},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#empieza-aquí",{"_2861":59971,"_25133":59968,"_5":25466,"_17569":102602,"_23818":102603,"_2388":102604},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2861":59972,"_25133":59968,"_5":25466,"_17569":102606,"_23818":102607,"_2388":100640},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#capacidades-principales",{"_2861":59973,"_25133":59968,"_5":25466,"_17569":102609,"_23818":102610,"_2388":100644},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2861":59974,"_25133":59968,"_5":25466,"_17569":102612,"_23818":102613,"_2388":100648},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2861":59975,"_25133":59968,"_5":25466,"_17569":102615,"_23818":102616,"_2388":100652},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#emite-y-controla-certificados",{"_2861":59976,"_25133":59968,"_5":25466,"_17569":102618,"_23818":102619,"_2388":100660},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#publica-el-estado-de-validación",{"_2861":59977,"_25133":59968,"_5":25466,"_17569":102621,"_23818":102622,"_2388":102623},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2861":59978,"_25133":59968,"_5":25466,"_17569":102625,"_23818":102626,"_2388":101575},[],"/docs/pr-preview/pr-37/es/platform/pki/overview#continúa",{"_2861":59979,"_25133":59968,"_17569":102628,"_5":17464,"_23818":59968,"_2388":102629},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2861":59980,"_25133":59968,"_17569":102631,"_5":17464,"_23818":102600,"_2388":102632},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2861":59981,"_25133":59968,"_17569":102634,"_5":17464,"_23818":102600,"_2388":102635},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2861":59982,"_25133":59968,"_17569":102637,"_5":17464,"_23818":102603,"_2388":102638},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2861":59983,"_25133":59968,"_17569":102640,"_5":17464,"_23818":102603,"_2388":102641},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2861":59984,"_25133":59968,"_17569":102643,"_5":17464,"_23818":102603,"_2388":102644},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2861":59985,"_25133":59968,"_17569":102646,"_5":17464,"_23818":102603,"_2388":102647},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2861":59986,"_25133":59968,"_17569":102649,"_5":17464,"_23818":102603,"_2388":102650},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2861":59987,"_25133":59968,"_17569":102652,"_5":17464,"_23818":102610,"_2388":102653},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2861":59988,"_25133":59968,"_17569":102655,"_5":17464,"_23818":102613,"_2388":102656},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2861":59989,"_25133":59968,"_17569":102658,"_5":17464,"_23818":102616,"_2388":102659},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2861":59990,"_25133":59968,"_17569":102661,"_5":17464,"_23818":102619,"_2388":102662},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2861":59991,"_25133":59968,"_17569":102664,"_5":17464,"_23818":102622,"_2388":102665},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2861":59992,"_25133":59968,"_17569":102667,"_5":17464,"_23818":102622,"_2388":102668},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2861":59993,"_25133":59968,"_17569":102670,"_5":17464,"_23818":102622,"_2388":102671},[],"su clave pública corresponda a la clave privada del cliente;",{"_2861":59994,"_25133":59968,"_17569":102673,"_5":17464,"_23818":102622,"_2388":102674},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2861":59995,"_25133":59968,"_17569":102676,"_5":17464,"_23818":102622,"_2388":102677},[],"sus fechas y usos permitan la operación;",{"_2861":59996,"_25133":59968,"_17569":102679,"_5":17464,"_23818":102622,"_2388":102680},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2861":59997,"_25133":59968,"_17569":102682,"_5":17464,"_23818":102622,"_2388":102683},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2861":59998,"_25133":59968,"_17569":102685,"_5":17464,"_23818":102626,"_2388":102686},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2861":59999,"_25133":59968,"_17569":102688,"_5":17464,"_23818":102626,"_2388":102689},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2861":60000,"_25133":59968,"_17569":102691,"_5":17464,"_23818":102626,"_2388":102692},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2861":60001,"_25133":60001,"_5":12309,"_2388":102694,"_25469":102695,"_17569":102696,"_23818":60001},"Crea tu primera CA",[40834,97206,45871,100242],[],{"_2861":60002,"_25133":60001,"_17569":102698,"_5":17464,"_23818":60001,"_2388":102699},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2861":60003,"_25133":60001,"_5":25466,"_17569":102701,"_23818":102702,"_2388":95907},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2861":60004,"_25133":60001,"_5":25466,"_17569":102704,"_23818":102705,"_2388":102706},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2861":60005,"_25133":60001,"_5":25466,"_17569":102708,"_23818":102709,"_2388":102710},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2861":60006,"_25133":60001,"_5":25466,"_17569":102712,"_23818":102713,"_2388":102714},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2861":60007,"_25133":60001,"_5":25466,"_17569":102716,"_23818":102717,"_2388":102718},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2861":60008,"_25133":60001,"_5":25466,"_17569":102720,"_23818":102721,"_2388":102722},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2861":60009,"_25133":60001,"_5":25466,"_17569":102724,"_23818":102725,"_2388":102726},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2861":60010,"_25133":60001,"_5":25466,"_17569":102728,"_23818":102729,"_2388":100490},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2861":60011,"_25133":60001,"_5":25466,"_17569":102731,"_23818":102732,"_2388":95931},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2861":60012,"_25133":60001,"_17569":102734,"_5":17464,"_23818":60001,"_2388":102735},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2861":60013,"_25133":60001,"_17569":102737,"_5":17464,"_23818":102702,"_2388":102738},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2861":60014,"_25133":60001,"_17569":102740,"_5":17464,"_23818":102702,"_2388":102741},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2861":60015,"_25133":60001,"_17569":102743,"_5":17464,"_23818":102702,"_2388":102744},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2861":60016,"_25133":60001,"_17569":102746,"_5":17464,"_23818":102702,"_2388":102747},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2861":60017,"_25133":60001,"_17569":102749,"_5":17464,"_23818":102705,"_2388":102750},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2861":60018,"_25133":60001,"_17569":102752,"_5":17464,"_23818":102705,"_2388":102753},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2861":60019,"_25133":60001,"_17569":102755,"_5":17464,"_23818":102709,"_2388":102756},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2861":60020,"_25133":60001,"_17569":102758,"_5":17464,"_23818":102709,"_2388":102759},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2861":60021,"_25133":60001,"_17569":102761,"_5":17464,"_23818":102713,"_2388":102762},[],"Selecciona **Root CA** y completa:",{"_2861":60022,"_25133":60001,"_17569":102764,"_5":17464,"_23818":102713,"_2388":47870},[],{"_2861":60023,"_25133":60001,"_17569":102766,"_5":17464,"_23818":102713,"_2388":102767},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2861":60024,"_25133":60001,"_17569":102769,"_5":17464,"_23818":102713,"_2388":102770},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2861":60025,"_25133":60001,"_17569":102772,"_5":17464,"_23818":102713,"_2388":102773},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2861":60026,"_25133":60001,"_17569":102775,"_5":17464,"_23818":102713,"_2388":102776},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2861":60027,"_25133":60001,"_17569":102778,"_5":17464,"_23818":102717,"_2388":102779},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2861":60028,"_25133":60001,"_17569":102781,"_5":17464,"_23818":102721,"_2388":102782},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2861":60029,"_25133":60001,"_17569":102784,"_5":17464,"_23818":102721,"_2388":102785},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2861":60030,"_25133":60001,"_17569":102787,"_5":17464,"_23818":102725,"_2388":102788},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2861":60031,"_25133":60001,"_17569":102790,"_5":17464,"_23818":102725,"_2388":102791},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2861":60032,"_25133":60001,"_17569":102793,"_5":17464,"_23818":102725,"_2388":102794},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2861":60033,"_25133":60001,"_17569":102796,"_5":17464,"_23818":102729,"_2388":102797},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2861":60034,"_25133":60001,"_17569":102799,"_5":17464,"_23818":102729,"_2388":102800},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2861":60035,"_25133":60001,"_17569":102802,"_5":17464,"_23818":102729,"_2388":102803},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2861":60036,"_25133":60001,"_17569":102805,"_5":17464,"_23818":102729,"_2388":102806},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2861":60037,"_25133":60001,"_17569":102808,"_5":17464,"_23818":102732,"_2388":102809},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2861":60038,"_25133":60038,"_5":12309,"_2388":102811,"_25469":102812,"_17569":102813,"_23818":60038},"Emite y verifica un certificado",[40834,97206,45871,100242],[],{"_2861":60039,"_25133":60038,"_17569":102815,"_5":17464,"_23818":60038,"_2388":102816},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2861":60040,"_25133":60038,"_5":25466,"_17569":102818,"_23818":102819,"_2388":95907},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2861":60041,"_25133":60038,"_5":25466,"_17569":102821,"_23818":102822,"_2388":102823},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2861":60042,"_25133":60038,"_5":25466,"_17569":102825,"_23818":102826,"_2388":102827},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2861":60043,"_25133":60038,"_5":25466,"_17569":102829,"_23818":102830,"_2388":102831},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2861":60044,"_25133":60038,"_5":25466,"_17569":102833,"_23818":102834,"_2388":102835},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2861":60045,"_25133":60038,"_5":25466,"_17569":102837,"_23818":102838,"_2388":102839},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2861":60046,"_25133":60038,"_5":25466,"_17569":102841,"_23818":102842,"_2388":102722},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2861":60047,"_25133":60038,"_5":25466,"_17569":102844,"_23818":102845,"_2388":102846},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2861":60048,"_25133":60038,"_5":25466,"_17569":102848,"_23818":102849,"_2388":102850},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2861":60049,"_25133":60038,"_5":25466,"_17569":102852,"_23818":102853,"_2388":102854},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2861":60050,"_25133":60038,"_5":25466,"_17569":102856,"_23818":102857,"_2388":100490},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2861":60051,"_25133":60038,"_5":25466,"_17569":102859,"_23818":102860,"_2388":95931},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2861":60052,"_25133":60038,"_17569":102862,"_5":17464,"_23818":60038,"_2388":102863},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2861":60053,"_25133":60038,"_17569":102865,"_5":17464,"_23818":102819,"_2388":102866},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2861":60054,"_25133":60038,"_17569":102868,"_5":17464,"_23818":102819,"_2388":102869},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2861":60055,"_25133":60038,"_17569":102871,"_5":17464,"_23818":102819,"_2388":102872},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2861":60056,"_25133":60038,"_17569":102874,"_5":17464,"_23818":102819,"_2388":102875},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2861":60057,"_25133":60038,"_17569":102877,"_5":17464,"_23818":102819,"_2388":102878},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2861":60058,"_25133":60038,"_17569":102880,"_5":17464,"_23818":102822,"_2388":102881},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2861":60059,"_25133":60038,"_17569":102883,"_5":17464,"_23818":102826,"_2388":102884},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2861":60060,"_25133":60038,"_17569":102886,"_5":17464,"_23818":102826,"_2388":102887},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2861":60061,"_25133":60038,"_17569":102889,"_5":17464,"_23818":102830,"_2388":102890},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2861":60062,"_25133":60038,"_17569":102892,"_5":17464,"_23818":102830,"_2388":102893},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2861":60063,"_25133":60038,"_17569":102895,"_5":17464,"_23818":102834,"_2388":102896},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2861":60064,"_25133":60038,"_17569":102898,"_5":17464,"_23818":102834,"_2388":102899},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2861":60065,"_25133":60038,"_17569":102901,"_5":17464,"_23818":102838,"_2388":102902},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2861":60066,"_25133":60038,"_17569":102904,"_5":17464,"_23818":102842,"_2388":102905},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2861":60067,"_25133":60038,"_17569":102907,"_5":17464,"_23818":102845,"_2388":102908},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2861":60068,"_25133":60038,"_17569":102910,"_5":17464,"_23818":102849,"_2388":102911},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2861":60069,"_25133":60038,"_17569":102913,"_5":17464,"_23818":102849,"_2388":102914},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2861":60070,"_25133":60038,"_17569":102916,"_5":17464,"_23818":102849,"_2388":102917},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2861":60071,"_25133":60038,"_17569":102919,"_5":17464,"_23818":102853,"_2388":102920},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2861":60072,"_25133":60038,"_17569":102922,"_5":17464,"_23818":102853,"_2388":102923},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2861":60073,"_25133":60038,"_17569":102925,"_5":17464,"_23818":102853,"_2388":102926},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2861":60074,"_25133":60038,"_17569":102928,"_5":17464,"_23818":102857,"_2388":100573},[],{"_2861":60075,"_25133":60038,"_17569":102930,"_5":17464,"_23818":102857,"_2388":99340},[],{"_2861":60076,"_25133":60038,"_17569":102932,"_5":17464,"_23818":102857,"_2388":102933},[],"La CA rechaza la emisión",{"_2861":60077,"_25133":60038,"_17569":102935,"_5":17464,"_23818":102857,"_2388":102936},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2861":60078,"_25133":60038,"_17569":102938,"_5":17464,"_23818":102857,"_2388":102939},[],"Sujeto o usos diferentes",{"_2861":60079,"_25133":60038,"_17569":102941,"_5":17464,"_23818":102857,"_2388":102942},[],"Perfil aplicado y valores solicitados.",{"_2861":60080,"_25133":60038,"_17569":102944,"_5":17464,"_23818":102857,"_2388":102945},[],"No se encuentra el emisor",{"_2861":60081,"_25133":60038,"_17569":102947,"_5":17464,"_23818":102857,"_2388":102948},[],"CA descargada y cadena intermedia necesaria.",{"_2861":60082,"_25133":60038,"_17569":102950,"_5":17464,"_23818":102857,"_2388":102951},[],"Falla la vigencia",{"_2861":60083,"_25133":60038,"_17569":102953,"_5":17464,"_23818":102857,"_2388":102954},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2861":60084,"_25133":60038,"_17569":102956,"_5":17464,"_23818":102857,"_2388":102957},[],"Los resúmenes de clave difieren",{"_2861":60085,"_25133":60038,"_17569":102959,"_5":17464,"_23818":102857,"_2388":102960},[],"Archivos de certificado y clave de la misma emisión.",{"_2861":60086,"_25133":60038,"_17569":102962,"_5":17464,"_23818":102857,"_2388":102963},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2861":60087,"_25133":60038,"_17569":102965,"_5":17464,"_23818":102860,"_2388":102966},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2861":60088,"_25133":60038,"_17569":102968,"_5":17464,"_23818":102860,"_2388":102969},[],"Gestionar certificados para inspección, estado y revocación.",{"_2861":60089,"_25133":60038,"_17569":102971,"_5":17464,"_23818":102860,"_2388":102972},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2861":60090,"_25133":60038,"_17569":102974,"_5":17464,"_23818":102860,"_2388":102975},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2861":60091,"_25133":60038,"_17569":102977,"_5":17464,"_23818":102860,"_2388":102978},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2861":60092,"_25133":60092,"_5":12309,"_2388":102980,"_25469":102981,"_17569":102982,"_23818":60092},"Primeros pasos de PKI",[40834,97206,45871,100242],[],{"_2861":60093,"_25133":60092,"_17569":102984,"_5":17464,"_23818":60092,"_2388":102985},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2861":60094,"_25133":60092,"_5":25466,"_17569":102987,"_23818":102988,"_2388":95907},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2861":60095,"_25133":60092,"_5":25466,"_17569":102990,"_23818":102991,"_2388":102992},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2861":60096,"_25133":60092,"_5":25466,"_17569":102994,"_23818":102995,"_2388":100424},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2861":60097,"_25133":60092,"_5":25466,"_17569":102997,"_23818":102998,"_2388":102999},[],"/docs/pr-preview/pr-37/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2861":60098,"_25133":60092,"_17569":103001,"_5":17464,"_23818":60092,"_2388":103002},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2861":60099,"_25133":60092,"_17569":103004,"_5":17464,"_23818":102988,"_2388":103005},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2861":60100,"_25133":60092,"_17569":103007,"_5":17464,"_23818":102988,"_2388":103008},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2861":60101,"_25133":60092,"_17569":103010,"_5":17464,"_23818":102988,"_2388":103011},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2861":60102,"_25133":60092,"_17569":103013,"_5":17464,"_23818":102988,"_2388":103014},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2861":60103,"_25133":60092,"_17569":103016,"_5":17464,"_23818":102988,"_2388":103017},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2861":60104,"_25133":60092,"_17569":103019,"_5":17464,"_23818":102991,"_2388":103020},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2861":60105,"_25133":60092,"_17569":103022,"_5":17464,"_23818":102991,"_2388":103023},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2861":60106,"_25133":60092,"_17569":103025,"_5":17464,"_23818":102991,"_2388":103026},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2861":60107,"_25133":60092,"_17569":103028,"_5":17464,"_23818":102991,"_2388":103029},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2861":60108,"_25133":60092,"_17569":103031,"_5":17464,"_23818":102995,"_2388":103032},[],"Archivo o recurso",{"_2861":60109,"_25133":60092,"_17569":103034,"_5":17464,"_23818":102995,"_2388":100421},[],{"_2861":60110,"_25133":60092,"_17569":103036,"_5":17464,"_23818":102995,"_2388":103037},[],"CA raíz activa y `ca.pem`",{"_2861":60111,"_25133":60092,"_17569":103039,"_5":17464,"_23818":102995,"_2388":103040},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2861":60112,"_25133":60092,"_17569":103042,"_5":17464,"_23818":102995,"_2388":103043},[],"Certificado final y `device.crt`",{"_2861":60113,"_25133":60092,"_17569":103045,"_5":17464,"_23818":102995,"_2388":103046},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2861":60114,"_25133":60092,"_17569":103048,"_5":17464,"_23818":102995,"_2388":103049},[],"Clave privada `device.key`",{"_2861":60115,"_25133":60092,"_17569":103051,"_5":17464,"_23818":102995,"_2388":103052},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2861":60116,"_25133":60092,"_17569":103054,"_5":17464,"_23818":102995,"_2388":103055},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2861":60117,"_25133":60092,"_17569":103057,"_5":17464,"_23818":102998,"_2388":103058},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2861":60118,"_25133":60092,"_17569":103060,"_5":17464,"_23818":102998,"_2388":103061},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2861":60119,"_25133":60092,"_17569":103063,"_5":17464,"_23818":102998,"_2388":103064},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2861":60120,"_25133":60120,"_5":12309,"_2388":103066,"_25469":103067,"_17569":103069,"_23818":60120},"Resolución de problemas PKI",[40834,97206,45871,103068],"Resolución de problemas",[],{"_2861":60121,"_25133":60120,"_17569":103071,"_5":17464,"_23818":60120,"_2388":103072},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2861":60122,"_25133":60120,"_5":25466,"_17569":103074,"_23818":103075,"_2388":103076},[],"/docs/pr-preview/pr-37/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2861":60123,"_25133":60120,"_5":25466,"_17569":103078,"_23818":103079,"_2388":103080},[],"/docs/pr-preview/pr-37/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2861":60124,"_25133":60120,"_5":25466,"_17569":103082,"_23818":103083,"_2388":103084},[],"/docs/pr-preview/pr-37/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2861":60125,"_25133":60120,"_17569":103086,"_5":17464,"_23818":60120,"_2388":103087},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2861":60126,"_25133":60120,"_17569":103089,"_5":17464,"_23818":60120,"_2388":103090},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2861":60127,"_25133":60120,"_17569":103092,"_5":17464,"_23818":103075,"_2388":100421},[],{"_2861":60128,"_25133":60120,"_17569":103094,"_5":17464,"_23818":103075,"_2388":99340},[],{"_2861":60129,"_25133":60120,"_17569":103096,"_5":17464,"_23818":103075,"_2388":95931},[],{"_2861":60130,"_25133":60120,"_17569":103098,"_5":17464,"_23818":103075,"_2388":48206},[],{"_2861":60131,"_25133":60120,"_17569":103100,"_5":17464,"_23818":103075,"_2388":103101},[],"Existe, está activa y sus fechas son utilizables.",{"_2861":60132,"_25133":60120,"_17569":103103,"_5":17464,"_23818":103075,"_2388":103104},[],"Autoridades.",{"_2861":60133,"_25133":60120,"_17569":103106,"_5":17464,"_23818":103075,"_2388":103107},[],"Clave",{"_2861":60134,"_25133":60120,"_17569":103109,"_5":17464,"_23818":103075,"_2388":103110},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2861":60135,"_25133":60120,"_17569":103112,"_5":17464,"_23818":103075,"_2388":103113},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2861":60136,"_25133":60120,"_17569":103115,"_5":17464,"_23818":103075,"_2388":48224},[],{"_2861":60137,"_25133":60120,"_17569":103117,"_5":17464,"_23818":103075,"_2388":103118},[],"PEM correcto y firma verificable.",{"_2861":60138,"_25133":60120,"_17569":103120,"_5":17464,"_23818":103075,"_2388":48230},[],{"_2861":60139,"_25133":60120,"_17569":103122,"_5":17464,"_23818":103075,"_2388":103123},[],"Perfil",{"_2861":60140,"_25133":60120,"_17569":103125,"_5":17464,"_23818":103075,"_2388":103126},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2861":60141,"_25133":60120,"_17569":103128,"_5":17464,"_23818":103075,"_2388":103129},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2861":60142,"_25133":60120,"_17569":103131,"_5":17464,"_23818":103075,"_2388":100573},[],{"_2861":60143,"_25133":60120,"_17569":103133,"_5":17464,"_23818":103075,"_2388":103134},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2861":60144,"_25133":60120,"_17569":103136,"_5":17464,"_23818":103075,"_2388":103137},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2861":60145,"_25133":60120,"_17569":103139,"_5":17464,"_23818":103075,"_2388":103140},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2861":60146,"_25133":60120,"_17569":103142,"_5":17464,"_23818":103075,"_2388":103143},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2861":60147,"_25133":60120,"_17569":103145,"_5":17464,"_23818":103079,"_2388":103146},[],"Revisa cada frontera por separado:",{"_2861":60148,"_25133":60120,"_17569":103148,"_5":17464,"_23818":103079,"_2388":103149},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2861":60149,"_25133":60120,"_17569":103151,"_5":17464,"_23818":103079,"_2388":103152},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2861":60150,"_25133":60120,"_17569":103154,"_5":17464,"_23818":103079,"_2388":103155},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2861":60151,"_25133":60120,"_17569":103157,"_5":17464,"_23818":103079,"_2388":103158},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2861":60152,"_25133":60120,"_17569":103160,"_5":17464,"_23818":103079,"_2388":103161},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2861":60153,"_25133":60120,"_17569":103163,"_5":17464,"_23818":103079,"_2388":103164},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2861":60154,"_25133":60120,"_17569":103166,"_5":17464,"_23818":103083,"_2388":103167},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2861":60155,"_25133":60120,"_17569":103169,"_5":17464,"_23818":103083,"_2388":103170},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_48284":103172,"_48286":103173,"_48288":103174,"_48290":103175,"_15242":2410,"_57781":2410},"spanish",[2388,25133,5,23818],{"_2388":20962,"_25133":20962,"_5":20962,"_23818":20962},{"_2388":103176,"_25133":105547,"_5":107918,"_23818":110289},{"_3836":103177,"_48294":103178,"_5":20962},{"_12049":23820,"_12397":5704,"_12404":6140,"_24364":6306,"_23931":6206,"_16670":3622,"_12070":2751,"_12077":2745,"_24326":5313,"_24676":7085,"_24697":16933,"_24339":6169,"_28931":9227,"_24708":6907,"_28936":5152,"_28939":2547,"_28942":6207,"_28945":13832,"_28948":16925,"_25009":2709,"_28953":2630,"_28955":5061,"_25039":3805,"_24999":2673,"_28959":13114,"_28962":20350,"_28964":4014,"_24726":13237,"_25004":4927,"_25057":5740,"_28969":5739,"_28971":2727,"_28973":7974,"_28975":11862,"_28977":2699,"_28979":5050,"_25191":5711,"_28982":9226,"_28984":19867,"_24377":14262,"_28987":4235,"_28989":6266,"_24371":3754,"_28992":4867,"_28994":10600,"_28996":3553,"_28999":5089,"_24407":4215,"_29003":9230,"_24317":2625,"_29006":3821,"_24344":3361,"_29009":6165,"_29011":9221,"_29014":3906,"_25034":7775,"_29017":6209,"_29019":10204,"_29022":3820,"_29024":11901,"_29026":4791,"_29028":5750,"_29030":4940,"_16673":4239,"_29033":3434,"_29035":4868,"_29037":11903,"_24720":3917,"_29040":5421,"_29042":2451,"_29044":4435,"_29046":6048,"_29048":4512,"_29050":6689,"_29052":262