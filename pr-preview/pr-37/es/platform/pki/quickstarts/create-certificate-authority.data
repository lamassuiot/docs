as.mdx","es:deployment",{"_200":427},"deployment/meta.json","<link rel=\"preload\" as=\"image\" href=\"/docs/pr-preview/pr-37/images/kubernetes.svg\"/><img src=\"/docs/pr-preview/pr-37/images/kubernetes.svg\" width=\"20\" height=\"20\" style=\"width:1.25rem;height:1.25rem;vertical-align:middle;flex-shrink:0;object-fit:contain\"/>","fallback"]
