e_id":"/docs/pr-preview/pr-38/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","content":"Reduce use of the bootstrap administrator"},"453":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-22","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/access-control#fastlane-bootstrap","content":"Fastlane bootstrap"},"454":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-23","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/access-control#design-least-privilege-roles","content":"Design least-privilege roles"},"455":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-24","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/access-control#changes-and-access-revocation","content":"Changes and access revocation"},"456":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-25","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/access-control#operational-checklist","content":"Operational checklist"},"457":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-26","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/access-control#diagnostics","content":"Diagnostics"},"458":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-27","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/access-control#the-response-is-401","content":"The response is 401"},"459":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-28","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/access-control#the-response-is-403","content":"The response is 403"},"460":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-29","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/access-control#everything-returns-403","content":"Everything returns 403"},"461":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-30","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/access-control#access-appears-without-a-policy-grant","content":"Access appears without a policy grant"},"462":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-31","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/access-control#everything-fails-when-authz-is-unavailable","content":"Everything fails when authz is unavailable"},"463":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-32","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control","content":"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**."},"464":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-33","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control","content":"Lamassu does not assign permissions directly to users. The full chain is:"},"465":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-34","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control","content":"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider."},"466":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-35","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#essential-concepts","content":"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled."},"467":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-36","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#essential-concepts","content":"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both."},"468":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-37","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#essential-concepts","content":"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute."},"469":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-38","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#essential-concepts","content":"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter."},"470":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-39","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#essential-concepts","content":"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals."},"471":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-40","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#essential-concepts","content":"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions."},"472":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-41","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#two-decision-systems","content":"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way."},"473":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-42","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#two-decision-systems","content":"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries."},"474":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-43","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#integrated-or-external-http-services","content":"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema."},"475":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-44","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#integrated-or-external-http-services","content":"The decision is made **before forwarding the request to the service**:"},"476":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-45","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#integrated-or-external-http-services","content":"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS."},"477":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-46","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#integrated-or-external-http-services","content":"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`."},"478":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-47","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#integrated-or-external-http-services","content":"`authz` extracts the credential and resolves all active principals matching it."},"479":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-48","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#integrated-or-external-http-services","content":"It separately loads the policies granted to each principal."},"480":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-49","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#integrated-or-external-http-services","content":"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`."},"481":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-50","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#integrated-or-external-http-services","content":"`authz` looks for an HTTP rule granting that action."},"482":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-51","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#integrated-or-external-http-services","content":"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values."},"483":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-52","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#integrated-or-external-http-services","content":"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway."},"484":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-53","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#integrated-or-external-http-services","content":"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context."},"485":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-54","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#integrated-or-external-http-services","content":"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it."},"486":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-55","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"Two schema-level settings cover endpoints that policies do not mention:"},"487":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-56","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request."},"488":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-57","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal."},"489":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-58","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:"},"490":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-59","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`."},"491":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-60","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides."},"492":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-61","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load."},"493":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-62","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service."},"494":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-63","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#services-developed-by-lamassu","content":"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others."},"495":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-64","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#services-developed-by-lamassu","content":"The decision is made with the domain operation context:"},"496":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-65","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#services-developed-by-lamassu","content":"The middleware extracts the credential and resolves the matching principals."},"497":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-66","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#services-developed-by-lamassu","content":"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource."},"498":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-67","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#services-developed-by-lamassu","content":"`authz` gathers the entity rules of the granted policies."},"499":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-68","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#services-developed-by-lamassu","content":"The engine evaluates direct grants, attribute filters and relations with other entities."},"500":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-69","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#services-developed-by-lamassu","content":"For an individual operation, it checks that the concrete resource satisfies the computed scope."},"501":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-70","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#services-developed-by-lamassu","content":"For a listing, it generates a SQL filter that the service adds to its own query."},"502":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-71","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#services-developed-by-lamassu","content":"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**."},"503":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-72","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#services-developed-by-lamassu","content":"Actions fall into two groups:"},"504":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-73","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#services-developed-by-lamassu","content":"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples."},"505":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-74","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#services-developed-by-lamassu","content":"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations."},"506":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-75","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#services-developed-by-lamassu","content":"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface."},"507":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-76","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#how-the-two-paths-relate","content":"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services."},"508":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-77","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#how-the-two-paths-relate","content":"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity."},"509":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-78","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#how-the-two-paths-relate","content":"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes."},"510":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-79","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#oidc-principals","content":"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens."},"511":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-80","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#oidc-principals","content":"The following principal represents any identity holding the `pki-operators` role in Keycloak:"},"512":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-81","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#oidc-principals","content":"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time."},"513":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-82","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#oidc-principals","content":"The implemented operators are:"},"514":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-83","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#oidc-principals","content":"`equals`, for exact equality;"},"515":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-84","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#oidc-principals","content":"`contains`, to check membership in a list or the presence of text in a scalar value."},"516":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-85","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#oidc-principals","content":"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's."},"517":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-86","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#oidc-principals","content":"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`."},"518":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-87","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#x509-principals","content":"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name."},"519":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-88","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#x509-principals","content":"The available modes are:"},"520":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-89","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#x509-principals","content":"`serial_and_ca`: an exact certificate, identified by serial number and CA;"},"521":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-90","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#x509-principals","content":"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;"},"522":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-91","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#x509-principals","content":"`any_from_ca`: any certificate issued directly by the given CA."},"523":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-92","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#x509-principals","content":"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:"},"524":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-93","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#x509-principals","content":"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA."},"525":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-94","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#x509-principals","content":"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs."},"526":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-95","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#when-several-principals-match","content":"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function."},"527":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-96","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#when-several-principals-match","content":"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them."},"528":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-97","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#when-several-principals-match","content":"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another."},"529":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-98","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#when-several-principals-match","content":"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive."},"530":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-99","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#global-and-direct-access","content":"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations."},"531":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-100","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#global-and-direct-access","content":"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible."},"532":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-101","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#access-inherited-through-relations","content":"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources."},"533":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-102","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#access-inherited-through-relations","content":"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy."},"534":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-103","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#attribute-filtered-access","content":"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND."},"535":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-104","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#attribute-filtered-access","content":"For example, this rule allows reading active certificates issued by a specific CA:"},"536":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-105","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#attribute-filtered-access","content":"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values."},"537":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-106","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#http-rules","content":"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs."},"538":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-107","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#http-rules","content":"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`."},"539":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-108","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#http-rules","content":"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases."},"540":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-109","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#http-rules","content":"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:"},"541":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-110","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#http-rules","content":"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`."},"542":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-111","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#http-rules","content":"Note that:"},"543":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-112","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#http-rules","content":"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`."},"544":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-113","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#http-rules","content":"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied."},"545":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-114","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#http-rules","content":"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass."},"546":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-115","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#included-policies","content":"The `authz` preload installs reusable policies for the main domains. Among them are:"},"547":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-116","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#included-policies","content":"full and read-only access to certificates and authorities;"},"548":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-117","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#included-policies","content":"full and read-only access to the KMS;"},"549":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-118","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#included-policies","content":"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;"},"550":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-119","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#included-policies","content":"an `Auditor` policy with PKI read access and authorization visibility;"},"551":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-120","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#included-policies","content":"console access;"},"552":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-121","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#included-policies","content":"administration and observation policies for the Job Manager NBI and SBI APIs;"},"553":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-122","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#included-policies","content":"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains."},"554":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-123","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#included-policies","content":"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions."},"555":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-124","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#provision-the-first-administrator","content":"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform."},"556":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-125","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#provision-the-first-administrator","content":"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API."},"557":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-126","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#provision-the-first-administrator","content":"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades."},"558":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-127","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#prepare-the-identity-provider","content":"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`."},"559":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-128","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#configure-the-two-jwt-validations","content":"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components."},"560":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-129","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#install-and-verify-administrative-access","content":"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation."},"561":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-130","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#test-an-unprivileged-identity","content":"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations."},"562":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-131","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","content":"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work."},"563":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-132","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#fastlane-bootstrap","content":"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`."},"564":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-133","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#fastlane-bootstrap","content":"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design."},"565":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-134","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#design-least-privilege-roles","content":"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:"},"566":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-135","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#design-least-privilege-roles","content":"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group."},"567":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-136","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#design-least-privilege-roles","content":"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access."},"568":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-137","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#design-least-privilege-roles","content":"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration."},"569":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-138","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#design-least-privilege-roles","content":"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting."},"570":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-139","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#design-least-privilege-roles","content":"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls."},"571":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-140","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#design-least-privilege-roles","content":"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions."},"572":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-141","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#design-least-privilege-roles","content":"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade."},"573":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-142","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#changes-and-access-revocation","content":"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching."},"574":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-143","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#changes-and-access-revocation","content":"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider."},"575":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-144","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#changes-and-access-revocation","content":"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one."},"576":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-145","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#operational-checklist","content":"Keep `failOpen: false` unless a documented risk assessment justifies otherwise."},"577":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-146","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#operational-checklist","content":"Use groups or stable roles for people and independent identities for automations."},"578":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-147","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#operational-checklist","content":"Keep at least two recovery administrators and test their access periodically."},"579":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-148","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#operational-checklist","content":"Review active principals, their matches and their grants after IdP changes."},"580":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-149","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#operational-checklist","content":"Search for wildcards in policies before upgrading Lamassu."},"581":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-150","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#operational-checklist","content":"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service."},"582":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-151","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#operational-checklist","content":"Always test one allowed and one denied operation for each role."},"583":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-152","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#operational-checklist","content":"Correlate changes to principals, policies and grants with the audit logs."},"584":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-153","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#the-response-is-401","content":"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential."},"585":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-154","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#the-response-is-403","content":"The credential could be processed but did not produce a positive authorization. Review in this order:"},"586":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-155","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#the-response-is-403","content":"that an active principal of the correct type exists;"},"587":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-156","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#the-response-is-403","content":"that the claim paths and values match the real token exactly;"},"588":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-157","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#the-response-is-403","content":"that all of the principal's conditions hold;"},"589":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-158","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#the-response-is-403","content":"that the principal has the expected policy granted;"},"590":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-159","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#the-response-is-403","content":"that the policy includes the action and the requested resource type or route;"},"591":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-160","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#the-response-is-403","content":"that the identifier, relation, column filter or HTTP constraint includes the real resource."},"592":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-161","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#the-response-is-403","content":"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace."},"593":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-162","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#everything-returns-403","content":"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster."},"594":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-163","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#access-appears-without-a-policy-grant","content":"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants."},"595":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-164","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#everything-fails-when-authz-is-unavailable","content":"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision."},"596":{"id":"/docs/pr-preview/pr-38/platform/administration/access-control-165","page_id":"/docs/pr-preview/pr-38/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/access-control#everything-fails-when-authz-is-unavailable","content":"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment."},"597":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","type":"page","content":"Alerts and subscriptions","breadcrumbs":["Docs","Platform","Administration"],"tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/alerts"},"598":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-0","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts","content":"Send PKI events to people and external systems."},"599":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-1","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/alerts#how-it-works","content":"How it works"},"600":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-2","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/alerts#available-channels","content":"Available channels"},"601":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-3","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/alerts#create-a-subscription","content":"Create a subscription"},"602":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-4","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/alerts#choose-the-event","content":"Choose the event"},"603":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-5","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/alerts#configure-the-destination","content":"Configure the destination"},"604":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-6","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/alerts#limit-the-notifications","content":"Limit the notifications"},"605":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-7","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/alerts#review-and-activate","content":"Review and activate"},"606":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-8","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/alerts#webhook-delivery-rules","content":"Webhook delivery rules"},"607":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-9","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/alerts#manage-a-subscription","content":"Manage a subscription"},"608":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-10","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/alerts#event-families","content":"Event families"},"609":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-11","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts","content":"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes."},"610":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-12","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#how-it-works","content":"A service publishes a domain event."},"611":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-13","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#how-it-works","content":"Lamassu evaluates the subscriptions associated with that event type."},"612":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-14","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#how-it-works","content":"Each subscription's filter decides whether it should be notified."},"613":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-15","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#how-it-works","content":"Lamassu delivers the event to the configured channel."},"614":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-16","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#how-it-works","content":"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter."},"615":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-17","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#available-channels","content":"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup."},"616":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-18","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#available-channels","content":"**Microsoft Teams** posts the notification to a channel through its webhook URL."},"617":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-19","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#available-channels","content":"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`."},"618":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-20","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#available-channels","content":"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:"},"619":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-21","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#available-channels","content":"`apikey_options` requires `header` and `key`."},"620":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-22","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#available-channels","content":"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`."},"621":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-23","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#available-channels","content":"`mtls_options` requires the inline PEM `cert_content` and `key_content`; values that reference files on the server are rejected."},"622":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-24","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#available-channels","content":"The alerts API reference documents the full `http_client` schema."},"623":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-25","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#choose-the-event","content":"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on."},"624":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-26","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#configure-the-destination","content":"Select Email, Microsoft Teams or Webhook and enter the channel details."},"625":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-27","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#limit-the-notifications","content":"Add a filter if you don't want to receive every instance of the event."},"626":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-28","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#limit-the-notifications","content":"**None** notifies all instances of the event."},"627":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-29","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#limit-the-notifications","content":"**JSON Path** evaluates one or more specific fields."},"628":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-30","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#limit-the-notifications","content":"**JSON Schema** accepts only payloads with a particular structure."},"629":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-31","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#limit-the-notifications","content":"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`."},"630":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-32","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#limit-the-notifications","content":"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity."},"631":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-33","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#review-and-activate","content":"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery."},"632":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-34","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#webhook-delivery-rules","content":"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:"},"633":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-35","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#webhook-delivery-rules","content":"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery."},"634":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-36","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#webhook-delivery-rules","content":"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working."},"635":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-37","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#webhook-delivery-rules","content":"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected."},"636":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-38","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#webhook-delivery-rules","content":"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body."},"637":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-39","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#webhook-delivery-rules","content":"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive."},"638":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-40","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#webhook-delivery-rules","content":"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created."},"639":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-41","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#webhook-delivery-rules","content":"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises."},"640":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-42","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#manage-a-subscription","content":"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints."},"641":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-43","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#event-families","content":"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`."},"642":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-44","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#event-families","content":"**Certificates:** `ca.sign.certificate` and `certificate.delete`."},"643":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-45","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#event-families","content":"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`."},"644":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-46","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#event-families","content":"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`."},"645":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-47","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#event-families","content":"**Devices:** `device.create`, `device.identity.update` and `device.status.update`."},"646":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-48","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#event-families","content":"**Validation:** `va.role.crl.create`."},"647":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-49","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#event-families","content":"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`."},"648":{"id":"/docs/pr-preview/pr-38/platform/administration/alerts-50","page_id":"/docs/pr-preview/pr-38/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/alerts#event-families","content":"Use the catalog shown in the console as the source for the types available in your deployed version."},"649":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","type":"page","content":"Audit logs","breadcrumbs":["Docs","Platform","Administration"],"tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/audit-logs"},"650":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-0","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs","content":"Understand which audit events Lamassu generates and how to turn them into a durable trail."},"651":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-1","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#what-an-event-contains","content":"What an event contains"},"652":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-2","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#coverage","content":"Coverage"},"653":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-3","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#publication-and-persistence","content":"Publication and persistence"},"654":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-4","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#sensitive-data","content":"Sensitive data"},"655":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-5","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#a-reproducible-investigation","content":"A reproducible investigation"},"656":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-6","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#bound-the-interval","content":"Bound the interval"},"657":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-7","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#identify-the-operation","content":"Identify the operation"},"658":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-8","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#attribute-the-principal","content":"Attribute the principal"},"659":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-9","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#compare-intent-and-result","content":"Compare intent and result"},"660":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-10","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#follow-the-effect","content":"Follow the effect"},"661":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-11","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#periodic-verification","content":"Periodic verification"},"662":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-12","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs","content":"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error."},"663":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-13","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#what-an-event-contains","content":"The audit body includes:"},"664":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-14","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#what-an-event-contains","content":"input: data received by the operation;"},"665":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-15","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#what-an-event-contains","content":"has\\_error: whether the service returned an error;"},"666":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-16","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#what-an-event-contains","content":"output: produced result or error message;"},"667":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-17","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#what-an-event-contains","content":"principals: identifiers of the principals that matched the request."},"668":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-18","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#what-an-event-contains","content":"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type."},"669":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-19","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#what-an-event-contains","content":"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes."},"670":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-20","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#coverage","content":"The backend applies auditing to mutations of:"},"671":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-21","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#coverage","content":"authorities, certificates and issuance profiles;"},"672":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-22","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#coverage","content":"keys and KMS engines;"},"673":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-23","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#coverage","content":"devices and identities;"},"674":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-24","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#coverage","content":"DMSs and enrollment operations;"},"675":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-25","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#coverage","content":"validation functions and CRL;"},"676":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-26","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#coverage","content":"principals, policies and authorization grants."},"677":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-27","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#coverage","content":"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation."},"678":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-28","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#publication-and-persistence","content":"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file."},"679":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-29","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#publication-and-persistence","content":"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization."},"680":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-30","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#publication-and-persistence","content":"Design the consumer to:"},"681":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-31","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#publication-and-persistence","content":"subscribe to the audit.# types and also to operation types ending in .error;"},"682":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-32","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#publication-and-persistence","content":"keep the complete CloudEvent unmodified;"},"683":{"id":"/docs/pr-preview/pr-38/platform/administration/audit-logs-33","page_id":"/docs/pr-preview/pr-38/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/administration/audit-logs#publication-and-persistence","content":"record the ingestion time and detect duplicates by ID;"},"684":{"id":"