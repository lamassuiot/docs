s":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/overview#contract-version","content":"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations."},"1028":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","type":"page","content":"Provisioning strategies","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies"},"1029":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-0","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","content":"Choose device registration, identity authorization and key generation."},"1030":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-1","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Choose registration"},"1031":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-2","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"Preregistration and replacement"},"1032":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-3","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"Choose authentication"},"1033":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-4","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Choose custody"},"1034":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-5","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","content":"Check the decision"},"1035":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-6","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","content":"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself."},"1036":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-7","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Path"},"1037":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-8","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"When the device exists"},"1038":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-9","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"What to check"},"1039":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-10","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Manual assignment"},"1040":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-11","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"An operator creates it before associating a certificate."},"1041":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-12","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"ID, owning DMS, certificate CN and bound serial."},"1042":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-13","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"EST with `JITP`"},"1043":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-14","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Created for an unknown CN during `/simpleenroll`."},"1044":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-15","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Authorized credential, unused ID, profile, resulting registration and identity."},"1045":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-16","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"EST with `PRE_REGISTRATION`"},"1046":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-17","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Must exist before `/simpleenroll`."},"1047":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-18","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Approved record, same DMS and replacement conditions for your version."},"1048":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-19","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions."},"1049":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-20","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration."},"1050":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-21","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path."},"1051":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-22","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state."},"1052":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-23","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying."},"1053":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-24","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"Decide initial enrollment and re-enrollment separately:"},"1054":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-25","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**Client certificate:** useful when each device has an initial credential whose key it controls."},"1055":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-26","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID."},"1056":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-27","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**Certificate and webhook:** requires both controls in the configured operation."},"1057":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-28","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS."},"1058":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-29","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication."},"1059":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-30","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Option"},"1060":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-31","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Material crossing EST"},"1061":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-32","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Device-generated key"},"1062":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-33","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Public CSR and certificate; the key stays on the client."},"1063":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-34","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Existing device key"},"1064":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-35","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"CSR signed with that key and a new certificate."},"1065":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-36","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"ServerKeyGen"},"1066":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-37","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Private PKCS#8 key and certificate in a TLS-protected multipart response."},"1067":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-38","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material."},"1068":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies-39","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","content":"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate."},"1069":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","type":"page","content":"Renewal and recovery","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery"},"1070":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-0","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","content":"Renew without losing the identity and recover devices according to their actual state."},"1071":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-1","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Prepare renewal"},"1072":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-2","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","content":"Request the successor certificate"},"1073":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-3","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"Install and check the new pair"},"1074":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-4","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Recover according to state"},"1075":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-5","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","content":"Continuous operation"},"1076":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-6","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","content":"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps."},"1077":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-7","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key."},"1078":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-8","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted."},"1079":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-9","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window."},"1080":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-10","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one."},"1081":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-11","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","content":"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes."},"1082":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-12","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","content":"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results."},"1083":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-13","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key."},"1084":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-14","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption."},"1085":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-15","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation."},"1086":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-16","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Situation"},"1087":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-17","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Procedure"},"1088":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-18","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Valid certificate, outside the window"},"1089":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-19","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Schedule the request within the window. Do not use `simpleenroll` to bypass it."},"1090":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-20","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Expired certificate, key available"},"1091":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-21","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply."},"1092":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-22","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Renewal through webhook or `NO_AUTH`"},"1093":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-23","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition."},"1094":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-24","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Lost or inaccessible key"},"1095":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-25","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity."},"1096":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-26","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Current identity revoked"},"1097":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-27","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it."},"1098":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-28","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Device without an identity"},"1099":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-29","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning."},"1100":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-30","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Retired device"},"1101":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-31","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent."},"1102":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-32","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Timeout, HTTP 500 or installation failure"},"1103":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-33","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked."},"1104":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-34","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","content":"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed."},"1105":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery-35","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","content":"Continue with Trust distribution, Devices and identities and Troubleshooting."},"1106":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","type":"page","content":"Enrollment troubleshooting","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting"},"1107":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-0","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","content":"Locate transport, authentication, registration, issuance and installation failures."},"1108":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-1","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","content":"Diagnostics and compatibility"},"1109":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-2","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Error codes and diagnostics"},"1110":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-3","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes","content":"Compatibility notes"},"1111":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-4","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"EST enrollment fails"},"1112":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-5","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","content":"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report."},"1113":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-6","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result."},"1114":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-7","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Symptom or message"},"1115":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-8","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"What to check"},"1116":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-9","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"curl rejects TLS, name or issuer"},"1117":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-10","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification."},"1118":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-11","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"404 or missing APS"},"1119":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-12","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name."},"1120":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-13","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"400, CSR or format error"},"1121":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-14","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding."},"1122":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-15","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Missing credential or invalid certificate"},"1123":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-16","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA."},"1124":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-17","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Webhook denies, times out or responds without authorization"},"1125":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-18","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`."},"1126":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-19","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`unexpected status code: <n>: redirects are not followed`"},"1127":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-20","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed."},"1128":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-21","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`webhook response exceeds 1048576 bytes`"},"1129":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-22","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook."},"1130":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-23","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`webhook config must not reference files`"},"1131":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-24","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the PEM as `cert_content` and `key_content`; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the upgrade note in DMS."},"1132":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-25","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"400 `struct validation error` creating or updating a DMS"},"1133":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-26","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS."},"1134":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-27","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"HTTP 500 with an `err` body on enroll or reenroll"},"1135":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-28","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there."},"1136":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-29","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`device not preregistered`"},"1137":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-30","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"PRE\\_REGISTRATION requires an existing inventory entry."},"1138":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-31","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`forbiddenNewEnrollment`"},"1139":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-32","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag."},"1140":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-33","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Different owning DMS"},"1141":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-34","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"CN/ID, global inventory and owning DMS; do not reuse an ID from another context."},"1142":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-35","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`invalid RawSubject bytes`"},"1143":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-36","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"CSR subject versus the current certificate. Preserve its attributes as well as its CN."},"1144":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-37","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`invalid reenroll window`"},"1145":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-38","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window."},"1146":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-39","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Current certificate revoked"},"1147":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-40","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Renewal rejected; prepare authorized recovery according to the cause."},"1148":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-41","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"CA, profile or signing error"},"1149":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-42","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance."},"1150":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-43","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"HTTP 200 without a device connection"},"1151":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-44","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history."},"1152":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-45","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Timeout or error after issuance"},"1153":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-46","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"New certificates, current slot and previous identity's state before retrying."},"1154":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-47","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes","content":"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode after migration and Gateway behavior with expired certificates and the bootstrap CA."},"1155":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-48","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes","content":"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference."},"1156":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-49","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"Check HTTPS with the approved root and query cacerts for the correct APS."},"1157":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-50","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window."},"1158":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-51","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"Verify the CSR locally and relate its CN to the inventory."},"1159":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-52","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"Make one request, save headers/body and query the device and certificates."},"1160":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-53","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"If you receive an identity, check the key, subject, use and connection with the consumer."},"1161":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-54","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either."},"1162":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting-55","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities."},"1163":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","type":"page","content":"Trust distribution and updates","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution"},"1164":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-0","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","content":"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates."},"1165":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-1","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Three trust relationships"},"1166":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-2","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","content":"What cacerts returns"},"1167":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-3","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Install the required material"},"1168":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-4","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","content":"Migrate trust"},"1169":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-5","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#check-the-update","content":"Check the update"},"1170":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-6","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","content":"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors."},"1171":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-7","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Relationship"},"1172":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-8","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Material prepared by its owner"},"1173":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-9","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Device → EST server"},"1174":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-10","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Previously verified server root, chain or pin and TLS name."},"1175":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-11","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"DMS → requester"},"1176":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-12","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"CAs and rules authorizing initial or renewal credentials."},"1177":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-13","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Consumer → device"},"1178":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-14","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Operational identity roots, intermediates, validation and permissions."},"1179":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-15","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model."},"1180":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-16","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","content":"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration."},"1181":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-17","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","content":"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client."},"1182":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-18","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Keep initial EST server trust separate from identity consumer trust."},"1183":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-19","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Select policy-approved roots as anchors."},"1184":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-20","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Retain intermediates for chain building or presentation; do not automatically turn them into roots."},"1185":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-21","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent."},"1186":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-22","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Verify chain, dates, names, usages and revocation from the consumer."},"1187":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-23","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose."},"1188":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-24","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","content":"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains."},"1189":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-25","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","content":"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. When switching the enrollment CA, add the previous issuance CA to that list so old-CA identities keep re-enrolling during overlap; migrated `additional_validation_cas` values now live there. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured."},"1190":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-26","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","content":"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation."},"1191":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution-27","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#check-the-update","content":"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device."},"1192":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core","type":"page","content":"AWS IoT Core","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Integrations"],"tags":[],"url":"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core"},"1193":{"id":"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core-0","page_id":"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core","content":"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven."},"1194":{"id":"/docs/pr-preview/p