s/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`enable_replaceable_enrollment`"},"851":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-38","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico."},"852":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-39","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`est_rfc7030_settings.auth_mode`"},"853":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-40","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Uno de los cuatro modos de autenticación."},"854":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-41","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales."},"855":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-42","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Los bloques son independientes:"},"856":{"id":"/docs/pr-p