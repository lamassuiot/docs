t-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Autenticación inicial"},"1456":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-32","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos."},"1457":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-33","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Autenticación de renovación"},"1458":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-34","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment."},"1459":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-35","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Re-enrollment Validation CAs / Enable Expired Renewal"},"1460":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-36","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Lista vacía para esta emisión directa / deshabilitado."},"1461":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-37","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Re-enrollment Delta"},"1462":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-38","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"1 hora."},"1463":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-39","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Preventive / Critical Delta"},"1464":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-40","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"30 minutos / 10 minutos."},"1465":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-41","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Revoke on Re-enrollment"},"1466":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-42","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Deshabilitado para probar el sucesor antes de retirar el anterior."},"1467":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-43","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"ServerKeyGen"},"1468":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-44","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Deshabilitado; la clave operativa se genera en el cliente."},"1469":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-45","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"CA Distribution"},"1470":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-46","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado."},"1471":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-47","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS."},"1472":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-48","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","content":"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:"},"1473":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-49","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","content":"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir."},"1474":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-50","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","content":"Genera una clave nueva y una CSR con el identificador elegido:"},"1475":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-51","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","content":"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:"},"1476":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-52","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","content":"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida."},"1477":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-53","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","content":"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora."},"1478":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-54","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","content":"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active."},"1479":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-55","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:"},"1480":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-56","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:"},"1481":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-57","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL."},"1482":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-58","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:"},"1483":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-59","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server."},"1484":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-60","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Comprobación"},"1485":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-61","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Resultado esperado"},"1486":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-62","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Registro"},"1487":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-63","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"ID creado automáticamente y DMS correcto."},"1488":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-64","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Certificado"},"1489":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-65","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"CN, perfil, serie y clave verificados."},"1490":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-66","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Inventario"},"1491":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-67","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Serie recibida visible como identidad actual y en el historial."},"1492":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-68","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Consumidor"},"1493":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-69","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"mTLS responde 200 con la identidad y rechaza falta de certificado."},"1494":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-70","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente."},"1495":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device-71","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible."},"1496":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","type":"page","content":"Registra un dispositivo manualmente","breadcrumbs":["Docs","Plataforma","IoT Fleets","Primeros pasos"],"tags":[],"url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device"},"1497":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-0","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","content":"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad."},"1498":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-1","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar","content":"Antes de empezar"},"1499":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-2","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"Prepara el DMS"},"1500":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-3","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","content":"Registra el dispositivo"},"1501":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-4","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","content":"Comprueba el estado inicial"},"1502":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-5","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","content":"Asigna una identidad"},"1503":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-6","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","content":"Verifica el dispositivo"},"1504":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-7","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Resultado esperado"},"1505":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-8","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","content":"Si el resultado falla"},"1506":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-9","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","content":"Automatiza el siguiente dispositivo"},"1507":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-10","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","content":"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad."},"1508":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-11","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","content":"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino."},"1509":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-12","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar","content":"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados."},"1510":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-13","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar","content":"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA."},"1511":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-14","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar","content":"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos."},"1512":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-15","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar","content":"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`."},"1513":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-16","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:"},"1514":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-17","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`."},"1515":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-18","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"En **Enrollment CA**, selecciona la CA que emitió `device.crt`."},"1516":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-19","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita."},"1517":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-20","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar."},"1518":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-21","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador."},"1519":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-22","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario."},"1520":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-23","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo."},"1521":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-24","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","content":"Abre **Managed Devices** y la acción de registro. Completa:"},"1522":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-25","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","content":"**Device ID**: `device-001`."},"1523":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-26","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","content":"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro."},"1524":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-27","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","content":"**Icon** y **Tags**: clasificación opcional."},"1525":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-28","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","content":"Confirma el registro."},"1526":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-29","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","content":"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado."},"1527":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-30","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","content":"El registro crea la entrada de inventario; el certificado todavía debe asociarse."},"1528":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-31","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","content":"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI."},"1529":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-32","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","content":"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades."},"1530":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-33","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","content":"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación."},"1531":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-34","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","content":"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado."},"1532":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-35","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Comprobación"},"1533":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-36","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Resultado"},"1534":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-37","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Dispositivo"},"1535":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-38","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"`device-001` aparece en el inventario con el DMS previsto."},"1536":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-39","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Identidad actual"},"1537":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-40","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"El certificado asociado coincide con el que verificaste en PKI."},"1538":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-41","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Historial"},"1539":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-42","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"La emisión asociada aparece con su número de serie y fechas."},"1540":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-43","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Clave y certificado"},"1541":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-44","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Dispones de la pareja comprobada para instalarla en el dispositivo."},"1542":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-45","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","content":"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura."},"1543":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-46","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","content":"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista."},"1544":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-47","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","content":"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido."},"1545":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-48","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","content":"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades."},"1546":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-49","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","content":"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente."},"1547":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-50","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","content":"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo."},"1548":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device-51","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","content":"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios."},"1549":{"id":"/docs/pr-preview/pr-38/es/platform/overview","page_id":"/docs/pr-preview/pr-38/es/platform/overview","type":"page","content":"Plataforma Lamassu IoT","breadcrumbs":["Docs","Plataforma"],"tags":[],"url":"/docs/pr-preview/pr-38/es/platform/overview"},"1550":{"id":"/docs/pr-preview/pr-38/es/platform/overview-0","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview","content":"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos."},"1551":{"id":"/docs/pr-preview/pr-38/es/platform/overview-1","page_id":"/docs/pr-preview/pr-38/es/platform/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/overview#empieza-aquí","content":"Empieza aquí"},"1552":{"id":"/docs/pr-preview/pr-38/es/platform/overview-2","page_id":"/docs/pr-preview/pr-38/es/platform/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","content":"Elige tu recorrido"},"1553":{"id":"/docs/pr-preview/pr-38/es/platform/overview-3","page_id":"/docs/pr-preview/pr-38/es/platform/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/overview#arquitectura-de-un-vistazo","content":"Arquitectura de un vistazo"},"1554":{"id":"/docs/pr-preview/pr-38/es/platform/overview-4","page_id":"/docs/pr-preview/pr-38/es/platform/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/overview#capacidades-principales","content":"Capacidades principales"},"1555":{"id":"/docs/pr-preview/pr-38/es/platform/overview-5","page_id":"/docs/pr-preview/pr-38/es/platform/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/overview#construye-tu-jerarquía-de-confianza","content":"Construye tu jerarquía de confianza"},"1556":{"id":"/docs/pr-preview/pr-38/es/platform/overview-6","page_id":"/docs/pr-preview/pr-38/es/platform/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/overview#protege-las-claves-criptográficas","content":"Protege las claves criptográficas"},"1557":{"id":"/docs/pr-preview/pr-38/es/platform/overview-7","page_id":"/docs/pr-preview/pr-38/es/platform/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/overview#emite-y-controla-certificados","content":"Emite y controla certificados"},"1558":{"id":"/docs/pr-preview/pr-38/es/platform/overview-8","page_id":"/docs/pr-preview/pr-38/es/platform/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/overview#automatiza-identidades-de-dispositivos","content":"Automatiza identidades de dispositivos"},"1559":{"id":"/docs/pr-preview/pr-38/es/platform/overview-9","page_id":"/docs/pr-preview/pr-38/es/platform/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/overview#publica-el-estado-de-validación","content":"Publica el estado de validación"},"1560":{"id":"/docs/pr-preview/pr-38/es/platform/overview-10","page_id":"/docs/pr-preview/pr-38/es/platform/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/overview#reacciona-a-los-eventos","content":"Reacciona a los eventos"},"1561":{"id":"/docs/pr-preview/pr-38/es/platform/overview-11","page_id":"/docs/pr-preview/pr-38/es/platform/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/es/platform/overview#referencia-operativa","content":"Referencia operativa"},"1562":{"id":"/docs/pr-preview/pr-38/es/platform/overview-12","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview","content":"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos."},"1563":{"id":"/docs/pr-preview/pr-38/es/platform/overview-13","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#empieza-aquí","content":"Elige el resultado que necesitas obtener:"},"1564":{"id":"/docs/pr-preview/pr-38/es/platform/overview-14","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#empieza-aquí","content":"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />"},"1565":{"id":"/docs/pr-preview/pr-38/es/platform/overview-15","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#empieza-aquí","content":"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />"},"1566":{"id":"/docs/pr-preview/pr-38/es/platform/overview-16","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#empieza-aquí","content":"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones."},"1567":{"id":"/docs/pr-preview/pr-38/es/platform/overview-17","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","content":"Bloque"},"1568":{"id":"/docs/pr-preview/pr-38/es/platform/overview-18","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","content":"Qué gestionas"},"1569":{"id":"/docs/pr-preview/pr-38/es/platform/overview-19","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","content":"Punto de entrada"},"1570":{"id":"/docs/pr-preview/pr-38/es/platform/overview-20","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","content":"**PKI**"},"1571":{"id":"/docs/pr-preview/pr-38/es/platform/overview-21","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","content":"Claves, autoridades, perfiles, certificados y publicación del estado de revocación."},"1572":{"id":"/docs/pr-preview/pr-38/es/platform/overview-22","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","content":"Visión general de PKI"},"1573":{"id":"/docs/pr-preview/pr-38/es/platform/overview-23","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","content":"**IoT Fleets**"},"1574":{"id":"/docs/pr-preview/pr-38/es/platform/overview-24","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","content":"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones."},"1575":{"id":"/docs/pr-preview/pr-38/es/platform/overview-25","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","content":"Visión general de IoT Fleets"},"1576":{"id":"/docs/pr-preview/pr-38/es/platform/overview-26","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","content":"**Administración**"},"1577":{"id":"/docs/pr-preview/pr-38/es/platform/overview-27","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","content":"Permisos de operadores, auditoría y suscripciones a eventos."},"1578":{"id":"/docs/pr-preview/pr-38/es/platform/overview-28","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","content":"Control de acceso"},"1579":{"id":"/docs/pr-preview/pr-38/es/platform/overview-29","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","content":"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta."},"1580":{"id":"/docs/pr-preview/pr-38/es/platform/overview-30","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#arquitectura-de-un-vistazo","content":"El recorrido de una identidad conecta cuatro responsabilidades:"},"1581":{"id":"/docs/pr-preview/pr-38/es/platform/overview-31","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#arquitectura-de-un-vistazo","content":"El administrador PKI prepara la autoridad, su clave y las reglas de emisión."},"1582":{"id":"/docs/pr-preview/pr-38/es/platform/overview-32","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#arquitectura-de-un-vistazo","content":"El administrador del aprovisionamiento configura el DMS y la confianza inicial."},"1583":{"id":"/docs/pr-preview/pr-38/es/platform/overview-33","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#arquitectura-de-un-vistazo","content":"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde."},"1584":{"id":"/docs/pr-preview/pr-38/es/platform/overview-34","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#arquitectura-de-un-vistazo","content":"El consumidor valida la identidad y aplica sus permisos de acceso."},"1585":{"id":"/docs/pr-preview/pr-38/es/platform/overview-35","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#arquitectura-de-un-vistazo","content":"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue."},"1586":{"id":"/docs/pr-preview/pr-38/es/platform/overview-36","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#construye-tu-jerarquía-de-confianza","content":"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores."},"1587":{"id":"/docs/pr-preview/pr-38/es/platform/overview-37","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#protege-las-claves-criptográficas","content":"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue."},"1588":{"id":"/docs/pr-preview/pr-38/es/platform/overview-38","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#emite-y-controla-certificados","content":"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará."},"1589":{"id":"/docs/pr-preview/pr-38/es/platform/overview-39","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#automatiza-identidades-de-dispositivos","content":"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo."},"1590":{"id":"/docs/pr-preview/pr-38/es/platform/overview-40","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#publica-el-estado-de-validación","content":"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información."},"1591":{"id":"/docs/pr-preview/pr-38/es/platform/overview-41","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#reacciona-a-los-eventos","content":"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida."},"1592":{"id":"/docs/pr-preview/pr-38/es/platform/overview-42","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#referencia-operativa","content":"Responsabilidad"},"1593":{"id":"/docs/pr-preview/pr-38/es/platform/overview-43","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#referencia-operativa","content":"Qué prepara o comprueba"},"1594":{"id":"/docs/pr-preview/pr-38/es/platform/overview-44","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#referencia-operativa","content":"Administrador PKI"},"1595":{"id":"/docs/pr-preview/pr-38/es/platform/overview-45","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#referencia-operativa","content":"Custodia de claves, jerarquía de CAs, perfiles y validación."},"1596":{"id":"/docs/pr-preview/pr-38/es/platform/overview-46","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#referencia-operativa","content":"Administrador de la flota"},"1597":{"id":"/docs/pr-preview/pr-38/es/platform/overview-47","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#referencia-operativa","content":"DMS, admisión de dispositivos, política de renovación e inventario."},"1598":{"id":"/docs/pr-preview/pr-38/es/platform/overview-48","page_id":"/docs/pr-preview/pr-38/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/overview#referencia-operati