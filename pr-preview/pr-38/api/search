ne#what-the-script-configures","content":"creates the namespace"},"174":{"id":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane-96","page_id":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#what-the-script-configures","content":"installs PostgreSQL and creates the required databases"},"175":{"id":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane-97","page_id":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#what-the-script-configures","content":"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user"},"176":{"id":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane-98","page_id":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#what-the-script-configures","content":"installs RabbitMQ"},"177":{"id":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane-99","page_id":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#what-the-script-configures","content":"optionally installs observability and lab HSM components"},"178":{"id":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane-100","page_id":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#what-the-script-configures","content":"generates `lamassu.yaml` and installs the Lamassu chart"},"179":{"id":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane-101","page_id":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#what-the-script-configures","content":"optionally loads sample data"},"180":{"id":"/docs/pr-pre