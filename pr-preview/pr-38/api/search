iew/pr-38/es/platform/iot-fleets/enrollment/dms-49","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`EXTERNAL_WEBHOOK`"},"863":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-50","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Autorización del webhook configurado."},"864":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-51","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`"},"865":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-52","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Validación del certificado y, después, aprobación del webhook."},"866":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-53","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`NO_AUTH`"},"867":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-54","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Sin autenticación del solicitante por el DMS."},"868":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-55","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla."},"869":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-56","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway."},"870":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-57","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas` — copiar la lista del bloque inicial no amplía la aceptación en reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`."},"871":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-58","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado."},"872":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-59","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:"},"873":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-60","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Campo de `external_webhook_settings`"},"874":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-61","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Decisión"},"875":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-62","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`url`"},"876":{"id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms-63","page_id":"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-p