s":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#before-you-begin","content":"A Lamassu instance accessible from your browser. To prepare one, see Deployment."},"2310":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-7","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#before-you-begin","content":"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked."},"2311":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-8","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#before-you-begin","content":"An available cryptographic engine for the CA key; check the keys and engines inventory."},"2312":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-9","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#before-you-begin","content":"OpenSSL 3.x on the computer where you will verify the files."},"2313":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-10","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#before-you-begin","content":"A working directory with restricted access for the downloaded key."},"2314":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-11","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#recommended-path","content":"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />"},"2315":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-12","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#recommended-path","content":"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />"},"2316":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-13","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#recommended-path","content":"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect."},"2317":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-14","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#recommended-path","content":"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy."},"2318":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-15","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#expected-result","content":"File or resource"},"2319":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-16","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#expected-result","content":"Check"},"2320":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-17","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#expected-result","content":"Active root CA and `ca.pem`"},"2321":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-18","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#expected-result","content":"It is a CA certificate, is currently valid and its self-signature verifies."},"2322":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-19","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#expected-result","content":"End-entity certificate and `device.crt`"},"2323":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-20","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#expected-result","content":"It identifies `device-001`, supports client authentication and verifies against `ca.pem`."},"2324":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-21","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#expected-result","content":"Private key `device.key`"},"2325":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-22","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#expected-result","content":"Its public key matches the one included in `device.crt`."},"2326":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-23","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#expected-result","content":"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration."},"2327":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-24","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"To operate certificates, continue with Certificates and Validation."},"2328":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-25","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation."},"2329":{"id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview-26","page_id":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"For the device to request its certificate, prepare the DMS and EST client."},"2330":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","type":"page","content":"PKI troubleshooting","breadcrumbs":["Docs","Platform","PKI","Troubleshooting"],"tags":[],"url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting"},"2331":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-0","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","content":"Diagnose certificate issuance, OCSP and CRL."},"2332":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-1","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"Issuance fails"},"2333":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-2","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"OCSP or CRL do not reflect a change"},"2334":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-3","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"The chain validates but the connection fails"},"2335":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-4","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","content":"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics."},"2336":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-5","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","content":"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics."},"2337":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-6","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"Check"},"2338":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-7","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"What to inspect"},"2339":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-8","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"Next step"},"2340":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-9","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"CA"},"2341":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-10","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"Exists, is active and has usable dates."},"2342":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-11","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"Authorities."},"2343":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-12","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"Key"},"2344":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-13","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"The record has a usable private key and the engine can sign."},"2345":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-14","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"Try **Sign / Verify** in KMS; check provider permissions and availability."},"2346":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-15","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"CSR"},"2347":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-16","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"Correct PEM and verifiable signature."},"2348":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-17","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"`openssl req -in request.csr -noout -verify -text`."},"2349":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-18","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"Profile"},"2350":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-19","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"Selected source, existing ID, allowed algorithm and size."},"2351":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-20","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"Check Profiles precedence; CA and DMS resolve differently."},"2352":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-21","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"Result"},"2353":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-22","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"Appropriate subject, SAN, usages and dates."},"2354":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-23","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance."},"2355":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-24","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration."},"2356":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-25","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","content":"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation."},"2357":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-26","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"Check each boundary independently:"},"2358":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-27","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions."},"2359":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-28","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy."},"2360":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-29","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`."},"2361":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-30","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator."},"2362":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-31","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection."},"2363":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-32","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure."},"2364":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-33","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests."},"2365":{"id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting-34","page_id":"/docs/pr-preview/pr-38/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-38/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures."}},"count":2365},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":870,"2":1778,"3":580,"4":1241,"5":1497,"6":741,"7":1382,"8":1380,"9":1434,"10":1946,"11":1541,"12":439,"13":428,"14":42,"15":145,"16":107,"17":1129,"18":1803,"19":743,"20":1866,"21":778,"22":871,"23":710,"24":692,"25":1321,"26":462,"27":2342,"28":1425,"29":1654,"30":2317,"31":1872,"32":1349,"33":1608,"34":2363,"35":1134,"36":560,"37":1000,"38":2364,"39":1574,"