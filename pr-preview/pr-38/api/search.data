,"_33454":102895,"_33456":102899,"_33458":102903,"_33460":102906,"_33462":102910,"_33464":102914,"_33466":102918,"_33468":102921,"_33470":102924,"_33472":102927,"_33474":102930,"_33476":102933,"_33478":102936,"_33480":102939,"_33482":102942,"_33484":102945,"_33486":102948,"_33488":102951,"_33490":102954,"_33492":102957,"_33494":102960,"_33496":102963,"_33498":102966,"_33500":102969,"_33502":102972,"_33504":102975,"_33506":102978,"_33508":102981,"_33510":102984,"_33512":102987,"_33514":102990,"_33516":102992,"_33518":102994,"_33520":102997,"_33522":103000,"_33524":103003,"_33526":103006,"_33528":103009,"_33530":103012,"_33532":103015,"_33534":103018,"_33536":103021,"_33538":103024,"_33540":103027,"_33542":103030,"_33544":103033,"_33546":103036,"_33548":103039,"_33550":103042,"_33552":103046,"_33554":103049,"_33556":103052,"_33558":103056,"_33560":103059,"_33562":103063,"_33564":103066,"_33566":103069,"_33568":103072,"_33570":103075,"_33572":103078,"_33574":103081,"_33576":103084,"_33578":103087,"_33580":103090,"_33582":103093,"_33584":103096,"_33586":103098,"_33588":103101,"_33590":103104,"_33592":103107,"_33594":103110,"_33596":103113,"_33598":103116,"_33600":103119,"_33602":103122,"_33604":103125,"_33606":103128,"_33608":103133,"_33610":103136,"_33612":103140,"_33614":103144,"_33616":103148,"_33618":103151,"_33620":103154,"_33622":103156,"_33624":103158,"_33626":103160,"_33628":103162,"_33630":103165,"_33632":103168,"_33634":103171,"_33636":103174,"_33638":103177,"_33640":103179,"_33642":103182,"_33644":103184,"_33646":103187,"_33648":103190,"_33650":103193,"_33652":103195,"_33654":103198,"_33656":103201,"_33658":103204,"_33660":103207,"_33662":103210,"_33664":103213,"_33666":103216,"_33668":103219,"_33670":103222,"_33672":103225,"_33674":103228,"_33676":103231},{"_2857":57774,"_25170":57774,"_5":12294,"_2384":95969,"_25506":95970,"_17548":95973,"_23820":57774},"Despliega desde AWS Marketplace",[40848,95971,95972],"Despliegue","Otros modelos",[],{"_2857":57775,"_25170":57774,"_17548":95975,"_5":17443,"_23820":57774,"_2384":95976},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2857":57776,"_25170":57774,"_5":25503,"_17548":95978,"_23820":95979,"_2384":95980},[],"/docs/pr-preview/pr-38/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2857":57777,"_25170":57774,"_5":25503,"_17548":95982,"_23820":95983,"_2384":95984},[],"/docs/pr-preview/pr-38/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2857":57778,"_25170":57774,"_5":25503,"_17548":95986,"_23820":95987,"_2384":95988},[],"/docs/pr-preview/pr-38/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2857":57779,"_25170":57774,"_5":25503,"_17548":95990,"_23820":95991,"_2384":95992},[],"/docs/pr-preview/pr-38/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2857":57780,"_25170":57774,"_5":25503,"_17548":95994,"_23820":95995,"_2384":95996},[],"/docs/pr-preview/pr-38/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2857":57781,"_25170":57774,"_5":25503,"_17548":95998,"_23820":95999,"_2384":96000},[],"/docs/pr-preview/pr-38/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2857":57782,"_25170":57774,"_5":25503,"_17548":96002,"_23820":96003,"_2384":96004},[],"/docs/pr-preview/pr-38/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2857":57783,"_25170":57774,"_17548":96006,"_5":17443,"_23820":57774,"_2384":96007},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2857":57784,"_25170":57774,"_17548":96009,"_5":17443,"_23820":95979,"_2384":96010},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2857":57785,"_25170":57774,"_17548":96012,"_5":17443,"_23820":95979,"_2384":96013},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2857":57786,"_25170":57774,"_17548":96015,"_5":17443,"_23820":95979,"_2384":96016},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2857":57787,"_25170":57774,"_17548":96018,"_5":17443,"_23820":95983,"_2384":96019},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2857":57788,"_25170":57774,"_17548":96021,"_5":17443,"_23820":95983,"_2384":96022},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2857":57789,"_25170":57774,"_17548":96024,"_5":17443,"_23820":95983,"_2384":96025},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2857":57790,"_25170":57774,"_17548":96027,"_5":17443,"_23820":95987,"_2384":96028},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2857":57791,"_25170":57774,"_17548":96030,"_5":17443,"_23820":95991,"_2384":96031},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2857":57792,"_25170":57774,"_17548":96033,"_5":17443,"_23820":95995,"_2384":96034},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2857":57793,"_25170":57774,"_17548":96036,"_5":17443,"_23820":95999,"_2384":96037},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2857":57794,"_25170":57774,"_17548":96039,"_5":17443,"_23820":96003,"_2384":96040},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2857":57795,"_25170":57795,"_5":12294,"_2384":96042,"_25506":96043,"_17548":96044,"_23820":57795},"Despliega Lamassu",[40848,95971],[],{"_2857":57796,"_25170":57795,"_17548":96046,"_5":17443,"_23820":57795,"_2384":96047},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2857":57797,"_25170":57795,"_5":25503,"_17548":96049,"_23820":96050,"_2384":96051},[],"/docs/pr-preview/pr-38/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2857":57798,"_25170":57795,"_5":25503,"_17548":96053,"_23820":96054,"_2384":96055},[],"/docs/pr-preview/pr-38/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2857":57799,"_25170":57795,"_5":25503,"_17548":96057,"_23820":96058,"_2384":96059},[],"/docs/pr-preview/pr-38/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2857":57800,"_25170":57795,"_17548":96061,"_5":17443,"_23820":57795,"_2384":96062},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2857":57801,"_25170":57795,"_17548":96064,"_5":17443,"_23820":96050,"_2384":96065},[],"Modelo",{"_2857":57802,"_25170":57795,"_17548":96067,"_5":17443,"_23820":96050,"_2384":96068},[],"Recomendado para",{"_2857":57803,"_25170":57795,"_17548":96070,"_5":17443,"_23820":96050,"_2384":96071},[],"Quién opera la infraestructura",{"_2857":57804,"_25170":57795,"_17548":96073,"_5":17443,"_23820":96050,"_2384":96074},[],"Punto de partida",{"_2857":57805,"_25170":57795,"_17548":96076,"_5":17443,"_23820":96050,"_2384":40955},[],{"_2857":57806,"_25170":57795,"_17548":96078,"_5":17443,"_23820":96050,"_2384":96079},[],"Producción, entornos regulados y despliegues personalizados",{"_2857":57807,"_25170":57795,"_17548":96081,"_5":17443,"_23820":96050,"_2384":96082},[],"Tu equipo",{"_2857":57808,"_25170":57795,"_17548":96084,"_5":17443,"_23820":96050,"_2384":96085},[],"Helm o Fastlane",{"_2857":57809,"_25170":57795,"_17548":96087,"_5":17443,"_23820":96050,"_2384":40967},[],{"_2857":57810,"_25170":57795,"_17548":96089,"_5":17443,"_23820":96050,"_2384":96090},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2857":57811,"_25170":57795,"_17548":96092,"_5":17443,"_23820":96050,"_2384":96082},[],{"_2857":57812,"_25170":57795,"_17548":96094,"_5":17443,"_23820":96050,"_2384":96095},[],"Imagen preconfigurada en EC2",{"_2857":57813,"_25170":57795,"_17548":96097,"_5":17443,"_23820":96050,"_2384":40978},[],{"_2857":57814,"_25170":57795,"_17548":96099,"_5":17443,"_23820":96050,"_2384":96100},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2857":57815,"_25170":57795,"_17548":96102,"_5":17443,"_23820":96050,"_2384":40984},[],{"_2857":57816,"_25170":57795,"_17548":96104,"_5":17443,"_23820":96050,"_2384":96105},[],"Suscripción gestionada",{"_2857":57817,"_25170":57795,"_17548":96107,"_5":17443,"_23820":96050,"_2384":96108},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2857":57818,"_25170":57795,"_17548":96110,"_5":17443,"_23820":96050,"_2384":96111},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2857":57819,"_25170":57795,"_17548":96113,"_5":17443,"_23820":96050,"_2384":96114},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2857":57820,"_25170":57795,"_17548":96116,"_5":17443,"_23820":96054,"_2384":96117},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2857":57821,"_25170":57795,"_17548":96119,"_5":17443,"_23820":96058,"_2384":96120},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2857":57822,"_25170":57822,"_5":12294,"_2384":96122,"_25506":96123,"_17548":96124,"_23820":57822},"Utiliza Lamassu como SaaS",[40848,95971,95972],[],{"_2857":57823,"_25170":57822,"_17548":96126,"_5":17443,"_23820":57822,"_2384":96127},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2857":57824,"_25170":57822,"_5":25503,"_17548":96129,"_23820":96130,"_2384":96131},[],"/docs/pr-preview/pr-38/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2857":57825,"_25170":57822,"_5":25503,"_17548":96133,"_23820":96134,"_2384":96135},[],"/docs/pr-preview/pr-38/es/deployment/saas#planes","Planes",{"_2857":57826,"_25170":57822,"_5":25503,"_17548":96137,"_23820":96138,"_2384":96139},[],"/docs/pr-preview/pr-38/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2857":57827,"_25170":57822,"_17548":96141,"_5":17443,"_23820":57822,"_2384":96142},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2857":57828,"_25170":57822,"_17548":96144,"_5":17443,"_23820":96130,"_2384":96145},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2857":57829,"_25170":57822,"_17548":96147,"_5":17443,"_23820":96130,"_2384":96148},[],"Copias de seguridad automáticas.",{"_2857":57830,"_25170":57822,"_17548":96150,"_5":17443,"_23820":96130,"_2384":96151},[],"Actualizaciones de versión.",{"_2857":57831,"_25170":57822,"_17548":96153,"_5":17443,"_23820":96130,"_2384":96154},[],"Soporte técnico y SLA según el plan contratado.",{"_2857":57832,"_25170":57822,"_17548":96156,"_5":17443,"_23820":96134,"_2384":41039},[],{"_2857":57833,"_25170":57822,"_17548":96158,"_5":17443,"_23820":96134,"_2384":96159},[],"Dispositivos",{"_2857":57834,"_25170":57822,"_17548":96161,"_5":17443,"_23820":96134,"_2384":96162},[],"Soporte",{"_2857":57835,"_25170":57822,"_17548":96164,"_5":17443,"_23820":96134,"_2384":41048},[],{"_2857":57836,"_25170":57822,"_17548":96166,"_5":17443,"_23820":96134,"_2384":41051},[],{"_2857":57837,"_25170":57822,"_17548":96168,"_5":17443,"_23820":96134,"_2384":96169},[],"Hasta 1.000",{"_2857":57838,"_25170":57822,"_17548":96171,"_5":17443,"_23820":96134,"_2384":41057},[],{"_2857":57839,"_25170":57822,"_17548":96173,"_5":17443,"_23820":96134,"_2384":96174},[],"99,5 %",{"_2857":57840,"_25170":57822,"_17548":96176,"_5":17443,"_23820":96134,"_2384":41063},[],{"_2857":57841,"_25170":57822,"_17548":96178,"_5":17443,"_23820":96134,"_2384":96179},[],"Hasta 10.000",{"_2857":57842,"_25170":57822,"_17548":96181,"_5":17443,"_23820":96134,"_2384":96182},[],"Email y chat",{"_2857":57843,"_25170":57822,"_17548":96184,"_5":17443,"_23820":96134,"_2384":96185},[],"99,9 %",{"_2857":57844,"_25170":57822,"_17548":96187,"_5":17443,"_23820":96134,"_2384":41075},[],{"_2857":57845,"_25170":57822,"_17548":96189,"_5":17443,"_23820":96134,"_2384":96190},[],"Ilimitados",{"_2857":57846,"_25170":57822,"_17548":96192,"_5":17443,"_23820":96134,"_2384":96193},[],"Dedicado",{"_2857":57847,"_25170":57822,"_17548":96195,"_5":17443,"_23820":96134,"_2384":96196},[],"99,99 %",{"_2857":57848,"_25170":57822,"_17548":96198,"_5":17443,"_23820":96138,"_2384":96199},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2857":57849,"_25170":57822,"_17548":96201,"_5":17443,"_23820":96138,"_2384":96202},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2857":57850,"_25170":57850,"_5":12294,"_2384":41092,"_25506":96204,"_17548":96206,"_23820":57850},[40848,95971,96205],"Kubernetes autogestionado",[],{"_2857":57851,"_25170":57850,"_17548":96208,"_5":17443,"_23820":57850,"_2384":96209},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2857":57852,"_25170":57850,"_5":25503,"_17548":96211,"_23820":96212,"_2384":96213},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2857":57853,"_25170":57850,"_5":25503,"_17548":96215,"_23820":96216,"_2384":96217},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2857":57854,"_25170":57850,"_5":25503,"_17548":96219,"_23820":96220,"_2384":96221},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2857":57855,"_25170":57850,"_5":25503,"_17548":96223,"_23820":96224,"_2384":96225},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2857":57856,"_25170":57850,"_5":25503,"_17548":96227,"_23820":96228,"_2384":96229},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2857":57857,"_25170":57850,"_5":25503,"_17548":96231,"_23820":96232,"_2384":96233},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2857":57858,"_25170":57850,"_5":25503,"_17548":96235,"_23820":96236,"_2384":96237},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2857":57859,"_25170":57850,"_5":25503,"_17548":96239,"_23820":96240,"_2384":96241},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2857":57860,"_25170":57850,"_5":25503,"_17548":96243,"_23820":96244,"_2384":96245},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2857":57861,"_25170":57850,"_5":25503,"_17548":96247,"_23820":96248,"_2384":96249},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2857":57862,"_25170":57850,"_17548":96251,"_5":17443,"_23820":96212,"_2384":96252},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2857":57863,"_25170":57850,"_17548":96254,"_5":17443,"_23820":96212,"_2384":96255},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2857":57864,"_25170":57850,"_17548":96257,"_5":17443,"_23820":96216,"_2384":96258},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2857":57865,"_25170":57850,"_17548":96260,"_5":17443,"_23820":96216,"_2384":96261},[],"Fastlane instala o configura",{"_2857":57866,"_25170":57850,"_17548":96263,"_5":17443,"_23820":96216,"_2384":96264},[],"Tú sigues proporcionando",{"_2857":57867,"_25170":57850,"_17548":96266,"_5":17443,"_23820":96216,"_2384":96267},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2857":57868,"_25170":57850,"_17548":96269,"_5":17443,"_23820":96216,"_2384":96270},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2857":57869,"_25170":57850,"_17548":96272,"_5":17443,"_23820":96216,"_2384":96273},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2857":57870,"_25170":57850,"_17548":96275,"_5":17443,"_23820":96216,"_2384":96276},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2857":57871,"_25170":57850,"_17548":96278,"_5":17443,"_23820":96216,"_2384":96279},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2857":57872,"_25170":57850,"_17548":96281,"_5":17443,"_23820":96216,"_2384":96282},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2857":57873,"_25170":57850,"_17548":96284,"_5":17443,"_23820":96216,"_2384":96285},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2857":57874,"_25170":57850,"_17548":96287,"_5":17443,"_23820":96216,"_2384":96288},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2857":57875,"_25170":57850,"_17548":96290,"_5":17443,"_23820":96216,"_2384":96291},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2857":57876,"_25170":57850,"_17548":96293,"_5":17443,"_23820":96220,"_2384":96294},[],"Necesitas:",{"_2857":57877,"_25170":57850,"_17548":96296,"_5":17443,"_23820":96220,"_2384":96297},[],"un clúster Kubernetes existente",{"_2857":57878,"_25170":57850,"_17548":96299,"_5":17443,"_23820":96220,"_2384":96300},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2857":57879,"_25170":57850,"_17548":96302,"_5":17443,"_23820":96220,"_2384":41190},[],{"_2857":57880,"_25170":57850,"_17548":96304,"_5":17443,"_23820":96220,"_2384":19868},[],{"_2857":57881,"_25170":57850,"_17548":96306,"_5":17443,"_23820":96220,"_2384":96307},[],"`jq` solo si usas `--sample-data`",{"_2857":57882,"_25170":57850,"_17548":96309,"_5":17443,"_23820":96220,"_2384":96310},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2857":57883,"_25170":57850,"_17548":96312,"_5":17443,"_23820":96220,"_2384":96313},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2857":57884,"_25170":57850,"_17548":96315,"_5":17443,"_23820":96220,"_2384":96316},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2857":57885,"_25170":57850,"_17548":96318,"_5":17443,"_23820":96224,"_2384":96319},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2857":57886,"_25170":57850,"_17548":96321,"_5":17443,"_23820":96224,"_2384":96322},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2857":57887,"_25170":57850,"_17548":96324,"_5":17443,"_23820":96228,"_2384":96325},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2857":57888,"_25170":57850,"_17548":96327,"_5":17443,"_23820":96228,"_2384":96328},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2857":57889,"_25170":57850,"_17548":96330,"_5":17443,"_23820":96228,"_2384":96331},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2857":57890,"_25170":57850,"_17548":96333,"_5":17443,"_23820":96228,"_2384":96334},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2857":57891,"_25170":57850,"_17548":96336,"_5":17443,"_23820":96232,"_2384":96337},[],"Opción",{"_2857":57892,"_25170":57850,"_17548":96339,"_5":17443,"_23820":96232,"_2384":96340},[],"Valor predeterminado",{"_2857":57893,"_25170":57850,"_17548":96342,"_5":17443,"_23820":96232,"_2384":96343},[],"Propósito",{"_2857":57894,"_25170":57850,"_17548":96345,"_5":17443,"_23820":96232,"_2384":41234},[],{"_2857":57895,"_25170":57850,"_17548":96347,"_5":17443,"_23820":96232,"_2384":41237},[],{"_2857":57896,"_25170":57850,"_17548":96349,"_5":17443,"_23820":96232,"_2384":96350},[],"Muestra la ayuda",{"_2857":57897,"_25170":57850,"_17548":96352,"_5":17443,"_23820":96232,"_2384":41243},[],{"_2857":57898,"_25170":57850,"_17548":96354,"_5":17443,"_23820":96232,"_2384":96355},[],"contexto actual",{"_2857":57899,"_25170":57850,"_17548":96357,"_5":17443,"_23820":96232,"_2384":96358},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2857":57900,"_25170":57850,"_17548":96360,"_5":17443,"_23820":96232,"_2384":41252},[],{"_2857":57901,"_25170":57850,"_17548":96362,"_5":17443,"_23820":96232,"_2384":5349},[],{"_2857":57902,"_25170":57850,"_17548":96364,"_5":17443,"_23820":96232,"_2384":96365},[],"Omite prompts y genera credenciales para las dependencias",{"_2857":57903,"_25170":57850,"_17548":96367,"_5":17443,"_23820":96232,"_2384":41260},[],{"_2857":57904,"_25170":57850,"_17548":96369,"_5":17443,"_23820":96232,"_2384":41263},[],{"_2857":57905,"_25170":57850,"_17548":96371,"_5":17443,"_23820":96232,"_2384":96372},[],"Namespace de la instalación",{"_2857":57906,"_25170":57850,"_17548":96374,"_5":17443,"_23820":96232,"_2384":41269},[],{"_2857":57907,"_25170":57850,"_17548":96376,"_5":17443,"_23820":96232,"_2384":41272},[],{"_2857":57908,"_25170":57850,"_17548":96378,"_5":17443,"_23820":96232,"_2384":96379},[],"Dominio usado por la UI, OIDC y el certificado",{"_2857":57909,"_25170":57850,"_17548":96381,"_5":17443,"_23820":96232,"_2384":41278},[],{"_2857":57910,"_25170":57850,"_17548":96383,"_5":17443,"_23820":96232,"_2384":12520},[],{"_2857":57911,"_25170":57850,"_17548":96385,"_5":17443,"_23820":96232,"_2384":96386},[],"Versión del chart de Lamassu",{"_2857":57912,"_25170":57850,"_17548":96388,"_5":17443,"_23820":96232,"_2384":41286},[],{"_2857":57913,"_25170":57850,"_17548":96390,"_5":17443,"_23820":96232,"_2384":41289},[],{"_2857":57914,"_25170":57850,"_17548":96392,"_5":17443,"_23820":96232,"_2384":96393},[],"Puerto del listener HTTPS",{"_2857":57915,"_25170":57850,"_17548":96395,"_5":17443,"_23820":96232,"_2384":41295},[],{"_2857":57916,"_25170":57850,"_17548":96397,"_5":17443,"_23820":96232,"_2384":41298},[],{"_2857":57917,"_25170":57850,"_17548":96399,"_5":17443,"_23820":96232,"_2384":96400},[],"Puerto del listener HTTP",{"_2857":57918,"_25170":57850,"_17548":96402,"_5":17443,"_23820":96232,"_2384":41304},[],{"_2857":57919,"_25170":57850,"_17548":96404,"_5":17443,"_23820":96232,"_2384":41237},[],{"_2857":57920,"_25170":57850,"_17548":96406,"_5":17443,"_23820":96232,"_2384":96407},[],"Certificado PEM para TLS downstream",{"_2857":57921,"_25170":57850,"_17548":96409,"_5":17443,"_23820":96232,"_2384":41312},[],{"_2857":57922,"_25170":57850,"_17548":96411,"_5":17443,"_23820":96232,"_2384":41237},[],{"_2857":57923,"_25170":57850,"_17548":96413,"_5":17443,"_23820":96232,"_2384":96414},[],"Clave privada PEM para TLS downstream",{"_2857":57924,"_25170":57850,"_17548":96416,"_5":17443,"_23820":96232,"_2384":41320},[],{"_2857":57925,"_25170":57850,"_17548":96418,"_5":17443,"_23820":96232,"_2384":96419},[],"chart del repositorio",{"_2857":57926,"_25170":57850,"_17548":96421,"_5":17443,"_23820":96232,"_2384":96422},[],"Usa un chart local de Lamassu sin empaquetar",{"_2857":57927,"_25170":57850,"_17548":96424,"_5":17443,"_23820":96232,"_2384":41329},[],{"_2857":57928,"_25170":57850,"_17548":96426,"_5":17443,"_23820":96232,"_2384":96427},[],"detección automática",{"_2857":57929,"_25170":57850,"_17548":96429,"_5":17443,"_23820":96232,"_2384":96430},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2857":57930,"_25170":57850,"_17548":96432,"_5":17443,"_23820":96232,"_2384":41337},[],{"_2857":57931,"_25170":57850,"_17548":96434,"_5":17443,"_23820":96232,"_2384":5349},[],{"_2857":57932,"_25170":57850,"_17548":96436,"_5":17443,"_23820":96232,"_2384":96437},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2857":57933,"_25170":57850,"_17548":96439,"_5":17443,"_23820":96232,"_2384":41345},[],{"_2857":57934,"_25170":57850,"_17548":96441,"_5":17443,"_23820":96232,"_2384":5349},[],{"_2857":57935,"_25170":57850,"_17548":96443,"_5":17443,"_23820":96232,"_2384":96444},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2857":57936,"_25170":57850,"_17548":96446,"_5":17443,"_23820":96232,"_2384":41353},[],{"_2857":57937,"_25170":57850,"_17548":96448,"_5":17443,"_23820":96232,"_2384":5349},[],{"_2857":57938,"_25170":57850,"_17548":96450,"_5":17443,"_23820":96232,"_2384":96451},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2857":57939,"_25170":57850,"_17548":96453,"_5":17443,"_23820":96232,"_2384":41361},[],{"_2857":57940,"_25170":57850,"_17548":96455,"_5":17443,"_23820":96232,"_2384":41364},[],{"_2857":57941,"_25170":57850,"_17548":96457,"_5":17443,"_23820":96232,"_2384":96458},[],"Usa otro chart local de SoftHSM",{"_2857":57942,"_25170":57850,"_17548":96460,"_5":17443,"_23820":96232,"_2384":96461},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2857":57943,"_25170":57850,"_17548":96463,"_5":17443,"_23820":96236,"_2384":41373},[],{"_2857":57944,"_25170":57850,"_17548":96465,"_5":17443,"_23820":96236,"_2384":96466},[],"valida las herramientas locales y el clúster seleccionado",{"_2857":57945,"_25170":57850,"_17548":96468,"_5":17443,"_23820":96236,"_2384":96469},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2857":57946,"_25170":57850,"_17548":96471,"_5":17443,"_23820":96236,"_2384":96472},[],"crea el namespace",{"_2857":57947,"_25170":57850,"_17548":96474,"_5":17443,"_23820":96236,"_2384":96475},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2857":57948,"_25170":57850,"_17548":96477,"_5":17443,"_23820":96236,"_2384":96478},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2857":57949,"_25170":57850,"_17548":96480,"_5":17443,"_23820":96236,"_2384":96481},[],"instala RabbitMQ",{"_2857":57950,"_25170":57850,"_17548":96483,"_5":17443,"_23820":96236,"_2384":96484},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2857":57951,"_25170":57850,"_17548":96486,"_5":17443,"_23820":96236,"_2384":96487},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2857":57952,"_25170":57850,"_17548":96489,"_5":17443,"_23820":96236,"_2384":96490},[],"carga datos de ejemplo opcionalmente",{"_2857":57953,"_25170":57850,"_17548":96492,"_5":17443,"_23820":96236,"_2384":96493},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2857":57954,"_25170":57850,"_17548":96495,"_5":17443,"_23820":96240,"_2384":96496},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2857":57955,"_25170":57850,"_17548":96498,"_5":17443,"_23820":96240,"_2384":96499},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2857":57956,"_25170":57850,"_17548":96501,"_5":17443,"_23820":96244,"_2384":96502},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2857":57957,"_25170":57850,"_17548":96504,"_5":17443,"_23820":96244,"_2384":96505},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2857":57958,"_25170":57850,"_17548":96507,"_5":17443,"_23820":96244,"_2384":96508},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2857":57959,"_25170":57850,"_17548":96510,"_5":17443,"_23820":96248,"_2384":96511},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2857":57960,"_25170":57960,"_5":12294,"_2384":96513,"_25506":96514,"_17548":96515,"_23820":57960},"Instala con Helm",[40848,95971,96205],[],{"_2857":57961,"_25170":57960,"_17548":96517,"_5":17443,"_23820":57960,"_2384":96518},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2857":57962,"_25170":57960,"_5":25503,"_17548":96520,"_23820":96521,"_2384":96522},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2857":57963,"_25170":57960,"_5":25503,"_17548":96524,"_23820":96525,"_2384":96221},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2857":57964,"_25170":57960,"_5":25503,"_17548":96527,"_23820":96528,"_2384":96529},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2857":57965,"_25170":57960,"_5":25503,"_17548":96531,"_23820":96532,"_2384":96533},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2857":57966,"_25170":57960,"_5":25503,"_17548":96535,"_23820":96536,"_2384":96537},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2857":57967,"_25170":57960,"_5":25503,"_17548":96539,"_23820":96540,"_2384":96541},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2857":57968,"_25170":57960,"_5":25503,"_17548":96543,"_23820":96544,"_2384":96545},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2857":57969,"_25170":57960,"_5":25503,"_17548":96547,"_23820":96548,"_2384":96549},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2857":57970,"_25170":57960,"_5":25503,"_17548":96551,"_23820":96552,"_2384":96553},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2857":57971,"_25170":57960,"_17548":96555,"_5":17443,"_23820":96521,"_2384":96556},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2857":57972,"_25170":57960,"_17548":96558,"_5":17443,"_23820":96525,"_2384":96559},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2857":57973,"_25170":57960,"_17548":96561,"_5":17443,"_23820":96525,"_2384":96562},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2857":57974,"_25170":57960,"_17548":96564,"_5":17443,"_23820":96525,"_2384":96565},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2857":57975,"_25170":57960,"_17548":96567,"_5":17443,"_23820":96525,"_2384":96568},[],"un broker RabbitMQ accesible y sus credenciales",{"_2857":57976,"_25170":57960,"_17548":96570,"_5":17443,"_23820":96525,"_2384":96571},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2857":57977,"_25170":57960,"_17548":96573,"_5":17443,"_23820":96525,"_2384":96574},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2857":57978,"_25170":57960,"_17548":96576,"_5":17443,"_23820":96525,"_2384":96577},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2857":57979,"_25170":57960,"_17548":96579,"_5":17443,"_23820":96525,"_2384":96580},[],"una StorageClass y un diseño de tráfico externo",{"_2857":57980,"_25170":57960,"_17548":96582,"_5":17443,"_23820":96525,"_2384":96583},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2857":57981,"_25170":57960,"_17548":96585,"_5":17443,"_23820":96525,"_2384":96586},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2857":57982,"_25170":57960,"_17548":96588,"_5":17443,"_23820":96525,"_2384":96589},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2857":57983,"_25170":57960,"_17548":96591,"_5":17443,"_23820":96528,"_2384":96592},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2857":57984,"_25170":57960,"_17548":96594,"_5":17443,"_23820":96528,"_2384":96595},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2857":57985,"_25170":57960,"_17548":96597,"_5":17443,"_23820":96528,"_2384":96598},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2857":57986,"_25170":57960,"_17548":96600,"_5":17443,"_23820":96532,"_2384":96601},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2857":57987,"_25170":57960,"_17548":96603,"_5":17443,"_23820":96532,"_2384":96604},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2857":57988,"_25170":57960,"_17548":96606,"_5":17443,"_23820":96532,"_2384":96607},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2857":57989,"_25170":57960,"_17548":96609,"_5":17443,"_23820":96536,"_2384":96610},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2857":57990,"_25170":57960,"_17548":96612,"_5":17443,"_23820":96540,"_2384":96613},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2857":57991,"_25170":57960,"_17548":96615,"_5":17443,"_23820":96540,"_2384":96616},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2857":57992,"_25170":57960,"_17548":96618,"_5":17443,"_23820":96540,"_2384":96619},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2857":57993,"_25170":57960,"_17548":96621,"_5":17443,"_23820":96540,"_2384":96622},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2857":57994,"_25170":57960,"_17548":96624,"_5":17443,"_23820":96544,"_2384":96625},[],"Para instalar un checkout local:",{"_2857":57995,"_25170":57960,"_17548":96627,"_5":17443,"_23820":96548,"_2384":96628},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2857":57996,"_25170":57960,"_17548":96630,"_5":17443,"_23820":96548,"_2384":96631},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2857":57997,"_25170":57960,"_17548":96633,"_5":17443,"_23820":96552,"_2384":96634},[],"Antes de pasar a producción, revisa:",{"_2857":57998,"_25170":57960,"_17548":96636,"_5":17443,"_23820":96552,"_2384":96637},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2857":57999,"_25170":57960,"_17548":96639,"_5":17443,"_23820":96552,"_2384":96640},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2857":58000,"_25170":57960,"_17548":96642,"_5":17443,"_23820":96552,"_2384":96643},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2857":58001,"_25170":57960,"_17548":96645,"_5":17443,"_23820":96552,"_2384":96646},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2857":58002,"_25170":57960,"_17548":96648,"_5":17443,"_23820":96552,"_2384":96649},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2857":58003,"_25170":57960,"_17548":96651,"_5":17443,"_23820":96552,"_2384":96652},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2857":58004,"_25170":57960,"_17548":96654,"_5":17443,"_23820":96552,"_2384":96655},[],"SMTP, observabilidad y entrega de alertas",{"_2857":58005,"_25170":57960,"_17548":96657,"_5":17443,"_23820":96552,"_2384":96658},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2857":58006,"_25170":57960,"_17548":96660,"_5":17443,"_23820":96552,"_2384":96661},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2857":58007,"_25170":58007,"_5":12294,"_2384":96663,"_25506":96664,"_17548":96665,"_23820":58007},"Expón el Gateway",[40848,95971,96205],[],{"_2857":58008,"_25170":58007,"_17548":96667,"_5":17443,"_23820":58007,"_2384":96668},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2857":58009,"_25170":58007,"_5":25503,"_17548":96670,"_23820":96671,"_2384":96672},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2857":58010,"_25170":58007,"_5":25503,"_17548":96674,"_23820":96675,"_2384":96676},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2857":58011,"_25170":58007,"_5":25503,"_17548":96678,"_23820":96679,"_2384":96680},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2857":58012,"_25170":58007,"_5":25503,"_17548":96682,"_23820":96683,"_2384":41594},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#k3s",{"_2857":58013,"_25170":58007,"_5":25503,"_17548":96685,"_23820":96686,"_2384":96687},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2857":58014,"_25170":58007,"_5":25503,"_17548":96689,"_23820":96690,"_2384":96691},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2857":58015,"_25170":58007,"_5":25503,"_17548":96693,"_23820":96694,"_2384":96695},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2857":58016,"_25170":58007,"_5":25503,"_17548":96697,"_23820":96698,"_2384":96699},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2857":58017,"_25170":58007,"_5":25503,"_17548":96701,"_23820":96702,"_2384":96703},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2857":58018,"_25170":58007,"_17548":96705,"_5":17443,"_23820":96671,"_2384":96706},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2857":58019,"_25170":58007,"_17548":96708,"_5":17443,"_23820":96671,"_2384":96709},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2857":58020,"_25170":58007,"_17548":96711,"_5":17443,"_23820":96675,"_2384":96712},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2857":58021,"_25170":58007,"_17548":96714,"_5":17443,"_23820":96675,"_2384":96715},[],"Defínelo únicamente cuando:",{"_2857":58022,"_25170":58007,"_17548":96717,"_5":17443,"_23820":96675,"_2384":96718},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2857":58023,"_25170":58007,"_17548":96720,"_5":17443,"_23820":96675,"_2384":96721},[],"esa dirección está asignada a este Gateway",{"_2857":58024,"_25170":58007,"_17548":96723,"_5":17443,"_23820":96675,"_2384":96724},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2857":58025,"_25170":58007,"_17548":96726,"_5":17443,"_23820":96675,"_2384":96727},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2857":58026,"_25170":58007,"_17548":96729,"_5":17443,"_23820":96675,"_2384":96730},[],"No confundas estos valores:",{"_2857":58027,"_25170":58007,"_17548":96732,"_5":17443,"_23820":96675,"_2384":96733},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2857":58028,"_25170":58007,"_17548":96735,"_5":17443,"_23820":96675,"_2384":96736},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2857":58029,"_25170":58007,"_17548":96738,"_5":17443,"_23820":96675,"_2384":96739},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2857":58030,"_25170":58007,"_17548":96741,"_5":17443,"_23820":96679,"_2384":96742},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2857":58031,"_25170":58007,"_17548":96744,"_5":17443,"_23820":96679,"_2384":96745},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2857":58032,"_25170":58007,"_17548":96747,"_5":17443,"_23820":96683,"_2384":96748},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2857":58033,"_25170":58007,"_17548":96750,"_5":17443,"_23820":96683,"_2384":96751},[],"Para el diseño recomendado:",{"_2857":58034,"_25170":58007,"_17548":96753,"_5":17443,"_23820":96683,"_2384":96754},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2857":58035,"_25170":58007,"_17548":96756,"_5":17443,"_23820":96683,"_2384":96757},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2857":58036,"_25170":58007,"_17548":96759,"_5":17443,"_23820":96683,"_2384":96760},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2857":58037,"_25170":58007,"_17548":96762,"_5":17443,"_23820":96683,"_2384":96763},[],"Apunta DNS a la dirección accesible de la VM.",{"_2857":58038,"_25170":58007,"_17548":96765,"_5":17443,"_23820":96683,"_2384":96766},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2857":58039,"_25170":58007,"_17548":96768,"_5":17443,"_23820":96686,"_2384":96769},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2857":58040,"_25170":58007,"_17548":96771,"_5":17443,"_23820":96690,"_2384":96772},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2857":58041,"_25170":58007,"_17548":96774,"_5":17443,"_23820":96690,"_2384":96775},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2857":58042,"_25170":58007,"_17548":96777,"_5":17443,"_23820":96694,"_2384":96778},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2857":58043,"_25170":58007,"_17548":96780,"_5":17443,"_23820":96694,"_2384":96781},[],"Requisito",{"_2857":58044,"_25170":58007,"_17548":96783,"_5":17443,"_23820":96694,"_2384":96784},[],"Diseño recomendado",{"_2857":58045,"_25170":58007,"_17548":96786,"_5":17443,"_23820":96694,"_2384":96787},[],"Consecuencia",{"_2857":58046,"_25170":58007,"_17548":96789,"_5":17443,"_23820":96694,"_2384":96790},[],"Varias URL o servicios de Lamassu",{"_2857":58047,"_25170":58007,"_17548":96792,"_5":17443,"_23820":96694,"_2384":96793},[],"Un Gateway con varias rutas",{"_2857":58048,"_25170":58007,"_17548":96795,"_5":17443,"_23820":96694,"_2384":96796},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2857":58049,"_25170":58007,"_17548":96798,"_5":17443,"_23820":96694,"_2384":96799},[],"Gateways independientes e IP externas distintas",{"_2857":58050,"_25170":58007,"_17548":96801,"_5":17443,"_23820":96694,"_2384":96802},[],"Una VIP por Gateway",{"_2857":58051,"_25170":58007,"_17548":96804,"_5":17443,"_23820":96694,"_2384":96805},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2857":58052,"_25170":58007,"_17548":96807,"_5":17443,"_23820":96694,"_2384":96808},[],"Gateways independientes, un nodo y una IP",{"_2857":58053,"_25170":58007,"_17548":96810,"_5":17443,"_23820":96694,"_2384":96811},[],"Puertos externos diferentes",{"_2857":58054,"_25170":58007,"_17548":96813,"_5":17443,"_23820":96694,"_2384":96814},[],"Los clientes deben indicar puertos no estándar",{"_2857":58055,"_25170":58007,"_17548":96816,"_5":17443,"_23820":96694,"_2384":96817},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2857":58056,"_25170":58007,"_17548":96819,"_5":17443,"_23820":96694,"_2384":96820},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2857":58057,"_25170":58007,"_17548":96822,"_5":17443,"_23820":96694,"_2384":96823},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2857":58058,"_25170":58007,"_17548":96825,"_5":17443,"_23820":96694,"_2384":96826},[],"Recursos Gateway separados pero proxy compartido",{"_2857":58059,"_25170":58007,"_17548":96828,"_5":17443,"_23820":96694,"_2384":96829},[],"Modo merged Gateway de Envoy",{"_2857":58060,"_25170":58007,"_17548":96831,"_5":17443,"_23820":96694,"_2384":96832},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2857":58061,"_25170":58007,"_17548":96834,"_5":17443,"_23820":96694,"_2384":96835},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2857":58062,"_25170":58007,"_17548":96837,"_5":17443,"_23820":96694,"_2384":96838},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2857":58063,"_25170":58007,"_17548":96840,"_5":17443,"_23820":96694,"_2384":96841},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2857":58064,"_25170":58007,"_17548":96843,"_5":17443,"_23820":96694,"_2384":96844},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2857":58065,"_25170":58007,"_17548":96846,"_5":17443,"_23820":96698,"_2384":96847},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2857":58066,"_25170":58007,"_17548":96849,"_5":17443,"_23820":96698,"_2384":96850},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2857":58067,"_25170":58007,"_17548":96852,"_5":17443,"_23820":96698,"_2384":96853},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2857":58068,"_25170":58007,"_17548":96855,"_5":17443,"_23820":96698,"_2384":96856},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2857":58069,"_25170":58007,"_17548":96858,"_5":17443,"_23820":96698,"_2384":96859},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2857":58070,"_25170":58007,"_17548":96861,"_5":17443,"_23820":96702,"_2384":96862},[],"Comprueba, en orden:",{"_2857":58071,"_25170":58007,"_17548":96864,"_5":17443,"_23820":96702,"_2384":96865},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2857":58072,"_25170":58007,"_17548":96867,"_5":17443,"_23820":96702,"_2384":96868},[],"Su estado contiene la dirección esperada.",{"_2857":58073,"_25170":58007,"_17548":96870,"_5":17443,"_23820":96702,"_2384":96871},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2857":58074,"_25170":58007,"_17548":96873,"_5":17443,"_23820":96702,"_2384":96874},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2857":58075,"_25170":58007,"_17548":96876,"_5":17443,"_23820":96702,"_2384":96877},[],"DNS resuelve al endpoint accesible externamente.",{"_2857":58076,"_25170":58007,"_17548":96879,"_5":17443,"_23820":96702,"_2384":96880},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2857":58077,"_25170":58007,"_17548":96882,"_5":17443,"_23820":96702,"_2384":96883},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2857":58078,"_25170":58078,"_5":12294,"_2384":40955,"_25506":96885,"_17548":96886,"_23820":58078},[40848,95971,96205],[],{"_2857":58079,"_25170":58078,"_17548":96888,"_5":17443,"_23820":58078,"_2384":96889},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2857":58080,"_25170":58078,"_5":25503,"_17548":96891,"_23820":96892,"_2384":96893},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2857":58081,"_25170":58078,"_5":25503,"_17548":96895,"_23820":96896,"_2384":96897},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2857":58082,"_25170":58078,"_5":25503,"_17548":96899,"_23820":96900,"_2384":96901},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2857":58083,"_25170":58078,"_5":25503,"_17548":96903,"_23820":96904,"_2384":96905},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2857":58084,"_25170":58078,"_5":25503,"_17548":96907,"_23820":96908,"_2384":96909},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2857":58085,"_25170":58078,"_5":25503,"_17548":96911,"_23820":96912,"_2384":96913},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2857":58086,"_25170":58078,"_17548":96915,"_5":17443,"_23820":96892,"_2384":96916},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2857":58087,"_25170":58078,"_17548":96918,"_5":17443,"_23820":96896,"_2384":96919},[],"Flujo",{"_2857":58088,"_25170":58078,"_17548":96921,"_5":17443,"_23820":96896,"_2384":96922},[],"Úsalo para",{"_2857":58089,"_25170":58078,"_17548":96924,"_5":17443,"_23820":96896,"_2384":96925},[],"Qué instala",{"_2857":58090,"_25170":58078,"_17548":96927,"_5":17443,"_23820":96896,"_2384":41839},[],{"_2857":58091,"_25170":58078,"_17548":96929,"_5":17443,"_23820":96896,"_2384":96930},[],"Producción y entornos controlados",{"_2857":58092,"_25170":58078,"_17548":96932,"_5":17443,"_23820":96896,"_2384":96933},[],"Servicios de Lamassu y recursos de Gateway API",{"_2857":58093,"_25170":58078,"_17548":96935,"_5":17443,"_23820":96896,"_2384":41092},[],{"_2857":58094,"_25170":58078,"_17548":96937,"_5":17443,"_23820":96896,"_2384":96938},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2857":58095,"_25170":58078,"_17548":96940,"_5":17443,"_23820":96896,"_2384":96941},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2857":58096,"_25170":58078,"_17548":96943,"_5":17443,"_23820":96900,"_2384":96944},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2857":58097,"_25170":58078,"_17548":96946,"_5":17443,"_23820":96900,"_2384":96947},[],"Área",{"_2857":58098,"_25170":58078,"_17548":96949,"_5":17443,"_23820":96900,"_2384":96950},[],"El chart de Lamassu proporciona",{"_2857":58099,"_25170":58078,"_17548":96952,"_5":17443,"_23820":96900,"_2384":96953},[],"Tú proporcionas",{"_2857":58100,"_25170":58078,"_17548":96955,"_5":17443,"_23820":96900,"_2384":96956},[],"Aplicaciones Lamassu",{"_2857":58101,"_25170":58078,"_17548":96958,"_5":17443,"_23820":96900,"_2384":96959},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2857":58102,"_25170":58078,"_17548":96961,"_5":17443,"_23820":96900,"_2384":96962},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2857":58103,"_25170":58078,"_17548":96964,"_5":17443,"_23820":96900,"_2384":96965},[],"Datos PostgreSQL",{"_2857":58104,"_25170":58078,"_17548":96967,"_5":17443,"_23820":96900,"_2384":96968},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2857":58105,"_25170":58078,"_17548":96970,"_5":17443,"_23820":96900,"_2384":96971},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2857":58106,"_25170":58078,"_17548":96973,"_5":17443,"_23820":96900,"_2384":96974},[],"Mensajería",{"_2857":58107,"_25170":58078,"_17548":96976,"_5":17443,"_23820":96900,"_2384":96977},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2857":58108,"_25170":58078,"_17548":96979,"_5":17443,"_23820":96900,"_2384":96980},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2857":58109,"_25170":58078,"_17548":96982,"_5":17443,"_23820":96900,"_2384":96983},[],"Identidad",{"_2857":58110,"_25170":58078,"_17548":96985,"_5":17443,"_23820":96900,"_2384":96986},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2857":58111,"_25170":58078,"_17548":96988,"_5":17443,"_23820":96900,"_2384":96989},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2857":58112,"_25170":58078,"_17548":96991,"_5":17443,"_23820":96900,"_2384":96992},[],"Enrutamiento externo",{"_2857":58113,"_25170":58078,"_17548":96994,"_5":17443,"_23820":96900,"_2384":96995},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2857":58114,"_25170":58078,"_17548":96997,"_5":17443,"_23820":96900,"_2384":96998},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2857":58115,"_25170":58078,"_17548":97000,"_5":17443,"_23820":96900,"_2384":41913},[],{"_2857":58116,"_25170":58078,"_17548":97002,"_5":17443,"_23820":96900,"_2384":97003},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2857":58117,"_25170":58078,"_17548":97005,"_5":17443,"_23820":96900,"_2384":97006},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2857":58118,"_25170":58078,"_17548":97008,"_5":17443,"_23820":96900,"_2384":97009},[],"Datos persistentes de la aplicación",{"_2857":58119,"_25170":58078,"_17548":97011,"_5":17443,"_23820":96900,"_2384":97012},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2857":58120,"_25170":58078,"_17548":97014,"_5":17443,"_23820":96900,"_2384":97015},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2857":58121,"_25170":58078,"_17548":97017,"_5":17443,"_23820":96900,"_2384":97018},[],"Integraciones opcionales",{"_2857":58122,"_25170":58078,"_17548":97020,"_5":17443,"_23820":96900,"_2384":97021},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2857":58123,"_25170":58078,"_17548":97023,"_5":17443,"_23820":96900,"_2384":97024},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2857":58124,"_25170":58078,"_17548":97026,"_5":17443,"_23820":96900,"_2384":97027},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2857":58125,"_25170":58078,"_17548":97029,"_5":17443,"_23820":96900,"_2384":97030},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2857":58126,"_25170":58078,"_17548":97032,"_5":17443,"_23820":96904,"_2384":97033},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2857":58127,"_25170":58078,"_17548":97035,"_5":17443,"_23820":96904,"_2384":97036},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2857":58128,"_25170":58078,"_17548":97038,"_5":17443,"_23820":96908,"_2384":97039},[],"Kubernetes 1.24 o posterior",{"_2857":58129,"_25170":58078,"_17548":97041,"_5":17443,"_23820":96908,"_2384":97042},[],"Helm 3.2 o posterior",{"_2857":58130,"_25170":58078,"_17548":97044,"_5":17443,"_23820":96908,"_2384":97045},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2857":58131,"_25170":58078,"_17548":97047,"_5":17443,"_23820":96908,"_2384":97048},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2857":58132,"_25170":58078,"_17548":97050,"_5":17443,"_23820":96908,"_2384":97051},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2857":58133,"_25170":58078,"_17548":97053,"_5":17443,"_23820":96908,"_2384":97054},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2857":58134,"_25170":58078,"_17548":97056,"_5":17443,"_23820":96908,"_2384":97057},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2857":58135,"_25170":58078,"_17548":97059,"_5":17443,"_23820":96912,"_2384":97060},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2857":58136,"_25170":58078,"_17548":97062,"_5":17443,"_23820":96912,"_2384":97063},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2857":58137,"_25170":58078,"_17548":97065,"_5":17443,"_23820":96912,"_2384":97066},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2857":58138,"_25170":58138,"_5":12294,"_2384":97068,"_25506":97069,"_17548":97071,"_23820":58138},"Resolución de problemas de despliegue",[40848,95971,97070],"Operación",[],{"_2857":58139,"_25170":58138,"_17548":97073,"_5":17443,"_23820":58138,"_2384":97074},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2857":58140,"_25170":58138,"_5":25503,"_17548":97076,"_23820":97077,"_2384":97078},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2857":58141,"_25170":58138,"_5":25503,"_17548":97080,"_23820":97081,"_2384":97082},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2857":58142,"_25170":58138,"_5":25503,"_17548":97084,"_23820":97085,"_2384":97086},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2857":58143,"_25170":58138,"_5":25503,"_17548":97088,"_23820":97089,"_2384":97090},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2857":58144,"_25170":58138,"_5":25503,"_17548":97092,"_23820":97093,"_2384":97094},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2857":58145,"_25170":58138,"_5":25503,"_17548":97096,"_23820":97097,"_2384":97098},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2857":58146,"_25170":58138,"_5":25503,"_17548":97100,"_23820":97101,"_2384":97102},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2857":58147,"_25170":58138,"_5":25503,"_17548":97104,"_23820":97105,"_2384":97106},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2857":58148,"_25170":58138,"_5":25503,"_17548":97108,"_23820":97109,"_2384":97110},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2857":58149,"_25170":58138,"_5":25503,"_17548":97112,"_23820":97113,"_2384":97114},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2857":58150,"_25170":58138,"_5":25503,"_17548":97116,"_23820":97117,"_2384":97118},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2857":58151,"_25170":58138,"_5":25503,"_17548":97120,"_23820":97121,"_2384":97122},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2857":58152,"_25170":58138,"_17548":97124,"_5":17443,"_23820":58138,"_2384":97125},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2857":58153,"_25170":58138,"_17548":97127,"_5":17443,"_23820":97081,"_2384":97128},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2857":58154,"_25170":58138,"_17548":97130,"_5":17443,"_23820":97085,"_2384":97131},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2857":58155,"_25170":58138,"_17548":97133,"_5":17443,"_23820":97089,"_2384":97134},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2857":58156,"_25170":58138,"_17548":97136,"_5":17443,"_23820":97093,"_2384":97137},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2857":58157,"_25170":58138,"_17548":97139,"_5":17443,"_23820":97097,"_2384":97140},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2857":58158,"_25170":58138,"_17548":97142,"_5":17443,"_23820":97101,"_2384":97143},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2857":58159,"_25170":58138,"_17548":97145,"_5":17443,"_23820":97101,"_2384":97146},[],"Ejecuta también la prueba de conectividad del chart:",{"_2857":58160,"_25170":58138,"_17548":97148,"_5":17443,"_23820":97101,"_2384":97149},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2857":58161,"_25170":58138,"_17548":97151,"_5":17443,"_23820":97101,"_2384":97152},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2857":58162,"_25170":58138,"_17548":97154,"_5":17443,"_23820":97105,"_2384":97155},[],"Si recibes un 401:",{"_2857":58163,"_25170":58138,"_17548":97157,"_5":17443,"_23820":97105,"_2384":97158},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2857":58164,"_25170":58138,"_17548":97160,"_5":17443,"_23820":97105,"_2384":97161},[],"verifica emisor, audiencia y expiración del token;",{"_2857":58165,"_25170":58138,"_17548":97163,"_5":17443,"_23820":97105,"_2384":97164},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2857":58166,"_25170":58138,"_17548":97166,"_5":17443,"_23820":97105,"_2384":97167},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2857":58167,"_25170":58138,"_17548":97169,"_5":17443,"_23820":97105,"_2384":97170},[],"Si el login termina pero las APIs devuelven 403:",{"_2857":58168,"_25170":58138,"_17548":97172,"_5":17443,"_23820":97105,"_2384":97173},[],"inspecciona los claims reales del token;",{"_2857":58169,"_25170":58138,"_17548":97175,"_5":17443,"_23820":97105,"_2384":97176},[],"confirma que coinciden con un principal activo;",{"_2857":58170,"_25170":58138,"_17548":97178,"_5":17443,"_23820":97105,"_2384":97179},[],"revisa las políticas concedidas al principal;",{"_2857":58171,"_25170":58138,"_17548":97181,"_5":17443,"_23820":97105,"_2384":97182},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2857":58172,"_25170":58138,"_17548":97184,"_5":17443,"_23820":97105,"_2384":97185},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2857":58173,"_25170":58138,"_17548":97187,"_5":17443,"_23820":97109,"_2384":97188},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2857":58174,"_25170":58138,"_17548":97190,"_5":17443,"_23820":97109,"_2384":97191},[],"Localiza el pod y Service de authz.",{"_2857":58175,"_25170":58138,"_17548":97193,"_5":17443,"_23820":97109,"_2384":97194},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2857":58176,"_25170":58138,"_17548":97196,"_5":17443,"_23820":97109,"_2384":97197},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2857":58177,"_25170":58138,"_17548":97199,"_5":17443,"_23820":97109,"_2384":97200},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2857":58178,"_25170":58138,"_17548":97202,"_5":17443,"_23820":97109,"_2384":97203},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2857":58179,"_25170":58138,"_17548":97205,"_5":17443,"_23820":97113,"_2384":97206},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2857":58180,"_25170":58138,"_17548":97208,"_5":17443,"_23820":97113,"_2384":97209},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2857":58181,"_25170":58138,"_17548":97211,"_5":17443,"_23820":97113,"_2384":97212},[],"volumen persistente sin enlazar;",{"_2857":58182,"_25170":58138,"_17548":97214,"_5":17443,"_23820":97113,"_2384":97215},[],"imagen inaccesible o política de pull incorrecta;",{"_2857":58183,"_25170":58138,"_17548":97217,"_5":17443,"_23820":97113,"_2384":97218},[],"configuración inválida del motor criptográfico;",{"_2857":58184,"_25170":58138,"_17548":97220,"_5":17443,"_23820":97113,"_2384":97221},[],"límites de CPU o memoria demasiado bajos;",{"_2857":58185,"_25170":58138,"_17548":97223,"_5":17443,"_23820":97113,"_2384":97224},[],"migración previa incompleta.",{"_2857":58186,"_25170":58138,"_17548":97226,"_5":17443,"_23820":97113,"_2384":97227},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2857":58187,"_25170":58138,"_17548":97229,"_5":17443,"_23820":97113,"_2384":97230},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2857":58188,"_25170":58138,"_17548":97232,"_5":17443,"_23820":97117,"_2384":97233},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2857":58189,"_25170":58138,"_17548":97235,"_5":17443,"_23820":97117,"_2384":97236},[],"verifica que esté habilitado en el servicio emisor;",{"_2857":58190,"_25170":58138,"_17548":97238,"_5":17443,"_23820":97117,"_2384":97239},[],"comprueba conectividad y credenciales AMQP;",{"_2857":58191,"_25170":58138,"_17548":97241,"_5":17443,"_23820":97117,"_2384":97242},[],"revisa exchange, routing key, colas y consumidores;",{"_2857":58192,"_25170":58138,"_17548":97244,"_5":17443,"_23820":97117,"_2384":97245},[],"inspecciona dead-letter queues;",{"_2857":58193,"_25170":58138,"_17548":97247,"_5":17443,"_23820":97117,"_2384":97248},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2857":58194,"_25170":58138,"_17548":97250,"_5":17443,"_23820":97117,"_2384":97251},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2857":58195,"_25170":58138,"_17548":97253,"_5":17443,"_23820":97121,"_2384":97254},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2857":58196,"_25170":58138,"_17548":97256,"_5":17443,"_23820":97121,"_2384":97257},[],"Antes de cerrar una incidencia, guarda:",{"_2857":58197,"_25170":58138,"_17548":97259,"_5":17443,"_23820":97121,"_2384":97260},[],"causa confirmada;",{"_2857":58198,"_25170":58138,"_17548":97262,"_5":17443,"_23820":97121,"_2384":97263},[],"alcance temporal y recursos afectados;",{"_2857":58199,"_25170":58138,"_17548":97265,"_5":17443,"_23820":97121,"_2384":97266},[],"comandos o consultas utilizados;",{"_2857":58200,"_25170":58138,"_17548":97268,"_5":17443,"_23820":97121,"_2384":97269},[],"cambio aplicado y forma de revertirlo;",{"_2857":58201,"_25170":58138,"_17548":97271,"_5":17443,"_23820":97121,"_2384":97272},[],"validación desde un consumidor;",{"_2857":58202,"_25170":58138,"_17548":97274,"_5":17443,"_23820":97121,"_2384":97275},[],"acción preventiva y propietario.",{"_2857":58203,"_25170":58203,"_5":12294,"_2384":97277,"_25506":97278,"_17548":97281,"_23820":58203},"Control de acceso",[40848,97279,97280],"Plataforma","Administración",[],{"_2857":58204,"_25170":58203,"_17548":97283,"_5":17443,"_23820":58203,"_2384":97284},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2857":58205,"_25170":58203,"_5":25503,"_17548":97286,"_23820":97287,"_2384":97288},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2857":58206,"_25170":58203,"_5":25503,"_17548":97290,"_23820":97291,"_2384":97292},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2857":58207,"_25170":58203,"_5":25503,"_17548":97294,"_23820":97295,"_2384":97296},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2857":58208,"_25170":58203,"_5":25503,"_17548":97298,"_23820":97299,"_2384":97300},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2857":58209,"_25170":58203,"_5":25503,"_17548":97302,"_23820":97303,"_2384":97304},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2857":58210,"_25170":58203,"_5":25503,"_17548":97306,"_23820":97307,"_2384":97308},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2857":58211,"_25170":58203,"_5":25503,"_17548":97310,"_23820":97311,"_2384":97312},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2857":58212,"_25170":58203,"_5":25503,"_17548":97314,"_23820":97315,"_2384":97316},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2857":58213,"_25170":58203,"_5":25503,"_17548":97318,"_23820":97319,"_2384":97320},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2857":58214,"_25170":58203,"_5":25503,"_17548":97322,"_23820":97323,"_2384":97324},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2857":58215,"_25170":58203,"_5":25503,"_17548":97326,"_23820":97327,"_2384":97328},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2857":58216,"_25170":58203,"_5":25503,"_17548":97330,"_23820":97331,"_2384":97332},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2857":58217,"_25170":58203,"_5":25503,"_17548":97334,"_23820":97335,"_2384":97336},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2857":58218,"_25170":58203,"_5":25503,"_17548":97338,"_23820":97339,"_2384":97340},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2857":58219,"_25170":58203,"_5":25503,"_17548":97342,"_23820":97343,"_2384":97344},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2857":58220,"_25170":58203,"_5":25503,"_17548":97346,"_23820":97347,"_2384":96541},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2857":58221,"_25170":58203,"_5":25503,"_17548":97349,"_23820":97350,"_2384":97351},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2857":58222,"_25170":58203,"_5":25503,"_17548":97353,"_23820":97354,"_2384":97355},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2857":58223,"_25170":58203,"_5":25503,"_17548":97357,"_23820":97358,"_2384":97359},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2857":58224,"_25170":58203,"_5":25503,"_17548":97361,"_23820":97362,"_2384":97363},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2857":58225,"_25170":58203,"_5":25503,"_17548":97365,"_23820":97366,"_2384":97367},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2857":58226,"_25170":58203,"_5":25503,"_17548":97369,"_23820":97370,"_2384":97371},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2857":58227,"_25170":58203,"_5":25503,"_17548":97373,"_23820":97374,"_2384":97375},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2857":58228,"_25170":58203,"_5":25503,"_17548":97377,"_23820":97378,"_2384":97379},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2857":58229,"_25170":58203,"_5":25503,"_17548":97381,"_23820":97382,"_2384":97383},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2857":58230,"_25170":58203,"_5":25503,"_17548":97385,"_23820":97386,"_2384":97387},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2857":58231,"_25170":58203,"_5":25503,"_17548":97389,"_23820":97390,"_2384":97391},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2857":58232,"_25170":58203,"_5":25503,"_17548":97393,"_23820":97394,"_2384":97395},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2857":58233,"_25170":58203,"_5":25503,"_17548":97397,"_23820":97398,"_2384":97399},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2857":58234,"_25170":58203,"_5":25503,"_17548":97401,"_23820":97402,"_2384":97403},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2857":58235,"_25170":58203,"_5":25503,"_17548":97405,"_23820":97406,"_2384":97407},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2857":58236,"_25170":58203,"_17548":97409,"_5":17443,"_23820":58203,"_2384":97410},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2857":58237,"_25170":58203,"_17548":97412,"_5":17443,"_23820":58203,"_2384":97413},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2857":58238,"_25170":58203,"_17548":97415,"_5":17443,"_23820":58203,"_2384":97416},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2857":58239,"_25170":58203,"_17548":97418,"_5":17443,"_23820":97287,"_2384":97419},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2857":58240,"_25170":58203,"_17548":97421,"_5":17443,"_23820":97287,"_2384":97422},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2857":58241,"_25170":58203,"_17548":97424,"_5":17443,"_23820":97287,"_2384":97425},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2857":58242,"_25170":58203,"_17548":97427,"_5":17443,"_23820":97287,"_2384":97428},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2857":58243,"_25170":58203,"_17548":97430,"_5":17443,"_23820":97287,"_2384":97431},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2857":58244,"_25170":58203,"_17548":97433,"_5":17443,"_23820":97287,"_2384":97434},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2857":58245,"_25170":58203,"_17548":97436,"_5":17443,"_23820":97291,"_2384":97437},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2857":58246,"_25170":58203,"_17548":97439,"_5":17443,"_23820":97291,"_2384":97440},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2857":58247,"_25170":58203,"_17548":97442,"_5":17443,"_23820":97295,"_2384":97443},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2857":58248,"_25170":58203,"_17548":97445,"_5":17443,"_23820":97295,"_2384":97446},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2857":58249,"_25170":58203,"_17548":97448,"_5":17443,"_23820":97295,"_2384":97449},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2857":58250,"_25170":58203,"_17548":97451,"_5":17443,"_23820":97295,"_2384":97452},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2857":58251,"_25170":58203,"_17548":97454,"_5":17443,"_23820":97295,"_2384":97455},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2857":58252,"_25170":58203,"_17548":97457,"_5":17443,"_23820":97295,"_2384":97458},[],"Carga por separado las políticas concedidas a cada principal.",{"_2857":58253,"_25170":58203,"_17548":97460,"_5":17443,"_23820":97295,"_2384":97461},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2857":58254,"_25170":58203,"_17548":97463,"_5":17443,"_23820":97295,"_2384":97464},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2857":58255,"_25170":58203,"_17548":97466,"_5":17443,"_23820":97295,"_2384":97467},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2857":58256,"_25170":58203,"_17548":97469,"_5":17443,"_23820":97295,"_2384":97470},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2857":58257,"_25170":58203,"_17548":97472,"_5":17443,"_23820":97295,"_2384":97473},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2857":58258,"_25170":58203,"_17548":97475,"_5":17443,"_23820":97295,"_2384":97476},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2857":58259,"_25170":58203,"_17548":97478,"_5":17443,"_23820":97299,"_2384":97479},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2857":58260,"_25170":58203,"_17548":97481,"_5":17443,"_23820":97299,"_2384":97482},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2857":58261,"_25170":58203,"_17548":97484,"_5":17443,"_23820":97299,"_2384":97485},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2857":58262,"_25170":58203,"_17548":97487,"_5":17443,"_23820":97299,"_2384":97488},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2857":58263,"_25170":58203,"_17548":97490,"_5":17443,"_23820":97299,"_2384":97491},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2857":58264,"_25170":58203,"_17548":97493,"_5":17443,"_23820":97299,"_2384":97494},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2857":58265,"_25170":58203,"_17548":97496,"_5":17443,"_23820":97299,"_2384":97497},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2857":58266,"_25170":58203,"_17548":97499,"_5":17443,"_23820":97299,"_2384":97500},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2857":58267,"_25170":58203,"_17548":97502,"_5":17443,"_23820":97303,"_2384":97503},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2857":58268,"_25170":58203,"_17548":97505,"_5":17443,"_23820":97303,"_2384":97506},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2857":58269,"_25170":58203,"_17548":97508,"_5":17443,"_23820":97303,"_2384":97509},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2857":58270,"_25170":58203,"_17548":97511,"_5":17443,"_23820":97303,"_2384":97512},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2857":58271,"_25170":58203,"_17548":97514,"_5":17443,"_23820":97303,"_2384":97515},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2857":58272,"_25170":58203,"_17548":97517,"_5":17443,"_23820":97303,"_2384":97518},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2857":58273,"_25170":58203,"_17548":97520,"_5":17443,"_23820":97303,"_2384":97521},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2857":58274,"_25170":58203,"_17548":97523,"_5":17443,"_23820":97303,"_2384":97524},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2857":58275,"_25170":58203,"_17548":97526,"_5":17443,"_23820":97303,"_2384":97527},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2857":58276,"_25170":58203,"_17548":97529,"_5":17443,"_23820":97303,"_2384":97530},[],"Las acciones se dividen en dos grupos:",{"_2857":58277,"_25170":58203,"_17548":97532,"_5":17443,"_23820":97303,"_2384":97533},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2857":58278,"_25170":58203,"_17548":97535,"_5":17443,"_23820":97303,"_2384":97536},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2857":58279,"_25170":58203,"_17548":97538,"_5":17443,"_23820":97303,"_2384":97539},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2857":58280,"_25170":58203,"_17548":97541,"_5":17443,"_23820":97307,"_2384":97542},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2857":58281,"_25170":58203,"_17548":97544,"_5":17443,"_23820":97307,"_2384":97545},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2857":58282,"_25170":58203,"_17548":97547,"_5":17443,"_23820":97307,"_2384":97548},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2857":58283,"_25170":58203,"_17548":97550,"_5":17443,"_23820":97311,"_2384":97551},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2857":58284,"_25170":58203,"_17548":97553,"_5":17443,"_23820":97311,"_2384":97554},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2857":58285,"_25170":58203,"_17548":97556,"_5":17443,"_23820":97311,"_2384":97557},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2857":58286,"_25170":58203,"_17548":97559,"_5":17443,"_23820":97311,"_2384":97560},[],"Los operadores implementados son:",{"_2857":58287,"_25170":58203,"_17548":97562,"_5":17443,"_23820":97311,"_2384":97563},[],"`equals`, para igualdad exacta;",{"_2857":58288,"_25170":58203,"_17548":97565,"_5":17443,"_23820":97311,"_2384":97566},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2857":58289,"_25170":58203,"_17548":97568,"_5":17443,"_23820":97311,"_2384":97569},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2857":58290,"_25170":58203,"_17548":97571,"_5":17443,"_23820":97311,"_2384":97572},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2857":58291,"_25170":58203,"_17548":97574,"_5":17443,"_23820":97315,"_2384":97575},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2857":58292,"_25170":58203,"_17548":97577,"_5":17443,"_23820":97315,"_2384":97578},[],"Los modos disponibles son:",{"_2857":58293,"_25170":58203,"_17548":97580,"_5":17443,"_23820":97315,"_2384":97581},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2857":58294,"_25170":58203,"_17548":97583,"_5":17443,"_23820":97315,"_2384":97584},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2857":58295,"_25170":58203,"_17548":97586,"_5":17443,"_23820":97315,"_2384":97587},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2857":58296,"_25170":58203,"_17548":97589,"_5":17443,"_23820":97315,"_2384":97590},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2857":58297,"_25170":58203,"_17548":97592,"_5":17443,"_23820":97315,"_2384":97593},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2857":58298,"_25170":58203,"_17548":97595,"_5":17443,"_23820":97315,"_2384":97596},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2857":58299,"_25170":58203,"_17548":97598,"_5":17443,"_23820":97319,"_2384":97599},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2857":58300,"_25170":58203,"_17548":97601,"_5":17443,"_23820":97319,"_2384":97602},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2857":58301,"_25170":58203,"_17548":97604,"_5":17443,"_23820":97319,"_2384":97605},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2857":58302,"_25170":58203,"_17548":97607,"_5":17443,"_23820":97319,"_2384":97608},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2857":58303,"_25170":58203,"_17548":97610,"_5":17443,"_23820":97327,"_2384":97611},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2857":58304,"_25170":58203,"_17548":97613,"_5":17443,"_23820":97327,"_2384":97614},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2857":58305,"_25170":58203,"_17548":97616,"_5":17443,"_23820":97331,"_2384":97617},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2857":58306,"_25170":58203,"_17548":97619,"_5":17443,"_23820":97331,"_2384":97620},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2857":58307,"_25170":58203,"_17548":97622,"_5":17443,"_23820":97335,"_2384":97623},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2857":58308,"_25170":58203,"_17548":97625,"_5":17443,"_23820":97335,"_2384":97626},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2857":58309,"_25170":58203,"_17548":97628,"_5":17443,"_23820":97335,"_2384":97629},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2857":58310,"_25170":58203,"_17548":97631,"_5":17443,"_23820":97339,"_2384":97632},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2857":58311,"_25170":58203,"_17548":97634,"_5":17443,"_23820":97339,"_2384":97635},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2857":58312,"_25170":58203,"_17548":97637,"_5":17443,"_23820":97339,"_2384":97638},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2857":58313,"_25170":58203,"_17548":97640,"_5":17443,"_23820":97339,"_2384":97641},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2857":58314,"_25170":58203,"_17548":97643,"_5":17443,"_23820":97339,"_2384":97644},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2857":58315,"_25170":58203,"_17548":97646,"_5":17443,"_23820":97339,"_2384":97647},[],"Ten en cuenta que:",{"_2857":58316,"_25170":58203,"_17548":97649,"_5":17443,"_23820":97339,"_2384":97650},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2857":58317,"_25170":58203,"_17548":97652,"_5":17443,"_23820":97339,"_2384":97653},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2857":58318,"_25170":58203,"_17548":97655,"_5":17443,"_23820":97339,"_2384":97656},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2857":58319,"_25170":58203,"_17548":97658,"_5":17443,"_23820":97343,"_2384":97659},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2857":58320,"_25170":58203,"_17548":97661,"_5":17443,"_23820":97343,"_2384":97662},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2857":58321,"_25170":58203,"_17548":97664,"_5":17443,"_23820":97343,"_2384":97665},[],"acceso completo y de solo lectura a KMS;",{"_2857":58322,"_25170":58203,"_17548":97667,"_5":17443,"_23820":97343,"_2384":97668},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2857":58323,"_25170":58203,"_17548":97670,"_5":17443,"_23820":97343,"_2384":97671},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2857":58324,"_25170":58203,"_17548":97673,"_5":17443,"_23820":97343,"_2384":97674},[],"acceso a la interfaz;",{"_2857":58325,"_25170":58203,"_17548":97676,"_5":17443,"_23820":97343,"_2384":97677},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2857":58326,"_25170":58203,"_17548":97679,"_5":17443,"_23820":97343,"_2384":97680},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2857":58327,"_25170":58203,"_17548":97682,"_5":17443,"_23820":97343,"_2384":97683},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2857":58328,"_25170":58203,"_17548":97685,"_5":17443,"_23820":97347,"_2384":97686},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2857":58329,"_25170":58203,"_17548":97688,"_5":17443,"_23820":97347,"_2384":97689},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2857":58330,"_25170":58203,"_17548":97691,"_5":17443,"_23820":97347,"_2384":97692},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2857":58331,"_25170":58203,"_17548":97694,"_5":17443,"_23820":97350,"_2384":97695},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2857":58332,"_25170":58203,"_17548":97697,"_5":17443,"_23820":97354,"_2384":97698},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2857":58333,"_25170":58203,"_17548":97700,"_5":17443,"_23820":97358,"_2384":97701},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2857":58334,"_25170":58203,"_17548":97703,"_5":17443,"_23820":97362,"_2384":97704},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2857":58335,"_25170":58203,"_17548":97706,"_5":17443,"_23820":97366,"_2384":97707},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2857":58336,"_25170":58203,"_17548":97709,"_5":17443,"_23820":97370,"_2384":97710},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2857":58337,"_25170":58203,"_17548":97712,"_5":17443,"_23820":97370,"_2384":97713},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2857":58338,"_25170":58203,"_17548":97715,"_5":17443,"_23820":97374,"_2384":97716},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2857":58339,"_25170":58203,"_17548":97718,"_5":17443,"_23820":97374,"_2384":97719},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2857":58340,"_25170":58203,"_17548":97721,"_5":17443,"_23820":97374,"_2384":97722},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2857":58341,"_25170":58203,"_17548":97724,"_5":17443,"_23820":97374,"_2384":97725},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2857":58342,"_25170":58203,"_17548":97727,"_5":17443,"_23820":97374,"_2384":97728},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2857":58343,"_25170":58203,"_17548":97730,"_5":17443,"_23820":97374,"_2384":97731},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2857":58344,"_25170":58203,"_17548":97733,"_5":17443,"_23820":97374,"_2384":97734},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2857":58345,"_25170":58203,"_17548":97736,"_5":17443,"_23820":97374,"_2384":97737},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2857":58346,"_25170":58203,"_17548":97739,"_5":17443,"_23820":97378,"_2384":97740},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2857":58347,"_25170":58203,"_17548":97742,"_5":17443,"_23820":97378,"_2384":97743},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2857":58348,"_25170":58203,"_17548":97745,"_5":17443,"_23820":97378,"_2384":97746},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2857":58349,"_25170":58203,"_17548":97748,"_5":17443,"_23820":97382,"_2384":97749},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2857":58350,"_25170":58203,"_17548":97751,"_5":17443,"_23820":97382,"_2384":97752},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2857":58351,"_25170":58203,"_17548":97754,"_5":17443,"_23820":97382,"_2384":97755},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2857":58352,"_25170":58203,"_17548":97757,"_5":17443,"_23820":97382,"_2384":97758},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2857":58353,"_25170":58203,"_17548":97760,"_5":17443,"_23820":97382,"_2384":97761},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2857":58354,"_25170":58203,"_17548":97763,"_5":17443,"_23820":97382,"_2384":97764},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2857":58355,"_25170":58203,"_17548":97766,"_5":17443,"_23820":97382,"_2384":97767},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2857":58356,"_25170":58203,"_17548":97769,"_5":17443,"_23820":97382,"_2384":97770},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2857":58357,"_25170":58203,"_17548":97772,"_5":17443,"_23820":97390,"_2384":97773},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2857":58358,"_25170":58203,"_17548":97775,"_5":17443,"_23820":97394,"_2384":97776},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2857":58359,"_25170":58203,"_17548":97778,"_5":17443,"_23820":97394,"_2384":97779},[],"que exista un principal activo del tipo correcto;",{"_2857":58360,"_25170":58203,"_17548":97781,"_5":17443,"_23820":97394,"_2384":97782},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2857":58361,"_25170":58203,"_17548":97784,"_5":17443,"_23820":97394,"_2384":97785},[],"que todas las condiciones del principal se cumplan;",{"_2857":58362,"_25170":58203,"_17548":97787,"_5":17443,"_23820":97394,"_2384":97788},[],"que el principal tenga concedida la política esperada;",{"_2857":58363,"_25170":58203,"_17548":97790,"_5":17443,"_23820":97394,"_2384":97791},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2857":58364,"_25170":58203,"_17548":97793,"_5":17443,"_23820":97394,"_2384":97794},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2857":58365,"_25170":58203,"_17548":97796,"_5":17443,"_23820":97394,"_2384":97797},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2857":58366,"_25170":58203,"_17548":97799,"_5":17443,"_23820":97398,"_2384":97800},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2857":58367,"_25170":58203,"_17548":97802,"_5":17443,"_23820":97402,"_2384":97803},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2857":58368,"_25170":58203,"_17548":97805,"_5":17443,"_23820":97406,"_2384":97806},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2857":58369,"_25170":58203,"_17548":97808,"_5":17443,"_23820":97406,"_2384":97809},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2857":58370,"_25170":58370,"_5":12294,"_2384":97811,"_25506":97812,"_17548":97813,"_23820":58370},"Alertas y suscripciones",[40848,97279,97280],[],{"_2857":58371,"_25170":58370,"_17548":97815,"_5":17443,"_23820":58370,"_2384":97816},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2857":58372,"_25170":58370,"_5":25503,"_17548":97818,"_23820":97819,"_2384":97820},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2857":58373,"_25170":58370,"_5":25503,"_17548":97822,"_23820":97823,"_2384":97824},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2857":58374,"_25170":58370,"_5":25503,"_17548":97826,"_23820":97827,"_2384":97828},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2857":58375,"_25170":58370,"_5":25503,"_17548":97830,"_23820":97831,"_2384":97832},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2857":58376,"_25170":58370,"_5":25503,"_17548":97834,"_23820":97835,"_2384":97836},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2857":58377,"_25170":58370,"_5":25503,"_17548":97838,"_23820":97839,"_2384":97840},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2857":58378,"_25170":58370,"_5":25503,"_17548":97842,"_23820":97843,"_2384":97844},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2857":58379,"_25170":58370,"_5":25503,"_17548":97846,"_23820":97847,"_2384":97848},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2857":58380,"_25170":58370,"_5":25503,"_17548":97850,"_23820":97851,"_2384":97852},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2857":58381,"_25170":58370,"_5":25503,"_17548":97854,"_23820":97855,"_2384":97856},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2857":58382,"_25170":58370,"_17548":97858,"_5":17443,"_23820":58370,"_2384":97859},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2857":58383,"_25170":58370,"_17548":97861,"_5":17443,"_23820":97819,"_2384":97862},[],"Un servicio publica un evento de dominio.",{"_2857":58384,"_25170":58370,"_17548":97864,"_5":17443,"_23820":97819,"_2384":97865},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2857":58385,"_25170":58370,"_17548":97867,"_5":17443,"_23820":97819,"_2384":97868},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2857":58386,"_25170":58370,"_17548":97870,"_5":17443,"_23820":97819,"_2384":97871},[],"Lamassu entrega el evento al canal configurado.",{"_2857":58387,"_25170":58370,"_17548":97873,"_5":17443,"_23820":97819,"_2384":97874},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2857":58388,"_25170":58370,"_17548":97876,"_5":17443,"_23820":97823,"_2384":97877},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2857":58389,"_25170":58370,"_17548":97879,"_5":17443,"_23820":97823,"_2384":97880},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2857":58390,"_25170":58370,"_17548":97882,"_5":17443,"_23820":97823,"_2384":97883},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2857":58391,"_25170":58370,"_17548":97885,"_5":17443,"_23820":97823,"_2384":97886},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2857":58392,"_25170":58370,"_17548":97888,"_5":17443,"_23820":97823,"_2384":97889},[],"`apikey_options` necesita `header` y `key`.",{"_2857":58393,"_25170":58370,"_17548":97891,"_5":17443,"_23820":97823,"_2384":97892},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2857":58394,"_25170":58370,"_17548":97894,"_5":17443,"_23820":97823,"_2384":97895},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2857":58395,"_25170":58370,"_17548":97897,"_5":17443,"_23820":97823,"_2384":97898},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2857":58396,"_25170":58370,"_17548":97900,"_5":17443,"_23820":97831,"_2384":97901},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2857":58397,"_25170":58370,"_17548":97903,"_5":17443,"_23820":97835,"_2384":97904},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2857":58398,"_25170":58370,"_17548":97906,"_5":17443,"_23820":97839,"_2384":97907},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2857":58399,"_25170":58370,"_17548":97909,"_5":17443,"_23820":97839,"_2384":97910},[],"**None** notifica todas las instancias del evento.",{"_2857":58400,"_25170":58370,"_17548":97912,"_5":17443,"_23820":97839,"_2384":97913},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2857":58401,"_25170":58370,"_17548":97915,"_5":17443,"_23820":97839,"_2384":97916},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2857":58402,"_25170":58370,"_17548":97918,"_5":17443,"_23820":97839,"_2384":97919},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2857":58403,"_25170":58370,"_17548":97921,"_5":17443,"_23820":97839,"_2384":97922},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2857":58404,"_25170":58370,"_17548":97924,"_5":17443,"_23820":97843,"_2384":97925},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2857":58405,"_25170":58370,"_17548":97927,"_5":17443,"_23820":97847,"_2384":97928},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2857":58406,"_25170":58370,"_17548":97930,"_5":17443,"_23820":97847,"_2384":97931},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2857":58407,"_25170":58370,"_17548":97933,"_5":17443,"_23820":97847,"_2384":97934},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2857":58408,"_25170":58370,"_17548":97936,"_5":17443,"_23820":97847,"_2384":97937},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2857":58409,"_25170":58370,"_17548":97939,"_5":17443,"_23820":97847,"_2384":97940},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2857":58410,"_25170":58370,"_17548":97942,"_5":17443,"_23820":97847,"_2384":97943},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2857":58411,"_25170":58370,"_17548":97945,"_5":17443,"_23820":97847,"_2384":97946},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2857":58412,"_25170":58370,"_17548":97948,"_5":17443,"_23820":97847,"_2384":97949},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2857":58413,"_25170":58370,"_17548":97951,"_5":17443,"_23820":97851,"_2384":97952},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2857":58414,"_25170":58370,"_17548":97954,"_5":17443,"_23820":97855,"_2384":97955},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2857":58415,"_25170":58370,"_17548":97957,"_5":17443,"_23820":97855,"_2384":97958},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2857":58416,"_25170":58370,"_17548":97960,"_5":17443,"_23820":97855,"_2384":97961},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2857":58417,"_25170":58370,"_17548":97963,"_5":17443,"_23820":97855,"_2384":97964},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2857":58418,"_25170":58370,"_17548":97966,"_5":17443,"_23820":97855,"_2384":97967},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2857":58419,"_25170":58370,"_17548":97969,"_5":17443,"_23820":97855,"_2384":97970},[],"**Validación:** `va.role.crl.create`.",{"_2857":58420,"_25170":58370,"_17548":97972,"_5":17443,"_23820":97855,"_2384":97973},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2857":58421,"_25170":58370,"_17548":97975,"_5":17443,"_23820":97855,"_2384":97976},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2857":58422,"_25170":58422,"_5":12294,"_2384":97978,"_25506":97979,"_17548":97980,"_23820":58422},"Registros de auditoría",[40848,97279,97280],[],{"_2857":58423,"_25170":58422,"_17548":97982,"_5":17443,"_23820":58422,"_2384":97983},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2857":58424,"_25170":58422,"_5":25503,"_17548":97985,"_23820":97986,"_2384":97987},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2857":58425,"_25170":58422,"_5":25503,"_17548":97989,"_23820":97990,"_2384":97991},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2857":58426,"_25170":58422,"_5":25503,"_17548":97993,"_23820":97994,"_2384":97995},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2857":58427,"_25170":58422,"_5":25503,"_17548":97997,"_23820":97998,"_2384":97999},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2857":58428,"_25170":58422,"_5":25503,"_17548":98001,"_23820":98002,"_2384":98003},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2857":58429,"_25170":58422,"_5":25503,"_17548":98005,"_23820":98006,"_2384":98007},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2857":58430,"_25170":58422,"_5":25503,"_17548":98009,"_23820":98010,"_2384":98011},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2857":58431,"_25170":58422,"_5":25503,"_17548":98013,"_23820":98014,"_2384":98015},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2857":58432,"_25170":58422,"_5":25503,"_17548":98017,"_23820":98018,"_2384":98019},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2857":58433,"_25170":58422,"_5":25503,"_17548":98021,"_23820":98022,"_2384":98023},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2857":58434,"_25170":58422,"_5":25503,"_17548":98025,"_23820":98026,"_2384":98027},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2857":58435,"_25170":58422,"_17548":98029,"_5":17443,"_23820":58422,"_2384":98030},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2857":58436,"_25170":58422,"_17548":98032,"_5":17443,"_23820":97986,"_2384":98033},[],"El cuerpo de auditoría incluye:",{"_2857":58437,"_25170":58422,"_17548":98035,"_5":17443,"_23820":97986,"_2384":98036},[],"input: datos recibidos por la operación;",{"_2857":58438,"_25170":58422,"_17548":98038,"_5":17443,"_23820":97986,"_2384":98039},[],"has\\_error: indica si el servicio devolvió un error;",{"_2857":58439,"_25170":58422,"_17548":98041,"_5":17443,"_23820":97986,"_2384":98042},[],"output: resultado producido o mensaje de error;",{"_2857":58440,"_25170":58422,"_17548":98044,"_5":17443,"_23820":97986,"_2384":98045},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2857":58441,"_25170":58422,"_17548":98047,"_5":17443,"_23820":97986,"_2384":98048},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2857":58442,"_25170":58422,"_17548":98050,"_5":17443,"_23820":97986,"_2384":98051},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2857":58443,"_25170":58422,"_17548":98053,"_5":17443,"_23820":97990,"_2384":98054},[],"El backend aplica auditoría a mutaciones de:",{"_2857":58444,"_25170":58422,"_17548":98056,"_5":17443,"_23820":97990,"_2384":98057},[],"autoridades, certificados y perfiles de emisión;",{"_2857":58445,"_25170":58422,"_17548":98059,"_5":17443,"_23820":97990,"_2384":98060},[],"claves y motores KMS;",{"_2857":58446,"_25170":58422,"_17548":98062,"_5":17443,"_23820":97990,"_2384":98063},[],"dispositivos e identidades;",{"_2857":58447,"_25170":58422,"_17548":98065,"_5":17443,"_23820":97990,"_2384":98066},[],"DMS y operaciones de enrolamiento;",{"_2857":58448,"_25170":58422,"_17548":98068,"_5":17443,"_23820":97990,"_2384":98069},[],"funciones de validación y CRL;",{"_2857":58449,"_25170":58422,"_17548":98071,"_5":17443,"_23820":97990,"_2384":98072},[],"principales, políticas y concesiones de autorización.",{"_2857":58450,"_25170":58422,"_17548":98074,"_5":17443,"_23820":97990,"_2384":98075},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2857":58451,"_25170":58422,"_17548":98077,"_5":17443,"_23820":97994,"_2384":98078},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2857":58452,"_25170":58422,"_17548":98080,"_5":17443,"_23820":97994,"_2384":98081},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2857":58453,"_25170":58422,"_17548":98083,"_5":17443,"_23820":97994,"_2384":98084},[],"Diseña el consumidor para:",{"_2857":58454,"_25170":58422,"_17548":98086,"_5":17443,"_23820":97994,"_2384":98087},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2857":58455,"_25170":58422,"_17548":98089,"_5":17443,"_23820":97994,"_2384":98090},[],"conservar el CloudEvent completo sin modificar;",{"_2857":58456,"_25170":58422,"_17548":98092,"_5":17443,"_23820":97994,"_2384":98093},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2857":58457,"_25170":58422,"_17548":98095,"_5":17443,"_23820":97994,"_2384":98096},[],"cifrar en tránsito y en reposo;",{"_2857":58458,"_25170":58422,"_17548":98098,"_5":17443,"_23820":97994,"_2384":98099},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2857":58459,"_25170":58422,"_17548":98101,"_5":17443,"_23820":97994,"_2384":98102},[],"aplicar una política explícita de retención y legal hold;",{"_2857":58460,"_25170":58422,"_17548":98104,"_5":17443,"_23820":97994,"_2384":98105},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2857":58461,"_25170":58422,"_17548":98107,"_5":17443,"_23820":97998,"_2384":98108},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2857":58462,"_25170":58422,"_17548":98110,"_5":17443,"_23820":97998,"_2384":98111},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2857":58463,"_25170":58422,"_17548":98113,"_5":17443,"_23820":98006,"_2384":98114},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2857":58464,"_25170":58422,"_17548":98116,"_5":17443,"_23820":98010,"_2384":98117},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2857":58465,"_25170":58422,"_17548":98119,"_5":17443,"_23820":98014,"_2384":98120},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2857":58466,"_25170":58422,"_17548":98122,"_5":17443,"_23820":98018,"_2384":98123},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2857":58467,"_25170":58422,"_17548":98125,"_5":17443,"_23820":98022,"_2384":98126},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2857":58468,"_25170":58422,"_17548":98128,"_5":17443,"_23820":98026,"_2384":98129},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2857":58469,"_25170":58422,"_17548":98131,"_5":17443,"_23820":98026,"_2384":98132},[],"aparece un evento de auditoría correcto;",{"_2857":58470,"_25170":58422,"_17548":98134,"_5":17443,"_23820":98026,"_2384":98135},[],"el principal coincide con la identidad utilizada;",{"_2857":58471,"_25170":58422,"_17548":98137,"_5":17443,"_23820":98026,"_2384":98138},[],"el consumidor lo persiste una sola vez;",{"_2857":58472,"_25170":58422,"_17548":98140,"_5":17443,"_23820":98026,"_2384":98141},[],"puede recuperarse por recurso, actor y periodo;",{"_2857":58473,"_25170":58422,"_17548":98143,"_5":17443,"_23820":98026,"_2384":98144},[],"una interrupción del consumidor produce una alerta.",{"_2857":58474,"_25170":58422,"_17548":98146,"_5":17443,"_23820":98026,"_2384":98147},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2857":58475,"_25170":58475,"_5":12294,"_2384":98149,"_25506":98150,"_17548":98151,"_23820":58475},"Arquitectura de la plataforma",[40848,97279],[],{"_2857":58476,"_25170":58475,"_17548":98153,"_5":17443,"_23820":58475,"_2384":98154},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2857":58477,"_25170":58475,"_5":25503,"_17548":98156,"_23820":98157,"_2384":98158},[],"/docs/pr-preview/pr-38/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2857":58478,"_25170":58475,"_5":25503,"_17548":98160,"_23820":98161,"_2384":98162},[],"/docs/pr-preview/pr-38/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2857":58479,"_25170":58475,"_5":25503,"_17548":98164,"_23820":98165,"_2384":98166},[],"/docs/pr-preview/pr-38/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2857":58480,"_25170":58475,"_5":25503,"_17548":98168,"_23820":98169,"_2384":98170},[],"/docs/pr-preview/pr-38/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2857":58481,"_25170":58475,"_5":25503,"_17548":98172,"_23820":98173,"_2384":98174},[],"/docs/pr-preview/pr-38/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2857":58482,"_25170":58475,"_17548":98176,"_5":17443,"_23820":58475,"_2384":98177},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2857":58483,"_25170":58475,"_17548":98179,"_5":17443,"_23820":58475,"_2384":98180},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2857":58484,"_25170":58475,"_17548":98182,"_5":17443,"_23820":98157,"_2384":98183},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2857":58485,"_25170":58475,"_17548":98185,"_5":17443,"_23820":98161,"_2384":98186},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2857":58486,"_25170":58475,"_17548":98188,"_5":17443,"_23820":98165,"_2384":98189},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2857":58487,"_25170":58475,"_17548":98191,"_5":17443,"_23820":98169,"_2384":98192},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2857":58488,"_25170":58475,"_17548":98194,"_5":17443,"_23820":98173,"_2384":98195},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2857":58489,"_25170":58489,"_5":12294,"_2384":98197,"_25506":98198,"_17548":98199,"_23820":58489},"Cómo funciona Lamassu",[40848,97279],[],{"_2857":58490,"_25170":58489,"_17548":98201,"_5":17443,"_23820":58489,"_2384":98202},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2857":58491,"_25170":58489,"_5":25503,"_17548":98204,"_23820":98205,"_2384":98206},[],"/docs/pr-preview/pr-38/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2857":58492,"_25170":58489,"_5":25503,"_17548":98208,"_23820":98209,"_2384":98210},[],"/docs/pr-preview/pr-38/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2857":58493,"_25170":58489,"_17548":98212,"_5":17443,"_23820":58489,"_2384":98213},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2857":58494,"_25170":58489,"_17548":98215,"_5":17443,"_23820":98205,"_2384":98216},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2857":58495,"_25170":58489,"_17548":98218,"_5":17443,"_23820":98205,"_2384":98219},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2857":58496,"_25170":58489,"_17548":98221,"_5":17443,"_23820":98205,"_2384":98222},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2857":58497,"_25170":58489,"_17548":98224,"_5":17443,"_23820":98205,"_2384":98225},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2857":58498,"_25170":58489,"_17548":98227,"_5":17443,"_23820":98205,"_2384":98228},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2857":58499,"_25170":58489,"_17548":98230,"_5":17443,"_23820":98209,"_2384":98231},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2857":58500,"_25170":58489,"_17548":98233,"_5":17443,"_23820":98209,"_2384":98234},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2857":58501,"_25170":58489,"_17548":98236,"_5":17443,"_23820":98209,"_2384":98237},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2857":58502,"_25170":58489,"_17548":98239,"_5":17443,"_23820":98209,"_2384":98240},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2857":58503,"_25170":58489,"_17548":98242,"_5":17443,"_23820":98209,"_2384":98243},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2857":58504,"_25170":58489,"_17548":98245,"_5":17443,"_23820":98209,"_2384":98246},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2857":58505,"_25170":58489,"_17548":98248,"_5":17443,"_23820":98209,"_2384":98249},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2857":58506,"_25170":58506,"_5":12294,"_2384":98251,"_25506":98252,"_17548":98253,"_23820":58506},"Dispositivos e identidades",[40848,97279,43166,98251],[],{"_2857":58507,"_25170":58506,"_17548":98255,"_5":17443,"_23820":58506,"_2384":98256},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2857":58508,"_25170":58506,"_5":25503,"_17548":98258,"_23820":98259,"_2384":98260},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2857":58509,"_25170":58506,"_5":25503,"_17548":98262,"_23820":98263,"_2384":98264},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2857":58510,"_25170":58506,"_5":25503,"_17548":98266,"_23820":98267,"_2384":98268},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2857":58511,"_25170":58506,"_5":25503,"_17548":98270,"_23820":98271,"_2384":98272},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2857":58512,"_25170":58506,"_5":25503,"_17548":98274,"_23820":98275,"_2384":98276},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2857":58513,"_25170":58506,"_5":25503,"_17548":98278,"_23820":98279,"_2384":98280},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2857":58514,"_25170":58506,"_5":25503,"_17548":98282,"_23820":98283,"_2384":98284},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2857":58515,"_25170":58506,"_5":25503,"_17548":98286,"_23820":98287,"_2384":98288},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2857":58516,"_25170":58506,"_5":25503,"_17548":98290,"_23820":98291,"_2384":98292},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2857":58517,"_25170":58506,"_5":25503,"_17548":98294,"_23820":98295,"_2384":98296},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2857":58518,"_25170":58506,"_5":25503,"_17548":98298,"_23820":98299,"_2384":98300},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2857":58519,"_25170":58506,"_17548":98302,"_5":17443,"_23820":58506,"_2384":98303},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2857":58520,"_25170":58506,"_17548":98305,"_5":17443,"_23820":58506,"_2384":98306},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2857":58521,"_25170":58506,"_17548":98308,"_5":17443,"_23820":98259,"_2384":98309},[],"Vista operativa",{"_2857":58522,"_25170":58506,"_17548":98311,"_5":17443,"_23820":98259,"_2384":98312},[],"Interpretación",{"_2857":58523,"_25170":58506,"_17548":98314,"_5":17443,"_23820":98259,"_2384":43229},[],{"_2857":58524,"_25170":58506,"_17548":98316,"_5":17443,"_23820":98259,"_2384":98317},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2857":58525,"_25170":58506,"_17548":98319,"_5":17443,"_23820":98259,"_2384":43235},[],{"_2857":58526,"_25170":58506,"_17548":98321,"_5":17443,"_23820":98259,"_2384":98322},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2857":58527,"_25170":58506,"_17548":98324,"_5":17443,"_23820":98259,"_2384":43241},[],{"_2857":58528,"_25170":58506,"_17548":98326,"_5":17443,"_23820":98259,"_2384":98327},[],"La identidad está en la ventana operativa de renovación.",{"_2857":58529,"_25170":58506,"_17548":98329,"_5":17443,"_23820":98259,"_2384":43247},[],{"_2857":58530,"_25170":58506,"_17548":98331,"_5":17443,"_23820":98259,"_2384":98332},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2857":58531,"_25170":58506,"_17548":98334,"_5":17443,"_23820":98259,"_2384":43253},[],{"_2857":58532,"_25170":58506,"_17548":98336,"_5":17443,"_23820":98259,"_2384":98337},[],"La identidad ha vencido.",{"_2857":58533,"_25170":58506,"_17548":98339,"_5":17443,"_23820":98259,"_2384":43259},[],{"_2857":58534,"_25170":58506,"_17548":98341,"_5":17443,"_23820":98259,"_2384":98342},[],"La identidad está marcada como revocada.",{"_2857":58535,"_25170":58506,"_17548":98344,"_5":17443,"_23820":98259,"_2384":43265},[],{"_2857":58536,"_25170":58506,"_17548":98346,"_5":17443,"_23820":98259,"_2384":98347},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2857":58537,"_25170":58506,"_17548":98349,"_5":17443,"_23820":98259,"_2384":98350},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2857":58538,"_25170":58506,"_17548":98352,"_5":17443,"_23820":98263,"_2384":98353},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2857":58539,"_25170":58506,"_17548":98355,"_5":17443,"_23820":98263,"_2384":98356},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2857":58540,"_25170":58506,"_17548":98358,"_5":17443,"_23820":98263,"_2384":98359},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2857":58541,"_25170":58506,"_17548":98361,"_5":17443,"_23820":98263,"_2384":98362},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2857":58542,"_25170":58506,"_17548":98364,"_5":17443,"_23820":98267,"_2384":98365},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2857":58543,"_25170":58506,"_17548":98367,"_5":17443,"_23820":98271,"_2384":98368},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2857":58544,"_25170":58506,"_17548":98370,"_5":17443,"_23820":98275,"_2384":98371},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2857":58545,"_25170":58506,"_17548":98373,"_5":17443,"_23820":98279,"_2384":98374},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2857":58546,"_25170":58506,"_17548":98376,"_5":17443,"_23820":98283,"_2384":98377},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2857":58547,"_25170":58506,"_17548":98379,"_5":17443,"_23820":98283,"_2384":98380},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2857":58548,"_25170":58506,"_17548":98382,"_5":17443,"_23820":98287,"_2384":98383},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2857":58549,"_25170":58506,"_17548":98385,"_5":17443,"_23820":98287,"_2384":98386},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2857":58550,"_25170":58506,"_17548":98388,"_5":17443,"_23820":98287,"_2384":98389},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2857":58551,"_25170":58506,"_17548":98391,"_5":17443,"_23820":98287,"_2384":98392},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2857":58552,"_25170":58506,"_17548":98394,"_5":17443,"_23820":98287,"_2384":98395},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2857":58553,"_25170":58506,"_17548":98397,"_5":17443,"_23820":98287,"_2384":98398},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2857":58554,"_25170":58506,"_17548":98400,"_5":17443,"_23820":98291,"_2384":98401},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2857":58555,"_25170":58506,"_17548":98403,"_5":17443,"_23820":98291,"_2384":98404},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2857":58556,"_25170":58506,"_17548":98406,"_5":17443,"_23820":98295,"_2384":98407},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2857":58557,"_25170":58506,"_17548":98409,"_5":17443,"_23820":98295,"_2384":98410},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2857":58558,"_25170":58506,"_17548":98412,"_5":17443,"_23820":98295,"_2384":98413},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2857":58559,"_25170":58506,"_17548":98415,"_5":17443,"_23820":98295,"_2384":98416},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2857":58560,"_25170":58506,"_17548":98418,"_5":17443,"_23820":98299,"_2384":98419},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2857":58561,"_25170":58506,"_17548":98421,"_5":17443,"_23820":98299,"_2384":98422},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2857":58562,"_25170":58562,"_5":12294,"_2384":98424,"_25506":98425,"_17548":98427,"_23820":58562},"Identidad inicial y autenticación",[40848,97279,43166,98251,98426],"Enrolamiento con PKI",[],{"_2857":58563,"_25170":58562,"_17548":98429,"_5":17443,"_23820":58562,"_2384":98430},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2857":58564,"_25170":58562,"_5":25503,"_17548":98432,"_23820":98433,"_2384":98434},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2857":58565,"_25170":58562,"_5":25503,"_17548":98436,"_23820":98437,"_2384":98438},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2857":58566,"_25170":58562,"_5":25503,"_17548":98440,"_23820":98441,"_2384":98442},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2857":58567,"_25170":58562,"_5":25503,"_17548":98444,"_23820":98445,"_2384":98446},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2857":58568,"_25170":58562,"_5":25503,"_17548":98448,"_23820":98449,"_2384":98450},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2857":58569,"_25170":58562,"_17548":98452,"_5":17443,"_23820":58562,"_2384":98453},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2857":58570,"_25170":58562,"_17548":98455,"_5":17443,"_23820":98433,"_2384":98456},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2857":58571,"_25170":58562,"_17548":98458,"_5":17443,"_23820":98433,"_2384":98459},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2857":58572,"_25170":58562,"_17548":98461,"_5":17443,"_23820":98437,"_2384":98462},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2857":58573,"_25170":58562,"_17548":98464,"_5":17443,"_23820":98437,"_2384":98465},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2857":58574,"_25170":58562,"_17548":98467,"_5":17443,"_23820":98437,"_2384":98468},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2857":58575,"_25170":58562,"_17548":98470,"_5":17443,"_23820":98441,"_2384":98471},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2857":58576,"_25170":58562,"_17548":98473,"_5":17443,"_23820":98441,"_2384":98474},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2857":58577,"_25170":58562,"_17548":98476,"_5":17443,"_23820":98445,"_2384":98477},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2857":58578,"_25170":58562,"_17548":98479,"_5":17443,"_23820":98445,"_2384":98480},[],"Ejemplo de cuerpo:",{"_2857":58579,"_25170":58562,"_17548":98482,"_5":17443,"_23820":98445,"_2384":98483},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2857":58580,"_25170":58562,"_17548":98485,"_5":17443,"_23820":98445,"_2384":98486},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2857":58581,"_25170":58562,"_17548":98488,"_5":17443,"_23820":98445,"_2384":98489},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2857":58582,"_25170":58562,"_17548":98491,"_5":17443,"_23820":98445,"_2384":98492},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2857":58583,"_25170":58562,"_17548":98494,"_5":17443,"_23820":98449,"_2384":98495},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2857":58584,"_25170":58562,"_17548":98497,"_5":17443,"_23820":98449,"_2384":98498},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2857":58585,"_25170":58585,"_5":12294,"_2384":98500,"_25506":98501,"_17548":98502,"_23820":58585},"Configura y opera el DMS",[40848,97279,43166,98251,98426],[],{"_2857":58586,"_25170":58585,"_17548":98504,"_5":17443,"_23820":58585,"_2384":98505},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2857":58587,"_25170":58585,"_5":25503,"_17548":98507,"_23820":98508,"_2384":95980},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2857":58588,"_25170":58585,"_5":25503,"_17548":98510,"_23820":98511,"_2384":98512},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2857":58589,"_25170":58585,"_5":25503,"_17548":98514,"_23820":98515,"_2384":98516},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2857":58590,"_25170":58585,"_5":25503,"_17548":98518,"_23820":98519,"_2384":98520},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2857":58591,"_25170":58585,"_5":25503,"_17548":98522,"_23820":98523,"_2384":98524},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2857":58592,"_25170":58585,"_5":25503,"_17548":98526,"_23820":98527,"_2384":98528},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2857":58593,"_25170":58585,"_5":25503,"_17548":98530,"_23820":98531,"_2384":98532},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2857":58594,"_25170":58585,"_5":25503,"_17548":98534,"_23820":98535,"_2384":98536},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2857":58595,"_25170":58585,"_5":25503,"_17548":98538,"_23820":98539,"_2384":43461},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2857":58596,"_25170":58585,"_5":25503,"_17548":98541,"_23820":98542,"_2384":43465},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2857":58597,"_25170":58585,"_5":25503,"_17548":98544,"_23820":98545,"_2384":98546},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2857":58598,"_25170":58585,"_5":25503,"_17548":98548,"_23820":98549,"_2384":98550},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2857":58599,"_25170":58585,"_5":25503,"_17548":98552,"_23820":98553,"_2384":98554},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2857":58600,"_25170":58585,"_5":25503,"_17548":98556,"_23820":98557,"_2384":98558},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2857":58601,"_25170":58585,"_5":25503,"_17548":98560,"_23820":98561,"_2384":43485},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2857":58602,"_25170":58585,"_5":25503,"_17548":98563,"_23820":98564,"_2384":98565},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2857":58603,"_25170":58585,"_5":25503,"_17548":98567,"_23820":98568,"_2384":98569},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2857":58604,"_25170":58585,"_5":25503,"_17548":98571,"_23820":98572,"_2384":98573},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2857":58605,"_25170":58585,"_17548":98575,"_5":17443,"_23820":58585,"_2384":98576},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2857":58606,"_25170":58585,"_17548":98578,"_5":17443,"_23820":98508,"_2384":98579},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2857":58607,"_25170":58585,"_17548":98581,"_5":17443,"_23820":98508,"_2384":98582},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2857":58608,"_25170":58585,"_17548":98584,"_5":17443,"_23820":98515,"_2384":98585},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2857":58609,"_25170":58585,"_17548":98587,"_5":17443,"_23820":98519,"_2384":98588},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2857":58610,"_25170":58585,"_17548":98590,"_5":17443,"_23820":98523,"_2384":98591},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2857":58611,"_25170":58585,"_17548":98593,"_5":17443,"_23820":98527,"_2384":98594},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2857":58612,"_25170":58585,"_17548":98596,"_5":17443,"_23820":98531,"_2384":98597},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2857":58613,"_25170":58585,"_17548":98599,"_5":17443,"_23820":98539,"_2384":98600},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2857":58614,"_25170":58585,"_17548":98602,"_5":17443,"_23820":98539,"_2384":98603},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2857":58615,"_25170":58585,"_17548":98605,"_5":17443,"_23820":98542,"_2384":98606},[],"Campo de `settings.enrollment_settings`",{"_2857":58616,"_25170":58585,"_17548":98608,"_5":17443,"_23820":98542,"_2384":98609},[],"Decisión",{"_2857":58617,"_25170":58585,"_17548":98611,"_5":17443,"_23820":98542,"_2384":43536},[],{"_2857":58618,"_25170":58585,"_17548":98613,"_5":17443,"_23820":98542,"_2384":98614},[],"`EST_RFC7030` para estas operaciones.",{"_2857":58619,"_25170":58585,"_17548":98616,"_5":17443,"_23820":98542,"_2384":43542},[],{"_2857":58620,"_25170":58585,"_17548":98618,"_5":17443,"_23820":98542,"_2384":98619},[],"ID de la CA que firmará.",{"_2857":58621,"_25170":58585,"_17548":98621,"_5":17443,"_23820":98542,"_2384":43548},[],{"_2857":58622,"_25170":58585,"_17548":98623,"_5":17443,"_23820":98542,"_2384":98624},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2857":58623,"_25170":58585,"_17548":98626,"_5":17443,"_23820":98542,"_2384":43554},[],{"_2857":58624,"_25170":58585,"_17548":98628,"_5":17443,"_23820":98542,"_2384":98629},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2857":58625,"_25170":58585,"_17548":98631,"_5":17443,"_23820":98542,"_2384":43560},[],{"_2857":58626,"_25170":58585,"_17548":98633,"_5":17443,"_23820":98542,"_2384":98634},[],"Uno de los cuatro modos de autenticación.",{"_2857":58627,"_25170":58585,"_17548":98636,"_5":17443,"_23820":98542,"_2384":98637},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2857":58628,"_25170":58585,"_17548":98639,"_5":17443,"_23820":98545,"_2384":98640},[],"Los bloques son independientes:",{"_2857":58629,"_25170":58585,"_17548":98642,"_5":17443,"_23820":98545,"_2384":98643},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2857":58630,"_25170":58585,"_17548":98645,"_5":17443,"_23820":98545,"_2384":98646},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2857":58631,"_25170":58585,"_17548":98648,"_5":17443,"_23820":98545,"_2384":43578},[],{"_2857":58632,"_25170":58585,"_17548":98650,"_5":17443,"_23820":98545,"_2384":98651},[],"Control aplicado en la operación configurada",{"_2857":58633,"_25170":58585,"_17548":98653,"_5":17443,"_23820":98545,"_2384":43584},[],{"_2857":58634,"_25170":58585,"_17548":98655,"_5":17443,"_23820":98545,"_2384":98656},[],"Validación del certificado presentado.",{"_2857":58635,"_25170":58585,"_17548":98658,"_5":17443,"_23820":98545,"_2384":43590},[],{"_2857":58636,"_25170":58585,"_17548":98660,"_5":17443,"_23820":98545,"_2384":98661},[],"Autorización del webhook configurado.",{"_2857":58637,"_25170":58585,"_17548":98663,"_5":17443,"_23820":98545,"_2384":43596},[],{"_2857":58638,"_25170":58585,"_17548":98665,"_5":17443,"_23820":98545,"_2384":98666},[],"Validación del certificado y, después, aprobación del webhook.",{"_2857":58639,"_25170":58585,"_17548":98668,"_5":17443,"_23820":98545,"_2384":43602},[],{"_2857":58640,"_25170":58585,"_17548":98670,"_5":17443,"_23820":98545,"_2384":98671},[],"Sin autenticación del solicitante por el DMS.",{"_2857":58641,"_25170":58585,"_17548":98673,"_5":17443,"_23820":98545,"_2384":98674},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2857":58642,"_25170":58585,"_17548":98676,"_5":17443,"_23820":98545,"_2384":98677},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2857":58643,"_25170":58585,"_17548":98679,"_5":17443,"_23820":98545,"_2384":98680},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas` — copiar la lista del bloque inicial no amplía la aceptación en reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_2857":58644,"_25170":58585,"_17548":98682,"_5":17443,"_23820":98545,"_2384":98683},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2857":58645,"_25170":58585,"_17548":98685,"_5":17443,"_23820":98549,"_2384":98686},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2857":58646,"_25170":58585,"_17548":98688,"_5":17443,"_23820":98549,"_2384":98689},[],"Campo de `external_webhook_settings`",{"_2857":58647,"_25170":58585,"_17548":98691,"_5":17443,"_23820":98549,"_2384":98609},[],{"_2857":58648,"_25170":58585,"_17548":98693,"_5":17443,"_23820":98549,"_2384":43628},[],{"_2857":58649,"_25170":58585,"_17548":98695,"_5":17443,"_23820":98549,"_2384":98696},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2857":58650,"_25170":58585,"_17548":98698,"_5":17443,"_23820":98549,"_2384":43634},[],{"_2857":58651,"_25170":58585,"_17548":98700,"_5":17443,"_23820":98549,"_2384":98701},[],"`POST` o `PUT`; `POST` por defecto.",{"_2857":58652,"_25170":58585,"_17548":98703,"_5":17443,"_23820":98549,"_2384":43640},[],{"_2857":58653,"_25170":58585,"_17548":98705,"_5":17443,"_23820":98549,"_2384":98706},[],"Etiqueta usada en los logs del servicio.",{"_2857":58654,"_25170":58585,"_17548":98708,"_5":17443,"_23820":98549,"_2384":43646},[],{"_2857":58655,"_25170":58585,"_17548":98710,"_5":17443,"_23820":98549,"_2384":98711},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2857":58656,"_25170":58585,"_17548":98713,"_5":17443,"_23820":98549,"_2384":43652},[],{"_2857":58657,"_25170":58585,"_17548":98715,"_5":17443,"_23820":98549,"_2384":98716},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2857":58658,"_25170":58585,"_17548":98718,"_5":17443,"_23820":98549,"_2384":43658},[],{"_2857":58659,"_25170":58585,"_17548":98720,"_5":17443,"_23820":98549,"_2384":98721},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2857":58660,"_25170":58585,"_17548":98723,"_5":17443,"_23820":98549,"_2384":43664},[],{"_2857":58661,"_25170":58585,"_17548":98725,"_5":17443,"_23820":98549,"_2384":98726},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2857":58662,"_25170":58585,"_17548":98728,"_5":17443,"_23820":98549,"_2384":43670},[],{"_2857":58663,"_25170":58585,"_17548":98730,"_5":17443,"_23820":98549,"_2384":98731},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2857":58664,"_25170":58585,"_17548":98733,"_5":17443,"_23820":98549,"_2384":43676},[],{"_2857":58665,"_25170":58585,"_17548":98735,"_5":17443,"_23820":98549,"_2384":98736},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2857":58666,"_25170":58585,"_17548":98738,"_5":17443,"_23820":98549,"_2384":98739},[],"Reglas de esa configuración:",{"_2857":58667,"_25170":58585,"_17548":98741,"_5":17443,"_23820":98549,"_2384":98742},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2857":58668,"_25170":58585,"_17548":98744,"_5":17443,"_23820":98549,"_2384":98745},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2857":58669,"_25170":58585,"_17548":98747,"_5":17443,"_23820":98549,"_2384":98748},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2857":58670,"_25170":58585,"_17548":98750,"_5":17443,"_23820":98549,"_2384":98751},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2857":58671,"_25170":58585,"_17548":98753,"_5":17443,"_23820":98549,"_2384":98754},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2857":58672,"_25170":58585,"_17548":98756,"_5":17443,"_23820":98549,"_2384":98757},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2857":58673,"_25170":58585,"_17548":98759,"_5":17443,"_23820":98549,"_2384":98760},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2857":58674,"_25170":58585,"_17548":98762,"_5":17443,"_23820":98549,"_2384":98763},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS.",{"_2857":58675,"_25170":58585,"_17548":98765,"_5":17443,"_23820":98549,"_2384":98766},[],"La migración `20261022120000` traslada `reenrollment_settings.additional_validation_cas` a `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, sustituyendo lo que hubiera en la clave anidada. Ese valor anidado nunca se consultó al validar reenrolamientos, así que el conjunto de confianza efectivo no cambia; una lista plana ausente o nula pasa a ser una lista vacía. Los DMS sin `reenrollment_settings` quedan intactos. Los cuerpos que aún contengan `additional_validation_cas` se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET ya no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con el formato antiguo vacía en silencio la lista migrada.",{"_2857":58676,"_25170":58585,"_17548":98768,"_5":17443,"_23820":98553,"_2384":98769},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2857":58677,"_25170":58585,"_17548":98771,"_5":17443,"_23820":98557,"_2384":98772},[],"Campo de `settings.reenrollment_settings`",{"_2857":58678,"_25170":58585,"_17548":98774,"_5":17443,"_23820":98557,"_2384":98775},[],"Función",{"_2857":58679,"_25170":58585,"_17548":98777,"_5":17443,"_23820":98557,"_2384":43720},[],{"_2857":58680,"_25170":58585,"_17548":98779,"_5":17443,"_23820":98557,"_2384":98780},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2857":58681,"_25170":58585,"_17548":98782,"_5":17443,"_23820":98557,"_2384":43726},[],{"_2857":58682,"_25170":58585,"_17548":98784,"_5":17443,"_23820":98557,"_2384":98785},[],"Umbral operativo preventivo de monitorización.",{"_2857":58683,"_25170":58585,"_17548":98787,"_5":17443,"_23820":98557,"_2384":43732},[],{"_2857":58684,"_25170":58585,"_17548":98789,"_5":17443,"_23820":98557,"_2384":98790},[],"Umbral operativo crítico de monitorización.",{"_2857":58685,"_25170":58585,"_17548":98792,"_5":17443,"_23820":98557,"_2384":43738},[],{"_2857":58686,"_25170":58585,"_17548":98794,"_5":17443,"_23820":98557,"_2384":98795},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2857":58687,"_25170":58585,"_17548":98797,"_5":17443,"_23820":98557,"_2384":43744},[],{"_2857":58688,"_25170":58585,"_17548":98799,"_5":17443,"_23820":98557,"_2384":98800},[],"CAs de validación adicionales para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_2857":58689,"_25170":58585,"_17548":98802,"_5":17443,"_23820":98557,"_2384":43750},[],{"_2857":58690,"_25170":58585,"_17548":98804,"_5":17443,"_23820":98557,"_2384":98805},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2857":58691,"_25170":58585,"_17548":98807,"_5":17443,"_23820":98557,"_2384":98808},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2857":58692,"_25170":58585,"_17548":98810,"_5":17443,"_23820":98561,"_2384":98811},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2857":58693,"_25170":58585,"_17548":98813,"_5":17443,"_23820":98564,"_2384":96337},[],{"_2857":58694,"_25170":58585,"_17548":98815,"_5":17443,"_23820":98564,"_2384":98816},[],"Qué publica",{"_2857":58695,"_25170":58585,"_17548":98818,"_5":17443,"_23820":98564,"_2384":43767},[],{"_2857":58696,"_25170":58585,"_17548":98820,"_5":17443,"_23820":98564,"_2384":98821},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2857":58697,"_25170":58585,"_17548":98823,"_5":17443,"_23820":98564,"_2384":43773},[],{"_2857":58698,"_25170":58585,"_17548":98825,"_5":17443,"_23820":98564,"_2384":98826},[],"Certificado de la CA emisora seleccionada.",{"_2857":58699,"_25170":58585,"_17548":98828,"_5":17443,"_23820":98564,"_2384":43779},[],{"_2857":58700,"_25170":58585,"_17548":98830,"_5":17443,"_23820":98564,"_2384":98831},[],"Certificados de las CAs elegidas explícitamente.",{"_2857":58701,"_25170":58585,"_17548":98833,"_5":17443,"_23820":98564,"_2384":98834},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2857":58702,"_25170":58585,"_17548":98836,"_5":17443,"_23820":98568,"_2384":98837},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2857":58703,"_25170":58585,"_17548":98839,"_5":17443,"_23820":98568,"_2384":98840},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2857":58704,"_25170":58585,"_17548":98842,"_5":17443,"_23820":98568,"_2384":98843},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2857":58705,"_25170":58585,"_17548":98845,"_5":17443,"_23820":98572,"_2384":98846},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2857":58706,"_25170":58706,"_5":12294,"_2384":98848,"_25506":98849,"_17548":98850,"_23820":58706},"Integra el cliente EST",[40848,97279,43166,98251,98426],[],{"_2857":58707,"_25170":58706,"_17548":98852,"_5":17443,"_23820":58706,"_2384":98853},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2857":58708,"_25170":58706,"_5":25503,"_17548":98855,"_23820":98856,"_2384":95980},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2857":58709,"_25170":58706,"_5":25503,"_17548":98858,"_23820":98859,"_2384":98860},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2857":58710,"_25170":58706,"_5":25503,"_17548":98862,"_23820":98863,"_2384":98864},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2857":58711,"_25170":58706,"_5":25503,"_17548":98866,"_23820":98867,"_2384":98868},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2857":58712,"_25170":58706,"_5":25503,"_17548":98870,"_23820":98871,"_2384":98872},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2857":58713,"_25170":58706,"_5":25503,"_17548":98874,"_23820":98875,"_2384":98876},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2857":58714,"_25170":58706,"_17548":98878,"_5":17443,"_23820":58706,"_2384":98879},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2857":58715,"_25170":58706,"_17548":98881,"_5":17443,"_23820":98856,"_2384":98882},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2857":58716,"_25170":58706,"_17548":98884,"_5":17443,"_23820":98856,"_2384":98885},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2857":58717,"_25170":58706,"_17548":98887,"_5":17443,"_23820":98856,"_2384":98888},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2857":58718,"_25170":58706,"_17548":98890,"_5":17443,"_23820":98859,"_2384":98891},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2857":58719,"_25170":58706,"_17548":98893,"_5":17443,"_23820":98859,"_2384":98894},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2857":58720,"_25170":58706,"_17548":98896,"_5":17443,"_23820":98863,"_2384":98897},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2857":58721,"_25170":58706,"_17548":98899,"_5":17443,"_23820":98863,"_2384":98900},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2857":58722,"_25170":58706,"_17548":98902,"_5":17443,"_23820":98867,"_2384":98903},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2857":58723,"_25170":58706,"_17548":98905,"_5":17443,"_23820":98867,"_2384":98906},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2857":58724,"_25170":58706,"_17548":98908,"_5":17443,"_23820":98871,"_2384":98909},[],"Para el caso de una raíz que emite directamente:",{"_2857":58725,"_25170":58706,"_17548":98911,"_5":17443,"_23820":98871,"_2384":98912},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2857":58726,"_25170":58706,"_17548":98914,"_5":17443,"_23820":98871,"_2384":98915},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2857":58727,"_25170":58706,"_17548":98917,"_5":17443,"_23820":98875,"_2384":98918},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2857":58728,"_25170":58728,"_5":12294,"_2384":98920,"_25506":98921,"_17548":98922,"_23820":58728},"Referencia EST",[40848,97279,43166,98251,98426],[],{"_2857":58729,"_25170":58728,"_17548":98924,"_5":17443,"_23820":58728,"_2384":98925},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2857":58730,"_25170":58728,"_5":25503,"_17548":98927,"_23820":98928,"_2384":98929},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2857":58731,"_25170":58728,"_5":25503,"_17548":98931,"_23820":98932,"_2384":19066},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2857":58732,"_25170":58728,"_5":25503,"_17548":98934,"_23820":98935,"_2384":21842},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2857":58733,"_25170":58728,"_5":25503,"_17548":98937,"_23820":98938,"_2384":21849},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2857":58734,"_25170":58728,"_5":25503,"_17548":98940,"_23820":98941,"_2384":21219},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2857":58735,"_25170":58728,"_5":25503,"_17548":98943,"_23820":98944,"_2384":98945},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2857":58736,"_25170":58728,"_5":25503,"_17548":98947,"_23820":98948,"_2384":98949},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2857":58737,"_25170":58728,"_5":25503,"_17548":98951,"_23820":98952,"_2384":98953},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2857":58738,"_25170":58728,"_17548":98955,"_5":17443,"_23820":58728,"_2384":98956},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2857":58739,"_25170":58728,"_17548":98958,"_5":17443,"_23820":98928,"_2384":98959},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2857":58740,"_25170":58728,"_17548":98961,"_5":17443,"_23820":98928,"_2384":97070},[],{"_2857":58741,"_25170":58728,"_17548":98963,"_5":17443,"_23820":98928,"_2384":98964},[],"Método",{"_2857":58742,"_25170":58728,"_17548":98966,"_5":17443,"_23820":98928,"_2384":98967},[],"Autenticación y condición",{"_2857":58743,"_25170":58728,"_17548":98969,"_5":17443,"_23820":98928,"_2384":43922},[],{"_2857":58744,"_25170":58728,"_17548":98971,"_5":17443,"_23820":98928,"_2384":43925},[],{"_2857":58745,"_25170":58728,"_17548":98973,"_5":17443,"_23820":98928,"_2384":98974},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2857":58746,"_25170":58728,"_17548":98976,"_5":17443,"_23820":98928,"_2384":43931},[],{"_2857":58747,"_25170":58728,"_17548":98978,"_5":17443,"_23820":98928,"_2384":43934},[],{"_2857":58748,"_25170":58728,"_17548":98980,"_5":17443,"_23820":98928,"_2384":98981},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2857":58749,"_25170":58728,"_17548":98983,"_5":17443,"_23820":98928,"_2384":43940},[],{"_2857":58750,"_25170":58728,"_17548":98985,"_5":17443,"_23820":98928,"_2384":43934},[],{"_2857":58751,"_25170":58728,"_17548":98987,"_5":17443,"_23820":98928,"_2384":98988},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2857":58752,"_25170":58728,"_17548":98990,"_5":17443,"_23820":98928,"_2384":43948},[],{"_2857":58753,"_25170":58728,"_17548":98992,"_5":17443,"_23820":98928,"_2384":43934},[],{"_2857":58754,"_25170":58728,"_17548":98994,"_5":17443,"_23820":98928,"_2384":98995},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2857":58755,"_25170":58728,"_17548":98997,"_5":17443,"_23820":98928,"_2384":98998},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2857":58756,"_25170":58728,"_17548":99000,"_5":17443,"_23820":98932,"_2384":99001},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2857":58757,"_25170":58728,"_17548":99003,"_5":17443,"_23820":98932,"_2384":99004},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2857":58758,"_25170":58728,"_17548":99006,"_5":17443,"_23820":98935,"_2384":99007},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2857":58759,"_25170":58728,"_17548":99009,"_5":17443,"_23820":98935,"_2384":99010},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2857":58760,"_25170":58728,"_17548":99012,"_5":17443,"_23820":98938,"_2384":99013},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2857":58761,"_25170":58728,"_17548":99015,"_5":17443,"_23820":98938,"_2384":99016},[],"La CA de enrolamiento o una CA de validación configurada en el bloque de reenrolamiento valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2857":58762,"_25170":58728,"_17548":99018,"_5":17443,"_23820":98941,"_2384":99019},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2857":58763,"_25170":58728,"_17548":99021,"_5":17443,"_23820":98941,"_2384":99022},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2857":58764,"_25170":58728,"_17548":99024,"_5":17443,"_23820":98944,"_2384":99025},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2857":58765,"_25170":58728,"_17548":99027,"_5":17443,"_23820":98944,"_2384":99028},[],"Parte",{"_2857":58766,"_25170":58728,"_17548":99030,"_5":17443,"_23820":98944,"_2384":99031},[],"Contenido tras decodificar su Base64",{"_2857":58767,"_25170":58728,"_17548":99033,"_5":17443,"_23820":98944,"_2384":43992},[],{"_2857":58768,"_25170":58728,"_17548":99035,"_5":17443,"_23820":98944,"_2384":99036},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2857":58769,"_25170":58728,"_17548":99038,"_5":17443,"_23820":98944,"_2384":43998},[],{"_2857":58770,"_25170":58728,"_17548":99040,"_5":17443,"_23820":98944,"_2384":99041},[],"PKCS#7 DER con el certificado emitido.",{"_2857":58771,"_25170":58728,"_17548":99043,"_5":17443,"_23820":98944,"_2384":99044},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2857":58772,"_25170":58728,"_17548":99046,"_5":17443,"_23820":98948,"_2384":99047},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2857":58773,"_25170":58728,"_17548":99049,"_5":17443,"_23820":98948,"_2384":99050},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2857":58774,"_25170":58728,"_17548":99052,"_5":17443,"_23820":98948,"_2384":99053},[],"Convierte y comprueba el resultado:",{"_2857":58775,"_25170":58728,"_17548":99055,"_5":17443,"_23820":98948,"_2384":99056},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2857":58776,"_25170":58728,"_17548":99058,"_5":17443,"_23820":98952,"_2384":99059},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2857":58777,"_25170":58728,"_17548":99061,"_5":17443,"_23820":98952,"_2384":99062},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2857":58778,"_25170":58778,"_5":12294,"_2384":98426,"_25506":99064,"_17548":99065,"_23820":58778},[40848,97279,43166,98251,98426],[],{"_2857":58779,"_25170":58778,"_17548":99067,"_5":17443,"_23820":58778,"_2384":99068},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2857":58780,"_25170":58778,"_5":25503,"_17548":99070,"_23820":99071,"_2384":99072},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2857":58781,"_25170":58778,"_5":25503,"_17548":99074,"_23820":99075,"_2384":99076},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2857":58782,"_25170":58778,"_5":25503,"_17548":99078,"_23820":99079,"_2384":99080},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2857":58783,"_25170":58778,"_5":25503,"_17548":99082,"_23820":99083,"_2384":99084},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2857":58784,"_25170":58778,"_17548":99086,"_5":17443,"_23820":58778,"_2384":99087},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2857":58785,"_25170":58778,"_17548":99089,"_5":17443,"_23820":99071,"_2384":99090},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2857":58786,"_25170":58778,"_17548":99092,"_5":17443,"_23820":99071,"_2384":99093},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2857":58787,"_25170":58778,"_17548":99095,"_5":17443,"_23820":99071,"_2384":99096},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2857":58788,"_25170":58778,"_17548":99098,"_5":17443,"_23820":99071,"_2384":99099},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2857":58789,"_25170":58778,"_17548":99101,"_5":17443,"_23820":99071,"_2384":99102},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2857":58790,"_25170":58778,"_17548":99104,"_5":17443,"_23820":99071,"_2384":99105},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2857":58791,"_25170":58778,"_17548":99107,"_5":17443,"_23820":99075,"_2384":99108},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2857":58792,"_25170":58778,"_17548":99110,"_5":17443,"_23820":99075,"_2384":99111},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":58793,"_25170":58778,"_17548":99113,"_5":17443,"_23820":99075,"_2384":99114},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2857":58794,"_25170":58778,"_17548":99116,"_5":17443,"_23820":99075,"_2384":99117},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2857":58795,"_25170":58778,"_17548":99119,"_5":17443,"_23820":99079,"_2384":99120},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2857":58796,"_25170":58778,"_17548":99122,"_5":17443,"_23820":99079,"_2384":99123},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2857":58797,"_25170":58778,"_17548":99125,"_5":17443,"_23820":99079,"_2384":99126},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2857":58798,"_25170":58778,"_17548":99128,"_5":17443,"_23820":99079,"_2384":99129},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2857":58799,"_25170":58778,"_17548":99131,"_5":17443,"_23820":99083,"_2384":99132},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2857":58800,"_25170":58778,"_17548":99134,"_5":17443,"_23820":99083,"_2384":99135},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2857":58801,"_25170":58801,"_5":12294,"_2384":99137,"_25506":99138,"_17548":99139,"_23820":58801},"Estrategias de aprovisionamiento",[40848,97279,43166,98251,98426],[],{"_2857":58802,"_25170":58801,"_17548":99141,"_5":17443,"_23820":58801,"_2384":99142},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2857":58803,"_25170":58801,"_5":25503,"_17548":99144,"_23820":99145,"_2384":99146},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2857":58804,"_25170":58801,"_5":25503,"_17548":99148,"_23820":99149,"_2384":99150},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2857":58805,"_25170":58801,"_5":25503,"_17548":99152,"_23820":99153,"_2384":99154},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2857":58806,"_25170":58801,"_5":25503,"_17548":99156,"_23820":99157,"_2384":99158},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2857":58807,"_25170":58801,"_5":25503,"_17548":99160,"_23820":99161,"_2384":99162},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2857":58808,"_25170":58801,"_17548":99164,"_5":17443,"_23820":58801,"_2384":99165},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2857":58809,"_25170":58801,"_17548":99167,"_5":17443,"_23820":99145,"_2384":99168},[],"Recorrido",{"_2857":58810,"_25170":58801,"_17548":99170,"_5":17443,"_23820":99145,"_2384":99171},[],"Cuándo existe el dispositivo",{"_2857":58811,"_25170":58801,"_17548":99173,"_5":17443,"_23820":99145,"_2384":99174},[],"Qué compruebas",{"_2857":58812,"_25170":58801,"_17548":99176,"_5":17443,"_23820":99145,"_2384":99177},[],"Asignación manual",{"_2857":58813,"_25170":58801,"_17548":99179,"_5":17443,"_23820":99145,"_2384":99180},[],"El operador lo crea antes de asociar un certificado.",{"_2857":58814,"_25170":58801,"_17548":99182,"_5":17443,"_23820":99145,"_2384":99183},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2857":58815,"_25170":58801,"_17548":99185,"_5":17443,"_23820":99145,"_2384":99186},[],"EST con `JITP`",{"_2857":58816,"_25170":58801,"_17548":99188,"_5":17443,"_23820":99145,"_2384":99189},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2857":58817,"_25170":58801,"_17548":99191,"_5":17443,"_23820":99145,"_2384":99192},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2857":58818,"_25170":58801,"_17548":99194,"_5":17443,"_23820":99145,"_2384":99195},[],"EST con `PRE_REGISTRATION`",{"_2857":58819,"_25170":58801,"_17548":99197,"_5":17443,"_23820":99145,"_2384":99198},[],"Debe existir antes de `/simpleenroll`.",{"_2857":58820,"_25170":58801,"_17548":99200,"_5":17443,"_23820":99145,"_2384":99201},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2857":58821,"_25170":58801,"_17548":99203,"_5":17443,"_23820":99145,"_2384":99204},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2857":58822,"_25170":58801,"_17548":99206,"_5":17443,"_23820":99145,"_2384":99207},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2857":58823,"_25170":58801,"_17548":99209,"_5":17443,"_23820":99149,"_2384":99210},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2857":58824,"_25170":58801,"_17548":99212,"_5":17443,"_23820":99149,"_2384":99213},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2857":58825,"_25170":58801,"_17548":99215,"_5":17443,"_23820":99149,"_2384":99216},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2857":58826,"_25170":58801,"_17548":99218,"_5":17443,"_23820":99153,"_2384":99219},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2857":58827,"_25170":58801,"_17548":99221,"_5":17443,"_23820":99153,"_2384":99222},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2857":58828,"_25170":58801,"_17548":99224,"_5":17443,"_23820":99153,"_2384":99225},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2857":58829,"_25170":58801,"_17548":99227,"_5":17443,"_23820":99153,"_2384":99228},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2857":58830,"_25170":58801,"_17548":99230,"_5":17443,"_23820":99153,"_2384":99231},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2857":58831,"_25170":58801,"_17548":99233,"_5":17443,"_23820":99153,"_2384":99234},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2857":58832,"_25170":58801,"_17548":99236,"_5":17443,"_23820":99157,"_2384":96337},[],{"_2857":58833,"_25170":58801,"_17548":99238,"_5":17443,"_23820":99157,"_2384":99239},[],"Material que atraviesa EST",{"_2857":58834,"_25170":58801,"_17548":99241,"_5":17443,"_23820":99157,"_2384":99242},[],"Clave generada por el dispositivo",{"_2857":58835,"_25170":58801,"_17548":99244,"_5":17443,"_23820":99157,"_2384":99245},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2857":58836,"_25170":58801,"_17548":99247,"_5":17443,"_23820":99157,"_2384":99248},[],"Clave ya disponible en el dispositivo",{"_2857":58837,"_25170":58801,"_17548":99250,"_5":17443,"_23820":99157,"_2384":99251},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2857":58838,"_25170":58801,"_17548":99253,"_5":17443,"_23820":99157,"_2384":43485},[],{"_2857":58839,"_25170":58801,"_17548":99255,"_5":17443,"_23820":99157,"_2384":99256},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2857":58840,"_25170":58801,"_17548":99258,"_5":17443,"_23820":99157,"_2384":99259},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2857":58841,"_25170":58801,"_17548":99261,"_5":17443,"_23820":99161,"_2384":99262},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2857":58842,"_25170":58842,"_5":12294,"_2384":99264,"_25506":99265,"_17548":99266,"_23820":58842},"Renovación y recuperación",[40848,97279,43166,98251,98426],[],{"_2857":58843,"_25170":58842,"_17548":99268,"_5":17443,"_23820":58842,"_2384":99269},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2857":58844,"_25170":58842,"_5":25503,"_17548":99271,"_23820":99272,"_2384":99273},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2857":58845,"_25170":58842,"_5":25503,"_17548":99275,"_23820":99276,"_2384":99277},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2857":58846,"_25170":58842,"_5":25503,"_17548":99279,"_23820":99280,"_2384":99281},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2857":58847,"_25170":58842,"_5":25503,"_17548":99283,"_23820":99284,"_2384":99285},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2857":58848,"_25170":58842,"_5":25503,"_17548":99287,"_23820":99288,"_2384":99289},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2857":58849,"_25170":58842,"_17548":99291,"_5":17443,"_23820":58842,"_2384":99292},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2857":58850,"_25170":58842,"_17548":99294,"_5":17443,"_23820":99272,"_2384":99295},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2857":58851,"_25170":58842,"_17548":99297,"_5":17443,"_23820":99272,"_2384":99298},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2857":58852,"_25170":58842,"_17548":99300,"_5":17443,"_23820":99272,"_2384":99301},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2857":58853,"_25170":58842,"_17548":99303,"_5":17443,"_23820":99272,"_2384":99304},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2857":58854,"_25170":58842,"_17548":99306,"_5":17443,"_23820":99276,"_2384":99307},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2857":58855,"_25170":58842,"_17548":99309,"_5":17443,"_23820":99276,"_2384":99310},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2857":58856,"_25170":58842,"_17548":99312,"_5":17443,"_23820":99280,"_2384":99313},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2857":58857,"_25170":58842,"_17548":99315,"_5":17443,"_23820":99280,"_2384":99316},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2857":58858,"_25170":58842,"_17548":99318,"_5":17443,"_23820":99280,"_2384":99319},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2857":58859,"_25170":58842,"_17548":99321,"_5":17443,"_23820":99284,"_2384":99322},[],"Situación",{"_2857":58860,"_25170":58842,"_17548":99324,"_5":17443,"_23820":99284,"_2384":99325},[],"Procedimiento",{"_2857":58861,"_25170":58842,"_17548":99327,"_5":17443,"_23820":99284,"_2384":99328},[],"Certificado vigente, fuera de ventana",{"_2857":58862,"_25170":58842,"_17548":99330,"_5":17443,"_23820":99284,"_2384":99331},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2857":58863,"_25170":58842,"_17548":99333,"_5":17443,"_23820":99284,"_2384":99334},[],"Certificado vencido, clave disponible",{"_2857":58864,"_25170":58842,"_17548":99336,"_5":17443,"_23820":99284,"_2384":99337},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2857":58865,"_25170":58842,"_17548":99339,"_5":17443,"_23820":99284,"_2384":99340},[],"Renovación por webhook o `NO_AUTH`",{"_2857":58866,"_25170":58842,"_17548":99342,"_5":17443,"_23820":99284,"_2384":99343},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2857":58867,"_25170":58842,"_17548":99345,"_5":17443,"_23820":99284,"_2384":99346},[],"Clave perdida o inaccesible",{"_2857":58868,"_25170":58842,"_17548":99348,"_5":17443,"_23820":99284,"_2384":99349},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2857":58869,"_25170":58842,"_17548":99351,"_5":17443,"_23820":99284,"_2384":99352},[],"Identidad actual revocada",{"_2857":58870,"_25170":58842,"_17548":99354,"_5":17443,"_23820":99284,"_2384":99355},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2857":58871,"_25170":58842,"_17548":99357,"_5":17443,"_23820":99284,"_2384":99358},[],"Dispositivo sin identidad",{"_2857":58872,"_25170":58842,"_17548":99360,"_5":17443,"_23820":99284,"_2384":99361},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2857":58873,"_25170":58842,"_17548":99363,"_5":17443,"_23820":99284,"_2384":99364},[],"Dispositivo retirado",{"_2857":58874,"_25170":58842,"_17548":99366,"_5":17443,"_23820":99284,"_2384":99367},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2857":58875,"_25170":58842,"_17548":99369,"_5":17443,"_23820":99284,"_2384":99370},[],"Timeout, HTTP 500 o fallo de instalación",{"_2857":58876,"_25170":58842,"_17548":99372,"_5":17443,"_23820":99284,"_2384":99373},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2857":58877,"_25170":58842,"_17548":99375,"_5":17443,"_23820":99288,"_2384":99376},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2857":58878,"_25170":58842,"_17548":99378,"_5":17443,"_23820":99288,"_2384":99379},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2857":58879,"_25170":58879,"_5":12294,"_2384":99381,"_25506":99382,"_17548":99383,"_23820":58879},"Diagnóstico de enrolamiento",[40848,97279,43166,98251,98426],[],{"_2857":58880,"_25170":58879,"_17548":99385,"_5":17443,"_23820":58879,"_2384":99386},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2857":58881,"_25170":58879,"_5":25503,"_17548":99388,"_23820":99389,"_2384":99390},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2857":58882,"_25170":58879,"_5":25503,"_17548":99392,"_23820":99393,"_2384":99394},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2857":58883,"_25170":58879,"_5":25503,"_17548":99396,"_23820":99397,"_2384":98953},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2857":58884,"_25170":58879,"_5":25503,"_17548":99399,"_23820":99400,"_2384":99401},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2857":58885,"_25170":58879,"_17548":99403,"_5":17443,"_23820":58879,"_2384":99404},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2857":58886,"_25170":58879,"_17548":99406,"_5":17443,"_23820":99393,"_2384":99407},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2857":58887,"_25170":58879,"_17548":99409,"_5":17443,"_23820":99393,"_2384":99410},[],"Síntoma o mensaje",{"_2857":58888,"_25170":58879,"_17548":99412,"_5":17443,"_23820":99393,"_2384":99413},[],"Qué revisar",{"_2857":58889,"_25170":58879,"_17548":99415,"_5":17443,"_23820":99393,"_2384":99416},[],"curl rechaza TLS, nombre o emisor",{"_2857":58890,"_25170":58879,"_17548":99418,"_5":17443,"_23820":99393,"_2384":99419},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2857":58891,"_25170":58879,"_17548":99421,"_5":17443,"_23820":99393,"_2384":99422},[],"404 o APS ausente",{"_2857":58892,"_25170":58879,"_17548":99424,"_5":17443,"_23820":99393,"_2384":99425},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2857":58893,"_25170":58879,"_17548":99427,"_5":17443,"_23820":99393,"_2384":99428},[],"400, error de CSR o formato",{"_2857":58894,"_25170":58879,"_17548":99430,"_5":17443,"_23820":99393,"_2384":99431},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2857":58895,"_25170":58879,"_17548":99433,"_5":17443,"_23820":99393,"_2384":99434},[],"Credencial ausente o certificado no válido",{"_2857":58896,"_25170":58879,"_17548":99436,"_5":17443,"_23820":99393,"_2384":99437},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2857":58897,"_25170":58879,"_17548":99439,"_5":17443,"_23820":99393,"_2384":99440},[],"Webhook deniega, expira o responde sin autorización",{"_2857":58898,"_25170":58879,"_17548":99442,"_5":17443,"_23820":99393,"_2384":99443},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2857":58899,"_25170":58879,"_17548":99445,"_5":17443,"_23820":99393,"_2384":44405},[],{"_2857":58900,"_25170":58879,"_17548":99447,"_5":17443,"_23820":99393,"_2384":99448},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2857":58901,"_25170":58879,"_17548":99450,"_5":17443,"_23820":99393,"_2384":44411},[],{"_2857":58902,"_25170":58879,"_17548":99452,"_5":17443,"_23820":99393,"_2384":99453},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2857":58903,"_25170":58879,"_17548":99455,"_5":17443,"_23820":99393,"_2384":44417},[],{"_2857":58904,"_25170":58879,"_17548":99457,"_5":17443,"_23820":99393,"_2384":99458},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el PEM como `cert_content` y `key_content`; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2857":58905,"_25170":58879,"_17548":99460,"_5":17443,"_23820":99393,"_2384":99461},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2857":58906,"_25170":58879,"_17548":99463,"_5":17443,"_23820":99393,"_2384":99464},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2857":58907,"_25170":58879,"_17548":99466,"_5":17443,"_23820":99393,"_2384":99467},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2857":58908,"_25170":58879,"_17548":99469,"_5":17443,"_23820":99393,"_2384":99470},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2857":58909,"_25170":58879,"_17548":99472,"_5":17443,"_23820":99393,"_2384":44435},[],{"_2857":58910,"_25170":58879,"_17548":99474,"_5":17443,"_23820":99393,"_2384":99475},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2857":58911,"_25170":58879,"_17548":99477,"_5":17443,"_23820":99393,"_2384":44441},[],{"_2857":58912,"_25170":58879,"_17548":99479,"_5":17443,"_23820":99393,"_2384":99480},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2857":58913,"_25170":58879,"_17548":99482,"_5":17443,"_23820":99393,"_2384":99483},[],"DMS propietario distinto",{"_2857":58914,"_25170":58879,"_17548":99485,"_5":17443,"_23820":99393,"_2384":99486},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2857":58915,"_25170":58879,"_17548":99488,"_5":17443,"_23820":99393,"_2384":44453},[],{"_2857":58916,"_25170":58879,"_17548":99490,"_5":17443,"_23820":99393,"_2384":99491},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2857":58917,"_25170":58879,"_17548":99493,"_5":17443,"_23820":99393,"_2384":44459},[],{"_2857":58918,"_25170":58879,"_17548":99495,"_5":17443,"_23820":99393,"_2384":99496},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2857":58919,"_25170":58879,"_17548":99498,"_5":17443,"_23820":99393,"_2384":99499},[],"Certificado actual revocado",{"_2857":58920,"_25170":58879,"_17548":99501,"_5":17443,"_23820":99393,"_2384":99502},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2857":58921,"_25170":58879,"_17548":99504,"_5":17443,"_23820":99393,"_2384":99505},[],"Error de CA, perfil o firma",{"_2857":58922,"_25170":58879,"_17548":99507,"_5":17443,"_23820":99393,"_2384":99508},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2857":58923,"_25170":58879,"_17548":99510,"_5":17443,"_23820":99393,"_2384":99511},[],"HTTP 200 sin conexión del dispositivo",{"_2857":58924,"_25170":58879,"_17548":99513,"_5":17443,"_23820":99393,"_2384":99514},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2857":58925,"_25170":58879,"_17548":99516,"_5":17443,"_23820":99393,"_2384":99517},[],"Timeout o error después de emitir",{"_2857":58926,"_25170":58879,"_17548":99519,"_5":17443,"_23820":99393,"_2384":99520},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2857":58927,"_25170":58879,"_17548":99522,"_5":17443,"_23820":99397,"_2384":99523},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2857":58928,"_25170":58879,"_17548":99525,"_5":17443,"_23820":99397,"_2384":99526},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2857":58929,"_25170":58879,"_17548":99528,"_5":17443,"_23820":99400,"_2384":99529},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2857":58930,"_25170":58879,"_17548":99531,"_5":17443,"_23820":99400,"_2384":99532},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2857":58931,"_25170":58879,"_17548":99534,"_5":17443,"_23820":99400,"_2384":99535},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2857":58932,"_25170":58879,"_17548":99537,"_5":17443,"_23820":99400,"_2384":99538},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2857":58933,"_25170":58879,"_17548":99540,"_5":17443,"_23820":99400,"_2384":99541},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2857":58934,"_25170":58879,"_17548":99543,"_5":17443,"_23820":99400,"_2384":99544},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2857":58935,"_25170":58879,"_17548":99546,"_5":17443,"_23820":99400,"_2384":99547},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2857":58936,"_25170":58936,"_5":12294,"_2384":99549,"_25506":99550,"_17548":99551,"_23820":58936},"Distribución y actualización de confianza",[40848,97279,43166,98251,98426],[],{"_2857":58937,"_25170":58936,"_17548":99553,"_5":17443,"_23820":58936,"_2384":99554},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2857":58938,"_25170":58936,"_5":25503,"_17548":99556,"_23820":99557,"_2384":99558},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2857":58939,"_25170":58936,"_5":25503,"_17548":99560,"_23820":99561,"_2384":99562},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2857":58940,"_25170":58936,"_5":25503,"_17548":99564,"_23820":99565,"_2384":99566},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2857":58941,"_25170":58936,"_5":25503,"_17548":99568,"_23820":99569,"_2384":99570},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2857":58942,"_25170":58936,"_5":25503,"_17548":99572,"_23820":99573,"_2384":99574},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2857":58943,"_25170":58936,"_17548":99576,"_5":17443,"_23820":58936,"_2384":99577},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2857":58944,"_25170":58936,"_17548":99579,"_5":17443,"_23820":99557,"_2384":99580},[],"Relación",{"_2857":58945,"_25170":58936,"_17548":99582,"_5":17443,"_23820":99557,"_2384":99583},[],"Material que prepara el responsable",{"_2857":58946,"_25170":58936,"_17548":99585,"_5":17443,"_23820":99557,"_2384":99586},[],"Dispositivo → servidor EST",{"_2857":58947,"_25170":58936,"_17548":99588,"_5":17443,"_23820":99557,"_2384":99589},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2857":58948,"_25170":58936,"_17548":99591,"_5":17443,"_23820":99557,"_2384":99592},[],"DMS → solicitante",{"_2857":58949,"_25170":58936,"_17548":99594,"_5":17443,"_23820":99557,"_2384":99595},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2857":58950,"_25170":58936,"_17548":99597,"_5":17443,"_23820":99557,"_2384":99598},[],"Consumidor → dispositivo",{"_2857":58951,"_25170":58936,"_17548":99600,"_5":17443,"_23820":99557,"_2384":99601},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2857":58952,"_25170":58936,"_17548":99603,"_5":17443,"_23820":99557,"_2384":99604},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2857":58953,"_25170":58936,"_17548":99606,"_5":17443,"_23820":99561,"_2384":99607},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2857":58954,"_25170":58936,"_17548":99609,"_5":17443,"_23820":99561,"_2384":99610},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2857":58955,"_25170":58936,"_17548":99612,"_5":17443,"_23820":99565,"_2384":99613},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2857":58956,"_25170":58936,"_17548":99615,"_5":17443,"_23820":99565,"_2384":99616},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2857":58957,"_25170":58936,"_17548":99618,"_5":17443,"_23820":99565,"_2384":99619},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2857":58958,"_25170":58936,"_17548":99621,"_5":17443,"_23820":99565,"_2384":99622},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2857":58959,"_25170":58936,"_17548":99624,"_5":17443,"_23820":99565,"_2384":99625},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2857":58960,"_25170":58936,"_17548":99627,"_5":17443,"_23820":99565,"_2384":99628},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2857":58961,"_25170":58936,"_17548":99630,"_5":17443,"_23820":99569,"_2384":99631},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2857":58962,"_25170":58936,"_17548":99633,"_5":17443,"_23820":99569,"_2384":99634},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Al cambiar la CA de enrolamiento, añade a esa lista la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento; los valores migrados de `additional_validation_cas` viven ahora ahí. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2857":58963,"_25170":58936,"_17548":99636,"_5":17443,"_23820":99569,"_2384":99637},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2857":58964,"_25170":58936,"_17548":99639,"_5":17443,"_23820":99573,"_2384":99640},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2857":58965,"_25170":58965,"_5":12294,"_2384":44608,"_25506":99642,"_17548":99644,"_23820":58965},[40848,97279,43166,98251,99643],"Integraciones",[],{"_2857":58966,"_25170":58965,"_17548":99646,"_5":17443,"_23820":58965,"_2384":99647},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2857":58967,"_25170":58965,"_5":25503,"_17548":99649,"_23820":99650,"_2384":99651},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2857":58968,"_25170":58965,"_5":25503,"_17548":99653,"_23820":99654,"_2384":99655},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2857":58969,"_25170":58965,"_5":25503,"_17548":99657,"_23820":99658,"_2384":99659},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2857":58970,"_25170":58965,"_5":25503,"_17548":99661,"_23820":99662,"_2384":99663},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2857":58971,"_25170":58965,"_5":25503,"_17548":99665,"_23820":99666,"_2384":99667},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2857":58972,"_25170":58965,"_5":25503,"_17548":99669,"_23820":99670,"_2384":99671},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2857":58973,"_25170":58965,"_5":25503,"_17548":99673,"_23820":99674,"_2384":44642},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2857":58974,"_25170":58965,"_5":25503,"_17548":99676,"_23820":99677,"_2384":44646},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2857":58975,"_25170":58965,"_5":25503,"_17548":99679,"_23820":99680,"_2384":99681},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2857":58976,"_25170":58965,"_5":25503,"_17548":99683,"_23820":99684,"_2384":99685},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2857":58977,"_25170":58965,"_5":25503,"_17548":99687,"_23820":99688,"_2384":99689},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2857":58978,"_25170":58965,"_5":25503,"_17548":99691,"_23820":99692,"_2384":99693},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2857":58979,"_25170":58965,"_5":25503,"_17548":99695,"_23820":99696,"_2384":99697},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2857":58980,"_25170":58965,"_5":25503,"_17548":99699,"_23820":99700,"_2384":99701},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2857":58981,"_25170":58965,"_5":25503,"_17548":99703,"_23820":99704,"_2384":99705},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2857":58982,"_25170":58965,"_5":25503,"_17548":99707,"_23820":99708,"_2384":99709},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2857":58983,"_25170":58965,"_5":25503,"_17548":99711,"_23820":99712,"_2384":99713},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2857":58984,"_25170":58965,"_5":25503,"_17548":99715,"_23820":99716,"_2384":99717},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2857":58985,"_25170":58965,"_5":25503,"_17548":99719,"_23820":99720,"_2384":99721},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2857":58986,"_25170":58965,"_5":25503,"_17548":99723,"_23820":99724,"_2384":99725},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2857":58987,"_25170":58965,"_17548":99727,"_5":17443,"_23820":58965,"_2384":99728},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2857":58988,"_25170":58965,"_17548":99730,"_5":17443,"_23820":58965,"_2384":99731},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2857":58989,"_25170":58965,"_17548":99733,"_5":17443,"_23820":58965,"_2384":99734},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2857":58990,"_25170":58965,"_17548":99736,"_5":17443,"_23820":99650,"_2384":99737},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2857":58991,"_25170":58965,"_17548":99739,"_5":17443,"_23820":99650,"_2384":99740},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2857":58992,"_25170":58965,"_17548":99742,"_5":17443,"_23820":99650,"_2384":99743},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2857":58993,"_25170":58965,"_17548":99745,"_5":17443,"_23820":99650,"_2384":99746},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2857":58994,"_25170":58965,"_17548":99748,"_5":17443,"_23820":99654,"_2384":99749},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2857":58995,"_25170":58965,"_17548":99751,"_5":17443,"_23820":99658,"_2384":99752},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2857":58996,"_25170":58965,"_17548":99754,"_5":17443,"_23820":99658,"_2384":99755},[],"Acción IAM",{"_2857":58997,"_25170":58965,"_17548":99757,"_5":17443,"_23820":99658,"_2384":96343},[],{"_2857":58998,"_25170":58965,"_17548":99759,"_5":17443,"_23820":99658,"_2384":44729},[],{"_2857":58999,"_25170":58965,"_17548":99761,"_5":17443,"_23820":99658,"_2384":99762},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2857":59000,"_25170":58965,"_17548":99764,"_5":17443,"_23820":99658,"_2384":44735},[],{"_2857":59001,"_25170":58965,"_17548":99766,"_5":17443,"_23820":99658,"_2384":99767},[],"Registrar la CA en AWS IoT",{"_2857":59002,"_25170":58965,"_17548":99769,"_5":17443,"_23820":99658,"_2384":44741},[],{"_2857":59003,"_25170":58965,"_17548":99771,"_5":17443,"_23820":99658,"_2384":99772},[],"Consultar el estado del registro de la CA",{"_2857":59004,"_25170":58965,"_17548":99774,"_5":17443,"_23820":99658,"_2384":44747},[],{"_2857":59005,"_25170":58965,"_17548":99776,"_5":17443,"_23820":99658,"_2384":99777},[],"Crear o actualizar Things en IoT Core",{"_2857":59006,"_25170":58965,"_17548":99779,"_5":17443,"_23820":99658,"_2384":44753},[],{"_2857":59007,"_25170":58965,"_17548":99781,"_5":17443,"_23820":99658,"_2384":99782},[],"Aprovisionar Things mediante plantilla",{"_2857":59008,"_25170":58965,"_17548":99784,"_5":17443,"_23820":99658,"_2384":44759},[],{"_2857":59009,"_25170":58965,"_17548":99786,"_5":17443,"_23820":99658,"_2384":99787},[],"Registrar certificados de dispositivo",{"_2857":59010,"_25170":58965,"_17548":99789,"_5":17443,"_23820":99658,"_2384":44765},[],{"_2857":59011,"_25170":58965,"_17548":99791,"_5":17443,"_23820":99658,"_2384":99792},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2857":59012,"_25170":58965,"_17548":99794,"_5":17443,"_23820":99658,"_2384":44771},[],{"_2857":59013,"_25170":58965,"_17548":99796,"_5":17443,"_23820":99658,"_2384":99797},[],"Crear y adjuntar políticas IoT",{"_2857":59014,"_25170":58965,"_17548":99799,"_5":17443,"_23820":99658,"_2384":44777},[],{"_2857":59015,"_25170":58965,"_17548":99801,"_5":17443,"_23820":99658,"_2384":99802},[],"Gestionar grupos de Things",{"_2857":59016,"_25170":58965,"_17548":99804,"_5":17443,"_23820":99658,"_2384":44783},[],{"_2857":59017,"_25170":58965,"_17548":99806,"_5":17443,"_23820":99658,"_2384":99807},[],"Crear plantillas JITP",{"_2857":59018,"_25170":58965,"_17548":99809,"_5":17443,"_23820":99658,"_2384":44789},[],{"_2857":59019,"_25170":58965,"_17548":99811,"_5":17443,"_23820":99658,"_2384":99812},[],"Leer y escribir el Device Shadow",{"_2857":59020,"_25170":58965,"_17548":99814,"_5":17443,"_23820":99658,"_2384":99815},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2857":59021,"_25170":58965,"_17548":99817,"_5":17443,"_23820":99662,"_2384":99818},[],"Parámetro",{"_2857":59022,"_25170":58965,"_17548":99820,"_5":17443,"_23820":99662,"_2384":99821},[],"Tipo",{"_2857":59023,"_25170":58965,"_17548":99823,"_5":17443,"_23820":99662,"_2384":99824},[],"Requerido",{"_2857":59024,"_25170":58965,"_17548":99826,"_5":17443,"_23820":99662,"_2384":99827},[],"Descripción",{"_2857":59025,"_25170":58965,"_17548":99829,"_5":17443,"_23820":99662,"_2384":44810},[],{"_2857":59026,"_25170":58965,"_17548":99831,"_5":17443,"_23820":99662,"_2384":20963},[],{"_2857":59027,"_25170":58965,"_17548":99833,"_5":17443,"_23820":99662,"_2384":99834},[],"Sí",{"_2857":59028,"_25170":58965,"_17548":99836,"_5":17443,"_23820":99662,"_2384":99837},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2857":59029,"_25170":58965,"_17548":99839,"_5":17443,"_23820":99662,"_2384":44821},[],{"_2857":59030,"_25170":58965,"_17548":99841,"_5":17443,"_23820":99662,"_2384":20963},[],{"_2857":59031,"_25170":58965,"_17548":99843,"_5":17443,"_23820":99662,"_2384":99834},[],{"_2857":59032,"_25170":58965,"_17548":99845,"_5":17443,"_23820":99662,"_2384":99846},[],"Región AWS donde opera el conector.",{"_2857":59033,"_25170":58965,"_17548":99848,"_5":17443,"_23820":99662,"_2384":44831},[],{"_2857":59034,"_25170":58965,"_17548":99850,"_5":17443,"_23820":99662,"_2384":20963},[],{"_2857":59035,"_25170":58965,"_17548":99852,"_5":17443,"_23820":99662,"_2384":99834},[],{"_2857":59036,"_25170":58965,"_17548":99854,"_5":17443,"_23820":99662,"_2384":99855},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2857":59037,"_25170":58965,"_17548":99857,"_5":17443,"_23820":99662,"_2384":44841},[],{"_2857":59038,"_25170":58965,"_17548":99859,"_5":17443,"_23820":99662,"_2384":20963},[],{"_2857":59039,"_25170":58965,"_17548":99861,"_5":17443,"_23820":99662,"_2384":99862},[],"Solo con `auth_method=static`",{"_2857":59040,"_25170":58965,"_17548":99864,"_5":17443,"_23820":99662,"_2384":99865},[],"Clave de acceso AWS.",{"_2857":59041,"_25170":58965,"_17548":99867,"_5":17443,"_23820":99662,"_2384":44852},[],{"_2857":59042,"_25170":58965,"_17548":99869,"_5":17443,"_23820":99662,"_2384":20963},[],{"_2857":59043,"_25170":58965,"_17548":99871,"_5":17443,"_23820":99662,"_2384":99862},[],{"_2857":59044,"_25170":58965,"_17548":99873,"_5":17443,"_23820":99662,"_2384":99874},[],"Clave secreta AWS.",{"_2857":59045,"_25170":58965,"_17548":99876,"_5":17443,"_23820":99662,"_2384":44862},[],{"_2857":59046,"_25170":58965,"_17548":99878,"_5":17443,"_23820":99662,"_2384":20963},[],{"_2857":59047,"_25170":58965,"_17548":99880,"_5":17443,"_23820":99662,"_2384":44867},[],{"_2857":59048,"_25170":58965,"_17548":99882,"_5":17443,"_23820":99662,"_2384":99883},[],"Token de sesión (con `auth_method=static`).",{"_2857":59049,"_25170":58965,"_17548":99885,"_5":17443,"_23820":99662,"_2384":44873},[],{"_2857":59050,"_25170":58965,"_17548":99887,"_5":17443,"_23820":99662,"_2384":20963},[],{"_2857":59051,"_25170":58965,"_17548":99889,"_5":17443,"_23820":99662,"_2384":99890},[],"Solo con `auth_method=role`",{"_2857":59052,"_25170":58965,"_17548":99892,"_5":17443,"_23820":99662,"_2384":99893},[],"ARN del rol a asumir.",{"_2857":59053,"_25170":58965,"_17548":99895,"_5":17443,"_23820":99662,"_2384":44884},[],{"_2857":59054,"_25170":58965,"_17548":99897,"_5":17443,"_23820":99662,"_2384":20963},[],{"_2857":59055,"_25170":58965,"_17548":99899,"_5":17443,"_23820":99662,"_2384":44867},[],{"_2857":59056,"_25170":58965,"_17548":99901,"_5":17443,"_23820":99662,"_2384":99902},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2857":59057,"_25170":58965,"_17548":99904,"_5":17443,"_23820":99662,"_2384":44894},[],{"_2857":59058,"_25170":58965,"_17548":99906,"_5":17443,"_23820":99662,"_2384":14719},[],{"_2857":59059,"_25170":58965,"_17548":99908,"_5":17443,"_23820":99662,"_2384":99834},[],{"_2857":59060,"_25170":58965,"_17548":99910,"_5":17443,"_23820":99662,"_2384":99911},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2857":59061,"_25170":58965,"_17548":99913,"_5":17443,"_23820":99662,"_2384":44904},[],{"_2857":59062,"_25170":58965,"_17548":99915,"_5":17443,"_23820":99662,"_2384":20963},[],{"_2857":59063,"_25170":58965,"_17548":99917,"_5":17443,"_23820":99662,"_2384":99834},[],{"_2857":59064,"_25170":58965,"_17548":99919,"_5":17443,"_23820":99662,"_2384":99920},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2857":59065,"_25170":58965,"_17548":99922,"_5":17443,"_23820":99662,"_2384":44914},[],{"_2857":59066,"_25170":58965,"_17548":99924,"_5":17443,"_23820":99662,"_2384":20963},[],{"_2857":59067,"_25170":58965,"_17548":99926,"_5":17443,"_23820":99662,"_2384":99834},[],{"_2857":59068,"_25170":58965,"_17548":99928,"_5":17443,"_23820":99662,"_2384":99929},[],"URL HTTP del Device Manager de Lamassu.",{"_2857":59069,"_25170":58965,"_17548":99931,"_5":17443,"_23820":99662,"_2384":44924},[],{"_2857":59070,"_25170":58965,"_17548":99933,"_5":17443,"_23820":99662,"_2384":20963},[],{"_2857":59071,"_25170":58965,"_17548":99935,"_5":17443,"_23820":99662,"_2384":99834},[],{"_2857":59072,"_25170":58965,"_17548":99937,"_5":17443,"_23820":99662,"_2384":99938},[],"URL HTTP del servicio de CA de Lamassu.",{"_2857":59073,"_25170":58965,"_17548":99940,"_5":17443,"_23820":99666,"_2384":99941},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2857":59074,"_25170":58965,"_17548":99943,"_5":17443,"_23820":99670,"_2384":99944},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2857":59075,"_25170":58965,"_17548":99946,"_5":17443,"_23820":99670,"_2384":99947},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2857":59076,"_25170":58965,"_17548":99949,"_5":17443,"_23820":99674,"_2384":99950},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2857":59077,"_25170":58965,"_17548":99952,"_5":17443,"_23820":99674,"_2384":99953},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2857":59078,"_25170":58965,"_17548":99955,"_5":17443,"_23820":99674,"_2384":99956},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2857":59079,"_25170":58965,"_17548":99958,"_5":17443,"_23820":99674,"_2384":99959},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2857":59080,"_25170":58965,"_17548":99961,"_5":17443,"_23820":99674,"_2384":99962},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2857":59081,"_25170":58965,"_17548":99964,"_5":17443,"_23820":99674,"_2384":99965},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2857":59082,"_25170":58965,"_17548":99967,"_5":17443,"_23820":99677,"_2384":99968},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2857":59083,"_25170":58965,"_17548":99970,"_5":17443,"_23820":99680,"_2384":99971},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2857":59084,"_25170":58965,"_17548":99973,"_5":17443,"_23820":99680,"_2384":99974},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2857":59085,"_25170":58965,"_17548":99976,"_5":17443,"_23820":99684,"_2384":99977},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2857":59086,"_25170":58965,"_17548":99979,"_5":17443,"_23820":99688,"_2384":99980},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2857":59087,"_25170":58965,"_17548":99982,"_5":17443,"_23820":99688,"_2384":99983},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2857":59088,"_25170":58965,"_17548":99985,"_5":17443,"_23820":99688,"_2384":99986},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2857":59089,"_25170":58965,"_17548":99988,"_5":17443,"_23820":99688,"_2384":99989},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2857":59090,"_25170":58965,"_17548":99991,"_5":17443,"_23820":99688,"_2384":99992},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2857":59091,"_25170":58965,"_17548":99994,"_5":17443,"_23820":99688,"_2384":99995},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2857":59092,"_25170":58965,"_17548":99997,"_5":17443,"_23820":99692,"_2384":99998},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2857":59093,"_25170":58965,"_17548":100000,"_5":17443,"_23820":99692,"_2384":100001},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2857":59094,"_25170":58965,"_17548":100003,"_5":17443,"_23820":99692,"_2384":100004},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2857":59095,"_25170":58965,"_17548":100006,"_5":17443,"_23820":99696,"_2384":100007},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2857":59096,"_25170":58965,"_17548":100009,"_5":17443,"_23820":99696,"_2384":100010},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2857":59097,"_25170":58965,"_17548":100012,"_5":17443,"_23820":99696,"_2384":100013},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2857":59098,"_25170":58965,"_17548":100015,"_5":17443,"_23820":99700,"_2384":100016},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2857":59099,"_25170":58965,"_17548":100018,"_5":17443,"_23820":99700,"_2384":100019},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2857":59100,"_25170":58965,"_17548":100021,"_5":17443,"_23820":99700,"_2384":100022},[],"Para que el flujo JITP funcione correctamente:",{"_2857":59101,"_25170":58965,"_17548":100024,"_5":17443,"_23820":99700,"_2384":100025},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2857":59102,"_25170":58965,"_17548":100027,"_5":17443,"_23820":99700,"_2384":100028},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2857":59103,"_25170":58965,"_17548":100030,"_5":17443,"_23820":99700,"_2384":100031},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2857":59104,"_25170":58965,"_17548":100033,"_5":17443,"_23820":99700,"_2384":100034},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2857":59105,"_25170":58965,"_17548":100036,"_5":17443,"_23820":99704,"_2384":100037},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2857":59106,"_25170":58965,"_17548":100039,"_5":17443,"_23820":99704,"_2384":100040},[],"Estado en Lamassu",{"_2857":59107,"_25170":58965,"_17548":100042,"_5":17443,"_23820":99704,"_2384":100043},[],"Razón de revocación",{"_2857":59108,"_25170":58965,"_17548":100045,"_5":17443,"_23820":99704,"_2384":100046},[],"Estado en AWS IoT Core",{"_2857":59109,"_25170":58965,"_17548":100048,"_5":17443,"_23820":99704,"_2384":45045},[],{"_2857":59110,"_25170":58965,"_17548":100050,"_5":17443,"_23820":99704,"_2384":100051},[],"Ninguna",{"_2857":59111,"_25170":58965,"_17548":100053,"_5":17443,"_23820":99704,"_2384":45051},[],{"_2857":59112,"_25170":58965,"_17548":100055,"_5":17443,"_23820":99704,"_2384":45054},[],{"_2857":59113,"_25170":58965,"_17548":100057,"_5":17443,"_23820":99704,"_2384":45057},[],{"_2857":59114,"_25170":58965,"_17548":100059,"_5":17443,"_23820":99704,"_2384":45060},[],{"_2857":59115,"_25170":58965,"_17548":100061,"_5":17443,"_23820":99704,"_2384":45054},[],{"_2857":59116,"_25170":58965,"_17548":100063,"_5":17443,"_23820":99704,"_2384":100064},[],"Cualquier otra razón",{"_2857":59117,"_25170":58965,"_17548":100066,"_5":17443,"_23820":99704,"_2384":45068},[],{"_2857":59118,"_25170":58965,"_17548":100068,"_5":17443,"_23820":99704,"_2384":100069},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2857":59119,"_25170":58965,"_17548":100071,"_5":17443,"_23820":99708,"_2384":100072},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2857":59120,"_25170":58965,"_17548":100074,"_5":17443,"_23820":99708,"_2384":100075},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2857":59121,"_25170":58965,"_17548":100077,"_5":17443,"_23820":99708,"_2384":100078},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2857":59122,"_25170":58965,"_17548":100080,"_5":17443,"_23820":99712,"_2384":100081},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2857":59123,"_25170":58965,"_17548":100083,"_5":17443,"_23820":99712,"_2384":100084},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2857":59124,"_25170":58965,"_17548":100086,"_5":17443,"_23820":99716,"_2384":100087},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2857":59125,"_25170":58965,"_17548":100089,"_5":17443,"_23820":99716,"_2384":100090},[],"Existen dos tipos de acciones:",{"_2857":59126,"_25170":58965,"_17548":100092,"_5":17443,"_23820":99716,"_2384":100093},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2857":59127,"_25170":58965,"_17548":100095,"_5":17443,"_23820":99716,"_2384":100096},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2857":59128,"_25170":58965,"_17548":100098,"_5":17443,"_23820":99716,"_2384":100099},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2857":59129,"_25170":58965,"_17548":100101,"_5":17443,"_23820":99720,"_2384":100102},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2857":59130,"_25170":58965,"_17548":100104,"_5":17443,"_23820":99720,"_2384":100105},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2857":59131,"_25170":58965,"_17548":100107,"_5":17443,"_23820":99720,"_2384":100108},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2857":59132,"_25170":58965,"_17548":100110,"_5":17443,"_23820":99724,"_2384":100111},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2857":59133,"_25170":58965,"_17548":100113,"_5":17443,"_23820":99724,"_2384":100114},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2857":59134,"_25170":58965,"_17548":100116,"_5":17443,"_23820":99724,"_2384":100117},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2857":59135,"_25170":58965,"_17548":100119,"_5":17443,"_23820":99724,"_2384":100120},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2857":59136,"_25170":58965,"_17548":100122,"_5":17443,"_23820":99724,"_2384":100123},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2857":59137,"_25170":58965,"_17548":100125,"_5":17443,"_23820":99724,"_2384":100126},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2857":59138,"_25170":58965,"_17548":100128,"_5":17443,"_23820":99724,"_2384":100129},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2857":59139,"_25170":58965,"_17548":100131,"_5":17443,"_23820":99724,"_2384":100132},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2857":59140,"_25170":58965,"_17548":100134,"_5":17443,"_23820":99724,"_2384":100135},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2857":59141,"_25170":58965,"_17548":100137,"_5":17443,"_23820":99724,"_2384":100138},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2857":59142,"_25170":58965,"_17548":100140,"_5":17443,"_23820":99724,"_2384":100141},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2857":59143,"_25170":58965,"_17548":100143,"_5":17443,"_23820":99724,"_2384":100144},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2857":59144,"_25170":58965,"_17548":100146,"_5":17443,"_23820":99724,"_2384":100147},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2857":59145,"_25170":58965,"_17548":100149,"_5":17443,"_23820":99724,"_2384":100150},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2857":59146,"_25170":58965,"_17548":100152,"_5":17443,"_23820":99724,"_2384":100153},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2857":59147,"_25170":58965,"_17548":100155,"_5":17443,"_23820":99724,"_2384":100156},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2857":59148,"_25170":58965,"_17548":100158,"_5":17443,"_23820":99724,"_2384":100159},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2857":59149,"_25170":58965,"_17548":100161,"_5":17443,"_23820":99724,"_2384":100162},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2857":59150,"_25170":58965,"_17548":100164,"_5":17443,"_23820":99724,"_2384":100165},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":59151,"_25170":58965,"_17548":100167,"_5":17443,"_23820":99724,"_2384":100168},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2857":59152,"_25170":58965,"_17548":100170,"_5":17443,"_23820":99724,"_2384":100171},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2857":59153,"_25170":59153,"_5":12294,"_2384":43166,"_25506":100173,"_17548":100174,"_23820":59153},[40848,97279,43166],[],{"_2857":59154,"_25170":59153,"_17548":100176,"_5":17443,"_23820":59153,"_2384":100177},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2857":59155,"_25170":59153,"_5":25503,"_17548":100179,"_23820":100180,"_2384":100181},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2857":59156,"_25170":59153,"_5":25503,"_17548":100183,"_23820":100184,"_2384":98251},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2857":59157,"_25170":59153,"_5":25503,"_17548":100186,"_23820":100187,"_2384":98426},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2857":59158,"_25170":59153,"_5":25503,"_17548":100189,"_23820":100190,"_2384":99643},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/overview#integraciones",{"_2857":59159,"_25170":59153,"_5":25503,"_17548":100192,"_23820":100193,"_2384":100194},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2857":59160,"_25170":59153,"_17548":100196,"_5":17443,"_23820":59153,"_2384":100197},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2857":59161,"_25170":59153,"_17548":100199,"_5":17443,"_23820":100180,"_2384":100200},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2857":59162,"_25170":59153,"_17548":100202,"_5":17443,"_23820":100180,"_2384":100203},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2857":59163,"_25170":59153,"_17548":100205,"_5":17443,"_23820":100184,"_2384":100206},[],"Recurso",{"_2857":59164,"_25170":59153,"_17548":100208,"_5":17443,"_23820":100184,"_2384":100209},[],"Qué representa",{"_2857":59165,"_25170":59153,"_17548":100211,"_5":17443,"_23820":100184,"_2384":100212},[],"**Dispositivo**",{"_2857":59166,"_25170":59153,"_17548":100214,"_5":17443,"_23820":100184,"_2384":100215},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2857":59167,"_25170":59153,"_17548":100217,"_5":17443,"_23820":100184,"_2384":100218},[],"**Identidad**",{"_2857":59168,"_25170":59153,"_17548":100220,"_5":17443,"_23820":100184,"_2384":100221},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2857":59169,"_25170":59153,"_17548":100223,"_5":17443,"_23820":100184,"_2384":45226},[],{"_2857":59170,"_25170":59153,"_17548":100225,"_5":17443,"_23820":100184,"_2384":100226},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2857":59171,"_25170":59153,"_17548":100228,"_5":17443,"_23820":100184,"_2384":100229},[],"**Flota**",{"_2857":59172,"_25170":59153,"_17548":100231,"_5":17443,"_23820":100184,"_2384":100232},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2857":59173,"_25170":59153,"_17548":100234,"_5":17443,"_23820":100184,"_2384":100235},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2857":59174,"_25170":59153,"_17548":100237,"_5":17443,"_23820":100184,"_2384":100238},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2857":59175,"_25170":59153,"_17548":100240,"_5":17443,"_23820":100187,"_2384":100241},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2857":59176,"_25170":59153,"_17548":100243,"_5":17443,"_23820":100187,"_2384":100244},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2857":59177,"_25170":59153,"_17548":100246,"_5":17443,"_23820":100187,"_2384":100247},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2857":59178,"_25170":59153,"_17548":100249,"_5":17443,"_23820":100187,"_2384":100250},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2857":59179,"_25170":59153,"_17548":100252,"_5":17443,"_23820":100187,"_2384":100253},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2857":59180,"_25170":59153,"_17548":100255,"_5":17443,"_23820":100187,"_2384":100256},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2857":59181,"_25170":59153,"_17548":100258,"_5":17443,"_23820":100187,"_2384":100259},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":59182,"_25170":59153,"_17548":100261,"_5":17443,"_23820":100187,"_2384":100262},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2857":59183,"_25170":59153,"_17548":100264,"_5":17443,"_23820":100190,"_2384":100265},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2857":59184,"_25170":59153,"_17548":100267,"_5":17443,"_23820":100190,"_2384":100268},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2857":59185,"_25170":59153,"_17548":100270,"_5":17443,"_23820":100193,"_2384":100271},[],"Participante",{"_2857":59186,"_25170":59153,"_17548":100273,"_5":17443,"_23820":100193,"_2384":100274},[],"Responsabilidad",{"_2857":59187,"_25170":59153,"_17548":100276,"_5":17443,"_23820":100193,"_2384":100277},[],"Administrador PKI",{"_2857":59188,"_25170":59153,"_17548":100279,"_5":17443,"_23820":100193,"_2384":100280},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2857":59189,"_25170":59153,"_17548":100282,"_5":17443,"_23820":100193,"_2384":100283},[],"Administrador del aprovisionamiento",{"_2857":59190,"_25170":59153,"_17548":100285,"_5":17443,"_23820":100193,"_2384":100286},[],"DMS, admisión, autenticación por operación e inventario.",{"_2857":59191,"_25170":59153,"_17548":100288,"_5":17443,"_23820":100193,"_2384":100289},[],"Integrador del dispositivo",{"_2857":59192,"_25170":59153,"_17548":100291,"_5":17443,"_23820":100193,"_2384":100292},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2857":59193,"_25170":59153,"_17548":100294,"_5":17443,"_23820":100193,"_2384":100295},[],"Integrador del consumidor",{"_2857":59194,"_25170":59153,"_17548":100297,"_5":17443,"_23820":100193,"_2384":100298},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2857":59195,"_25170":59153,"_17548":100300,"_5":17443,"_23820":100193,"_2384":100301},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2857":59196,"_25170":59196,"_5":12294,"_2384":100303,"_25506":100304,"_17548":100306,"_23820":59196},"Enrola y conecta tu primer dispositivo",[40848,97279,43166,100305],"Primeros pasos",[],{"_2857":59197,"_25170":59196,"_17548":100308,"_5":17443,"_23820":59196,"_2384":100309},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2857":59198,"_25170":59196,"_5":25503,"_17548":100311,"_23820":100312,"_2384":95980},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2857":59199,"_25170":59196,"_5":25503,"_17548":100314,"_23820":100315,"_2384":100316},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2857":59200,"_25170":59196,"_5":25503,"_17548":100318,"_23820":100319,"_2384":100320},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2857":59201,"_25170":59196,"_5":25503,"_17548":100322,"_23820":100323,"_2384":100324},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2857":59202,"_25170":59196,"_5":25503,"_17548":100326,"_23820":100327,"_2384":100328},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2857":59203,"_25170":59196,"_5":25503,"_17548":100330,"_23820":100331,"_2384":100332},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2857":59204,"_25170":59196,"_5":25503,"_17548":100334,"_23820":100335,"_2384":100336},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2857":59205,"_25170":59196,"_5":25503,"_17548":100338,"_23820":100339,"_2384":100340},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2857":59206,"_25170":59196,"_17548":100342,"_5":17443,"_23820":59196,"_2384":100343},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2857":59207,"_25170":59196,"_17548":100345,"_5":17443,"_23820":100312,"_2384":100346},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2857":59208,"_25170":59196,"_17548":100348,"_5":17443,"_23820":100312,"_2384":100349},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2857":59209,"_25170":59196,"_17548":100351,"_5":17443,"_23820":100312,"_2384":100352},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2857":59210,"_25170":59196,"_17548":100354,"_5":17443,"_23820":100312,"_2384":100355},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2857":59211,"_25170":59196,"_17548":100357,"_5":17443,"_23820":100312,"_2384":100358},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2857":59212,"_25170":59196,"_17548":100360,"_5":17443,"_23820":100315,"_2384":100361},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2857":59213,"_25170":59196,"_17548":100363,"_5":17443,"_23820":100315,"_2384":100364},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2857":59214,"_25170":59196,"_17548":100366,"_5":17443,"_23820":100319,"_2384":100367},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2857":59215,"_25170":59196,"_17548":100369,"_5":17443,"_23820":100319,"_2384":100370},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2857":59216,"_25170":59196,"_17548":100372,"_5":17443,"_23820":100319,"_2384":100373},[],"Ajuste",{"_2857":59217,"_25170":59196,"_17548":100375,"_5":17443,"_23820":100319,"_2384":100376},[],"Valor de evaluación",{"_2857":59218,"_25170":59196,"_17548":100378,"_5":17443,"_23820":100319,"_2384":45382},[],{"_2857":59219,"_25170":59196,"_17548":100380,"_5":17443,"_23820":100319,"_2384":100381},[],"Raíz emisora de `device-root.pem`.",{"_2857":59220,"_25170":59196,"_17548":100383,"_5":17443,"_23820":100319,"_2384":98554},[],{"_2857":59221,"_25170":59196,"_17548":100385,"_5":17443,"_23820":100319,"_2384":100386},[],"Perfil final de 1 hora que acabas de preparar.",{"_2857":59222,"_25170":59196,"_17548":100388,"_5":17443,"_23820":100319,"_2384":45393},[],{"_2857":59223,"_25170":59196,"_17548":100390,"_5":17443,"_23820":100319,"_2384":45396},[],{"_2857":59224,"_25170":59196,"_17548":100392,"_5":17443,"_23820":100319,"_2384":45399},[],{"_2857":59225,"_25170":59196,"_17548":100394,"_5":17443,"_23820":100319,"_2384":100395},[],"Habilitado.",{"_2857":59226,"_25170":59196,"_17548":100397,"_5":17443,"_23820":100319,"_2384":45405},[],{"_2857":59227,"_25170":59196,"_17548":100399,"_5":17443,"_23820":100319,"_2384":100400},[],"Deshabilitado; el ID debe ser nuevo.",{"_2857":59228,"_25170":59196,"_17548":100402,"_5":17443,"_23820":100319,"_2384":100403},[],"Autenticación inicial",{"_2857":59229,"_25170":59196,"_17548":100405,"_5":17443,"_23820":100319,"_2384":100406},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2857":59230,"_25170":59196,"_17548":100408,"_5":17443,"_23820":100319,"_2384":100409},[],"Autenticación de renovación",{"_2857":59231,"_25170":59196,"_17548":100411,"_5":17443,"_23820":100319,"_2384":100412},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2857":59232,"_25170":59196,"_17548":100414,"_5":17443,"_23820":100319,"_2384":45423},[],{"_2857":59233,"_25170":59196,"_17548":100416,"_5":17443,"_23820":100319,"_2384":100417},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2857":59234,"_25170":59196,"_17548":100419,"_5":17443,"_23820":100319,"_2384":45429},[],{"_2857":59235,"_25170":59196,"_17548":100421,"_5":17443,"_23820":100319,"_2384":100422},[],"1 hora.",{"_2857":59236,"_25170":59196,"_17548":100424,"_5":17443,"_23820":100319,"_2384":45435},[],{"_2857":59237,"_25170":59196,"_17548":100426,"_5":17443,"_23820":100319,"_2384":100427},[],"30 minutos / 10 minutos.",{"_2857":59238,"_25170":59196,"_17548":100429,"_5":17443,"_23820":100319,"_2384":45441},[],{"_2857":59239,"_25170":59196,"_17548":100431,"_5":17443,"_23820":100319,"_2384":100432},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2857":59240,"_25170":59196,"_17548":100434,"_5":17443,"_23820":100319,"_2384":43485},[],{"_2857":59241,"_25170":59196,"_17548":100436,"_5":17443,"_23820":100319,"_2384":100437},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2857":59242,"_25170":59196,"_17548":100439,"_5":17443,"_23820":100319,"_2384":45452},[],{"_2857":59243,"_25170":59196,"_17548":100441,"_5":17443,"_23820":100319,"_2384":100442},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2857":59244,"_25170":59196,"_17548":100444,"_5":17443,"_23820":100319,"_2384":100445},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2857":59245,"_25170":59196,"_17548":100447,"_5":17443,"_23820":100323,"_2384":100448},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2857":59246,"_25170":59196,"_17548":100450,"_5":17443,"_23820":100323,"_2384":100451},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2857":59247,"_25170":59196,"_17548":100453,"_5":17443,"_23820":100327,"_2384":100454},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2857":59248,"_25170":59196,"_17548":100456,"_5":17443,"_23820":100327,"_2384":100457},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2857":59249,"_25170":59196,"_17548":100459,"_5":17443,"_23820":100327,"_2384":100460},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2857":59250,"_25170":59196,"_17548":100462,"_5":17443,"_23820":100331,"_2384":100463},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2857":59251,"_25170":59196,"_17548":100465,"_5":17443,"_23820":100331,"_2384":100466},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2857":59252,"_25170":59196,"_17548":100468,"_5":17443,"_23820":100335,"_2384":100469},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2857":59253,"_25170":59196,"_17548":100471,"_5":17443,"_23820":100335,"_2384":100472},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2857":59254,"_25170":59196,"_17548":100474,"_5":17443,"_23820":100335,"_2384":100475},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2857":59255,"_25170":59196,"_17548":100477,"_5":17443,"_23820":100335,"_2384":100478},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2857":59256,"_25170":59196,"_17548":100480,"_5":17443,"_23820":100335,"_2384":100481},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2857":59257,"_25170":59196,"_17548":100483,"_5":17443,"_23820":100339,"_2384":100484},[],"Comprobación",{"_2857":59258,"_25170":59196,"_17548":100486,"_5":17443,"_23820":100339,"_2384":100487},[],"Resultado esperado",{"_2857":59259,"_25170":59196,"_17548":100489,"_5":17443,"_23820":100339,"_2384":100490},[],"Registro",{"_2857":59260,"_25170":59196,"_17548":100492,"_5":17443,"_23820":100339,"_2384":100493},[],"ID creado automáticamente y DMS correcto.",{"_2857":59261,"_25170":59196,"_17548":100495,"_5":17443,"_23820":100339,"_2384":100496},[],"Certificado",{"_2857":59262,"_25170":59196,"_17548":100498,"_5":17443,"_23820":100339,"_2384":100499},[],"CN, perfil, serie y clave verificados.",{"_2857":59263,"_25170":59196,"_17548":100501,"_5":17443,"_23820":100339,"_2384":100502},[],"Inventario",{"_2857":59264,"_25170":59196,"_17548":100504,"_5":17443,"_23820":100339,"_2384":100505},[],"Serie recibida visible como identidad actual y en el historial.",{"_2857":59265,"_25170":59196,"_17548":100507,"_5":17443,"_23820":100339,"_2384":100508},[],"Consumidor",{"_2857":59266,"_25170":59196,"_17548":100510,"_5":17443,"_23820":100339,"_2384":100511},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2857":59267,"_25170":59196,"_17548":100513,"_5":17443,"_23820":100339,"_2384":100514},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2857":59268,"_25170":59196,"_17548":100516,"_5":17443,"_23820":100339,"_2384":100517},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2857":59269,"_25170":59269,"_5":12294,"_2384":98268,"_25506":100519,"_17548":100520,"_23820":59269},[40848,97279,43166,100305],[],{"_2857":59270,"_25170":59269,"_17548":100522,"_5":17443,"_23820":59269,"_2384":100523},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2857":59271,"_25170":59269,"_5":25503,"_17548":100525,"_23820":100526,"_2384":95980},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2857":59272,"_25170":59269,"_5":25503,"_17548":100528,"_23820":100529,"_2384":100530},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2857":59273,"_25170":59269,"_5":25503,"_17548":100532,"_23820":100533,"_2384":100534},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2857":59274,"_25170":59269,"_5":25503,"_17548":100536,"_23820":100537,"_2384":100538},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2857":59275,"_25170":59269,"_5":25503,"_17548":100540,"_23820":100541,"_2384":100542},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2857":59276,"_25170":59269,"_5":25503,"_17548":100544,"_23820":100545,"_2384":100546},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2857":59277,"_25170":59269,"_5":25503,"_17548":100548,"_23820":100549,"_2384":100487},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2857":59278,"_25170":59269,"_5":25503,"_17548":100551,"_23820":100552,"_2384":100553},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2857":59279,"_25170":59269,"_5":25503,"_17548":100555,"_23820":100556,"_2384":100557},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2857":59280,"_25170":59269,"_17548":100559,"_5":17443,"_23820":59269,"_2384":100560},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2857":59281,"_25170":59269,"_17548":100562,"_5":17443,"_23820":59269,"_2384":100563},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2857":59282,"_25170":59269,"_17548":100565,"_5":17443,"_23820":100526,"_2384":100566},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2857":59283,"_25170":59269,"_17548":100568,"_5":17443,"_23820":100526,"_2384":100569},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2857":59284,"_25170":59269,"_17548":100571,"_5":17443,"_23820":100526,"_2384":100572},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2857":59285,"_25170":59269,"_17548":100574,"_5":17443,"_23820":100526,"_2384":100575},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2857":59286,"_25170":59269,"_17548":100577,"_5":17443,"_23820":100529,"_2384":100578},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2857":59287,"_25170":59269,"_17548":100580,"_5":17443,"_23820":100529,"_2384":100581},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2857":59288,"_25170":59269,"_17548":100583,"_5":17443,"_23820":100529,"_2384":100584},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2857":59289,"_25170":59269,"_17548":100586,"_5":17443,"_23820":100529,"_2384":100587},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2857":59290,"_25170":59269,"_17548":100589,"_5":17443,"_23820":100529,"_2384":100590},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2857":59291,"_25170":59269,"_17548":100592,"_5":17443,"_23820":100529,"_2384":100593},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2857":59292,"_25170":59269,"_17548":100595,"_5":17443,"_23820":100529,"_2384":100596},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2857":59293,"_25170":59269,"_17548":100598,"_5":17443,"_23820":100529,"_2384":100599},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2857":59294,"_25170":59269,"_17548":100601,"_5":17443,"_23820":100533,"_2384":100602},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2857":59295,"_25170":59269,"_17548":100604,"_5":17443,"_23820":100533,"_2384":45618},[],{"_2857":59296,"_25170":59269,"_17548":100606,"_5":17443,"_23820":100533,"_2384":100607},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2857":59297,"_25170":59269,"_17548":100609,"_5":17443,"_23820":100533,"_2384":100610},[],"**Icon** y **Tags**: clasificación opcional.",{"_2857":59298,"_25170":59269,"_17548":100612,"_5":17443,"_23820":100533,"_2384":100613},[],"Confirma el registro.",{"_2857":59299,"_25170":59269,"_17548":100615,"_5":17443,"_23820":100537,"_2384":100616},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2857":59300,"_25170":59269,"_17548":100618,"_5":17443,"_23820":100537,"_2384":100619},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2857":59301,"_25170":59269,"_17548":100621,"_5":17443,"_23820":100541,"_2384":100622},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2857":59302,"_25170":59269,"_17548":100624,"_5":17443,"_23820":100541,"_2384":100625},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2857":59303,"_25170":59269,"_17548":100627,"_5":17443,"_23820":100545,"_2384":100628},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2857":59304,"_25170":59269,"_17548":100630,"_5":17443,"_23820":100545,"_2384":100631},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2857":59305,"_25170":59269,"_17548":100633,"_5":17443,"_23820":100549,"_2384":100484},[],{"_2857":59306,"_25170":59269,"_17548":100635,"_5":17443,"_23820":100549,"_2384":100636},[],"Resultado",{"_2857":59307,"_25170":59269,"_17548":100638,"_5":17443,"_23820":100549,"_2384":100639},[],"Dispositivo",{"_2857":59308,"_25170":59269,"_17548":100641,"_5":17443,"_23820":100549,"_2384":100642},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2857":59309,"_25170":59269,"_17548":100644,"_5":17443,"_23820":100549,"_2384":100645},[],"Identidad actual",{"_2857":59310,"_25170":59269,"_17548":100647,"_5":17443,"_23820":100549,"_2384":100648},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2857":59311,"_25170":59269,"_17548":100650,"_5":17443,"_23820":100549,"_2384":100651},[],"Historial",{"_2857":59312,"_25170":59269,"_17548":100653,"_5":17443,"_23820":100549,"_2384":100654},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2857":59313,"_25170":59269,"_17548":100656,"_5":17443,"_23820":100549,"_2384":100657},[],"Clave y certificado",{"_2857":59314,"_25170":59269,"_17548":100659,"_5":17443,"_23820":100549,"_2384":100660},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2857":59315,"_25170":59269,"_17548":100662,"_5":17443,"_23820":100552,"_2384":100663},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2857":59316,"_25170":59269,"_17548":100665,"_5":17443,"_23820":100552,"_2384":100666},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2857":59317,"_25170":59269,"_17548":100668,"_5":17443,"_23820":100552,"_2384":100669},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2857":59318,"_25170":59269,"_17548":100671,"_5":17443,"_23820":100552,"_2384":100672},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2857":59319,"_25170":59269,"_17548":100674,"_5":17443,"_23820":100556,"_2384":100675},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2857":59320,"_25170":59269,"_17548":100677,"_5":17443,"_23820":100556,"_2384":100678},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2857":59321,"_25170":59269,"_17548":100680,"_5":17443,"_23820":100556,"_2384":100681},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2857":59322,"_25170":59322,"_5":12294,"_2384":100683,"_25506":100684,"_17548":100685,"_23820":59322},"Plataforma Lamassu IoT",[40848,97279],[],{"_2857":59323,"_25170":59322,"_17548":100687,"_5":17443,"_23820":59322,"_2384":100688},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2857":59324,"_25170":59322,"_5":25503,"_17548":100690,"_23820":100691,"_2384":100181},[],"/docs/pr-preview/pr-38/es/platform/overview#empieza-aquí",{"_2857":59325,"_25170":59322,"_5":25503,"_17548":100693,"_23820":100694,"_2384":100695},[],"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2857":59326,"_25170":59322,"_5":25503,"_17548":100697,"_23820":100698,"_2384":100699},[],"/docs/pr-preview/pr-38/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2857":59327,"_25170":59322,"_5":25503,"_17548":100701,"_23820":100702,"_2384":100703},[],"/docs/pr-preview/pr-38/es/platform/overview#capacidades-principales","Capacidades principales",{"_2857":59328,"_25170":59322,"_5":25503,"_17548":100705,"_23820":100706,"_2384":100707},[],"/docs/pr-preview/pr-38/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2857":59329,"_25170":59322,"_5":25503,"_17548":100709,"_23820":100710,"_2384":100711},[],"/docs/pr-preview/pr-38/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2857":59330,"_25170":59322,"_5":25503,"_17548":100713,"_23820":100714,"_2384":100715},[],"/docs/pr-preview/pr-38/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2857":59331,"_25170":59322,"_5":25503,"_17548":100717,"_23820":100718,"_2384":100719},[],"/docs/pr-preview/pr-38/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2857":59332,"_25170":59322,"_5":25503,"_17548":100721,"_23820":100722,"_2384":100723},[],"/docs/pr-preview/pr-38/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2857":59333,"_25170":59322,"_5":25503,"_17548":100725,"_23820":100726,"_2384":100727},[],"/docs/pr-preview/pr-38/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2857":59334,"_25170":59322,"_5":25503,"_17548":100729,"_23820":100730,"_2384":100731},[],"/docs/pr-preview/pr-38/es/platform/overview#referencia-operativa","Referencia operativa",{"_2857":59335,"_25170":59322,"_17548":100733,"_5":17443,"_23820":59322,"_2384":100734},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2857":59336,"_25170":59322,"_17548":100736,"_5":17443,"_23820":100691,"_2384":100737},[],"Elige el resultado que necesitas obtener:",{"_2857":59337,"_25170":59322,"_17548":100739,"_5":17443,"_23820":100691,"_2384":100740},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2857":59338,"_25170":59322,"_17548":100742,"_5":17443,"_23820":100691,"_2384":100743},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2857":59339,"_25170":59322,"_17548":100745,"_5":17443,"_23820":100691,"_2384":100746},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2857":59340,"_25170":59322,"_17548":100748,"_5":17443,"_23820":100694,"_2384":100749},[],"Bloque",{"_2857":59341,"_25170":59322,"_17548":100751,"_5":17443,"_23820":100694,"_2384":100752},[],"Qué gestionas",{"_2857":59342,"_25170":59322,"_17548":100754,"_5":17443,"_23820":100694,"_2384":100755},[],"Punto de entrada",{"_2857":59343,"_25170":59322,"_17548":100757,"_5":17443,"_23820":100694,"_2384":45772},[],{"_2857":59344,"_25170":59322,"_17548":100759,"_5":17443,"_23820":100694,"_2384":100760},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2857":59345,"_25170":59322,"_17548":100762,"_5":17443,"_23820":100694,"_2384":100763},[],"Visión general de PKI",{"_2857":59346,"_25170":59322,"_17548":100765,"_5":17443,"_23820":100694,"_2384":45781},[],{"_2857":59347,"_25170":59322,"_17548":100767,"_5":17443,"_23820":100694,"_2384":100768},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2857":59348,"_25170":59322,"_17548":100770,"_5":17443,"_23820":100694,"_2384":100771},[],"Visión general de IoT Fleets",{"_2857":59349,"_25170":59322,"_17548":100773,"_5":17443,"_23820":100694,"_2384":100774},[],"**Administración**",{"_2857":59350,"_25170":59322,"_17548":100776,"_5":17443,"_23820":100694,"_2384":100777},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2857":59351,"_25170":59322,"_17548":100779,"_5":17443,"_23820":100694,"_2384":97277},[],{"_2857":59352,"_25170":59322,"_17548":100781,"_5":17443,"_23820":100694,"_2384":100782},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2857":59353,"_25170":59322,"_17548":100784,"_5":17443,"_23820":100698,"_2384":100785},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2857":59354,"_25170":59322,"_17548":100787,"_5":17443,"_23820":100698,"_2384":100788},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2857":59355,"_25170":59322,"_17548":100790,"_5":17443,"_23820":100698,"_2384":100791},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2857":59356,"_25170":59322,"_17548":100793,"_5":17443,"_23820":100698,"_2384":100794},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2857":59357,"_25170":59322,"_17548":100796,"_5":17443,"_23820":100698,"_2384":100797},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2857":59358,"_25170":59322,"_17548":100799,"_5":17443,"_23820":100698,"_2384":100800},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2857":59359,"_25170":59322,"_17548":100802,"_5":17443,"_23820":100706,"_2384":100803},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2857":59360,"_25170":59322,"_17548":100805,"_5":17443,"_23820":100710,"_2384":100806},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2857":59361,"_25170":59322,"_17548":100808,"_5":17443,"_23820":100714,"_2384":100809},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2857":59362,"_25170":59322,"_17548":100811,"_5":17443,"_23820":100718,"_2384":100812},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2857":59363,"_25170":59322,"_17548":100814,"_5":17443,"_23820":100722,"_2384":100815},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2857":59364,"_25170":59322,"_17548":100817,"_5":17443,"_23820":100726,"_2384":100818},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2857":59365,"_25170":59322,"_17548":100820,"_5":17443,"_23820":100730,"_2384":100274},[],{"_2857":59366,"_25170":59322,"_17548":100822,"_5":17443,"_23820":100730,"_2384":100823},[],"Qué prepara o comprueba",{"_2857":59367,"_25170":59322,"_17548":100825,"_5":17443,"_23820":100730,"_2384":100277},[],{"_2857":59368,"_25170":59322,"_17548":100827,"_5":17443,"_23820":100730,"_2384":100828},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2857":59369,"_25170":59322,"_17548":100830,"_5":17443,"_23820":100730,"_2384":100831},[],"Administrador de la flota",{"_2857":59370,"_25170":59322,"_17548":100833,"_5":17443,"_23820":100730,"_2384":100834},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2857":59371,"_25170":59322,"_17548":100836,"_5":17443,"_23820":100730,"_2384":100289},[],{"_2857":59372,"_25170":59322,"_17548":100838,"_5":17443,"_23820":100730,"_2384":100839},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2857":59373,"_25170":59322,"_17548":100841,"_5":17443,"_23820":100730,"_2384":100295},[],{"_2857":59374,"_25170":59322,"_17548":100843,"_5":17443,"_23820":100730,"_2384":100844},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2857":59375,"_25170":59322,"_17548":100846,"_5":17443,"_23820":100730,"_2384":100847},[],"Operador de infraestructura",{"_2857":59376,"_25170":59322,"_17548":100849,"_5":17443,"_23820":100730,"_2384":100850},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2857":59377,"_25170":59322,"_17548":100852,"_5":17443,"_23820":100730,"_2384":100853},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2857":59378,"_25170":59378,"_5":12294,"_2384":100855,"_25506":100856,"_17548":100858,"_23820":59378},"Jerarquía y rotación de CAs",[40848,97279,45873,100857],"Claves, autoridades y certificados",[],{"_2857":59379,"_25170":59378,"_17548":100860,"_5":17443,"_23820":59378,"_2384":100861},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2857":59380,"_25170":59378,"_5":25503,"_17548":100863,"_23820":100864,"_2384":100865},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2857":59381,"_25170":59378,"_5":25503,"_17548":100867,"_23820":100868,"_2384":100869},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2857":59382,"_25170":59378,"_5":25503,"_17548":100871,"_23820":100872,"_2384":100873},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2857":59383,"_25170":59378,"_5":25503,"_17548":100875,"_23820":100876,"_2384":100877},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2857":59384,"_25170":59378,"_5":25503,"_17548":100879,"_23820":100880,"_2384":100881},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2857":59385,"_25170":59378,"_5":25503,"_17548":100883,"_23820":100884,"_2384":100885},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2857":59386,"_25170":59378,"_5":25503,"_17548":100887,"_23820":100888,"_2384":100889},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2857":59387,"_25170":59378,"_5":25503,"_17548":100891,"_23820":100892,"_2384":100893},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2857":59388,"_25170":59378,"_5":25503,"_17548":100895,"_23820":100896,"_2384":100897},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2857":59389,"_25170":59378,"_5":25503,"_17548":100899,"_23820":100900,"_2384":100901},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2857":59390,"_25170":59378,"_5":25503,"_17548":100903,"_23820":100904,"_2384":100905},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2857":59391,"_25170":59378,"_5":25503,"_17548":100907,"_23820":100908,"_2384":100909},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2857":59392,"_25170":59378,"_17548":100911,"_5":17443,"_23820":59378,"_2384":100912},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2857":59393,"_25170":59378,"_17548":100914,"_5":17443,"_23820":59378,"_2384":100915},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2857":59394,"_25170":59378,"_17548":100917,"_5":17443,"_23820":100864,"_2384":100918},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2857":59395,"_25170":59378,"_17548":100920,"_5":17443,"_23820":100864,"_2384":100921},[],"entorno, como producción y preproducción;",{"_2857":59396,"_25170":59378,"_17548":100923,"_5":17443,"_23820":100864,"_2384":100924},[],"propietario o equipo operador;",{"_2857":59397,"_25170":59378,"_17548":100926,"_5":17443,"_23820":100864,"_2384":100927},[],"familia de dispositivos o proceso de fabricación;",{"_2857":59398,"_25170":59378,"_17548":100929,"_5":17443,"_23820":100864,"_2384":100930},[],"región o requisito regulatorio;",{"_2857":59399,"_25170":59378,"_17548":100932,"_5":17443,"_23820":100864,"_2384":100933},[],"motor criptográfico o política de clave;",{"_2857":59400,"_25170":59378,"_17548":100935,"_5":17443,"_23820":100864,"_2384":100936},[],"ventana de mantenimiento y ritmo de renovación.",{"_2857":59401,"_25170":59378,"_17548":100938,"_5":17443,"_23820":100864,"_2384":100939},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2857":59402,"_25170":59378,"_17548":100941,"_5":17443,"_23820":100864,"_2384":100942},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2857":59403,"_25170":59378,"_17548":100944,"_5":17443,"_23820":100868,"_2384":100945},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2857":59404,"_25170":59378,"_17548":100947,"_5":17443,"_23820":100868,"_2384":100948},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2857":59405,"_25170":59378,"_17548":100950,"_5":17443,"_23820":100868,"_2384":100951},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2857":59406,"_25170":59378,"_17548":100953,"_5":17443,"_23820":100872,"_2384":100954},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2857":59407,"_25170":59378,"_17548":100956,"_5":17443,"_23820":100872,"_2384":100957},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2857":59408,"_25170":59378,"_17548":100959,"_5":17443,"_23820":100872,"_2384":100960},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2857":59409,"_25170":59378,"_17548":100962,"_5":17443,"_23820":100872,"_2384":100963},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2857":59410,"_25170":59378,"_17548":100965,"_5":17443,"_23820":100880,"_2384":100966},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2857":59411,"_25170":59378,"_17548":100968,"_5":17443,"_23820":100884,"_2384":100969},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2857":59412,"_25170":59378,"_17548":100971,"_5":17443,"_23820":100888,"_2384":100972},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2857":59413,"_25170":59378,"_17548":100974,"_5":17443,"_23820":100892,"_2384":100975},[],"Actualiza la CA de enrolamiento y el perfil de los DMS y añade la CA anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS mientras sigan renovando cohortes con certificados antiguos. La guía DMS documenta ese ajuste.",{"_2857":59414,"_25170":59378,"_17548":100977,"_5":17443,"_23820":100896,"_2384":100978},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2857":59415,"_25170":59378,"_17548":100980,"_5":17443,"_23820":100900,"_2384":100981},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2857":59416,"_25170":59378,"_17548":100983,"_5":17443,"_23820":100904,"_2384":100984},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2857":59417,"_25170":59378,"_17548":100986,"_5":17443,"_23820":100904,"_2384":100987},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2857":59418,"_25170":59378,"_17548":100989,"_5":17443,"_23820":100904,"_2384":100990},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2857":59419,"_25170":59378,"_17548":100992,"_5":17443,"_23820":100904,"_2384":100993},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2857":59420,"_25170":59378,"_17548":100995,"_5":17443,"_23820":100908,"_2384":100996},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2857":59421,"_25170":59378,"_17548":100998,"_5":17443,"_23820":100908,"_2384":100999},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2857":59422,"_25170":59378,"_17548":101001,"_5":17443,"_23820":100908,"_2384":101002},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2857":59423,"_25170":59378,"_17548":101004,"_5":17443,"_23820":100908,"_2384":101005},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2857":59424,"_25170":59378,"_17548":101007,"_5":17443,"_23820":100908,"_2384":101008},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2857":59425,"_25170":59378,"_17548":101010,"_5":17443,"_23820":100908,"_2384":101011},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2857":59426,"_25170":59378,"_17548":101013,"_5":17443,"_23820":100908,"_2384":101014},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2857":59427,"_25170":59427,"_5":12294,"_2384":101016,"_25506":101017,"_17548":101018,"_23820":59427},"Autoridades de certificación",[40848,97279,45873,100857],[],{"_2857":59428,"_25170":59427,"_17548":101020,"_5":17443,"_23820":59427,"_2384":101021},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2857":59429,"_25170":59427,"_5":25503,"_17548":101023,"_23820":101024,"_2384":101025},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2857":59430,"_25170":59427,"_5":25503,"_17548":101027,"_23820":101028,"_2384":101029},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2857":59431,"_25170":59427,"_5":25503,"_17548":101031,"_23820":101032,"_2384":95980},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2857":59432,"_25170":59427,"_5":25503,"_17548":101034,"_23820":101035,"_2384":101036},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2857":59433,"_25170":59427,"_5":25503,"_17548":101038,"_23820":101039,"_2384":101040},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2857":59434,"_25170":59427,"_5":25503,"_17548":101042,"_23820":101043,"_2384":101044},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2857":59435,"_25170":59427,"_5":25503,"_17548":101046,"_23820":101047,"_2384":101048},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2857":59436,"_25170":59427,"_5":25503,"_17548":101050,"_23820":101051,"_2384":101052},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2857":59437,"_25170":59427,"_5":25503,"_17548":101054,"_23820":101055,"_2384":101056},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2857":59438,"_25170":59427,"_5":25503,"_17548":101058,"_23820":101059,"_2384":101060},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2857":59439,"_25170":59427,"_5":25503,"_17548":101062,"_23820":101063,"_2384":101064},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2857":59440,"_25170":59427,"_5":25503,"_17548":101066,"_23820":101067,"_2384":101068},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2857":59441,"_25170":59427,"_5":25503,"_17548":101070,"_23820":101071,"_2384":101072},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2857":59442,"_25170":59427,"_5":25503,"_17548":101074,"_23820":101075,"_2384":101076},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2857":59443,"_25170":59427,"_5":25503,"_17548":101078,"_23820":101079,"_2384":101080},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2857":59444,"_25170":59427,"_5":25503,"_17548":101082,"_23820":101083,"_2384":101084},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2857":59445,"_25170":59427,"_5":25503,"_17548":101086,"_23820":101087,"_2384":101088},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2857":59446,"_25170":59427,"_5":25503,"_17548":101090,"_23820":101091,"_2384":101092},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2857":59447,"_25170":59427,"_5":25503,"_17548":101094,"_23820":101095,"_2384":101096},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2857":59448,"_25170":59427,"_5":25503,"_17548":101098,"_23820":101099,"_2384":101100},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2857":59449,"_25170":59427,"_5":25503,"_17548":101102,"_23820":101103,"_2384":101104},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2857":59450,"_25170":59427,"_5":25503,"_17548":101106,"_23820":101107,"_2384":101108},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2857":59451,"_25170":59427,"_17548":101110,"_5":17443,"_23820":59427,"_2384":101111},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2857":59452,"_25170":59427,"_17548":101113,"_5":17443,"_23820":59427,"_2384":101114},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2857":59453,"_25170":59427,"_17548":101116,"_5":17443,"_23820":59427,"_2384":101117},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2857":59454,"_25170":59427,"_17548":101119,"_5":17443,"_23820":101024,"_2384":101120},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2857":59455,"_25170":59427,"_17548":101122,"_5":17443,"_23820":101024,"_2384":101123},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2857":59456,"_25170":59427,"_17548":101125,"_5":17443,"_23820":101024,"_2384":101126},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2857":59457,"_25170":59427,"_17548":101128,"_5":17443,"_23820":101024,"_2384":101129},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2857":59458,"_25170":59427,"_17548":101131,"_5":17443,"_23820":101024,"_2384":101132},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2857":59459,"_25170":59427,"_17548":101134,"_5":17443,"_23820":101032,"_2384":101135},[],"Decide si la CA será raíz o intermedia.",{"_2857":59460,"_25170":59427,"_17548":101137,"_5":17443,"_23820":101032,"_2384":101138},[],"Elige el motor que custodiará la clave.",{"_2857":59461,"_25170":59427,"_17548":101140,"_5":17443,"_23820":101032,"_2384":101141},[],"Define una validez superior a la de los certificados que emitirá.",{"_2857":59462,"_25170":59427,"_17548":101143,"_5":17443,"_23820":101032,"_2384":101144},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2857":59463,"_25170":59427,"_17548":101146,"_5":17443,"_23820":101035,"_2384":101147},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2857":59464,"_25170":59427,"_17548":101149,"_5":17443,"_23820":101039,"_2384":101150},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2857":59465,"_25170":59427,"_17548":101152,"_5":17443,"_23820":101039,"_2384":101153},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2857":59466,"_25170":59427,"_17548":101155,"_5":17443,"_23820":101043,"_2384":101156},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2857":59467,"_25170":59427,"_17548":101158,"_5":17443,"_23820":101047,"_2384":101159},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2857":59468,"_25170":59427,"_17548":101161,"_5":17443,"_23820":101047,"_2384":101162},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2857":59469,"_25170":59427,"_17548":101164,"_5":17443,"_23820":101047,"_2384":101165},[],"`ST`: estado o provincia.",{"_2857":59470,"_25170":59427,"_17548":101167,"_5":17443,"_23820":101047,"_2384":101168},[],"`L`: localidad.",{"_2857":59471,"_25170":59427,"_17548":101170,"_5":17443,"_23820":101047,"_2384":101171},[],"`O`: organización.",{"_2857":59472,"_25170":59427,"_17548":101173,"_5":17443,"_23820":101047,"_2384":101174},[],"`OU`: unidad organizativa.",{"_2857":59473,"_25170":59427,"_17548":101176,"_5":17443,"_23820":101047,"_2384":101177},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2857":59474,"_25170":59427,"_17548":101179,"_5":17443,"_23820":101051,"_2384":101180},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2857":59475,"_25170":59427,"_17548":101182,"_5":17443,"_23820":101051,"_2384":101183},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2857":59476,"_25170":59427,"_17548":101185,"_5":17443,"_23820":101055,"_2384":101186},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2857":59477,"_25170":59427,"_17548":101188,"_5":17443,"_23820":101055,"_2384":101189},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2857":59478,"_25170":59427,"_17548":101191,"_5":17443,"_23820":101059,"_2384":101192},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2857":59479,"_25170":59427,"_17548":101194,"_5":17443,"_23820":101059,"_2384":101195},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2857":59480,"_25170":59427,"_17548":101197,"_5":17443,"_23820":101063,"_2384":101198},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2857":59481,"_25170":59427,"_17548":101200,"_5":17443,"_23820":101067,"_2384":101201},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2857":59482,"_25170":59427,"_17548":101203,"_5":17443,"_23820":101071,"_2384":101204},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2857":59483,"_25170":59427,"_17548":101206,"_5":17443,"_23820":101075,"_2384":101207},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2857":59484,"_25170":59427,"_17548":101209,"_5":17443,"_23820":101079,"_2384":101210},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2857":59485,"_25170":59427,"_17548":101212,"_5":17443,"_23820":101079,"_2384":101213},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2857":59486,"_25170":59427,"_17548":101215,"_5":17443,"_23820":101083,"_2384":101216},[],"Abre una CA desde el inventario para consultar:",{"_2857":59487,"_25170":59427,"_17548":101218,"_5":17443,"_23820":101083,"_2384":101219},[],"Estado y periodo de validez.",{"_2857":59488,"_25170":59427,"_17548":101221,"_5":17443,"_23820":101083,"_2384":101222},[],"Certificado y cadena en formato PEM.",{"_2857":59489,"_25170":59427,"_17548":101224,"_5":17443,"_23820":101083,"_2384":101225},[],"Número de certificados activos, expirados y revocados.",{"_2857":59490,"_25170":59427,"_17548":101227,"_5":17443,"_23820":101083,"_2384":101228},[],"Certificados emitidos en **Issued Certificates**.",{"_2857":59491,"_25170":59427,"_17548":101230,"_5":17443,"_23820":101083,"_2384":101231},[],"CRL vinculada a la autoridad.",{"_2857":59492,"_25170":59427,"_17548":101233,"_5":17443,"_23820":101083,"_2384":101234},[],"Metadatos y motor criptográfico asociado.",{"_2857":59493,"_25170":59427,"_17548":101236,"_5":17443,"_23820":101083,"_2384":101237},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2857":59494,"_25170":59427,"_17548":101239,"_5":17443,"_23820":101087,"_2384":101240},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2857":59495,"_25170":59427,"_17548":101242,"_5":17443,"_23820":101087,"_2384":101243},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2857":59496,"_25170":59427,"_17548":101245,"_5":17443,"_23820":101087,"_2384":101246},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2857":59497,"_25170":59427,"_17548":101248,"_5":17443,"_23820":101087,"_2384":101249},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2857":59498,"_25170":59427,"_17548":101251,"_5":17443,"_23820":101091,"_2384":101252},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2857":59499,"_25170":59427,"_17548":101254,"_5":17443,"_23820":101095,"_2384":101255},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2857":59500,"_25170":59427,"_17548":101257,"_5":17443,"_23820":101099,"_2384":101258},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2857":59501,"_25170":59427,"_17548":101260,"_5":17443,"_23820":101103,"_2384":101261},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2857":59502,"_25170":59427,"_17548":101263,"_5":17443,"_23820":101107,"_2384":101264},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2857":59503,"_25170":59427,"_17548":101266,"_5":17443,"_23820":101107,"_2384":101267},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2857":59504,"_25170":59504,"_5":12294,"_2384":101269,"_25506":101270,"_17548":101271,"_23820":59504},"Perfiles de certificado",[40848,97279,45873,100857],[],{"_2857":59505,"_25170":59504,"_17548":101273,"_5":17443,"_23820":59504,"_2384":101274},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2857":59506,"_25170":59504,"_5":25503,"_17548":101276,"_23820":101277,"_2384":101278},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2857":59507,"_25170":59504,"_5":25503,"_17548":101280,"_23820":101281,"_2384":101282},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#validez","Validez",{"_2857":59508,"_25170":59504,"_5":25503,"_17548":101284,"_23820":101285,"_2384":101286},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2857":59509,"_25170":59504,"_5":25503,"_17548":101288,"_23820":101289,"_2384":101290},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2857":59510,"_25170":59504,"_5":25503,"_17548":101292,"_23820":101293,"_2384":101294},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2857":59511,"_25170":59504,"_5":25503,"_17548":101296,"_23820":101297,"_2384":101298},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2857":59512,"_25170":59504,"_5":25503,"_17548":101300,"_23820":101301,"_2384":101302},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2857":59513,"_25170":59504,"_5":25503,"_17548":101304,"_23820":101305,"_2384":101306},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2857":59514,"_25170":59504,"_5":25503,"_17548":101308,"_23820":101309,"_2384":101310},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2857":59515,"_25170":59504,"_5":25503,"_17548":101312,"_23820":101313,"_2384":101314},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2857":59516,"_25170":59504,"_5":25503,"_17548":101316,"_23820":101317,"_2384":101318},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2857":59517,"_25170":59504,"_5":25503,"_17548":101320,"_23820":101321,"_2384":101322},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2857":59518,"_25170":59504,"_5":25503,"_17548":101324,"_23820":101325,"_2384":101326},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2857":59519,"_25170":59504,"_5":25503,"_17548":101328,"_23820":101329,"_2384":101330},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2857":59520,"_25170":59504,"_5":25503,"_17548":101332,"_23820":101333,"_2384":101334},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2857":59521,"_25170":59504,"_5":25503,"_17548":101336,"_23820":101337,"_2384":101338},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2857":59522,"_25170":59504,"_17548":101340,"_5":17443,"_23820":59504,"_2384":101341},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2857":59523,"_25170":59504,"_17548":101343,"_5":17443,"_23820":59504,"_2384":101344},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2857":59524,"_25170":59504,"_17548":101346,"_5":17443,"_23820":101281,"_2384":101347},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2857":59525,"_25170":59504,"_17548":101349,"_5":17443,"_23820":101281,"_2384":101350},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2857":59526,"_25170":59504,"_17548":101352,"_5":17443,"_23820":101285,"_2384":101353},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2857":59527,"_25170":59504,"_17548":101355,"_5":17443,"_23820":101289,"_2384":101356},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2857":59528,"_25170":59504,"_17548":101358,"_5":17443,"_23820":101289,"_2384":101359},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2857":59529,"_25170":59504,"_17548":101361,"_5":17443,"_23820":101289,"_2384":101362},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2857":59530,"_25170":59504,"_17548":101364,"_5":17443,"_23820":101293,"_2384":101365},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2857":59531,"_25170":59504,"_17548":101367,"_5":17443,"_23820":101297,"_2384":101368},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2857":59532,"_25170":59504,"_17548":101370,"_5":17443,"_23820":101297,"_2384":101371},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2857":59533,"_25170":59504,"_17548":101373,"_5":17443,"_23820":101301,"_2384":101374},[],"La aplicación criptográfica puede:",{"_2857":59534,"_25170":59504,"_17548":101376,"_5":17443,"_23820":101301,"_2384":101377},[],"permitir o bloquear claves RSA;",{"_2857":59535,"_25170":59504,"_17548":101379,"_5":17443,"_23820":101301,"_2384":101380},[],"limitar los tamaños RSA admitidos;",{"_2857":59536,"_25170":59504,"_17548":101382,"_5":17443,"_23820":101301,"_2384":101383},[],"permitir o bloquear claves ECDSA;",{"_2857":59537,"_25170":59504,"_17548":101385,"_5":17443,"_23820":101301,"_2384":101386},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2857":59538,"_25170":59504,"_17548":101388,"_5":17443,"_23820":101301,"_2384":101389},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2857":59539,"_25170":59504,"_17548":101391,"_5":17443,"_23820":101305,"_2384":101392},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2857":59540,"_25170":59504,"_17548":101394,"_5":17443,"_23820":101305,"_2384":97070},[],{"_2857":59541,"_25170":59504,"_17548":101396,"_5":17443,"_23820":101305,"_2384":101397},[],"Primera opción",{"_2857":59542,"_25170":59504,"_17548":101399,"_5":17443,"_23820":101305,"_2384":101400},[],"Segunda opción",{"_2857":59543,"_25170":59504,"_17548":101402,"_5":17443,"_23820":101305,"_2384":101403},[],"Si no hay ninguna",{"_2857":59544,"_25170":59504,"_17548":101405,"_5":17443,"_23820":101305,"_2384":101406},[],"Firma directa con una CA",{"_2857":59545,"_25170":59504,"_17548":101408,"_5":17443,"_23820":101305,"_2384":101409},[],"`issuance_profile` incluido en la solicitud",{"_2857":59546,"_25170":59504,"_17548":101411,"_5":17443,"_23820":101305,"_2384":101412},[],"`issuance_profile_id` de la solicitud",{"_2857":59547,"_25170":59504,"_17548":101414,"_5":17443,"_23820":101305,"_2384":101415},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2857":59548,"_25170":59504,"_17548":101417,"_5":17443,"_23820":101305,"_2384":101418},[],"Emisión mediante DMS",{"_2857":59549,"_25170":59504,"_17548":101420,"_5":17443,"_23820":101305,"_2384":46438},[],{"_2857":59550,"_25170":59504,"_17548":101422,"_5":17443,"_23820":101305,"_2384":101423},[],"`settings.issuance_profile` incluido en el DMS",{"_2857":59551,"_25170":59504,"_17548":101425,"_5":17443,"_23820":101305,"_2384":101426},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2857":59552,"_25170":59504,"_17548":101428,"_5":17443,"_23820":101305,"_2384":101429},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2857":59553,"_25170":59504,"_17548":101431,"_5":17443,"_23820":101305,"_2384":101432},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2857":59554,"_25170":59504,"_17548":101434,"_5":17443,"_23820":101313,"_2384":101435},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2857":59555,"_25170":59504,"_17548":101437,"_5":17443,"_23820":101317,"_2384":101438},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2857":59556,"_25170":59504,"_17548":101440,"_5":17443,"_23820":101321,"_2384":101441},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2857":59557,"_25170":59504,"_17548":101443,"_5":17443,"_23820":101325,"_2384":101444},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2857":59558,"_25170":59504,"_17548":101446,"_5":17443,"_23820":101329,"_2384":101447},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2857":59559,"_25170":59504,"_17548":101449,"_5":17443,"_23820":101329,"_2384":101450},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2857":59560,"_25170":59504,"_17548":101452,"_5":17443,"_23820":101333,"_2384":101453},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2857":59561,"_25170":59504,"_17548":101455,"_5":17443,"_23820":101333,"_2384":101456},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2857":59562,"_25170":59504,"_17548":101458,"_5":17443,"_23820":101333,"_2384":101459},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2857":59563,"_25170":59504,"_17548":101461,"_5":17443,"_23820":101333,"_2384":101462},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2857":59564,"_25170":59504,"_17548":101464,"_5":17443,"_23820":101337,"_2384":101465},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2857":59565,"_25170":59504,"_17548":101467,"_5":17443,"_23820":101337,"_2384":101468},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2857":59566,"_25170":59566,"_5":12294,"_2384":101470,"_25506":101471,"_17548":101473,"_23820":59566},"Validación de certificados",[40848,97279,45873,101472],"Validación",[],{"_2857":59567,"_25170":59566,"_17548":101475,"_5":17443,"_23820":59566,"_2384":101476},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2857":59568,"_25170":59566,"_5":25503,"_17548":101478,"_23820":101479,"_2384":101480},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2857":59569,"_25170":59566,"_5":25503,"_17548":101482,"_23820":101483,"_2384":101484},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2857":59570,"_25170":59566,"_5":25503,"_17548":101486,"_23820":101487,"_2384":101488},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2857":59571,"_25170":59566,"_17548":101490,"_5":17443,"_23820":59566,"_2384":101491},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2857":59572,"_25170":59566,"_17548":101493,"_5":17443,"_23820":101479,"_2384":101494},[],"Verifica estos criterios juntos:",{"_2857":59573,"_25170":59566,"_17548":101496,"_5":17443,"_23820":101479,"_2384":100484},[],{"_2857":59574,"_25170":59566,"_17548":101498,"_5":17443,"_23820":101479,"_2384":101499},[],"Resultado necesario",{"_2857":59575,"_25170":59566,"_17548":101501,"_5":17443,"_23820":101479,"_2384":101502},[],"Cadena y firma",{"_2857":59576,"_25170":59566,"_17548":101504,"_5":17443,"_23820":101479,"_2384":101505},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2857":59577,"_25170":59566,"_17548":101507,"_5":17443,"_23820":101479,"_2384":101508},[],"Fechas",{"_2857":59578,"_25170":59566,"_17548":101510,"_5":17443,"_23820":101479,"_2384":101511},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2857":59579,"_25170":59566,"_17548":101513,"_5":17443,"_23820":101479,"_2384":96983},[],{"_2857":59580,"_25170":59566,"_17548":101515,"_5":17443,"_23820":101479,"_2384":101516},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2857":59581,"_25170":59566,"_17548":101518,"_5":17443,"_23820":101479,"_2384":101519},[],"Uso",{"_2857":59582,"_25170":59566,"_17548":101521,"_5":17443,"_23820":101479,"_2384":101522},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2857":59583,"_25170":59566,"_17548":101524,"_5":17443,"_23820":101479,"_2384":101525},[],"Revocación",{"_2857":59584,"_25170":59566,"_17548":101527,"_5":17443,"_23820":101479,"_2384":101528},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2857":59585,"_25170":59566,"_17548":101530,"_5":17443,"_23820":101479,"_2384":101531},[],"Autorización",{"_2857":59586,"_25170":59566,"_17548":101533,"_5":17443,"_23820":101479,"_2384":101534},[],"La aplicación permite la acción a esa identidad.",{"_2857":59587,"_25170":59566,"_17548":101536,"_5":17443,"_23820":101479,"_2384":101537},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2857":59588,"_25170":59566,"_17548":101539,"_5":17443,"_23820":101483,"_2384":101540},[],"Mecanismo",{"_2857":59589,"_25170":59566,"_17548":101542,"_5":17443,"_23820":101483,"_2384":101543},[],"Cuándo utilizarlo",{"_2857":59590,"_25170":59566,"_17548":101545,"_5":17443,"_23820":101483,"_2384":101546},[],"Qué debes mantener",{"_2857":59591,"_25170":59566,"_17548":101548,"_5":17443,"_23820":101483,"_2384":46566},[],{"_2857":59592,"_25170":59566,"_17548":101550,"_5":17443,"_23820":101483,"_2384":101551},[],"Consulta del estado de un certificado concreto.",{"_2857":59593,"_25170":59566,"_17548":101553,"_5":17443,"_23820":101483,"_2384":101554},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2857":59594,"_25170":59566,"_17548":101556,"_5":17443,"_23820":101483,"_2384":46575},[],{"_2857":59595,"_25170":59566,"_17548":101558,"_5":17443,"_23820":101483,"_2384":101559},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2857":59596,"_25170":59566,"_17548":101561,"_5":17443,"_23820":101483,"_2384":101562},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2857":59597,"_25170":59566,"_17548":101564,"_5":17443,"_23820":101483,"_2384":101565},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2857":59598,"_25170":59566,"_17548":101567,"_5":17443,"_23820":101483,"_2384":101568},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2857":59599,"_25170":59566,"_17548":101570,"_5":17443,"_23820":101487,"_2384":101571},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2857":59600,"_25170":59566,"_17548":101573,"_5":17443,"_23820":101487,"_2384":101574},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2857":59601,"_25170":59566,"_17548":101576,"_5":17443,"_23820":101487,"_2384":101577},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2857":59602,"_25170":59566,"_17548":101579,"_5":17443,"_23820":101487,"_2384":101580},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2857":59603,"_25170":59566,"_17548":101582,"_5":17443,"_23820":101487,"_2384":101583},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2857":59604,"_25170":59566,"_17548":101585,"_5":17443,"_23820":101487,"_2384":101586},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2857":59605,"_25170":59566,"_17548":101588,"_5":17443,"_23820":101487,"_2384":101589},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2857":59606,"_25170":59566,"_17548":101591,"_5":17443,"_23820":101487,"_2384":101592},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":59607,"_25170":59566,"_17548":101594,"_5":17443,"_23820":101487,"_2384":101595},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2857":59608,"_25170":59608,"_5":12294,"_2384":101597,"_25506":101598,"_17548":101599,"_23820":59608},"Certificados",[40848,97279,45873,100857],[],{"_2857":59609,"_25170":59608,"_17548":101601,"_5":17443,"_23820":59608,"_2384":101602},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2857":59610,"_25170":59608,"_5":25503,"_17548":101604,"_23820":101605,"_2384":101606},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2857":59611,"_25170":59608,"_5":25503,"_17548":101608,"_23820":101609,"_2384":101610},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2857":59612,"_25170":59608,"_5":25503,"_17548":101612,"_23820":101613,"_2384":101614},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2857":59613,"_25170":59608,"_5":25503,"_17548":101616,"_23820":101617,"_2384":101618},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2857":59614,"_25170":59608,"_5":25503,"_17548":101620,"_23820":101621,"_2384":101622},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2857":59615,"_25170":59608,"_5":25503,"_17548":101624,"_23820":101625,"_2384":101626},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2857":59616,"_25170":59608,"_5":25503,"_17548":101628,"_23820":101629,"_2384":101630},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2857":59617,"_25170":59608,"_5":25503,"_17548":101632,"_23820":101633,"_2384":101634},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2857":59618,"_25170":59608,"_5":25503,"_17548":101636,"_23820":101637,"_2384":101638},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#continúa","Continúa",{"_2857":59619,"_25170":59608,"_17548":101640,"_5":17443,"_23820":59608,"_2384":101641},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2857":59620,"_25170":59608,"_17548":101643,"_5":17443,"_23820":101605,"_2384":101644},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2857":59621,"_25170":59608,"_17548":101646,"_5":17443,"_23820":101605,"_2384":101647},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2857":59622,"_25170":59608,"_17548":101649,"_5":17443,"_23820":101609,"_2384":101650},[],"Descarga el PEM e inspecciónalo:",{"_2857":59623,"_25170":59608,"_17548":101652,"_5":17443,"_23820":101609,"_2384":101653},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2857":59624,"_25170":59608,"_17548":101655,"_5":17443,"_23820":101613,"_2384":101656},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2857":59625,"_25170":59608,"_17548":101658,"_5":17443,"_23820":101613,"_2384":101659},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2857":59626,"_25170":59608,"_17548":101661,"_5":17443,"_23820":101613,"_2384":101662},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2857":59627,"_25170":59608,"_17548":101664,"_5":17443,"_23820":101613,"_2384":101665},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2857":59628,"_25170":59608,"_17548":101667,"_5":17443,"_23820":101613,"_2384":101668},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2857":59629,"_25170":59608,"_17548":101670,"_5":17443,"_23820":101613,"_2384":101671},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2857":59630,"_25170":59608,"_17548":101673,"_5":17443,"_23820":101613,"_2384":101674},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2857":59631,"_25170":59608,"_17548":101676,"_5":17443,"_23820":101617,"_2384":101677},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2857":59632,"_25170":59608,"_17548":101679,"_5":17443,"_23820":101621,"_2384":101680},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2857":59633,"_25170":59608,"_17548":101682,"_5":17443,"_23820":101625,"_2384":101683},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2857":59634,"_25170":59608,"_17548":101685,"_5":17443,"_23820":101629,"_2384":101686},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2857":59635,"_25170":59608,"_17548":101688,"_5":17443,"_23820":101629,"_2384":101689},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2857":59636,"_25170":59608,"_17548":101691,"_5":17443,"_23820":101629,"_2384":101692},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2857":59637,"_25170":59608,"_17548":101694,"_5":17443,"_23820":101633,"_2384":101695},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2857":59638,"_25170":59608,"_17548":101697,"_5":17443,"_23820":101633,"_2384":101698},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2857":59639,"_25170":59608,"_17548":101700,"_5":17443,"_23820":101633,"_2384":101701},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2857":59640,"_25170":59608,"_17548":101703,"_5":17443,"_23820":101637,"_2384":101704},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":59641,"_25170":59608,"_17548":101706,"_5":17443,"_23820":101637,"_2384":101707},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2857":59642,"_25170":59642,"_5":12294,"_2384":101709,"_25506":101710,"_17548":101712,"_23820":59642},"Ciclo de vida de un certificado",[40848,97279,45873,101711],"Conceptos",[],{"_2857":59643,"_25170":59642,"_17548":101714,"_5":17443,"_23820":59642,"_2384":101715},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2857":59644,"_25170":59642,"_5":25503,"_17548":101717,"_23820":101718,"_2384":101719},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2857":59645,"_25170":59642,"_5":25503,"_17548":101721,"_23820":101722,"_2384":101723},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2857":59646,"_25170":59642,"_5":25503,"_17548":101725,"_23820":101726,"_2384":101727},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2857":59647,"_25170":59642,"_5":25503,"_17548":101729,"_23820":101730,"_2384":101731},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2857":59648,"_25170":59642,"_5":25503,"_17548":101733,"_23820":101734,"_2384":101735},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2857":59649,"_25170":59642,"_5":25503,"_17548":101737,"_23820":101738,"_2384":101739},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2857":59650,"_25170":59642,"_5":25503,"_17548":101741,"_23820":101742,"_2384":101743},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2857":59651,"_25170":59642,"_5":25503,"_17548":101745,"_23820":101746,"_2384":101747},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2857":59652,"_25170":59642,"_5":25503,"_17548":101749,"_23820":101750,"_2384":101751},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2857":59653,"_25170":59642,"_5":25503,"_17548":101753,"_23820":101754,"_2384":101755},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2857":59654,"_25170":59642,"_17548":101757,"_5":17443,"_23820":59642,"_2384":101758},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2857":59655,"_25170":59642,"_17548":101760,"_5":17443,"_23820":101722,"_2384":101761},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2857":59656,"_25170":59642,"_17548":101763,"_5":17443,"_23820":101726,"_2384":101764},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2857":59657,"_25170":59642,"_17548":101766,"_5":17443,"_23820":101730,"_2384":101767},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2857":59658,"_25170":59642,"_17548":101769,"_5":17443,"_23820":101734,"_2384":101770},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2857":59659,"_25170":59642,"_17548":101772,"_5":17443,"_23820":101738,"_2384":101773},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2857":59660,"_25170":59642,"_17548":101775,"_5":17443,"_23820":101742,"_2384":101776},[],"Lamassu persiste cuatro estados X.509:",{"_2857":59661,"_25170":59642,"_17548":101778,"_5":17443,"_23820":101742,"_2384":101779},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2857":59662,"_25170":59642,"_17548":101781,"_5":17443,"_23820":101742,"_2384":101782},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2857":59663,"_25170":59642,"_17548":101784,"_5":17443,"_23820":101742,"_2384":101785},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2857":59664,"_25170":59642,"_17548":101787,"_5":17443,"_23820":101742,"_2384":101788},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2857":59665,"_25170":59642,"_17548":101790,"_5":17443,"_23820":101742,"_2384":101791},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2857":59666,"_25170":59642,"_17548":101793,"_5":17443,"_23820":101746,"_2384":101794},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2857":59667,"_25170":59642,"_17548":101796,"_5":17443,"_23820":101746,"_2384":101797},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2857":59668,"_25170":59642,"_17548":101799,"_5":17443,"_23820":101746,"_2384":101800},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2857":59669,"_25170":59642,"_17548":101802,"_5":17443,"_23820":101750,"_2384":101803},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2857":59670,"_25170":59642,"_17548":101805,"_5":17443,"_23820":101750,"_2384":101806},[],"Antes de confirmar:",{"_2857":59671,"_25170":59642,"_17548":101808,"_5":17443,"_23820":101750,"_2384":101809},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2857":59672,"_25170":59642,"_17548":101811,"_5":17443,"_23820":101750,"_2384":101812},[],"Distribuye la nueva cadena de confianza.",{"_2857":59673,"_25170":59642,"_17548":101814,"_5":17443,"_23820":101750,"_2384":101815},[],"Reemite las identidades necesarias.",{"_2857":59674,"_25170":59642,"_17548":101817,"_5":17443,"_23820":101750,"_2384":101818},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2857":59675,"_25170":59642,"_17548":101820,"_5":17443,"_23820":101750,"_2384":101821},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2857":59676,"_25170":59642,"_17548":101823,"_5":17443,"_23820":101750,"_2384":101824},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2857":59677,"_25170":59642,"_17548":101826,"_5":17443,"_23820":101754,"_2384":101827},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2857":59678,"_25170":59642,"_17548":101829,"_5":17443,"_23820":101754,"_2384":101830},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2857":59679,"_25170":59642,"_17548":101832,"_5":17443,"_23820":101754,"_2384":101833},[],"Cambios de estado y razones de revocación.",{"_2857":59680,"_25170":59642,"_17548":101835,"_5":17443,"_23820":101754,"_2384":101836},[],"Publicación y vigencia de OCSP y CRLs.",{"_2857":59681,"_25170":59642,"_17548":101838,"_5":17443,"_23820":101754,"_2384":101839},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2857":59682,"_25170":59642,"_17548":101841,"_5":17443,"_23820":101754,"_2384":101842},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2857":59683,"_25170":59683,"_5":12294,"_2384":101844,"_25506":101845,"_17548":101846,"_23820":59683},"Modelo de confianza",[40848,97279,45873,101711],[],{"_2857":59684,"_25170":59683,"_17548":101848,"_5":17443,"_23820":59683,"_2384":101849},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2857":59685,"_25170":59683,"_5":25503,"_17548":101851,"_23820":101852,"_2384":101853},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2857":59686,"_25170":59683,"_5":25503,"_17548":101855,"_23820":101856,"_2384":101857},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2857":59687,"_25170":59683,"_5":25503,"_17548":101859,"_23820":101860,"_2384":101861},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2857":59688,"_25170":59683,"_5":25503,"_17548":101863,"_23820":101864,"_2384":101865},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2857":59689,"_25170":59683,"_5":25503,"_17548":101867,"_23820":101868,"_2384":101869},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2857":59690,"_25170":59683,"_5":25503,"_17548":101871,"_23820":101872,"_2384":101873},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2857":59691,"_25170":59683,"_5":25503,"_17548":101875,"_23820":101876,"_2384":101877},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2857":59692,"_25170":59683,"_5":25503,"_17548":101879,"_23820":101880,"_2384":101881},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2857":59693,"_25170":59683,"_5":25503,"_17548":101883,"_23820":101884,"_2384":101885},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2857":59694,"_25170":59683,"_5":25503,"_17548":101887,"_23820":101888,"_2384":101889},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2857":59695,"_25170":59683,"_17548":101891,"_5":17443,"_23820":59683,"_2384":101892},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2857":59696,"_25170":59683,"_17548":101894,"_5":17443,"_23820":101856,"_2384":101895},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2857":59697,"_25170":59683,"_17548":101897,"_5":17443,"_23820":101860,"_2384":101898},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2857":59698,"_25170":59683,"_17548":101900,"_5":17443,"_23820":101864,"_2384":101901},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2857":59699,"_25170":59683,"_17548":101903,"_5":17443,"_23820":101868,"_2384":101904},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2857":59700,"_25170":59683,"_17548":101906,"_5":17443,"_23820":101872,"_2384":101907},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2857":59701,"_25170":59683,"_17548":101909,"_5":17443,"_23820":101872,"_2384":101910},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2857":59702,"_25170":59683,"_17548":101912,"_5":17443,"_23820":101872,"_2384":101913},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2857":59703,"_25170":59683,"_17548":101915,"_5":17443,"_23820":101872,"_2384":101916},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2857":59704,"_25170":59683,"_17548":101918,"_5":17443,"_23820":101872,"_2384":101919},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2857":59705,"_25170":59683,"_17548":101921,"_5":17443,"_23820":101872,"_2384":101922},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2857":59706,"_25170":59683,"_17548":101924,"_5":17443,"_23820":101876,"_2384":101925},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2857":59707,"_25170":59683,"_17548":101927,"_5":17443,"_23820":101876,"_2384":101928},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2857":59708,"_25170":59683,"_17548":101930,"_5":17443,"_23820":101876,"_2384":101931},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación configuradas en el bloque de re-enrolamiento.",{"_2857":59709,"_25170":59683,"_17548":101933,"_5":17443,"_23820":101876,"_2384":101934},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2857":59710,"_25170":59683,"_17548":101936,"_5":17443,"_23820":101876,"_2384":101937},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2857":59711,"_25170":59683,"_17548":101939,"_5":17443,"_23820":101880,"_2384":101940},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2857":59712,"_25170":59683,"_17548":101942,"_5":17443,"_23820":101880,"_2384":101943},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2857":59713,"_25170":59683,"_17548":101945,"_5":17443,"_23820":101880,"_2384":101946},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2857":59714,"_25170":59683,"_17548":101948,"_5":17443,"_23820":101880,"_2384":101949},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2857":59715,"_25170":59683,"_17548":101951,"_5":17443,"_23820":101880,"_2384":101952},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2857":59716,"_25170":59683,"_17548":101954,"_5":17443,"_23820":101880,"_2384":101955},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2857":59717,"_25170":59683,"_17548":101957,"_5":17443,"_23820":101880,"_2384":101958},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2857":59718,"_25170":59683,"_17548":101960,"_5":17443,"_23820":101884,"_2384":101961},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2857":59719,"_25170":59683,"_17548":101963,"_5":17443,"_23820":101888,"_2384":101964},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2857":59720,"_25170":59683,"_17548":101966,"_5":17443,"_23820":101888,"_2384":101967},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2857":59721,"_25170":59683,"_17548":101969,"_5":17443,"_23820":101888,"_2384":101970},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2857":59722,"_25170":59683,"_17548":101972,"_5":17443,"_23820":101888,"_2384":101973},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2857":59723,"_25170":59683,"_17548":101975,"_5":17443,"_23820":101888,"_2384":101976},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2857":59724,"_25170":59683,"_17548":101978,"_5":17443,"_23820":101888,"_2384":101979},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2857":59725,"_25170":59683,"_17548":101981,"_5":17443,"_23820":101888,"_2384":101982},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2857":59726,"_25170":59726,"_5":12294,"_2384":101984,"_25506":101985,"_17548":101986,"_23820":59726},"Listas de revocación (CRL)",[40848,97279,45873,101472],[],{"_2857":59727,"_25170":59726,"_17548":101988,"_5":17443,"_23820":59726,"_2384":101989},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2857":59728,"_25170":59726,"_5":25503,"_17548":101991,"_23820":101992,"_2384":101993},[],"/docs/pr-preview/pr-38/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2857":59729,"_25170":59726,"_5":25503,"_17548":101995,"_23820":101996,"_2384":101997},[],"/docs/pr-preview/pr-38/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2857":59730,"_25170":59726,"_5":25503,"_17548":101999,"_23820":102000,"_2384":102001},[],"/docs/pr-preview/pr-38/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2857":59731,"_25170":59726,"_5":25503,"_17548":102003,"_23820":102004,"_2384":102005},[],"/docs/pr-preview/pr-38/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2857":59732,"_25170":59726,"_5":25503,"_17548":102007,"_23820":102008,"_2384":102009},[],"/docs/pr-preview/pr-38/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2857":59733,"_25170":59726,"_5":25503,"_17548":102011,"_23820":102012,"_2384":102013},[],"/docs/pr-preview/pr-38/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2857":59734,"_25170":59726,"_5":25503,"_17548":102015,"_23820":102016,"_2384":102017},[],"/docs/pr-preview/pr-38/es/platform/pki/crl#referencias","Referencias",{"_2857":59735,"_25170":59726,"_17548":102019,"_5":17443,"_23820":59726,"_2384":102020},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2857":59736,"_25170":59726,"_17548":102022,"_5":17443,"_23820":101992,"_2384":102023},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2857":59737,"_25170":59726,"_17548":102025,"_5":17443,"_23820":101992,"_2384":102026},[],"Campo de `crl_options`",{"_2857":59738,"_25170":59726,"_17548":102028,"_5":17443,"_23820":101992,"_2384":98775},[],{"_2857":59739,"_25170":59726,"_17548":102030,"_5":17443,"_23820":101992,"_2384":102031},[],"Valor inicial del backend",{"_2857":59740,"_25170":59726,"_17548":102033,"_5":17443,"_23820":101992,"_2384":47053},[],{"_2857":59741,"_25170":59726,"_17548":102035,"_5":17443,"_23820":101992,"_2384":102036},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2857":59742,"_25170":59726,"_17548":102038,"_5":17443,"_23820":101992,"_2384":102039},[],"7 días.",{"_2857":59743,"_25170":59726,"_17548":102041,"_5":17443,"_23820":101992,"_2384":47062},[],{"_2857":59744,"_25170":59726,"_17548":102043,"_5":17443,"_23820":101992,"_2384":102044},[],"Plazo desde la publicación que activa la renovación programada.",{"_2857":59745,"_25170":59726,"_17548":102046,"_5":17443,"_23820":101992,"_2384":102047},[],"6 días y 23 horas.",{"_2857":59746,"_25170":59726,"_17548":102049,"_5":17443,"_23820":101992,"_2384":47071},[],{"_2857":59747,"_25170":59726,"_17548":102051,"_5":17443,"_23820":101992,"_2384":102052},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2857":59748,"_25170":59726,"_17548":102054,"_5":17443,"_23820":101992,"_2384":47077},[],{"_2857":59749,"_25170":59726,"_17548":102056,"_5":17443,"_23820":101992,"_2384":47080},[],{"_2857":59750,"_25170":59726,"_17548":102058,"_5":17443,"_23820":101992,"_2384":102059},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2857":59751,"_25170":59726,"_17548":102061,"_5":17443,"_23820":101992,"_2384":102062},[],"SKI de la CA.",{"_2857":59752,"_25170":59726,"_17548":102064,"_5":17443,"_23820":101992,"_2384":102065},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2857":59753,"_25170":59726,"_17548":102067,"_5":17443,"_23820":101992,"_2384":102068},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2857":59754,"_25170":59726,"_17548":102070,"_5":17443,"_23820":101996,"_2384":102071},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2857":59755,"_25170":59726,"_17548":102073,"_5":17443,"_23820":101996,"_2384":102074},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2857":59756,"_25170":59726,"_17548":102076,"_5":17443,"_23820":101996,"_2384":102077},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2857":59757,"_25170":59726,"_17548":102079,"_5":17443,"_23820":102000,"_2384":102080},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2857":59758,"_25170":59726,"_17548":102082,"_5":17443,"_23820":102000,"_2384":102083},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2857":59759,"_25170":59726,"_17548":102085,"_5":17443,"_23820":102004,"_2384":102086},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2857":59760,"_25170":59726,"_17548":102088,"_5":17443,"_23820":102004,"_2384":102089},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2857":59761,"_25170":59726,"_17548":102091,"_5":17443,"_23820":102004,"_2384":102092},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2857":59762,"_25170":59726,"_17548":102094,"_5":17443,"_23820":102004,"_2384":102095},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2857":59763,"_25170":59726,"_17548":102097,"_5":17443,"_23820":102004,"_2384":102098},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2857":59764,"_25170":59726,"_17548":102100,"_5":17443,"_23820":102008,"_2384":102101},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2857":59765,"_25170":59726,"_17548":102103,"_5":17443,"_23820":102008,"_2384":98964},[],{"_2857":59766,"_25170":59726,"_17548":102105,"_5":17443,"_23820":102008,"_2384":102106},[],"Path relativo",{"_2857":59767,"_25170":59726,"_17548":102108,"_5":17443,"_23820":102008,"_2384":97070},[],{"_2857":59768,"_25170":59726,"_17548":102110,"_5":17443,"_23820":102008,"_2384":47135},[],{"_2857":59769,"_25170":59726,"_17548":102112,"_5":17443,"_23820":102008,"_2384":47138},[],{"_2857":59770,"_25170":59726,"_17548":102114,"_5":17443,"_23820":102008,"_2384":102115},[],"Consultar `crl_options` y `latest_crl`.",{"_2857":59771,"_25170":59726,"_17548":102117,"_5":17443,"_23820":102008,"_2384":47144},[],{"_2857":59772,"_25170":59726,"_17548":102119,"_5":17443,"_23820":102008,"_2384":47138},[],{"_2857":59773,"_25170":59726,"_17548":102121,"_5":17443,"_23820":102008,"_2384":102122},[],"Sustituir la configuración de CRL.",{"_2857":59774,"_25170":59726,"_17548":102124,"_5":17443,"_23820":102008,"_2384":102125},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2857":59775,"_25170":59726,"_17548":102127,"_5":17443,"_23820":102008,"_2384":102128},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2857":59776,"_25170":59726,"_17548":102130,"_5":17443,"_23820":102012,"_2384":102131},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2857":59777,"_25170":59726,"_17548":102133,"_5":17443,"_23820":102016,"_2384":102134},[],"RFC 5280: perfil X.509 y CRL.",{"_2857":59778,"_25170":59726,"_17548":102136,"_5":17443,"_23820":102016,"_2384":47164},[],{"_2857":59779,"_25170":59726,"_17548":102138,"_5":17443,"_23820":102016,"_2384":47167},[],{"_2857":59780,"_25170":59726,"_17548":102140,"_5":17443,"_23820":102016,"_2384":102141},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":59781,"_25170":59726,"_17548":102143,"_5":17443,"_23820":102016,"_2384":102144},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2857":59782,"_25170":59782,"_5":12294,"_2384":102146,"_25506":102147,"_17548":102148,"_23820":59782},"Claves y motores criptográficos",[40848,97279,45873,100857],[],{"_2857":59783,"_25170":59782,"_17548":102150,"_5":17443,"_23820":59782,"_2384":102151},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2857":59784,"_25170":59782,"_5":25503,"_17548":102153,"_23820":102154,"_2384":102155},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2857":59785,"_25170":59782,"_5":25503,"_17548":102157,"_23820":102158,"_2384":102159},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2857":59786,"_25170":59782,"_5":25503,"_17548":102161,"_23820":102162,"_2384":47192},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#file-system",{"_2857":59787,"_25170":59782,"_5":25503,"_17548":102164,"_23820":102165,"_2384":47196},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#hashicorp-vault",{"_2857":59788,"_25170":59782,"_5":25503,"_17548":102167,"_23820":102168,"_2384":47200},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#aws-secrets-manager",{"_2857":59789,"_25170":59782,"_5":25503,"_17548":102170,"_23820":102171,"_2384":47204},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#aws-kms",{"_2857":59790,"_25170":59782,"_5":25503,"_17548":102173,"_23820":102174,"_2384":47208},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#pkcs11",{"_2857":59791,"_25170":59782,"_5":25503,"_17548":102176,"_23820":102177,"_2384":47212},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#azure-key-vault",{"_2857":59792,"_25170":59782,"_5":25503,"_17548":102179,"_23820":102180,"_2384":102181},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2857":59793,"_25170":59782,"_5":25503,"_17548":102183,"_23820":102184,"_2384":102185},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2857":59794,"_25170":59782,"_5":25503,"_17548":102187,"_23820":102188,"_2384":102189},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2857":59795,"_25170":59782,"_5":25503,"_17548":102191,"_23820":102192,"_2384":102193},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2857":59796,"_25170":59782,"_5":25503,"_17548":102195,"_23820":102196,"_2384":102197},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2857":59797,"_25170":59782,"_5":25503,"_17548":102199,"_23820":102200,"_2384":102201},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2857":59798,"_25170":59782,"_5":25503,"_17548":102203,"_23820":102204,"_2384":102205},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2857":59799,"_25170":59782,"_5":25503,"_17548":102207,"_23820":102208,"_2384":47244},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#sign",{"_2857":59800,"_25170":59782,"_5":25503,"_17548":102210,"_23820":102211,"_2384":47248},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#verify",{"_2857":59801,"_25170":59782,"_5":25503,"_17548":102213,"_23820":102214,"_2384":102215},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2857":59802,"_25170":59782,"_5":25503,"_17548":102217,"_23820":102218,"_2384":102219},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2857":59803,"_25170":59782,"_5":25503,"_17548":102221,"_23820":102222,"_2384":102223},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2857":59804,"_25170":59782,"_17548":102225,"_5":17443,"_23820":59782,"_2384":102226},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2857":59805,"_25170":59782,"_17548":102228,"_5":17443,"_23820":59782,"_2384":102229},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2857":59806,"_25170":59782,"_17548":102231,"_5":17443,"_23820":102154,"_2384":102232},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2857":59807,"_25170":59782,"_17548":102234,"_5":17443,"_23820":102154,"_2384":102235},[],"En la práctica, permite:",{"_2857":59808,"_25170":59782,"_17548":102237,"_5":17443,"_23820":102154,"_2384":102238},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2857":59809,"_25170":59782,"_17548":102240,"_5":17443,"_23820":102154,"_2384":102241},[],"Importar claves creadas externamente.",{"_2857":59810,"_25170":59782,"_17548":102243,"_5":17443,"_23820":102154,"_2384":102244},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2857":59811,"_25170":59782,"_17548":102246,"_5":17443,"_23820":102154,"_2384":102247},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2857":59812,"_25170":59782,"_17548":102249,"_5":17443,"_23820":102158,"_2384":102250},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2857":59813,"_25170":59782,"_17548":102252,"_5":17443,"_23820":102158,"_2384":102253},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2857":59814,"_25170":59782,"_17548":102255,"_5":17443,"_23820":102158,"_2384":102256},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2857":59815,"_25170":59782,"_17548":102258,"_5":17443,"_23820":102162,"_2384":102259},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2857":59816,"_25170":59782,"_17548":102261,"_5":17443,"_23820":102165,"_2384":102262},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2857":59817,"_25170":59782,"_17548":102264,"_5":17443,"_23820":102168,"_2384":102265},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2857":59818,"_25170":59782,"_17548":102267,"_5":17443,"_23820":102171,"_2384":102268},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2857":59819,"_25170":59782,"_17548":102270,"_5":17443,"_23820":102174,"_2384":102271},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2857":59820,"_25170":59782,"_17548":102273,"_5":17443,"_23820":102177,"_2384":102274},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2857":59821,"_25170":59782,"_17548":102276,"_5":17443,"_23820":102177,"_2384":102277},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2857":59822,"_25170":59782,"_17548":102279,"_5":17443,"_23820":102177,"_2384":102280},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2857":59823,"_25170":59782,"_17548":102282,"_5":17443,"_23820":102177,"_2384":102283},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2857":59824,"_25170":59782,"_17548":102285,"_5":17443,"_23820":102180,"_2384":102286},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2857":59825,"_25170":59782,"_17548":102288,"_5":17443,"_23820":102180,"_2384":102289},[],"La tabla incluye los siguientes campos:",{"_2857":59826,"_25170":59782,"_17548":102291,"_5":17443,"_23820":102180,"_2384":102292},[],"**Name**: nombre descriptivo de la clave.",{"_2857":59827,"_25170":59782,"_17548":102294,"_5":17443,"_23820":102180,"_2384":102295},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2857":59828,"_25170":59782,"_17548":102297,"_5":17443,"_23820":102180,"_2384":102298},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2857":59829,"_25170":59782,"_17548":102300,"_5":17443,"_23820":102180,"_2384":102301},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2857":59830,"_25170":59782,"_17548":102303,"_5":17443,"_23820":102180,"_2384":102304},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2857":59831,"_25170":59782,"_17548":102306,"_5":17443,"_23820":102180,"_2384":102307},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2857":59832,"_25170":59782,"_17548":102309,"_5":17443,"_23820":102180,"_2384":102310},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2857":59833,"_25170":59782,"_17548":102312,"_5":17443,"_23820":102180,"_2384":102313},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2857":59834,"_25170":59782,"_17548":102315,"_5":17443,"_23820":102180,"_2384":102316},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2857":59835,"_25170":59782,"_17548":102318,"_5":17443,"_23820":102180,"_2384":102319},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2857":59836,"_25170":59782,"_17548":102321,"_5":17443,"_23820":102180,"_2384":102322},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2857":59837,"_25170":59782,"_17548":102324,"_5":17443,"_23820":102180,"_2384":102325},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2857":59838,"_25170":59782,"_17548":102327,"_5":17443,"_23820":102180,"_2384":102328},[],"**Delete Key** para eliminar la clave del sistema.",{"_2857":59839,"_25170":59782,"_17548":102330,"_5":17443,"_23820":102184,"_2384":102331},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2857":59840,"_25170":59782,"_17548":102333,"_5":17443,"_23820":102188,"_2384":102334},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2857":59841,"_25170":59782,"_17548":102336,"_5":17443,"_23820":102188,"_2384":102337},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2857":59842,"_25170":59782,"_17548":102339,"_5":17443,"_23820":102188,"_2384":102340},[],"**Key Name**: nombre único y descriptivo.",{"_2857":59843,"_25170":59782,"_17548":102342,"_5":17443,"_23820":102188,"_2384":102343},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2857":59844,"_25170":59782,"_17548":102345,"_5":17443,"_23820":102188,"_2384":102346},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2857":59845,"_25170":59782,"_17548":102348,"_5":17443,"_23820":102188,"_2384":102349},[],"**Tags**: metadatos para clasificar la clave.",{"_2857":59846,"_25170":59782,"_17548":102351,"_5":17443,"_23820":102188,"_2384":102352},[],"**Metadata**: información adicional para usos avanzados.",{"_2857":59847,"_25170":59782,"_17548":102354,"_5":17443,"_23820":102192,"_2384":102355},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2857":59848,"_25170":59782,"_17548":102357,"_5":17443,"_23820":102192,"_2384":102358},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2857":59849,"_25170":59782,"_17548":102360,"_5":17443,"_23820":102192,"_2384":102361},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2857":59850,"_25170":59782,"_17548":102363,"_5":17443,"_23820":102192,"_2384":102364},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2857":59851,"_25170":59782,"_17548":102366,"_5":17443,"_23820":102192,"_2384":102367},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2857":59852,"_25170":59782,"_17548":102369,"_5":17443,"_23820":102192,"_2384":102370},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2857":59853,"_25170":59782,"_17548":102372,"_5":17443,"_23820":102192,"_2384":102373},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2857":59854,"_25170":59782,"_17548":102375,"_5":17443,"_23820":102192,"_2384":102376},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2857":59855,"_25170":59782,"_17548":102378,"_5":17443,"_23820":102192,"_2384":102379},[],"**Metadata**: información adicional opcional.",{"_2857":59856,"_25170":59782,"_17548":102381,"_5":17443,"_23820":102192,"_2384":102382},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2857":59857,"_25170":59782,"_17548":102384,"_5":17443,"_23820":102192,"_2384":102385},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2857":59858,"_25170":59782,"_17548":102387,"_5":17443,"_23820":102196,"_2384":102388},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2857":59859,"_25170":59782,"_17548":102390,"_5":17443,"_23820":102200,"_2384":102391},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2857":59860,"_25170":59782,"_17548":102393,"_5":17443,"_23820":102200,"_2384":102394},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2857":59861,"_25170":59782,"_17548":102396,"_5":17443,"_23820":102200,"_2384":102397},[],"**Key Name**: nombre descriptivo.",{"_2857":59862,"_25170":59782,"_17548":102399,"_5":17443,"_23820":102200,"_2384":102400},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2857":59863,"_25170":59782,"_17548":102402,"_5":17443,"_23820":102200,"_2384":102403},[],"**Tags**: etiquetas asociadas.",{"_2857":59864,"_25170":59782,"_17548":102405,"_5":17443,"_23820":102200,"_2384":102406},[],"**Aliases**: nombres alternativos.",{"_2857":59865,"_25170":59782,"_17548":102408,"_5":17443,"_23820":102200,"_2384":102409},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2857":59866,"_25170":59782,"_17548":102411,"_5":17443,"_23820":102200,"_2384":102412},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2857":59867,"_25170":59782,"_17548":102414,"_5":17443,"_23820":102200,"_2384":102415},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2857":59868,"_25170":59782,"_17548":102417,"_5":17443,"_23820":102200,"_2384":102418},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2857":59869,"_25170":59782,"_17548":102420,"_5":17443,"_23820":102204,"_2384":102421},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2857":59870,"_25170":59782,"_17548":102423,"_5":17443,"_23820":102204,"_2384":102424},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2857":59871,"_25170":59782,"_17548":102426,"_5":17443,"_23820":102204,"_2384":102427},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2857":59872,"_25170":59782,"_17548":102429,"_5":17443,"_23820":102208,"_2384":102430},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2857":59873,"_25170":59782,"_17548":102432,"_5":17443,"_23820":102208,"_2384":102433},[],"Campos principales:",{"_2857":59874,"_25170":59782,"_17548":102435,"_5":17443,"_23820":102208,"_2384":102436},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2857":59875,"_25170":59782,"_17548":102438,"_5":17443,"_23820":102208,"_2384":102439},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2857":59876,"_25170":59782,"_17548":102441,"_5":17443,"_23820":102208,"_2384":102442},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2857":59877,"_25170":59782,"_17548":102444,"_5":17443,"_23820":102208,"_2384":102445},[],"**Message**: contenido que se va a firmar.",{"_2857":59878,"_25170":59782,"_17548":102447,"_5":17443,"_23820":102208,"_2384":102448},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2857":59879,"_25170":59782,"_17548":102450,"_5":17443,"_23820":102211,"_2384":102451},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2857":59880,"_25170":59782,"_17548":102453,"_5":17443,"_23820":102211,"_2384":102433},[],{"_2857":59881,"_25170":59782,"_17548":102455,"_5":17443,"_23820":102211,"_2384":102456},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2857":59882,"_25170":59782,"_17548":102458,"_5":17443,"_23820":102211,"_2384":102459},[],"**Message Type**: `Raw` o `Digest`.",{"_2857":59883,"_25170":59782,"_17548":102461,"_5":17443,"_23820":102211,"_2384":102462},[],"**Payload Encoding**: codificación del mensaje.",{"_2857":59884,"_25170":59782,"_17548":102464,"_5":17443,"_23820":102211,"_2384":102465},[],"**Message**: mensaje original o hash.",{"_2857":59885,"_25170":59782,"_17548":102467,"_5":17443,"_23820":102211,"_2384":102468},[],"**Signature**: firma que se desea comprobar.",{"_2857":59886,"_25170":59782,"_17548":102470,"_5":17443,"_23820":102211,"_2384":102471},[],"**Result**: indicador del resultado de la validación.",{"_2857":59887,"_25170":59782,"_17548":102473,"_5":17443,"_23820":102214,"_2384":102474},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2857":59888,"_25170":59782,"_17548":102476,"_5":17443,"_23820":102214,"_2384":102477},[],"Este flujo es útil para:",{"_2857":59889,"_25170":59782,"_17548":102479,"_5":17443,"_23820":102214,"_2384":102480},[],"Solicitar certificados a una CA externa.",{"_2857":59890,"_25170":59782,"_17548":102482,"_5":17443,"_23820":102214,"_2384":102483},[],"Renovar una identidad manteniendo la misma clave.",{"_2857":59891,"_25170":59782,"_17548":102485,"_5":17443,"_23820":102214,"_2384":102486},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2857":59892,"_25170":59782,"_17548":102488,"_5":17443,"_23820":102214,"_2384":102489},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2857":59893,"_25170":59782,"_17548":102491,"_5":17443,"_23820":102214,"_2384":102492},[],"**Organization (O)**: organización o empresa.",{"_2857":59894,"_25170":59782,"_17548":102494,"_5":17443,"_23820":102214,"_2384":102495},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2857":59895,"_25170":59782,"_17548":102497,"_5":17443,"_23820":102214,"_2384":102498},[],"**Country (C)**: código de país de dos letras.",{"_2857":59896,"_25170":59782,"_17548":102500,"_5":17443,"_23820":102214,"_2384":102501},[],"**State / Province (ST)**: estado o provincia.",{"_2857":59897,"_25170":59782,"_17548":102503,"_5":17443,"_23820":102214,"_2384":102504},[],"**Locality (L)**: ciudad o localidad.",{"_2857":59898,"_25170":59782,"_17548":102506,"_5":17443,"_23820":102214,"_2384":102507},[],"**Email Address**: correo de contacto.",{"_2857":59899,"_25170":59782,"_17548":102509,"_5":17443,"_23820":102214,"_2384":102510},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2857":59900,"_25170":59782,"_17548":102512,"_5":17443,"_23820":102214,"_2384":102513},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2857":59901,"_25170":59782,"_17548":102515,"_5":17443,"_23820":102218,"_2384":102516},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2857":59902,"_25170":59782,"_17548":102518,"_5":17443,"_23820":102218,"_2384":47556},[],{"_2857":59903,"_25170":59782,"_17548":102520,"_5":17443,"_23820":102222,"_2384":102521},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2857":59904,"_25170":59904,"_5":12294,"_2384":102523,"_25506":102524,"_17548":102525,"_23820":59904},"Validación online con OCSP",[40848,97279,45873,101472],[],{"_2857":59905,"_25170":59904,"_17548":102527,"_5":17443,"_23820":59904,"_2384":102528},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2857":59906,"_25170":59904,"_5":25503,"_17548":102530,"_23820":102531,"_2384":102532},[],"/docs/pr-preview/pr-38/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2857":59907,"_25170":59904,"_5":25503,"_17548":102534,"_23820":102535,"_2384":102536},[],"/docs/pr-preview/pr-38/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2857":59908,"_25170":59904,"_5":25503,"_17548":102538,"_23820":102539,"_2384":102540},[],"/docs/pr-preview/pr-38/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2857":59909,"_25170":59904,"_5":25503,"_17548":102542,"_23820":102543,"_2384":102544},[],"/docs/pr-preview/pr-38/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2857":59910,"_25170":59904,"_5":25503,"_17548":102546,"_23820":102547,"_2384":102548},[],"/docs/pr-preview/pr-38/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2857":59911,"_25170":59904,"_5":25503,"_17548":102550,"_23820":102551,"_2384":102017},[],"/docs/pr-preview/pr-38/es/platform/pki/ocsp#referencias",{"_2857":59912,"_25170":59904,"_17548":102553,"_5":17443,"_23820":59904,"_2384":102554},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2857":59913,"_25170":59904,"_17548":102556,"_5":17443,"_23820":102531,"_2384":102557},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2857":59914,"_25170":59904,"_17548":102559,"_5":17443,"_23820":102531,"_2384":102560},[],"Estado del registro",{"_2857":59915,"_25170":59904,"_17548":102562,"_5":17443,"_23820":102531,"_2384":102563},[],"Respuesta firmada",{"_2857":59916,"_25170":59904,"_17548":102565,"_5":17443,"_23820":102531,"_2384":45051},[],{"_2857":59917,"_25170":59904,"_17548":102567,"_5":17443,"_23820":102531,"_2384":47606},[],{"_2857":59918,"_25170":59904,"_17548":102569,"_5":17443,"_23820":102531,"_2384":45068},[],{"_2857":59919,"_25170":59904,"_17548":102571,"_5":17443,"_23820":102531,"_2384":102572},[],"`Revoked`, con razón y fecha de revocación.",{"_2857":59920,"_25170":59904,"_17548":102574,"_5":17443,"_23820":102531,"_2384":102575},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2857":59921,"_25170":59904,"_17548":102577,"_5":17443,"_23820":102531,"_2384":102578},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2857":59922,"_25170":59904,"_17548":102580,"_5":17443,"_23820":102531,"_2384":102581},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2857":59923,"_25170":59904,"_17548":102583,"_5":17443,"_23820":102531,"_2384":102584},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2857":59924,"_25170":59904,"_17548":102586,"_5":17443,"_23820":102531,"_2384":102587},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2857":59925,"_25170":59904,"_17548":102589,"_5":17443,"_23820":102535,"_2384":102590},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2857":59926,"_25170":59904,"_17548":102592,"_5":17443,"_23820":102535,"_2384":102593},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2857":59927,"_25170":59904,"_17548":102595,"_5":17443,"_23820":102539,"_2384":102596},[],"El servicio acepta:",{"_2857":59928,"_25170":59904,"_17548":102598,"_5":17443,"_23820":102539,"_2384":98964},[],{"_2857":59929,"_25170":59904,"_17548":102600,"_5":17443,"_23820":102539,"_2384":102601},[],"Ruta del servicio VA",{"_2857":59930,"_25170":59904,"_17548":102603,"_5":17443,"_23820":102539,"_2384":102604},[],"Formato",{"_2857":59931,"_25170":59904,"_17548":102606,"_5":17443,"_23820":102539,"_2384":47646},[],{"_2857":59932,"_25170":59904,"_17548":102608,"_5":17443,"_23820":102539,"_2384":47649},[],{"_2857":59933,"_25170":59904,"_17548":102610,"_5":17443,"_23820":102539,"_2384":102611},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2857":59934,"_25170":59904,"_17548":102613,"_5":17443,"_23820":102539,"_2384":47135},[],{"_2857":59935,"_25170":59904,"_17548":102615,"_5":17443,"_23820":102539,"_2384":47657},[],{"_2857":59936,"_25170":59904,"_17548":102617,"_5":17443,"_23820":102539,"_2384":102618},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2857":59937,"_25170":59904,"_17548":102620,"_5":17443,"_23820":102539,"_2384":102621},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2857":59938,"_25170":59904,"_17548":102623,"_5":17443,"_23820":102543,"_2384":102624},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2857":59939,"_25170":59904,"_17548":102626,"_5":17443,"_23820":102543,"_2384":102627},[],"Genera la solicitud:",{"_2857":59940,"_25170":59904,"_17548":102629,"_5":17443,"_23820":102543,"_2384":102630},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2857":59941,"_25170":59904,"_17548":102632,"_5":17443,"_23820":102543,"_2384":102633},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2857":59942,"_25170":59904,"_17548":102635,"_5":17443,"_23820":102543,"_2384":102636},[],"Verifica el DER recibido:",{"_2857":59943,"_25170":59904,"_17548":102638,"_5":17443,"_23820":102543,"_2384":102639},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2857":59944,"_25170":59904,"_17548":102641,"_5":17443,"_23820":102547,"_2384":102642},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2857":59945,"_25170":59904,"_17548":102644,"_5":17443,"_23820":102547,"_2384":102645},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2857":59946,"_25170":59904,"_17548":102647,"_5":17443,"_23820":102551,"_2384":47690},[],{"_2857":59947,"_25170":59904,"_17548":102649,"_5":17443,"_23820":102551,"_2384":47693},[],{"_2857":59948,"_25170":59904,"_17548":102651,"_5":17443,"_23820":102551,"_2384":102652},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2857":59949,"_25170":59904,"_17548":102654,"_5":17443,"_23820":102551,"_2384":102144},[],{"_2857":59950,"_25170":59950,"_5":12294,"_2384":45873,"_25506":102656,"_17548":102657,"_23820":59950},[40848,97279,45873],[],{"_2857":59951,"_25170":59950,"_17548":102659,"_5":17443,"_23820":59950,"_2384":102660},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2857":59952,"_25170":59950,"_5":25503,"_17548":102662,"_23820":102663,"_2384":100181},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#empieza-aquí",{"_2857":59953,"_25170":59950,"_5":25503,"_17548":102665,"_23820":102666,"_2384":102667},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2857":59954,"_25170":59950,"_5":25503,"_17548":102669,"_23820":102670,"_2384":100703},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#capacidades-principales",{"_2857":59955,"_25170":59950,"_5":25503,"_17548":102672,"_23820":102673,"_2384":100707},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2857":59956,"_25170":59950,"_5":25503,"_17548":102675,"_23820":102676,"_2384":100711},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2857":59957,"_25170":59950,"_5":25503,"_17548":102678,"_23820":102679,"_2384":100715},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#emite-y-controla-certificados",{"_2857":59958,"_25170":59950,"_5":25503,"_17548":102681,"_23820":102682,"_2384":100723},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#publica-el-estado-de-validación",{"_2857":59959,"_25170":59950,"_5":25503,"_17548":102684,"_23820":102685,"_2384":102686},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2857":59960,"_25170":59950,"_5":25503,"_17548":102688,"_23820":102689,"_2384":101638},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#continúa",{"_2857":59961,"_25170":59950,"_17548":102691,"_5":17443,"_23820":59950,"_2384":102692},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2857":59962,"_25170":59950,"_17548":102694,"_5":17443,"_23820":102663,"_2384":102695},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2857":59963,"_25170":59950,"_17548":102697,"_5":17443,"_23820":102663,"_2384":102698},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2857":59964,"_25170":59950,"_17548":102700,"_5":17443,"_23820":102666,"_2384":102701},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2857":59965,"_25170":59950,"_17548":102703,"_5":17443,"_23820":102666,"_2384":102704},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2857":59966,"_25170":59950,"_17548":102706,"_5":17443,"_23820":102666,"_2384":102707},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2857":59967,"_25170":59950,"_17548":102709,"_5":17443,"_23820":102666,"_2384":102710},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2857":59968,"_25170":59950,"_17548":102712,"_5":17443,"_23820":102666,"_2384":102713},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2857":59969,"_25170":59950,"_17548":102715,"_5":17443,"_23820":102673,"_2384":102716},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2857":59970,"_25170":59950,"_17548":102718,"_5":17443,"_23820":102676,"_2384":102719},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2857":59971,"_25170":59950,"_17548":102721,"_5":17443,"_23820":102679,"_2384":102722},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2857":59972,"_25170":59950,"_17548":102724,"_5":17443,"_23820":102682,"_2384":102725},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2857":59973,"_25170":59950,"_17548":102727,"_5":17443,"_23820":102685,"_2384":102728},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2857":59974,"_25170":59950,"_17548":102730,"_5":17443,"_23820":102685,"_2384":102731},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2857":59975,"_25170":59950,"_17548":102733,"_5":17443,"_23820":102685,"_2384":102734},[],"su clave pública corresponda a la clave privada del cliente;",{"_2857":59976,"_25170":59950,"_17548":102736,"_5":17443,"_23820":102685,"_2384":102737},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2857":59977,"_25170":59950,"_17548":102739,"_5":17443,"_23820":102685,"_2384":102740},[],"sus fechas y usos permitan la operación;",{"_2857":59978,"_25170":59950,"_17548":102742,"_5":17443,"_23820":102685,"_2384":102743},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2857":59979,"_25170":59950,"_17548":102745,"_5":17443,"_23820":102685,"_2384":102746},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2857":59980,"_25170":59950,"_17548":102748,"_5":17443,"_23820":102689,"_2384":102749},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2857":59981,"_25170":59950,"_17548":102751,"_5":17443,"_23820":102689,"_2384":102752},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2857":59982,"_25170":59950,"_17548":102754,"_5":17443,"_23820":102689,"_2384":102755},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2857":59983,"_25170":59983,"_5":12294,"_2384":102757,"_25506":102758,"_17548":102759,"_23820":59983},"Crea tu primera CA",[40848,97279,45873,100305],[],{"_2857":59984,"_25170":59983,"_17548":102761,"_5":17443,"_23820":59983,"_2384":102762},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2857":59985,"_25170":59983,"_5":25503,"_17548":102764,"_23820":102765,"_2384":95980},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2857":59986,"_25170":59983,"_5":25503,"_17548":102767,"_23820":102768,"_2384":102769},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2857":59987,"_25170":59983,"_5":25503,"_17548":102771,"_23820":102772,"_2384":102773},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2857":59988,"_25170":59983,"_5":25503,"_17548":102775,"_23820":102776,"_2384":102777},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2857":59989,"_25170":59983,"_5":25503,"_17548":102779,"_23820":102780,"_2384":102781},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2857":59990,"_25170":59983,"_5":25503,"_17548":102783,"_23820":102784,"_2384":102785},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2857":59991,"_25170":59983,"_5":25503,"_17548":102787,"_23820":102788,"_2384":102789},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2857":59992,"_25170":59983,"_5":25503,"_17548":102791,"_23820":102792,"_2384":100553},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2857":59993,"_25170":59983,"_5":25503,"_17548":102794,"_23820":102795,"_2384":96004},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2857":59994,"_25170":59983,"_17548":102797,"_5":17443,"_23820":59983,"_2384":102798},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2857":59995,"_25170":59983,"_17548":102800,"_5":17443,"_23820":102765,"_2384":102801},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2857":59996,"_25170":59983,"_17548":102803,"_5":17443,"_23820":102765,"_2384":102804},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2857":59997,"_25170":59983,"_17548":102806,"_5":17443,"_23820":102765,"_2384":102807},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2857":59998,"_25170":59983,"_17548":102809,"_5":17443,"_23820":102765,"_2384":102810},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2857":59999,"_25170":59983,"_17548":102812,"_5":17443,"_23820":102768,"_2384":102813},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2857":60000,"_25170":59983,"_17548":102815,"_5":17443,"_23820":102768,"_2384":102816},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2857":60001,"_25170":59983,"_17548":102818,"_5":17443,"_23820":102772,"_2384":102819},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2857":60002,"_25170":59983,"_17548":102821,"_5":17443,"_23820":102772,"_2384":102822},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2857":60003,"_25170":59983,"_17548":102824,"_5":17443,"_23820":102776,"_2384":102825},[],"Selecciona **Root CA** y completa:",{"_2857":60004,"_25170":59983,"_17548":102827,"_5":17443,"_23820":102776,"_2384":47872},[],{"_2857":60005,"_25170":59983,"_17548":102829,"_5":17443,"_23820":102776,"_2384":102830},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2857":60006,"_25170":59983,"_17548":102832,"_5":17443,"_23820":102776,"_2384":102833},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2857":60007,"_25170":59983,"_17548":102835,"_5":17443,"_23820":102776,"_2384":102836},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2857":60008,"_25170":59983,"_17548":102838,"_5":17443,"_23820":102776,"_2384":102839},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2857":60009,"_25170":59983,"_17548":102841,"_5":17443,"_23820":102780,"_2384":102842},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2857":60010,"_25170":59983,"_17548":102844,"_5":17443,"_23820":102784,"_2384":102845},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2857":60011,"_25170":59983,"_17548":102847,"_5":17443,"_23820":102784,"_2384":102848},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2857":60012,"_25170":59983,"_17548":102850,"_5":17443,"_23820":102788,"_2384":102851},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2857":60013,"_25170":59983,"_17548":102853,"_5":17443,"_23820":102788,"_2384":102854},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2857":60014,"_25170":59983,"_17548":102856,"_5":17443,"_23820":102788,"_2384":102857},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2857":60015,"_25170":59983,"_17548":102859,"_5":17443,"_23820":102792,"_2384":102860},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2857":60016,"_25170":59983,"_17548":102862,"_5":17443,"_23820":102792,"_2384":102863},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2857":60017,"_25170":59983,"_17548":102865,"_5":17443,"_23820":102792,"_2384":102866},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2857":60018,"_25170":59983,"_17548":102868,"_5":17443,"_23820":102792,"_2384":102869},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2857":60019,"_25170":59983,"_17548":102871,"_5":17443,"_23820":102795,"_2384":102872},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2857":60020,"_25170":60020,"_5":12294,"_2384":102874,"_25506":102875,"_17548":102876,"_23820":60020},"Emite y verifica un certificado",[40848,97279,45873,100305],[],{"_2857":60021,"_25170":60020,"_17548":102878,"_5":17443,"_23820":60020,"_2384":102879},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2857":60022,"_25170":60020,"_5":25503,"_17548":102881,"_23820":102882,"_2384":95980},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2857":60023,"_25170":60020,"_5":25503,"_17548":102884,"_23820":102885,"_2384":102886},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2857":60024,"_25170":60020,"_5":25503,"_17548":102888,"_23820":102889,"_2384":102890},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2857":60025,"_25170":60020,"_5":25503,"_17548":102892,"_23820":102893,"_2384":102894},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2857":60026,"_25170":60020,"_5":25503,"_17548":102896,"_23820":102897,"_2384":102898},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2857":60027,"_25170":60020,"_5":25503,"_17548":102900,"_23820":102901,"_2384":102902},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2857":60028,"_25170":60020,"_5":25503,"_17548":102904,"_23820":102905,"_2384":102785},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2857":60029,"_25170":60020,"_5":25503,"_17548":102907,"_23820":102908,"_2384":102909},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2857":60030,"_25170":60020,"_5":25503,"_17548":102911,"_23820":102912,"_2384":102913},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2857":60031,"_25170":60020,"_5":25503,"_17548":102915,"_23820":102916,"_2384":102917},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2857":60032,"_25170":60020,"_5":25503,"_17548":102919,"_23820":102920,"_2384":100553},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2857":60033,"_25170":60020,"_5":25503,"_17548":102922,"_23820":102923,"_2384":96004},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2857":60034,"_25170":60020,"_17548":102925,"_5":17443,"_23820":60020,"_2384":102926},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2857":60035,"_25170":60020,"_17548":102928,"_5":17443,"_23820":102882,"_2384":102929},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2857":60036,"_25170":60020,"_17548":102931,"_5":17443,"_23820":102882,"_2384":102932},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2857":60037,"_25170":60020,"_17548":102934,"_5":17443,"_23820":102882,"_2384":102935},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2857":60038,"_25170":60020,"_17548":102937,"_5":17443,"_23820":102882,"_2384":102938},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2857":60039,"_25170":60020,"_17548":102940,"_5":17443,"_23820":102882,"_2384":102941},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2857":60040,"_25170":60020,"_17548":102943,"_5":17443,"_23820":102885,"_2384":102944},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2857":60041,"_25170":60020,"_17548":102946,"_5":17443,"_23820":102889,"_2384":102947},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2857":60042,"_25170":60020,"_17548":102949,"_5":17443,"_23820":102889,"_2384":102950},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2857":60043,"_25170":60020,"_17548":102952,"_5":17443,"_23820":102893,"_2384":102953},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2857":60044,"_25170":60020,"_17548":102955,"_5":17443,"_23820":102893,"_2384":102956},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2857":60045,"_25170":60020,"_17548":102958,"_5":17443,"_23820":102897,"_2384":102959},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2857":60046,"_25170":60020,"_17548":102961,"_5":17443,"_23820":102897,"_2384":102962},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2857":60047,"_25170":60020,"_17548":102964,"_5":17443,"_23820":102901,"_2384":102965},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2857":60048,"_25170":60020,"_17548":102967,"_5":17443,"_23820":102905,"_2384":102968},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2857":60049,"_25170":60020,"_17548":102970,"_5":17443,"_23820":102908,"_2384":102971},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2857":60050,"_25170":60020,"_17548":102973,"_5":17443,"_23820":102912,"_2384":102974},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2857":60051,"_25170":60020,"_17548":102976,"_5":17443,"_23820":102912,"_2384":102977},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2857":60052,"_25170":60020,"_17548":102979,"_5":17443,"_23820":102912,"_2384":102980},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2857":60053,"_25170":60020,"_17548":102982,"_5":17443,"_23820":102916,"_2384":102983},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2857":60054,"_25170":60020,"_17548":102985,"_5":17443,"_23820":102916,"_2384":102986},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2857":60055,"_25170":60020,"_17548":102988,"_5":17443,"_23820":102916,"_2384":102989},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2857":60056,"_25170":60020,"_17548":102991,"_5":17443,"_23820":102920,"_2384":100636},[],{"_2857":60057,"_25170":60020,"_17548":102993,"_5":17443,"_23820":102920,"_2384":99413},[],{"_2857":60058,"_25170":60020,"_17548":102995,"_5":17443,"_23820":102920,"_2384":102996},[],"La CA rechaza la emisión",{"_2857":60059,"_25170":60020,"_17548":102998,"_5":17443,"_23820":102920,"_2384":102999},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2857":60060,"_25170":60020,"_17548":103001,"_5":17443,"_23820":102920,"_2384":103002},[],"Sujeto o usos diferentes",{"_2857":60061,"_25170":60020,"_17548":103004,"_5":17443,"_23820":102920,"_2384":103005},[],"Perfil aplicado y valores solicitados.",{"_2857":60062,"_25170":60020,"_17548":103007,"_5":17443,"_23820":102920,"_2384":103008},[],"No se encuentra el emisor",{"_2857":60063,"_25170":60020,"_17548":103010,"_5":17443,"_23820":102920,"_2384":103011},[],"CA descargada y cadena intermedia necesaria.",{"_2857":60064,"_25170":60020,"_17548":103013,"_5":17443,"_23820":102920,"_2384":103014},[],"Falla la vigencia",{"_2857":60065,"_25170":60020,"_17548":103016,"_5":17443,"_23820":102920,"_2384":103017},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2857":60066,"_25170":60020,"_17548":103019,"_5":17443,"_23820":102920,"_2384":103020},[],"Los resúmenes de clave difieren",{"_2857":60067,"_25170":60020,"_17548":103022,"_5":17443,"_23820":102920,"_2384":103023},[],"Archivos de certificado y clave de la misma emisión.",{"_2857":60068,"_25170":60020,"_17548":103025,"_5":17443,"_23820":102920,"_2384":103026},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2857":60069,"_25170":60020,"_17548":103028,"_5":17443,"_23820":102923,"_2384":103029},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2857":60070,"_25170":60020,"_17548":103031,"_5":17443,"_23820":102923,"_2384":103032},[],"Gestionar certificados para inspección, estado y revocación.",{"_2857":60071,"_25170":60020,"_17548":103034,"_5":17443,"_23820":102923,"_2384":103035},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2857":60072,"_25170":60020,"_17548":103037,"_5":17443,"_23820":102923,"_2384":103038},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2857":60073,"_25170":60020,"_17548":103040,"_5":17443,"_23820":102923,"_2384":103041},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2857":60074,"_25170":60074,"_5":12294,"_2384":103043,"_25506":103044,"_17548":103045,"_23820":60074},"Primeros pasos de PKI",[40848,97279,45873,100305],[],{"_2857":60075,"_25170":60074,"_17548":103047,"_5":17443,"_23820":60074,"_2384":103048},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2857":60076,"_25170":60074,"_5":25503,"_17548":103050,"_23820":103051,"_2384":95980},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2857":60077,"_25170":60074,"_5":25503,"_17548":103053,"_23820":103054,"_2384":103055},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2857":60078,"_25170":60074,"_5":25503,"_17548":103057,"_23820":103058,"_2384":100487},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2857":60079,"_25170":60074,"_5":25503,"_17548":103060,"_23820":103061,"_2384":103062},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2857":60080,"_25170":60074,"_17548":103064,"_5":17443,"_23820":60074,"_2384":103065},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2857":60081,"_25170":60074,"_17548":103067,"_5":17443,"_23820":103051,"_2384":103068},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2857":60082,"_25170":60074,"_17548":103070,"_5":17443,"_23820":103051,"_2384":103071},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2857":60083,"_25170":60074,"_17548":103073,"_5":17443,"_23820":103051,"_2384":103074},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2857":60084,"_25170":60074,"_17548":103076,"_5":17443,"_23820":103051,"_2384":103077},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2857":60085,"_25170":60074,"_17548":103079,"_5":17443,"_23820":103051,"_2384":103080},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2857":60086,"_25170":60074,"_17548":103082,"_5":17443,"_23820":103054,"_2384":103083},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2857":60087,"_25170":60074,"_17548":103085,"_5":17443,"_23820":103054,"_2384":103086},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2857":60088,"_25170":60074,"_17548":103088,"_5":17443,"_23820":103054,"_2384":103089},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2857":60089,"_25170":60074,"_17548":103091,"_5":17443,"_23820":103054,"_2384":103092},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2857":60090,"_25170":60074,"_17548":103094,"_5":17443,"_23820":103058,"_2384":103095},[],"Archivo o recurso",{"_2857":60091,"_25170":60074,"_17548":103097,"_5":17443,"_23820":103058,"_2384":100484},[],{"_2857":60092,"_25170":60074,"_17548":103099,"_5":17443,"_23820":103058,"_2384":103100},[],"CA raíz activa y `ca.pem`",{"_2857":60093,"_25170":60074,"_17548":103102,"_5":17443,"_23820":103058,"_2384":103103},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2857":60094,"_25170":60074,"_17548":103105,"_5":17443,"_23820":103058,"_2384":103106},[],"Certificado final y `device.crt`",{"_2857":60095,"_25170":60074,"_17548":103108,"_5":17443,"_23820":103058,"_2384":103109},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2857":60096,"_25170":60074,"_17548":103111,"_5":17443,"_23820":103058,"_2384":103112},[],"Clave privada `device.key`",{"_2857":60097,"_25170":60074,"_17548":103114,"_5":17443,"_23820":103058,"_2384":103115},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2857":60098,"_25170":60074,"_17548":103117,"_5":17443,"_23820":103058,"_2384":103118},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2857":60099,"_25170":60074,"_17548":103120,"_5":17443,"_23820":103061,"_2384":103121},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2857":60100,"_25170":60074,"_17548":103123,"_5":17443,"_23820":103061,"_2384":103124},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2857":60101,"_25170":60074,"_17548":103126,"_5":17443,"_23820":103061,"_2384":103127},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2857":60102,"_25170":60102,"_5":12294,"_2384":103129,"_25506":103130,"_17548":103132,"_23820":60102},"Resolución de problemas PKI",[40848,97279,45873,103131],"Resolución de problemas",[],{"_2857":60103,"_25170":60102,"_17548":103134,"_5":17443,"_23820":60102,"_2384":103135},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2857":60104,"_25170":60102,"_5":25503,"_17548":103137,"_23820":103138,"_2384":103139},[],"/docs/pr-preview/pr-38/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2857":60105,"_25170":60102,"_5":25503,"_17548":103141,"_23820":103142,"_2384":103143},[],"/docs/pr-preview/pr-38/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2857":60106,"_25170":60102,"_5":25503,"_17548":103145,"_23820":103146,"_2384":103147},[],"/docs/pr-preview/pr-38/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2857":60107,"_25170":60102,"_17548":103149,"_5":17443,"_23820":60102,"_2384":103150},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2857":60108,"_25170":60102,"_17548":103152,"_5":17443,"_23820":60102,"_2384":103153},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2857":60109,"_25170":60102,"_17548":103155,"_5":17443,"_23820":103138,"_2384":100484},[],{"_2857":60110,"_25170":60102,"_17548":103157,"_5":17443,"_23820":103138,"_2384":99413},[],{"_2857":60111,"_25170":60102,"_17548":103159,"_5":17443,"_23820":103138,"_2384":96004},[],{"_2857":60112,"_25170":60102,"_17548":103161,"_5":17443,"_23820":103138,"_2384":48208},[],{"_2857":60113,"_25170":60102,"_17548":103163,"_5":17443,"_23820":103138,"_2384":103164},[],"Existe, está activa y sus fechas son utilizables.",{"_2857":60114,"_25170":60102,"_17548":103166,"_5":17443,"_23820":103138,"_2384":103167},[],"Autoridades.",{"_2857":60115,"_25170":60102,"_17548":103169,"_5":17443,"_23820":103138,"_2384":103170},[],"Clave",{"_2857":60116,"_25170":60102,"_17548":103172,"_5":17443,"_23820":103138,"_2384":103173},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2857":60117,"_25170":60102,"_17548":103175,"_5":17443,"_23820":103138,"_2384":103176},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2857":60118,"_25170":60102,"_17548":103178,"_5":17443,"_23820":103138,"_2384":48226},[],{"_2857":60119,"_25170":60102,"_17548":103180,"_5":17443,"_23820":103138,"_2384":103181},[],"PEM correcto y firma verificable.",{"_2857":60120,"_25170":60102,"_17548":103183,"_5":17443,"_23820":103138,"_2384":48232},[],{"_2857":60121,"_25170":60102,"_17548":103185,"_5":17443,"_23820":103138,"_2384":103186},[],"Perfil",{"_2857":60122,"_25170":60102,"_17548":103188,"_5":17443,"_23820":103138,"_2384":103189},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2857":60123,"_25170":60102,"_17548":103191,"_5":17443,"_23820":103138,"_2384":103192},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2857":60124,"_25170":60102,"_17548":103194,"_5":17443,"_23820":103138,"_2384":100636},[],{"_2857":60125,"_25170":60102,"_17548":103196,"_5":17443,"_23820":103138,"_2384":103197},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2857":60126,"_25170":60102,"_17548":103199,"_5":17443,"_23820":103138,"_2384":103200},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2857":60127,"_25170":60102,"_17548":103202,"_5":17443,"_23820":103138,"_2384":103203},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2857":60128,"_25170":60102,"_17548":103205,"_5":17443,"_23820":103138,"_2384":103206},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2857":60129,"_25170":60102,"_17548":103208,"_5":17443,"_23820":103142,"_2384":103209},[],"Revisa cada frontera por separado:",{"_2857":60130,"_25170":60102,"_17548":103211,"_5":17443,"_23820":103142,"_2384":103212},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2857":60131,"_25170":60102,"_17548":103214,"_5":17443,"_23820":103142,"_2384":103215},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2857":60132,"_25170":60102,"_17548":103217,"_5":17443,"_23820":103142,"_2384":103218},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2857":60133,"_25170":60102,"_17548":103220,"_5":17443,"_23820":103142,"_2384":103221},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2857":60134,"_25170":60102,"_17548":103223,"_5":17443,"_23820":103142,"_2384":103224},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2857":60135,"_25170":60102,"_17548":103226,"_5":17443,"_23820":103142,"_2384":103227},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2857":60136,"_25170":60102,"_17548":103229,"_5":17443,"_23820":103146,"_2384":103230},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2857":60137,"_25170":60102,"_17548":103232,"_5":17443,"_23820":103146,"_2384":103233},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_48286":103235,"_48288":103236,"_48290":103237,"_48292":103238,"_15231":2406,"_57767":2406},"spanish",[2384,25170,5,23820],{"_2384":20963,"_25170":20963,"_5":20963,"_23820":20963},{"_2384":103239,"_25170":105606,"_5":107973,"_23820":110340},{"_3827":103240,"_48296":103241,"_5":20963},{"_12039":5299,"_12382":4986,"_12389":16902,"_24371":3938,"_23933":6040,"_16648":3230,"_12060":19154,"_12067":3916,"_24333":4929,"_24683":10125,"_24704":6289,"_24346":6169,"_28968":9213,"_24715":6906,"_28973":5145,"_28976":2543,"_28979":3367,"_28982":5743,"_28985":3097,"_25016":3806,"_28990":7252,"_28992":3428,"_25076":5989,"_25006":3349,"_28996":13120,"_25032":8508,"_29000":5269,"_24733":2462,"_25011":4155,"_25094":16838,"_29005":17937,"_29007":6258,"_29009":11898,"_29011":9212,"_29013":2694,"_29015":3294,"_29017":9786,"_25228":17938,"_29020":9498,"_24384":3831,"_29023":6254,"_29025":5719,"_24378":2578,"_29028":5674,"_29030":6199,"_29032":6201,"_29035":5082,"_24414":3347,"_29039":9216,"_24324":2619,"_29042":4824,"_24351":4378,"_29045":4103,"_29047":2739,"_29050":5393,"_25071":14011,"_29053":13097,"_29055":4933,"_29058":3357,"_29060":3300,"_29062":10175,"_29064":4931,"_29066":5062,"_16651":2692,"_29069":9496,"_29071":6203,"_29073":6293,"_24727":4232,"_29076":3799,"_29078":2545,"_29080":2454,"_29082":20244,"_29084":2643,"_29086":4861,"_29088":2622,"_25156":16032,"_24754":3000,"_29092":5681,"_29094":7081,"_24362":2768,"_29097":5893,"_29099":2706,"_29101":5789,"_25099":8015,"_29104":3931,"_29106":6142,"_29108":4023,"_29110":5765,"_29112":6907,"_24460":3311,"_29117":20965,"_24721":20966,"_29120":2838,"_29122":3830,"_29124":21844,"_29126":2677,"_29128":4048,"_29130":3361,"_24454":2808,"_24688":6218,"_29134":7505,"_25044":5821,"_29138":2763,"_29140":5108,"_29142":8369,"_29144":4122,"_29146":4169,"_29148":6192,"_29151":6270,"_29153":16869,"_29155":5780,"_29157":4213,"_29159":2632,"_29162":14349,"_29164":11034,"_29167":21225,"_29170":2618,"_29172":4