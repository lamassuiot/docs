"_33663":48257,"_33665":48260,"_33667":48263,"_33669":48266,"_33671":48269,"_33673":48272,"_33675":48275,"_33677":48278,"_33679":48281},{"_2857":15,"_25170":15,"_5":12294,"_2384":40847,"_25506":40848,"_17548":40852,"_23820":15},"Deploy from AWS Marketplace",[40849,40850,40851],"Docs","Deployment","Other models",[],{"_2857":16,"_25170":15,"_17548":40854,"_5":17443,"_23820":15,"_2384":40855},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2857":17,"_25170":15,"_5":25503,"_17548":40857,"_23820":40858,"_2384":40859},[],"/docs/pr-preview/pr-38/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2857":18,"_25170":15,"_5":25503,"_17548":40861,"_23820":40862,"_2384":40863},[],"/docs/pr-preview/pr-38/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2857":19,"_25170":15,"_5":25503,"_17548":40865,"_23820":40866,"_2384":40867},[],"/docs/pr-preview/pr-38/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2857":20,"_25170":15,"_5":25503,"_17548":40869,"_23820":40870,"_2384":40871},[],"/docs/pr-preview/pr-38/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2857":21,"_25170":15,"_5":25503,"_17548":40873,"_23820":40874,"_2384":40875},[],"/docs/pr-preview/pr-38/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2857":22,"_25170":15,"_5":25503,"_17548":40877,"_23820":40878,"_2384":40879},[],"/docs/pr-preview/pr-38/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2857":23,"_25170":15,"_5":25503,"_17548":40881,"_23820":40882,"_2384":40883},[],"/docs/pr-preview/pr-38/deployment/aws-marketplace#next-step","Next step",{"_2857":24,"_25170":15,"_17548":40885,"_5":17443,"_23820":15,"_2384":40886},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2857":25,"_25170":15,"_17548":40888,"_5":17443,"_23820":40858,"_2384":40889},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2857":26,"_25170":15,"_17548":40891,"_5":17443,"_23820":40858,"_2384":40892},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2857":27,"_25170":15,"_17548":40894,"_5":17443,"_23820":40858,"_2384":40895},[],"A security group allowing the necessary endpoints.",{"_2857":28,"_25170":15,"_17548":40897,"_5":17443,"_23820":40862,"_2384":40898},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2857":29,"_25170":15,"_17548":40900,"_5":17443,"_23820":40862,"_2384":40901},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2857":30,"_25170":15,"_17548":40903,"_5":17443,"_23820":40862,"_2384":40904},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2857":31,"_25170":15,"_17548":40906,"_5":17443,"_23820":40866,"_2384":40907},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2857":32,"_25170":15,"_17548":40909,"_5":17443,"_23820":40870,"_2384":40910},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2857":33,"_25170":15,"_17548":40912,"_5":17443,"_23820":40874,"_2384":40913},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2857":34,"_25170":15,"_17548":40915,"_5":17443,"_23820":40878,"_2384":40916},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2857":35,"_25170":15,"_17548":40918,"_5":17443,"_23820":40882,"_2384":40919},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2857":36,"_25170":36,"_5":12294,"_2384":40921,"_25506":40922,"_17548":40923,"_23820":36},"Deploy Lamassu",[40849,40850],[],{"_2857":37,"_25170":36,"_17548":40925,"_5":17443,"_23820":36,"_2384":40926},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2857":38,"_25170":36,"_5":25503,"_17548":40928,"_23820":40929,"_2384":40930},[],"/docs/pr-preview/pr-38/deployment/overview#choose-a-model","Choose a model",{"_2857":39,"_25170":36,"_5":25503,"_17548":40932,"_23820":40933,"_2384":40934},[],"/docs/pr-preview/pr-38/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2857":40,"_25170":36,"_5":25503,"_17548":40936,"_23820":40937,"_2384":40938},[],"/docs/pr-preview/pr-38/deployment/overview#after-deployment","After deployment",{"_2857":41,"_25170":36,"_17548":40940,"_5":17443,"_23820":36,"_2384":40941},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2857":42,"_25170":36,"_17548":40943,"_5":17443,"_23820":40929,"_2384":40944},[],"Model",{"_2857":43,"_25170":36,"_17548":40946,"_5":17443,"_23820":40929,"_2384":40947},[],"Recommended for",{"_2857":44,"_25170":36,"_17548":40949,"_5":17443,"_23820":40929,"_2384":40950},[],"Who operates the infrastructure",{"_2857":45,"_25170":36,"_17548":40952,"_5":17443,"_23820":40929,"_2384":40953},[],"Starting point",{"_2857":46,"_25170":36,"_17548":40955,"_5":17443,"_23820":40929,"_2384":40956},[],"Kubernetes self-managed",{"_2857":47,"_25170":36,"_17548":40958,"_5":17443,"_23820":40929,"_2384":40959},[],"Production, regulated environments and custom deployments",{"_2857":48,"_25170":36,"_17548":40961,"_5":17443,"_23820":40929,"_2384":40962},[],"Your team",{"_2857":49,"_25170":36,"_17548":40964,"_5":17443,"_23820":40929,"_2384":40965},[],"Helm or Fastlane",{"_2857":50,"_25170":36,"_17548":40967,"_5":17443,"_23820":40929,"_2384":40968},[],"AWS Marketplace",{"_2857":51,"_25170":36,"_17548":40970,"_5":17443,"_23820":40929,"_2384":40971},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2857":52,"_25170":36,"_17548":40973,"_5":17443,"_23820":40929,"_2384":40962},[],{"_2857":53,"_25170":36,"_17548":40975,"_5":17443,"_23820":40929,"_2384":40976},[],"Preconfigured image on EC2",{"_2857":54,"_25170":36,"_17548":40978,"_5":17443,"_23820":40929,"_2384":40979},[],"SaaS",{"_2857":55,"_25170":36,"_17548":40981,"_5":17443,"_23820":40929,"_2384":40982},[],"Teams that want to use the platform without operating it",{"_2857":56,"_25170":36,"_17548":40984,"_5":17443,"_23820":40929,"_2384":40985},[],"Lamassu",{"_2857":57,"_25170":36,"_17548":40987,"_5":17443,"_23820":40929,"_2384":40988},[],"Managed subscription",{"_2857":58,"_25170":36,"_17548":40990,"_5":17443,"_23820":40929,"_2384":40991},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2857":59,"_25170":36,"_17548":40993,"_5":17443,"_23820":40929,"_2384":40994},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2857":60,"_25170":36,"_17548":40996,"_5":17443,"_23820":40929,"_2384":40997},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2857":61,"_25170":36,"_17548":40999,"_5":17443,"_23820":40933,"_2384":41000},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2857":62,"_25170":36,"_17548":41002,"_5":17443,"_23820":40937,"_2384":41003},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2857":63,"_25170":63,"_5":12294,"_2384":41005,"_25506":41006,"_17548":41007,"_23820":63},"Use Lamassu as SaaS",[40849,40850,40851],[],{"_2857":64,"_25170":63,"_17548":41009,"_5":17443,"_23820":63,"_2384":41010},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2857":65,"_25170":63,"_5":25503,"_17548":41012,"_23820":41013,"_2384":41014},[],"/docs/pr-preview/pr-38/deployment/saas#what-the-service-manages","What the service manages",{"_2857":66,"_25170":63,"_5":25503,"_17548":41016,"_23820":41017,"_2384":41018},[],"/docs/pr-preview/pr-38/deployment/saas#plans","Plans",{"_2857":67,"_25170":63,"_5":25503,"_17548":41020,"_23820":41021,"_2384":41022},[],"/docs/pr-preview/pr-38/deployment/saas#request-access","Request access",{"_2857":68,"_25170":63,"_17548":41024,"_5":17443,"_23820":63,"_2384":41025},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2857":69,"_25170":63,"_17548":41027,"_5":17443,"_23820":41013,"_2384":41028},[],"Platform availability and maintenance.",{"_2857":70,"_25170":63,"_17548":41030,"_5":17443,"_23820":41013,"_2384":41031},[],"Automatic backups.",{"_2857":71,"_25170":63,"_17548":41033,"_5":17443,"_23820":41013,"_2384":41034},[],"Version upgrades.",{"_2857":72,"_25170":63,"_17548":41036,"_5":17443,"_23820":41013,"_2384":41037},[],"Technical support and SLA according to your plan.",{"_2857":73,"_25170":63,"_17548":41039,"_5":17443,"_23820":41017,"_2384":41040},[],"Plan",{"_2857":74,"_25170":63,"_17548":41042,"_5":17443,"_23820":41017,"_2384":41043},[],"Devices",{"_2857":75,"_25170":63,"_17548":41045,"_5":17443,"_23820":41017,"_2384":41046},[],"Support",{"_2857":76,"_25170":63,"_17548":41048,"_5":17443,"_23820":41017,"_2384":41049},[],"SLA",{"_2857":77,"_25170":63,"_17548":41051,"_5":17443,"_23820":41017,"_2384":41052},[],"Starter",{"_2857":78,"_25170":63,"_17548":41054,"_5":17443,"_23820":41017,"_2384":41055},[],"Up to 1,000",{"_2857":79,"_25170":63,"_17548":41057,"_5":17443,"_23820":41017,"_2384":41058},[],"Email",{"_2857":80,"_25170":63,"_17548":41060,"_5":17443,"_23820":41017,"_2384":41061},[],"99.5 %",{"_2857":81,"_25170":63,"_17548":41063,"_5":17443,"_23820":41017,"_2384":41064},[],"Professional",{"_2857":82,"_25170":63,"_17548":41066,"_5":17443,"_23820":41017,"_2384":41067},[],"Up to 10,000",{"_2857":83,"_25170":63,"_17548":41069,"_5":17443,"_23820":41017,"_2384":41070},[],"Email and chat",{"_2857":84,"_25170":63,"_17548":41072,"_5":17443,"_23820":41017,"_2384":41073},[],"99.9 %",{"_2857":85,"_25170":63,"_17548":41075,"_5":17443,"_23820":41017,"_2384":41076},[],"Enterprise",{"_2857":86,"_25170":63,"_17548":41078,"_5":17443,"_23820":41017,"_2384":41079},[],"Unlimited",{"_2857":87,"_25170":63,"_17548":41081,"_5":17443,"_23820":41017,"_2384":41082},[],"Dedicated",{"_2857":88,"_25170":63,"_17548":41084,"_5":17443,"_23820":41017,"_2384":41085},[],"99.99 %",{"_2857":89,"_25170":63,"_17548":41087,"_5":17443,"_23820":41021,"_2384":41088},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2857":90,"_25170":63,"_17548":41090,"_5":17443,"_23820":41021,"_2384":41091},[],"When you receive your instance's credentials, continue with Get started.",{"_2857":91,"_25170":91,"_5":12294,"_2384":41093,"_25506":41094,"_17548":41095,"_23820":91},"Fastlane",[40849,40850,40956],[],{"_2857":92,"_25170":91,"_17548":41097,"_5":17443,"_23820":91,"_2384":41098},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2857":93,"_25170":91,"_5":25503,"_17548":41100,"_23820":41101,"_2384":41102},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2857":94,"_25170":91,"_5":25503,"_17548":41104,"_23820":41105,"_2384":41106},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2857":95,"_25170":91,"_5":25503,"_17548":41108,"_23820":41109,"_2384":40859},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#before-you-begin",{"_2857":96,"_25170":91,"_5":25503,"_17548":41111,"_23820":41112,"_2384":41113},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2857":97,"_25170":91,"_5":25503,"_17548":41115,"_23820":41116,"_2384":41117},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2857":98,"_25170":91,"_5":25503,"_17548":41119,"_23820":41120,"_2384":41121},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2857":99,"_25170":91,"_5":25503,"_17548":41123,"_23820":41124,"_2384":41125},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2857":100,"_25170":91,"_5":25503,"_17548":41127,"_23820":41128,"_2384":41129},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2857":101,"_25170":91,"_5":25503,"_17548":41131,"_23820":41132,"_2384":41133},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2857":102,"_25170":91,"_5":25503,"_17548":41135,"_23820":41136,"_2384":41137},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2857":103,"_25170":91,"_17548":41139,"_5":17443,"_23820":41101,"_2384":41140},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2857":104,"_25170":91,"_17548":41142,"_5":17443,"_23820":41101,"_2384":41143},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2857":105,"_25170":91,"_17548":41145,"_5":17443,"_23820":41105,"_2384":41146},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2857":106,"_25170":91,"_17548":41148,"_5":17443,"_23820":41105,"_2384":41149},[],"Fastlane installs or configures",{"_2857":107,"_25170":91,"_17548":41151,"_5":17443,"_23820":41105,"_2384":41152},[],"You still provide",{"_2857":108,"_25170":91,"_17548":41154,"_5":17443,"_23820":41105,"_2384":41155},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2857":109,"_25170":91,"_17548":41157,"_5":17443,"_23820":41105,"_2384":41158},[],"The Kubernetes cluster, nodes and persistent storage",{"_2857":110,"_25170":91,"_17548":41160,"_5":17443,"_23820":41105,"_2384":41161},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2857":111,"_25170":91,"_17548":41163,"_5":17443,"_23820":41105,"_2384":41164},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2857":112,"_25170":91,"_17548":41166,"_5":17443,"_23820":41105,"_2384":41167},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2857":113,"_25170":91,"_17548":41169,"_5":17443,"_23820":41105,"_2384":41170},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2857":114,"_25170":91,"_17548":41172,"_5":17443,"_23820":41105,"_2384":41173},[],"Optional observability and lab HSM components",{"_2857":115,"_25170":91,"_17548":41175,"_5":17443,"_23820":41105,"_2384":41176},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2857":116,"_25170":91,"_17548":41178,"_5":17443,"_23820":41105,"_2384":41179},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2857":117,"_25170":91,"_17548":41181,"_5":17443,"_23820":41109,"_2384":41182},[],"You need:",{"_2857":118,"_25170":91,"_17548":41184,"_5":17443,"_23820":41109,"_2384":41185},[],"an existing Kubernetes cluster",{"_2857":119,"_25170":91,"_17548":41187,"_5":17443,"_23820":41109,"_2384":41188},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2857":120,"_25170":91,"_17548":41190,"_5":17443,"_23820":41109,"_2384":41191},[],"`yq`",{"_2857":121,"_25170":91,"_17548":41193,"_5":17443,"_23820":41109,"_2384":19868},[],{"_2857":122,"_25170":91,"_17548":41195,"_5":17443,"_23820":41109,"_2384":41196},[],"`jq` only when using `--sample-data`",{"_2857":123,"_25170":91,"_17548":41198,"_5":17443,"_23820":41109,"_2384":41199},[],"free external ports 80 and 443 on a single-node K3s host",{"_2857":124,"_25170":91,"_17548":41201,"_5":17443,"_23820":41109,"_2384":41202},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2857":125,"_25170":91,"_17548":41204,"_5":17443,"_23820":41109,"_2384":41205},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2857":126,"_25170":91,"_17548":41207,"_5":17443,"_23820":41112,"_2384":41208},[],"Run the script from a clone of the Helm repository:",{"_2857":127,"_25170":91,"_17548":41210,"_5":17443,"_23820":41112,"_2384":41211},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2857":128,"_25170":91,"_17548":41213,"_5":17443,"_23820":41116,"_2384":41214},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2857":129,"_25170":91,"_17548":41216,"_5":17443,"_23820":41116,"_2384":41217},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2857":130,"_25170":91,"_17548":41219,"_5":17443,"_23820":41116,"_2384":41220},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2857":131,"_25170":91,"_17548":41222,"_5":17443,"_23820":41116,"_2384":41223},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2857":132,"_25170":91,"_17548":41225,"_5":17443,"_23820":41120,"_2384":41226},[],"Option",{"_2857":133,"_25170":91,"_17548":41228,"_5":17443,"_23820":41120,"_2384":41229},[],"Default",{"_2857":134,"_25170":91,"_17548":41231,"_5":17443,"_23820":41120,"_2384":41232},[],"Purpose",{"_2857":135,"_25170":91,"_17548":41234,"_5":17443,"_23820":41120,"_2384":41235},[],"`-h`, `--help`",{"_2857":136,"_25170":91,"_17548":41237,"_5":17443,"_23820":41120,"_2384":41238},[],"—",{"_2857":137,"_25170":91,"_17548":41240,"_5":17443,"_23820":41120,"_2384":41241},[],"Show help",{"_2857":138,"_25170":91,"_17548":41243,"_5":17443,"_23820":41120,"_2384":41244},[],"`-c`, `--context`",{"_2857":139,"_25170":91,"_17548":41246,"_5":17443,"_23820":41120,"_2384":41247},[],"current context",{"_2857":140,"_25170":91,"_17548":41249,"_5":17443,"_23820":41120,"_2384":41250},[],"Select the kubeconfig context for kubectl and Helm",{"_2857":141,"_25170":91,"_17548":41252,"_5":17443,"_23820":41120,"_2384":41253},[],"`-n`, `--non-interactive`",{"_2857":142,"_25170":91,"_17548":41255,"_5":17443,"_23820":41120,"_2384":5349},[],{"_2857":143,"_25170":91,"_17548":41257,"_5":17443,"_23820":41120,"_2384":41258},[],"Skip prompts and generate dependency credentials",{"_2857":144,"_25170":91,"_17548":41260,"_5":17443,"_23820":41120,"_2384":41261},[],"`-ns`, `--namespace`",{"_2857":145,"_25170":91,"_17548":41263,"_5":17443,"_23820":41120,"_2384":41264},[],"`lamassu-dev`",{"_2857":146,"_25170":91,"_17548":41266,"_5":17443,"_23820":41120,"_2384":41267},[],"Namespace for the installation",{"_2857":147,"_25170":91,"_17548":41269,"_5":17443,"_23820":41120,"_2384":41270},[],"`-d`, `--domain`",{"_2857":148,"_25170":91,"_17548":41272,"_5":17443,"_23820":41120,"_2384":41273},[],"`dev.lamassu.io`",{"_2857":149,"_25170":91,"_17548":41275,"_5":17443,"_23820":41120,"_2384":41276},[],"Domain used by the UI, OIDC and certificate",{"_2857":150,"_25170":91,"_17548":41278,"_5":17443,"_23820":41120,"_2384":41279},[],"`-v`, `--version`",{"_2857":151,"_25170":91,"_17548":41281,"_5":17443,"_23820":41120,"_2384":12520},[],{"_2857":152,"_25170":91,"_17548":41283,"_5":17443,"_23820":41120,"_2384":41284},[],"Lamassu chart version",{"_2857":153,"_25170":91,"_17548":41286,"_5":17443,"_23820":41120,"_2384":41287},[],"`--https-port`",{"_2857":154,"_25170":91,"_17548":41289,"_5":17443,"_23820":41120,"_2384":41290},[],"`443`",{"_2857":155,"_25170":91,"_17548":41292,"_5":17443,"_23820":41120,"_2384":41293},[],"Gateway HTTPS listener port",{"_2857":156,"_25170":91,"_17548":41295,"_5":17443,"_23820":41120,"_2384":41296},[],"`--http-port`",{"_2857":157,"_25170":91,"_17548":41298,"_5":17443,"_23820":41120,"_2384":41299},[],"`80`",{"_2857":158,"_25170":91,"_17548":41301,"_5":17443,"_23820":41120,"_2384":41302},[],"Gateway HTTP listener port",{"_2857":159,"_25170":91,"_17548":41304,"_5":17443,"_23820":41120,"_2384":41305},[],"`--tls-crt`",{"_2857":160,"_25170":91,"_17548":41307,"_5":17443,"_23820":41120,"_2384":41238},[],{"_2857":161,"_25170":91,"_17548":41309,"_5":17443,"_23820":41120,"_2384":41310},[],"PEM certificate for downstream TLS",{"_2857":162,"_25170":91,"_17548":41312,"_5":17443,"_23820":41120,"_2384":41313},[],"`--tls-key`",{"_2857":163,"_25170":91,"_17548":41315,"_5":17443,"_23820":41120,"_2384":41238},[],{"_2857":164,"_25170":91,"_17548":41317,"_5":17443,"_23820":41120,"_2384":41318},[],"PEM private key for downstream TLS",{"_2857":165,"_25170":91,"_17548":41320,"_5":17443,"_23820":41120,"_2384":41321},[],"`-l`, `--local-chart-path`",{"_2857":166,"_25170":91,"_17548":41323,"_5":17443,"_23820":41120,"_2384":41324},[],"repository chart",{"_2857":167,"_25170":91,"_17548":41326,"_5":17443,"_23820":41120,"_2384":41327},[],"Use an unpacked local Lamassu chart",{"_2857":168,"_25170":91,"_17548":41329,"_5":17443,"_23820":41120,"_2384":41330},[],"`-ip`, `--gateway-ip`",{"_2857":169,"_25170":91,"_17548":41332,"_5":17443,"_23820":41120,"_2384":7261},[],{"_2857":170,"_25170":91,"_17548":41334,"_5":17443,"_23820":41120,"_2384":41335},[],"Override the address written to `gateway.addresses`",{"_2857":171,"_25170":91,"_17548":41337,"_5":17443,"_23820":41120,"_2384":41338},[],"`--otel`",{"_2857":172,"_25170":91,"_17548":41340,"_5":17443,"_23820":41120,"_2384":5349},[],{"_2857":173,"_25170":91,"_17548":41342,"_5":17443,"_23820":41120,"_2384":41343},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2857":174,"_25170":91,"_17548":41345,"_5":17443,"_23820":41120,"_2384":41346},[],"`--sample-data`",{"_2857":175,"_25170":91,"_17548":41348,"_5":17443,"_23820":41120,"_2384":5349},[],{"_2857":176,"_25170":91,"_17548":41350,"_5":17443,"_23820":41120,"_2384":41351},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2857":177,"_25170":91,"_17548":41353,"_5":17443,"_23820":41120,"_2384":41354},[],"`--with-hsm`",{"_2857":178,"_25170":91,"_17548":41356,"_5":17443,"_23820":41120,"_2384":5349},[],{"_2857":179,"_25170":91,"_17548":41358,"_5":17443,"_23820":41120,"_2384":41359},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2857":180,"_25170":91,"_17548":41361,"_5":17443,"_23820":41120,"_2384":41362},[],"`--softhsm-chart-path`",{"_2857":181,"_25170":91,"_17548":41364,"_5":17443,"_23820":41120,"_2384":41365},[],"`./charts/softhsm`",{"_2857":182,"_25170":91,"_17548":41367,"_5":17443,"_23820":41120,"_2384":41368},[],"Use a different local SoftHSM chart",{"_2857":183,"_25170":91,"_17548":41370,"_5":17443,"_23820":41120,"_2384":41371},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2857":184,"_25170":91,"_17548":41373,"_5":17443,"_23820":41124,"_2384":41374},[],"Fastlane:",{"_2857":185,"_25170":91,"_17548":41376,"_5":17443,"_23820":41124,"_2384":41377},[],"validates local tools and the selected cluster",{"_2857":186,"_25170":91,"_17548":41379,"_5":17443,"_23820":41124,"_2384":41380},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2857":187,"_25170":91,"_17548":41382,"_5":17443,"_23820":41124,"_2384":41383},[],"creates the namespace",{"_2857":188,"_25170":91,"_17548":41385,"_5":17443,"_23820":41124,"_2384":41386},[],"installs PostgreSQL and creates the required databases",{"_2857":189,"_25170":91,"_17548":41388,"_5":17443,"_23820":41124,"_2384":41389},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2857":190,"_25170":91,"_17548":41391,"_5":17443,"_23820":41124,"_2384":41392},[],"installs RabbitMQ",{"_2857":191,"_25170":91,"_17548":41394,"_5":17443,"_23820":41124,"_2384":41395},[],"optionally installs observability and lab HSM components",{"_2857":192,"_25170":91,"_17548":41397,"_5":17443,"_23820":41124,"_2384":41398},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2857":193,"_25170":91,"_17548":41400,"_5":17443,"_23820":41124,"_2384":41401},[],"optionally loads sample data",{"_2857":194,"_25170":91,"_17548":41403,"_5":17443,"_23820":41124,"_2384":41404},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2857":195,"_25170":91,"_17548":41406,"_5":17443,"_23820":41128,"_2384":41407},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2857":196,"_25170":91,"_17548":41409,"_5":17443,"_23820":41128,"_2384":41410},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2857":197,"_25170":91,"_17548":41412,"_5":17443,"_23820":41132,"_2384":41413},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2857":198,"_25170":91,"_17548":41415,"_5":17443,"_23820":41132,"_2384":41416},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2857":199,"_25170":91,"_17548":41418,"_5":17443,"_23820":41132,"_2384":41419},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2857":200,"_25170":91,"_17548":41421,"_5":17443,"_23820":41136,"_2384":41422},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2857":201,"_25170":201,"_5":12294,"_2384":41424,"_25506":41425,"_17548":41426,"_23820":201},"Install with Helm",[40849,40850,40956],[],{"_2857":202,"_25170":201,"_17548":41428,"_5":17443,"_23820":201,"_2384":41429},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2857":203,"_25170":201,"_5":25503,"_17548":41431,"_23820":41432,"_2384":41433},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2857":204,"_25170":201,"_5":25503,"_17548":41435,"_23820":41436,"_2384":40859},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#before-you-begin",{"_2857":205,"_25170":201,"_5":25503,"_17548":41438,"_23820":41439,"_2384":41440},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2857":206,"_25170":201,"_5":25503,"_17548":41442,"_23820":41443,"_2384":41444},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2857":207,"_25170":201,"_5":25503,"_17548":41446,"_23820":41447,"_2384":41448},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2857":208,"_25170":201,"_5":25503,"_17548":41450,"_23820":41451,"_2384":41452},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2857":209,"_25170":201,"_5":25503,"_17548":41454,"_23820":41455,"_2384":41456},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2857":210,"_25170":201,"_5":25503,"_17548":41458,"_23820":41459,"_2384":41460},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2857":211,"_25170":201,"_5":25503,"_17548":41462,"_23820":41463,"_2384":41464},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2857":212,"_25170":201,"_17548":41466,"_5":17443,"_23820":41432,"_2384":41467},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2857":213,"_25170":201,"_17548":41469,"_5":17443,"_23820":41436,"_2384":41470},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2857":214,"_25170":201,"_17548":41472,"_5":17443,"_23820":41436,"_2384":41473},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2857":215,"_25170":201,"_17548":41475,"_5":17443,"_23820":41436,"_2384":41476},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2857":216,"_25170":201,"_17548":41478,"_5":17443,"_23820":41436,"_2384":41479},[],"a reachable RabbitMQ broker and credentials",{"_2857":217,"_25170":201,"_17548":41481,"_5":17443,"_23820":41436,"_2384":41482},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2857":218,"_25170":201,"_17548":41484,"_5":17443,"_23820":41436,"_2384":41485},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2857":219,"_25170":201,"_17548":41487,"_5":17443,"_23820":41436,"_2384":41488},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2857":220,"_25170":201,"_17548":41490,"_5":17443,"_23820":41436,"_2384":41491},[],"a StorageClass and an external traffic design",{"_2857":221,"_25170":201,"_17548":41493,"_5":17443,"_23820":41436,"_2384":41494},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2857":222,"_25170":201,"_17548":41496,"_5":17443,"_23820":41436,"_2384":41497},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2857":223,"_25170":201,"_17548":41499,"_5":17443,"_23820":41436,"_2384":41500},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2857":224,"_25170":201,"_17548":41502,"_5":17443,"_23820":41439,"_2384":41503},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2857":225,"_25170":201,"_17548":41505,"_5":17443,"_23820":41439,"_2384":41506},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2857":226,"_25170":201,"_17548":41508,"_5":17443,"_23820":41439,"_2384":41509},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2857":227,"_25170":201,"_17548":41511,"_5":17443,"_23820":41443,"_2384":41512},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2857":228,"_25170":201,"_17548":41514,"_5":17443,"_23820":41443,"_2384":41515},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2857":229,"_25170":201,"_17548":41517,"_5":17443,"_23820":41443,"_2384":41518},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2857":230,"_25170":201,"_17548":41520,"_5":17443,"_23820":41447,"_2384":41521},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2857":231,"_25170":201,"_17548":41523,"_5":17443,"_23820":41451,"_2384":41524},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2857":232,"_25170":201,"_17548":41526,"_5":17443,"_23820":41451,"_2384":41527},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2857":233,"_25170":201,"_17548":41529,"_5":17443,"_23820":41451,"_2384":41530},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2857":234,"_25170":201,"_17548":41532,"_5":17443,"_23820":41451,"_2384":41533},[],"See Access control for the principal and policy model.",{"_2857":235,"_25170":201,"_17548":41535,"_5":17443,"_23820":41455,"_2384":41536},[],"To install a local checkout instead:",{"_2857":236,"_25170":201,"_17548":41538,"_5":17443,"_23820":41459,"_2384":41539},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2857":237,"_25170":201,"_17548":41541,"_5":17443,"_23820":41459,"_2384":41542},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2857":238,"_25170":201,"_17548":41544,"_5":17443,"_23820":41463,"_2384":41545},[],"Before going live, review:",{"_2857":239,"_25170":201,"_17548":41547,"_5":17443,"_23820":41463,"_2384":41548},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2857":240,"_25170":201,"_17548":41550,"_5":17443,"_23820":41463,"_2384":41551},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2857":241,"_25170":201,"_17548":41553,"_5":17443,"_23820":41463,"_2384":41554},[],"shared VA storage before increasing VA replicas",{"_2857":242,"_25170":201,"_17548":41556,"_5":17443,"_23820":41463,"_2384":41557},[],"managed OIDC roles and removal of evaluation credentials",{"_2857":243,"_25170":201,"_17548":41559,"_5":17443,"_23820":41463,"_2384":41560},[],"a trusted TLS issuer or externally managed certificate",{"_2857":244,"_25170":201,"_17548":41562,"_5":17443,"_23820":41463,"_2384":41563},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2857":245,"_25170":201,"_17548":41565,"_5":17443,"_23820":41463,"_2384":41566},[],"SMTP, observability and alert delivery",{"_2857":246,"_25170":201,"_17548":41568,"_5":17443,"_23820":41463,"_2384":41569},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2857":247,"_25170":201,"_17548":41571,"_5":17443,"_23820":41463,"_2384":41572},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2857":248,"_25170":248,"_5":12294,"_2384":41574,"_25506":41575,"_17548":41576,"_23820":248},"Expose the Gateway",[40849,40850,40956],[],{"_2857":249,"_25170":248,"_17548":41578,"_5":17443,"_23820":248,"_2384":41579},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2857":250,"_25170":248,"_5":25503,"_17548":41581,"_23820":41582,"_2384":41583},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2857":251,"_25170":248,"_5":25503,"_17548":41585,"_23820":41586,"_2384":41587},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2857":252,"_25170":248,"_5":25503,"_17548":41589,"_23820":41590,"_2384":41591},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2857":253,"_25170":248,"_5":25503,"_17548":41593,"_23820":41594,"_2384":41595},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#k3s","K3s",{"_2857":254,"_25170":248,"_5":25503,"_17548":41597,"_23820":41598,"_2384":41599},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2857":255,"_25170":248,"_5":25503,"_17548":41601,"_23820":41602,"_2384":41603},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2857":256,"_25170":248,"_5":25503,"_17548":41605,"_23820":41606,"_2384":41607},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2857":257,"_25170":248,"_5":25503,"_17548":41609,"_23820":41610,"_2384":41611},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2857":258,"_25170":248,"_5":25503,"_17548":41613,"_23820":41614,"_2384":41615},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2857":259,"_25170":248,"_17548":41617,"_5":17443,"_23820":41582,"_2384":41618},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2857":260,"_25170":248,"_17548":41620,"_5":17443,"_23820":41582,"_2384":41621},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2857":261,"_25170":248,"_17548":41623,"_5":17443,"_23820":41586,"_2384":41624},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2857":262,"_25170":248,"_17548":41626,"_5":17443,"_23820":41586,"_2384":41627},[],"Set it only when:",{"_2857":263,"_25170":248,"_17548":41629,"_5":17443,"_23820":41586,"_2384":41630},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2857":264,"_25170":248,"_17548":41632,"_5":17443,"_23820":41586,"_2384":41633},[],"that address is allocated to this Gateway",{"_2857":265,"_25170":248,"_17548":41635,"_5":17443,"_23820":41586,"_2384":41636},[],"the surrounding network already routes traffic for it to the cluster",{"_2857":266,"_25170":248,"_17548":41638,"_5":17443,"_23820":41586,"_2384":41639},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2857":267,"_25170":248,"_17548":41641,"_5":17443,"_23820":41586,"_2384":41642},[],"Keep these two settings separate:",{"_2857":268,"_25170":248,"_17548":41644,"_5":17443,"_23820":41586,"_2384":41645},[],"`gateway.addresses` requests an address for the Gateway.",{"_2857":269,"_25170":248,"_17548":41647,"_5":17443,"_23820":41586,"_2384":41648},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2857":270,"_25170":248,"_17548":41650,"_5":17443,"_23820":41586,"_2384":41651},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2857":271,"_25170":248,"_17548":41653,"_5":17443,"_23820":41590,"_2384":41654},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2857":272,"_25170":248,"_17548":41656,"_5":17443,"_23820":41590,"_2384":41657},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2857":273,"_25170":248,"_17548":41659,"_5":17443,"_23820":41594,"_2384":41660},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2857":274,"_25170":248,"_17548":41662,"_5":17443,"_23820":41594,"_2384":41663},[],"For the recommended design:",{"_2857":275,"_25170":248,"_17548":41665,"_5":17443,"_23820":41594,"_2384":41666},[],"Use only one externally exposed Lamassu Gateway.",{"_2857":276,"_25170":248,"_17548":41668,"_5":17443,"_23820":41594,"_2384":41669},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2857":277,"_25170":248,"_17548":41671,"_5":17443,"_23820":41594,"_2384":41672},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2857":278,"_25170":248,"_17548":41674,"_5":17443,"_23820":41594,"_2384":41675},[],"Point DNS at the VM's reachable address.",{"_2857":279,"_25170":248,"_17548":41677,"_5":17443,"_23820":41594,"_2384":41678},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2857":280,"_25170":248,"_17548":41680,"_5":17443,"_23820":41598,"_2384":41681},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2857":281,"_25170":248,"_17548":41683,"_5":17443,"_23820":41602,"_2384":41684},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2857":282,"_25170":248,"_17548":41686,"_5":17443,"_23820":41602,"_2384":41687},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2857":283,"_25170":248,"_17548":41689,"_5":17443,"_23820":41606,"_2384":41690},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2857":284,"_25170":248,"_17548":41692,"_5":17443,"_23820":41606,"_2384":41693},[],"Requirement",{"_2857":285,"_25170":248,"_17548":41695,"_5":17443,"_23820":41606,"_2384":41696},[],"Recommended design",{"_2857":286,"_25170":248,"_17548":41698,"_5":17443,"_23820":41606,"_2384":41699},[],"Consequence",{"_2857":287,"_25170":248,"_17548":41701,"_5":17443,"_23820":41606,"_2384":41702},[],"Several Lamassu URLs or services",{"_2857":288,"_25170":248,"_17548":41704,"_5":17443,"_23820":41606,"_2384":41705},[],"One Gateway with multiple routes",{"_2857":289,"_25170":248,"_17548":41707,"_5":17443,"_23820":41606,"_2384":41708},[],"One IP and one proxy fleet; this is the chart default",{"_2857":290,"_25170":248,"_17548":41710,"_5":17443,"_23820":41606,"_2384":41711},[],"Independent Gateways and separate external IPs",{"_2857":291,"_25170":248,"_17548":41713,"_5":17443,"_23820":41606,"_2384":41714},[],"One VIP per Gateway",{"_2857":292,"_25170":248,"_17548":41716,"_5":17443,"_23820":41606,"_2384":41717},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2857":293,"_25170":248,"_17548":41719,"_5":17443,"_23820":41606,"_2384":41720},[],"Independent Gateways on one node and one IP",{"_2857":294,"_25170":248,"_17548":41722,"_5":17443,"_23820":41606,"_2384":41723},[],"Use different external ports",{"_2857":295,"_25170":248,"_17548":41725,"_5":17443,"_23820":41606,"_2384":41726},[],"Clients must include non-standard ports",{"_2857":296,"_25170":248,"_17548":41728,"_5":17443,"_23820":41606,"_2384":41729},[],"Separate TLS/mTLS termination behind one IP",{"_2857":297,"_25170":248,"_17548":41731,"_5":17443,"_23820":41606,"_2384":41732},[],"Front-door SNI routing to internal Gateways",{"_2857":298,"_25170":248,"_17548":41734,"_5":17443,"_23820":41606,"_2384":41735},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2857":299,"_25170":248,"_17548":41737,"_5":17443,"_23820":41606,"_2384":41738},[],"Separate Gateway resources but shared proxy infrastructure",{"_2857":300,"_25170":248,"_17548":41740,"_5":17443,"_23820":41606,"_2384":41741},[],"Envoy merged-Gateway mode",{"_2857":301,"_25170":248,"_17548":41743,"_5":17443,"_23820":41606,"_2384":41744},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2857":302,"_25170":248,"_17548":41746,"_5":17443,"_23820":41606,"_2384":41747},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2857":303,"_25170":248,"_17548":41749,"_5":17443,"_23820":41606,"_2384":41750},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2857":304,"_25170":248,"_17548":41752,"_5":17443,"_23820":41606,"_2384":41753},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2857":305,"_25170":248,"_17548":41755,"_5":17443,"_23820":41606,"_2384":41756},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2857":306,"_25170":248,"_17548":41758,"_5":17443,"_23820":41610,"_2384":41759},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2857":307,"_25170":248,"_17548":41761,"_5":17443,"_23820":41610,"_2384":41762},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2857":308,"_25170":248,"_17548":41764,"_5":17443,"_23820":41610,"_2384":41765},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2857":309,"_25170":248,"_17548":41767,"_5":17443,"_23820":41610,"_2384":41768},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2857":310,"_25170":248,"_17548":41770,"_5":17443,"_23820":41610,"_2384":41771},[],"If none of those are possible, use different external ports or change the external network design.",{"_2857":311,"_25170":248,"_17548":41773,"_5":17443,"_23820":41614,"_2384":41774},[],"Check, in order:",{"_2857":312,"_25170":248,"_17548":41776,"_5":17443,"_23820":41614,"_2384":41777},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2857":313,"_25170":248,"_17548":41779,"_5":17443,"_23820":41614,"_2384":41780},[],"Its status contains the expected address.",{"_2857":314,"_25170":248,"_17548":41782,"_5":17443,"_23820":41614,"_2384":41783},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2857":315,"_25170":248,"_17548":41785,"_5":17443,"_23820":41614,"_2384":41786},[],"Port 443 reaches that address from the client network.",{"_2857":316,"_25170":248,"_17548":41788,"_5":17443,"_23820":41614,"_2384":41789},[],"DNS resolves to the externally reachable endpoint.",{"_2857":317,"_25170":248,"_17548":41791,"_5":17443,"_23820":41614,"_2384":41792},[],"The certificate contains the DNS name or IP used by the client.",{"_2857":318,"_25170":248,"_17548":41794,"_5":17443,"_23820":41614,"_2384":41795},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2857":319,"_25170":319,"_5":12294,"_2384":40956,"_25506":41797,"_17548":41798,"_23820":319},[40849,40850,40956],[],{"_2857":320,"_25170":319,"_17548":41800,"_5":17443,"_23820":319,"_2384":41801},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2857":321,"_25170":319,"_5":25503,"_17548":41803,"_23820":41804,"_2384":41805},[],"/docs/pr-preview/pr-38/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2857":322,"_25170":319,"_5":25503,"_17548":41807,"_23820":41808,"_2384":41809},[],"/docs/pr-preview/pr-38/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2857":323,"_25170":319,"_5":25503,"_17548":41811,"_23820":41812,"_2384":41813},[],"/docs/pr-preview/pr-38/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2857":324,"_25170":319,"_5":25503,"_17548":41815,"_23820":41816,"_2384":41817},[],"/docs/pr-preview/pr-38/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2857":325,"_25170":319,"_5":25503,"_17548":41819,"_23820":41820,"_2384":41821},[],"/docs/pr-preview/pr-38/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2857":326,"_25170":319,"_5":25503,"_17548":41823,"_23820":41824,"_2384":41825},[],"/docs/pr-preview/pr-38/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2857":327,"_25170":319,"_17548":41827,"_5":17443,"_23820":41804,"_2384":41828},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2857":328,"_25170":319,"_17548":41830,"_5":17443,"_23820":41808,"_2384":41831},[],"Workflow",{"_2857":329,"_25170":319,"_17548":41833,"_5":17443,"_23820":41808,"_2384":41834},[],"Use it for",{"_2857":330,"_25170":319,"_17548":41836,"_5":17443,"_23820":41808,"_2384":41837},[],"What it installs",{"_2857":331,"_25170":319,"_17548":41839,"_5":17443,"_23820":41808,"_2384":41840},[],"Helm",{"_2857":332,"_25170":319,"_17548":41842,"_5":17443,"_23820":41808,"_2384":41843},[],"Production and controlled environments",{"_2857":333,"_25170":319,"_17548":41845,"_5":17443,"_23820":41808,"_2384":41846},[],"Lamassu services and Gateway API resources",{"_2857":334,"_25170":319,"_17548":41848,"_5":17443,"_23820":41808,"_2384":41093},[],{"_2857":335,"_25170":319,"_17548":41850,"_5":17443,"_23820":41808,"_2384":41851},[],"Evaluation, demos, CI and small lab clusters",{"_2857":336,"_25170":319,"_17548":41853,"_5":17443,"_23820":41808,"_2384":41854},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2857":337,"_25170":319,"_17548":41856,"_5":17443,"_23820":41812,"_2384":41857},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2857":338,"_25170":319,"_17548":41859,"_5":17443,"_23820":41812,"_2384":41860},[],"Area",{"_2857":339,"_25170":319,"_17548":41862,"_5":17443,"_23820":41812,"_2384":41863},[],"The Lamassu chart provides",{"_2857":340,"_25170":319,"_17548":41865,"_5":17443,"_23820":41812,"_2384":41866},[],"You provide",{"_2857":341,"_25170":319,"_17548":41868,"_5":17443,"_23820":41812,"_2384":41869},[],"Lamassu applications",{"_2857":342,"_25170":319,"_17548":41871,"_5":17443,"_23820":41812,"_2384":41872},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2857":343,"_25170":319,"_17548":41874,"_5":17443,"_23820":41812,"_2384":41875},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2857":344,"_25170":319,"_17548":41877,"_5":17443,"_23820":41812,"_2384":41878},[],"PostgreSQL data",{"_2857":345,"_25170":319,"_17548":41880,"_5":17443,"_23820":41812,"_2384":41881},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2857":346,"_25170":319,"_17548":41883,"_5":17443,"_23820":41812,"_2384":41884},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2857":347,"_25170":319,"_17548":41886,"_5":17443,"_23820":41812,"_2384":41887},[],"Messaging",{"_2857":348,"_25170":319,"_17548":41889,"_5":17443,"_23820":41812,"_2384":41890},[],"RabbitMQ connection configuration for the Lamassu services",{"_2857":349,"_25170":319,"_17548":41892,"_5":17443,"_23820":41812,"_2384":41893},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2857":350,"_25170":319,"_17548":41895,"_5":17443,"_23820":41812,"_2384":41896},[],"Identity",{"_2857":351,"_25170":319,"_17548":41898,"_5":17443,"_23820":41812,"_2384":41899},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2857":352,"_25170":319,"_17548":41901,"_5":17443,"_23820":41812,"_2384":41902},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2857":353,"_25170":319,"_17548":41904,"_5":17443,"_23820":41812,"_2384":41905},[],"External routing",{"_2857":354,"_25170":319,"_17548":41907,"_5":17443,"_23820":41812,"_2384":41908},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2857":355,"_25170":319,"_17548":41910,"_5":17443,"_23820":41812,"_2384":41911},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2857":356,"_25170":319,"_17548":41913,"_5":17443,"_23820":41812,"_2384":41914},[],"TLS",{"_2857":357,"_25170":319,"_17548":41916,"_5":17443,"_23820":41812,"_2384":41917},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2857":358,"_25170":319,"_17548":41919,"_5":17443,"_23820":41812,"_2384":41920},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2857":359,"_25170":319,"_17548":41922,"_5":17443,"_23820":41812,"_2384":41923},[],"Persistent application data",{"_2857":360,"_25170":319,"_17548":41925,"_5":17443,"_23820":41812,"_2384":41926},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2857":361,"_25170":319,"_17548":41928,"_5":17443,"_23820":41812,"_2384":41929},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2857":362,"_25170":319,"_17548":41931,"_5":17443,"_23820":41812,"_2384":41932},[],"Optional integrations",{"_2857":363,"_25170":319,"_17548":41934,"_5":17443,"_23820":41812,"_2384":41935},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2857":364,"_25170":319,"_17548":41937,"_5":17443,"_23820":41812,"_2384":41938},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2857":365,"_25170":319,"_17548":41940,"_5":17443,"_23820":41812,"_2384":41941},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2857":366,"_25170":319,"_17548":41943,"_5":17443,"_23820":41812,"_2384":41944},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2857":367,"_25170":319,"_17548":41946,"_5":17443,"_23820":41816,"_2384":41947},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2857":368,"_25170":319,"_17548":41949,"_5":17443,"_23820":41816,"_2384":41950},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2857":369,"_25170":319,"_17548":41952,"_5":17443,"_23820":41820,"_2384":41953},[],"Kubernetes 1.24 or newer",{"_2857":370,"_25170":319,"_17548":41955,"_5":17443,"_23820":41820,"_2384":41956},[],"Helm 3.2 or newer",{"_2857":371,"_25170":319,"_17548":41958,"_5":17443,"_23820":41820,"_2384":41959},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2857":372,"_25170":319,"_17548":41961,"_5":17443,"_23820":41820,"_2384":41962},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2857":373,"_25170":319,"_17548":41964,"_5":17443,"_23820":41820,"_2384":41965},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2857":374,"_25170":319,"_17548":41967,"_5":17443,"_23820":41820,"_2384":41968},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2857":375,"_25170":319,"_17548":41970,"_5":17443,"_23820":41820,"_2384":41971},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2857":376,"_25170":319,"_17548":41973,"_5":17443,"_23820":41824,"_2384":41974},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2857":377,"_25170":319,"_17548":41976,"_5":17443,"_23820":41824,"_2384":41977},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2857":378,"_25170":319,"_17548":41979,"_5":17443,"_23820":41824,"_2384":41980},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2857":379,"_25170":379,"_5":12294,"_2384":41982,"_25506":41983,"_17548":41985,"_23820":379},"Deployment troubleshooting",[40849,40850,41984],"Operations",[],{"_2857":380,"_25170":379,"_17548":41987,"_5":17443,"_23820":379,"_2384":41988},[],"Diagnose access, service health and infrastructure dependencies.",{"_2857":381,"_25170":379,"_5":25503,"_17548":41990,"_23820":41991,"_2384":41992},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2857":382,"_25170":379,"_5":25503,"_17548":41994,"_23820":41995,"_2384":41996},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2857":383,"_25170":379,"_5":25503,"_17548":41998,"_23820":41999,"_2384":42000},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2857":384,"_25170":379,"_5":25503,"_17548":42002,"_23820":42003,"_2384":42004},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2857":385,"_25170":379,"_5":25503,"_17548":42006,"_23820":42007,"_2384":42008},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2857":386,"_25170":379,"_5":25503,"_17548":42010,"_23820":42011,"_2384":42012},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2857":387,"_25170":379,"_5":25503,"_17548":42014,"_23820":42015,"_2384":42016},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2857":388,"_25170":379,"_5":25503,"_17548":42018,"_23820":42019,"_2384":42020},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2857":389,"_25170":379,"_5":25503,"_17548":42022,"_23820":42023,"_2384":42024},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2857":390,"_25170":379,"_5":25503,"_17548":42026,"_23820":42027,"_2384":42028},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2857":391,"_25170":379,"_5":25503,"_17548":42030,"_23820":42031,"_2384":42032},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2857":392,"_25170":379,"_5":25503,"_17548":42034,"_23820":42035,"_2384":42036},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#observability","Observability",{"_2857":393,"_25170":379,"_17548":42038,"_5":17443,"_23820":379,"_2384":42039},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2857":394,"_25170":379,"_17548":42041,"_5":17443,"_23820":41995,"_2384":42042},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2857":395,"_25170":379,"_17548":42044,"_5":17443,"_23820":41999,"_2384":42045},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2857":396,"_25170":379,"_17548":42047,"_5":17443,"_23820":42003,"_2384":42048},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2857":397,"_25170":379,"_17548":42050,"_5":17443,"_23820":42007,"_2384":42051},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2857":398,"_25170":379,"_17548":42053,"_5":17443,"_23820":42011,"_2384":42054},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2857":399,"_25170":379,"_17548":42056,"_5":17443,"_23820":42015,"_2384":42057},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2857":400,"_25170":379,"_17548":42059,"_5":17443,"_23820":42015,"_2384":42060},[],"Also run the chart's connectivity test:",{"_2857":401,"_25170":379,"_17548":42062,"_5":17443,"_23820":42015,"_2384":42063},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2857":402,"_25170":379,"_17548":42065,"_5":17443,"_23820":42015,"_2384":42066},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2857":403,"_25170":379,"_17548":42068,"_5":17443,"_23820":42019,"_2384":42069},[],"If you receive a 401:",{"_2857":404,"_25170":379,"_17548":42071,"_5":17443,"_23820":42019,"_2384":42072},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2857":405,"_25170":379,"_17548":42074,"_5":17443,"_23820":42019,"_2384":42075},[],"verify issuer, audience and expiration of the token;",{"_2857":406,"_25170":379,"_17548":42077,"_5":17443,"_23820":42019,"_2384":42078},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2857":407,"_25170":379,"_17548":42080,"_5":17443,"_23820":42019,"_2384":42081},[],"check that the provider's public and internal routes point to the same realm.",{"_2857":408,"_25170":379,"_17548":42083,"_5":17443,"_23820":42019,"_2384":42084},[],"If login succeeds but the APIs return 403:",{"_2857":409,"_25170":379,"_17548":42086,"_5":17443,"_23820":42019,"_2384":42087},[],"inspect the token's real claims;",{"_2857":410,"_25170":379,"_17548":42089,"_5":17443,"_23820":42019,"_2384":42090},[],"confirm they match an active principal;",{"_2857":411,"_25170":379,"_17548":42092,"_5":17443,"_23820":42019,"_2384":42093},[],"review the policies granted to that principal;",{"_2857":412,"_25170":379,"_17548":42095,"_5":17443,"_23820":42019,"_2384":42096},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2857":413,"_25170":379,"_17548":42098,"_5":17443,"_23820":42019,"_2384":42099},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2857":414,"_25170":379,"_17548":42101,"_5":17443,"_23820":42023,"_2384":42102},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2857":415,"_25170":379,"_17548":42104,"_5":17443,"_23820":42023,"_2384":42105},[],"Locate the authz pod and Service.",{"_2857":416,"_25170":379,"_17548":42107,"_5":17443,"_23820":42023,"_2384":42108},[],"Check /health, logs and its database connection.",{"_2857":417,"_25170":379,"_17548":42110,"_5":17443,"_23820":42023,"_2384":42111},[],"Verify the DNS and port configured in externalAuthorization.",{"_2857":418,"_25170":379,"_17548":42113,"_5":17443,"_23820":42023,"_2384":42114},[],"Check the check route is /v1/ext\\_authz/check.",{"_2857":419,"_25170":379,"_17548":42116,"_5":17443,"_23820":42023,"_2384":42117},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2857":420,"_25170":379,"_17548":42119,"_5":17443,"_23820":42027,"_2384":42120},[],"Review kubectl describe pod first. Common causes are:",{"_2857":421,"_25170":379,"_17548":42122,"_5":17443,"_23820":42027,"_2384":42123},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2857":422,"_25170":379,"_17548":42125,"_5":17443,"_23820":42027,"_2384":42126},[],"unbound persistent volume;",{"_2857":423,"_25170":379,"_17548":42128,"_5":17443,"_23820":42027,"_2384":42129},[],"inaccessible image or incorrect pull policy;",{"_2857":424,"_25170":379,"_17548":42131,"_5":17443,"_23820":42027,"_2384":42132},[],"invalid cryptographic engine configuration;",{"_2857":425,"_25170":379,"_17548":42134,"_5":17443,"_23820":42027,"_2384":42135},[],"CPU or memory limits set too low;",{"_2857":426,"_25170":379,"_17548":42137,"_5":17443,"_23820":42027,"_2384":42138},[],"an incomplete prior migration.",{"_2857":427,"_25170":379,"_17548":42140,"_5":17443,"_23820":42027,"_2384":42141},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2857":428,"_25170":379,"_17548":42143,"_5":17443,"_23820":42027,"_2384":42144},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2857":429,"_25170":379,"_17548":42146,"_5":17443,"_23820":42031,"_2384":42147},[],"Domain and audit events depend on the bus publisher:",{"_2857":430,"_25170":379,"_17548":42149,"_5":17443,"_23820":42031,"_2384":42150},[],"verify it is enabled in the emitting service;",{"_2857":431,"_25170":379,"_17548":42152,"_5":17443,"_23820":42031,"_2384":42153},[],"check AMQP connectivity and credentials;",{"_2857":432,"_25170":379,"_17548":42155,"_5":17443,"_23820":42031,"_2384":42156},[],"review exchange, routing key, queues and consumers;",{"_2857":433,"_25170":379,"_17548":42158,"_5":17443,"_23820":42031,"_2384":42159},[],"inspect dead-letter queues;",{"_2857":434,"_25170":379,"_17548":42161,"_5":17443,"_23820":42031,"_2384":42162},[],"alert on orphan durable queues and backlog growth.",{"_2857":435,"_25170":379,"_17548":42164,"_5":17443,"_23820":42031,"_2384":42165},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2857":436,"_25170":379,"_17548":42167,"_5":17443,"_23820":42035,"_2384":42168},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2857":437,"_25170":379,"_17548":42170,"_5":17443,"_23820":42035,"_2384":42171},[],"Before closing an incident, record:",{"_2857":438,"_25170":379,"_17548":42173,"_5":17443,"_23820":42035,"_2384":42174},[],"the confirmed cause;",{"_2857":439,"_25170":379,"_17548":42176,"_5":17443,"_23820":42035,"_2384":42177},[],"the time scope and affected resources;",{"_2857":440,"_25170":379,"_17548":42179,"_5":17443,"_23820":42035,"_2384":42180},[],"the commands or queries used;",{"_2857":441,"_25170":379,"_17548":42182,"_5":17443,"_23820":42035,"_2384":42183},[],"the applied change and how to revert it;",{"_2857":442,"_25170":379,"_17548":42185,"_5":17443,"_23820":42035,"_2384":42186},[],"validation from a consumer;",{"_2857":443,"_25170":379,"_17548":42188,"_5":17443,"_23820":42035,"_2384":42189},[],"the preventive action and its owner.",{"_2857":444,"_25170":444,"_5":12294,"_2384":42191,"_25506":42192,"_17548":42195,"_23820":444},"Access control",[40849,42193,42194],"Platform","Administration",[],{"_2857":445,"_25170":444,"_17548":42197,"_5":17443,"_23820":444,"_2384":42198},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2857":446,"_25170":444,"_5":25503,"_17548":42200,"_23820":42201,"_2384":42202},[],"/docs/pr-preview/pr-38/platform/administration/access-control#essential-concepts","Essential concepts",{"_2857":447,"_25170":444,"_5":25503,"_17548":42204,"_23820":42205,"_2384":42206},[],"/docs/pr-preview/pr-38/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2857":448,"_25170":444,"_5":25503,"_17548":42208,"_23820":42209,"_2384":42210},[],"/docs/pr-preview/pr-38/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2857":449,"_25170":444,"_5":25503,"_17548":42212,"_23820":42213,"_2384":42214},[],"/docs/pr-preview/pr-38/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2857":450,"_25170":444,"_5":25503,"_17548":42216,"_23820":42217,"_2384":42218},[],"/docs/pr-preview/pr-38/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2857":451,"_25170":444,"_5":25503,"_17548":42220,"_23820":42221,"_2384":42222},[],"/docs/pr-preview/pr-38/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2857":452,"_25170":444,"_5":25503,"_17548":42224,"_23820":42225,"_2384":42226},[],"/docs/pr-preview/pr-38/platform/administration/access-control#oidc-principals","OIDC principals",{"_2857":453,"_25170":444,"_5":25503,"_17548":42228,"_23820":42229,"_2384":42230},[],"/docs/pr-preview/pr-38/platform/administration/access-control#x509-principals","X.509 principals",{"_2857":454,"_25170":444,"_5":25503,"_17548":42232,"_23820":42233,"_2384":42234},[],"/docs/pr-preview/pr-38/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2857":455,"_25170":444,"_5":25503,"_17548":42236,"_23820":42237,"_2384":42238},[],"/docs/pr-preview/pr-38/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2857":456,"_25170":444,"_5":25503,"_17548":42240,"_23820":42241,"_2384":42242},[],"/docs/pr-preview/pr-38/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2857":457,"_25170":444,"_5":25503,"_17548":42244,"_23820":42245,"_2384":42246},[],"/docs/pr-preview/pr-38/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2857":458,"_25170":444,"_5":25503,"_17548":42248,"_23820":42249,"_2384":42250},[],"/docs/pr-preview/pr-38/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2857":459,"_25170":444,"_5":25503,"_17548":42252,"_23820":42253,"_2384":42254},[],"/docs/pr-preview/pr-38/platform/administration/access-control#http-rules","HTTP rules",{"_2857":460,"_25170":444,"_5":25503,"_17548":42256,"_23820":42257,"_2384":42258},[],"/docs/pr-preview/pr-38/platform/administration/access-control#included-policies","Included policies",{"_2857":461,"_25170":444,"_5":25503,"_17548":42260,"_23820":42261,"_2384":41452},[],"/docs/pr-preview/pr-38/platform/administration/access-control#provision-the-first-administrator",{"_2857":462,"_25170":444,"_5":25503,"_17548":42263,"_23820":42264,"_2384":42265},[],"/docs/pr-preview/pr-38/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2857":463,"_25170":444,"_5":25503,"_17548":42267,"_23820":42268,"_2384":42269},[],"/docs/pr-preview/pr-38/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2857":464,"_25170":444,"_5":25503,"_17548":42271,"_23820":42272,"_2384":42273},[],"/docs/pr-preview/pr-38/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2857":465,"_25170":444,"_5":25503,"_17548":42275,"_23820":42276,"_2384":42277},[],"/docs/pr-preview/pr-38/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2857":466,"_25170":444,"_5":25503,"_17548":42279,"_23820":42280,"_2384":42281},[],"/docs/pr-preview/pr-38/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2857":467,"_25170":444,"_5":25503,"_17548":42283,"_23820":42284,"_2384":42285},[],"/docs/pr-preview/pr-38/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2857":468,"_25170":444,"_5":25503,"_17548":42287,"_23820":42288,"_2384":42289},[],"/docs/pr-preview/pr-38/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2857":469,"_25170":444,"_5":25503,"_17548":42291,"_23820":42292,"_2384":42293},[],"/docs/pr-preview/pr-38/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2857":470,"_25170":444,"_5":25503,"_17548":42295,"_23820":42296,"_2384":42297},[],"/docs/pr-preview/pr-38/platform/administration/access-control#operational-checklist","Operational checklist",{"_2857":471,"_25170":444,"_5":25503,"_17548":42299,"_23820":42300,"_2384":42301},[],"/docs/pr-preview/pr-38/platform/administration/access-control#diagnostics","Diagnostics",{"_2857":472,"_25170":444,"_5":25503,"_17548":42303,"_23820":42304,"_2384":42305},[],"/docs/pr-preview/pr-38/platform/administration/access-control#the-response-is-401","The response is 401",{"_2857":473,"_25170":444,"_5":25503,"_17548":42307,"_23820":42308,"_2384":42309},[],"/docs/pr-preview/pr-38/platform/administration/access-control#the-response-is-403","The response is 403",{"_2857":474,"_25170":444,"_5":25503,"_17548":42311,"_23820":42312,"_2384":42313},[],"/docs/pr-preview/pr-38/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2857":475,"_25170":444,"_5":25503,"_17548":42315,"_23820":42316,"_2384":42317},[],"/docs/pr-preview/pr-38/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2857":476,"_25170":444,"_5":25503,"_17548":42319,"_23820":42320,"_2384":42321},[],"/docs/pr-preview/pr-38/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2857":477,"_25170":444,"_17548":42323,"_5":17443,"_23820":444,"_2384":42324},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2857":478,"_25170":444,"_17548":42326,"_5":17443,"_23820":444,"_2384":42327},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2857":479,"_25170":444,"_17548":42329,"_5":17443,"_23820":444,"_2384":42330},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2857":480,"_25170":444,"_17548":42332,"_5":17443,"_23820":42201,"_2384":42333},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2857":481,"_25170":444,"_17548":42335,"_5":17443,"_23820":42201,"_2384":42336},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2857":482,"_25170":444,"_17548":42338,"_5":17443,"_23820":42201,"_2384":42339},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2857":483,"_25170":444,"_17548":42341,"_5":17443,"_23820":42201,"_2384":42342},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2857":484,"_25170":444,"_17548":42344,"_5":17443,"_23820":42201,"_2384":42345},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2857":485,"_25170":444,"_17548":42347,"_5":17443,"_23820":42201,"_2384":42348},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2857":486,"_25170":444,"_17548":42350,"_5":17443,"_23820":42205,"_2384":42351},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2857":487,"_25170":444,"_17548":42353,"_5":17443,"_23820":42205,"_2384":42354},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2857":488,"_25170":444,"_17548":42356,"_5":17443,"_23820":42209,"_2384":42357},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2857":489,"_25170":444,"_17548":42359,"_5":17443,"_23820":42209,"_2384":42360},[],"The decision is made **before forwarding the request to the service**:",{"_2857":490,"_25170":444,"_17548":42362,"_5":17443,"_23820":42209,"_2384":42363},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2857":491,"_25170":444,"_17548":42365,"_5":17443,"_23820":42209,"_2384":42366},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2857":492,"_25170":444,"_17548":42368,"_5":17443,"_23820":42209,"_2384":42369},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2857":493,"_25170":444,"_17548":42371,"_5":17443,"_23820":42209,"_2384":42372},[],"It separately loads the policies granted to each principal.",{"_2857":494,"_25170":444,"_17548":42374,"_5":17443,"_23820":42209,"_2384":42375},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2857":495,"_25170":444,"_17548":42377,"_5":17443,"_23820":42209,"_2384":42378},[],"`authz` looks for an HTTP rule granting that action.",{"_2857":496,"_25170":444,"_17548":42380,"_5":17443,"_23820":42209,"_2384":42381},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2857":497,"_25170":444,"_17548":42383,"_5":17443,"_23820":42209,"_2384":42384},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2857":498,"_25170":444,"_17548":42386,"_5":17443,"_23820":42209,"_2384":42387},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_2857":499,"_25170":444,"_17548":42389,"_5":17443,"_23820":42209,"_2384":42390},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2857":500,"_25170":444,"_17548":42392,"_5":17443,"_23820":42213,"_2384":42393},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2857":501,"_25170":444,"_17548":42395,"_5":17443,"_23820":42213,"_2384":42396},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2857":502,"_25170":444,"_17548":42398,"_5":17443,"_23820":42213,"_2384":42399},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2857":503,"_25170":444,"_17548":42401,"_5":17443,"_23820":42213,"_2384":42402},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2857":504,"_25170":444,"_17548":42404,"_5":17443,"_23820":42213,"_2384":42405},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2857":505,"_25170":444,"_17548":42407,"_5":17443,"_23820":42213,"_2384":42408},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2857":506,"_25170":444,"_17548":42410,"_5":17443,"_23820":42213,"_2384":42411},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2857":507,"_25170":444,"_17548":42413,"_5":17443,"_23820":42213,"_2384":42414},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2857":508,"_25170":444,"_17548":42416,"_5":17443,"_23820":42217,"_2384":42417},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2857":509,"_25170":444,"_17548":42419,"_5":17443,"_23820":42217,"_2384":42420},[],"The decision is made with the domain operation context:",{"_2857":510,"_25170":444,"_17548":42422,"_5":17443,"_23820":42217,"_2384":42423},[],"The middleware extracts the credential and resolves the matching principals.",{"_2857":511,"_25170":444,"_17548":42425,"_5":17443,"_23820":42217,"_2384":42426},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2857":512,"_25170":444,"_17548":42428,"_5":17443,"_23820":42217,"_2384":42429},[],"`authz` gathers the entity rules of the granted policies.",{"_2857":513,"_25170":444,"_17548":42431,"_5":17443,"_23820":42217,"_2384":42432},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2857":514,"_25170":444,"_17548":42434,"_5":17443,"_23820":42217,"_2384":42435},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2857":515,"_25170":444,"_17548":42437,"_5":17443,"_23820":42217,"_2384":42438},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2857":516,"_25170":444,"_17548":42440,"_5":17443,"_23820":42217,"_2384":42441},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2857":517,"_25170":444,"_17548":42443,"_5":17443,"_23820":42217,"_2384":42444},[],"Actions fall into two groups:",{"_2857":518,"_25170":444,"_17548":42446,"_5":17443,"_23820":42217,"_2384":42447},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2857":519,"_25170":444,"_17548":42449,"_5":17443,"_23820":42217,"_2384":42450},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2857":520,"_25170":444,"_17548":42452,"_5":17443,"_23820":42217,"_2384":42453},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2857":521,"_25170":444,"_17548":42455,"_5":17443,"_23820":42221,"_2384":42456},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2857":522,"_25170":444,"_17548":42458,"_5":17443,"_23820":42221,"_2384":42459},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2857":523,"_25170":444,"_17548":42461,"_5":17443,"_23820":42221,"_2384":42462},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2857":524,"_25170":444,"_17548":42464,"_5":17443,"_23820":42225,"_2384":42465},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2857":525,"_25170":444,"_17548":42467,"_5":17443,"_23820":42225,"_2384":42468},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2857":526,"_25170":444,"_17548":42470,"_5":17443,"_23820":42225,"_2384":42471},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2857":527,"_25170":444,"_17548":42473,"_5":17443,"_23820":42225,"_2384":42474},[],"The implemented operators are:",{"_2857":528,"_25170":444,"_17548":42476,"_5":17443,"_23820":42225,"_2384":42477},[],"`equals`, for exact equality;",{"_2857":529,"_25170":444,"_17548":42479,"_5":17443,"_23820":42225,"_2384":42480},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2857":530,"_25170":444,"_17548":42482,"_5":17443,"_23820":42225,"_2384":42483},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2857":531,"_25170":444,"_17548":42485,"_5":17443,"_23820":42225,"_2384":42486},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2857":532,"_25170":444,"_17548":42488,"_5":17443,"_23820":42229,"_2384":42489},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2857":533,"_25170":444,"_17548":42491,"_5":17443,"_23820":42229,"_2384":42492},[],"The available modes are:",{"_2857":534,"_25170":444,"_17548":42494,"_5":17443,"_23820":42229,"_2384":42495},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2857":535,"_25170":444,"_17548":42497,"_5":17443,"_23820":42229,"_2384":42498},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2857":536,"_25170":444,"_17548":42500,"_5":17443,"_23820":42229,"_2384":42501},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2857":537,"_25170":444,"_17548":42503,"_5":17443,"_23820":42229,"_2384":42504},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2857":538,"_25170":444,"_17548":42506,"_5":17443,"_23820":42229,"_2384":42507},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2857":539,"_25170":444,"_17548":42509,"_5":17443,"_23820":42229,"_2384":42510},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2857":540,"_25170":444,"_17548":42512,"_5":17443,"_23820":42233,"_2384":42513},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2857":541,"_25170":444,"_17548":42515,"_5":17443,"_23820":42233,"_2384":42516},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2857":542,"_25170":444,"_17548":42518,"_5":17443,"_23820":42233,"_2384":42519},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2857":543,"_25170":444,"_17548":42521,"_5":17443,"_23820":42233,"_2384":42522},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2857":544,"_25170":444,"_17548":42524,"_5":17443,"_23820":42241,"_2384":42525},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2857":545,"_25170":444,"_17548":42527,"_5":17443,"_23820":42241,"_2384":42528},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2857":546,"_25170":444,"_17548":42530,"_5":17443,"_23820":42245,"_2384":42531},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2857":547,"_25170":444,"_17548":42533,"_5":17443,"_23820":42245,"_2384":42534},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2857":548,"_25170":444,"_17548":42536,"_5":17443,"_23820":42249,"_2384":42537},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2857":549,"_25170":444,"_17548":42539,"_5":17443,"_23820":42249,"_2384":42540},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2857":550,"_25170":444,"_17548":42542,"_5":17443,"_23820":42249,"_2384":42543},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2857":551,"_25170":444,"_17548":42545,"_5":17443,"_23820":42253,"_2384":42546},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2857":552,"_25170":444,"_17548":42548,"_5":17443,"_23820":42253,"_2384":42549},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2857":553,"_25170":444,"_17548":42551,"_5":17443,"_23820":42253,"_2384":42552},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2857":554,"_25170":444,"_17548":42554,"_5":17443,"_23820":42253,"_2384":42555},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2857":555,"_25170":444,"_17548":42557,"_5":17443,"_23820":42253,"_2384":42558},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2857":556,"_25170":444,"_17548":42560,"_5":17443,"_23820":42253,"_2384":42561},[],"Note that:",{"_2857":557,"_25170":444,"_17548":42563,"_5":17443,"_23820":42253,"_2384":42564},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2857":558,"_25170":444,"_17548":42566,"_5":17443,"_23820":42253,"_2384":42567},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2857":559,"_25170":444,"_17548":42569,"_5":17443,"_23820":42253,"_2384":42570},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2857":560,"_25170":444,"_17548":42572,"_5":17443,"_23820":42257,"_2384":42573},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2857":561,"_25170":444,"_17548":42575,"_5":17443,"_23820":42257,"_2384":42576},[],"full and read-only access to certificates and authorities;",{"_2857":562,"_25170":444,"_17548":42578,"_5":17443,"_23820":42257,"_2384":42579},[],"full and read-only access to the KMS;",{"_2857":563,"_25170":444,"_17548":42581,"_5":17443,"_23820":42257,"_2384":42582},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2857":564,"_25170":444,"_17548":42584,"_5":17443,"_23820":42257,"_2384":42585},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2857":565,"_25170":444,"_17548":42587,"_5":17443,"_23820":42257,"_2384":42588},[],"console access;",{"_2857":566,"_25170":444,"_17548":42590,"_5":17443,"_23820":42257,"_2384":42591},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2857":567,"_25170":444,"_17548":42593,"_5":17443,"_23820":42257,"_2384":42594},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2857":568,"_25170":444,"_17548":42596,"_5":17443,"_23820":42257,"_2384":42597},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2857":569,"_25170":444,"_17548":42599,"_5":17443,"_23820":42261,"_2384":42600},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2857":570,"_25170":444,"_17548":42602,"_5":17443,"_23820":42261,"_2384":42603},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2857":571,"_25170":444,"_17548":42605,"_5":17443,"_23820":42261,"_2384":42606},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2857":572,"_25170":444,"_17548":42608,"_5":17443,"_23820":42264,"_2384":42609},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2857":573,"_25170":444,"_17548":42611,"_5":17443,"_23820":42268,"_2384":42612},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2857":574,"_25170":444,"_17548":42614,"_5":17443,"_23820":42272,"_2384":42615},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2857":575,"_25170":444,"_17548":42617,"_5":17443,"_23820":42276,"_2384":42618},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2857":576,"_25170":444,"_17548":42620,"_5":17443,"_23820":42280,"_2384":42621},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2857":577,"_25170":444,"_17548":42623,"_5":17443,"_23820":42284,"_2384":42624},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2857":578,"_25170":444,"_17548":42626,"_5":17443,"_23820":42284,"_2384":42627},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2857":579,"_25170":444,"_17548":42629,"_5":17443,"_23820":42288,"_2384":42630},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2857":580,"_25170":444,"_17548":42632,"_5":17443,"_23820":42288,"_2384":42633},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2857":581,"_25170":444,"_17548":42635,"_5":17443,"_23820":42288,"_2384":42636},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2857":582,"_25170":444,"_17548":42638,"_5":17443,"_23820":42288,"_2384":42639},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2857":583,"_25170":444,"_17548":42641,"_5":17443,"_23820":42288,"_2384":42642},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2857":584,"_25170":444,"_17548":42644,"_5":17443,"_23820":42288,"_2384":42645},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2857":585,"_25170":444,"_17548":42647,"_5":17443,"_23820":42288,"_2384":42648},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2857":586,"_25170":444,"_17548":42650,"_5":17443,"_23820":42288,"_2384":42651},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2857":587,"_25170":444,"_17548":42653,"_5":17443,"_23820":42292,"_2384":42654},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2857":588,"_25170":444,"_17548":42656,"_5":17443,"_23820":42292,"_2384":42657},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2857":589,"_25170":444,"_17548":42659,"_5":17443,"_23820":42292,"_2384":42660},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2857":590,"_25170":444,"_17548":42662,"_5":17443,"_23820":42296,"_2384":42663},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2857":591,"_25170":444,"_17548":42665,"_5":17443,"_23820":42296,"_2384":42666},[],"Use groups or stable roles for people and independent identities for automations.",{"_2857":592,"_25170":444,"_17548":42668,"_5":17443,"_23820":42296,"_2384":42669},[],"Keep at least two recovery administrators and test their access periodically.",{"_2857":593,"_25170":444,"_17548":42671,"_5":17443,"_23820":42296,"_2384":42672},[],"Review active principals, their matches and their grants after IdP changes.",{"_2857":594,"_25170":444,"_17548":42674,"_5":17443,"_23820":42296,"_2384":42675},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2857":595,"_25170":444,"_17548":42677,"_5":17443,"_23820":42296,"_2384":42678},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2857":596,"_25170":444,"_17548":42680,"_5":17443,"_23820":42296,"_2384":42681},[],"Always test one allowed and one denied operation for each role.",{"_2857":597,"_25170":444,"_17548":42683,"_5":17443,"_23820":42296,"_2384":42684},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2857":598,"_25170":444,"_17548":42686,"_5":17443,"_23820":42304,"_2384":42687},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2857":599,"_25170":444,"_17548":42689,"_5":17443,"_23820":42308,"_2384":42690},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2857":600,"_25170":444,"_17548":42692,"_5":17443,"_23820":42308,"_2384":42693},[],"that an active principal of the correct type exists;",{"_2857":601,"_25170":444,"_17548":42695,"_5":17443,"_23820":42308,"_2384":42696},[],"that the claim paths and values match the real token exactly;",{"_2857":602,"_25170":444,"_17548":42698,"_5":17443,"_23820":42308,"_2384":42699},[],"that all of the principal's conditions hold;",{"_2857":603,"_25170":444,"_17548":42701,"_5":17443,"_23820":42308,"_2384":42702},[],"that the principal has the expected policy granted;",{"_2857":604,"_25170":444,"_17548":42704,"_5":17443,"_23820":42308,"_2384":42705},[],"that the policy includes the action and the requested resource type or route;",{"_2857":605,"_25170":444,"_17548":42707,"_5":17443,"_23820":42308,"_2384":42708},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2857":606,"_25170":444,"_17548":42710,"_5":17443,"_23820":42308,"_2384":42711},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2857":607,"_25170":444,"_17548":42713,"_5":17443,"_23820":42312,"_2384":42714},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2857":608,"_25170":444,"_17548":42716,"_5":17443,"_23820":42316,"_2384":42717},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2857":609,"_25170":444,"_17548":42719,"_5":17443,"_23820":42320,"_2384":42720},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2857":610,"_25170":444,"_17548":42722,"_5":17443,"_23820":42320,"_2384":42723},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2857":611,"_25170":611,"_5":12294,"_2384":42725,"_25506":42726,"_17548":42727,"_23820":611},"Alerts and subscriptions",[40849,42193,42194],[],{"_2857":612,"_25170":611,"_17548":42729,"_5":17443,"_23820":611,"_2384":42730},[],"Send PKI events to people and external systems.",{"_2857":613,"_25170":611,"_5":25503,"_17548":42732,"_23820":42733,"_2384":42734},[],"/docs/pr-preview/pr-38/platform/administration/alerts#how-it-works","How it works",{"_2857":614,"_25170":611,"_5":25503,"_17548":42736,"_23820":42737,"_2384":42738},[],"/docs/pr-preview/pr-38/platform/administration/alerts#available-channels","Available channels",{"_2857":615,"_25170":611,"_5":25503,"_17548":42740,"_23820":42741,"_2384":42742},[],"/docs/pr-preview/pr-38/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2857":616,"_25170":611,"_5":25503,"_17548":42744,"_23820":42745,"_2384":42746},[],"/docs/pr-preview/pr-38/platform/administration/alerts#choose-the-event","Choose the event",{"_2857":617,"_25170":611,"_5":25503,"_17548":42748,"_23820":42749,"_2384":42750},[],"/docs/pr-preview/pr-38/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2857":618,"_25170":611,"_5":25503,"_17548":42752,"_23820":42753,"_2384":42754},[],"/docs/pr-preview/pr-38/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2857":619,"_25170":611,"_5":25503,"_17548":42756,"_23820":42757,"_2384":42758},[],"/docs/pr-preview/pr-38/platform/administration/alerts#review-and-activate","Review and activate",{"_2857":620,"_25170":611,"_5":25503,"_17548":42760,"_23820":42761,"_2384":42762},[],"/docs/pr-preview/pr-38/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_2857":621,"_25170":611,"_5":25503,"_17548":42764,"_23820":42765,"_2384":42766},[],"/docs/pr-preview/pr-38/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2857":622,"_25170":611,"_5":25503,"_17548":42768,"_23820":42769,"_2384":42770},[],"/docs/pr-preview/pr-38/platform/administration/alerts#event-families","Event families",{"_2857":623,"_25170":611,"_17548":42772,"_5":17443,"_23820":611,"_2384":42773},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2857":624,"_25170":611,"_17548":42775,"_5":17443,"_23820":42733,"_2384":42776},[],"A service publishes a domain event.",{"_2857":625,"_25170":611,"_17548":42778,"_5":17443,"_23820":42733,"_2384":42779},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2857":626,"_25170":611,"_17548":42781,"_5":17443,"_23820":42733,"_2384":42782},[],"Each subscription's filter decides whether it should be notified.",{"_2857":627,"_25170":611,"_17548":42784,"_5":17443,"_23820":42733,"_2384":42785},[],"Lamassu delivers the event to the configured channel.",{"_2857":628,"_25170":611,"_17548":42787,"_5":17443,"_23820":42733,"_2384":42788},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2857":629,"_25170":611,"_17548":42790,"_5":17443,"_23820":42737,"_2384":42791},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_2857":630,"_25170":611,"_17548":42793,"_5":17443,"_23820":42737,"_2384":42794},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2857":631,"_25170":611,"_17548":42796,"_5":17443,"_23820":42737,"_2384":42797},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2857":632,"_25170":611,"_17548":42799,"_5":17443,"_23820":42737,"_2384":42800},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_2857":633,"_25170":611,"_17548":42802,"_5":17443,"_23820":42737,"_2384":42803},[],"`apikey_options` requires `header` and `key`.",{"_2857":634,"_25170":611,"_17548":42805,"_5":17443,"_23820":42737,"_2384":42806},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2857":635,"_25170":611,"_17548":42808,"_5":17443,"_23820":42737,"_2384":42809},[],"`mtls_options` requires the inline PEM `cert_content` and `key_content`; values that reference files on the server are rejected.",{"_2857":636,"_25170":611,"_17548":42811,"_5":17443,"_23820":42737,"_2384":42812},[],"The alerts API reference documents the full `http_client` schema.",{"_2857":637,"_25170":611,"_17548":42814,"_5":17443,"_23820":42745,"_2384":42815},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2857":638,"_25170":611,"_17548":42817,"_5":17443,"_23820":42749,"_2384":42818},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2857":639,"_25170":611,"_17548":42820,"_5":17443,"_23820":42753,"_2384":42821},[],"Add a filter if you don't want to receive every instance of the event.",{"_2857":640,"_25170":611,"_17548":42823,"_5":17443,"_23820":42753,"_2384":42824},[],"**None** notifies all instances of the event.",{"_2857":641,"_25170":611,"_17548":42826,"_5":17443,"_23820":42753,"_2384":42827},[],"**JSON Path** evaluates one or more specific fields.",{"_2857":642,"_25170":611,"_17548":42829,"_5":17443,"_23820":42753,"_2384":42830},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2857":643,"_25170":611,"_17548":42832,"_5":17443,"_23820":42753,"_2384":42833},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_2857":644,"_25170":611,"_17548":42835,"_5":17443,"_23820":42753,"_2384":42836},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2857":645,"_25170":611,"_17548":42838,"_5":17443,"_23820":42757,"_2384":42839},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2857":646,"_25170":611,"_17548":42841,"_5":17443,"_23820":42761,"_2384":42842},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_2857":647,"_25170":611,"_17548":42844,"_5":17443,"_23820":42761,"_2384":42845},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_2857":648,"_25170":611,"_17548":42847,"_5":17443,"_23820":42761,"_2384":42848},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_2857":649,"_25170":611,"_17548":42850,"_5":17443,"_23820":42761,"_2384":42851},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_2857":650,"_25170":611,"_17548":42853,"_5":17443,"_23820":42761,"_2384":42854},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_2857":651,"_25170":611,"_17548":42856,"_5":17443,"_23820":42761,"_2384":42857},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_2857":652,"_25170":611,"_17548":42859,"_5":17443,"_23820":42761,"_2384":42860},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_2857":653,"_25170":611,"_17548":42862,"_5":17443,"_23820":42761,"_2384":42863},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_2857":654,"_25170":611,"_17548":42865,"_5":17443,"_23820":42765,"_2384":42866},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2857":655,"_25170":611,"_17548":42868,"_5":17443,"_23820":42769,"_2384":42869},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2857":656,"_25170":611,"_17548":42871,"_5":17443,"_23820":42769,"_2384":42872},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2857":657,"_25170":611,"_17548":42874,"_5":17443,"_23820":42769,"_2384":42875},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_2857":658,"_25170":611,"_17548":42877,"_5":17443,"_23820":42769,"_2384":42878},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2857":659,"_25170":611,"_17548":42880,"_5":17443,"_23820":42769,"_2384":42881},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2857":660,"_25170":611,"_17548":42883,"_5":17443,"_23820":42769,"_2384":42884},[],"**Validation:** `va.role.crl.create`.",{"_2857":661,"_25170":611,"_17548":42886,"_5":17443,"_23820":42769,"_2384":42887},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_2857":662,"_25170":611,"_17548":42889,"_5":17443,"_23820":42769,"_2384":42890},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2857":663,"_25170":663,"_5":12294,"_2384":42892,"_25506":42893,"_17548":42894,"_23820":663},"Audit logs",[40849,42193,42194],[],{"_2857":664,"_25170":663,"_17548":42896,"_5":17443,"_23820":663,"_2384":42897},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2857":665,"_25170":663,"_5":25503,"_17548":42899,"_23820":42900,"_2384":42901},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2857":666,"_25170":663,"_5":25503,"_17548":42903,"_23820":42904,"_2384":42905},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#coverage","Coverage",{"_2857":667,"_25170":663,"_5":25503,"_17548":42907,"_23820":42908,"_2384":42909},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2857":668,"_25170":663,"_5":25503,"_17548":42911,"_23820":42912,"_2384":42913},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2857":669,"_25170":663,"_5":25503,"_17548":42915,"_23820":42916,"_2384":42917},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2857":670,"_25170":663,"_5":25503,"_17548":42919,"_23820":42920,"_2384":42921},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2857":671,"_25170":663,"_5":25503,"_17548":42923,"_23820":42924,"_2384":42925},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2857":672,"_25170":663,"_5":25503,"_17548":42927,"_23820":42928,"_2384":42929},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2857":673,"_25170":663,"_5":25503,"_17548":42931,"_23820":42932,"_2384":42933},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2857":674,"_25170":663,"_5":25503,"_17548":42935,"_23820":42936,"_2384":42937},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2857":675,"_25170":663,"_5":25503,"_17548":42939,"_23820":42940,"_2384":42941},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2857":676,"_25170":663,"_17548":42943,"_5":17443,"_23820":663,"_2384":42944},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2857":677,"_25170":663,"_17548":42946,"_5":17443,"_23820":42900,"_2384":42947},[],"The audit body includes:",{"_2857":678,"_25170":663,"_17548":42949,"_5":17443,"_23820":42900,"_2384":42950},[],"input: data received by the operation;",{"_2857":679,"_25170":663,"_17548":42952,"_5":17443,"_23820":42900,"_2384":42953},[],"has\\_error: whether the service returned an error;",{"_2857":680,"_25170":663,"_17548":42955,"_5":17443,"_23820":42900,"_2384":42956},[],"output: produced result or error message;",{"_2857":681,"_25170":663,"_17548":42958,"_5":17443,"_23820":42900,"_2384":42959},[],"principals: identifiers of the principals that matched the request.",{"_2857":682,"_25170":663,"_17548":42961,"_5":17443,"_23820":42900,"_2384":42962},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2857":683,"_25170":663,"_17548":42964,"_5":17443,"_23820":42900,"_2384":42965},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2857":684,"_25170":663,"_17548":42967,"_5":17443,"_23820":42904,"_2384":42968},[],"The backend applies auditing to mutations of:",{"_2857":685,"_25170":663,"_17548":42970,"_5":17443,"_23820":42904,"_2384":42971},[],"authorities, certificates and issuance profiles;",{"_2857":686,"_25170":663,"_17548":42973,"_5":17443,"_23820":42904,"_2384":42974},[],"keys and KMS engines;",{"_2857":687,"_25170":663,"_17548":42976,"_5":17443,"_23820":42904,"_2384":42977},[],"devices and identities;",{"_2857":688,"_25170":663,"_17548":42979,"_5":17443,"_23820":42904,"_2384":42980},[],"DMSs and enrollment operations;",{"_2857":689,"_25170":663,"_17548":42982,"_5":17443,"_23820":42904,"_2384":42983},[],"validation functions and CRL;",{"_2857":690,"_25170":663,"_17548":42985,"_5":17443,"_23820":42904,"_2384":42986},[],"principals, policies and authorization grants.",{"_2857":691,"_25170":663,"_17548":42988,"_5":17443,"_23820":42904,"_2384":42989},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2857":692,"_25170":663,"_17548":42991,"_5":17443,"_23820":42908,"_2384":42992},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2857":693,"_25170":663,"_17548":42994,"_5":17443,"_23820":42908,"_2384":42995},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2857":694,"_25170":663,"_17548":42997,"_5":17443,"_23820":42908,"_2384":42998},[],"Design the consumer to:",{"_2857":695,"_25170":663,"_17548":43000,"_5":17443,"_23820":42908,"_2384":43001},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2857":696,"_25170":663,"_17548":43003,"_5":17443,"_23820":42908,"_2384":43004},[],"keep the complete CloudEvent unmodified;",{"_2857":697,"_25170":663,"_17548":43006,"_5":17443,"_23820":42908,"_2384":43007},[],"record the ingestion time and detect duplicates by ID;",{"_2857":698,"_25170":663,"_17548":43009,"_5":17443,"_23820":42908,"_2384":43010},[],"encrypt in transit and at rest;",{"_2857":699,"_25170":663,"_17548":43012,"_5":17443,"_23820":42908,"_2384":43013},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2857":700,"_25170":663,"_17548":43015,"_5":17443,"_23820":42908,"_2384":43016},[],"apply an explicit retention and legal hold policy;",{"_2857":701,"_25170":663,"_17548":43018,"_5":17443,"_23820":42908,"_2384":43019},[],"alert if it stops consuming or the pending queue grows.",{"_2857":702,"_25170":663,"_17548":43021,"_5":17443,"_23820":42912,"_2384":43022},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2857":703,"_25170":663,"_17548":43024,"_5":17443,"_23820":42912,"_2384":43025},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2857":704,"_25170":663,"_17548":43027,"_5":17443,"_23820":42920,"_2384":43028},[],"Start from the reported time and normalize every source to UTC.",{"_2857":705,"_25170":663,"_17548":43030,"_5":17443,"_23820":42924,"_2384":43031},[],"Filter by event type, service source and resource identifier.",{"_2857":706,"_25170":663,"_17548":43033,"_5":17443,"_23820":42928,"_2384":43034},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2857":707,"_25170":663,"_17548":43036,"_5":17443,"_23820":42932,"_2384":43037},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2857":708,"_25170":663,"_17548":43039,"_5":17443,"_23820":42936,"_2384":43040},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2857":709,"_25170":663,"_17548":43042,"_5":17443,"_23820":42940,"_2384":43043},[],"Generate a controlled mutation in a test environment and check that:",{"_2857":710,"_25170":663,"_17548":43045,"_5":17443,"_23820":42940,"_2384":43046},[],"a successful audit event appears;",{"_2857":711,"_25170":663,"_17548":43048,"_5":17443,"_23820":42940,"_2384":43049},[],"the principal matches the identity used;",{"_2857":712,"_25170":663,"_17548":43051,"_5":17443,"_23820":42940,"_2384":43052},[],"the consumer persists it exactly once;",{"_2857":713,"_25170":663,"_17548":43054,"_5":17443,"_23820":42940,"_2384":43055},[],"it can be retrieved by resource, actor and period;",{"_2857":714,"_25170":663,"_17548":43057,"_5":17443,"_23820":42940,"_2384":43058},[],"a consumer outage raises an alert.",{"_2857":715,"_25170":663,"_17548":43060,"_5":17443,"_23820":42940,"_2384":43061},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2857":716,"_25170":716,"_5":12294,"_2384":43063,"_25506":43064,"_17548":43065,"_23820":716},"Platform architecture",[40849,42193],[],{"_2857":717,"_25170":716,"_17548":43067,"_5":17443,"_23820":716,"_2384":43068},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2857":718,"_25170":716,"_5":25503,"_17548":43070,"_23820":43071,"_2384":43072},[],"/docs/pr-preview/pr-38/platform/concepts/architecture#control-plane","Control plane",{"_2857":719,"_25170":716,"_5":25503,"_17548":43074,"_23820":43075,"_2384":43076},[],"/docs/pr-preview/pr-38/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2857":720,"_25170":716,"_5":25503,"_17548":43078,"_23820":43079,"_2384":43080},[],"/docs/pr-preview/pr-38/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2857":721,"_25170":716,"_5":25503,"_17548":43082,"_23820":43083,"_2384":43084},[],"/docs/pr-preview/pr-38/platform/concepts/architecture#status-and-validation","Status and validation",{"_2857":722,"_25170":716,"_5":25503,"_17548":43086,"_23820":43087,"_2384":43088},[],"/docs/pr-preview/pr-38/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2857":723,"_25170":716,"_17548":43090,"_5":17443,"_23820":716,"_2384":43091},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2857":724,"_25170":716,"_17548":43093,"_5":17443,"_23820":716,"_2384":43094},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2857":725,"_25170":716,"_17548":43096,"_5":17443,"_23820":43071,"_2384":43097},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2857":726,"_25170":716,"_17548":43099,"_5":17443,"_23820":43075,"_2384":43100},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2857":727,"_25170":716,"_17548":43102,"_5":17443,"_23820":43079,"_2384":43103},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2857":728,"_25170":716,"_17548":43105,"_5":17443,"_23820":43083,"_2384":43106},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2857":729,"_25170":716,"_17548":43108,"_5":17443,"_23820":43087,"_2384":43109},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2857":730,"_25170":730,"_5":12294,"_2384":43111,"_25506":43112,"_17548":43113,"_23820":730},"How Lamassu works",[40849,42193],[],{"_2857":731,"_25170":730,"_17548":43115,"_5":17443,"_23820":730,"_2384":43116},[],"The mental model of trust, keys, certificates and devices.",{"_2857":732,"_25170":730,"_5":25503,"_17548":43118,"_23820":43119,"_2384":43120},[],"/docs/pr-preview/pr-38/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2857":733,"_25170":730,"_5":25503,"_17548":43122,"_23820":43123,"_2384":43124},[],"/docs/pr-preview/pr-38/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2857":734,"_25170":730,"_17548":43126,"_5":17443,"_23820":730,"_2384":43127},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2857":735,"_25170":730,"_17548":43129,"_5":17443,"_23820":43119,"_2384":43130},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2857":736,"_25170":730,"_17548":43132,"_5":17443,"_23820":43119,"_2384":43133},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2857":737,"_25170":730,"_17548":43135,"_5":17443,"_23820":43119,"_2384":43136},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2857":738,"_25170":730,"_17548":43138,"_5":17443,"_23820":43119,"_2384":43139},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2857":739,"_25170":730,"_17548":43141,"_5":17443,"_23820":43119,"_2384":43142},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2857":740,"_25170":730,"_17548":43144,"_5":17443,"_23820":43123,"_2384":43145},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2857":741,"_25170":730,"_17548":43147,"_5":17443,"_23820":43123,"_2384":43148},[],"A DMS relates that CA to an enrollment policy.",{"_2857":742,"_25170":730,"_17548":43150,"_5":17443,"_23820":43123,"_2384":43151},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2857":743,"_25170":730,"_17548":43153,"_5":17443,"_23820":43123,"_2384":43154},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2857":744,"_25170":730,"_17548":43156,"_5":17443,"_23820":43123,"_2384":43157},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2857":745,"_25170":730,"_17548":43159,"_5":17443,"_23820":43123,"_2384":43160},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2857":746,"_25170":730,"_17548":43162,"_5":17443,"_23820":43123,"_2384":43163},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2857":747,"_25170":747,"_5":12294,"_2384":43165,"_25506":43166,"_17548":43168,"_23820":747},"Devices and identities",[40849,42193,43167,43165],"IoT Fleets",[],{"_2857":748,"_25170":747,"_17548":43170,"_5":17443,"_23820":747,"_2384":43171},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2857":749,"_25170":747,"_5":25503,"_17548":43173,"_23820":43174,"_2384":43175},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#device-states","Device states",{"_2857":750,"_25170":747,"_5":25503,"_17548":43177,"_23820":43178,"_2384":43179},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2857":751,"_25170":747,"_5":25503,"_17548":43181,"_23820":43182,"_2384":43183},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2857":752,"_25170":747,"_5":25503,"_17548":43185,"_23820":43186,"_2384":43187},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2857":753,"_25170":747,"_5":25503,"_17548":43189,"_23820":43190,"_2384":43191},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2857":754,"_25170":747,"_5":25503,"_17548":43193,"_23820":43194,"_2384":43195},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2857":755,"_25170":747,"_5":25503,"_17548":43197,"_23820":43198,"_2384":43199},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2857":756,"_25170":747,"_5":25503,"_17548":43201,"_23820":43202,"_2384":43203},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2857":757,"_25170":747,"_5":25503,"_17548":43205,"_23820":43206,"_2384":43207},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2857":758,"_25170":747,"_5":25503,"_17548":43209,"_23820":43210,"_2384":43211},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2857":759,"_25170":747,"_5":25503,"_17548":43213,"_23820":43214,"_2384":43215},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2857":760,"_25170":747,"_17548":43217,"_5":17443,"_23820":747,"_2384":43218},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2857":761,"_25170":747,"_17548":43220,"_5":17443,"_23820":747,"_2384":43221},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2857":762,"_25170":747,"_17548":43223,"_5":17443,"_23820":43174,"_2384":43224},[],"Operational view",{"_2857":763,"_25170":747,"_17548":43226,"_5":17443,"_23820":43174,"_2384":43227},[],"Meaning",{"_2857":764,"_25170":747,"_17548":43229,"_5":17443,"_23820":43174,"_2384":43230},[],"**No Identity**",{"_2857":765,"_25170":747,"_17548":43232,"_5":17443,"_23820":43174,"_2384":43233},[],"A record exists without an associated identity.",{"_2857":766,"_25170":747,"_17548":43235,"_5":17443,"_23820":43174,"_2384":43236},[],"**Active**",{"_2857":767,"_25170":747,"_17548":43238,"_5":17443,"_23820":43174,"_2384":43239},[],"The slot is active; also check certificate dates, status and usages.",{"_2857":768,"_25170":747,"_17548":43241,"_5":17443,"_23820":43174,"_2384":43242},[],"**Renewal Pending**",{"_2857":769,"_25170":747,"_17548":43244,"_5":17443,"_23820":43174,"_2384":43245},[],"The identity is in the operational renewal window.",{"_2857":770,"_25170":747,"_17548":43247,"_5":17443,"_23820":43174,"_2384":43248},[],"**Expiring Soon**",{"_2857":771,"_25170":747,"_17548":43250,"_5":17443,"_23820":43174,"_2384":43251},[],"Expiration is approaching according to configured thresholds.",{"_2857":772,"_25170":747,"_17548":43253,"_5":17443,"_23820":43174,"_2384":43254},[],"**Expired**",{"_2857":773,"_25170":747,"_17548":43256,"_5":17443,"_23820":43174,"_2384":43257},[],"The identity has expired.",{"_2857":774,"_25170":747,"_17548":43259,"_5":17443,"_23820":43174,"_2384":43260},[],"**Revoked**",{"_2857":775,"_25170":747,"_17548":43262,"_5":17443,"_23820":43174,"_2384":43263},[],"The identity is marked revoked.",{"_2857":776,"_25170":747,"_17548":43265,"_5":17443,"_23820":43174,"_2384":43266},[],"**Decommissioned**",{"_2857":777,"_25170":747,"_17548":43268,"_5":17443,"_23820":43174,"_2384":43269},[],"The record is retired and ordinary updates do not restore operation.",{"_2857":778,"_25170":747,"_17548":43271,"_5":17443,"_23820":43174,"_2384":43272},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2857":779,"_25170":747,"_17548":43274,"_5":17443,"_23820":43178,"_2384":43275},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2857":780,"_25170":747,"_17548":43277,"_5":17443,"_23820":43178,"_2384":43278},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2857":781,"_25170":747,"_17548":43280,"_5":17443,"_23820":43178,"_2384":43281},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2857":782,"_25170":747,"_17548":43283,"_5":17443,"_23820":43178,"_2384":43284},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2857":783,"_25170":747,"_17548":43286,"_5":17443,"_23820":43182,"_2384":43287},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2857":784,"_25170":747,"_17548":43289,"_5":17443,"_23820":43186,"_2384":43290},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2857":785,"_25170":747,"_17548":43292,"_5":17443,"_23820":43190,"_2384":43293},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2857":786,"_25170":747,"_17548":43295,"_5":17443,"_23820":43194,"_2384":43296},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2857":787,"_25170":747,"_17548":43298,"_5":17443,"_23820":43198,"_2384":43299},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2857":788,"_25170":747,"_17548":43301,"_5":17443,"_23820":43198,"_2384":43302},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2857":789,"_25170":747,"_17548":43304,"_5":17443,"_23820":43202,"_2384":43305},[],"From **No Identity**, use **Assign Identity**:",{"_2857":790,"_25170":747,"_17548":43307,"_5":17443,"_23820":43202,"_2384":43308},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2857":791,"_25170":747,"_17548":43310,"_5":17443,"_23820":43202,"_2384":43311},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2857":792,"_25170":747,"_17548":43313,"_5":17443,"_23820":43202,"_2384":43314},[],"Confirm and read the serial, active version and history again.",{"_2857":793,"_25170":747,"_17548":43316,"_5":17443,"_23820":43202,"_2384":43317},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2857":794,"_25170":747,"_17548":43319,"_5":17443,"_23820":43202,"_2384":43320},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2857":795,"_25170":747,"_17548":43322,"_5":17443,"_23820":43206,"_2384":43323},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2857":796,"_25170":747,"_17548":43325,"_5":17443,"_23820":43206,"_2384":43326},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2857":797,"_25170":747,"_17548":43328,"_5":17443,"_23820":43210,"_2384":43329},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2857":798,"_25170":747,"_17548":43331,"_5":17443,"_23820":43210,"_2384":43332},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2857":799,"_25170":747,"_17548":43334,"_5":17443,"_23820":43210,"_2384":43335},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2857":800,"_25170":747,"_17548":43337,"_5":17443,"_23820":43210,"_2384":43338},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2857":801,"_25170":747,"_17548":43340,"_5":17443,"_23820":43214,"_2384":43341},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2857":802,"_25170":747,"_17548":43343,"_5":17443,"_23820":43214,"_2384":43344},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2857":803,"_25170":803,"_5":12294,"_2384":43346,"_25506":43347,"_17548":43349,"_23820":803},"Bootstrap identity and authentication",[40849,42193,43167,43165,43348],"Enrollment with PKI",[],{"_2857":804,"_25170":803,"_17548":43351,"_5":17443,"_23820":803,"_2384":43352},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2857":805,"_25170":803,"_5":25503,"_17548":43354,"_23820":43355,"_2384":43356},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2857":806,"_25170":803,"_5":25503,"_17548":43358,"_23820":43359,"_2384":43360},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2857":807,"_25170":803,"_5":25503,"_17548":43362,"_23820":43363,"_2384":43364},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2857":808,"_25170":803,"_5":25503,"_17548":43366,"_23820":43367,"_2384":43368},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2857":809,"_25170":803,"_5":25503,"_17548":43370,"_23820":43371,"_2384":43372},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2857":810,"_25170":803,"_17548":43374,"_5":17443,"_23820":803,"_2384":43375},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2857":811,"_25170":803,"_17548":43377,"_5":17443,"_23820":43355,"_2384":43378},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2857":812,"_25170":803,"_17548":43380,"_5":17443,"_23820":43355,"_2384":43381},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2857":813,"_25170":803,"_17548":43383,"_5":17443,"_23820":43359,"_2384":43384},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2857":814,"_25170":803,"_17548":43386,"_5":17443,"_23820":43359,"_2384":43387},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2857":815,"_25170":803,"_17548":43389,"_5":17443,"_23820":43359,"_2384":43390},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2857":816,"_25170":803,"_17548":43392,"_5":17443,"_23820":43363,"_2384":43393},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2857":817,"_25170":803,"_17548":43395,"_5":17443,"_23820":43363,"_2384":43396},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2857":818,"_25170":803,"_17548":43398,"_5":17443,"_23820":43367,"_2384":43399},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_2857":819,"_25170":803,"_17548":43401,"_5":17443,"_23820":43367,"_2384":43402},[],"Example body:",{"_2857":820,"_25170":803,"_17548":43404,"_5":17443,"_23820":43367,"_2384":43405},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2857":821,"_25170":803,"_17548":43407,"_5":17443,"_23820":43367,"_2384":43408},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2857":822,"_25170":803,"_17548":43410,"_5":17443,"_23820":43367,"_2384":43411},[],"Continuation requires a successful HTTP response and JSON:",{"_2857":823,"_25170":803,"_17548":43413,"_5":17443,"_23820":43367,"_2384":43414},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2857":824,"_25170":803,"_17548":43416,"_5":17443,"_23820":43371,"_2384":43417},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2857":825,"_25170":803,"_17548":43419,"_5":17443,"_23820":43371,"_2384":43420},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2857":826,"_25170":826,"_5":12294,"_2384":43422,"_25506":43423,"_17548":43424,"_23820":826},"Configure and operate the DMS",[40849,42193,43167,43165,43348],[],{"_2857":827,"_25170":826,"_17548":43426,"_5":17443,"_23820":826,"_2384":43427},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2857":828,"_25170":826,"_5":25503,"_17548":43429,"_23820":43430,"_2384":40859},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2857":829,"_25170":826,"_5":25503,"_17548":43432,"_23820":43433,"_2384":43434},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2857":830,"_25170":826,"_5":25503,"_17548":43436,"_23820":43437,"_2384":43438},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2857":831,"_25170":826,"_5":25503,"_17548":43440,"_23820":43441,"_2384":43442},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2857":832,"_25170":826,"_5":25503,"_17548":43444,"_23820":43445,"_2384":43446},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2857":833,"_25170":826,"_5":25503,"_17548":43448,"_23820":43449,"_2384":43450},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2857":834,"_25170":826,"_5":25503,"_17548":43452,"_23820":43453,"_2384":43454},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2857":835,"_25170":826,"_5":25503,"_17548":43456,"_23820":43457,"_2384":43458},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2857":836,"_25170":826,"_5":25503,"_17548":43460,"_23820":43461,"_2384":43462},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2857":837,"_25170":826,"_5":25503,"_17548":43464,"_23820":43465,"_2384":43466},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2857":838,"_25170":826,"_5":25503,"_17548":43468,"_23820":43469,"_2384":43470},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2857":839,"_25170":826,"_5":25503,"_17548":43472,"_23820":43473,"_2384":43474},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_2857":840,"_25170":826,"_5":25503,"_17548":43476,"_23820":43477,"_2384":43478},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2857":841,"_25170":826,"_5":25503,"_17548":43480,"_23820":43481,"_2384":43482},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2857":842,"_25170":826,"_5":25503,"_17548":43484,"_23820":43485,"_2384":43486},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2857":843,"_25170":826,"_5":25503,"_17548":43488,"_23820":43489,"_2384":43490},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2857":844,"_25170":826,"_5":25503,"_17548":43492,"_23820":43493,"_2384":43494},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2857":845,"_25170":826,"_5":25503,"_17548":43496,"_23820":43497,"_2384":43498},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2857":846,"_25170":826,"_17548":43500,"_5":17443,"_23820":826,"_2384":43501},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2857":847,"_25170":826,"_17548":43503,"_5":17443,"_23820":43430,"_2384":43504},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2857":848,"_25170":826,"_17548":43506,"_5":17443,"_23820":43430,"_2384":43507},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2857":849,"_25170":826,"_17548":43509,"_5":17443,"_23820":43437,"_2384":43510},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2857":850,"_25170":826,"_17548":43512,"_5":17443,"_23820":43441,"_2384":43513},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2857":851,"_25170":826,"_17548":43515,"_5":17443,"_23820":43445,"_2384":43516},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2857":852,"_25170":826,"_17548":43518,"_5":17443,"_23820":43449,"_2384":43519},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2857":853,"_25170":826,"_17548":43521,"_5":17443,"_23820":43453,"_2384":43522},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2857":854,"_25170":826,"_17548":43524,"_5":17443,"_23820":43461,"_2384":43525},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2857":855,"_25170":826,"_17548":43527,"_5":17443,"_23820":43461,"_2384":43528},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2857":856,"_25170":826,"_17548":43530,"_5":17443,"_23820":43465,"_2384":43531},[],"`settings.enrollment_settings` field",{"_2857":857,"_25170":826,"_17548":43533,"_5":17443,"_23820":43465,"_2384":43534},[],"Decision",{"_2857":858,"_25170":826,"_17548":43536,"_5":17443,"_23820":43465,"_2384":43537},[],"`protocol`",{"_2857":859,"_25170":826,"_17548":43539,"_5":17443,"_23820":43465,"_2384":43540},[],"`EST_RFC7030` for these operations.",{"_2857":860,"_25170":826,"_17548":43542,"_5":17443,"_23820":43465,"_2384":43543},[],"`enrollment_ca`",{"_2857":861,"_25170":826,"_17548":43545,"_5":17443,"_23820":43465,"_2384":43546},[],"ID of the signing CA.",{"_2857":862,"_25170":826,"_17548":43548,"_5":17443,"_23820":43465,"_2384":43549},[],"`verify_csr_signature`",{"_2857":863,"_25170":826,"_17548":43551,"_5":17443,"_23820":43465,"_2384":43552},[],"Keep `true` to verify CSR key possession.",{"_2857":864,"_25170":826,"_17548":43554,"_5":17443,"_23820":43465,"_2384":43555},[],"`enable_replaceable_enrollment`",{"_2857":865,"_25170":826,"_17548":43557,"_5":17443,"_23820":43465,"_2384":43558},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2857":866,"_25170":826,"_17548":43560,"_5":17443,"_23820":43465,"_2384":43561},[],"`est_rfc7030_settings.auth_mode`",{"_2857":867,"_25170":826,"_17548":43563,"_5":17443,"_23820":43465,"_2384":43564},[],"One of the four authentication modes.",{"_2857":868,"_25170":826,"_17548":43566,"_5":17443,"_23820":43465,"_2384":43567},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2857":869,"_25170":826,"_17548":43569,"_5":17443,"_23820":43469,"_2384":43570},[],"The blocks are independent:",{"_2857":870,"_25170":826,"_17548":43572,"_5":17443,"_23820":43469,"_2384":43573},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2857":871,"_25170":826,"_17548":43575,"_5":17443,"_23820":43469,"_2384":43576},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2857":872,"_25170":826,"_17548":43578,"_5":17443,"_23820":43469,"_2384":43579},[],"`auth_mode`",{"_2857":873,"_25170":826,"_17548":43581,"_5":17443,"_23820":43469,"_2384":43582},[],"Control applied in the configured operation",{"_2857":874,"_25170":826,"_17548":43584,"_5":17443,"_23820":43469,"_2384":43585},[],"`CLIENT_CERTIFICATE`",{"_2857":875,"_25170":826,"_17548":43587,"_5":17443,"_23820":43469,"_2384":43588},[],"Presented certificate validation.",{"_2857":876,"_25170":826,"_17548":43590,"_5":17443,"_23820":43469,"_2384":43591},[],"`EXTERNAL_WEBHOOK`",{"_2857":877,"_25170":826,"_17548":43593,"_5":17443,"_23820":43469,"_2384":43594},[],"Configured webhook authorization.",{"_2857":878,"_25170":826,"_17548":43596,"_5":17443,"_23820":43469,"_2384":43597},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2857":879,"_25170":826,"_17548":43599,"_5":17443,"_23820":43469,"_2384":43600},[],"Certificate validation followed by webhook approval.",{"_2857":880,"_25170":826,"_17548":43602,"_5":17443,"_23820":43469,"_2384":43603},[],"`NO_AUTH`",{"_2857":881,"_25170":826,"_17548":43605,"_5":17443,"_23820":43469,"_2384":43606},[],"No DMS requester authentication.",{"_2857":882,"_25170":826,"_17548":43608,"_5":17443,"_23820":43469,"_2384":43609},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2857":883,"_25170":826,"_17548":43611,"_5":17443,"_23820":43469,"_2384":43612},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2857":884,"_25170":826,"_17548":43614,"_5":17443,"_23820":43469,"_2384":43615},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_2857":885,"_25170":826,"_17548":43617,"_5":17443,"_23820":43469,"_2384":43618},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2857":886,"_25170":826,"_17548":43620,"_5":17443,"_23820":43473,"_2384":43621},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_2857":887,"_25170":826,"_17548":43623,"_5":17443,"_23820":43473,"_2384":43624},[],"`external_webhook_settings` field",{"_2857":888,"_25170":826,"_17548":43626,"_5":17443,"_23820":43473,"_2384":43534},[],{"_2857":889,"_25170":826,"_17548":43628,"_5":17443,"_23820":43473,"_2384":43629},[],"`url`",{"_2857":890,"_25170":826,"_17548":43631,"_5":17443,"_23820":43473,"_2384":43632},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_2857":891,"_25170":826,"_17548":43634,"_5":17443,"_23820":43473,"_2384":43635},[],"`method`",{"_2857":892,"_25170":826,"_17548":43637,"_5":17443,"_23820":43473,"_2384":43638},[],"`POST` or `PUT`; `POST` by default.",{"_2857":893,"_25170":826,"_17548":43640,"_5":17443,"_23820":43473,"_2384":43641},[],"`name`",{"_2857":894,"_25170":826,"_17548":43643,"_5":17443,"_23820":43473,"_2384":43644},[],"Label used in service logs.",{"_2857":895,"_25170":826,"_17548":43646,"_5":17443,"_23820":43473,"_2384":43647},[],"`config.auth_mode`",{"_2857":896,"_25170":826,"_17548":43649,"_5":17443,"_23820":43473,"_2384":43650},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_2857":897,"_25170":826,"_17548":43652,"_5":17443,"_23820":43473,"_2384":43653},[],"`config.apikey_options`",{"_2857":898,"_25170":826,"_17548":43655,"_5":17443,"_23820":43473,"_2384":43656},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_2857":899,"_25170":826,"_17548":43658,"_5":17443,"_23820":43473,"_2384":43659},[],"`config.jwt_options`",{"_2857":900,"_25170":826,"_17548":43661,"_5":17443,"_23820":43473,"_2384":43662},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2857":901,"_25170":826,"_17548":43664,"_5":17443,"_23820":43473,"_2384":43665},[],"`config.mtls_options`",{"_2857":902,"_25170":826,"_17548":43667,"_5":17443,"_23820":43473,"_2384":43668},[],"Required for `mtls`: `cert_content` and `key_content` as inline PEM.",{"_2857":903,"_25170":826,"_17548":43670,"_5":17443,"_23820":43473,"_2384":43671},[],"`config.insecure_skip_verify`",{"_2857":904,"_25170":826,"_17548":43673,"_5":17443,"_23820":43473,"_2384":43674},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_2857":905,"_25170":826,"_17548":43676,"_5":17443,"_23820":43473,"_2384":43677},[],"`config.call_timeout`",{"_2857":906,"_25170":826,"_17548":43679,"_5":17443,"_23820":43473,"_2384":43680},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_2857":907,"_25170":826,"_17548":43682,"_5":17443,"_23820":43473,"_2384":43683},[],"Rules for that configuration:",{"_2857":908,"_25170":826,"_17548":43685,"_5":17443,"_23820":43473,"_2384":43686},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so supply the PEM as `mtls_options.cert_content` and `key_content`.",{"_2857":909,"_25170":826,"_17548":43688,"_5":17443,"_23820":43473,"_2384":43689},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_2857":910,"_25170":826,"_17548":43691,"_5":17443,"_23820":43473,"_2384":43692},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_2857":911,"_25170":826,"_17548":43694,"_5":17443,"_23820":43473,"_2384":43695},[],"The API ignores the legacy fields `validate_server_cert`, `apikey`, `oidc` and `mtls`. A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` that still carries only the legacy option fields (`apikey`, `oidc`, `mtls`) fails validation with 400; only legacy `noauth` bodies are accepted, and their credentials are dropped.",{"_2857":912,"_25170":826,"_17548":43697,"_5":17443,"_23820":43473,"_2384":43698},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_2857":913,"_25170":826,"_17548":43700,"_5":17443,"_23820":43473,"_2384":43701},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_2857":914,"_25170":826,"_17548":43703,"_5":17443,"_23820":43473,"_2384":43704},[],"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks; if your version’s console does not expose independent settings, use the DMS API.",{"_2857":915,"_25170":826,"_17548":43706,"_5":17443,"_23820":43473,"_2384":43707},[],"Migration `20261021120000` rewrites every stored webhook config into this layout: `validate_server_cert` becomes the negated `insecure_skip_verify` (a config where `validate_server_cert` was false keeps skipping verification), `oidc` becomes `jwt_options`, `apikey` becomes `apikey_options` and `mtls` becomes `mtls_options`. When both the legacy certificate and key are PEM, they move into `mtls_options.cert_content` and `key_content` and need no action. Otherwise, including a mixed config (PEM certificate, file-path key), both values become `mtls_options.cert_file` and `key_file`. Delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are re-entered as PEM content, or the leftover file fields are removed if the webhook does not use mTLS. If your version's console does not expose those fields, edit the DMS through the DMS API.",{"_2857":916,"_25170":826,"_17548":43709,"_5":17443,"_23820":43473,"_2384":43710},[],"Migration `20261022120000` moves `reenrollment_settings.additional_validation_cas` into `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, replacing whatever the nested key held. That nested value was never consulted when validating re-enrollments, so the effective trust set is unchanged; a missing or null flat list becomes an empty list. DMSs without `reenrollment_settings` are untouched. Bodies that still carry `additional_validation_cas` are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses no longer include it. Read the DMS before sending API edits: an update body built from the old layout silently empties the migrated list.",{"_2857":917,"_25170":826,"_17548":43712,"_5":17443,"_23820":43477,"_2384":43713},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2857":918,"_25170":826,"_17548":43715,"_5":17443,"_23820":43481,"_2384":43716},[],"`settings.reenrollment_settings` field",{"_2857":919,"_25170":826,"_17548":43718,"_5":17443,"_23820":43481,"_2384":41232},[],{"_2857":920,"_25170":826,"_17548":43720,"_5":17443,"_23820":43481,"_2384":43721},[],"`reenrollment_delta`",{"_2857":921,"_25170":826,"_17548":43723,"_5":17443,"_23820":43481,"_2384":43724},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2857":922,"_25170":826,"_17548":43726,"_5":17443,"_23820":43481,"_2384":43727},[],"`preventive_delta`",{"_2857":923,"_25170":826,"_17548":43729,"_5":17443,"_23820":43481,"_2384":43730},[],"Preventive operational monitoring threshold.",{"_2857":924,"_25170":826,"_17548":43732,"_5":17443,"_23820":43481,"_2384":43733},[],"`critical_delta`",{"_2857":925,"_25170":826,"_17548":43735,"_5":17443,"_23820":43481,"_2384":43736},[],"Critical operational monitoring threshold.",{"_2857":926,"_25170":826,"_17548":43738,"_5":17443,"_23820":43481,"_2384":43739},[],"`enable_expired_renewal`",{"_2857":927,"_25170":826,"_17548":43741,"_5":17443,"_23820":43481,"_2384":43742},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2857":928,"_25170":826,"_17548":43744,"_5":17443,"_23820":43481,"_2384":43745},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_2857":929,"_25170":826,"_17548":43747,"_5":17443,"_23820":43481,"_2384":43748},[],"Additional validation CAs for the renewal mTLS credential, tried after the enrollment CA; typically populated during CA rotation while old-CA cohorts renew.",{"_2857":930,"_25170":826,"_17548":43750,"_5":17443,"_23820":43481,"_2384":43751},[],"`revoke_on_reenrollment`",{"_2857":931,"_25170":826,"_17548":43753,"_5":17443,"_23820":43481,"_2384":43754},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2857":932,"_25170":826,"_17548":43756,"_5":17443,"_23820":43481,"_2384":43757},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2857":933,"_25170":826,"_17548":43759,"_5":17443,"_23820":43485,"_2384":43760},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2857":934,"_25170":826,"_17548":43762,"_5":17443,"_23820":43489,"_2384":41226},[],{"_2857":935,"_25170":826,"_17548":43764,"_5":17443,"_23820":43489,"_2384":43765},[],"Published material",{"_2857":936,"_25170":826,"_17548":43767,"_5":17443,"_23820":43489,"_2384":43768},[],"**Include Lamassu System CA**",{"_2857":937,"_25170":826,"_17548":43770,"_5":17443,"_23820":43489,"_2384":43771},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2857":938,"_25170":826,"_17548":43773,"_5":17443,"_23820":43489,"_2384":43774},[],"**Include Enrollment CA**",{"_2857":939,"_25170":826,"_17548":43776,"_5":17443,"_23820":43489,"_2384":43777},[],"Selected issuing CA certificate.",{"_2857":940,"_25170":826,"_17548":43779,"_5":17443,"_23820":43489,"_2384":43780},[],"**Managed CAs**",{"_2857":941,"_25170":826,"_17548":43782,"_5":17443,"_23820":43489,"_2384":43783},[],"Explicitly selected CA certificates.",{"_2857":942,"_25170":826,"_17548":43785,"_5":17443,"_23820":43489,"_2384":43786},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2857":943,"_25170":826,"_17548":43788,"_5":17443,"_23820":43493,"_2384":43789},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2857":944,"_25170":826,"_17548":43791,"_5":17443,"_23820":43493,"_2384":43792},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2857":945,"_25170":826,"_17548":43794,"_5":17443,"_23820":43493,"_2384":43795},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2857":946,"_25170":826,"_17548":43797,"_5":17443,"_23820":43497,"_2384":43798},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2857":947,"_25170":947,"_5":12294,"_2384":43800,"_25506":43801,"_17548":43802,"_23820":947},"Integrate the EST client",[40849,42193,43167,43165,43348],[],{"_2857":948,"_25170":947,"_17548":43804,"_5":17443,"_23820":947,"_2384":43805},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2857":949,"_25170":947,"_5":25503,"_17548":43807,"_23820":43808,"_2384":40859},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2857":950,"_25170":947,"_5":25503,"_17548":43810,"_23820":43811,"_2384":43812},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2857":951,"_25170":947,"_5":25503,"_17548":43814,"_23820":43815,"_2384":43816},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2857":952,"_25170":947,"_5":25503,"_17548":43818,"_23820":43819,"_2384":43820},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2857":953,"_25170":947,"_5":25503,"_17548":43822,"_23820":43823,"_2384":43824},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2857":954,"_25170":947,"_5":25503,"_17548":43826,"_23820":43827,"_2384":43828},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2857":955,"_25170":947,"_17548":43830,"_5":17443,"_23820":947,"_2384":43831},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2857":956,"_25170":947,"_17548":43833,"_5":17443,"_23820":43808,"_2384":43834},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2857":957,"_25170":947,"_17548":43836,"_5":17443,"_23820":43808,"_2384":43837},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2857":958,"_25170":947,"_17548":43839,"_5":17443,"_23820":43808,"_2384":43840},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2857":959,"_25170":947,"_17548":43842,"_5":17443,"_23820":43811,"_2384":43843},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2857":960,"_25170":947,"_17548":43845,"_5":17443,"_23820":43811,"_2384":43846},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2857":961,"_25170":947,"_17548":43848,"_5":17443,"_23820":43815,"_2384":43849},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2857":962,"_25170":947,"_17548":43851,"_5":17443,"_23820":43815,"_2384":43852},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2857":963,"_25170":947,"_17548":43854,"_5":17443,"_23820":43819,"_2384":43855},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2857":964,"_25170":947,"_17548":43857,"_5":17443,"_23820":43819,"_2384":43858},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2857":965,"_25170":947,"_17548":43860,"_5":17443,"_23820":43823,"_2384":43861},[],"For a root that issues directly:",{"_2857":966,"_25170":947,"_17548":43863,"_5":17443,"_23820":43823,"_2384":43864},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2857":967,"_25170":947,"_17548":43866,"_5":17443,"_23820":43823,"_2384":43867},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2857":968,"_25170":947,"_17548":43869,"_5":17443,"_23820":43827,"_2384":43870},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2857":969,"_25170":969,"_5":12294,"_2384":43872,"_25506":43873,"_17548":43874,"_23820":969},"EST reference",[40849,42193,43167,43165,43348],[],{"_2857":970,"_25170":969,"_17548":43876,"_5":17443,"_23820":969,"_2384":43877},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2857":971,"_25170":969,"_5":25503,"_17548":43879,"_23820":43880,"_2384":43881},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2857":972,"_25170":969,"_5":25503,"_17548":43883,"_23820":43884,"_2384":19066},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2857":973,"_25170":969,"_5":25503,"_17548":43886,"_23820":43887,"_2384":21842},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2857":974,"_25170":969,"_5":25503,"_17548":43889,"_23820":43890,"_2384":21849},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2857":975,"_25170":969,"_5":25503,"_17548":43892,"_23820":43893,"_2384":21219},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2857":976,"_25170":969,"_5":25503,"_17548":43895,"_23820":43896,"_2384":43897},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2857":977,"_25170":969,"_5":25503,"_17548":43899,"_23820":43900,"_2384":43901},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2857":978,"_25170":969,"_5":25503,"_17548":43903,"_23820":43904,"_2384":43905},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2857":979,"_25170":969,"_17548":43907,"_5":17443,"_23820":969,"_2384":43908},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2857":980,"_25170":969,"_17548":43910,"_5":17443,"_23820":43880,"_2384":43911},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2857":981,"_25170":969,"_17548":43913,"_5":17443,"_23820":43880,"_2384":43914},[],"Operation",{"_2857":982,"_25170":969,"_17548":43916,"_5":17443,"_23820":43880,"_2384":43917},[],"Method",{"_2857":983,"_25170":969,"_17548":43919,"_5":17443,"_23820":43880,"_2384":43920},[],"Authentication and condition",{"_2857":984,"_25170":969,"_17548":43922,"_5":17443,"_23820":43880,"_2384":43923},[],"`/cacerts`",{"_2857":985,"_25170":969,"_17548":43925,"_5":17443,"_23820":43880,"_2384":43926},[],"GET",{"_2857":986,"_25170":969,"_17548":43928,"_5":17443,"_23820":43880,"_2384":43929},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2857":987,"_25170":969,"_17548":43931,"_5":17443,"_23820":43880,"_2384":43932},[],"`/simpleenroll`",{"_2857":988,"_25170":969,"_17548":43934,"_5":17443,"_23820":43880,"_2384":43935},[],"POST",{"_2857":989,"_25170":969,"_17548":43937,"_5":17443,"_23820":43880,"_2384":43938},[],"Initial authentication and DMS registration/replacement policy.",{"_2857":990,"_25170":969,"_17548":43940,"_5":17443,"_23820":43880,"_2384":43941},[],"`/simplereenroll`",{"_2857":991,"_25170":969,"_17548":43943,"_5":17443,"_23820":43880,"_2384":43935},[],{"_2857":992,"_25170":969,"_17548":43945,"_5":17443,"_23820":43880,"_2384":43946},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2857":993,"_25170":969,"_17548":43948,"_5":17443,"_23820":43880,"_2384":43949},[],"`/serverkeygen`",{"_2857":994,"_25170":969,"_17548":43951,"_5":17443,"_23820":43880,"_2384":43935},[],{"_2857":995,"_25170":969,"_17548":43953,"_5":17443,"_23820":43880,"_2384":43954},[],"Initial authentication and admission; server generation enabled.",{"_2857":996,"_25170":969,"_17548":43956,"_5":17443,"_23820":43880,"_2384":43957},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2857":997,"_25170":969,"_17548":43959,"_5":17443,"_23820":43884,"_2384":43960},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2857":998,"_25170":969,"_17548":43962,"_5":17443,"_23820":43884,"_2384":43963},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2857":999,"_25170":969,"_17548":43965,"_5":17443,"_23820":43887,"_2384":43966},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2857":1000,"_25170":969,"_17548":43968,"_5":17443,"_23820":43887,"_2384":43969},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2857":1001,"_25170":969,"_17548":43971,"_5":17443,"_23820":43890,"_2384":43972},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2857":1002,"_25170":969,"_17548":43974,"_5":17443,"_23820":43890,"_2384":43975},[],"The enrollment CA or a validation CA configured in the re-enrollment block validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2857":1003,"_25170":969,"_17548":43977,"_5":17443,"_23820":43893,"_2384":43978},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2857":1004,"_25170":969,"_17548":43980,"_5":17443,"_23820":43893,"_2384":43981},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2857":1005,"_25170":969,"_17548":43983,"_5":17443,"_23820":43896,"_2384":43984},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2857":1006,"_25170":969,"_17548":43986,"_5":17443,"_23820":43896,"_2384":43987},[],"Part",{"_2857":1007,"_25170":969,"_17548":43989,"_5":17443,"_23820":43896,"_2384":43990},[],"Content after decoding its Base64",{"_2857":1008,"_25170":969,"_17548":43992,"_5":17443,"_23820":43896,"_2384":43993},[],"`application/pkcs8`",{"_2857":1009,"_25170":969,"_17548":43995,"_5":17443,"_23820":43896,"_2384":43996},[],"Unencrypted DER PKCS#8 private key.",{"_2857":1010,"_25170":969,"_17548":43998,"_5":17443,"_23820":43896,"_2384":43999},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2857":1011,"_25170":969,"_17548":44001,"_5":17443,"_23820":43896,"_2384":44002},[],"DER PKCS#7 containing the issued certificate.",{"_2857":1012,"_25170":969,"_17548":44004,"_5":17443,"_23820":43896,"_2384":44005},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2857":1013,"_25170":969,"_17548":44007,"_5":17443,"_23820":43900,"_2384":44008},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2857":1014,"_25170":969,"_17548":44010,"_5":17443,"_23820":43900,"_2384":44011},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2857":1015,"_25170":969,"_17548":44013,"_5":17443,"_23820":43900,"_2384":44014},[],"Convert and check the result:",{"_2857":1016,"_25170":969,"_17548":44016,"_5":17443,"_23820":43900,"_2384":44017},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2857":1017,"_25170":969,"_17548":44019,"_5":17443,"_23820":43904,"_2384":44020},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2857":1018,"_25170":969,"_17548":44022,"_5":17443,"_23820":43904,"_2384":44023},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2857":1019,"_25170":1019,"_5":12294,"_2384":43348,"_25506":44025,"_17548":44026,"_23820":1019},[40849,42193,43167,43165,43348],[],{"_2857":1020,"_25170":1019,"_17548":44028,"_5":17443,"_23820":1019,"_2384":44029},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2857":1021,"_25170":1019,"_5":25503,"_17548":44031,"_23820":44032,"_2384":44033},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2857":1022,"_25170":1019,"_5":25503,"_17548":44035,"_23820":44036,"_2384":44037},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2857":1023,"_25170":1019,"_5":25503,"_17548":44039,"_23820":44040,"_2384":44041},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2857":1024,"_25170":1019,"_5":25503,"_17548":44043,"_23820":44044,"_2384":44045},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2857":1025,"_25170":1019,"_17548":44047,"_5":17443,"_23820":1019,"_2384":44048},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2857":1026,"_25170":1019,"_17548":44050,"_5":17443,"_23820":44032,"_2384":44051},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2857":1027,"_25170":1019,"_17548":44053,"_5":17443,"_23820":44032,"_2384":44054},[],"The integrator installs initial EST server trust and an admission credential.",{"_2857":1028,"_25170":1019,"_17548":44056,"_5":17443,"_23820":44032,"_2384":44057},[],"The client requests an identity for its `Device ID` through EST.",{"_2857":1029,"_25170":1019,"_17548":44059,"_5":17443,"_23820":44032,"_2384":44060},[],"Certificate, device binding and key/certificate installation are checked.",{"_2857":1030,"_25170":1019,"_17548":44062,"_5":17443,"_23820":44032,"_2384":44063},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2857":1031,"_25170":1019,"_17548":44065,"_5":17443,"_23820":44032,"_2384":44066},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2857":1032,"_25170":1019,"_17548":44068,"_5":17443,"_23820":44036,"_2384":44069},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2857":1033,"_25170":1019,"_17548":44071,"_5":17443,"_23820":44036,"_2384":44072},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":1034,"_25170":1019,"_17548":44074,"_5":17443,"_23820":44036,"_2384":44075},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2857":1035,"_25170":1019,"_17548":44077,"_5":17443,"_23820":44036,"_2384":44078},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2857":1036,"_25170":1019,"_17548":44080,"_5":17443,"_23820":44040,"_2384":44081},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2857":1037,"_25170":1019,"_17548":44083,"_5":17443,"_23820":44040,"_2384":44084},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2857":1038,"_25170":1019,"_17548":44086,"_5":17443,"_23820":44040,"_2384":44087},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2857":1039,"_25170":1019,"_17548":44089,"_5":17443,"_23820":44040,"_2384":44090},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2857":1040,"_25170":1019,"_17548":44092,"_5":17443,"_23820":44044,"_2384":44093},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract and migrations, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2857":1041,"_25170":1019,"_17548":44095,"_5":17443,"_23820":44044,"_2384":44096},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2857":1042,"_25170":1042,"_5":12294,"_2384":44098,"_25506":44099,"_17548":44100,"_23820":1042},"Provisioning strategies",[40849,42193,43167,43165,43348],[],{"_2857":1043,"_25170":1042,"_17548":44102,"_5":17443,"_23820":1042,"_2384":44103},[],"Choose device registration, identity authorization and key generation.",{"_2857":1044,"_25170":1042,"_5":25503,"_17548":44105,"_23820":44106,"_2384":44107},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2857":1045,"_25170":1042,"_5":25503,"_17548":44109,"_23820":44110,"_2384":44111},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2857":1046,"_25170":1042,"_5":25503,"_17548":44113,"_23820":44114,"_2384":44115},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2857":1047,"_25170":1042,"_5":25503,"_17548":44117,"_23820":44118,"_2384":44119},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2857":1048,"_25170":1042,"_5":25503,"_17548":44121,"_23820":44122,"_2384":44123},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2857":1049,"_25170":1042,"_17548":44125,"_5":17443,"_23820":1042,"_2384":44126},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2857":1050,"_25170":1042,"_17548":44128,"_5":17443,"_23820":44106,"_2384":44129},[],"Path",{"_2857":1051,"_25170":1042,"_17548":44131,"_5":17443,"_23820":44106,"_2384":44132},[],"When the device exists",{"_2857":1052,"_25170":1042,"_17548":44134,"_5":17443,"_23820":44106,"_2384":44135},[],"What to check",{"_2857":1053,"_25170":1042,"_17548":44137,"_5":17443,"_23820":44106,"_2384":44138},[],"Manual assignment",{"_2857":1054,"_25170":1042,"_17548":44140,"_5":17443,"_23820":44106,"_2384":44141},[],"An operator creates it before associating a certificate.",{"_2857":1055,"_25170":1042,"_17548":44143,"_5":17443,"_23820":44106,"_2384":44144},[],"ID, owning DMS, certificate CN and bound serial.",{"_2857":1056,"_25170":1042,"_17548":44146,"_5":17443,"_23820":44106,"_2384":44147},[],"EST with `JITP`",{"_2857":1057,"_25170":1042,"_17548":44149,"_5":17443,"_23820":44106,"_2384":44150},[],"Created for an unknown CN during `/simpleenroll`.",{"_2857":1058,"_25170":1042,"_17548":44152,"_5":17443,"_23820":44106,"_2384":44153},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2857":1059,"_25170":1042,"_17548":44155,"_5":17443,"_23820":44106,"_2384":44156},[],"EST with `PRE_REGISTRATION`",{"_2857":1060,"_25170":1042,"_17548":44158,"_5":17443,"_23820":44106,"_2384":44159},[],"Must exist before `/simpleenroll`.",{"_2857":1061,"_25170":1042,"_17548":44161,"_5":17443,"_23820":44106,"_2384":44162},[],"Approved record, same DMS and replacement conditions for your version.",{"_2857":1062,"_25170":1042,"_17548":44164,"_5":17443,"_23820":44106,"_2384":44165},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2857":1063,"_25170":1042,"_17548":44167,"_5":17443,"_23820":44106,"_2384":44168},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2857":1064,"_25170":1042,"_17548":44170,"_5":17443,"_23820":44110,"_2384":44171},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2857":1065,"_25170":1042,"_17548":44173,"_5":17443,"_23820":44110,"_2384":44174},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2857":1066,"_25170":1042,"_17548":44176,"_5":17443,"_23820":44110,"_2384":44177},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2857":1067,"_25170":1042,"_17548":44179,"_5":17443,"_23820":44114,"_2384":44180},[],"Decide initial enrollment and re-enrollment separately:",{"_2857":1068,"_25170":1042,"_17548":44182,"_5":17443,"_23820":44114,"_2384":44183},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2857":1069,"_25170":1042,"_17548":44185,"_5":17443,"_23820":44114,"_2384":44186},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2857":1070,"_25170":1042,"_17548":44188,"_5":17443,"_23820":44114,"_2384":44189},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2857":1071,"_25170":1042,"_17548":44191,"_5":17443,"_23820":44114,"_2384":44192},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2857":1072,"_25170":1042,"_17548":44194,"_5":17443,"_23820":44114,"_2384":44195},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2857":1073,"_25170":1042,"_17548":44197,"_5":17443,"_23820":44118,"_2384":41226},[],{"_2857":1074,"_25170":1042,"_17548":44199,"_5":17443,"_23820":44118,"_2384":44200},[],"Material crossing EST",{"_2857":1075,"_25170":1042,"_17548":44202,"_5":17443,"_23820":44118,"_2384":44203},[],"Device-generated key",{"_2857":1076,"_25170":1042,"_17548":44205,"_5":17443,"_23820":44118,"_2384":44206},[],"Public CSR and certificate; the key stays on the client.",{"_2857":1077,"_25170":1042,"_17548":44208,"_5":17443,"_23820":44118,"_2384":44209},[],"Existing device key",{"_2857":1078,"_25170":1042,"_17548":44211,"_5":17443,"_23820":44118,"_2384":44212},[],"CSR signed with that key and a new certificate.",{"_2857":1079,"_25170":1042,"_17548":44214,"_5":17443,"_23820":44118,"_2384":43486},[],{"_2857":1080,"_25170":1042,"_17548":44216,"_5":17443,"_23820":44118,"_2384":44217},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2857":1081,"_25170":1042,"_17548":44219,"_5":17443,"_23820":44118,"_2384":44220},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2857":1082,"_25170":1042,"_17548":44222,"_5":17443,"_23820":44122,"_2384":44223},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2857":1083,"_25170":1083,"_5":12294,"_2384":44225,"_25506":44226,"_17548":44227,"_23820":1083},"Renewal and recovery",[40849,42193,43167,43165,43348],[],{"_2857":1084,"_25170":1083,"_17548":44229,"_5":17443,"_23820":1083,"_2384":44230},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2857":1085,"_25170":1083,"_5":25503,"_17548":44232,"_23820":44233,"_2384":44234},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2857":1086,"_25170":1083,"_5":25503,"_17548":44236,"_23820":44237,"_2384":44238},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2857":1087,"_25170":1083,"_5":25503,"_17548":44240,"_23820":44241,"_2384":44242},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2857":1088,"_25170":1083,"_5":25503,"_17548":44244,"_23820":44245,"_2384":44246},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2857":1089,"_25170":1083,"_5":25503,"_17548":44248,"_23820":44249,"_2384":44250},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2857":1090,"_25170":1083,"_17548":44252,"_5":17443,"_23820":1083,"_2384":44253},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2857":1091,"_25170":1083,"_17548":44255,"_5":17443,"_23820":44233,"_2384":44256},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2857":1092,"_25170":1083,"_17548":44258,"_5":17443,"_23820":44233,"_2384":44259},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2857":1093,"_25170":1083,"_17548":44261,"_5":17443,"_23820":44233,"_2384":44262},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2857":1094,"_25170":1083,"_17548":44264,"_5":17443,"_23820":44233,"_2384":44265},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2857":1095,"_25170":1083,"_17548":44267,"_5":17443,"_23820":44237,"_2384":44268},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2857":1096,"_25170":1083,"_17548":44270,"_5":17443,"_23820":44237,"_2384":44271},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2857":1097,"_25170":1083,"_17548":44273,"_5":17443,"_23820":44241,"_2384":44274},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2857":1098,"_25170":1083,"_17548":44276,"_5":17443,"_23820":44241,"_2384":44277},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2857":1099,"_25170":1083,"_17548":44279,"_5":17443,"_23820":44241,"_2384":44280},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2857":1100,"_25170":1083,"_17548":44282,"_5":17443,"_23820":44245,"_2384":44283},[],"Situation",{"_2857":1101,"_25170":1083,"_17548":44285,"_5":17443,"_23820":44245,"_2384":44286},[],"Procedure",{"_2857":1102,"_25170":1083,"_17548":44288,"_5":17443,"_23820":44245,"_2384":44289},[],"Valid certificate, outside the window",{"_2857":1103,"_25170":1083,"_17548":44291,"_5":17443,"_23820":44245,"_2384":44292},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2857":1104,"_25170":1083,"_17548":44294,"_5":17443,"_23820":44245,"_2384":44295},[],"Expired certificate, key available",{"_2857":1105,"_25170":1083,"_17548":44297,"_5":17443,"_23820":44245,"_2384":44298},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2857":1106,"_25170":1083,"_17548":44300,"_5":17443,"_23820":44245,"_2384":44301},[],"Renewal through webhook or `NO_AUTH`",{"_2857":1107,"_25170":1083,"_17548":44303,"_5":17443,"_23820":44245,"_2384":44304},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2857":1108,"_25170":1083,"_17548":44306,"_5":17443,"_23820":44245,"_2384":44307},[],"Lost or inaccessible key",{"_2857":1109,"_25170":1083,"_17548":44309,"_5":17443,"_23820":44245,"_2384":44310},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2857":1110,"_25170":1083,"_17548":44312,"_5":17443,"_23820":44245,"_2384":44313},[],"Current identity revoked",{"_2857":1111,"_25170":1083,"_17548":44315,"_5":17443,"_23820":44245,"_2384":44316},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2857":1112,"_25170":1083,"_17548":44318,"_5":17443,"_23820":44245,"_2384":44319},[],"Device without an identity",{"_2857":1113,"_25170":1083,"_17548":44321,"_5":17443,"_23820":44245,"_2384":44322},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2857":1114,"_25170":1083,"_17548":44324,"_5":17443,"_23820":44245,"_2384":44325},[],"Retired device",{"_2857":1115,"_25170":1083,"_17548":44327,"_5":17443,"_23820":44245,"_2384":44328},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2857":1116,"_25170":1083,"_17548":44330,"_5":17443,"_23820":44245,"_2384":44331},[],"Timeout, HTTP 500 or installation failure",{"_2857":1117,"_25170":1083,"_17548":44333,"_5":17443,"_23820":44245,"_2384":44334},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2857":1118,"_25170":1083,"_17548":44336,"_5":17443,"_23820":44249,"_2384":44337},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2857":1119,"_25170":1083,"_17548":44339,"_5":17443,"_23820":44249,"_2384":44340},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2857":1120,"_25170":1120,"_5":12294,"_2384":44342,"_25506":44343,"_17548":44344,"_23820":1120},"Enrollment troubleshooting",[40849,42193,43167,43165,43348],[],{"_2857":1121,"_25170":1120,"_17548":44346,"_5":17443,"_23820":1120,"_2384":44347},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2857":1122,"_25170":1120,"_5":25503,"_17548":44349,"_23820":44350,"_2384":44351},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2857":1123,"_25170":1120,"_5":25503,"_17548":44353,"_23820":44354,"_2384":44355},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2857":1124,"_25170":1120,"_5":25503,"_17548":44357,"_23820":44358,"_2384":43905},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2857":1125,"_25170":1120,"_5":25503,"_17548":44360,"_23820":44361,"_2384":44362},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2857":1126,"_25170":1120,"_17548":44364,"_5":17443,"_23820":1120,"_2384":44365},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2857":1127,"_25170":1120,"_17548":44367,"_5":17443,"_23820":44354,"_2384":44368},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2857":1128,"_25170":1120,"_17548":44370,"_5":17443,"_23820":44354,"_2384":44371},[],"Symptom or message",{"_2857":1129,"_25170":1120,"_17548":44373,"_5":17443,"_23820":44354,"_2384":44135},[],{"_2857":1130,"_25170":1120,"_17548":44375,"_5":17443,"_23820":44354,"_2384":44376},[],"curl rejects TLS, name or issuer",{"_2857":1131,"_25170":1120,"_17548":44378,"_5":17443,"_23820":44354,"_2384":44379},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2857":1132,"_25170":1120,"_17548":44381,"_5":17443,"_23820":44354,"_2384":44382},[],"404 or missing APS",{"_2857":1133,"_25170":1120,"_17548":44384,"_5":17443,"_23820":44354,"_2384":44385},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2857":1134,"_25170":1120,"_17548":44387,"_5":17443,"_23820":44354,"_2384":44388},[],"400, CSR or format error",{"_2857":1135,"_25170":1120,"_17548":44390,"_5":17443,"_23820":44354,"_2384":44391},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2857":1136,"_25170":1120,"_17548":44393,"_5":17443,"_23820":44354,"_2384":44394},[],"Missing credential or invalid certificate",{"_2857":1137,"_25170":1120,"_17548":44396,"_5":17443,"_23820":44354,"_2384":44397},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2857":1138,"_25170":1120,"_17548":44399,"_5":17443,"_23820":44354,"_2384":44400},[],"Webhook denies, times out or responds without authorization",{"_2857":1139,"_25170":1120,"_17548":44402,"_5":17443,"_23820":44354,"_2384":44403},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2857":1140,"_25170":1120,"_17548":44405,"_5":17443,"_23820":44354,"_2384":44406},[],"`unexpected status code: <n>: redirects are not followed`",{"_2857":1141,"_25170":1120,"_17548":44408,"_5":17443,"_23820":44354,"_2384":44409},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_2857":1142,"_25170":1120,"_17548":44411,"_5":17443,"_23820":44354,"_2384":44412},[],"`webhook response exceeds 1048576 bytes`",{"_2857":1143,"_25170":1120,"_17548":44414,"_5":17443,"_23820":44354,"_2384":44415},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_2857":1144,"_25170":1120,"_17548":44417,"_5":17443,"_23820":44354,"_2384":44418},[],"`webhook config must not reference files`",{"_2857":1145,"_25170":1120,"_17548":44420,"_5":17443,"_23820":44354,"_2384":44421},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the PEM as `cert_content` and `key_content`; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the upgrade note in DMS.",{"_2857":1146,"_25170":1120,"_17548":44423,"_5":17443,"_23820":44354,"_2384":44424},[],"400 `struct validation error` creating or updating a DMS",{"_2857":1147,"_25170":1120,"_17548":44426,"_5":17443,"_23820":44354,"_2384":44427},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_2857":1148,"_25170":1120,"_17548":44429,"_5":17443,"_23820":44354,"_2384":44430},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_2857":1149,"_25170":1120,"_17548":44432,"_5":17443,"_23820":44354,"_2384":44433},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_2857":1150,"_25170":1120,"_17548":44435,"_5":17443,"_23820":44354,"_2384":44436},[],"`device not preregistered`",{"_2857":1151,"_25170":1120,"_17548":44438,"_5":17443,"_23820":44354,"_2384":44439},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2857":1152,"_25170":1120,"_17548":44441,"_5":17443,"_23820":44354,"_2384":44442},[],"`forbiddenNewEnrollment`",{"_2857":1153,"_25170":1120,"_17548":44444,"_5":17443,"_23820":44354,"_2384":44445},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2857":1154,"_25170":1120,"_17548":44447,"_5":17443,"_23820":44354,"_2384":44448},[],"Different owning DMS",{"_2857":1155,"_25170":1120,"_17548":44450,"_5":17443,"_23820":44354,"_2384":44451},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2857":1156,"_25170":1120,"_17548":44453,"_5":17443,"_23820":44354,"_2384":44454},[],"`invalid RawSubject bytes`",{"_2857":1157,"_25170":1120,"_17548":44456,"_5":17443,"_23820":44354,"_2384":44457},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2857":1158,"_25170":1120,"_17548":44459,"_5":17443,"_23820":44354,"_2384":44460},[],"`invalid reenroll window`",{"_2857":1159,"_25170":1120,"_17548":44462,"_5":17443,"_23820":44354,"_2384":44463},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2857":1160,"_25170":1120,"_17548":44465,"_5":17443,"_23820":44354,"_2384":44466},[],"Current certificate revoked",{"_2857":1161,"_25170":1120,"_17548":44468,"_5":17443,"_23820":44354,"_2384":44469},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2857":1162,"_25170":1120,"_17548":44471,"_5":17443,"_23820":44354,"_2384":44472},[],"CA, profile or signing error",{"_2857":1163,"_25170":1120,"_17548":44474,"_5":17443,"_23820":44354,"_2384":44475},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2857":1164,"_25170":1120,"_17548":44477,"_5":17443,"_23820":44354,"_2384":44478},[],"HTTP 200 without a device connection",{"_2857":1165,"_25170":1120,"_17548":44480,"_5":17443,"_23820":44354,"_2384":44481},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2857":1166,"_25170":1120,"_17548":44483,"_5":17443,"_23820":44354,"_2384":44484},[],"Timeout or error after issuance",{"_2857":1167,"_25170":1120,"_17548":44486,"_5":17443,"_23820":44354,"_2384":44487},[],"New certificates, current slot and previous identity's state before retrying.",{"_2857":1168,"_25170":1120,"_17548":44489,"_5":17443,"_23820":44358,"_2384":44490},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode after migration and Gateway behavior with expired certificates and the bootstrap CA.",{"_2857":1169,"_25170":1120,"_17548":44492,"_5":17443,"_23820":44358,"_2384":44493},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2857":1170,"_25170":1120,"_17548":44495,"_5":17443,"_23820":44361,"_2384":44496},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2857":1171,"_25170":1120,"_17548":44498,"_5":17443,"_23820":44361,"_2384":44499},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2857":1172,"_25170":1120,"_17548":44501,"_5":17443,"_23820":44361,"_2384":44502},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2857":1173,"_25170":1120,"_17548":44504,"_5":17443,"_23820":44361,"_2384":44505},[],"Make one request, save headers/body and query the device and certificates.",{"_2857":1174,"_25170":1120,"_17548":44507,"_5":17443,"_23820":44361,"_2384":44508},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2857":1175,"_25170":1120,"_17548":44510,"_5":17443,"_23820":44361,"_2384":44511},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2857":1176,"_25170":1120,"_17548":44513,"_5":17443,"_23820":44361,"_2384":44514},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2857":1177,"_25170":1177,"_5":12294,"_2384":44516,"_25506":44517,"_17548":44518,"_23820":1177},"Trust distribution and updates",[40849,42193,43167,43165,43348],[],{"_2857":1178,"_25170":1177,"_17548":44520,"_5":17443,"_23820":1177,"_2384":44521},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2857":1179,"_25170":1177,"_5":25503,"_17548":44523,"_23820":44524,"_2384":44525},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2857":1180,"_25170":1177,"_5":25503,"_17548":44527,"_23820":44528,"_2384":44529},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2857":1181,"_25170":1177,"_5":25503,"_17548":44531,"_23820":44532,"_2384":44533},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2857":1182,"_25170":1177,"_5":25503,"_17548":44535,"_23820":44536,"_2384":44537},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2857":1183,"_25170":1177,"_5":25503,"_17548":44539,"_23820":44540,"_2384":44541},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2857":1184,"_25170":1177,"_17548":44543,"_5":17443,"_23820":1177,"_2384":44544},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2857":1185,"_25170":1177,"_17548":44546,"_5":17443,"_23820":44524,"_2384":44547},[],"Relationship",{"_2857":1186,"_25170":1177,"_17548":44549,"_5":17443,"_23820":44524,"_2384":44550},[],"Material prepared by its owner",{"_2857":1187,"_25170":1177,"_17548":44552,"_5":17443,"_23820":44524,"_2384":44553},[],"Device → EST server",{"_2857":1188,"_25170":1177,"_17548":44555,"_5":17443,"_23820":44524,"_2384":44556},[],"Previously verified server root, chain or pin and TLS name.",{"_2857":1189,"_25170":1177,"_17548":44558,"_5":17443,"_23820":44524,"_2384":44559},[],"DMS → requester",{"_2857":1190,"_25170":1177,"_17548":44561,"_5":17443,"_23820":44524,"_2384":44562},[],"CAs and rules authorizing initial or renewal credentials.",{"_2857":1191,"_25170":1177,"_17548":44564,"_5":17443,"_23820":44524,"_2384":44565},[],"Consumer → device",{"_2857":1192,"_25170":1177,"_17548":44567,"_5":17443,"_23820":44524,"_2384":44568},[],"Operational identity roots, intermediates, validation and permissions.",{"_2857":1193,"_25170":1177,"_17548":44570,"_5":17443,"_23820":44524,"_2384":44571},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2857":1194,"_25170":1177,"_17548":44573,"_5":17443,"_23820":44528,"_2384":44574},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2857":1195,"_25170":1177,"_17548":44576,"_5":17443,"_23820":44528,"_2384":44577},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2857":1196,"_25170":1177,"_17548":44579,"_5":17443,"_23820":44532,"_2384":44580},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2857":1197,"_25170":1177,"_17548":44582,"_5":17443,"_23820":44532,"_2384":44583},[],"Select policy-approved roots as anchors.",{"_2857":1198,"_25170":1177,"_17548":44585,"_5":17443,"_23820":44532,"_2384":44586},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2857":1199,"_25170":1177,"_17548":44588,"_5":17443,"_23820":44532,"_2384":44589},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2857":1200,"_25170":1177,"_17548":44591,"_5":17443,"_23820":44532,"_2384":44592},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2857":1201,"_25170":1177,"_17548":44594,"_5":17443,"_23820":44532,"_2384":44595},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2857":1202,"_25170":1177,"_17548":44597,"_5":17443,"_23820":44536,"_2384":44598},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2857":1203,"_25170":1177,"_17548":44600,"_5":17443,"_23820":44536,"_2384":44601},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. When switching the enrollment CA, add the previous issuance CA to that list so old-CA identities keep re-enrolling during overlap; migrated `additional_validation_cas` values now live there. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2857":1204,"_25170":1177,"_17548":44603,"_5":17443,"_23820":44536,"_2384":44604},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2857":1205,"_25170":1177,"_17548":44606,"_5":17443,"_23820":44540,"_2384":44607},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2857":1206,"_25170":1206,"_5":12294,"_2384":44609,"_25506":44610,"_17548":44612,"_23820":1206},"AWS IoT Core",[40849,42193,43167,43165,44611],"Integrations",[],{"_2857":1207,"_25170":1206,"_17548":44614,"_5":17443,"_23820":1206,"_2384":44615},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2857":1208,"_25170":1206,"_5":25503,"_17548":44617,"_23820":44618,"_2384":44619},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2857":1209,"_25170":1206,"_5":25503,"_17548":44621,"_23820":44622,"_2384":44623},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2857":1210,"_25170":1206,"_5":25503,"_17548":44625,"_23820":44626,"_2384":44627},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2857":1211,"_25170":1206,"_5":25503,"_17548":44629,"_23820":44630,"_2384":44631},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2857":1212,"_25170":1206,"_5":25503,"_17548":44633,"_23820":44634,"_2384":44635},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2857":1213,"_25170":1206,"_5":25503,"_17548":44637,"_23820":44638,"_2384":44639},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2857":1214,"_25170":1206,"_5":25503,"_17548":44641,"_23820":44642,"_2384":44643},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2857":1215,"_25170":1206,"_5":25503,"_17548":44645,"_23820":44646,"_2384":44647},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2857":1216,"_25170":1206,"_5":25503,"_17548":44649,"_23820":44650,"_2384":44651},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2857":1217,"_25170":1206,"_5":25503,"_17548":44653,"_23820":44654,"_2384":44655},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2857":1218,"_25170":1206,"_5":25503,"_17548":44657,"_23820":44658,"_2384":44659},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2857":1219,"_25170":1206,"_5":25503,"_17548":44661,"_23820":44662,"_2384":44663},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2857":1220,"_25170":1206,"_5":25503,"_17548":44665,"_23820":44666,"_2384":44667},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2857":1221,"_25170":1206,"_5":25503,"_17548":44669,"_23820":44670,"_2384":44671},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2857":1222,"_25170":1206,"_5":25503,"_17548":44673,"_23820":44674,"_2384":44675},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2857":1223,"_25170":1206,"_5":25503,"_17548":44677,"_23820":44678,"_2384":44679},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2857":1224,"_25170":1206,"_5":25503,"_17548":44681,"_23820":44682,"_2384":44683},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2857":1225,"_25170":1206,"_5":25503,"_17548":44685,"_23820":44686,"_2384":44687},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2857":1226,"_25170":1206,"_5":25503,"_17548":44689,"_23820":44690,"_2384":44691},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2857":1227,"_25170":1206,"_5":25503,"_17548":44693,"_23820":44694,"_2384":44695},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2857":1228,"_25170":1206,"_17548":44697,"_5":17443,"_23820":1206,"_2384":44698},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2857":1229,"_25170":1206,"_17548":44700,"_5":17443,"_23820":1206,"_2384":44701},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2857":1230,"_25170":1206,"_17548":44703,"_5":17443,"_23820":1206,"_2384":44704},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2857":1231,"_25170":1206,"_17548":44706,"_5":17443,"_23820":44618,"_2384":44707},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2857":1232,"_25170":1206,"_17548":44709,"_5":17443,"_23820":44618,"_2384":44710},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2857":1233,"_25170":1206,"_17548":44712,"_5":17443,"_23820":44618,"_2384":44713},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2857":1234,"_25170":1206,"_17548":44715,"_5":17443,"_23820":44618,"_2384":44716},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2857":1235,"_25170":1206,"_17548":44718,"_5":17443,"_23820":44622,"_2384":44719},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2857":1236,"_25170":1206,"_17548":44721,"_5":17443,"_23820":44626,"_2384":44722},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2857":1237,"_25170":1206,"_17548":44724,"_5":17443,"_23820":44626,"_2384":44725},[],"IAM action",{"_2857":1238,"_25170":1206,"_17548":44727,"_5":17443,"_23820":44626,"_2384":41232},[],{"_2857":1239,"_25170":1206,"_17548":44729,"_5":17443,"_23820":44626,"_2384":44730},[],"`iot:GetRegistrationCode`",{"_2857":1240,"_25170":1206,"_17548":44732,"_5":17443,"_23820":44626,"_2384":44733},[],"Obtain the verification code for CA registration in the Primary Account",{"_2857":1241,"_25170":1206,"_17548":44735,"_5":17443,"_23820":44626,"_2384":44736},[],"`iot:RegisterCACertificate`",{"_2857":1242,"_25170":1206,"_17548":44738,"_5":17443,"_23820":44626,"_2384":44739},[],"Register the CA in AWS IoT",{"_2857":1243,"_25170":1206,"_17548":44741,"_5":17443,"_23820":44626,"_2384":44742},[],"`iot:DescribeCACertificate`",{"_2857":1244,"_25170":1206,"_17548":44744,"_5":17443,"_23820":44626,"_2384":44745},[],"Check the CA registration status",{"_2857":1245,"_25170":1206,"_17548":44747,"_5":17443,"_23820":44626,"_2384":44748},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2857":1246,"_25170":1206,"_17548":44750,"_5":17443,"_23820":44626,"_2384":44751},[],"Create or update Things in IoT Core",{"_2857":1247,"_25170":1206,"_17548":44753,"_5":17443,"_23820":44626,"_2384":44754},[],"`iot:RegisterThing`",{"_2857":1248,"_25170":1206,"_17548":44756,"_5":17443,"_23820":44626,"_2384":44757},[],"Provision Things through a template",{"_2857":1249,"_25170":1206,"_17548":44759,"_5":17443,"_23820":44626,"_2384":44760},[],"`iot:RegisterCertificate`",{"_2857":1250,"_25170":1206,"_17548":44762,"_5":17443,"_23820":44626,"_2384":44763},[],"Register device certificates",{"_2857":1251,"_25170":1206,"_17548":44765,"_5":17443,"_23820":44626,"_2384":44766},[],"`iot:UpdateCertificate`",{"_2857":1252,"_25170":1206,"_17548":44768,"_5":17443,"_23820":44626,"_2384":44769},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2857":1253,"_25170":1206,"_17548":44771,"_5":17443,"_23820":44626,"_2384":44772},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2857":1254,"_25170":1206,"_17548":44774,"_5":17443,"_23820":44626,"_2384":44775},[],"Create and attach IoT policies",{"_2857":1255,"_25170":1206,"_17548":44777,"_5":17443,"_23820":44626,"_2384":44778},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2857":1256,"_25170":1206,"_17548":44780,"_5":17443,"_23820":44626,"_2384":44781},[],"Manage Thing groups",{"_2857":1257,"_25170":1206,"_17548":44783,"_5":17443,"_23820":44626,"_2384":44784},[],"`iot:CreateProvisioningTemplate`",{"_2857":1258,"_25170":1206,"_17548":44786,"_5":17443,"_23820":44626,"_2384":44787},[],"Create JITP templates",{"_2857":1259,"_25170":1206,"_17548":44789,"_5":17443,"_23820":44626,"_2384":44790},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2857":1260,"_25170":1206,"_17548":44792,"_5":17443,"_23820":44626,"_2384":44793},[],"Read and write the Device Shadow",{"_2857":1261,"_25170":1206,"_17548":44795,"_5":17443,"_23820":44626,"_2384":44796},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2857":1262,"_25170":1206,"_17548":44798,"_5":17443,"_23820":44630,"_2384":44799},[],"Parameter",{"_2857":1263,"_25170":1206,"_17548":44801,"_5":17443,"_23820":44630,"_2384":44802},[],"Type",{"_2857":1264,"_25170":1206,"_17548":44804,"_5":17443,"_23820":44630,"_2384":44805},[],"Required",{"_2857":1265,"_25170":1206,"_17548":44807,"_5":17443,"_23820":44630,"_2384":44808},[],"Description",{"_2857":1266,"_25170":1206,"_17548":44810,"_5":17443,"_23820":44630,"_2384":44811},[],"`connector_id`",{"_2857":1267,"_25170":1206,"_17548":44813,"_5":17443,"_23820":44630,"_2384":20963},[],{"_2857":1268,"_25170":1206,"_17548":44815,"_5":17443,"_23820":44630,"_2384":44816},[],"Yes",{"_2857":1269,"_25170":1206,"_17548":44818,"_5":17443,"_23820":44630,"_2384":44819},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2857":1270,"_25170":1206,"_17548":44821,"_5":17443,"_23820":44630,"_2384":44822},[],"`aws_config.region`",{"_2857":1271,"_25170":1206,"_17548":44824,"_5":17443,"_23820":44630,"_2384":20963},[],{"_2857":1272,"_25170":1206,"_17548":44826,"_5":17443,"_23820":44630,"_2384":44816},[],{"_2857":1273,"_25170":1206,"_17548":44828,"_5":17443,"_23820":44630,"_2384":44829},[],"AWS region where the connector operates.",{"_2857":1274,"_25170":1206,"_17548":44831,"_5":17443,"_23820":44630,"_2384":44832},[],"`aws_config.auth_method`",{"_2857":1275,"_25170":1206,"_17548":44834,"_5":17443,"_23820":44630,"_2384":20963},[],{"_2857":1276,"_25170":1206,"_17548":44836,"_5":17443,"_23820":44630,"_2384":44816},[],{"_2857":1277,"_25170":1206,"_17548":44838,"_5":17443,"_23820":44630,"_2384":44839},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2857":1278,"_25170":1206,"_17548":44841,"_5":17443,"_23820":44630,"_2384":44842},[],"`aws_config.access_key_id`",{"_2857":1279,"_25170":1206,"_17548":44844,"_5":17443,"_23820":44630,"_2384":20963},[],{"_2857":1280,"_25170":1206,"_17548":44846,"_5":17443,"_23820":44630,"_2384":44847},[],"Only with `auth_method=static`",{"_2857":1281,"_25170":1206,"_17548":44849,"_5":17443,"_23820":44630,"_2384":44850},[],"AWS access key.",{"_2857":1282,"_25170":1206,"_17548":44852,"_5":17443,"_23820":44630,"_2384":44853},[],"`aws_config.secret_access_key`",{"_2857":1283,"_25170":1206,"_17548":44855,"_5":17443,"_23820":44630,"_2384":20963},[],{"_2857":1284,"_25170":1206,"_17548":44857,"_5":17443,"_23820":44630,"_2384":44847},[],{"_2857":1285,"_25170":1206,"_17548":44859,"_5":17443,"_23820":44630,"_2384":44860},[],"AWS secret key.",{"_2857":1286,"_25170":1206,"_17548":44862,"_5":17443,"_23820":44630,"_2384":44863},[],"`aws_config.session_token`",{"_2857":1287,"_25170":1206,"_17548":44865,"_5":17443,"_23820":44630,"_2384":20963},[],{"_2857":1288,"_25170":1206,"_17548":44867,"_5":17443,"_23820":44630,"_2384":44868},[],"No",{"_2857":1289,"_25170":1206,"_17548":44870,"_5":17443,"_23820":44630,"_2384":44871},[],"Session token (with `auth_method=static`).",{"_2857":1290,"_25170":1206,"_17548":44873,"_5":17443,"_23820":44630,"_2384":44874},[],"`aws_config.role_arn`",{"_2857":1291,"_25170":1206,"_17548":44876,"_5":17443,"_23820":44630,"_2384":20963},[],{"_2857":1292,"_25170":1206,"_17548":44878,"_5":17443,"_23820":44630,"_2384":44879},[],"Only with `auth_method=role`",{"_2857":1293,"_25170":1206,"_17548":44881,"_5":17443,"_23820":44630,"_2384":44882},[],"ARN of the role to assume.",{"_2857":1294,"_25170":1206,"_17548":44884,"_5":17443,"_23820":44630,"_2384":44885},[],"`aws_config.endpoint_url`",{"_2857":1295,"_25170":1206,"_17548":44887,"_5":17443,"_23820":44630,"_2384":20963},[],{"_2857":1296,"_25170":1206,"_17548":44889,"_5":17443,"_23820":44630,"_2384":44868},[],{"_2857":1297,"_25170":1206,"_17548":44891,"_5":17443,"_23820":44630,"_2384":44892},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2857":1298,"_25170":1206,"_17548":44894,"_5":17443,"_23820":44630,"_2384":44895},[],"`subscriber_event_bus`",{"_2857":1299,"_25170":1206,"_17548":44897,"_5":17443,"_23820":44630,"_2384":14708},[],{"_2857":1300,"_25170":1206,"_17548":44899,"_5":17443,"_23820":44630,"_2384":44816},[],{"_2857":1301,"_25170":1206,"_17548":44901,"_5":17443,"_23820":44630,"_2384":44902},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2857":1302,"_25170":1206,"_17548":44904,"_5":17443,"_23820":44630,"_2384":44905},[],"`dms_manager_client`",{"_2857":1303,"_25170":1206,"_17548":44907,"_5":17443,"_23820":44630,"_2384":20963},[],{"_2857":1304,"_25170":1206,"_17548":44909,"_5":17443,"_23820":44630,"_2384":44816},[],{"_2857":1305,"_25170":1206,"_17548":44911,"_5":17443,"_23820":44630,"_2384":44912},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2857":1306,"_25170":1206,"_17548":44914,"_5":17443,"_23820":44630,"_2384":44915},[],"`device_manager_client`",{"_2857":1307,"_25170":1206,"_17548":44917,"_5":17443,"_23820":44630,"_2384":20963},[],{"_2857":1308,"_25170":1206,"_17548":44919,"_5":17443,"_23820":44630,"_2384":44816},[],{"_2857":1309,"_25170":1206,"_17548":44921,"_5":17443,"_23820":44630,"_2384":44922},[],"HTTP URL of Lamassu's Device Manager.",{"_2857":1310,"_25170":1206,"_17548":44924,"_5":17443,"_23820":44630,"_2384":44925},[],"`ca_client`",{"_2857":1311,"_25170":1206,"_17548":44927,"_5":17443,"_23820":44630,"_2384":20963},[],{"_2857":1312,"_25170":1206,"_17548":44929,"_5":17443,"_23820":44630,"_2384":44816},[],{"_2857":1313,"_25170":1206,"_17548":44931,"_5":17443,"_23820":44630,"_2384":44932},[],"HTTP URL of Lamassu's CA service.",{"_2857":1314,"_25170":1206,"_17548":44934,"_5":17443,"_23820":44634,"_2384":44935},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2857":1315,"_25170":1206,"_17548":44937,"_5":17443,"_23820":44638,"_2384":44938},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2857":1316,"_25170":1206,"_17548":44940,"_5":17443,"_23820":44638,"_2384":44941},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2857":1317,"_25170":1206,"_17548":44943,"_5":17443,"_23820":44642,"_2384":44944},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2857":1318,"_25170":1206,"_17548":44946,"_5":17443,"_23820":44642,"_2384":44947},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2857":1319,"_25170":1206,"_17548":44949,"_5":17443,"_23820":44642,"_2384":44950},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2857":1320,"_25170":1206,"_17548":44952,"_5":17443,"_23820":44642,"_2384":44953},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2857":1321,"_25170":1206,"_17548":44955,"_5":17443,"_23820":44642,"_2384":44956},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2857":1322,"_25170":1206,"_17548":44958,"_5":17443,"_23820":44642,"_2384":44959},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2857":1323,"_25170":1206,"_17548":44961,"_5":17443,"_23820":44646,"_2384":44962},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2857":1324,"_25170":1206,"_17548":44964,"_5":17443,"_23820":44650,"_2384":44965},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2857":1325,"_25170":1206,"_17548":44967,"_5":17443,"_23820":44650,"_2384":44968},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2857":1326,"_25170":1206,"_17548":44970,"_5":17443,"_23820":44654,"_2384":44971},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2857":1327,"_25170":1206,"_17548":44973,"_5":17443,"_23820":44658,"_2384":44974},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2857":1328,"_25170":1206,"_17548":44976,"_5":17443,"_23820":44658,"_2384":44977},[],"Creates or updates the IoT policies configured in the DMS.",{"_2857":1329,"_25170":1206,"_17548":44979,"_5":17443,"_23820":44658,"_2384":44980},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2857":1330,"_25170":1206,"_17548":44982,"_5":17443,"_23820":44658,"_2384":44983},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2857":1331,"_25170":1206,"_17548":44985,"_5":17443,"_23820":44658,"_2384":44986},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2857":1332,"_25170":1206,"_17548":44988,"_5":17443,"_23820":44658,"_2384":44989},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2857":1333,"_25170":1206,"_17548":44991,"_5":17443,"_23820":44658,"_2384":44992},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2857":1334,"_25170":1206,"_17548":44994,"_5":17443,"_23820":44662,"_2384":44995},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2857":1335,"_25170":1206,"_17548":44997,"_5":17443,"_23820":44662,"_2384":44998},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2857":1336,"_25170":1206,"_17548":45000,"_5":17443,"_23820":44662,"_2384":45001},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2857":1337,"_25170":1206,"_17548":45003,"_5":17443,"_23820":44666,"_2384":45004},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2857":1338,"_25170":1206,"_17548":45006,"_5":17443,"_23820":44666,"_2384":45007},[],"The full flow from the device's perspective is:",{"_2857":1339,"_25170":1206,"_17548":45009,"_5":17443,"_23820":44666,"_2384":45010},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2857":1340,"_25170":1206,"_17548":45012,"_5":17443,"_23820":44670,"_2384":45013},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2857":1341,"_25170":1206,"_17548":45015,"_5":17443,"_23820":44670,"_2384":45016},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2857":1342,"_25170":1206,"_17548":45018,"_5":17443,"_23820":44670,"_2384":45019},[],"For the JITP flow to work correctly:",{"_2857":1343,"_25170":1206,"_17548":45021,"_5":17443,"_23820":44670,"_2384":45022},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2857":1344,"_25170":1206,"_17548":45024,"_5":17443,"_23820":44670,"_2384":45025},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2857":1345,"_25170":1206,"_17548":45027,"_5":17443,"_23820":44670,"_2384":45028},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2857":1346,"_25170":1206,"_17548":45030,"_5":17443,"_23820":44670,"_2384":45031},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2857":1347,"_25170":1206,"_17548":45033,"_5":17443,"_23820":44674,"_2384":45034},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2857":1348,"_25170":1206,"_17548":45036,"_5":17443,"_23820":44674,"_2384":45037},[],"Status in Lamassu",{"_2857":1349,"_25170":1206,"_17548":45039,"_5":17443,"_23820":44674,"_2384":45040},[],"Revocation reason",{"_2857":1350,"_25170":1206,"_17548":45042,"_5":17443,"_23820":44674,"_2384":45043},[],"Status in AWS IoT Core",{"_2857":1351,"_25170":1206,"_17548":45045,"_5":17443,"_23820":44674,"_2384":45046},[],"`Active`",{"_2857":1352,"_25170":1206,"_17548":45048,"_5":17443,"_23820":44674,"_2384":45049},[],"None",{"_2857":1353,"_25170":1206,"_17548":45051,"_5":17443,"_23820":44674,"_2384":45052},[],"`ACTIVE`",{"_2857":1354,"_25170":1206,"_17548":45054,"_5":17443,"_23820":44674,"_2384":45055},[],"`Revoked`",{"_2857":1355,"_25170":1206,"_17548":45057,"_5":17443,"_23820":44674,"_2384":45058},[],"`certificateHold`",{"_2857":1356,"_25170":1206,"_17548":45060,"_5":17443,"_23820":44674,"_2384":45061},[],"`INACTIVE`",{"_2857":1357,"_25170":1206,"_17548":45063,"_5":17443,"_23820":44674,"_2384":45055},[],{"_2857":1358,"_25170":1206,"_17548":45065,"_5":17443,"_23820":44674,"_2384":45066},[],"Any other reason",{"_2857":1359,"_25170":1206,"_17548":45068,"_5":17443,"_23820":44674,"_2384":45069},[],"`REVOKED`",{"_2857":1360,"_25170":1206,"_17548":45071,"_5":17443,"_23820":44674,"_2384":45072},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2857":1361,"_25170":1206,"_17548":45074,"_5":17443,"_23820":44678,"_2384":45075},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2857":1362,"_25170":1206,"_17548":45077,"_5":17443,"_23820":44678,"_2384":45078},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2857":1363,"_25170":1206,"_17548":45080,"_5":17443,"_23820":44678,"_2384":45081},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2857":1364,"_25170":1206,"_17548":45083,"_5":17443,"_23820":44682,"_2384":45084},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2857":1365,"_25170":1206,"_17548":45086,"_5":17443,"_23820":44682,"_2384":45087},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2857":1366,"_25170":1206,"_17548":45089,"_5":17443,"_23820":44686,"_2384":45090},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2857":1367,"_25170":1206,"_17548":45092,"_5":17443,"_23820":44686,"_2384":45093},[],"There are two action types:",{"_2857":1368,"_25170":1206,"_17548":45095,"_5":17443,"_23820":44686,"_2384":45096},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2857":1369,"_25170":1206,"_17548":45098,"_5":17443,"_23820":44686,"_2384":45099},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2857":1370,"_25170":1206,"_17548":45101,"_5":17443,"_23820":44686,"_2384":45102},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2857":1371,"_25170":1206,"_17548":45104,"_5":17443,"_23820":44690,"_2384":45105},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2857":1372,"_25170":1206,"_17548":45107,"_5":17443,"_23820":44690,"_2384":45108},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2857":1373,"_25170":1206,"_17548":45110,"_5":17443,"_23820":44690,"_2384":45111},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2857":1374,"_25170":1206,"_17548":45113,"_5":17443,"_23820":44694,"_2384":45114},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2857":1375,"_25170":1206,"_17548":45116,"_5":17443,"_23820":44694,"_2384":45117},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2857":1376,"_25170":1206,"_17548":45119,"_5":17443,"_23820":44694,"_2384":45120},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2857":1377,"_25170":1206,"_17548":45122,"_5":17443,"_23820":44694,"_2384":45123},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2857":1378,"_25170":1206,"_17548":45125,"_5":17443,"_23820":44694,"_2384":45126},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2857":1379,"_25170":1206,"_17548":45128,"_5":17443,"_23820":44694,"_2384":45129},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2857":1380,"_25170":1206,"_17548":45131,"_5":17443,"_23820":44694,"_2384":45132},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2857":1381,"_25170":1206,"_17548":45134,"_5":17443,"_23820":44694,"_2384":45135},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2857":1382,"_25170":1206,"_17548":45137,"_5":17443,"_23820":44694,"_2384":45138},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2857":1383,"_25170":1206,"_17548":45140,"_5":17443,"_23820":44694,"_2384":45141},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2857":1384,"_25170":1206,"_17548":45143,"_5":17443,"_23820":44694,"_2384":45144},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2857":1385,"_25170":1206,"_17548":45146,"_5":17443,"_23820":44694,"_2384":45147},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2857":1386,"_25170":1206,"_17548":45149,"_5":17443,"_23820":44694,"_2384":45150},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2857":1387,"_25170":1206,"_17548":45152,"_5":17443,"_23820":44694,"_2384":45153},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2857":1388,"_25170":1206,"_17548":45155,"_5":17443,"_23820":44694,"_2384":45156},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2857":1389,"_25170":1206,"_17548":45158,"_5":17443,"_23820":44694,"_2384":45159},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2857":1390,"_25170":1206,"_17548":45161,"_5":17443,"_23820":44694,"_2384":45162},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2857":1391,"_25170":1206,"_17548":45164,"_5":17443,"_23820":44694,"_2384":45165},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2857":1392,"_25170":1206,"_17548":45167,"_5":17443,"_23820":44694,"_2384":45168},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":1393,"_25170":1206,"_17548":45170,"_5":17443,"_23820":44694,"_2384":45171},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2857":1394,"_25170":1206,"_17548":45173,"_5":17443,"_23820":44694,"_2384":45174},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2857":1395,"_25170":1395,"_5":12294,"_2384":43167,"_25506":45176,"_17548":45177,"_23820":1395},[40849,42193,43167],[],{"_2857":1396,"_25170":1395,"_17548":45179,"_5":17443,"_23820":1395,"_2384":45180},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2857":1397,"_25170":1395,"_5":25503,"_17548":45182,"_23820":45183,"_2384":45184},[],"/docs/pr-preview/pr-38/platform/iot-fleets/overview#start-here","Start here",{"_2857":1398,"_25170":1395,"_5":25503,"_17548":45186,"_23820":45187,"_2384":43165},[],"/docs/pr-preview/pr-38/platform/iot-fleets/overview#devices-and-identities",{"_2857":1399,"_25170":1395,"_5":25503,"_17548":45189,"_23820":45190,"_2384":43348},[],"/docs/pr-preview/pr-38/platform/iot-fleets/overview#enrollment-with-pki",{"_2857":1400,"_25170":1395,"_5":25503,"_17548":45192,"_23820":45193,"_2384":44611},[],"/docs/pr-preview/pr-38/platform/iot-fleets/overview#integrations",{"_2857":1401,"_25170":1395,"_5":25503,"_17548":45195,"_23820":45196,"_2384":45197},[],"/docs/pr-preview/pr-38/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2857":1402,"_25170":1395,"_17548":45199,"_5":17443,"_23820":1395,"_2384":45200},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2857":1403,"_25170":1395,"_17548":45202,"_5":17443,"_23820":45183,"_2384":45203},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2857":1404,"_25170":1395,"_17548":45205,"_5":17443,"_23820":45183,"_2384":45206},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2857":1405,"_25170":1395,"_17548":45208,"_5":17443,"_23820":45187,"_2384":45209},[],"Resource",{"_2857":1406,"_25170":1395,"_17548":45211,"_5":17443,"_23820":45187,"_2384":45212},[],"What it represents",{"_2857":1407,"_25170":1395,"_17548":45214,"_5":17443,"_23820":45187,"_2384":45215},[],"**Device**",{"_2857":1408,"_25170":1395,"_17548":45217,"_5":17443,"_23820":45187,"_2384":45218},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2857":1409,"_25170":1395,"_17548":45220,"_5":17443,"_23820":45187,"_2384":45221},[],"**Identity**",{"_2857":1410,"_25170":1395,"_17548":45223,"_5":17443,"_23820":45187,"_2384":45224},[],"The device's association with its certificates: an active version and a history.",{"_2857":1411,"_25170":1395,"_17548":45226,"_5":17443,"_23820":45187,"_2384":45227},[],"**DMS**",{"_2857":1412,"_25170":1395,"_17548":45229,"_5":17443,"_23820":45187,"_2384":45230},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2857":1413,"_25170":1395,"_17548":45232,"_5":17443,"_23820":45187,"_2384":45233},[],"**Fleet**",{"_2857":1414,"_25170":1395,"_17548":45235,"_5":17443,"_23820":45187,"_2384":45236},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2857":1415,"_25170":1395,"_17548":45238,"_5":17443,"_23820":45187,"_2384":45239},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2857":1416,"_25170":1395,"_17548":45241,"_5":17443,"_23820":45187,"_2384":45242},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2857":1417,"_25170":1395,"_17548":45244,"_5":17443,"_23820":45190,"_2384":45245},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2857":1418,"_25170":1395,"_17548":45247,"_5":17443,"_23820":45190,"_2384":45248},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2857":1419,"_25170":1395,"_17548":45250,"_5":17443,"_23820":45190,"_2384":45251},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2857":1420,"_25170":1395,"_17548":45253,"_5":17443,"_23820":45190,"_2384":45254},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2857":1421,"_25170":1395,"_17548":45256,"_5":17443,"_23820":45190,"_2384":45257},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2857":1422,"_25170":1395,"_17548":45259,"_5":17443,"_23820":45190,"_2384":45260},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2857":1423,"_25170":1395,"_17548":45262,"_5":17443,"_23820":45190,"_2384":45263},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":1424,"_25170":1395,"_17548":45265,"_5":17443,"_23820":45190,"_2384":45266},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2857":1425,"_25170":1395,"_17548":45268,"_5":17443,"_23820":45193,"_2384":45269},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2857":1426,"_25170":1395,"_17548":45271,"_5":17443,"_23820":45193,"_2384":45272},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2857":1427,"_25170":1395,"_17548":45274,"_5":17443,"_23820":45196,"_2384":45275},[],"Participant",{"_2857":1428,"_25170":1395,"_17548":45277,"_5":17443,"_23820":45196,"_2384":45278},[],"Responsibility",{"_2857":1429,"_25170":1395,"_17548":45280,"_5":17443,"_23820":45196,"_2384":45281},[],"PKI administrator",{"_2857":1430,"_25170":1395,"_17548":45283,"_5":17443,"_23820":45196,"_2384":45284},[],"CA, issuance profile, chain and revocation publication.",{"_2857":1431,"_25170":1395,"_17548":45286,"_5":17443,"_23820":45196,"_2384":45287},[],"Provisioning administrator",{"_2857":1432,"_25170":1395,"_17548":45289,"_5":17443,"_23820":45196,"_2384":45290},[],"DMS, admission, authentication per operation and inventory.",{"_2857":1433,"_25170":1395,"_17548":45292,"_5":17443,"_23820":45196,"_2384":45293},[],"Device integrator",{"_2857":1434,"_25170":1395,"_17548":45295,"_5":17443,"_23820":45196,"_2384":45296},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2857":1435,"_25170":1395,"_17548":45298,"_5":17443,"_23820":45196,"_2384":45299},[],"Consumer integrator",{"_2857":1436,"_25170":1395,"_17548":45301,"_5":17443,"_23820":45196,"_2384":45302},[],"Trusted issuers, validation and device permissions in the destination.",{"_2857":1437,"_25170":1395,"_17548":45304,"_5":17443,"_23820":45196,"_2384":45305},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2857":1438,"_25170":1438,"_5":12294,"_2384":45307,"_25506":45308,"_17548":45310,"_23820":1438},"Enroll and connect your first device",[40849,42193,43167,45309],"Getting started",[],{"_2857":1439,"_25170":1438,"_17548":45312,"_5":17443,"_23820":1438,"_2384":45313},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2857":1440,"_25170":1438,"_5":25503,"_17548":45315,"_23820":45316,"_2384":40859},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2857":1441,"_25170":1438,"_5":25503,"_17548":45318,"_23820":45319,"_2384":45320},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2857":1442,"_25170":1438,"_5":25503,"_17548":45322,"_23820":45323,"_2384":45324},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2857":1443,"_25170":1438,"_5":25503,"_17548":45326,"_23820":45327,"_2384":45328},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2857":1444,"_25170":1438,"_5":25503,"_17548":45330,"_23820":45331,"_2384":45332},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2857":1445,"_25170":1438,"_5":25503,"_17548":45334,"_23820":45335,"_2384":45336},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2857":1446,"_25170":1438,"_5":25503,"_17548":45338,"_23820":45339,"_2384":45340},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2857":1447,"_25170":1438,"_5":25503,"_17548":45342,"_23820":45343,"_2384":45344},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2857":1448,"_25170":1438,"_17548":45346,"_5":17443,"_23820":1438,"_2384":45347},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2857":1449,"_25170":1438,"_17548":45349,"_5":17443,"_23820":45316,"_2384":45350},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2857":1450,"_25170":1438,"_17548":45352,"_5":17443,"_23820":45316,"_2384":45353},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2857":1451,"_25170":1438,"_17548":45355,"_5":17443,"_23820":45316,"_2384":45356},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2857":1452,"_25170":1438,"_17548":45358,"_5":17443,"_23820":45316,"_2384":45359},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2857":1453,"_25170":1438,"_17548":45361,"_5":17443,"_23820":45316,"_2384":45362},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2857":1454,"_25170":1438,"_17548":45364,"_5":17443,"_23820":45319,"_2384":45365},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2857":1455,"_25170":1438,"_17548":45367,"_5":17443,"_23820":45319,"_2384":45368},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2857":1456,"_25170":1438,"_17548":45370,"_5":17443,"_23820":45323,"_2384":45371},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2857":1457,"_25170":1438,"_17548":45373,"_5":17443,"_23820":45323,"_2384":45374},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2857":1458,"_25170":1438,"_17548":45376,"_5":17443,"_23820":45323,"_2384":45377},[],"Setting",{"_2857":1459,"_25170":1438,"_17548":45379,"_5":17443,"_23820":45323,"_2384":45380},[],"Evaluation value",{"_2857":1460,"_25170":1438,"_17548":45382,"_5":17443,"_23820":45323,"_2384":45383},[],"Enrollment CA",{"_2857":1461,"_25170":1438,"_17548":45385,"_5":17443,"_23820":45323,"_2384":45386},[],"Issuing root from `device-root.pem`.",{"_2857":1462,"_25170":1438,"_17548":45388,"_5":17443,"_23820":45323,"_2384":43478},[],{"_2857":1463,"_25170":1438,"_17548":45390,"_5":17443,"_23820":45323,"_2384":45391},[],"The 1-hour leaf profile you just prepared.",{"_2857":1464,"_25170":1438,"_17548":45393,"_5":17443,"_23820":45323,"_2384":45394},[],"Protocol / Registration Mode",{"_2857":1465,"_25170":1438,"_17548":45396,"_5":17443,"_23820":45323,"_2384":45397},[],"`EST_RFC7030` / `JITP`.",{"_2857":1466,"_25170":1438,"_17548":45399,"_5":17443,"_23820":45323,"_2384":45400},[],"Verify CSR Signature",{"_2857":1467,"_25170":1438,"_17548":45402,"_5":17443,"_23820":45323,"_2384":45403},[],"Enabled.",{"_2857":1468,"_25170":1438,"_17548":45405,"_5":17443,"_23820":45323,"_2384":45406},[],"Enable Replaceable Enrollment",{"_2857":1469,"_25170":1438,"_17548":45408,"_5":17443,"_23820":45323,"_2384":45409},[],"Disabled; the ID must be new.",{"_2857":1470,"_25170":1438,"_17548":45411,"_5":17443,"_23820":45323,"_2384":45412},[],"Initial authentication",{"_2857":1471,"_25170":1438,"_17548":45414,"_5":17443,"_23820":45323,"_2384":45415},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2857":1472,"_25170":1438,"_17548":45417,"_5":17443,"_23820":45323,"_2384":45418},[],"Renewal authentication",{"_2857":1473,"_25170":1438,"_17548":45420,"_5":17443,"_23820":45323,"_2384":45421},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2857":1474,"_25170":1438,"_17548":45423,"_5":17443,"_23820":45323,"_2384":45424},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_2857":1475,"_25170":1438,"_17548":45426,"_5":17443,"_23820":45323,"_2384":45427},[],"Empty list for this direct issuance / disabled.",{"_2857":1476,"_25170":1438,"_17548":45429,"_5":17443,"_23820":45323,"_2384":45430},[],"Re-enrollment Delta",{"_2857":1477,"_25170":1438,"_17548":45432,"_5":17443,"_23820":45323,"_2384":45433},[],"1 hour.",{"_2857":1478,"_25170":1438,"_17548":45435,"_5":17443,"_23820":45323,"_2384":45436},[],"Preventive / Critical Delta",{"_2857":1479,"_25170":1438,"_17548":45438,"_5":17443,"_23820":45323,"_2384":45439},[],"30 minutes / 10 minutes.",{"_2857":1480,"_25170":1438,"_17548":45441,"_5":17443,"_23820":45323,"_2384":45442},[],"Revoke on Re-enrollment",{"_2857":1481,"_25170":1438,"_17548":45444,"_5":17443,"_23820":45323,"_2384":45445},[],"Disabled to test the successor before retiring the previous identity.",{"_2857":1482,"_25170":1438,"_17548":45447,"_5":17443,"_23820":45323,"_2384":43486},[],{"_2857":1483,"_25170":1438,"_17548":45449,"_5":17443,"_23820":45323,"_2384":45450},[],"Disabled; the operational key is generated in the client.",{"_2857":1484,"_25170":1438,"_17548":45452,"_5":17443,"_23820":45323,"_2384":45453},[],"CA Distribution",{"_2857":1485,"_25170":1438,"_17548":45455,"_5":17443,"_23820":45323,"_2384":45456},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2857":1486,"_25170":1438,"_17548":45458,"_5":17443,"_23820":45323,"_2384":45459},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2857":1487,"_25170":1438,"_17548":45461,"_5":17443,"_23820":45327,"_2384":45462},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2857":1488,"_25170":1438,"_17548":45464,"_5":17443,"_23820":45327,"_2384":45465},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2857":1489,"_25170":1438,"_17548":45467,"_5":17443,"_23820":45331,"_2384":45468},[],"Generate a new key and CSR with the selected identifier:",{"_2857":1490,"_25170":1438,"_17548":45470,"_5":17443,"_23820":45331,"_2384":45471},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2857":1491,"_25170":1438,"_17548":45473,"_5":17443,"_23820":45331,"_2384":45474},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2857":1492,"_25170":1438,"_17548":45476,"_5":17443,"_23820":45335,"_2384":45477},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2857":1493,"_25170":1438,"_17548":45479,"_5":17443,"_23820":45335,"_2384":45480},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2857":1494,"_25170":1438,"_17548":45482,"_5":17443,"_23820":45339,"_2384":45483},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2857":1495,"_25170":1438,"_17548":45485,"_5":17443,"_23820":45339,"_2384":45486},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2857":1496,"_25170":1438,"_17548":45488,"_5":17443,"_23820":45339,"_2384":45489},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2857":1497,"_25170":1438,"_17548":45491,"_5":17443,"_23820":45339,"_2384":45492},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2857":1498,"_25170":1438,"_17548":45494,"_5":17443,"_23820":45339,"_2384":45495},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2857":1499,"_25170":1438,"_17548":45497,"_5":17443,"_23820":45343,"_2384":45498},[],"Check",{"_2857":1500,"_25170":1438,"_17548":45500,"_5":17443,"_23820":45343,"_2384":45501},[],"Expected result",{"_2857":1501,"_25170":1438,"_17548":45503,"_5":17443,"_23820":45343,"_2384":45504},[],"Registration",{"_2857":1502,"_25170":1438,"_17548":45506,"_5":17443,"_23820":45343,"_2384":45507},[],"ID created automatically and correct DMS.",{"_2857":1503,"_25170":1438,"_17548":45509,"_5":17443,"_23820":45343,"_2384":45510},[],"Certificate",{"_2857":1504,"_25170":1438,"_17548":45512,"_5":17443,"_23820":45343,"_2384":45513},[],"CN, profile, serial and key verified.",{"_2857":1505,"_25170":1438,"_17548":45515,"_5":17443,"_23820":45343,"_2384":45516},[],"Inventory",{"_2857":1506,"_25170":1438,"_17548":45518,"_5":17443,"_23820":45343,"_2384":45519},[],"Received serial visible as the current identity and in history.",{"_2857":1507,"_25170":1438,"_17548":45521,"_5":17443,"_23820":45343,"_2384":45522},[],"Consumer",{"_2857":1508,"_25170":1438,"_17548":45524,"_5":17443,"_23820":45343,"_2384":45525},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2857":1509,"_25170":1438,"_17548":45527,"_5":17443,"_23820":45343,"_2384":45528},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2857":1510,"_25170":1438,"_17548":45530,"_5":17443,"_23820":45343,"_2384":45531},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2857":1511,"_25170":1511,"_5":12294,"_2384":43183,"_25506":45533,"_17548":45534,"_23820":1511},[40849,42193,43167,45309],[],{"_2857":1512,"_25170":1511,"_17548":45536,"_5":17443,"_23820":1511,"_2384":45537},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2857":1513,"_25170":1511,"_5":25503,"_17548":45539,"_23820":45540,"_2384":40859},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2857":1514,"_25170":1511,"_5":25503,"_17548":45542,"_23820":45543,"_2384":45544},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2857":1515,"_25170":1511,"_5":25503,"_17548":45546,"_23820":45547,"_2384":45548},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2857":1516,"_25170":1511,"_5":25503,"_17548":45550,"_23820":45551,"_2384":45552},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2857":1517,"_25170":1511,"_5":25503,"_17548":45554,"_23820":45555,"_2384":45556},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2857":1518,"_25170":1511,"_5":25503,"_17548":45558,"_23820":45559,"_2384":45560},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2857":1519,"_25170":1511,"_5":25503,"_17548":45562,"_23820":45563,"_2384":45501},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2857":1520,"_25170":1511,"_5":25503,"_17548":45565,"_23820":45566,"_2384":45567},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2857":1521,"_25170":1511,"_5":25503,"_17548":45569,"_23820":45570,"_2384":45571},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2857":1522,"_25170":1511,"_17548":45573,"_5":17443,"_23820":1511,"_2384":45574},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2857":1523,"_25170":1511,"_17548":45576,"_5":17443,"_23820":1511,"_2384":45577},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2857":1524,"_25170":1511,"_17548":45579,"_5":17443,"_23820":45540,"_2384":45580},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2857":1525,"_25170":1511,"_17548":45582,"_5":17443,"_23820":45540,"_2384":45583},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2857":1526,"_25170":1511,"_17548":45585,"_5":17443,"_23820":45540,"_2384":45586},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2857":1527,"_25170":1511,"_17548":45588,"_5":17443,"_23820":45540,"_2384":45589},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2857":1528,"_25170":1511,"_17548":45591,"_5":17443,"_23820":45543,"_2384":45592},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2857":1529,"_25170":1511,"_17548":45594,"_5":17443,"_23820":45543,"_2384":45595},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2857":1530,"_25170":1511,"_17548":45597,"_5":17443,"_23820":45543,"_2384":45598},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2857":1531,"_25170":1511,"_17548":45600,"_5":17443,"_23820":45543,"_2384":45601},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2857":1532,"_25170":1511,"_17548":45603,"_5":17443,"_23820":45543,"_2384":45604},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2857":1533,"_25170":1511,"_17548":45606,"_5":17443,"_23820":45543,"_2384":45607},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2857":1534,"_25170":1511,"_17548":45609,"_5":17443,"_23820":45543,"_2384":45610},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2857":1535,"_25170":1511,"_17548":45612,"_5":17443,"_23820":45543,"_2384":45613},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2857":1536,"_25170":1511,"_17548":45615,"_5":17443,"_23820":45547,"_2384":45616},[],"Open **Managed Devices** and the registration action. Complete:",{"_2857":1537,"_25170":1511,"_17548":45618,"_5":17443,"_23820":45547,"_2384":45619},[],"**Device ID**: `device-001`.",{"_2857":1538,"_25170":1511,"_17548":45621,"_5":17443,"_23820":45547,"_2384":45622},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2857":1539,"_25170":1511,"_17548":45624,"_5":17443,"_23820":45547,"_2384":45625},[],"**Icon** and **Tags**: optional classification.",{"_2857":1540,"_25170":1511,"_17548":45627,"_5":17443,"_23820":45547,"_2384":45628},[],"Confirm registration.",{"_2857":1541,"_25170":1511,"_17548":45630,"_5":17443,"_23820":45551,"_2384":45631},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2857":1542,"_25170":1511,"_17548":45633,"_5":17443,"_23820":45551,"_2384":45634},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2857":1543,"_25170":1511,"_17548":45636,"_5":17443,"_23820":45555,"_2384":45637},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2857":1544,"_25170":1511,"_17548":45639,"_5":17443,"_23820":45555,"_2384":45640},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2857":1545,"_25170":1511,"_17548":45642,"_5":17443,"_23820":45559,"_2384":45643},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2857":1546,"_25170":1511,"_17548":45645,"_5":17443,"_23820":45559,"_2384":45646},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2857":1547,"_25170":1511,"_17548":45648,"_5":17443,"_23820":45563,"_2384":45498},[],{"_2857":1548,"_25170":1511,"_17548":45650,"_5":17443,"_23820":45563,"_2384":45651},[],"Result",{"_2857":1549,"_25170":1511,"_17548":45653,"_5":17443,"_23820":45563,"_2384":45654},[],"Device",{"_2857":1550,"_25170":1511,"_17548":45656,"_5":17443,"_23820":45563,"_2384":45657},[],"`device-001` appears in inventory with the expected DMS.",{"_2857":1551,"_25170":1511,"_17548":45659,"_5":17443,"_23820":45563,"_2384":45660},[],"Current identity",{"_2857":1552,"_25170":1511,"_17548":45662,"_5":17443,"_23820":45563,"_2384":45663},[],"The associated certificate matches the one you verified in PKI.",{"_2857":1553,"_25170":1511,"_17548":45665,"_5":17443,"_23820":45563,"_2384":45666},[],"History",{"_2857":1554,"_25170":1511,"_17548":45668,"_5":17443,"_23820":45563,"_2384":45669},[],"The associated issuance appears with its serial number and dates.",{"_2857":1555,"_25170":1511,"_17548":45671,"_5":17443,"_23820":45563,"_2384":45672},[],"Key and certificate",{"_2857":1556,"_25170":1511,"_17548":45674,"_5":17443,"_23820":45563,"_2384":45675},[],"You have the verified pair ready to install on the device.",{"_2857":1557,"_25170":1511,"_17548":45677,"_5":17443,"_23820":45566,"_2384":45678},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2857":1558,"_25170":1511,"_17548":45680,"_5":17443,"_23820":45566,"_2384":45681},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2857":1559,"_25170":1511,"_17548":45683,"_5":17443,"_23820":45566,"_2384":45684},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2857":1560,"_25170":1511,"_17548":45686,"_5":17443,"_23820":45566,"_2384":45687},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2857":1561,"_25170":1511,"_17548":45689,"_5":17443,"_23820":45570,"_2384":45690},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2857":1562,"_25170":1511,"_17548":45692,"_5":17443,"_23820":45570,"_2384":45693},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2857":1563,"_25170":1511,"_17548":45695,"_5":17443,"_23820":45570,"_2384":45696},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2857":1564,"_25170":1564,"_5":12294,"_2384":45698,"_25506":45699,"_17548":45700,"_23820":1564},"Lamassu IoT Platform",[40849,42193],[],{"_2857":1565,"_25170":1564,"_17548":45702,"_5":17443,"_23820":1564,"_2384":45703},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2857":1566,"_25170":1564,"_5":25503,"_17548":45705,"_23820":45706,"_2384":45184},[],"/docs/pr-preview/pr-38/platform/overview#start-here",{"_2857":1567,"_25170":1564,"_5":25503,"_17548":45708,"_23820":45709,"_2384":45710},[],"/docs/pr-preview/pr-38/platform/overview#choose-your-path","Choose your path",{"_2857":1568,"_25170":1564,"_5":25503,"_17548":45712,"_23820":45713,"_2384":45714},[],"/docs/pr-preview/pr-38/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2857":1569,"_25170":1564,"_5":25503,"_17548":45716,"_23820":45717,"_2384":45718},[],"/docs/pr-preview/pr-38/platform/overview#core-capabilities","Core capabilities",{"_2857":1570,"_25170":1564,"_5":25503,"_17548":45720,"_23820":45721,"_2384":45722},[],"/docs/pr-preview/pr-38/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2857":1571,"_25170":1564,"_5":25503,"_17548":45724,"_23820":45725,"_2384":45726},[],"/docs/pr-preview/pr-38/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2857":1572,"_25170":1564,"_5":25503,"_17548":45728,"_23820":45729,"_2384":45730},[],"/docs/pr-preview/pr-38/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2857":1573,"_25170":1564,"_5":25503,"_17548":45732,"_23820":45733,"_2384":45734},[],"/docs/pr-preview/pr-38/platform/overview#automate-device-identities","Automate device identities",{"_2857":1574,"_25170":1564,"_5":25503,"_17548":45736,"_23820":45737,"_2384":45738},[],"/docs/pr-preview/pr-38/platform/overview#publish-validation-status","Publish validation status",{"_2857":1575,"_25170":1564,"_5":25503,"_17548":45740,"_23820":45741,"_2384":45742},[],"/docs/pr-preview/pr-38/platform/overview#react-to-events","React to events",{"_2857":1576,"_25170":1564,"_5":25503,"_17548":45744,"_23820":45745,"_2384":45746},[],"/docs/pr-preview/pr-38/platform/overview#operational-reference","Operational reference",{"_2857":1577,"_25170":1564,"_17548":45748,"_5":17443,"_23820":1564,"_2384":45749},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2857":1578,"_25170":1564,"_17548":45751,"_5":17443,"_23820":45706,"_2384":45752},[],"Choose the result you need:",{"_2857":1579,"_25170":1564,"_17548":45754,"_5":17443,"_23820":45706,"_2384":45755},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2857":1580,"_25170":1564,"_17548":45757,"_5":17443,"_23820":45706,"_2384":45758},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2857":1581,"_25170":1564,"_17548":45760,"_5":17443,"_23820":45706,"_2384":45761},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2857":1582,"_25170":1564,"_17548":45763,"_5":17443,"_23820":45709,"_2384":45764},[],"Section",{"_2857":1583,"_25170":1564,"_17548":45766,"_5":17443,"_23820":45709,"_2384":45767},[],"What you manage",{"_2857":1584,"_25170":1564,"_17548":45769,"_5":17443,"_23820":45709,"_2384":45770},[],"Entry point",{"_2857":1585,"_25170":1564,"_17548":45772,"_5":17443,"_23820":45709,"_2384":45773},[],"**PKI**",{"_2857":1586,"_25170":1564,"_17548":45775,"_5":17443,"_23820":45709,"_2384":45776},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2857":1587,"_25170":1564,"_17548":45778,"_5":17443,"_23820":45709,"_2384":45779},[],"PKI overview",{"_2857":1588,"_25170":1564,"_17548":45781,"_5":17443,"_23820":45709,"_2384":45782},[],"**IoT Fleets**",{"_2857":1589,"_25170":1564,"_17548":45784,"_5":17443,"_23820":45709,"_2384":45785},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2857":1590,"_25170":1564,"_17548":45787,"_5":17443,"_23820":45709,"_2384":45788},[],"IoT Fleets overview",{"_2857":1591,"_25170":1564,"_17548":45790,"_5":17443,"_23820":45709,"_2384":45791},[],"**Administration**",{"_2857":1592,"_25170":1564,"_17548":45793,"_5":17443,"_23820":45709,"_2384":45794},[],"Operator permissions, audit and event subscriptions.",{"_2857":1593,"_25170":1564,"_17548":45796,"_5":17443,"_23820":45709,"_2384":42191},[],{"_2857":1594,"_25170":1564,"_17548":45798,"_5":17443,"_23820":45709,"_2384":45799},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2857":1595,"_25170":1564,"_17548":45801,"_5":17443,"_23820":45713,"_2384":45802},[],"An identity's journey connects four responsibilities:",{"_2857":1596,"_25170":1564,"_17548":45804,"_5":17443,"_23820":45713,"_2384":45805},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2857":1597,"_25170":1564,"_17548":45807,"_5":17443,"_23820":45713,"_2384":45808},[],"The provisioning administrator configures the DMS and initial trust.",{"_2857":1598,"_25170":1564,"_17548":45810,"_5":17443,"_23820":45713,"_2384":45811},[],"The device client requests a certificate and installs it with the matching key.",{"_2857":1599,"_25170":1564,"_17548":45813,"_5":17443,"_23820":45713,"_2384":45814},[],"The consumer validates the identity and applies its access permissions.",{"_2857":1600,"_25170":1564,"_17548":45816,"_5":17443,"_23820":45713,"_2384":45817},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2857":1601,"_25170":1564,"_17548":45819,"_5":17443,"_23820":45721,"_2384":45820},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2857":1602,"_25170":1564,"_17548":45822,"_5":17443,"_23820":45725,"_2384":45823},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2857":1603,"_25170":1564,"_17548":45825,"_5":17443,"_23820":45729,"_2384":45826},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2857":1604,"_25170":1564,"_17548":45828,"_5":17443,"_23820":45733,"_2384":45829},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2857":1605,"_25170":1564,"_17548":45831,"_5":17443,"_23820":45737,"_2384":45832},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2857":1606,"_25170":1564,"_17548":45834,"_5":17443,"_23820":45741,"_2384":45835},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2857":1607,"_25170":1564,"_17548":45837,"_5":17443,"_23820":45745,"_2384":45278},[],{"_2857":1608,"_25170":1564,"_17548":45839,"_5":17443,"_23820":45745,"_2384":45840},[],"What it prepares or checks",{"_2857":1609,"_25170":1564,"_17548":45842,"_5":17443,"_23820":45745,"_2384":45281},[],{"_2857":1610,"_25170":1564,"_17548":45844,"_5":17443,"_23820":45745,"_2384":45845},[],"Key custody, CA hierarchy, profiles and validation.",{"_2857":1611,"_25170":1564,"_17548":45847,"_5":17443,"_23820":45745,"_2384":45848},[],"Fleet administrator",{"_2857":1612,"_25170":1564,"_17548":45850,"_5":17443,"_23820":45745,"_2384":45851},[],"DMS, device admission, renewal policy and inventory.",{"_2857":1613,"_25170":1564,"_17548":45853,"_5":17443,"_23820":45745,"_2384":45293},[],{"_2857":1614,"_25170":1564,"_17548":45855,"_5":17443,"_23820":45745,"_2384":45856},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2857":1615,"_25170":1564,"_17548":45858,"_5":17443,"_23820":45745,"_2384":45299},[],{"_2857":1616,"_25170":1564,"_17548":45860,"_5":17443,"_23820":45745,"_2384":45861},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2857":1617,"_25170":1564,"_17548":45863,"_5":17443,"_23820":45745,"_2384":45864},[],"Infrastructure operator",{"_2857":1618,"_25170":1564,"_17548":45866,"_5":17443,"_23820":45745,"_2384":45867},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2857":1619,"_25170":1564,"_17548":45869,"_5":17443,"_23820":45745,"_2384":45870},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2857":1620,"_25170":1620,"_5":12294,"_2384":45872,"_25506":45873,"_17548":45876,"_23820":1620},"CA hierarchy and rotation",[40849,42193,45874,45875],"PKI","Keys, authorities and certificates",[],{"_2857":1621,"_25170":1620,"_17548":45878,"_5":17443,"_23820":1620,"_2384":45879},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2857":1622,"_25170":1620,"_5":25503,"_17548":45881,"_23820":45882,"_2384":45883},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2857":1623,"_25170":1620,"_5":25503,"_17548":45885,"_23820":45886,"_2384":45887},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2857":1624,"_25170":1620,"_5":25503,"_17548":45889,"_23820":45890,"_2384":45891},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2857":1625,"_25170":1620,"_5":25503,"_17548":45893,"_23820":45894,"_2384":45895},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2857":1626,"_25170":1620,"_5":25503,"_17548":45897,"_23820":45898,"_2384":45899},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2857":1627,"_25170":1620,"_5":25503,"_17548":45901,"_23820":45902,"_2384":45903},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2857":1628,"_25170":1620,"_5":25503,"_17548":45905,"_23820":45906,"_2384":45907},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2857":1629,"_25170":1620,"_5":25503,"_17548":45909,"_23820":45910,"_2384":45911},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2857":1630,"_25170":1620,"_5":25503,"_17548":45913,"_23820":45914,"_2384":45915},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2857":1631,"_25170":1620,"_5":25503,"_17548":45917,"_23820":45918,"_2384":45919},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2857":1632,"_25170":1620,"_5":25503,"_17548":45921,"_23820":45922,"_2384":45923},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2857":1633,"_25170":1620,"_5":25503,"_17548":45925,"_23820":45926,"_2384":45927},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2857":1634,"_25170":1620,"_17548":45929,"_5":17443,"_23820":1620,"_2384":45930},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2857":1635,"_25170":1620,"_17548":45932,"_5":17443,"_23820":1620,"_2384":45933},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2857":1636,"_25170":1620,"_17548":45935,"_5":17443,"_23820":45882,"_2384":45936},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2857":1637,"_25170":1620,"_17548":45938,"_5":17443,"_23820":45882,"_2384":45939},[],"environment, such as production and preproduction;",{"_2857":1638,"_25170":1620,"_17548":45941,"_5":17443,"_23820":45882,"_2384":45942},[],"owner or operating team;",{"_2857":1639,"_25170":1620,"_17548":45944,"_5":17443,"_23820":45882,"_2384":45945},[],"device family or manufacturing process;",{"_2857":1640,"_25170":1620,"_17548":45947,"_5":17443,"_23820":45882,"_2384":45948},[],"region or regulatory requirement;",{"_2857":1641,"_25170":1620,"_17548":45950,"_5":17443,"_23820":45882,"_2384":45951},[],"cryptographic engine or key policy;",{"_2857":1642,"_25170":1620,"_17548":45953,"_5":17443,"_23820":45882,"_2384":45954},[],"maintenance window and renewal cadence.",{"_2857":1643,"_25170":1620,"_17548":45956,"_5":17443,"_23820":45882,"_2384":45957},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2857":1644,"_25170":1620,"_17548":45959,"_5":17443,"_23820":45882,"_2384":45960},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2857":1645,"_25170":1620,"_17548":45962,"_5":17443,"_23820":45886,"_2384":45963},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2857":1646,"_25170":1620,"_17548":45965,"_5":17443,"_23820":45886,"_2384":45966},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2857":1647,"_25170":1620,"_17548":45968,"_5":17443,"_23820":45886,"_2384":45969},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2857":1648,"_25170":1620,"_17548":45971,"_5":17443,"_23820":45890,"_2384":45972},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2857":1649,"_25170":1620,"_17548":45974,"_5":17443,"_23820":45890,"_2384":45975},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2857":1650,"_25170":1620,"_17548":45977,"_5":17443,"_23820":45890,"_2384":45978},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2857":1651,"_25170":1620,"_17548":45980,"_5":17443,"_23820":45890,"_2384":45981},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2857":1652,"_25170":1620,"_17548":45983,"_5":17443,"_23820":45898,"_2384":45984},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2857":1653,"_25170":1620,"_17548":45986,"_5":17443,"_23820":45902,"_2384":45987},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2857":1654,"_25170":1620,"_17548":45989,"_5":17443,"_23820":45906,"_2384":45990},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2857":1655,"_25170":1620,"_17548":45992,"_5":17443,"_23820":45910,"_2384":45993},[],"Update the enrollment CA and profile of the DMSs, and add the old CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) while old-CA cohorts still renew. The DMS guide documents the setting.",{"_2857":1656,"_25170":1620,"_17548":45995,"_5":17443,"_23820":45914,"_2384":45996},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2857":1657,"_25170":1620,"_17548":45998,"_5":17443,"_23820":45918,"_2384":45999},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2857":1658,"_25170":1620,"_17548":46001,"_5":17443,"_23820":45922,"_2384":46002},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2857":1659,"_25170":1620,"_17548":46004,"_5":17443,"_23820":45922,"_2384":46005},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2857":1660,"_25170":1620,"_17548":46007,"_5":17443,"_23820":45922,"_2384":46008},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2857":1661,"_25170":1620,"_17548":46010,"_5":17443,"_23820":45922,"_2384":46011},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2857":1662,"_25170":1620,"_17548":46013,"_5":17443,"_23820":45926,"_2384":46014},[],"The new chain ends in an anchor installed by the consumer.",{"_2857":1663,"_25170":1620,"_17548":46016,"_5":17443,"_23820":45926,"_2384":46017},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2857":1664,"_25170":1620,"_17548":46019,"_5":17443,"_23820":45926,"_2384":46020},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2857":1665,"_25170":1620,"_17548":46022,"_5":17443,"_23820":45926,"_2384":46023},[],"Re-enrollment accepts the old identity during the planned period.",{"_2857":1666,"_25170":1620,"_17548":46025,"_5":17443,"_23820":45926,"_2384":46026},[],"OCSP and CRL respond for the authorities that remain active.",{"_2857":1667,"_25170":1620,"_17548":46028,"_5":17443,"_23820":45926,"_2384":46029},[],"No DMS is left accidentally issuing from the old CA.",{"_2857":1668,"_25170":1620,"_17548":46031,"_5":17443,"_23820":45926,"_2384":46032},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2857":1669,"_25170":1669,"_5":12294,"_2384":46034,"_25506":46035,"_17548":46036,"_23820":1669},"Certification authorities",[40849,42193,45874,45875],[],{"_2857":1670,"_25170":1669,"_17548":46038,"_5":17443,"_23820":1669,"_2384":46039},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2857":1671,"_25170":1669,"_5":25503,"_17548":46041,"_23820":46042,"_2384":46043},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2857":1672,"_25170":1669,"_5":25503,"_17548":46045,"_23820":46046,"_2384":46047},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2857":1673,"_25170":1669,"_5":25503,"_17548":46049,"_23820":46050,"_2384":40859},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#before-you-begin",{"_2857":1674,"_25170":1669,"_5":25503,"_17548":46052,"_23820":46053,"_2384":46054},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2857":1675,"_25170":1669,"_5":25503,"_17548":46056,"_23820":46057,"_2384":46058},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2857":1676,"_25170":1669,"_5":25503,"_17548":46060,"_23820":46061,"_2384":46062},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2857":1677,"_25170":1669,"_5":25503,"_17548":46064,"_23820":46065,"_2384":46066},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2857":1678,"_25170":1669,"_5":25503,"_17548":46068,"_23820":46069,"_2384":46070},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2857":1679,"_25170":1669,"_5":25503,"_17548":46072,"_23820":46073,"_2384":46074},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2857":1680,"_25170":1669,"_5":25503,"_17548":46076,"_23820":46077,"_2384":46078},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2857":1681,"_25170":1669,"_5":25503,"_17548":46080,"_23820":46081,"_2384":46082},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2857":1682,"_25170":1669,"_5":25503,"_17548":46084,"_23820":46085,"_2384":46086},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2857":1683,"_25170":1669,"_5":25503,"_17548":46088,"_23820":46089,"_2384":46090},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2857":1684,"_25170":1669,"_5":25503,"_17548":46092,"_23820":46093,"_2384":46094},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2857":1685,"_25170":1669,"_5":25503,"_17548":46096,"_23820":46097,"_2384":46098},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2857":1686,"_25170":1669,"_5":25503,"_17548":46100,"_23820":46101,"_2384":46102},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2857":1687,"_25170":1669,"_5":25503,"_17548":46104,"_23820":46105,"_2384":46106},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2857":1688,"_25170":1669,"_5":25503,"_17548":46108,"_23820":46109,"_2384":46110},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2857":1689,"_25170":1669,"_5":25503,"_17548":46112,"_23820":46113,"_2384":46114},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2857":1690,"_25170":1669,"_5":25503,"_17548":46116,"_23820":46117,"_2384":46118},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2857":1691,"_25170":1669,"_5":25503,"_17548":46120,"_23820":46121,"_2384":46122},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2857":1692,"_25170":1669,"_5":25503,"_17548":46124,"_23820":46125,"_2384":46126},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2857":1693,"_25170":1669,"_17548":46128,"_5":17443,"_23820":1669,"_2384":46129},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2857":1694,"_25170":1669,"_17548":46131,"_5":17443,"_23820":1669,"_2384":46132},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2857":1695,"_25170":1669,"_17548":46134,"_5":17443,"_23820":1669,"_2384":46135},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2857":1696,"_25170":1669,"_17548":46137,"_5":17443,"_23820":46042,"_2384":46138},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2857":1697,"_25170":1669,"_17548":46140,"_5":17443,"_23820":46042,"_2384":46141},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2857":1698,"_25170":1669,"_17548":46143,"_5":17443,"_23820":46042,"_2384":46144},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2857":1699,"_25170":1669,"_17548":46146,"_5":17443,"_23820":46042,"_2384":46147},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2857":1700,"_25170":1669,"_17548":46149,"_5":17443,"_23820":46042,"_2384":46150},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2857":1701,"_25170":1669,"_17548":46152,"_5":17443,"_23820":46050,"_2384":46153},[],"Decide whether the CA will be a root or an intermediate.",{"_2857":1702,"_25170":1669,"_17548":46155,"_5":17443,"_23820":46050,"_2384":46156},[],"Choose the engine that will keep the key.",{"_2857":1703,"_25170":1669,"_17548":46158,"_5":17443,"_23820":46050,"_2384":46159},[],"Define a validity longer than that of the certificates it will issue.",{"_2857":1704,"_25170":1669,"_17548":46161,"_5":17443,"_23820":46050,"_2384":46162},[],"For an intermediate CA, make sure the parent CA is active.",{"_2857":1705,"_25170":1669,"_17548":46164,"_5":17443,"_23820":46053,"_2384":46165},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2857":1706,"_25170":1669,"_17548":46167,"_5":17443,"_23820":46057,"_2384":46168},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2857":1707,"_25170":1669,"_17548":46170,"_5":17443,"_23820":46057,"_2384":46171},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2857":1708,"_25170":1669,"_17548":46173,"_5":17443,"_23820":46061,"_2384":46174},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2857":1709,"_25170":1669,"_17548":46176,"_5":17443,"_23820":46065,"_2384":46177},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2857":1710,"_25170":1669,"_17548":46179,"_5":17443,"_23820":46065,"_2384":46180},[],"`C`: two-letter ISO 3166-1 country code.",{"_2857":1711,"_25170":1669,"_17548":46182,"_5":17443,"_23820":46065,"_2384":46183},[],"`ST`: state or province.",{"_2857":1712,"_25170":1669,"_17548":46185,"_5":17443,"_23820":46065,"_2384":46186},[],"`L`: locality.",{"_2857":1713,"_25170":1669,"_17548":46188,"_5":17443,"_23820":46065,"_2384":46189},[],"`O`: organization.",{"_2857":1714,"_25170":1669,"_17548":46191,"_5":17443,"_23820":46065,"_2384":46192},[],"`OU`: organizational unit.",{"_2857":1715,"_25170":1669,"_17548":46194,"_5":17443,"_23820":46065,"_2384":46195},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2857":1716,"_25170":1669,"_17548":46197,"_5":17443,"_23820":46069,"_2384":46198},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2857":1717,"_25170":1669,"_17548":46200,"_5":17443,"_23820":46069,"_2384":46201},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2857":1718,"_25170":1669,"_17548":46203,"_5":17443,"_23820":46073,"_2384":46204},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2857":1719,"_25170":1669,"_17548":46206,"_5":17443,"_23820":46073,"_2384":46207},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2857":1720,"_25170":1669,"_17548":46209,"_5":17443,"_23820":46077,"_2384":46210},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2857":1721,"_25170":1669,"_17548":46212,"_5":17443,"_23820":46077,"_2384":46213},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2857":1722,"_25170":1669,"_17548":46215,"_5":17443,"_23820":46081,"_2384":46216},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2857":1723,"_25170":1669,"_17548":46218,"_5":17443,"_23820":46085,"_2384":46219},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2857":1724,"_25170":1669,"_17548":46221,"_5":17443,"_23820":46089,"_2384":46222},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2857":1725,"_25170":1669,"_17548":46224,"_5":17443,"_23820":46093,"_2384":46225},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2857":1726,"_25170":1669,"_17548":46227,"_5":17443,"_23820":46097,"_2384":46228},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2857":1727,"_25170":1669,"_17548":46230,"_5":17443,"_23820":46097,"_2384":46231},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2857":1728,"_25170":1669,"_17548":46233,"_5":17443,"_23820":46101,"_2384":46234},[],"Open a CA from the inventory to review:",{"_2857":1729,"_25170":1669,"_17548":46236,"_5":17443,"_23820":46101,"_2384":46237},[],"Status and validity period.",{"_2857":1730,"_25170":1669,"_17548":46239,"_5":17443,"_23820":46101,"_2384":46240},[],"Certificate and chain in PEM format.",{"_2857":1731,"_25170":1669,"_17548":46242,"_5":17443,"_23820":46101,"_2384":46243},[],"Number of active, expired and revoked certificates.",{"_2857":1732,"_25170":1669,"_17548":46245,"_5":17443,"_23820":46101,"_2384":46246},[],"Certificates issued in **Issued Certificates**.",{"_2857":1733,"_25170":1669,"_17548":46248,"_5":17443,"_23820":46101,"_2384":46249},[],"The CRL linked to the authority.",{"_2857":1734,"_25170":1669,"_17548":46251,"_5":17443,"_23820":46101,"_2384":46252},[],"Metadata and the associated cryptographic engine.",{"_2857":1735,"_25170":1669,"_17548":46254,"_5":17443,"_23820":46101,"_2384":46255},[],"You can filter the inventory by name, status and CA type.",{"_2857":1736,"_25170":1669,"_17548":46257,"_5":17443,"_23820":46105,"_2384":46258},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2857":1737,"_25170":1669,"_17548":46260,"_5":17443,"_23820":46105,"_2384":46261},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2857":1738,"_25170":1669,"_17548":46263,"_5":17443,"_23820":46105,"_2384":46264},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2857":1739,"_25170":1669,"_17548":46266,"_5":17443,"_23820":46105,"_2384":46267},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2857":1740,"_25170":1669,"_17548":46269,"_5":17443,"_23820":46109,"_2384":46270},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2857":1741,"_25170":1669,"_17548":46272,"_5":17443,"_23820":46113,"_2384":46273},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2857":1742,"_25170":1669,"_17548":46275,"_5":17443,"_23820":46117,"_2384":46276},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2857":1743,"_25170":1669,"_17548":46278,"_5":17443,"_23820":46121,"_2384":46279},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2857":1744,"_25170":1669,"_17548":46281,"_5":17443,"_23820":46125,"_2384":46282},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2857":1745,"_25170":1669,"_17548":46284,"_5":17443,"_23820":46125,"_2384":46285},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2857":1746,"_25170":1746,"_5":12294,"_2384":46287,"_25506":46288,"_17548":46289,"_23820":1746},"Certificate profiles",[40849,42193,45874,45875],[],{"_2857":1747,"_25170":1746,"_17548":46291,"_5":17443,"_23820":1746,"_2384":46292},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2857":1748,"_25170":1746,"_5":25503,"_17548":46294,"_23820":46295,"_2384":46296},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2857":1749,"_25170":1746,"_5":25503,"_17548":46298,"_23820":46299,"_2384":46300},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#validity","Validity",{"_2857":1750,"_25170":1746,"_5":25503,"_17548":46302,"_23820":46303,"_2384":46304},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2857":1751,"_25170":1746,"_5":25503,"_17548":46306,"_23820":46307,"_2384":46308},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2857":1752,"_25170":1746,"_5":25503,"_17548":46310,"_23820":46311,"_2384":46312},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#subject","Subject",{"_2857":1753,"_25170":1746,"_5":25503,"_17548":46314,"_23820":46315,"_2384":46316},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2857":1754,"_25170":1746,"_5":25503,"_17548":46318,"_23820":46319,"_2384":46320},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2857":1755,"_25170":1746,"_5":25503,"_17548":46322,"_23820":46323,"_2384":46324},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2857":1756,"_25170":1746,"_5":25503,"_17548":46326,"_23820":46327,"_2384":46328},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2857":1757,"_25170":1746,"_5":25503,"_17548":46330,"_23820":46331,"_2384":46332},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2857":1758,"_25170":1746,"_5":25503,"_17548":46334,"_23820":46335,"_2384":46336},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2857":1759,"_25170":1746,"_5":25503,"_17548":46338,"_23820":46339,"_2384":46340},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2857":1760,"_25170":1746,"_5":25503,"_17548":46342,"_23820":46343,"_2384":46344},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2857":1761,"_25170":1746,"_5":25503,"_17548":46346,"_23820":46347,"_2384":46348},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2857":1762,"_25170":1746,"_5":25503,"_17548":46350,"_23820":46351,"_2384":46352},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#design-examples","Design examples",{"_2857":1763,"_25170":1746,"_5":25503,"_17548":46354,"_23820":46355,"_2384":46356},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2857":1764,"_25170":1746,"_17548":46358,"_5":17443,"_23820":1746,"_2384":46359},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2857":1765,"_25170":1746,"_17548":46361,"_5":17443,"_23820":1746,"_2384":46362},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2857":1766,"_25170":1746,"_17548":46364,"_5":17443,"_23820":46299,"_2384":46365},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2857":1767,"_25170":1746,"_17548":46367,"_5":17443,"_23820":46299,"_2384":46368},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2857":1768,"_25170":1746,"_17548":46370,"_5":17443,"_23820":46303,"_2384":46371},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2857":1769,"_25170":1746,"_17548":46373,"_5":17443,"_23820":46307,"_2384":46374},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2857":1770,"_25170":1746,"_17548":46376,"_5":17443,"_23820":46307,"_2384":46377},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2857":1771,"_25170":1746,"_17548":46379,"_5":17443,"_23820":46307,"_2384":46380},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2857":1772,"_25170":1746,"_17548":46382,"_5":17443,"_23820":46311,"_2384":46383},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2857":1773,"_25170":1746,"_17548":46385,"_5":17443,"_23820":46315,"_2384":46386},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2857":1774,"_25170":1746,"_17548":46388,"_5":17443,"_23820":46315,"_2384":46389},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2857":1775,"_25170":1746,"_17548":46391,"_5":17443,"_23820":46319,"_2384":46392},[],"The cryptographic enforcement can:",{"_2857":1776,"_25170":1746,"_17548":46394,"_5":17443,"_23820":46319,"_2384":46395},[],"allow or block RSA keys;",{"_2857":1777,"_25170":1746,"_17548":46397,"_5":17443,"_23820":46319,"_2384":46398},[],"limit the supported RSA sizes;",{"_2857":1778,"_25170":1746,"_17548":46400,"_5":17443,"_23820":46319,"_2384":46401},[],"allow or block ECDSA keys;",{"_2857":1779,"_25170":1746,"_17548":46403,"_5":17443,"_23820":46319,"_2384":46404},[],"limit the supported ECDSA sizes or curves.",{"_2857":1780,"_25170":1746,"_17548":46406,"_5":17443,"_23820":46319,"_2384":46407},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2857":1781,"_25170":1746,"_17548":46409,"_5":17443,"_23820":46323,"_2384":46410},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2857":1782,"_25170":1746,"_17548":46412,"_5":17443,"_23820":46323,"_2384":43914},[],{"_2857":1783,"_25170":1746,"_17548":46414,"_5":17443,"_23820":46323,"_2384":46415},[],"First choice",{"_2857":1784,"_25170":1746,"_17548":46417,"_5":17443,"_23820":46323,"_2384":46418},[],"Second choice",{"_2857":1785,"_25170":1746,"_17548":46420,"_5":17443,"_23820":46323,"_2384":46421},[],"If neither is supplied",{"_2857":1786,"_25170":1746,"_17548":46423,"_5":17443,"_23820":46323,"_2384":46424},[],"Direct signing with a CA",{"_2857":1787,"_25170":1746,"_17548":46426,"_5":17443,"_23820":46323,"_2384":46427},[],"`issuance_profile` embedded in the request",{"_2857":1788,"_25170":1746,"_17548":46429,"_5":17443,"_23820":46323,"_2384":46430},[],"Request `issuance_profile_id`",{"_2857":1789,"_25170":1746,"_17548":46432,"_5":17443,"_23820":46323,"_2384":46433},[],"CA default profile (`profile_id`).",{"_2857":1790,"_25170":1746,"_17548":46435,"_5":17443,"_23820":46323,"_2384":46436},[],"Issuance through a DMS",{"_2857":1791,"_25170":1746,"_17548":46438,"_5":17443,"_23820":46323,"_2384":46439},[],"`settings.issuance_profile_id`",{"_2857":1792,"_25170":1746,"_17548":46441,"_5":17443,"_23820":46323,"_2384":46442},[],"`settings.issuance_profile` embedded in the DMS",{"_2857":1793,"_25170":1746,"_17548":46444,"_5":17443,"_23820":46323,"_2384":46445},[],"Enrollment CA default profile.",{"_2857":1794,"_25170":1746,"_17548":46447,"_5":17443,"_23820":46323,"_2384":46448},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2857":1795,"_25170":1746,"_17548":46450,"_5":17443,"_23820":46323,"_2384":46451},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2857":1796,"_25170":1746,"_17548":46453,"_5":17443,"_23820":46331,"_2384":46454},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2857":1797,"_25170":1746,"_17548":46456,"_5":17443,"_23820":46335,"_2384":46457},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2857":1798,"_25170":1746,"_17548":46459,"_5":17443,"_23820":46339,"_2384":46460},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2857":1799,"_25170":1746,"_17548":46462,"_5":17443,"_23820":46343,"_2384":46463},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2857":1800,"_25170":1746,"_17548":46465,"_5":17443,"_23820":46347,"_2384":46466},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2857":1801,"_25170":1746,"_17548":46468,"_5":17443,"_23820":46347,"_2384":46469},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2857":1802,"_25170":1746,"_17548":46471,"_5":17443,"_23820":46351,"_2384":46472},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2857":1803,"_25170":1746,"_17548":46474,"_5":17443,"_23820":46351,"_2384":46475},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2857":1804,"_25170":1746,"_17548":46477,"_5":17443,"_23820":46351,"_2384":46478},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2857":1805,"_25170":1746,"_17548":46480,"_5":17443,"_23820":46351,"_2384":46481},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2857":1806,"_25170":1746,"_17548":46483,"_5":17443,"_23820":46355,"_2384":46484},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2857":1807,"_25170":1746,"_17548":46486,"_5":17443,"_23820":46355,"_2384":46487},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2857":1808,"_25170":1808,"_5":12294,"_2384":46489,"_25506":46490,"_17548":46492,"_23820":1808},"Certificate validation",[40849,42193,45874,46491],"Validation",[],{"_2857":1809,"_25170":1808,"_17548":46494,"_5":17443,"_23820":1808,"_2384":46495},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2857":1810,"_25170":1808,"_5":25503,"_17548":46497,"_23820":46498,"_2384":46499},[],"/docs/pr-preview/pr-38/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2857":1811,"_25170":1808,"_5":25503,"_17548":46501,"_23820":46502,"_2384":46503},[],"/docs/pr-preview/pr-38/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2857":1812,"_25170":1808,"_5":25503,"_17548":46505,"_23820":46506,"_2384":46507},[],"/docs/pr-preview/pr-38/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2857":1813,"_25170":1808,"_17548":46509,"_5":17443,"_23820":1808,"_2384":46510},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2857":1814,"_25170":1808,"_17548":46512,"_5":17443,"_23820":46498,"_2384":46513},[],"Verify these criteria together:",{"_2857":1815,"_25170":1808,"_17548":46515,"_5":17443,"_23820":46498,"_2384":45498},[],{"_2857":1816,"_25170":1808,"_17548":46517,"_5":17443,"_23820":46498,"_2384":46518},[],"Required result",{"_2857":1817,"_25170":1808,"_17548":46520,"_5":17443,"_23820":46498,"_2384":46521},[],"Chain and signature",{"_2857":1818,"_25170":1808,"_17548":46523,"_5":17443,"_23820":46498,"_2384":46524},[],"Valid chain to a root deliberately installed in the consumer.",{"_2857":1819,"_25170":1808,"_17548":46526,"_5":17443,"_23820":46498,"_2384":46527},[],"Dates",{"_2857":1820,"_25170":1808,"_17548":46529,"_5":17443,"_23820":46498,"_2384":46530},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2857":1821,"_25170":1808,"_17548":46532,"_5":17443,"_23820":46498,"_2384":41896},[],{"_2857":1822,"_25170":1808,"_17548":46534,"_5":17443,"_23820":46498,"_2384":46535},[],"Name, SAN or identifier matches the expected peer.",{"_2857":1823,"_25170":1808,"_17548":46537,"_5":17443,"_23820":46498,"_2384":41232},[],{"_2857":1824,"_25170":1808,"_17548":46539,"_5":17443,"_23820":46498,"_2384":46540},[],"KU, EKU and constraints permit the specific operation.",{"_2857":1825,"_25170":1808,"_17548":46542,"_5":17443,"_23820":46498,"_2384":46543},[],"Revocation",{"_2857":1826,"_25170":1808,"_17548":46545,"_5":17443,"_23820":46498,"_2384":46546},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2857":1827,"_25170":1808,"_17548":46548,"_5":17443,"_23820":46498,"_2384":46549},[],"Authorization",{"_2857":1828,"_25170":1808,"_17548":46551,"_5":17443,"_23820":46498,"_2384":46552},[],"The application permits that identity to perform the action.",{"_2857":1829,"_25170":1808,"_17548":46554,"_5":17443,"_23820":46498,"_2384":46555},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2857":1830,"_25170":1808,"_17548":46557,"_5":17443,"_23820":46502,"_2384":46558},[],"Mechanism",{"_2857":1831,"_25170":1808,"_17548":46560,"_5":17443,"_23820":46502,"_2384":46561},[],"When to use it",{"_2857":1832,"_25170":1808,"_17548":46563,"_5":17443,"_23820":46502,"_2384":46564},[],"What you must maintain",{"_2857":1833,"_25170":1808,"_17548":46566,"_5":17443,"_23820":46502,"_2384":46567},[],"OCSP",{"_2857":1834,"_25170":1808,"_17548":46569,"_5":17443,"_23820":46502,"_2384":46570},[],"Status query for a specific certificate.",{"_2857":1835,"_25170":1808,"_17548":46572,"_5":17443,"_23820":46502,"_2384":46573},[],"Responder access, signature verification and cache/freshness policy.",{"_2857":1836,"_25170":1808,"_17548":46575,"_5":17443,"_23820":46502,"_2384":46576},[],"CRL",{"_2857":1837,"_25170":1808,"_17548":46578,"_5":17443,"_23820":46502,"_2384":46579},[],"Local checks for many certificates or offline operation.",{"_2857":1838,"_25170":1808,"_17548":46581,"_5":17443,"_23820":46502,"_2384":46582},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2857":1839,"_25170":1808,"_17548":46584,"_5":17443,"_23820":46502,"_2384":46585},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2857":1840,"_25170":1808,"_17548":46587,"_5":17443,"_23820":46502,"_2384":46588},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2857":1841,"_25170":1808,"_17548":46590,"_5":17443,"_23820":46506,"_2384":46591},[],"Accept a current, authorized certificate with a known chain.",{"_2857":1842,"_25170":1808,"_17548":46593,"_5":17443,"_23820":46506,"_2384":46594},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2857":1843,"_25170":1808,"_17548":46596,"_5":17443,"_23820":46506,"_2384":46597},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2857":1844,"_25170":1808,"_17548":46599,"_5":17443,"_23820":46506,"_2384":46600},[],"Check that a new connection with that identity is rejected.",{"_2857":1845,"_25170":1808,"_17548":46602,"_5":17443,"_23820":46506,"_2384":46603},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2857":1846,"_25170":1808,"_17548":46605,"_5":17443,"_23820":46506,"_2384":46606},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2857":1847,"_25170":1808,"_17548":46608,"_5":17443,"_23820":46506,"_2384":46609},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2857":1848,"_25170":1808,"_17548":46611,"_5":17443,"_23820":46506,"_2384":46612},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":1849,"_25170":1808,"_17548":46614,"_5":17443,"_23820":46506,"_2384":46615},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2857":1850,"_25170":1850,"_5":12294,"_2384":46617,"_25506":46618,"_17548":46619,"_23820":1850},"Certificates",[40849,42193,45874,45875],[],{"_2857":1851,"_25170":1850,"_17548":46621,"_5":17443,"_23820":1850,"_2384":46622},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2857":1852,"_25170":1850,"_5":25503,"_17548":46624,"_23820":46625,"_2384":46626},[],"/docs/pr-preview/pr-38/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2857":1853,"_25170":1850,"_5":25503,"_17548":46628,"_23820":46629,"_2384":46630},[],"/docs/pr-preview/pr-38/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2857":1854,"_25170":1850,"_5":25503,"_17548":46632,"_23820":46633,"_2384":46634},[],"/docs/pr-preview/pr-38/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2857":1855,"_25170":1850,"_5":25503,"_17548":46636,"_23820":46637,"_2384":46638},[],"/docs/pr-preview/pr-38/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2857":1856,"_25170":1850,"_5":25503,"_17548":46640,"_23820":46641,"_2384":46642},[],"/docs/pr-preview/pr-38/platform/pki/certificates#open-the-action","Open the action",{"_2857":1857,"_25170":1850,"_5":25503,"_17548":46644,"_23820":46645,"_2384":46646},[],"/docs/pr-preview/pr-38/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2857":1858,"_25170":1850,"_5":25503,"_17548":46648,"_23820":46649,"_2384":46650},[],"/docs/pr-preview/pr-38/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2857":1859,"_25170":1850,"_5":25503,"_17548":46652,"_23820":46653,"_2384":46654},[],"/docs/pr-preview/pr-38/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2857":1860,"_25170":1850,"_5":25503,"_17548":46656,"_23820":46657,"_2384":46658},[],"/docs/pr-preview/pr-38/platform/pki/certificates#continue","Continue",{"_2857":1861,"_25170":1850,"_17548":46660,"_5":17443,"_23820":1850,"_2384":46661},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2857":1862,"_25170":1850,"_17548":46663,"_5":17443,"_23820":46625,"_2384":46664},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2857":1863,"_25170":1850,"_17548":46666,"_5":17443,"_23820":46625,"_2384":46667},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2857":1864,"_25170":1850,"_17548":46669,"_5":17443,"_23820":46629,"_2384":46670},[],"Download the PEM and inspect it:",{"_2857":1865,"_25170":1850,"_17548":46672,"_5":17443,"_23820":46629,"_2384":46673},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2857":1866,"_25170":1850,"_17548":46675,"_5":17443,"_23820":46633,"_2384":46676},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2857":1867,"_25170":1850,"_17548":46678,"_5":17443,"_23820":46633,"_2384":46679},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2857":1868,"_25170":1850,"_17548":46681,"_5":17443,"_23820":46633,"_2384":46682},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2857":1869,"_25170":1850,"_17548":46684,"_5":17443,"_23820":46633,"_2384":46685},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2857":1870,"_25170":1850,"_17548":46687,"_5":17443,"_23820":46633,"_2384":46688},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2857":1871,"_25170":1850,"_17548":46690,"_5":17443,"_23820":46633,"_2384":46691},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2857":1872,"_25170":1850,"_17548":46693,"_5":17443,"_23820":46633,"_2384":46694},[],"For browser key generation, follow Issue your first certificate.",{"_2857":1873,"_25170":1850,"_17548":46696,"_5":17443,"_23820":46637,"_2384":46697},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2857":1874,"_25170":1850,"_17548":46699,"_5":17443,"_23820":46641,"_2384":46700},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2857":1875,"_25170":1850,"_17548":46702,"_5":17443,"_23820":46645,"_2384":46703},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2857":1876,"_25170":1850,"_17548":46705,"_5":17443,"_23820":46649,"_2384":46706},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2857":1877,"_25170":1850,"_17548":46708,"_5":17443,"_23820":46649,"_2384":46709},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2857":1878,"_25170":1850,"_17548":46711,"_5":17443,"_23820":46649,"_2384":46712},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2857":1879,"_25170":1850,"_17548":46714,"_5":17443,"_23820":46653,"_2384":46715},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2857":1880,"_25170":1850,"_17548":46717,"_5":17443,"_23820":46653,"_2384":46718},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2857":1881,"_25170":1850,"_17548":46720,"_5":17443,"_23820":46653,"_2384":46721},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2857":1882,"_25170":1850,"_17548":46723,"_5":17443,"_23820":46657,"_2384":46724},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":1883,"_25170":1850,"_17548":46726,"_5":17443,"_23820":46657,"_2384":46727},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2857":1884,"_25170":1884,"_5":12294,"_2384":46729,"_25506":46730,"_17548":46732,"_23820":1884},"Certificate lifecycle",[40849,42193,45874,46731],"Concepts",[],{"_2857":1885,"_25170":1884,"_17548":46734,"_5":17443,"_23820":1884,"_2384":46735},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2857":1886,"_25170":1884,"_5":25503,"_17548":46737,"_23820":46738,"_2384":46739},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2857":1887,"_25170":1884,"_5":25503,"_17548":46741,"_23820":46742,"_2384":46743},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2857":1888,"_25170":1884,"_5":25503,"_17548":46745,"_23820":46746,"_2384":46747},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2857":1889,"_25170":1884,"_5":25503,"_17548":46749,"_23820":46750,"_2384":46751},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2857":1890,"_25170":1884,"_5":25503,"_17548":46753,"_23820":46754,"_2384":46755},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2857":1891,"_25170":1884,"_5":25503,"_17548":46757,"_23820":46758,"_2384":46759},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2857":1892,"_25170":1884,"_5":25503,"_17548":46761,"_23820":46762,"_2384":46763},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2857":1893,"_25170":1884,"_5":25503,"_17548":46765,"_23820":46766,"_2384":46767},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2857":1894,"_25170":1884,"_5":25503,"_17548":46769,"_23820":46770,"_2384":46771},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2857":1895,"_25170":1884,"_5":25503,"_17548":46773,"_23820":46774,"_2384":46775},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2857":1896,"_25170":1884,"_17548":46777,"_5":17443,"_23820":1884,"_2384":46778},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2857":1897,"_25170":1884,"_17548":46780,"_5":17443,"_23820":46742,"_2384":46781},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2857":1898,"_25170":1884,"_17548":46783,"_5":17443,"_23820":46746,"_2384":46784},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2857":1899,"_25170":1884,"_17548":46786,"_5":17443,"_23820":46750,"_2384":46787},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2857":1900,"_25170":1884,"_17548":46789,"_5":17443,"_23820":46754,"_2384":46790},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2857":1901,"_25170":1884,"_17548":46792,"_5":17443,"_23820":46758,"_2384":46793},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2857":1902,"_25170":1884,"_17548":46795,"_5":17443,"_23820":46762,"_2384":46796},[],"Lamassu persists four X.509 states:",{"_2857":1903,"_25170":1884,"_17548":46798,"_5":17443,"_23820":46762,"_2384":46799},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2857":1904,"_25170":1884,"_17548":46801,"_5":17443,"_23820":46762,"_2384":46802},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2857":1905,"_25170":1884,"_17548":46804,"_5":17443,"_23820":46762,"_2384":46805},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2857":1906,"_25170":1884,"_17548":46807,"_5":17443,"_23820":46762,"_2384":46808},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2857":1907,"_25170":1884,"_17548":46810,"_5":17443,"_23820":46762,"_2384":46811},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2857":1908,"_25170":1884,"_17548":46813,"_5":17443,"_23820":46766,"_2384":46814},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2857":1909,"_25170":1884,"_17548":46816,"_5":17443,"_23820":46766,"_2384":46817},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2857":1910,"_25170":1884,"_17548":46819,"_5":17443,"_23820":46766,"_2384":46820},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2857":1911,"_25170":1884,"_17548":46822,"_5":17443,"_23820":46770,"_2384":46823},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2857":1912,"_25170":1884,"_17548":46825,"_5":17443,"_23820":46770,"_2384":46826},[],"Before confirming:",{"_2857":1913,"_25170":1884,"_17548":46828,"_5":17443,"_23820":46770,"_2384":46829},[],"Identify DMSs, devices and services that trust that chain.",{"_2857":1914,"_25170":1884,"_17548":46831,"_5":17443,"_23820":46770,"_2384":46832},[],"Distribute the new chain of trust.",{"_2857":1915,"_25170":1884,"_17548":46834,"_5":17443,"_23820":46770,"_2384":46835},[],"Reissue the necessary identities.",{"_2857":1916,"_25170":1884,"_17548":46837,"_5":17443,"_23820":46770,"_2384":46838},[],"Check OCSP and CRL from a real consumer.",{"_2857":1917,"_25170":1884,"_17548":46840,"_5":17443,"_23820":46770,"_2384":46841},[],"Revoke the old CA once no legitimate traffic remains.",{"_2857":1918,"_25170":1884,"_17548":46843,"_5":17443,"_23820":46770,"_2384":46844},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2857":1919,"_25170":1884,"_17548":46846,"_5":17443,"_23820":46774,"_2384":46847},[],"Certificates entering the preventive or critical renewal window.",{"_2857":1920,"_25170":1884,"_17548":46849,"_5":17443,"_23820":46774,"_2384":46850},[],"Repeated enrollment or re-enrollment failures.",{"_2857":1921,"_25170":1884,"_17548":46852,"_5":17443,"_23820":46774,"_2384":46853},[],"Status changes and revocation reasons.",{"_2857":1922,"_25170":1884,"_17548":46855,"_5":17443,"_23820":46774,"_2384":46856},[],"OCSP and CRL publication and validity.",{"_2857":1923,"_25170":1884,"_17548":46858,"_5":17443,"_23820":46774,"_2384":46859},[],"Dependencies still presenting a replaced certificate.",{"_2857":1924,"_25170":1884,"_17548":46861,"_5":17443,"_23820":46774,"_2384":46862},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2857":1925,"_25170":1925,"_5":12294,"_2384":46864,"_25506":46865,"_17548":46866,"_23820":1925},"Trust model",[40849,42193,45874,46731],[],{"_2857":1926,"_25170":1925,"_17548":46868,"_5":17443,"_23820":1925,"_2384":46869},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2857":1927,"_25170":1925,"_5":25503,"_17548":46871,"_23820":46872,"_2384":46873},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2857":1928,"_25170":1925,"_5":25503,"_17548":46875,"_23820":46876,"_2384":46877},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2857":1929,"_25170":1925,"_5":25503,"_17548":46879,"_23820":46880,"_2384":46881},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2857":1930,"_25170":1925,"_5":25503,"_17548":46883,"_23820":46884,"_2384":46885},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2857":1931,"_25170":1925,"_5":25503,"_17548":46887,"_23820":46888,"_2384":46889},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2857":1932,"_25170":1925,"_5":25503,"_17548":46891,"_23820":46892,"_2384":46893},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2857":1933,"_25170":1925,"_5":25503,"_17548":46895,"_23820":46896,"_2384":46897},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2857":1934,"_25170":1925,"_5":25503,"_17548":46899,"_23820":46900,"_2384":46901},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2857":1935,"_25170":1925,"_5":25503,"_17548":46903,"_23820":46904,"_2384":46905},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2857":1936,"_25170":1925,"_5":25503,"_17548":46907,"_23820":46908,"_2384":46909},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2857":1937,"_25170":1925,"_17548":46911,"_5":17443,"_23820":1925,"_2384":46912},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2857":1938,"_25170":1925,"_17548":46914,"_5":17443,"_23820":46876,"_2384":46915},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2857":1939,"_25170":1925,"_17548":46917,"_5":17443,"_23820":46880,"_2384":46918},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2857":1940,"_25170":1925,"_17548":46920,"_5":17443,"_23820":46884,"_2384":46921},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2857":1941,"_25170":1925,"_17548":46923,"_5":17443,"_23820":46888,"_2384":46924},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2857":1942,"_25170":1925,"_17548":46926,"_5":17443,"_23820":46892,"_2384":46927},[],"The device proves it can enroll according to the DMS policy.",{"_2857":1943,"_25170":1925,"_17548":46929,"_5":17443,"_23820":46892,"_2384":46930},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2857":1944,"_25170":1925,"_17548":46932,"_5":17443,"_23820":46892,"_2384":46933},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2857":1945,"_25170":1925,"_17548":46935,"_5":17443,"_23820":46892,"_2384":46936},[],"The device installs the certificate and the chain it needs.",{"_2857":1946,"_25170":1925,"_17548":46938,"_5":17443,"_23820":46892,"_2384":46939},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2857":1947,"_25170":1925,"_17548":46941,"_5":17443,"_23820":46892,"_2384":46942},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2857":1948,"_25170":1925,"_17548":46944,"_5":17443,"_23820":46896,"_2384":46945},[],"A DMS relates three sets that are worth designing separately:",{"_2857":1949,"_25170":1925,"_17548":46947,"_5":17443,"_23820":46896,"_2384":46948},[],"**Enrollment CA:** signs the new identities.",{"_2857":1950,"_25170":1925,"_17548":46950,"_5":17443,"_23820":46896,"_2384":46951},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the validation CAs configured in the re-enrollment block.",{"_2857":1951,"_25170":1925,"_17548":46953,"_5":17443,"_23820":46896,"_2384":46954},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2857":1952,"_25170":1925,"_17548":46956,"_5":17443,"_23820":46896,"_2384":46957},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2857":1953,"_25170":1925,"_17548":46959,"_5":17443,"_23820":46900,"_2384":46960},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2857":1954,"_25170":1925,"_17548":46962,"_5":17443,"_23820":46900,"_2384":46963},[],"that the current date is between `Not Before` and `Not After`;",{"_2857":1955,"_25170":1925,"_17548":46965,"_5":17443,"_23820":46900,"_2384":46966},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2857":1956,"_25170":1925,"_17548":46968,"_5":17443,"_23820":46900,"_2384":46969},[],"that names, SANs and subject match the expected identity;",{"_2857":1957,"_25170":1925,"_17548":46971,"_5":17443,"_23820":46900,"_2384":46972},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2857":1958,"_25170":1925,"_17548":46974,"_5":17443,"_23820":46900,"_2384":46975},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2857":1959,"_25170":1925,"_17548":46977,"_5":17443,"_23820":46900,"_2384":46978},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2857":1960,"_25170":1925,"_17548":46980,"_5":17443,"_23820":46904,"_2384":46981},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2857":1961,"_25170":1925,"_17548":46983,"_5":17443,"_23820":46908,"_2384":46984},[],"Keep the root out of daily operations, or with very restricted access.",{"_2857":1962,"_25170":1925,"_17548":46986,"_5":17443,"_23820":46908,"_2384":46987},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2857":1963,"_25170":1925,"_17548":46989,"_5":17443,"_23820":46908,"_2384":46990},[],"Assign explicit profiles to every use case.",{"_2857":1964,"_25170":1925,"_17548":46992,"_5":17443,"_23820":46908,"_2384":46993},[],"Distribute the new trust before starting a rotation.",{"_2857":1965,"_25170":1925,"_17548":46995,"_5":17443,"_23820":46908,"_2384":46996},[],"Keep enough overlap to renew a disconnected fleet.",{"_2857":1966,"_25170":1925,"_17548":46998,"_5":17443,"_23820":46908,"_2384":46999},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2857":1967,"_25170":1925,"_17548":47001,"_5":17443,"_23820":46908,"_2384":47002},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2857":1968,"_25170":1968,"_5":12294,"_2384":47004,"_25506":47005,"_17548":47006,"_23820":1968},"Revocation lists (CRL)",[40849,42193,45874,46491],[],{"_2857":1969,"_25170":1968,"_17548":47008,"_5":17443,"_23820":1968,"_2384":47009},[],"Generate and distribute signed lists to validate certificates offline.",{"_2857":1970,"_25170":1968,"_5":25503,"_17548":47011,"_23820":47012,"_2384":47013},[],"/docs/pr-preview/pr-38/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2857":1971,"_25170":1968,"_5":25503,"_17548":47015,"_23820":47016,"_2384":47017},[],"/docs/pr-preview/pr-38/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2857":1972,"_25170":1968,"_5":25503,"_17548":47019,"_23820":47020,"_2384":47021},[],"/docs/pr-preview/pr-38/platform/pki/crl#crl-contents","CRL contents",{"_2857":1973,"_25170":1968,"_5":25503,"_17548":47023,"_23820":47024,"_2384":47025},[],"/docs/pr-preview/pr-38/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2857":1974,"_25170":1968,"_5":25503,"_17548":47027,"_23820":47028,"_2384":47029},[],"/docs/pr-preview/pr-38/platform/pki/crl#va-role-management-api","VA role management API",{"_2857":1975,"_25170":1968,"_5":25503,"_17548":47031,"_23820":47032,"_2384":47033},[],"/docs/pr-preview/pr-38/platform/pki/crl#from-the-interface","From the interface",{"_2857":1976,"_25170":1968,"_5":25503,"_17548":47035,"_23820":47036,"_2384":47037},[],"/docs/pr-preview/pr-38/platform/pki/crl#references","References",{"_2857":1977,"_25170":1968,"_17548":47039,"_5":17443,"_23820":1968,"_2384":47040},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2857":1978,"_25170":1968,"_17548":47042,"_5":17443,"_23820":47012,"_2384":47043},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2857":1979,"_25170":1968,"_17548":47045,"_5":17443,"_23820":47012,"_2384":47046},[],"`crl_options` field",{"_2857":1980,"_25170":1968,"_17548":47048,"_5":17443,"_23820":47012,"_2384":41232},[],{"_2857":1981,"_25170":1968,"_17548":47050,"_5":17443,"_23820":47012,"_2384":47051},[],"Backend initial value",{"_2857":1982,"_25170":1968,"_17548":47053,"_5":17443,"_23820":47012,"_2384":47054},[],"`validity`",{"_2857":1983,"_25170":1968,"_17548":47056,"_5":17443,"_23820":47012,"_2384":47057},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2857":1984,"_25170":1968,"_17548":47059,"_5":17443,"_23820":47012,"_2384":47060},[],"7 days.",{"_2857":1985,"_25170":1968,"_17548":47062,"_5":17443,"_23820":47012,"_2384":47063},[],"`refresh_interval`",{"_2857":1986,"_25170":1968,"_17548":47065,"_5":17443,"_23820":47012,"_2384":47066},[],"Time since publication that triggers scheduled renewal.",{"_2857":1987,"_25170":1968,"_17548":47068,"_5":17443,"_23820":47012,"_2384":47069},[],"6 days and 23 hours.",{"_2857":1988,"_25170":1968,"_17548":47071,"_5":17443,"_23820":47012,"_2384":47072},[],"`regenerate_on_revoke`",{"_2857":1989,"_25170":1968,"_17548":47074,"_5":17443,"_23820":47012,"_2384":47075},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2857":1990,"_25170":1968,"_17548":47077,"_5":17443,"_23820":47012,"_2384":47078},[],"`true`.",{"_2857":1991,"_25170":1968,"_17548":47080,"_5":17443,"_23820":47012,"_2384":47081},[],"`subject_key_id_signer`",{"_2857":1992,"_25170":1968,"_17548":47083,"_5":17443,"_23820":47012,"_2384":47084},[],"Configuration field initialized with the CA’s SKI.",{"_2857":1993,"_25170":1968,"_17548":47086,"_5":17443,"_23820":47012,"_2384":47087},[],"CA SKI.",{"_2857":1994,"_25170":1968,"_17548":47089,"_5":17443,"_23820":47012,"_2384":47090},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2857":1995,"_25170":1968,"_17548":47092,"_5":17443,"_23820":47012,"_2384":47093},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2857":1996,"_25170":1968,"_17548":47095,"_5":17443,"_23820":47016,"_2384":47096},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2857":1997,"_25170":1968,"_17548":47098,"_5":17443,"_23820":47016,"_2384":47099},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2857":1998,"_25170":1968,"_17548":47101,"_5":17443,"_23820":47016,"_2384":47102},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2857":1999,"_25170":1968,"_17548":47104,"_5":17443,"_23820":47020,"_2384":47105},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2857":2000,"_25170":1968,"_17548":47107,"_5":17443,"_23820":47020,"_2384":47108},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2857":2001,"_25170":1968,"_17548":47110,"_5":17443,"_23820":47024,"_2384":47111},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2857":2002,"_25170":1968,"_17548":47113,"_5":17443,"_23820":47024,"_2384":47114},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2857":2003,"_25170":1968,"_17548":47116,"_5":17443,"_23820":47024,"_2384":47117},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2857":2004,"_25170":1968,"_17548":47119,"_5":17443,"_23820":47024,"_2384":47120},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2857":2005,"_25170":1968,"_17548":47122,"_5":17443,"_23820":47024,"_2384":47123},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2857":2006,"_25170":1968,"_17548":47125,"_5":17443,"_23820":47028,"_2384":47126},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2857":2007,"_25170":1968,"_17548":47128,"_5":17443,"_23820":47028,"_2384":43917},[],{"_2857":2008,"_25170":1968,"_17548":47130,"_5":17443,"_23820":47028,"_2384":47131},[],"Relative path",{"_2857":2009,"_25170":1968,"_17548":47133,"_5":17443,"_23820":47028,"_2384":43914},[],{"_2857":2010,"_25170":1968,"_17548":47135,"_5":17443,"_23820":47028,"_2384":47136},[],"`GET`",{"_2857":2011,"_25170":1968,"_17548":47138,"_5":17443,"_23820":47028,"_2384":47139},[],"`/v1/roles/{ca-ski}`",{"_2857":2012,"_25170":1968,"_17548":47141,"_5":17443,"_23820":47028,"_2384":47142},[],"Read `crl_options` and `latest_crl`.",{"_2857":2013,"_25170":1968,"_17548":47144,"_5":17443,"_23820":47028,"_2384":47145},[],"`PUT`",{"_2857":2014,"_25170":1968,"_17548":47147,"_5":17443,"_23820":47028,"_2384":47139},[],{"_2857":2015,"_25170":1968,"_17548":47149,"_5":17443,"_23820":47028,"_2384":47150},[],"Replace CRL configuration.",{"_2857":2016,"_25170":1968,"_17548":47152,"_5":17443,"_23820":47028,"_2384":47153},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2857":2017,"_25170":1968,"_17548":47155,"_5":17443,"_23820":47028,"_2384":47156},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2857":2018,"_25170":1968,"_17548":47158,"_5":17443,"_23820":47032,"_2384":47159},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2857":2019,"_25170":1968,"_17548":47161,"_5":17443,"_23820":47036,"_2384":47162},[],"RFC 5280: X.509 and CRL profile.",{"_2857":2020,"_25170":1968,"_17548":47164,"_5":17443,"_23820":47036,"_2384":47165},[],"OpenSSL: openssl-crl.",{"_2857":2021,"_25170":1968,"_17548":47167,"_5":17443,"_23820":47036,"_2384":47168},[],"OpenSSL: openssl-verify.",{"_2857":2022,"_25170":1968,"_17548":47170,"_5":17443,"_23820":47036,"_2384":47171},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":2023,"_25170":1968,"_17548":47173,"_5":17443,"_23820":47036,"_2384":47174},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2857":2024,"_25170":2024,"_5":12294,"_2384":47176,"_25506":47177,"_17548":47178,"_23820":2024},"Keys and cryptographic engines",[40849,42193,45874,45875],[],{"_2857":2025,"_25170":2024,"_17548":47180,"_5":17443,"_23820":2024,"_2384":47181},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2857":2026,"_25170":2024,"_5":25503,"_17548":47183,"_23820":47184,"_2384":47185},[],"/docs/pr-preview/pr-38/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2857":2027,"_25170":2024,"_5":25503,"_17548":47187,"_23820":47188,"_2384":47189},[],"/docs/pr-preview/pr-38/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2857":2028,"_25170":2024,"_5":25503,"_17548":47191,"_23820":47192,"_2384":47193},[],"/docs/pr-preview/pr-38/platform/pki/key-management#file-system","File System",{"_2857":2029,"_25170":2024,"_5":25503,"_17548":47195,"_23820":47196,"_2384":47197},[],"/docs/pr-preview/pr-38/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2857":2030,"_25170":2024,"_5":25503,"_17548":47199,"_23820":47200,"_2384":47201},[],"/docs/pr-preview/pr-38/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2857":2031,"_25170":2024,"_5":25503,"_17548":47203,"_23820":47204,"_2384":47205},[],"/docs/pr-preview/pr-38/platform/pki/key-management#aws-kms","AWS KMS",{"_2857":2032,"_25170":2024,"_5":25503,"_17548":47207,"_23820":47208,"_2384":47209},[],"/docs/pr-preview/pr-38/platform/pki/key-management#pkcs11","PKCS#11",{"_2857":2033,"_25170":2024,"_5":25503,"_17548":47211,"_23820":47212,"_2384":47213},[],"/docs/pr-preview/pr-38/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2857":2034,"_25170":2024,"_5":25503,"_17548":47215,"_23820":47216,"_2384":47217},[],"/docs/pr-preview/pr-38/platform/pki/key-management#key-inventory","Key inventory",{"_2857":2035,"_25170":2024,"_5":25503,"_17548":47219,"_23820":47220,"_2384":47221},[],"/docs/pr-preview/pr-38/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2857":2036,"_25170":2024,"_5":25503,"_17548":47223,"_23820":47224,"_2384":47225},[],"/docs/pr-preview/pr-38/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2857":2037,"_25170":2024,"_5":25503,"_17548":47227,"_23820":47228,"_2384":47229},[],"/docs/pr-preview/pr-38/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2857":2038,"_25170":2024,"_5":25503,"_17548":47231,"_23820":47232,"_2384":47233},[],"/docs/pr-preview/pr-38/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2857":2039,"_25170":2024,"_5":25503,"_17548":47235,"_23820":47236,"_2384":47237},[],"/docs/pr-preview/pr-38/platform/pki/key-management#view-details","View details",{"_2857":2040,"_25170":2024,"_5":25503,"_17548":47239,"_23820":47240,"_2384":47241},[],"/docs/pr-preview/pr-38/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2857":2041,"_25170":2024,"_5":25503,"_17548":47243,"_23820":47244,"_2384":47245},[],"/docs/pr-preview/pr-38/platform/pki/key-management#sign","Sign",{"_2857":2042,"_25170":2024,"_5":25503,"_17548":47247,"_23820":47248,"_2384":47249},[],"/docs/pr-preview/pr-38/platform/pki/key-management#verify","Verify",{"_2857":2043,"_25170":2024,"_5":25503,"_17548":47251,"_23820":47252,"_2384":47253},[],"/docs/pr-preview/pr-38/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2857":2044,"_25170":2024,"_5":25503,"_17548":47255,"_23820":47256,"_2384":47257},[],"/docs/pr-preview/pr-38/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2857":2045,"_25170":2024,"_5":25503,"_17548":47259,"_23820":47260,"_2384":47261},[],"/docs/pr-preview/pr-38/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2857":2046,"_25170":2024,"_17548":47263,"_5":17443,"_23820":2024,"_2384":47264},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2857":2047,"_25170":2024,"_17548":47266,"_5":17443,"_23820":2024,"_2384":47267},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2857":2048,"_25170":2024,"_17548":47269,"_5":17443,"_23820":47184,"_2384":47270},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2857":2049,"_25170":2024,"_17548":47272,"_5":17443,"_23820":47184,"_2384":47273},[],"In practice, it lets you:",{"_2857":2050,"_25170":2024,"_17548":47275,"_5":17443,"_23820":47184,"_2384":47276},[],"Generate new key pairs from Lamassu IoT.",{"_2857":2051,"_25170":2024,"_17548":47278,"_5":17443,"_23820":47184,"_2384":47279},[],"Import keys created externally.",{"_2857":2052,"_25170":2024,"_17548":47281,"_5":17443,"_23820":47184,"_2384":47282},[],"Delegate custody and cryptographic operations to external engines.",{"_2857":2053,"_25170":2024,"_17548":47284,"_5":17443,"_23820":47184,"_2384":47285},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2857":2054,"_25170":2024,"_17548":47287,"_5":17443,"_23820":47188,"_2384":47288},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2857":2055,"_25170":2024,"_17548":47290,"_5":17443,"_23820":47188,"_2384":47291},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2857":2056,"_25170":2024,"_17548":47293,"_5":17443,"_23820":47188,"_2384":47294},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2857":2057,"_25170":2024,"_17548":47296,"_5":17443,"_23820":47192,"_2384":47297},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2857":2058,"_25170":2024,"_17548":47299,"_5":17443,"_23820":47196,"_2384":47300},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2857":2059,"_25170":2024,"_17548":47302,"_5":17443,"_23820":47200,"_2384":47303},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2857":2060,"_25170":2024,"_17548":47305,"_5":17443,"_23820":47204,"_2384":47306},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2857":2061,"_25170":2024,"_17548":47308,"_5":17443,"_23820":47208,"_2384":47309},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2857":2062,"_25170":2024,"_17548":47311,"_5":17443,"_23820":47212,"_2384":47312},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2857":2063,"_25170":2024,"_17548":47314,"_5":17443,"_23820":47212,"_2384":47315},[],"Lamassu shows the enabled engines in the console.",{"_2857":2064,"_25170":2024,"_17548":47317,"_5":17443,"_23820":47212,"_2384":47318},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2857":2065,"_25170":2024,"_17548":47320,"_5":17443,"_23820":47212,"_2384":47321},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2857":2066,"_25170":2024,"_17548":47323,"_5":17443,"_23820":47216,"_2384":47324},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2857":2067,"_25170":2024,"_17548":47326,"_5":17443,"_23820":47216,"_2384":47327},[],"The table includes the following fields:",{"_2857":2068,"_25170":2024,"_17548":47329,"_5":17443,"_23820":47216,"_2384":47330},[],"**Name**: descriptive name of the key.",{"_2857":2069,"_25170":2024,"_17548":47332,"_5":17443,"_23820":47216,"_2384":47333},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2857":2070,"_25170":2024,"_17548":47335,"_5":17443,"_23820":47216,"_2384":47336},[],"**Strength**: visual indicator of cryptographic strength.",{"_2857":2071,"_25170":2024,"_17548":47338,"_5":17443,"_23820":47216,"_2384":47339},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2857":2072,"_25170":2024,"_17548":47341,"_5":17443,"_23820":47216,"_2384":47342},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2857":2073,"_25170":2024,"_17548":47344,"_5":17443,"_23820":47216,"_2384":47345},[],"**Aliases**: alternative names associated with the key.",{"_2857":2074,"_25170":2024,"_17548":47347,"_5":17443,"_23820":47216,"_2384":47348},[],"**Tags**: labels for classification and search.",{"_2857":2075,"_25170":2024,"_17548":47350,"_5":17443,"_23820":47216,"_2384":47351},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2857":2076,"_25170":2024,"_17548":47353,"_5":17443,"_23820":47216,"_2384":47354},[],"From this view you also reach the most common actions:",{"_2857":2077,"_25170":2024,"_17548":47356,"_5":17443,"_23820":47216,"_2384":47357},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2857":2078,"_25170":2024,"_17548":47359,"_5":17443,"_23820":47216,"_2384":47360},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2857":2079,"_25170":2024,"_17548":47362,"_5":17443,"_23820":47216,"_2384":47363},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2857":2080,"_25170":2024,"_17548":47365,"_5":17443,"_23820":47216,"_2384":47366},[],"**Delete Key** to remove the key from the system.",{"_2857":2081,"_25170":2024,"_17548":47368,"_5":17443,"_23820":47220,"_2384":47369},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2857":2082,"_25170":2024,"_17548":47371,"_5":17443,"_23820":47224,"_2384":47372},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2857":2083,"_25170":2024,"_17548":47374,"_5":17443,"_23820":47224,"_2384":47375},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2857":2084,"_25170":2024,"_17548":47377,"_5":17443,"_23820":47224,"_2384":47378},[],"**Key Name**: unique and descriptive name.",{"_2857":2085,"_25170":2024,"_17548":47380,"_5":17443,"_23820":47224,"_2384":47381},[],"**Crypto Engine**: engine that will keep the key.",{"_2857":2086,"_25170":2024,"_17548":47383,"_5":17443,"_23820":47224,"_2384":47384},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2857":2087,"_25170":2024,"_17548":47386,"_5":17443,"_23820":47224,"_2384":47387},[],"**Tags**: metadata to classify the key.",{"_2857":2088,"_25170":2024,"_17548":47389,"_5":17443,"_23820":47224,"_2384":47390},[],"**Metadata**: additional information for advanced uses.",{"_2857":2089,"_25170":2024,"_17548":47392,"_5":17443,"_23820":47228,"_2384":47393},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2857":2090,"_25170":2024,"_17548":47395,"_5":17443,"_23820":47228,"_2384":47396},[],"When you have an exportable private key and the destination engine supports import.",{"_2857":2091,"_25170":2024,"_17548":47398,"_5":17443,"_23820":47228,"_2384":47399},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2857":2092,"_25170":2024,"_17548":47401,"_5":17443,"_23820":47228,"_2384":47402},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2857":2093,"_25170":2024,"_17548":47404,"_5":17443,"_23820":47228,"_2384":47405},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2857":2094,"_25170":2024,"_17548":47407,"_5":17443,"_23820":47228,"_2384":47408},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2857":2095,"_25170":2024,"_17548":47410,"_5":17443,"_23820":47228,"_2384":47411},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2857":2096,"_25170":2024,"_17548":47413,"_5":17443,"_23820":47228,"_2384":47414},[],"**Tags**: labels for organization and search.",{"_2857":2097,"_25170":2024,"_17548":47416,"_5":17443,"_23820":47228,"_2384":47417},[],"**Metadata**: additional optional information.",{"_2857":2098,"_25170":2024,"_17548":47419,"_5":17443,"_23820":47228,"_2384":47420},[],"**Private Key (PEM)**: private key in PEM format.",{"_2857":2099,"_25170":2024,"_17548":47422,"_5":17443,"_23820":47228,"_2384":47423},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2857":2100,"_25170":2024,"_17548":47425,"_5":17443,"_23820":47232,"_2384":47426},[],"Each registered key has a detail view and several operational actions.",{"_2857":2101,"_25170":2024,"_17548":47428,"_5":17443,"_23820":47236,"_2384":47429},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2857":2102,"_25170":2024,"_17548":47431,"_5":17443,"_23820":47236,"_2384":47432},[],"The **Overview** tab shows, among others, these fields:",{"_2857":2103,"_25170":2024,"_17548":47434,"_5":17443,"_23820":47236,"_2384":47435},[],"**Key Name**: descriptive name.",{"_2857":2104,"_25170":2024,"_17548":47437,"_5":17443,"_23820":47236,"_2384":47438},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2857":2105,"_25170":2024,"_17548":47440,"_5":17443,"_23820":47236,"_2384":47441},[],"**Tags**: associated labels.",{"_2857":2106,"_25170":2024,"_17548":47443,"_5":17443,"_23820":47236,"_2384":47444},[],"**Aliases**: alternative names.",{"_2857":2107,"_25170":2024,"_17548":47446,"_5":17443,"_23820":47236,"_2384":47447},[],"**Crypto Engine**: engine where the key resides.",{"_2857":2108,"_25170":2024,"_17548":47449,"_5":17443,"_23820":47236,"_2384":47450},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2857":2109,"_25170":2024,"_17548":47452,"_5":17443,"_23820":47236,"_2384":47453},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2857":2110,"_25170":2024,"_17548":47455,"_5":17443,"_23820":47236,"_2384":47456},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2857":2111,"_25170":2024,"_17548":47458,"_5":17443,"_23820":47240,"_2384":47459},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2857":2112,"_25170":2024,"_17548":47461,"_5":17443,"_23820":47240,"_2384":47462},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2857":2113,"_25170":2024,"_17548":47464,"_5":17443,"_23820":47240,"_2384":47465},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2857":2114,"_25170":2024,"_17548":47467,"_5":17443,"_23820":47244,"_2384":47468},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2857":2115,"_25170":2024,"_17548":47470,"_5":17443,"_23820":47244,"_2384":47471},[],"Main fields:",{"_2857":2116,"_25170":2024,"_17548":47473,"_5":17443,"_23820":47244,"_2384":47474},[],"**Algorithm**: signing algorithm available for the key type.",{"_2857":2117,"_25170":2024,"_17548":47476,"_5":17443,"_23820":47244,"_2384":47477},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2857":2118,"_25170":2024,"_17548":47479,"_5":17443,"_23820":47244,"_2384":47480},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2857":2119,"_25170":2024,"_17548":47482,"_5":17443,"_23820":47244,"_2384":47483},[],"**Message**: content to sign.",{"_2857":2120,"_25170":2024,"_17548":47485,"_5":17443,"_23820":47244,"_2384":47486},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2857":2121,"_25170":2024,"_17548":47488,"_5":17443,"_23820":47248,"_2384":47489},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2857":2122,"_25170":2024,"_17548":47491,"_5":17443,"_23820":47248,"_2384":47471},[],{"_2857":2123,"_25170":2024,"_17548":47493,"_5":17443,"_23820":47248,"_2384":47494},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2857":2124,"_25170":2024,"_17548":47496,"_5":17443,"_23820":47248,"_2384":47497},[],"**Message Type**: `Raw` or `Digest`.",{"_2857":2125,"_25170":2024,"_17548":47499,"_5":17443,"_23820":47248,"_2384":47500},[],"**Payload Encoding**: encoding of the message.",{"_2857":2126,"_25170":2024,"_17548":47502,"_5":17443,"_23820":47248,"_2384":47503},[],"**Message**: original message or hash.",{"_2857":2127,"_25170":2024,"_17548":47505,"_5":17443,"_23820":47248,"_2384":47506},[],"**Signature**: signature to check.",{"_2857":2128,"_25170":2024,"_17548":47508,"_5":17443,"_23820":47248,"_2384":47509},[],"**Result**: indicator of the validation result.",{"_2857":2129,"_25170":2024,"_17548":47511,"_5":17443,"_23820":47252,"_2384":47512},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2857":2130,"_25170":2024,"_17548":47514,"_5":17443,"_23820":47252,"_2384":47515},[],"This flow is useful for:",{"_2857":2131,"_25170":2024,"_17548":47517,"_5":17443,"_23820":47252,"_2384":47518},[],"Requesting certificates from an external CA.",{"_2857":2132,"_25170":2024,"_17548":47520,"_5":17443,"_23820":47252,"_2384":47521},[],"Renewing an identity while keeping the same key.",{"_2857":2133,"_25170":2024,"_17548":47523,"_5":17443,"_23820":47252,"_2384":47524},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2857":2134,"_25170":2024,"_17548":47526,"_5":17443,"_23820":47252,"_2384":47527},[],"**Common Name (CN)**: main name of the identity.",{"_2857":2135,"_25170":2024,"_17548":47529,"_5":17443,"_23820":47252,"_2384":47530},[],"**Organization (O)**: organization or company.",{"_2857":2136,"_25170":2024,"_17548":47532,"_5":17443,"_23820":47252,"_2384":47533},[],"**Organizational Unit (OU)**: department or unit.",{"_2857":2137,"_25170":2024,"_17548":47535,"_5":17443,"_23820":47252,"_2384":47536},[],"**Country (C)**: two-letter country code.",{"_2857":2138,"_25170":2024,"_17548":47538,"_5":17443,"_23820":47252,"_2384":47539},[],"**State / Province (ST)**: state or province.",{"_2857":2139,"_25170":2024,"_17548":47541,"_5":17443,"_23820":47252,"_2384":47542},[],"**Locality (L)**: city or locality.",{"_2857":2140,"_25170":2024,"_17548":47544,"_5":17443,"_23820":47252,"_2384":47545},[],"**Email Address**: contact email.",{"_2857":2141,"_25170":2024,"_17548":47547,"_5":17443,"_23820":47252,"_2384":47548},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2857":2142,"_25170":2024,"_17548":47550,"_5":17443,"_23820":47252,"_2384":47551},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2857":2143,"_25170":2024,"_17548":47553,"_5":17443,"_23820":47256,"_2384":47554},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2857":2144,"_25170":2024,"_17548":47556,"_5":17443,"_23820":47256,"_2384":47557},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2857":2145,"_25170":2024,"_17548":47559,"_5":17443,"_23820":47260,"_2384":47560},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2857":2146,"_25170":2146,"_5":12294,"_2384":47562,"_25506":47563,"_17548":47564,"_23820":2146},"Online validation with OCSP",[40849,42193,45874,46491],[],{"_2857":2147,"_25170":2146,"_17548":47566,"_5":17443,"_23820":2146,"_2384":47567},[],"Query signed status and verify the responder’s response.",{"_2857":2148,"_25170":2146,"_5":25503,"_17548":47569,"_23820":47570,"_2384":47571},[],"/docs/pr-preview/pr-38/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2857":2149,"_25170":2146,"_5":25503,"_17548":47573,"_23820":47574,"_2384":47575},[],"/docs/pr-preview/pr-38/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2857":2150,"_25170":2146,"_5":25503,"_17548":47577,"_23820":47578,"_2384":47579},[],"/docs/pr-preview/pr-38/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2857":2151,"_25170":2146,"_5":25503,"_17548":47581,"_23820":47582,"_2384":47583},[],"/docs/pr-preview/pr-38/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2857":2152,"_25170":2146,"_5":25503,"_17548":47585,"_23820":47586,"_2384":47587},[],"/docs/pr-preview/pr-38/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2857":2153,"_25170":2146,"_5":25503,"_17548":47589,"_23820":47590,"_2384":47037},[],"/docs/pr-preview/pr-38/platform/pki/ocsp#references",{"_2857":2154,"_25170":2146,"_17548":47592,"_5":17443,"_23820":2146,"_2384":47593},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2857":2155,"_25170":2146,"_17548":47595,"_5":17443,"_23820":47570,"_2384":47596},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2857":2156,"_25170":2146,"_17548":47598,"_5":17443,"_23820":47570,"_2384":47599},[],"Record status",{"_2857":2157,"_25170":2146,"_17548":47601,"_5":17443,"_23820":47570,"_2384":47602},[],"Signed response",{"_2857":2158,"_25170":2146,"_17548":47604,"_5":17443,"_23820":47570,"_2384":45052},[],{"_2857":2159,"_25170":2146,"_17548":47606,"_5":17443,"_23820":47570,"_2384":47607},[],"`Good`.",{"_2857":2160,"_25170":2146,"_17548":47609,"_5":17443,"_23820":47570,"_2384":45069},[],{"_2857":2161,"_25170":2146,"_17548":47611,"_5":17443,"_23820":47570,"_2384":47612},[],"`Revoked`, with revocation reason and timestamp.",{"_2857":2162,"_25170":2146,"_17548":47614,"_5":17443,"_23820":47570,"_2384":47615},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2857":2163,"_25170":2146,"_17548":47617,"_5":17443,"_23820":47570,"_2384":47618},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2857":2164,"_25170":2146,"_17548":47620,"_5":17443,"_23820":47570,"_2384":47621},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2857":2165,"_25170":2146,"_17548":47623,"_5":17443,"_23820":47570,"_2384":47624},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2857":2166,"_25170":2146,"_17548":47626,"_5":17443,"_23820":47570,"_2384":47627},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2857":2167,"_25170":2146,"_17548":47629,"_5":17443,"_23820":47574,"_2384":47630},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2857":2168,"_25170":2146,"_17548":47632,"_5":17443,"_23820":47574,"_2384":47633},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2857":2169,"_25170":2146,"_17548":47635,"_5":17443,"_23820":47578,"_2384":47636},[],"The service accepts:",{"_2857":2170,"_25170":2146,"_17548":47638,"_5":17443,"_23820":47578,"_2384":43917},[],{"_2857":2171,"_25170":2146,"_17548":47640,"_5":17443,"_23820":47578,"_2384":47641},[],"VA service path",{"_2857":2172,"_25170":2146,"_17548":47643,"_5":17443,"_23820":47578,"_2384":47644},[],"Format",{"_2857":2173,"_25170":2146,"_17548":47646,"_5":17443,"_23820":47578,"_2384":47647},[],"`POST`",{"_2857":2174,"_25170":2146,"_17548":47649,"_5":17443,"_23820":47578,"_2384":47650},[],"`/ocsp`",{"_2857":2175,"_25170":2146,"_17548":47652,"_5":17443,"_23820":47578,"_2384":47653},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2857":2176,"_25170":2146,"_17548":47655,"_5":17443,"_23820":47578,"_2384":47136},[],{"_2857":2177,"_25170":2146,"_17548":47657,"_5":17443,"_23820":47578,"_2384":47658},[],"`/ocsp/{ocsp_request}`",{"_2857":2178,"_25170":2146,"_17548":47660,"_5":17443,"_23820":47578,"_2384":47661},[],"DER request encoded using padded URL Base64.",{"_2857":2179,"_25170":2146,"_17548":47663,"_5":17443,"_23820":47578,"_2384":47664},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2857":2180,"_25170":2146,"_17548":47666,"_5":17443,"_23820":47582,"_2384":47667},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2857":2181,"_25170":2146,"_17548":47669,"_5":17443,"_23820":47582,"_2384":47670},[],"Generate the request:",{"_2857":2182,"_25170":2146,"_17548":47672,"_5":17443,"_23820":47582,"_2384":47673},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2857":2183,"_25170":2146,"_17548":47675,"_5":17443,"_23820":47582,"_2384":47676},[],"Replace the example URL with the inspected endpoint:",{"_2857":2184,"_25170":2146,"_17548":47678,"_5":17443,"_23820":47582,"_2384":47679},[],"Verify the returned DER:",{"_2857":2185,"_25170":2146,"_17548":47681,"_5":17443,"_23820":47582,"_2384":47682},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2857":2186,"_25170":2146,"_17548":47684,"_5":17443,"_23820":47586,"_2384":47685},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2857":2187,"_25170":2146,"_17548":47687,"_5":17443,"_23820":47586,"_2384":47688},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2857":2188,"_25170":2146,"_17548":47690,"_5":17443,"_23820":47590,"_2384":47691},[],"RFC 6960: OCSP.",{"_2857":2189,"_25170":2146,"_17548":47693,"_5":17443,"_23820":47590,"_2384":47694},[],"OpenSSL: openssl-ocsp.",{"_2857":2190,"_25170":2146,"_17548":47696,"_5":17443,"_23820":47590,"_2384":47697},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2857":2191,"_25170":2146,"_17548":47699,"_5":17443,"_23820":47590,"_2384":47174},[],{"_2857":2192,"_25170":2192,"_5":12294,"_2384":45874,"_25506":47701,"_17548":47702,"_23820":2192},[40849,42193,45874],[],{"_2857":2193,"_25170":2192,"_17548":47704,"_5":17443,"_23820":2192,"_2384":47705},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2857":2194,"_25170":2192,"_5":25503,"_17548":47707,"_23820":47708,"_2384":45184},[],"/docs/pr-preview/pr-38/platform/pki/overview#start-here",{"_2857":2195,"_25170":2192,"_5":25503,"_17548":47710,"_23820":47711,"_2384":47712},[],"/docs/pr-preview/pr-38/platform/pki/overview#what-you-need","What you need",{"_2857":2196,"_25170":2192,"_5":25503,"_17548":47714,"_23820":47715,"_2384":45718},[],"/docs/pr-preview/pr-38/platform/pki/overview#core-capabilities",{"_2857":2197,"_25170":2192,"_5":25503,"_17548":47717,"_23820":47718,"_2384":45722},[],"/docs/pr-preview/pr-38/platform/pki/overview#build-your-trust-hierarchy",{"_2857":2198,"_25170":2192,"_5":25503,"_17548":47720,"_23820":47721,"_2384":45726},[],"/docs/pr-preview/pr-38/platform/pki/overview#protect-cryptographic-keys",{"_2857":2199,"_25170":2192,"_5":25503,"_17548":47723,"_23820":47724,"_2384":45730},[],"/docs/pr-preview/pr-38/platform/pki/overview#issue-and-control-certificates",{"_2857":2200,"_25170":2192,"_5":25503,"_17548":47726,"_23820":47727,"_2384":45738},[],"/docs/pr-preview/pr-38/platform/pki/overview#publish-validation-status",{"_2857":2201,"_25170":2192,"_5":25503,"_17548":47729,"_23820":47730,"_2384":47731},[],"/docs/pr-preview/pr-38/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2857":2202,"_25170":2192,"_5":25503,"_17548":47733,"_23820":47734,"_2384":46658},[],"/docs/pr-preview/pr-38/platform/pki/overview#continue",{"_2857":2203,"_25170":2192,"_17548":47736,"_5":17443,"_23820":2192,"_2384":47737},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2857":2204,"_25170":2192,"_17548":47739,"_5":17443,"_23820":47708,"_2384":47740},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2857":2205,"_25170":2192,"_17548":47742,"_5":17443,"_23820":47708,"_2384":47743},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2857":2206,"_25170":2192,"_17548":47745,"_5":17443,"_23820":47711,"_2384":47746},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2857":2207,"_25170":2192,"_17548":47748,"_5":17443,"_23820":47711,"_2384":47749},[],"An available cryptographic engine to keep the authority's key.",{"_2857":2208,"_25170":2192,"_17548":47751,"_5":17443,"_23820":47711,"_2384":47752},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2857":2209,"_25170":2192,"_17548":47754,"_5":17443,"_23820":47711,"_2384":47755},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2857":2210,"_25170":2192,"_17548":47757,"_5":17443,"_23820":47711,"_2384":47758},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2857":2211,"_25170":2192,"_17548":47760,"_5":17443,"_23820":47718,"_2384":47761},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2857":2212,"_25170":2192,"_17548":47763,"_5":17443,"_23820":47721,"_2384":47764},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2857":2213,"_25170":2192,"_17548":47766,"_5":17443,"_23820":47724,"_2384":47767},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2857":2214,"_25170":2192,"_17548":47769,"_5":17443,"_23820":47727,"_2384":47770},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2857":2215,"_25170":2192,"_17548":47772,"_5":17443,"_23820":47730,"_2384":47773},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2857":2216,"_25170":2192,"_17548":47775,"_5":17443,"_23820":47730,"_2384":47776},[],"its subject and extensions identify the expected client;",{"_2857":2217,"_25170":2192,"_17548":47778,"_5":17443,"_23820":47730,"_2384":47779},[],"its public key matches the client's private key;",{"_2857":2218,"_25170":2192,"_17548":47781,"_5":17443,"_23820":47730,"_2384":47782},[],"its chain reaches a root trusted by the consumer;",{"_2857":2219,"_25170":2192,"_17548":47784,"_5":17443,"_23820":47730,"_2384":47785},[],"its dates and usages allow the operation;",{"_2857":2220,"_25170":2192,"_17548":47787,"_5":17443,"_23820":47730,"_2384":47788},[],"the consumer applies revocation checks and authorization.",{"_2857":2221,"_25170":2192,"_17548":47790,"_5":17443,"_23820":47730,"_2384":47791},[],"The issuance path includes the first independent checks.",{"_2857":2222,"_25170":2192,"_17548":47793,"_5":17443,"_23820":47734,"_2384":47794},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2857":2223,"_25170":2192,"_17548":47796,"_5":17443,"_23820":47734,"_2384":47797},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2857":2224,"_25170":2192,"_17548":47799,"_5":17443,"_23820":47734,"_2384":47800},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2857":2225,"_25170":2225,"_5":12294,"_2384":47802,"_25506":47803,"_17548":47804,"_23820":2225},"Create your first CA",[40849,42193,45874,45309],[],{"_2857":2226,"_25170":2225,"_17548":47806,"_5":17443,"_23820":2225,"_2384":47807},[],"Create an evaluation root and check its certificate before issuing.",{"_2857":2227,"_25170":2225,"_5":25503,"_17548":47809,"_23820":47810,"_2384":40859},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2857":2228,"_25170":2225,"_5":25503,"_17548":47812,"_23820":47813,"_2384":47814},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2857":2229,"_25170":2225,"_5":25503,"_17548":47816,"_23820":47817,"_2384":47818},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2857":2230,"_25170":2225,"_5":25503,"_17548":47820,"_23820":47821,"_2384":47822},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2857":2231,"_25170":2225,"_5":25503,"_17548":47824,"_23820":47825,"_2384":47826},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2857":2232,"_25170":2225,"_5":25503,"_17548":47828,"_23820":47829,"_2384":47830},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2857":2233,"_25170":2225,"_5":25503,"_17548":47832,"_23820":47833,"_2384":47834},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2857":2234,"_25170":2225,"_5":25503,"_17548":47836,"_23820":47837,"_2384":45567},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2857":2235,"_25170":2225,"_5":25503,"_17548":47839,"_23820":47840,"_2384":40883},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2857":2236,"_25170":2225,"_17548":47842,"_5":17443,"_23820":2225,"_2384":47843},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2857":2237,"_25170":2225,"_17548":47845,"_5":17443,"_23820":47810,"_2384":47846},[],"Console access and permission to create keys and authorities.",{"_2857":2238,"_25170":2225,"_17548":47848,"_5":17443,"_23820":47810,"_2384":47849},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2857":2239,"_25170":2225,"_17548":47851,"_5":17443,"_23820":47810,"_2384":47852},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2857":2240,"_25170":2225,"_17548":47854,"_5":17443,"_23820":47810,"_2384":47855},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2857":2241,"_25170":2225,"_17548":47857,"_5":17443,"_23820":47813,"_2384":47858},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2857":2242,"_25170":2225,"_17548":47860,"_5":17443,"_23820":47813,"_2384":47861},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2857":2243,"_25170":2225,"_17548":47863,"_5":17443,"_23820":47817,"_2384":47864},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2857":2244,"_25170":2225,"_17548":47866,"_5":17443,"_23820":47817,"_2384":47867},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2857":2245,"_25170":2225,"_17548":47869,"_5":17443,"_23820":47821,"_2384":47870},[],"Select **Root CA** and complete:",{"_2857":2246,"_25170":2225,"_17548":47872,"_5":17443,"_23820":47821,"_2384":47873},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2857":2247,"_25170":2225,"_17548":47875,"_5":17443,"_23820":47821,"_2384":47876},[],"**Subject**: organization and country details for your evaluation.",{"_2857":2248,"_25170":2225,"_17548":47878,"_5":17443,"_23820":47821,"_2384":47879},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2857":2249,"_25170":2225,"_17548":47881,"_5":17443,"_23820":47821,"_2384":47882},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2857":2250,"_25170":2225,"_17548":47884,"_5":17443,"_23820":47821,"_2384":47885},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2857":2251,"_25170":2225,"_17548":47887,"_5":17443,"_23820":47825,"_2384":47888},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2857":2252,"_25170":2225,"_17548":47890,"_5":17443,"_23820":47829,"_2384":47891},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2857":2253,"_25170":2225,"_17548":47893,"_5":17443,"_23820":47829,"_2384":47894},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2857":2254,"_25170":2225,"_17548":47896,"_5":17443,"_23820":47833,"_2384":47897},[],"Run from the directory where you saved `ca.pem`:",{"_2857":2255,"_25170":2225,"_17548":47899,"_5":17443,"_23820":47833,"_2384":47900},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2857":2256,"_25170":2225,"_17548":47902,"_5":17443,"_23820":47833,"_2384":47903},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2857":2257,"_25170":2225,"_17548":47905,"_5":17443,"_23820":47837,"_2384":47906},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2857":2258,"_25170":2225,"_17548":47908,"_5":17443,"_23820":47837,"_2384":47909},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2857":2259,"_25170":2225,"_17548":47911,"_5":17443,"_23820":47837,"_2384":47912},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2857":2260,"_25170":2225,"_17548":47914,"_5":17443,"_23820":47837,"_2384":47915},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2857":2261,"_25170":2225,"_17548":47917,"_5":17443,"_23820":47840,"_2384":47918},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2857":2262,"_25170":2262,"_5":12294,"_2384":47920,"_25506":47921,"_17548":47922,"_23820":2262},"Issue and verify a certificate",[40849,42193,45874,45309],[],{"_2857":2263,"_25170":2262,"_17548":47924,"_5":17443,"_23820":2262,"_2384":47925},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2857":2264,"_25170":2262,"_5":25503,"_17548":47927,"_23820":47928,"_2384":40859},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2857":2265,"_25170":2262,"_5":25503,"_17548":47930,"_23820":47931,"_2384":47932},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2857":2266,"_25170":2262,"_5":25503,"_17548":47934,"_23820":47935,"_2384":47936},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2857":2267,"_25170":2262,"_5":25503,"_17548":47938,"_23820":47939,"_2384":47940},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2857":2268,"_25170":2262,"_5":25503,"_17548":47942,"_23820":47943,"_2384":47944},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2857":2269,"_25170":2262,"_5":25503,"_17548":47946,"_23820":47947,"_2384":47948},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2857":2270,"_25170":2262,"_5":25503,"_17548":47950,"_23820":47951,"_2384":47830},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2857":2271,"_25170":2262,"_5":25503,"_17548":47953,"_23820":47954,"_2384":47955},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2857":2272,"_25170":2262,"_5":25503,"_17548":47957,"_23820":47958,"_2384":47959},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2857":2273,"_25170":2262,"_5":25503,"_17548":47961,"_23820":47962,"_2384":47963},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2857":2274,"_25170":2262,"_5":25503,"_17548":47965,"_23820":47966,"_2384":45567},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2857":2275,"_25170":2262,"_5":25503,"_17548":47968,"_23820":47969,"_2384":40883},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#next-step",{"_2857":2276,"_25170":2262,"_17548":47971,"_5":17443,"_23820":2262,"_2384":47972},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2857":2277,"_25170":2262,"_17548":47974,"_5":17443,"_23820":47928,"_2384":47975},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2857":2278,"_25170":2262,"_17548":47977,"_5":17443,"_23820":47928,"_2384":47978},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2857":2279,"_25170":2262,"_17548":47980,"_5":17443,"_23820":47928,"_2384":47981},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2857":2280,"_25170":2262,"_17548":47983,"_5":17443,"_23820":47928,"_2384":47984},[],"A client identifier: here we use `device-001`.",{"_2857":2281,"_25170":2262,"_17548":47986,"_5":17443,"_23820":47928,"_2384":47987},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2857":2282,"_25170":2262,"_17548":47989,"_5":17443,"_23820":47931,"_2384":47990},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2857":2283,"_25170":2262,"_17548":47992,"_5":17443,"_23820":47935,"_2384":47993},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2857":2284,"_25170":2262,"_17548":47995,"_5":17443,"_23820":47935,"_2384":47996},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2857":2285,"_25170":2262,"_17548":47998,"_5":17443,"_23820":47939,"_2384":47999},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2857":2286,"_25170":2262,"_17548":48001,"_5":17443,"_23820":47939,"_2384":48002},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2857":2287,"_25170":2262,"_17548":48004,"_5":17443,"_23820":47943,"_2384":48005},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2857":2288,"_25170":2262,"_17548":48007,"_5":17443,"_23820":47943,"_2384":48008},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2857":2289,"_25170":2262,"_17548":48010,"_5":17443,"_23820":47947,"_2384":48011},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2857":2290,"_25170":2262,"_17548":48013,"_5":17443,"_23820":47951,"_2384":48014},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2857":2291,"_25170":2262,"_17548":48016,"_5":17443,"_23820":47954,"_2384":48017},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2857":2292,"_25170":2262,"_17548":48019,"_5":17443,"_23820":47958,"_2384":48020},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2857":2293,"_25170":2262,"_17548":48022,"_5":17443,"_23820":47958,"_2384":48023},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2857":2294,"_25170":2262,"_17548":48025,"_5":17443,"_23820":47958,"_2384":48026},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2857":2295,"_25170":2262,"_17548":48028,"_5":17443,"_23820":47962,"_2384":48029},[],"In Bash, compare the two public-key digests:",{"_2857":2296,"_25170":2262,"_17548":48031,"_5":17443,"_23820":47962,"_2384":48032},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2857":2297,"_25170":2262,"_17548":48034,"_5":17443,"_23820":47962,"_2384":48035},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2857":2298,"_25170":2262,"_17548":48037,"_5":17443,"_23820":47966,"_2384":45651},[],{"_2857":2299,"_25170":2262,"_17548":48039,"_5":17443,"_23820":47966,"_2384":48040},[],"What to review",{"_2857":2300,"_25170":2262,"_17548":48042,"_5":17443,"_23820":47966,"_2384":48043},[],"The CA rejects issuance",{"_2857":2301,"_25170":2262,"_17548":48045,"_5":17443,"_23820":47966,"_2384":48046},[],"Permissions, CA state and key, algorithm and profile.",{"_2857":2302,"_25170":2262,"_17548":48048,"_5":17443,"_23820":47966,"_2384":48049},[],"Different subject or usages",{"_2857":2303,"_25170":2262,"_17548":48051,"_5":17443,"_23820":47966,"_2384":48052},[],"Applied profile and requested values.",{"_2857":2304,"_25170":2262,"_17548":48054,"_5":17443,"_23820":47966,"_2384":48055},[],"Issuer cannot be found",{"_2857":2305,"_25170":2262,"_17548":48057,"_5":17443,"_23820":47966,"_2384":48058},[],"Downloaded CA and required intermediate chain.",{"_2857":2306,"_25170":2262,"_17548":48060,"_5":17443,"_23820":47966,"_2384":48061},[],"Validity fails",{"_2857":2307,"_25170":2262,"_17548":48063,"_5":17443,"_23820":47966,"_2384":48064},[],"Certificate and CA dates, and the computer's clock.",{"_2857":2308,"_25170":2262,"_17548":48066,"_5":17443,"_23820":47966,"_2384":48067},[],"Public-key digests differ",{"_2857":2309,"_25170":2262,"_17548":48069,"_5":17443,"_23820":47966,"_2384":48070},[],"Certificate and key files from the same issuance.",{"_2857":2310,"_25170":2262,"_17548":48072,"_5":17443,"_23820":47966,"_2384":48073},[],"See PKI diagnostics to narrow an issuance failure.",{"_2857":2311,"_25170":2262,"_17548":48075,"_5":17443,"_23820":47969,"_2384":48076},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2857":2312,"_25170":2262,"_17548":48078,"_5":17443,"_23820":47969,"_2384":48079},[],"Manage certificates for inspection, status and revocation.",{"_2857":2313,"_25170":2262,"_17548":48081,"_5":17443,"_23820":47969,"_2384":48082},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2857":2314,"_25170":2262,"_17548":48084,"_5":17443,"_23820":47969,"_2384":48085},[],"Prepare EST for the device to request its next identities.",{"_2857":2315,"_25170":2262,"_17548":48087,"_5":17443,"_23820":47969,"_2384":48088},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2857":2316,"_25170":2316,"_5":12294,"_2384":48090,"_25506":48091,"_17548":48092,"_23820":2316},"PKI getting started",[40849,42193,45874,45309],[],{"_2857":2317,"_25170":2316,"_17548":48094,"_5":17443,"_23820":2316,"_2384":48095},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2857":2318,"_25170":2316,"_5":25503,"_17548":48097,"_23820":48098,"_2384":40859},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#before-you-begin",{"_2857":2319,"_25170":2316,"_5":25503,"_17548":48100,"_23820":48101,"_2384":48102},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2857":2320,"_25170":2316,"_5":25503,"_17548":48104,"_23820":48105,"_2384":45501},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#expected-result",{"_2857":2321,"_25170":2316,"_5":25503,"_17548":48107,"_23820":48108,"_2384":48109},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2857":2322,"_25170":2316,"_17548":48111,"_5":17443,"_23820":2316,"_2384":48112},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2857":2323,"_25170":2316,"_17548":48114,"_5":17443,"_23820":48098,"_2384":48115},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2857":2324,"_25170":2316,"_17548":48117,"_5":17443,"_23820":48098,"_2384":48118},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2857":2325,"_25170":2316,"_17548":48120,"_5":17443,"_23820":48098,"_2384":48121},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2857":2326,"_25170":2316,"_17548":48123,"_5":17443,"_23820":48098,"_2384":48124},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2857":2327,"_25170":2316,"_17548":48126,"_5":17443,"_23820":48098,"_2384":48127},[],"A working directory with restricted access for the downloaded key.",{"_2857":2328,"_25170":2316,"_17548":48129,"_5":17443,"_23820":48101,"_2384":48130},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2857":2329,"_25170":2316,"_17548":48132,"_5":17443,"_23820":48101,"_2384":48133},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2857":2330,"_25170":2316,"_17548":48135,"_5":17443,"_23820":48101,"_2384":48136},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2857":2331,"_25170":2316,"_17548":48138,"_5":17443,"_23820":48101,"_2384":48139},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2857":2332,"_25170":2316,"_17548":48141,"_5":17443,"_23820":48105,"_2384":48142},[],"File or resource",{"_2857":2333,"_25170":2316,"_17548":48144,"_5":17443,"_23820":48105,"_2384":45498},[],{"_2857":2334,"_25170":2316,"_17548":48146,"_5":17443,"_23820":48105,"_2384":48147},[],"Active root CA and `ca.pem`",{"_2857":2335,"_25170":2316,"_17548":48149,"_5":17443,"_23820":48105,"_2384":48150},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2857":2336,"_25170":2316,"_17548":48152,"_5":17443,"_23820":48105,"_2384":48153},[],"End-entity certificate and `device.crt`",{"_2857":2337,"_25170":2316,"_17548":48155,"_5":17443,"_23820":48105,"_2384":48156},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2857":2338,"_25170":2316,"_17548":48158,"_5":17443,"_23820":48105,"_2384":48159},[],"Private key `device.key`",{"_2857":2339,"_25170":2316,"_17548":48161,"_5":17443,"_23820":48105,"_2384":48162},[],"Its public key matches the one included in `device.crt`.",{"_2857":2340,"_25170":2316,"_17548":48164,"_5":17443,"_23820":48105,"_2384":48165},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2857":2341,"_25170":2316,"_17548":48167,"_5":17443,"_23820":48108,"_2384":48168},[],"To operate certificates, continue with Certificates and Validation.",{"_2857":2342,"_25170":2316,"_17548":48170,"_5":17443,"_23820":48108,"_2384":48171},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2857":2343,"_25170":2316,"_17548":48173,"_5":17443,"_23820":48108,"_2384":48174},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2857":2344,"_25170":2344,"_5":12294,"_2384":48176,"_25506":48177,"_17548":48178,"_23820":2344},"PKI troubleshooting",[40849,42193,45874,44695],[],{"_2857":2345,"_25170":2344,"_17548":48180,"_5":17443,"_23820":2344,"_2384":48181},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2857":2346,"_25170":2344,"_5":25503,"_17548":48183,"_23820":48184,"_2384":48185},[],"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2857":2347,"_25170":2344,"_5":25503,"_17548":48187,"_23820":48188,"_2384":48189},[],"/docs/pr-preview/pr-38/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2857":2348,"_25170":2344,"_5":25503,"_17548":48191,"_23820":48192,"_2384":48193},[],"/docs/pr-preview/pr-38/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2857":2349,"_25170":2344,"_17548":48195,"_5":17443,"_23820":2344,"_2384":48196},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2857":2350,"_25170":2344,"_17548":48198,"_5":17443,"_23820":2344,"_2384":48199},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2857":2351,"_25170":2344,"_17548":48201,"_5":17443,"_23820":48184,"_2384":45498},[],{"_2857":2352,"_25170":2344,"_17548":48203,"_5":17443,"_23820":48184,"_2384":48204},[],"What to inspect",{"_2857":2353,"_25170":2344,"_17548":48206,"_5":17443,"_23820":48184,"_2384":40883},[],{"_2857":2354,"_25170":2344,"_17548":48208,"_5":17443,"_23820":48184,"_2384":48209},[],"CA",{"_2857":2355,"_25170":2344,"_17548":48211,"_5":17443,"_23820":48184,"_2384":48212},[],"Exists, is active and has usable dates.",{"_2857":2356,"_25170":2344,"_17548":48214,"_5":17443,"_23820":48184,"_2384":48215},[],"Authorities.",{"_2857":2357,"_25170":2344,"_17548":48217,"_5":17443,"_23820":48184,"_2384":48218},[],"Key",{"_2857":2358,"_25170":2344,"_17548":48220,"_5":17443,"_23820":48184,"_2384":48221},[],"The record has a usable private key and the engine can sign.",{"_2857":2359,"_25170":2344,"_17548":48223,"_5":17443,"_23820":48184,"_2384":48224},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2857":2360,"_25170":2344,"_17548":48226,"_5":17443,"_23820":48184,"_2384":48227},[],"CSR",{"_2857":2361,"_25170":2344,"_17548":48229,"_5":17443,"_23820":48184,"_2384":48230},[],"Correct PEM and verifiable signature.",{"_2857":2362,"_25170":2344,"_17548":48232,"_5":17443,"_23820":48184,"_2384":48233},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2857":2363,"_25170":2344,"_17548":48235,"_5":17443,"_23820":48184,"_2384":48236},[],"Profile",{"_2857":2364,"_25170":2344,"_17548":48238,"_5":17443,"_23820":48184,"_2384":48239},[],"Selected source, existing ID, allowed algorithm and size.",{"_2857":2365,"_25170":2344,"_17548":48241,"_5":17443,"_23820":48184,"_2384":48242},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2857":2366,"_25170":2344,"_17548":48244,"_5":17443,"_23820":48184,"_2384":45651},[],{"_2857":2367,"_25170":2344,"_17548":48246,"_5":17443,"_23820":48184,"_2384":48247},[],"Appropriate subject, SAN, usages and dates.",{"_2857":2368,"_25170":2344,"_17548":48249,"_5":17443,"_23820":48184,"_2384":48250},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2857":2369,"_25170":2344,"_17548":48252,"_5":17443,"_23820":48184,"_2384":48253},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2857":2370,"_25170":2344,"_17548":48255,"_5":17443,"_23820":48184,"_2384":48256},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2857":2371,"_25170":2344,"_17548":48258,"_5":17443,"_23820":48188,"_2384":48259},[],"Check each boundary independently:",{"_2857":2372,"_25170":2344,"_17548":48261,"_5":17443,"_23820":48188,"_2384":48262},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2857":2373,"_25170":2344,"_17548":48264,"_5":17443,"_23820":48188,"_2384":48265},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2857":2374,"_25170":2344,"_17548":48267,"_5":17443,"_23820":48188,"_2384":48268},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2857":2375,"_25170":2344,"_17548":48270,"_5":17443,"_23820":48188,"_2384":48271},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2857":2376,"_25170":2344,"_17548":48273,"_5":17443,"_23820":48188,"_2384":48274},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2857":2377,"_25170":2344,"_17548":48276,"_5":17443,"_23820":48188,"_2384":48277},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2857":2378,"_25170":2344,"_17548":48279,"_5":17443,"_23820":48192,"_2384":48280},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2857":2379,"_25170":2344,"_17548":48282,"_5":17443,"_23820":48192,"_2384":48283},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.","count","sorting",{"_48287":48288,"_48289":48290,"_48291":48292,"_48293":48294,"_15231":2406,"_57768":2406},"language","english","sortableProperties",[2384,25170,5,23820],"sortablePropertiesWithTypes",{"_2384":20963,"_25170":20963,"_5":20963,"_23820":20963},"sorts",{"_2384":48295,"_25170":50664,"_5":53032,"_23820":55400},{"_3828":48296,"_48297":48298,"_5":20963},{"_12039":3792,"_12382":4252,"_12389":4878,"_24371":6578,"_23933":2735,"_16648":9735,"_12060":2822,"_12067":3831,"_24333":2731,"_24683":3653,"_24704":6267,"_24346":11372,"_28968":4754,"_24715":12417,"_28973":24863,"_28976":19871,"_28979":7134,"_28982":6291,"_28985":9488,"_25016":6161,"_28990":6045,"_28992":2648,"_25076":2530,"_25006":6226,"_28996":2697,"_25032":5391,"_29000":7168,"_24733":6153,"_25011":4288,"_25094":3117,"_29005":5567,"_29007":3807,"_29009":3099,"_29011":3062,"_29013":6150,"_29015":5687,"_29017":5167,"_25228":4457,"_29020":5521,"_24384":2835,"_29023":4405,"_29025":2706,"_24378":6259,"_29028":2444,"_29030":3988,"_29032":2445,"_29035":16913,"_24414":45