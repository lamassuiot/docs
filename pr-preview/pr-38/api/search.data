"_2857":15,"_25170":15,"_5":12294,"_2384":40846,"_25506":40847,"_17548":40851,"_23820":15},"Deploy from AWS Marketplace",[40848,40849,40850],"Docs","Deployment","Other models",[],{"_2857":16,"_25170":15,"_17548":40853,"_5":17443,"_23820":15,"_2384":40854},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2857":17,"_25170":15,"_5":25503,"_17548":40856,"_23820":40857,"_2384":40858},[],"/docs/pr-preview/pr-38/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2857":18,"_25170":15,"_5":25503,"_17548":40860,"_23820":40861,"_2384":40862},[],"/docs/pr-preview/pr-38/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2857":19,"_25170":15,"_5":25503,"_17548":40864,"_23820":40865,"_2384":40866},[],"/docs/pr-preview/pr-38/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2857":20,"_25170":15,"_5":25503,"_17548":40868,"_23820":40869,"_2384":40870},[],"/docs/pr-preview/pr-38/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2857":21,"_25170":15,"_5":25503,"_17548":40872,"_23820":40873,"_2384":40874},[],"/docs/pr-preview/pr-38/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2857":22,"_25170":15,"_5":25503,"_17548":40876,"_23820":40877,"_2384":40878},[],"/docs/pr-preview/pr-38/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2857":23,"_25170":15,"_5":25503,"_17548":40880,"_23820":40881,"_2384":40882},[],"/docs/pr-preview/pr-38/deployment/aws-marketplace#next-step","Next step",{"_2857":24,"_25170":15,"_17548":40884,"_5":17443,"_23820":15,"_2384":40885},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2857":25,"_25170":15,"_17548":40887,"_5":17443,"_23820":40857,"_2384":40888},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2857":26,"_25170":15,"_17548":40890,"_5":17443,"_23820":40857,"_2384":40891},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2857":27,"_25170":15,"_17548":40893,"_5":17443,"_23820":40857,"_2384":40894},[],"A security group allowing the necessary endpoints.",{"_2857":28,"_25170":15,"_17548":40896,"_5":17443,"_23820":40861,"_2384":40897},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2857":29,"_25170":15,"_17548":40899,"_5":17443,"_23820":40861,"_2384":40900},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2857":30,"_25170":15,"_17548":40902,"_5":17443,"_23820":40861,"_2384":40903},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2857":31,"_25170":15,"_17548":40905,"_5":17443,"_23820":40865,"_2384":40906},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2857":32,"_25170":15,"_17548":40908,"_5":17443,"_23820":40869,"_2384":40909},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2857":33,"_25170":15,"_17548":40911,"_5":17443,"_23820":40873,"_2384":40912},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2857":34,"_25170":15,"_17548":40914,"_5":17443,"_23820":40877,"_2384":40915},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2857":35,"_25170":15,"_17548":40917,"_5":17443,"_23820":40881,"_2384":40918},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2857":36,"_25170":36,"_5":12294,"_2384":40920,"_25506":40921,"_17548":40922,"_23820":36},"Deploy Lamassu",[40848,40849],[],{"_2857":37,"_25170":36,"_17548":40924,"_5":17443,"_23820":36,"_2384":40925},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2857":38,"_25170":36,"_5":25503,"_17548":40927,"_23820":40928,"_2384":40929},[],"/docs/pr-preview/pr-38/deployment/overview#choose-a-model","Choose a model",{"_2857":39,"_25170":36,"_5":25503,"_17548":40931,"_23820":40932,"_2384":40933},[],"/docs/pr-preview/pr-38/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2857":40,"_25170":36,"_5":25503,"_17548":40935,"_23820":40936,"_2384":40937},[],"/docs/pr-preview/pr-38/deployment/overview#after-deployment","After deployment",{"_2857":41,"_25170":36,"_17548":40939,"_5":17443,"_23820":36,"_2384":40940},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2857":42,"_25170":36,"_17548":40942,"_5":17443,"_23820":40928,"_2384":40943},[],"Model",{"_2857":43,"_25170":36,"_17548":40945,"_5":17443,"_23820":40928,"_2384":40946},[],"Recommended for",{"_2857":44,"_25170":36,"_17548":40948,"_5":17443,"_23820":40928,"_2384":40949},[],"Who operates the infrastructure",{"_2857":45,"_25170":36,"_17548":40951,"_5":17443,"_23820":40928,"_2384":40952},[],"Starting point",{"_2857":46,"_25170":36,"_17548":40954,"_5":17443,"_23820":40928,"_2384":40955},[],"Kubernetes self-managed",{"_2857":47,"_25170":36,"_17548":40957,"_5":17443,"_23820":40928,"_2384":40958},[],"Production, regulated environments and custom deployments",{"_2857":48,"_25170":36,"_17548":40960,"_5":17443,"_23820":40928,"_2384":40961},[],"Your team",{"_2857":49,"_25170":36,"_17548":40963,"_5":17443,"_23820":40928,"_2384":40964},[],"Helm or Fastlane",{"_2857":50,"_25170":36,"_17548":40966,"_5":17443,"_23820":40928,"_2384":40967},[],"AWS Marketplace",{"_2857":51,"_25170":36,"_17548":40969,"_5":17443,"_23820":40928,"_2384":40970},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2857":52,"_25170":36,"_17548":40972,"_5":17443,"_23820":40928,"_2384":40961},[],{"_2857":53,"_25170":36,"_17548":40974,"_5":17443,"_23820":40928,"_2384":40975},[],"Preconfigured image on EC2",{"_2857":54,"_25170":36,"_17548":40977,"_5":17443,"_23820":40928,"_2384":40978},[],"SaaS",{"_2857":55,"_25170":36,"_17548":40980,"_5":17443,"_23820":40928,"_2384":40981},[],"Teams that want to use the platform without operating it",{"_2857":56,"_25170":36,"_17548":40983,"_5":17443,"_23820":40928,"_2384":40984},[],"Lamassu",{"_2857":57,"_25170":36,"_17548":40986,"_5":17443,"_23820":40928,"_2384":40987},[],"Managed subscription",{"_2857":58,"_25170":36,"_17548":40989,"_5":17443,"_23820":40928,"_2384":40990},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2857":59,"_25170":36,"_17548":40992,"_5":17443,"_23820":40928,"_2384":40993},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2857":60,"_25170":36,"_17548":40995,"_5":17443,"_23820":40928,"_2384":40996},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2857":61,"_25170":36,"_17548":40998,"_5":17443,"_23820":40932,"_2384":40999},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2857":62,"_25170":36,"_17548":41001,"_5":17443,"_23820":40936,"_2384":41002},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2857":63,"_25170":63,"_5":12294,"_2384":41004,"_25506":41005,"_17548":41006,"_23820":63},"Use Lamassu as SaaS",[40848,40849,40850],[],{"_2857":64,"_25170":63,"_17548":41008,"_5":17443,"_23820":63,"_2384":41009},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2857":65,"_25170":63,"_5":25503,"_17548":41011,"_23820":41012,"_2384":41013},[],"/docs/pr-preview/pr-38/deployment/saas#what-the-service-manages","What the service manages",{"_2857":66,"_25170":63,"_5":25503,"_17548":41015,"_23820":41016,"_2384":41017},[],"/docs/pr-preview/pr-38/deployment/saas#plans","Plans",{"_2857":67,"_25170":63,"_5":25503,"_17548":41019,"_23820":41020,"_2384":41021},[],"/docs/pr-preview/pr-38/deployment/saas#request-access","Request access",{"_2857":68,"_25170":63,"_17548":41023,"_5":17443,"_23820":63,"_2384":41024},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2857":69,"_25170":63,"_17548":41026,"_5":17443,"_23820":41012,"_2384":41027},[],"Platform availability and maintenance.",{"_2857":70,"_25170":63,"_17548":41029,"_5":17443,"_23820":41012,"_2384":41030},[],"Automatic backups.",{"_2857":71,"_25170":63,"_17548":41032,"_5":17443,"_23820":41012,"_2384":41033},[],"Version upgrades.",{"_2857":72,"_25170":63,"_17548":41035,"_5":17443,"_23820":41012,"_2384":41036},[],"Technical support and SLA according to your plan.",{"_2857":73,"_25170":63,"_17548":41038,"_5":17443,"_23820":41016,"_2384":41039},[],"Plan",{"_2857":74,"_25170":63,"_17548":41041,"_5":17443,"_23820":41016,"_2384":41042},[],"Devices",{"_2857":75,"_25170":63,"_17548":41044,"_5":17443,"_23820":41016,"_2384":41045},[],"Support",{"_2857":76,"_25170":63,"_17548":41047,"_5":17443,"_23820":41016,"_2384":41048},[],"SLA",{"_2857":77,"_25170":63,"_17548":41050,"_5":17443,"_23820":41016,"_2384":41051},[],"Starter",{"_2857":78,"_25170":63,"_17548":41053,"_5":17443,"_23820":41016,"_2384":41054},[],"Up to 1,000",{"_2857":79,"_25170":63,"_17548":41056,"_5":17443,"_23820":41016,"_2384":41057},[],"Email",{"_2857":80,"_25170":63,"_17548":41059,"_5":17443,"_23820":41016,"_2384":41060},[],"99.5 %",{"_2857":81,"_25170":63,"_17548":41062,"_5":17443,"_23820":41016,"_2384":41063},[],"Professional",{"_2857":82,"_25170":63,"_17548":41065,"_5":17443,"_23820":41016,"_2384":41066},[],"Up to 10,000",{"_2857":83,"_25170":63,"_17548":41068,"_5":17443,"_23820":41016,"_2384":41069},[],"Email and chat",{"_2857":84,"_25170":63,"_17548":41071,"_5":17443,"_23820":41016,"_2384":41072},[],"99.9 %",{"_2857":85,"_25170":63,"_17548":41074,"_5":17443,"_23820":41016,"_2384":41075},[],"Enterprise",{"_2857":86,"_25170":63,"_17548":41077,"_5":17443,"_23820":41016,"_2384":41078},[],"Unlimited",{"_2857":87,"_25170":63,"_17548":41080,"_5":17443,"_23820":41016,"_2384":41081},[],"Dedicated",{"_2857":88,"_25170":63,"_17548":41083,"_5":17443,"_23820":41016,"_2384":41084},[],"99.99 %",{"_2857":89,"_25170":63,"_17548":41086,"_5":17443,"_23820":41020,"_2384":41087},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2857":90,"_25170":63,"_17548":41089,"_5":17443,"_23820":41020,"_2384":41090},[],"When you receive your instance's credentials, continue with Get started.",{"_2857":91,"_25170":91,"_5":12294,"_2384":41092,"_25506":41093,"_17548":41094,"_23820":91},"Fastlane",[40848,40849,40955],[],{"_2857":92,"_25170":91,"_17548":41096,"_5":17443,"_23820":91,"_2384":41097},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2857":93,"_25170":91,"_5":25503,"_17548":41099,"_23820":41100,"_2384":41101},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2857":94,"_25170":91,"_5":25503,"_17548":41103,"_23820":41104,"_2384":41105},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2857":95,"_25170":91,"_5":25503,"_17548":41107,"_23820":41108,"_2384":40858},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#before-you-begin",{"_2857":96,"_25170":91,"_5":25503,"_17548":41110,"_23820":41111,"_2384":41112},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2857":97,"_25170":91,"_5":25503,"_17548":41114,"_23820":41115,"_2384":41116},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2857":98,"_25170":91,"_5":25503,"_17548":41118,"_23820":41119,"_2384":41120},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2857":99,"_25170":91,"_5":25503,"_17548":41122,"_23820":41123,"_2384":41124},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2857":100,"_25170":91,"_5":25503,"_17548":41126,"_23820":41127,"_2384":41128},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2857":101,"_25170":91,"_5":25503,"_17548":41130,"_23820":41131,"_2384":41132},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2857":102,"_25170":91,"_5":25503,"_17548":41134,"_23820":41135,"_2384":41136},[],"/docs/pr-preview/pr-38/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2857":103,"_25170":91,"_17548":41138,"_5":17443,"_23820":41100,"_2384":41139},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2857":104,"_25170":91,"_17548":41141,"_5":17443,"_23820":41100,"_2384":41142},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2857":105,"_25170":91,"_17548":41144,"_5":17443,"_23820":41104,"_2384":41145},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2857":106,"_25170":91,"_17548":41147,"_5":17443,"_23820":41104,"_2384":41148},[],"Fastlane installs or configures",{"_2857":107,"_25170":91,"_17548":41150,"_5":17443,"_23820":41104,"_2384":41151},[],"You still provide",{"_2857":108,"_25170":91,"_17548":41153,"_5":17443,"_23820":41104,"_2384":41154},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2857":109,"_25170":91,"_17548":41156,"_5":17443,"_23820":41104,"_2384":41157},[],"The Kubernetes cluster, nodes and persistent storage",{"_2857":110,"_25170":91,"_17548":41159,"_5":17443,"_23820":41104,"_2384":41160},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2857":111,"_25170":91,"_17548":41162,"_5":17443,"_23820":41104,"_2384":41163},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2857":112,"_25170":91,"_17548":41165,"_5":17443,"_23820":41104,"_2384":41166},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2857":113,"_25170":91,"_17548":41168,"_5":17443,"_23820":41104,"_2384":41169},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2857":114,"_25170":91,"_17548":41171,"_5":17443,"_23820":41104,"_2384":41172},[],"Optional observability and lab HSM components",{"_2857":115,"_25170":91,"_17548":41174,"_5":17443,"_23820":41104,"_2384":41175},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2857":116,"_25170":91,"_17548":41177,"_5":17443,"_23820":41104,"_2384":41178},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2857":117,"_25170":91,"_17548":41180,"_5":17443,"_23820":41108,"_2384":41181},[],"You need:",{"_2857":118,"_25170":91,"_17548":41183,"_5":17443,"_23820":41108,"_2384":41184},[],"an existing Kubernetes cluster",{"_2857":119,"_25170":91,"_17548":41186,"_5":17443,"_23820":41108,"_2384":41187},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2857":120,"_25170":91,"_17548":41189,"_5":17443,"_23820":41108,"_2384":41190},[],"`yq`",{"_2857":121,"_25170":91,"_17548":41192,"_5":17443,"_23820":41108,"_2384":19868},[],{"_2857":122,"_25170":91,"_17548":41194,"_5":17443,"_23820":41108,"_2384":41195},[],"`jq` only when using `--sample-data`",{"_2857":123,"_25170":91,"_17548":41197,"_5":17443,"_23820":41108,"_2384":41198},[],"free external ports 80 and 443 on a single-node K3s host",{"_2857":124,"_25170":91,"_17548":41200,"_5":17443,"_23820":41108,"_2384":41201},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2857":125,"_25170":91,"_17548":41203,"_5":17443,"_23820":41108,"_2384":41204},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2857":126,"_25170":91,"_17548":41206,"_5":17443,"_23820":41111,"_2384":41207},[],"Run the script from a clone of the Helm repository:",{"_2857":127,"_25170":91,"_17548":41209,"_5":17443,"_23820":41111,"_2384":41210},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2857":128,"_25170":91,"_17548":41212,"_5":17443,"_23820":41115,"_2384":41213},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2857":129,"_25170":91,"_17548":41215,"_5":17443,"_23820":41115,"_2384":41216},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2857":130,"_25170":91,"_17548":41218,"_5":17443,"_23820":41115,"_2384":41219},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2857":131,"_25170":91,"_17548":41221,"_5":17443,"_23820":41115,"_2384":41222},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2857":132,"_25170":91,"_17548":41224,"_5":17443,"_23820":41119,"_2384":41225},[],"Option",{"_2857":133,"_25170":91,"_17548":41227,"_5":17443,"_23820":41119,"_2384":41228},[],"Default",{"_2857":134,"_25170":91,"_17548":41230,"_5":17443,"_23820":41119,"_2384":41231},[],"Purpose",{"_2857":135,"_25170":91,"_17548":41233,"_5":17443,"_23820":41119,"_2384":41234},[],"`-h`, `--help`",{"_2857":136,"_25170":91,"_17548":41236,"_5":17443,"_23820":41119,"_2384":41237},[],"—",{"_2857":137,"_25170":91,"_17548":41239,"_5":17443,"_23820":41119,"_2384":41240},[],"Show help",{"_2857":138,"_25170":91,"_17548":41242,"_5":17443,"_23820":41119,"_2384":41243},[],"`-c`, `--context`",{"_2857":139,"_25170":91,"_17548":41245,"_5":17443,"_23820":41119,"_2384":41246},[],"current context",{"_2857":140,"_25170":91,"_17548":41248,"_5":17443,"_23820":41119,"_2384":41249},[],"Select the kubeconfig context for kubectl and Helm",{"_2857":141,"_25170":91,"_17548":41251,"_5":17443,"_23820":41119,"_2384":41252},[],"`-n`, `--non-interactive`",{"_2857":142,"_25170":91,"_17548":41254,"_5":17443,"_23820":41119,"_2384":5349},[],{"_2857":143,"_25170":91,"_17548":41256,"_5":17443,"_23820":41119,"_2384":41257},[],"Skip prompts and generate dependency credentials",{"_2857":144,"_25170":91,"_17548":41259,"_5":17443,"_23820":41119,"_2384":41260},[],"`-ns`, `--namespace`",{"_2857":145,"_25170":91,"_17548":41262,"_5":17443,"_23820":41119,"_2384":41263},[],"`lamassu-dev`",{"_2857":146,"_25170":91,"_17548":41265,"_5":17443,"_23820":41119,"_2384":41266},[],"Namespace for the installation",{"_2857":147,"_25170":91,"_17548":41268,"_5":17443,"_23820":41119,"_2384":41269},[],"`-d`, `--domain`",{"_2857":148,"_25170":91,"_17548":41271,"_5":17443,"_23820":41119,"_2384":41272},[],"`dev.lamassu.io`",{"_2857":149,"_25170":91,"_17548":41274,"_5":17443,"_23820":41119,"_2384":41275},[],"Domain used by the UI, OIDC and certificate",{"_2857":150,"_25170":91,"_17548":41277,"_5":17443,"_23820":41119,"_2384":41278},[],"`-v`, `--version`",{"_2857":151,"_25170":91,"_17548":41280,"_5":17443,"_23820":41119,"_2384":12520},[],{"_2857":152,"_25170":91,"_17548":41282,"_5":17443,"_23820":41119,"_2384":41283},[],"Lamassu chart version",{"_2857":153,"_25170":91,"_17548":41285,"_5":17443,"_23820":41119,"_2384":41286},[],"`--https-port`",{"_2857":154,"_25170":91,"_17548":41288,"_5":17443,"_23820":41119,"_2384":41289},[],"`443`",{"_2857":155,"_25170":91,"_17548":41291,"_5":17443,"_23820":41119,"_2384":41292},[],"Gateway HTTPS listener port",{"_2857":156,"_25170":91,"_17548":41294,"_5":17443,"_23820":41119,"_2384":41295},[],"`--http-port`",{"_2857":157,"_25170":91,"_17548":41297,"_5":17443,"_23820":41119,"_2384":41298},[],"`80`",{"_2857":158,"_25170":91,"_17548":41300,"_5":17443,"_23820":41119,"_2384":41301},[],"Gateway HTTP listener port",{"_2857":159,"_25170":91,"_17548":41303,"_5":17443,"_23820":41119,"_2384":41304},[],"`--tls-crt`",{"_2857":160,"_25170":91,"_17548":41306,"_5":17443,"_23820":41119,"_2384":41237},[],{"_2857":161,"_25170":91,"_17548":41308,"_5":17443,"_23820":41119,"_2384":41309},[],"PEM certificate for downstream TLS",{"_2857":162,"_25170":91,"_17548":41311,"_5":17443,"_23820":41119,"_2384":41312},[],"`--tls-key`",{"_2857":163,"_25170":91,"_17548":41314,"_5":17443,"_23820":41119,"_2384":41237},[],{"_2857":164,"_25170":91,"_17548":41316,"_5":17443,"_23820":41119,"_2384":41317},[],"PEM private key for downstream TLS",{"_2857":165,"_25170":91,"_17548":41319,"_5":17443,"_23820":41119,"_2384":41320},[],"`-l`, `--local-chart-path`",{"_2857":166,"_25170":91,"_17548":41322,"_5":17443,"_23820":41119,"_2384":41323},[],"repository chart",{"_2857":167,"_25170":91,"_17548":41325,"_5":17443,"_23820":41119,"_2384":41326},[],"Use an unpacked local Lamassu chart",{"_2857":168,"_25170":91,"_17548":41328,"_5":17443,"_23820":41119,"_2384":41329},[],"`-ip`, `--gateway-ip`",{"_2857":169,"_25170":91,"_17548":41331,"_5":17443,"_23820":41119,"_2384":7261},[],{"_2857":170,"_25170":91,"_17548":41333,"_5":17443,"_23820":41119,"_2384":41334},[],"Override the address written to `gateway.addresses`",{"_2857":171,"_25170":91,"_17548":41336,"_5":17443,"_23820":41119,"_2384":41337},[],"`--otel`",{"_2857":172,"_25170":91,"_17548":41339,"_5":17443,"_23820":41119,"_2384":5349},[],{"_2857":173,"_25170":91,"_17548":41341,"_5":17443,"_23820":41119,"_2384":41342},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2857":174,"_25170":91,"_17548":41344,"_5":17443,"_23820":41119,"_2384":41345},[],"`--sample-data`",{"_2857":175,"_25170":91,"_17548":41347,"_5":17443,"_23820":41119,"_2384":5349},[],{"_2857":176,"_25170":91,"_17548":41349,"_5":17443,"_23820":41119,"_2384":41350},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2857":177,"_25170":91,"_17548":41352,"_5":17443,"_23820":41119,"_2384":41353},[],"`--with-hsm`",{"_2857":178,"_25170":91,"_17548":41355,"_5":17443,"_23820":41119,"_2384":5349},[],{"_2857":179,"_25170":91,"_17548":41357,"_5":17443,"_23820":41119,"_2384":41358},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2857":180,"_25170":91,"_17548":41360,"_5":17443,"_23820":41119,"_2384":41361},[],"`--softhsm-chart-path`",{"_2857":181,"_25170":91,"_17548":41363,"_5":17443,"_23820":41119,"_2384":41364},[],"`./charts/softhsm`",{"_2857":182,"_25170":91,"_17548":41366,"_5":17443,"_23820":41119,"_2384":41367},[],"Use a different local SoftHSM chart",{"_2857":183,"_25170":91,"_17548":41369,"_5":17443,"_23820":41119,"_2384":41370},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2857":184,"_25170":91,"_17548":41372,"_5":17443,"_23820":41123,"_2384":41373},[],"Fastlane:",{"_2857":185,"_25170":91,"_17548":41375,"_5":17443,"_23820":41123,"_2384":41376},[],"validates local tools and the selected cluster",{"_2857":186,"_25170":91,"_17548":41378,"_5":17443,"_23820":41123,"_2384":41379},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2857":187,"_25170":91,"_17548":41381,"_5":17443,"_23820":41123,"_2384":41382},[],"creates the namespace",{"_2857":188,"_25170":91,"_17548":41384,"_5":17443,"_23820":41123,"_2384":41385},[],"installs PostgreSQL and creates the required databases",{"_2857":189,"_25170":91,"_17548":41387,"_5":17443,"_23820":41123,"_2384":41388},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2857":190,"_25170":91,"_17548":41390,"_5":17443,"_23820":41123,"_2384":41391},[],"installs RabbitMQ",{"_2857":191,"_25170":91,"_17548":41393,"_5":17443,"_23820":41123,"_2384":41394},[],"optionally installs observability and lab HSM components",{"_2857":192,"_25170":91,"_17548":41396,"_5":17443,"_23820":41123,"_2384":41397},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2857":193,"_25170":91,"_17548":41399,"_5":17443,"_23820":41123,"_2384":41400},[],"optionally loads sample data",{"_2857":194,"_25170":91,"_17548":41402,"_5":17443,"_23820":41123,"_2384":41403},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2857":195,"_25170":91,"_17548":41405,"_5":17443,"_23820":41127,"_2384":41406},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2857":196,"_25170":91,"_17548":41408,"_5":17443,"_23820":41127,"_2384":41409},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2857":197,"_25170":91,"_17548":41411,"_5":17443,"_23820":41131,"_2384":41412},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2857":198,"_25170":91,"_17548":41414,"_5":17443,"_23820":41131,"_2384":41415},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2857":199,"_25170":91,"_17548":41417,"_5":17443,"_23820":41131,"_2384":41418},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2857":200,"_25170":91,"_17548":41420,"_5":17443,"_23820":41135,"_2384":41421},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2857":201,"_25170":201,"_5":12294,"_2384":41423,"_25506":41424,"_17548":41425,"_23820":201},"Install with Helm",[40848,40849,40955],[],{"_2857":202,"_25170":201,"_17548":41427,"_5":17443,"_23820":201,"_2384":41428},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2857":203,"_25170":201,"_5":25503,"_17548":41430,"_23820":41431,"_2384":41432},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2857":204,"_25170":201,"_5":25503,"_17548":41434,"_23820":41435,"_2384":40858},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#before-you-begin",{"_2857":205,"_25170":201,"_5":25503,"_17548":41437,"_23820":41438,"_2384":41439},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2857":206,"_25170":201,"_5":25503,"_17548":41441,"_23820":41442,"_2384":41443},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2857":207,"_25170":201,"_5":25503,"_17548":41445,"_23820":41446,"_2384":41447},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2857":208,"_25170":201,"_5":25503,"_17548":41449,"_23820":41450,"_2384":41451},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2857":209,"_25170":201,"_5":25503,"_17548":41453,"_23820":41454,"_2384":41455},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2857":210,"_25170":201,"_5":25503,"_17548":41457,"_23820":41458,"_2384":41459},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2857":211,"_25170":201,"_5":25503,"_17548":41461,"_23820":41462,"_2384":41463},[],"/docs/pr-preview/pr-38/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2857":212,"_25170":201,"_17548":41465,"_5":17443,"_23820":41431,"_2384":41466},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2857":213,"_25170":201,"_17548":41468,"_5":17443,"_23820":41435,"_2384":41469},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2857":214,"_25170":201,"_17548":41471,"_5":17443,"_23820":41435,"_2384":41472},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2857":215,"_25170":201,"_17548":41474,"_5":17443,"_23820":41435,"_2384":41475},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2857":216,"_25170":201,"_17548":41477,"_5":17443,"_23820":41435,"_2384":41478},[],"a reachable RabbitMQ broker and credentials",{"_2857":217,"_25170":201,"_17548":41480,"_5":17443,"_23820":41435,"_2384":41481},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2857":218,"_25170":201,"_17548":41483,"_5":17443,"_23820":41435,"_2384":41484},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2857":219,"_25170":201,"_17548":41486,"_5":17443,"_23820":41435,"_2384":41487},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2857":220,"_25170":201,"_17548":41489,"_5":17443,"_23820":41435,"_2384":41490},[],"a StorageClass and an external traffic design",{"_2857":221,"_25170":201,"_17548":41492,"_5":17443,"_23820":41435,"_2384":41493},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2857":222,"_25170":201,"_17548":41495,"_5":17443,"_23820":41435,"_2384":41496},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2857":223,"_25170":201,"_17548":41498,"_5":17443,"_23820":41435,"_2384":41499},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2857":224,"_25170":201,"_17548":41501,"_5":17443,"_23820":41438,"_2384":41502},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2857":225,"_25170":201,"_17548":41504,"_5":17443,"_23820":41438,"_2384":41505},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2857":226,"_25170":201,"_17548":41507,"_5":17443,"_23820":41438,"_2384":41508},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2857":227,"_25170":201,"_17548":41510,"_5":17443,"_23820":41442,"_2384":41511},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2857":228,"_25170":201,"_17548":41513,"_5":17443,"_23820":41442,"_2384":41514},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2857":229,"_25170":201,"_17548":41516,"_5":17443,"_23820":41442,"_2384":41517},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2857":230,"_25170":201,"_17548":41519,"_5":17443,"_23820":41446,"_2384":41520},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2857":231,"_25170":201,"_17548":41522,"_5":17443,"_23820":41450,"_2384":41523},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2857":232,"_25170":201,"_17548":41525,"_5":17443,"_23820":41450,"_2384":41526},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2857":233,"_25170":201,"_17548":41528,"_5":17443,"_23820":41450,"_2384":41529},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2857":234,"_25170":201,"_17548":41531,"_5":17443,"_23820":41450,"_2384":41532},[],"See Access control for the principal and policy model.",{"_2857":235,"_25170":201,"_17548":41534,"_5":17443,"_23820":41454,"_2384":41535},[],"To install a local checkout instead:",{"_2857":236,"_25170":201,"_17548":41537,"_5":17443,"_23820":41458,"_2384":41538},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2857":237,"_25170":201,"_17548":41540,"_5":17443,"_23820":41458,"_2384":41541},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2857":238,"_25170":201,"_17548":41543,"_5":17443,"_23820":41462,"_2384":41544},[],"Before going live, review:",{"_2857":239,"_25170":201,"_17548":41546,"_5":17443,"_23820":41462,"_2384":41547},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2857":240,"_25170":201,"_17548":41549,"_5":17443,"_23820":41462,"_2384":41550},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2857":241,"_25170":201,"_17548":41552,"_5":17443,"_23820":41462,"_2384":41553},[],"shared VA storage before increasing VA replicas",{"_2857":242,"_25170":201,"_17548":41555,"_5":17443,"_23820":41462,"_2384":41556},[],"managed OIDC roles and removal of evaluation credentials",{"_2857":243,"_25170":201,"_17548":41558,"_5":17443,"_23820":41462,"_2384":41559},[],"a trusted TLS issuer or externally managed certificate",{"_2857":244,"_25170":201,"_17548":41561,"_5":17443,"_23820":41462,"_2384":41562},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2857":245,"_25170":201,"_17548":41564,"_5":17443,"_23820":41462,"_2384":41565},[],"SMTP, observability and alert delivery",{"_2857":246,"_25170":201,"_17548":41567,"_5":17443,"_23820":41462,"_2384":41568},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2857":247,"_25170":201,"_17548":41570,"_5":17443,"_23820":41462,"_2384":41571},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2857":248,"_25170":248,"_5":12294,"_2384":41573,"_25506":41574,"_17548":41575,"_23820":248},"Expose the Gateway",[40848,40849,40955],[],{"_2857":249,"_25170":248,"_17548":41577,"_5":17443,"_23820":248,"_2384":41578},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2857":250,"_25170":248,"_5":25503,"_17548":41580,"_23820":41581,"_2384":41582},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2857":251,"_25170":248,"_5":25503,"_17548":41584,"_23820":41585,"_2384":41586},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2857":252,"_25170":248,"_5":25503,"_17548":41588,"_23820":41589,"_2384":41590},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2857":253,"_25170":248,"_5":25503,"_17548":41592,"_23820":41593,"_2384":41594},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#k3s","K3s",{"_2857":254,"_25170":248,"_5":25503,"_17548":41596,"_23820":41597,"_2384":41598},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2857":255,"_25170":248,"_5":25503,"_17548":41600,"_23820":41601,"_2384":41602},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2857":256,"_25170":248,"_5":25503,"_17548":41604,"_23820":41605,"_2384":41606},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2857":257,"_25170":248,"_5":25503,"_17548":41608,"_23820":41609,"_2384":41610},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2857":258,"_25170":248,"_5":25503,"_17548":41612,"_23820":41613,"_2384":41614},[],"/docs/pr-preview/pr-38/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2857":259,"_25170":248,"_17548":41616,"_5":17443,"_23820":41581,"_2384":41617},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2857":260,"_25170":248,"_17548":41619,"_5":17443,"_23820":41581,"_2384":41620},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2857":261,"_25170":248,"_17548":41622,"_5":17443,"_23820":41585,"_2384":41623},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2857":262,"_25170":248,"_17548":41625,"_5":17443,"_23820":41585,"_2384":41626},[],"Set it only when:",{"_2857":263,"_25170":248,"_17548":41628,"_5":17443,"_23820":41585,"_2384":41629},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2857":264,"_25170":248,"_17548":41631,"_5":17443,"_23820":41585,"_2384":41632},[],"that address is allocated to this Gateway",{"_2857":265,"_25170":248,"_17548":41634,"_5":17443,"_23820":41585,"_2384":41635},[],"the surrounding network already routes traffic for it to the cluster",{"_2857":266,"_25170":248,"_17548":41637,"_5":17443,"_23820":41585,"_2384":41638},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2857":267,"_25170":248,"_17548":41640,"_5":17443,"_23820":41585,"_2384":41641},[],"Keep these two settings separate:",{"_2857":268,"_25170":248,"_17548":41643,"_5":17443,"_23820":41585,"_2384":41644},[],"`gateway.addresses` requests an address for the Gateway.",{"_2857":269,"_25170":248,"_17548":41646,"_5":17443,"_23820":41585,"_2384":41647},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2857":270,"_25170":248,"_17548":41649,"_5":17443,"_23820":41585,"_2384":41650},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2857":271,"_25170":248,"_17548":41652,"_5":17443,"_23820":41589,"_2384":41653},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2857":272,"_25170":248,"_17548":41655,"_5":17443,"_23820":41589,"_2384":41656},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2857":273,"_25170":248,"_17548":41658,"_5":17443,"_23820":41593,"_2384":41659},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2857":274,"_25170":248,"_17548":41661,"_5":17443,"_23820":41593,"_2384":41662},[],"For the recommended design:",{"_2857":275,"_25170":248,"_17548":41664,"_5":17443,"_23820":41593,"_2384":41665},[],"Use only one externally exposed Lamassu Gateway.",{"_2857":276,"_25170":248,"_17548":41667,"_5":17443,"_23820":41593,"_2384":41668},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2857":277,"_25170":248,"_17548":41670,"_5":17443,"_23820":41593,"_2384":41671},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2857":278,"_25170":248,"_17548":41673,"_5":17443,"_23820":41593,"_2384":41674},[],"Point DNS at the VM's reachable address.",{"_2857":279,"_25170":248,"_17548":41676,"_5":17443,"_23820":41593,"_2384":41677},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2857":280,"_25170":248,"_17548":41679,"_5":17443,"_23820":41597,"_2384":41680},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2857":281,"_25170":248,"_17548":41682,"_5":17443,"_23820":41601,"_2384":41683},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2857":282,"_25170":248,"_17548":41685,"_5":17443,"_23820":41601,"_2384":41686},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2857":283,"_25170":248,"_17548":41688,"_5":17443,"_23820":41605,"_2384":41689},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2857":284,"_25170":248,"_17548":41691,"_5":17443,"_23820":41605,"_2384":41692},[],"Requirement",{"_2857":285,"_25170":248,"_17548":41694,"_5":17443,"_23820":41605,"_2384":41695},[],"Recommended design",{"_2857":286,"_25170":248,"_17548":41697,"_5":17443,"_23820":41605,"_2384":41698},[],"Consequence",{"_2857":287,"_25170":248,"_17548":41700,"_5":17443,"_23820":41605,"_2384":41701},[],"Several Lamassu URLs or services",{"_2857":288,"_25170":248,"_17548":41703,"_5":17443,"_23820":41605,"_2384":41704},[],"One Gateway with multiple routes",{"_2857":289,"_25170":248,"_17548":41706,"_5":17443,"_23820":41605,"_2384":41707},[],"One IP and one proxy fleet; this is the chart default",{"_2857":290,"_25170":248,"_17548":41709,"_5":17443,"_23820":41605,"_2384":41710},[],"Independent Gateways and separate external IPs",{"_2857":291,"_25170":248,"_17548":41712,"_5":17443,"_23820":41605,"_2384":41713},[],"One VIP per Gateway",{"_2857":292,"_25170":248,"_17548":41715,"_5":17443,"_23820":41605,"_2384":41716},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2857":293,"_25170":248,"_17548":41718,"_5":17443,"_23820":41605,"_2384":41719},[],"Independent Gateways on one node and one IP",{"_2857":294,"_25170":248,"_17548":41721,"_5":17443,"_23820":41605,"_2384":41722},[],"Use different external ports",{"_2857":295,"_25170":248,"_17548":41724,"_5":17443,"_23820":41605,"_2384":41725},[],"Clients must include non-standard ports",{"_2857":296,"_25170":248,"_17548":41727,"_5":17443,"_23820":41605,"_2384":41728},[],"Separate TLS/mTLS termination behind one IP",{"_2857":297,"_25170":248,"_17548":41730,"_5":17443,"_23820":41605,"_2384":41731},[],"Front-door SNI routing to internal Gateways",{"_2857":298,"_25170":248,"_17548":41733,"_5":17443,"_23820":41605,"_2384":41734},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2857":299,"_25170":248,"_17548":41736,"_5":17443,"_23820":41605,"_2384":41737},[],"Separate Gateway resources but shared proxy infrastructure",{"_2857":300,"_25170":248,"_17548":41739,"_5":17443,"_23820":41605,"_2384":41740},[],"Envoy merged-Gateway mode",{"_2857":301,"_25170":248,"_17548":41742,"_5":17443,"_23820":41605,"_2384":41743},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2857":302,"_25170":248,"_17548":41745,"_5":17443,"_23820":41605,"_2384":41746},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2857":303,"_25170":248,"_17548":41748,"_5":17443,"_23820":41605,"_2384":41749},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2857":304,"_25170":248,"_17548":41751,"_5":17443,"_23820":41605,"_2384":41752},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2857":305,"_25170":248,"_17548":41754,"_5":17443,"_23820":41605,"_2384":41755},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2857":306,"_25170":248,"_17548":41757,"_5":17443,"_23820":41609,"_2384":41758},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2857":307,"_25170":248,"_17548":41760,"_5":17443,"_23820":41609,"_2384":41761},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2857":308,"_25170":248,"_17548":41763,"_5":17443,"_23820":41609,"_2384":41764},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2857":309,"_25170":248,"_17548":41766,"_5":17443,"_23820":41609,"_2384":41767},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2857":310,"_25170":248,"_17548":41769,"_5":17443,"_23820":41609,"_2384":41770},[],"If none of those are possible, use different external ports or change the external network design.",{"_2857":311,"_25170":248,"_17548":41772,"_5":17443,"_23820":41613,"_2384":41773},[],"Check, in order:",{"_2857":312,"_25170":248,"_17548":41775,"_5":17443,"_23820":41613,"_2384":41776},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2857":313,"_25170":248,"_17548":41778,"_5":17443,"_23820":41613,"_2384":41779},[],"Its status contains the expected address.",{"_2857":314,"_25170":248,"_17548":41781,"_5":17443,"_23820":41613,"_2384":41782},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2857":315,"_25170":248,"_17548":41784,"_5":17443,"_23820":41613,"_2384":41785},[],"Port 443 reaches that address from the client network.",{"_2857":316,"_25170":248,"_17548":41787,"_5":17443,"_23820":41613,"_2384":41788},[],"DNS resolves to the externally reachable endpoint.",{"_2857":317,"_25170":248,"_17548":41790,"_5":17443,"_23820":41613,"_2384":41791},[],"The certificate contains the DNS name or IP used by the client.",{"_2857":318,"_25170":248,"_17548":41793,"_5":17443,"_23820":41613,"_2384":41794},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2857":319,"_25170":319,"_5":12294,"_2384":40955,"_25506":41796,"_17548":41797,"_23820":319},[40848,40849,40955],[],{"_2857":320,"_25170":319,"_17548":41799,"_5":17443,"_23820":319,"_2384":41800},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2857":321,"_25170":319,"_5":25503,"_17548":41802,"_23820":41803,"_2384":41804},[],"/docs/pr-preview/pr-38/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2857":322,"_25170":319,"_5":25503,"_17548":41806,"_23820":41807,"_2384":41808},[],"/docs/pr-preview/pr-38/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2857":323,"_25170":319,"_5":25503,"_17548":41810,"_23820":41811,"_2384":41812},[],"/docs/pr-preview/pr-38/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2857":324,"_25170":319,"_5":25503,"_17548":41814,"_23820":41815,"_2384":41816},[],"/docs/pr-preview/pr-38/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2857":325,"_25170":319,"_5":25503,"_17548":41818,"_23820":41819,"_2384":41820},[],"/docs/pr-preview/pr-38/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2857":326,"_25170":319,"_5":25503,"_17548":41822,"_23820":41823,"_2384":41824},[],"/docs/pr-preview/pr-38/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2857":327,"_25170":319,"_17548":41826,"_5":17443,"_23820":41803,"_2384":41827},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2857":328,"_25170":319,"_17548":41829,"_5":17443,"_23820":41807,"_2384":41830},[],"Workflow",{"_2857":329,"_25170":319,"_17548":41832,"_5":17443,"_23820":41807,"_2384":41833},[],"Use it for",{"_2857":330,"_25170":319,"_17548":41835,"_5":17443,"_23820":41807,"_2384":41836},[],"What it installs",{"_2857":331,"_25170":319,"_17548":41838,"_5":17443,"_23820":41807,"_2384":41839},[],"Helm",{"_2857":332,"_25170":319,"_17548":41841,"_5":17443,"_23820":41807,"_2384":41842},[],"Production and controlled environments",{"_2857":333,"_25170":319,"_17548":41844,"_5":17443,"_23820":41807,"_2384":41845},[],"Lamassu services and Gateway API resources",{"_2857":334,"_25170":319,"_17548":41847,"_5":17443,"_23820":41807,"_2384":41092},[],{"_2857":335,"_25170":319,"_17548":41849,"_5":17443,"_23820":41807,"_2384":41850},[],"Evaluation, demos, CI and small lab clusters",{"_2857":336,"_25170":319,"_17548":41852,"_5":17443,"_23820":41807,"_2384":41853},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2857":337,"_25170":319,"_17548":41855,"_5":17443,"_23820":41811,"_2384":41856},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2857":338,"_25170":319,"_17548":41858,"_5":17443,"_23820":41811,"_2384":41859},[],"Area",{"_2857":339,"_25170":319,"_17548":41861,"_5":17443,"_23820":41811,"_2384":41862},[],"The Lamassu chart provides",{"_2857":340,"_25170":319,"_17548":41864,"_5":17443,"_23820":41811,"_2384":41865},[],"You provide",{"_2857":341,"_25170":319,"_17548":41867,"_5":17443,"_23820":41811,"_2384":41868},[],"Lamassu applications",{"_2857":342,"_25170":319,"_17548":41870,"_5":17443,"_23820":41811,"_2384":41871},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2857":343,"_25170":319,"_17548":41873,"_5":17443,"_23820":41811,"_2384":41874},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2857":344,"_25170":319,"_17548":41876,"_5":17443,"_23820":41811,"_2384":41877},[],"PostgreSQL data",{"_2857":345,"_25170":319,"_17548":41879,"_5":17443,"_23820":41811,"_2384":41880},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2857":346,"_25170":319,"_17548":41882,"_5":17443,"_23820":41811,"_2384":41883},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2857":347,"_25170":319,"_17548":41885,"_5":17443,"_23820":41811,"_2384":41886},[],"Messaging",{"_2857":348,"_25170":319,"_17548":41888,"_5":17443,"_23820":41811,"_2384":41889},[],"RabbitMQ connection configuration for the Lamassu services",{"_2857":349,"_25170":319,"_17548":41891,"_5":17443,"_23820":41811,"_2384":41892},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2857":350,"_25170":319,"_17548":41894,"_5":17443,"_23820":41811,"_2384":41895},[],"Identity",{"_2857":351,"_25170":319,"_17548":41897,"_5":17443,"_23820":41811,"_2384":41898},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2857":352,"_25170":319,"_17548":41900,"_5":17443,"_23820":41811,"_2384":41901},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2857":353,"_25170":319,"_17548":41903,"_5":17443,"_23820":41811,"_2384":41904},[],"External routing",{"_2857":354,"_25170":319,"_17548":41906,"_5":17443,"_23820":41811,"_2384":41907},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2857":355,"_25170":319,"_17548":41909,"_5":17443,"_23820":41811,"_2384":41910},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2857":356,"_25170":319,"_17548":41912,"_5":17443,"_23820":41811,"_2384":41913},[],"TLS",{"_2857":357,"_25170":319,"_17548":41915,"_5":17443,"_23820":41811,"_2384":41916},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2857":358,"_25170":319,"_17548":41918,"_5":17443,"_23820":41811,"_2384":41919},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2857":359,"_25170":319,"_17548":41921,"_5":17443,"_23820":41811,"_2384":41922},[],"Persistent application data",{"_2857":360,"_25170":319,"_17548":41924,"_5":17443,"_23820":41811,"_2384":41925},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2857":361,"_25170":319,"_17548":41927,"_5":17443,"_23820":41811,"_2384":41928},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2857":362,"_25170":319,"_17548":41930,"_5":17443,"_23820":41811,"_2384":41931},[],"Optional integrations",{"_2857":363,"_25170":319,"_17548":41933,"_5":17443,"_23820":41811,"_2384":41934},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2857":364,"_25170":319,"_17548":41936,"_5":17443,"_23820":41811,"_2384":41937},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2857":365,"_25170":319,"_17548":41939,"_5":17443,"_23820":41811,"_2384":41940},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2857":366,"_25170":319,"_17548":41942,"_5":17443,"_23820":41811,"_2384":41943},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2857":367,"_25170":319,"_17548":41945,"_5":17443,"_23820":41815,"_2384":41946},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2857":368,"_25170":319,"_17548":41948,"_5":17443,"_23820":41815,"_2384":41949},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2857":369,"_25170":319,"_17548":41951,"_5":17443,"_23820":41819,"_2384":41952},[],"Kubernetes 1.24 or newer",{"_2857":370,"_25170":319,"_17548":41954,"_5":17443,"_23820":41819,"_2384":41955},[],"Helm 3.2 or newer",{"_2857":371,"_25170":319,"_17548":41957,"_5":17443,"_23820":41819,"_2384":41958},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2857":372,"_25170":319,"_17548":41960,"_5":17443,"_23820":41819,"_2384":41961},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2857":373,"_25170":319,"_17548":41963,"_5":17443,"_23820":41819,"_2384":41964},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2857":374,"_25170":319,"_17548":41966,"_5":17443,"_23820":41819,"_2384":41967},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2857":375,"_25170":319,"_17548":41969,"_5":17443,"_23820":41819,"_2384":41970},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2857":376,"_25170":319,"_17548":41972,"_5":17443,"_23820":41823,"_2384":41973},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2857":377,"_25170":319,"_17548":41975,"_5":17443,"_23820":41823,"_2384":41976},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2857":378,"_25170":319,"_17548":41978,"_5":17443,"_23820":41823,"_2384":41979},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2857":379,"_25170":379,"_5":12294,"_2384":41981,"_25506":41982,"_17548":41984,"_23820":379},"Deployment troubleshooting",[40848,40849,41983],"Operations",[],{"_2857":380,"_25170":379,"_17548":41986,"_5":17443,"_23820":379,"_2384":41987},[],"Diagnose access, service health and infrastructure dependencies.",{"_2857":381,"_25170":379,"_5":25503,"_17548":41989,"_23820":41990,"_2384":41991},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2857":382,"_25170":379,"_5":25503,"_17548":41993,"_23820":41994,"_2384":41995},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2857":383,"_25170":379,"_5":25503,"_17548":41997,"_23820":41998,"_2384":41999},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2857":384,"_25170":379,"_5":25503,"_17548":42001,"_23820":42002,"_2384":42003},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2857":385,"_25170":379,"_5":25503,"_17548":42005,"_23820":42006,"_2384":42007},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2857":386,"_25170":379,"_5":25503,"_17548":42009,"_23820":42010,"_2384":42011},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2857":387,"_25170":379,"_5":25503,"_17548":42013,"_23820":42014,"_2384":42015},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2857":388,"_25170":379,"_5":25503,"_17548":42017,"_23820":42018,"_2384":42019},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2857":389,"_25170":379,"_5":25503,"_17548":42021,"_23820":42022,"_2384":42023},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2857":390,"_25170":379,"_5":25503,"_17548":42025,"_23820":42026,"_2384":42027},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2857":391,"_25170":379,"_5":25503,"_17548":42029,"_23820":42030,"_2384":42031},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2857":392,"_25170":379,"_5":25503,"_17548":42033,"_23820":42034,"_2384":42035},[],"/docs/pr-preview/pr-38/deployment/troubleshooting#observability","Observability",{"_2857":393,"_25170":379,"_17548":42037,"_5":17443,"_23820":379,"_2384":42038},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2857":394,"_25170":379,"_17548":42040,"_5":17443,"_23820":41994,"_2384":42041},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2857":395,"_25170":379,"_17548":42043,"_5":17443,"_23820":41998,"_2384":42044},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2857":396,"_25170":379,"_17548":42046,"_5":17443,"_23820":42002,"_2384":42047},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2857":397,"_25170":379,"_17548":42049,"_5":17443,"_23820":42006,"_2384":42050},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2857":398,"_25170":379,"_17548":42052,"_5":17443,"_23820":42010,"_2384":42053},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2857":399,"_25170":379,"_17548":42055,"_5":17443,"_23820":42014,"_2384":42056},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2857":400,"_25170":379,"_17548":42058,"_5":17443,"_23820":42014,"_2384":42059},[],"Also run the chart's connectivity test:",{"_2857":401,"_25170":379,"_17548":42061,"_5":17443,"_23820":42014,"_2384":42062},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2857":402,"_25170":379,"_17548":42064,"_5":17443,"_23820":42014,"_2384":42065},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2857":403,"_25170":379,"_17548":42067,"_5":17443,"_23820":42018,"_2384":42068},[],"If you receive a 401:",{"_2857":404,"_25170":379,"_17548":42070,"_5":17443,"_23820":42018,"_2384":42071},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2857":405,"_25170":379,"_17548":42073,"_5":17443,"_23820":42018,"_2384":42074},[],"verify issuer, audience and expiration of the token;",{"_2857":406,"_25170":379,"_17548":42076,"_5":17443,"_23820":42018,"_2384":42077},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2857":407,"_25170":379,"_17548":42079,"_5":17443,"_23820":42018,"_2384":42080},[],"check that the provider's public and internal routes point to the same realm.",{"_2857":408,"_25170":379,"_17548":42082,"_5":17443,"_23820":42018,"_2384":42083},[],"If login succeeds but the APIs return 403:",{"_2857":409,"_25170":379,"_17548":42085,"_5":17443,"_23820":42018,"_2384":42086},[],"inspect the token's real claims;",{"_2857":410,"_25170":379,"_17548":42088,"_5":17443,"_23820":42018,"_2384":42089},[],"confirm they match an active principal;",{"_2857":411,"_25170":379,"_17548":42091,"_5":17443,"_23820":42018,"_2384":42092},[],"review the policies granted to that principal;",{"_2857":412,"_25170":379,"_17548":42094,"_5":17443,"_23820":42018,"_2384":42095},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2857":413,"_25170":379,"_17548":42097,"_5":17443,"_23820":42018,"_2384":42098},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2857":414,"_25170":379,"_17548":42100,"_5":17443,"_23820":42022,"_2384":42101},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2857":415,"_25170":379,"_17548":42103,"_5":17443,"_23820":42022,"_2384":42104},[],"Locate the authz pod and Service.",{"_2857":416,"_25170":379,"_17548":42106,"_5":17443,"_23820":42022,"_2384":42107},[],"Check /health, logs and its database connection.",{"_2857":417,"_25170":379,"_17548":42109,"_5":17443,"_23820":42022,"_2384":42110},[],"Verify the DNS and port configured in externalAuthorization.",{"_2857":418,"_25170":379,"_17548":42112,"_5":17443,"_23820":42022,"_2384":42113},[],"Check the check route is /v1/ext\\_authz/check.",{"_2857":419,"_25170":379,"_17548":42115,"_5":17443,"_23820":42022,"_2384":42116},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2857":420,"_25170":379,"_17548":42118,"_5":17443,"_23820":42026,"_2384":42119},[],"Review kubectl describe pod first. Common causes are:",{"_2857":421,"_25170":379,"_17548":42121,"_5":17443,"_23820":42026,"_2384":42122},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2857":422,"_25170":379,"_17548":42124,"_5":17443,"_23820":42026,"_2384":42125},[],"unbound persistent volume;",{"_2857":423,"_25170":379,"_17548":42127,"_5":17443,"_23820":42026,"_2384":42128},[],"inaccessible image or incorrect pull policy;",{"_2857":424,"_25170":379,"_17548":42130,"_5":17443,"_23820":42026,"_2384":42131},[],"invalid cryptographic engine configuration;",{"_2857":425,"_25170":379,"_17548":42133,"_5":17443,"_23820":42026,"_2384":42134},[],"CPU or memory limits set too low;",{"_2857":426,"_25170":379,"_17548":42136,"_5":17443,"_23820":42026,"_2384":42137},[],"an incomplete prior migration.",{"_2857":427,"_25170":379,"_17548":42139,"_5":17443,"_23820":42026,"_2384":42140},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2857":428,"_25170":379,"_17548":42142,"_5":17443,"_23820":42026,"_2384":42143},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2857":429,"_25170":379,"_17548":42145,"_5":17443,"_23820":42030,"_2384":42146},[],"Domain and audit events depend on the bus publisher:",{"_2857":430,"_25170":379,"_17548":42148,"_5":17443,"_23820":42030,"_2384":42149},[],"verify it is enabled in the emitting service;",{"_2857":431,"_25170":379,"_17548":42151,"_5":17443,"_23820":42030,"_2384":42152},[],"check AMQP connectivity and credentials;",{"_2857":432,"_25170":379,"_17548":42154,"_5":17443,"_23820":42030,"_2384":42155},[],"review exchange, routing key, queues and consumers;",{"_2857":433,"_25170":379,"_17548":42157,"_5":17443,"_23820":42030,"_2384":42158},[],"inspect dead-letter queues;",{"_2857":434,"_25170":379,"_17548":42160,"_5":17443,"_23820":42030,"_2384":42161},[],"alert on orphan durable queues and backlog growth.",{"_2857":435,"_25170":379,"_17548":42163,"_5":17443,"_23820":42030,"_2384":42164},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2857":436,"_25170":379,"_17548":42166,"_5":17443,"_23820":42034,"_2384":42167},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2857":437,"_25170":379,"_17548":42169,"_5":17443,"_23820":42034,"_2384":42170},[],"Before closing an incident, record:",{"_2857":438,"_25170":379,"_17548":42172,"_5":17443,"_23820":42034,"_2384":42173},[],"the confirmed cause;",{"_2857":439,"_25170":379,"_17548":42175,"_5":17443,"_23820":42034,"_2384":42176},[],"the time scope and affected resources;",{"_2857":440,"_25170":379,"_17548":42178,"_5":17443,"_23820":42034,"_2384":42179},[],"the commands or queries used;",{"_2857":441,"_25170":379,"_17548":42181,"_5":17443,"_23820":42034,"_2384":42182},[],"the applied change and how to revert it;",{"_2857":442,"_25170":379,"_17548":42184,"_5":17443,"_23820":42034,"_2384":42185},[],"validation from a consumer;",{"_2857":443,"_25170":379,"_17548":42187,"_5":17443,"_23820":42034,"_2384":42188},[],"the preventive action and its owner.",{"_2857":444,"_25170":444,"_5":12294,"_2384":42190,"_25506":42191,"_17548":42194,"_23820":444},"Access control",[40848,42192,42193],"Platform","Administration",[],{"_2857":445,"_25170":444,"_17548":42196,"_5":17443,"_23820":444,"_2384":42197},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2857":446,"_25170":444,"_5":25503,"_17548":42199,"_23820":42200,"_2384":42201},[],"/docs/pr-preview/pr-38/platform/administration/access-control#essential-concepts","Essential concepts",{"_2857":447,"_25170":444,"_5":25503,"_17548":42203,"_23820":42204,"_2384":42205},[],"/docs/pr-preview/pr-38/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2857":448,"_25170":444,"_5":25503,"_17548":42207,"_23820":42208,"_2384":42209},[],"/docs/pr-preview/pr-38/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2857":449,"_25170":444,"_5":25503,"_17548":42211,"_23820":42212,"_2384":42213},[],"/docs/pr-preview/pr-38/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2857":450,"_25170":444,"_5":25503,"_17548":42215,"_23820":42216,"_2384":42217},[],"/docs/pr-preview/pr-38/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2857":451,"_25170":444,"_5":25503,"_17548":42219,"_23820":42220,"_2384":42221},[],"/docs/pr-preview/pr-38/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2857":452,"_25170":444,"_5":25503,"_17548":42223,"_23820":42224,"_2384":42225},[],"/docs/pr-preview/pr-38/platform/administration/access-control#oidc-principals","OIDC principals",{"_2857":453,"_25170":444,"_5":25503,"_17548":42227,"_23820":42228,"_2384":42229},[],"/docs/pr-preview/pr-38/platform/administration/access-control#x509-principals","X.509 principals",{"_2857":454,"_25170":444,"_5":25503,"_17548":42231,"_23820":42232,"_2384":42233},[],"/docs/pr-preview/pr-38/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2857":455,"_25170":444,"_5":25503,"_17548":42235,"_23820":42236,"_2384":42237},[],"/docs/pr-preview/pr-38/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2857":456,"_25170":444,"_5":25503,"_17548":42239,"_23820":42240,"_2384":42241},[],"/docs/pr-preview/pr-38/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2857":457,"_25170":444,"_5":25503,"_17548":42243,"_23820":42244,"_2384":42245},[],"/docs/pr-preview/pr-38/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2857":458,"_25170":444,"_5":25503,"_17548":42247,"_23820":42248,"_2384":42249},[],"/docs/pr-preview/pr-38/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2857":459,"_25170":444,"_5":25503,"_17548":42251,"_23820":42252,"_2384":42253},[],"/docs/pr-preview/pr-38/platform/administration/access-control#http-rules","HTTP rules",{"_2857":460,"_25170":444,"_5":25503,"_17548":42255,"_23820":42256,"_2384":42257},[],"/docs/pr-preview/pr-38/platform/administration/access-control#included-policies","Included policies",{"_2857":461,"_25170":444,"_5":25503,"_17548":42259,"_23820":42260,"_2384":41451},[],"/docs/pr-preview/pr-38/platform/administration/access-control#provision-the-first-administrator",{"_2857":462,"_25170":444,"_5":25503,"_17548":42262,"_23820":42263,"_2384":42264},[],"/docs/pr-preview/pr-38/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2857":463,"_25170":444,"_5":25503,"_17548":42266,"_23820":42267,"_2384":42268},[],"/docs/pr-preview/pr-38/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2857":464,"_25170":444,"_5":25503,"_17548":42270,"_23820":42271,"_2384":42272},[],"/docs/pr-preview/pr-38/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2857":465,"_25170":444,"_5":25503,"_17548":42274,"_23820":42275,"_2384":42276},[],"/docs/pr-preview/pr-38/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2857":466,"_25170":444,"_5":25503,"_17548":42278,"_23820":42279,"_2384":42280},[],"/docs/pr-preview/pr-38/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2857":467,"_25170":444,"_5":25503,"_17548":42282,"_23820":42283,"_2384":42284},[],"/docs/pr-preview/pr-38/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2857":468,"_25170":444,"_5":25503,"_17548":42286,"_23820":42287,"_2384":42288},[],"/docs/pr-preview/pr-38/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2857":469,"_25170":444,"_5":25503,"_17548":42290,"_23820":42291,"_2384":42292},[],"/docs/pr-preview/pr-38/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2857":470,"_25170":444,"_5":25503,"_17548":42294,"_23820":42295,"_2384":42296},[],"/docs/pr-preview/pr-38/platform/administration/access-control#operational-checklist","Operational checklist",{"_2857":471,"_25170":444,"_5":25503,"_17548":42298,"_23820":42299,"_2384":42300},[],"/docs/pr-preview/pr-38/platform/administration/access-control#diagnostics","Diagnostics",{"_2857":472,"_25170":444,"_5":25503,"_17548":42302,"_23820":42303,"_2384":42304},[],"/docs/pr-preview/pr-38/platform/administration/access-control#the-response-is-401","The response is 401",{"_2857":473,"_25170":444,"_5":25503,"_17548":42306,"_23820":42307,"_2384":42308},[],"/docs/pr-preview/pr-38/platform/administration/access-control#the-response-is-403","The response is 403",{"_2857":474,"_25170":444,"_5":25503,"_17548":42310,"_23820":42311,"_2384":42312},[],"/docs/pr-preview/pr-38/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2857":475,"_25170":444,"_5":25503,"_17548":42314,"_23820":42315,"_2384":42316},[],"/docs/pr-preview/pr-38/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2857":476,"_25170":444,"_5":25503,"_17548":42318,"_23820":42319,"_2384":42320},[],"/docs/pr-preview/pr-38/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2857":477,"_25170":444,"_17548":42322,"_5":17443,"_23820":444,"_2384":42323},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2857":478,"_25170":444,"_17548":42325,"_5":17443,"_23820":444,"_2384":42326},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2857":479,"_25170":444,"_17548":42328,"_5":17443,"_23820":444,"_2384":42329},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2857":480,"_25170":444,"_17548":42331,"_5":17443,"_23820":42200,"_2384":42332},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2857":481,"_25170":444,"_17548":42334,"_5":17443,"_23820":42200,"_2384":42335},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2857":482,"_25170":444,"_17548":42337,"_5":17443,"_23820":42200,"_2384":42338},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2857":483,"_25170":444,"_17548":42340,"_5":17443,"_23820":42200,"_2384":42341},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2857":484,"_25170":444,"_17548":42343,"_5":17443,"_23820":42200,"_2384":42344},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2857":485,"_25170":444,"_17548":42346,"_5":17443,"_23820":42200,"_2384":42347},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2857":486,"_25170":444,"_17548":42349,"_5":17443,"_23820":42204,"_2384":42350},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2857":487,"_25170":444,"_17548":42352,"_5":17443,"_23820":42204,"_2384":42353},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2857":488,"_25170":444,"_17548":42355,"_5":17443,"_23820":42208,"_2384":42356},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2857":489,"_25170":444,"_17548":42358,"_5":17443,"_23820":42208,"_2384":42359},[],"The decision is made **before forwarding the request to the service**:",{"_2857":490,"_25170":444,"_17548":42361,"_5":17443,"_23820":42208,"_2384":42362},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2857":491,"_25170":444,"_17548":42364,"_5":17443,"_23820":42208,"_2384":42365},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2857":492,"_25170":444,"_17548":42367,"_5":17443,"_23820":42208,"_2384":42368},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2857":493,"_25170":444,"_17548":42370,"_5":17443,"_23820":42208,"_2384":42371},[],"It separately loads the policies granted to each principal.",{"_2857":494,"_25170":444,"_17548":42373,"_5":17443,"_23820":42208,"_2384":42374},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2857":495,"_25170":444,"_17548":42376,"_5":17443,"_23820":42208,"_2384":42377},[],"`authz` looks for an HTTP rule granting that action.",{"_2857":496,"_25170":444,"_17548":42379,"_5":17443,"_23820":42208,"_2384":42380},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2857":497,"_25170":444,"_17548":42382,"_5":17443,"_23820":42208,"_2384":42383},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2857":498,"_25170":444,"_17548":42385,"_5":17443,"_23820":42208,"_2384":42386},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_2857":499,"_25170":444,"_17548":42388,"_5":17443,"_23820":42208,"_2384":42389},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2857":500,"_25170":444,"_17548":42391,"_5":17443,"_23820":42212,"_2384":42392},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2857":501,"_25170":444,"_17548":42394,"_5":17443,"_23820":42212,"_2384":42395},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2857":502,"_25170":444,"_17548":42397,"_5":17443,"_23820":42212,"_2384":42398},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2857":503,"_25170":444,"_17548":42400,"_5":17443,"_23820":42212,"_2384":42401},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2857":504,"_25170":444,"_17548":42403,"_5":17443,"_23820":42212,"_2384":42404},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2857":505,"_25170":444,"_17548":42406,"_5":17443,"_23820":42212,"_2384":42407},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2857":506,"_25170":444,"_17548":42409,"_5":17443,"_23820":42212,"_2384":42410},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2857":507,"_25170":444,"_17548":42412,"_5":17443,"_23820":42212,"_2384":42413},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2857":508,"_25170":444,"_17548":42415,"_5":17443,"_23820":42216,"_2384":42416},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2857":509,"_25170":444,"_17548":42418,"_5":17443,"_23820":42216,"_2384":42419},[],"The decision is made with the domain operation context:",{"_2857":510,"_25170":444,"_17548":42421,"_5":17443,"_23820":42216,"_2384":42422},[],"The middleware extracts the credential and resolves the matching principals.",{"_2857":511,"_25170":444,"_17548":42424,"_5":17443,"_23820":42216,"_2384":42425},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2857":512,"_25170":444,"_17548":42427,"_5":17443,"_23820":42216,"_2384":42428},[],"`authz` gathers the entity rules of the granted policies.",{"_2857":513,"_25170":444,"_17548":42430,"_5":17443,"_23820":42216,"_2384":42431},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2857":514,"_25170":444,"_17548":42433,"_5":17443,"_23820":42216,"_2384":42434},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2857":515,"_25170":444,"_17548":42436,"_5":17443,"_23820":42216,"_2384":42437},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2857":516,"_25170":444,"_17548":42439,"_5":17443,"_23820":42216,"_2384":42440},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2857":517,"_25170":444,"_17548":42442,"_5":17443,"_23820":42216,"_2384":42443},[],"Actions fall into two groups:",{"_2857":518,"_25170":444,"_17548":42445,"_5":17443,"_23820":42216,"_2384":42446},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2857":519,"_25170":444,"_17548":42448,"_5":17443,"_23820":42216,"_2384":42449},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2857":520,"_25170":444,"_17548":42451,"_5":17443,"_23820":42216,"_2384":42452},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2857":521,"_25170":444,"_17548":42454,"_5":17443,"_23820":42220,"_2384":42455},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2857":522,"_25170":444,"_17548":42457,"_5":17443,"_23820":42220,"_2384":42458},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2857":523,"_25170":444,"_17548":42460,"_5":17443,"_23820":42220,"_2384":42461},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2857":524,"_25170":444,"_17548":42463,"_5":17443,"_23820":42224,"_2384":42464},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2857":525,"_25170":444,"_17548":42466,"_5":17443,"_23820":42224,"_2384":42467},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2857":526,"_25170":444,"_17548":42469,"_5":17443,"_23820":42224,"_2384":42470},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2857":527,"_25170":444,"_17548":42472,"_5":17443,"_23820":42224,"_2384":42473},[],"The implemented operators are:",{"_2857":528,"_25170":444,"_17548":42475,"_5":17443,"_23820":42224,"_2384":42476},[],"`equals`, for exact equality;",{"_2857":529,"_25170":444,"_17548":42478,"_5":17443,"_23820":42224,"_2384":42479},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2857":530,"_25170":444,"_17548":42481,"_5":17443,"_23820":42224,"_2384":42482},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2857":531,"_25170":444,"_17548":42484,"_5":17443,"_23820":42224,"_2384":42485},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2857":532,"_25170":444,"_17548":42487,"_5":17443,"_23820":42228,"_2384":42488},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2857":533,"_25170":444,"_17548":42490,"_5":17443,"_23820":42228,"_2384":42491},[],"The available modes are:",{"_2857":534,"_25170":444,"_17548":42493,"_5":17443,"_23820":42228,"_2384":42494},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2857":535,"_25170":444,"_17548":42496,"_5":17443,"_23820":42228,"_2384":42497},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2857":536,"_25170":444,"_17548":42499,"_5":17443,"_23820":42228,"_2384":42500},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2857":537,"_25170":444,"_17548":42502,"_5":17443,"_23820":42228,"_2384":42503},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2857":538,"_25170":444,"_17548":42505,"_5":17443,"_23820":42228,"_2384":42506},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2857":539,"_25170":444,"_17548":42508,"_5":17443,"_23820":42228,"_2384":42509},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2857":540,"_25170":444,"_17548":42511,"_5":17443,"_23820":42232,"_2384":42512},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2857":541,"_25170":444,"_17548":42514,"_5":17443,"_23820":42232,"_2384":42515},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2857":542,"_25170":444,"_17548":42517,"_5":17443,"_23820":42232,"_2384":42518},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2857":543,"_25170":444,"_17548":42520,"_5":17443,"_23820":42232,"_2384":42521},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2857":544,"_25170":444,"_17548":42523,"_5":17443,"_23820":42240,"_2384":42524},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2857":545,"_25170":444,"_17548":42526,"_5":17443,"_23820":42240,"_2384":42527},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2857":546,"_25170":444,"_17548":42529,"_5":17443,"_23820":42244,"_2384":42530},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2857":547,"_25170":444,"_17548":42532,"_5":17443,"_23820":42244,"_2384":42533},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2857":548,"_25170":444,"_17548":42535,"_5":17443,"_23820":42248,"_2384":42536},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2857":549,"_25170":444,"_17548":42538,"_5":17443,"_23820":42248,"_2384":42539},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2857":550,"_25170":444,"_17548":42541,"_5":17443,"_23820":42248,"_2384":42542},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2857":551,"_25170":444,"_17548":42544,"_5":17443,"_23820":42252,"_2384":42545},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2857":552,"_25170":444,"_17548":42547,"_5":17443,"_23820":42252,"_2384":42548},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2857":553,"_25170":444,"_17548":42550,"_5":17443,"_23820":42252,"_2384":42551},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2857":554,"_25170":444,"_17548":42553,"_5":17443,"_23820":42252,"_2384":42554},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2857":555,"_25170":444,"_17548":42556,"_5":17443,"_23820":42252,"_2384":42557},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2857":556,"_25170":444,"_17548":42559,"_5":17443,"_23820":42252,"_2384":42560},[],"Note that:",{"_2857":557,"_25170":444,"_17548":42562,"_5":17443,"_23820":42252,"_2384":42563},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2857":558,"_25170":444,"_17548":42565,"_5":17443,"_23820":42252,"_2384":42566},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2857":559,"_25170":444,"_17548":42568,"_5":17443,"_23820":42252,"_2384":42569},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2857":560,"_25170":444,"_17548":42571,"_5":17443,"_23820":42256,"_2384":42572},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2857":561,"_25170":444,"_17548":42574,"_5":17443,"_23820":42256,"_2384":42575},[],"full and read-only access to certificates and authorities;",{"_2857":562,"_25170":444,"_17548":42577,"_5":17443,"_23820":42256,"_2384":42578},[],"full and read-only access to the KMS;",{"_2857":563,"_25170":444,"_17548":42580,"_5":17443,"_23820":42256,"_2384":42581},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2857":564,"_25170":444,"_17548":42583,"_5":17443,"_23820":42256,"_2384":42584},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2857":565,"_25170":444,"_17548":42586,"_5":17443,"_23820":42256,"_2384":42587},[],"console access;",{"_2857":566,"_25170":444,"_17548":42589,"_5":17443,"_23820":42256,"_2384":42590},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2857":567,"_25170":444,"_17548":42592,"_5":17443,"_23820":42256,"_2384":42593},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2857":568,"_25170":444,"_17548":42595,"_5":17443,"_23820":42256,"_2384":42596},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2857":569,"_25170":444,"_17548":42598,"_5":17443,"_23820":42260,"_2384":42599},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2857":570,"_25170":444,"_17548":42601,"_5":17443,"_23820":42260,"_2384":42602},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2857":571,"_25170":444,"_17548":42604,"_5":17443,"_23820":42260,"_2384":42605},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2857":572,"_25170":444,"_17548":42607,"_5":17443,"_23820":42263,"_2384":42608},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2857":573,"_25170":444,"_17548":42610,"_5":17443,"_23820":42267,"_2384":42611},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2857":574,"_25170":444,"_17548":42613,"_5":17443,"_23820":42271,"_2384":42614},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2857":575,"_25170":444,"_17548":42616,"_5":17443,"_23820":42275,"_2384":42617},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2857":576,"_25170":444,"_17548":42619,"_5":17443,"_23820":42279,"_2384":42620},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2857":577,"_25170":444,"_17548":42622,"_5":17443,"_23820":42283,"_2384":42623},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2857":578,"_25170":444,"_17548":42625,"_5":17443,"_23820":42283,"_2384":42626},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2857":579,"_25170":444,"_17548":42628,"_5":17443,"_23820":42287,"_2384":42629},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2857":580,"_25170":444,"_17548":42631,"_5":17443,"_23820":42287,"_2384":42632},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2857":581,"_25170":444,"_17548":42634,"_5":17443,"_23820":42287,"_2384":42635},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2857":582,"_25170":444,"_17548":42637,"_5":17443,"_23820":42287,"_2384":42638},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2857":583,"_25170":444,"_17548":42640,"_5":17443,"_23820":42287,"_2384":42641},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2857":584,"_25170":444,"_17548":42643,"_5":17443,"_23820":42287,"_2384":42644},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2857":585,"_25170":444,"_17548":42646,"_5":17443,"_23820":42287,"_2384":42647},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2857":586,"_25170":444,"_17548":42649,"_5":17443,"_23820":42287,"_2384":42650},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2857":587,"_25170":444,"_17548":42652,"_5":17443,"_23820":42291,"_2384":42653},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2857":588,"_25170":444,"_17548":42655,"_5":17443,"_23820":42291,"_2384":42656},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2857":589,"_25170":444,"_17548":42658,"_5":17443,"_23820":42291,"_2384":42659},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2857":590,"_25170":444,"_17548":42661,"_5":17443,"_23820":42295,"_2384":42662},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2857":591,"_25170":444,"_17548":42664,"_5":17443,"_23820":42295,"_2384":42665},[],"Use groups or stable roles for people and independent identities for automations.",{"_2857":592,"_25170":444,"_17548":42667,"_5":17443,"_23820":42295,"_2384":42668},[],"Keep at least two recovery administrators and test their access periodically.",{"_2857":593,"_25170":444,"_17548":42670,"_5":17443,"_23820":42295,"_2384":42671},[],"Review active principals, their matches and their grants after IdP changes.",{"_2857":594,"_25170":444,"_17548":42673,"_5":17443,"_23820":42295,"_2384":42674},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2857":595,"_25170":444,"_17548":42676,"_5":17443,"_23820":42295,"_2384":42677},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2857":596,"_25170":444,"_17548":42679,"_5":17443,"_23820":42295,"_2384":42680},[],"Always test one allowed and one denied operation for each role.",{"_2857":597,"_25170":444,"_17548":42682,"_5":17443,"_23820":42295,"_2384":42683},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2857":598,"_25170":444,"_17548":42685,"_5":17443,"_23820":42303,"_2384":42686},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2857":599,"_25170":444,"_17548":42688,"_5":17443,"_23820":42307,"_2384":42689},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2857":600,"_25170":444,"_17548":42691,"_5":17443,"_23820":42307,"_2384":42692},[],"that an active principal of the correct type exists;",{"_2857":601,"_25170":444,"_17548":42694,"_5":17443,"_23820":42307,"_2384":42695},[],"that the claim paths and values match the real token exactly;",{"_2857":602,"_25170":444,"_17548":42697,"_5":17443,"_23820":42307,"_2384":42698},[],"that all of the principal's conditions hold;",{"_2857":603,"_25170":444,"_17548":42700,"_5":17443,"_23820":42307,"_2384":42701},[],"that the principal has the expected policy granted;",{"_2857":604,"_25170":444,"_17548":42703,"_5":17443,"_23820":42307,"_2384":42704},[],"that the policy includes the action and the requested resource type or route;",{"_2857":605,"_25170":444,"_17548":42706,"_5":17443,"_23820":42307,"_2384":42707},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2857":606,"_25170":444,"_17548":42709,"_5":17443,"_23820":42307,"_2384":42710},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2857":607,"_25170":444,"_17548":42712,"_5":17443,"_23820":42311,"_2384":42713},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2857":608,"_25170":444,"_17548":42715,"_5":17443,"_23820":42315,"_2384":42716},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2857":609,"_25170":444,"_17548":42718,"_5":17443,"_23820":42319,"_2384":42719},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2857":610,"_25170":444,"_17548":42721,"_5":17443,"_23820":42319,"_2384":42722},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2857":611,"_25170":611,"_5":12294,"_2384":42724,"_25506":42725,"_17548":42726,"_23820":611},"Alerts and subscriptions",[40848,42192,42193],[],{"_2857":612,"_25170":611,"_17548":42728,"_5":17443,"_23820":611,"_2384":42729},[],"Send PKI events to people and external systems.",{"_2857":613,"_25170":611,"_5":25503,"_17548":42731,"_23820":42732,"_2384":42733},[],"/docs/pr-preview/pr-38/platform/administration/alerts#how-it-works","How it works",{"_2857":614,"_25170":611,"_5":25503,"_17548":42735,"_23820":42736,"_2384":42737},[],"/docs/pr-preview/pr-38/platform/administration/alerts#available-channels","Available channels",{"_2857":615,"_25170":611,"_5":25503,"_17548":42739,"_23820":42740,"_2384":42741},[],"/docs/pr-preview/pr-38/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2857":616,"_25170":611,"_5":25503,"_17548":42743,"_23820":42744,"_2384":42745},[],"/docs/pr-preview/pr-38/platform/administration/alerts#choose-the-event","Choose the event",{"_2857":617,"_25170":611,"_5":25503,"_17548":42747,"_23820":42748,"_2384":42749},[],"/docs/pr-preview/pr-38/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2857":618,"_25170":611,"_5":25503,"_17548":42751,"_23820":42752,"_2384":42753},[],"/docs/pr-preview/pr-38/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2857":619,"_25170":611,"_5":25503,"_17548":42755,"_23820":42756,"_2384":42757},[],"/docs/pr-preview/pr-38/platform/administration/alerts#review-and-activate","Review and activate",{"_2857":620,"_25170":611,"_5":25503,"_17548":42759,"_23820":42760,"_2384":42761},[],"/docs/pr-preview/pr-38/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_2857":621,"_25170":611,"_5":25503,"_17548":42763,"_23820":42764,"_2384":42765},[],"/docs/pr-preview/pr-38/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2857":622,"_25170":611,"_5":25503,"_17548":42767,"_23820":42768,"_2384":42769},[],"/docs/pr-preview/pr-38/platform/administration/alerts#event-families","Event families",{"_2857":623,"_25170":611,"_17548":42771,"_5":17443,"_23820":611,"_2384":42772},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2857":624,"_25170":611,"_17548":42774,"_5":17443,"_23820":42732,"_2384":42775},[],"A service publishes a domain event.",{"_2857":625,"_25170":611,"_17548":42777,"_5":17443,"_23820":42732,"_2384":42778},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2857":626,"_25170":611,"_17548":42780,"_5":17443,"_23820":42732,"_2384":42781},[],"Each subscription's filter decides whether it should be notified.",{"_2857":627,"_25170":611,"_17548":42783,"_5":17443,"_23820":42732,"_2384":42784},[],"Lamassu delivers the event to the configured channel.",{"_2857":628,"_25170":611,"_17548":42786,"_5":17443,"_23820":42732,"_2384":42787},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2857":629,"_25170":611,"_17548":42789,"_5":17443,"_23820":42736,"_2384":42790},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_2857":630,"_25170":611,"_17548":42792,"_5":17443,"_23820":42736,"_2384":42793},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2857":631,"_25170":611,"_17548":42795,"_5":17443,"_23820":42736,"_2384":42796},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2857":632,"_25170":611,"_17548":42798,"_5":17443,"_23820":42736,"_2384":42799},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_2857":633,"_25170":611,"_17548":42801,"_5":17443,"_23820":42736,"_2384":42802},[],"`apikey_options` requires `header` and `key`.",{"_2857":634,"_25170":611,"_17548":42804,"_5":17443,"_23820":42736,"_2384":42805},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2857":635,"_25170":611,"_17548":42807,"_5":17443,"_23820":42736,"_2384":42808},[],"`mtls_options` requires the inline PEM `cert_content` and `key_content`; values that reference files on the server are rejected.",{"_2857":636,"_25170":611,"_17548":42810,"_5":17443,"_23820":42736,"_2384":42811},[],"The alerts API reference documents the full `http_client` schema.",{"_2857":637,"_25170":611,"_17548":42813,"_5":17443,"_23820":42744,"_2384":42814},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2857":638,"_25170":611,"_17548":42816,"_5":17443,"_23820":42748,"_2384":42817},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2857":639,"_25170":611,"_17548":42819,"_5":17443,"_23820":42752,"_2384":42820},[],"Add a filter if you don't want to receive every instance of the event.",{"_2857":640,"_25170":611,"_17548":42822,"_5":17443,"_23820":42752,"_2384":42823},[],"**None** notifies all instances of the event.",{"_2857":641,"_25170":611,"_17548":42825,"_5":17443,"_23820":42752,"_2384":42826},[],"**JSON Path** evaluates one or more specific fields.",{"_2857":642,"_25170":611,"_17548":42828,"_5":17443,"_23820":42752,"_2384":42829},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2857":643,"_25170":611,"_17548":42831,"_5":17443,"_23820":42752,"_2384":42832},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_2857":644,"_25170":611,"_17548":42834,"_5":17443,"_23820":42752,"_2384":42835},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2857":645,"_25170":611,"_17548":42837,"_5":17443,"_23820":42756,"_2384":42838},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2857":646,"_25170":611,"_17548":42840,"_5":17443,"_23820":42760,"_2384":42841},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_2857":647,"_25170":611,"_17548":42843,"_5":17443,"_23820":42760,"_2384":42844},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_2857":648,"_25170":611,"_17548":42846,"_5":17443,"_23820":42760,"_2384":42847},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_2857":649,"_25170":611,"_17548":42849,"_5":17443,"_23820":42760,"_2384":42850},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_2857":650,"_25170":611,"_17548":42852,"_5":17443,"_23820":42760,"_2384":42853},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_2857":651,"_25170":611,"_17548":42855,"_5":17443,"_23820":42760,"_2384":42856},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_2857":652,"_25170":611,"_17548":42858,"_5":17443,"_23820":42760,"_2384":42859},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_2857":653,"_25170":611,"_17548":42861,"_5":17443,"_23820":42760,"_2384":42862},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_2857":654,"_25170":611,"_17548":42864,"_5":17443,"_23820":42764,"_2384":42865},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2857":655,"_25170":611,"_17548":42867,"_5":17443,"_23820":42768,"_2384":42868},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2857":656,"_25170":611,"_17548":42870,"_5":17443,"_23820":42768,"_2384":42871},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2857":657,"_25170":611,"_17548":42873,"_5":17443,"_23820":42768,"_2384":42874},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_2857":658,"_25170":611,"_17548":42876,"_5":17443,"_23820":42768,"_2384":42877},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2857":659,"_25170":611,"_17548":42879,"_5":17443,"_23820":42768,"_2384":42880},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2857":660,"_25170":611,"_17548":42882,"_5":17443,"_23820":42768,"_2384":42883},[],"**Validation:** `va.role.crl.create`.",{"_2857":661,"_25170":611,"_17548":42885,"_5":17443,"_23820":42768,"_2384":42886},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_2857":662,"_25170":611,"_17548":42888,"_5":17443,"_23820":42768,"_2384":42889},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2857":663,"_25170":663,"_5":12294,"_2384":42891,"_25506":42892,"_17548":42893,"_23820":663},"Audit logs",[40848,42192,42193],[],{"_2857":664,"_25170":663,"_17548":42895,"_5":17443,"_23820":663,"_2384":42896},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2857":665,"_25170":663,"_5":25503,"_17548":42898,"_23820":42899,"_2384":42900},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2857":666,"_25170":663,"_5":25503,"_17548":42902,"_23820":42903,"_2384":42904},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#coverage","Coverage",{"_2857":667,"_25170":663,"_5":25503,"_17548":42906,"_23820":42907,"_2384":42908},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2857":668,"_25170":663,"_5":25503,"_17548":42910,"_23820":42911,"_2384":42912},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2857":669,"_25170":663,"_5":25503,"_17548":42914,"_23820":42915,"_2384":42916},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2857":670,"_25170":663,"_5":25503,"_17548":42918,"_23820":42919,"_2384":42920},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2857":671,"_25170":663,"_5":25503,"_17548":42922,"_23820":42923,"_2384":42924},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2857":672,"_25170":663,"_5":25503,"_17548":42926,"_23820":42927,"_2384":42928},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2857":673,"_25170":663,"_5":25503,"_17548":42930,"_23820":42931,"_2384":42932},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2857":674,"_25170":663,"_5":25503,"_17548":42934,"_23820":42935,"_2384":42936},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2857":675,"_25170":663,"_5":25503,"_17548":42938,"_23820":42939,"_2384":42940},[],"/docs/pr-preview/pr-38/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2857":676,"_25170":663,"_17548":42942,"_5":17443,"_23820":663,"_2384":42943},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2857":677,"_25170":663,"_17548":42945,"_5":17443,"_23820":42899,"_2384":42946},[],"The audit body includes:",{"_2857":678,"_25170":663,"_17548":42948,"_5":17443,"_23820":42899,"_2384":42949},[],"input: data received by the operation;",{"_2857":679,"_25170":663,"_17548":42951,"_5":17443,"_23820":42899,"_2384":42952},[],"has\\_error: whether the service returned an error;",{"_2857":680,"_25170":663,"_17548":42954,"_5":17443,"_23820":42899,"_2384":42955},[],"output: produced result or error message;",{"_2857":681,"_25170":663,"_17548":42957,"_5":17443,"_23820":42899,"_2384":42958},[],"principals: identifiers of the principals that matched the request.",{"_2857":682,"_25170":663,"_17548":42960,"_5":17443,"_23820":42899,"_2384":42961},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2857":683,"_25170":663,"_17548":42963,"_5":17443,"_23820":42899,"_2384":42964},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2857":684,"_25170":663,"_17548":42966,"_5":17443,"_23820":42903,"_2384":42967},[],"The backend applies auditing to mutations of:",{"_2857":685,"_25170":663,"_17548":42969,"_5":17443,"_23820":42903,"_2384":42970},[],"authorities, certificates and issuance profiles;",{"_2857":686,"_25170":663,"_17548":42972,"_5":17443,"_23820":42903,"_2384":42973},[],"keys and KMS engines;",{"_2857":687,"_25170":663,"_17548":42975,"_5":17443,"_23820":42903,"_2384":42976},[],"devices and identities;",{"_2857":688,"_25170":663,"_17548":42978,"_5":17443,"_23820":42903,"_2384":42979},[],"DMSs and enrollment operations;",{"_2857":689,"_25170":663,"_17548":42981,"_5":17443,"_23820":42903,"_2384":42982},[],"validation functions and CRL;",{"_2857":690,"_25170":663,"_17548":42984,"_5":17443,"_23820":42903,"_2384":42985},[],"principals, policies and authorization grants.",{"_2857":691,"_25170":663,"_17548":42987,"_5":17443,"_23820":42903,"_2384":42988},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2857":692,"_25170":663,"_17548":42990,"_5":17443,"_23820":42907,"_2384":42991},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2857":693,"_25170":663,"_17548":42993,"_5":17443,"_23820":42907,"_2384":42994},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2857":694,"_25170":663,"_17548":42996,"_5":17443,"_23820":42907,"_2384":42997},[],"Design the consumer to:",{"_2857":695,"_25170":663,"_17548":42999,"_5":17443,"_23820":42907,"_2384":43000},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2857":696,"_25170":663,"_17548":43002,"_5":17443,"_23820":42907,"_2384":43003},[],"keep the complete CloudEvent unmodified;",{"_2857":697,"_25170":663,"_17548":43005,"_5":17443,"_23820":42907,"_2384":43006},[],"record the ingestion time and detect duplicates by ID;",{"_2857":698,"_25170":663,"_17548":43008,"_5":17443,"_23820":42907,"_2384":43009},[],"encrypt in transit and at rest;",{"_2857":699,"_25170":663,"_17548":43011,"_5":17443,"_23820":42907,"_2384":43012},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2857":700,"_25170":663,"_17548":43014,"_5":17443,"_23820":42907,"_2384":43015},[],"apply an explicit retention and legal hold policy;",{"_2857":701,"_25170":663,"_17548":43017,"_5":17443,"_23820":42907,"_2384":43018},[],"alert if it stops consuming or the pending queue grows.",{"_2857":702,"_25170":663,"_17548":43020,"_5":17443,"_23820":42911,"_2384":43021},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2857":703,"_25170":663,"_17548":43023,"_5":17443,"_23820":42911,"_2384":43024},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2857":704,"_25170":663,"_17548":43026,"_5":17443,"_23820":42919,"_2384":43027},[],"Start from the reported time and normalize every source to UTC.",{"_2857":705,"_25170":663,"_17548":43029,"_5":17443,"_23820":42923,"_2384":43030},[],"Filter by event type, service source and resource identifier.",{"_2857":706,"_25170":663,"_17548":43032,"_5":17443,"_23820":42927,"_2384":43033},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2857":707,"_25170":663,"_17548":43035,"_5":17443,"_23820":42931,"_2384":43036},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2857":708,"_25170":663,"_17548":43038,"_5":17443,"_23820":42935,"_2384":43039},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2857":709,"_25170":663,"_17548":43041,"_5":17443,"_23820":42939,"_2384":43042},[],"Generate a controlled mutation in a test environment and check that:",{"_2857":710,"_25170":663,"_17548":43044,"_5":17443,"_23820":42939,"_2384":43045},[],"a successful audit event appears;",{"_2857":711,"_25170":663,"_17548":43047,"_5":17443,"_23820":42939,"_2384":43048},[],"the principal matches the identity used;",{"_2857":712,"_25170":663,"_17548":43050,"_5":17443,"_23820":42939,"_2384":43051},[],"the consumer persists it exactly once;",{"_2857":713,"_25170":663,"_17548":43053,"_5":17443,"_23820":42939,"_2384":43054},[],"it can be retrieved by resource, actor and period;",{"_2857":714,"_25170":663,"_17548":43056,"_5":17443,"_23820":42939,"_2384":43057},[],"a consumer outage raises an alert.",{"_2857":715,"_25170":663,"_17548":43059,"_5":17443,"_23820":42939,"_2384":43060},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2857":716,"_25170":716,"_5":12294,"_2384":43062,"_25506":43063,"_17548":43064,"_23820":716},"Platform architecture",[40848,42192],[],{"_2857":717,"_25170":716,"_17548":43066,"_5":17443,"_23820":716,"_2384":43067},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2857":718,"_25170":716,"_5":25503,"_17548":43069,"_23820":43070,"_2384":43071},[],"/docs/pr-preview/pr-38/platform/concepts/architecture#control-plane","Control plane",{"_2857":719,"_25170":716,"_5":25503,"_17548":43073,"_23820":43074,"_2384":43075},[],"/docs/pr-preview/pr-38/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2857":720,"_25170":716,"_5":25503,"_17548":43077,"_23820":43078,"_2384":43079},[],"/docs/pr-preview/pr-38/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2857":721,"_25170":716,"_5":25503,"_17548":43081,"_23820":43082,"_2384":43083},[],"/docs/pr-preview/pr-38/platform/concepts/architecture#status-and-validation","Status and validation",{"_2857":722,"_25170":716,"_5":25503,"_17548":43085,"_23820":43086,"_2384":43087},[],"/docs/pr-preview/pr-38/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2857":723,"_25170":716,"_17548":43089,"_5":17443,"_23820":716,"_2384":43090},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2857":724,"_25170":716,"_17548":43092,"_5":17443,"_23820":716,"_2384":43093},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2857":725,"_25170":716,"_17548":43095,"_5":17443,"_23820":43070,"_2384":43096},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2857":726,"_25170":716,"_17548":43098,"_5":17443,"_23820":43074,"_2384":43099},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2857":727,"_25170":716,"_17548":43101,"_5":17443,"_23820":43078,"_2384":43102},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2857":728,"_25170":716,"_17548":43104,"_5":17443,"_23820":43082,"_2384":43105},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2857":729,"_25170":716,"_17548":43107,"_5":17443,"_23820":43086,"_2384":43108},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2857":730,"_25170":730,"_5":12294,"_2384":43110,"_25506":43111,"_17548":43112,"_23820":730},"How Lamassu works",[40848,42192],[],{"_2857":731,"_25170":730,"_17548":43114,"_5":17443,"_23820":730,"_2384":43115},[],"The mental model of trust, keys, certificates and devices.",{"_2857":732,"_25170":730,"_5":25503,"_17548":43117,"_23820":43118,"_2384":43119},[],"/docs/pr-preview/pr-38/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2857":733,"_25170":730,"_5":25503,"_17548":43121,"_23820":43122,"_2384":43123},[],"/docs/pr-preview/pr-38/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2857":734,"_25170":730,"_17548":43125,"_5":17443,"_23820":730,"_2384":43126},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2857":735,"_25170":730,"_17548":43128,"_5":17443,"_23820":43118,"_2384":43129},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2857":736,"_25170":730,"_17548":43131,"_5":17443,"_23820":43118,"_2384":43132},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2857":737,"_25170":730,"_17548":43134,"_5":17443,"_23820":43118,"_2384":43135},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2857":738,"_25170":730,"_17548":43137,"_5":17443,"_23820":43118,"_2384":43138},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2857":739,"_25170":730,"_17548":43140,"_5":17443,"_23820":43118,"_2384":43141},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2857":740,"_25170":730,"_17548":43143,"_5":17443,"_23820":43122,"_2384":43144},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2857":741,"_25170":730,"_17548":43146,"_5":17443,"_23820":43122,"_2384":43147},[],"A DMS relates that CA to an enrollment policy.",{"_2857":742,"_25170":730,"_17548":43149,"_5":17443,"_23820":43122,"_2384":43150},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2857":743,"_25170":730,"_17548":43152,"_5":17443,"_23820":43122,"_2384":43153},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2857":744,"_25170":730,"_17548":43155,"_5":17443,"_23820":43122,"_2384":43156},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2857":745,"_25170":730,"_17548":43158,"_5":17443,"_23820":43122,"_2384":43159},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2857":746,"_25170":730,"_17548":43161,"_5":17443,"_23820":43122,"_2384":43162},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2857":747,"_25170":747,"_5":12294,"_2384":43164,"_25506":43165,"_17548":43167,"_23820":747},"Devices and identities",[40848,42192,43166,43164],"IoT Fleets",[],{"_2857":748,"_25170":747,"_17548":43169,"_5":17443,"_23820":747,"_2384":43170},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2857":749,"_25170":747,"_5":25503,"_17548":43172,"_23820":43173,"_2384":43174},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#device-states","Device states",{"_2857":750,"_25170":747,"_5":25503,"_17548":43176,"_23820":43177,"_2384":43178},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2857":751,"_25170":747,"_5":25503,"_17548":43180,"_23820":43181,"_2384":43182},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2857":752,"_25170":747,"_5":25503,"_17548":43184,"_23820":43185,"_2384":43186},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2857":753,"_25170":747,"_5":25503,"_17548":43188,"_23820":43189,"_2384":43190},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2857":754,"_25170":747,"_5":25503,"_17548":43192,"_23820":43193,"_2384":43194},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2857":755,"_25170":747,"_5":25503,"_17548":43196,"_23820":43197,"_2384":43198},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2857":756,"_25170":747,"_5":25503,"_17548":43200,"_23820":43201,"_2384":43202},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2857":757,"_25170":747,"_5":25503,"_17548":43204,"_23820":43205,"_2384":43206},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2857":758,"_25170":747,"_5":25503,"_17548":43208,"_23820":43209,"_2384":43210},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2857":759,"_25170":747,"_5":25503,"_17548":43212,"_23820":43213,"_2384":43214},[],"/docs/pr-preview/pr-38/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2857":760,"_25170":747,"_17548":43216,"_5":17443,"_23820":747,"_2384":43217},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2857":761,"_25170":747,"_17548":43219,"_5":17443,"_23820":747,"_2384":43220},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2857":762,"_25170":747,"_17548":43222,"_5":17443,"_23820":43173,"_2384":43223},[],"Operational view",{"_2857":763,"_25170":747,"_17548":43225,"_5":17443,"_23820":43173,"_2384":43226},[],"Meaning",{"_2857":764,"_25170":747,"_17548":43228,"_5":17443,"_23820":43173,"_2384":43229},[],"**No Identity**",{"_2857":765,"_25170":747,"_17548":43231,"_5":17443,"_23820":43173,"_2384":43232},[],"A record exists without an associated identity.",{"_2857":766,"_25170":747,"_17548":43234,"_5":17443,"_23820":43173,"_2384":43235},[],"**Active**",{"_2857":767,"_25170":747,"_17548":43237,"_5":17443,"_23820":43173,"_2384":43238},[],"The slot is active; also check certificate dates, status and usages.",{"_2857":768,"_25170":747,"_17548":43240,"_5":17443,"_23820":43173,"_2384":43241},[],"**Renewal Pending**",{"_2857":769,"_25170":747,"_17548":43243,"_5":17443,"_23820":43173,"_2384":43244},[],"The identity is in the operational renewal window.",{"_2857":770,"_25170":747,"_17548":43246,"_5":17443,"_23820":43173,"_2384":43247},[],"**Expiring Soon**",{"_2857":771,"_25170":747,"_17548":43249,"_5":17443,"_23820":43173,"_2384":43250},[],"Expiration is approaching according to configured thresholds.",{"_2857":772,"_25170":747,"_17548":43252,"_5":17443,"_23820":43173,"_2384":43253},[],"**Expired**",{"_2857":773,"_25170":747,"_17548":43255,"_5":17443,"_23820":43173,"_2384":43256},[],"The identity has expired.",{"_2857":774,"_25170":747,"_17548":43258,"_5":17443,"_23820":43173,"_2384":43259},[],"**Revoked**",{"_2857":775,"_25170":747,"_17548":43261,"_5":17443,"_23820":43173,"_2384":43262},[],"The identity is marked revoked.",{"_2857":776,"_25170":747,"_17548":43264,"_5":17443,"_23820":43173,"_2384":43265},[],"**Decommissioned**",{"_2857":777,"_25170":747,"_17548":43267,"_5":17443,"_23820":43173,"_2384":43268},[],"The record is retired and ordinary updates do not restore operation.",{"_2857":778,"_25170":747,"_17548":43270,"_5":17443,"_23820":43173,"_2384":43271},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2857":779,"_25170":747,"_17548":43273,"_5":17443,"_23820":43177,"_2384":43274},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2857":780,"_25170":747,"_17548":43276,"_5":17443,"_23820":43177,"_2384":43277},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2857":781,"_25170":747,"_17548":43279,"_5":17443,"_23820":43177,"_2384":43280},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2857":782,"_25170":747,"_17548":43282,"_5":17443,"_23820":43177,"_2384":43283},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2857":783,"_25170":747,"_17548":43285,"_5":17443,"_23820":43181,"_2384":43286},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2857":784,"_25170":747,"_17548":43288,"_5":17443,"_23820":43185,"_2384":43289},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2857":785,"_25170":747,"_17548":43291,"_5":17443,"_23820":43189,"_2384":43292},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2857":786,"_25170":747,"_17548":43294,"_5":17443,"_23820":43193,"_2384":43295},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2857":787,"_25170":747,"_17548":43297,"_5":17443,"_23820":43197,"_2384":43298},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2857":788,"_25170":747,"_17548":43300,"_5":17443,"_23820":43197,"_2384":43301},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2857":789,"_25170":747,"_17548":43303,"_5":17443,"_23820":43201,"_2384":43304},[],"From **No Identity**, use **Assign Identity**:",{"_2857":790,"_25170":747,"_17548":43306,"_5":17443,"_23820":43201,"_2384":43307},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2857":791,"_25170":747,"_17548":43309,"_5":17443,"_23820":43201,"_2384":43310},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2857":792,"_25170":747,"_17548":43312,"_5":17443,"_23820":43201,"_2384":43313},[],"Confirm and read the serial, active version and history again.",{"_2857":793,"_25170":747,"_17548":43315,"_5":17443,"_23820":43201,"_2384":43316},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2857":794,"_25170":747,"_17548":43318,"_5":17443,"_23820":43201,"_2384":43319},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2857":795,"_25170":747,"_17548":43321,"_5":17443,"_23820":43205,"_2384":43322},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2857":796,"_25170":747,"_17548":43324,"_5":17443,"_23820":43205,"_2384":43325},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2857":797,"_25170":747,"_17548":43327,"_5":17443,"_23820":43209,"_2384":43328},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2857":798,"_25170":747,"_17548":43330,"_5":17443,"_23820":43209,"_2384":43331},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2857":799,"_25170":747,"_17548":43333,"_5":17443,"_23820":43209,"_2384":43334},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2857":800,"_25170":747,"_17548":43336,"_5":17443,"_23820":43209,"_2384":43337},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2857":801,"_25170":747,"_17548":43339,"_5":17443,"_23820":43213,"_2384":43340},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2857":802,"_25170":747,"_17548":43342,"_5":17443,"_23820":43213,"_2384":43343},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2857":803,"_25170":803,"_5":12294,"_2384":43345,"_25506":43346,"_17548":43348,"_23820":803},"Bootstrap identity and authentication",[40848,42192,43166,43164,43347],"Enrollment with PKI",[],{"_2857":804,"_25170":803,"_17548":43350,"_5":17443,"_23820":803,"_2384":43351},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2857":805,"_25170":803,"_5":25503,"_17548":43353,"_23820":43354,"_2384":43355},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2857":806,"_25170":803,"_5":25503,"_17548":43357,"_23820":43358,"_2384":43359},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2857":807,"_25170":803,"_5":25503,"_17548":43361,"_23820":43362,"_2384":43363},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2857":808,"_25170":803,"_5":25503,"_17548":43365,"_23820":43366,"_2384":43367},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2857":809,"_25170":803,"_5":25503,"_17548":43369,"_23820":43370,"_2384":43371},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2857":810,"_25170":803,"_17548":43373,"_5":17443,"_23820":803,"_2384":43374},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2857":811,"_25170":803,"_17548":43376,"_5":17443,"_23820":43354,"_2384":43377},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2857":812,"_25170":803,"_17548":43379,"_5":17443,"_23820":43354,"_2384":43380},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2857":813,"_25170":803,"_17548":43382,"_5":17443,"_23820":43358,"_2384":43383},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2857":814,"_25170":803,"_17548":43385,"_5":17443,"_23820":43358,"_2384":43386},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2857":815,"_25170":803,"_17548":43388,"_5":17443,"_23820":43358,"_2384":43389},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2857":816,"_25170":803,"_17548":43391,"_5":17443,"_23820":43362,"_2384":43392},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2857":817,"_25170":803,"_17548":43394,"_5":17443,"_23820":43362,"_2384":43395},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2857":818,"_25170":803,"_17548":43397,"_5":17443,"_23820":43366,"_2384":43398},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_2857":819,"_25170":803,"_17548":43400,"_5":17443,"_23820":43366,"_2384":43401},[],"Example body:",{"_2857":820,"_25170":803,"_17548":43403,"_5":17443,"_23820":43366,"_2384":43404},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2857":821,"_25170":803,"_17548":43406,"_5":17443,"_23820":43366,"_2384":43407},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2857":822,"_25170":803,"_17548":43409,"_5":17443,"_23820":43366,"_2384":43410},[],"Continuation requires a successful HTTP response and JSON:",{"_2857":823,"_25170":803,"_17548":43412,"_5":17443,"_23820":43366,"_2384":43413},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2857":824,"_25170":803,"_17548":43415,"_5":17443,"_23820":43370,"_2384":43416},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2857":825,"_25170":803,"_17548":43418,"_5":17443,"_23820":43370,"_2384":43419},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2857":826,"_25170":826,"_5":12294,"_2384":43421,"_25506":43422,"_17548":43423,"_23820":826},"Configure and operate the DMS",[40848,42192,43166,43164,43347],[],{"_2857":827,"_25170":826,"_17548":43425,"_5":17443,"_23820":826,"_2384":43426},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2857":828,"_25170":826,"_5":25503,"_17548":43428,"_23820":43429,"_2384":40858},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2857":829,"_25170":826,"_5":25503,"_17548":43431,"_23820":43432,"_2384":43433},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2857":830,"_25170":826,"_5":25503,"_17548":43435,"_23820":43436,"_2384":43437},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2857":831,"_25170":826,"_5":25503,"_17548":43439,"_23820":43440,"_2384":43441},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2857":832,"_25170":826,"_5":25503,"_17548":43443,"_23820":43444,"_2384":43445},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2857":833,"_25170":826,"_5":25503,"_17548":43447,"_23820":43448,"_2384":43449},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2857":834,"_25170":826,"_5":25503,"_17548":43451,"_23820":43452,"_2384":43453},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2857":835,"_25170":826,"_5":25503,"_17548":43455,"_23820":43456,"_2384":43457},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2857":836,"_25170":826,"_5":25503,"_17548":43459,"_23820":43460,"_2384":43461},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2857":837,"_25170":826,"_5":25503,"_17548":43463,"_23820":43464,"_2384":43465},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2857":838,"_25170":826,"_5":25503,"_17548":43467,"_23820":43468,"_2384":43469},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2857":839,"_25170":826,"_5":25503,"_17548":43471,"_23820":43472,"_2384":43473},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_2857":840,"_25170":826,"_5":25503,"_17548":43475,"_23820":43476,"_2384":43477},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2857":841,"_25170":826,"_5":25503,"_17548":43479,"_23820":43480,"_2384":43481},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2857":842,"_25170":826,"_5":25503,"_17548":43483,"_23820":43484,"_2384":43485},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2857":843,"_25170":826,"_5":25503,"_17548":43487,"_23820":43488,"_2384":43489},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2857":844,"_25170":826,"_5":25503,"_17548":43491,"_23820":43492,"_2384":43493},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2857":845,"_25170":826,"_5":25503,"_17548":43495,"_23820":43496,"_2384":43497},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2857":846,"_25170":826,"_17548":43499,"_5":17443,"_23820":826,"_2384":43500},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2857":847,"_25170":826,"_17548":43502,"_5":17443,"_23820":43429,"_2384":43503},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2857":848,"_25170":826,"_17548":43505,"_5":17443,"_23820":43429,"_2384":43506},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2857":849,"_25170":826,"_17548":43508,"_5":17443,"_23820":43436,"_2384":43509},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2857":850,"_25170":826,"_17548":43511,"_5":17443,"_23820":43440,"_2384":43512},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2857":851,"_25170":826,"_17548":43514,"_5":17443,"_23820":43444,"_2384":43515},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2857":852,"_25170":826,"_17548":43517,"_5":17443,"_23820":43448,"_2384":43518},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2857":853,"_25170":826,"_17548":43520,"_5":17443,"_23820":43452,"_2384":43521},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2857":854,"_25170":826,"_17548":43523,"_5":17443,"_23820":43460,"_2384":43524},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2857":855,"_25170":826,"_17548":43526,"_5":17443,"_23820":43460,"_2384":43527},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2857":856,"_25170":826,"_17548":43529,"_5":17443,"_23820":43464,"_2384":43530},[],"`settings.enrollment_settings` field",{"_2857":857,"_25170":826,"_17548":43532,"_5":17443,"_23820":43464,"_2384":43533},[],"Decision",{"_2857":858,"_25170":826,"_17548":43535,"_5":17443,"_23820":43464,"_2384":43536},[],"`protocol`",{"_2857":859,"_25170":826,"_17548":43538,"_5":17443,"_23820":43464,"_2384":43539},[],"`EST_RFC7030` for these operations.",{"_2857":860,"_25170":826,"_17548":43541,"_5":17443,"_23820":43464,"_2384":43542},[],"`enrollment_ca`",{"_2857":861,"_25170":826,"_17548":43544,"_5":17443,"_23820":43464,"_2384":43545},[],"ID of the signing CA.",{"_2857":862,"_25170":826,"_17548":43547,"_5":17443,"_23820":43464,"_2384":43548},[],"`verify_csr_signature`",{"_2857":863,"_25170":826,"_17548":43550,"_5":17443,"_23820":43464,"_2384":43551},[],"Keep `true` to verify CSR key possession.",{"_2857":864,"_25170":826,"_17548":43553,"_5":17443,"_23820":43464,"_2384":43554},[],"`enable_replaceable_enrollment`",{"_2857":865,"_25170":826,"_17548":43556,"_5":17443,"_23820":43464,"_2384":43557},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2857":866,"_25170":826,"_17548":43559,"_5":17443,"_23820":43464,"_2384":43560},[],"`est_rfc7030_settings.auth_mode`",{"_2857":867,"_25170":826,"_17548":43562,"_5":17443,"_23820":43464,"_2384":43563},[],"One of the four authentication modes.",{"_2857":868,"_25170":826,"_17548":43565,"_5":17443,"_23820":43464,"_2384":43566},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2857":869,"_25170":826,"_17548":43568,"_5":17443,"_23820":43468,"_2384":43569},[],"The blocks are independent:",{"_2857":870,"_25170":826,"_17548":43571,"_5":17443,"_23820":43468,"_2384":43572},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2857":871,"_25170":826,"_17548":43574,"_5":17443,"_23820":43468,"_2384":43575},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2857":872,"_25170":826,"_17548":43577,"_5":17443,"_23820":43468,"_2384":43578},[],"`auth_mode`",{"_2857":873,"_25170":826,"_17548":43580,"_5":17443,"_23820":43468,"_2384":43581},[],"Control applied in the configured operation",{"_2857":874,"_25170":826,"_17548":43583,"_5":17443,"_23820":43468,"_2384":43584},[],"`CLIENT_CERTIFICATE`",{"_2857":875,"_25170":826,"_17548":43586,"_5":17443,"_23820":43468,"_2384":43587},[],"Presented certificate validation.",{"_2857":876,"_25170":826,"_17548":43589,"_5":17443,"_23820":43468,"_2384":43590},[],"`EXTERNAL_WEBHOOK`",{"_2857":877,"_25170":826,"_17548":43592,"_5":17443,"_23820":43468,"_2384":43593},[],"Configured webhook authorization.",{"_2857":878,"_25170":826,"_17548":43595,"_5":17443,"_23820":43468,"_2384":43596},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2857":879,"_25170":826,"_17548":43598,"_5":17443,"_23820":43468,"_2384":43599},[],"Certificate validation followed by webhook approval.",{"_2857":880,"_25170":826,"_17548":43601,"_5":17443,"_23820":43468,"_2384":43602},[],"`NO_AUTH`",{"_2857":881,"_25170":826,"_17548":43604,"_5":17443,"_23820":43468,"_2384":43605},[],"No DMS requester authentication.",{"_2857":882,"_25170":826,"_17548":43607,"_5":17443,"_23820":43468,"_2384":43608},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2857":883,"_25170":826,"_17548":43610,"_5":17443,"_23820":43468,"_2384":43611},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2857":884,"_25170":826,"_17548":43613,"_5":17443,"_23820":43468,"_2384":43614},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs, and each settings block consults only its own `validation_cas` — copying the initial block's list does not extend re-enrollment acceptance. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_2857":885,"_25170":826,"_17548":43616,"_5":17443,"_23820":43468,"_2384":43617},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2857":886,"_25170":826,"_17548":43619,"_5":17443,"_23820":43472,"_2384":43620},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_2857":887,"_25170":826,"_17548":43622,"_5":17443,"_23820":43472,"_2384":43623},[],"`external_webhook_settings` field",{"_2857":888,"_25170":826,"_17548":43625,"_5":17443,"_23820":43472,"_2384":43533},[],{"_2857":889,"_25170":826,"_17548":43627,"_5":17443,"_23820":43472,"_2384":43628},[],"`url`",{"_2857":890,"_25170":826,"_17548":43630,"_5":17443,"_23820":43472,"_2384":43631},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_2857":891,"_25170":826,"_17548":43633,"_5":17443,"_23820":43472,"_2384":43634},[],"`method`",{"_2857":892,"_25170":826,"_17548":43636,"_5":17443,"_23820":43472,"_2384":43637},[],"`POST` or `PUT`; `POST` by default.",{"_2857":893,"_25170":826,"_17548":43639,"_5":17443,"_23820":43472,"_2384":43640},[],"`name`",{"_2857":894,"_25170":826,"_17548":43642,"_5":17443,"_23820":43472,"_2384":43643},[],"Label used in service logs.",{"_2857":895,"_25170":826,"_17548":43645,"_5":17443,"_23820":43472,"_2384":43646},[],"`config.auth_mode`",{"_2857":896,"_25170":826,"_17548":43648,"_5":17443,"_23820":43472,"_2384":43649},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_2857":897,"_25170":826,"_17548":43651,"_5":17443,"_23820":43472,"_2384":43652},[],"`config.apikey_options`",{"_2857":898,"_25170":826,"_17548":43654,"_5":17443,"_23820":43472,"_2384":43655},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_2857":899,"_25170":826,"_17548":43657,"_5":17443,"_23820":43472,"_2384":43658},[],"`config.jwt_options`",{"_2857":900,"_25170":826,"_17548":43660,"_5":17443,"_23820":43472,"_2384":43661},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2857":901,"_25170":826,"_17548":43663,"_5":17443,"_23820":43472,"_2384":43664},[],"`config.mtls_options`",{"_2857":902,"_25170":826,"_17548":43666,"_5":17443,"_23820":43472,"_2384":43667},[],"Required for `mtls`: `cert_content` and `key_content` as inline PEM.",{"_2857":903,"_25170":826,"_17548":43669,"_5":17443,"_23820":43472,"_2384":43670},[],"`config.insecure_skip_verify`",{"_2857":904,"_25170":826,"_17548":43672,"_5":17443,"_23820":43472,"_2384":43673},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_2857":905,"_25170":826,"_17548":43675,"_5":17443,"_23820":43472,"_2384":43676},[],"`config.call_timeout`",{"_2857":906,"_25170":826,"_17548":43678,"_5":17443,"_23820":43472,"_2384":43679},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_2857":907,"_25170":826,"_17548":43681,"_5":17443,"_23820":43472,"_2384":43682},[],"Rules for that configuration:",{"_2857":908,"_25170":826,"_17548":43684,"_5":17443,"_23820":43472,"_2384":43685},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so supply the PEM as `mtls_options.cert_content` and `key_content`.",{"_2857":909,"_25170":826,"_17548":43687,"_5":17443,"_23820":43472,"_2384":43688},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_2857":910,"_25170":826,"_17548":43690,"_5":17443,"_23820":43472,"_2384":43691},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_2857":911,"_25170":826,"_17548":43693,"_5":17443,"_23820":43472,"_2384":43694},[],"The API ignores the legacy fields `validate_server_cert`, `apikey`, `oidc` and `mtls`. A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` that still carries only the legacy option fields (`apikey`, `oidc`, `mtls`) fails validation with 400; only legacy `noauth` bodies are accepted, and their credentials are dropped.",{"_2857":912,"_25170":826,"_17548":43696,"_5":17443,"_23820":43472,"_2384":43697},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_2857":913,"_25170":826,"_17548":43699,"_5":17443,"_23820":43472,"_2384":43700},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_2857":914,"_25170":826,"_17548":43702,"_5":17443,"_23820":43472,"_2384":43703},[],"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks; if your version’s console does not expose independent settings, use the DMS API.",{"_2857":915,"_25170":826,"_17548":43705,"_5":17443,"_23820":43472,"_2384":43706},[],"Migration `20261021120000` rewrites every stored webhook config into this layout: `validate_server_cert` becomes the negated `insecure_skip_verify` (a config where `validate_server_cert` was false keeps skipping verification), `oidc` becomes `jwt_options`, `apikey` becomes `apikey_options` and `mtls` becomes `mtls_options`. When both the legacy certificate and key are PEM, they move into `mtls_options.cert_content` and `key_content` and need no action. Otherwise, including a mixed config (PEM certificate, file-path key), both values become `mtls_options.cert_file` and `key_file`. Delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are re-entered as PEM content, or the leftover file fields are removed if the webhook does not use mTLS. If your version's console does not expose those fields, edit the DMS through the DMS API.",{"_2857":916,"_25170":826,"_17548":43708,"_5":17443,"_23820":43472,"_2384":43709},[],"Migration `20261022120000` moves `reenrollment_settings.additional_validation_cas` into `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, replacing whatever the nested key held. That nested value was never consulted when validating re-enrollments, so the effective trust set is unchanged; a missing or null flat list becomes an empty list. DMSs without `reenrollment_settings` are untouched. Bodies that still carry `additional_validation_cas` are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses no longer include it. Read the DMS before sending API edits: an update body built from the old layout silently empties the migrated list.",{"_2857":917,"_25170":826,"_17548":43711,"_5":17443,"_23820":43476,"_2384":43712},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2857":918,"_25170":826,"_17548":43714,"_5":17443,"_23820":43480,"_2384":43715},[],"`settings.reenrollment_settings` field",{"_2857":919,"_25170":826,"_17548":43717,"_5":17443,"_23820":43480,"_2384":41231},[],{"_2857":920,"_25170":826,"_17548":43719,"_5":17443,"_23820":43480,"_2384":43720},[],"`reenrollment_delta`",{"_2857":921,"_25170":826,"_17548":43722,"_5":17443,"_23820":43480,"_2384":43723},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2857":922,"_25170":826,"_17548":43725,"_5":17443,"_23820":43480,"_2384":43726},[],"`preventive_delta`",{"_2857":923,"_25170":826,"_17548":43728,"_5":17443,"_23820":43480,"_2384":43729},[],"Preventive operational monitoring threshold.",{"_2857":924,"_25170":826,"_17548":43731,"_5":17443,"_23820":43480,"_2384":43732},[],"`critical_delta`",{"_2857":925,"_25170":826,"_17548":43734,"_5":17443,"_23820":43480,"_2384":43735},[],"Critical operational monitoring threshold.",{"_2857":926,"_25170":826,"_17548":43737,"_5":17443,"_23820":43480,"_2384":43738},[],"`enable_expired_renewal`",{"_2857":927,"_25170":826,"_17548":43740,"_5":17443,"_23820":43480,"_2384":43741},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2857":928,"_25170":826,"_17548":43743,"_5":17443,"_23820":43480,"_2384":43744},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_2857":929,"_25170":826,"_17548":43746,"_5":17443,"_23820":43480,"_2384":43747},[],"Additional validation CAs for the renewal mTLS credential, tried after the enrollment CA; typically populated during CA rotation while old-CA cohorts renew.",{"_2857":930,"_25170":826,"_17548":43749,"_5":17443,"_23820":43480,"_2384":43750},[],"`revoke_on_reenrollment`",{"_2857":931,"_25170":826,"_17548":43752,"_5":17443,"_23820":43480,"_2384":43753},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2857":932,"_25170":826,"_17548":43755,"_5":17443,"_23820":43480,"_2384":43756},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2857":933,"_25170":826,"_17548":43758,"_5":17443,"_23820":43484,"_2384":43759},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2857":934,"_25170":826,"_17548":43761,"_5":17443,"_23820":43488,"_2384":41225},[],{"_2857":935,"_25170":826,"_17548":43763,"_5":17443,"_23820":43488,"_2384":43764},[],"Published material",{"_2857":936,"_25170":826,"_17548":43766,"_5":17443,"_23820":43488,"_2384":43767},[],"**Include Lamassu System CA**",{"_2857":937,"_25170":826,"_17548":43769,"_5":17443,"_23820":43488,"_2384":43770},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2857":938,"_25170":826,"_17548":43772,"_5":17443,"_23820":43488,"_2384":43773},[],"**Include Enrollment CA**",{"_2857":939,"_25170":826,"_17548":43775,"_5":17443,"_23820":43488,"_2384":43776},[],"Selected issuing CA certificate.",{"_2857":940,"_25170":826,"_17548":43778,"_5":17443,"_23820":43488,"_2384":43779},[],"**Managed CAs**",{"_2857":941,"_25170":826,"_17548":43781,"_5":17443,"_23820":43488,"_2384":43782},[],"Explicitly selected CA certificates.",{"_2857":942,"_25170":826,"_17548":43784,"_5":17443,"_23820":43488,"_2384":43785},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2857":943,"_25170":826,"_17548":43787,"_5":17443,"_23820":43492,"_2384":43788},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2857":944,"_25170":826,"_17548":43790,"_5":17443,"_23820":43492,"_2384":43791},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2857":945,"_25170":826,"_17548":43793,"_5":17443,"_23820":43492,"_2384":43794},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2857":946,"_25170":826,"_17548":43796,"_5":17443,"_23820":43496,"_2384":43797},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2857":947,"_25170":947,"_5":12294,"_2384":43799,"_25506":43800,"_17548":43801,"_23820":947},"Integrate the EST client",[40848,42192,43166,43164,43347],[],{"_2857":948,"_25170":947,"_17548":43803,"_5":17443,"_23820":947,"_2384":43804},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2857":949,"_25170":947,"_5":25503,"_17548":43806,"_23820":43807,"_2384":40858},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2857":950,"_25170":947,"_5":25503,"_17548":43809,"_23820":43810,"_2384":43811},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2857":951,"_25170":947,"_5":25503,"_17548":43813,"_23820":43814,"_2384":43815},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2857":952,"_25170":947,"_5":25503,"_17548":43817,"_23820":43818,"_2384":43819},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2857":953,"_25170":947,"_5":25503,"_17548":43821,"_23820":43822,"_2384":43823},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2857":954,"_25170":947,"_5":25503,"_17548":43825,"_23820":43826,"_2384":43827},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2857":955,"_25170":947,"_17548":43829,"_5":17443,"_23820":947,"_2384":43830},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2857":956,"_25170":947,"_17548":43832,"_5":17443,"_23820":43807,"_2384":43833},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2857":957,"_25170":947,"_17548":43835,"_5":17443,"_23820":43807,"_2384":43836},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2857":958,"_25170":947,"_17548":43838,"_5":17443,"_23820":43807,"_2384":43839},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2857":959,"_25170":947,"_17548":43841,"_5":17443,"_23820":43810,"_2384":43842},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2857":960,"_25170":947,"_17548":43844,"_5":17443,"_23820":43810,"_2384":43845},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2857":961,"_25170":947,"_17548":43847,"_5":17443,"_23820":43814,"_2384":43848},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2857":962,"_25170":947,"_17548":43850,"_5":17443,"_23820":43814,"_2384":43851},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2857":963,"_25170":947,"_17548":43853,"_5":17443,"_23820":43818,"_2384":43854},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2857":964,"_25170":947,"_17548":43856,"_5":17443,"_23820":43818,"_2384":43857},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2857":965,"_25170":947,"_17548":43859,"_5":17443,"_23820":43822,"_2384":43860},[],"For a root that issues directly:",{"_2857":966,"_25170":947,"_17548":43862,"_5":17443,"_23820":43822,"_2384":43863},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2857":967,"_25170":947,"_17548":43865,"_5":17443,"_23820":43822,"_2384":43866},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2857":968,"_25170":947,"_17548":43868,"_5":17443,"_23820":43826,"_2384":43869},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2857":969,"_25170":969,"_5":12294,"_2384":43871,"_25506":43872,"_17548":43873,"_23820":969},"EST reference",[40848,42192,43166,43164,43347],[],{"_2857":970,"_25170":969,"_17548":43875,"_5":17443,"_23820":969,"_2384":43876},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2857":971,"_25170":969,"_5":25503,"_17548":43878,"_23820":43879,"_2384":43880},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2857":972,"_25170":969,"_5":25503,"_17548":43882,"_23820":43883,"_2384":19066},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2857":973,"_25170":969,"_5":25503,"_17548":43885,"_23820":43886,"_2384":21842},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2857":974,"_25170":969,"_5":25503,"_17548":43888,"_23820":43889,"_2384":21849},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2857":975,"_25170":969,"_5":25503,"_17548":43891,"_23820":43892,"_2384":21219},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2857":976,"_25170":969,"_5":25503,"_17548":43894,"_23820":43895,"_2384":43896},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2857":977,"_25170":969,"_5":25503,"_17548":43898,"_23820":43899,"_2384":43900},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2857":978,"_25170":969,"_5":25503,"_17548":43902,"_23820":43903,"_2384":43904},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2857":979,"_25170":969,"_17548":43906,"_5":17443,"_23820":969,"_2384":43907},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2857":980,"_25170":969,"_17548":43909,"_5":17443,"_23820":43879,"_2384":43910},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2857":981,"_25170":969,"_17548":43912,"_5":17443,"_23820":43879,"_2384":43913},[],"Operation",{"_2857":982,"_25170":969,"_17548":43915,"_5":17443,"_23820":43879,"_2384":43916},[],"Method",{"_2857":983,"_25170":969,"_17548":43918,"_5":17443,"_23820":43879,"_2384":43919},[],"Authentication and condition",{"_2857":984,"_25170":969,"_17548":43921,"_5":17443,"_23820":43879,"_2384":43922},[],"`/cacerts`",{"_2857":985,"_25170":969,"_17548":43924,"_5":17443,"_23820":43879,"_2384":43925},[],"GET",{"_2857":986,"_25170":969,"_17548":43927,"_5":17443,"_23820":43879,"_2384":43928},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2857":987,"_25170":969,"_17548":43930,"_5":17443,"_23820":43879,"_2384":43931},[],"`/simpleenroll`",{"_2857":988,"_25170":969,"_17548":43933,"_5":17443,"_23820":43879,"_2384":43934},[],"POST",{"_2857":989,"_25170":969,"_17548":43936,"_5":17443,"_23820":43879,"_2384":43937},[],"Initial authentication and DMS registration/replacement policy.",{"_2857":990,"_25170":969,"_17548":43939,"_5":17443,"_23820":43879,"_2384":43940},[],"`/simplereenroll`",{"_2857":991,"_25170":969,"_17548":43942,"_5":17443,"_23820":43879,"_2384":43934},[],{"_2857":992,"_25170":969,"_17548":43944,"_5":17443,"_23820":43879,"_2384":43945},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2857":993,"_25170":969,"_17548":43947,"_5":17443,"_23820":43879,"_2384":43948},[],"`/serverkeygen`",{"_2857":994,"_25170":969,"_17548":43950,"_5":17443,"_23820":43879,"_2384":43934},[],{"_2857":995,"_25170":969,"_17548":43952,"_5":17443,"_23820":43879,"_2384":43953},[],"Initial authentication and admission; server generation enabled.",{"_2857":996,"_25170":969,"_17548":43955,"_5":17443,"_23820":43879,"_2384":43956},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2857":997,"_25170":969,"_17548":43958,"_5":17443,"_23820":43883,"_2384":43959},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2857":998,"_25170":969,"_17548":43961,"_5":17443,"_23820":43883,"_2384":43962},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2857":999,"_25170":969,"_17548":43964,"_5":17443,"_23820":43886,"_2384":43965},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2857":1000,"_25170":969,"_17548":43967,"_5":17443,"_23820":43886,"_2384":43968},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2857":1001,"_25170":969,"_17548":43970,"_5":17443,"_23820":43889,"_2384":43971},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2857":1002,"_25170":969,"_17548":43973,"_5":17443,"_23820":43889,"_2384":43974},[],"The enrollment CA or a validation CA configured in the re-enrollment block validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2857":1003,"_25170":969,"_17548":43976,"_5":17443,"_23820":43892,"_2384":43977},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2857":1004,"_25170":969,"_17548":43979,"_5":17443,"_23820":43892,"_2384":43980},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2857":1005,"_25170":969,"_17548":43982,"_5":17443,"_23820":43895,"_2384":43983},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2857":1006,"_25170":969,"_17548":43985,"_5":17443,"_23820":43895,"_2384":43986},[],"Part",{"_2857":1007,"_25170":969,"_17548":43988,"_5":17443,"_23820":43895,"_2384":43989},[],"Content after decoding its Base64",{"_2857":1008,"_25170":969,"_17548":43991,"_5":17443,"_23820":43895,"_2384":43992},[],"`application/pkcs8`",{"_2857":1009,"_25170":969,"_17548":43994,"_5":17443,"_23820":43895,"_2384":43995},[],"Unencrypted DER PKCS#8 private key.",{"_2857":1010,"_25170":969,"_17548":43997,"_5":17443,"_23820":43895,"_2384":43998},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2857":1011,"_25170":969,"_17548":44000,"_5":17443,"_23820":43895,"_2384":44001},[],"DER PKCS#7 containing the issued certificate.",{"_2857":1012,"_25170":969,"_17548":44003,"_5":17443,"_23820":43895,"_2384":44004},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2857":1013,"_25170":969,"_17548":44006,"_5":17443,"_23820":43899,"_2384":44007},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2857":1014,"_25170":969,"_17548":44009,"_5":17443,"_23820":43899,"_2384":44010},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2857":1015,"_25170":969,"_17548":44012,"_5":17443,"_23820":43899,"_2384":44013},[],"Convert and check the result:",{"_2857":1016,"_25170":969,"_17548":44015,"_5":17443,"_23820":43899,"_2384":44016},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2857":1017,"_25170":969,"_17548":44018,"_5":17443,"_23820":43903,"_2384":44019},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2857":1018,"_25170":969,"_17548":44021,"_5":17443,"_23820":43903,"_2384":44022},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2857":1019,"_25170":1019,"_5":12294,"_2384":43347,"_25506":44024,"_17548":44025,"_23820":1019},[40848,42192,43166,43164,43347],[],{"_2857":1020,"_25170":1019,"_17548":44027,"_5":17443,"_23820":1019,"_2384":44028},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2857":1021,"_25170":1019,"_5":25503,"_17548":44030,"_23820":44031,"_2384":44032},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2857":1022,"_25170":1019,"_5":25503,"_17548":44034,"_23820":44035,"_2384":44036},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2857":1023,"_25170":1019,"_5":25503,"_17548":44038,"_23820":44039,"_2384":44040},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2857":1024,"_25170":1019,"_5":25503,"_17548":44042,"_23820":44043,"_2384":44044},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2857":1025,"_25170":1019,"_17548":44046,"_5":17443,"_23820":1019,"_2384":44047},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2857":1026,"_25170":1019,"_17548":44049,"_5":17443,"_23820":44031,"_2384":44050},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2857":1027,"_25170":1019,"_17548":44052,"_5":17443,"_23820":44031,"_2384":44053},[],"The integrator installs initial EST server trust and an admission credential.",{"_2857":1028,"_25170":1019,"_17548":44055,"_5":17443,"_23820":44031,"_2384":44056},[],"The client requests an identity for its `Device ID` through EST.",{"_2857":1029,"_25170":1019,"_17548":44058,"_5":17443,"_23820":44031,"_2384":44059},[],"Certificate, device binding and key/certificate installation are checked.",{"_2857":1030,"_25170":1019,"_17548":44061,"_5":17443,"_23820":44031,"_2384":44062},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2857":1031,"_25170":1019,"_17548":44064,"_5":17443,"_23820":44031,"_2384":44065},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2857":1032,"_25170":1019,"_17548":44067,"_5":17443,"_23820":44035,"_2384":44068},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2857":1033,"_25170":1019,"_17548":44070,"_5":17443,"_23820":44035,"_2384":44071},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":1034,"_25170":1019,"_17548":44073,"_5":17443,"_23820":44035,"_2384":44074},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2857":1035,"_25170":1019,"_17548":44076,"_5":17443,"_23820":44035,"_2384":44077},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2857":1036,"_25170":1019,"_17548":44079,"_5":17443,"_23820":44039,"_2384":44080},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2857":1037,"_25170":1019,"_17548":44082,"_5":17443,"_23820":44039,"_2384":44083},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2857":1038,"_25170":1019,"_17548":44085,"_5":17443,"_23820":44039,"_2384":44086},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2857":1039,"_25170":1019,"_17548":44088,"_5":17443,"_23820":44039,"_2384":44089},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2857":1040,"_25170":1019,"_17548":44091,"_5":17443,"_23820":44043,"_2384":44092},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract and migrations, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2857":1041,"_25170":1019,"_17548":44094,"_5":17443,"_23820":44043,"_2384":44095},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2857":1042,"_25170":1042,"_5":12294,"_2384":44097,"_25506":44098,"_17548":44099,"_23820":1042},"Provisioning strategies",[40848,42192,43166,43164,43347],[],{"_2857":1043,"_25170":1042,"_17548":44101,"_5":17443,"_23820":1042,"_2384":44102},[],"Choose device registration, identity authorization and key generation.",{"_2857":1044,"_25170":1042,"_5":25503,"_17548":44104,"_23820":44105,"_2384":44106},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2857":1045,"_25170":1042,"_5":25503,"_17548":44108,"_23820":44109,"_2384":44110},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2857":1046,"_25170":1042,"_5":25503,"_17548":44112,"_23820":44113,"_2384":44114},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2857":1047,"_25170":1042,"_5":25503,"_17548":44116,"_23820":44117,"_2384":44118},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2857":1048,"_25170":1042,"_5":25503,"_17548":44120,"_23820":44121,"_2384":44122},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2857":1049,"_25170":1042,"_17548":44124,"_5":17443,"_23820":1042,"_2384":44125},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2857":1050,"_25170":1042,"_17548":44127,"_5":17443,"_23820":44105,"_2384":44128},[],"Path",{"_2857":1051,"_25170":1042,"_17548":44130,"_5":17443,"_23820":44105,"_2384":44131},[],"When the device exists",{"_2857":1052,"_25170":1042,"_17548":44133,"_5":17443,"_23820":44105,"_2384":44134},[],"What to check",{"_2857":1053,"_25170":1042,"_17548":44136,"_5":17443,"_23820":44105,"_2384":44137},[],"Manual assignment",{"_2857":1054,"_25170":1042,"_17548":44139,"_5":17443,"_23820":44105,"_2384":44140},[],"An operator creates it before associating a certificate.",{"_2857":1055,"_25170":1042,"_17548":44142,"_5":17443,"_23820":44105,"_2384":44143},[],"ID, owning DMS, certificate CN and bound serial.",{"_2857":1056,"_25170":1042,"_17548":44145,"_5":17443,"_23820":44105,"_2384":44146},[],"EST with `JITP`",{"_2857":1057,"_25170":1042,"_17548":44148,"_5":17443,"_23820":44105,"_2384":44149},[],"Created for an unknown CN during `/simpleenroll`.",{"_2857":1058,"_25170":1042,"_17548":44151,"_5":17443,"_23820":44105,"_2384":44152},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2857":1059,"_25170":1042,"_17548":44154,"_5":17443,"_23820":44105,"_2384":44155},[],"EST with `PRE_REGISTRATION`",{"_2857":1060,"_25170":1042,"_17548":44157,"_5":17443,"_23820":44105,"_2384":44158},[],"Must exist before `/simpleenroll`.",{"_2857":1061,"_25170":1042,"_17548":44160,"_5":17443,"_23820":44105,"_2384":44161},[],"Approved record, same DMS and replacement conditions for your version.",{"_2857":1062,"_25170":1042,"_17548":44163,"_5":17443,"_23820":44105,"_2384":44164},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2857":1063,"_25170":1042,"_17548":44166,"_5":17443,"_23820":44105,"_2384":44167},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2857":1064,"_25170":1042,"_17548":44169,"_5":17443,"_23820":44109,"_2384":44170},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2857":1065,"_25170":1042,"_17548":44172,"_5":17443,"_23820":44109,"_2384":44173},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2857":1066,"_25170":1042,"_17548":44175,"_5":17443,"_23820":44109,"_2384":44176},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2857":1067,"_25170":1042,"_17548":44178,"_5":17443,"_23820":44113,"_2384":44179},[],"Decide initial enrollment and re-enrollment separately:",{"_2857":1068,"_25170":1042,"_17548":44181,"_5":17443,"_23820":44113,"_2384":44182},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2857":1069,"_25170":1042,"_17548":44184,"_5":17443,"_23820":44113,"_2384":44185},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2857":1070,"_25170":1042,"_17548":44187,"_5":17443,"_23820":44113,"_2384":44188},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2857":1071,"_25170":1042,"_17548":44190,"_5":17443,"_23820":44113,"_2384":44191},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2857":1072,"_25170":1042,"_17548":44193,"_5":17443,"_23820":44113,"_2384":44194},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2857":1073,"_25170":1042,"_17548":44196,"_5":17443,"_23820":44117,"_2384":41225},[],{"_2857":1074,"_25170":1042,"_17548":44198,"_5":17443,"_23820":44117,"_2384":44199},[],"Material crossing EST",{"_2857":1075,"_25170":1042,"_17548":44201,"_5":17443,"_23820":44117,"_2384":44202},[],"Device-generated key",{"_2857":1076,"_25170":1042,"_17548":44204,"_5":17443,"_23820":44117,"_2384":44205},[],"Public CSR and certificate; the key stays on the client.",{"_2857":1077,"_25170":1042,"_17548":44207,"_5":17443,"_23820":44117,"_2384":44208},[],"Existing device key",{"_2857":1078,"_25170":1042,"_17548":44210,"_5":17443,"_23820":44117,"_2384":44211},[],"CSR signed with that key and a new certificate.",{"_2857":1079,"_25170":1042,"_17548":44213,"_5":17443,"_23820":44117,"_2384":43485},[],{"_2857":1080,"_25170":1042,"_17548":44215,"_5":17443,"_23820":44117,"_2384":44216},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2857":1081,"_25170":1042,"_17548":44218,"_5":17443,"_23820":44117,"_2384":44219},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2857":1082,"_25170":1042,"_17548":44221,"_5":17443,"_23820":44121,"_2384":44222},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2857":1083,"_25170":1083,"_5":12294,"_2384":44224,"_25506":44225,"_17548":44226,"_23820":1083},"Renewal and recovery",[40848,42192,43166,43164,43347],[],{"_2857":1084,"_25170":1083,"_17548":44228,"_5":17443,"_23820":1083,"_2384":44229},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2857":1085,"_25170":1083,"_5":25503,"_17548":44231,"_23820":44232,"_2384":44233},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2857":1086,"_25170":1083,"_5":25503,"_17548":44235,"_23820":44236,"_2384":44237},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2857":1087,"_25170":1083,"_5":25503,"_17548":44239,"_23820":44240,"_2384":44241},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2857":1088,"_25170":1083,"_5":25503,"_17548":44243,"_23820":44244,"_2384":44245},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2857":1089,"_25170":1083,"_5":25503,"_17548":44247,"_23820":44248,"_2384":44249},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2857":1090,"_25170":1083,"_17548":44251,"_5":17443,"_23820":1083,"_2384":44252},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2857":1091,"_25170":1083,"_17548":44254,"_5":17443,"_23820":44232,"_2384":44255},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2857":1092,"_25170":1083,"_17548":44257,"_5":17443,"_23820":44232,"_2384":44258},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2857":1093,"_25170":1083,"_17548":44260,"_5":17443,"_23820":44232,"_2384":44261},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2857":1094,"_25170":1083,"_17548":44263,"_5":17443,"_23820":44232,"_2384":44264},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2857":1095,"_25170":1083,"_17548":44266,"_5":17443,"_23820":44236,"_2384":44267},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2857":1096,"_25170":1083,"_17548":44269,"_5":17443,"_23820":44236,"_2384":44270},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2857":1097,"_25170":1083,"_17548":44272,"_5":17443,"_23820":44240,"_2384":44273},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2857":1098,"_25170":1083,"_17548":44275,"_5":17443,"_23820":44240,"_2384":44276},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2857":1099,"_25170":1083,"_17548":44278,"_5":17443,"_23820":44240,"_2384":44279},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2857":1100,"_25170":1083,"_17548":44281,"_5":17443,"_23820":44244,"_2384":44282},[],"Situation",{"_2857":1101,"_25170":1083,"_17548":44284,"_5":17443,"_23820":44244,"_2384":44285},[],"Procedure",{"_2857":1102,"_25170":1083,"_17548":44287,"_5":17443,"_23820":44244,"_2384":44288},[],"Valid certificate, outside the window",{"_2857":1103,"_25170":1083,"_17548":44290,"_5":17443,"_23820":44244,"_2384":44291},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2857":1104,"_25170":1083,"_17548":44293,"_5":17443,"_23820":44244,"_2384":44294},[],"Expired certificate, key available",{"_2857":1105,"_25170":1083,"_17548":44296,"_5":17443,"_23820":44244,"_2384":44297},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2857":1106,"_25170":1083,"_17548":44299,"_5":17443,"_23820":44244,"_2384":44300},[],"Renewal through webhook or `NO_AUTH`",{"_2857":1107,"_25170":1083,"_17548":44302,"_5":17443,"_23820":44244,"_2384":44303},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2857":1108,"_25170":1083,"_17548":44305,"_5":17443,"_23820":44244,"_2384":44306},[],"Lost or inaccessible key",{"_2857":1109,"_25170":1083,"_17548":44308,"_5":17443,"_23820":44244,"_2384":44309},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2857":1110,"_25170":1083,"_17548":44311,"_5":17443,"_23820":44244,"_2384":44312},[],"Current identity revoked",{"_2857":1111,"_25170":1083,"_17548":44314,"_5":17443,"_23820":44244,"_2384":44315},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2857":1112,"_25170":1083,"_17548":44317,"_5":17443,"_23820":44244,"_2384":44318},[],"Device without an identity",{"_2857":1113,"_25170":1083,"_17548":44320,"_5":17443,"_23820":44244,"_2384":44321},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2857":1114,"_25170":1083,"_17548":44323,"_5":17443,"_23820":44244,"_2384":44324},[],"Retired device",{"_2857":1115,"_25170":1083,"_17548":44326,"_5":17443,"_23820":44244,"_2384":44327},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2857":1116,"_25170":1083,"_17548":44329,"_5":17443,"_23820":44244,"_2384":44330},[],"Timeout, HTTP 500 or installation failure",{"_2857":1117,"_25170":1083,"_17548":44332,"_5":17443,"_23820":44244,"_2384":44333},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2857":1118,"_25170":1083,"_17548":44335,"_5":17443,"_23820":44248,"_2384":44336},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2857":1119,"_25170":1083,"_17548":44338,"_5":17443,"_23820":44248,"_2384":44339},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2857":1120,"_25170":1120,"_5":12294,"_2384":44341,"_25506":44342,"_17548":44343,"_23820":1120},"Enrollment troubleshooting",[40848,42192,43166,43164,43347],[],{"_2857":1121,"_25170":1120,"_17548":44345,"_5":17443,"_23820":1120,"_2384":44346},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2857":1122,"_25170":1120,"_5":25503,"_17548":44348,"_23820":44349,"_2384":44350},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2857":1123,"_25170":1120,"_5":25503,"_17548":44352,"_23820":44353,"_2384":44354},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2857":1124,"_25170":1120,"_5":25503,"_17548":44356,"_23820":44357,"_2384":43904},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2857":1125,"_25170":1120,"_5":25503,"_17548":44359,"_23820":44360,"_2384":44361},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2857":1126,"_25170":1120,"_17548":44363,"_5":17443,"_23820":1120,"_2384":44364},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2857":1127,"_25170":1120,"_17548":44366,"_5":17443,"_23820":44353,"_2384":44367},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2857":1128,"_25170":1120,"_17548":44369,"_5":17443,"_23820":44353,"_2384":44370},[],"Symptom or message",{"_2857":1129,"_25170":1120,"_17548":44372,"_5":17443,"_23820":44353,"_2384":44134},[],{"_2857":1130,"_25170":1120,"_17548":44374,"_5":17443,"_23820":44353,"_2384":44375},[],"curl rejects TLS, name or issuer",{"_2857":1131,"_25170":1120,"_17548":44377,"_5":17443,"_23820":44353,"_2384":44378},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2857":1132,"_25170":1120,"_17548":44380,"_5":17443,"_23820":44353,"_2384":44381},[],"404 or missing APS",{"_2857":1133,"_25170":1120,"_17548":44383,"_5":17443,"_23820":44353,"_2384":44384},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2857":1134,"_25170":1120,"_17548":44386,"_5":17443,"_23820":44353,"_2384":44387},[],"400, CSR or format error",{"_2857":1135,"_25170":1120,"_17548":44389,"_5":17443,"_23820":44353,"_2384":44390},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2857":1136,"_25170":1120,"_17548":44392,"_5":17443,"_23820":44353,"_2384":44393},[],"Missing credential or invalid certificate",{"_2857":1137,"_25170":1120,"_17548":44395,"_5":17443,"_23820":44353,"_2384":44396},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2857":1138,"_25170":1120,"_17548":44398,"_5":17443,"_23820":44353,"_2384":44399},[],"Webhook denies, times out or responds without authorization",{"_2857":1139,"_25170":1120,"_17548":44401,"_5":17443,"_23820":44353,"_2384":44402},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2857":1140,"_25170":1120,"_17548":44404,"_5":17443,"_23820":44353,"_2384":44405},[],"`unexpected status code: <n>: redirects are not followed`",{"_2857":1141,"_25170":1120,"_17548":44407,"_5":17443,"_23820":44353,"_2384":44408},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_2857":1142,"_25170":1120,"_17548":44410,"_5":17443,"_23820":44353,"_2384":44411},[],"`webhook response exceeds 1048576 bytes`",{"_2857":1143,"_25170":1120,"_17548":44413,"_5":17443,"_23820":44353,"_2384":44414},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_2857":1144,"_25170":1120,"_17548":44416,"_5":17443,"_23820":44353,"_2384":44417},[],"`webhook config must not reference files`",{"_2857":1145,"_25170":1120,"_17548":44419,"_5":17443,"_23820":44353,"_2384":44420},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the PEM as `cert_content` and `key_content`; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the upgrade note in DMS.",{"_2857":1146,"_25170":1120,"_17548":44422,"_5":17443,"_23820":44353,"_2384":44423},[],"400 `struct validation error` creating or updating a DMS",{"_2857":1147,"_25170":1120,"_17548":44425,"_5":17443,"_23820":44353,"_2384":44426},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_2857":1148,"_25170":1120,"_17548":44428,"_5":17443,"_23820":44353,"_2384":44429},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_2857":1149,"_25170":1120,"_17548":44431,"_5":17443,"_23820":44353,"_2384":44432},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_2857":1150,"_25170":1120,"_17548":44434,"_5":17443,"_23820":44353,"_2384":44435},[],"`device not preregistered`",{"_2857":1151,"_25170":1120,"_17548":44437,"_5":17443,"_23820":44353,"_2384":44438},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2857":1152,"_25170":1120,"_17548":44440,"_5":17443,"_23820":44353,"_2384":44441},[],"`forbiddenNewEnrollment`",{"_2857":1153,"_25170":1120,"_17548":44443,"_5":17443,"_23820":44353,"_2384":44444},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2857":1154,"_25170":1120,"_17548":44446,"_5":17443,"_23820":44353,"_2384":44447},[],"Different owning DMS",{"_2857":1155,"_25170":1120,"_17548":44449,"_5":17443,"_23820":44353,"_2384":44450},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2857":1156,"_25170":1120,"_17548":44452,"_5":17443,"_23820":44353,"_2384":44453},[],"`invalid RawSubject bytes`",{"_2857":1157,"_25170":1120,"_17548":44455,"_5":17443,"_23820":44353,"_2384":44456},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2857":1158,"_25170":1120,"_17548":44458,"_5":17443,"_23820":44353,"_2384":44459},[],"`invalid reenroll window`",{"_2857":1159,"_25170":1120,"_17548":44461,"_5":17443,"_23820":44353,"_2384":44462},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2857":1160,"_25170":1120,"_17548":44464,"_5":17443,"_23820":44353,"_2384":44465},[],"Current certificate revoked",{"_2857":1161,"_25170":1120,"_17548":44467,"_5":17443,"_23820":44353,"_2384":44468},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2857":1162,"_25170":1120,"_17548":44470,"_5":17443,"_23820":44353,"_2384":44471},[],"CA, profile or signing error",{"_2857":1163,"_25170":1120,"_17548":44473,"_5":17443,"_23820":44353,"_2384":44474},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2857":1164,"_25170":1120,"_17548":44476,"_5":17443,"_23820":44353,"_2384":44477},[],"HTTP 200 without a device connection",{"_2857":1165,"_25170":1120,"_17548":44479,"_5":17443,"_23820":44353,"_2384":44480},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2857":1166,"_25170":1120,"_17548":44482,"_5":17443,"_23820":44353,"_2384":44483},[],"Timeout or error after issuance",{"_2857":1167,"_25170":1120,"_17548":44485,"_5":17443,"_23820":44353,"_2384":44486},[],"New certificates, current slot and previous identity's state before retrying.",{"_2857":1168,"_25170":1120,"_17548":44488,"_5":17443,"_23820":44357,"_2384":44489},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode after migration and Gateway behavior with expired certificates and the bootstrap CA.",{"_2857":1169,"_25170":1120,"_17548":44491,"_5":17443,"_23820":44357,"_2384":44492},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2857":1170,"_25170":1120,"_17548":44494,"_5":17443,"_23820":44360,"_2384":44495},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2857":1171,"_25170":1120,"_17548":44497,"_5":17443,"_23820":44360,"_2384":44498},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2857":1172,"_25170":1120,"_17548":44500,"_5":17443,"_23820":44360,"_2384":44501},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2857":1173,"_25170":1120,"_17548":44503,"_5":17443,"_23820":44360,"_2384":44504},[],"Make one request, save headers/body and query the device and certificates.",{"_2857":1174,"_25170":1120,"_17548":44506,"_5":17443,"_23820":44360,"_2384":44507},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2857":1175,"_25170":1120,"_17548":44509,"_5":17443,"_23820":44360,"_2384":44510},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2857":1176,"_25170":1120,"_17548":44512,"_5":17443,"_23820":44360,"_2384":44513},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2857":1177,"_25170":1177,"_5":12294,"_2384":44515,"_25506":44516,"_17548":44517,"_23820":1177},"Trust distribution and updates",[40848,42192,43166,43164,43347],[],{"_2857":1178,"_25170":1177,"_17548":44519,"_5":17443,"_23820":1177,"_2384":44520},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2857":1179,"_25170":1177,"_5":25503,"_17548":44522,"_23820":44523,"_2384":44524},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2857":1180,"_25170":1177,"_5":25503,"_17548":44526,"_23820":44527,"_2384":44528},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2857":1181,"_25170":1177,"_5":25503,"_17548":44530,"_23820":44531,"_2384":44532},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2857":1182,"_25170":1177,"_5":25503,"_17548":44534,"_23820":44535,"_2384":44536},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2857":1183,"_25170":1177,"_5":25503,"_17548":44538,"_23820":44539,"_2384":44540},[],"/docs/pr-preview/pr-38/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2857":1184,"_25170":1177,"_17548":44542,"_5":17443,"_23820":1177,"_2384":44543},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2857":1185,"_25170":1177,"_17548":44545,"_5":17443,"_23820":44523,"_2384":44546},[],"Relationship",{"_2857":1186,"_25170":1177,"_17548":44548,"_5":17443,"_23820":44523,"_2384":44549},[],"Material prepared by its owner",{"_2857":1187,"_25170":1177,"_17548":44551,"_5":17443,"_23820":44523,"_2384":44552},[],"Device → EST server",{"_2857":1188,"_25170":1177,"_17548":44554,"_5":17443,"_23820":44523,"_2384":44555},[],"Previously verified server root, chain or pin and TLS name.",{"_2857":1189,"_25170":1177,"_17548":44557,"_5":17443,"_23820":44523,"_2384":44558},[],"DMS → requester",{"_2857":1190,"_25170":1177,"_17548":44560,"_5":17443,"_23820":44523,"_2384":44561},[],"CAs and rules authorizing initial or renewal credentials.",{"_2857":1191,"_25170":1177,"_17548":44563,"_5":17443,"_23820":44523,"_2384":44564},[],"Consumer → device",{"_2857":1192,"_25170":1177,"_17548":44566,"_5":17443,"_23820":44523,"_2384":44567},[],"Operational identity roots, intermediates, validation and permissions.",{"_2857":1193,"_25170":1177,"_17548":44569,"_5":17443,"_23820":44523,"_2384":44570},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2857":1194,"_25170":1177,"_17548":44572,"_5":17443,"_23820":44527,"_2384":44573},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2857":1195,"_25170":1177,"_17548":44575,"_5":17443,"_23820":44527,"_2384":44576},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2857":1196,"_25170":1177,"_17548":44578,"_5":17443,"_23820":44531,"_2384":44579},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2857":1197,"_25170":1177,"_17548":44581,"_5":17443,"_23820":44531,"_2384":44582},[],"Select policy-approved roots as anchors.",{"_2857":1198,"_25170":1177,"_17548":44584,"_5":17443,"_23820":44531,"_2384":44585},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2857":1199,"_25170":1177,"_17548":44587,"_5":17443,"_23820":44531,"_2384":44588},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2857":1200,"_25170":1177,"_17548":44590,"_5":17443,"_23820":44531,"_2384":44591},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2857":1201,"_25170":1177,"_17548":44593,"_5":17443,"_23820":44531,"_2384":44594},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2857":1202,"_25170":1177,"_17548":44596,"_5":17443,"_23820":44535,"_2384":44597},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2857":1203,"_25170":1177,"_17548":44599,"_5":17443,"_23820":44535,"_2384":44600},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. When switching the enrollment CA, add the previous issuance CA to that list so old-CA identities keep re-enrolling during overlap; migrated `additional_validation_cas` values now live there. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2857":1204,"_25170":1177,"_17548":44602,"_5":17443,"_23820":44535,"_2384":44603},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2857":1205,"_25170":1177,"_17548":44605,"_5":17443,"_23820":44539,"_2384":44606},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2857":1206,"_25170":1206,"_5":12294,"_2384":44608,"_25506":44609,"_17548":44611,"_23820":1206},"AWS IoT Core",[40848,42192,43166,43164,44610],"Integrations",[],{"_2857":1207,"_25170":1206,"_17548":44613,"_5":17443,"_23820":1206,"_2384":44614},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2857":1208,"_25170":1206,"_5":25503,"_17548":44616,"_23820":44617,"_2384":44618},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2857":1209,"_25170":1206,"_5":25503,"_17548":44620,"_23820":44621,"_2384":44622},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2857":1210,"_25170":1206,"_5":25503,"_17548":44624,"_23820":44625,"_2384":44626},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2857":1211,"_25170":1206,"_5":25503,"_17548":44628,"_23820":44629,"_2384":44630},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2857":1212,"_25170":1206,"_5":25503,"_17548":44632,"_23820":44633,"_2384":44634},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2857":1213,"_25170":1206,"_5":25503,"_17548":44636,"_23820":44637,"_2384":44638},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2857":1214,"_25170":1206,"_5":25503,"_17548":44640,"_23820":44641,"_2384":44642},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2857":1215,"_25170":1206,"_5":25503,"_17548":44644,"_23820":44645,"_2384":44646},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2857":1216,"_25170":1206,"_5":25503,"_17548":44648,"_23820":44649,"_2384":44650},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2857":1217,"_25170":1206,"_5":25503,"_17548":44652,"_23820":44653,"_2384":44654},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2857":1218,"_25170":1206,"_5":25503,"_17548":44656,"_23820":44657,"_2384":44658},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2857":1219,"_25170":1206,"_5":25503,"_17548":44660,"_23820":44661,"_2384":44662},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2857":1220,"_25170":1206,"_5":25503,"_17548":44664,"_23820":44665,"_2384":44666},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2857":1221,"_25170":1206,"_5":25503,"_17548":44668,"_23820":44669,"_2384":44670},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2857":1222,"_25170":1206,"_5":25503,"_17548":44672,"_23820":44673,"_2384":44674},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2857":1223,"_25170":1206,"_5":25503,"_17548":44676,"_23820":44677,"_2384":44678},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2857":1224,"_25170":1206,"_5":25503,"_17548":44680,"_23820":44681,"_2384":44682},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2857":1225,"_25170":1206,"_5":25503,"_17548":44684,"_23820":44685,"_2384":44686},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2857":1226,"_25170":1206,"_5":25503,"_17548":44688,"_23820":44689,"_2384":44690},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2857":1227,"_25170":1206,"_5":25503,"_17548":44692,"_23820":44693,"_2384":44694},[],"/docs/pr-preview/pr-38/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2857":1228,"_25170":1206,"_17548":44696,"_5":17443,"_23820":1206,"_2384":44697},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2857":1229,"_25170":1206,"_17548":44699,"_5":17443,"_23820":1206,"_2384":44700},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2857":1230,"_25170":1206,"_17548":44702,"_5":17443,"_23820":1206,"_2384":44703},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2857":1231,"_25170":1206,"_17548":44705,"_5":17443,"_23820":44617,"_2384":44706},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2857":1232,"_25170":1206,"_17548":44708,"_5":17443,"_23820":44617,"_2384":44709},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2857":1233,"_25170":1206,"_17548":44711,"_5":17443,"_23820":44617,"_2384":44712},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2857":1234,"_25170":1206,"_17548":44714,"_5":17443,"_23820":44617,"_2384":44715},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2857":1235,"_25170":1206,"_17548":44717,"_5":17443,"_23820":44621,"_2384":44718},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2857":1236,"_25170":1206,"_17548":44720,"_5":17443,"_23820":44625,"_2384":44721},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2857":1237,"_25170":1206,"_17548":44723,"_5":17443,"_23820":44625,"_2384":44724},[],"IAM action",{"_2857":1238,"_25170":1206,"_17548":44726,"_5":17443,"_23820":44625,"_2384":41231},[],{"_2857":1239,"_25170":1206,"_17548":44728,"_5":17443,"_23820":44625,"_2384":44729},[],"`iot:GetRegistrationCode`",{"_2857":1240,"_25170":1206,"_17548":44731,"_5":17443,"_23820":44625,"_2384":44732},[],"Obtain the verification code for CA registration in the Primary Account",{"_2857":1241,"_25170":1206,"_17548":44734,"_5":17443,"_23820":44625,"_2384":44735},[],"`iot:RegisterCACertificate`",{"_2857":1242,"_25170":1206,"_17548":44737,"_5":17443,"_23820":44625,"_2384":44738},[],"Register the CA in AWS IoT",{"_2857":1243,"_25170":1206,"_17548":44740,"_5":17443,"_23820":44625,"_2384":44741},[],"`iot:DescribeCACertificate`",{"_2857":1244,"_25170":1206,"_17548":44743,"_5":17443,"_23820":44625,"_2384":44744},[],"Check the CA registration status",{"_2857":1245,"_25170":1206,"_17548":44746,"_5":17443,"_23820":44625,"_2384":44747},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2857":1246,"_25170":1206,"_17548":44749,"_5":17443,"_23820":44625,"_2384":44750},[],"Create or update Things in IoT Core",{"_2857":1247,"_25170":1206,"_17548":44752,"_5":17443,"_23820":44625,"_2384":44753},[],"`iot:RegisterThing`",{"_2857":1248,"_25170":1206,"_17548":44755,"_5":17443,"_23820":44625,"_2384":44756},[],"Provision Things through a template",{"_2857":1249,"_25170":1206,"_17548":44758,"_5":17443,"_23820":44625,"_2384":44759},[],"`iot:RegisterCertificate`",{"_2857":1250,"_25170":1206,"_17548":44761,"_5":17443,"_23820":44625,"_2384":44762},[],"Register device certificates",{"_2857":1251,"_25170":1206,"_17548":44764,"_5":17443,"_23820":44625,"_2384":44765},[],"`iot:UpdateCertificate`",{"_2857":1252,"_25170":1206,"_17548":44767,"_5":17443,"_23820":44625,"_2384":44768},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2857":1253,"_25170":1206,"_17548":44770,"_5":17443,"_23820":44625,"_2384":44771},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2857":1254,"_25170":1206,"_17548":44773,"_5":17443,"_23820":44625,"_2384":44774},[],"Create and attach IoT policies",{"_2857":1255,"_25170":1206,"_17548":44776,"_5":17443,"_23820":44625,"_2384":44777},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2857":1256,"_25170":1206,"_17548":44779,"_5":17443,"_23820":44625,"_2384":44780},[],"Manage Thing groups",{"_2857":1257,"_25170":1206,"_17548":44782,"_5":17443,"_23820":44625,"_2384":44783},[],"`iot:CreateProvisioningTemplate`",{"_2857":1258,"_25170":1206,"_17548":44785,"_5":17443,"_23820":44625,"_2384":44786},[],"Create JITP templates",{"_2857":1259,"_25170":1206,"_17548":44788,"_5":17443,"_23820":44625,"_2384":44789},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2857":1260,"_25170":1206,"_17548":44791,"_5":17443,"_23820":44625,"_2384":44792},[],"Read and write the Device Shadow",{"_2857":1261,"_25170":1206,"_17548":44794,"_5":17443,"_23820":44625,"_2384":44795},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2857":1262,"_25170":1206,"_17548":44797,"_5":17443,"_23820":44629,"_2384":44798},[],"Parameter",{"_2857":1263,"_25170":1206,"_17548":44800,"_5":17443,"_23820":44629,"_2384":44801},[],"Type",{"_2857":1264,"_25170":1206,"_17548":44803,"_5":17443,"_23820":44629,"_2384":44804},[],"Required",{"_2857":1265,"_25170":1206,"_17548":44806,"_5":17443,"_23820":44629,"_2384":44807},[],"Description",{"_2857":1266,"_25170":1206,"_17548":44809,"_5":17443,"_23820":44629,"_2384":44810},[],"`connector_id`",{"_2857":1267,"_25170":1206,"_17548":44812,"_5":17443,"_23820":44629,"_2384":20963},[],{"_2857":1268,"_25170":1206,"_17548":44814,"_5":17443,"_23820":44629,"_2384":44815},[],"Yes",{"_2857":1269,"_25170":1206,"_17548":44817,"_5":17443,"_23820":44629,"_2384":44818},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2857":1270,"_25170":1206,"_17548":44820,"_5":17443,"_23820":44629,"_2384":44821},[],"`aws_config.region`",{"_2857":1271,"_25170":1206,"_17548":44823,"_5":17443,"_23820":44629,"_2384":20963},[],{"_2857":1272,"_25170":1206,"_17548":44825,"_5":17443,"_23820":44629,"_2384":44815},[],{"_2857":1273,"_25170":1206,"_17548":44827,"_5":17443,"_23820":44629,"_2384":44828},[],"AWS region where the connector operates.",{"_2857":1274,"_25170":1206,"_17548":44830,"_5":17443,"_23820":44629,"_2384":44831},[],"`aws_config.auth_method`",{"_2857":1275,"_25170":1206,"_17548":44833,"_5":17443,"_23820":44629,"_2384":20963},[],{"_2857":1276,"_25170":1206,"_17548":44835,"_5":17443,"_23820":44629,"_2384":44815},[],{"_2857":1277,"_25170":1206,"_17548":44837,"_5":17443,"_23820":44629,"_2384":44838},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2857":1278,"_25170":1206,"_17548":44840,"_5":17443,"_23820":44629,"_2384":44841},[],"`aws_config.access_key_id`",{"_2857":1279,"_25170":1206,"_17548":44843,"_5":17443,"_23820":44629,"_2384":20963},[],{"_2857":1280,"_25170":1206,"_17548":44845,"_5":17443,"_23820":44629,"_2384":44846},[],"Only with `auth_method=static`",{"_2857":1281,"_25170":1206,"_17548":44848,"_5":17443,"_23820":44629,"_2384":44849},[],"AWS access key.",{"_2857":1282,"_25170":1206,"_17548":44851,"_5":17443,"_23820":44629,"_2384":44852},[],"`aws_config.secret_access_key`",{"_2857":1283,"_25170":1206,"_17548":44854,"_5":17443,"_23820":44629,"_2384":20963},[],{"_2857":1284,"_25170":1206,"_17548":44856,"_5":17443,"_23820":44629,"_2384":44846},[],{"_2857":1285,"_25170":1206,"_17548":44858,"_5":17443,"_23820":44629,"_2384":44859},[],"AWS secret key.",{"_2857":1286,"_25170":1206,"_17548":44861,"_5":17443,"_23820":44629,"_2384":44862},[],"`aws_config.session_token`",{"_2857":1287,"_25170":1206,"_17548":44864,"_5":17443,"_23820":44629,"_2384":20963},[],{"_2857":1288,"_25170":1206,"_17548":44866,"_5":17443,"_23820":44629,"_2384":44867},[],"No",{"_2857":1289,"_25170":1206,"_17548":44869,"_5":17443,"_23820":44629,"_2384":44870},[],"Session token (with `auth_method=static`).",{"_2857":1290,"_25170":1206,"_17548":44872,"_5":17443,"_23820":44629,"_2384":44873},[],"`aws_config.role_arn`",{"_2857":1291,"_25170":1206,"_17548":44875,"_5":17443,"_23820":44629,"_2384":20963},[],{"_2857":1292,"_25170":1206,"_17548":44877,"_5":17443,"_23820":44629,"_2384":44878},[],"Only with `auth_method=role`",{"_2857":1293,"_25170":1206,"_17548":44880,"_5":17443,"_23820":44629,"_2384":44881},[],"ARN of the role to assume.",{"_2857":1294,"_25170":1206,"_17548":44883,"_5":17443,"_23820":44629,"_2384":44884},[],"`aws_config.endpoint_url`",{"_2857":1295,"_25170":1206,"_17548":44886,"_5":17443,"_23820":44629,"_2384":20963},[],{"_2857":1296,"_25170":1206,"_17548":44888,"_5":17443,"_23820":44629,"_2384":44867},[],{"_2857":1297,"_25170":1206,"_17548":44890,"_5":17443,"_23820":44629,"_2384":44891},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2857":1298,"_25170":1206,"_17548":44893,"_5":17443,"_23820":44629,"_2384":44894},[],"`subscriber_event_bus`",{"_2857":1299,"_25170":1206,"_17548":44896,"_5":17443,"_23820":44629,"_2384":14708},[],{"_2857":1300,"_25170":1206,"_17548":44898,"_5":17443,"_23820":44629,"_2384":44815},[],{"_2857":1301,"_25170":1206,"_17548":44900,"_5":17443,"_23820":44629,"_2384":44901},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2857":1302,"_25170":1206,"_17548":44903,"_5":17443,"_23820":44629,"_2384":44904},[],"`dms_manager_client`",{"_2857":1303,"_25170":1206,"_17548":44906,"_5":17443,"_23820":44629,"_2384":20963},[],{"_2857":1304,"_25170":1206,"_17548":44908,"_5":17443,"_23820":44629,"_2384":44815},[],{"_2857":1305,"_25170":1206,"_17548":44910,"_5":17443,"_23820":44629,"_2384":44911},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2857":1306,"_25170":1206,"_17548":44913,"_5":17443,"_23820":44629,"_2384":44914},[],"`device_manager_client`",{"_2857":1307,"_25170":1206,"_17548":44916,"_5":17443,"_23820":44629,"_2384":20963},[],{"_2857":1308,"_25170":1206,"_17548":44918,"_5":17443,"_23820":44629,"_2384":44815},[],{"_2857":1309,"_25170":1206,"_17548":44920,"_5":17443,"_23820":44629,"_2384":44921},[],"HTTP URL of Lamassu's Device Manager.",{"_2857":1310,"_25170":1206,"_17548":44923,"_5":17443,"_23820":44629,"_2384":44924},[],"`ca_client`",{"_2857":1311,"_25170":1206,"_17548":44926,"_5":17443,"_23820":44629,"_2384":20963},[],{"_2857":1312,"_25170":1206,"_17548":44928,"_5":17443,"_23820":44629,"_2384":44815},[],{"_2857":1313,"_25170":1206,"_17548":44930,"_5":17443,"_23820":44629,"_2384":44931},[],"HTTP URL of Lamassu's CA service.",{"_2857":1314,"_25170":1206,"_17548":44933,"_5":17443,"_23820":44633,"_2384":44934},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2857":1315,"_25170":1206,"_17548":44936,"_5":17443,"_23820":44637,"_2384":44937},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2857":1316,"_25170":1206,"_17548":44939,"_5":17443,"_23820":44637,"_2384":44940},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2857":1317,"_25170":1206,"_17548":44942,"_5":17443,"_23820":44641,"_2384":44943},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2857":1318,"_25170":1206,"_17548":44945,"_5":17443,"_23820":44641,"_2384":44946},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2857":1319,"_25170":1206,"_17548":44948,"_5":17443,"_23820":44641,"_2384":44949},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2857":1320,"_25170":1206,"_17548":44951,"_5":17443,"_23820":44641,"_2384":44952},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2857":1321,"_25170":1206,"_17548":44954,"_5":17443,"_23820":44641,"_2384":44955},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2857":1322,"_25170":1206,"_17548":44957,"_5":17443,"_23820":44641,"_2384":44958},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2857":1323,"_25170":1206,"_17548":44960,"_5":17443,"_23820":44645,"_2384":44961},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2857":1324,"_25170":1206,"_17548":44963,"_5":17443,"_23820":44649,"_2384":44964},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2857":1325,"_25170":1206,"_17548":44966,"_5":17443,"_23820":44649,"_2384":44967},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2857":1326,"_25170":1206,"_17548":44969,"_5":17443,"_23820":44653,"_2384":44970},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2857":1327,"_25170":1206,"_17548":44972,"_5":17443,"_23820":44657,"_2384":44973},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2857":1328,"_25170":1206,"_17548":44975,"_5":17443,"_23820":44657,"_2384":44976},[],"Creates or updates the IoT policies configured in the DMS.",{"_2857":1329,"_25170":1206,"_17548":44978,"_5":17443,"_23820":44657,"_2384":44979},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2857":1330,"_25170":1206,"_17548":44981,"_5":17443,"_23820":44657,"_2384":44982},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2857":1331,"_25170":1206,"_17548":44984,"_5":17443,"_23820":44657,"_2384":44985},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2857":1332,"_25170":1206,"_17548":44987,"_5":17443,"_23820":44657,"_2384":44988},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2857":1333,"_25170":1206,"_17548":44990,"_5":17443,"_23820":44657,"_2384":44991},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2857":1334,"_25170":1206,"_17548":44993,"_5":17443,"_23820":44661,"_2384":44994},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2857":1335,"_25170":1206,"_17548":44996,"_5":17443,"_23820":44661,"_2384":44997},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2857":1336,"_25170":1206,"_17548":44999,"_5":17443,"_23820":44661,"_2384":45000},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2857":1337,"_25170":1206,"_17548":45002,"_5":17443,"_23820":44665,"_2384":45003},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2857":1338,"_25170":1206,"_17548":45005,"_5":17443,"_23820":44665,"_2384":45006},[],"The full flow from the device's perspective is:",{"_2857":1339,"_25170":1206,"_17548":45008,"_5":17443,"_23820":44665,"_2384":45009},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2857":1340,"_25170":1206,"_17548":45011,"_5":17443,"_23820":44669,"_2384":45012},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2857":1341,"_25170":1206,"_17548":45014,"_5":17443,"_23820":44669,"_2384":45015},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2857":1342,"_25170":1206,"_17548":45017,"_5":17443,"_23820":44669,"_2384":45018},[],"For the JITP flow to work correctly:",{"_2857":1343,"_25170":1206,"_17548":45020,"_5":17443,"_23820":44669,"_2384":45021},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2857":1344,"_25170":1206,"_17548":45023,"_5":17443,"_23820":44669,"_2384":45024},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2857":1345,"_25170":1206,"_17548":45026,"_5":17443,"_23820":44669,"_2384":45027},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2857":1346,"_25170":1206,"_17548":45029,"_5":17443,"_23820":44669,"_2384":45030},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2857":1347,"_25170":1206,"_17548":45032,"_5":17443,"_23820":44673,"_2384":45033},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2857":1348,"_25170":1206,"_17548":45035,"_5":17443,"_23820":44673,"_2384":45036},[],"Status in Lamassu",{"_2857":1349,"_25170":1206,"_17548":45038,"_5":17443,"_23820":44673,"_2384":45039},[],"Revocation reason",{"_2857":1350,"_25170":1206,"_17548":45041,"_5":17443,"_23820":44673,"_2384":45042},[],"Status in AWS IoT Core",{"_2857":1351,"_25170":1206,"_17548":45044,"_5":17443,"_23820":44673,"_2384":45045},[],"`Active`",{"_2857":1352,"_25170":1206,"_17548":45047,"_5":17443,"_23820":44673,"_2384":45048},[],"None",{"_2857":1353,"_25170":1206,"_17548":45050,"_5":17443,"_23820":44673,"_2384":45051},[],"`ACTIVE`",{"_2857":1354,"_25170":1206,"_17548":45053,"_5":17443,"_23820":44673,"_2384":45054},[],"`Revoked`",{"_2857":1355,"_25170":1206,"_17548":45056,"_5":17443,"_23820":44673,"_2384":45057},[],"`certificateHold`",{"_2857":1356,"_25170":1206,"_17548":45059,"_5":17443,"_23820":44673,"_2384":45060},[],"`INACTIVE`",{"_2857":1357,"_25170":1206,"_17548":45062,"_5":17443,"_23820":44673,"_2384":45054},[],{"_2857":1358,"_25170":1206,"_17548":45064,"_5":17443,"_23820":44673,"_2384":45065},[],"Any other reason",{"_2857":1359,"_25170":1206,"_17548":45067,"_5":17443,"_23820":44673,"_2384":45068},[],"`REVOKED`",{"_2857":1360,"_25170":1206,"_17548":45070,"_5":17443,"_23820":44673,"_2384":45071},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2857":1361,"_25170":1206,"_17548":45073,"_5":17443,"_23820":44677,"_2384":45074},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2857":1362,"_25170":1206,"_17548":45076,"_5":17443,"_23820":44677,"_2384":45077},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2857":1363,"_25170":1206,"_17548":45079,"_5":17443,"_23820":44677,"_2384":45080},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2857":1364,"_25170":1206,"_17548":45082,"_5":17443,"_23820":44681,"_2384":45083},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2857":1365,"_25170":1206,"_17548":45085,"_5":17443,"_23820":44681,"_2384":45086},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2857":1366,"_25170":1206,"_17548":45088,"_5":17443,"_23820":44685,"_2384":45089},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2857":1367,"_25170":1206,"_17548":45091,"_5":17443,"_23820":44685,"_2384":45092},[],"There are two action types:",{"_2857":1368,"_25170":1206,"_17548":45094,"_5":17443,"_23820":44685,"_2384":45095},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2857":1369,"_25170":1206,"_17548":45097,"_5":17443,"_23820":44685,"_2384":45098},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2857":1370,"_25170":1206,"_17548":45100,"_5":17443,"_23820":44685,"_2384":45101},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2857":1371,"_25170":1206,"_17548":45103,"_5":17443,"_23820":44689,"_2384":45104},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2857":1372,"_25170":1206,"_17548":45106,"_5":17443,"_23820":44689,"_2384":45107},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2857":1373,"_25170":1206,"_17548":45109,"_5":17443,"_23820":44689,"_2384":45110},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2857":1374,"_25170":1206,"_17548":45112,"_5":17443,"_23820":44693,"_2384":45113},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2857":1375,"_25170":1206,"_17548":45115,"_5":17443,"_23820":44693,"_2384":45116},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2857":1376,"_25170":1206,"_17548":45118,"_5":17443,"_23820":44693,"_2384":45119},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2857":1377,"_25170":1206,"_17548":45121,"_5":17443,"_23820":44693,"_2384":45122},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2857":1378,"_25170":1206,"_17548":45124,"_5":17443,"_23820":44693,"_2384":45125},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2857":1379,"_25170":1206,"_17548":45127,"_5":17443,"_23820":44693,"_2384":45128},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2857":1380,"_25170":1206,"_17548":45130,"_5":17443,"_23820":44693,"_2384":45131},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2857":1381,"_25170":1206,"_17548":45133,"_5":17443,"_23820":44693,"_2384":45134},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2857":1382,"_25170":1206,"_17548":45136,"_5":17443,"_23820":44693,"_2384":45137},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2857":1383,"_25170":1206,"_17548":45139,"_5":17443,"_23820":44693,"_2384":45140},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2857":1384,"_25170":1206,"_17548":45142,"_5":17443,"_23820":44693,"_2384":45143},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2857":1385,"_25170":1206,"_17548":45145,"_5":17443,"_23820":44693,"_2384":45146},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2857":1386,"_25170":1206,"_17548":45148,"_5":17443,"_23820":44693,"_2384":45149},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2857":1387,"_25170":1206,"_17548":45151,"_5":17443,"_23820":44693,"_2384":45152},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2857":1388,"_25170":1206,"_17548":45154,"_5":17443,"_23820":44693,"_2384":45155},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2857":1389,"_25170":1206,"_17548":45157,"_5":17443,"_23820":44693,"_2384":45158},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2857":1390,"_25170":1206,"_17548":45160,"_5":17443,"_23820":44693,"_2384":45161},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2857":1391,"_25170":1206,"_17548":45163,"_5":17443,"_23820":44693,"_2384":45164},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2857":1392,"_25170":1206,"_17548":45166,"_5":17443,"_23820":44693,"_2384":45167},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":1393,"_25170":1206,"_17548":45169,"_5":17443,"_23820":44693,"_2384":45170},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2857":1394,"_25170":1206,"_17548":45172,"_5":17443,"_23820":44693,"_2384":45173},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2857":1395,"_25170":1395,"_5":12294,"_2384":43166,"_25506":45175,"_17548":45176,"_23820":1395},[40848,42192,43166],[],{"_2857":1396,"_25170":1395,"_17548":45178,"_5":17443,"_23820":1395,"_2384":45179},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2857":1397,"_25170":1395,"_5":25503,"_17548":45181,"_23820":45182,"_2384":45183},[],"/docs/pr-preview/pr-38/platform/iot-fleets/overview#start-here","Start here",{"_2857":1398,"_25170":1395,"_5":25503,"_17548":45185,"_23820":45186,"_2384":43164},[],"/docs/pr-preview/pr-38/platform/iot-fleets/overview#devices-and-identities",{"_2857":1399,"_25170":1395,"_5":25503,"_17548":45188,"_23820":45189,"_2384":43347},[],"/docs/pr-preview/pr-38/platform/iot-fleets/overview#enrollment-with-pki",{"_2857":1400,"_25170":1395,"_5":25503,"_17548":45191,"_23820":45192,"_2384":44610},[],"/docs/pr-preview/pr-38/platform/iot-fleets/overview#integrations",{"_2857":1401,"_25170":1395,"_5":25503,"_17548":45194,"_23820":45195,"_2384":45196},[],"/docs/pr-preview/pr-38/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2857":1402,"_25170":1395,"_17548":45198,"_5":17443,"_23820":1395,"_2384":45199},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2857":1403,"_25170":1395,"_17548":45201,"_5":17443,"_23820":45182,"_2384":45202},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2857":1404,"_25170":1395,"_17548":45204,"_5":17443,"_23820":45182,"_2384":45205},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2857":1405,"_25170":1395,"_17548":45207,"_5":17443,"_23820":45186,"_2384":45208},[],"Resource",{"_2857":1406,"_25170":1395,"_17548":45210,"_5":17443,"_23820":45186,"_2384":45211},[],"What it represents",{"_2857":1407,"_25170":1395,"_17548":45213,"_5":17443,"_23820":45186,"_2384":45214},[],"**Device**",{"_2857":1408,"_25170":1395,"_17548":45216,"_5":17443,"_23820":45186,"_2384":45217},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2857":1409,"_25170":1395,"_17548":45219,"_5":17443,"_23820":45186,"_2384":45220},[],"**Identity**",{"_2857":1410,"_25170":1395,"_17548":45222,"_5":17443,"_23820":45186,"_2384":45223},[],"The device's association with its certificates: an active version and a history.",{"_2857":1411,"_25170":1395,"_17548":45225,"_5":17443,"_23820":45186,"_2384":45226},[],"**DMS**",{"_2857":1412,"_25170":1395,"_17548":45228,"_5":17443,"_23820":45186,"_2384":45229},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2857":1413,"_25170":1395,"_17548":45231,"_5":17443,"_23820":45186,"_2384":45232},[],"**Fleet**",{"_2857":1414,"_25170":1395,"_17548":45234,"_5":17443,"_23820":45186,"_2384":45235},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2857":1415,"_25170":1395,"_17548":45237,"_5":17443,"_23820":45186,"_2384":45238},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2857":1416,"_25170":1395,"_17548":45240,"_5":17443,"_23820":45186,"_2384":45241},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2857":1417,"_25170":1395,"_17548":45243,"_5":17443,"_23820":45189,"_2384":45244},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2857":1418,"_25170":1395,"_17548":45246,"_5":17443,"_23820":45189,"_2384":45247},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2857":1419,"_25170":1395,"_17548":45249,"_5":17443,"_23820":45189,"_2384":45250},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2857":1420,"_25170":1395,"_17548":45252,"_5":17443,"_23820":45189,"_2384":45253},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2857":1421,"_25170":1395,"_17548":45255,"_5":17443,"_23820":45189,"_2384":45256},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2857":1422,"_25170":1395,"_17548":45258,"_5":17443,"_23820":45189,"_2384":45259},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2857":1423,"_25170":1395,"_17548":45261,"_5":17443,"_23820":45189,"_2384":45262},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":1424,"_25170":1395,"_17548":45264,"_5":17443,"_23820":45189,"_2384":45265},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2857":1425,"_25170":1395,"_17548":45267,"_5":17443,"_23820":45192,"_2384":45268},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2857":1426,"_25170":1395,"_17548":45270,"_5":17443,"_23820":45192,"_2384":45271},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2857":1427,"_25170":1395,"_17548":45273,"_5":17443,"_23820":45195,"_2384":45274},[],"Participant",{"_2857":1428,"_25170":1395,"_17548":45276,"_5":17443,"_23820":45195,"_2384":45277},[],"Responsibility",{"_2857":1429,"_25170":1395,"_17548":45279,"_5":17443,"_23820":45195,"_2384":45280},[],"PKI administrator",{"_2857":1430,"_25170":1395,"_17548":45282,"_5":17443,"_23820":45195,"_2384":45283},[],"CA, issuance profile, chain and revocation publication.",{"_2857":1431,"_25170":1395,"_17548":45285,"_5":17443,"_23820":45195,"_2384":45286},[],"Provisioning administrator",{"_2857":1432,"_25170":1395,"_17548":45288,"_5":17443,"_23820":45195,"_2384":45289},[],"DMS, admission, authentication per operation and inventory.",{"_2857":1433,"_25170":1395,"_17548":45291,"_5":17443,"_23820":45195,"_2384":45292},[],"Device integrator",{"_2857":1434,"_25170":1395,"_17548":45294,"_5":17443,"_23820":45195,"_2384":45295},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2857":1435,"_25170":1395,"_17548":45297,"_5":17443,"_23820":45195,"_2384":45298},[],"Consumer integrator",{"_2857":1436,"_25170":1395,"_17548":45300,"_5":17443,"_23820":45195,"_2384":45301},[],"Trusted issuers, validation and device permissions in the destination.",{"_2857":1437,"_25170":1395,"_17548":45303,"_5":17443,"_23820":45195,"_2384":45304},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2857":1438,"_25170":1438,"_5":12294,"_2384":45306,"_25506":45307,"_17548":45309,"_23820":1438},"Enroll and connect your first device",[40848,42192,43166,45308],"Getting started",[],{"_2857":1439,"_25170":1438,"_17548":45311,"_5":17443,"_23820":1438,"_2384":45312},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2857":1440,"_25170":1438,"_5":25503,"_17548":45314,"_23820":45315,"_2384":40858},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2857":1441,"_25170":1438,"_5":25503,"_17548":45317,"_23820":45318,"_2384":45319},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2857":1442,"_25170":1438,"_5":25503,"_17548":45321,"_23820":45322,"_2384":45323},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2857":1443,"_25170":1438,"_5":25503,"_17548":45325,"_23820":45326,"_2384":45327},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2857":1444,"_25170":1438,"_5":25503,"_17548":45329,"_23820":45330,"_2384":45331},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2857":1445,"_25170":1438,"_5":25503,"_17548":45333,"_23820":45334,"_2384":45335},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2857":1446,"_25170":1438,"_5":25503,"_17548":45337,"_23820":45338,"_2384":45339},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2857":1447,"_25170":1438,"_5":25503,"_17548":45341,"_23820":45342,"_2384":45343},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2857":1448,"_25170":1438,"_17548":45345,"_5":17443,"_23820":1438,"_2384":45346},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2857":1449,"_25170":1438,"_17548":45348,"_5":17443,"_23820":45315,"_2384":45349},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2857":1450,"_25170":1438,"_17548":45351,"_5":17443,"_23820":45315,"_2384":45352},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2857":1451,"_25170":1438,"_17548":45354,"_5":17443,"_23820":45315,"_2384":45355},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2857":1452,"_25170":1438,"_17548":45357,"_5":17443,"_23820":45315,"_2384":45358},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2857":1453,"_25170":1438,"_17548":45360,"_5":17443,"_23820":45315,"_2384":45361},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2857":1454,"_25170":1438,"_17548":45363,"_5":17443,"_23820":45318,"_2384":45364},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2857":1455,"_25170":1438,"_17548":45366,"_5":17443,"_23820":45318,"_2384":45367},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2857":1456,"_25170":1438,"_17548":45369,"_5":17443,"_23820":45322,"_2384":45370},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2857":1457,"_25170":1438,"_17548":45372,"_5":17443,"_23820":45322,"_2384":45373},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2857":1458,"_25170":1438,"_17548":45375,"_5":17443,"_23820":45322,"_2384":45376},[],"Setting",{"_2857":1459,"_25170":1438,"_17548":45378,"_5":17443,"_23820":45322,"_2384":45379},[],"Evaluation value",{"_2857":1460,"_25170":1438,"_17548":45381,"_5":17443,"_23820":45322,"_2384":45382},[],"Enrollment CA",{"_2857":1461,"_25170":1438,"_17548":45384,"_5":17443,"_23820":45322,"_2384":45385},[],"Issuing root from `device-root.pem`.",{"_2857":1462,"_25170":1438,"_17548":45387,"_5":17443,"_23820":45322,"_2384":43477},[],{"_2857":1463,"_25170":1438,"_17548":45389,"_5":17443,"_23820":45322,"_2384":45390},[],"The 1-hour leaf profile you just prepared.",{"_2857":1464,"_25170":1438,"_17548":45392,"_5":17443,"_23820":45322,"_2384":45393},[],"Protocol / Registration Mode",{"_2857":1465,"_25170":1438,"_17548":45395,"_5":17443,"_23820":45322,"_2384":45396},[],"`EST_RFC7030` / `JITP`.",{"_2857":1466,"_25170":1438,"_17548":45398,"_5":17443,"_23820":45322,"_2384":45399},[],"Verify CSR Signature",{"_2857":1467,"_25170":1438,"_17548":45401,"_5":17443,"_23820":45322,"_2384":45402},[],"Enabled.",{"_2857":1468,"_25170":1438,"_17548":45404,"_5":17443,"_23820":45322,"_2384":45405},[],"Enable Replaceable Enrollment",{"_2857":1469,"_25170":1438,"_17548":45407,"_5":17443,"_23820":45322,"_2384":45408},[],"Disabled; the ID must be new.",{"_2857":1470,"_25170":1438,"_17548":45410,"_5":17443,"_23820":45322,"_2384":45411},[],"Initial authentication",{"_2857":1471,"_25170":1438,"_17548":45413,"_5":17443,"_23820":45322,"_2384":45414},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2857":1472,"_25170":1438,"_17548":45416,"_5":17443,"_23820":45322,"_2384":45417},[],"Renewal authentication",{"_2857":1473,"_25170":1438,"_17548":45419,"_5":17443,"_23820":45322,"_2384":45420},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2857":1474,"_25170":1438,"_17548":45422,"_5":17443,"_23820":45322,"_2384":45423},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_2857":1475,"_25170":1438,"_17548":45425,"_5":17443,"_23820":45322,"_2384":45426},[],"Empty list for this direct issuance / disabled.",{"_2857":1476,"_25170":1438,"_17548":45428,"_5":17443,"_23820":45322,"_2384":45429},[],"Re-enrollment Delta",{"_2857":1477,"_25170":1438,"_17548":45431,"_5":17443,"_23820":45322,"_2384":45432},[],"1 hour.",{"_2857":1478,"_25170":1438,"_17548":45434,"_5":17443,"_23820":45322,"_2384":45435},[],"Preventive / Critical Delta",{"_2857":1479,"_25170":1438,"_17548":45437,"_5":17443,"_23820":45322,"_2384":45438},[],"30 minutes / 10 minutes.",{"_2857":1480,"_25170":1438,"_17548":45440,"_5":17443,"_23820":45322,"_2384":45441},[],"Revoke on Re-enrollment",{"_2857":1481,"_25170":1438,"_17548":45443,"_5":17443,"_23820":45322,"_2384":45444},[],"Disabled to test the successor before retiring the previous identity.",{"_2857":1482,"_25170":1438,"_17548":45446,"_5":17443,"_23820":45322,"_2384":43485},[],{"_2857":1483,"_25170":1438,"_17548":45448,"_5":17443,"_23820":45322,"_2384":45449},[],"Disabled; the operational key is generated in the client.",{"_2857":1484,"_25170":1438,"_17548":45451,"_5":17443,"_23820":45322,"_2384":45452},[],"CA Distribution",{"_2857":1485,"_25170":1438,"_17548":45454,"_5":17443,"_23820":45322,"_2384":45455},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2857":1486,"_25170":1438,"_17548":45457,"_5":17443,"_23820":45322,"_2384":45458},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2857":1487,"_25170":1438,"_17548":45460,"_5":17443,"_23820":45326,"_2384":45461},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2857":1488,"_25170":1438,"_17548":45463,"_5":17443,"_23820":45326,"_2384":45464},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2857":1489,"_25170":1438,"_17548":45466,"_5":17443,"_23820":45330,"_2384":45467},[],"Generate a new key and CSR with the selected identifier:",{"_2857":1490,"_25170":1438,"_17548":45469,"_5":17443,"_23820":45330,"_2384":45470},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2857":1491,"_25170":1438,"_17548":45472,"_5":17443,"_23820":45330,"_2384":45473},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2857":1492,"_25170":1438,"_17548":45475,"_5":17443,"_23820":45334,"_2384":45476},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2857":1493,"_25170":1438,"_17548":45478,"_5":17443,"_23820":45334,"_2384":45479},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2857":1494,"_25170":1438,"_17548":45481,"_5":17443,"_23820":45338,"_2384":45482},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2857":1495,"_25170":1438,"_17548":45484,"_5":17443,"_23820":45338,"_2384":45485},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2857":1496,"_25170":1438,"_17548":45487,"_5":17443,"_23820":45338,"_2384":45488},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2857":1497,"_25170":1438,"_17548":45490,"_5":17443,"_23820":45338,"_2384":45491},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2857":1498,"_25170":1438,"_17548":45493,"_5":17443,"_23820":45338,"_2384":45494},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2857":1499,"_25170":1438,"_17548":45496,"_5":17443,"_23820":45342,"_2384":45497},[],"Check",{"_2857":1500,"_25170":1438,"_17548":45499,"_5":17443,"_23820":45342,"_2384":45500},[],"Expected result",{"_2857":1501,"_25170":1438,"_17548":45502,"_5":17443,"_23820":45342,"_2384":45503},[],"Registration",{"_2857":1502,"_25170":1438,"_17548":45505,"_5":17443,"_23820":45342,"_2384":45506},[],"ID created automatically and correct DMS.",{"_2857":1503,"_25170":1438,"_17548":45508,"_5":17443,"_23820":45342,"_2384":45509},[],"Certificate",{"_2857":1504,"_25170":1438,"_17548":45511,"_5":17443,"_23820":45342,"_2384":45512},[],"CN, profile, serial and key verified.",{"_2857":1505,"_25170":1438,"_17548":45514,"_5":17443,"_23820":45342,"_2384":45515},[],"Inventory",{"_2857":1506,"_25170":1438,"_17548":45517,"_5":17443,"_23820":45342,"_2384":45518},[],"Received serial visible as the current identity and in history.",{"_2857":1507,"_25170":1438,"_17548":45520,"_5":17443,"_23820":45342,"_2384":45521},[],"Consumer",{"_2857":1508,"_25170":1438,"_17548":45523,"_5":17443,"_23820":45342,"_2384":45524},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2857":1509,"_25170":1438,"_17548":45526,"_5":17443,"_23820":45342,"_2384":45527},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2857":1510,"_25170":1438,"_17548":45529,"_5":17443,"_23820":45342,"_2384":45530},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2857":1511,"_25170":1511,"_5":12294,"_2384":43182,"_25506":45532,"_17548":45533,"_23820":1511},[40848,42192,43166,45308],[],{"_2857":1512,"_25170":1511,"_17548":45535,"_5":17443,"_23820":1511,"_2384":45536},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2857":1513,"_25170":1511,"_5":25503,"_17548":45538,"_23820":45539,"_2384":40858},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2857":1514,"_25170":1511,"_5":25503,"_17548":45541,"_23820":45542,"_2384":45543},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2857":1515,"_25170":1511,"_5":25503,"_17548":45545,"_23820":45546,"_2384":45547},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2857":1516,"_25170":1511,"_5":25503,"_17548":45549,"_23820":45550,"_2384":45551},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2857":1517,"_25170":1511,"_5":25503,"_17548":45553,"_23820":45554,"_2384":45555},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2857":1518,"_25170":1511,"_5":25503,"_17548":45557,"_23820":45558,"_2384":45559},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2857":1519,"_25170":1511,"_5":25503,"_17548":45561,"_23820":45562,"_2384":45500},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2857":1520,"_25170":1511,"_5":25503,"_17548":45564,"_23820":45565,"_2384":45566},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2857":1521,"_25170":1511,"_5":25503,"_17548":45568,"_23820":45569,"_2384":45570},[],"/docs/pr-preview/pr-38/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2857":1522,"_25170":1511,"_17548":45572,"_5":17443,"_23820":1511,"_2384":45573},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2857":1523,"_25170":1511,"_17548":45575,"_5":17443,"_23820":1511,"_2384":45576},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2857":1524,"_25170":1511,"_17548":45578,"_5":17443,"_23820":45539,"_2384":45579},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2857":1525,"_25170":1511,"_17548":45581,"_5":17443,"_23820":45539,"_2384":45582},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2857":1526,"_25170":1511,"_17548":45584,"_5":17443,"_23820":45539,"_2384":45585},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2857":1527,"_25170":1511,"_17548":45587,"_5":17443,"_23820":45539,"_2384":45588},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2857":1528,"_25170":1511,"_17548":45590,"_5":17443,"_23820":45542,"_2384":45591},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2857":1529,"_25170":1511,"_17548":45593,"_5":17443,"_23820":45542,"_2384":45594},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2857":1530,"_25170":1511,"_17548":45596,"_5":17443,"_23820":45542,"_2384":45597},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2857":1531,"_25170":1511,"_17548":45599,"_5":17443,"_23820":45542,"_2384":45600},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2857":1532,"_25170":1511,"_17548":45602,"_5":17443,"_23820":45542,"_2384":45603},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2857":1533,"_25170":1511,"_17548":45605,"_5":17443,"_23820":45542,"_2384":45606},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2857":1534,"_25170":1511,"_17548":45608,"_5":17443,"_23820":45542,"_2384":45609},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2857":1535,"_25170":1511,"_17548":45611,"_5":17443,"_23820":45542,"_2384":45612},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2857":1536,"_25170":1511,"_17548":45614,"_5":17443,"_23820":45546,"_2384":45615},[],"Open **Managed Devices** and the registration action. Complete:",{"_2857":1537,"_25170":1511,"_17548":45617,"_5":17443,"_23820":45546,"_2384":45618},[],"**Device ID**: `device-001`.",{"_2857":1538,"_25170":1511,"_17548":45620,"_5":17443,"_23820":45546,"_2384":45621},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2857":1539,"_25170":1511,"_17548":45623,"_5":17443,"_23820":45546,"_2384":45624},[],"**Icon** and **Tags**: optional classification.",{"_2857":1540,"_25170":1511,"_17548":45626,"_5":17443,"_23820":45546,"_2384":45627},[],"Confirm registration.",{"_2857":1541,"_25170":1511,"_17548":45629,"_5":17443,"_23820":45550,"_2384":45630},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2857":1542,"_25170":1511,"_17548":45632,"_5":17443,"_23820":45550,"_2384":45633},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2857":1543,"_25170":1511,"_17548":45635,"_5":17443,"_23820":45554,"_2384":45636},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2857":1544,"_25170":1511,"_17548":45638,"_5":17443,"_23820":45554,"_2384":45639},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2857":1545,"_25170":1511,"_17548":45641,"_5":17443,"_23820":45558,"_2384":45642},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2857":1546,"_25170":1511,"_17548":45644,"_5":17443,"_23820":45558,"_2384":45645},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2857":1547,"_25170":1511,"_17548":45647,"_5":17443,"_23820":45562,"_2384":45497},[],{"_2857":1548,"_25170":1511,"_17548":45649,"_5":17443,"_23820":45562,"_2384":45650},[],"Result",{"_2857":1549,"_25170":1511,"_17548":45652,"_5":17443,"_23820":45562,"_2384":45653},[],"Device",{"_2857":1550,"_25170":1511,"_17548":45655,"_5":17443,"_23820":45562,"_2384":45656},[],"`device-001` appears in inventory with the expected DMS.",{"_2857":1551,"_25170":1511,"_17548":45658,"_5":17443,"_23820":45562,"_2384":45659},[],"Current identity",{"_2857":1552,"_25170":1511,"_17548":45661,"_5":17443,"_23820":45562,"_2384":45662},[],"The associated certificate matches the one you verified in PKI.",{"_2857":1553,"_25170":1511,"_17548":45664,"_5":17443,"_23820":45562,"_2384":45665},[],"History",{"_2857":1554,"_25170":1511,"_17548":45667,"_5":17443,"_23820":45562,"_2384":45668},[],"The associated issuance appears with its serial number and dates.",{"_2857":1555,"_25170":1511,"_17548":45670,"_5":17443,"_23820":45562,"_2384":45671},[],"Key and certificate",{"_2857":1556,"_25170":1511,"_17548":45673,"_5":17443,"_23820":45562,"_2384":45674},[],"You have the verified pair ready to install on the device.",{"_2857":1557,"_25170":1511,"_17548":45676,"_5":17443,"_23820":45565,"_2384":45677},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2857":1558,"_25170":1511,"_17548":45679,"_5":17443,"_23820":45565,"_2384":45680},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2857":1559,"_25170":1511,"_17548":45682,"_5":17443,"_23820":45565,"_2384":45683},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2857":1560,"_25170":1511,"_17548":45685,"_5":17443,"_23820":45565,"_2384":45686},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2857":1561,"_25170":1511,"_17548":45688,"_5":17443,"_23820":45569,"_2384":45689},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2857":1562,"_25170":1511,"_17548":45691,"_5":17443,"_23820":45569,"_2384":45692},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2857":1563,"_25170":1511,"_17548":45694,"_5":17443,"_23820":45569,"_2384":45695},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2857":1564,"_25170":1564,"_5":12294,"_2384":45697,"_25506":45698,"_17548":45699,"_23820":1564},"Lamassu IoT Platform",[40848,42192],[],{"_2857":1565,"_25170":1564,"_17548":45701,"_5":17443,"_23820":1564,"_2384":45702},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2857":1566,"_25170":1564,"_5":25503,"_17548":45704,"_23820":45705,"_2384":45183},[],"/docs/pr-preview/pr-38/platform/overview#start-here",{"_2857":1567,"_25170":1564,"_5":25503,"_17548":45707,"_23820":45708,"_2384":45709},[],"/docs/pr-preview/pr-38/platform/overview#choose-your-path","Choose your path",{"_2857":1568,"_25170":1564,"_5":25503,"_17548":45711,"_23820":45712,"_2384":45713},[],"/docs/pr-preview/pr-38/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2857":1569,"_25170":1564,"_5":25503,"_17548":45715,"_23820":45716,"_2384":45717},[],"/docs/pr-preview/pr-38/platform/overview#core-capabilities","Core capabilities",{"_2857":1570,"_25170":1564,"_5":25503,"_17548":45719,"_23820":45720,"_2384":45721},[],"/docs/pr-preview/pr-38/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2857":1571,"_25170":1564,"_5":25503,"_17548":45723,"_23820":45724,"_2384":45725},[],"/docs/pr-preview/pr-38/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2857":1572,"_25170":1564,"_5":25503,"_17548":45727,"_23820":45728,"_2384":45729},[],"/docs/pr-preview/pr-38/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2857":1573,"_25170":1564,"_5":25503,"_17548":45731,"_23820":45732,"_2384":45733},[],"/docs/pr-preview/pr-38/platform/overview#automate-device-identities","Automate device identities",{"_2857":1574,"_25170":1564,"_5":25503,"_17548":45735,"_23820":45736,"_2384":45737},[],"/docs/pr-preview/pr-38/platform/overview#publish-validation-status","Publish validation status",{"_2857":1575,"_25170":1564,"_5":25503,"_17548":45739,"_23820":45740,"_2384":45741},[],"/docs/pr-preview/pr-38/platform/overview#react-to-events","React to events",{"_2857":1576,"_25170":1564,"_5":25503,"_17548":45743,"_23820":45744,"_2384":45745},[],"/docs/pr-preview/pr-38/platform/overview#operational-reference","Operational reference",{"_2857":1577,"_25170":1564,"_17548":45747,"_5":17443,"_23820":1564,"_2384":45748},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2857":1578,"_25170":1564,"_17548":45750,"_5":17443,"_23820":45705,"_2384":45751},[],"Choose the result you need:",{"_2857":1579,"_25170":1564,"_17548":45753,"_5":17443,"_23820":45705,"_2384":45754},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2857":1580,"_25170":1564,"_17548":45756,"_5":17443,"_23820":45705,"_2384":45757},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2857":1581,"_25170":1564,"_17548":45759,"_5":17443,"_23820":45705,"_2384":45760},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2857":1582,"_25170":1564,"_17548":45762,"_5":17443,"_23820":45708,"_2384":45763},[],"Section",{"_2857":1583,"_25170":1564,"_17548":45765,"_5":17443,"_23820":45708,"_2384":45766},[],"What you manage",{"_2857":1584,"_25170":1564,"_17548":45768,"_5":17443,"_23820":45708,"_2384":45769},[],"Entry point",{"_2857":1585,"_25170":1564,"_17548":45771,"_5":17443,"_23820":45708,"_2384":45772},[],"**PKI**",{"_2857":1586,"_25170":1564,"_17548":45774,"_5":17443,"_23820":45708,"_2384":45775},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2857":1587,"_25170":1564,"_17548":45777,"_5":17443,"_23820":45708,"_2384":45778},[],"PKI overview",{"_2857":1588,"_25170":1564,"_17548":45780,"_5":17443,"_23820":45708,"_2384":45781},[],"**IoT Fleets**",{"_2857":1589,"_25170":1564,"_17548":45783,"_5":17443,"_23820":45708,"_2384":45784},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2857":1590,"_25170":1564,"_17548":45786,"_5":17443,"_23820":45708,"_2384":45787},[],"IoT Fleets overview",{"_2857":1591,"_25170":1564,"_17548":45789,"_5":17443,"_23820":45708,"_2384":45790},[],"**Administration**",{"_2857":1592,"_25170":1564,"_17548":45792,"_5":17443,"_23820":45708,"_2384":45793},[],"Operator permissions, audit and event subscriptions.",{"_2857":1593,"_25170":1564,"_17548":45795,"_5":17443,"_23820":45708,"_2384":42190},[],{"_2857":1594,"_25170":1564,"_17548":45797,"_5":17443,"_23820":45708,"_2384":45798},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2857":1595,"_25170":1564,"_17548":45800,"_5":17443,"_23820":45712,"_2384":45801},[],"An identity's journey connects four responsibilities:",{"_2857":1596,"_25170":1564,"_17548":45803,"_5":17443,"_23820":45712,"_2384":45804},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2857":1597,"_25170":1564,"_17548":45806,"_5":17443,"_23820":45712,"_2384":45807},[],"The provisioning administrator configures the DMS and initial trust.",{"_2857":1598,"_25170":1564,"_17548":45809,"_5":17443,"_23820":45712,"_2384":45810},[],"The device client requests a certificate and installs it with the matching key.",{"_2857":1599,"_25170":1564,"_17548":45812,"_5":17443,"_23820":45712,"_2384":45813},[],"The consumer validates the identity and applies its access permissions.",{"_2857":1600,"_25170":1564,"_17548":45815,"_5":17443,"_23820":45712,"_2384":45816},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2857":1601,"_25170":1564,"_17548":45818,"_5":17443,"_23820":45720,"_2384":45819},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2857":1602,"_25170":1564,"_17548":45821,"_5":17443,"_23820":45724,"_2384":45822},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2857":1603,"_25170":1564,"_17548":45824,"_5":17443,"_23820":45728,"_2384":45825},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2857":1604,"_25170":1564,"_17548":45827,"_5":17443,"_23820":45732,"_2384":45828},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2857":1605,"_25170":1564,"_17548":45830,"_5":17443,"_23820":45736,"_2384":45831},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2857":1606,"_25170":1564,"_17548":45833,"_5":17443,"_23820":45740,"_2384":45834},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2857":1607,"_25170":1564,"_17548":45836,"_5":17443,"_23820":45744,"_2384":45277},[],{"_2857":1608,"_25170":1564,"_17548":45838,"_5":17443,"_23820":45744,"_2384":45839},[],"What it prepares or checks",{"_2857":1609,"_25170":1564,"_17548":45841,"_5":17443,"_23820":45744,"_2384":45280},[],{"_2857":1610,"_25170":1564,"_17548":45843,"_5":17443,"_23820":45744,"_2384":45844},[],"Key custody, CA hierarchy, profiles and validation.",{"_2857":1611,"_25170":1564,"_17548":45846,"_5":17443,"_23820":45744,"_2384":45847},[],"Fleet administrator",{"_2857":1612,"_25170":1564,"_17548":45849,"_5":17443,"_23820":45744,"_2384":45850},[],"DMS, device admission, renewal policy and inventory.",{"_2857":1613,"_25170":1564,"_17548":45852,"_5":17443,"_23820":45744,"_2384":45292},[],{"_2857":1614,"_25170":1564,"_17548":45854,"_5":17443,"_23820":45744,"_2384":45855},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2857":1615,"_25170":1564,"_17548":45857,"_5":17443,"_23820":45744,"_2384":45298},[],{"_2857":1616,"_25170":1564,"_17548":45859,"_5":17443,"_23820":45744,"_2384":45860},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2857":1617,"_25170":1564,"_17548":45862,"_5":17443,"_23820":45744,"_2384":45863},[],"Infrastructure operator",{"_2857":1618,"_25170":1564,"_17548":45865,"_5":17443,"_23820":45744,"_2384":45866},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2857":1619,"_25170":1564,"_17548":45868,"_5":17443,"_23820":45744,"_2384":45869},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2857":1620,"_25170":1620,"_5":12294,"_2384":45871,"_25506":45872,"_17548":45875,"_23820":1620},"CA hierarchy and rotation",[40848,42192,45873,45874],"PKI","Keys, authorities and certificates",[],{"_2857":1621,"_25170":1620,"_17548":45877,"_5":17443,"_23820":1620,"_2384":45878},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2857":1622,"_25170":1620,"_5":25503,"_17548":45880,"_23820":45881,"_2384":45882},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2857":1623,"_25170":1620,"_5":25503,"_17548":45884,"_23820":45885,"_2384":45886},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2857":1624,"_25170":1620,"_5":25503,"_17548":45888,"_23820":45889,"_2384":45890},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2857":1625,"_25170":1620,"_5":25503,"_17548":45892,"_23820":45893,"_2384":45894},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2857":1626,"_25170":1620,"_5":25503,"_17548":45896,"_23820":45897,"_2384":45898},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2857":1627,"_25170":1620,"_5":25503,"_17548":45900,"_23820":45901,"_2384":45902},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2857":1628,"_25170":1620,"_5":25503,"_17548":45904,"_23820":45905,"_2384":45906},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2857":1629,"_25170":1620,"_5":25503,"_17548":45908,"_23820":45909,"_2384":45910},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2857":1630,"_25170":1620,"_5":25503,"_17548":45912,"_23820":45913,"_2384":45914},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2857":1631,"_25170":1620,"_5":25503,"_17548":45916,"_23820":45917,"_2384":45918},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2857":1632,"_25170":1620,"_5":25503,"_17548":45920,"_23820":45921,"_2384":45922},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2857":1633,"_25170":1620,"_5":25503,"_17548":45924,"_23820":45925,"_2384":45926},[],"/docs/pr-preview/pr-38/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2857":1634,"_25170":1620,"_17548":45928,"_5":17443,"_23820":1620,"_2384":45929},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2857":1635,"_25170":1620,"_17548":45931,"_5":17443,"_23820":1620,"_2384":45932},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2857":1636,"_25170":1620,"_17548":45934,"_5":17443,"_23820":45881,"_2384":45935},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2857":1637,"_25170":1620,"_17548":45937,"_5":17443,"_23820":45881,"_2384":45938},[],"environment, such as production and preproduction;",{"_2857":1638,"_25170":1620,"_17548":45940,"_5":17443,"_23820":45881,"_2384":45941},[],"owner or operating team;",{"_2857":1639,"_25170":1620,"_17548":45943,"_5":17443,"_23820":45881,"_2384":45944},[],"device family or manufacturing process;",{"_2857":1640,"_25170":1620,"_17548":45946,"_5":17443,"_23820":45881,"_2384":45947},[],"region or regulatory requirement;",{"_2857":1641,"_25170":1620,"_17548":45949,"_5":17443,"_23820":45881,"_2384":45950},[],"cryptographic engine or key policy;",{"_2857":1642,"_25170":1620,"_17548":45952,"_5":17443,"_23820":45881,"_2384":45953},[],"maintenance window and renewal cadence.",{"_2857":1643,"_25170":1620,"_17548":45955,"_5":17443,"_23820":45881,"_2384":45956},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2857":1644,"_25170":1620,"_17548":45958,"_5":17443,"_23820":45881,"_2384":45959},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2857":1645,"_25170":1620,"_17548":45961,"_5":17443,"_23820":45885,"_2384":45962},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2857":1646,"_25170":1620,"_17548":45964,"_5":17443,"_23820":45885,"_2384":45965},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2857":1647,"_25170":1620,"_17548":45967,"_5":17443,"_23820":45885,"_2384":45968},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2857":1648,"_25170":1620,"_17548":45970,"_5":17443,"_23820":45889,"_2384":45971},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2857":1649,"_25170":1620,"_17548":45973,"_5":17443,"_23820":45889,"_2384":45974},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2857":1650,"_25170":1620,"_17548":45976,"_5":17443,"_23820":45889,"_2384":45977},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2857":1651,"_25170":1620,"_17548":45979,"_5":17443,"_23820":45889,"_2384":45980},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2857":1652,"_25170":1620,"_17548":45982,"_5":17443,"_23820":45897,"_2384":45983},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2857":1653,"_25170":1620,"_17548":45985,"_5":17443,"_23820":45901,"_2384":45986},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2857":1654,"_25170":1620,"_17548":45988,"_5":17443,"_23820":45905,"_2384":45989},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2857":1655,"_25170":1620,"_17548":45991,"_5":17443,"_23820":45909,"_2384":45992},[],"Update the enrollment CA and profile of the DMSs, and add the old CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) while old-CA cohorts still renew. The DMS guide documents the setting.",{"_2857":1656,"_25170":1620,"_17548":45994,"_5":17443,"_23820":45913,"_2384":45995},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2857":1657,"_25170":1620,"_17548":45997,"_5":17443,"_23820":45917,"_2384":45998},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2857":1658,"_25170":1620,"_17548":46000,"_5":17443,"_23820":45921,"_2384":46001},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2857":1659,"_25170":1620,"_17548":46003,"_5":17443,"_23820":45921,"_2384":46004},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2857":1660,"_25170":1620,"_17548":46006,"_5":17443,"_23820":45921,"_2384":46007},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2857":1661,"_25170":1620,"_17548":46009,"_5":17443,"_23820":45921,"_2384":46010},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2857":1662,"_25170":1620,"_17548":46012,"_5":17443,"_23820":45925,"_2384":46013},[],"The new chain ends in an anchor installed by the consumer.",{"_2857":1663,"_25170":1620,"_17548":46015,"_5":17443,"_23820":45925,"_2384":46016},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2857":1664,"_25170":1620,"_17548":46018,"_5":17443,"_23820":45925,"_2384":46019},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2857":1665,"_25170":1620,"_17548":46021,"_5":17443,"_23820":45925,"_2384":46022},[],"Re-enrollment accepts the old identity during the planned period.",{"_2857":1666,"_25170":1620,"_17548":46024,"_5":17443,"_23820":45925,"_2384":46025},[],"OCSP and CRL respond for the authorities that remain active.",{"_2857":1667,"_25170":1620,"_17548":46027,"_5":17443,"_23820":45925,"_2384":46028},[],"No DMS is left accidentally issuing from the old CA.",{"_2857":1668,"_25170":1620,"_17548":46030,"_5":17443,"_23820":45925,"_2384":46031},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2857":1669,"_25170":1669,"_5":12294,"_2384":46033,"_25506":46034,"_17548":46035,"_23820":1669},"Certification authorities",[40848,42192,45873,45874],[],{"_2857":1670,"_25170":1669,"_17548":46037,"_5":17443,"_23820":1669,"_2384":46038},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2857":1671,"_25170":1669,"_5":25503,"_17548":46040,"_23820":46041,"_2384":46042},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2857":1672,"_25170":1669,"_5":25503,"_17548":46044,"_23820":46045,"_2384":46046},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2857":1673,"_25170":1669,"_5":25503,"_17548":46048,"_23820":46049,"_2384":40858},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#before-you-begin",{"_2857":1674,"_25170":1669,"_5":25503,"_17548":46051,"_23820":46052,"_2384":46053},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2857":1675,"_25170":1669,"_5":25503,"_17548":46055,"_23820":46056,"_2384":46057},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2857":1676,"_25170":1669,"_5":25503,"_17548":46059,"_23820":46060,"_2384":46061},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2857":1677,"_25170":1669,"_5":25503,"_17548":46063,"_23820":46064,"_2384":46065},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2857":1678,"_25170":1669,"_5":25503,"_17548":46067,"_23820":46068,"_2384":46069},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2857":1679,"_25170":1669,"_5":25503,"_17548":46071,"_23820":46072,"_2384":46073},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2857":1680,"_25170":1669,"_5":25503,"_17548":46075,"_23820":46076,"_2384":46077},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2857":1681,"_25170":1669,"_5":25503,"_17548":46079,"_23820":46080,"_2384":46081},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2857":1682,"_25170":1669,"_5":25503,"_17548":46083,"_23820":46084,"_2384":46085},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2857":1683,"_25170":1669,"_5":25503,"_17548":46087,"_23820":46088,"_2384":46089},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2857":1684,"_25170":1669,"_5":25503,"_17548":46091,"_23820":46092,"_2384":46093},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2857":1685,"_25170":1669,"_5":25503,"_17548":46095,"_23820":46096,"_2384":46097},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2857":1686,"_25170":1669,"_5":25503,"_17548":46099,"_23820":46100,"_2384":46101},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2857":1687,"_25170":1669,"_5":25503,"_17548":46103,"_23820":46104,"_2384":46105},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2857":1688,"_25170":1669,"_5":25503,"_17548":46107,"_23820":46108,"_2384":46109},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2857":1689,"_25170":1669,"_5":25503,"_17548":46111,"_23820":46112,"_2384":46113},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2857":1690,"_25170":1669,"_5":25503,"_17548":46115,"_23820":46116,"_2384":46117},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2857":1691,"_25170":1669,"_5":25503,"_17548":46119,"_23820":46120,"_2384":46121},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2857":1692,"_25170":1669,"_5":25503,"_17548":46123,"_23820":46124,"_2384":46125},[],"/docs/pr-preview/pr-38/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2857":1693,"_25170":1669,"_17548":46127,"_5":17443,"_23820":1669,"_2384":46128},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2857":1694,"_25170":1669,"_17548":46130,"_5":17443,"_23820":1669,"_2384":46131},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2857":1695,"_25170":1669,"_17548":46133,"_5":17443,"_23820":1669,"_2384":46134},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2857":1696,"_25170":1669,"_17548":46136,"_5":17443,"_23820":46041,"_2384":46137},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2857":1697,"_25170":1669,"_17548":46139,"_5":17443,"_23820":46041,"_2384":46140},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2857":1698,"_25170":1669,"_17548":46142,"_5":17443,"_23820":46041,"_2384":46143},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2857":1699,"_25170":1669,"_17548":46145,"_5":17443,"_23820":46041,"_2384":46146},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2857":1700,"_25170":1669,"_17548":46148,"_5":17443,"_23820":46041,"_2384":46149},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2857":1701,"_25170":1669,"_17548":46151,"_5":17443,"_23820":46049,"_2384":46152},[],"Decide whether the CA will be a root or an intermediate.",{"_2857":1702,"_25170":1669,"_17548":46154,"_5":17443,"_23820":46049,"_2384":46155},[],"Choose the engine that will keep the key.",{"_2857":1703,"_25170":1669,"_17548":46157,"_5":17443,"_23820":46049,"_2384":46158},[],"Define a validity longer than that of the certificates it will issue.",{"_2857":1704,"_25170":1669,"_17548":46160,"_5":17443,"_23820":46049,"_2384":46161},[],"For an intermediate CA, make sure the parent CA is active.",{"_2857":1705,"_25170":1669,"_17548":46163,"_5":17443,"_23820":46052,"_2384":46164},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2857":1706,"_25170":1669,"_17548":46166,"_5":17443,"_23820":46056,"_2384":46167},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2857":1707,"_25170":1669,"_17548":46169,"_5":17443,"_23820":46056,"_2384":46170},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2857":1708,"_25170":1669,"_17548":46172,"_5":17443,"_23820":46060,"_2384":46173},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2857":1709,"_25170":1669,"_17548":46175,"_5":17443,"_23820":46064,"_2384":46176},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2857":1710,"_25170":1669,"_17548":46178,"_5":17443,"_23820":46064,"_2384":46179},[],"`C`: two-letter ISO 3166-1 country code.",{"_2857":1711,"_25170":1669,"_17548":46181,"_5":17443,"_23820":46064,"_2384":46182},[],"`ST`: state or province.",{"_2857":1712,"_25170":1669,"_17548":46184,"_5":17443,"_23820":46064,"_2384":46185},[],"`L`: locality.",{"_2857":1713,"_25170":1669,"_17548":46187,"_5":17443,"_23820":46064,"_2384":46188},[],"`O`: organization.",{"_2857":1714,"_25170":1669,"_17548":46190,"_5":17443,"_23820":46064,"_2384":46191},[],"`OU`: organizational unit.",{"_2857":1715,"_25170":1669,"_17548":46193,"_5":17443,"_23820":46064,"_2384":46194},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2857":1716,"_25170":1669,"_17548":46196,"_5":17443,"_23820":46068,"_2384":46197},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2857":1717,"_25170":1669,"_17548":46199,"_5":17443,"_23820":46068,"_2384":46200},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2857":1718,"_25170":1669,"_17548":46202,"_5":17443,"_23820":46072,"_2384":46203},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2857":1719,"_25170":1669,"_17548":46205,"_5":17443,"_23820":46072,"_2384":46206},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2857":1720,"_25170":1669,"_17548":46208,"_5":17443,"_23820":46076,"_2384":46209},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2857":1721,"_25170":1669,"_17548":46211,"_5":17443,"_23820":46076,"_2384":46212},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2857":1722,"_25170":1669,"_17548":46214,"_5":17443,"_23820":46080,"_2384":46215},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2857":1723,"_25170":1669,"_17548":46217,"_5":17443,"_23820":46084,"_2384":46218},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2857":1724,"_25170":1669,"_17548":46220,"_5":17443,"_23820":46088,"_2384":46221},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2857":1725,"_25170":1669,"_17548":46223,"_5":17443,"_23820":46092,"_2384":46224},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2857":1726,"_25170":1669,"_17548":46226,"_5":17443,"_23820":46096,"_2384":46227},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2857":1727,"_25170":1669,"_17548":46229,"_5":17443,"_23820":46096,"_2384":46230},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2857":1728,"_25170":1669,"_17548":46232,"_5":17443,"_23820":46100,"_2384":46233},[],"Open a CA from the inventory to review:",{"_2857":1729,"_25170":1669,"_17548":46235,"_5":17443,"_23820":46100,"_2384":46236},[],"Status and validity period.",{"_2857":1730,"_25170":1669,"_17548":46238,"_5":17443,"_23820":46100,"_2384":46239},[],"Certificate and chain in PEM format.",{"_2857":1731,"_25170":1669,"_17548":46241,"_5":17443,"_23820":46100,"_2384":46242},[],"Number of active, expired and revoked certificates.",{"_2857":1732,"_25170":1669,"_17548":46244,"_5":17443,"_23820":46100,"_2384":46245},[],"Certificates issued in **Issued Certificates**.",{"_2857":1733,"_25170":1669,"_17548":46247,"_5":17443,"_23820":46100,"_2384":46248},[],"The CRL linked to the authority.",{"_2857":1734,"_25170":1669,"_17548":46250,"_5":17443,"_23820":46100,"_2384":46251},[],"Metadata and the associated cryptographic engine.",{"_2857":1735,"_25170":1669,"_17548":46253,"_5":17443,"_23820":46100,"_2384":46254},[],"You can filter the inventory by name, status and CA type.",{"_2857":1736,"_25170":1669,"_17548":46256,"_5":17443,"_23820":46104,"_2384":46257},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2857":1737,"_25170":1669,"_17548":46259,"_5":17443,"_23820":46104,"_2384":46260},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2857":1738,"_25170":1669,"_17548":46262,"_5":17443,"_23820":46104,"_2384":46263},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2857":1739,"_25170":1669,"_17548":46265,"_5":17443,"_23820":46104,"_2384":46266},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2857":1740,"_25170":1669,"_17548":46268,"_5":17443,"_23820":46108,"_2384":46269},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2857":1741,"_25170":1669,"_17548":46271,"_5":17443,"_23820":46112,"_2384":46272},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2857":1742,"_25170":1669,"_17548":46274,"_5":17443,"_23820":46116,"_2384":46275},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2857":1743,"_25170":1669,"_17548":46277,"_5":17443,"_23820":46120,"_2384":46278},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2857":1744,"_25170":1669,"_17548":46280,"_5":17443,"_23820":46124,"_2384":46281},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2857":1745,"_25170":1669,"_17548":46283,"_5":17443,"_23820":46124,"_2384":46284},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2857":1746,"_25170":1746,"_5":12294,"_2384":46286,"_25506":46287,"_17548":46288,"_23820":1746},"Certificate profiles",[40848,42192,45873,45874],[],{"_2857":1747,"_25170":1746,"_17548":46290,"_5":17443,"_23820":1746,"_2384":46291},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2857":1748,"_25170":1746,"_5":25503,"_17548":46293,"_23820":46294,"_2384":46295},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2857":1749,"_25170":1746,"_5":25503,"_17548":46297,"_23820":46298,"_2384":46299},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#validity","Validity",{"_2857":1750,"_25170":1746,"_5":25503,"_17548":46301,"_23820":46302,"_2384":46303},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2857":1751,"_25170":1746,"_5":25503,"_17548":46305,"_23820":46306,"_2384":46307},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2857":1752,"_25170":1746,"_5":25503,"_17548":46309,"_23820":46310,"_2384":46311},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#subject","Subject",{"_2857":1753,"_25170":1746,"_5":25503,"_17548":46313,"_23820":46314,"_2384":46315},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2857":1754,"_25170":1746,"_5":25503,"_17548":46317,"_23820":46318,"_2384":46319},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2857":1755,"_25170":1746,"_5":25503,"_17548":46321,"_23820":46322,"_2384":46323},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2857":1756,"_25170":1746,"_5":25503,"_17548":46325,"_23820":46326,"_2384":46327},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2857":1757,"_25170":1746,"_5":25503,"_17548":46329,"_23820":46330,"_2384":46331},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2857":1758,"_25170":1746,"_5":25503,"_17548":46333,"_23820":46334,"_2384":46335},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2857":1759,"_25170":1746,"_5":25503,"_17548":46337,"_23820":46338,"_2384":46339},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2857":1760,"_25170":1746,"_5":25503,"_17548":46341,"_23820":46342,"_2384":46343},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2857":1761,"_25170":1746,"_5":25503,"_17548":46345,"_23820":46346,"_2384":46347},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2857":1762,"_25170":1746,"_5":25503,"_17548":46349,"_23820":46350,"_2384":46351},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#design-examples","Design examples",{"_2857":1763,"_25170":1746,"_5":25503,"_17548":46353,"_23820":46354,"_2384":46355},[],"/docs/pr-preview/pr-38/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2857":1764,"_25170":1746,"_17548":46357,"_5":17443,"_23820":1746,"_2384":46358},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2857":1765,"_25170":1746,"_17548":46360,"_5":17443,"_23820":1746,"_2384":46361},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2857":1766,"_25170":1746,"_17548":46363,"_5":17443,"_23820":46298,"_2384":46364},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2857":1767,"_25170":1746,"_17548":46366,"_5":17443,"_23820":46298,"_2384":46367},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2857":1768,"_25170":1746,"_17548":46369,"_5":17443,"_23820":46302,"_2384":46370},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2857":1769,"_25170":1746,"_17548":46372,"_5":17443,"_23820":46306,"_2384":46373},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2857":1770,"_25170":1746,"_17548":46375,"_5":17443,"_23820":46306,"_2384":46376},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2857":1771,"_25170":1746,"_17548":46378,"_5":17443,"_23820":46306,"_2384":46379},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2857":1772,"_25170":1746,"_17548":46381,"_5":17443,"_23820":46310,"_2384":46382},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2857":1773,"_25170":1746,"_17548":46384,"_5":17443,"_23820":46314,"_2384":46385},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2857":1774,"_25170":1746,"_17548":46387,"_5":17443,"_23820":46314,"_2384":46388},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2857":1775,"_25170":1746,"_17548":46390,"_5":17443,"_23820":46318,"_2384":46391},[],"The cryptographic enforcement can:",{"_2857":1776,"_25170":1746,"_17548":46393,"_5":17443,"_23820":46318,"_2384":46394},[],"allow or block RSA keys;",{"_2857":1777,"_25170":1746,"_17548":46396,"_5":17443,"_23820":46318,"_2384":46397},[],"limit the supported RSA sizes;",{"_2857":1778,"_25170":1746,"_17548":46399,"_5":17443,"_23820":46318,"_2384":46400},[],"allow or block ECDSA keys;",{"_2857":1779,"_25170":1746,"_17548":46402,"_5":17443,"_23820":46318,"_2384":46403},[],"limit the supported ECDSA sizes or curves.",{"_2857":1780,"_25170":1746,"_17548":46405,"_5":17443,"_23820":46318,"_2384":46406},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2857":1781,"_25170":1746,"_17548":46408,"_5":17443,"_23820":46322,"_2384":46409},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2857":1782,"_25170":1746,"_17548":46411,"_5":17443,"_23820":46322,"_2384":43913},[],{"_2857":1783,"_25170":1746,"_17548":46413,"_5":17443,"_23820":46322,"_2384":46414},[],"First choice",{"_2857":1784,"_25170":1746,"_17548":46416,"_5":17443,"_23820":46322,"_2384":46417},[],"Second choice",{"_2857":1785,"_25170":1746,"_17548":46419,"_5":17443,"_23820":46322,"_2384":46420},[],"If neither is supplied",{"_2857":1786,"_25170":1746,"_17548":46422,"_5":17443,"_23820":46322,"_2384":46423},[],"Direct signing with a CA",{"_2857":1787,"_25170":1746,"_17548":46425,"_5":17443,"_23820":46322,"_2384":46426},[],"`issuance_profile` embedded in the request",{"_2857":1788,"_25170":1746,"_17548":46428,"_5":17443,"_23820":46322,"_2384":46429},[],"Request `issuance_profile_id`",{"_2857":1789,"_25170":1746,"_17548":46431,"_5":17443,"_23820":46322,"_2384":46432},[],"CA default profile (`profile_id`).",{"_2857":1790,"_25170":1746,"_17548":46434,"_5":17443,"_23820":46322,"_2384":46435},[],"Issuance through a DMS",{"_2857":1791,"_25170":1746,"_17548":46437,"_5":17443,"_23820":46322,"_2384":46438},[],"`settings.issuance_profile_id`",{"_2857":1792,"_25170":1746,"_17548":46440,"_5":17443,"_23820":46322,"_2384":46441},[],"`settings.issuance_profile` embedded in the DMS",{"_2857":1793,"_25170":1746,"_17548":46443,"_5":17443,"_23820":46322,"_2384":46444},[],"Enrollment CA default profile.",{"_2857":1794,"_25170":1746,"_17548":46446,"_5":17443,"_23820":46322,"_2384":46447},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2857":1795,"_25170":1746,"_17548":46449,"_5":17443,"_23820":46322,"_2384":46450},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2857":1796,"_25170":1746,"_17548":46452,"_5":17443,"_23820":46330,"_2384":46453},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2857":1797,"_25170":1746,"_17548":46455,"_5":17443,"_23820":46334,"_2384":46456},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2857":1798,"_25170":1746,"_17548":46458,"_5":17443,"_23820":46338,"_2384":46459},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2857":1799,"_25170":1746,"_17548":46461,"_5":17443,"_23820":46342,"_2384":46462},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2857":1800,"_25170":1746,"_17548":46464,"_5":17443,"_23820":46346,"_2384":46465},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2857":1801,"_25170":1746,"_17548":46467,"_5":17443,"_23820":46346,"_2384":46468},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2857":1802,"_25170":1746,"_17548":46470,"_5":17443,"_23820":46350,"_2384":46471},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2857":1803,"_25170":1746,"_17548":46473,"_5":17443,"_23820":46350,"_2384":46474},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2857":1804,"_25170":1746,"_17548":46476,"_5":17443,"_23820":46350,"_2384":46477},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2857":1805,"_25170":1746,"_17548":46479,"_5":17443,"_23820":46350,"_2384":46480},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2857":1806,"_25170":1746,"_17548":46482,"_5":17443,"_23820":46354,"_2384":46483},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2857":1807,"_25170":1746,"_17548":46485,"_5":17443,"_23820":46354,"_2384":46486},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2857":1808,"_25170":1808,"_5":12294,"_2384":46488,"_25506":46489,"_17548":46491,"_23820":1808},"Certificate validation",[40848,42192,45873,46490],"Validation",[],{"_2857":1809,"_25170":1808,"_17548":46493,"_5":17443,"_23820":1808,"_2384":46494},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2857":1810,"_25170":1808,"_5":25503,"_17548":46496,"_23820":46497,"_2384":46498},[],"/docs/pr-preview/pr-38/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2857":1811,"_25170":1808,"_5":25503,"_17548":46500,"_23820":46501,"_2384":46502},[],"/docs/pr-preview/pr-38/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2857":1812,"_25170":1808,"_5":25503,"_17548":46504,"_23820":46505,"_2384":46506},[],"/docs/pr-preview/pr-38/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2857":1813,"_25170":1808,"_17548":46508,"_5":17443,"_23820":1808,"_2384":46509},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2857":1814,"_25170":1808,"_17548":46511,"_5":17443,"_23820":46497,"_2384":46512},[],"Verify these criteria together:",{"_2857":1815,"_25170":1808,"_17548":46514,"_5":17443,"_23820":46497,"_2384":45497},[],{"_2857":1816,"_25170":1808,"_17548":46516,"_5":17443,"_23820":46497,"_2384":46517},[],"Required result",{"_2857":1817,"_25170":1808,"_17548":46519,"_5":17443,"_23820":46497,"_2384":46520},[],"Chain and signature",{"_2857":1818,"_25170":1808,"_17548":46522,"_5":17443,"_23820":46497,"_2384":46523},[],"Valid chain to a root deliberately installed in the consumer.",{"_2857":1819,"_25170":1808,"_17548":46525,"_5":17443,"_23820":46497,"_2384":46526},[],"Dates",{"_2857":1820,"_25170":1808,"_17548":46528,"_5":17443,"_23820":46497,"_2384":46529},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2857":1821,"_25170":1808,"_17548":46531,"_5":17443,"_23820":46497,"_2384":41895},[],{"_2857":1822,"_25170":1808,"_17548":46533,"_5":17443,"_23820":46497,"_2384":46534},[],"Name, SAN or identifier matches the expected peer.",{"_2857":1823,"_25170":1808,"_17548":46536,"_5":17443,"_23820":46497,"_2384":41231},[],{"_2857":1824,"_25170":1808,"_17548":46538,"_5":17443,"_23820":46497,"_2384":46539},[],"KU, EKU and constraints permit the specific operation.",{"_2857":1825,"_25170":1808,"_17548":46541,"_5":17443,"_23820":46497,"_2384":46542},[],"Revocation",{"_2857":1826,"_25170":1808,"_17548":46544,"_5":17443,"_23820":46497,"_2384":46545},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2857":1827,"_25170":1808,"_17548":46547,"_5":17443,"_23820":46497,"_2384":46548},[],"Authorization",{"_2857":1828,"_25170":1808,"_17548":46550,"_5":17443,"_23820":46497,"_2384":46551},[],"The application permits that identity to perform the action.",{"_2857":1829,"_25170":1808,"_17548":46553,"_5":17443,"_23820":46497,"_2384":46554},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2857":1830,"_25170":1808,"_17548":46556,"_5":17443,"_23820":46501,"_2384":46557},[],"Mechanism",{"_2857":1831,"_25170":1808,"_17548":46559,"_5":17443,"_23820":46501,"_2384":46560},[],"When to use it",{"_2857":1832,"_25170":1808,"_17548":46562,"_5":17443,"_23820":46501,"_2384":46563},[],"What you must maintain",{"_2857":1833,"_25170":1808,"_17548":46565,"_5":17443,"_23820":46501,"_2384":46566},[],"OCSP",{"_2857":1834,"_25170":1808,"_17548":46568,"_5":17443,"_23820":46501,"_2384":46569},[],"Status query for a specific certificate.",{"_2857":1835,"_25170":1808,"_17548":46571,"_5":17443,"_23820":46501,"_2384":46572},[],"Responder access, signature verification and cache/freshness policy.",{"_2857":1836,"_25170":1808,"_17548":46574,"_5":17443,"_23820":46501,"_2384":46575},[],"CRL",{"_2857":1837,"_25170":1808,"_17548":46577,"_5":17443,"_23820":46501,"_2384":46578},[],"Local checks for many certificates or offline operation.",{"_2857":1838,"_25170":1808,"_17548":46580,"_5":17443,"_23820":46501,"_2384":46581},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2857":1839,"_25170":1808,"_17548":46583,"_5":17443,"_23820":46501,"_2384":46584},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2857":1840,"_25170":1808,"_17548":46586,"_5":17443,"_23820":46501,"_2384":46587},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2857":1841,"_25170":1808,"_17548":46589,"_5":17443,"_23820":46505,"_2384":46590},[],"Accept a current, authorized certificate with a known chain.",{"_2857":1842,"_25170":1808,"_17548":46592,"_5":17443,"_23820":46505,"_2384":46593},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2857":1843,"_25170":1808,"_17548":46595,"_5":17443,"_23820":46505,"_2384":46596},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2857":1844,"_25170":1808,"_17548":46598,"_5":17443,"_23820":46505,"_2384":46599},[],"Check that a new connection with that identity is rejected.",{"_2857":1845,"_25170":1808,"_17548":46601,"_5":17443,"_23820":46505,"_2384":46602},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2857":1846,"_25170":1808,"_17548":46604,"_5":17443,"_23820":46505,"_2384":46605},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2857":1847,"_25170":1808,"_17548":46607,"_5":17443,"_23820":46505,"_2384":46608},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2857":1848,"_25170":1808,"_17548":46610,"_5":17443,"_23820":46505,"_2384":46611},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":1849,"_25170":1808,"_17548":46613,"_5":17443,"_23820":46505,"_2384":46614},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2857":1850,"_25170":1850,"_5":12294,"_2384":46616,"_25506":46617,"_17548":46618,"_23820":1850},"Certificates",[40848,42192,45873,45874],[],{"_2857":1851,"_25170":1850,"_17548":46620,"_5":17443,"_23820":1850,"_2384":46621},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2857":1852,"_25170":1850,"_5":25503,"_17548":46623,"_23820":46624,"_2384":46625},[],"/docs/pr-preview/pr-38/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2857":1853,"_25170":1850,"_5":25503,"_17548":46627,"_23820":46628,"_2384":46629},[],"/docs/pr-preview/pr-38/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2857":1854,"_25170":1850,"_5":25503,"_17548":46631,"_23820":46632,"_2384":46633},[],"/docs/pr-preview/pr-38/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2857":1855,"_25170":1850,"_5":25503,"_17548":46635,"_23820":46636,"_2384":46637},[],"/docs/pr-preview/pr-38/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2857":1856,"_25170":1850,"_5":25503,"_17548":46639,"_23820":46640,"_2384":46641},[],"/docs/pr-preview/pr-38/platform/pki/certificates#open-the-action","Open the action",{"_2857":1857,"_25170":1850,"_5":25503,"_17548":46643,"_23820":46644,"_2384":46645},[],"/docs/pr-preview/pr-38/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2857":1858,"_25170":1850,"_5":25503,"_17548":46647,"_23820":46648,"_2384":46649},[],"/docs/pr-preview/pr-38/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2857":1859,"_25170":1850,"_5":25503,"_17548":46651,"_23820":46652,"_2384":46653},[],"/docs/pr-preview/pr-38/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2857":1860,"_25170":1850,"_5":25503,"_17548":46655,"_23820":46656,"_2384":46657},[],"/docs/pr-preview/pr-38/platform/pki/certificates#continue","Continue",{"_2857":1861,"_25170":1850,"_17548":46659,"_5":17443,"_23820":1850,"_2384":46660},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2857":1862,"_25170":1850,"_17548":46662,"_5":17443,"_23820":46624,"_2384":46663},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2857":1863,"_25170":1850,"_17548":46665,"_5":17443,"_23820":46624,"_2384":46666},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2857":1864,"_25170":1850,"_17548":46668,"_5":17443,"_23820":46628,"_2384":46669},[],"Download the PEM and inspect it:",{"_2857":1865,"_25170":1850,"_17548":46671,"_5":17443,"_23820":46628,"_2384":46672},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2857":1866,"_25170":1850,"_17548":46674,"_5":17443,"_23820":46632,"_2384":46675},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2857":1867,"_25170":1850,"_17548":46677,"_5":17443,"_23820":46632,"_2384":46678},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2857":1868,"_25170":1850,"_17548":46680,"_5":17443,"_23820":46632,"_2384":46681},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2857":1869,"_25170":1850,"_17548":46683,"_5":17443,"_23820":46632,"_2384":46684},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2857":1870,"_25170":1850,"_17548":46686,"_5":17443,"_23820":46632,"_2384":46687},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2857":1871,"_25170":1850,"_17548":46689,"_5":17443,"_23820":46632,"_2384":46690},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2857":1872,"_25170":1850,"_17548":46692,"_5":17443,"_23820":46632,"_2384":46693},[],"For browser key generation, follow Issue your first certificate.",{"_2857":1873,"_25170":1850,"_17548":46695,"_5":17443,"_23820":46636,"_2384":46696},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2857":1874,"_25170":1850,"_17548":46698,"_5":17443,"_23820":46640,"_2384":46699},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2857":1875,"_25170":1850,"_17548":46701,"_5":17443,"_23820":46644,"_2384":46702},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2857":1876,"_25170":1850,"_17548":46704,"_5":17443,"_23820":46648,"_2384":46705},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2857":1877,"_25170":1850,"_17548":46707,"_5":17443,"_23820":46648,"_2384":46708},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2857":1878,"_25170":1850,"_17548":46710,"_5":17443,"_23820":46648,"_2384":46711},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2857":1879,"_25170":1850,"_17548":46713,"_5":17443,"_23820":46652,"_2384":46714},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2857":1880,"_25170":1850,"_17548":46716,"_5":17443,"_23820":46652,"_2384":46717},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2857":1881,"_25170":1850,"_17548":46719,"_5":17443,"_23820":46652,"_2384":46720},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2857":1882,"_25170":1850,"_17548":46722,"_5":17443,"_23820":46656,"_2384":46723},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":1883,"_25170":1850,"_17548":46725,"_5":17443,"_23820":46656,"_2384":46726},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2857":1884,"_25170":1884,"_5":12294,"_2384":46728,"_25506":46729,"_17548":46731,"_23820":1884},"Certificate lifecycle",[40848,42192,45873,46730],"Concepts",[],{"_2857":1885,"_25170":1884,"_17548":46733,"_5":17443,"_23820":1884,"_2384":46734},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2857":1886,"_25170":1884,"_5":25503,"_17548":46736,"_23820":46737,"_2384":46738},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2857":1887,"_25170":1884,"_5":25503,"_17548":46740,"_23820":46741,"_2384":46742},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2857":1888,"_25170":1884,"_5":25503,"_17548":46744,"_23820":46745,"_2384":46746},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2857":1889,"_25170":1884,"_5":25503,"_17548":46748,"_23820":46749,"_2384":46750},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2857":1890,"_25170":1884,"_5":25503,"_17548":46752,"_23820":46753,"_2384":46754},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2857":1891,"_25170":1884,"_5":25503,"_17548":46756,"_23820":46757,"_2384":46758},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2857":1892,"_25170":1884,"_5":25503,"_17548":46760,"_23820":46761,"_2384":46762},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2857":1893,"_25170":1884,"_5":25503,"_17548":46764,"_23820":46765,"_2384":46766},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2857":1894,"_25170":1884,"_5":25503,"_17548":46768,"_23820":46769,"_2384":46770},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2857":1895,"_25170":1884,"_5":25503,"_17548":46772,"_23820":46773,"_2384":46774},[],"/docs/pr-preview/pr-38/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2857":1896,"_25170":1884,"_17548":46776,"_5":17443,"_23820":1884,"_2384":46777},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2857":1897,"_25170":1884,"_17548":46779,"_5":17443,"_23820":46741,"_2384":46780},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2857":1898,"_25170":1884,"_17548":46782,"_5":17443,"_23820":46745,"_2384":46783},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2857":1899,"_25170":1884,"_17548":46785,"_5":17443,"_23820":46749,"_2384":46786},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2857":1900,"_25170":1884,"_17548":46788,"_5":17443,"_23820":46753,"_2384":46789},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2857":1901,"_25170":1884,"_17548":46791,"_5":17443,"_23820":46757,"_2384":46792},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2857":1902,"_25170":1884,"_17548":46794,"_5":17443,"_23820":46761,"_2384":46795},[],"Lamassu persists four X.509 states:",{"_2857":1903,"_25170":1884,"_17548":46797,"_5":17443,"_23820":46761,"_2384":46798},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2857":1904,"_25170":1884,"_17548":46800,"_5":17443,"_23820":46761,"_2384":46801},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2857":1905,"_25170":1884,"_17548":46803,"_5":17443,"_23820":46761,"_2384":46804},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2857":1906,"_25170":1884,"_17548":46806,"_5":17443,"_23820":46761,"_2384":46807},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2857":1907,"_25170":1884,"_17548":46809,"_5":17443,"_23820":46761,"_2384":46810},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2857":1908,"_25170":1884,"_17548":46812,"_5":17443,"_23820":46765,"_2384":46813},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2857":1909,"_25170":1884,"_17548":46815,"_5":17443,"_23820":46765,"_2384":46816},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2857":1910,"_25170":1884,"_17548":46818,"_5":17443,"_23820":46765,"_2384":46819},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2857":1911,"_25170":1884,"_17548":46821,"_5":17443,"_23820":46769,"_2384":46822},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2857":1912,"_25170":1884,"_17548":46824,"_5":17443,"_23820":46769,"_2384":46825},[],"Before confirming:",{"_2857":1913,"_25170":1884,"_17548":46827,"_5":17443,"_23820":46769,"_2384":46828},[],"Identify DMSs, devices and services that trust that chain.",{"_2857":1914,"_25170":1884,"_17548":46830,"_5":17443,"_23820":46769,"_2384":46831},[],"Distribute the new chain of trust.",{"_2857":1915,"_25170":1884,"_17548":46833,"_5":17443,"_23820":46769,"_2384":46834},[],"Reissue the necessary identities.",{"_2857":1916,"_25170":1884,"_17548":46836,"_5":17443,"_23820":46769,"_2384":46837},[],"Check OCSP and CRL from a real consumer.",{"_2857":1917,"_25170":1884,"_17548":46839,"_5":17443,"_23820":46769,"_2384":46840},[],"Revoke the old CA once no legitimate traffic remains.",{"_2857":1918,"_25170":1884,"_17548":46842,"_5":17443,"_23820":46769,"_2384":46843},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2857":1919,"_25170":1884,"_17548":46845,"_5":17443,"_23820":46773,"_2384":46846},[],"Certificates entering the preventive or critical renewal window.",{"_2857":1920,"_25170":1884,"_17548":46848,"_5":17443,"_23820":46773,"_2384":46849},[],"Repeated enrollment or re-enrollment failures.",{"_2857":1921,"_25170":1884,"_17548":46851,"_5":17443,"_23820":46773,"_2384":46852},[],"Status changes and revocation reasons.",{"_2857":1922,"_25170":1884,"_17548":46854,"_5":17443,"_23820":46773,"_2384":46855},[],"OCSP and CRL publication and validity.",{"_2857":1923,"_25170":1884,"_17548":46857,"_5":17443,"_23820":46773,"_2384":46858},[],"Dependencies still presenting a replaced certificate.",{"_2857":1924,"_25170":1884,"_17548":46860,"_5":17443,"_23820":46773,"_2384":46861},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2857":1925,"_25170":1925,"_5":12294,"_2384":46863,"_25506":46864,"_17548":46865,"_23820":1925},"Trust model",[40848,42192,45873,46730],[],{"_2857":1926,"_25170":1925,"_17548":46867,"_5":17443,"_23820":1925,"_2384":46868},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2857":1927,"_25170":1925,"_5":25503,"_17548":46870,"_23820":46871,"_2384":46872},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2857":1928,"_25170":1925,"_5":25503,"_17548":46874,"_23820":46875,"_2384":46876},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2857":1929,"_25170":1925,"_5":25503,"_17548":46878,"_23820":46879,"_2384":46880},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2857":1930,"_25170":1925,"_5":25503,"_17548":46882,"_23820":46883,"_2384":46884},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2857":1931,"_25170":1925,"_5":25503,"_17548":46886,"_23820":46887,"_2384":46888},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2857":1932,"_25170":1925,"_5":25503,"_17548":46890,"_23820":46891,"_2384":46892},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2857":1933,"_25170":1925,"_5":25503,"_17548":46894,"_23820":46895,"_2384":46896},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2857":1934,"_25170":1925,"_5":25503,"_17548":46898,"_23820":46899,"_2384":46900},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2857":1935,"_25170":1925,"_5":25503,"_17548":46902,"_23820":46903,"_2384":46904},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2857":1936,"_25170":1925,"_5":25503,"_17548":46906,"_23820":46907,"_2384":46908},[],"/docs/pr-preview/pr-38/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2857":1937,"_25170":1925,"_17548":46910,"_5":17443,"_23820":1925,"_2384":46911},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2857":1938,"_25170":1925,"_17548":46913,"_5":17443,"_23820":46875,"_2384":46914},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2857":1939,"_25170":1925,"_17548":46916,"_5":17443,"_23820":46879,"_2384":46917},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2857":1940,"_25170":1925,"_17548":46919,"_5":17443,"_23820":46883,"_2384":46920},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2857":1941,"_25170":1925,"_17548":46922,"_5":17443,"_23820":46887,"_2384":46923},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2857":1942,"_25170":1925,"_17548":46925,"_5":17443,"_23820":46891,"_2384":46926},[],"The device proves it can enroll according to the DMS policy.",{"_2857":1943,"_25170":1925,"_17548":46928,"_5":17443,"_23820":46891,"_2384":46929},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2857":1944,"_25170":1925,"_17548":46931,"_5":17443,"_23820":46891,"_2384":46932},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2857":1945,"_25170":1925,"_17548":46934,"_5":17443,"_23820":46891,"_2384":46935},[],"The device installs the certificate and the chain it needs.",{"_2857":1946,"_25170":1925,"_17548":46937,"_5":17443,"_23820":46891,"_2384":46938},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2857":1947,"_25170":1925,"_17548":46940,"_5":17443,"_23820":46891,"_2384":46941},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2857":1948,"_25170":1925,"_17548":46943,"_5":17443,"_23820":46895,"_2384":46944},[],"A DMS relates three sets that are worth designing separately:",{"_2857":1949,"_25170":1925,"_17548":46946,"_5":17443,"_23820":46895,"_2384":46947},[],"**Enrollment CA:** signs the new identities.",{"_2857":1950,"_25170":1925,"_17548":46949,"_5":17443,"_23820":46895,"_2384":46950},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the validation CAs configured in the re-enrollment block.",{"_2857":1951,"_25170":1925,"_17548":46952,"_5":17443,"_23820":46895,"_2384":46953},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2857":1952,"_25170":1925,"_17548":46955,"_5":17443,"_23820":46895,"_2384":46956},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2857":1953,"_25170":1925,"_17548":46958,"_5":17443,"_23820":46899,"_2384":46959},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2857":1954,"_25170":1925,"_17548":46961,"_5":17443,"_23820":46899,"_2384":46962},[],"that the current date is between `Not Before` and `Not After`;",{"_2857":1955,"_25170":1925,"_17548":46964,"_5":17443,"_23820":46899,"_2384":46965},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2857":1956,"_25170":1925,"_17548":46967,"_5":17443,"_23820":46899,"_2384":46968},[],"that names, SANs and subject match the expected identity;",{"_2857":1957,"_25170":1925,"_17548":46970,"_5":17443,"_23820":46899,"_2384":46971},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2857":1958,"_25170":1925,"_17548":46973,"_5":17443,"_23820":46899,"_2384":46974},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2857":1959,"_25170":1925,"_17548":46976,"_5":17443,"_23820":46899,"_2384":46977},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2857":1960,"_25170":1925,"_17548":46979,"_5":17443,"_23820":46903,"_2384":46980},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2857":1961,"_25170":1925,"_17548":46982,"_5":17443,"_23820":46907,"_2384":46983},[],"Keep the root out of daily operations, or with very restricted access.",{"_2857":1962,"_25170":1925,"_17548":46985,"_5":17443,"_23820":46907,"_2384":46986},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2857":1963,"_25170":1925,"_17548":46988,"_5":17443,"_23820":46907,"_2384":46989},[],"Assign explicit profiles to every use case.",{"_2857":1964,"_25170":1925,"_17548":46991,"_5":17443,"_23820":46907,"_2384":46992},[],"Distribute the new trust before starting a rotation.",{"_2857":1965,"_25170":1925,"_17548":46994,"_5":17443,"_23820":46907,"_2384":46995},[],"Keep enough overlap to renew a disconnected fleet.",{"_2857":1966,"_25170":1925,"_17548":46997,"_5":17443,"_23820":46907,"_2384":46998},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2857":1967,"_25170":1925,"_17548":47000,"_5":17443,"_23820":46907,"_2384":47001},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2857":1968,"_25170":1968,"_5":12294,"_2384":47003,"_25506":47004,"_17548":47005,"_23820":1968},"Revocation lists (CRL)",[40848,42192,45873,46490],[],{"_2857":1969,"_25170":1968,"_17548":47007,"_5":17443,"_23820":1968,"_2384":47008},[],"Generate and distribute signed lists to validate certificates offline.",{"_2857":1970,"_25170":1968,"_5":25503,"_17548":47010,"_23820":47011,"_2384":47012},[],"/docs/pr-preview/pr-38/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2857":1971,"_25170":1968,"_5":25503,"_17548":47014,"_23820":47015,"_2384":47016},[],"/docs/pr-preview/pr-38/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2857":1972,"_25170":1968,"_5":25503,"_17548":47018,"_23820":47019,"_2384":47020},[],"/docs/pr-preview/pr-38/platform/pki/crl#crl-contents","CRL contents",{"_2857":1973,"_25170":1968,"_5":25503,"_17548":47022,"_23820":47023,"_2384":47024},[],"/docs/pr-preview/pr-38/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2857":1974,"_25170":1968,"_5":25503,"_17548":47026,"_23820":47027,"_2384":47028},[],"/docs/pr-preview/pr-38/platform/pki/crl#va-role-management-api","VA role management API",{"_2857":1975,"_25170":1968,"_5":25503,"_17548":47030,"_23820":47031,"_2384":47032},[],"/docs/pr-preview/pr-38/platform/pki/crl#from-the-interface","From the interface",{"_2857":1976,"_25170":1968,"_5":25503,"_17548":47034,"_23820":47035,"_2384":47036},[],"/docs/pr-preview/pr-38/platform/pki/crl#references","References",{"_2857":1977,"_25170":1968,"_17548":47038,"_5":17443,"_23820":1968,"_2384":47039},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2857":1978,"_25170":1968,"_17548":47041,"_5":17443,"_23820":47011,"_2384":47042},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2857":1979,"_25170":1968,"_17548":47044,"_5":17443,"_23820":47011,"_2384":47045},[],"`crl_options` field",{"_2857":1980,"_25170":1968,"_17548":47047,"_5":17443,"_23820":47011,"_2384":41231},[],{"_2857":1981,"_25170":1968,"_17548":47049,"_5":17443,"_23820":47011,"_2384":47050},[],"Backend initial value",{"_2857":1982,"_25170":1968,"_17548":47052,"_5":17443,"_23820":47011,"_2384":47053},[],"`validity`",{"_2857":1983,"_25170":1968,"_17548":47055,"_5":17443,"_23820":47011,"_2384":47056},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2857":1984,"_25170":1968,"_17548":47058,"_5":17443,"_23820":47011,"_2384":47059},[],"7 days.",{"_2857":1985,"_25170":1968,"_17548":47061,"_5":17443,"_23820":47011,"_2384":47062},[],"`refresh_interval`",{"_2857":1986,"_25170":1968,"_17548":47064,"_5":17443,"_23820":47011,"_2384":47065},[],"Time since publication that triggers scheduled renewal.",{"_2857":1987,"_25170":1968,"_17548":47067,"_5":17443,"_23820":47011,"_2384":47068},[],"6 days and 23 hours.",{"_2857":1988,"_25170":1968,"_17548":47070,"_5":17443,"_23820":47011,"_2384":47071},[],"`regenerate_on_revoke`",{"_2857":1989,"_25170":1968,"_17548":47073,"_5":17443,"_23820":47011,"_2384":47074},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2857":1990,"_25170":1968,"_17548":47076,"_5":17443,"_23820":47011,"_2384":47077},[],"`true`.",{"_2857":1991,"_25170":1968,"_17548":47079,"_5":17443,"_23820":47011,"_2384":47080},[],"`subject_key_id_signer`",{"_2857":1992,"_25170":1968,"_17548":47082,"_5":17443,"_23820":47011,"_2384":47083},[],"Configuration field initialized with the CA’s SKI.",{"_2857":1993,"_25170":1968,"_17548":47085,"_5":17443,"_23820":47011,"_2384":47086},[],"CA SKI.",{"_2857":1994,"_25170":1968,"_17548":47088,"_5":17443,"_23820":47011,"_2384":47089},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2857":1995,"_25170":1968,"_17548":47091,"_5":17443,"_23820":47011,"_2384":47092},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2857":1996,"_25170":1968,"_17548":47094,"_5":17443,"_23820":47015,"_2384":47095},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2857":1997,"_25170":1968,"_17548":47097,"_5":17443,"_23820":47015,"_2384":47098},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2857":1998,"_25170":1968,"_17548":47100,"_5":17443,"_23820":47015,"_2384":47101},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2857":1999,"_25170":1968,"_17548":47103,"_5":17443,"_23820":47019,"_2384":47104},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2857":2000,"_25170":1968,"_17548":47106,"_5":17443,"_23820":47019,"_2384":47107},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2857":2001,"_25170":1968,"_17548":47109,"_5":17443,"_23820":47023,"_2384":47110},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2857":2002,"_25170":1968,"_17548":47112,"_5":17443,"_23820":47023,"_2384":47113},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2857":2003,"_25170":1968,"_17548":47115,"_5":17443,"_23820":47023,"_2384":47116},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2857":2004,"_25170":1968,"_17548":47118,"_5":17443,"_23820":47023,"_2384":47119},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2857":2005,"_25170":1968,"_17548":47121,"_5":17443,"_23820":47023,"_2384":47122},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2857":2006,"_25170":1968,"_17548":47124,"_5":17443,"_23820":47027,"_2384":47125},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2857":2007,"_25170":1968,"_17548":47127,"_5":17443,"_23820":47027,"_2384":43916},[],{"_2857":2008,"_25170":1968,"_17548":47129,"_5":17443,"_23820":47027,"_2384":47130},[],"Relative path",{"_2857":2009,"_25170":1968,"_17548":47132,"_5":17443,"_23820":47027,"_2384":43913},[],{"_2857":2010,"_25170":1968,"_17548":47134,"_5":17443,"_23820":47027,"_2384":47135},[],"`GET`",{"_2857":2011,"_25170":1968,"_17548":47137,"_5":17443,"_23820":47027,"_2384":47138},[],"`/v1/roles/{ca-ski}`",{"_2857":2012,"_25170":1968,"_17548":47140,"_5":17443,"_23820":47027,"_2384":47141},[],"Read `crl_options` and `latest_crl`.",{"_2857":2013,"_25170":1968,"_17548":47143,"_5":17443,"_23820":47027,"_2384":47144},[],"`PUT`",{"_2857":2014,"_25170":1968,"_17548":47146,"_5":17443,"_23820":47027,"_2384":47138},[],{"_2857":2015,"_25170":1968,"_17548":47148,"_5":17443,"_23820":47027,"_2384":47149},[],"Replace CRL configuration.",{"_2857":2016,"_25170":1968,"_17548":47151,"_5":17443,"_23820":47027,"_2384":47152},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2857":2017,"_25170":1968,"_17548":47154,"_5":17443,"_23820":47027,"_2384":47155},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2857":2018,"_25170":1968,"_17548":47157,"_5":17443,"_23820":47031,"_2384":47158},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2857":2019,"_25170":1968,"_17548":47160,"_5":17443,"_23820":47035,"_2384":47161},[],"RFC 5280: X.509 and CRL profile.",{"_2857":2020,"_25170":1968,"_17548":47163,"_5":17443,"_23820":47035,"_2384":47164},[],"OpenSSL: openssl-crl.",{"_2857":2021,"_25170":1968,"_17548":47166,"_5":17443,"_23820":47035,"_2384":47167},[],"OpenSSL: openssl-verify.",{"_2857":2022,"_25170":1968,"_17548":47169,"_5":17443,"_23820":47035,"_2384":47170},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":2023,"_25170":1968,"_17548":47172,"_5":17443,"_23820":47035,"_2384":47173},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2857":2024,"_25170":2024,"_5":12294,"_2384":47175,"_25506":47176,"_17548":47177,"_23820":2024},"Keys and cryptographic engines",[40848,42192,45873,45874],[],{"_2857":2025,"_25170":2024,"_17548":47179,"_5":17443,"_23820":2024,"_2384":47180},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2857":2026,"_25170":2024,"_5":25503,"_17548":47182,"_23820":47183,"_2384":47184},[],"/docs/pr-preview/pr-38/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2857":2027,"_25170":2024,"_5":25503,"_17548":47186,"_23820":47187,"_2384":47188},[],"/docs/pr-preview/pr-38/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2857":2028,"_25170":2024,"_5":25503,"_17548":47190,"_23820":47191,"_2384":47192},[],"/docs/pr-preview/pr-38/platform/pki/key-management#file-system","File System",{"_2857":2029,"_25170":2024,"_5":25503,"_17548":47194,"_23820":47195,"_2384":47196},[],"/docs/pr-preview/pr-38/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2857":2030,"_25170":2024,"_5":25503,"_17548":47198,"_23820":47199,"_2384":47200},[],"/docs/pr-preview/pr-38/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2857":2031,"_25170":2024,"_5":25503,"_17548":47202,"_23820":47203,"_2384":47204},[],"/docs/pr-preview/pr-38/platform/pki/key-management#aws-kms","AWS KMS",{"_2857":2032,"_25170":2024,"_5":25503,"_17548":47206,"_23820":47207,"_2384":47208},[],"/docs/pr-preview/pr-38/platform/pki/key-management#pkcs11","PKCS#11",{"_2857":2033,"_25170":2024,"_5":25503,"_17548":47210,"_23820":47211,"_2384":47212},[],"/docs/pr-preview/pr-38/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2857":2034,"_25170":2024,"_5":25503,"_17548":47214,"_23820":47215,"_2384":47216},[],"/docs/pr-preview/pr-38/platform/pki/key-management#key-inventory","Key inventory",{"_2857":2035,"_25170":2024,"_5":25503,"_17548":47218,"_23820":47219,"_2384":47220},[],"/docs/pr-preview/pr-38/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2857":2036,"_25170":2024,"_5":25503,"_17548":47222,"_23820":47223,"_2384":47224},[],"/docs/pr-preview/pr-38/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2857":2037,"_25170":2024,"_5":25503,"_17548":47226,"_23820":47227,"_2384":47228},[],"/docs/pr-preview/pr-38/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2857":2038,"_25170":2024,"_5":25503,"_17548":47230,"_23820":47231,"_2384":47232},[],"/docs/pr-preview/pr-38/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2857":2039,"_25170":2024,"_5":25503,"_17548":47234,"_23820":47235,"_2384":47236},[],"/docs/pr-preview/pr-38/platform/pki/key-management#view-details","View details",{"_2857":2040,"_25170":2024,"_5":25503,"_17548":47238,"_23820":47239,"_2384":47240},[],"/docs/pr-preview/pr-38/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2857":2041,"_25170":2024,"_5":25503,"_17548":47242,"_23820":47243,"_2384":47244},[],"/docs/pr-preview/pr-38/platform/pki/key-management#sign","Sign",{"_2857":2042,"_25170":2024,"_5":25503,"_17548":47246,"_23820":47247,"_2384":47248},[],"/docs/pr-preview/pr-38/platform/pki/key-management#verify","Verify",{"_2857":2043,"_25170":2024,"_5":25503,"_17548":47250,"_23820":47251,"_2384":47252},[],"/docs/pr-preview/pr-38/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2857":2044,"_25170":2024,"_5":25503,"_17548":47254,"_23820":47255,"_2384":47256},[],"/docs/pr-preview/pr-38/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2857":2045,"_25170":2024,"_5":25503,"_17548":47258,"_23820":47259,"_2384":47260},[],"/docs/pr-preview/pr-38/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2857":2046,"_25170":2024,"_17548":47262,"_5":17443,"_23820":2024,"_2384":47263},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2857":2047,"_25170":2024,"_17548":47265,"_5":17443,"_23820":2024,"_2384":47266},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2857":2048,"_25170":2024,"_17548":47268,"_5":17443,"_23820":47183,"_2384":47269},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2857":2049,"_25170":2024,"_17548":47271,"_5":17443,"_23820":47183,"_2384":47272},[],"In practice, it lets you:",{"_2857":2050,"_25170":2024,"_17548":47274,"_5":17443,"_23820":47183,"_2384":47275},[],"Generate new key pairs from Lamassu IoT.",{"_2857":2051,"_25170":2024,"_17548":47277,"_5":17443,"_23820":47183,"_2384":47278},[],"Import keys created externally.",{"_2857":2052,"_25170":2024,"_17548":47280,"_5":17443,"_23820":47183,"_2384":47281},[],"Delegate custody and cryptographic operations to external engines.",{"_2857":2053,"_25170":2024,"_17548":47283,"_5":17443,"_23820":47183,"_2384":47284},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2857":2054,"_25170":2024,"_17548":47286,"_5":17443,"_23820":47187,"_2384":47287},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2857":2055,"_25170":2024,"_17548":47289,"_5":17443,"_23820":47187,"_2384":47290},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2857":2056,"_25170":2024,"_17548":47292,"_5":17443,"_23820":47187,"_2384":47293},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2857":2057,"_25170":2024,"_17548":47295,"_5":17443,"_23820":47191,"_2384":47296},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2857":2058,"_25170":2024,"_17548":47298,"_5":17443,"_23820":47195,"_2384":47299},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2857":2059,"_25170":2024,"_17548":47301,"_5":17443,"_23820":47199,"_2384":47302},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2857":2060,"_25170":2024,"_17548":47304,"_5":17443,"_23820":47203,"_2384":47305},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2857":2061,"_25170":2024,"_17548":47307,"_5":17443,"_23820":47207,"_2384":47308},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2857":2062,"_25170":2024,"_17548":47310,"_5":17443,"_23820":47211,"_2384":47311},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2857":2063,"_25170":2024,"_17548":47313,"_5":17443,"_23820":47211,"_2384":47314},[],"Lamassu shows the enabled engines in the console.",{"_2857":2064,"_25170":2024,"_17548":47316,"_5":17443,"_23820":47211,"_2384":47317},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2857":2065,"_25170":2024,"_17548":47319,"_5":17443,"_23820":47211,"_2384":47320},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2857":2066,"_25170":2024,"_17548":47322,"_5":17443,"_23820":47215,"_2384":47323},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2857":2067,"_25170":2024,"_17548":47325,"_5":17443,"_23820":47215,"_2384":47326},[],"The table includes the following fields:",{"_2857":2068,"_25170":2024,"_17548":47328,"_5":17443,"_23820":47215,"_2384":47329},[],"**Name**: descriptive name of the key.",{"_2857":2069,"_25170":2024,"_17548":47331,"_5":17443,"_23820":47215,"_2384":47332},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2857":2070,"_25170":2024,"_17548":47334,"_5":17443,"_23820":47215,"_2384":47335},[],"**Strength**: visual indicator of cryptographic strength.",{"_2857":2071,"_25170":2024,"_17548":47337,"_5":17443,"_23820":47215,"_2384":47338},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2857":2072,"_25170":2024,"_17548":47340,"_5":17443,"_23820":47215,"_2384":47341},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2857":2073,"_25170":2024,"_17548":47343,"_5":17443,"_23820":47215,"_2384":47344},[],"**Aliases**: alternative names associated with the key.",{"_2857":2074,"_25170":2024,"_17548":47346,"_5":17443,"_23820":47215,"_2384":47347},[],"**Tags**: labels for classification and search.",{"_2857":2075,"_25170":2024,"_17548":47349,"_5":17443,"_23820":47215,"_2384":47350},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2857":2076,"_25170":2024,"_17548":47352,"_5":17443,"_23820":47215,"_2384":47353},[],"From this view you also reach the most common actions:",{"_2857":2077,"_25170":2024,"_17548":47355,"_5":17443,"_23820":47215,"_2384":47356},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2857":2078,"_25170":2024,"_17548":47358,"_5":17443,"_23820":47215,"_2384":47359},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2857":2079,"_25170":2024,"_17548":47361,"_5":17443,"_23820":47215,"_2384":47362},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2857":2080,"_25170":2024,"_17548":47364,"_5":17443,"_23820":47215,"_2384":47365},[],"**Delete Key** to remove the key from the system.",{"_2857":2081,"_25170":2024,"_17548":47367,"_5":17443,"_23820":47219,"_2384":47368},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2857":2082,"_25170":2024,"_17548":47370,"_5":17443,"_23820":47223,"_2384":47371},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2857":2083,"_25170":2024,"_17548":47373,"_5":17443,"_23820":47223,"_2384":47374},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2857":2084,"_25170":2024,"_17548":47376,"_5":17443,"_23820":47223,"_2384":47377},[],"**Key Name**: unique and descriptive name.",{"_2857":2085,"_25170":2024,"_17548":47379,"_5":17443,"_23820":47223,"_2384":47380},[],"**Crypto Engine**: engine that will keep the key.",{"_2857":2086,"_25170":2024,"_17548":47382,"_5":17443,"_23820":47223,"_2384":47383},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2857":2087,"_25170":2024,"_17548":47385,"_5":17443,"_23820":47223,"_2384":47386},[],"**Tags**: metadata to classify the key.",{"_2857":2088,"_25170":2024,"_17548":47388,"_5":17443,"_23820":47223,"_2384":47389},[],"**Metadata**: additional information for advanced uses.",{"_2857":2089,"_25170":2024,"_17548":47391,"_5":17443,"_23820":47227,"_2384":47392},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2857":2090,"_25170":2024,"_17548":47394,"_5":17443,"_23820":47227,"_2384":47395},[],"When you have an exportable private key and the destination engine supports import.",{"_2857":2091,"_25170":2024,"_17548":47397,"_5":17443,"_23820":47227,"_2384":47398},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2857":2092,"_25170":2024,"_17548":47400,"_5":17443,"_23820":47227,"_2384":47401},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2857":2093,"_25170":2024,"_17548":47403,"_5":17443,"_23820":47227,"_2384":47404},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2857":2094,"_25170":2024,"_17548":47406,"_5":17443,"_23820":47227,"_2384":47407},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2857":2095,"_25170":2024,"_17548":47409,"_5":17443,"_23820":47227,"_2384":47410},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2857":2096,"_25170":2024,"_17548":47412,"_5":17443,"_23820":47227,"_2384":47413},[],"**Tags**: labels for organization and search.",{"_2857":2097,"_25170":2024,"_17548":47415,"_5":17443,"_23820":47227,"_2384":47416},[],"**Metadata**: additional optional information.",{"_2857":2098,"_25170":2024,"_17548":47418,"_5":17443,"_23820":47227,"_2384":47419},[],"**Private Key (PEM)**: private key in PEM format.",{"_2857":2099,"_25170":2024,"_17548":47421,"_5":17443,"_23820":47227,"_2384":47422},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2857":2100,"_25170":2024,"_17548":47424,"_5":17443,"_23820":47231,"_2384":47425},[],"Each registered key has a detail view and several operational actions.",{"_2857":2101,"_25170":2024,"_17548":47427,"_5":17443,"_23820":47235,"_2384":47428},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2857":2102,"_25170":2024,"_17548":47430,"_5":17443,"_23820":47235,"_2384":47431},[],"The **Overview** tab shows, among others, these fields:",{"_2857":2103,"_25170":2024,"_17548":47433,"_5":17443,"_23820":47235,"_2384":47434},[],"**Key Name**: descriptive name.",{"_2857":2104,"_25170":2024,"_17548":47436,"_5":17443,"_23820":47235,"_2384":47437},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2857":2105,"_25170":2024,"_17548":47439,"_5":17443,"_23820":47235,"_2384":47440},[],"**Tags**: associated labels.",{"_2857":2106,"_25170":2024,"_17548":47442,"_5":17443,"_23820":47235,"_2384":47443},[],"**Aliases**: alternative names.",{"_2857":2107,"_25170":2024,"_17548":47445,"_5":17443,"_23820":47235,"_2384":47446},[],"**Crypto Engine**: engine where the key resides.",{"_2857":2108,"_25170":2024,"_17548":47448,"_5":17443,"_23820":47235,"_2384":47449},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2857":2109,"_25170":2024,"_17548":47451,"_5":17443,"_23820":47235,"_2384":47452},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2857":2110,"_25170":2024,"_17548":47454,"_5":17443,"_23820":47235,"_2384":47455},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2857":2111,"_25170":2024,"_17548":47457,"_5":17443,"_23820":47239,"_2384":47458},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2857":2112,"_25170":2024,"_17548":47460,"_5":17443,"_23820":47239,"_2384":47461},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2857":2113,"_25170":2024,"_17548":47463,"_5":17443,"_23820":47239,"_2384":47464},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2857":2114,"_25170":2024,"_17548":47466,"_5":17443,"_23820":47243,"_2384":47467},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2857":2115,"_25170":2024,"_17548":47469,"_5":17443,"_23820":47243,"_2384":47470},[],"Main fields:",{"_2857":2116,"_25170":2024,"_17548":47472,"_5":17443,"_23820":47243,"_2384":47473},[],"**Algorithm**: signing algorithm available for the key type.",{"_2857":2117,"_25170":2024,"_17548":47475,"_5":17443,"_23820":47243,"_2384":47476},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2857":2118,"_25170":2024,"_17548":47478,"_5":17443,"_23820":47243,"_2384":47479},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2857":2119,"_25170":2024,"_17548":47481,"_5":17443,"_23820":47243,"_2384":47482},[],"**Message**: content to sign.",{"_2857":2120,"_25170":2024,"_17548":47484,"_5":17443,"_23820":47243,"_2384":47485},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2857":2121,"_25170":2024,"_17548":47487,"_5":17443,"_23820":47247,"_2384":47488},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2857":2122,"_25170":2024,"_17548":47490,"_5":17443,"_23820":47247,"_2384":47470},[],{"_2857":2123,"_25170":2024,"_17548":47492,"_5":17443,"_23820":47247,"_2384":47493},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2857":2124,"_25170":2024,"_17548":47495,"_5":17443,"_23820":47247,"_2384":47496},[],"**Message Type**: `Raw` or `Digest`.",{"_2857":2125,"_25170":2024,"_17548":47498,"_5":17443,"_23820":47247,"_2384":47499},[],"**Payload Encoding**: encoding of the message.",{"_2857":2126,"_25170":2024,"_17548":47501,"_5":17443,"_23820":47247,"_2384":47502},[],"**Message**: original message or hash.",{"_2857":2127,"_25170":2024,"_17548":47504,"_5":17443,"_23820":47247,"_2384":47505},[],"**Signature**: signature to check.",{"_2857":2128,"_25170":2024,"_17548":47507,"_5":17443,"_23820":47247,"_2384":47508},[],"**Result**: indicator of the validation result.",{"_2857":2129,"_25170":2024,"_17548":47510,"_5":17443,"_23820":47251,"_2384":47511},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2857":2130,"_25170":2024,"_17548":47513,"_5":17443,"_23820":47251,"_2384":47514},[],"This flow is useful for:",{"_2857":2131,"_25170":2024,"_17548":47516,"_5":17443,"_23820":47251,"_2384":47517},[],"Requesting certificates from an external CA.",{"_2857":2132,"_25170":2024,"_17548":47519,"_5":17443,"_23820":47251,"_2384":47520},[],"Renewing an identity while keeping the same key.",{"_2857":2133,"_25170":2024,"_17548":47522,"_5":17443,"_23820":47251,"_2384":47523},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2857":2134,"_25170":2024,"_17548":47525,"_5":17443,"_23820":47251,"_2384":47526},[],"**Common Name (CN)**: main name of the identity.",{"_2857":2135,"_25170":2024,"_17548":47528,"_5":17443,"_23820":47251,"_2384":47529},[],"**Organization (O)**: organization or company.",{"_2857":2136,"_25170":2024,"_17548":47531,"_5":17443,"_23820":47251,"_2384":47532},[],"**Organizational Unit (OU)**: department or unit.",{"_2857":2137,"_25170":2024,"_17548":47534,"_5":17443,"_23820":47251,"_2384":47535},[],"**Country (C)**: two-letter country code.",{"_2857":2138,"_25170":2024,"_17548":47537,"_5":17443,"_23820":47251,"_2384":47538},[],"**State / Province (ST)**: state or province.",{"_2857":2139,"_25170":2024,"_17548":47540,"_5":17443,"_23820":47251,"_2384":47541},[],"**Locality (L)**: city or locality.",{"_2857":2140,"_25170":2024,"_17548":47543,"_5":17443,"_23820":47251,"_2384":47544},[],"**Email Address**: contact email.",{"_2857":2141,"_25170":2024,"_17548":47546,"_5":17443,"_23820":47251,"_2384":47547},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2857":2142,"_25170":2024,"_17548":47549,"_5":17443,"_23820":47251,"_2384":47550},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2857":2143,"_25170":2024,"_17548":47552,"_5":17443,"_23820":47255,"_2384":47553},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2857":2144,"_25170":2024,"_17548":47555,"_5":17443,"_23820":47255,"_2384":47556},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2857":2145,"_25170":2024,"_17548":47558,"_5":17443,"_23820":47259,"_2384":47559},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2857":2146,"_25170":2146,"_5":12294,"_2384":47561,"_25506":47562,"_17548":47563,"_23820":2146},"Online validation with OCSP",[40848,42192,45873,46490],[],{"_2857":2147,"_25170":2146,"_17548":47565,"_5":17443,"_23820":2146,"_2384":47566},[],"Query signed status and verify the responder’s response.",{"_2857":2148,"_25170":2146,"_5":25503,"_17548":47568,"_23820":47569,"_2384":47570},[],"/docs/pr-preview/pr-38/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2857":2149,"_25170":2146,"_5":25503,"_17548":47572,"_23820":47573,"_2384":47574},[],"/docs/pr-preview/pr-38/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2857":2150,"_25170":2146,"_5":25503,"_17548":47576,"_23820":47577,"_2384":47578},[],"/docs/pr-preview/pr-38/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2857":2151,"_25170":2146,"_5":25503,"_17548":47580,"_23820":47581,"_2384":47582},[],"/docs/pr-preview/pr-38/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2857":2152,"_25170":2146,"_5":25503,"_17548":47584,"_23820":47585,"_2384":47586},[],"/docs/pr-preview/pr-38/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2857":2153,"_25170":2146,"_5":25503,"_17548":47588,"_23820":47589,"_2384":47036},[],"/docs/pr-preview/pr-38/platform/pki/ocsp#references",{"_2857":2154,"_25170":2146,"_17548":47591,"_5":17443,"_23820":2146,"_2384":47592},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2857":2155,"_25170":2146,"_17548":47594,"_5":17443,"_23820":47569,"_2384":47595},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2857":2156,"_25170":2146,"_17548":47597,"_5":17443,"_23820":47569,"_2384":47598},[],"Record status",{"_2857":2157,"_25170":2146,"_17548":47600,"_5":17443,"_23820":47569,"_2384":47601},[],"Signed response",{"_2857":2158,"_25170":2146,"_17548":47603,"_5":17443,"_23820":47569,"_2384":45051},[],{"_2857":2159,"_25170":2146,"_17548":47605,"_5":17443,"_23820":47569,"_2384":47606},[],"`Good`.",{"_2857":2160,"_25170":2146,"_17548":47608,"_5":17443,"_23820":47569,"_2384":45068},[],{"_2857":2161,"_25170":2146,"_17548":47610,"_5":17443,"_23820":47569,"_2384":47611},[],"`Revoked`, with revocation reason and timestamp.",{"_2857":2162,"_25170":2146,"_17548":47613,"_5":17443,"_23820":47569,"_2384":47614},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2857":2163,"_25170":2146,"_17548":47616,"_5":17443,"_23820":47569,"_2384":47617},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2857":2164,"_25170":2146,"_17548":47619,"_5":17443,"_23820":47569,"_2384":47620},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2857":2165,"_25170":2146,"_17548":47622,"_5":17443,"_23820":47569,"_2384":47623},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2857":2166,"_25170":2146,"_17548":47625,"_5":17443,"_23820":47569,"_2384":47626},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2857":2167,"_25170":2146,"_17548":47628,"_5":17443,"_23820":47573,"_2384":47629},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2857":2168,"_25170":2146,"_17548":47631,"_5":17443,"_23820":47573,"_2384":47632},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2857":2169,"_25170":2146,"_17548":47634,"_5":17443,"_23820":47577,"_2384":47635},[],"The service accepts:",{"_2857":2170,"_25170":2146,"_17548":47637,"_5":17443,"_23820":47577,"_2384":43916},[],{"_2857":2171,"_25170":2146,"_17548":47639,"_5":17443,"_23820":47577,"_2384":47640},[],"VA service path",{"_2857":2172,"_25170":2146,"_17548":47642,"_5":17443,"_23820":47577,"_2384":47643},[],"Format",{"_2857":2173,"_25170":2146,"_17548":47645,"_5":17443,"_23820":47577,"_2384":47646},[],"`POST`",{"_2857":2174,"_25170":2146,"_17548":47648,"_5":17443,"_23820":47577,"_2384":47649},[],"`/ocsp`",{"_2857":2175,"_25170":2146,"_17548":47651,"_5":17443,"_23820":47577,"_2384":47652},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2857":2176,"_25170":2146,"_17548":47654,"_5":17443,"_23820":47577,"_2384":47135},[],{"_2857":2177,"_25170":2146,"_17548":47656,"_5":17443,"_23820":47577,"_2384":47657},[],"`/ocsp/{ocsp_request}`",{"_2857":2178,"_25170":2146,"_17548":47659,"_5":17443,"_23820":47577,"_2384":47660},[],"DER request encoded using padded URL Base64.",{"_2857":2179,"_25170":2146,"_17548":47662,"_5":17443,"_23820":47577,"_2384":47663},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2857":2180,"_25170":2146,"_17548":47665,"_5":17443,"_23820":47581,"_2384":47666},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2857":2181,"_25170":2146,"_17548":47668,"_5":17443,"_23820":47581,"_2384":47669},[],"Generate the request:",{"_2857":2182,"_25170":2146,"_17548":47671,"_5":17443,"_23820":47581,"_2384":47672},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2857":2183,"_25170":2146,"_17548":47674,"_5":17443,"_23820":47581,"_2384":47675},[],"Replace the example URL with the inspected endpoint:",{"_2857":2184,"_25170":2146,"_17548":47677,"_5":17443,"_23820":47581,"_2384":47678},[],"Verify the returned DER:",{"_2857":2185,"_25170":2146,"_17548":47680,"_5":17443,"_23820":47581,"_2384":47681},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2857":2186,"_25170":2146,"_17548":47683,"_5":17443,"_23820":47585,"_2384":47684},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2857":2187,"_25170":2146,"_17548":47686,"_5":17443,"_23820":47585,"_2384":47687},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2857":2188,"_25170":2146,"_17548":47689,"_5":17443,"_23820":47589,"_2384":47690},[],"RFC 6960: OCSP.",{"_2857":2189,"_25170":2146,"_17548":47692,"_5":17443,"_23820":47589,"_2384":47693},[],"OpenSSL: openssl-ocsp.",{"_2857":2190,"_25170":2146,"_17548":47695,"_5":17443,"_23820":47589,"_2384":47696},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2857":2191,"_25170":2146,"_17548":47698,"_5":17443,"_23820":47589,"_2384":47173},[],{"_2857":2192,"_25170":2192,"_5":12294,"_2384":45873,"_25506":47700,"_17548":47701,"_23820":2192},[40848,42192,45873],[],{"_2857":2193,"_25170":2192,"_17548":47703,"_5":17443,"_23820":2192,"_2384":47704},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2857":2194,"_25170":2192,"_5":25503,"_17548":47706,"_23820":47707,"_2384":45183},[],"/docs/pr-preview/pr-38/platform/pki/overview#start-here",{"_2857":2195,"_25170":2192,"_5":25503,"_17548":47709,"_23820":47710,"_2384":47711},[],"/docs/pr-preview/pr-38/platform/pki/overview#what-you-need","What you need",{"_2857":2196,"_25170":2192,"_5":25503,"_17548":47713,"_23820":47714,"_2384":45717},[],"/docs/pr-preview/pr-38/platform/pki/overview#core-capabilities",{"_2857":2197,"_25170":2192,"_5":25503,"_17548":47716,"_23820":47717,"_2384":45721},[],"/docs/pr-preview/pr-38/platform/pki/overview#build-your-trust-hierarchy",{"_2857":2198,"_25170":2192,"_5":25503,"_17548":47719,"_23820":47720,"_2384":45725},[],"/docs/pr-preview/pr-38/platform/pki/overview#protect-cryptographic-keys",{"_2857":2199,"_25170":2192,"_5":25503,"_17548":47722,"_23820":47723,"_2384":45729},[],"/docs/pr-preview/pr-38/platform/pki/overview#issue-and-control-certificates",{"_2857":2200,"_25170":2192,"_5":25503,"_17548":47725,"_23820":47726,"_2384":45737},[],"/docs/pr-preview/pr-38/platform/pki/overview#publish-validation-status",{"_2857":2201,"_25170":2192,"_5":25503,"_17548":47728,"_23820":47729,"_2384":47730},[],"/docs/pr-preview/pr-38/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2857":2202,"_25170":2192,"_5":25503,"_17548":47732,"_23820":47733,"_2384":46657},[],"/docs/pr-preview/pr-38/platform/pki/overview#continue",{"_2857":2203,"_25170":2192,"_17548":47735,"_5":17443,"_23820":2192,"_2384":47736},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2857":2204,"_25170":2192,"_17548":47738,"_5":17443,"_23820":47707,"_2384":47739},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2857":2205,"_25170":2192,"_17548":47741,"_5":17443,"_23820":47707,"_2384":47742},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2857":2206,"_25170":2192,"_17548":47744,"_5":17443,"_23820":47710,"_2384":47745},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2857":2207,"_25170":2192,"_17548":47747,"_5":17443,"_23820":47710,"_2384":47748},[],"An available cryptographic engine to keep the authority's key.",{"_2857":2208,"_25170":2192,"_17548":47750,"_5":17443,"_23820":47710,"_2384":47751},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2857":2209,"_25170":2192,"_17548":47753,"_5":17443,"_23820":47710,"_2384":47754},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2857":2210,"_25170":2192,"_17548":47756,"_5":17443,"_23820":47710,"_2384":47757},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2857":2211,"_25170":2192,"_17548":47759,"_5":17443,"_23820":47717,"_2384":47760},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2857":2212,"_25170":2192,"_17548":47762,"_5":17443,"_23820":47720,"_2384":47763},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2857":2213,"_25170":2192,"_17548":47765,"_5":17443,"_23820":47723,"_2384":47766},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2857":2214,"_25170":2192,"_17548":47768,"_5":17443,"_23820":47726,"_2384":47769},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2857":2215,"_25170":2192,"_17548":47771,"_5":17443,"_23820":47729,"_2384":47772},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2857":2216,"_25170":2192,"_17548":47774,"_5":17443,"_23820":47729,"_2384":47775},[],"its subject and extensions identify the expected client;",{"_2857":2217,"_25170":2192,"_17548":47777,"_5":17443,"_23820":47729,"_2384":47778},[],"its public key matches the client's private key;",{"_2857":2218,"_25170":2192,"_17548":47780,"_5":17443,"_23820":47729,"_2384":47781},[],"its chain reaches a root trusted by the consumer;",{"_2857":2219,"_25170":2192,"_17548":47783,"_5":17443,"_23820":47729,"_2384":47784},[],"its dates and usages allow the operation;",{"_2857":2220,"_25170":2192,"_17548":47786,"_5":17443,"_23820":47729,"_2384":47787},[],"the consumer applies revocation checks and authorization.",{"_2857":2221,"_25170":2192,"_17548":47789,"_5":17443,"_23820":47729,"_2384":47790},[],"The issuance path includes the first independent checks.",{"_2857":2222,"_25170":2192,"_17548":47792,"_5":17443,"_23820":47733,"_2384":47793},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2857":2223,"_25170":2192,"_17548":47795,"_5":17443,"_23820":47733,"_2384":47796},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2857":2224,"_25170":2192,"_17548":47798,"_5":17443,"_23820":47733,"_2384":47799},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2857":2225,"_25170":2225,"_5":12294,"_2384":47801,"_25506":47802,"_17548":47803,"_23820":2225},"Create your first CA",[40848,42192,45873,45308],[],{"_2857":2226,"_25170":2225,"_17548":47805,"_5":17443,"_23820":2225,"_2384":47806},[],"Create an evaluation root and check its certificate before issuing.",{"_2857":2227,"_25170":2225,"_5":25503,"_17548":47808,"_23820":47809,"_2384":40858},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2857":2228,"_25170":2225,"_5":25503,"_17548":47811,"_23820":47812,"_2384":47813},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2857":2229,"_25170":2225,"_5":25503,"_17548":47815,"_23820":47816,"_2384":47817},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2857":2230,"_25170":2225,"_5":25503,"_17548":47819,"_23820":47820,"_2384":47821},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2857":2231,"_25170":2225,"_5":25503,"_17548":47823,"_23820":47824,"_2384":47825},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2857":2232,"_25170":2225,"_5":25503,"_17548":47827,"_23820":47828,"_2384":47829},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2857":2233,"_25170":2225,"_5":25503,"_17548":47831,"_23820":47832,"_2384":47833},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2857":2234,"_25170":2225,"_5":25503,"_17548":47835,"_23820":47836,"_2384":45566},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2857":2235,"_25170":2225,"_5":25503,"_17548":47838,"_23820":47839,"_2384":40882},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2857":2236,"_25170":2225,"_17548":47841,"_5":17443,"_23820":2225,"_2384":47842},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2857":2237,"_25170":2225,"_17548":47844,"_5":17443,"_23820":47809,"_2384":47845},[],"Console access and permission to create keys and authorities.",{"_2857":2238,"_25170":2225,"_17548":47847,"_5":17443,"_23820":47809,"_2384":47848},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2857":2239,"_25170":2225,"_17548":47850,"_5":17443,"_23820":47809,"_2384":47851},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2857":2240,"_25170":2225,"_17548":47853,"_5":17443,"_23820":47809,"_2384":47854},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2857":2241,"_25170":2225,"_17548":47856,"_5":17443,"_23820":47812,"_2384":47857},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2857":2242,"_25170":2225,"_17548":47859,"_5":17443,"_23820":47812,"_2384":47860},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2857":2243,"_25170":2225,"_17548":47862,"_5":17443,"_23820":47816,"_2384":47863},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2857":2244,"_25170":2225,"_17548":47865,"_5":17443,"_23820":47816,"_2384":47866},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2857":2245,"_25170":2225,"_17548":47868,"_5":17443,"_23820":47820,"_2384":47869},[],"Select **Root CA** and complete:",{"_2857":2246,"_25170":2225,"_17548":47871,"_5":17443,"_23820":47820,"_2384":47872},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2857":2247,"_25170":2225,"_17548":47874,"_5":17443,"_23820":47820,"_2384":47875},[],"**Subject**: organization and country details for your evaluation.",{"_2857":2248,"_25170":2225,"_17548":47877,"_5":17443,"_23820":47820,"_2384":47878},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2857":2249,"_25170":2225,"_17548":47880,"_5":17443,"_23820":47820,"_2384":47881},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2857":2250,"_25170":2225,"_17548":47883,"_5":17443,"_23820":47820,"_2384":47884},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2857":2251,"_25170":2225,"_17548":47886,"_5":17443,"_23820":47824,"_2384":47887},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2857":2252,"_25170":2225,"_17548":47889,"_5":17443,"_23820":47828,"_2384":47890},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2857":2253,"_25170":2225,"_17548":47892,"_5":17443,"_23820":47828,"_2384":47893},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2857":2254,"_25170":2225,"_17548":47895,"_5":17443,"_23820":47832,"_2384":47896},[],"Run from the directory where you saved `ca.pem`:",{"_2857":2255,"_25170":2225,"_17548":47898,"_5":17443,"_23820":47832,"_2384":47899},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2857":2256,"_25170":2225,"_17548":47901,"_5":17443,"_23820":47832,"_2384":47902},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2857":2257,"_25170":2225,"_17548":47904,"_5":17443,"_23820":47836,"_2384":47905},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2857":2258,"_25170":2225,"_17548":47907,"_5":17443,"_23820":47836,"_2384":47908},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2857":2259,"_25170":2225,"_17548":47910,"_5":17443,"_23820":47836,"_2384":47911},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2857":2260,"_25170":2225,"_17548":47913,"_5":17443,"_23820":47836,"_2384":47914},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2857":2261,"_25170":2225,"_17548":47916,"_5":17443,"_23820":47839,"_2384":47917},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2857":2262,"_25170":2262,"_5":12294,"_2384":47919,"_25506":47920,"_17548":47921,"_23820":2262},"Issue and verify a certificate",[40848,42192,45873,45308],[],{"_2857":2263,"_25170":2262,"_17548":47923,"_5":17443,"_23820":2262,"_2384":47924},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2857":2264,"_25170":2262,"_5":25503,"_17548":47926,"_23820":47927,"_2384":40858},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2857":2265,"_25170":2262,"_5":25503,"_17548":47929,"_23820":47930,"_2384":47931},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2857":2266,"_25170":2262,"_5":25503,"_17548":47933,"_23820":47934,"_2384":47935},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2857":2267,"_25170":2262,"_5":25503,"_17548":47937,"_23820":47938,"_2384":47939},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2857":2268,"_25170":2262,"_5":25503,"_17548":47941,"_23820":47942,"_2384":47943},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2857":2269,"_25170":2262,"_5":25503,"_17548":47945,"_23820":47946,"_2384":47947},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2857":2270,"_25170":2262,"_5":25503,"_17548":47949,"_23820":47950,"_2384":47829},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2857":2271,"_25170":2262,"_5":25503,"_17548":47952,"_23820":47953,"_2384":47954},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2857":2272,"_25170":2262,"_5":25503,"_17548":47956,"_23820":47957,"_2384":47958},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2857":2273,"_25170":2262,"_5":25503,"_17548":47960,"_23820":47961,"_2384":47962},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2857":2274,"_25170":2262,"_5":25503,"_17548":47964,"_23820":47965,"_2384":45566},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2857":2275,"_25170":2262,"_5":25503,"_17548":47967,"_23820":47968,"_2384":40882},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/issue-certificate#next-step",{"_2857":2276,"_25170":2262,"_17548":47970,"_5":17443,"_23820":2262,"_2384":47971},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2857":2277,"_25170":2262,"_17548":47973,"_5":17443,"_23820":47927,"_2384":47974},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2857":2278,"_25170":2262,"_17548":47976,"_5":17443,"_23820":47927,"_2384":47977},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2857":2279,"_25170":2262,"_17548":47979,"_5":17443,"_23820":47927,"_2384":47980},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2857":2280,"_25170":2262,"_17548":47982,"_5":17443,"_23820":47927,"_2384":47983},[],"A client identifier: here we use `device-001`.",{"_2857":2281,"_25170":2262,"_17548":47985,"_5":17443,"_23820":47927,"_2384":47986},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2857":2282,"_25170":2262,"_17548":47988,"_5":17443,"_23820":47930,"_2384":47989},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2857":2283,"_25170":2262,"_17548":47991,"_5":17443,"_23820":47934,"_2384":47992},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2857":2284,"_25170":2262,"_17548":47994,"_5":17443,"_23820":47934,"_2384":47995},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2857":2285,"_25170":2262,"_17548":47997,"_5":17443,"_23820":47938,"_2384":47998},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2857":2286,"_25170":2262,"_17548":48000,"_5":17443,"_23820":47938,"_2384":48001},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2857":2287,"_25170":2262,"_17548":48003,"_5":17443,"_23820":47942,"_2384":48004},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2857":2288,"_25170":2262,"_17548":48006,"_5":17443,"_23820":47942,"_2384":48007},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2857":2289,"_25170":2262,"_17548":48009,"_5":17443,"_23820":47946,"_2384":48010},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2857":2290,"_25170":2262,"_17548":48012,"_5":17443,"_23820":47950,"_2384":48013},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2857":2291,"_25170":2262,"_17548":48015,"_5":17443,"_23820":47953,"_2384":48016},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2857":2292,"_25170":2262,"_17548":48018,"_5":17443,"_23820":47957,"_2384":48019},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2857":2293,"_25170":2262,"_17548":48021,"_5":17443,"_23820":47957,"_2384":48022},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2857":2294,"_25170":2262,"_17548":48024,"_5":17443,"_23820":47957,"_2384":48025},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2857":2295,"_25170":2262,"_17548":48027,"_5":17443,"_23820":47961,"_2384":48028},[],"In Bash, compare the two public-key digests:",{"_2857":2296,"_25170":2262,"_17548":48030,"_5":17443,"_23820":47961,"_2384":48031},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2857":2297,"_25170":2262,"_17548":48033,"_5":17443,"_23820":47961,"_2384":48034},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2857":2298,"_25170":2262,"_17548":48036,"_5":17443,"_23820":47965,"_2384":45650},[],{"_2857":2299,"_25170":2262,"_17548":48038,"_5":17443,"_23820":47965,"_2384":48039},[],"What to review",{"_2857":2300,"_25170":2262,"_17548":48041,"_5":17443,"_23820":47965,"_2384":48042},[],"The CA rejects issuance",{"_2857":2301,"_25170":2262,"_17548":48044,"_5":17443,"_23820":47965,"_2384":48045},[],"Permissions, CA state and key, algorithm and profile.",{"_2857":2302,"_25170":2262,"_17548":48047,"_5":17443,"_23820":47965,"_2384":48048},[],"Different subject or usages",{"_2857":2303,"_25170":2262,"_17548":48050,"_5":17443,"_23820":47965,"_2384":48051},[],"Applied profile and requested values.",{"_2857":2304,"_25170":2262,"_17548":48053,"_5":17443,"_23820":47965,"_2384":48054},[],"Issuer cannot be found",{"_2857":2305,"_25170":2262,"_17548":48056,"_5":17443,"_23820":47965,"_2384":48057},[],"Downloaded CA and required intermediate chain.",{"_2857":2306,"_25170":2262,"_17548":48059,"_5":17443,"_23820":47965,"_2384":48060},[],"Validity fails",{"_2857":2307,"_25170":2262,"_17548":48062,"_5":17443,"_23820":47965,"_2384":48063},[],"Certificate and CA dates, and the computer's clock.",{"_2857":2308,"_25170":2262,"_17548":48065,"_5":17443,"_23820":47965,"_2384":48066},[],"Public-key digests differ",{"_2857":2309,"_25170":2262,"_17548":48068,"_5":17443,"_23820":47965,"_2384":48069},[],"Certificate and key files from the same issuance.",{"_2857":2310,"_25170":2262,"_17548":48071,"_5":17443,"_23820":47965,"_2384":48072},[],"See PKI diagnostics to narrow an issuance failure.",{"_2857":2311,"_25170":2262,"_17548":48074,"_5":17443,"_23820":47968,"_2384":48075},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2857":2312,"_25170":2262,"_17548":48077,"_5":17443,"_23820":47968,"_2384":48078},[],"Manage certificates for inspection, status and revocation.",{"_2857":2313,"_25170":2262,"_17548":48080,"_5":17443,"_23820":47968,"_2384":48081},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2857":2314,"_25170":2262,"_17548":48083,"_5":17443,"_23820":47968,"_2384":48084},[],"Prepare EST for the device to request its next identities.",{"_2857":2315,"_25170":2262,"_17548":48086,"_5":17443,"_23820":47968,"_2384":48087},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2857":2316,"_25170":2316,"_5":12294,"_2384":48089,"_25506":48090,"_17548":48091,"_23820":2316},"PKI getting started",[40848,42192,45873,45308],[],{"_2857":2317,"_25170":2316,"_17548":48093,"_5":17443,"_23820":2316,"_2384":48094},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2857":2318,"_25170":2316,"_5":25503,"_17548":48096,"_23820":48097,"_2384":40858},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#before-you-begin",{"_2857":2319,"_25170":2316,"_5":25503,"_17548":48099,"_23820":48100,"_2384":48101},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2857":2320,"_25170":2316,"_5":25503,"_17548":48103,"_23820":48104,"_2384":45500},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#expected-result",{"_2857":2321,"_25170":2316,"_5":25503,"_17548":48106,"_23820":48107,"_2384":48108},[],"/docs/pr-preview/pr-38/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2857":2322,"_25170":2316,"_17548":48110,"_5":17443,"_23820":2316,"_2384":48111},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2857":2323,"_25170":2316,"_17548":48113,"_5":17443,"_23820":48097,"_2384":48114},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2857":2324,"_25170":2316,"_17548":48116,"_5":17443,"_23820":48097,"_2384":48117},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2857":2325,"_25170":2316,"_17548":48119,"_5":17443,"_23820":48097,"_2384":48120},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2857":2326,"_25170":2316,"_17548":48122,"_5":17443,"_23820":48097,"_2384":48123},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2857":2327,"_25170":2316,"_17548":48125,"_5":17443,"_23820":48097,"_2384":48126},[],"A working directory with restricted access for the downloaded key.",{"_2857":2328,"_25170":2316,"_17548":48128,"_5":17443,"_23820":48100,"_2384":48129},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2857":2329,"_25170":2316,"_17548":48131,"_5":17443,"_23820":48100,"_2384":48132},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2857":2330,"_25170":2316,"_17548":48134,"_5":17443,"_23820":48100,"_2384":48135},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2857":2331,"_25170":2316,"_17548":48137,"_5":17443,"_23820":48100,"_2384":48138},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2857":2332,"_25170":2316,"_17548":48140,"_5":17443,"_23820":48104,"_2384":48141},[],"File or resource",{"_2857":2333,"_25170":2316,"_17548":48143,"_5":17443,"_23820":48104,"_2384":45497},[],{"_2857":2334,"_25170":2316,"_17548":48145,"_5":17443,"_23820":48104,"_2384":48146},[],"Active root CA and `ca.pem`",{"_2857":2335,"_25170":2316,"_17548":48148,"_5":17443,"_23820":48104,"_2384":48149},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2857":2336,"_25170":2316,"_17548":48151,"_5":17443,"_23820":48104,"_2384":48152},[],"End-entity certificate and `device.crt`",{"_2857":2337,"_25170":2316,"_17548":48154,"_5":17443,"_23820":48104,"_2384":48155},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2857":2338,"_25170":2316,"_17548":48157,"_5":17443,"_23820":48104,"_2384":48158},[],"Private key `device.key`",{"_2857":2339,"_25170":2316,"_17548":48160,"_5":17443,"_23820":48104,"_2384":48161},[],"Its public key matches the one included in `device.crt`.",{"_2857":2340,"_25170":2316,"_17548":48163,"_5":17443,"_23820":48104,"_2384":48164},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2857":2341,"_25170":2316,"_17548":48166,"_5":17443,"_23820":48107,"_2384":48167},[],"To operate certificates, continue with Certificates and Validation.",{"_2857":2342,"_25170":2316,"_17548":48169,"_5":17443,"_23820":48107,"_2384":48170},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2857":2343,"_25170":2316,"_17548":48172,"_5":17443,"_23820":48107,"_2384":48173},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2857":2344,"_25170":2344,"_5":12294,"_2384":48175,"_25506":48176,"_17548":48177,"_23820":2344},"PKI troubleshooting",[40848,42192,45873,44694],[],{"_2857":2345,"_25170":2344,"_17548":48179,"_5":17443,"_23820":2344,"_2384":48180},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2857":2346,"_25170":2344,"_5":25503,"_17548":48182,"_23820":48183,"_2384":48184},[],"/docs/pr-preview/pr-38/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2857":2347,"_25170":2344,"_5":25503,"_17548":48186,"_23820":48187,"_2384":48188},[],"/docs/pr-preview/pr-38/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2857":2348,"_25170":2344,"_5":25503,"_17548":48190,"_23820":48191,"_2384":48192},[],"/docs/pr-preview/pr-38/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2857":2349,"_25170":2344,"_17548":48194,"_5":17443,"_23820":2344,"_2384":48195},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2857":2350,"_25170":2344,"_17548":48197,"_5":17443,"_23820":2344,"_2384":48198},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2857":2351,"_25170":2344,"_17548":48200,"_5":17443,"_23820":48183,"_2384":45497},[],{"_2857":2352,"_25170":2344,"_17548":48202,"_5":17443,"_23820":48183,"_2384":48203},[],"What to inspect",{"_2857":2353,"_25170":2344,"_17548":48205,"_5":17443,"_23820":48183,"_2384":40882},[],{"_2857":2354,"_25170":2344,"_17548":48207,"_5":17443,"_23820":48183,"_2384":48208},[],"CA",{"_2857":2355,"_25170":2344,"_17548":48210,"_5":17443,"_23820":48183,"_2384":48211},[],"Exists, is active and has usable dates.",{"_2857":2356,"_25170":2344,"_17548":48213,"_5":17443,"_23820":48183,"_2384":48214},[],"Authorities.",{"_2857":2357,"_25170":2344,"_17548":48216,"_5":17443,"_23820":48183,"_2384":48217},[],"Key",{"_2857":2358,"_25170":2344,"_17548":48219,"_5":17443,"_23820":48183,"_2384":48220},[],"The record has a usable private key and the engine can sign.",{"_2857":2359,"_25170":2344,"_17548":48222,"_5":17443,"_23820":48183,"_2384":48223},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2857":2360,"_25170":2344,"_17548":48225,"_5":17443,"_23820":48183,"_2384":48226},[],"CSR",{"_2857":2361,"_25170":2344,"_17548":48228,"_5":17443,"_23820":48183,"_2384":48229},[],"Correct PEM and verifiable signature.",{"_2857":2362,"_25170":2344,"_17548":48231,"_5":17443,"_23820":48183,"_2384":48232},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2857":2363,"_25170":2344,"_17548":48234,"_5":17443,"_23820":48183,"_2384":48235},[],"Profile",{"_2857":2364,"_25170":2344,"_17548":48237,"_5":17443,"_23820":48183,"_2384":48238},[],"Selected source, existing ID, allowed algorithm and size.",{"_2857":2365,"_25170":2344,"_17548":48240,"_5":17443,"_23820":48183,"_2384":48241},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2857":2366,"_25170":2344,"_17548":48243,"_5":17443,"_23820":48183,"_2384":45650},[],{"_2857":2367,"_25170":2344,"_17548":48245,"_5":17443,"_23820":48183,"_2384":48246},[],"Appropriate subject, SAN, usages and dates.",{"_2857":2368,"_25170":2344,"_17548":48248,"_5":17443,"_23820":48183,"_2384":48249},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2857":2369,"_25170":2344,"_17548":48251,"_5":17443,"_23820":48183,"_2384":48252},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2857":2370,"_25170":2344,"_17548":48254,"_5":17443,"_23820":48183,"_2384":48255},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2857":2371,"_25170":2344,"_17548":48257,"_5":17443,"_23820":48187,"_2384":48258},[],"Check each boundary independently:",{"_2857":2372,"_25170":2344,"_17548":48260,"_5":17443,"_23820":48187,"_2384":48261},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2857":2373,"_25170":2344,"_17548":48263,"_5":17443,"_23820":48187,"_2384":48264},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2857":2374,"_25170":2344,"_17548":48266,"_5":17443,"_23820":48187,"_2384":48267},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2857":2375,"_25170":2344,"_17548":48269,"_5":17443,"_23820":48187,"_2384":48270},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2857":2376,"_25170":2344,"_17548":48272,"_5":17443,"_23820":48187,"_2384":48273},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2857":2377,"_25170":2344,"_17548":48275,"_5":17443,"_23820":48187,"_2384":48276},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2857":2378,"_25170":2344,"_17548":48278,"_5":17443,"_23820":48191,"_2384":48279},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2857":2379,"_25170":2344,"_17548":48281,"_5":17443,"_23820":48191,"_2384":48282},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.","count","sorting",{"_48286":48287,"_48288":48289,"_48290":48291,"_48292":48293,"_15231":2406,"_57767":2406},"language","english","sortableProperties",[2384,25170,5,23820],"sortablePropertiesWithTypes",{"_2384":20963,"_25170":20963,"_5":20963,"_23820":20963},"sorts",{"_2384":48294,"_25170":50663,"_5":53031,"_23820":55399},{"_3827":48295,"_48296":48297,"_5":20963},{"_12039":3897,"_12382":4252,"_12389":4878,"_24371":6578,"_23933":2735,"_16648":9735,"_12060":2822,"_12067":3830,"_24333":2731,"_24683":3653,"_24704":6267,"_24346":11372,"_28968":4754,"_24715":12417,"_28973":24863,"_28976":19871,"_28979":7134,"_28982":6291,"_28985":9488,"_25016":6161,"_28990":6045,"_28992":2648,"_25076":2530,"_25006":6226,"_28996":2697,"_25032":5391,"_29000":7168,"_24733":6153,"_25011":4288,"_25094":3117,"_29005":5567,"_29007":3806,"_29009":3099,"_29011":3062,"_29013":6150,"_29015":5687,"_29017":5167,"_25228":4457,"_29020":5521,"_24384":2835,"_29023":4405,"_29025":2706,"_24378":6259,"_29028":2444,"_29030":3988,"_29032":2445,"_29035":16913,"_24414":4511,"_29039":16914,"_24324":3788,"_29042":10341,"_24351":6268,"_29045":3921,"_29047":5134,"_29050":11856,"_25071":5898,"_29053":2916,"_29055":10353,"_29058":18652,"_29060":3575,"_29062":4155,"_29064":2769,"_29066":6297,"_16651":6321,"_2906