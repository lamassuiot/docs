33657":103202,"_33659":103205,"_33661":103208,"_33663":103211,"_33665":103214,"_33667":103217,"_33669":103220,"_33671":103223,"_33673":103226,"_33675":103229,"_33677":103232},{"_2857":57775,"_25170":57775,"_5":12294,"_2384":95970,"_25506":95971,"_17548":95974,"_23820":57775},"Despliega desde AWS Marketplace",[40849,95972,95973],"Despliegue","Otros modelos",[],{"_2857":57776,"_25170":57775,"_17548":95976,"_5":17443,"_23820":57775,"_2384":95977},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2857":57777,"_25170":57775,"_5":25503,"_17548":95979,"_23820":95980,"_2384":95981},[],"/docs/pr-preview/pr-38/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2857":57778,"_25170":57775,"_5":25503,"_17548":95983,"_23820":95984,"_2384":95985},[],"/docs/pr-preview/pr-38/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2857":57779,"_25170":57775,"_5":25503,"_17548":95987,"_23820":95988,"_2384":95989},[],"/docs/pr-preview/pr-38/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2857":57780,"_25170":57775,"_5":25503,"_17548":95991,"_23820":95992,"_2384":95993},[],"/docs/pr-preview/pr-38/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2857":57781,"_25170":57775,"_5":25503,"_17548":95995,"_23820":95996,"_2384":95997},[],"/docs/pr-preview/pr-38/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2857":57782,"_25170":57775,"_5":25503,"_17548":95999,"_23820":96000,"_2384":96001},[],"/docs/pr-preview/pr-38/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2857":57783,"_25170":57775,"_5":25503,"_17548":96003,"_23820":96004,"_2384":96005},[],"/docs/pr-preview/pr-38/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2857":57784,"_25170":57775,"_17548":96007,"_5":17443,"_23820":57775,"_2384":96008},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2857":57785,"_25170":57775,"_17548":96010,"_5":17443,"_23820":95980,"_2384":96011},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2857":57786,"_25170":57775,"_17548":96013,"_5":17443,"_23820":95980,"_2384":96014},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2857":57787,"_25170":57775,"_17548":96016,"_5":17443,"_23820":95980,"_2384":96017},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2857":57788,"_25170":57775,"_17548":96019,"_5":17443,"_23820":95984,"_2384":96020},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2857":57789,"_25170":57775,"_17548":96022,"_5":17443,"_23820":95984,"_2384":96023},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2857":57790,"_25170":57775,"_17548":96025,"_5":17443,"_23820":95984,"_2384":96026},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2857":57791,"_25170":57775,"_17548":96028,"_5":17443,"_23820":95988,"_2384":96029},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2857":57792,"_25170":57775,"_17548":96031,"_5":17443,"_23820":95992,"_2384":96032},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2857":57793,"_25170":57775,"_17548":96034,"_5":17443,"_23820":95996,"_2384":96035},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2857":57794,"_25170":57775,"_17548":96037,"_5":17443,"_23820":96000,"_2384":96038},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2857":57795,"_25170":57775,"_17548":96040,"_5":17443,"_23820":96004,"_2384":96041},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2857":57796,"_25170":57796,"_5":12294,"_2384":96043,"_25506":96044,"_17548":96045,"_23820":57796},"Despliega Lamassu",[40849,95972],[],{"_2857":57797,"_25170":57796,"_17548":96047,"_5":17443,"_23820":57796,"_2384":96048},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2857":57798,"_25170":57796,"_5":25503,"_17548":96050,"_23820":96051,"_2384":96052},[],"/docs/pr-preview/pr-38/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2857":57799,"_25170":57796,"_5":25503,"_17548":96054,"_23820":96055,"_2384":96056},[],"/docs/pr-preview/pr-38/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2857":57800,"_25170":57796,"_5":25503,"_17548":96058,"_23820":96059,"_2384":96060},[],"/docs/pr-preview/pr-38/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2857":57801,"_25170":57796,"_17548":96062,"_5":17443,"_23820":57796,"_2384":96063},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2857":57802,"_25170":57796,"_17548":96065,"_5":17443,"_23820":96051,"_2384":96066},[],"Modelo",{"_2857":57803,"_25170":57796,"_17548":96068,"_5":17443,"_23820":96051,"_2384":96069},[],"Recomendado para",{"_2857":57804,"_25170":57796,"_17548":96071,"_5":17443,"_23820":96051,"_2384":96072},[],"Quién opera la infraestructura",{"_2857":57805,"_25170":57796,"_17548":96074,"_5":17443,"_23820":96051,"_2384":96075},[],"Punto de partida",{"_2857":57806,"_25170":57796,"_17548":96077,"_5":17443,"_23820":96051,"_2384":40956},[],{"_2857":57807,"_25170":57796,"_17548":96079,"_5":17443,"_23820":96051,"_2384":96080},[],"Producción, entornos regulados y despliegues personalizados",{"_2857":57808,"_25170":57796,"_17548":96082,"_5":17443,"_23820":96051,"_2384":96083},[],"Tu equipo",{"_2857":57809,"_25170":57796,"_17548":96085,"_5":17443,"_23820":96051,"_2384":96086},[],"Helm o Fastlane",{"_2857":57810,"_25170":57796,"_17548":96088,"_5":17443,"_23820":96051,"_2384":40968},[],{"_2857":57811,"_25170":57796,"_17548":96090,"_5":17443,"_23820":96051,"_2384":96091},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2857":57812,"_25170":57796,"_17548":96093,"_5":17443,"_23820":96051,"_2384":96083},[],{"_2857":57813,"_25170":57796,"_17548":96095,"_5":17443,"_23820":96051,"_2384":96096},[],"Imagen preconfigurada en EC2",{"_2857":57814,"_25170":57796,"_17548":96098,"_5":17443,"_23820":96051,"_2384":40979},[],{"_2857":57815,"_25170":57796,"_17548":96100,"_5":17443,"_23820":96051,"_2384":96101},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2857":57816,"_25170":57796,"_17548":96103,"_5":17443,"_23820":96051,"_2384":40985},[],{"_2857":57817,"_25170":57796,"_17548":96105,"_5":17443,"_23820":96051,"_2384":96106},[],"Suscripción gestionada",{"_2857":57818,"_25170":57796,"_17548":96108,"_5":17443,"_23820":96051,"_2384":96109},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2857":57819,"_25170":57796,"_17548":96111,"_5":17443,"_23820":96051,"_2384":96112},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2857":57820,"_25170":57796,"_17548":96114,"_5":17443,"_23820":96051,"_2384":96115},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2857":57821,"_25170":57796,"_17548":96117,"_5":17443,"_23820":96055,"_2384":96118},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2857":57822,"_25170":57796,"_17548":96120,"_5":17443,"_23820":96059,"_2384":96121},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2857":57823,"_25170":57823,"_5":12294,"_2384":96123,"_25506":96124,"_17548":96125,"_23820":57823},"Utiliza Lamassu como SaaS",[40849,95972,95973],[],{"_2857":57824,"_25170":57823,"_17548":96127,"_5":17443,"_23820":57823,"_2384":96128},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2857":57825,"_25170":57823,"_5":25503,"_17548":96130,"_23820":96131,"_2384":96132},[],"/docs/pr-preview/pr-38/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2857":57826,"_25170":57823,"_5":25503,"_17548":96134,"_23820":96135,"_2384":96136},[],"/docs/pr-preview/pr-38/es/deployment/saas#planes","Planes",{"_2857":57827,"_25170":57823,"_5":25503,"_17548":96138,"_23820":96139,"_2384":96140},[],"/docs/pr-preview/pr-38/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2857":57828,"_25170":57823,"_17548":96142,"_5":17443,"_23820":57823,"_2384":96143},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2857":57829,"_25170":57823,"_17548":96145,"_5":17443,"_23820":96131,"_2384":96146},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2857":57830,"_25170":57823,"_17548":96148,"_5":17443,"_23820":96131,"_2384":96149},[],"Copias de seguridad automáticas.",{"_2857":57831,"_25170":57823,"_17548":96151,"_5":17443,"_23820":96131,"_2384":96152},[],"Actualizaciones de versión.",{"_2857":57832,"_25170":57823,"_17548":96154,"_5":17443,"_23820":96131,"_2384":96155},[],"Soporte técnico y SLA según el plan contratado.",{"_2857":57833,"_25170":57823,"_17548":96157,"_5":17443,"_23820":96135,"_2384":41040},[],{"_2857":57834,"_25170":57823,"_17548":96159,"_5":17443,"_23820":96135,"_2384":96160},[],"Dispositivos",{"_2857":57835,"_25170":57823,"_17548":96162,"_5":17443,"_23820":96135,"_2384":96163},[],"Soporte",{"_2857":57836,"_25170":57823,"_17548":96165,"_5":17443,"_23820":96135,"_2384":41049},[],{"_2857":57837,"_25170":57823,"_17548":96167,"_5":17443,"_23820":96135,"_2384":41052},[],{"_2857":57838,"_25170":57823,"_17548":96169,"_5":17443,"_23820":96135,"_2384":96170},[],"Hasta 1.000",{"_2857":57839,"_25170":57823,"_17548":96172,"_5":17443,"_23820":96135,"_2384":41058},[],{"_2857":57840,"_25170":57823,"_17548":96174,"_5":17443,"_23820":96135,"_2384":96175},[],"99,5 %",{"_2857":57841,"_25170":57823,"_17548":96177,"_5":17443,"_23820":96135,"_2384":41064},[],{"_2857":57842,"_25170":57823,"_17548":96179,"_5":17443,"_23820":96135,"_2384":96180},[],"Hasta 10.000",{"_2857":57843,"_25170":57823,"_17548":96182,"_5":17443,"_23820":96135,"_2384":96183},[],"Email y chat",{"_2857":57844,"_25170":57823,"_17548":96185,"_5":17443,"_23820":96135,"_2384":96186},[],"99,9 %",{"_2857":57845,"_25170":57823,"_17548":96188,"_5":17443,"_23820":96135,"_2384":41076},[],{"_2857":57846,"_25170":57823,"_17548":96190,"_5":17443,"_23820":96135,"_2384":96191},[],"Ilimitados",{"_2857":57847,"_25170":57823,"_17548":96193,"_5":17443,"_23820":96135,"_2384":96194},[],"Dedicado",{"_2857":57848,"_25170":57823,"_17548":96196,"_5":17443,"_23820":96135,"_2384":96197},[],"99,99 %",{"_2857":57849,"_25170":57823,"_17548":96199,"_5":17443,"_23820":96139,"_2384":96200},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2857":57850,"_25170":57823,"_17548":96202,"_5":17443,"_23820":96139,"_2384":96203},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2857":57851,"_25170":57851,"_5":12294,"_2384":41093,"_25506":96205,"_17548":96207,"_23820":57851},[40849,95972,96206],"Kubernetes autogestionado",[],{"_2857":57852,"_25170":57851,"_17548":96209,"_5":17443,"_23820":57851,"_2384":96210},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2857":57853,"_25170":57851,"_5":25503,"_17548":96212,"_23820":96213,"_2384":96214},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2857":57854,"_25170":57851,"_5":25503,"_17548":96216,"_23820":96217,"_2384":96218},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2857":57855,"_25170":57851,"_5":25503,"_17548":96220,"_23820":96221,"_2384":96222},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2857":57856,"_25170":57851,"_5":25503,"_17548":96224,"_23820":96225,"_2384":96226},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2857":57857,"_25170":57851,"_5":25503,"_17548":96228,"_23820":96229,"_2384":96230},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2857":57858,"_25170":57851,"_5":25503,"_17548":96232,"_23820":96233,"_2384":96234},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2857":57859,"_25170":57851,"_5":25503,"_17548":96236,"_23820":96237,"_2384":96238},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2857":57860,"_25170":57851,"_5":25503,"_17548":96240,"_23820":96241,"_2384":96242},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2857":57861,"_25170":57851,"_5":25503,"_17548":96244,"_23820":96245,"_2384":96246},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2857":57862,"_25170":57851,"_5":25503,"_17548":96248,"_23820":96249,"_2384":96250},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2857":57863,"_25170":57851,"_17548":96252,"_5":17443,"_23820":96213,"_2384":96253},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2857":57864,"_25170":57851,"_17548":96255,"_5":17443,"_23820":96213,"_2384":96256},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2857":57865,"_25170":57851,"_17548":96258,"_5":17443,"_23820":96217,"_2384":96259},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2857":57866,"_25170":57851,"_17548":96261,"_5":17443,"_23820":96217,"_2384":96262},[],"Fastlane instala o configura",{"_2857":57867,"_25170":57851,"_17548":96264,"_5":17443,"_23820":96217,"_2384":96265},[],"Tú sigues proporcionando",{"_2857":57868,"_25170":57851,"_17548":96267,"_5":17443,"_23820":96217,"_2384":96268},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2857":57869,"_25170":57851,"_17548":96270,"_5":17443,"_23820":96217,"_2384":96271},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2857":57870,"_25170":57851,"_17548":96273,"_5":17443,"_23820":96217,"_2384":96274},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2857":57871,"_25170":57851,"_17548":96276,"_5":17443,"_23820":96217,"_2384":96277},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2857":57872,"_25170":57851,"_17548":96279,"_5":17443,"_23820":96217,"_2384":96280},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2857":57873,"_25170":57851,"_17548":96282,"_5":17443,"_23820":96217,"_2384":96283},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2857":57874,"_25170":57851,"_17548":96285,"_5":17443,"_23820":96217,"_2384":96286},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2857":57875,"_25170":57851,"_17548":96288,"_5":17443,"_23820":96217,"_2384":96289},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2857":57876,"_25170":57851,"_17548":96291,"_5":17443,"_23820":96217,"_2384":96292},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2857":57877,"_25170":57851,"_17548":96294,"_5":17443,"_23820":96221,"_2384":96295},[],"Necesitas:",{"_2857":57878,"_25170":57851,"_17548":96297,"_5":17443,"_23820":96221,"_2384":96298},[],"un clúster Kubernetes existente",{"_2857":57879,"_25170":57851,"_17548":96300,"_5":17443,"_23820":96221,"_2384":96301},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2857":57880,"_25170":57851,"_17548":96303,"_5":17443,"_23820":96221,"_2384":41191},[],{"_2857":57881,"_25170":57851,"_17548":96305,"_5":17443,"_23820":96221,"_2384":19868},[],{"_2857":57882,"_25170":57851,"_17548":96307,"_5":17443,"_23820":96221,"_2384":96308},[],"`jq` solo si usas `--sample-data`",{"_2857":57883,"_25170":57851,"_17548":96310,"_5":17443,"_23820":96221,"_2384":96311},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2857":57884,"_25170":57851,"_17548":96313,"_5":17443,"_23820":96221,"_2384":96314},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2857":57885,"_25170":57851,"_17548":96316,"_5":17443,"_23820":96221,"_2384":96317},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2857":57886,"_25170":57851,"_17548":96319,"_5":17443,"_23820":96225,"_2384":96320},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2857":57887,"_25170":57851,"_17548":96322,"_5":17443,"_23820":96225,"_2384":96323},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2857":57888,"_25170":57851,"_17548":96325,"_5":17443,"_23820":96229,"_2384":96326},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2857":57889,"_25170":57851,"_17548":96328,"_5":17443,"_23820":96229,"_2384":96329},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2857":57890,"_25170":57851,"_17548":96331,"_5":17443,"_23820":96229,"_2384":96332},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2857":57891,"_25170":57851,"_17548":96334,"_5":17443,"_23820":96229,"_2384":96335},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2857":57892,"_25170":57851,"_17548":96337,"_5":17443,"_23820":96233,"_2384":96338},[],"Opción",{"_2857":57893,"_25170":57851,"_17548":96340,"_5":17443,"_23820":96233,"_2384":96341},[],"Valor predeterminado",{"_2857":57894,"_25170":57851,"_17548":96343,"_5":17443,"_23820":96233,"_2384":96344},[],"Propósito",{"_2857":57895,"_25170":57851,"_17548":96346,"_5":17443,"_23820":96233,"_2384":41235},[],{"_2857":57896,"_25170":57851,"_17548":96348,"_5":17443,"_23820":96233,"_2384":41238},[],{"_2857":57897,"_25170":57851,"_17548":96350,"_5":17443,"_23820":96233,"_2384":96351},[],"Muestra la ayuda",{"_2857":57898,"_25170":57851,"_17548":96353,"_5":17443,"_23820":96233,"_2384":41244},[],{"_2857":57899,"_25170":57851,"_17548":96355,"_5":17443,"_23820":96233,"_2384":96356},[],"contexto actual",{"_2857":57900,"_25170":57851,"_17548":96358,"_5":17443,"_23820":96233,"_2384":96359},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2857":57901,"_25170":57851,"_17548":96361,"_5":17443,"_23820":96233,"_2384":41253},[],{"_2857":57902,"_25170":57851,"_17548":96363,"_5":17443,"_23820":96233,"_2384":5349},[],{"_2857":57903,"_25170":57851,"_17548":96365,"_5":17443,"_23820":96233,"_2384":96366},[],"Omite prompts y genera credenciales para las dependencias",{"_2857":57904,"_25170":57851,"_17548":96368,"_5":17443,"_23820":96233,"_2384":41261},[],{"_2857":57905,"_25170":57851,"_17548":96370,"_5":17443,"_23820":96233,"_2384":41264},[],{"_2857":57906,"_25170":57851,"_17548":96372,"_5":17443,"_23820":96233,"_2384":96373},[],"Namespace de la instalación",{"_2857":57907,"_25170":57851,"_17548":96375,"_5":17443,"_23820":96233,"_2384":41270},[],{"_2857":57908,"_25170":57851,"_17548":96377,"_5":17443,"_23820":96233,"_2384":41273},[],{"_2857":57909,"_25170":57851,"_17548":96379,"_5":17443,"_23820":96233,"_2384":96380},[],"Dominio usado por la UI, OIDC y el certificado",{"_2857":57910,"_25170":57851,"_17548":96382,"_5":17443,"_23820":96233,"_2384":41279},[],{"_2857":57911,"_25170":57851,"_17548":96384,"_5":17443,"_23820":96233,"_2384":12520},[],{"_2857":57912,"_25170":57851,"_17548":96386,"_5":17443,"_23820":96233,"_2384":96387},[],"Versión del chart de Lamassu",{"_2857":57913,"_25170":57851,"_17548":96389,"_5":17443,"_23820":96233,"_2384":41287},[],{"_2857":57914,"_25170":57851,"_17548":96391,"_5":17443,"_23820":96233,"_2384":41290},[],{"_2857":57915,"_25170":57851,"_17548":96393,"_5":17443,"_23820":96233,"_2384":96394},[],"Puerto del listener HTTPS",{"_2857":57916,"_25170":57851,"_17548":96396,"_5":17443,"_23820":96233,"_2384":41296},[],{"_2857":57917,"_25170":57851,"_17548":96398,"_5":17443,"_23820":96233,"_2384":41299},[],{"_2857":57918,"_25170":57851,"_17548":96400,"_5":17443,"_23820":96233,"_2384":96401},[],"Puerto del listener HTTP",{"_2857":57919,"_25170":57851,"_17548":96403,"_5":17443,"_23820":96233,"_2384":41305},[],{"_2857":57920,"_25170":57851,"_17548":96405,"_5":17443,"_23820":96233,"_2384":41238},[],{"_2857":57921,"_25170":57851,"_17548":96407,"_5":17443,"_23820":96233,"_2384":96408},[],"Certificado PEM para TLS downstream",{"_2857":57922,"_25170":57851,"_17548":96410,"_5":17443,"_23820":96233,"_2384":41313},[],{"_2857":57923,"_25170":57851,"_17548":96412,"_5":17443,"_23820":96233,"_2384":41238},[],{"_2857":57924,"_25170":57851,"_17548":96414,"_5":17443,"_23820":96233,"_2384":96415},[],"Clave privada PEM para TLS downstream",{"_2857":57925,"_25170":57851,"_17548":96417,"_5":17443,"_23820":96233,"_2384":41321},[],{"_2857":57926,"_25170":57851,"_17548":96419,"_5":17443,"_23820":96233,"_2384":96420},[],"chart del repositorio",{"_2857":57927,"_25170":57851,"_17548":96422,"_5":17443,"_23820":96233,"_2384":96423},[],"Usa un chart local de Lamassu sin empaquetar",{"_2857":57928,"_25170":57851,"_17548":96425,"_5":17443,"_23820":96233,"_2384":41330},[],{"_2857":57929,"_25170":57851,"_17548":96427,"_5":17443,"_23820":96233,"_2384":96428},[],"detección automática",{"_2857":57930,"_25170":57851,"_17548":96430,"_5":17443,"_23820":96233,"_2384":96431},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2857":57931,"_25170":57851,"_17548":96433,"_5":17443,"_23820":96233,"_2384":41338},[],{"_2857":57932,"_25170":57851,"_17548":96435,"_5":17443,"_23820":96233,"_2384":5349},[],{"_2857":57933,"_25170":57851,"_17548":96437,"_5":17443,"_23820":96233,"_2384":96438},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2857":57934,"_25170":57851,"_17548":96440,"_5":17443,"_23820":96233,"_2384":41346},[],{"_2857":57935,"_25170":57851,"_17548":96442,"_5":17443,"_23820":96233,"_2384":5349},[],{"_2857":57936,"_25170":57851,"_17548":96444,"_5":17443,"_23820":96233,"_2384":96445},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2857":57937,"_25170":57851,"_17548":96447,"_5":17443,"_23820":96233,"_2384":41354},[],{"_2857":57938,"_25170":57851,"_17548":96449,"_5":17443,"_23820":96233,"_2384":5349},[],{"_2857":57939,"_25170":57851,"_17548":96451,"_5":17443,"_23820":96233,"_2384":96452},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2857":57940,"_25170":57851,"_17548":96454,"_5":17443,"_23820":96233,"_2384":41362},[],{"_2857":57941,"_25170":57851,"_17548":96456,"_5":17443,"_23820":96233,"_2384":41365},[],{"_2857":57942,"_25170":57851,"_17548":96458,"_5":17443,"_23820":96233,"_2384":96459},[],"Usa otro chart local de SoftHSM",{"_2857":57943,"_25170":57851,"_17548":96461,"_5":17443,"_23820":96233,"_2384":96462},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2857":57944,"_25170":57851,"_17548":96464,"_5":17443,"_23820":96237,"_2384":41374},[],{"_2857":57945,"_25170":57851,"_17548":96466,"_5":17443,"_23820":96237,"_2384":96467},[],"valida las herramientas locales y el clúster seleccionado",{"_2857":57946,"_25170":57851,"_17548":96469,"_5":17443,"_23820":96237,"_2384":96470},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2857":57947,"_25170":57851,"_17548":96472,"_5":17443,"_23820":96237,"_2384":96473},[],"crea el namespace",{"_2857":57948,"_25170":57851,"_17548":96475,"_5":17443,"_23820":96237,"_2384":96476},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2857":57949,"_25170":57851,"_17548":96478,"_5":17443,"_23820":96237,"_2384":96479},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2857":57950,"_25170":57851,"_17548":96481,"_5":17443,"_23820":96237,"_2384":96482},[],"instala RabbitMQ",{"_2857":57951,"_25170":57851,"_17548":96484,"_5":17443,"_23820":96237,"_2384":96485},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2857":57952,"_25170":57851,"_17548":96487,"_5":17443,"_23820":96237,"_2384":96488},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2857":57953,"_25170":57851,"_17548":96490,"_5":17443,"_23820":96237,"_2384":96491},[],"carga datos de ejemplo opcionalmente",{"_2857":57954,"_25170":57851,"_17548":96493,"_5":17443,"_23820":96237,"_2384":96494},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2857":57955,"_25170":57851,"_17548":96496,"_5":17443,"_23820":96241,"_2384":96497},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2857":57956,"_25170":57851,"_17548":96499,"_5":17443,"_23820":96241,"_2384":96500},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2857":57957,"_25170":57851,"_17548":96502,"_5":17443,"_23820":96245,"_2384":96503},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2857":57958,"_25170":57851,"_17548":96505,"_5":17443,"_23820":96245,"_2384":96506},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2857":57959,"_25170":57851,"_17548":96508,"_5":17443,"_23820":96245,"_2384":96509},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2857":57960,"_25170":57851,"_17548":96511,"_5":17443,"_23820":96249,"_2384":96512},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2857":57961,"_25170":57961,"_5":12294,"_2384":96514,"_25506":96515,"_17548":96516,"_23820":57961},"Instala con Helm",[40849,95972,96206],[],{"_2857":57962,"_25170":57961,"_17548":96518,"_5":17443,"_23820":57961,"_2384":96519},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2857":57963,"_25170":57961,"_5":25503,"_17548":96521,"_23820":96522,"_2384":96523},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2857":57964,"_25170":57961,"_5":25503,"_17548":96525,"_23820":96526,"_2384":96222},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2857":57965,"_25170":57961,"_5":25503,"_17548":96528,"_23820":96529,"_2384":96530},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2857":57966,"_25170":57961,"_5":25503,"_17548":96532,"_23820":96533,"_2384":96534},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2857":57967,"_25170":57961,"_5":25503,"_17548":96536,"_23820":96537,"_2384":96538},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2857":57968,"_25170":57961,"_5":25503,"_17548":96540,"_23820":96541,"_2384":96542},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2857":57969,"_25170":57961,"_5":25503,"_17548":96544,"_23820":96545,"_2384":96546},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2857":57970,"_25170":57961,"_5":25503,"_17548":96548,"_23820":96549,"_2384":96550},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2857":57971,"_25170":57961,"_5":25503,"_17548":96552,"_23820":96553,"_2384":96554},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2857":57972,"_25170":57961,"_17548":96556,"_5":17443,"_23820":96522,"_2384":96557},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2857":57973,"_25170":57961,"_17548":96559,"_5":17443,"_23820":96526,"_2384":96560},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2857":57974,"_25170":57961,"_17548":96562,"_5":17443,"_23820":96526,"_2384":96563},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2857":57975,"_25170":57961,"_17548":96565,"_5":17443,"_23820":96526,"_2384":96566},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2857":57976,"_25170":57961,"_17548":96568,"_5":17443,"_23820":96526,"_2384":96569},[],"un broker RabbitMQ accesible y sus credenciales",{"_2857":57977,"_25170":57961,"_17548":96571,"_5":17443,"_23820":96526,"_2384":96572},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2857":57978,"_25170":57961,"_17548":96574,"_5":17443,"_23820":96526,"_2384":96575},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2857":57979,"_25170":57961,"_17548":96577,"_5":17443,"_23820":96526,"_2384":96578},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2857":57980,"_25170":57961,"_17548":96580,"_5":17443,"_23820":96526,"_2384":96581},[],"una StorageClass y un diseño de tráfico externo",{"_2857":57981,"_25170":57961,"_17548":96583,"_5":17443,"_23820":96526,"_2384":96584},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2857":57982,"_25170":57961,"_17548":96586,"_5":17443,"_23820":96526,"_2384":96587},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2857":57983,"_25170":57961,"_17548":96589,"_5":17443,"_23820":96526,"_2384":96590},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2857":57984,"_25170":57961,"_17548":96592,"_5":17443,"_23820":96529,"_2384":96593},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2857":57985,"_25170":57961,"_17548":96595,"_5":17443,"_23820":96529,"_2384":96596},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2857":57986,"_25170":57961,"_17548":96598,"_5":17443,"_23820":96529,"_2384":96599},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2857":57987,"_25170":57961,"_17548":96601,"_5":17443,"_23820":96533,"_2384":96602},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2857":57988,"_25170":57961,"_17548":96604,"_5":17443,"_23820":96533,"_2384":96605},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2857":57989,"_25170":57961,"_17548":96607,"_5":17443,"_23820":96533,"_2384":96608},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2857":57990,"_25170":57961,"_17548":96610,"_5":17443,"_23820":96537,"_2384":96611},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2857":57991,"_25170":57961,"_17548":96613,"_5":17443,"_23820":96541,"_2384":96614},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2857":57992,"_25170":57961,"_17548":96616,"_5":17443,"_23820":96541,"_2384":96617},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2857":57993,"_25170":57961,"_17548":96619,"_5":17443,"_23820":96541,"_2384":96620},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2857":57994,"_25170":57961,"_17548":96622,"_5":17443,"_23820":96541,"_2384":96623},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2857":57995,"_25170":57961,"_17548":96625,"_5":17443,"_23820":96545,"_2384":96626},[],"Para instalar un checkout local:",{"_2857":57996,"_25170":57961,"_17548":96628,"_5":17443,"_23820":96549,"_2384":96629},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2857":57997,"_25170":57961,"_17548":96631,"_5":17443,"_23820":96549,"_2384":96632},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2857":57998,"_25170":57961,"_17548":96634,"_5":17443,"_23820":96553,"_2384":96635},[],"Antes de pasar a producción, revisa:",{"_2857":57999,"_25170":57961,"_17548":96637,"_5":17443,"_23820":96553,"_2384":96638},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2857":58000,"_25170":57961,"_17548":96640,"_5":17443,"_23820":96553,"_2384":96641},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2857":58001,"_25170":57961,"_17548":96643,"_5":17443,"_23820":96553,"_2384":96644},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2857":58002,"_25170":57961,"_17548":96646,"_5":17443,"_23820":96553,"_2384":96647},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2857":58003,"_25170":57961,"_17548":96649,"_5":17443,"_23820":96553,"_2384":96650},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2857":58004,"_25170":57961,"_17548":96652,"_5":17443,"_23820":96553,"_2384":96653},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2857":58005,"_25170":57961,"_17548":96655,"_5":17443,"_23820":96553,"_2384":96656},[],"SMTP, observabilidad y entrega de alertas",{"_2857":58006,"_25170":57961,"_17548":96658,"_5":17443,"_23820":96553,"_2384":96659},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2857":58007,"_25170":57961,"_17548":96661,"_5":17443,"_23820":96553,"_2384":96662},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2857":58008,"_25170":58008,"_5":12294,"_2384":96664,"_25506":96665,"_17548":96666,"_23820":58008},"Expón el Gateway",[40849,95972,96206],[],{"_2857":58009,"_25170":58008,"_17548":96668,"_5":17443,"_23820":58008,"_2384":96669},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2857":58010,"_25170":58008,"_5":25503,"_17548":96671,"_23820":96672,"_2384":96673},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2857":58011,"_25170":58008,"_5":25503,"_17548":96675,"_23820":96676,"_2384":96677},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2857":58012,"_25170":58008,"_5":25503,"_17548":96679,"_23820":96680,"_2384":96681},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2857":58013,"_25170":58008,"_5":25503,"_17548":96683,"_23820":96684,"_2384":41595},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#k3s",{"_2857":58014,"_25170":58008,"_5":25503,"_17548":96686,"_23820":96687,"_2384":96688},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2857":58015,"_25170":58008,"_5":25503,"_17548":96690,"_23820":96691,"_2384":96692},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2857":58016,"_25170":58008,"_5":25503,"_17548":96694,"_23820":96695,"_2384":96696},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2857":58017,"_25170":58008,"_5":25503,"_17548":96698,"_23820":96699,"_2384":96700},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2857":58018,"_25170":58008,"_5":25503,"_17548":96702,"_23820":96703,"_2384":96704},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2857":58019,"_25170":58008,"_17548":96706,"_5":17443,"_23820":96672,"_2384":96707},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2857":58020,"_25170":58008,"_17548":96709,"_5":17443,"_23820":96672,"_2384":96710},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2857":58021,"_25170":58008,"_17548":96712,"_5":17443,"_23820":96676,"_2384":96713},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2857":58022,"_25170":58008,"_17548":96715,"_5":17443,"_23820":96676,"_2384":96716},[],"Defínelo únicamente cuando:",{"_2857":58023,"_25170":58008,"_17548":96718,"_5":17443,"_23820":96676,"_2384":96719},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2857":58024,"_25170":58008,"_17548":96721,"_5":17443,"_23820":96676,"_2384":96722},[],"esa dirección está asignada a este Gateway",{"_2857":58025,"_25170":58008,"_17548":96724,"_5":17443,"_23820":96676,"_2384":96725},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2857":58026,"_25170":58008,"_17548":96727,"_5":17443,"_23820":96676,"_2384":96728},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2857":58027,"_25170":58008,"_17548":96730,"_5":17443,"_23820":96676,"_2384":96731},[],"No confundas estos valores:",{"_2857":58028,"_25170":58008,"_17548":96733,"_5":17443,"_23820":96676,"_2384":96734},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2857":58029,"_25170":58008,"_17548":96736,"_5":17443,"_23820":96676,"_2384":96737},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2857":58030,"_25170":58008,"_17548":96739,"_5":17443,"_23820":96676,"_2384":96740},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2857":58031,"_25170":58008,"_17548":96742,"_5":17443,"_23820":96680,"_2384":96743},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2857":58032,"_25170":58008,"_17548":96745,"_5":17443,"_23820":96680,"_2384":96746},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2857":58033,"_25170":58008,"_17548":96748,"_5":17443,"_23820":96684,"_2384":96749},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2857":58034,"_25170":58008,"_17548":96751,"_5":17443,"_23820":96684,"_2384":96752},[],"Para el diseño recomendado:",{"_2857":58035,"_25170":58008,"_17548":96754,"_5":17443,"_23820":96684,"_2384":96755},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2857":58036,"_25170":58008,"_17548":96757,"_5":17443,"_23820":96684,"_2384":96758},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2857":58037,"_25170":58008,"_17548":96760,"_5":17443,"_23820":96684,"_2384":96761},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2857":58038,"_25170":58008,"_17548":96763,"_5":17443,"_23820":96684,"_2384":96764},[],"Apunta DNS a la dirección accesible de la VM.",{"_2857":58039,"_25170":58008,"_17548":96766,"_5":17443,"_23820":96684,"_2384":96767},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2857":58040,"_25170":58008,"_17548":96769,"_5":17443,"_23820":96687,"_2384":96770},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2857":58041,"_25170":58008,"_17548":96772,"_5":17443,"_23820":96691,"_2384":96773},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2857":58042,"_25170":58008,"_17548":96775,"_5":17443,"_23820":96691,"_2384":96776},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2857":58043,"_25170":58008,"_17548":96778,"_5":17443,"_23820":96695,"_2384":96779},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2857":58044,"_25170":58008,"_17548":96781,"_5":17443,"_23820":96695,"_2384":96782},[],"Requisito",{"_2857":58045,"_25170":58008,"_17548":96784,"_5":17443,"_23820":96695,"_2384":96785},[],"Diseño recomendado",{"_2857":58046,"_25170":58008,"_17548":96787,"_5":17443,"_23820":96695,"_2384":96788},[],"Consecuencia",{"_2857":58047,"_25170":58008,"_17548":96790,"_5":17443,"_23820":96695,"_2384":96791},[],"Varias URL o servicios de Lamassu",{"_2857":58048,"_25170":58008,"_17548":96793,"_5":17443,"_23820":96695,"_2384":96794},[],"Un Gateway con varias rutas",{"_2857":58049,"_25170":58008,"_17548":96796,"_5":17443,"_23820":96695,"_2384":96797},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2857":58050,"_25170":58008,"_17548":96799,"_5":17443,"_23820":96695,"_2384":96800},[],"Gateways independientes e IP externas distintas",{"_2857":58051,"_25170":58008,"_17548":96802,"_5":17443,"_23820":96695,"_2384":96803},[],"Una VIP por Gateway",{"_2857":58052,"_25170":58008,"_17548":96805,"_5":17443,"_23820":96695,"_2384":96806},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2857":58053,"_25170":58008,"_17548":96808,"_5":17443,"_23820":96695,"_2384":96809},[],"Gateways independientes, un nodo y una IP",{"_2857":58054,"_25170":58008,"_17548":96811,"_5":17443,"_23820":96695,"_2384":96812},[],"Puertos externos diferentes",{"_2857":58055,"_25170":58008,"_17548":96814,"_5":17443,"_23820":96695,"_2384":96815},[],"Los clientes deben indicar puertos no estándar",{"_2857":58056,"_25170":58008,"_17548":96817,"_5":17443,"_23820":96695,"_2384":96818},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2857":58057,"_25170":58008,"_17548":96820,"_5":17443,"_23820":96695,"_2384":96821},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2857":58058,"_25170":58008,"_17548":96823,"_5":17443,"_23820":96695,"_2384":96824},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2857":58059,"_25170":58008,"_17548":96826,"_5":17443,"_23820":96695,"_2384":96827},[],"Recursos Gateway separados pero proxy compartido",{"_2857":58060,"_25170":58008,"_17548":96829,"_5":17443,"_23820":96695,"_2384":96830},[],"Modo merged Gateway de Envoy",{"_2857":58061,"_25170":58008,"_17548":96832,"_5":17443,"_23820":96695,"_2384":96833},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2857":58062,"_25170":58008,"_17548":96835,"_5":17443,"_23820":96695,"_2384":96836},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2857":58063,"_25170":58008,"_17548":96838,"_5":17443,"_23820":96695,"_2384":96839},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2857":58064,"_25170":58008,"_17548":96841,"_5":17443,"_23820":96695,"_2384":96842},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2857":58065,"_25170":58008,"_17548":96844,"_5":17443,"_23820":96695,"_2384":96845},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2857":58066,"_25170":58008,"_17548":96847,"_5":17443,"_23820":96699,"_2384":96848},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2857":58067,"_25170":58008,"_17548":96850,"_5":17443,"_23820":96699,"_2384":96851},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2857":58068,"_25170":58008,"_17548":96853,"_5":17443,"_23820":96699,"_2384":96854},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2857":58069,"_25170":58008,"_17548":96856,"_5":17443,"_23820":96699,"_2384":96857},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2857":58070,"_25170":58008,"_17548":96859,"_5":17443,"_23820":96699,"_2384":96860},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2857":58071,"_25170":58008,"_17548":96862,"_5":17443,"_23820":96703,"_2384":96863},[],"Comprueba, en orden:",{"_2857":58072,"_25170":58008,"_17548":96865,"_5":17443,"_23820":96703,"_2384":96866},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2857":58073,"_25170":58008,"_17548":96868,"_5":17443,"_23820":96703,"_2384":96869},[],"Su estado contiene la dirección esperada.",{"_2857":58074,"_25170":58008,"_17548":96871,"_5":17443,"_23820":96703,"_2384":96872},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2857":58075,"_25170":58008,"_17548":96874,"_5":17443,"_23820":96703,"_2384":96875},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2857":58076,"_25170":58008,"_17548":96877,"_5":17443,"_23820":96703,"_2384":96878},[],"DNS resuelve al endpoint accesible externamente.",{"_2857":58077,"_25170":58008,"_17548":96880,"_5":17443,"_23820":96703,"_2384":96881},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2857":58078,"_25170":58008,"_17548":96883,"_5":17443,"_23820":96703,"_2384":96884},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2857":58079,"_25170":58079,"_5":12294,"_2384":40956,"_25506":96886,"_17548":96887,"_23820":58079},[40849,95972,96206],[],{"_2857":58080,"_25170":58079,"_17548":96889,"_5":17443,"_23820":58079,"_2384":96890},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2857":58081,"_25170":58079,"_5":25503,"_17548":96892,"_23820":96893,"_2384":96894},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2857":58082,"_25170":58079,"_5":25503,"_17548":96896,"_23820":96897,"_2384":96898},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2857":58083,"_25170":58079,"_5":25503,"_17548":96900,"_23820":96901,"_2384":96902},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2857":58084,"_25170":58079,"_5":25503,"_17548":96904,"_23820":96905,"_2384":96906},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2857":58085,"_25170":58079,"_5":25503,"_17548":96908,"_23820":96909,"_2384":96910},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2857":58086,"_25170":58079,"_5":25503,"_17548":96912,"_23820":96913,"_2384":96914},[],"/docs/pr-preview/pr-38/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2857":58087,"_25170":58079,"_17548":96916,"_5":17443,"_23820":96893,"_2384":96917},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2857":58088,"_25170":58079,"_17548":96919,"_5":17443,"_23820":96897,"_2384":96920},[],"Flujo",{"_2857":58089,"_25170":58079,"_17548":96922,"_5":17443,"_23820":96897,"_2384":96923},[],"Úsalo para",{"_2857":58090,"_25170":58079,"_17548":96925,"_5":17443,"_23820":96897,"_2384":96926},[],"Qué instala",{"_2857":58091,"_25170":58079,"_17548":96928,"_5":17443,"_23820":96897,"_2384":41840},[],{"_2857":58092,"_25170":58079,"_17548":96930,"_5":17443,"_23820":96897,"_2384":96931},[],"Producción y entornos controlados",{"_2857":58093,"_25170":58079,"_17548":96933,"_5":17443,"_23820":96897,"_2384":96934},[],"Servicios de Lamassu y recursos de Gateway API",{"_2857":58094,"_25170":58079,"_17548":96936,"_5":17443,"_23820":96897,"_2384":41093},[],{"_2857":58095,"_25170":58079,"_17548":96938,"_5":17443,"_23820":96897,"_2384":96939},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2857":58096,"_25170":58079,"_17548":96941,"_5":17443,"_23820":96897,"_2384":96942},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2857":58097,"_25170":58079,"_17548":96944,"_5":17443,"_23820":96901,"_2384":96945},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2857":58098,"_25170":58079,"_17548":96947,"_5":17443,"_23820":96901,"_2384":96948},[],"Área",{"_2857":58099,"_25170":58079,"_17548":96950,"_5":17443,"_23820":96901,"_2384":96951},[],"El chart de Lamassu proporciona",{"_2857":58100,"_25170":58079,"_17548":96953,"_5":17443,"_23820":96901,"_2384":96954},[],"Tú proporcionas",{"_2857":58101,"_25170":58079,"_17548":96956,"_5":17443,"_23820":96901,"_2384":96957},[],"Aplicaciones Lamassu",{"_2857":58102,"_25170":58079,"_17548":96959,"_5":17443,"_23820":96901,"_2384":96960},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2857":58103,"_25170":58079,"_17548":96962,"_5":17443,"_23820":96901,"_2384":96963},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2857":58104,"_25170":58079,"_17548":96965,"_5":17443,"_23820":96901,"_2384":96966},[],"Datos PostgreSQL",{"_2857":58105,"_25170":58079,"_17548":96968,"_5":17443,"_23820":96901,"_2384":96969},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2857":58106,"_25170":58079,"_17548":96971,"_5":17443,"_23820":96901,"_2384":96972},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2857":58107,"_25170":58079,"_17548":96974,"_5":17443,"_23820":96901,"_2384":96975},[],"Mensajería",{"_2857":58108,"_25170":58079,"_17548":96977,"_5":17443,"_23820":96901,"_2384":96978},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2857":58109,"_25170":58079,"_17548":96980,"_5":17443,"_23820":96901,"_2384":96981},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2857":58110,"_25170":58079,"_17548":96983,"_5":17443,"_23820":96901,"_2384":96984},[],"Identidad",{"_2857":58111,"_25170":58079,"_17548":96986,"_5":17443,"_23820":96901,"_2384":96987},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2857":58112,"_25170":58079,"_17548":96989,"_5":17443,"_23820":96901,"_2384":96990},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2857":58113,"_25170":58079,"_17548":96992,"_5":17443,"_23820":96901,"_2384":96993},[],"Enrutamiento externo",{"_2857":58114,"_25170":58079,"_17548":96995,"_5":17443,"_23820":96901,"_2384":96996},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2857":58115,"_25170":58079,"_17548":96998,"_5":17443,"_23820":96901,"_2384":96999},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2857":58116,"_25170":58079,"_17548":97001,"_5":17443,"_23820":96901,"_2384":41914},[],{"_2857":58117,"_25170":58079,"_17548":97003,"_5":17443,"_23820":96901,"_2384":97004},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2857":58118,"_25170":58079,"_17548":97006,"_5":17443,"_23820":96901,"_2384":97007},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2857":58119,"_25170":58079,"_17548":97009,"_5":17443,"_23820":96901,"_2384":97010},[],"Datos persistentes de la aplicación",{"_2857":58120,"_25170":58079,"_17548":97012,"_5":17443,"_23820":96901,"_2384":97013},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2857":58121,"_25170":58079,"_17548":97015,"_5":17443,"_23820":96901,"_2384":97016},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2857":58122,"_25170":58079,"_17548":97018,"_5":17443,"_23820":96901,"_2384":97019},[],"Integraciones opcionales",{"_2857":58123,"_25170":58079,"_17548":97021,"_5":17443,"_23820":96901,"_2384":97022},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2857":58124,"_25170":58079,"_17548":97024,"_5":17443,"_23820":96901,"_2384":97025},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2857":58125,"_25170":58079,"_17548":97027,"_5":17443,"_23820":96901,"_2384":97028},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2857":58126,"_25170":58079,"_17548":97030,"_5":17443,"_23820":96901,"_2384":97031},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2857":58127,"_25170":58079,"_17548":97033,"_5":17443,"_23820":96905,"_2384":97034},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2857":58128,"_25170":58079,"_17548":97036,"_5":17443,"_23820":96905,"_2384":97037},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2857":58129,"_25170":58079,"_17548":97039,"_5":17443,"_23820":96909,"_2384":97040},[],"Kubernetes 1.24 o posterior",{"_2857":58130,"_25170":58079,"_17548":97042,"_5":17443,"_23820":96909,"_2384":97043},[],"Helm 3.2 o posterior",{"_2857":58131,"_25170":58079,"_17548":97045,"_5":17443,"_23820":96909,"_2384":97046},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2857":58132,"_25170":58079,"_17548":97048,"_5":17443,"_23820":96909,"_2384":97049},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2857":58133,"_25170":58079,"_17548":97051,"_5":17443,"_23820":96909,"_2384":97052},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2857":58134,"_25170":58079,"_17548":97054,"_5":17443,"_23820":96909,"_2384":97055},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2857":58135,"_25170":58079,"_17548":97057,"_5":17443,"_23820":96909,"_2384":97058},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2857":58136,"_25170":58079,"_17548":97060,"_5":17443,"_23820":96913,"_2384":97061},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2857":58137,"_25170":58079,"_17548":97063,"_5":17443,"_23820":96913,"_2384":97064},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2857":58138,"_25170":58079,"_17548":97066,"_5":17443,"_23820":96913,"_2384":97067},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2857":58139,"_25170":58139,"_5":12294,"_2384":97069,"_25506":97070,"_17548":97072,"_23820":58139},"Resolución de problemas de despliegue",[40849,95972,97071],"Operación",[],{"_2857":58140,"_25170":58139,"_17548":97074,"_5":17443,"_23820":58139,"_2384":97075},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2857":58141,"_25170":58139,"_5":25503,"_17548":97077,"_23820":97078,"_2384":97079},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2857":58142,"_25170":58139,"_5":25503,"_17548":97081,"_23820":97082,"_2384":97083},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2857":58143,"_25170":58139,"_5":25503,"_17548":97085,"_23820":97086,"_2384":97087},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2857":58144,"_25170":58139,"_5":25503,"_17548":97089,"_23820":97090,"_2384":97091},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2857":58145,"_25170":58139,"_5":25503,"_17548":97093,"_23820":97094,"_2384":97095},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2857":58146,"_25170":58139,"_5":25503,"_17548":97097,"_23820":97098,"_2384":97099},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2857":58147,"_25170":58139,"_5":25503,"_17548":97101,"_23820":97102,"_2384":97103},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2857":58148,"_25170":58139,"_5":25503,"_17548":97105,"_23820":97106,"_2384":97107},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2857":58149,"_25170":58139,"_5":25503,"_17548":97109,"_23820":97110,"_2384":97111},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2857":58150,"_25170":58139,"_5":25503,"_17548":97113,"_23820":97114,"_2384":97115},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2857":58151,"_25170":58139,"_5":25503,"_17548":97117,"_23820":97118,"_2384":97119},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2857":58152,"_25170":58139,"_5":25503,"_17548":97121,"_23820":97122,"_2384":97123},[],"/docs/pr-preview/pr-38/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2857":58153,"_25170":58139,"_17548":97125,"_5":17443,"_23820":58139,"_2384":97126},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2857":58154,"_25170":58139,"_17548":97128,"_5":17443,"_23820":97082,"_2384":97129},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2857":58155,"_25170":58139,"_17548":97131,"_5":17443,"_23820":97086,"_2384":97132},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2857":58156,"_25170":58139,"_17548":97134,"_5":17443,"_23820":97090,"_2384":97135},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2857":58157,"_25170":58139,"_17548":97137,"_5":17443,"_23820":97094,"_2384":97138},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2857":58158,"_25170":58139,"_17548":97140,"_5":17443,"_23820":97098,"_2384":97141},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2857":58159,"_25170":58139,"_17548":97143,"_5":17443,"_23820":97102,"_2384":97144},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2857":58160,"_25170":58139,"_17548":97146,"_5":17443,"_23820":97102,"_2384":97147},[],"Ejecuta también la prueba de conectividad del chart:",{"_2857":58161,"_25170":58139,"_17548":97149,"_5":17443,"_23820":97102,"_2384":97150},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2857":58162,"_25170":58139,"_17548":97152,"_5":17443,"_23820":97102,"_2384":97153},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2857":58163,"_25170":58139,"_17548":97155,"_5":17443,"_23820":97106,"_2384":97156},[],"Si recibes un 401:",{"_2857":58164,"_25170":58139,"_17548":97158,"_5":17443,"_23820":97106,"_2384":97159},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2857":58165,"_25170":58139,"_17548":97161,"_5":17443,"_23820":97106,"_2384":97162},[],"verifica emisor, audiencia y expiración del token;",{"_2857":58166,"_25170":58139,"_17548":97164,"_5":17443,"_23820":97106,"_2384":97165},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2857":58167,"_25170":58139,"_17548":97167,"_5":17443,"_23820":97106,"_2384":97168},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2857":58168,"_25170":58139,"_17548":97170,"_5":17443,"_23820":97106,"_2384":97171},[],"Si el login termina pero las APIs devuelven 403:",{"_2857":58169,"_25170":58139,"_17548":97173,"_5":17443,"_23820":97106,"_2384":97174},[],"inspecciona los claims reales del token;",{"_2857":58170,"_25170":58139,"_17548":97176,"_5":17443,"_23820":97106,"_2384":97177},[],"confirma que coinciden con un principal activo;",{"_2857":58171,"_25170":58139,"_17548":97179,"_5":17443,"_23820":97106,"_2384":97180},[],"revisa las políticas concedidas al principal;",{"_2857":58172,"_25170":58139,"_17548":97182,"_5":17443,"_23820":97106,"_2384":97183},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2857":58173,"_25170":58139,"_17548":97185,"_5":17443,"_23820":97106,"_2384":97186},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2857":58174,"_25170":58139,"_17548":97188,"_5":17443,"_23820":97110,"_2384":97189},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2857":58175,"_25170":58139,"_17548":97191,"_5":17443,"_23820":97110,"_2384":97192},[],"Localiza el pod y Service de authz.",{"_2857":58176,"_25170":58139,"_17548":97194,"_5":17443,"_23820":97110,"_2384":97195},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2857":58177,"_25170":58139,"_17548":97197,"_5":17443,"_23820":97110,"_2384":97198},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2857":58178,"_25170":58139,"_17548":97200,"_5":17443,"_23820":97110,"_2384":97201},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2857":58179,"_25170":58139,"_17548":97203,"_5":17443,"_23820":97110,"_2384":97204},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2857":58180,"_25170":58139,"_17548":97206,"_5":17443,"_23820":97114,"_2384":97207},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2857":58181,"_25170":58139,"_17548":97209,"_5":17443,"_23820":97114,"_2384":97210},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2857":58182,"_25170":58139,"_17548":97212,"_5":17443,"_23820":97114,"_2384":97213},[],"volumen persistente sin enlazar;",{"_2857":58183,"_25170":58139,"_17548":97215,"_5":17443,"_23820":97114,"_2384":97216},[],"imagen inaccesible o política de pull incorrecta;",{"_2857":58184,"_25170":58139,"_17548":97218,"_5":17443,"_23820":97114,"_2384":97219},[],"configuración inválida del motor criptográfico;",{"_2857":58185,"_25170":58139,"_17548":97221,"_5":17443,"_23820":97114,"_2384":97222},[],"límites de CPU o memoria demasiado bajos;",{"_2857":58186,"_25170":58139,"_17548":97224,"_5":17443,"_23820":97114,"_2384":97225},[],"migración previa incompleta.",{"_2857":58187,"_25170":58139,"_17548":97227,"_5":17443,"_23820":97114,"_2384":97228},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2857":58188,"_25170":58139,"_17548":97230,"_5":17443,"_23820":97114,"_2384":97231},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2857":58189,"_25170":58139,"_17548":97233,"_5":17443,"_23820":97118,"_2384":97234},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2857":58190,"_25170":58139,"_17548":97236,"_5":17443,"_23820":97118,"_2384":97237},[],"verifica que esté habilitado en el servicio emisor;",{"_2857":58191,"_25170":58139,"_17548":97239,"_5":17443,"_23820":97118,"_2384":97240},[],"comprueba conectividad y credenciales AMQP;",{"_2857":58192,"_25170":58139,"_17548":97242,"_5":17443,"_23820":97118,"_2384":97243},[],"revisa exchange, routing key, colas y consumidores;",{"_2857":58193,"_25170":58139,"_17548":97245,"_5":17443,"_23820":97118,"_2384":97246},[],"inspecciona dead-letter queues;",{"_2857":58194,"_25170":58139,"_17548":97248,"_5":17443,"_23820":97118,"_2384":97249},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2857":58195,"_25170":58139,"_17548":97251,"_5":17443,"_23820":97118,"_2384":97252},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2857":58196,"_25170":58139,"_17548":97254,"_5":17443,"_23820":97122,"_2384":97255},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2857":58197,"_25170":58139,"_17548":97257,"_5":17443,"_23820":97122,"_2384":97258},[],"Antes de cerrar una incidencia, guarda:",{"_2857":58198,"_25170":58139,"_17548":97260,"_5":17443,"_23820":97122,"_2384":97261},[],"causa confirmada;",{"_2857":58199,"_25170":58139,"_17548":97263,"_5":17443,"_23820":97122,"_2384":97264},[],"alcance temporal y recursos afectados;",{"_2857":58200,"_25170":58139,"_17548":97266,"_5":17443,"_23820":97122,"_2384":97267},[],"comandos o consultas utilizados;",{"_2857":58201,"_25170":58139,"_17548":97269,"_5":17443,"_23820":97122,"_2384":97270},[],"cambio aplicado y forma de revertirlo;",{"_2857":58202,"_25170":58139,"_17548":97272,"_5":17443,"_23820":97122,"_2384":97273},[],"validación desde un consumidor;",{"_2857":58203,"_25170":58139,"_17548":97275,"_5":17443,"_23820":97122,"_2384":97276},[],"acción preventiva y propietario.",{"_2857":58204,"_25170":58204,"_5":12294,"_2384":97278,"_25506":97279,"_17548":97282,"_23820":58204},"Control de acceso",[40849,97280,97281],"Plataforma","Administración",[],{"_2857":58205,"_25170":58204,"_17548":97284,"_5":17443,"_23820":58204,"_2384":97285},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2857":58206,"_25170":58204,"_5":25503,"_17548":97287,"_23820":97288,"_2384":97289},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2857":58207,"_25170":58204,"_5":25503,"_17548":97291,"_23820":97292,"_2384":97293},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2857":58208,"_25170":58204,"_5":25503,"_17548":97295,"_23820":97296,"_2384":97297},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2857":58209,"_25170":58204,"_5":25503,"_17548":97299,"_23820":97300,"_2384":97301},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2857":58210,"_25170":58204,"_5":25503,"_17548":97303,"_23820":97304,"_2384":97305},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2857":58211,"_25170":58204,"_5":25503,"_17548":97307,"_23820":97308,"_2384":97309},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2857":58212,"_25170":58204,"_5":25503,"_17548":97311,"_23820":97312,"_2384":97313},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2857":58213,"_25170":58204,"_5":25503,"_17548":97315,"_23820":97316,"_2384":97317},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2857":58214,"_25170":58204,"_5":25503,"_17548":97319,"_23820":97320,"_2384":97321},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2857":58215,"_25170":58204,"_5":25503,"_17548":97323,"_23820":97324,"_2384":97325},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2857":58216,"_25170":58204,"_5":25503,"_17548":97327,"_23820":97328,"_2384":97329},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2857":58217,"_25170":58204,"_5":25503,"_17548":97331,"_23820":97332,"_2384":97333},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2857":58218,"_25170":58204,"_5":25503,"_17548":97335,"_23820":97336,"_2384":97337},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2857":58219,"_25170":58204,"_5":25503,"_17548":97339,"_23820":97340,"_2384":97341},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2857":58220,"_25170":58204,"_5":25503,"_17548":97343,"_23820":97344,"_2384":97345},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2857":58221,"_25170":58204,"_5":25503,"_17548":97347,"_23820":97348,"_2384":96542},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2857":58222,"_25170":58204,"_5":25503,"_17548":97350,"_23820":97351,"_2384":97352},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2857":58223,"_25170":58204,"_5":25503,"_17548":97354,"_23820":97355,"_2384":97356},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2857":58224,"_25170":58204,"_5":25503,"_17548":97358,"_23820":97359,"_2384":97360},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2857":58225,"_25170":58204,"_5":25503,"_17548":97362,"_23820":97363,"_2384":97364},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2857":58226,"_25170":58204,"_5":25503,"_17548":97366,"_23820":97367,"_2384":97368},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2857":58227,"_25170":58204,"_5":25503,"_17548":97370,"_23820":97371,"_2384":97372},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2857":58228,"_25170":58204,"_5":25503,"_17548":97374,"_23820":97375,"_2384":97376},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2857":58229,"_25170":58204,"_5":25503,"_17548":97378,"_23820":97379,"_2384":97380},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2857":58230,"_25170":58204,"_5":25503,"_17548":97382,"_23820":97383,"_2384":97384},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2857":58231,"_25170":58204,"_5":25503,"_17548":97386,"_23820":97387,"_2384":97388},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2857":58232,"_25170":58204,"_5":25503,"_17548":97390,"_23820":97391,"_2384":97392},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2857":58233,"_25170":58204,"_5":25503,"_17548":97394,"_23820":97395,"_2384":97396},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2857":58234,"_25170":58204,"_5":25503,"_17548":97398,"_23820":97399,"_2384":97400},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2857":58235,"_25170":58204,"_5":25503,"_17548":97402,"_23820":97403,"_2384":97404},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2857":58236,"_25170":58204,"_5":25503,"_17548":97406,"_23820":97407,"_2384":97408},[],"/docs/pr-preview/pr-38/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2857":58237,"_25170":58204,"_17548":97410,"_5":17443,"_23820":58204,"_2384":97411},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2857":58238,"_25170":58204,"_17548":97413,"_5":17443,"_23820":58204,"_2384":97414},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2857":58239,"_25170":58204,"_17548":97416,"_5":17443,"_23820":58204,"_2384":97417},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2857":58240,"_25170":58204,"_17548":97419,"_5":17443,"_23820":97288,"_2384":97420},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2857":58241,"_25170":58204,"_17548":97422,"_5":17443,"_23820":97288,"_2384":97423},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2857":58242,"_25170":58204,"_17548":97425,"_5":17443,"_23820":97288,"_2384":97426},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2857":58243,"_25170":58204,"_17548":97428,"_5":17443,"_23820":97288,"_2384":97429},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2857":58244,"_25170":58204,"_17548":97431,"_5":17443,"_23820":97288,"_2384":97432},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2857":58245,"_25170":58204,"_17548":97434,"_5":17443,"_23820":97288,"_2384":97435},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2857":58246,"_25170":58204,"_17548":97437,"_5":17443,"_23820":97292,"_2384":97438},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2857":58247,"_25170":58204,"_17548":97440,"_5":17443,"_23820":97292,"_2384":97441},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2857":58248,"_25170":58204,"_17548":97443,"_5":17443,"_23820":97296,"_2384":97444},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2857":58249,"_25170":58204,"_17548":97446,"_5":17443,"_23820":97296,"_2384":97447},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2857":58250,"_25170":58204,"_17548":97449,"_5":17443,"_23820":97296,"_2384":97450},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2857":58251,"_25170":58204,"_17548":97452,"_5":17443,"_23820":97296,"_2384":97453},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2857":58252,"_25170":58204,"_17548":97455,"_5":17443,"_23820":97296,"_2384":97456},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2857":58253,"_25170":58204,"_17548":97458,"_5":17443,"_23820":97296,"_2384":97459},[],"Carga por separado las políticas concedidas a cada principal.",{"_2857":58254,"_25170":58204,"_17548":97461,"_5":17443,"_23820":97296,"_2384":97462},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2857":58255,"_25170":58204,"_17548":97464,"_5":17443,"_23820":97296,"_2384":97465},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2857":58256,"_25170":58204,"_17548":97467,"_5":17443,"_23820":97296,"_2384":97468},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2857":58257,"_25170":58204,"_17548":97470,"_5":17443,"_23820":97296,"_2384":97471},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2857":58258,"_25170":58204,"_17548":97473,"_5":17443,"_23820":97296,"_2384":97474},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2857":58259,"_25170":58204,"_17548":97476,"_5":17443,"_23820":97296,"_2384":97477},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2857":58260,"_25170":58204,"_17548":97479,"_5":17443,"_23820":97300,"_2384":97480},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2857":58261,"_25170":58204,"_17548":97482,"_5":17443,"_23820":97300,"_2384":97483},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2857":58262,"_25170":58204,"_17548":97485,"_5":17443,"_23820":97300,"_2384":97486},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2857":58263,"_25170":58204,"_17548":97488,"_5":17443,"_23820":97300,"_2384":97489},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2857":58264,"_25170":58204,"_17548":97491,"_5":17443,"_23820":97300,"_2384":97492},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2857":58265,"_25170":58204,"_17548":97494,"_5":17443,"_23820":97300,"_2384":97495},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2857":58266,"_25170":58204,"_17548":97497,"_5":17443,"_23820":97300,"_2384":97498},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2857":58267,"_25170":58204,"_17548":97500,"_5":17443,"_23820":97300,"_2384":97501},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2857":58268,"_25170":58204,"_17548":97503,"_5":17443,"_23820":97304,"_2384":97504},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2857":58269,"_25170":58204,"_17548":97506,"_5":17443,"_23820":97304,"_2384":97507},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2857":58270,"_25170":58204,"_17548":97509,"_5":17443,"_23820":97304,"_2384":97510},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2857":58271,"_25170":58204,"_17548":97512,"_5":17443,"_23820":97304,"_2384":97513},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2857":58272,"_25170":58204,"_17548":97515,"_5":17443,"_23820":97304,"_2384":97516},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2857":58273,"_25170":58204,"_17548":97518,"_5":17443,"_23820":97304,"_2384":97519},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2857":58274,"_25170":58204,"_17548":97521,"_5":17443,"_23820":97304,"_2384":97522},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2857":58275,"_25170":58204,"_17548":97524,"_5":17443,"_23820":97304,"_2384":97525},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2857":58276,"_25170":58204,"_17548":97527,"_5":17443,"_23820":97304,"_2384":97528},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2857":58277,"_25170":58204,"_17548":97530,"_5":17443,"_23820":97304,"_2384":97531},[],"Las acciones se dividen en dos grupos:",{"_2857":58278,"_25170":58204,"_17548":97533,"_5":17443,"_23820":97304,"_2384":97534},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2857":58279,"_25170":58204,"_17548":97536,"_5":17443,"_23820":97304,"_2384":97537},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2857":58280,"_25170":58204,"_17548":97539,"_5":17443,"_23820":97304,"_2384":97540},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2857":58281,"_25170":58204,"_17548":97542,"_5":17443,"_23820":97308,"_2384":97543},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2857":58282,"_25170":58204,"_17548":97545,"_5":17443,"_23820":97308,"_2384":97546},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2857":58283,"_25170":58204,"_17548":97548,"_5":17443,"_23820":97308,"_2384":97549},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2857":58284,"_25170":58204,"_17548":97551,"_5":17443,"_23820":97312,"_2384":97552},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2857":58285,"_25170":58204,"_17548":97554,"_5":17443,"_23820":97312,"_2384":97555},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2857":58286,"_25170":58204,"_17548":97557,"_5":17443,"_23820":97312,"_2384":97558},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2857":58287,"_25170":58204,"_17548":97560,"_5":17443,"_23820":97312,"_2384":97561},[],"Los operadores implementados son:",{"_2857":58288,"_25170":58204,"_17548":97563,"_5":17443,"_23820":97312,"_2384":97564},[],"`equals`, para igualdad exacta;",{"_2857":58289,"_25170":58204,"_17548":97566,"_5":17443,"_23820":97312,"_2384":97567},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2857":58290,"_25170":58204,"_17548":97569,"_5":17443,"_23820":97312,"_2384":97570},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2857":58291,"_25170":58204,"_17548":97572,"_5":17443,"_23820":97312,"_2384":97573},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2857":58292,"_25170":58204,"_17548":97575,"_5":17443,"_23820":97316,"_2384":97576},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2857":58293,"_25170":58204,"_17548":97578,"_5":17443,"_23820":97316,"_2384":97579},[],"Los modos disponibles son:",{"_2857":58294,"_25170":58204,"_17548":97581,"_5":17443,"_23820":97316,"_2384":97582},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2857":58295,"_25170":58204,"_17548":97584,"_5":17443,"_23820":97316,"_2384":97585},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2857":58296,"_25170":58204,"_17548":97587,"_5":17443,"_23820":97316,"_2384":97588},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2857":58297,"_25170":58204,"_17548":97590,"_5":17443,"_23820":97316,"_2384":97591},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2857":58298,"_25170":58204,"_17548":97593,"_5":17443,"_23820":97316,"_2384":97594},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2857":58299,"_25170":58204,"_17548":97596,"_5":17443,"_23820":97316,"_2384":97597},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2857":58300,"_25170":58204,"_17548":97599,"_5":17443,"_23820":97320,"_2384":97600},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2857":58301,"_25170":58204,"_17548":97602,"_5":17443,"_23820":97320,"_2384":97603},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2857":58302,"_25170":58204,"_17548":97605,"_5":17443,"_23820":97320,"_2384":97606},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2857":58303,"_25170":58204,"_17548":97608,"_5":17443,"_23820":97320,"_2384":97609},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2857":58304,"_25170":58204,"_17548":97611,"_5":17443,"_23820":97328,"_2384":97612},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2857":58305,"_25170":58204,"_17548":97614,"_5":17443,"_23820":97328,"_2384":97615},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2857":58306,"_25170":58204,"_17548":97617,"_5":17443,"_23820":97332,"_2384":97618},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2857":58307,"_25170":58204,"_17548":97620,"_5":17443,"_23820":97332,"_2384":97621},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2857":58308,"_25170":58204,"_17548":97623,"_5":17443,"_23820":97336,"_2384":97624},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2857":58309,"_25170":58204,"_17548":97626,"_5":17443,"_23820":97336,"_2384":97627},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2857":58310,"_25170":58204,"_17548":97629,"_5":17443,"_23820":97336,"_2384":97630},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2857":58311,"_25170":58204,"_17548":97632,"_5":17443,"_23820":97340,"_2384":97633},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2857":58312,"_25170":58204,"_17548":97635,"_5":17443,"_23820":97340,"_2384":97636},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2857":58313,"_25170":58204,"_17548":97638,"_5":17443,"_23820":97340,"_2384":97639},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2857":58314,"_25170":58204,"_17548":97641,"_5":17443,"_23820":97340,"_2384":97642},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2857":58315,"_25170":58204,"_17548":97644,"_5":17443,"_23820":97340,"_2384":97645},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2857":58316,"_25170":58204,"_17548":97647,"_5":17443,"_23820":97340,"_2384":97648},[],"Ten en cuenta que:",{"_2857":58317,"_25170":58204,"_17548":97650,"_5":17443,"_23820":97340,"_2384":97651},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2857":58318,"_25170":58204,"_17548":97653,"_5":17443,"_23820":97340,"_2384":97654},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2857":58319,"_25170":58204,"_17548":97656,"_5":17443,"_23820":97340,"_2384":97657},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2857":58320,"_25170":58204,"_17548":97659,"_5":17443,"_23820":97344,"_2384":97660},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2857":58321,"_25170":58204,"_17548":97662,"_5":17443,"_23820":97344,"_2384":97663},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2857":58322,"_25170":58204,"_17548":97665,"_5":17443,"_23820":97344,"_2384":97666},[],"acceso completo y de solo lectura a KMS;",{"_2857":58323,"_25170":58204,"_17548":97668,"_5":17443,"_23820":97344,"_2384":97669},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2857":58324,"_25170":58204,"_17548":97671,"_5":17443,"_23820":97344,"_2384":97672},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2857":58325,"_25170":58204,"_17548":97674,"_5":17443,"_23820":97344,"_2384":97675},[],"acceso a la interfaz;",{"_2857":58326,"_25170":58204,"_17548":97677,"_5":17443,"_23820":97344,"_2384":97678},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2857":58327,"_25170":58204,"_17548":97680,"_5":17443,"_23820":97344,"_2384":97681},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2857":58328,"_25170":58204,"_17548":97683,"_5":17443,"_23820":97344,"_2384":97684},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2857":58329,"_25170":58204,"_17548":97686,"_5":17443,"_23820":97348,"_2384":97687},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2857":58330,"_25170":58204,"_17548":97689,"_5":17443,"_23820":97348,"_2384":97690},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2857":58331,"_25170":58204,"_17548":97692,"_5":17443,"_23820":97348,"_2384":97693},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2857":58332,"_25170":58204,"_17548":97695,"_5":17443,"_23820":97351,"_2384":97696},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2857":58333,"_25170":58204,"_17548":97698,"_5":17443,"_23820":97355,"_2384":97699},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2857":58334,"_25170":58204,"_17548":97701,"_5":17443,"_23820":97359,"_2384":97702},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2857":58335,"_25170":58204,"_17548":97704,"_5":17443,"_23820":97363,"_2384":97705},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2857":58336,"_25170":58204,"_17548":97707,"_5":17443,"_23820":97367,"_2384":97708},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2857":58337,"_25170":58204,"_17548":97710,"_5":17443,"_23820":97371,"_2384":97711},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2857":58338,"_25170":58204,"_17548":97713,"_5":17443,"_23820":97371,"_2384":97714},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2857":58339,"_25170":58204,"_17548":97716,"_5":17443,"_23820":97375,"_2384":97717},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2857":58340,"_25170":58204,"_17548":97719,"_5":17443,"_23820":97375,"_2384":97720},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2857":58341,"_25170":58204,"_17548":97722,"_5":17443,"_23820":97375,"_2384":97723},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2857":58342,"_25170":58204,"_17548":97725,"_5":17443,"_23820":97375,"_2384":97726},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2857":58343,"_25170":58204,"_17548":97728,"_5":17443,"_23820":97375,"_2384":97729},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2857":58344,"_25170":58204,"_17548":97731,"_5":17443,"_23820":97375,"_2384":97732},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2857":58345,"_25170":58204,"_17548":97734,"_5":17443,"_23820":97375,"_2384":97735},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2857":58346,"_25170":58204,"_17548":97737,"_5":17443,"_23820":97375,"_2384":97738},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2857":58347,"_25170":58204,"_17548":97740,"_5":17443,"_23820":97379,"_2384":97741},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2857":58348,"_25170":58204,"_17548":97743,"_5":17443,"_23820":97379,"_2384":97744},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2857":58349,"_25170":58204,"_17548":97746,"_5":17443,"_23820":97379,"_2384":97747},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2857":58350,"_25170":58204,"_17548":97749,"_5":17443,"_23820":97383,"_2384":97750},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2857":58351,"_25170":58204,"_17548":97752,"_5":17443,"_23820":97383,"_2384":97753},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2857":58352,"_25170":58204,"_17548":97755,"_5":17443,"_23820":97383,"_2384":97756},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2857":58353,"_25170":58204,"_17548":97758,"_5":17443,"_23820":97383,"_2384":97759},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2857":58354,"_25170":58204,"_17548":97761,"_5":17443,"_23820":97383,"_2384":97762},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2857":58355,"_25170":58204,"_17548":97764,"_5":17443,"_23820":97383,"_2384":97765},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2857":58356,"_25170":58204,"_17548":97767,"_5":17443,"_23820":97383,"_2384":97768},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2857":58357,"_25170":58204,"_17548":97770,"_5":17443,"_23820":97383,"_2384":97771},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2857":58358,"_25170":58204,"_17548":97773,"_5":17443,"_23820":97391,"_2384":97774},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2857":58359,"_25170":58204,"_17548":97776,"_5":17443,"_23820":97395,"_2384":97777},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2857":58360,"_25170":58204,"_17548":97779,"_5":17443,"_23820":97395,"_2384":97780},[],"que exista un principal activo del tipo correcto;",{"_2857":58361,"_25170":58204,"_17548":97782,"_5":17443,"_23820":97395,"_2384":97783},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2857":58362,"_25170":58204,"_17548":97785,"_5":17443,"_23820":97395,"_2384":97786},[],"que todas las condiciones del principal se cumplan;",{"_2857":58363,"_25170":58204,"_17548":97788,"_5":17443,"_23820":97395,"_2384":97789},[],"que el principal tenga concedida la política esperada;",{"_2857":58364,"_25170":58204,"_17548":97791,"_5":17443,"_23820":97395,"_2384":97792},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2857":58365,"_25170":58204,"_17548":97794,"_5":17443,"_23820":97395,"_2384":97795},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2857":58366,"_25170":58204,"_17548":97797,"_5":17443,"_23820":97395,"_2384":97798},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2857":58367,"_25170":58204,"_17548":97800,"_5":17443,"_23820":97399,"_2384":97801},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2857":58368,"_25170":58204,"_17548":97803,"_5":17443,"_23820":97403,"_2384":97804},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2857":58369,"_25170":58204,"_17548":97806,"_5":17443,"_23820":97407,"_2384":97807},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2857":58370,"_25170":58204,"_17548":97809,"_5":17443,"_23820":97407,"_2384":97810},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2857":58371,"_25170":58371,"_5":12294,"_2384":97812,"_25506":97813,"_17548":97814,"_23820":58371},"Alertas y suscripciones",[40849,97280,97281],[],{"_2857":58372,"_25170":58371,"_17548":97816,"_5":17443,"_23820":58371,"_2384":97817},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2857":58373,"_25170":58371,"_5":25503,"_17548":97819,"_23820":97820,"_2384":97821},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2857":58374,"_25170":58371,"_5":25503,"_17548":97823,"_23820":97824,"_2384":97825},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2857":58375,"_25170":58371,"_5":25503,"_17548":97827,"_23820":97828,"_2384":97829},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2857":58376,"_25170":58371,"_5":25503,"_17548":97831,"_23820":97832,"_2384":97833},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2857":58377,"_25170":58371,"_5":25503,"_17548":97835,"_23820":97836,"_2384":97837},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2857":58378,"_25170":58371,"_5":25503,"_17548":97839,"_23820":97840,"_2384":97841},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2857":58379,"_25170":58371,"_5":25503,"_17548":97843,"_23820":97844,"_2384":97845},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2857":58380,"_25170":58371,"_5":25503,"_17548":97847,"_23820":97848,"_2384":97849},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2857":58381,"_25170":58371,"_5":25503,"_17548":97851,"_23820":97852,"_2384":97853},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2857":58382,"_25170":58371,"_5":25503,"_17548":97855,"_23820":97856,"_2384":97857},[],"/docs/pr-preview/pr-38/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2857":58383,"_25170":58371,"_17548":97859,"_5":17443,"_23820":58371,"_2384":97860},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2857":58384,"_25170":58371,"_17548":97862,"_5":17443,"_23820":97820,"_2384":97863},[],"Un servicio publica un evento de dominio.",{"_2857":58385,"_25170":58371,"_17548":97865,"_5":17443,"_23820":97820,"_2384":97866},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2857":58386,"_25170":58371,"_17548":97868,"_5":17443,"_23820":97820,"_2384":97869},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2857":58387,"_25170":58371,"_17548":97871,"_5":17443,"_23820":97820,"_2384":97872},[],"Lamassu entrega el evento al canal configurado.",{"_2857":58388,"_25170":58371,"_17548":97874,"_5":17443,"_23820":97820,"_2384":97875},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2857":58389,"_25170":58371,"_17548":97877,"_5":17443,"_23820":97824,"_2384":97878},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2857":58390,"_25170":58371,"_17548":97880,"_5":17443,"_23820":97824,"_2384":97881},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2857":58391,"_25170":58371,"_17548":97883,"_5":17443,"_23820":97824,"_2384":97884},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2857":58392,"_25170":58371,"_17548":97886,"_5":17443,"_23820":97824,"_2384":97887},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2857":58393,"_25170":58371,"_17548":97889,"_5":17443,"_23820":97824,"_2384":97890},[],"`apikey_options` necesita `header` y `key`.",{"_2857":58394,"_25170":58371,"_17548":97892,"_5":17443,"_23820":97824,"_2384":97893},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2857":58395,"_25170":58371,"_17548":97895,"_5":17443,"_23820":97824,"_2384":97896},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2857":58396,"_25170":58371,"_17548":97898,"_5":17443,"_23820":97824,"_2384":97899},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2857":58397,"_25170":58371,"_17548":97901,"_5":17443,"_23820":97832,"_2384":97902},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2857":58398,"_25170":58371,"_17548":97904,"_5":17443,"_23820":97836,"_2384":97905},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2857":58399,"_25170":58371,"_17548":97907,"_5":17443,"_23820":97840,"_2384":97908},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2857":58400,"_25170":58371,"_17548":97910,"_5":17443,"_23820":97840,"_2384":97911},[],"**None** notifica todas las instancias del evento.",{"_2857":58401,"_25170":58371,"_17548":97913,"_5":17443,"_23820":97840,"_2384":97914},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2857":58402,"_25170":58371,"_17548":97916,"_5":17443,"_23820":97840,"_2384":97917},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2857":58403,"_25170":58371,"_17548":97919,"_5":17443,"_23820":97840,"_2384":97920},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2857":58404,"_25170":58371,"_17548":97922,"_5":17443,"_23820":97840,"_2384":97923},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2857":58405,"_25170":58371,"_17548":97925,"_5":17443,"_23820":97844,"_2384":97926},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2857":58406,"_25170":58371,"_17548":97928,"_5":17443,"_23820":97848,"_2384":97929},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2857":58407,"_25170":58371,"_17548":97931,"_5":17443,"_23820":97848,"_2384":97932},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2857":58408,"_25170":58371,"_17548":97934,"_5":17443,"_23820":97848,"_2384":97935},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2857":58409,"_25170":58371,"_17548":97937,"_5":17443,"_23820":97848,"_2384":97938},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2857":58410,"_25170":58371,"_17548":97940,"_5":17443,"_23820":97848,"_2384":97941},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2857":58411,"_25170":58371,"_17548":97943,"_5":17443,"_23820":97848,"_2384":97944},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2857":58412,"_25170":58371,"_17548":97946,"_5":17443,"_23820":97848,"_2384":97947},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2857":58413,"_25170":58371,"_17548":97949,"_5":17443,"_23820":97848,"_2384":97950},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2857":58414,"_25170":58371,"_17548":97952,"_5":17443,"_23820":97852,"_2384":97953},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2857":58415,"_25170":58371,"_17548":97955,"_5":17443,"_23820":97856,"_2384":97956},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2857":58416,"_25170":58371,"_17548":97958,"_5":17443,"_23820":97856,"_2384":97959},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2857":58417,"_25170":58371,"_17548":97961,"_5":17443,"_23820":97856,"_2384":97962},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2857":58418,"_25170":58371,"_17548":97964,"_5":17443,"_23820":97856,"_2384":97965},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2857":58419,"_25170":58371,"_17548":97967,"_5":17443,"_23820":97856,"_2384":97968},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2857":58420,"_25170":58371,"_17548":97970,"_5":17443,"_23820":97856,"_2384":97971},[],"**Validación:** `va.role.crl.create`.",{"_2857":58421,"_25170":58371,"_17548":97973,"_5":17443,"_23820":97856,"_2384":97974},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2857":58422,"_25170":58371,"_17548":97976,"_5":17443,"_23820":97856,"_2384":97977},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2857":58423,"_25170":58423,"_5":12294,"_2384":97979,"_25506":97980,"_17548":97981,"_23820":58423},"Registros de auditoría",[40849,97280,97281],[],{"_2857":58424,"_25170":58423,"_17548":97983,"_5":17443,"_23820":58423,"_2384":97984},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2857":58425,"_25170":58423,"_5":25503,"_17548":97986,"_23820":97987,"_2384":97988},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2857":58426,"_25170":58423,"_5":25503,"_17548":97990,"_23820":97991,"_2384":97992},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2857":58427,"_25170":58423,"_5":25503,"_17548":97994,"_23820":97995,"_2384":97996},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2857":58428,"_25170":58423,"_5":25503,"_17548":97998,"_23820":97999,"_2384":98000},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2857":58429,"_25170":58423,"_5":25503,"_17548":98002,"_23820":98003,"_2384":98004},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2857":58430,"_25170":58423,"_5":25503,"_17548":98006,"_23820":98007,"_2384":98008},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2857":58431,"_25170":58423,"_5":25503,"_17548":98010,"_23820":98011,"_2384":98012},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2857":58432,"_25170":58423,"_5":25503,"_17548":98014,"_23820":98015,"_2384":98016},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2857":58433,"_25170":58423,"_5":25503,"_17548":98018,"_23820":98019,"_2384":98020},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2857":58434,"_25170":58423,"_5":25503,"_17548":98022,"_23820":98023,"_2384":98024},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2857":58435,"_25170":58423,"_5":25503,"_17548":98026,"_23820":98027,"_2384":98028},[],"/docs/pr-preview/pr-38/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2857":58436,"_25170":58423,"_17548":98030,"_5":17443,"_23820":58423,"_2384":98031},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2857":58437,"_25170":58423,"_17548":98033,"_5":17443,"_23820":97987,"_2384":98034},[],"El cuerpo de auditoría incluye:",{"_2857":58438,"_25170":58423,"_17548":98036,"_5":17443,"_23820":97987,"_2384":98037},[],"input: datos recibidos por la operación;",{"_2857":58439,"_25170":58423,"_17548":98039,"_5":17443,"_23820":97987,"_2384":98040},[],"has\\_error: indica si el servicio devolvió un error;",{"_2857":58440,"_25170":58423,"_17548":98042,"_5":17443,"_23820":97987,"_2384":98043},[],"output: resultado producido o mensaje de error;",{"_2857":58441,"_25170":58423,"_17548":98045,"_5":17443,"_23820":97987,"_2384":98046},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2857":58442,"_25170":58423,"_17548":98048,"_5":17443,"_23820":97987,"_2384":98049},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2857":58443,"_25170":58423,"_17548":98051,"_5":17443,"_23820":97987,"_2384":98052},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2857":58444,"_25170":58423,"_17548":98054,"_5":17443,"_23820":97991,"_2384":98055},[],"El backend aplica auditoría a mutaciones de:",{"_2857":58445,"_25170":58423,"_17548":98057,"_5":17443,"_23820":97991,"_2384":98058},[],"autoridades, certificados y perfiles de emisión;",{"_2857":58446,"_25170":58423,"_17548":98060,"_5":17443,"_23820":97991,"_2384":98061},[],"claves y motores KMS;",{"_2857":58447,"_25170":58423,"_17548":98063,"_5":17443,"_23820":97991,"_2384":98064},[],"dispositivos e identidades;",{"_2857":58448,"_25170":58423,"_17548":98066,"_5":17443,"_23820":97991,"_2384":98067},[],"DMS y operaciones de enrolamiento;",{"_2857":58449,"_25170":58423,"_17548":98069,"_5":17443,"_23820":97991,"_2384":98070},[],"funciones de validación y CRL;",{"_2857":58450,"_25170":58423,"_17548":98072,"_5":17443,"_23820":97991,"_2384":98073},[],"principales, políticas y concesiones de autorización.",{"_2857":58451,"_25170":58423,"_17548":98075,"_5":17443,"_23820":97991,"_2384":98076},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2857":58452,"_25170":58423,"_17548":98078,"_5":17443,"_23820":97995,"_2384":98079},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2857":58453,"_25170":58423,"_17548":98081,"_5":17443,"_23820":97995,"_2384":98082},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2857":58454,"_25170":58423,"_17548":98084,"_5":17443,"_23820":97995,"_2384":98085},[],"Diseña el consumidor para:",{"_2857":58455,"_25170":58423,"_17548":98087,"_5":17443,"_23820":97995,"_2384":98088},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2857":58456,"_25170":58423,"_17548":98090,"_5":17443,"_23820":97995,"_2384":98091},[],"conservar el CloudEvent completo sin modificar;",{"_2857":58457,"_25170":58423,"_17548":98093,"_5":17443,"_23820":97995,"_2384":98094},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2857":58458,"_25170":58423,"_17548":98096,"_5":17443,"_23820":97995,"_2384":98097},[],"cifrar en tránsito y en reposo;",{"_2857":58459,"_25170":58423,"_17548":98099,"_5":17443,"_23820":97995,"_2384":98100},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2857":58460,"_25170":58423,"_17548":98102,"_5":17443,"_23820":97995,"_2384":98103},[],"aplicar una política explícita de retención y legal hold;",{"_2857":58461,"_25170":58423,"_17548":98105,"_5":17443,"_23820":97995,"_2384":98106},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2857":58462,"_25170":58423,"_17548":98108,"_5":17443,"_23820":97999,"_2384":98109},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2857":58463,"_25170":58423,"_17548":98111,"_5":17443,"_23820":97999,"_2384":98112},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2857":58464,"_25170":58423,"_17548":98114,"_5":17443,"_23820":98007,"_2384":98115},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2857":58465,"_25170":58423,"_17548":98117,"_5":17443,"_23820":98011,"_2384":98118},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2857":58466,"_25170":58423,"_17548":98120,"_5":17443,"_23820":98015,"_2384":98121},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2857":58467,"_25170":58423,"_17548":98123,"_5":17443,"_23820":98019,"_2384":98124},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2857":58468,"_25170":58423,"_17548":98126,"_5":17443,"_23820":98023,"_2384":98127},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2857":58469,"_25170":58423,"_17548":98129,"_5":17443,"_23820":98027,"_2384":98130},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2857":58470,"_25170":58423,"_17548":98132,"_5":17443,"_23820":98027,"_2384":98133},[],"aparece un evento de auditoría correcto;",{"_2857":58471,"_25170":58423,"_17548":98135,"_5":17443,"_23820":98027,"_2384":98136},[],"el principal coincide con la identidad utilizada;",{"_2857":58472,"_25170":58423,"_17548":98138,"_5":17443,"_23820":98027,"_2384":98139},[],"el consumidor lo persiste una sola vez;",{"_2857":58473,"_25170":58423,"_17548":98141,"_5":17443,"_23820":98027,"_2384":98142},[],"puede recuperarse por recurso, actor y periodo;",{"_2857":58474,"_25170":58423,"_17548":98144,"_5":17443,"_23820":98027,"_2384":98145},[],"una interrupción del consumidor produce una alerta.",{"_2857":58475,"_25170":58423,"_17548":98147,"_5":17443,"_23820":98027,"_2384":98148},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2857":58476,"_25170":58476,"_5":12294,"_2384":98150,"_25506":98151,"_17548":98152,"_23820":58476},"Arquitectura de la plataforma",[40849,97280],[],{"_2857":58477,"_25170":58476,"_17548":98154,"_5":17443,"_23820":58476,"_2384":98155},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2857":58478,"_25170":58476,"_5":25503,"_17548":98157,"_23820":98158,"_2384":98159},[],"/docs/pr-preview/pr-38/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2857":58479,"_25170":58476,"_5":25503,"_17548":98161,"_23820":98162,"_2384":98163},[],"/docs/pr-preview/pr-38/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2857":58480,"_25170":58476,"_5":25503,"_17548":98165,"_23820":98166,"_2384":98167},[],"/docs/pr-preview/pr-38/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2857":58481,"_25170":58476,"_5":25503,"_17548":98169,"_23820":98170,"_2384":98171},[],"/docs/pr-preview/pr-38/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2857":58482,"_25170":58476,"_5":25503,"_17548":98173,"_23820":98174,"_2384":98175},[],"/docs/pr-preview/pr-38/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2857":58483,"_25170":58476,"_17548":98177,"_5":17443,"_23820":58476,"_2384":98178},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2857":58484,"_25170":58476,"_17548":98180,"_5":17443,"_23820":58476,"_2384":98181},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2857":58485,"_25170":58476,"_17548":98183,"_5":17443,"_23820":98158,"_2384":98184},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2857":58486,"_25170":58476,"_17548":98186,"_5":17443,"_23820":98162,"_2384":98187},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2857":58487,"_25170":58476,"_17548":98189,"_5":17443,"_23820":98166,"_2384":98190},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2857":58488,"_25170":58476,"_17548":98192,"_5":17443,"_23820":98170,"_2384":98193},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2857":58489,"_25170":58476,"_17548":98195,"_5":17443,"_23820":98174,"_2384":98196},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2857":58490,"_25170":58490,"_5":12294,"_2384":98198,"_25506":98199,"_17548":98200,"_23820":58490},"Cómo funciona Lamassu",[40849,97280],[],{"_2857":58491,"_25170":58490,"_17548":98202,"_5":17443,"_23820":58490,"_2384":98203},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2857":58492,"_25170":58490,"_5":25503,"_17548":98205,"_23820":98206,"_2384":98207},[],"/docs/pr-preview/pr-38/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2857":58493,"_25170":58490,"_5":25503,"_17548":98209,"_23820":98210,"_2384":98211},[],"/docs/pr-preview/pr-38/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2857":58494,"_25170":58490,"_17548":98213,"_5":17443,"_23820":58490,"_2384":98214},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2857":58495,"_25170":58490,"_17548":98216,"_5":17443,"_23820":98206,"_2384":98217},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2857":58496,"_25170":58490,"_17548":98219,"_5":17443,"_23820":98206,"_2384":98220},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2857":58497,"_25170":58490,"_17548":98222,"_5":17443,"_23820":98206,"_2384":98223},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2857":58498,"_25170":58490,"_17548":98225,"_5":17443,"_23820":98206,"_2384":98226},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2857":58499,"_25170":58490,"_17548":98228,"_5":17443,"_23820":98206,"_2384":98229},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2857":58500,"_25170":58490,"_17548":98231,"_5":17443,"_23820":98210,"_2384":98232},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2857":58501,"_25170":58490,"_17548":98234,"_5":17443,"_23820":98210,"_2384":98235},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2857":58502,"_25170":58490,"_17548":98237,"_5":17443,"_23820":98210,"_2384":98238},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2857":58503,"_25170":58490,"_17548":98240,"_5":17443,"_23820":98210,"_2384":98241},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2857":58504,"_25170":58490,"_17548":98243,"_5":17443,"_23820":98210,"_2384":98244},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2857":58505,"_25170":58490,"_17548":98246,"_5":17443,"_23820":98210,"_2384":98247},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2857":58506,"_25170":58490,"_17548":98249,"_5":17443,"_23820":98210,"_2384":98250},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2857":58507,"_25170":58507,"_5":12294,"_2384":98252,"_25506":98253,"_17548":98254,"_23820":58507},"Dispositivos e identidades",[40849,97280,43167,98252],[],{"_2857":58508,"_25170":58507,"_17548":98256,"_5":17443,"_23820":58507,"_2384":98257},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2857":58509,"_25170":58507,"_5":25503,"_17548":98259,"_23820":98260,"_2384":98261},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2857":58510,"_25170":58507,"_5":25503,"_17548":98263,"_23820":98264,"_2384":98265},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2857":58511,"_25170":58507,"_5":25503,"_17548":98267,"_23820":98268,"_2384":98269},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2857":58512,"_25170":58507,"_5":25503,"_17548":98271,"_23820":98272,"_2384":98273},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2857":58513,"_25170":58507,"_5":25503,"_17548":98275,"_23820":98276,"_2384":98277},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2857":58514,"_25170":58507,"_5":25503,"_17548":98279,"_23820":98280,"_2384":98281},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2857":58515,"_25170":58507,"_5":25503,"_17548":98283,"_23820":98284,"_2384":98285},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2857":58516,"_25170":58507,"_5":25503,"_17548":98287,"_23820":98288,"_2384":98289},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2857":58517,"_25170":58507,"_5":25503,"_17548":98291,"_23820":98292,"_2384":98293},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2857":58518,"_25170":58507,"_5":25503,"_17548":98295,"_23820":98296,"_2384":98297},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2857":58519,"_25170":58507,"_5":25503,"_17548":98299,"_23820":98300,"_2384":98301},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2857":58520,"_25170":58507,"_17548":98303,"_5":17443,"_23820":58507,"_2384":98304},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2857":58521,"_25170":58507,"_17548":98306,"_5":17443,"_23820":58507,"_2384":98307},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2857":58522,"_25170":58507,"_17548":98309,"_5":17443,"_23820":98260,"_2384":98310},[],"Vista operativa",{"_2857":58523,"_25170":58507,"_17548":98312,"_5":17443,"_23820":98260,"_2384":98313},[],"Interpretación",{"_2857":58524,"_25170":58507,"_17548":98315,"_5":17443,"_23820":98260,"_2384":43230},[],{"_2857":58525,"_25170":58507,"_17548":98317,"_5":17443,"_23820":98260,"_2384":98318},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2857":58526,"_25170":58507,"_17548":98320,"_5":17443,"_23820":98260,"_2384":43236},[],{"_2857":58527,"_25170":58507,"_17548":98322,"_5":17443,"_23820":98260,"_2384":98323},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2857":58528,"_25170":58507,"_17548":98325,"_5":17443,"_23820":98260,"_2384":43242},[],{"_2857":58529,"_25170":58507,"_17548":98327,"_5":17443,"_23820":98260,"_2384":98328},[],"La identidad está en la ventana operativa de renovación.",{"_2857":58530,"_25170":58507,"_17548":98330,"_5":17443,"_23820":98260,"_2384":43248},[],{"_2857":58531,"_25170":58507,"_17548":98332,"_5":17443,"_23820":98260,"_2384":98333},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2857":58532,"_25170":58507,"_17548":98335,"_5":17443,"_23820":98260,"_2384":43254},[],{"_2857":58533,"_25170":58507,"_17548":98337,"_5":17443,"_23820":98260,"_2384":98338},[],"La identidad ha vencido.",{"_2857":58534,"_25170":58507,"_17548":98340,"_5":17443,"_23820":98260,"_2384":43260},[],{"_2857":58535,"_25170":58507,"_17548":98342,"_5":17443,"_23820":98260,"_2384":98343},[],"La identidad está marcada como revocada.",{"_2857":58536,"_25170":58507,"_17548":98345,"_5":17443,"_23820":98260,"_2384":43266},[],{"_2857":58537,"_25170":58507,"_17548":98347,"_5":17443,"_23820":98260,"_2384":98348},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2857":58538,"_25170":58507,"_17548":98350,"_5":17443,"_23820":98260,"_2384":98351},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2857":58539,"_25170":58507,"_17548":98353,"_5":17443,"_23820":98264,"_2384":98354},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2857":58540,"_25170":58507,"_17548":98356,"_5":17443,"_23820":98264,"_2384":98357},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2857":58541,"_25170":58507,"_17548":98359,"_5":17443,"_23820":98264,"_2384":98360},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2857":58542,"_25170":58507,"_17548":98362,"_5":17443,"_23820":98264,"_2384":98363},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2857":58543,"_25170":58507,"_17548":98365,"_5":17443,"_23820":98268,"_2384":98366},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2857":58544,"_25170":58507,"_17548":98368,"_5":17443,"_23820":98272,"_2384":98369},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2857":58545,"_25170":58507,"_17548":98371,"_5":17443,"_23820":98276,"_2384":98372},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2857":58546,"_25170":58507,"_17548":98374,"_5":17443,"_23820":98280,"_2384":98375},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2857":58547,"_25170":58507,"_17548":98377,"_5":17443,"_23820":98284,"_2384":98378},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2857":58548,"_25170":58507,"_17548":98380,"_5":17443,"_23820":98284,"_2384":98381},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2857":58549,"_25170":58507,"_17548":98383,"_5":17443,"_23820":98288,"_2384":98384},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2857":58550,"_25170":58507,"_17548":98386,"_5":17443,"_23820":98288,"_2384":98387},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2857":58551,"_25170":58507,"_17548":98389,"_5":17443,"_23820":98288,"_2384":98390},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2857":58552,"_25170":58507,"_17548":98392,"_5":17443,"_23820":98288,"_2384":98393},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2857":58553,"_25170":58507,"_17548":98395,"_5":17443,"_23820":98288,"_2384":98396},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2857":58554,"_25170":58507,"_17548":98398,"_5":17443,"_23820":98288,"_2384":98399},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2857":58555,"_25170":58507,"_17548":98401,"_5":17443,"_23820":98292,"_2384":98402},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2857":58556,"_25170":58507,"_17548":98404,"_5":17443,"_23820":98292,"_2384":98405},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2857":58557,"_25170":58507,"_17548":98407,"_5":17443,"_23820":98296,"_2384":98408},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2857":58558,"_25170":58507,"_17548":98410,"_5":17443,"_23820":98296,"_2384":98411},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2857":58559,"_25170":58507,"_17548":98413,"_5":17443,"_23820":98296,"_2384":98414},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2857":58560,"_25170":58507,"_17548":98416,"_5":17443,"_23820":98296,"_2384":98417},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2857":58561,"_25170":58507,"_17548":98419,"_5":17443,"_23820":98300,"_2384":98420},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2857":58562,"_25170":58507,"_17548":98422,"_5":17443,"_23820":98300,"_2384":98423},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2857":58563,"_25170":58563,"_5":12294,"_2384":98425,"_25506":98426,"_17548":98428,"_23820":58563},"Identidad inicial y autenticación",[40849,97280,43167,98252,98427],"Enrolamiento con PKI",[],{"_2857":58564,"_25170":58563,"_17548":98430,"_5":17443,"_23820":58563,"_2384":98431},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2857":58565,"_25170":58563,"_5":25503,"_17548":98433,"_23820":98434,"_2384":98435},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2857":58566,"_25170":58563,"_5":25503,"_17548":98437,"_23820":98438,"_2384":98439},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2857":58567,"_25170":58563,"_5":25503,"_17548":98441,"_23820":98442,"_2384":98443},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2857":58568,"_25170":58563,"_5":25503,"_17548":98445,"_23820":98446,"_2384":98447},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2857":58569,"_25170":58563,"_5":25503,"_17548":98449,"_23820":98450,"_2384":98451},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2857":58570,"_25170":58563,"_17548":98453,"_5":17443,"_23820":58563,"_2384":98454},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2857":58571,"_25170":58563,"_17548":98456,"_5":17443,"_23820":98434,"_2384":98457},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2857":58572,"_25170":58563,"_17548":98459,"_5":17443,"_23820":98434,"_2384":98460},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2857":58573,"_25170":58563,"_17548":98462,"_5":17443,"_23820":98438,"_2384":98463},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2857":58574,"_25170":58563,"_17548":98465,"_5":17443,"_23820":98438,"_2384":98466},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2857":58575,"_25170":58563,"_17548":98468,"_5":17443,"_23820":98438,"_2384":98469},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2857":58576,"_25170":58563,"_17548":98471,"_5":17443,"_23820":98442,"_2384":98472},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2857":58577,"_25170":58563,"_17548":98474,"_5":17443,"_23820":98442,"_2384":98475},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2857":58578,"_25170":58563,"_17548":98477,"_5":17443,"_23820":98446,"_2384":98478},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2857":58579,"_25170":58563,"_17548":98480,"_5":17443,"_23820":98446,"_2384":98481},[],"Ejemplo de cuerpo:",{"_2857":58580,"_25170":58563,"_17548":98483,"_5":17443,"_23820":98446,"_2384":98484},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2857":58581,"_25170":58563,"_17548":98486,"_5":17443,"_23820":98446,"_2384":98487},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2857":58582,"_25170":58563,"_17548":98489,"_5":17443,"_23820":98446,"_2384":98490},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2857":58583,"_25170":58563,"_17548":98492,"_5":17443,"_23820":98446,"_2384":98493},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2857":58584,"_25170":58563,"_17548":98495,"_5":17443,"_23820":98450,"_2384":98496},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2857":58585,"_25170":58563,"_17548":98498,"_5":17443,"_23820":98450,"_2384":98499},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2857":58586,"_25170":58586,"_5":12294,"_2384":98501,"_25506":98502,"_17548":98503,"_23820":58586},"Configura y opera el DMS",[40849,97280,43167,98252,98427],[],{"_2857":58587,"_25170":58586,"_17548":98505,"_5":17443,"_23820":58586,"_2384":98506},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2857":58588,"_25170":58586,"_5":25503,"_17548":98508,"_23820":98509,"_2384":95981},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2857":58589,"_25170":58586,"_5":25503,"_17548":98511,"_23820":98512,"_2384":98513},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2857":58590,"_25170":58586,"_5":25503,"_17548":98515,"_23820":98516,"_2384":98517},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2857":58591,"_25170":58586,"_5":25503,"_17548":98519,"_23820":98520,"_2384":98521},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2857":58592,"_25170":58586,"_5":25503,"_17548":98523,"_23820":98524,"_2384":98525},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2857":58593,"_25170":58586,"_5":25503,"_17548":98527,"_23820":98528,"_2384":98529},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2857":58594,"_25170":58586,"_5":25503,"_17548":98531,"_23820":98532,"_2384":98533},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2857":58595,"_25170":58586,"_5":25503,"_17548":98535,"_23820":98536,"_2384":98537},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2857":58596,"_25170":58586,"_5":25503,"_17548":98539,"_23820":98540,"_2384":43462},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2857":58597,"_25170":58586,"_5":25503,"_17548":98542,"_23820":98543,"_2384":43466},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2857":58598,"_25170":58586,"_5":25503,"_17548":98545,"_23820":98546,"_2384":98547},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2857":58599,"_25170":58586,"_5":25503,"_17548":98549,"_23820":98550,"_2384":98551},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2857":58600,"_25170":58586,"_5":25503,"_17548":98553,"_23820":98554,"_2384":98555},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2857":58601,"_25170":58586,"_5":25503,"_17548":98557,"_23820":98558,"_2384":98559},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2857":58602,"_25170":58586,"_5":25503,"_17548":98561,"_23820":98562,"_2384":43486},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2857":58603,"_25170":58586,"_5":25503,"_17548":98564,"_23820":98565,"_2384":98566},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2857":58604,"_25170":58586,"_5":25503,"_17548":98568,"_23820":98569,"_2384":98570},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2857":58605,"_25170":58586,"_5":25503,"_17548":98572,"_23820":98573,"_2384":98574},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2857":58606,"_25170":58586,"_17548":98576,"_5":17443,"_23820":58586,"_2384":98577},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2857":58607,"_25170":58586,"_17548":98579,"_5":17443,"_23820":98509,"_2384":98580},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2857":58608,"_25170":58586,"_17548":98582,"_5":17443,"_23820":98509,"_2384":98583},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2857":58609,"_25170":58586,"_17548":98585,"_5":17443,"_23820":98516,"_2384":98586},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2857":58610,"_25170":58586,"_17548":98588,"_5":17443,"_23820":98520,"_2384":98589},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2857":58611,"_25170":58586,"_17548":98591,"_5":17443,"_23820":98524,"_2384":98592},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2857":58612,"_25170":58586,"_17548":98594,"_5":17443,"_23820":98528,"_2384":98595},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2857":58613,"_25170":58586,"_17548":98597,"_5":17443,"_23820":98532,"_2384":98598},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2857":58614,"_25170":58586,"_17548":98600,"_5":17443,"_23820":98540,"_2384":98601},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2857":58615,"_25170":58586,"_17548":98603,"_5":17443,"_23820":98540,"_2384":98604},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2857":58616,"_25170":58586,"_17548":98606,"_5":17443,"_23820":98543,"_2384":98607},[],"Campo de `settings.enrollment_settings`",{"_2857":58617,"_25170":58586,"_17548":98609,"_5":17443,"_23820":98543,"_2384":98610},[],"Decisión",{"_2857":58618,"_25170":58586,"_17548":98612,"_5":17443,"_23820":98543,"_2384":43537},[],{"_2857":58619,"_25170":58586,"_17548":98614,"_5":17443,"_23820":98543,"_2384":98615},[],"`EST_RFC7030` para estas operaciones.",{"_2857":58620,"_25170":58586,"_17548":98617,"_5":17443,"_23820":98543,"_2384":43543},[],{"_2857":58621,"_25170":58586,"_17548":98619,"_5":17443,"_23820":98543,"_2384":98620},[],"ID de la CA que firmará.",{"_2857":58622,"_25170":58586,"_17548":98622,"_5":17443,"_23820":98543,"_2384":43549},[],{"_2857":58623,"_25170":58586,"_17548":98624,"_5":17443,"_23820":98543,"_2384":98625},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2857":58624,"_25170":58586,"_17548":98627,"_5":17443,"_23820":98543,"_2384":43555},[],{"_2857":58625,"_25170":58586,"_17548":98629,"_5":17443,"_23820":98543,"_2384":98630},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2857":58626,"_25170":58586,"_17548":98632,"_5":17443,"_23820":98543,"_2384":43561},[],{"_2857":58627,"_25170":58586,"_17548":98634,"_5":17443,"_23820":98543,"_2384":98635},[],"Uno de los cuatro modos de autenticación.",{"_2857":58628,"_25170":58586,"_17548":98637,"_5":17443,"_23820":98543,"_2384":98638},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2857":58629,"_25170":58586,"_17548":98640,"_5":17443,"_23820":98546,"_2384":98641},[],"Los bloques son independientes:",{"_2857":58630,"_25170":58586,"_17548":98643,"_5":17443,"_23820":98546,"_2384":98644},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2857":58631,"_25170":58586,"_17548":98646,"_5":17443,"_23820":98546,"_2384":98647},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2857":58632,"_25170":58586,"_17548":98649,"_5":17443,"_23820":98546,"_2384":43579},[],{"_2857":58633,"_25170":58586,"_17548":98651,"_5":17443,"_23820":98546,"_2384":98652},[],"Control aplicado en la operación configurada",{"_2857":58634,"_25170":58586,"_17548":98654,"_5":17443,"_23820":98546,"_2384":43585},[],{"_2857":58635,"_25170":58586,"_17548":98656,"_5":17443,"_23820":98546,"_2384":98657},[],"Validación del certificado presentado.",{"_2857":58636,"_25170":58586,"_17548":98659,"_5":17443,"_23820":98546,"_2384":43591},[],{"_2857":58637,"_25170":58586,"_17548":98661,"_5":17443,"_23820":98546,"_2384":98662},[],"Autorización del webhook configurado.",{"_2857":58638,"_25170":58586,"_17548":98664,"_5":17443,"_23820":98546,"_2384":43597},[],{"_2857":58639,"_25170":58586,"_17548":98666,"_5":17443,"_23820":98546,"_2384":98667},[],"Validación del certificado y, después, aprobación del webhook.",{"_2857":58640,"_25170":58586,"_17548":98669,"_5":17443,"_23820":98546,"_2384":43603},[],{"_2857":58641,"_25170":58586,"_17548":98671,"_5":17443,"_23820":98546,"_2384":98672},[],"Sin autenticación del solicitante por el DMS.",{"_2857":58642,"_25170":58586,"_17548":98674,"_5":17443,"_23820":98546,"_2384":98675},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2857":58643,"_25170":58586,"_17548":98677,"_5":17443,"_23820":98546,"_2384":98678},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2857":58644,"_25170":58586,"_17548":98680,"_5":17443,"_23820":98546,"_2384":98681},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_2857":58645,"_25170":58586,"_17548":98683,"_5":17443,"_23820":98546,"_2384":98684},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2857":58646,"_25170":58586,"_17548":98686,"_5":17443,"_23820":98550,"_2384":98687},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2857":58647,"_25170":58586,"_17548":98689,"_5":17443,"_23820":98550,"_2384":98690},[],"Campo de `external_webhook_settings`",{"_2857":58648,"_25170":58586,"_17548":98692,"_5":17443,"_23820":98550,"_2384":98610},[],{"_2857":58649,"_25170":58586,"_17548":98694,"_5":17443,"_23820":98550,"_2384":43629},[],{"_2857":58650,"_25170":58586,"_17548":98696,"_5":17443,"_23820":98550,"_2384":98697},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2857":58651,"_25170":58586,"_17548":98699,"_5":17443,"_23820":98550,"_2384":43635},[],{"_2857":58652,"_25170":58586,"_17548":98701,"_5":17443,"_23820":98550,"_2384":98702},[],"`POST` o `PUT`; `POST` por defecto.",{"_2857":58653,"_25170":58586,"_17548":98704,"_5":17443,"_23820":98550,"_2384":43641},[],{"_2857":58654,"_25170":58586,"_17548":98706,"_5":17443,"_23820":98550,"_2384":98707},[],"Etiqueta usada en los logs del servicio.",{"_2857":58655,"_25170":58586,"_17548":98709,"_5":17443,"_23820":98550,"_2384":43647},[],{"_2857":58656,"_25170":58586,"_17548":98711,"_5":17443,"_23820":98550,"_2384":98712},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2857":58657,"_25170":58586,"_17548":98714,"_5":17443,"_23820":98550,"_2384":43653},[],{"_2857":58658,"_25170":58586,"_17548":98716,"_5":17443,"_23820":98550,"_2384":98717},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2857":58659,"_25170":58586,"_17548":98719,"_5":17443,"_23820":98550,"_2384":43659},[],{"_2857":58660,"_25170":58586,"_17548":98721,"_5":17443,"_23820":98550,"_2384":98722},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2857":58661,"_25170":58586,"_17548":98724,"_5":17443,"_23820":98550,"_2384":43665},[],{"_2857":58662,"_25170":58586,"_17548":98726,"_5":17443,"_23820":98550,"_2384":98727},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2857":58663,"_25170":58586,"_17548":98729,"_5":17443,"_23820":98550,"_2384":43671},[],{"_2857":58664,"_25170":58586,"_17548":98731,"_5":17443,"_23820":98550,"_2384":98732},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2857":58665,"_25170":58586,"_17548":98734,"_5":17443,"_23820":98550,"_2384":43677},[],{"_2857":58666,"_25170":58586,"_17548":98736,"_5":17443,"_23820":98550,"_2384":98737},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2857":58667,"_25170":58586,"_17548":98739,"_5":17443,"_23820":98550,"_2384":98740},[],"Reglas de esa configuración:",{"_2857":58668,"_25170":58586,"_17548":98742,"_5":17443,"_23820":98550,"_2384":98743},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2857":58669,"_25170":58586,"_17548":98745,"_5":17443,"_23820":98550,"_2384":98746},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2857":58670,"_25170":58586,"_17548":98748,"_5":17443,"_23820":98550,"_2384":98749},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2857":58671,"_25170":58586,"_17548":98751,"_5":17443,"_23820":98550,"_2384":98752},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2857":58672,"_25170":58586,"_17548":98754,"_5":17443,"_23820":98550,"_2384":98755},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2857":58673,"_25170":58586,"_17548":98757,"_5":17443,"_23820":98550,"_2384":98758},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2857":58674,"_25170":58586,"_17548":98760,"_5":17443,"_23820":98550,"_2384":98761},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2857":58675,"_25170":58586,"_17548":98763,"_5":17443,"_23820":98550,"_2384":98764},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS.",{"_2857":58676,"_25170":58586,"_17548":98766,"_5":17443,"_23820":98550,"_2384":98767},[],"La migración `20261022120000` traslada `reenrollment_settings.additional_validation_cas` a `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, sustituyendo lo que hubiera en la clave anidada. Ese valor anidado nunca se consultó al validar reenrolamientos, así que el conjunto de confianza efectivo no cambia; una lista plana ausente o nula pasa a ser una lista vacía. Los DMS sin `reenrollment_settings` quedan intactos. Los cuerpos que aún contengan `additional_validation_cas` se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET ya no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con el formato antiguo vacía en silencio la lista migrada.",{"_2857":58677,"_25170":58586,"_17548":98769,"_5":17443,"_23820":98554,"_2384":98770},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2857":58678,"_25170":58586,"_17548":98772,"_5":17443,"_23820":98558,"_2384":98773},[],"Campo de `settings.reenrollment_settings`",{"_2857":58679,"_25170":58586,"_17548":98775,"_5":17443,"_23820":98558,"_2384":98776},[],"Función",{"_2857":58680,"_25170":58586,"_17548":98778,"_5":17443,"_23820":98558,"_2384":43721},[],{"_2857":58681,"_25170":58586,"_17548":98780,"_5":17443,"_23820":98558,"_2384":98781},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2857":58682,"_25170":58586,"_17548":98783,"_5":17443,"_23820":98558,"_2384":43727},[],{"_2857":58683,"_25170":58586,"_17548":98785,"_5":17443,"_23820":98558,"_2384":98786},[],"Umbral operativo preventivo de monitorización.",{"_2857":58684,"_25170":58586,"_17548":98788,"_5":17443,"_23820":98558,"_2384":43733},[],{"_2857":58685,"_25170":58586,"_17548":98790,"_5":17443,"_23820":98558,"_2384":98791},[],"Umbral operativo crítico de monitorización.",{"_2857":58686,"_25170":58586,"_17548":98793,"_5":17443,"_23820":98558,"_2384":43739},[],{"_2857":58687,"_25170":58586,"_17548":98795,"_5":17443,"_23820":98558,"_2384":98796},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2857":58688,"_25170":58586,"_17548":98798,"_5":17443,"_23820":98558,"_2384":43745},[],{"_2857":58689,"_25170":58586,"_17548":98800,"_5":17443,"_23820":98558,"_2384":98801},[],"CAs de validación adicionales para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_2857":58690,"_25170":58586,"_17548":98803,"_5":17443,"_23820":98558,"_2384":43751},[],{"_2857":58691,"_25170":58586,"_17548":98805,"_5":17443,"_23820":98558,"_2384":98806},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2857":58692,"_25170":58586,"_17548":98808,"_5":17443,"_23820":98558,"_2384":98809},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2857":58693,"_25170":58586,"_17548":98811,"_5":17443,"_23820":98562,"_2384":98812},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2857":58694,"_25170":58586,"_17548":98814,"_5":17443,"_23820":98565,"_2384":96338},[],{"_2857":58695,"_25170":58586,"_17548":98816,"_5":17443,"_23820":98565,"_2384":98817},[],"Qué publica",{"_2857":58696,"_25170":58586,"_17548":98819,"_5":17443,"_23820":98565,"_2384":43768},[],{"_2857":58697,"_25170":58586,"_17548":98821,"_5":17443,"_23820":98565,"_2384":98822},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2857":58698,"_25170":58586,"_17548":98824,"_5":17443,"_23820":98565,"_2384":43774},[],{"_2857":58699,"_25170":58586,"_17548":98826,"_5":17443,"_23820":98565,"_2384":98827},[],"Certificado de la CA emisora seleccionada.",{"_2857":58700,"_25170":58586,"_17548":98829,"_5":17443,"_23820":98565,"_2384":43780},[],{"_2857":58701,"_25170":58586,"_17548":98831,"_5":17443,"_23820":98565,"_2384":98832},[],"Certificados de las CAs elegidas explícitamente.",{"_2857":58702,"_25170":58586,"_17548":98834,"_5":17443,"_23820":98565,"_2384":98835},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2857":58703,"_25170":58586,"_17548":98837,"_5":17443,"_23820":98569,"_2384":98838},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2857":58704,"_25170":58586,"_17548":98840,"_5":17443,"_23820":98569,"_2384":98841},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2857":58705,"_25170":58586,"_17548":98843,"_5":17443,"_23820":98569,"_2384":98844},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2857":58706,"_25170":58586,"_17548":98846,"_5":17443,"_23820":98573,"_2384":98847},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2857":58707,"_25170":58707,"_5":12294,"_2384":98849,"_25506":98850,"_17548":98851,"_23820":58707},"Integra el cliente EST",[40849,97280,43167,98252,98427],[],{"_2857":58708,"_25170":58707,"_17548":98853,"_5":17443,"_23820":58707,"_2384":98854},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2857":58709,"_25170":58707,"_5":25503,"_17548":98856,"_23820":98857,"_2384":95981},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2857":58710,"_25170":58707,"_5":25503,"_17548":98859,"_23820":98860,"_2384":98861},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2857":58711,"_25170":58707,"_5":25503,"_17548":98863,"_23820":98864,"_2384":98865},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2857":58712,"_25170":58707,"_5":25503,"_17548":98867,"_23820":98868,"_2384":98869},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2857":58713,"_25170":58707,"_5":25503,"_17548":98871,"_23820":98872,"_2384":98873},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2857":58714,"_25170":58707,"_5":25503,"_17548":98875,"_23820":98876,"_2384":98877},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2857":58715,"_25170":58707,"_17548":98879,"_5":17443,"_23820":58707,"_2384":98880},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2857":58716,"_25170":58707,"_17548":98882,"_5":17443,"_23820":98857,"_2384":98883},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2857":58717,"_25170":58707,"_17548":98885,"_5":17443,"_23820":98857,"_2384":98886},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2857":58718,"_25170":58707,"_17548":98888,"_5":17443,"_23820":98857,"_2384":98889},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2857":58719,"_25170":58707,"_17548":98891,"_5":17443,"_23820":98860,"_2384":98892},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2857":58720,"_25170":58707,"_17548":98894,"_5":17443,"_23820":98860,"_2384":98895},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2857":58721,"_25170":58707,"_17548":98897,"_5":17443,"_23820":98864,"_2384":98898},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2857":58722,"_25170":58707,"_17548":98900,"_5":17443,"_23820":98864,"_2384":98901},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2857":58723,"_25170":58707,"_17548":98903,"_5":17443,"_23820":98868,"_2384":98904},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2857":58724,"_25170":58707,"_17548":98906,"_5":17443,"_23820":98868,"_2384":98907},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2857":58725,"_25170":58707,"_17548":98909,"_5":17443,"_23820":98872,"_2384":98910},[],"Para el caso de una raíz que emite directamente:",{"_2857":58726,"_25170":58707,"_17548":98912,"_5":17443,"_23820":98872,"_2384":98913},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2857":58727,"_25170":58707,"_17548":98915,"_5":17443,"_23820":98872,"_2384":98916},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2857":58728,"_25170":58707,"_17548":98918,"_5":17443,"_23820":98876,"_2384":98919},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2857":58729,"_25170":58729,"_5":12294,"_2384":98921,"_25506":98922,"_17548":98923,"_23820":58729},"Referencia EST",[40849,97280,43167,98252,98427],[],{"_2857":58730,"_25170":58729,"_17548":98925,"_5":17443,"_23820":58729,"_2384":98926},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2857":58731,"_25170":58729,"_5":25503,"_17548":98928,"_23820":98929,"_2384":98930},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2857":58732,"_25170":58729,"_5":25503,"_17548":98932,"_23820":98933,"_2384":19066},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2857":58733,"_25170":58729,"_5":25503,"_17548":98935,"_23820":98936,"_2384":21842},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2857":58734,"_25170":58729,"_5":25503,"_17548":98938,"_23820":98939,"_2384":21849},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2857":58735,"_25170":58729,"_5":25503,"_17548":98941,"_23820":98942,"_2384":21219},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2857":58736,"_25170":58729,"_5":25503,"_17548":98944,"_23820":98945,"_2384":98946},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2857":58737,"_25170":58729,"_5":25503,"_17548":98948,"_23820":98949,"_2384":98950},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2857":58738,"_25170":58729,"_5":25503,"_17548":98952,"_23820":98953,"_2384":98954},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2857":58739,"_25170":58729,"_17548":98956,"_5":17443,"_23820":58729,"_2384":98957},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2857":58740,"_25170":58729,"_17548":98959,"_5":17443,"_23820":98929,"_2384":98960},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2857":58741,"_25170":58729,"_17548":98962,"_5":17443,"_23820":98929,"_2384":97071},[],{"_2857":58742,"_25170":58729,"_17548":98964,"_5":17443,"_23820":98929,"_2384":98965},[],"Método",{"_2857":58743,"_25170":58729,"_17548":98967,"_5":17443,"_23820":98929,"_2384":98968},[],"Autenticación y condición",{"_2857":58744,"_25170":58729,"_17548":98970,"_5":17443,"_23820":98929,"_2384":43923},[],{"_2857":58745,"_25170":58729,"_17548":98972,"_5":17443,"_23820":98929,"_2384":43926},[],{"_2857":58746,"_25170":58729,"_17548":98974,"_5":17443,"_23820":98929,"_2384":98975},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2857":58747,"_25170":58729,"_17548":98977,"_5":17443,"_23820":98929,"_2384":43932},[],{"_2857":58748,"_25170":58729,"_17548":98979,"_5":17443,"_23820":98929,"_2384":43935},[],{"_2857":58749,"_25170":58729,"_17548":98981,"_5":17443,"_23820":98929,"_2384":98982},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2857":58750,"_25170":58729,"_17548":98984,"_5":17443,"_23820":98929,"_2384":43941},[],{"_2857":58751,"_25170":58729,"_17548":98986,"_5":17443,"_23820":98929,"_2384":43935},[],{"_2857":58752,"_25170":58729,"_17548":98988,"_5":17443,"_23820":98929,"_2384":98989},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2857":58753,"_25170":58729,"_17548":98991,"_5":17443,"_23820":98929,"_2384":43949},[],{"_2857":58754,"_25170":58729,"_17548":98993,"_5":17443,"_23820":98929,"_2384":43935},[],{"_2857":58755,"_25170":58729,"_17548":98995,"_5":17443,"_23820":98929,"_2384":98996},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2857":58756,"_25170":58729,"_17548":98998,"_5":17443,"_23820":98929,"_2384":98999},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2857":58757,"_25170":58729,"_17548":99001,"_5":17443,"_23820":98933,"_2384":99002},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2857":58758,"_25170":58729,"_17548":99004,"_5":17443,"_23820":98933,"_2384":99005},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2857":58759,"_25170":58729,"_17548":99007,"_5":17443,"_23820":98936,"_2384":99008},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2857":58760,"_25170":58729,"_17548":99010,"_5":17443,"_23820":98936,"_2384":99011},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2857":58761,"_25170":58729,"_17548":99013,"_5":17443,"_23820":98939,"_2384":99014},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2857":58762,"_25170":58729,"_17548":99016,"_5":17443,"_23820":98939,"_2384":99017},[],"La CA de enrolamiento o una CA de validación configurada en el bloque de reenrolamiento valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2857":58763,"_25170":58729,"_17548":99019,"_5":17443,"_23820":98942,"_2384":99020},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2857":58764,"_25170":58729,"_17548":99022,"_5":17443,"_23820":98942,"_2384":99023},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2857":58765,"_25170":58729,"_17548":99025,"_5":17443,"_23820":98945,"_2384":99026},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2857":58766,"_25170":58729,"_17548":99028,"_5":17443,"_23820":98945,"_2384":99029},[],"Parte",{"_2857":58767,"_25170":58729,"_17548":99031,"_5":17443,"_23820":98945,"_2384":99032},[],"Contenido tras decodificar su Base64",{"_2857":58768,"_25170":58729,"_17548":99034,"_5":17443,"_23820":98945,"_2384":43993},[],{"_2857":58769,"_25170":58729,"_17548":99036,"_5":17443,"_23820":98945,"_2384":99037},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2857":58770,"_25170":58729,"_17548":99039,"_5":17443,"_23820":98945,"_2384":43999},[],{"_2857":58771,"_25170":58729,"_17548":99041,"_5":17443,"_23820":98945,"_2384":99042},[],"PKCS#7 DER con el certificado emitido.",{"_2857":58772,"_25170":58729,"_17548":99044,"_5":17443,"_23820":98945,"_2384":99045},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2857":58773,"_25170":58729,"_17548":99047,"_5":17443,"_23820":98949,"_2384":99048},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2857":58774,"_25170":58729,"_17548":99050,"_5":17443,"_23820":98949,"_2384":99051},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2857":58775,"_25170":58729,"_17548":99053,"_5":17443,"_23820":98949,"_2384":99054},[],"Convierte y comprueba el resultado:",{"_2857":58776,"_25170":58729,"_17548":99056,"_5":17443,"_23820":98949,"_2384":99057},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2857":58777,"_25170":58729,"_17548":99059,"_5":17443,"_23820":98953,"_2384":99060},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2857":58778,"_25170":58729,"_17548":99062,"_5":17443,"_23820":98953,"_2384":99063},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2857":58779,"_25170":58779,"_5":12294,"_2384":98427,"_25506":99065,"_17548":99066,"_23820":58779},[40849,97280,43167,98252,98427],[],{"_2857":58780,"_25170":58779,"_17548":99068,"_5":17443,"_23820":58779,"_2384":99069},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2857":58781,"_25170":58779,"_5":25503,"_17548":99071,"_23820":99072,"_2384":99073},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2857":58782,"_25170":58779,"_5":25503,"_17548":99075,"_23820":99076,"_2384":99077},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2857":58783,"_25170":58779,"_5":25503,"_17548":99079,"_23820":99080,"_2384":99081},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2857":58784,"_25170":58779,"_5":25503,"_17548":99083,"_23820":99084,"_2384":99085},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2857":58785,"_25170":58779,"_17548":99087,"_5":17443,"_23820":58779,"_2384":99088},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2857":58786,"_25170":58779,"_17548":99090,"_5":17443,"_23820":99072,"_2384":99091},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2857":58787,"_25170":58779,"_17548":99093,"_5":17443,"_23820":99072,"_2384":99094},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2857":58788,"_25170":58779,"_17548":99096,"_5":17443,"_23820":99072,"_2384":99097},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2857":58789,"_25170":58779,"_17548":99099,"_5":17443,"_23820":99072,"_2384":99100},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2857":58790,"_25170":58779,"_17548":99102,"_5":17443,"_23820":99072,"_2384":99103},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2857":58791,"_25170":58779,"_17548":99105,"_5":17443,"_23820":99072,"_2384":99106},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2857":58792,"_25170":58779,"_17548":99108,"_5":17443,"_23820":99076,"_2384":99109},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2857":58793,"_25170":58779,"_17548":99111,"_5":17443,"_23820":99076,"_2384":99112},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":58794,"_25170":58779,"_17548":99114,"_5":17443,"_23820":99076,"_2384":99115},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2857":58795,"_25170":58779,"_17548":99117,"_5":17443,"_23820":99076,"_2384":99118},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2857":58796,"_25170":58779,"_17548":99120,"_5":17443,"_23820":99080,"_2384":99121},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2857":58797,"_25170":58779,"_17548":99123,"_5":17443,"_23820":99080,"_2384":99124},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2857":58798,"_25170":58779,"_17548":99126,"_5":17443,"_23820":99080,"_2384":99127},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2857":58799,"_25170":58779,"_17548":99129,"_5":17443,"_23820":99080,"_2384":99130},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2857":58800,"_25170":58779,"_17548":99132,"_5":17443,"_23820":99084,"_2384":99133},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2857":58801,"_25170":58779,"_17548":99135,"_5":17443,"_23820":99084,"_2384":99136},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2857":58802,"_25170":58802,"_5":12294,"_2384":99138,"_25506":99139,"_17548":99140,"_23820":58802},"Estrategias de aprovisionamiento",[40849,97280,43167,98252,98427],[],{"_2857":58803,"_25170":58802,"_17548":99142,"_5":17443,"_23820":58802,"_2384":99143},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2857":58804,"_25170":58802,"_5":25503,"_17548":99145,"_23820":99146,"_2384":99147},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2857":58805,"_25170":58802,"_5":25503,"_17548":99149,"_23820":99150,"_2384":99151},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2857":58806,"_25170":58802,"_5":25503,"_17548":99153,"_23820":99154,"_2384":99155},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2857":58807,"_25170":58802,"_5":25503,"_17548":99157,"_23820":99158,"_2384":99159},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2857":58808,"_25170":58802,"_5":25503,"_17548":99161,"_23820":99162,"_2384":99163},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2857":58809,"_25170":58802,"_17548":99165,"_5":17443,"_23820":58802,"_2384":99166},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2857":58810,"_25170":58802,"_17548":99168,"_5":17443,"_23820":99146,"_2384":99169},[],"Recorrido",{"_2857":58811,"_25170":58802,"_17548":99171,"_5":17443,"_23820":99146,"_2384":99172},[],"Cuándo existe el dispositivo",{"_2857":58812,"_25170":58802,"_17548":99174,"_5":17443,"_23820":99146,"_2384":99175},[],"Qué compruebas",{"_2857":58813,"_25170":58802,"_17548":99177,"_5":17443,"_23820":99146,"_2384":99178},[],"Asignación manual",{"_2857":58814,"_25170":58802,"_17548":99180,"_5":17443,"_23820":99146,"_2384":99181},[],"El operador lo crea antes de asociar un certificado.",{"_2857":58815,"_25170":58802,"_17548":99183,"_5":17443,"_23820":99146,"_2384":99184},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2857":58816,"_25170":58802,"_17548":99186,"_5":17443,"_23820":99146,"_2384":99187},[],"EST con `JITP`",{"_2857":58817,"_25170":58802,"_17548":99189,"_5":17443,"_23820":99146,"_2384":99190},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2857":58818,"_25170":58802,"_17548":99192,"_5":17443,"_23820":99146,"_2384":99193},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2857":58819,"_25170":58802,"_17548":99195,"_5":17443,"_23820":99146,"_2384":99196},[],"EST con `PRE_REGISTRATION`",{"_2857":58820,"_25170":58802,"_17548":99198,"_5":17443,"_23820":99146,"_2384":99199},[],"Debe existir antes de `/simpleenroll`.",{"_2857":58821,"_25170":58802,"_17548":99201,"_5":17443,"_23820":99146,"_2384":99202},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2857":58822,"_25170":58802,"_17548":99204,"_5":17443,"_23820":99146,"_2384":99205},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2857":58823,"_25170":58802,"_17548":99207,"_5":17443,"_23820":99146,"_2384":99208},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2857":58824,"_25170":58802,"_17548":99210,"_5":17443,"_23820":99150,"_2384":99211},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2857":58825,"_25170":58802,"_17548":99213,"_5":17443,"_23820":99150,"_2384":99214},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2857":58826,"_25170":58802,"_17548":99216,"_5":17443,"_23820":99150,"_2384":99217},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2857":58827,"_25170":58802,"_17548":99219,"_5":17443,"_23820":99154,"_2384":99220},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2857":58828,"_25170":58802,"_17548":99222,"_5":17443,"_23820":99154,"_2384":99223},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2857":58829,"_25170":58802,"_17548":99225,"_5":17443,"_23820":99154,"_2384":99226},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2857":58830,"_25170":58802,"_17548":99228,"_5":17443,"_23820":99154,"_2384":99229},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2857":58831,"_25170":58802,"_17548":99231,"_5":17443,"_23820":99154,"_2384":99232},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2857":58832,"_25170":58802,"_17548":99234,"_5":17443,"_23820":99154,"_2384":99235},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2857":58833,"_25170":58802,"_17548":99237,"_5":17443,"_23820":99158,"_2384":96338},[],{"_2857":58834,"_25170":58802,"_17548":99239,"_5":17443,"_23820":99158,"_2384":99240},[],"Material que atraviesa EST",{"_2857":58835,"_25170":58802,"_17548":99242,"_5":17443,"_23820":99158,"_2384":99243},[],"Clave generada por el dispositivo",{"_2857":58836,"_25170":58802,"_17548":99245,"_5":17443,"_23820":99158,"_2384":99246},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2857":58837,"_25170":58802,"_17548":99248,"_5":17443,"_23820":99158,"_2384":99249},[],"Clave ya disponible en el dispositivo",{"_2857":58838,"_25170":58802,"_17548":99251,"_5":17443,"_23820":99158,"_2384":99252},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2857":58839,"_25170":58802,"_17548":99254,"_5":17443,"_23820":99158,"_2384":43486},[],{"_2857":58840,"_25170":58802,"_17548":99256,"_5":17443,"_23820":99158,"_2384":99257},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2857":58841,"_25170":58802,"_17548":99259,"_5":17443,"_23820":99158,"_2384":99260},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2857":58842,"_25170":58802,"_17548":99262,"_5":17443,"_23820":99162,"_2384":99263},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2857":58843,"_25170":58843,"_5":12294,"_2384":99265,"_25506":99266,"_17548":99267,"_23820":58843},"Renovación y recuperación",[40849,97280,43167,98252,98427],[],{"_2857":58844,"_25170":58843,"_17548":99269,"_5":17443,"_23820":58843,"_2384":99270},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2857":58845,"_25170":58843,"_5":25503,"_17548":99272,"_23820":99273,"_2384":99274},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2857":58846,"_25170":58843,"_5":25503,"_17548":99276,"_23820":99277,"_2384":99278},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2857":58847,"_25170":58843,"_5":25503,"_17548":99280,"_23820":99281,"_2384":99282},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2857":58848,"_25170":58843,"_5":25503,"_17548":99284,"_23820":99285,"_2384":99286},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2857":58849,"_25170":58843,"_5":25503,"_17548":99288,"_23820":99289,"_2384":99290},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2857":58850,"_25170":58843,"_17548":99292,"_5":17443,"_23820":58843,"_2384":99293},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2857":58851,"_25170":58843,"_17548":99295,"_5":17443,"_23820":99273,"_2384":99296},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2857":58852,"_25170":58843,"_17548":99298,"_5":17443,"_23820":99273,"_2384":99299},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2857":58853,"_25170":58843,"_17548":99301,"_5":17443,"_23820":99273,"_2384":99302},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2857":58854,"_25170":58843,"_17548":99304,"_5":17443,"_23820":99273,"_2384":99305},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2857":58855,"_25170":58843,"_17548":99307,"_5":17443,"_23820":99277,"_2384":99308},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2857":58856,"_25170":58843,"_17548":99310,"_5":17443,"_23820":99277,"_2384":99311},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2857":58857,"_25170":58843,"_17548":99313,"_5":17443,"_23820":99281,"_2384":99314},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2857":58858,"_25170":58843,"_17548":99316,"_5":17443,"_23820":99281,"_2384":99317},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2857":58859,"_25170":58843,"_17548":99319,"_5":17443,"_23820":99281,"_2384":99320},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2857":58860,"_25170":58843,"_17548":99322,"_5":17443,"_23820":99285,"_2384":99323},[],"Situación",{"_2857":58861,"_25170":58843,"_17548":99325,"_5":17443,"_23820":99285,"_2384":99326},[],"Procedimiento",{"_2857":58862,"_25170":58843,"_17548":99328,"_5":17443,"_23820":99285,"_2384":99329},[],"Certificado vigente, fuera de ventana",{"_2857":58863,"_25170":58843,"_17548":99331,"_5":17443,"_23820":99285,"_2384":99332},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2857":58864,"_25170":58843,"_17548":99334,"_5":17443,"_23820":99285,"_2384":99335},[],"Certificado vencido, clave disponible",{"_2857":58865,"_25170":58843,"_17548":99337,"_5":17443,"_23820":99285,"_2384":99338},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2857":58866,"_25170":58843,"_17548":99340,"_5":17443,"_23820":99285,"_2384":99341},[],"Renovación por webhook o `NO_AUTH`",{"_2857":58867,"_25170":58843,"_17548":99343,"_5":17443,"_23820":99285,"_2384":99344},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2857":58868,"_25170":58843,"_17548":99346,"_5":17443,"_23820":99285,"_2384":99347},[],"Clave perdida o inaccesible",{"_2857":58869,"_25170":58843,"_17548":99349,"_5":17443,"_23820":99285,"_2384":99350},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2857":58870,"_25170":58843,"_17548":99352,"_5":17443,"_23820":99285,"_2384":99353},[],"Identidad actual revocada",{"_2857":58871,"_25170":58843,"_17548":99355,"_5":17443,"_23820":99285,"_2384":99356},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2857":58872,"_25170":58843,"_17548":99358,"_5":17443,"_23820":99285,"_2384":99359},[],"Dispositivo sin identidad",{"_2857":58873,"_25170":58843,"_17548":99361,"_5":17443,"_23820":99285,"_2384":99362},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2857":58874,"_25170":58843,"_17548":99364,"_5":17443,"_23820":99285,"_2384":99365},[],"Dispositivo retirado",{"_2857":58875,"_25170":58843,"_17548":99367,"_5":17443,"_23820":99285,"_2384":99368},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2857":58876,"_25170":58843,"_17548":99370,"_5":17443,"_23820":99285,"_2384":99371},[],"Timeout, HTTP 500 o fallo de instalación",{"_2857":58877,"_25170":58843,"_17548":99373,"_5":17443,"_23820":99285,"_2384":99374},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2857":58878,"_25170":58843,"_17548":99376,"_5":17443,"_23820":99289,"_2384":99377},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2857":58879,"_25170":58843,"_17548":99379,"_5":17443,"_23820":99289,"_2384":99380},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2857":58880,"_25170":58880,"_5":12294,"_2384":99382,"_25506":99383,"_17548":99384,"_23820":58880},"Diagnóstico de enrolamiento",[40849,97280,43167,98252,98427],[],{"_2857":58881,"_25170":58880,"_17548":99386,"_5":17443,"_23820":58880,"_2384":99387},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2857":58882,"_25170":58880,"_5":25503,"_17548":99389,"_23820":99390,"_2384":99391},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2857":58883,"_25170":58880,"_5":25503,"_17548":99393,"_23820":99394,"_2384":99395},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2857":58884,"_25170":58880,"_5":25503,"_17548":99397,"_23820":99398,"_2384":98954},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2857":58885,"_25170":58880,"_5":25503,"_17548":99400,"_23820":99401,"_2384":99402},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2857":58886,"_25170":58880,"_17548":99404,"_5":17443,"_23820":58880,"_2384":99405},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2857":58887,"_25170":58880,"_17548":99407,"_5":17443,"_23820":99394,"_2384":99408},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2857":58888,"_25170":58880,"_17548":99410,"_5":17443,"_23820":99394,"_2384":99411},[],"Síntoma o mensaje",{"_2857":58889,"_25170":58880,"_17548":99413,"_5":17443,"_23820":99394,"_2384":99414},[],"Qué revisar",{"_2857":58890,"_25170":58880,"_17548":99416,"_5":17443,"_23820":99394,"_2384":99417},[],"curl rechaza TLS, nombre o emisor",{"_2857":58891,"_25170":58880,"_17548":99419,"_5":17443,"_23820":99394,"_2384":99420},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2857":58892,"_25170":58880,"_17548":99422,"_5":17443,"_23820":99394,"_2384":99423},[],"404 o APS ausente",{"_2857":58893,"_25170":58880,"_17548":99425,"_5":17443,"_23820":99394,"_2384":99426},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2857":58894,"_25170":58880,"_17548":99428,"_5":17443,"_23820":99394,"_2384":99429},[],"400, error de CSR o formato",{"_2857":58895,"_25170":58880,"_17548":99431,"_5":17443,"_23820":99394,"_2384":99432},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2857":58896,"_25170":58880,"_17548":99434,"_5":17443,"_23820":99394,"_2384":99435},[],"Credencial ausente o certificado no válido",{"_2857":58897,"_25170":58880,"_17548":99437,"_5":17443,"_23820":99394,"_2384":99438},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2857":58898,"_25170":58880,"_17548":99440,"_5":17443,"_23820":99394,"_2384":99441},[],"Webhook deniega, expira o responde sin autorización",{"_2857":58899,"_25170":58880,"_17548":99443,"_5":17443,"_23820":99394,"_2384":99444},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2857":58900,"_25170":58880,"_17548":99446,"_5":17443,"_23820":99394,"_2384":44406},[],{"_2857":58901,"_25170":58880,"_17548":99448,"_5":17443,"_23820":99394,"_2384":99449},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2857":58902,"_25170":58880,"_17548":99451,"_5":17443,"_23820":99394,"_2384":44412},[],{"_2857":58903,"_25170":58880,"_17548":99453,"_5":17443,"_23820":99394,"_2384":99454},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2857":58904,"_25170":58880,"_17548":99456,"_5":17443,"_23820":99394,"_2384":44418},[],{"_2857":58905,"_25170":58880,"_17548":99458,"_5":17443,"_23820":99394,"_2384":99459},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el PEM como `cert_content` y `key_content`; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2857":58906,"_25170":58880,"_17548":99461,"_5":17443,"_23820":99394,"_2384":99462},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2857":58907,"_25170":58880,"_17548":99464,"_5":17443,"_23820":99394,"_2384":99465},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2857":58908,"_25170":58880,"_17548":99467,"_5":17443,"_23820":99394,"_2384":99468},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2857":58909,"_25170":58880,"_17548":99470,"_5":17443,"_23820":99394,"_2384":99471},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2857":58910,"_25170":58880,"_17548":99473,"_5":17443,"_23820":99394,"_2384":44436},[],{"_2857":58911,"_25170":58880,"_17548":99475,"_5":17443,"_23820":99394,"_2384":99476},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2857":58912,"_25170":58880,"_17548":99478,"_5":17443,"_23820":99394,"_2384":44442},[],{"_2857":58913,"_25170":58880,"_17548":99480,"_5":17443,"_23820":99394,"_2384":99481},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2857":58914,"_25170":58880,"_17548":99483,"_5":17443,"_23820":99394,"_2384":99484},[],"DMS propietario distinto",{"_2857":58915,"_25170":58880,"_17548":99486,"_5":17443,"_23820":99394,"_2384":99487},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2857":58916,"_25170":58880,"_17548":99489,"_5":17443,"_23820":99394,"_2384":44454},[],{"_2857":58917,"_25170":58880,"_17548":99491,"_5":17443,"_23820":99394,"_2384":99492},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2857":58918,"_25170":58880,"_17548":99494,"_5":17443,"_23820":99394,"_2384":44460},[],{"_2857":58919,"_25170":58880,"_17548":99496,"_5":17443,"_23820":99394,"_2384":99497},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2857":58920,"_25170":58880,"_17548":99499,"_5":17443,"_23820":99394,"_2384":99500},[],"Certificado actual revocado",{"_2857":58921,"_25170":58880,"_17548":99502,"_5":17443,"_23820":99394,"_2384":99503},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2857":58922,"_25170":58880,"_17548":99505,"_5":17443,"_23820":99394,"_2384":99506},[],"Error de CA, perfil o firma",{"_2857":58923,"_25170":58880,"_17548":99508,"_5":17443,"_23820":99394,"_2384":99509},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2857":58924,"_25170":58880,"_17548":99511,"_5":17443,"_23820":99394,"_2384":99512},[],"HTTP 200 sin conexión del dispositivo",{"_2857":58925,"_25170":58880,"_17548":99514,"_5":17443,"_23820":99394,"_2384":99515},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2857":58926,"_25170":58880,"_17548":99517,"_5":17443,"_23820":99394,"_2384":99518},[],"Timeout o error después de emitir",{"_2857":58927,"_25170":58880,"_17548":99520,"_5":17443,"_23820":99394,"_2384":99521},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2857":58928,"_25170":58880,"_17548":99523,"_5":17443,"_23820":99398,"_2384":99524},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2857":58929,"_25170":58880,"_17548":99526,"_5":17443,"_23820":99398,"_2384":99527},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2857":58930,"_25170":58880,"_17548":99529,"_5":17443,"_23820":99401,"_2384":99530},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2857":58931,"_25170":58880,"_17548":99532,"_5":17443,"_23820":99401,"_2384":99533},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2857":58932,"_25170":58880,"_17548":99535,"_5":17443,"_23820":99401,"_2384":99536},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2857":58933,"_25170":58880,"_17548":99538,"_5":17443,"_23820":99401,"_2384":99539},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2857":58934,"_25170":58880,"_17548":99541,"_5":17443,"_23820":99401,"_2384":99542},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2857":58935,"_25170":58880,"_17548":99544,"_5":17443,"_23820":99401,"_2384":99545},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2857":58936,"_25170":58880,"_17548":99547,"_5":17443,"_23820":99401,"_2384":99548},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2857":58937,"_25170":58937,"_5":12294,"_2384":99550,"_25506":99551,"_17548":99552,"_23820":58937},"Distribución y actualización de confianza",[40849,97280,43167,98252,98427],[],{"_2857":58938,"_25170":58937,"_17548":99554,"_5":17443,"_23820":58937,"_2384":99555},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2857":58939,"_25170":58937,"_5":25503,"_17548":99557,"_23820":99558,"_2384":99559},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2857":58940,"_25170":58937,"_5":25503,"_17548":99561,"_23820":99562,"_2384":99563},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2857":58941,"_25170":58937,"_5":25503,"_17548":99565,"_23820":99566,"_2384":99567},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2857":58942,"_25170":58937,"_5":25503,"_17548":99569,"_23820":99570,"_2384":99571},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2857":58943,"_25170":58937,"_5":25503,"_17548":99573,"_23820":99574,"_2384":99575},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2857":58944,"_25170":58937,"_17548":99577,"_5":17443,"_23820":58937,"_2384":99578},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2857":58945,"_25170":58937,"_17548":99580,"_5":17443,"_23820":99558,"_2384":99581},[],"Relación",{"_2857":58946,"_25170":58937,"_17548":99583,"_5":17443,"_23820":99558,"_2384":99584},[],"Material que prepara el responsable",{"_2857":58947,"_25170":58937,"_17548":99586,"_5":17443,"_23820":99558,"_2384":99587},[],"Dispositivo → servidor EST",{"_2857":58948,"_25170":58937,"_17548":99589,"_5":17443,"_23820":99558,"_2384":99590},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2857":58949,"_25170":58937,"_17548":99592,"_5":17443,"_23820":99558,"_2384":99593},[],"DMS → solicitante",{"_2857":58950,"_25170":58937,"_17548":99595,"_5":17443,"_23820":99558,"_2384":99596},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2857":58951,"_25170":58937,"_17548":99598,"_5":17443,"_23820":99558,"_2384":99599},[],"Consumidor → dispositivo",{"_2857":58952,"_25170":58937,"_17548":99601,"_5":17443,"_23820":99558,"_2384":99602},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2857":58953,"_25170":58937,"_17548":99604,"_5":17443,"_23820":99558,"_2384":99605},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2857":58954,"_25170":58937,"_17548":99607,"_5":17443,"_23820":99562,"_2384":99608},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2857":58955,"_25170":58937,"_17548":99610,"_5":17443,"_23820":99562,"_2384":99611},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2857":58956,"_25170":58937,"_17548":99613,"_5":17443,"_23820":99566,"_2384":99614},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2857":58957,"_25170":58937,"_17548":99616,"_5":17443,"_23820":99566,"_2384":99617},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2857":58958,"_25170":58937,"_17548":99619,"_5":17443,"_23820":99566,"_2384":99620},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2857":58959,"_25170":58937,"_17548":99622,"_5":17443,"_23820":99566,"_2384":99623},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2857":58960,"_25170":58937,"_17548":99625,"_5":17443,"_23820":99566,"_2384":99626},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2857":58961,"_25170":58937,"_17548":99628,"_5":17443,"_23820":99566,"_2384":99629},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2857":58962,"_25170":58937,"_17548":99631,"_5":17443,"_23820":99570,"_2384":99632},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2857":58963,"_25170":58937,"_17548":99634,"_5":17443,"_23820":99570,"_2384":99635},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Al cambiar la CA de enrolamiento, añade a esa lista la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento; los valores migrados de `additional_validation_cas` viven ahora ahí. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2857":58964,"_25170":58937,"_17548":99637,"_5":17443,"_23820":99570,"_2384":99638},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2857":58965,"_25170":58937,"_17548":99640,"_5":17443,"_23820":99574,"_2384":99641},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2857":58966,"_25170":58966,"_5":12294,"_2384":44609,"_25506":99643,"_17548":99645,"_23820":58966},[40849,97280,43167,98252,99644],"Integraciones",[],{"_2857":58967,"_25170":58966,"_17548":99647,"_5":17443,"_23820":58966,"_2384":99648},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2857":58968,"_25170":58966,"_5":25503,"_17548":99650,"_23820":99651,"_2384":99652},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2857":58969,"_25170":58966,"_5":25503,"_17548":99654,"_23820":99655,"_2384":99656},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2857":58970,"_25170":58966,"_5":25503,"_17548":99658,"_23820":99659,"_2384":99660},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2857":58971,"_25170":58966,"_5":25503,"_17548":99662,"_23820":99663,"_2384":99664},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2857":58972,"_25170":58966,"_5":25503,"_17548":99666,"_23820":99667,"_2384":99668},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2857":58973,"_25170":58966,"_5":25503,"_17548":99670,"_23820":99671,"_2384":99672},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2857":58974,"_25170":58966,"_5":25503,"_17548":99674,"_23820":99675,"_2384":44643},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2857":58975,"_25170":58966,"_5":25503,"_17548":99677,"_23820":99678,"_2384":44647},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2857":58976,"_25170":58966,"_5":25503,"_17548":99680,"_23820":99681,"_2384":99682},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2857":58977,"_25170":58966,"_5":25503,"_17548":99684,"_23820":99685,"_2384":99686},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2857":58978,"_25170":58966,"_5":25503,"_17548":99688,"_23820":99689,"_2384":99690},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2857":58979,"_25170":58966,"_5":25503,"_17548":99692,"_23820":99693,"_2384":99694},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2857":58980,"_25170":58966,"_5":25503,"_17548":99696,"_23820":99697,"_2384":99698},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2857":58981,"_25170":58966,"_5":25503,"_17548":99700,"_23820":99701,"_2384":99702},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2857":58982,"_25170":58966,"_5":25503,"_17548":99704,"_23820":99705,"_2384":99706},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2857":58983,"_25170":58966,"_5":25503,"_17548":99708,"_23820":99709,"_2384":99710},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2857":58984,"_25170":58966,"_5":25503,"_17548":99712,"_23820":99713,"_2384":99714},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2857":58985,"_25170":58966,"_5":25503,"_17548":99716,"_23820":99717,"_2384":99718},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2857":58986,"_25170":58966,"_5":25503,"_17548":99720,"_23820":99721,"_2384":99722},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2857":58987,"_25170":58966,"_5":25503,"_17548":99724,"_23820":99725,"_2384":99726},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2857":58988,"_25170":58966,"_17548":99728,"_5":17443,"_23820":58966,"_2384":99729},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2857":58989,"_25170":58966,"_17548":99731,"_5":17443,"_23820":58966,"_2384":99732},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2857":58990,"_25170":58966,"_17548":99734,"_5":17443,"_23820":58966,"_2384":99735},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2857":58991,"_25170":58966,"_17548":99737,"_5":17443,"_23820":99651,"_2384":99738},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2857":58992,"_25170":58966,"_17548":99740,"_5":17443,"_23820":99651,"_2384":99741},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2857":58993,"_25170":58966,"_17548":99743,"_5":17443,"_23820":99651,"_2384":99744},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2857":58994,"_25170":58966,"_17548":99746,"_5":17443,"_23820":99651,"_2384":99747},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2857":58995,"_25170":58966,"_17548":99749,"_5":17443,"_23820":99655,"_2384":99750},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2857":58996,"_25170":58966,"_17548":99752,"_5":17443,"_23820":99659,"_2384":99753},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2857":58997,"_25170":58966,"_17548":99755,"_5":17443,"_23820":99659,"_2384":99756},[],"Acción IAM",{"_2857":58998,"_25170":58966,"_17548":99758,"_5":17443,"_23820":99659,"_2384":96344},[],{"_2857":58999,"_25170":58966,"_17548":99760,"_5":17443,"_23820":99659,"_2384":44730},[],{"_2857":59000,"_25170":58966,"_17548":99762,"_5":17443,"_23820":99659,"_2384":99763},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2857":59001,"_25170":58966,"_17548":99765,"_5":17443,"_23820":99659,"_2384":44736},[],{"_2857":59002,"_25170":58966,"_17548":99767,"_5":17443,"_23820":99659,"_2384":99768},[],"Registrar la CA en AWS IoT",{"_2857":59003,"_25170":58966,"_17548":99770,"_5":17443,"_23820":99659,"_2384":44742},[],{"_2857":59004,"_25170":58966,"_17548":99772,"_5":17443,"_23820":99659,"_2384":99773},[],"Consultar el estado del registro de la CA",{"_2857":59005,"_25170":58966,"_17548":99775,"_5":17443,"_23820":99659,"_2384":44748},[],{"_2857":59006,"_25170":58966,"_17548":99777,"_5":17443,"_23820":99659,"_2384":99778},[],"Crear o actualizar Things en IoT Core",{"_2857":59007,"_25170":58966,"_17548":99780,"_5":17443,"_23820":99659,"_2384":44754},[],{"_2857":59008,"_25170":58966,"_17548":99782,"_5":17443,"_23820":99659,"_2384":99783},[],"Aprovisionar Things mediante plantilla",{"_2857":59009,"_25170":58966,"_17548":99785,"_5":17443,"_23820":99659,"_2384":44760},[],{"_2857":59010,"_25170":58966,"_17548":99787,"_5":17443,"_23820":99659,"_2384":99788},[],"Registrar certificados de dispositivo",{"_2857":59011,"_25170":58966,"_17548":99790,"_5":17443,"_23820":99659,"_2384":44766},[],{"_2857":59012,"_25170":58966,"_17548":99792,"_5":17443,"_23820":99659,"_2384":99793},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2857":59013,"_25170":58966,"_17548":99795,"_5":17443,"_23820":99659,"_2384":44772},[],{"_2857":59014,"_25170":58966,"_17548":99797,"_5":17443,"_23820":99659,"_2384":99798},[],"Crear y adjuntar políticas IoT",{"_2857":59015,"_25170":58966,"_17548":99800,"_5":17443,"_23820":99659,"_2384":44778},[],{"_2857":59016,"_25170":58966,"_17548":99802,"_5":17443,"_23820":99659,"_2384":99803},[],"Gestionar grupos de Things",{"_2857":59017,"_25170":58966,"_17548":99805,"_5":17443,"_23820":99659,"_2384":44784},[],{"_2857":59018,"_25170":58966,"_17548":99807,"_5":17443,"_23820":99659,"_2384":99808},[],"Crear plantillas JITP",{"_2857":59019,"_25170":58966,"_17548":99810,"_5":17443,"_23820":99659,"_2384":44790},[],{"_2857":59020,"_25170":58966,"_17548":99812,"_5":17443,"_23820":99659,"_2384":99813},[],"Leer y escribir el Device Shadow",{"_2857":59021,"_25170":58966,"_17548":99815,"_5":17443,"_23820":99659,"_2384":99816},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2857":59022,"_25170":58966,"_17548":99818,"_5":17443,"_23820":99663,"_2384":99819},[],"Parámetro",{"_2857":59023,"_25170":58966,"_17548":99821,"_5":17443,"_23820":99663,"_2384":99822},[],"Tipo",{"_2857":59024,"_25170":58966,"_17548":99824,"_5":17443,"_23820":99663,"_2384":99825},[],"Requerido",{"_2857":59025,"_25170":58966,"_17548":99827,"_5":17443,"_23820":99663,"_2384":99828},[],"Descripción",{"_2857":59026,"_25170":58966,"_17548":99830,"_5":17443,"_23820":99663,"_2384":44811},[],{"_2857":59027,"_25170":58966,"_17548":99832,"_5":17443,"_23820":99663,"_2384":20963},[],{"_2857":59028,"_25170":58966,"_17548":99834,"_5":17443,"_23820":99663,"_2384":99835},[],"Sí",{"_2857":59029,"_25170":58966,"_17548":99837,"_5":17443,"_23820":99663,"_2384":99838},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2857":59030,"_25170":58966,"_17548":99840,"_5":17443,"_23820":99663,"_2384":44822},[],{"_2857":59031,"_25170":58966,"_17548":99842,"_5":17443,"_23820":99663,"_2384":20963},[],{"_2857":59032,"_25170":58966,"_17548":99844,"_5":17443,"_23820":99663,"_2384":99835},[],{"_2857":59033,"_25170":58966,"_17548":99846,"_5":17443,"_23820":99663,"_2384":99847},[],"Región AWS donde opera el conector.",{"_2857":59034,"_25170":58966,"_17548":99849,"_5":17443,"_23820":99663,"_2384":44832},[],{"_2857":59035,"_25170":58966,"_17548":99851,"_5":17443,"_23820":99663,"_2384":20963},[],{"_2857":59036,"_25170":58966,"_17548":99853,"_5":17443,"_23820":99663,"_2384":99835},[],{"_2857":59037,"_25170":58966,"_17548":99855,"_5":17443,"_23820":99663,"_2384":99856},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2857":59038,"_25170":58966,"_17548":99858,"_5":17443,"_23820":99663,"_2384":44842},[],{"_2857":59039,"_25170":58966,"_17548":99860,"_5":17443,"_23820":99663,"_2384":20963},[],{"_2857":59040,"_25170":58966,"_17548":99862,"_5":17443,"_23820":99663,"_2384":99863},[],"Solo con `auth_method=static`",{"_2857":59041,"_25170":58966,"_17548":99865,"_5":17443,"_23820":99663,"_2384":99866},[],"Clave de acceso AWS.",{"_2857":59042,"_25170":58966,"_17548":99868,"_5":17443,"_23820":99663,"_2384":44853},[],{"_2857":59043,"_25170":58966,"_17548":99870,"_5":17443,"_23820":99663,"_2384":20963},[],{"_2857":59044,"_25170":58966,"_17548":99872,"_5":17443,"_23820":99663,"_2384":99863},[],{"_2857":59045,"_25170":58966,"_17548":99874,"_5":17443,"_23820":99663,"_2384":99875},[],"Clave secreta AWS.",{"_2857":59046,"_25170":58966,"_17548":99877,"_5":17443,"_23820":99663,"_2384":44863},[],{"_2857":59047,"_25170":58966,"_17548":99879,"_5":17443,"_23820":99663,"_2384":20963},[],{"_2857":59048,"_25170":58966,"_17548":99881,"_5":17443,"_23820":99663,"_2384":44868},[],{"_2857":59049,"_25170":58966,"_17548":99883,"_5":17443,"_23820":99663,"_2384":99884},[],"Token de sesión (con `auth_method=static`).",{"_2857":59050,"_25170":58966,"_17548":99886,"_5":17443,"_23820":99663,"_2384":44874},[],{"_2857":59051,"_25170":58966,"_17548":99888,"_5":17443,"_23820":99663,"_2384":20963},[],{"_2857":59052,"_25170":58966,"_17548":99890,"_5":17443,"_23820":99663,"_2384":99891},[],"Solo con `auth_method=role`",{"_2857":59053,"_25170":58966,"_17548":99893,"_5":17443,"_23820":99663,"_2384":99894},[],"ARN del rol a asumir.",{"_2857":59054,"_25170":58966,"_17548":99896,"_5":17443,"_23820":99663,"_2384":44885},[],{"_2857":59055,"_25170":58966,"_17548":99898,"_5":17443,"_23820":99663,"_2384":20963},[],{"_2857":59056,"_25170":58966,"_17548":99900,"_5":17443,"_23820":99663,"_2384":44868},[],{"_2857":59057,"_25170":58966,"_17548":99902,"_5":17443,"_23820":99663,"_2384":99903},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2857":59058,"_25170":58966,"_17548":99905,"_5":17443,"_23820":99663,"_2384":44895},[],{"_2857":59059,"_25170":58966,"_17548":99907,"_5":17443,"_23820":99663,"_2384":14719},[],{"_2857":59060,"_25170":58966,"_17548":99909,"_5":17443,"_23820":99663,"_2384":99835},[],{"_2857":59061,"_25170":58966,"_17548":99911,"_5":17443,"_23820":99663,"_2384":99912},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2857":59062,"_25170":58966,"_17548":99914,"_5":17443,"_23820":99663,"_2384":44905},[],{"_2857":59063,"_25170":58966,"_17548":99916,"_5":17443,"_23820":99663,"_2384":20963},[],{"_2857":59064,"_25170":58966,"_17548":99918,"_5":17443,"_23820":99663,"_2384":99835},[],{"_2857":59065,"_25170":58966,"_17548":99920,"_5":17443,"_23820":99663,"_2384":99921},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2857":59066,"_25170":58966,"_17548":99923,"_5":17443,"_23820":99663,"_2384":44915},[],{"_2857":59067,"_25170":58966,"_17548":99925,"_5":17443,"_23820":99663,"_2384":20963},[],{"_2857":59068,"_25170":58966,"_17548":99927,"_5":17443,"_23820":99663,"_2384":99835},[],{"_2857":59069,"_25170":58966,"_17548":99929,"_5":17443,"_23820":99663,"_2384":99930},[],"URL HTTP del Device Manager de Lamassu.",{"_2857":59070,"_25170":58966,"_17548":99932,"_5":17443,"_23820":99663,"_2384":44925},[],{"_2857":59071,"_25170":58966,"_17548":99934,"_5":17443,"_23820":99663,"_2384":20963},[],{"_2857":59072,"_25170":58966,"_17548":99936,"_5":17443,"_23820":99663,"_2384":99835},[],{"_2857":59073,"_25170":58966,"_17548":99938,"_5":17443,"_23820":99663,"_2384":99939},[],"URL HTTP del servicio de CA de Lamassu.",{"_2857":59074,"_25170":58966,"_17548":99941,"_5":17443,"_23820":99667,"_2384":99942},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2857":59075,"_25170":58966,"_17548":99944,"_5":17443,"_23820":99671,"_2384":99945},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2857":59076,"_25170":58966,"_17548":99947,"_5":17443,"_23820":99671,"_2384":99948},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2857":59077,"_25170":58966,"_17548":99950,"_5":17443,"_23820":99675,"_2384":99951},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2857":59078,"_25170":58966,"_17548":99953,"_5":17443,"_23820":99675,"_2384":99954},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2857":59079,"_25170":58966,"_17548":99956,"_5":17443,"_23820":99675,"_2384":99957},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2857":59080,"_25170":58966,"_17548":99959,"_5":17443,"_23820":99675,"_2384":99960},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2857":59081,"_25170":58966,"_17548":99962,"_5":17443,"_23820":99675,"_2384":99963},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2857":59082,"_25170":58966,"_17548":99965,"_5":17443,"_23820":99675,"_2384":99966},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2857":59083,"_25170":58966,"_17548":99968,"_5":17443,"_23820":99678,"_2384":99969},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2857":59084,"_25170":58966,"_17548":99971,"_5":17443,"_23820":99681,"_2384":99972},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2857":59085,"_25170":58966,"_17548":99974,"_5":17443,"_23820":99681,"_2384":99975},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2857":59086,"_25170":58966,"_17548":99977,"_5":17443,"_23820":99685,"_2384":99978},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2857":59087,"_25170":58966,"_17548":99980,"_5":17443,"_23820":99689,"_2384":99981},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2857":59088,"_25170":58966,"_17548":99983,"_5":17443,"_23820":99689,"_2384":99984},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2857":59089,"_25170":58966,"_17548":99986,"_5":17443,"_23820":99689,"_2384":99987},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2857":59090,"_25170":58966,"_17548":99989,"_5":17443,"_23820":99689,"_2384":99990},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2857":59091,"_25170":58966,"_17548":99992,"_5":17443,"_23820":99689,"_2384":99993},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2857":59092,"_25170":58966,"_17548":99995,"_5":17443,"_23820":99689,"_2384":99996},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2857":59093,"_25170":58966,"_17548":99998,"_5":17443,"_23820":99693,"_2384":99999},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2857":59094,"_25170":58966,"_17548":100001,"_5":17443,"_23820":99693,"_2384":100002},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2857":59095,"_25170":58966,"_17548":100004,"_5":17443,"_23820":99693,"_2384":100005},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2857":59096,"_25170":58966,"_17548":100007,"_5":17443,"_23820":99697,"_2384":100008},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2857":59097,"_25170":58966,"_17548":100010,"_5":17443,"_23820":99697,"_2384":100011},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2857":59098,"_25170":58966,"_17548":100013,"_5":17443,"_23820":99697,"_2384":100014},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2857":59099,"_25170":58966,"_17548":100016,"_5":17443,"_23820":99701,"_2384":100017},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2857":59100,"_25170":58966,"_17548":100019,"_5":17443,"_23820":99701,"_2384":100020},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2857":59101,"_25170":58966,"_17548":100022,"_5":17443,"_23820":99701,"_2384":100023},[],"Para que el flujo JITP funcione correctamente:",{"_2857":59102,"_25170":58966,"_17548":100025,"_5":17443,"_23820":99701,"_2384":100026},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2857":59103,"_25170":58966,"_17548":100028,"_5":17443,"_23820":99701,"_2384":100029},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2857":59104,"_25170":58966,"_17548":100031,"_5":17443,"_23820":99701,"_2384":100032},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2857":59105,"_25170":58966,"_17548":100034,"_5":17443,"_23820":99701,"_2384":100035},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2857":59106,"_25170":58966,"_17548":100037,"_5":17443,"_23820":99705,"_2384":100038},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2857":59107,"_25170":58966,"_17548":100040,"_5":17443,"_23820":99705,"_2384":100041},[],"Estado en Lamassu",{"_2857":59108,"_25170":58966,"_17548":100043,"_5":17443,"_23820":99705,"_2384":100044},[],"Razón de revocación",{"_2857":59109,"_25170":58966,"_17548":100046,"_5":17443,"_23820":99705,"_2384":100047},[],"Estado en AWS IoT Core",{"_2857":59110,"_25170":58966,"_17548":100049,"_5":17443,"_23820":99705,"_2384":45046},[],{"_2857":59111,"_25170":58966,"_17548":100051,"_5":17443,"_23820":99705,"_2384":100052},[],"Ninguna",{"_2857":59112,"_25170":58966,"_17548":100054,"_5":17443,"_23820":99705,"_2384":45052},[],{"_2857":59113,"_25170":58966,"_17548":100056,"_5":17443,"_23820":99705,"_2384":45055},[],{"_2857":59114,"_25170":58966,"_17548":100058,"_5":17443,"_23820":99705,"_2384":45058},[],{"_2857":59115,"_25170":58966,"_17548":100060,"_5":17443,"_23820":99705,"_2384":45061},[],{"_2857":59116,"_25170":58966,"_17548":100062,"_5":17443,"_23820":99705,"_2384":45055},[],{"_2857":59117,"_25170":58966,"_17548":100064,"_5":17443,"_23820":99705,"_2384":100065},[],"Cualquier otra razón",{"_2857":59118,"_25170":58966,"_17548":100067,"_5":17443,"_23820":99705,"_2384":45069},[],{"_2857":59119,"_25170":58966,"_17548":100069,"_5":17443,"_23820":99705,"_2384":100070},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2857":59120,"_25170":58966,"_17548":100072,"_5":17443,"_23820":99709,"_2384":100073},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2857":59121,"_25170":58966,"_17548":100075,"_5":17443,"_23820":99709,"_2384":100076},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2857":59122,"_25170":58966,"_17548":100078,"_5":17443,"_23820":99709,"_2384":100079},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2857":59123,"_25170":58966,"_17548":100081,"_5":17443,"_23820":99713,"_2384":100082},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2857":59124,"_25170":58966,"_17548":100084,"_5":17443,"_23820":99713,"_2384":100085},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2857":59125,"_25170":58966,"_17548":100087,"_5":17443,"_23820":99717,"_2384":100088},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2857":59126,"_25170":58966,"_17548":100090,"_5":17443,"_23820":99717,"_2384":100091},[],"Existen dos tipos de acciones:",{"_2857":59127,"_25170":58966,"_17548":100093,"_5":17443,"_23820":99717,"_2384":100094},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2857":59128,"_25170":58966,"_17548":100096,"_5":17443,"_23820":99717,"_2384":100097},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2857":59129,"_25170":58966,"_17548":100099,"_5":17443,"_23820":99717,"_2384":100100},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2857":59130,"_25170":58966,"_17548":100102,"_5":17443,"_23820":99721,"_2384":100103},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2857":59131,"_25170":58966,"_17548":100105,"_5":17443,"_23820":99721,"_2384":100106},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2857":59132,"_25170":58966,"_17548":100108,"_5":17443,"_23820":99721,"_2384":100109},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2857":59133,"_25170":58966,"_17548":100111,"_5":17443,"_23820":99725,"_2384":100112},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2857":59134,"_25170":58966,"_17548":100114,"_5":17443,"_23820":99725,"_2384":100115},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2857":59135,"_25170":58966,"_17548":100117,"_5":17443,"_23820":99725,"_2384":100118},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2857":59136,"_25170":58966,"_17548":100120,"_5":17443,"_23820":99725,"_2384":100121},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2857":59137,"_25170":58966,"_17548":100123,"_5":17443,"_23820":99725,"_2384":100124},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2857":59138,"_25170":58966,"_17548":100126,"_5":17443,"_23820":99725,"_2384":100127},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2857":59139,"_25170":58966,"_17548":100129,"_5":17443,"_23820":99725,"_2384":100130},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2857":59140,"_25170":58966,"_17548":100132,"_5":17443,"_23820":99725,"_2384":100133},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2857":59141,"_25170":58966,"_17548":100135,"_5":17443,"_23820":99725,"_2384":100136},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2857":59142,"_25170":58966,"_17548":100138,"_5":17443,"_23820":99725,"_2384":100139},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2857":59143,"_25170":58966,"_17548":100141,"_5":17443,"_23820":99725,"_2384":100142},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2857":59144,"_25170":58966,"_17548":100144,"_5":17443,"_23820":99725,"_2384":100145},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2857":59145,"_25170":58966,"_17548":100147,"_5":17443,"_23820":99725,"_2384":100148},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2857":59146,"_25170":58966,"_17548":100150,"_5":17443,"_23820":99725,"_2384":100151},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2857":59147,"_25170":58966,"_17548":100153,"_5":17443,"_23820":99725,"_2384":100154},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2857":59148,"_25170":58966,"_17548":100156,"_5":17443,"_23820":99725,"_2384":100157},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2857":59149,"_25170":58966,"_17548":100159,"_5":17443,"_23820":99725,"_2384":100160},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2857":59150,"_25170":58966,"_17548":100162,"_5":17443,"_23820":99725,"_2384":100163},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2857":59151,"_25170":58966,"_17548":100165,"_5":17443,"_23820":99725,"_2384":100166},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":59152,"_25170":58966,"_17548":100168,"_5":17443,"_23820":99725,"_2384":100169},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2857":59153,"_25170":58966,"_17548":100171,"_5":17443,"_23820":99725,"_2384":100172},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2857":59154,"_25170":59154,"_5":12294,"_2384":43167,"_25506":100174,"_17548":100175,"_23820":59154},[40849,97280,43167],[],{"_2857":59155,"_25170":59154,"_17548":100177,"_5":17443,"_23820":59154,"_2384":100178},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2857":59156,"_25170":59154,"_5":25503,"_17548":100180,"_23820":100181,"_2384":100182},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2857":59157,"_25170":59154,"_5":25503,"_17548":100184,"_23820":100185,"_2384":98252},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2857":59158,"_25170":59154,"_5":25503,"_17548":100187,"_23820":100188,"_2384":98427},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2857":59159,"_25170":59154,"_5":25503,"_17548":100190,"_23820":100191,"_2384":99644},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/overview#integraciones",{"_2857":59160,"_25170":59154,"_5":25503,"_17548":100193,"_23820":100194,"_2384":100195},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2857":59161,"_25170":59154,"_17548":100197,"_5":17443,"_23820":59154,"_2384":100198},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2857":59162,"_25170":59154,"_17548":100200,"_5":17443,"_23820":100181,"_2384":100201},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2857":59163,"_25170":59154,"_17548":100203,"_5":17443,"_23820":100181,"_2384":100204},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2857":59164,"_25170":59154,"_17548":100206,"_5":17443,"_23820":100185,"_2384":100207},[],"Recurso",{"_2857":59165,"_25170":59154,"_17548":100209,"_5":17443,"_23820":100185,"_2384":100210},[],"Qué representa",{"_2857":59166,"_25170":59154,"_17548":100212,"_5":17443,"_23820":100185,"_2384":100213},[],"**Dispositivo**",{"_2857":59167,"_25170":59154,"_17548":100215,"_5":17443,"_23820":100185,"_2384":100216},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2857":59168,"_25170":59154,"_17548":100218,"_5":17443,"_23820":100185,"_2384":100219},[],"**Identidad**",{"_2857":59169,"_25170":59154,"_17548":100221,"_5":17443,"_23820":100185,"_2384":100222},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2857":59170,"_25170":59154,"_17548":100224,"_5":17443,"_23820":100185,"_2384":45227},[],{"_2857":59171,"_25170":59154,"_17548":100226,"_5":17443,"_23820":100185,"_2384":100227},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2857":59172,"_25170":59154,"_17548":100229,"_5":17443,"_23820":100185,"_2384":100230},[],"**Flota**",{"_2857":59173,"_25170":59154,"_17548":100232,"_5":17443,"_23820":100185,"_2384":100233},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2857":59174,"_25170":59154,"_17548":100235,"_5":17443,"_23820":100185,"_2384":100236},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2857":59175,"_25170":59154,"_17548":100238,"_5":17443,"_23820":100185,"_2384":100239},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2857":59176,"_25170":59154,"_17548":100241,"_5":17443,"_23820":100188,"_2384":100242},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2857":59177,"_25170":59154,"_17548":100244,"_5":17443,"_23820":100188,"_2384":100245},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2857":59178,"_25170":59154,"_17548":100247,"_5":17443,"_23820":100188,"_2384":100248},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2857":59179,"_25170":59154,"_17548":100250,"_5":17443,"_23820":100188,"_2384":100251},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2857":59180,"_25170":59154,"_17548":100253,"_5":17443,"_23820":100188,"_2384":100254},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2857":59181,"_25170":59154,"_17548":100256,"_5":17443,"_23820":100188,"_2384":100257},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2857":59182,"_25170":59154,"_17548":100259,"_5":17443,"_23820":100188,"_2384":100260},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":59183,"_25170":59154,"_17548":100262,"_5":17443,"_23820":100188,"_2384":100263},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2857":59184,"_25170":59154,"_17548":100265,"_5":17443,"_23820":100191,"_2384":100266},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2857":59185,"_25170":59154,"_17548":100268,"_5":17443,"_23820":100191,"_2384":100269},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2857":59186,"_25170":59154,"_17548":100271,"_5":17443,"_23820":100194,"_2384":100272},[],"Participante",{"_2857":59187,"_25170":59154,"_17548":100274,"_5":17443,"_23820":100194,"_2384":100275},[],"Responsabilidad",{"_2857":59188,"_25170":59154,"_17548":100277,"_5":17443,"_23820":100194,"_2384":100278},[],"Administrador PKI",{"_2857":59189,"_25170":59154,"_17548":100280,"_5":17443,"_23820":100194,"_2384":100281},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2857":59190,"_25170":59154,"_17548":100283,"_5":17443,"_23820":100194,"_2384":100284},[],"Administrador del aprovisionamiento",{"_2857":59191,"_25170":59154,"_17548":100286,"_5":17443,"_23820":100194,"_2384":100287},[],"DMS, admisión, autenticación por operación e inventario.",{"_2857":59192,"_25170":59154,"_17548":100289,"_5":17443,"_23820":100194,"_2384":100290},[],"Integrador del dispositivo",{"_2857":59193,"_25170":59154,"_17548":100292,"_5":17443,"_23820":100194,"_2384":100293},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2857":59194,"_25170":59154,"_17548":100295,"_5":17443,"_23820":100194,"_2384":100296},[],"Integrador del consumidor",{"_2857":59195,"_25170":59154,"_17548":100298,"_5":17443,"_23820":100194,"_2384":100299},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2857":59196,"_25170":59154,"_17548":100301,"_5":17443,"_23820":100194,"_2384":100302},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2857":59197,"_25170":59197,"_5":12294,"_2384":100304,"_25506":100305,"_17548":100307,"_23820":59197},"Enrola y conecta tu primer dispositivo",[40849,97280,43167,100306],"Primeros pasos",[],{"_2857":59198,"_25170":59197,"_17548":100309,"_5":17443,"_23820":59197,"_2384":100310},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2857":59199,"_25170":59197,"_5":25503,"_17548":100312,"_23820":100313,"_2384":95981},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2857":59200,"_25170":59197,"_5":25503,"_17548":100315,"_23820":100316,"_2384":100317},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2857":59201,"_25170":59197,"_5":25503,"_17548":100319,"_23820":100320,"_2384":100321},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2857":59202,"_25170":59197,"_5":25503,"_17548":100323,"_23820":100324,"_2384":100325},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2857":59203,"_25170":59197,"_5":25503,"_17548":100327,"_23820":100328,"_2384":100329},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2857":59204,"_25170":59197,"_5":25503,"_17548":100331,"_23820":100332,"_2384":100333},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2857":59205,"_25170":59197,"_5":25503,"_17548":100335,"_23820":100336,"_2384":100337},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2857":59206,"_25170":59197,"_5":25503,"_17548":100339,"_23820":100340,"_2384":100341},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2857":59207,"_25170":59197,"_17548":100343,"_5":17443,"_23820":59197,"_2384":100344},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2857":59208,"_25170":59197,"_17548":100346,"_5":17443,"_23820":100313,"_2384":100347},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2857":59209,"_25170":59197,"_17548":100349,"_5":17443,"_23820":100313,"_2384":100350},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2857":59210,"_25170":59197,"_17548":100352,"_5":17443,"_23820":100313,"_2384":100353},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2857":59211,"_25170":59197,"_17548":100355,"_5":17443,"_23820":100313,"_2384":100356},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2857":59212,"_25170":59197,"_17548":100358,"_5":17443,"_23820":100313,"_2384":100359},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2857":59213,"_25170":59197,"_17548":100361,"_5":17443,"_23820":100316,"_2384":100362},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2857":59214,"_25170":59197,"_17548":100364,"_5":17443,"_23820":100316,"_2384":100365},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2857":59215,"_25170":59197,"_17548":100367,"_5":17443,"_23820":100320,"_2384":100368},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2857":59216,"_25170":59197,"_17548":100370,"_5":17443,"_23820":100320,"_2384":100371},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2857":59217,"_25170":59197,"_17548":100373,"_5":17443,"_23820":100320,"_2384":100374},[],"Ajuste",{"_2857":59218,"_25170":59197,"_17548":100376,"_5":17443,"_23820":100320,"_2384":100377},[],"Valor de evaluación",{"_2857":59219,"_25170":59197,"_17548":100379,"_5":17443,"_23820":100320,"_2384":45383},[],{"_2857":59220,"_25170":59197,"_17548":100381,"_5":17443,"_23820":100320,"_2384":100382},[],"Raíz emisora de `device-root.pem`.",{"_2857":59221,"_25170":59197,"_17548":100384,"_5":17443,"_23820":100320,"_2384":98555},[],{"_2857":59222,"_25170":59197,"_17548":100386,"_5":17443,"_23820":100320,"_2384":100387},[],"Perfil final de 1 hora que acabas de preparar.",{"_2857":59223,"_25170":59197,"_17548":100389,"_5":17443,"_23820":100320,"_2384":45394},[],{"_2857":59224,"_25170":59197,"_17548":100391,"_5":17443,"_23820":100320,"_2384":45397},[],{"_2857":59225,"_25170":59197,"_17548":100393,"_5":17443,"_23820":100320,"_2384":45400},[],{"_2857":59226,"_25170":59197,"_17548":100395,"_5":17443,"_23820":100320,"_2384":100396},[],"Habilitado.",{"_2857":59227,"_25170":59197,"_17548":100398,"_5":17443,"_23820":100320,"_2384":45406},[],{"_2857":59228,"_25170":59197,"_17548":100400,"_5":17443,"_23820":100320,"_2384":100401},[],"Deshabilitado; el ID debe ser nuevo.",{"_2857":59229,"_25170":59197,"_17548":100403,"_5":17443,"_23820":100320,"_2384":100404},[],"Autenticación inicial",{"_2857":59230,"_25170":59197,"_17548":100406,"_5":17443,"_23820":100320,"_2384":100407},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2857":59231,"_25170":59197,"_17548":100409,"_5":17443,"_23820":100320,"_2384":100410},[],"Autenticación de renovación",{"_2857":59232,"_25170":59197,"_17548":100412,"_5":17443,"_23820":100320,"_2384":100413},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2857":59233,"_25170":59197,"_17548":100415,"_5":17443,"_23820":100320,"_2384":45424},[],{"_2857":59234,"_25170":59197,"_17548":100417,"_5":17443,"_23820":100320,"_2384":100418},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2857":59235,"_25170":59197,"_17548":100420,"_5":17443,"_23820":100320,"_2384":45430},[],{"_2857":59236,"_25170":59197,"_17548":100422,"_5":17443,"_23820":100320,"_2384":100423},[],"1 hora.",{"_2857":59237,"_25170":59197,"_17548":100425,"_5":17443,"_23820":100320,"_2384":45436},[],{"_2857":59238,"_25170":59197,"_17548":100427,"_5":17443,"_23820":100320,"_2384":100428},[],"30 minutos / 10 minutos.",{"_2857":59239,"_25170":59197,"_17548":100430,"_5":17443,"_23820":100320,"_2384":45442},[],{"_2857":59240,"_25170":59197,"_17548":100432,"_5":17443,"_23820":100320,"_2384":100433},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2857":59241,"_25170":59197,"_17548":100435,"_5":17443,"_23820":100320,"_2384":43486},[],{"_2857":59242,"_25170":59197,"_17548":100437,"_5":17443,"_23820":100320,"_2384":100438},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2857":59243,"_25170":59197,"_17548":100440,"_5":17443,"_23820":100320,"_2384":45453},[],{"_2857":59244,"_25170":59197,"_17548":100442,"_5":17443,"_23820":100320,"_2384":100443},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2857":59245,"_25170":59197,"_17548":100445,"_5":17443,"_23820":100320,"_2384":100446},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2857":59246,"_25170":59197,"_17548":100448,"_5":17443,"_23820":100324,"_2384":100449},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2857":59247,"_25170":59197,"_17548":100451,"_5":17443,"_23820":100324,"_2384":100452},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2857":59248,"_25170":59197,"_17548":100454,"_5":17443,"_23820":100328,"_2384":100455},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2857":59249,"_25170":59197,"_17548":100457,"_5":17443,"_23820":100328,"_2384":100458},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2857":59250,"_25170":59197,"_17548":100460,"_5":17443,"_23820":100328,"_2384":100461},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2857":59251,"_25170":59197,"_17548":100463,"_5":17443,"_23820":100332,"_2384":100464},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2857":59252,"_25170":59197,"_17548":100466,"_5":17443,"_23820":100332,"_2384":100467},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2857":59253,"_25170":59197,"_17548":100469,"_5":17443,"_23820":100336,"_2384":100470},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2857":59254,"_25170":59197,"_17548":100472,"_5":17443,"_23820":100336,"_2384":100473},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2857":59255,"_25170":59197,"_17548":100475,"_5":17443,"_23820":100336,"_2384":100476},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2857":59256,"_25170":59197,"_17548":100478,"_5":17443,"_23820":100336,"_2384":100479},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2857":59257,"_25170":59197,"_17548":100481,"_5":17443,"_23820":100336,"_2384":100482},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2857":59258,"_25170":59197,"_17548":100484,"_5":17443,"_23820":100340,"_2384":100485},[],"Comprobación",{"_2857":59259,"_25170":59197,"_17548":100487,"_5":17443,"_23820":100340,"_2384":100488},[],"Resultado esperado",{"_2857":59260,"_25170":59197,"_17548":100490,"_5":17443,"_23820":100340,"_2384":100491},[],"Registro",{"_2857":59261,"_25170":59197,"_17548":100493,"_5":17443,"_23820":100340,"_2384":100494},[],"ID creado automáticamente y DMS correcto.",{"_2857":59262,"_25170":59197,"_17548":100496,"_5":17443,"_23820":100340,"_2384":100497},[],"Certificado",{"_2857":59263,"_25170":59197,"_17548":100499,"_5":17443,"_23820":100340,"_2384":100500},[],"CN, perfil, serie y clave verificados.",{"_2857":59264,"_25170":59197,"_17548":100502,"_5":17443,"_23820":100340,"_2384":100503},[],"Inventario",{"_2857":59265,"_25170":59197,"_17548":100505,"_5":17443,"_23820":100340,"_2384":100506},[],"Serie recibida visible como identidad actual y en el historial.",{"_2857":59266,"_25170":59197,"_17548":100508,"_5":17443,"_23820":100340,"_2384":100509},[],"Consumidor",{"_2857":59267,"_25170":59197,"_17548":100511,"_5":17443,"_23820":100340,"_2384":100512},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2857":59268,"_25170":59197,"_17548":100514,"_5":17443,"_23820":100340,"_2384":100515},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2857":59269,"_25170":59197,"_17548":100517,"_5":17443,"_23820":100340,"_2384":100518},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2857":59270,"_25170":59270,"_5":12294,"_2384":98269,"_25506":100520,"_17548":100521,"_23820":59270},[40849,97280,43167,100306],[],{"_2857":59271,"_25170":59270,"_17548":100523,"_5":17443,"_23820":59270,"_2384":100524},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2857":59272,"_25170":59270,"_5":25503,"_17548":100526,"_23820":100527,"_2384":95981},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2857":59273,"_25170":59270,"_5":25503,"_17548":100529,"_23820":100530,"_2384":100531},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2857":59274,"_25170":59270,"_5":25503,"_17548":100533,"_23820":100534,"_2384":100535},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2857":59275,"_25170":59270,"_5":25503,"_17548":100537,"_23820":100538,"_2384":100539},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2857":59276,"_25170":59270,"_5":25503,"_17548":100541,"_23820":100542,"_2384":100543},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2857":59277,"_25170":59270,"_5":25503,"_17548":100545,"_23820":100546,"_2384":100547},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2857":59278,"_25170":59270,"_5":25503,"_17548":100549,"_23820":100550,"_2384":100488},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2857":59279,"_25170":59270,"_5":25503,"_17548":100552,"_23820":100553,"_2384":100554},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2857":59280,"_25170":59270,"_5":25503,"_17548":100556,"_23820":100557,"_2384":100558},[],"/docs/pr-preview/pr-38/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2857":59281,"_25170":59270,"_17548":100560,"_5":17443,"_23820":59270,"_2384":100561},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2857":59282,"_25170":59270,"_17548":100563,"_5":17443,"_23820":59270,"_2384":100564},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2857":59283,"_25170":59270,"_17548":100566,"_5":17443,"_23820":100527,"_2384":100567},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2857":59284,"_25170":59270,"_17548":100569,"_5":17443,"_23820":100527,"_2384":100570},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2857":59285,"_25170":59270,"_17548":100572,"_5":17443,"_23820":100527,"_2384":100573},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2857":59286,"_25170":59270,"_17548":100575,"_5":17443,"_23820":100527,"_2384":100576},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2857":59287,"_25170":59270,"_17548":100578,"_5":17443,"_23820":100530,"_2384":100579},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2857":59288,"_25170":59270,"_17548":100581,"_5":17443,"_23820":100530,"_2384":100582},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2857":59289,"_25170":59270,"_17548":100584,"_5":17443,"_23820":100530,"_2384":100585},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2857":59290,"_25170":59270,"_17548":100587,"_5":17443,"_23820":100530,"_2384":100588},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2857":59291,"_25170":59270,"_17548":100590,"_5":17443,"_23820":100530,"_2384":100591},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2857":59292,"_25170":59270,"_17548":100593,"_5":17443,"_23820":100530,"_2384":100594},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2857":59293,"_25170":59270,"_17548":100596,"_5":17443,"_23820":100530,"_2384":100597},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2857":59294,"_25170":59270,"_17548":100599,"_5":17443,"_23820":100530,"_2384":100600},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2857":59295,"_25170":59270,"_17548":100602,"_5":17443,"_23820":100534,"_2384":100603},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2857":59296,"_25170":59270,"_17548":100605,"_5":17443,"_23820":100534,"_2384":45619},[],{"_2857":59297,"_25170":59270,"_17548":100607,"_5":17443,"_23820":100534,"_2384":100608},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2857":59298,"_25170":59270,"_17548":100610,"_5":17443,"_23820":100534,"_2384":100611},[],"**Icon** y **Tags**: clasificación opcional.",{"_2857":59299,"_25170":59270,"_17548":100613,"_5":17443,"_23820":100534,"_2384":100614},[],"Confirma el registro.",{"_2857":59300,"_25170":59270,"_17548":100616,"_5":17443,"_23820":100538,"_2384":100617},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2857":59301,"_25170":59270,"_17548":100619,"_5":17443,"_23820":100538,"_2384":100620},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2857":59302,"_25170":59270,"_17548":100622,"_5":17443,"_23820":100542,"_2384":100623},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2857":59303,"_25170":59270,"_17548":100625,"_5":17443,"_23820":100542,"_2384":100626},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2857":59304,"_25170":59270,"_17548":100628,"_5":17443,"_23820":100546,"_2384":100629},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2857":59305,"_25170":59270,"_17548":100631,"_5":17443,"_23820":100546,"_2384":100632},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2857":59306,"_25170":59270,"_17548":100634,"_5":17443,"_23820":100550,"_2384":100485},[],{"_2857":59307,"_25170":59270,"_17548":100636,"_5":17443,"_23820":100550,"_2384":100637},[],"Resultado",{"_2857":59308,"_25170":59270,"_17548":100639,"_5":17443,"_23820":100550,"_2384":100640},[],"Dispositivo",{"_2857":59309,"_25170":59270,"_17548":100642,"_5":17443,"_23820":100550,"_2384":100643},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2857":59310,"_25170":59270,"_17548":100645,"_5":17443,"_23820":100550,"_2384":100646},[],"Identidad actual",{"_2857":59311,"_25170":59270,"_17548":100648,"_5":17443,"_23820":100550,"_2384":100649},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2857":59312,"_25170":59270,"_17548":100651,"_5":17443,"_23820":100550,"_2384":100652},[],"Historial",{"_2857":59313,"_25170":59270,"_17548":100654,"_5":17443,"_23820":100550,"_2384":100655},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2857":59314,"_25170":59270,"_17548":100657,"_5":17443,"_23820":100550,"_2384":100658},[],"Clave y certificado",{"_2857":59315,"_25170":59270,"_17548":100660,"_5":17443,"_23820":100550,"_2384":100661},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2857":59316,"_25170":59270,"_17548":100663,"_5":17443,"_23820":100553,"_2384":100664},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2857":59317,"_25170":59270,"_17548":100666,"_5":17443,"_23820":100553,"_2384":100667},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2857":59318,"_25170":59270,"_17548":100669,"_5":17443,"_23820":100553,"_2384":100670},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2857":59319,"_25170":59270,"_17548":100672,"_5":17443,"_23820":100553,"_2384":100673},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2857":59320,"_25170":59270,"_17548":100675,"_5":17443,"_23820":100557,"_2384":100676},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2857":59321,"_25170":59270,"_17548":100678,"_5":17443,"_23820":100557,"_2384":100679},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2857":59322,"_25170":59270,"_17548":100681,"_5":17443,"_23820":100557,"_2384":100682},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2857":59323,"_25170":59323,"_5":12294,"_2384":100684,"_25506":100685,"_17548":100686,"_23820":59323},"Plataforma Lamassu IoT",[40849,97280],[],{"_2857":59324,"_25170":59323,"_17548":100688,"_5":17443,"_23820":59323,"_2384":100689},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2857":59325,"_25170":59323,"_5":25503,"_17548":100691,"_23820":100692,"_2384":100182},[],"/docs/pr-preview/pr-38/es/platform/overview#empieza-aquí",{"_2857":59326,"_25170":59323,"_5":25503,"_17548":100694,"_23820":100695,"_2384":100696},[],"/docs/pr-preview/pr-38/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2857":59327,"_25170":59323,"_5":25503,"_17548":100698,"_23820":100699,"_2384":100700},[],"/docs/pr-preview/pr-38/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2857":59328,"_25170":59323,"_5":25503,"_17548":100702,"_23820":100703,"_2384":100704},[],"/docs/pr-preview/pr-38/es/platform/overview#capacidades-principales","Capacidades principales",{"_2857":59329,"_25170":59323,"_5":25503,"_17548":100706,"_23820":100707,"_2384":100708},[],"/docs/pr-preview/pr-38/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2857":59330,"_25170":59323,"_5":25503,"_17548":100710,"_23820":100711,"_2384":100712},[],"/docs/pr-preview/pr-38/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2857":59331,"_25170":59323,"_5":25503,"_17548":100714,"_23820":100715,"_2384":100716},[],"/docs/pr-preview/pr-38/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2857":59332,"_25170":59323,"_5":25503,"_17548":100718,"_23820":100719,"_2384":100720},[],"/docs/pr-preview/pr-38/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2857":59333,"_25170":59323,"_5":25503,"_17548":100722,"_23820":100723,"_2384":100724},[],"/docs/pr-preview/pr-38/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2857":59334,"_25170":59323,"_5":25503,"_17548":100726,"_23820":100727,"_2384":100728},[],"/docs/pr-preview/pr-38/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2857":59335,"_25170":59323,"_5":25503,"_17548":100730,"_23820":100731,"_2384":100732},[],"/docs/pr-preview/pr-38/es/platform/overview#referencia-operativa","Referencia operativa",{"_2857":59336,"_25170":59323,"_17548":100734,"_5":17443,"_23820":59323,"_2384":100735},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2857":59337,"_25170":59323,"_17548":100737,"_5":17443,"_23820":100692,"_2384":100738},[],"Elige el resultado que necesitas obtener:",{"_2857":59338,"_25170":59323,"_17548":100740,"_5":17443,"_23820":100692,"_2384":100741},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2857":59339,"_25170":59323,"_17548":100743,"_5":17443,"_23820":100692,"_2384":100744},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2857":59340,"_25170":59323,"_17548":100746,"_5":17443,"_23820":100692,"_2384":100747},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2857":59341,"_25170":59323,"_17548":100749,"_5":17443,"_23820":100695,"_2384":100750},[],"Bloque",{"_2857":59342,"_25170":59323,"_17548":100752,"_5":17443,"_23820":100695,"_2384":100753},[],"Qué gestionas",{"_2857":59343,"_25170":59323,"_17548":100755,"_5":17443,"_23820":100695,"_2384":100756},[],"Punto de entrada",{"_2857":59344,"_25170":59323,"_17548":100758,"_5":17443,"_23820":100695,"_2384":45773},[],{"_2857":59345,"_25170":59323,"_17548":100760,"_5":17443,"_23820":100695,"_2384":100761},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2857":59346,"_25170":59323,"_17548":100763,"_5":17443,"_23820":100695,"_2384":100764},[],"Visión general de PKI",{"_2857":59347,"_25170":59323,"_17548":100766,"_5":17443,"_23820":100695,"_2384":45782},[],{"_2857":59348,"_25170":59323,"_17548":100768,"_5":17443,"_23820":100695,"_2384":100769},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2857":59349,"_25170":59323,"_17548":100771,"_5":17443,"_23820":100695,"_2384":100772},[],"Visión general de IoT Fleets",{"_2857":59350,"_25170":59323,"_17548":100774,"_5":17443,"_23820":100695,"_2384":100775},[],"**Administración**",{"_2857":59351,"_25170":59323,"_17548":100777,"_5":17443,"_23820":100695,"_2384":100778},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2857":59352,"_25170":59323,"_17548":100780,"_5":17443,"_23820":100695,"_2384":97278},[],{"_2857":59353,"_25170":59323,"_17548":100782,"_5":17443,"_23820":100695,"_2384":100783},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2857":59354,"_25170":59323,"_17548":100785,"_5":17443,"_23820":100699,"_2384":100786},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2857":59355,"_25170":59323,"_17548":100788,"_5":17443,"_23820":100699,"_2384":100789},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2857":59356,"_25170":59323,"_17548":100791,"_5":17443,"_23820":100699,"_2384":100792},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2857":59357,"_25170":59323,"_17548":100794,"_5":17443,"_23820":100699,"_2384":100795},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2857":59358,"_25170":59323,"_17548":100797,"_5":17443,"_23820":100699,"_2384":100798},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2857":59359,"_25170":59323,"_17548":100800,"_5":17443,"_23820":100699,"_2384":100801},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2857":59360,"_25170":59323,"_17548":100803,"_5":17443,"_23820":100707,"_2384":100804},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2857":59361,"_25170":59323,"_17548":100806,"_5":17443,"_23820":100711,"_2384":100807},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2857":59362,"_25170":59323,"_17548":100809,"_5":17443,"_23820":100715,"_2384":100810},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2857":59363,"_25170":59323,"_17548":100812,"_5":17443,"_23820":100719,"_2384":100813},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2857":59364,"_25170":59323,"_17548":100815,"_5":17443,"_23820":100723,"_2384":100816},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2857":59365,"_25170":59323,"_17548":100818,"_5":17443,"_23820":100727,"_2384":100819},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2857":59366,"_25170":59323,"_17548":100821,"_5":17443,"_23820":100731,"_2384":100275},[],{"_2857":59367,"_25170":59323,"_17548":100823,"_5":17443,"_23820":100731,"_2384":100824},[],"Qué prepara o comprueba",{"_2857":59368,"_25170":59323,"_17548":100826,"_5":17443,"_23820":100731,"_2384":100278},[],{"_2857":59369,"_25170":59323,"_17548":100828,"_5":17443,"_23820":100731,"_2384":100829},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2857":59370,"_25170":59323,"_17548":100831,"_5":17443,"_23820":100731,"_2384":100832},[],"Administrador de la flota",{"_2857":59371,"_25170":59323,"_17548":100834,"_5":17443,"_23820":100731,"_2384":100835},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2857":59372,"_25170":59323,"_17548":100837,"_5":17443,"_23820":100731,"_2384":100290},[],{"_2857":59373,"_25170":59323,"_17548":100839,"_5":17443,"_23820":100731,"_2384":100840},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2857":59374,"_25170":59323,"_17548":100842,"_5":17443,"_23820":100731,"_2384":100296},[],{"_2857":59375,"_25170":59323,"_17548":100844,"_5":17443,"_23820":100731,"_2384":100845},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2857":59376,"_25170":59323,"_17548":100847,"_5":17443,"_23820":100731,"_2384":100848},[],"Operador de infraestructura",{"_2857":59377,"_25170":59323,"_17548":100850,"_5":17443,"_23820":100731,"_2384":100851},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2857":59378,"_25170":59323,"_17548":100853,"_5":17443,"_23820":100731,"_2384":100854},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2857":59379,"_25170":59379,"_5":12294,"_2384":100856,"_25506":100857,"_17548":100859,"_23820":59379},"Jerarquía y rotación de CAs",[40849,97280,45874,100858],"Claves, autoridades y certificados",[],{"_2857":59380,"_25170":59379,"_17548":100861,"_5":17443,"_23820":59379,"_2384":100862},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2857":59381,"_25170":59379,"_5":25503,"_17548":100864,"_23820":100865,"_2384":100866},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2857":59382,"_25170":59379,"_5":25503,"_17548":100868,"_23820":100869,"_2384":100870},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2857":59383,"_25170":59379,"_5":25503,"_17548":100872,"_23820":100873,"_2384":100874},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2857":59384,"_25170":59379,"_5":25503,"_17548":100876,"_23820":100877,"_2384":100878},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2857":59385,"_25170":59379,"_5":25503,"_17548":100880,"_23820":100881,"_2384":100882},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2857":59386,"_25170":59379,"_5":25503,"_17548":100884,"_23820":100885,"_2384":100886},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2857":59387,"_25170":59379,"_5":25503,"_17548":100888,"_23820":100889,"_2384":100890},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2857":59388,"_25170":59379,"_5":25503,"_17548":100892,"_23820":100893,"_2384":100894},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2857":59389,"_25170":59379,"_5":25503,"_17548":100896,"_23820":100897,"_2384":100898},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2857":59390,"_25170":59379,"_5":25503,"_17548":100900,"_23820":100901,"_2384":100902},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2857":59391,"_25170":59379,"_5":25503,"_17548":100904,"_23820":100905,"_2384":100906},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2857":59392,"_25170":59379,"_5":25503,"_17548":100908,"_23820":100909,"_2384":100910},[],"/docs/pr-preview/pr-38/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2857":59393,"_25170":59379,"_17548":100912,"_5":17443,"_23820":59379,"_2384":100913},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2857":59394,"_25170":59379,"_17548":100915,"_5":17443,"_23820":59379,"_2384":100916},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2857":59395,"_25170":59379,"_17548":100918,"_5":17443,"_23820":100865,"_2384":100919},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2857":59396,"_25170":59379,"_17548":100921,"_5":17443,"_23820":100865,"_2384":100922},[],"entorno, como producción y preproducción;",{"_2857":59397,"_25170":59379,"_17548":100924,"_5":17443,"_23820":100865,"_2384":100925},[],"propietario o equipo operador;",{"_2857":59398,"_25170":59379,"_17548":100927,"_5":17443,"_23820":100865,"_2384":100928},[],"familia de dispositivos o proceso de fabricación;",{"_2857":59399,"_25170":59379,"_17548":100930,"_5":17443,"_23820":100865,"_2384":100931},[],"región o requisito regulatorio;",{"_2857":59400,"_25170":59379,"_17548":100933,"_5":17443,"_23820":100865,"_2384":100934},[],"motor criptográfico o política de clave;",{"_2857":59401,"_25170":59379,"_17548":100936,"_5":17443,"_23820":100865,"_2384":100937},[],"ventana de mantenimiento y ritmo de renovación.",{"_2857":59402,"_25170":59379,"_17548":100939,"_5":17443,"_23820":100865,"_2384":100940},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2857":59403,"_25170":59379,"_17548":100942,"_5":17443,"_23820":100865,"_2384":100943},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2857":59404,"_25170":59379,"_17548":100945,"_5":17443,"_23820":100869,"_2384":100946},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2857":59405,"_25170":59379,"_17548":100948,"_5":17443,"_23820":100869,"_2384":100949},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2857":59406,"_25170":59379,"_17548":100951,"_5":17443,"_23820":100869,"_2384":100952},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2857":59407,"_25170":59379,"_17548":100954,"_5":17443,"_23820":100873,"_2384":100955},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2857":59408,"_25170":59379,"_17548":100957,"_5":17443,"_23820":100873,"_2384":100958},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2857":59409,"_25170":59379,"_17548":100960,"_5":17443,"_23820":100873,"_2384":100961},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2857":59410,"_25170":59379,"_17548":100963,"_5":17443,"_23820":100873,"_2384":100964},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2857":59411,"_25170":59379,"_17548":100966,"_5":17443,"_23820":100881,"_2384":100967},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2857":59412,"_25170":59379,"_17548":100969,"_5":17443,"_23820":100885,"_2384":100970},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2857":59413,"_25170":59379,"_17548":100972,"_5":17443,"_23820":100889,"_2384":100973},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2857":59414,"_25170":59379,"_17548":100975,"_5":17443,"_23820":100893,"_2384":100976},[],"Actualiza la CA de enrolamiento y el perfil de los DMS y añade la CA anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS mientras sigan renovando cohortes con certificados antiguos. La guía DMS documenta ese ajuste.",{"_2857":59415,"_25170":59379,"_17548":100978,"_5":17443,"_23820":100897,"_2384":100979},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2857":59416,"_25170":59379,"_17548":100981,"_5":17443,"_23820":100901,"_2384":100982},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2857":59417,"_25170":59379,"_17548":100984,"_5":17443,"_23820":100905,"_2384":100985},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2857":59418,"_25170":59379,"_17548":100987,"_5":17443,"_23820":100905,"_2384":100988},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2857":59419,"_25170":59379,"_17548":100990,"_5":17443,"_23820":100905,"_2384":100991},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2857":59420,"_25170":59379,"_17548":100993,"_5":17443,"_23820":100905,"_2384":100994},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2857":59421,"_25170":59379,"_17548":100996,"_5":17443,"_23820":100909,"_2384":100997},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2857":59422,"_25170":59379,"_17548":100999,"_5":17443,"_23820":100909,"_2384":101000},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2857":59423,"_25170":59379,"_17548":101002,"_5":17443,"_23820":100909,"_2384":101003},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2857":59424,"_25170":59379,"_17548":101005,"_5":17443,"_23820":100909,"_2384":101006},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2857":59425,"_25170":59379,"_17548":101008,"_5":17443,"_23820":100909,"_2384":101009},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2857":59426,"_25170":59379,"_17548":101011,"_5":17443,"_23820":100909,"_2384":101012},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2857":59427,"_25170":59379,"_17548":101014,"_5":17443,"_23820":100909,"_2384":101015},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2857":59428,"_25170":59428,"_5":12294,"_2384":101017,"_25506":101018,"_17548":101019,"_23820":59428},"Autoridades de certificación",[40849,97280,45874,100858],[],{"_2857":59429,"_25170":59428,"_17548":101021,"_5":17443,"_23820":59428,"_2384":101022},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2857":59430,"_25170":59428,"_5":25503,"_17548":101024,"_23820":101025,"_2384":101026},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2857":59431,"_25170":59428,"_5":25503,"_17548":101028,"_23820":101029,"_2384":101030},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2857":59432,"_25170":59428,"_5":25503,"_17548":101032,"_23820":101033,"_2384":95981},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2857":59433,"_25170":59428,"_5":25503,"_17548":101035,"_23820":101036,"_2384":101037},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2857":59434,"_25170":59428,"_5":25503,"_17548":101039,"_23820":101040,"_2384":101041},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2857":59435,"_25170":59428,"_5":25503,"_17548":101043,"_23820":101044,"_2384":101045},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2857":59436,"_25170":59428,"_5":25503,"_17548":101047,"_23820":101048,"_2384":101049},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2857":59437,"_25170":59428,"_5":25503,"_17548":101051,"_23820":101052,"_2384":101053},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2857":59438,"_25170":59428,"_5":25503,"_17548":101055,"_23820":101056,"_2384":101057},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2857":59439,"_25170":59428,"_5":25503,"_17548":101059,"_23820":101060,"_2384":101061},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2857":59440,"_25170":59428,"_5":25503,"_17548":101063,"_23820":101064,"_2384":101065},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2857":59441,"_25170":59428,"_5":25503,"_17548":101067,"_23820":101068,"_2384":101069},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2857":59442,"_25170":59428,"_5":25503,"_17548":101071,"_23820":101072,"_2384":101073},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2857":59443,"_25170":59428,"_5":25503,"_17548":101075,"_23820":101076,"_2384":101077},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2857":59444,"_25170":59428,"_5":25503,"_17548":101079,"_23820":101080,"_2384":101081},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2857":59445,"_25170":59428,"_5":25503,"_17548":101083,"_23820":101084,"_2384":101085},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2857":59446,"_25170":59428,"_5":25503,"_17548":101087,"_23820":101088,"_2384":101089},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2857":59447,"_25170":59428,"_5":25503,"_17548":101091,"_23820":101092,"_2384":101093},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2857":59448,"_25170":59428,"_5":25503,"_17548":101095,"_23820":101096,"_2384":101097},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2857":59449,"_25170":59428,"_5":25503,"_17548":101099,"_23820":101100,"_2384":101101},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2857":59450,"_25170":59428,"_5":25503,"_17548":101103,"_23820":101104,"_2384":101105},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2857":59451,"_25170":59428,"_5":25503,"_17548":101107,"_23820":101108,"_2384":101109},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2857":59452,"_25170":59428,"_17548":101111,"_5":17443,"_23820":59428,"_2384":101112},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2857":59453,"_25170":59428,"_17548":101114,"_5":17443,"_23820":59428,"_2384":101115},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2857":59454,"_25170":59428,"_17548":101117,"_5":17443,"_23820":59428,"_2384":101118},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2857":59455,"_25170":59428,"_17548":101120,"_5":17443,"_23820":101025,"_2384":101121},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2857":59456,"_25170":59428,"_17548":101123,"_5":17443,"_23820":101025,"_2384":101124},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2857":59457,"_25170":59428,"_17548":101126,"_5":17443,"_23820":101025,"_2384":101127},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2857":59458,"_25170":59428,"_17548":101129,"_5":17443,"_23820":101025,"_2384":101130},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2857":59459,"_25170":59428,"_17548":101132,"_5":17443,"_23820":101025,"_2384":101133},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2857":59460,"_25170":59428,"_17548":101135,"_5":17443,"_23820":101033,"_2384":101136},[],"Decide si la CA será raíz o intermedia.",{"_2857":59461,"_25170":59428,"_17548":101138,"_5":17443,"_23820":101033,"_2384":101139},[],"Elige el motor que custodiará la clave.",{"_2857":59462,"_25170":59428,"_17548":101141,"_5":17443,"_23820":101033,"_2384":101142},[],"Define una validez superior a la de los certificados que emitirá.",{"_2857":59463,"_25170":59428,"_17548":101144,"_5":17443,"_23820":101033,"_2384":101145},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2857":59464,"_25170":59428,"_17548":101147,"_5":17443,"_23820":101036,"_2384":101148},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2857":59465,"_25170":59428,"_17548":101150,"_5":17443,"_23820":101040,"_2384":101151},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2857":59466,"_25170":59428,"_17548":101153,"_5":17443,"_23820":101040,"_2384":101154},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2857":59467,"_25170":59428,"_17548":101156,"_5":17443,"_23820":101044,"_2384":101157},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2857":59468,"_25170":59428,"_17548":101159,"_5":17443,"_23820":101048,"_2384":101160},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2857":59469,"_25170":59428,"_17548":101162,"_5":17443,"_23820":101048,"_2384":101163},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2857":59470,"_25170":59428,"_17548":101165,"_5":17443,"_23820":101048,"_2384":101166},[],"`ST`: estado o provincia.",{"_2857":59471,"_25170":59428,"_17548":101168,"_5":17443,"_23820":101048,"_2384":101169},[],"`L`: localidad.",{"_2857":59472,"_25170":59428,"_17548":101171,"_5":17443,"_23820":101048,"_2384":101172},[],"`O`: organización.",{"_2857":59473,"_25170":59428,"_17548":101174,"_5":17443,"_23820":101048,"_2384":101175},[],"`OU`: unidad organizativa.",{"_2857":59474,"_25170":59428,"_17548":101177,"_5":17443,"_23820":101048,"_2384":101178},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2857":59475,"_25170":59428,"_17548":101180,"_5":17443,"_23820":101052,"_2384":101181},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2857":59476,"_25170":59428,"_17548":101183,"_5":17443,"_23820":101052,"_2384":101184},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2857":59477,"_25170":59428,"_17548":101186,"_5":17443,"_23820":101056,"_2384":101187},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2857":59478,"_25170":59428,"_17548":101189,"_5":17443,"_23820":101056,"_2384":101190},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2857":59479,"_25170":59428,"_17548":101192,"_5":17443,"_23820":101060,"_2384":101193},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2857":59480,"_25170":59428,"_17548":101195,"_5":17443,"_23820":101060,"_2384":101196},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2857":59481,"_25170":59428,"_17548":101198,"_5":17443,"_23820":101064,"_2384":101199},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2857":59482,"_25170":59428,"_17548":101201,"_5":17443,"_23820":101068,"_2384":101202},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2857":59483,"_25170":59428,"_17548":101204,"_5":17443,"_23820":101072,"_2384":101205},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2857":59484,"_25170":59428,"_17548":101207,"_5":17443,"_23820":101076,"_2384":101208},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2857":59485,"_25170":59428,"_17548":101210,"_5":17443,"_23820":101080,"_2384":101211},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2857":59486,"_25170":59428,"_17548":101213,"_5":17443,"_23820":101080,"_2384":101214},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2857":59487,"_25170":59428,"_17548":101216,"_5":17443,"_23820":101084,"_2384":101217},[],"Abre una CA desde el inventario para consultar:",{"_2857":59488,"_25170":59428,"_17548":101219,"_5":17443,"_23820":101084,"_2384":101220},[],"Estado y periodo de validez.",{"_2857":59489,"_25170":59428,"_17548":101222,"_5":17443,"_23820":101084,"_2384":101223},[],"Certificado y cadena en formato PEM.",{"_2857":59490,"_25170":59428,"_17548":101225,"_5":17443,"_23820":101084,"_2384":101226},[],"Número de certificados activos, expirados y revocados.",{"_2857":59491,"_25170":59428,"_17548":101228,"_5":17443,"_23820":101084,"_2384":101229},[],"Certificados emitidos en **Issued Certificates**.",{"_2857":59492,"_25170":59428,"_17548":101231,"_5":17443,"_23820":101084,"_2384":101232},[],"CRL vinculada a la autoridad.",{"_2857":59493,"_25170":59428,"_17548":101234,"_5":17443,"_23820":101084,"_2384":101235},[],"Metadatos y motor criptográfico asociado.",{"_2857":59494,"_25170":59428,"_17548":101237,"_5":17443,"_23820":101084,"_2384":101238},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2857":59495,"_25170":59428,"_17548":101240,"_5":17443,"_23820":101088,"_2384":101241},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2857":59496,"_25170":59428,"_17548":101243,"_5":17443,"_23820":101088,"_2384":101244},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2857":59497,"_25170":59428,"_17548":101246,"_5":17443,"_23820":101088,"_2384":101247},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2857":59498,"_25170":59428,"_17548":101249,"_5":17443,"_23820":101088,"_2384":101250},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2857":59499,"_25170":59428,"_17548":101252,"_5":17443,"_23820":101092,"_2384":101253},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2857":59500,"_25170":59428,"_17548":101255,"_5":17443,"_23820":101096,"_2384":101256},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2857":59501,"_25170":59428,"_17548":101258,"_5":17443,"_23820":101100,"_2384":101259},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2857":59502,"_25170":59428,"_17548":101261,"_5":17443,"_23820":101104,"_2384":101262},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2857":59503,"_25170":59428,"_17548":101264,"_5":17443,"_23820":101108,"_2384":101265},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2857":59504,"_25170":59428,"_17548":101267,"_5":17443,"_23820":101108,"_2384":101268},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2857":59505,"_25170":59505,"_5":12294,"_2384":101270,"_25506":101271,"_17548":101272,"_23820":59505},"Perfiles de certificado",[40849,97280,45874,100858],[],{"_2857":59506,"_25170":59505,"_17548":101274,"_5":17443,"_23820":59505,"_2384":101275},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2857":59507,"_25170":59505,"_5":25503,"_17548":101277,"_23820":101278,"_2384":101279},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2857":59508,"_25170":59505,"_5":25503,"_17548":101281,"_23820":101282,"_2384":101283},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#validez","Validez",{"_2857":59509,"_25170":59505,"_5":25503,"_17548":101285,"_23820":101286,"_2384":101287},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2857":59510,"_25170":59505,"_5":25503,"_17548":101289,"_23820":101290,"_2384":101291},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2857":59511,"_25170":59505,"_5":25503,"_17548":101293,"_23820":101294,"_2384":101295},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2857":59512,"_25170":59505,"_5":25503,"_17548":101297,"_23820":101298,"_2384":101299},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2857":59513,"_25170":59505,"_5":25503,"_17548":101301,"_23820":101302,"_2384":101303},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2857":59514,"_25170":59505,"_5":25503,"_17548":101305,"_23820":101306,"_2384":101307},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2857":59515,"_25170":59505,"_5":25503,"_17548":101309,"_23820":101310,"_2384":101311},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2857":59516,"_25170":59505,"_5":25503,"_17548":101313,"_23820":101314,"_2384":101315},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2857":59517,"_25170":59505,"_5":25503,"_17548":101317,"_23820":101318,"_2384":101319},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2857":59518,"_25170":59505,"_5":25503,"_17548":101321,"_23820":101322,"_2384":101323},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2857":59519,"_25170":59505,"_5":25503,"_17548":101325,"_23820":101326,"_2384":101327},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2857":59520,"_25170":59505,"_5":25503,"_17548":101329,"_23820":101330,"_2384":101331},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2857":59521,"_25170":59505,"_5":25503,"_17548":101333,"_23820":101334,"_2384":101335},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2857":59522,"_25170":59505,"_5":25503,"_17548":101337,"_23820":101338,"_2384":101339},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2857":59523,"_25170":59505,"_17548":101341,"_5":17443,"_23820":59505,"_2384":101342},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2857":59524,"_25170":59505,"_17548":101344,"_5":17443,"_23820":59505,"_2384":101345},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2857":59525,"_25170":59505,"_17548":101347,"_5":17443,"_23820":101282,"_2384":101348},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2857":59526,"_25170":59505,"_17548":101350,"_5":17443,"_23820":101282,"_2384":101351},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2857":59527,"_25170":59505,"_17548":101353,"_5":17443,"_23820":101286,"_2384":101354},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2857":59528,"_25170":59505,"_17548":101356,"_5":17443,"_23820":101290,"_2384":101357},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2857":59529,"_25170":59505,"_17548":101359,"_5":17443,"_23820":101290,"_2384":101360},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2857":59530,"_25170":59505,"_17548":101362,"_5":17443,"_23820":101290,"_2384":101363},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2857":59531,"_25170":59505,"_17548":101365,"_5":17443,"_23820":101294,"_2384":101366},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2857":59532,"_25170":59505,"_17548":101368,"_5":17443,"_23820":101298,"_2384":101369},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2857":59533,"_25170":59505,"_17548":101371,"_5":17443,"_23820":101298,"_2384":101372},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2857":59534,"_25170":59505,"_17548":101374,"_5":17443,"_23820":101302,"_2384":101375},[],"La aplicación criptográfica puede:",{"_2857":59535,"_25170":59505,"_17548":101377,"_5":17443,"_23820":101302,"_2384":101378},[],"permitir o bloquear claves RSA;",{"_2857":59536,"_25170":59505,"_17548":101380,"_5":17443,"_23820":101302,"_2384":101381},[],"limitar los tamaños RSA admitidos;",{"_2857":59537,"_25170":59505,"_17548":101383,"_5":17443,"_23820":101302,"_2384":101384},[],"permitir o bloquear claves ECDSA;",{"_2857":59538,"_25170":59505,"_17548":101386,"_5":17443,"_23820":101302,"_2384":101387},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2857":59539,"_25170":59505,"_17548":101389,"_5":17443,"_23820":101302,"_2384":101390},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2857":59540,"_25170":59505,"_17548":101392,"_5":17443,"_23820":101306,"_2384":101393},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2857":59541,"_25170":59505,"_17548":101395,"_5":17443,"_23820":101306,"_2384":97071},[],{"_2857":59542,"_25170":59505,"_17548":101397,"_5":17443,"_23820":101306,"_2384":101398},[],"Primera opción",{"_2857":59543,"_25170":59505,"_17548":101400,"_5":17443,"_23820":101306,"_2384":101401},[],"Segunda opción",{"_2857":59544,"_25170":59505,"_17548":101403,"_5":17443,"_23820":101306,"_2384":101404},[],"Si no hay ninguna",{"_2857":59545,"_25170":59505,"_17548":101406,"_5":17443,"_23820":101306,"_2384":101407},[],"Firma directa con una CA",{"_2857":59546,"_25170":59505,"_17548":101409,"_5":17443,"_23820":101306,"_2384":101410},[],"`issuance_profile` incluido en la solicitud",{"_2857":59547,"_25170":59505,"_17548":101412,"_5":17443,"_23820":101306,"_2384":101413},[],"`issuance_profile_id` de la solicitud",{"_2857":59548,"_25170":59505,"_17548":101415,"_5":17443,"_23820":101306,"_2384":101416},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2857":59549,"_25170":59505,"_17548":101418,"_5":17443,"_23820":101306,"_2384":101419},[],"Emisión mediante DMS",{"_2857":59550,"_25170":59505,"_17548":101421,"_5":17443,"_23820":101306,"_2384":46439},[],{"_2857":59551,"_25170":59505,"_17548":101423,"_5":17443,"_23820":101306,"_2384":101424},[],"`settings.issuance_profile` incluido en el DMS",{"_2857":59552,"_25170":59505,"_17548":101426,"_5":17443,"_23820":101306,"_2384":101427},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2857":59553,"_25170":59505,"_17548":101429,"_5":17443,"_23820":101306,"_2384":101430},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2857":59554,"_25170":59505,"_17548":101432,"_5":17443,"_23820":101306,"_2384":101433},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2857":59555,"_25170":59505,"_17548":101435,"_5":17443,"_23820":101314,"_2384":101436},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2857":59556,"_25170":59505,"_17548":101438,"_5":17443,"_23820":101318,"_2384":101439},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2857":59557,"_25170":59505,"_17548":101441,"_5":17443,"_23820":101322,"_2384":101442},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2857":59558,"_25170":59505,"_17548":101444,"_5":17443,"_23820":101326,"_2384":101445},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2857":59559,"_25170":59505,"_17548":101447,"_5":17443,"_23820":101330,"_2384":101448},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2857":59560,"_25170":59505,"_17548":101450,"_5":17443,"_23820":101330,"_2384":101451},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2857":59561,"_25170":59505,"_17548":101453,"_5":17443,"_23820":101334,"_2384":101454},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2857":59562,"_25170":59505,"_17548":101456,"_5":17443,"_23820":101334,"_2384":101457},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2857":59563,"_25170":59505,"_17548":101459,"_5":17443,"_23820":101334,"_2384":101460},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2857":59564,"_25170":59505,"_17548":101462,"_5":17443,"_23820":101334,"_2384":101463},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2857":59565,"_25170":59505,"_17548":101465,"_5":17443,"_23820":101338,"_2384":101466},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2857":59566,"_25170":59505,"_17548":101468,"_5":17443,"_23820":101338,"_2384":101469},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2857":59567,"_25170":59567,"_5":12294,"_2384":101471,"_25506":101472,"_17548":101474,"_23820":59567},"Validación de certificados",[40849,97280,45874,101473],"Validación",[],{"_2857":59568,"_25170":59567,"_17548":101476,"_5":17443,"_23820":59567,"_2384":101477},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2857":59569,"_25170":59567,"_5":25503,"_17548":101479,"_23820":101480,"_2384":101481},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2857":59570,"_25170":59567,"_5":25503,"_17548":101483,"_23820":101484,"_2384":101485},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2857":59571,"_25170":59567,"_5":25503,"_17548":101487,"_23820":101488,"_2384":101489},[],"/docs/pr-preview/pr-38/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2857":59572,"_25170":59567,"_17548":101491,"_5":17443,"_23820":59567,"_2384":101492},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2857":59573,"_25170":59567,"_17548":101494,"_5":17443,"_23820":101480,"_2384":101495},[],"Verifica estos criterios juntos:",{"_2857":59574,"_25170":59567,"_17548":101497,"_5":17443,"_23820":101480,"_2384":100485},[],{"_2857":59575,"_25170":59567,"_17548":101499,"_5":17443,"_23820":101480,"_2384":101500},[],"Resultado necesario",{"_2857":59576,"_25170":59567,"_17548":101502,"_5":17443,"_23820":101480,"_2384":101503},[],"Cadena y firma",{"_2857":59577,"_25170":59567,"_17548":101505,"_5":17443,"_23820":101480,"_2384":101506},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2857":59578,"_25170":59567,"_17548":101508,"_5":17443,"_23820":101480,"_2384":101509},[],"Fechas",{"_2857":59579,"_25170":59567,"_17548":101511,"_5":17443,"_23820":101480,"_2384":101512},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2857":59580,"_25170":59567,"_17548":101514,"_5":17443,"_23820":101480,"_2384":96984},[],{"_2857":59581,"_25170":59567,"_17548":101516,"_5":17443,"_23820":101480,"_2384":101517},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2857":59582,"_25170":59567,"_17548":101519,"_5":17443,"_23820":101480,"_2384":101520},[],"Uso",{"_2857":59583,"_25170":59567,"_17548":101522,"_5":17443,"_23820":101480,"_2384":101523},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2857":59584,"_25170":59567,"_17548":101525,"_5":17443,"_23820":101480,"_2384":101526},[],"Revocación",{"_2857":59585,"_25170":59567,"_17548":101528,"_5":17443,"_23820":101480,"_2384":101529},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2857":59586,"_25170":59567,"_17548":101531,"_5":17443,"_23820":101480,"_2384":101532},[],"Autorización",{"_2857":59587,"_25170":59567,"_17548":101534,"_5":17443,"_23820":101480,"_2384":101535},[],"La aplicación permite la acción a esa identidad.",{"_2857":59588,"_25170":59567,"_17548":101537,"_5":17443,"_23820":101480,"_2384":101538},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2857":59589,"_25170":59567,"_17548":101540,"_5":17443,"_23820":101484,"_2384":101541},[],"Mecanismo",{"_2857":59590,"_25170":59567,"_17548":101543,"_5":17443,"_23820":101484,"_2384":101544},[],"Cuándo utilizarlo",{"_2857":59591,"_25170":59567,"_17548":101546,"_5":17443,"_23820":101484,"_2384":101547},[],"Qué debes mantener",{"_2857":59592,"_25170":59567,"_17548":101549,"_5":17443,"_23820":101484,"_2384":46567},[],{"_2857":59593,"_25170":59567,"_17548":101551,"_5":17443,"_23820":101484,"_2384":101552},[],"Consulta del estado de un certificado concreto.",{"_2857":59594,"_25170":59567,"_17548":101554,"_5":17443,"_23820":101484,"_2384":101555},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2857":59595,"_25170":59567,"_17548":101557,"_5":17443,"_23820":101484,"_2384":46576},[],{"_2857":59596,"_25170":59567,"_17548":101559,"_5":17443,"_23820":101484,"_2384":101560},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2857":59597,"_25170":59567,"_17548":101562,"_5":17443,"_23820":101484,"_2384":101563},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2857":59598,"_25170":59567,"_17548":101565,"_5":17443,"_23820":101484,"_2384":101566},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2857":59599,"_25170":59567,"_17548":101568,"_5":17443,"_23820":101484,"_2384":101569},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2857":59600,"_25170":59567,"_17548":101571,"_5":17443,"_23820":101488,"_2384":101572},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2857":59601,"_25170":59567,"_17548":101574,"_5":17443,"_23820":101488,"_2384":101575},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2857":59602,"_25170":59567,"_17548":101577,"_5":17443,"_23820":101488,"_2384":101578},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2857":59603,"_25170":59567,"_17548":101580,"_5":17443,"_23820":101488,"_2384":101581},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2857":59604,"_25170":59567,"_17548":101583,"_5":17443,"_23820":101488,"_2384":101584},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2857":59605,"_25170":59567,"_17548":101586,"_5":17443,"_23820":101488,"_2384":101587},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2857":59606,"_25170":59567,"_17548":101589,"_5":17443,"_23820":101488,"_2384":101590},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2857":59607,"_25170":59567,"_17548":101592,"_5":17443,"_23820":101488,"_2384":101593},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":59608,"_25170":59567,"_17548":101595,"_5":17443,"_23820":101488,"_2384":101596},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2857":59609,"_25170":59609,"_5":12294,"_2384":101598,"_25506":101599,"_17548":101600,"_23820":59609},"Certificados",[40849,97280,45874,100858],[],{"_2857":59610,"_25170":59609,"_17548":101602,"_5":17443,"_23820":59609,"_2384":101603},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2857":59611,"_25170":59609,"_5":25503,"_17548":101605,"_23820":101606,"_2384":101607},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2857":59612,"_25170":59609,"_5":25503,"_17548":101609,"_23820":101610,"_2384":101611},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2857":59613,"_25170":59609,"_5":25503,"_17548":101613,"_23820":101614,"_2384":101615},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2857":59614,"_25170":59609,"_5":25503,"_17548":101617,"_23820":101618,"_2384":101619},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2857":59615,"_25170":59609,"_5":25503,"_17548":101621,"_23820":101622,"_2384":101623},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2857":59616,"_25170":59609,"_5":25503,"_17548":101625,"_23820":101626,"_2384":101627},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2857":59617,"_25170":59609,"_5":25503,"_17548":101629,"_23820":101630,"_2384":101631},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2857":59618,"_25170":59609,"_5":25503,"_17548":101633,"_23820":101634,"_2384":101635},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2857":59619,"_25170":59609,"_5":25503,"_17548":101637,"_23820":101638,"_2384":101639},[],"/docs/pr-preview/pr-38/es/platform/pki/certificates#continúa","Continúa",{"_2857":59620,"_25170":59609,"_17548":101641,"_5":17443,"_23820":59609,"_2384":101642},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2857":59621,"_25170":59609,"_17548":101644,"_5":17443,"_23820":101606,"_2384":101645},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2857":59622,"_25170":59609,"_17548":101647,"_5":17443,"_23820":101606,"_2384":101648},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2857":59623,"_25170":59609,"_17548":101650,"_5":17443,"_23820":101610,"_2384":101651},[],"Descarga el PEM e inspecciónalo:",{"_2857":59624,"_25170":59609,"_17548":101653,"_5":17443,"_23820":101610,"_2384":101654},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2857":59625,"_25170":59609,"_17548":101656,"_5":17443,"_23820":101614,"_2384":101657},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2857":59626,"_25170":59609,"_17548":101659,"_5":17443,"_23820":101614,"_2384":101660},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2857":59627,"_25170":59609,"_17548":101662,"_5":17443,"_23820":101614,"_2384":101663},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2857":59628,"_25170":59609,"_17548":101665,"_5":17443,"_23820":101614,"_2384":101666},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2857":59629,"_25170":59609,"_17548":101668,"_5":17443,"_23820":101614,"_2384":101669},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2857":59630,"_25170":59609,"_17548":101671,"_5":17443,"_23820":101614,"_2384":101672},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2857":59631,"_25170":59609,"_17548":101674,"_5":17443,"_23820":101614,"_2384":101675},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2857":59632,"_25170":59609,"_17548":101677,"_5":17443,"_23820":101618,"_2384":101678},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2857":59633,"_25170":59609,"_17548":101680,"_5":17443,"_23820":101622,"_2384":101681},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2857":59634,"_25170":59609,"_17548":101683,"_5":17443,"_23820":101626,"_2384":101684},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2857":59635,"_25170":59609,"_17548":101686,"_5":17443,"_23820":101630,"_2384":101687},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2857":59636,"_25170":59609,"_17548":101689,"_5":17443,"_23820":101630,"_2384":101690},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2857":59637,"_25170":59609,"_17548":101692,"_5":17443,"_23820":101630,"_2384":101693},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2857":59638,"_25170":59609,"_17548":101695,"_5":17443,"_23820":101634,"_2384":101696},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2857":59639,"_25170":59609,"_17548":101698,"_5":17443,"_23820":101634,"_2384":101699},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2857":59640,"_25170":59609,"_17548":101701,"_5":17443,"_23820":101634,"_2384":101702},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2857":59641,"_25170":59609,"_17548":101704,"_5":17443,"_23820":101638,"_2384":101705},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":59642,"_25170":59609,"_17548":101707,"_5":17443,"_23820":101638,"_2384":101708},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2857":59643,"_25170":59643,"_5":12294,"_2384":101710,"_25506":101711,"_17548":101713,"_23820":59643},"Ciclo de vida de un certificado",[40849,97280,45874,101712],"Conceptos",[],{"_2857":59644,"_25170":59643,"_17548":101715,"_5":17443,"_23820":59643,"_2384":101716},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2857":59645,"_25170":59643,"_5":25503,"_17548":101718,"_23820":101719,"_2384":101720},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2857":59646,"_25170":59643,"_5":25503,"_17548":101722,"_23820":101723,"_2384":101724},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2857":59647,"_25170":59643,"_5":25503,"_17548":101726,"_23820":101727,"_2384":101728},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2857":59648,"_25170":59643,"_5":25503,"_17548":101730,"_23820":101731,"_2384":101732},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2857":59649,"_25170":59643,"_5":25503,"_17548":101734,"_23820":101735,"_2384":101736},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2857":59650,"_25170":59643,"_5":25503,"_17548":101738,"_23820":101739,"_2384":101740},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2857":59651,"_25170":59643,"_5":25503,"_17548":101742,"_23820":101743,"_2384":101744},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2857":59652,"_25170":59643,"_5":25503,"_17548":101746,"_23820":101747,"_2384":101748},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2857":59653,"_25170":59643,"_5":25503,"_17548":101750,"_23820":101751,"_2384":101752},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2857":59654,"_25170":59643,"_5":25503,"_17548":101754,"_23820":101755,"_2384":101756},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2857":59655,"_25170":59643,"_17548":101758,"_5":17443,"_23820":59643,"_2384":101759},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2857":59656,"_25170":59643,"_17548":101761,"_5":17443,"_23820":101723,"_2384":101762},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2857":59657,"_25170":59643,"_17548":101764,"_5":17443,"_23820":101727,"_2384":101765},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2857":59658,"_25170":59643,"_17548":101767,"_5":17443,"_23820":101731,"_2384":101768},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2857":59659,"_25170":59643,"_17548":101770,"_5":17443,"_23820":101735,"_2384":101771},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2857":59660,"_25170":59643,"_17548":101773,"_5":17443,"_23820":101739,"_2384":101774},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2857":59661,"_25170":59643,"_17548":101776,"_5":17443,"_23820":101743,"_2384":101777},[],"Lamassu persiste cuatro estados X.509:",{"_2857":59662,"_25170":59643,"_17548":101779,"_5":17443,"_23820":101743,"_2384":101780},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2857":59663,"_25170":59643,"_17548":101782,"_5":17443,"_23820":101743,"_2384":101783},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2857":59664,"_25170":59643,"_17548":101785,"_5":17443,"_23820":101743,"_2384":101786},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2857":59665,"_25170":59643,"_17548":101788,"_5":17443,"_23820":101743,"_2384":101789},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2857":59666,"_25170":59643,"_17548":101791,"_5":17443,"_23820":101743,"_2384":101792},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2857":59667,"_25170":59643,"_17548":101794,"_5":17443,"_23820":101747,"_2384":101795},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2857":59668,"_25170":59643,"_17548":101797,"_5":17443,"_23820":101747,"_2384":101798},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2857":59669,"_25170":59643,"_17548":101800,"_5":17443,"_23820":101747,"_2384":101801},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2857":59670,"_25170":59643,"_17548":101803,"_5":17443,"_23820":101751,"_2384":101804},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2857":59671,"_25170":59643,"_17548":101806,"_5":17443,"_23820":101751,"_2384":101807},[],"Antes de confirmar:",{"_2857":59672,"_25170":59643,"_17548":101809,"_5":17443,"_23820":101751,"_2384":101810},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2857":59673,"_25170":59643,"_17548":101812,"_5":17443,"_23820":101751,"_2384":101813},[],"Distribuye la nueva cadena de confianza.",{"_2857":59674,"_25170":59643,"_17548":101815,"_5":17443,"_23820":101751,"_2384":101816},[],"Reemite las identidades necesarias.",{"_2857":59675,"_25170":59643,"_17548":101818,"_5":17443,"_23820":101751,"_2384":101819},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2857":59676,"_25170":59643,"_17548":101821,"_5":17443,"_23820":101751,"_2384":101822},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2857":59677,"_25170":59643,"_17548":101824,"_5":17443,"_23820":101751,"_2384":101825},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2857":59678,"_25170":59643,"_17548":101827,"_5":17443,"_23820":101755,"_2384":101828},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2857":59679,"_25170":59643,"_17548":101830,"_5":17443,"_23820":101755,"_2384":101831},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2857":59680,"_25170":59643,"_17548":101833,"_5":17443,"_23820":101755,"_2384":101834},[],"Cambios de estado y razones de revocación.",{"_2857":59681,"_25170":59643,"_17548":101836,"_5":17443,"_23820":101755,"_2384":101837},[],"Publicación y vigencia de OCSP y CRLs.",{"_2857":59682,"_25170":59643,"_17548":101839,"_5":17443,"_23820":101755,"_2384":101840},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2857":59683,"_25170":59643,"_17548":101842,"_5":17443,"_23820":101755,"_2384":101843},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2857":59684,"_25170":59684,"_5":12294,"_2384":101845,"_25506":101846,"_17548":101847,"_23820":59684},"Modelo de confianza",[40849,97280,45874,101712],[],{"_2857":59685,"_25170":59684,"_17548":101849,"_5":17443,"_23820":59684,"_2384":101850},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2857":59686,"_25170":59684,"_5":25503,"_17548":101852,"_23820":101853,"_2384":101854},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2857":59687,"_25170":59684,"_5":25503,"_17548":101856,"_23820":101857,"_2384":101858},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2857":59688,"_25170":59684,"_5":25503,"_17548":101860,"_23820":101861,"_2384":101862},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2857":59689,"_25170":59684,"_5":25503,"_17548":101864,"_23820":101865,"_2384":101866},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2857":59690,"_25170":59684,"_5":25503,"_17548":101868,"_23820":101869,"_2384":101870},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2857":59691,"_25170":59684,"_5":25503,"_17548":101872,"_23820":101873,"_2384":101874},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2857":59692,"_25170":59684,"_5":25503,"_17548":101876,"_23820":101877,"_2384":101878},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2857":59693,"_25170":59684,"_5":25503,"_17548":101880,"_23820":101881,"_2384":101882},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2857":59694,"_25170":59684,"_5":25503,"_17548":101884,"_23820":101885,"_2384":101886},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2857":59695,"_25170":59684,"_5":25503,"_17548":101888,"_23820":101889,"_2384":101890},[],"/docs/pr-preview/pr-38/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2857":59696,"_25170":59684,"_17548":101892,"_5":17443,"_23820":59684,"_2384":101893},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2857":59697,"_25170":59684,"_17548":101895,"_5":17443,"_23820":101857,"_2384":101896},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2857":59698,"_25170":59684,"_17548":101898,"_5":17443,"_23820":101861,"_2384":101899},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2857":59699,"_25170":59684,"_17548":101901,"_5":17443,"_23820":101865,"_2384":101902},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2857":59700,"_25170":59684,"_17548":101904,"_5":17443,"_23820":101869,"_2384":101905},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2857":59701,"_25170":59684,"_17548":101907,"_5":17443,"_23820":101873,"_2384":101908},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2857":59702,"_25170":59684,"_17548":101910,"_5":17443,"_23820":101873,"_2384":101911},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2857":59703,"_25170":59684,"_17548":101913,"_5":17443,"_23820":101873,"_2384":101914},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2857":59704,"_25170":59684,"_17548":101916,"_5":17443,"_23820":101873,"_2384":101917},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2857":59705,"_25170":59684,"_17548":101919,"_5":17443,"_23820":101873,"_2384":101920},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2857":59706,"_25170":59684,"_17548":101922,"_5":17443,"_23820":101873,"_2384":101923},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2857":59707,"_25170":59684,"_17548":101925,"_5":17443,"_23820":101877,"_2384":101926},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2857":59708,"_25170":59684,"_17548":101928,"_5":17443,"_23820":101877,"_2384":101929},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2857":59709,"_25170":59684,"_17548":101931,"_5":17443,"_23820":101877,"_2384":101932},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación configuradas en el bloque de re-enrolamiento.",{"_2857":59710,"_25170":59684,"_17548":101934,"_5":17443,"_23820":101877,"_2384":101935},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2857":59711,"_25170":59684,"_17548":101937,"_5":17443,"_23820":101877,"_2384":101938},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2857":59712,"_25170":59684,"_17548":101940,"_5":17443,"_23820":101881,"_2384":101941},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2857":59713,"_25170":59684,"_17548":101943,"_5":17443,"_23820":101881,"_2384":101944},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2857":59714,"_25170":59684,"_17548":101946,"_5":17443,"_23820":101881,"_2384":101947},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2857":59715,"_25170":59684,"_17548":101949,"_5":17443,"_23820":101881,"_2384":101950},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2857":59716,"_25170":59684,"_17548":101952,"_5":17443,"_23820":101881,"_2384":101953},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2857":59717,"_25170":59684,"_17548":101955,"_5":17443,"_23820":101881,"_2384":101956},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2857":59718,"_25170":59684,"_17548":101958,"_5":17443,"_23820":101881,"_2384":101959},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2857":59719,"_25170":59684,"_17548":101961,"_5":17443,"_23820":101885,"_2384":101962},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2857":59720,"_25170":59684,"_17548":101964,"_5":17443,"_23820":101889,"_2384":101965},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2857":59721,"_25170":59684,"_17548":101967,"_5":17443,"_23820":101889,"_2384":101968},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2857":59722,"_25170":59684,"_17548":101970,"_5":17443,"_23820":101889,"_2384":101971},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2857":59723,"_25170":59684,"_17548":101973,"_5":17443,"_23820":101889,"_2384":101974},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2857":59724,"_25170":59684,"_17548":101976,"_5":17443,"_23820":101889,"_2384":101977},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2857":59725,"_25170":59684,"_17548":101979,"_5":17443,"_23820":101889,"_2384":101980},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2857":59726,"_25170":59684,"_17548":101982,"_5":17443,"_23820":101889,"_2384":101983},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2857":59727,"_25170":59727,"_5":12294,"_2384":101985,"_25506":101986,"_17548":101987,"_23820":59727},"Listas de revocación (CRL)",[40849,97280,45874,101473],[],{"_2857":59728,"_25170":59727,"_17548":101989,"_5":17443,"_23820":59727,"_2384":101990},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2857":59729,"_25170":59727,"_5":25503,"_17548":101992,"_23820":101993,"_2384":101994},[],"/docs/pr-preview/pr-38/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2857":59730,"_25170":59727,"_5":25503,"_17548":101996,"_23820":101997,"_2384":101998},[],"/docs/pr-preview/pr-38/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2857":59731,"_25170":59727,"_5":25503,"_17548":102000,"_23820":102001,"_2384":102002},[],"/docs/pr-preview/pr-38/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2857":59732,"_25170":59727,"_5":25503,"_17548":102004,"_23820":102005,"_2384":102006},[],"/docs/pr-preview/pr-38/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2857":59733,"_25170":59727,"_5":25503,"_17548":102008,"_23820":102009,"_2384":102010},[],"/docs/pr-preview/pr-38/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2857":59734,"_25170":59727,"_5":25503,"_17548":102012,"_23820":102013,"_2384":102014},[],"/docs/pr-preview/pr-38/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2857":59735,"_25170":59727,"_5":25503,"_17548":102016,"_23820":102017,"_2384":102018},[],"/docs/pr-preview/pr-38/es/platform/pki/crl#referencias","Referencias",{"_2857":59736,"_25170":59727,"_17548":102020,"_5":17443,"_23820":59727,"_2384":102021},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2857":59737,"_25170":59727,"_17548":102023,"_5":17443,"_23820":101993,"_2384":102024},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2857":59738,"_25170":59727,"_17548":102026,"_5":17443,"_23820":101993,"_2384":102027},[],"Campo de `crl_options`",{"_2857":59739,"_25170":59727,"_17548":102029,"_5":17443,"_23820":101993,"_2384":98776},[],{"_2857":59740,"_25170":59727,"_17548":102031,"_5":17443,"_23820":101993,"_2384":102032},[],"Valor inicial del backend",{"_2857":59741,"_25170":59727,"_17548":102034,"_5":17443,"_23820":101993,"_2384":47054},[],{"_2857":59742,"_25170":59727,"_17548":102036,"_5":17443,"_23820":101993,"_2384":102037},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2857":59743,"_25170":59727,"_17548":102039,"_5":17443,"_23820":101993,"_2384":102040},[],"7 días.",{"_2857":59744,"_25170":59727,"_17548":102042,"_5":17443,"_23820":101993,"_2384":47063},[],{"_2857":59745,"_25170":59727,"_17548":102044,"_5":17443,"_23820":101993,"_2384":102045},[],"Plazo desde la publicación que activa la renovación programada.",{"_2857":59746,"_25170":59727,"_17548":102047,"_5":17443,"_23820":101993,"_2384":102048},[],"6 días y 23 horas.",{"_2857":59747,"_25170":59727,"_17548":102050,"_5":17443,"_23820":101993,"_2384":47072},[],{"_2857":59748,"_25170":59727,"_17548":102052,"_5":17443,"_23820":101993,"_2384":102053},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2857":59749,"_25170":59727,"_17548":102055,"_5":17443,"_23820":101993,"_2384":47078},[],{"_2857":59750,"_25170":59727,"_17548":102057,"_5":17443,"_23820":101993,"_2384":47081},[],{"_2857":59751,"_25170":59727,"_17548":102059,"_5":17443,"_23820":101993,"_2384":102060},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2857":59752,"_25170":59727,"_17548":102062,"_5":17443,"_23820":101993,"_2384":102063},[],"SKI de la CA.",{"_2857":59753,"_25170":59727,"_17548":102065,"_5":17443,"_23820":101993,"_2384":102066},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2857":59754,"_25170":59727,"_17548":102068,"_5":17443,"_23820":101993,"_2384":102069},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2857":59755,"_25170":59727,"_17548":102071,"_5":17443,"_23820":101997,"_2384":102072},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2857":59756,"_25170":59727,"_17548":102074,"_5":17443,"_23820":101997,"_2384":102075},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2857":59757,"_25170":59727,"_17548":102077,"_5":17443,"_23820":101997,"_2384":102078},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2857":59758,"_25170":59727,"_17548":102080,"_5":17443,"_23820":102001,"_2384":102081},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2857":59759,"_25170":59727,"_17548":102083,"_5":17443,"_23820":102001,"_2384":102084},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2857":59760,"_25170":59727,"_17548":102086,"_5":17443,"_23820":102005,"_2384":102087},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2857":59761,"_25170":59727,"_17548":102089,"_5":17443,"_23820":102005,"_2384":102090},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2857":59762,"_25170":59727,"_17548":102092,"_5":17443,"_23820":102005,"_2384":102093},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2857":59763,"_25170":59727,"_17548":102095,"_5":17443,"_23820":102005,"_2384":102096},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2857":59764,"_25170":59727,"_17548":102098,"_5":17443,"_23820":102005,"_2384":102099},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2857":59765,"_25170":59727,"_17548":102101,"_5":17443,"_23820":102009,"_2384":102102},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2857":59766,"_25170":59727,"_17548":102104,"_5":17443,"_23820":102009,"_2384":98965},[],{"_2857":59767,"_25170":59727,"_17548":102106,"_5":17443,"_23820":102009,"_2384":102107},[],"Path relativo",{"_2857":59768,"_25170":59727,"_17548":102109,"_5":17443,"_23820":102009,"_2384":97071},[],{"_2857":59769,"_25170":59727,"_17548":102111,"_5":17443,"_23820":102009,"_2384":47136},[],{"_2857":59770,"_25170":59727,"_17548":102113,"_5":17443,"_23820":102009,"_2384":47139},[],{"_2857":59771,"_25170":59727,"_17548":102115,"_5":17443,"_23820":102009,"_2384":102116},[],"Consultar `crl_options` y `latest_crl`.",{"_2857":59772,"_25170":59727,"_17548":102118,"_5":17443,"_23820":102009,"_2384":47145},[],{"_2857":59773,"_25170":59727,"_17548":102120,"_5":17443,"_23820":102009,"_2384":47139},[],{"_2857":59774,"_25170":59727,"_17548":102122,"_5":17443,"_23820":102009,"_2384":102123},[],"Sustituir la configuración de CRL.",{"_2857":59775,"_25170":59727,"_17548":102125,"_5":17443,"_23820":102009,"_2384":102126},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2857":59776,"_25170":59727,"_17548":102128,"_5":17443,"_23820":102009,"_2384":102129},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2857":59777,"_25170":59727,"_17548":102131,"_5":17443,"_23820":102013,"_2384":102132},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2857":59778,"_25170":59727,"_17548":102134,"_5":17443,"_23820":102017,"_2384":102135},[],"RFC 5280: perfil X.509 y CRL.",{"_2857":59779,"_25170":59727,"_17548":102137,"_5":17443,"_23820":102017,"_2384":47165},[],{"_2857":59780,"_25170":59727,"_17548":102139,"_5":17443,"_23820":102017,"_2384":47168},[],{"_2857":59781,"_25170":59727,"_17548":102141,"_5":17443,"_23820":102017,"_2384":102142},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":59782,"_25170":59727,"_17548":102144,"_5":17443,"_23820":102017,"_2384":102145},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2857":59783,"_25170":59783,"_5":12294,"_2384":102147,"_25506":102148,"_17548":102149,"_23820":59783},"Claves y motores criptográficos",[40849,97280,45874,100858],[],{"_2857":59784,"_25170":59783,"_17548":102151,"_5":17443,"_23820":59783,"_2384":102152},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2857":59785,"_25170":59783,"_5":25503,"_17548":102154,"_23820":102155,"_2384":102156},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2857":59786,"_25170":59783,"_5":25503,"_17548":102158,"_23820":102159,"_2384":102160},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2857":59787,"_25170":59783,"_5":25503,"_17548":102162,"_23820":102163,"_2384":47193},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#file-system",{"_2857":59788,"_25170":59783,"_5":25503,"_17548":102165,"_23820":102166,"_2384":47197},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#hashicorp-vault",{"_2857":59789,"_25170":59783,"_5":25503,"_17548":102168,"_23820":102169,"_2384":47201},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#aws-secrets-manager",{"_2857":59790,"_25170":59783,"_5":25503,"_17548":102171,"_23820":102172,"_2384":47205},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#aws-kms",{"_2857":59791,"_25170":59783,"_5":25503,"_17548":102174,"_23820":102175,"_2384":47209},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#pkcs11",{"_2857":59792,"_25170":59783,"_5":25503,"_17548":102177,"_23820":102178,"_2384":47213},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#azure-key-vault",{"_2857":59793,"_25170":59783,"_5":25503,"_17548":102180,"_23820":102181,"_2384":102182},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2857":59794,"_25170":59783,"_5":25503,"_17548":102184,"_23820":102185,"_2384":102186},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2857":59795,"_25170":59783,"_5":25503,"_17548":102188,"_23820":102189,"_2384":102190},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2857":59796,"_25170":59783,"_5":25503,"_17548":102192,"_23820":102193,"_2384":102194},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2857":59797,"_25170":59783,"_5":25503,"_17548":102196,"_23820":102197,"_2384":102198},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2857":59798,"_25170":59783,"_5":25503,"_17548":102200,"_23820":102201,"_2384":102202},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2857":59799,"_25170":59783,"_5":25503,"_17548":102204,"_23820":102205,"_2384":102206},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2857":59800,"_25170":59783,"_5":25503,"_17548":102208,"_23820":102209,"_2384":47245},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#sign",{"_2857":59801,"_25170":59783,"_5":25503,"_17548":102211,"_23820":102212,"_2384":47249},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#verify",{"_2857":59802,"_25170":59783,"_5":25503,"_17548":102214,"_23820":102215,"_2384":102216},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2857":59803,"_25170":59783,"_5":25503,"_17548":102218,"_23820":102219,"_2384":102220},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2857":59804,"_25170":59783,"_5":25503,"_17548":102222,"_23820":102223,"_2384":102224},[],"/docs/pr-preview/pr-38/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2857":59805,"_25170":59783,"_17548":102226,"_5":17443,"_23820":59783,"_2384":102227},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2857":59806,"_25170":59783,"_17548":102229,"_5":17443,"_23820":59783,"_2384":102230},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2857":59807,"_25170":59783,"_17548":102232,"_5":17443,"_23820":102155,"_2384":102233},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2857":59808,"_25170":59783,"_17548":102235,"_5":17443,"_23820":102155,"_2384":102236},[],"En la práctica, permite:",{"_2857":59809,"_25170":59783,"_17548":102238,"_5":17443,"_23820":102155,"_2384":102239},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2857":59810,"_25170":59783,"_17548":102241,"_5":17443,"_23820":102155,"_2384":102242},[],"Importar claves creadas externamente.",{"_2857":59811,"_25170":59783,"_17548":102244,"_5":17443,"_23820":102155,"_2384":102245},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2857":59812,"_25170":59783,"_17548":102247,"_5":17443,"_23820":102155,"_2384":102248},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2857":59813,"_25170":59783,"_17548":102250,"_5":17443,"_23820":102159,"_2384":102251},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2857":59814,"_25170":59783,"_17548":102253,"_5":17443,"_23820":102159,"_2384":102254},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2857":59815,"_25170":59783,"_17548":102256,"_5":17443,"_23820":102159,"_2384":102257},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2857":59816,"_25170":59783,"_17548":102259,"_5":17443,"_23820":102163,"_2384":102260},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2857":59817,"_25170":59783,"_17548":102262,"_5":17443,"_23820":102166,"_2384":102263},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2857":59818,"_25170":59783,"_17548":102265,"_5":17443,"_23820":102169,"_2384":102266},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2857":59819,"_25170":59783,"_17548":102268,"_5":17443,"_23820":102172,"_2384":102269},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2857":59820,"_25170":59783,"_17548":102271,"_5":17443,"_23820":102175,"_2384":102272},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2857":59821,"_25170":59783,"_17548":102274,"_5":17443,"_23820":102178,"_2384":102275},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2857":59822,"_25170":59783,"_17548":102277,"_5":17443,"_23820":102178,"_2384":102278},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2857":59823,"_25170":59783,"_17548":102280,"_5":17443,"_23820":102178,"_2384":102281},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2857":59824,"_25170":59783,"_17548":102283,"_5":17443,"_23820":102178,"_2384":102284},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2857":59825,"_25170":59783,"_17548":102286,"_5":17443,"_23820":102181,"_2384":102287},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2857":59826,"_25170":59783,"_17548":102289,"_5":17443,"_23820":102181,"_2384":102290},[],"La tabla incluye los siguientes campos:",{"_2857":59827,"_25170":59783,"_17548":102292,"_5":17443,"_23820":102181,"_2384":102293},[],"**Name**: nombre descriptivo de la clave.",{"_2857":59828,"_25170":59783,"_17548":102295,"_5":17443,"_23820":102181,"_2384":102296},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2857":59829,"_25170":59783,"_17548":102298,"_5":17443,"_23820":102181,"_2384":102299},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2857":59830,"_25170":59783,"_17548":102301,"_5":17443,"_23820":102181,"_2384":102302},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2857":59831,"_25170":59783,"_17548":102304,"_5":17443,"_23820":102181,"_2384":102305},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2857":59832,"_25170":59783,"_17548":102307,"_5":17443,"_23820":102181,"_2384":102308},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2857":59833,"_25170":59783,"_17548":102310,"_5":17443,"_23820":102181,"_2384":102311},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2857":59834,"_25170":59783,"_17548":102313,"_5":17443,"_23820":102181,"_2384":102314},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2857":59835,"_25170":59783,"_17548":102316,"_5":17443,"_23820":102181,"_2384":102317},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2857":59836,"_25170":59783,"_17548":102319,"_5":17443,"_23820":102181,"_2384":102320},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2857":59837,"_25170":59783,"_17548":102322,"_5":17443,"_23820":102181,"_2384":102323},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2857":59838,"_25170":59783,"_17548":102325,"_5":17443,"_23820":102181,"_2384":102326},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2857":59839,"_25170":59783,"_17548":102328,"_5":17443,"_23820":102181,"_2384":102329},[],"**Delete Key** para eliminar la clave del sistema.",{"_2857":59840,"_25170":59783,"_17548":102331,"_5":17443,"_23820":102185,"_2384":102332},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2857":59841,"_25170":59783,"_17548":102334,"_5":17443,"_23820":102189,"_2384":102335},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2857":59842,"_25170":59783,"_17548":102337,"_5":17443,"_23820":102189,"_2384":102338},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2857":59843,"_25170":59783,"_17548":102340,"_5":17443,"_23820":102189,"_2384":102341},[],"**Key Name**: nombre único y descriptivo.",{"_2857":59844,"_25170":59783,"_17548":102343,"_5":17443,"_23820":102189,"_2384":102344},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2857":59845,"_25170":59783,"_17548":102346,"_5":17443,"_23820":102189,"_2384":102347},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2857":59846,"_25170":59783,"_17548":102349,"_5":17443,"_23820":102189,"_2384":102350},[],"**Tags**: metadatos para clasificar la clave.",{"_2857":59847,"_25170":59783,"_17548":102352,"_5":17443,"_23820":102189,"_2384":102353},[],"**Metadata**: información adicional para usos avanzados.",{"_2857":59848,"_25170":59783,"_17548":102355,"_5":17443,"_23820":102193,"_2384":102356},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2857":59849,"_25170":59783,"_17548":102358,"_5":17443,"_23820":102193,"_2384":102359},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2857":59850,"_25170":59783,"_17548":102361,"_5":17443,"_23820":102193,"_2384":102362},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2857":59851,"_25170":59783,"_17548":102364,"_5":17443,"_23820":102193,"_2384":102365},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2857":59852,"_25170":59783,"_17548":102367,"_5":17443,"_23820":102193,"_2384":102368},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2857":59853,"_25170":59783,"_17548":102370,"_5":17443,"_23820":102193,"_2384":102371},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2857":59854,"_25170":59783,"_17548":102373,"_5":17443,"_23820":102193,"_2384":102374},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2857":59855,"_25170":59783,"_17548":102376,"_5":17443,"_23820":102193,"_2384":102377},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2857":59856,"_25170":59783,"_17548":102379,"_5":17443,"_23820":102193,"_2384":102380},[],"**Metadata**: información adicional opcional.",{"_2857":59857,"_25170":59783,"_17548":102382,"_5":17443,"_23820":102193,"_2384":102383},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2857":59858,"_25170":59783,"_17548":102385,"_5":17443,"_23820":102193,"_2384":102386},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2857":59859,"_25170":59783,"_17548":102388,"_5":17443,"_23820":102197,"_2384":102389},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2857":59860,"_25170":59783,"_17548":102391,"_5":17443,"_23820":102201,"_2384":102392},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2857":59861,"_25170":59783,"_17548":102394,"_5":17443,"_23820":102201,"_2384":102395},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2857":59862,"_25170":59783,"_17548":102397,"_5":17443,"_23820":102201,"_2384":102398},[],"**Key Name**: nombre descriptivo.",{"_2857":59863,"_25170":59783,"_17548":102400,"_5":17443,"_23820":102201,"_2384":102401},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2857":59864,"_25170":59783,"_17548":102403,"_5":17443,"_23820":102201,"_2384":102404},[],"**Tags**: etiquetas asociadas.",{"_2857":59865,"_25170":59783,"_17548":102406,"_5":17443,"_23820":102201,"_2384":102407},[],"**Aliases**: nombres alternativos.",{"_2857":59866,"_25170":59783,"_17548":102409,"_5":17443,"_23820":102201,"_2384":102410},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2857":59867,"_25170":59783,"_17548":102412,"_5":17443,"_23820":102201,"_2384":102413},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2857":59868,"_25170":59783,"_17548":102415,"_5":17443,"_23820":102201,"_2384":102416},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2857":59869,"_25170":59783,"_17548":102418,"_5":17443,"_23820":102201,"_2384":102419},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2857":59870,"_25170":59783,"_17548":102421,"_5":17443,"_23820":102205,"_2384":102422},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2857":59871,"_25170":59783,"_17548":102424,"_5":17443,"_23820":102205,"_2384":102425},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2857":59872,"_25170":59783,"_17548":102427,"_5":17443,"_23820":102205,"_2384":102428},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2857":59873,"_25170":59783,"_17548":102430,"_5":17443,"_23820":102209,"_2384":102431},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2857":59874,"_25170":59783,"_17548":102433,"_5":17443,"_23820":102209,"_2384":102434},[],"Campos principales:",{"_2857":59875,"_25170":59783,"_17548":102436,"_5":17443,"_23820":102209,"_2384":102437},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2857":59876,"_25170":59783,"_17548":102439,"_5":17443,"_23820":102209,"_2384":102440},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2857":59877,"_25170":59783,"_17548":102442,"_5":17443,"_23820":102209,"_2384":102443},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2857":59878,"_25170":59783,"_17548":102445,"_5":17443,"_23820":102209,"_2384":102446},[],"**Message**: contenido que se va a firmar.",{"_2857":59879,"_25170":59783,"_17548":102448,"_5":17443,"_23820":102209,"_2384":102449},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2857":59880,"_25170":59783,"_17548":102451,"_5":17443,"_23820":102212,"_2384":102452},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2857":59881,"_25170":59783,"_17548":102454,"_5":17443,"_23820":102212,"_2384":102434},[],{"_2857":59882,"_25170":59783,"_17548":102456,"_5":17443,"_23820":102212,"_2384":102457},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2857":59883,"_25170":59783,"_17548":102459,"_5":17443,"_23820":102212,"_2384":102460},[],"**Message Type**: `Raw` o `Digest`.",{"_2857":59884,"_25170":59783,"_17548":102462,"_5":17443,"_23820":102212,"_2384":102463},[],"**Payload Encoding**: codificación del mensaje.",{"_2857":59885,"_25170":59783,"_17548":102465,"_5":17443,"_23820":102212,"_2384":102466},[],"**Message**: mensaje original o hash.",{"_2857":59886,"_25170":59783,"_17548":102468,"_5":17443,"_23820":102212,"_2384":102469},[],"**Signature**: firma que se desea comprobar.",{"_2857":59887,"_25170":59783,"_17548":102471,"_5":17443,"_23820":102212,"_2384":102472},[],"**Result**: indicador del resultado de la validación.",{"_2857":59888,"_25170":59783,"_17548":102474,"_5":17443,"_23820":102215,"_2384":102475},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2857":59889,"_25170":59783,"_17548":102477,"_5":17443,"_23820":102215,"_2384":102478},[],"Este flujo es útil para:",{"_2857":59890,"_25170":59783,"_17548":102480,"_5":17443,"_23820":102215,"_2384":102481},[],"Solicitar certificados a una CA externa.",{"_2857":59891,"_25170":59783,"_17548":102483,"_5":17443,"_23820":102215,"_2384":102484},[],"Renovar una identidad manteniendo la misma clave.",{"_2857":59892,"_25170":59783,"_17548":102486,"_5":17443,"_23820":102215,"_2384":102487},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2857":59893,"_25170":59783,"_17548":102489,"_5":17443,"_23820":102215,"_2384":102490},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2857":59894,"_25170":59783,"_17548":102492,"_5":17443,"_23820":102215,"_2384":102493},[],"**Organization (O)**: organización o empresa.",{"_2857":59895,"_25170":59783,"_17548":102495,"_5":17443,"_23820":102215,"_2384":102496},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2857":59896,"_25170":59783,"_17548":102498,"_5":17443,"_23820":102215,"_2384":102499},[],"**Country (C)**: código de país de dos letras.",{"_2857":59897,"_25170":59783,"_17548":102501,"_5":17443,"_23820":102215,"_2384":102502},[],"**State / Province (ST)**: estado o provincia.",{"_2857":59898,"_25170":59783,"_17548":102504,"_5":17443,"_23820":102215,"_2384":102505},[],"**Locality (L)**: ciudad o localidad.",{"_2857":59899,"_25170":59783,"_17548":102507,"_5":17443,"_23820":102215,"_2384":102508},[],"**Email Address**: correo de contacto.",{"_2857":59900,"_25170":59783,"_17548":102510,"_5":17443,"_23820":102215,"_2384":102511},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2857":59901,"_25170":59783,"_17548":102513,"_5":17443,"_23820":102215,"_2384":102514},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2857":59902,"_25170":59783,"_17548":102516,"_5":17443,"_23820":102219,"_2384":102517},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2857":59903,"_25170":59783,"_17548":102519,"_5":17443,"_23820":102219,"_2384":47557},[],{"_2857":59904,"_25170":59783,"_17548":102521,"_5":17443,"_23820":102223,"_2384":102522},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2857":59905,"_25170":59905,"_5":12294,"_2384":102524,"_25506":102525,"_17548":102526,"_23820":59905},"Validación online con OCSP",[40849,97280,45874,101473],[],{"_2857":59906,"_25170":59905,"_17548":102528,"_5":17443,"_23820":59905,"_2384":102529},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2857":59907,"_25170":59905,"_5":25503,"_17548":102531,"_23820":102532,"_2384":102533},[],"/docs/pr-preview/pr-38/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2857":59908,"_25170":59905,"_5":25503,"_17548":102535,"_23820":102536,"_2384":102537},[],"/docs/pr-preview/pr-38/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2857":59909,"_25170":59905,"_5":25503,"_17548":102539,"_23820":102540,"_2384":102541},[],"/docs/pr-preview/pr-38/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2857":59910,"_25170":59905,"_5":25503,"_17548":102543,"_23820":102544,"_2384":102545},[],"/docs/pr-preview/pr-38/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2857":59911,"_25170":59905,"_5":25503,"_17548":102547,"_23820":102548,"_2384":102549},[],"/docs/pr-preview/pr-38/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2857":59912,"_25170":59905,"_5":25503,"_17548":102551,"_23820":102552,"_2384":102018},[],"/docs/pr-preview/pr-38/es/platform/pki/ocsp#referencias",{"_2857":59913,"_25170":59905,"_17548":102554,"_5":17443,"_23820":59905,"_2384":102555},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2857":59914,"_25170":59905,"_17548":102557,"_5":17443,"_23820":102532,"_2384":102558},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2857":59915,"_25170":59905,"_17548":102560,"_5":17443,"_23820":102532,"_2384":102561},[],"Estado del registro",{"_2857":59916,"_25170":59905,"_17548":102563,"_5":17443,"_23820":102532,"_2384":102564},[],"Respuesta firmada",{"_2857":59917,"_25170":59905,"_17548":102566,"_5":17443,"_23820":102532,"_2384":45052},[],{"_2857":59918,"_25170":59905,"_17548":102568,"_5":17443,"_23820":102532,"_2384":47607},[],{"_2857":59919,"_25170":59905,"_17548":102570,"_5":17443,"_23820":102532,"_2384":45069},[],{"_2857":59920,"_25170":59905,"_17548":102572,"_5":17443,"_23820":102532,"_2384":102573},[],"`Revoked`, con razón y fecha de revocación.",{"_2857":59921,"_25170":59905,"_17548":102575,"_5":17443,"_23820":102532,"_2384":102576},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2857":59922,"_25170":59905,"_17548":102578,"_5":17443,"_23820":102532,"_2384":102579},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2857":59923,"_25170":59905,"_17548":102581,"_5":17443,"_23820":102532,"_2384":102582},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2857":59924,"_25170":59905,"_17548":102584,"_5":17443,"_23820":102532,"_2384":102585},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2857":59925,"_25170":59905,"_17548":102587,"_5":17443,"_23820":102532,"_2384":102588},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2857":59926,"_25170":59905,"_17548":102590,"_5":17443,"_23820":102536,"_2384":102591},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2857":59927,"_25170":59905,"_17548":102593,"_5":17443,"_23820":102536,"_2384":102594},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2857":59928,"_25170":59905,"_17548":102596,"_5":17443,"_23820":102540,"_2384":102597},[],"El servicio acepta:",{"_2857":59929,"_25170":59905,"_17548":102599,"_5":17443,"_23820":102540,"_2384":98965},[],{"_2857":59930,"_25170":59905,"_17548":102601,"_5":17443,"_23820":102540,"_2384":102602},[],"Ruta del servicio VA",{"_2857":59931,"_25170":59905,"_17548":102604,"_5":17443,"_23820":102540,"_2384":102605},[],"Formato",{"_2857":59932,"_25170":59905,"_17548":102607,"_5":17443,"_23820":102540,"_2384":47647},[],{"_2857":59933,"_25170":59905,"_17548":102609,"_5":17443,"_23820":102540,"_2384":47650},[],{"_2857":59934,"_25170":59905,"_17548":102611,"_5":17443,"_23820":102540,"_2384":102612},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2857":59935,"_25170":59905,"_17548":102614,"_5":17443,"_23820":102540,"_2384":47136},[],{"_2857":59936,"_25170":59905,"_17548":102616,"_5":17443,"_23820":102540,"_2384":47658},[],{"_2857":59937,"_25170":59905,"_17548":102618,"_5":17443,"_23820":102540,"_2384":102619},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2857":59938,"_25170":59905,"_17548":102621,"_5":17443,"_23820":102540,"_2384":102622},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2857":59939,"_25170":59905,"_17548":102624,"_5":17443,"_23820":102544,"_2384":102625},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2857":59940,"_25170":59905,"_17548":102627,"_5":17443,"_23820":102544,"_2384":102628},[],"Genera la solicitud:",{"_2857":59941,"_25170":59905,"_17548":102630,"_5":17443,"_23820":102544,"_2384":102631},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2857":59942,"_25170":59905,"_17548":102633,"_5":17443,"_23820":102544,"_2384":102634},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2857":59943,"_25170":59905,"_17548":102636,"_5":17443,"_23820":102544,"_2384":102637},[],"Verifica el DER recibido:",{"_2857":59944,"_25170":59905,"_17548":102639,"_5":17443,"_23820":102544,"_2384":102640},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2857":59945,"_25170":59905,"_17548":102642,"_5":17443,"_23820":102548,"_2384":102643},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2857":59946,"_25170":59905,"_17548":102645,"_5":17443,"_23820":102548,"_2384":102646},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2857":59947,"_25170":59905,"_17548":102648,"_5":17443,"_23820":102552,"_2384":47691},[],{"_2857":59948,"_25170":59905,"_17548":102650,"_5":17443,"_23820":102552,"_2384":47694},[],{"_2857":59949,"_25170":59905,"_17548":102652,"_5":17443,"_23820":102552,"_2384":102653},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2857":59950,"_25170":59905,"_17548":102655,"_5":17443,"_23820":102552,"_2384":102145},[],{"_2857":59951,"_25170":59951,"_5":12294,"_2384":45874,"_25506":102657,"_17548":102658,"_23820":59951},[40849,97280,45874],[],{"_2857":59952,"_25170":59951,"_17548":102660,"_5":17443,"_23820":59951,"_2384":102661},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2857":59953,"_25170":59951,"_5":25503,"_17548":102663,"_23820":102664,"_2384":100182},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#empieza-aquí",{"_2857":59954,"_25170":59951,"_5":25503,"_17548":102666,"_23820":102667,"_2384":102668},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2857":59955,"_25170":59951,"_5":25503,"_17548":102670,"_23820":102671,"_2384":100704},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#capacidades-principales",{"_2857":59956,"_25170":59951,"_5":25503,"_17548":102673,"_23820":102674,"_2384":100708},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2857":59957,"_25170":59951,"_5":25503,"_17548":102676,"_23820":102677,"_2384":100712},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2857":59958,"_25170":59951,"_5":25503,"_17548":102679,"_23820":102680,"_2384":100716},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#emite-y-controla-certificados",{"_2857":59959,"_25170":59951,"_5":25503,"_17548":102682,"_23820":102683,"_2384":100724},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#publica-el-estado-de-validación",{"_2857":59960,"_25170":59951,"_5":25503,"_17548":102685,"_23820":102686,"_2384":102687},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2857":59961,"_25170":59951,"_5":25503,"_17548":102689,"_23820":102690,"_2384":101639},[],"/docs/pr-preview/pr-38/es/platform/pki/overview#continúa",{"_2857":59962,"_25170":59951,"_17548":102692,"_5":17443,"_23820":59951,"_2384":102693},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2857":59963,"_25170":59951,"_17548":102695,"_5":17443,"_23820":102664,"_2384":102696},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2857":59964,"_25170":59951,"_17548":102698,"_5":17443,"_23820":102664,"_2384":102699},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2857":59965,"_25170":59951,"_17548":102701,"_5":17443,"_23820":102667,"_2384":102702},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2857":59966,"_25170":59951,"_17548":102704,"_5":17443,"_23820":102667,"_2384":102705},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2857":59967,"_25170":59951,"_17548":102707,"_5":17443,"_23820":102667,"_2384":102708},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2857":59968,"_25170":59951,"_17548":102710,"_5":17443,"_23820":102667,"_2384":102711},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2857":59969,"_25170":59951,"_17548":102713,"_5":17443,"_23820":102667,"_2384":102714},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2857":59970,"_25170":59951,"_17548":102716,"_5":17443,"_23820":102674,"_2384":102717},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2857":59971,"_25170":59951,"_17548":102719,"_5":17443,"_23820":102677,"_2384":102720},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2857":59972,"_25170":59951,"_17548":102722,"_5":17443,"_23820":102680,"_2384":102723},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2857":59973,"_25170":59951,"_17548":102725,"_5":17443,"_23820":102683,"_2384":102726},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2857":59974,"_25170":59951,"_17548":102728,"_5":17443,"_23820":102686,"_2384":102729},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2857":59975,"_25170":59951,"_17548":102731,"_5":17443,"_23820":102686,"_2384":102732},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2857":59976,"_25170":59951,"_17548":102734,"_5":17443,"_23820":102686,"_2384":102735},[],"su clave pública corresponda a la clave privada del cliente;",{"_2857":59977,"_25170":59951,"_17548":102737,"_5":17443,"_23820":102686,"_2384":102738},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2857":59978,"_25170":59951,"_17548":102740,"_5":17443,"_23820":102686,"_2384":102741},[],"sus fechas y usos permitan la operación;",{"_2857":59979,"_25170":59951,"_17548":102743,"_5":17443,"_23820":102686,"_2384":102744},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2857":59980,"_25170":59951,"_17548":102746,"_5":17443,"_23820":102686,"_2384":102747},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2857":59981,"_25170":59951,"_17548":102749,"_5":17443,"_23820":102690,"_2384":102750},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2857":59982,"_25170":59951,"_17548":102752,"_5":17443,"_23820":102690,"_2384":102753},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2857":59983,"_25170":59951,"_17548":102755,"_5":17443,"_23820":102690,"_2384":102756},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2857":59984,"_25170":59984,"_5":12294,"_2384":102758,"_25506":102759,"_17548":102760,"_23820":59984},"Crea tu primera CA",[40849,97280,45874,100306],[],{"_2857":59985,"_25170":59984,"_17548":102762,"_5":17443,"_23820":59984,"_2384":102763},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2857":59986,"_25170":59984,"_5":25503,"_17548":102765,"_23820":102766,"_2384":95981},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2857":59987,"_25170":59984,"_5":25503,"_17548":102768,"_23820":102769,"_2384":102770},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2857":59988,"_25170":59984,"_5":25503,"_17548":102772,"_23820":102773,"_2384":102774},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2857":59989,"_25170":59984,"_5":25503,"_17548":102776,"_23820":102777,"_2384":102778},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2857":59990,"_25170":59984,"_5":25503,"_17548":102780,"_23820":102781,"_2384":102782},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2857":59991,"_25170":59984,"_5":25503,"_17548":102784,"_23820":102785,"_2384":102786},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2857":59992,"_25170":59984,"_5":25503,"_17548":102788,"_23820":102789,"_2384":102790},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2857":59993,"_25170":59984,"_5":25503,"_17548":102792,"_23820":102793,"_2384":100554},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2857":59994,"_25170":59984,"_5":25503,"_17548":102795,"_23820":102796,"_2384":96005},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2857":59995,"_25170":59984,"_17548":102798,"_5":17443,"_23820":59984,"_2384":102799},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2857":59996,"_25170":59984,"_17548":102801,"_5":17443,"_23820":102766,"_2384":102802},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2857":59997,"_25170":59984,"_17548":102804,"_5":17443,"_23820":102766,"_2384":102805},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2857":59998,"_25170":59984,"_17548":102807,"_5":17443,"_23820":102766,"_2384":102808},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2857":59999,"_25170":59984,"_17548":102810,"_5":17443,"_23820":102766,"_2384":102811},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2857":60000,"_25170":59984,"_17548":102813,"_5":17443,"_23820":102769,"_2384":102814},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2857":60001,"_25170":59984,"_17548":102816,"_5":17443,"_23820":102769,"_2384":102817},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2857":60002,"_25170":59984,"_17548":102819,"_5":17443,"_23820":102773,"_2384":102820},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2857":60003,"_25170":59984,"_17548":102822,"_5":17443,"_23820":102773,"_2384":102823},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2857":60004,"_25170":59984,"_17548":102825,"_5":17443,"_23820":102777,"_2384":102826},[],"Selecciona **Root CA** y completa:",{"_2857":60005,"_25170":59984,"_17548":102828,"_5":17443,"_23820":102777,"_2384":47873},[],{"_2857":60006,"_25170":59984,"_17548":102830,"_5":17443,"_23820":102777,"_2384":102831},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2857":60007,"_25170":59984,"_17548":102833,"_5":17443,"_23820":102777,"_2384":102834},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2857":60008,"_25170":59984,"_17548":102836,"_5":17443,"_23820":102777,"_2384":102837},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2857":60009,"_25170":59984,"_17548":102839,"_5":17443,"_23820":102777,"_2384":102840},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2857":60010,"_25170":59984,"_17548":102842,"_5":17443,"_23820":102781,"_2384":102843},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2857":60011,"_25170":59984,"_17548":102845,"_5":17443,"_23820":102785,"_2384":102846},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2857":60012,"_25170":59984,"_17548":102848,"_5":17443,"_23820":102785,"_2384":102849},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2857":60013,"_25170":59984,"_17548":102851,"_5":17443,"_23820":102789,"_2384":102852},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2857":60014,"_25170":59984,"_17548":102854,"_5":17443,"_23820":102789,"_2384":102855},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2857":60015,"_25170":59984,"_17548":102857,"_5":17443,"_23820":102789,"_2384":102858},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2857":60016,"_25170":59984,"_17548":102860,"_5":17443,"_23820":102793,"_2384":102861},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2857":60017,"_25170":59984,"_17548":102863,"_5":17443,"_23820":102793,"_2384":102864},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2857":60018,"_25170":59984,"_17548":102866,"_5":17443,"_23820":102793,"_2384":102867},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2857":60019,"_25170":59984,"_17548":102869,"_5":17443,"_23820":102793,"_2384":102870},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2857":60020,"_25170":59984,"_17548":102872,"_5":17443,"_23820":102796,"_2384":102873},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2857":60021,"_25170":60021,"_5":12294,"_2384":102875,"_25506":102876,"_17548":102877,"_23820":60021},"Emite y verifica un certificado",[40849,97280,45874,100306],[],{"_2857":60022,"_25170":60021,"_17548":102879,"_5":17443,"_23820":60021,"_2384":102880},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2857":60023,"_25170":60021,"_5":25503,"_17548":102882,"_23820":102883,"_2384":95981},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2857":60024,"_25170":60021,"_5":25503,"_17548":102885,"_23820":102886,"_2384":102887},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2857":60025,"_25170":60021,"_5":25503,"_17548":102889,"_23820":102890,"_2384":102891},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2857":60026,"_25170":60021,"_5":25503,"_17548":102893,"_23820":102894,"_2384":102895},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2857":60027,"_25170":60021,"_5":25503,"_17548":102897,"_23820":102898,"_2384":102899},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2857":60028,"_25170":60021,"_5":25503,"_17548":102901,"_23820":102902,"_2384":102903},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2857":60029,"_25170":60021,"_5":25503,"_17548":102905,"_23820":102906,"_2384":102786},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2857":60030,"_25170":60021,"_5":25503,"_17548":102908,"_23820":102909,"_2384":102910},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2857":60031,"_25170":60021,"_5":25503,"_17548":102912,"_23820":102913,"_2384":102914},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2857":60032,"_25170":60021,"_5":25503,"_17548":102916,"_23820":102917,"_2384":102918},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2857":60033,"_25170":60021,"_5":25503,"_17548":102920,"_23820":102921,"_2384":100554},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2857":60034,"_25170":60021,"_5":25503,"_17548":102923,"_23820":102924,"_2384":96005},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2857":60035,"_25170":60021,"_17548":102926,"_5":17443,"_23820":60021,"_2384":102927},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2857":60036,"_25170":60021,"_17548":102929,"_5":17443,"_23820":102883,"_2384":102930},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2857":60037,"_25170":60021,"_17548":102932,"_5":17443,"_23820":102883,"_2384":102933},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2857":60038,"_25170":60021,"_17548":102935,"_5":17443,"_23820":102883,"_2384":102936},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2857":60039,"_25170":60021,"_17548":102938,"_5":17443,"_23820":102883,"_2384":102939},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2857":60040,"_25170":60021,"_17548":102941,"_5":17443,"_23820":102883,"_2384":102942},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2857":60041,"_25170":60021,"_17548":102944,"_5":17443,"_23820":102886,"_2384":102945},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2857":60042,"_25170":60021,"_17548":102947,"_5":17443,"_23820":102890,"_2384":102948},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2857":60043,"_25170":60021,"_17548":102950,"_5":17443,"_23820":102890,"_2384":102951},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2857":60044,"_25170":60021,"_17548":102953,"_5":17443,"_23820":102894,"_2384":102954},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2857":60045,"_25170":60021,"_17548":102956,"_5":17443,"_23820":102894,"_2384":102957},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2857":60046,"_25170":60021,"_17548":102959,"_5":17443,"_23820":102898,"_2384":102960},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2857":60047,"_25170":60021,"_17548":102962,"_5":17443,"_23820":102898,"_2384":102963},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2857":60048,"_25170":60021,"_17548":102965,"_5":17443,"_23820":102902,"_2384":102966},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2857":60049,"_25170":60021,"_17548":102968,"_5":17443,"_23820":102906,"_2384":102969},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2857":60050,"_25170":60021,"_17548":102971,"_5":17443,"_23820":102909,"_2384":102972},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2857":60051,"_25170":60021,"_17548":102974,"_5":17443,"_23820":102913,"_2384":102975},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2857":60052,"_25170":60021,"_17548":102977,"_5":17443,"_23820":102913,"_2384":102978},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2857":60053,"_25170":60021,"_17548":102980,"_5":17443,"_23820":102913,"_2384":102981},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2857":60054,"_25170":60021,"_17548":102983,"_5":17443,"_23820":102917,"_2384":102984},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2857":60055,"_25170":60021,"_17548":102986,"_5":17443,"_23820":102917,"_2384":102987},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2857":60056,"_25170":60021,"_17548":102989,"_5":17443,"_23820":102917,"_2384":102990},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2857":60057,"_25170":60021,"_17548":102992,"_5":17443,"_23820":102921,"_2384":100637},[],{"_2857":60058,"_25170":60021,"_17548":102994,"_5":17443,"_23820":102921,"_2384":99414},[],{"_2857":60059,"_25170":60021,"_17548":102996,"_5":17443,"_23820":102921,"_2384":102997},[],"La CA rechaza la emisión",{"_2857":60060,"_25170":60021,"_17548":102999,"_5":17443,"_23820":102921,"_2384":103000},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2857":60061,"_25170":60021,"_17548":103002,"_5":17443,"_23820":102921,"_2384":103003},[],"Sujeto o usos diferentes",{"_2857":60062,"_25170":60021,"_17548":103005,"_5":17443,"_23820":102921,"_2384":103006},[],"Perfil aplicado y valores solicitados.",{"_2857":60063,"_25170":60021,"_17548":103008,"_5":17443,"_23820":102921,"_2384":103009},[],"No se encuentra el emisor",{"_2857":60064,"_25170":60021,"_17548":103011,"_5":17443,"_23820":102921,"_2384":103012},[],"CA descargada y cadena intermedia necesaria.",{"_2857":60065,"_25170":60021,"_17548":103014,"_5":17443,"_23820":102921,"_2384":103015},[],"Falla la vigencia",{"_2857":60066,"_25170":60021,"_17548":103017,"_5":17443,"_23820":102921,"_2384":103018},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2857":60067,"_25170":60021,"_17548":103020,"_5":17443,"_23820":102921,"_2384":103021},[],"Los resúmenes de clave difieren",{"_2857":60068,"_25170":60021,"_17548":103023,"_5":17443,"_23820":102921,"_2384":103024},[],"Archivos de certificado y clave de la misma emisión.",{"_2857":60069,"_25170":60021,"_17548":103026,"_5":17443,"_23820":102921,"_2384":103027},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2857":60070,"_25170":60021,"_17548":103029,"_5":17443,"_23820":102924,"_2384":103030},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2857":60071,"_25170":60021,"_17548":103032,"_5":17443,"_23820":102924,"_2384":103033},[],"Gestionar certificados para inspección, estado y revocación.",{"_2857":60072,"_25170":60021,"_17548":103035,"_5":17443,"_23820":102924,"_2384":103036},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2857":60073,"_25170":60021,"_17548":103038,"_5":17443,"_23820":102924,"_2384":103039},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2857":60074,"_25170":60021,"_17548":103041,"_5":17443,"_23820":102924,"_2384":103042},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2857":60075,"_25170":60075,"_5":12294,"_2384":103044,"_25506":103045,"_17548":103046,"_23820":60075},"Primeros pasos de PKI",[40849,97280,45874,100306],[],{"_2857":60076,"_25170":60075,"_17548":103048,"_5":17443,"_23820":60075,"_2384":103049},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2857":60077,"_25170":60075,"_5":25503,"_17548":103051,"_23820":103052,"_2384":95981},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2857":60078,"_25170":60075,"_5":25503,"_17548":103054,"_23820":103055,"_2384":103056},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2857":60079,"_25170":60075,"_5":25503,"_17548":103058,"_23820":103059,"_2384":100488},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2857":60080,"_25170":60075,"_5":25503,"_17548":103061,"_23820":103062,"_2384":103063},[],"/docs/pr-preview/pr-38/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2857":60081,"_25170":60075,"_17548":103065,"_5":17443,"_23820":60075,"_2384":103066},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2857":60082,"_25170":60075,"_17548":103068,"_5":17443,"_23820":103052,"_2384":103069},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2857":60083,"_25170":60075,"_17548":103071,"_5":17443,"_23820":103052,"_2384":103072},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2857":60084,"_25170":60075,"_17548":103074,"_5":17443,"_23820":103052,"_2384":103075},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2857":60085,"_25170":60075,"_17548":103077,"_5":17443,"_23820":103052,"_2384":103078},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2857":60086,"_25170":60075,"_17548":103080,"_5":17443,"_23820":103052,"_2384":103081},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2857":60087,"_25170":60075,"_17548":103083,"_5":17443,"_23820":103055,"_2384":103084},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2857":60088,"_25170":60075,"_17548":103086,"_5":17443,"_23820":103055,"_2384":103087},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2857":60089,"_25170":60075,"_17548":103089,"_5":17443,"_23820":103055,"_2384":103090},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2857":60090,"_25170":60075,"_17548":103092,"_5":17443,"_23820":103055,"_2384":103093},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2857":60091,"_25170":60075,"_17548":103095,"_5":17443,"_23820":103059,"_2384":103096},[],"Archivo o recurso",{"_2857":60092,"_25170":60075,"_17548":103098,"_5":17443,"_23820":103059,"_2384":100485},[],{"_2857":60093,"_25170":60075,"_17548":103100,"_5":17443,"_23820":103059,"_2384":103101},[],"CA raíz activa y `ca.pem`",{"_2857":60094,"_25170":60075,"_17548":103103,"_5":17443,"_23820":103059,"_2384":103104},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2857":60095,"_25170":60075,"_17548":103106,"_5":17443,"_23820":103059,"_2384":103107},[],"Certificado final y `device.crt`",{"_2857":60096,"_25170":60075,"_17548":103109,"_5":17443,"_23820":103059,"_2384":103110},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2857":60097,"_25170":60075,"_17548":103112,"_5":17443,"_23820":103059,"_2384":103113},[],"Clave privada `device.key`",{"_2857":60098,"_25170":60075,"_17548":103115,"_5":17443,"_23820":103059,"_2384":103116},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2857":60099,"_25170":60075,"_17548":103118,"_5":17443,"_23820":103059,"_2384":103119},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2857":60100,"_25170":60075,"_17548":103121,"_5":17443,"_23820":103062,"_2384":103122},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2857":60101,"_25170":60075,"_17548":103124,"_5":17443,"_23820":103062,"_2384":103125},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2857":60102,"_25170":60075,"_17548":103127,"_5":17443,"_23820":103062,"_2384":103128},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2857":60103,"_25170":60103,"_5":12294,"_2384":103130,"_25506":103131,"_17548":103133,"_23820":60103},"Resolución de problemas PKI",[40849,97280,45874,103132],"Resolución de problemas",[],{"_2857":60104,"_25170":60103,"_17548":103135,"_5":17443,"_23820":60103,"_2384":103136},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2857":60105,"_25170":60103,"_5":25503,"_17548":103138,"_23820":103139,"_2384":103140},[],"/docs/pr-preview/pr-38/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2857":60106,"_25170":60103,"_5":25503,"_17548":103142,"_23820":103143,"_2384":103144},[],"/docs/pr-preview/pr-38/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2857":60107,"_25170":60103,"_5":25503,"_17548":103146,"_23820":103147,"_2384":103148},[],"/docs/pr-preview/pr-38/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2857":60108,"_25170":60103,"_17548":103150,"_5":17443,"_23820":60103,"_2384":103151},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2857":60109,"_25170":60103,"_17548":103153,"_5":17443,"_23820":60103,"_2384":103154},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2857":60110,"_25170":60103,"_17548":103156,"_5":17443,"_23820":103139,"_2384":100485},[],{"_2857":60111,"_25170":60103,"_17548":103158,"_5":17443,"_23820":103139,"_2384":99414},[],{"_2857":60112,"_25170":60103,"_17548":103160,"_5":17443,"_23820":103139,"_2384":96005},[],{"_2857":60113,"_25170":60103,"_17548":103162,"_5":17443,"_23820":103139,"_2384":48209},[],{"_2857":60114,"_25170":60103,"_17548":103164,"_5":17443,"_23820":103139,"_2384":103165},[],"Existe, está activa y sus fechas son utilizables.",{"_2857":60115,"_25170":60103,"_17548":103167,"_5":17443,"_23820":103139,"_2384":103168},[],"Autoridades.",{"_2857":60116,"_25170":60103,"_17548":103170,"_5":17443,"_23820":103139,"_2384":103171},[],"Clave",{"_2857":60117,"_25170":60103,"_17548":103173,"_5":17443,"_23820":103139,"_2384":103174},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2857":60118,"_25170":60103,"_17548":103176,"_5":17443,"_23820":103139,"_2384":103177},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2857":60119,"_25170":60103,"_17548":103179,"_5":17443,"_23820":103139,"_2384":48227},[],{"_2857":60120,"_25170":60103,"_17548":103181,"_5":17443,"_23820":103139,"_2384":103182},[],"PEM correcto y firma verificable.",{"_2857":60121,"_25170":60103,"_17548":103184,"_5":17443,"_23820":103139,"_2384":48233},[],{"_2857":60122,"_25170":60103,"_17548":103186,"_5":17443,"_23820":103139,"_2384":103187},[],"Perfil",{"_2857":60123,"_25170":60103,"_17548":103189,"_5":17443,"_23820":103139,"_2384":103190},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2857":60124,"_25170":60103,"_17548":103192,"_5":17443,"_23820":103139,"_2384":103193},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2857":60125,"_25170":60103,"_17548":103195,"_5":17443,"_23820":103139,"_2384":100637},[],{"_2857":60126,"_25170":60103,"_17548":103197,"_5":17443,"_23820":103139,"_2384":103198},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2857":60127,"_25170":60103,"_17548":103200,"_5":17443,"_23820":103139,"_2384":103201},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2857":60128,"_25170":60103,"_17548":103203,"_5":17443,"_23820":103139,"_2384":103204},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2857":60129,"_25170":60103,"_17548":103206,"_5":17443,"_23820":103139,"_2384":103207},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2857":60130,"_25170":60103,"_17548":103209,"_5":17443,"_23820":103143,"_2384":103210},[],"Revisa cada frontera por separado:",{"_2857":60131,"_25170":60103,"_17548":103212,"_5":17443,"_23820":103143,"_2384":103213},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2857":60132,"_25170":60103,"_17548":103215,"_5":17443,"_23820":103143,"_2384":103216},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2857":60133,"_25170":60103,"_17548":103218,"_5":17443,"_23820":103143,"_2384":103219},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2857":60134,"_25170":60103,"_17548":103221,"_5":17443,"_23820":103143,"_2384":103222},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2857":60135,"_25170":60103,"_17548":103224,"_5":17443,"_23820":103143,"_2384":103225},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2857":60136,"_25170":60103,"_17548":103227,"_5":17443,"_23820":103143,"_2384":103228},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2857":60137,"_25170":60103,"_17548":103230,"_5":17443,"_23820":103147,"_2384":103231},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2857":60138,"_25170":60103,"_17548":103233,"_5":17443,"_23820":103147,"_2384":103234},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_48287":103236,"_48289":103237,"_48291":103238,"_48293":103239,"_15231":2406,"_57768":2406},"spanish",[2384,25170,5,23820],{"_2384":20963,"_25170":20963,"_5":20963,"_23820":20963},{"_2384":103240,"_25170":105607,"_5":107974,"_23820":110341},{"_3828":103241,"_48297":103242,"_5":20963},{"_12039":5299,"_12382":4986,"_12389":16902,"_24371":3938,"_23933":6040,"_16648":3230,"_12060":19154,"_12067":3916,"_24333":4929,"_24683":10125,"_24704":6289,"_24346":6169,"_28968":9213,"_24715":6906,"_28973":5145,"_28976":2543,"_28979":3367,"_28982":5743,"_28985":3097,"_25016":3807,"_28990":7252,"_28992":3428,"_25076":5989,"_25006":3349,"_28996":13120,"_25032":8508,"_29000":5269,"_24733":2462,"_25011":4155,"_25094":16838,"_29005":17937,"_29007":6258,"_29009":11898,"_29011":9212,"_29013":2694,"_29015":3294,"_29017":9786,"_25228":17938,"_29020":9498,"_24384":3832,"_29023":6254,"_29025":5719,"_24378":2578,"_29028":5674,"_29030":6199,"_29032":6201,"_29035":5082,"_24414":3347,"_29039":9216,"_24324":2619,"_29042":4824,"_24351":4378,"_29045":4103,"_29047":2739,"_29050":5393,"_25071":14011,"_29053":13097,"_29055":4933,"_29058":3357,"_29060":3300,"_29062":10175,"_29064":4931,"_29066":5062,"_16651":2692,"_29069":9496,"_29071":6203,"_29073":6293,"_24727":4232,"_29076":3800,"_29078":2545,"_29080":2454,"_29082":20244,"_29084":2643,"_29086":4861,"_29088":2622,"_25156":16032,"_24754":3000,"_29092":5681,"_29094":7081,"_24362":2768,"_29097":5893,"_29099"