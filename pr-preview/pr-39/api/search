ment."},"1600":{"id":"/docs/pr-preview/pr-39/platform/overview-38","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#issue-and-control-certificates","content":"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it."},"1601":{"id":"/docs/pr-preview/pr-39/platform/overview-39","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#automate-device-identities","content":"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration."},"1602":{"id":"/docs/pr-preview/pr-39/platform/overview-40","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#publish-validation-status","content":"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information."},"1603":{"id":"/docs/pr-preview/pr-39/platform/overview-41","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#react-to-events","content":"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events."},"1604":{"id":"/docs/pr-preview/pr-39/platform/overview-42","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#operational-reference","content":"Responsibility"},"1605":{"id":"/docs/pr-preview/pr-39/platform/overview-43","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#operational-reference","content":"What it prepares or checks"},"1606":{"id":"/docs/pr-preview/pr-39/platform/overview-44","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#operational-reference","content":"PKI administrator"},"1607":{"id":"/docs/pr-preview/pr-39/platform/overview-45","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#operational-reference","content":"Key custody, CA hierarchy, profiles and validation."},"1608":{"id":"/docs/pr-preview/pr-39/platform/overview-46","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#operational-reference","content":"Fleet administrator"},"1609":{"id":"/docs/pr-preview/pr-39/platform/overview-47","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#operational-reference","content":"DMS, device admission, renewal policy and inventory."},"1610":{"id":"/docs/pr-preview/pr-39/platform/overview-48","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#operational-reference","content":"Device integrator"},"1611":{"id":"/docs/pr-preview/pr-39/platform/overview-49","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#operational-reference","content":"Initial credential, server trust, EST client, and key and certificate storage."},"1612":{"id":"/docs/pr-preview/pr-39/platform/overview-50","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#operational-reference","content":"Consumer integrator"},"1613":{"id":"/docs/pr-preview/pr-39/platform/overview-51","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#operational-reference","content":"Issuer trust, certificate validation and permissions in the destination."},"1614":{"id":"/docs/pr-preview/pr-39/platform/overview-52","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#operational-reference","content":"Infrastructure operator"},"1615":{"id":"/docs/pr-preview/pr-39/platform/overview-53","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#operational-reference","content":"Installation, network, availability, dependencies and deployment diagnosis."},"1616":{"id":"/docs/pr-preview/pr-39/platform/overview-54","page_id":"/docs/pr-preview/pr-39/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/overview#operational-reference","content":"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment."},"1617":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","type":"page","content":"CA hierarchy and rotation","breadcrumbs":["Docs","Platform","PKI","Keys, authorities and certificates"],"tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation"},"1618":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-0","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","content":"Design root and intermediate authorities and replace certificates or keys without breaking trust."},"1619":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-1","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"Design the hierarchy"},"1620":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-2","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"Reissuance and rotation are not the same"},"1621":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-3","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"When to choose each operation"},"1622":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-4","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","content":"Key rotation procedure"},"1623":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-5","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","content":"Inventory the dependencies"},"1624":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-6","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","content":"Create the successor CA"},"1625":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-7","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","content":"Distribute the new trust"},"1626":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-8","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#switch-issuance","content":"Switch issuance"},"1627":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-9","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","content":"Renew in batches"},"1628":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-10","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","content":"Close the overlap"},"1629":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-11","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Cascading revocation"},"1630":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-12","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"Checks after the change"},"1631":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-13","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","content":"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust."},"1632":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-14","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","content":"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap."},"1633":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-15","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:"},"1634":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-16","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"environment, such as production and preproduction;"},"1635":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-17","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"owner or operating team;"},"1636":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-18","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"device family or manufacturing process;"},"1637":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-19","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"region or regulatory requirement;"},"1638":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-20","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"cryptographic engine or key policy;"},"1639":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-21","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"maintenance window and renewal cadence."},"1640":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-22","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew."},"1641":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-23","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates."},"1642":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-24","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata."},"1643":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-25","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies."},"1644":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-26","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions."},"1645":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-27","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate."},"1646":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-28","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine."},"1647":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-29","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Create a parallel branch if you cannot update all consumers at the same time."},"1648":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-30","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet."},"1649":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-31","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","content":"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months."},"1650":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-32","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","content":"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation."},"1651":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-33","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","content":"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity."},"1652":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-34","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#switch-issuance","content":"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment."},"1653":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-35","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","content":"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain."},"1654":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-36","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","content":"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it."},"1655":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-37","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed."},"1656":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-38","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes."},"1657":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-39","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch."},"1658":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-40","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows."},"1659":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-41","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"The new chain ends in an anchor installed by the consumer."},"1660":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-42","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"New certificates contain the expected AKI, SKI, KU, EKU and SAN."},"1661":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-43","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"The DMS delivers the correct chain through EST `/cacerts`."},"1662":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-44","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"Re-enrollment accepts the old identity during the planned period."},"1663":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-45","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"OCSP and CRL respond for the authorities that remain active."},"1664":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-46","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"No DMS is left accidentally issuing from the old CA."},"1665":{"id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation-47","page_id":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects."},"1666":{"id":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities","page_id":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities","type":"page","content":"Certification authorities","breadcrumbs":["Docs","Platform","PKI","Keys, authorities and certificates"],"tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities"},"1667":{"id":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities-0","page_id":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities","content":"Create, import and operate the authorities that establish your PKI's trust."},"1668":{"id":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities-1","page_id":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#choose-a-flow","content":"Choose a flow"},"1669":{"id":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities-2","page_id":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#create-a-new-authority","content":"Create a new authority"},"1670":{"id":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities-3","page_id":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#before-you-begin","content":"Before you begin"},"1671":{"id":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities-4","page_id":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#open-the-wizard","conten