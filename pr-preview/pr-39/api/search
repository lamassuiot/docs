ed/helm#1-instala-los-requisitos-del-gateway","content":"1\\. Instala los requisitos del Gateway"},"192":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-4","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","content":"2\\. Crea un archivo de valores"},"193":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-5","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#tls-con-un-secret-existente","content":"TLS con un Secret existente"},"194":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-6","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","content":"Provisiona el primer administrador"},"195":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-7","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#3-instala-lamassu","content":"3\\. Instala Lamassu"},"196":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-8","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#4-verifica-el-despliegue","content":"4\\. Verifica el despliegue"},"197":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-9","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#decisiones-para-producción","content":"Decisiones para producción"},"198":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-10","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#instala-lamassu-con-helm","content":"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane."},"199":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-11","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#antes-de-comenzar","content":"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:"},"200":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-12","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#antes-de-comenzar","content":"un clúster Kubernetes 1.24+ y Helm 3.2+"},"201":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-13","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#antes-de-comenzar","content":"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas"},"202":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-14","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#antes-de-comenzar","content":"un broker RabbitMQ accesible y sus credenciales"},"203":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-15","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#antes-de-comenzar","content":"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu"},"204":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-16","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#antes-de-comenzar","content":"Envoy Gateway 1.8+ y una `GatewayClass`"},"205":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-17","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#antes-de-comenzar","content":"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes"},"206":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-18","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#antes-de-comenzar","content":"una StorageClass y un diseño de tráfico externo"},"207":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-19","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#antes-de-comenzar","content":"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre."},"208":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-20","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#antes-de-comenzar","content":"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`."},"209":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-21","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#antes-de-comenzar","content":"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager."},"210":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-22","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","content":"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:"},"211":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-23","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","content":"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:"},"212":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-24","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","content":"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager."},"213":{"id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm-25","page_id":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","content":"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y