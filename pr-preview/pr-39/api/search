s/pr-preview/pr-39/es/platform/pki/key-management#pkcs11","content":"PKCS#11"},"2029":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-8","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#azure-key-vault","content":"Azure Key Vault"},"2030":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-9","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#inventario-de-claves","content":"Inventario de claves"},"2031":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-10","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#crear-o-importar-claves","content":"Crear o importar claves"},"2032":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-11","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"Generar un nuevo par de claves"},"2033":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-12","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#importar-un-par-existente","content":"Importar un par existente"},"2034":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-13","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#operaciones-sobre-una-clave","content":"Operaciones sobre una clave"},"2035":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-14","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#ver-detalles","content":"Ver detalles"},"2036":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-15","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#firmar-y-verificar","content":"Firmar y verificar"},"2037":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-16","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#sign","content":"Sign"},"2038":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-17","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#verify","content":"Verify"},"2039":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-18","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#generar-un-csr","content":"Generar un CSR"},"2040":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-19","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#firma-local-con-pkcs11","content":"Firma local con PKCS#11"},"2041":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-20","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#antes-de-eliminar-una-clave","content":"Antes de eliminar una clave"},"2042":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-21","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management","content":"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI."},"2043":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-22","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management","content":"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema."},"2044":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-23","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#qué-resuelve-el-kms","content":"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto."},"2045":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-24","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#qué-resuelve-el-kms","content":"En la práctica, permite:"},"2046":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-25","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Generar nuevos pares de claves desde Lamassu IoT."},"2047":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-26","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Importar claves creadas externamente."},"2048":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-27","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Delegar la custodia y las operaciones criptográficas en motores externos."},"2049":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-28","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación."},"2050":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-29","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#motores-criptográficos","content":"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada."},"2051":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-30","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#motores-criptográficos","content":"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios."},"2052":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-31","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#motores-criptográficos","content":"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración."},"2053":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-32","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#file-system","content":"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos."},"2054":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-33","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#hashicorp-vault","content":"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue."},"2055":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-34","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#aws-secrets-manager","content":"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM."},"2056":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-35","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#aws-kms","content":"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas."},"2057":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-36","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#pkcs11","content":"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware."},"2058":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-37","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#azure-key-vault","content":"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias."},"2059":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-38","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#azure-key-vault","content":"Lamassu muestra en la consola el listado de motores habilitados."},"2060":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-39","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#azure-key-vault","content":"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar."},"2061":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-40","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#azure-key-vault","content":"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA."},"2062":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-41","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#inventario-de-claves","content":"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas."},"2063":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-42","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#inventario-de-claves","content":"La tabla incluye los siguientes campos:"},"2064":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-43","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#inventario-de-claves","content":"**Name**: nombre descriptivo de la clave."},"2065":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-44","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#inventario-de-claves","content":"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256."},"2066":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-45","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#inventario-de-claves","content":"**Strength**: indicador visual de fortaleza criptográfica."},"2067":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-46","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#inventario-de-claves","content":"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública."},"2068":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-47","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#inventario-de-claves","content":"**Crypto Engine**: motor criptográfico que custodia la clave."},"2069":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-48","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#inventario-de-claves","content":"**Aliases**: nombres alternativos asociados a la clave."},"2070":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-49","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#inventario-de-claves","content":"**Tags**: etiquetas para clasificación y búsqueda."},"2071":{"id":"/docs/pr-preview/pr-39/es/platform/pki/key-management-50","page_id":"/docs/pr-preview/pr-39/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/es/platform/pki/key-management#inventario-de-claves",