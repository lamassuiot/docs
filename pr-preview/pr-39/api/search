/pr-39/deployment/self-hosted/fastlane#what-the-script-configures","content":"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`"},"173":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane-95","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#what-the-script-configures","content":"creates the namespace"},"174":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane-96","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#what-the-script-configures","content":"installs PostgreSQL and creates the required databases"},"175":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane-97","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#what-the-script-configures","content":"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user"},"176":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane-98","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#what-the-script-configures","content":"installs RabbitMQ"},"177":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane-99","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#what-the-script-configures","content":"optionally installs observability and lab HSM components"},"178":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane-100","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#what-the-script-configures","content":"generates `lamassu.yaml` and installs the Lamassu chart"},"179":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane-101","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#what-the-script-configures","content":"optionally loads sample data"},"180":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane-102","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#what-the-script-configures","content":"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator."},"181":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane-103","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#tls-behavior","content":"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`."},"182":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane-104","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#tls-behavior","content":"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system."},"183":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane-105","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#credentials-and-generated-files","content":"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use."},"184":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane-106","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#credentials-and-generated-files","content":"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it."},"185":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane-107","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#credentials-and-generated-files","content":"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production."},"186":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane-108","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#verify-the-installation","content":"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway."},"187":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/helm","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/helm","type":"page","content":"Install with Helm","breadcrumbs":["Docs","Deployment","Kubernetes self-managed"],"tags":[],"url":"/docs/pr-preview/pr-39/deployment/self-hosted/helm"},"188":{"id":"/docs/pr-preview/pr-39/deployment/self-hosted/helm-0","page_id":"/docs/pr-preview/pr-39/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/deployment/self-hosted/helm","content":"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment."}