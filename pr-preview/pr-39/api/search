t-fleets/quickstarts/enroll-device-48","page_id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","content":"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:"},"1485":{"id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device-49","page_id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","content":"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue."},"1486":{"id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device-50","page_id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","content":"Generate a new key and CSR with the selected identifier:"},"1487":{"id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device-51","page_id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","content":"Request the identity with the bootstrap credential and extract the certificate from the default response:"},"1488":{"id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device-52","page_id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","content":"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance."},"1489":{"id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device-53","page_id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","content":"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile."},"1490":{"id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device-54","page_id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","content":"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active."},"1491":{"id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device-55","page_id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","content":"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:"},"1492":{"id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device-56","page_id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","content":"Leave it running. In the first terminal, connect using the obtained identity:"},"1493":{"id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device-57","page_id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","content":"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information."},"1494":{"id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device-58","page_id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","content":"With the same server still running, test that a request without a client certificate is rejected:"},"1495":{"id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device-59","page_id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","content":"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server."},"1496":{"id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device-60","page_id":"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-39/platform/iot-fleets/