272,"_37109":114275,"_37111":114278,"_37113":114281,"_37115":114284,"_37117":114287,"_37119":114290,"_37121":114293,"_37123":114296,"_37125":114299,"_37127":114302,"_37129":114305,"_37131":114308,"_37133":114311,"_37135":114314,"_37138":114317,"_37140":114320,"_37142":114323,"_37145":114326,"_37147":114329,"_37149":114332,"_37151":114335,"_37153":114338,"_37155":114341,"_37157":114344,"_37159":114347,"_37161":114350,"_37163":114353,"_37165":114356,"_37167":114359,"_37169":114362,"_37171":114365,"_37173":114368,"_37175":114371,"_37177":114374,"_37180":114377,"_37182":114380,"_37184":114383,"_37186":114386,"_37188":114389,"_37190":114392,"_37192":114395,"_37194":114398,"_37196":114401,"_37198":114404,"_37200":114407,"_37202":114410,"_37204":114413,"_37206":114416,"_37208":114419,"_37210":114422,"_37212":114425,"_37214":114428,"_37216":114431,"_37218":114434,"_37220":114437,"_37223":114440,"_37225":114443,"_37227":114446},{"_3162":64107,"_27851":64107,"_5":13585,"_2660":106346,"_28194":106347,"_19309":106350,"_25377":64107},"Despliega desde AWS Marketplace",[45228,106348,106349],"Despliegue","Otros modelos",[],{"_3162":64108,"_27851":64107,"_19309":106352,"_5":13254,"_25377":64107,"_2660":106353},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3162":64109,"_27851":64107,"_5":28191,"_19309":106355,"_25377":106356,"_2660":106357},[],"/docs/pr-preview/pr-39/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3162":64110,"_27851":64107,"_5":28191,"_19309":106359,"_25377":106360,"_2660":106361},[],"/docs/pr-preview/pr-39/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3162":64111,"_27851":64107,"_5":28191,"_19309":106363,"_25377":106364,"_2660":106365},[],"/docs/pr-preview/pr-39/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3162":64112,"_27851":64107,"_5":28191,"_19309":106367,"_25377":106368,"_2660":106369},[],"/docs/pr-preview/pr-39/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3162":64113,"_27851":64107,"_5":28191,"_19309":106371,"_25377":106372,"_2660":106373},[],"/docs/pr-preview/pr-39/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3162":64114,"_27851":64107,"_5":28191,"_19309":106375,"_25377":106376,"_2660":106377},[],"/docs/pr-preview/pr-39/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3162":64115,"_27851":64107,"_5":28191,"_19309":106379,"_25377":106380,"_2660":106381},[],"/docs/pr-preview/pr-39/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3162":64116,"_27851":64107,"_19309":106383,"_5":13254,"_25377":64107,"_2660":106384},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3162":64117,"_27851":64107,"_19309":106386,"_5":13254,"_25377":106356,"_2660":106387},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3162":64118,"_27851":64107,"_19309":106389,"_5":13254,"_25377":106356,"_2660":106390},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3162":64119,"_27851":64107,"_19309":106392,"_5":13254,"_25377":106356,"_2660":106393},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3162":64120,"_27851":64107,"_19309":106395,"_5":13254,"_25377":106360,"_2660":106396},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3162":64121,"_27851":64107,"_19309":106398,"_5":13254,"_25377":106360,"_2660":106399},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3162":64122,"_27851":64107,"_19309":106401,"_5":13254,"_25377":106360,"_2660":106402},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3162":64123,"_27851":64107,"_19309":106404,"_5":13254,"_25377":106364,"_2660":106405},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3162":64124,"_27851":64107,"_19309":106407,"_5":13254,"_25377":106368,"_2660":106408},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3162":64125,"_27851":64107,"_19309":106410,"_5":13254,"_25377":106372,"_2660":106411},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3162":64126,"_27851":64107,"_19309":106413,"_5":13254,"_25377":106376,"_2660":106414},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3162":64127,"_27851":64107,"_19309":106416,"_5":13254,"_25377":106380,"_2660":106417},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3162":64128,"_27851":64128,"_5":13585,"_2660":106419,"_28194":106420,"_19309":106421,"_25377":64128},"Despliega Lamassu",[45228,106348],[],{"_3162":64129,"_27851":64128,"_19309":106423,"_5":13254,"_25377":64128,"_2660":106424},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3162":64130,"_27851":64128,"_5":28191,"_19309":106426,"_25377":106427,"_2660":106428},[],"/docs/pr-preview/pr-39/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3162":64131,"_27851":64128,"_5":28191,"_19309":106430,"_25377":106431,"_2660":106432},[],"/docs/pr-preview/pr-39/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3162":64132,"_27851":64128,"_5":28191,"_19309":106434,"_25377":106435,"_2660":106436},[],"/docs/pr-preview/pr-39/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3162":64133,"_27851":64128,"_19309":106438,"_5":13254,"_25377":64128,"_2660":106439},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3162":64134,"_27851":64128,"_19309":106441,"_5":13254,"_25377":106427,"_2660":106442},[],"Modelo",{"_3162":64135,"_27851":64128,"_19309":106444,"_5":13254,"_25377":106427,"_2660":106445},[],"Recomendado para",{"_3162":64136,"_27851":64128,"_19309":106447,"_5":13254,"_25377":106427,"_2660":106448},[],"Quién opera la infraestructura",{"_3162":64137,"_27851":64128,"_19309":106450,"_5":13254,"_25377":106427,"_2660":106451},[],"Punto de partida",{"_3162":64138,"_27851":64128,"_19309":106453,"_5":13254,"_25377":106427,"_2660":45335},[],{"_3162":64139,"_27851":64128,"_19309":106455,"_5":13254,"_25377":106427,"_2660":106456},[],"Producción, entornos regulados y despliegues personalizados",{"_3162":64140,"_27851":64128,"_19309":106458,"_5":13254,"_25377":106427,"_2660":106459},[],"Tu equipo",{"_3162":64141,"_27851":64128,"_19309":106461,"_5":13254,"_25377":106427,"_2660":106462},[],"Helm o Fastlane",{"_3162":64142,"_27851":64128,"_19309":106464,"_5":13254,"_25377":106427,"_2660":45347},[],{"_3162":64143,"_27851":64128,"_19309":106466,"_5":13254,"_25377":106427,"_2660":106467},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3162":64144,"_27851":64128,"_19309":106469,"_5":13254,"_25377":106427,"_2660":106459},[],{"_3162":64145,"_27851":64128,"_19309":106471,"_5":13254,"_25377":106427,"_2660":106472},[],"Imagen preconfigurada en EC2",{"_3162":64146,"_27851":64128,"_19309":106474,"_5":13254,"_25377":106427,"_2660":45358},[],{"_3162":64147,"_27851":64128,"_19309":106476,"_5":13254,"_25377":106427,"_2660":106477},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3162":64148,"_27851":64128,"_19309":106479,"_5":13254,"_25377":106427,"_2660":45364},[],{"_3162":64149,"_27851":64128,"_19309":106481,"_5":13254,"_25377":106427,"_2660":106482},[],"Suscripción gestionada",{"_3162":64150,"_27851":64128,"_19309":106484,"_5":13254,"_25377":106427,"_2660":106485},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3162":64151,"_27851":64128,"_19309":106487,"_5":13254,"_25377":106427,"_2660":106488},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3162":64152,"_27851":64128,"_19309":106490,"_5":13254,"_25377":106427,"_2660":106491},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3162":64153,"_27851":64128,"_19309":106493,"_5":13254,"_25377":106431,"_2660":106494},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3162":64154,"_27851":64128,"_19309":106496,"_5":13254,"_25377":106435,"_2660":106497},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3162":64155,"_27851":64155,"_5":13585,"_2660":106499,"_28194":106500,"_19309":106501,"_25377":64155},"Utiliza Lamassu como SaaS",[45228,106348,106349],[],{"_3162":64156,"_27851":64155,"_19309":106503,"_5":13254,"_25377":64155,"_2660":106504},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3162":64157,"_27851":64155,"_5":28191,"_19309":106506,"_25377":106507,"_2660":106508},[],"/docs/pr-preview/pr-39/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3162":64158,"_27851":64155,"_5":28191,"_19309":106510,"_25377":106511,"_2660":106512},[],"/docs/pr-preview/pr-39/es/deployment/saas#planes","Planes",{"_3162":64159,"_27851":64155,"_5":28191,"_19309":106514,"_25377":106515,"_2660":106516},[],"/docs/pr-preview/pr-39/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3162":64160,"_27851":64155,"_19309":106518,"_5":13254,"_25377":64155,"_2660":106519},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3162":64161,"_27851":64155,"_19309":106521,"_5":13254,"_25377":106507,"_2660":106522},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3162":64162,"_27851":64155,"_19309":106524,"_5":13254,"_25377":106507,"_2660":106525},[],"Copias de seguridad automáticas.",{"_3162":64163,"_27851":64155,"_19309":106527,"_5":13254,"_25377":106507,"_2660":106528},[],"Actualizaciones de versión.",{"_3162":64164,"_27851":64155,"_19309":106530,"_5":13254,"_25377":106507,"_2660":106531},[],"Soporte técnico y SLA según el plan contratado.",{"_3162":64165,"_27851":64155,"_19309":106533,"_5":13254,"_25377":106511,"_2660":45419},[],{"_3162":64166,"_27851":64155,"_19309":106535,"_5":13254,"_25377":106511,"_2660":106536},[],"Dispositivos",{"_3162":64167,"_27851":64155,"_19309":106538,"_5":13254,"_25377":106511,"_2660":106539},[],"Soporte",{"_3162":64168,"_27851":64155,"_19309":106541,"_5":13254,"_25377":106511,"_2660":45428},[],{"_3162":64169,"_27851":64155,"_19309":106543,"_5":13254,"_25377":106511,"_2660":45431},[],{"_3162":64170,"_27851":64155,"_19309":106545,"_5":13254,"_25377":106511,"_2660":106546},[],"Hasta 1.000",{"_3162":64171,"_27851":64155,"_19309":106548,"_5":13254,"_25377":106511,"_2660":45437},[],{"_3162":64172,"_27851":64155,"_19309":106550,"_5":13254,"_25377":106511,"_2660":106551},[],"99,5 %",{"_3162":64173,"_27851":64155,"_19309":106553,"_5":13254,"_25377":106511,"_2660":45443},[],{"_3162":64174,"_27851":64155,"_19309":106555,"_5":13254,"_25377":106511,"_2660":106556},[],"Hasta 10.000",{"_3162":64175,"_27851":64155,"_19309":106558,"_5":13254,"_25377":106511,"_2660":106559},[],"Email y chat",{"_3162":64176,"_27851":64155,"_19309":106561,"_5":13254,"_25377":106511,"_2660":106562},[],"99,9 %",{"_3162":64177,"_27851":64155,"_19309":106564,"_5":13254,"_25377":106511,"_2660":45455},[],{"_3162":64178,"_27851":64155,"_19309":106566,"_5":13254,"_25377":106511,"_2660":106567},[],"Ilimitados",{"_3162":64179,"_27851":64155,"_19309":106569,"_5":13254,"_25377":106511,"_2660":106570},[],"Dedicado",{"_3162":64180,"_27851":64155,"_19309":106572,"_5":13254,"_25377":106511,"_2660":106573},[],"99,99 %",{"_3162":64181,"_27851":64155,"_19309":106575,"_5":13254,"_25377":106515,"_2660":106576},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3162":64182,"_27851":64155,"_19309":106578,"_5":13254,"_25377":106515,"_2660":106579},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3162":64183,"_27851":64183,"_5":13585,"_2660":45472,"_28194":106581,"_19309":106583,"_25377":64183},[45228,106348,106582],"Kubernetes autogestionado",[],{"_3162":64184,"_27851":64183,"_19309":106585,"_5":13254,"_25377":64183,"_2660":106586},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3162":64185,"_27851":64183,"_5":28191,"_19309":106588,"_25377":106589,"_2660":106590},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3162":64186,"_27851":64183,"_5":28191,"_19309":106592,"_25377":106593,"_2660":106594},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3162":64187,"_27851":64183,"_5":28191,"_19309":106596,"_25377":106597,"_2660":106598},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3162":64188,"_27851":64183,"_5":28191,"_19309":106600,"_25377":106601,"_2660":106602},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3162":64189,"_27851":64183,"_5":28191,"_19309":106604,"_25377":106605,"_2660":106606},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3162":64190,"_27851":64183,"_5":28191,"_19309":106608,"_25377":106609,"_2660":106610},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3162":64191,"_27851":64183,"_5":28191,"_19309":106612,"_25377":106613,"_2660":106614},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3162":64192,"_27851":64183,"_5":28191,"_19309":106616,"_25377":106617,"_2660":106618},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3162":64193,"_27851":64183,"_5":28191,"_19309":106620,"_25377":106621,"_2660":106622},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3162":64194,"_27851":64183,"_5":28191,"_19309":106624,"_25377":106625,"_2660":106626},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3162":64195,"_27851":64183,"_5":28191,"_19309":106628,"_25377":106629,"_2660":106630},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3162":64196,"_27851":64183,"_19309":106632,"_5":13254,"_25377":106589,"_2660":106633},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3162":64197,"_27851":64183,"_19309":106635,"_5":13254,"_25377":106589,"_2660":106636},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3162":64198,"_27851":64183,"_19309":106638,"_5":13254,"_25377":106593,"_2660":106639},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3162":64199,"_27851":64183,"_19309":106641,"_5":13254,"_25377":106593,"_2660":106642},[],"Fastlane instala o configura",{"_3162":64200,"_27851":64183,"_19309":106644,"_5":13254,"_25377":106593,"_2660":106645},[],"Tú sigues proporcionando",{"_3162":64201,"_27851":64183,"_19309":106647,"_5":13254,"_25377":106593,"_2660":106648},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3162":64202,"_27851":64183,"_19309":106650,"_5":13254,"_25377":106593,"_2660":106651},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3162":64203,"_27851":64183,"_19309":106653,"_5":13254,"_25377":106593,"_2660":106654},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3162":64204,"_27851":64183,"_19309":106656,"_5":13254,"_25377":106593,"_2660":106657},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3162":64205,"_27851":64183,"_19309":106659,"_5":13254,"_25377":106593,"_2660":106660},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3162":64206,"_27851":64183,"_19309":106662,"_5":13254,"_25377":106593,"_2660":106663},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3162":64207,"_27851":64183,"_19309":106665,"_5":13254,"_25377":106593,"_2660":106666},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3162":64208,"_27851":64183,"_19309":106668,"_5":13254,"_25377":106593,"_2660":106669},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3162":64209,"_27851":64183,"_19309":106671,"_5":13254,"_25377":106593,"_2660":106672},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3162":64210,"_27851":64183,"_19309":106674,"_5":13254,"_25377":106597,"_2660":106675},[],"Necesitas:",{"_3162":64211,"_27851":64183,"_19309":106677,"_5":13254,"_25377":106597,"_2660":106678},[],"un clúster Kubernetes existente",{"_3162":64212,"_27851":64183,"_19309":106680,"_5":13254,"_25377":106597,"_2660":106681},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3162":64213,"_27851":64183,"_19309":106683,"_5":13254,"_25377":106597,"_2660":45574},[],{"_3162":64214,"_27851":64183,"_19309":106685,"_5":13254,"_25377":106597,"_2660":21876},[],{"_3162":64215,"_27851":64183,"_19309":106687,"_5":13254,"_25377":106597,"_2660":106688},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3162":64216,"_27851":64183,"_19309":106690,"_5":13254,"_25377":106597,"_2660":106691},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3162":64217,"_27851":64183,"_19309":106693,"_5":13254,"_25377":106597,"_2660":106694},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3162":64218,"_27851":64183,"_19309":106696,"_5":13254,"_25377":106597,"_2660":106697},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3162":64219,"_27851":64183,"_19309":106699,"_5":13254,"_25377":106597,"_2660":106700},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3162":64220,"_27851":64183,"_19309":106702,"_5":13254,"_25377":106601,"_2660":106703},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3162":64221,"_27851":64183,"_19309":106705,"_5":13254,"_25377":106601,"_2660":106706},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3162":64222,"_27851":64183,"_19309":106708,"_5":13254,"_25377":106605,"_2660":106709},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3162":64223,"_27851":64183,"_19309":106711,"_5":13254,"_25377":106605,"_2660":106712},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3162":64224,"_27851":64183,"_19309":106714,"_5":13254,"_25377":106605,"_2660":106715},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3162":64225,"_27851":64183,"_19309":106717,"_5":13254,"_25377":106605,"_2660":106718},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3162":64226,"_27851":64183,"_19309":106720,"_5":13254,"_25377":106609,"_2660":106721},[],"Opción",{"_3162":64227,"_27851":64183,"_19309":106723,"_5":13254,"_25377":106609,"_2660":106724},[],"Valor predeterminado",{"_3162":64228,"_27851":64183,"_19309":106726,"_5":13254,"_25377":106609,"_2660":106727},[],"Propósito",{"_3162":64229,"_27851":64183,"_19309":106729,"_5":13254,"_25377":106609,"_2660":45621},[],{"_3162":64230,"_27851":64183,"_19309":106731,"_5":13254,"_25377":106609,"_2660":45624},[],{"_3162":64231,"_27851":64183,"_19309":106733,"_5":13254,"_25377":106609,"_2660":106734},[],"Muestra la ayuda",{"_3162":64232,"_27851":64183,"_19309":106736,"_5":13254,"_25377":106609,"_2660":45630},[],{"_3162":64233,"_27851":64183,"_19309":106738,"_5":13254,"_25377":106609,"_2660":106739},[],"contexto actual",{"_3162":64234,"_27851":64183,"_19309":106741,"_5":13254,"_25377":106609,"_2660":106742},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3162":64235,"_27851":64183,"_19309":106744,"_5":13254,"_25377":106609,"_2660":45639},[],{"_3162":64236,"_27851":64183,"_19309":106746,"_5":13254,"_25377":106609,"_2660":5932},[],{"_3162":64237,"_27851":64183,"_19309":106748,"_5":13254,"_25377":106609,"_2660":106749},[],"Omite prompts y genera credenciales para las dependencias",{"_3162":64238,"_27851":64183,"_19309":106751,"_5":13254,"_25377":106609,"_2660":45647},[],{"_3162":64239,"_27851":64183,"_19309":106753,"_5":13254,"_25377":106609,"_2660":45650},[],{"_3162":64240,"_27851":64183,"_19309":106755,"_5":13254,"_25377":106609,"_2660":106756},[],"Namespace de la instalación",{"_3162":64241,"_27851":64183,"_19309":106758,"_5":13254,"_25377":106609,"_2660":45656},[],{"_3162":64242,"_27851":64183,"_19309":106760,"_5":13254,"_25377":106609,"_2660":45659},[],{"_3162":64243,"_27851":64183,"_19309":106762,"_5":13254,"_25377":106609,"_2660":106763},[],"Dominio usado por la UI, OIDC y el certificado",{"_3162":64244,"_27851":64183,"_19309":106765,"_5":13254,"_25377":106609,"_2660":45665},[],{"_3162":64245,"_27851":64183,"_19309":106767,"_5":13254,"_25377":106609,"_2660":13879},[],{"_3162":64246,"_27851":64183,"_19309":106769,"_5":13254,"_25377":106609,"_2660":106770},[],"Versión del chart de Lamassu",{"_3162":64247,"_27851":64183,"_19309":106772,"_5":13254,"_25377":106609,"_2660":45673},[],{"_3162":64248,"_27851":64183,"_19309":106774,"_5":13254,"_25377":106609,"_2660":45676},[],{"_3162":64249,"_27851":64183,"_19309":106776,"_5":13254,"_25377":106609,"_2660":106777},[],"Puerto del listener HTTPS",{"_3162":64250,"_27851":64183,"_19309":106779,"_5":13254,"_25377":106609,"_2660":45682},[],{"_3162":64251,"_27851":64183,"_19309":106781,"_5":13254,"_25377":106609,"_2660":45685},[],{"_3162":64252,"_27851":64183,"_19309":106783,"_5":13254,"_25377":106609,"_2660":106784},[],"Puerto del listener HTTP",{"_3162":64253,"_27851":64183,"_19309":106786,"_5":13254,"_25377":106609,"_2660":45691},[],{"_3162":64254,"_27851":64183,"_19309":106788,"_5":13254,"_25377":106609,"_2660":45624},[],{"_3162":64255,"_27851":64183,"_19309":106790,"_5":13254,"_25377":106609,"_2660":106791},[],"Certificado PEM para TLS downstream",{"_3162":64256,"_27851":64183,"_19309":106793,"_5":13254,"_25377":106609,"_2660":45699},[],{"_3162":64257,"_27851":64183,"_19309":106795,"_5":13254,"_25377":106609,"_2660":45624},[],{"_3162":64258,"_27851":64183,"_19309":106797,"_5":13254,"_25377":106609,"_2660":106798},[],"Clave privada PEM para TLS downstream",{"_3162":64259,"_27851":64183,"_19309":106800,"_5":13254,"_25377":106609,"_2660":45707},[],{"_3162":64260,"_27851":64183,"_19309":106802,"_5":13254,"_25377":106609,"_2660":106803},[],"chart del repositorio",{"_3162":64261,"_27851":64183,"_19309":106805,"_5":13254,"_25377":106609,"_2660":106806},[],"Usa un chart local de Lamassu sin empaquetar",{"_3162":64262,"_27851":64183,"_19309":106808,"_5":13254,"_25377":106609,"_2660":45716},[],{"_3162":64263,"_27851":64183,"_19309":106810,"_5":13254,"_25377":106609,"_2660":106811},[],"detección automática",{"_3162":64264,"_27851":64183,"_19309":106813,"_5":13254,"_25377":106609,"_2660":106814},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3162":64265,"_27851":64183,"_19309":106816,"_5":13254,"_25377":106609,"_2660":45724},[],{"_3162":64266,"_27851":64183,"_19309":106818,"_5":13254,"_25377":106609,"_2660":5932},[],{"_3162":64267,"_27851":64183,"_19309":106820,"_5":13254,"_25377":106609,"_2660":106821},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3162":64268,"_27851":64183,"_19309":106823,"_5":13254,"_25377":106609,"_2660":45732},[],{"_3162":64269,"_27851":64183,"_19309":106825,"_5":13254,"_25377":106609,"_2660":5932},[],{"_3162":64270,"_27851":64183,"_19309":106827,"_5":13254,"_25377":106609,"_2660":106828},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3162":64271,"_27851":64183,"_19309":106830,"_5":13254,"_25377":106609,"_2660":45740},[],{"_3162":64272,"_27851":64183,"_19309":106832,"_5":13254,"_25377":106609,"_2660":5932},[],{"_3162":64273,"_27851":64183,"_19309":106834,"_5":13254,"_25377":106609,"_2660":106835},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3162":64274,"_27851":64183,"_19309":106837,"_5":13254,"_25377":106609,"_2660":45748},[],{"_3162":64275,"_27851":64183,"_19309":106839,"_5":13254,"_25377":106609,"_2660":5932},[],{"_3162":64276,"_27851":64183,"_19309":106841,"_5":13254,"_25377":106609,"_2660":106842},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3162":64277,"_27851":64183,"_19309":106844,"_5":13254,"_25377":106609,"_2660":45756},[],{"_3162":64278,"_27851":64183,"_19309":106846,"_5":13254,"_25377":106609,"_2660":45759},[],{"_3162":64279,"_27851":64183,"_19309":106848,"_5":13254,"_25377":106609,"_2660":106849},[],"Usa otro chart local de SoftHSM",{"_3162":64280,"_27851":64183,"_19309":106851,"_5":13254,"_25377":106609,"_2660":106852},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3162":64281,"_27851":64183,"_19309":106854,"_5":13254,"_25377":106613,"_2660":106855},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3162":64282,"_27851":64183,"_19309":106857,"_5":13254,"_25377":106613,"_2660":106858},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3162":64283,"_27851":64183,"_19309":106860,"_5":13254,"_25377":106613,"_2660":106861},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3162":64284,"_27851":64183,"_19309":106863,"_5":13254,"_25377":106613,"_2660":106864},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3162":64285,"_27851":64183,"_19309":106866,"_5":13254,"_25377":106613,"_2660":106867},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3162":64286,"_27851":64183,"_19309":106869,"_5":13254,"_25377":106613,"_2660":106870},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3162":64287,"_27851":64183,"_19309":106872,"_5":13254,"_25377":106617,"_2660":45786},[],{"_3162":64288,"_27851":64183,"_19309":106874,"_5":13254,"_25377":106617,"_2660":106875},[],"valida las herramientas locales y el clúster seleccionado",{"_3162":64289,"_27851":64183,"_19309":106877,"_5":13254,"_25377":106617,"_2660":106878},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3162":64290,"_27851":64183,"_19309":106880,"_5":13254,"_25377":106617,"_2660":106881},[],"crea el namespace",{"_3162":64291,"_27851":64183,"_19309":106883,"_5":13254,"_25377":106617,"_2660":106884},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3162":64292,"_27851":64183,"_19309":106886,"_5":13254,"_25377":106617,"_2660":106887},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3162":64293,"_27851":64183,"_19309":106889,"_5":13254,"_25377":106617,"_2660":106890},[],"instala RabbitMQ",{"_3162":64294,"_27851":64183,"_19309":106892,"_5":13254,"_25377":106617,"_2660":106893},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3162":64295,"_27851":64183,"_19309":106895,"_5":13254,"_25377":106617,"_2660":106896},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3162":64296,"_27851":64183,"_19309":106898,"_5":13254,"_25377":106617,"_2660":106899},[],"carga datos de ejemplo opcionalmente",{"_3162":64297,"_27851":64183,"_19309":106901,"_5":13254,"_25377":106617,"_2660":106902},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3162":64298,"_27851":64183,"_19309":106904,"_5":13254,"_25377":106621,"_2660":106905},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3162":64299,"_27851":64183,"_19309":106907,"_5":13254,"_25377":106621,"_2660":106908},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3162":64300,"_27851":64183,"_19309":106910,"_5":13254,"_25377":106625,"_2660":106911},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3162":64301,"_27851":64183,"_19309":106913,"_5":13254,"_25377":106625,"_2660":106914},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3162":64302,"_27851":64183,"_19309":106916,"_5":13254,"_25377":106625,"_2660":106917},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3162":64303,"_27851":64183,"_19309":106919,"_5":13254,"_25377":106629,"_2660":106920},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3162":64304,"_27851":64304,"_5":13585,"_2660":106922,"_28194":106923,"_19309":106924,"_25377":64304},"Instala con Helm",[45228,106348,106582],[],{"_3162":64305,"_27851":64304,"_19309":106926,"_5":13254,"_25377":64304,"_2660":106927},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3162":64306,"_27851":64304,"_5":28191,"_19309":106929,"_25377":106930,"_2660":106931},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3162":64307,"_27851":64304,"_5":28191,"_19309":106933,"_25377":106934,"_2660":106598},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3162":64308,"_27851":64304,"_5":28191,"_19309":106936,"_25377":106937,"_2660":106938},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3162":64309,"_27851":64304,"_5":28191,"_19309":106940,"_25377":106941,"_2660":106942},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3162":64310,"_27851":64304,"_5":28191,"_19309":106944,"_25377":106945,"_2660":106946},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3162":64311,"_27851":64304,"_5":28191,"_19309":106948,"_25377":106949,"_2660":106950},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3162":64312,"_27851":64304,"_5":28191,"_19309":106952,"_25377":106953,"_2660":106954},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3162":64313,"_27851":64304,"_5":28191,"_19309":106956,"_25377":106957,"_2660":106958},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3162":64314,"_27851":64304,"_5":28191,"_19309":106960,"_25377":106961,"_2660":106962},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3162":64315,"_27851":64304,"_19309":106964,"_5":13254,"_25377":106930,"_2660":106965},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3162":64316,"_27851":64304,"_19309":106967,"_5":13254,"_25377":106934,"_2660":106968},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3162":64317,"_27851":64304,"_19309":106970,"_5":13254,"_25377":106934,"_2660":106971},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3162":64318,"_27851":64304,"_19309":106973,"_5":13254,"_25377":106934,"_2660":106974},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3162":64319,"_27851":64304,"_19309":106976,"_5":13254,"_25377":106934,"_2660":106977},[],"un broker RabbitMQ accesible y sus credenciales",{"_3162":64320,"_27851":64304,"_19309":106979,"_5":13254,"_25377":106934,"_2660":106980},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3162":64321,"_27851":64304,"_19309":106982,"_5":13254,"_25377":106934,"_2660":106983},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3162":64322,"_27851":64304,"_19309":106985,"_5":13254,"_25377":106934,"_2660":106986},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3162":64323,"_27851":64304,"_19309":106988,"_5":13254,"_25377":106934,"_2660":106989},[],"una StorageClass y un diseño de tráfico externo",{"_3162":64324,"_27851":64304,"_19309":106991,"_5":13254,"_25377":106934,"_2660":106992},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3162":64325,"_27851":64304,"_19309":106994,"_5":13254,"_25377":106934,"_2660":106995},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3162":64326,"_27851":64304,"_19309":106997,"_5":13254,"_25377":106934,"_2660":106998},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3162":64327,"_27851":64304,"_19309":107000,"_5":13254,"_25377":106937,"_2660":107001},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3162":64328,"_27851":64304,"_19309":107003,"_5":13254,"_25377":106937,"_2660":107004},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3162":64329,"_27851":64304,"_19309":107006,"_5":13254,"_25377":106937,"_2660":107007},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3162":64330,"_27851":64304,"_19309":107009,"_5":13254,"_25377":106941,"_2660":107010},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3162":64331,"_27851":64304,"_19309":107012,"_5":13254,"_25377":106941,"_2660":107013},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3162":64332,"_27851":64304,"_19309":107015,"_5":13254,"_25377":106941,"_2660":107016},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3162":64333,"_27851":64304,"_19309":107018,"_5":13254,"_25377":106945,"_2660":107019},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3162":64334,"_27851":64304,"_19309":107021,"_5":13254,"_25377":106949,"_2660":107022},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3162":64335,"_27851":64304,"_19309":107024,"_5":13254,"_25377":106949,"_2660":107025},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3162":64336,"_27851":64304,"_19309":107027,"_5":13254,"_25377":106949,"_2660":107028},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3162":64337,"_27851":64304,"_19309":107030,"_5":13254,"_25377":106949,"_2660":107031},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3162":64338,"_27851":64304,"_19309":107033,"_5":13254,"_25377":106953,"_2660":107034},[],"Para instalar un checkout local:",{"_3162":64339,"_27851":64304,"_19309":107036,"_5":13254,"_25377":106957,"_2660":107037},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3162":64340,"_27851":64304,"_19309":107039,"_5":13254,"_25377":106957,"_2660":107040},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3162":64341,"_27851":64304,"_19309":107042,"_5":13254,"_25377":106961,"_2660":107043},[],"Antes de pasar a producción, revisa:",{"_3162":64342,"_27851":64304,"_19309":107045,"_5":13254,"_25377":106961,"_2660":107046},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3162":64343,"_27851":64304,"_19309":107048,"_5":13254,"_25377":106961,"_2660":107049},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3162":64344,"_27851":64304,"_19309":107051,"_5":13254,"_25377":106961,"_2660":107052},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3162":64345,"_27851":64304,"_19309":107054,"_5":13254,"_25377":106961,"_2660":107055},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3162":64346,"_27851":64304,"_19309":107057,"_5":13254,"_25377":106961,"_2660":107058},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3162":64347,"_27851":64304,"_19309":107060,"_5":13254,"_25377":106961,"_2660":107061},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3162":64348,"_27851":64304,"_19309":107063,"_5":13254,"_25377":106961,"_2660":107064},[],"SMTP, observabilidad y entrega de alertas",{"_3162":64349,"_27851":64304,"_19309":107066,"_5":13254,"_25377":106961,"_2660":107067},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3162":64350,"_27851":64304,"_19309":107069,"_5":13254,"_25377":106961,"_2660":107070},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3162":64351,"_27851":64351,"_5":13585,"_2660":107072,"_28194":107073,"_19309":107074,"_25377":64351},"Expón el Gateway",[45228,106348,106582],[],{"_3162":64352,"_27851":64351,"_19309":107076,"_5":13254,"_25377":64351,"_2660":107077},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3162":64353,"_27851":64351,"_5":28191,"_19309":107079,"_25377":107080,"_2660":107081},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3162":64354,"_27851":64351,"_5":28191,"_19309":107083,"_25377":107084,"_2660":107085},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3162":64355,"_27851":64351,"_5":28191,"_19309":107087,"_25377":107088,"_2660":107089},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3162":64356,"_27851":64351,"_5":28191,"_19309":107091,"_25377":107092,"_2660":46007},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#k3s",{"_3162":64357,"_27851":64351,"_5":28191,"_19309":107094,"_25377":107095,"_2660":107096},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3162":64358,"_27851":64351,"_5":28191,"_19309":107098,"_25377":107099,"_2660":107100},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3162":64359,"_27851":64351,"_5":28191,"_19309":107102,"_25377":107103,"_2660":107104},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3162":64360,"_27851":64351,"_5":28191,"_19309":107106,"_25377":107107,"_2660":107108},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3162":64361,"_27851":64351,"_5":28191,"_19309":107110,"_25377":107111,"_2660":107112},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3162":64362,"_27851":64351,"_19309":107114,"_5":13254,"_25377":107080,"_2660":107115},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3162":64363,"_27851":64351,"_19309":107117,"_5":13254,"_25377":107080,"_2660":107118},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3162":64364,"_27851":64351,"_19309":107120,"_5":13254,"_25377":107084,"_2660":107121},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3162":64365,"_27851":64351,"_19309":107123,"_5":13254,"_25377":107084,"_2660":107124},[],"Defínelo únicamente cuando:",{"_3162":64366,"_27851":64351,"_19309":107126,"_5":13254,"_25377":107084,"_2660":107127},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3162":64367,"_27851":64351,"_19309":107129,"_5":13254,"_25377":107084,"_2660":107130},[],"esa dirección está asignada a este Gateway",{"_3162":64368,"_27851":64351,"_19309":107132,"_5":13254,"_25377":107084,"_2660":107133},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3162":64369,"_27851":64351,"_19309":107135,"_5":13254,"_25377":107084,"_2660":107136},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3162":64370,"_27851":64351,"_19309":107138,"_5":13254,"_25377":107084,"_2660":107139},[],"No confundas estos valores:",{"_3162":64371,"_27851":64351,"_19309":107141,"_5":13254,"_25377":107084,"_2660":107142},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3162":64372,"_27851":64351,"_19309":107144,"_5":13254,"_25377":107084,"_2660":107145},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3162":64373,"_27851":64351,"_19309":107147,"_5":13254,"_25377":107084,"_2660":107148},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3162":64374,"_27851":64351,"_19309":107150,"_5":13254,"_25377":107088,"_2660":107151},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3162":64375,"_27851":64351,"_19309":107153,"_5":13254,"_25377":107088,"_2660":107154},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3162":64376,"_27851":64351,"_19309":107156,"_5":13254,"_25377":107092,"_2660":107157},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3162":64377,"_27851":64351,"_19309":107159,"_5":13254,"_25377":107092,"_2660":107160},[],"Para el diseño recomendado:",{"_3162":64378,"_27851":64351,"_19309":107162,"_5":13254,"_25377":107092,"_2660":107163},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3162":64379,"_27851":64351,"_19309":107165,"_5":13254,"_25377":107092,"_2660":107166},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3162":64380,"_27851":64351,"_19309":107168,"_5":13254,"_25377":107092,"_2660":107169},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3162":64381,"_27851":64351,"_19309":107171,"_5":13254,"_25377":107092,"_2660":107172},[],"Apunta DNS a la dirección accesible de la VM.",{"_3162":64382,"_27851":64351,"_19309":107174,"_5":13254,"_25377":107092,"_2660":107175},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3162":64383,"_27851":64351,"_19309":107177,"_5":13254,"_25377":107095,"_2660":107178},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3162":64384,"_27851":64351,"_19309":107180,"_5":13254,"_25377":107099,"_2660":107181},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3162":64385,"_27851":64351,"_19309":107183,"_5":13254,"_25377":107099,"_2660":107184},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3162":64386,"_27851":64351,"_19309":107186,"_5":13254,"_25377":107103,"_2660":107187},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3162":64387,"_27851":64351,"_19309":107189,"_5":13254,"_25377":107103,"_2660":107190},[],"Requisito",{"_3162":64388,"_27851":64351,"_19309":107192,"_5":13254,"_25377":107103,"_2660":107193},[],"Diseño recomendado",{"_3162":64389,"_27851":64351,"_19309":107195,"_5":13254,"_25377":107103,"_2660":107196},[],"Consecuencia",{"_3162":64390,"_27851":64351,"_19309":107198,"_5":13254,"_25377":107103,"_2660":107199},[],"Varias URL o servicios de Lamassu",{"_3162":64391,"_27851":64351,"_19309":107201,"_5":13254,"_25377":107103,"_2660":107202},[],"Un Gateway con varias rutas",{"_3162":64392,"_27851":64351,"_19309":107204,"_5":13254,"_25377":107103,"_2660":107205},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3162":64393,"_27851":64351,"_19309":107207,"_5":13254,"_25377":107103,"_2660":107208},[],"Gateways independientes e IP externas distintas",{"_3162":64394,"_27851":64351,"_19309":107210,"_5":13254,"_25377":107103,"_2660":107211},[],"Una VIP por Gateway",{"_3162":64395,"_27851":64351,"_19309":107213,"_5":13254,"_25377":107103,"_2660":107214},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3162":64396,"_27851":64351,"_19309":107216,"_5":13254,"_25377":107103,"_2660":107217},[],"Gateways independientes, un nodo y una IP",{"_3162":64397,"_27851":64351,"_19309":107219,"_5":13254,"_25377":107103,"_2660":107220},[],"Puertos externos diferentes",{"_3162":64398,"_27851":64351,"_19309":107222,"_5":13254,"_25377":107103,"_2660":107223},[],"Los clientes deben indicar puertos no estándar",{"_3162":64399,"_27851":64351,"_19309":107225,"_5":13254,"_25377":107103,"_2660":107226},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3162":64400,"_27851":64351,"_19309":107228,"_5":13254,"_25377":107103,"_2660":107229},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3162":64401,"_27851":64351,"_19309":107231,"_5":13254,"_25377":107103,"_2660":107232},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3162":64402,"_27851":64351,"_19309":107234,"_5":13254,"_25377":107103,"_2660":107235},[],"Recursos Gateway separados pero proxy compartido",{"_3162":64403,"_27851":64351,"_19309":107237,"_5":13254,"_25377":107103,"_2660":107238},[],"Modo merged Gateway de Envoy",{"_3162":64404,"_27851":64351,"_19309":107240,"_5":13254,"_25377":107103,"_2660":107241},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3162":64405,"_27851":64351,"_19309":107243,"_5":13254,"_25377":107103,"_2660":107244},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3162":64406,"_27851":64351,"_19309":107246,"_5":13254,"_25377":107103,"_2660":107247},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3162":64407,"_27851":64351,"_19309":107249,"_5":13254,"_25377":107103,"_2660":107250},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3162":64408,"_27851":64351,"_19309":107252,"_5":13254,"_25377":107103,"_2660":107253},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3162":64409,"_27851":64351,"_19309":107255,"_5":13254,"_25377":107107,"_2660":107256},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3162":64410,"_27851":64351,"_19309":107258,"_5":13254,"_25377":107107,"_2660":107259},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3162":64411,"_27851":64351,"_19309":107261,"_5":13254,"_25377":107107,"_2660":107262},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3162":64412,"_27851":64351,"_19309":107264,"_5":13254,"_25377":107107,"_2660":107265},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3162":64413,"_27851":64351,"_19309":107267,"_5":13254,"_25377":107107,"_2660":107268},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3162":64414,"_27851":64351,"_19309":107270,"_5":13254,"_25377":107111,"_2660":107271},[],"Comprueba, en orden:",{"_3162":64415,"_27851":64351,"_19309":107273,"_5":13254,"_25377":107111,"_2660":107274},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3162":64416,"_27851":64351,"_19309":107276,"_5":13254,"_25377":107111,"_2660":107277},[],"Su estado contiene la dirección esperada.",{"_3162":64417,"_27851":64351,"_19309":107279,"_5":13254,"_25377":107111,"_2660":107280},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3162":64418,"_27851":64351,"_19309":107282,"_5":13254,"_25377":107111,"_2660":107283},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3162":64419,"_27851":64351,"_19309":107285,"_5":13254,"_25377":107111,"_2660":107286},[],"DNS resuelve al endpoint accesible externamente.",{"_3162":64420,"_27851":64351,"_19309":107288,"_5":13254,"_25377":107111,"_2660":107289},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3162":64421,"_27851":64351,"_19309":107291,"_5":13254,"_25377":107111,"_2660":107292},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3162":64422,"_27851":64422,"_5":13585,"_2660":45335,"_28194":107294,"_19309":107295,"_25377":64422},[45228,106348,106582],[],{"_3162":64423,"_27851":64422,"_19309":107297,"_5":13254,"_25377":64422,"_2660":107298},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3162":64424,"_27851":64422,"_5":28191,"_19309":107300,"_25377":107301,"_2660":107302},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3162":64425,"_27851":64422,"_5":28191,"_19309":107304,"_25377":107305,"_2660":107306},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3162":64426,"_27851":64422,"_5":28191,"_19309":107308,"_25377":107309,"_2660":107310},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3162":64427,"_27851":64422,"_5":28191,"_19309":107312,"_25377":107313,"_2660":107314},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3162":64428,"_27851":64422,"_5":28191,"_19309":107316,"_25377":107317,"_2660":107318},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3162":64429,"_27851":64422,"_5":28191,"_19309":107320,"_25377":107321,"_2660":107322},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3162":64430,"_27851":64422,"_19309":107324,"_5":13254,"_25377":107301,"_2660":107325},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3162":64431,"_27851":64422,"_19309":107327,"_5":13254,"_25377":107305,"_2660":107328},[],"Flujo",{"_3162":64432,"_27851":64422,"_19309":107330,"_5":13254,"_25377":107305,"_2660":107331},[],"Úsalo para",{"_3162":64433,"_27851":64422,"_19309":107333,"_5":13254,"_25377":107305,"_2660":107334},[],"Qué instala",{"_3162":64434,"_27851":64422,"_19309":107336,"_5":13254,"_25377":107305,"_2660":46252},[],{"_3162":64435,"_27851":64422,"_19309":107338,"_5":13254,"_25377":107305,"_2660":107339},[],"Producción y entornos controlados",{"_3162":64436,"_27851":64422,"_19309":107341,"_5":13254,"_25377":107305,"_2660":107342},[],"Servicios de Lamassu y recursos de Gateway API",{"_3162":64437,"_27851":64422,"_19309":107344,"_5":13254,"_25377":107305,"_2660":45472},[],{"_3162":64438,"_27851":64422,"_19309":107346,"_5":13254,"_25377":107305,"_2660":107347},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3162":64439,"_27851":64422,"_19309":107349,"_5":13254,"_25377":107305,"_2660":107350},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3162":64440,"_27851":64422,"_19309":107352,"_5":13254,"_25377":107309,"_2660":107353},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3162":64441,"_27851":64422,"_19309":107355,"_5":13254,"_25377":107309,"_2660":107356},[],"Área",{"_3162":64442,"_27851":64422,"_19309":107358,"_5":13254,"_25377":107309,"_2660":107359},[],"El chart de Lamassu proporciona",{"_3162":64443,"_27851":64422,"_19309":107361,"_5":13254,"_25377":107309,"_2660":107362},[],"Tú proporcionas",{"_3162":64444,"_27851":64422,"_19309":107364,"_5":13254,"_25377":107309,"_2660":107365},[],"Aplicaciones Lamassu",{"_3162":64445,"_27851":64422,"_19309":107367,"_5":13254,"_25377":107309,"_2660":107368},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3162":64446,"_27851":64422,"_19309":107370,"_5":13254,"_25377":107309,"_2660":107371},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3162":64447,"_27851":64422,"_19309":107373,"_5":13254,"_25377":107309,"_2660":107374},[],"Datos PostgreSQL",{"_3162":64448,"_27851":64422,"_19309":107376,"_5":13254,"_25377":107309,"_2660":107377},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3162":64449,"_27851":64422,"_19309":107379,"_5":13254,"_25377":107309,"_2660":107380},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3162":64450,"_27851":64422,"_19309":107382,"_5":13254,"_25377":107309,"_2660":107383},[],"Mensajería",{"_3162":64451,"_27851":64422,"_19309":107385,"_5":13254,"_25377":107309,"_2660":107386},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_3162":64452,"_27851":64422,"_19309":107388,"_5":13254,"_25377":107309,"_2660":107389},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3162":64453,"_27851":64422,"_19309":107391,"_5":13254,"_25377":107309,"_2660":107392},[],"Identidad",{"_3162":64454,"_27851":64422,"_19309":107394,"_5":13254,"_25377":107309,"_2660":107395},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3162":64455,"_27851":64422,"_19309":107397,"_5":13254,"_25377":107309,"_2660":107398},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3162":64456,"_27851":64422,"_19309":107400,"_5":13254,"_25377":107309,"_2660":107401},[],"Enrutamiento externo",{"_3162":64457,"_27851":64422,"_19309":107403,"_5":13254,"_25377":107309,"_2660":107404},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3162":64458,"_27851":64422,"_19309":107406,"_5":13254,"_25377":107309,"_2660":107407},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3162":64459,"_27851":64422,"_19309":107409,"_5":13254,"_25377":107309,"_2660":46326},[],{"_3162":64460,"_27851":64422,"_19309":107411,"_5":13254,"_25377":107309,"_2660":107412},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3162":64461,"_27851":64422,"_19309":107414,"_5":13254,"_25377":107309,"_2660":107415},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3162":64462,"_27851":64422,"_19309":107417,"_5":13254,"_25377":107309,"_2660":107418},[],"Datos persistentes de la aplicación",{"_3162":64463,"_27851":64422,"_19309":107420,"_5":13254,"_25377":107309,"_2660":107421},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3162":64464,"_27851":64422,"_19309":107423,"_5":13254,"_25377":107309,"_2660":107424},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3162":64465,"_27851":64422,"_19309":107426,"_5":13254,"_25377":107309,"_2660":107427},[],"Integraciones opcionales",{"_3162":64466,"_27851":64422,"_19309":107429,"_5":13254,"_25377":107309,"_2660":107430},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3162":64467,"_27851":64422,"_19309":107432,"_5":13254,"_25377":107309,"_2660":107433},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3162":64468,"_27851":64422,"_19309":107435,"_5":13254,"_25377":107309,"_2660":107436},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3162":64469,"_27851":64422,"_19309":107438,"_5":13254,"_25377":107309,"_2660":107439},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3162":64470,"_27851":64422,"_19309":107441,"_5":13254,"_25377":107313,"_2660":107442},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3162":64471,"_27851":64422,"_19309":107444,"_5":13254,"_25377":107313,"_2660":107445},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3162":64472,"_27851":64422,"_19309":107447,"_5":13254,"_25377":107317,"_2660":107448},[],"Kubernetes 1.24 o posterior",{"_3162":64473,"_27851":64422,"_19309":107450,"_5":13254,"_25377":107317,"_2660":107451},[],"Helm 3.2 o posterior",{"_3162":64474,"_27851":64422,"_19309":107453,"_5":13254,"_25377":107317,"_2660":107454},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3162":64475,"_27851":64422,"_19309":107456,"_5":13254,"_25377":107317,"_2660":107457},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3162":64476,"_27851":64422,"_19309":107459,"_5":13254,"_25377":107317,"_2660":107460},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3162":64477,"_27851":64422,"_19309":107462,"_5":13254,"_25377":107317,"_2660":107463},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3162":64478,"_27851":64422,"_19309":107465,"_5":13254,"_25377":107317,"_2660":107466},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3162":64479,"_27851":64422,"_19309":107468,"_5":13254,"_25377":107321,"_2660":107469},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3162":64480,"_27851":64422,"_19309":107471,"_5":13254,"_25377":107321,"_2660":107472},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3162":64481,"_27851":64422,"_19309":107474,"_5":13254,"_25377":107321,"_2660":107475},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3162":64482,"_27851":64422,"_19309":107477,"_5":13254,"_25377":107321,"_2660":107478},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3162":64483,"_27851":64483,"_5":13585,"_2660":107480,"_28194":107481,"_19309":107483,"_25377":64483},"Resolución de problemas de despliegue",[45228,106348,107482],"Operación",[],{"_3162":64484,"_27851":64483,"_19309":107485,"_5":13254,"_25377":64483,"_2660":107486},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3162":64485,"_27851":64483,"_5":28191,"_19309":107488,"_25377":107489,"_2660":107490},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3162":64486,"_27851":64483,"_5":28191,"_19309":107492,"_25377":107493,"_2660":107494},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3162":64487,"_27851":64483,"_5":28191,"_19309":107496,"_25377":107497,"_2660":107498},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3162":64488,"_27851":64483,"_5":28191,"_19309":107500,"_25377":107501,"_2660":107502},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3162":64489,"_27851":64483,"_5":28191,"_19309":107504,"_25377":107505,"_2660":107506},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3162":64490,"_27851":64483,"_5":28191,"_19309":107508,"_25377":107509,"_2660":107510},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3162":64491,"_27851":64483,"_5":28191,"_19309":107512,"_25377":107513,"_2660":107514},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3162":64492,"_27851":64483,"_5":28191,"_19309":107516,"_25377":107517,"_2660":107518},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3162":64493,"_27851":64483,"_5":28191,"_19309":107520,"_25377":107521,"_2660":107522},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3162":64494,"_27851":64483,"_5":28191,"_19309":107524,"_25377":107525,"_2660":107526},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3162":64495,"_27851":64483,"_5":28191,"_19309":107528,"_25377":107529,"_2660":107530},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3162":64496,"_27851":64483,"_5":28191,"_19309":107532,"_25377":107533,"_2660":107534},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3162":64497,"_27851":64483,"_19309":107536,"_5":13254,"_25377":64483,"_2660":107537},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3162":64498,"_27851":64483,"_19309":107539,"_5":13254,"_25377":107493,"_2660":107540},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3162":64499,"_27851":64483,"_19309":107542,"_5":13254,"_25377":107497,"_2660":107543},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3162":64500,"_27851":64483,"_19309":107545,"_5":13254,"_25377":107501,"_2660":107546},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3162":64501,"_27851":64483,"_19309":107548,"_5":13254,"_25377":107505,"_2660":107549},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3162":64502,"_27851":64483,"_19309":107551,"_5":13254,"_25377":107509,"_2660":107552},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3162":64503,"_27851":64483,"_19309":107554,"_5":13254,"_25377":107513,"_2660":107555},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3162":64504,"_27851":64483,"_19309":107557,"_5":13254,"_25377":107513,"_2660":107558},[],"Ejecuta también la prueba de conectividad del chart:",{"_3162":64505,"_27851":64483,"_19309":107560,"_5":13254,"_25377":107513,"_2660":107561},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3162":64506,"_27851":64483,"_19309":107563,"_5":13254,"_25377":107513,"_2660":107564},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3162":64507,"_27851":64483,"_19309":107566,"_5":13254,"_25377":107517,"_2660":107567},[],"Si recibes un 401:",{"_3162":64508,"_27851":64483,"_19309":107569,"_5":13254,"_25377":107517,"_2660":107570},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3162":64509,"_27851":64483,"_19309":107572,"_5":13254,"_25377":107517,"_2660":107573},[],"verifica emisor, audiencia y expiración del token;",{"_3162":64510,"_27851":64483,"_19309":107575,"_5":13254,"_25377":107517,"_2660":107576},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3162":64511,"_27851":64483,"_19309":107578,"_5":13254,"_25377":107517,"_2660":107579},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3162":64512,"_27851":64483,"_19309":107581,"_5":13254,"_25377":107517,"_2660":107582},[],"Si el login termina pero las APIs devuelven 403:",{"_3162":64513,"_27851":64483,"_19309":107584,"_5":13254,"_25377":107517,"_2660":107585},[],"inspecciona los claims reales del token;",{"_3162":64514,"_27851":64483,"_19309":107587,"_5":13254,"_25377":107517,"_2660":107588},[],"confirma que coinciden con un principal activo;",{"_3162":64515,"_27851":64483,"_19309":107590,"_5":13254,"_25377":107517,"_2660":107591},[],"revisa las políticas concedidas al principal;",{"_3162":64516,"_27851":64483,"_19309":107593,"_5":13254,"_25377":107517,"_2660":107594},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3162":64517,"_27851":64483,"_19309":107596,"_5":13254,"_25377":107517,"_2660":107597},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3162":64518,"_27851":64483,"_19309":107599,"_5":13254,"_25377":107521,"_2660":107600},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3162":64519,"_27851":64483,"_19309":107602,"_5":13254,"_25377":107521,"_2660":107603},[],"Localiza el pod y Service de authz.",{"_3162":64520,"_27851":64483,"_19309":107605,"_5":13254,"_25377":107521,"_2660":107606},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3162":64521,"_27851":64483,"_19309":107608,"_5":13254,"_25377":107521,"_2660":107609},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3162":64522,"_27851":64483,"_19309":107611,"_5":13254,"_25377":107521,"_2660":107612},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3162":64523,"_27851":64483,"_19309":107614,"_5":13254,"_25377":107521,"_2660":107615},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3162":64524,"_27851":64483,"_19309":107617,"_5":13254,"_25377":107525,"_2660":107618},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3162":64525,"_27851":64483,"_19309":107620,"_5":13254,"_25377":107525,"_2660":107621},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3162":64526,"_27851":64483,"_19309":107623,"_5":13254,"_25377":107525,"_2660":107624},[],"volumen persistente sin enlazar;",{"_3162":64527,"_27851":64483,"_19309":107626,"_5":13254,"_25377":107525,"_2660":107627},[],"imagen inaccesible o política de pull incorrecta;",{"_3162":64528,"_27851":64483,"_19309":107629,"_5":13254,"_25377":107525,"_2660":107630},[],"configuración inválida del motor criptográfico;",{"_3162":64529,"_27851":64483,"_19309":107632,"_5":13254,"_25377":107525,"_2660":107633},[],"límites de CPU o memoria demasiado bajos;",{"_3162":64530,"_27851":64483,"_19309":107635,"_5":13254,"_25377":107525,"_2660":107636},[],"migración previa incompleta.",{"_3162":64531,"_27851":64483,"_19309":107638,"_5":13254,"_25377":107525,"_2660":107639},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3162":64532,"_27851":64483,"_19309":107641,"_5":13254,"_25377":107525,"_2660":107642},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3162":64533,"_27851":64483,"_19309":107644,"_5":13254,"_25377":107529,"_2660":107645},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3162":64534,"_27851":64483,"_19309":107647,"_5":13254,"_25377":107529,"_2660":107648},[],"verifica que esté habilitado en el servicio emisor;",{"_3162":64535,"_27851":64483,"_19309":107650,"_5":13254,"_25377":107529,"_2660":107651},[],"comprueba conectividad y credenciales AMQP;",{"_3162":64536,"_27851":64483,"_19309":107653,"_5":13254,"_25377":107529,"_2660":107654},[],"revisa exchange, routing key, colas y consumidores;",{"_3162":64537,"_27851":64483,"_19309":107656,"_5":13254,"_25377":107529,"_2660":107657},[],"inspecciona dead-letter queues;",{"_3162":64538,"_27851":64483,"_19309":107659,"_5":13254,"_25377":107529,"_2660":107660},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3162":64539,"_27851":64483,"_19309":107662,"_5":13254,"_25377":107529,"_2660":107663},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3162":64540,"_27851":64483,"_19309":107665,"_5":13254,"_25377":107533,"_2660":107666},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3162":64541,"_27851":64483,"_19309":107668,"_5":13254,"_25377":107533,"_2660":107669},[],"Antes de cerrar una incidencia, guarda:",{"_3162":64542,"_27851":64483,"_19309":107671,"_5":13254,"_25377":107533,"_2660":107672},[],"causa confirmada;",{"_3162":64543,"_27851":64483,"_19309":107674,"_5":13254,"_25377":107533,"_2660":107675},[],"alcance temporal y recursos afectados;",{"_3162":64544,"_27851":64483,"_19309":107677,"_5":13254,"_25377":107533,"_2660":107678},[],"comandos o consultas utilizados;",{"_3162":64545,"_27851":64483,"_19309":107680,"_5":13254,"_25377":107533,"_2660":107681},[],"cambio aplicado y forma de revertirlo;",{"_3162":64546,"_27851":64483,"_19309":107683,"_5":13254,"_25377":107533,"_2660":107684},[],"validación desde un consumidor;",{"_3162":64547,"_27851":64483,"_19309":107686,"_5":13254,"_25377":107533,"_2660":107687},[],"acción preventiva y propietario.",{"_3162":64548,"_27851":64548,"_5":13585,"_2660":107689,"_28194":107690,"_19309":107693,"_25377":64548},"Control de acceso",[45228,107691,107692],"Plataforma","Administración",[],{"_3162":64549,"_27851":64548,"_19309":107695,"_5":13254,"_25377":64548,"_2660":107696},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3162":64550,"_27851":64548,"_5":28191,"_19309":107698,"_25377":107699,"_2660":107700},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3162":64551,"_27851":64548,"_5":28191,"_19309":107702,"_25377":107703,"_2660":107704},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3162":64552,"_27851":64548,"_5":28191,"_19309":107706,"_25377":107707,"_2660":107708},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3162":64553,"_27851":64548,"_5":28191,"_19309":107710,"_25377":107711,"_2660":107712},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3162":64554,"_27851":64548,"_5":28191,"_19309":107714,"_25377":107715,"_2660":107716},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3162":64555,"_27851":64548,"_5":28191,"_19309":107718,"_25377":107719,"_2660":107720},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3162":64556,"_27851":64548,"_5":28191,"_19309":107722,"_25377":107723,"_2660":107724},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3162":64557,"_27851":64548,"_5":28191,"_19309":107726,"_25377":107727,"_2660":107728},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3162":64558,"_27851":64548,"_5":28191,"_19309":107730,"_25377":107731,"_2660":107732},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3162":64559,"_27851":64548,"_5":28191,"_19309":107734,"_25377":107735,"_2660":107736},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3162":64560,"_27851":64548,"_5":28191,"_19309":107738,"_25377":107739,"_2660":107740},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3162":64561,"_27851":64548,"_5":28191,"_19309":107742,"_25377":107743,"_2660":107744},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3162":64562,"_27851":64548,"_5":28191,"_19309":107746,"_25377":107747,"_2660":107748},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3162":64563,"_27851":64548,"_5":28191,"_19309":107750,"_25377":107751,"_2660":107752},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3162":64564,"_27851":64548,"_5":28191,"_19309":107754,"_25377":107755,"_2660":107756},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3162":64565,"_27851":64548,"_5":28191,"_19309":107758,"_25377":107759,"_2660":106950},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3162":64566,"_27851":64548,"_5":28191,"_19309":107761,"_25377":107762,"_2660":107763},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3162":64567,"_27851":64548,"_5":28191,"_19309":107765,"_25377":107766,"_2660":107767},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3162":64568,"_27851":64548,"_5":28191,"_19309":107769,"_25377":107770,"_2660":107771},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3162":64569,"_27851":64548,"_5":28191,"_19309":107773,"_25377":107774,"_2660":107775},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3162":64570,"_27851":64548,"_5":28191,"_19309":107777,"_25377":107778,"_2660":107779},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3162":64571,"_27851":64548,"_5":28191,"_19309":107781,"_25377":107782,"_2660":107783},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3162":64572,"_27851":64548,"_5":28191,"_19309":107785,"_25377":107786,"_2660":107787},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3162":64573,"_27851":64548,"_5":28191,"_19309":107789,"_25377":107790,"_2660":107791},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3162":64574,"_27851":64548,"_5":28191,"_19309":107793,"_25377":107794,"_2660":107795},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3162":64575,"_27851":64548,"_5":28191,"_19309":107797,"_25377":107798,"_2660":107799},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3162":64576,"_27851":64548,"_5":28191,"_19309":107801,"_25377":107802,"_2660":107803},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3162":64577,"_27851":64548,"_5":28191,"_19309":107805,"_25377":107806,"_2660":107807},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3162":64578,"_27851":64548,"_5":28191,"_19309":107809,"_25377":107810,"_2660":107811},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3162":64579,"_27851":64548,"_5":28191,"_19309":107813,"_25377":107814,"_2660":107815},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3162":64580,"_27851":64548,"_5":28191,"_19309":107817,"_25377":107818,"_2660":107819},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3162":64581,"_27851":64548,"_19309":107821,"_5":13254,"_25377":64548,"_2660":107822},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3162":64582,"_27851":64548,"_19309":107824,"_5":13254,"_25377":64548,"_2660":107825},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3162":64583,"_27851":64548,"_19309":107827,"_5":13254,"_25377":64548,"_2660":107828},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3162":64584,"_27851":64548,"_19309":107830,"_5":13254,"_25377":107699,"_2660":107831},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3162":64585,"_27851":64548,"_19309":107833,"_5":13254,"_25377":107699,"_2660":107834},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3162":64586,"_27851":64548,"_19309":107836,"_5":13254,"_25377":107699,"_2660":107837},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3162":64587,"_27851":64548,"_19309":107839,"_5":13254,"_25377":107699,"_2660":107840},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3162":64588,"_27851":64548,"_19309":107842,"_5":13254,"_25377":107699,"_2660":107843},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3162":64589,"_27851":64548,"_19309":107845,"_5":13254,"_25377":107699,"_2660":107846},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3162":64590,"_27851":64548,"_19309":107848,"_5":13254,"_25377":107703,"_2660":107849},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3162":64591,"_27851":64548,"_19309":107851,"_5":13254,"_25377":107703,"_2660":107852},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3162":64592,"_27851":64548,"_19309":107854,"_5":13254,"_25377":107707,"_2660":107855},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3162":64593,"_27851":64548,"_19309":107857,"_5":13254,"_25377":107707,"_2660":107858},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3162":64594,"_27851":64548,"_19309":107860,"_5":13254,"_25377":107707,"_2660":107861},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3162":64595,"_27851":64548,"_19309":107863,"_5":13254,"_25377":107707,"_2660":107864},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3162":64596,"_27851":64548,"_19309":107866,"_5":13254,"_25377":107707,"_2660":107867},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3162":64597,"_27851":64548,"_19309":107869,"_5":13254,"_25377":107707,"_2660":107870},[],"Carga por separado las políticas concedidas a cada principal.",{"_3162":64598,"_27851":64548,"_19309":107872,"_5":13254,"_25377":107707,"_2660":107873},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3162":64599,"_27851":64548,"_19309":107875,"_5":13254,"_25377":107707,"_2660":107876},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3162":64600,"_27851":64548,"_19309":107878,"_5":13254,"_25377":107707,"_2660":107879},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3162":64601,"_27851":64548,"_19309":107881,"_5":13254,"_25377":107707,"_2660":107882},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3162":64602,"_27851":64548,"_19309":107884,"_5":13254,"_25377":107707,"_2660":107885},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3162":64603,"_27851":64548,"_19309":107887,"_5":13254,"_25377":107707,"_2660":107888},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3162":64604,"_27851":64548,"_19309":107890,"_5":13254,"_25377":107711,"_2660":107891},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3162":64605,"_27851":64548,"_19309":107893,"_5":13254,"_25377":107711,"_2660":107894},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3162":64606,"_27851":64548,"_19309":107896,"_5":13254,"_25377":107711,"_2660":107897},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3162":64607,"_27851":64548,"_19309":107899,"_5":13254,"_25377":107711,"_2660":107900},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3162":64608,"_27851":64548,"_19309":107902,"_5":13254,"_25377":107711,"_2660":107903},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3162":64609,"_27851":64548,"_19309":107905,"_5":13254,"_25377":107711,"_2660":107906},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3162":64610,"_27851":64548,"_19309":107908,"_5":13254,"_25377":107711,"_2660":107909},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3162":64611,"_27851":64548,"_19309":107911,"_5":13254,"_25377":107711,"_2660":107912},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3162":64612,"_27851":64548,"_19309":107914,"_5":13254,"_25377":107715,"_2660":107915},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3162":64613,"_27851":64548,"_19309":107917,"_5":13254,"_25377":107715,"_2660":107918},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3162":64614,"_27851":64548,"_19309":107920,"_5":13254,"_25377":107715,"_2660":107921},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3162":64615,"_27851":64548,"_19309":107923,"_5":13254,"_25377":107715,"_2660":107924},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3162":64616,"_27851":64548,"_19309":107926,"_5":13254,"_25377":107715,"_2660":107927},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3162":64617,"_27851":64548,"_19309":107929,"_5":13254,"_25377":107715,"_2660":107930},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3162":64618,"_27851":64548,"_19309":107932,"_5":13254,"_25377":107715,"_2660":107933},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3162":64619,"_27851":64548,"_19309":107935,"_5":13254,"_25377":107715,"_2660":107936},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3162":64620,"_27851":64548,"_19309":107938,"_5":13254,"_25377":107715,"_2660":107939},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3162":64621,"_27851":64548,"_19309":107941,"_5":13254,"_25377":107715,"_2660":107942},[],"Las acciones se dividen en dos grupos:",{"_3162":64622,"_27851":64548,"_19309":107944,"_5":13254,"_25377":107715,"_2660":107945},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3162":64623,"_27851":64548,"_19309":107947,"_5":13254,"_25377":107715,"_2660":107948},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3162":64624,"_27851":64548,"_19309":107950,"_5":13254,"_25377":107715,"_2660":107951},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3162":64625,"_27851":64548,"_19309":107953,"_5":13254,"_25377":107719,"_2660":107954},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3162":64626,"_27851":64548,"_19309":107956,"_5":13254,"_25377":107719,"_2660":107957},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3162":64627,"_27851":64548,"_19309":107959,"_5":13254,"_25377":107719,"_2660":107960},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3162":64628,"_27851":64548,"_19309":107962,"_5":13254,"_25377":107723,"_2660":107963},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3162":64629,"_27851":64548,"_19309":107965,"_5":13254,"_25377":107723,"_2660":107966},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3162":64630,"_27851":64548,"_19309":107968,"_5":13254,"_25377":107723,"_2660":107969},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3162":64631,"_27851":64548,"_19309":107971,"_5":13254,"_25377":107723,"_2660":107972},[],"Los operadores implementados son:",{"_3162":64632,"_27851":64548,"_19309":107974,"_5":13254,"_25377":107723,"_2660":107975},[],"`equals`, para igualdad exacta;",{"_3162":64633,"_27851":64548,"_19309":107977,"_5":13254,"_25377":107723,"_2660":107978},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3162":64634,"_27851":64548,"_19309":107980,"_5":13254,"_25377":107723,"_2660":107981},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3162":64635,"_27851":64548,"_19309":107983,"_5":13254,"_25377":107723,"_2660":107984},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3162":64636,"_27851":64548,"_19309":107986,"_5":13254,"_25377":107727,"_2660":107987},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3162":64637,"_27851":64548,"_19309":107989,"_5":13254,"_25377":107727,"_2660":107990},[],"Los modos disponibles son:",{"_3162":64638,"_27851":64548,"_19309":107992,"_5":13254,"_25377":107727,"_2660":107993},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3162":64639,"_27851":64548,"_19309":107995,"_5":13254,"_25377":107727,"_2660":107996},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3162":64640,"_27851":64548,"_19309":107998,"_5":13254,"_25377":107727,"_2660":107999},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3162":64641,"_27851":64548,"_19309":108001,"_5":13254,"_25377":107727,"_2660":108002},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3162":64642,"_27851":64548,"_19309":108004,"_5":13254,"_25377":107727,"_2660":108005},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3162":64643,"_27851":64548,"_19309":108007,"_5":13254,"_25377":107727,"_2660":108008},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3162":64644,"_27851":64548,"_19309":108010,"_5":13254,"_25377":107731,"_2660":108011},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3162":64645,"_27851":64548,"_19309":108013,"_5":13254,"_25377":107731,"_2660":108014},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3162":64646,"_27851":64548,"_19309":108016,"_5":13254,"_25377":107731,"_2660":108017},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3162":64647,"_27851":64548,"_19309":108019,"_5":13254,"_25377":107731,"_2660":108020},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3162":64648,"_27851":64548,"_19309":108022,"_5":13254,"_25377":107739,"_2660":108023},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3162":64649,"_27851":64548,"_19309":108025,"_5":13254,"_25377":107739,"_2660":108026},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3162":64650,"_27851":64548,"_19309":108028,"_5":13254,"_25377":107743,"_2660":108029},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3162":64651,"_27851":64548,"_19309":108031,"_5":13254,"_25377":107743,"_2660":108032},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3162":64652,"_27851":64548,"_19309":108034,"_5":13254,"_25377":107747,"_2660":108035},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3162":64653,"_27851":64548,"_19309":108037,"_5":13254,"_25377":107747,"_2660":108038},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3162":64654,"_27851":64548,"_19309":108040,"_5":13254,"_25377":107747,"_2660":108041},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3162":64655,"_27851":64548,"_19309":108043,"_5":13254,"_25377":107751,"_2660":108044},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3162":64656,"_27851":64548,"_19309":108046,"_5":13254,"_25377":107751,"_2660":108047},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3162":64657,"_27851":64548,"_19309":108049,"_5":13254,"_25377":107751,"_2660":108050},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3162":64658,"_27851":64548,"_19309":108052,"_5":13254,"_25377":107751,"_2660":108053},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3162":64659,"_27851":64548,"_19309":108055,"_5":13254,"_25377":107751,"_2660":108056},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3162":64660,"_27851":64548,"_19309":108058,"_5":13254,"_25377":107751,"_2660":108059},[],"Ten en cuenta que:",{"_3162":64661,"_27851":64548,"_19309":108061,"_5":13254,"_25377":107751,"_2660":108062},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3162":64662,"_27851":64548,"_19309":108064,"_5":13254,"_25377":107751,"_2660":108065},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3162":64663,"_27851":64548,"_19309":108067,"_5":13254,"_25377":107751,"_2660":108068},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3162":64664,"_27851":64548,"_19309":108070,"_5":13254,"_25377":107755,"_2660":108071},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3162":64665,"_27851":64548,"_19309":108073,"_5":13254,"_25377":107755,"_2660":108074},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3162":64666,"_27851":64548,"_19309":108076,"_5":13254,"_25377":107755,"_2660":108077},[],"acceso completo y de solo lectura a KMS;",{"_3162":64667,"_27851":64548,"_19309":108079,"_5":13254,"_25377":107755,"_2660":108080},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3162":64668,"_27851":64548,"_19309":108082,"_5":13254,"_25377":107755,"_2660":108083},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3162":64669,"_27851":64548,"_19309":108085,"_5":13254,"_25377":107755,"_2660":108086},[],"acceso a la interfaz;",{"_3162":64670,"_27851":64548,"_19309":108088,"_5":13254,"_25377":107755,"_2660":108089},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3162":64671,"_27851":64548,"_19309":108091,"_5":13254,"_25377":107755,"_2660":108092},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3162":64672,"_27851":64548,"_19309":108094,"_5":13254,"_25377":107755,"_2660":108095},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3162":64673,"_27851":64548,"_19309":108097,"_5":13254,"_25377":107759,"_2660":108098},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3162":64674,"_27851":64548,"_19309":108100,"_5":13254,"_25377":107759,"_2660":108101},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3162":64675,"_27851":64548,"_19309":108103,"_5":13254,"_25377":107759,"_2660":108104},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3162":64676,"_27851":64548,"_19309":108106,"_5":13254,"_25377":107762,"_2660":108107},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3162":64677,"_27851":64548,"_19309":108109,"_5":13254,"_25377":107766,"_2660":108110},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3162":64678,"_27851":64548,"_19309":108112,"_5":13254,"_25377":107766,"_2660":108113},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3162":64679,"_27851":64548,"_19309":108115,"_5":13254,"_25377":107770,"_2660":108116},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3162":64680,"_27851":64548,"_19309":108118,"_5":13254,"_25377":107774,"_2660":108119},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3162":64681,"_27851":64548,"_19309":108121,"_5":13254,"_25377":107778,"_2660":108122},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3162":64682,"_27851":64548,"_19309":108124,"_5":13254,"_25377":107782,"_2660":108125},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3162":64683,"_27851":64548,"_19309":108127,"_5":13254,"_25377":107782,"_2660":108128},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3162":64684,"_27851":64548,"_19309":108130,"_5":13254,"_25377":107786,"_2660":108131},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3162":64685,"_27851":64548,"_19309":108133,"_5":13254,"_25377":107786,"_2660":108134},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3162":64686,"_27851":64548,"_19309":108136,"_5":13254,"_25377":107786,"_2660":108137},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3162":64687,"_27851":64548,"_19309":108139,"_5":13254,"_25377":107786,"_2660":108140},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3162":64688,"_27851":64548,"_19309":108142,"_5":13254,"_25377":107786,"_2660":108143},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3162":64689,"_27851":64548,"_19309":108145,"_5":13254,"_25377":107786,"_2660":108146},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3162":64690,"_27851":64548,"_19309":108148,"_5":13254,"_25377":107786,"_2660":108149},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3162":64691,"_27851":64548,"_19309":108151,"_5":13254,"_25377":107786,"_2660":108152},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3162":64692,"_27851":64548,"_19309":108154,"_5":13254,"_25377":107790,"_2660":108155},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3162":64693,"_27851":64548,"_19309":108157,"_5":13254,"_25377":107790,"_2660":108158},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3162":64694,"_27851":64548,"_19309":108160,"_5":13254,"_25377":107790,"_2660":108161},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3162":64695,"_27851":64548,"_19309":108163,"_5":13254,"_25377":107794,"_2660":108164},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3162":64696,"_27851":64548,"_19309":108166,"_5":13254,"_25377":107794,"_2660":108167},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3162":64697,"_27851":64548,"_19309":108169,"_5":13254,"_25377":107794,"_2660":108170},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3162":64698,"_27851":64548,"_19309":108172,"_5":13254,"_25377":107794,"_2660":108173},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3162":64699,"_27851":64548,"_19309":108175,"_5":13254,"_25377":107794,"_2660":108176},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3162":64700,"_27851":64548,"_19309":108178,"_5":13254,"_25377":107794,"_2660":108179},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3162":64701,"_27851":64548,"_19309":108181,"_5":13254,"_25377":107794,"_2660":108182},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3162":64702,"_27851":64548,"_19309":108184,"_5":13254,"_25377":107794,"_2660":108185},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3162":64703,"_27851":64548,"_19309":108187,"_5":13254,"_25377":107802,"_2660":108188},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3162":64704,"_27851":64548,"_19309":108190,"_5":13254,"_25377":107806,"_2660":108191},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3162":64705,"_27851":64548,"_19309":108193,"_5":13254,"_25377":107806,"_2660":108194},[],"que exista un principal activo del tipo correcto;",{"_3162":64706,"_27851":64548,"_19309":108196,"_5":13254,"_25377":107806,"_2660":108197},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3162":64707,"_27851":64548,"_19309":108199,"_5":13254,"_25377":107806,"_2660":108200},[],"que todas las condiciones del principal se cumplan;",{"_3162":64708,"_27851":64548,"_19309":108202,"_5":13254,"_25377":107806,"_2660":108203},[],"que el principal tenga concedida la política esperada;",{"_3162":64709,"_27851":64548,"_19309":108205,"_5":13254,"_25377":107806,"_2660":108206},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3162":64710,"_27851":64548,"_19309":108208,"_5":13254,"_25377":107806,"_2660":108209},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3162":64711,"_27851":64548,"_19309":108211,"_5":13254,"_25377":107806,"_2660":108212},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3162":64712,"_27851":64548,"_19309":108214,"_5":13254,"_25377":107810,"_2660":108215},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3162":64713,"_27851":64548,"_19309":108217,"_5":13254,"_25377":107814,"_2660":108218},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3162":64714,"_27851":64548,"_19309":108220,"_5":13254,"_25377":107818,"_2660":108221},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3162":64715,"_27851":64548,"_19309":108223,"_5":13254,"_25377":107818,"_2660":108224},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3162":64716,"_27851":64716,"_5":13585,"_2660":108226,"_28194":108227,"_19309":108228,"_25377":64716},"Alertas y suscripciones",[45228,107691,107692],[],{"_3162":64717,"_27851":64716,"_19309":108230,"_5":13254,"_25377":64716,"_2660":108231},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3162":64718,"_27851":64716,"_5":28191,"_19309":108233,"_25377":108234,"_2660":108235},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3162":64719,"_27851":64716,"_5":28191,"_19309":108237,"_25377":108238,"_2660":108239},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3162":64720,"_27851":64716,"_5":28191,"_19309":108241,"_25377":108242,"_2660":108243},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3162":64721,"_27851":64716,"_5":28191,"_19309":108245,"_25377":108246,"_2660":108247},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3162":64722,"_27851":64716,"_5":28191,"_19309":108249,"_25377":108250,"_2660":108251},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3162":64723,"_27851":64716,"_5":28191,"_19309":108253,"_25377":108254,"_2660":108255},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3162":64724,"_27851":64716,"_5":28191,"_19309":108257,"_25377":108258,"_2660":108259},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3162":64725,"_27851":64716,"_5":28191,"_19309":108261,"_25377":108262,"_2660":108263},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3162":64726,"_27851":64716,"_5":28191,"_19309":108265,"_25377":108266,"_2660":108267},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3162":64727,"_27851":64716,"_5":28191,"_19309":108269,"_25377":108270,"_2660":108271},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3162":64728,"_27851":64716,"_5":28191,"_19309":108273,"_25377":108274,"_2660":108275},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3162":64729,"_27851":64716,"_19309":108277,"_5":13254,"_25377":64716,"_2660":108278},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3162":64730,"_27851":64716,"_19309":108280,"_5":13254,"_25377":108234,"_2660":108281},[],"Un servicio publica un evento de dominio.",{"_3162":64731,"_27851":64716,"_19309":108283,"_5":13254,"_25377":108234,"_2660":108284},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3162":64732,"_27851":64716,"_19309":108286,"_5":13254,"_25377":108234,"_2660":108287},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3162":64733,"_27851":64716,"_19309":108289,"_5":13254,"_25377":108234,"_2660":108290},[],"Lamassu entrega el evento al canal configurado.",{"_3162":64734,"_27851":64716,"_19309":108292,"_5":13254,"_25377":108234,"_2660":108293},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3162":64735,"_27851":64716,"_19309":108295,"_5":13254,"_25377":108238,"_2660":108296},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3162":64736,"_27851":64716,"_19309":108298,"_5":13254,"_25377":108238,"_2660":108299},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3162":64737,"_27851":64716,"_19309":108301,"_5":13254,"_25377":108238,"_2660":108302},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3162":64738,"_27851":64716,"_19309":108304,"_5":13254,"_25377":108238,"_2660":108305},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3162":64739,"_27851":64716,"_19309":108307,"_5":13254,"_25377":108238,"_2660":108308},[],"`apikey_options` necesita `header` y `key`.",{"_3162":64740,"_27851":64716,"_19309":108310,"_5":13254,"_25377":108238,"_2660":108311},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3162":64741,"_27851":64716,"_19309":108313,"_5":13254,"_25377":108238,"_2660":108314},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3162":64742,"_27851":64716,"_19309":108316,"_5":13254,"_25377":108238,"_2660":108317},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3162":64743,"_27851":64716,"_19309":108319,"_5":13254,"_25377":108246,"_2660":108320},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3162":64744,"_27851":64716,"_19309":108322,"_5":13254,"_25377":108250,"_2660":108323},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3162":64745,"_27851":64716,"_19309":108325,"_5":13254,"_25377":108254,"_2660":108326},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3162":64746,"_27851":64716,"_19309":108328,"_5":13254,"_25377":108254,"_2660":108329},[],"**None** notifica todas las instancias del evento.",{"_3162":64747,"_27851":64716,"_19309":108331,"_5":13254,"_25377":108254,"_2660":108332},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3162":64748,"_27851":64716,"_19309":108334,"_5":13254,"_25377":108254,"_2660":108335},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3162":64749,"_27851":64716,"_19309":108337,"_5":13254,"_25377":108254,"_2660":108338},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3162":64750,"_27851":64716,"_19309":108340,"_5":13254,"_25377":108254,"_2660":108341},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3162":64751,"_27851":64716,"_19309":108343,"_5":13254,"_25377":108258,"_2660":108344},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3162":64752,"_27851":64716,"_19309":108346,"_5":13254,"_25377":108262,"_2660":108347},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3162":64753,"_27851":64716,"_19309":108349,"_5":13254,"_25377":108262,"_2660":108350},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3162":64754,"_27851":64716,"_19309":108352,"_5":13254,"_25377":108262,"_2660":108353},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3162":64755,"_27851":64716,"_19309":108355,"_5":13254,"_25377":108262,"_2660":108356},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3162":64756,"_27851":64716,"_19309":108358,"_5":13254,"_25377":108262,"_2660":108359},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3162":64757,"_27851":64716,"_19309":108361,"_5":13254,"_25377":108262,"_2660":108362},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3162":64758,"_27851":64716,"_19309":108364,"_5":13254,"_25377":108262,"_2660":108365},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3162":64759,"_27851":64716,"_19309":108367,"_5":13254,"_25377":108262,"_2660":108368},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3162":64760,"_27851":64716,"_19309":108370,"_5":13254,"_25377":108266,"_2660":108371},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3162":64761,"_27851":64716,"_19309":108373,"_5":13254,"_25377":108266,"_2660":108374},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3162":64762,"_27851":64716,"_19309":108376,"_5":13254,"_25377":108266,"_2660":108377},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3162":64763,"_27851":64716,"_19309":108379,"_5":13254,"_25377":108266,"_2660":108380},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3162":64764,"_27851":64716,"_19309":108382,"_5":13254,"_25377":108266,"_2660":108383},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3162":64765,"_27851":64716,"_19309":108385,"_5":13254,"_25377":108266,"_2660":108386},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3162":64766,"_27851":64716,"_19309":108388,"_5":13254,"_25377":108266,"_2660":108389},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3162":64767,"_27851":64716,"_19309":108391,"_5":13254,"_25377":108266,"_2660":108392},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3162":64768,"_27851":64716,"_19309":108394,"_5":13254,"_25377":108270,"_2660":108395},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3162":64769,"_27851":64716,"_19309":108397,"_5":13254,"_25377":108270,"_2660":108398},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3162":64770,"_27851":64716,"_19309":108400,"_5":13254,"_25377":108274,"_2660":108401},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3162":64771,"_27851":64716,"_19309":108403,"_5":13254,"_25377":108274,"_2660":108404},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3162":64772,"_27851":64716,"_19309":108406,"_5":13254,"_25377":108274,"_2660":108407},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3162":64773,"_27851":64716,"_19309":108409,"_5":13254,"_25377":108274,"_2660":108410},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3162":64774,"_27851":64716,"_19309":108412,"_5":13254,"_25377":108274,"_2660":108413},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3162":64775,"_27851":64716,"_19309":108415,"_5":13254,"_25377":108274,"_2660":108416},[],"**Validación:** `va.role.crl.create`.",{"_3162":64776,"_27851":64716,"_19309":108418,"_5":13254,"_25377":108274,"_2660":108419},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3162":64777,"_27851":64716,"_19309":108421,"_5":13254,"_25377":108274,"_2660":108422},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3162":64778,"_27851":64778,"_5":13585,"_2660":108424,"_28194":108425,"_19309":108426,"_25377":64778},"Registros de auditoría",[45228,107691,107692],[],{"_3162":64779,"_27851":64778,"_19309":108428,"_5":13254,"_25377":64778,"_2660":108429},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3162":64780,"_27851":64778,"_5":28191,"_19309":108431,"_25377":108432,"_2660":108433},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3162":64781,"_27851":64778,"_5":28191,"_19309":108435,"_25377":108436,"_2660":108437},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3162":64782,"_27851":64778,"_5":28191,"_19309":108439,"_25377":108440,"_2660":108441},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3162":64783,"_27851":64778,"_5":28191,"_19309":108443,"_25377":108444,"_2660":108445},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3162":64784,"_27851":64778,"_5":28191,"_19309":108447,"_25377":108448,"_2660":108449},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3162":64785,"_27851":64778,"_5":28191,"_19309":108451,"_25377":108452,"_2660":108453},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3162":64786,"_27851":64778,"_5":28191,"_19309":108455,"_25377":108456,"_2660":108457},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3162":64787,"_27851":64778,"_5":28191,"_19309":108459,"_25377":108460,"_2660":108461},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3162":64788,"_27851":64778,"_5":28191,"_19309":108463,"_25377":108464,"_2660":108465},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3162":64789,"_27851":64778,"_5":28191,"_19309":108467,"_25377":108468,"_2660":108469},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3162":64790,"_27851":64778,"_5":28191,"_19309":108471,"_25377":108472,"_2660":108473},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3162":64791,"_27851":64778,"_19309":108475,"_5":13254,"_25377":64778,"_2660":108476},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3162":64792,"_27851":64778,"_19309":108478,"_5":13254,"_25377":108432,"_2660":108479},[],"El cuerpo de auditoría incluye:",{"_3162":64793,"_27851":64778,"_19309":108481,"_5":13254,"_25377":108432,"_2660":108482},[],"input: datos recibidos por la operación;",{"_3162":64794,"_27851":64778,"_19309":108484,"_5":13254,"_25377":108432,"_2660":108485},[],"has\\_error: indica si el servicio devolvió un error;",{"_3162":64795,"_27851":64778,"_19309":108487,"_5":13254,"_25377":108432,"_2660":108488},[],"output: resultado producido o mensaje de error;",{"_3162":64796,"_27851":64778,"_19309":108490,"_5":13254,"_25377":108432,"_2660":108491},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3162":64797,"_27851":64778,"_19309":108493,"_5":13254,"_25377":108432,"_2660":108494},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3162":64798,"_27851":64778,"_19309":108496,"_5":13254,"_25377":108432,"_2660":108497},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3162":64799,"_27851":64778,"_19309":108499,"_5":13254,"_25377":108436,"_2660":108500},[],"El backend aplica auditoría a mutaciones de:",{"_3162":64800,"_27851":64778,"_19309":108502,"_5":13254,"_25377":108436,"_2660":108503},[],"autoridades, certificados y perfiles de emisión;",{"_3162":64801,"_27851":64778,"_19309":108505,"_5":13254,"_25377":108436,"_2660":108506},[],"claves y motores KMS;",{"_3162":64802,"_27851":64778,"_19309":108508,"_5":13254,"_25377":108436,"_2660":108509},[],"dispositivos e identidades;",{"_3162":64803,"_27851":64778,"_19309":108511,"_5":13254,"_25377":108436,"_2660":108512},[],"DMS y operaciones de enrolamiento;",{"_3162":64804,"_27851":64778,"_19309":108514,"_5":13254,"_25377":108436,"_2660":108515},[],"funciones de validación y CRL;",{"_3162":64805,"_27851":64778,"_19309":108517,"_5":13254,"_25377":108436,"_2660":108518},[],"principales, políticas y concesiones de autorización.",{"_3162":64806,"_27851":64778,"_19309":108520,"_5":13254,"_25377":108436,"_2660":108521},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3162":64807,"_27851":64778,"_19309":108523,"_5":13254,"_25377":108440,"_2660":108524},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3162":64808,"_27851":64778,"_19309":108526,"_5":13254,"_25377":108440,"_2660":108527},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3162":64809,"_27851":64778,"_19309":108529,"_5":13254,"_25377":108440,"_2660":108530},[],"Diseña el consumidor para:",{"_3162":64810,"_27851":64778,"_19309":108532,"_5":13254,"_25377":108440,"_2660":108533},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3162":64811,"_27851":64778,"_19309":108535,"_5":13254,"_25377":108440,"_2660":108536},[],"conservar el CloudEvent completo sin modificar;",{"_3162":64812,"_27851":64778,"_19309":108538,"_5":13254,"_25377":108440,"_2660":108539},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3162":64813,"_27851":64778,"_19309":108541,"_5":13254,"_25377":108440,"_2660":108542},[],"cifrar en tránsito y en reposo;",{"_3162":64814,"_27851":64778,"_19309":108544,"_5":13254,"_25377":108440,"_2660":108545},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3162":64815,"_27851":64778,"_19309":108547,"_5":13254,"_25377":108440,"_2660":108548},[],"aplicar una política explícita de retención y legal hold;",{"_3162":64816,"_27851":64778,"_19309":108550,"_5":13254,"_25377":108440,"_2660":108551},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3162":64817,"_27851":64778,"_19309":108553,"_5":13254,"_25377":108444,"_2660":108554},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3162":64818,"_27851":64778,"_19309":108556,"_5":13254,"_25377":108444,"_2660":108557},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3162":64819,"_27851":64778,"_19309":108559,"_5":13254,"_25377":108452,"_2660":108560},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3162":64820,"_27851":64778,"_19309":108562,"_5":13254,"_25377":108456,"_2660":108563},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3162":64821,"_27851":64778,"_19309":108565,"_5":13254,"_25377":108460,"_2660":108566},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3162":64822,"_27851":64778,"_19309":108568,"_5":13254,"_25377":108464,"_2660":108569},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3162":64823,"_27851":64778,"_19309":108571,"_5":13254,"_25377":108468,"_2660":108572},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3162":64824,"_27851":64778,"_19309":108574,"_5":13254,"_25377":108472,"_2660":108575},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3162":64825,"_27851":64778,"_19309":108577,"_5":13254,"_25377":108472,"_2660":108578},[],"aparece un evento de auditoría correcto;",{"_3162":64826,"_27851":64778,"_19309":108580,"_5":13254,"_25377":108472,"_2660":108581},[],"el principal coincide con la identidad utilizada;",{"_3162":64827,"_27851":64778,"_19309":108583,"_5":13254,"_25377":108472,"_2660":108584},[],"el consumidor lo persiste una sola vez;",{"_3162":64828,"_27851":64778,"_19309":108586,"_5":13254,"_25377":108472,"_2660":108587},[],"puede recuperarse por recurso, actor y periodo;",{"_3162":64829,"_27851":64778,"_19309":108589,"_5":13254,"_25377":108472,"_2660":108590},[],"una interrupción del consumidor produce una alerta.",{"_3162":64830,"_27851":64778,"_19309":108592,"_5":13254,"_25377":108472,"_2660":108593},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3162":64831,"_27851":64831,"_5":13585,"_2660":108595,"_28194":108596,"_19309":108597,"_25377":64831},"Arquitectura de la plataforma",[45228,107691],[],{"_3162":64832,"_27851":64831,"_19309":108599,"_5":13254,"_25377":64831,"_2660":108600},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3162":64833,"_27851":64831,"_5":28191,"_19309":108602,"_25377":108603,"_2660":108604},[],"/docs/pr-preview/pr-39/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3162":64834,"_27851":64831,"_5":28191,"_19309":108606,"_25377":108607,"_2660":108608},[],"/docs/pr-preview/pr-39/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3162":64835,"_27851":64831,"_5":28191,"_19309":108610,"_25377":108611,"_2660":108612},[],"/docs/pr-preview/pr-39/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3162":64836,"_27851":64831,"_5":28191,"_19309":108614,"_25377":108615,"_2660":108616},[],"/docs/pr-preview/pr-39/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3162":64837,"_27851":64831,"_5":28191,"_19309":108618,"_25377":108619,"_2660":108620},[],"/docs/pr-preview/pr-39/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3162":64838,"_27851":64831,"_19309":108622,"_5":13254,"_25377":64831,"_2660":108623},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3162":64839,"_27851":64831,"_19309":108625,"_5":13254,"_25377":64831,"_2660":108626},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3162":64840,"_27851":64831,"_19309":108628,"_5":13254,"_25377":108603,"_2660":108629},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3162":64841,"_27851":64831,"_19309":108631,"_5":13254,"_25377":108607,"_2660":108632},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3162":64842,"_27851":64831,"_19309":108634,"_5":13254,"_25377":108611,"_2660":108635},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3162":64843,"_27851":64831,"_19309":108637,"_5":13254,"_25377":108615,"_2660":108638},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3162":64844,"_27851":64831,"_19309":108640,"_5":13254,"_25377":108619,"_2660":108641},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3162":64845,"_27851":64845,"_5":13585,"_2660":108643,"_28194":108644,"_19309":108645,"_25377":64845},"Cómo funciona Lamassu",[45228,107691],[],{"_3162":64846,"_27851":64845,"_19309":108647,"_5":13254,"_25377":64845,"_2660":108648},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3162":64847,"_27851":64845,"_5":28191,"_19309":108650,"_25377":108651,"_2660":108652},[],"/docs/pr-preview/pr-39/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3162":64848,"_27851":64845,"_5":28191,"_19309":108654,"_25377":108655,"_2660":108656},[],"/docs/pr-preview/pr-39/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3162":64849,"_27851":64845,"_19309":108658,"_5":13254,"_25377":64845,"_2660":108659},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3162":64850,"_27851":64845,"_19309":108661,"_5":13254,"_25377":108651,"_2660":108662},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3162":64851,"_27851":64845,"_19309":108664,"_5":13254,"_25377":108651,"_2660":108665},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3162":64852,"_27851":64845,"_19309":108667,"_5":13254,"_25377":108651,"_2660":108668},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3162":64853,"_27851":64845,"_19309":108670,"_5":13254,"_25377":108651,"_2660":108671},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3162":64854,"_27851":64845,"_19309":108673,"_5":13254,"_25377":108651,"_2660":108674},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3162":64855,"_27851":64845,"_19309":108676,"_5":13254,"_25377":108655,"_2660":108677},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3162":64856,"_27851":64845,"_19309":108679,"_5":13254,"_25377":108655,"_2660":108680},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3162":64857,"_27851":64845,"_19309":108682,"_5":13254,"_25377":108655,"_2660":108683},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3162":64858,"_27851":64845,"_19309":108685,"_5":13254,"_25377":108655,"_2660":108686},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3162":64859,"_27851":64845,"_19309":108688,"_5":13254,"_25377":108655,"_2660":108689},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3162":64860,"_27851":64845,"_19309":108691,"_5":13254,"_25377":108655,"_2660":108692},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3162":64861,"_27851":64845,"_19309":108694,"_5":13254,"_25377":108655,"_2660":108695},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3162":64862,"_27851":64862,"_5":13585,"_2660":108697,"_28194":108698,"_19309":108699,"_25377":64862},"Dispositivos e identidades",[45228,107691,47616,108697],[],{"_3162":64863,"_27851":64862,"_19309":108701,"_5":13254,"_25377":64862,"_2660":108702},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3162":64864,"_27851":64862,"_5":28191,"_19309":108704,"_25377":108705,"_2660":108706},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3162":64865,"_27851":64862,"_5":28191,"_19309":108708,"_25377":108709,"_2660":108710},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3162":64866,"_27851":64862,"_5":28191,"_19309":108712,"_25377":108713,"_2660":108714},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3162":64867,"_27851":64862,"_5":28191,"_19309":108716,"_25377":108717,"_2660":108718},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3162":64868,"_27851":64862,"_5":28191,"_19309":108720,"_25377":108721,"_2660":108722},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3162":64869,"_27851":64862,"_5":28191,"_19309":108724,"_25377":108725,"_2660":108726},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3162":64870,"_27851":64862,"_5":28191,"_19309":108728,"_25377":108729,"_2660":108730},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3162":64871,"_27851":64862,"_5":28191,"_19309":108732,"_25377":108733,"_2660":108734},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3162":64872,"_27851":64862,"_5":28191,"_19309":108736,"_25377":108737,"_2660":108738},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3162":64873,"_27851":64862,"_5":28191,"_19309":108740,"_25377":108741,"_2660":108742},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3162":64874,"_27851":64862,"_5":28191,"_19309":108744,"_25377":108745,"_2660":108746},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3162":64875,"_27851":64862,"_19309":108748,"_5":13254,"_25377":64862,"_2660":108749},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3162":64876,"_27851":64862,"_19309":108751,"_5":13254,"_25377":64862,"_2660":108752},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3162":64877,"_27851":64862,"_19309":108754,"_5":13254,"_25377":108705,"_2660":108755},[],"Vista operativa",{"_3162":64878,"_27851":64862,"_19309":108757,"_5":13254,"_25377":108705,"_2660":108758},[],"Interpretación",{"_3162":64879,"_27851":64862,"_19309":108760,"_5":13254,"_25377":108705,"_2660":47679},[],{"_3162":64880,"_27851":64862,"_19309":108762,"_5":13254,"_25377":108705,"_2660":108763},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3162":64881,"_27851":64862,"_19309":108765,"_5":13254,"_25377":108705,"_2660":47685},[],{"_3162":64882,"_27851":64862,"_19309":108767,"_5":13254,"_25377":108705,"_2660":108768},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3162":64883,"_27851":64862,"_19309":108770,"_5":13254,"_25377":108705,"_2660":47691},[],{"_3162":64884,"_27851":64862,"_19309":108772,"_5":13254,"_25377":108705,"_2660":108773},[],"La identidad está en la ventana operativa de renovación.",{"_3162":64885,"_27851":64862,"_19309":108775,"_5":13254,"_25377":108705,"_2660":47697},[],{"_3162":64886,"_27851":64862,"_19309":108777,"_5":13254,"_25377":108705,"_2660":108778},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3162":64887,"_27851":64862,"_19309":108780,"_5":13254,"_25377":108705,"_2660":47703},[],{"_3162":64888,"_27851":64862,"_19309":108782,"_5":13254,"_25377":108705,"_2660":108783},[],"La identidad ha vencido.",{"_3162":64889,"_27851":64862,"_19309":108785,"_5":13254,"_25377":108705,"_2660":47709},[],{"_3162":64890,"_27851":64862,"_19309":108787,"_5":13254,"_25377":108705,"_2660":108788},[],"La identidad está marcada como revocada.",{"_3162":64891,"_27851":64862,"_19309":108790,"_5":13254,"_25377":108705,"_2660":47715},[],{"_3162":64892,"_27851":64862,"_19309":108792,"_5":13254,"_25377":108705,"_2660":108793},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3162":64893,"_27851":64862,"_19309":108795,"_5":13254,"_25377":108705,"_2660":108796},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3162":64894,"_27851":64862,"_19309":108798,"_5":13254,"_25377":108709,"_2660":108799},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3162":64895,"_27851":64862,"_19309":108801,"_5":13254,"_25377":108709,"_2660":108802},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3162":64896,"_27851":64862,"_19309":108804,"_5":13254,"_25377":108709,"_2660":108805},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3162":64897,"_27851":64862,"_19309":108807,"_5":13254,"_25377":108709,"_2660":108808},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3162":64898,"_27851":64862,"_19309":108810,"_5":13254,"_25377":108713,"_2660":108811},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3162":64899,"_27851":64862,"_19309":108813,"_5":13254,"_25377":108717,"_2660":108814},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3162":64900,"_27851":64862,"_19309":108816,"_5":13254,"_25377":108721,"_2660":108817},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3162":64901,"_27851":64862,"_19309":108819,"_5":13254,"_25377":108725,"_2660":108820},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3162":64902,"_27851":64862,"_19309":108822,"_5":13254,"_25377":108729,"_2660":108823},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3162":64903,"_27851":64862,"_19309":108825,"_5":13254,"_25377":108729,"_2660":108826},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3162":64904,"_27851":64862,"_19309":108828,"_5":13254,"_25377":108733,"_2660":108829},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3162":64905,"_27851":64862,"_19309":108831,"_5":13254,"_25377":108733,"_2660":108832},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3162":64906,"_27851":64862,"_19309":108834,"_5":13254,"_25377":108733,"_2660":108835},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3162":64907,"_27851":64862,"_19309":108837,"_5":13254,"_25377":108733,"_2660":108838},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3162":64908,"_27851":64862,"_19309":108840,"_5":13254,"_25377":108733,"_2660":108841},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3162":64909,"_27851":64862,"_19309":108843,"_5":13254,"_25377":108733,"_2660":108844},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3162":64910,"_27851":64862,"_19309":108846,"_5":13254,"_25377":108737,"_2660":108847},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3162":64911,"_27851":64862,"_19309":108849,"_5":13254,"_25377":108737,"_2660":108850},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3162":64912,"_27851":64862,"_19309":108852,"_5":13254,"_25377":108741,"_2660":108853},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3162":64913,"_27851":64862,"_19309":108855,"_5":13254,"_25377":108741,"_2660":108856},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3162":64914,"_27851":64862,"_19309":108858,"_5":13254,"_25377":108741,"_2660":108859},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3162":64915,"_27851":64862,"_19309":108861,"_5":13254,"_25377":108741,"_2660":108862},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3162":64916,"_27851":64862,"_19309":108864,"_5":13254,"_25377":108745,"_2660":108865},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3162":64917,"_27851":64862,"_19309":108867,"_5":13254,"_25377":108745,"_2660":108868},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3162":64918,"_27851":64918,"_5":13585,"_2660":108870,"_28194":108871,"_19309":108873,"_25377":64918},"Identidad inicial y autenticación",[45228,107691,47616,108697,108872],"Enrolamiento con PKI",[],{"_3162":64919,"_27851":64918,"_19309":108875,"_5":13254,"_25377":64918,"_2660":108876},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3162":64920,"_27851":64918,"_5":28191,"_19309":108878,"_25377":108879,"_2660":108880},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3162":64921,"_27851":64918,"_5":28191,"_19309":108882,"_25377":108883,"_2660":108884},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3162":64922,"_27851":64918,"_5":28191,"_19309":108886,"_25377":108887,"_2660":108888},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3162":64923,"_27851":64918,"_5":28191,"_19309":108890,"_25377":108891,"_2660":108892},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3162":64924,"_27851":64918,"_5":28191,"_19309":108894,"_25377":108895,"_2660":108896},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3162":64925,"_27851":64918,"_19309":108898,"_5":13254,"_25377":64918,"_2660":108899},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3162":64926,"_27851":64918,"_19309":108901,"_5":13254,"_25377":108879,"_2660":108902},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3162":64927,"_27851":64918,"_19309":108904,"_5":13254,"_25377":108879,"_2660":108905},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3162":64928,"_27851":64918,"_19309":108907,"_5":13254,"_25377":108883,"_2660":108908},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3162":64929,"_27851":64918,"_19309":108910,"_5":13254,"_25377":108883,"_2660":108911},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3162":64930,"_27851":64918,"_19309":108913,"_5":13254,"_25377":108883,"_2660":108914},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3162":64931,"_27851":64918,"_19309":108916,"_5":13254,"_25377":108887,"_2660":108917},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3162":64932,"_27851":64918,"_19309":108919,"_5":13254,"_25377":108887,"_2660":108920},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3162":64933,"_27851":64918,"_19309":108922,"_5":13254,"_25377":108891,"_2660":108923},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3162":64934,"_27851":64918,"_19309":108925,"_5":13254,"_25377":108891,"_2660":108926},[],"Ejemplo de cuerpo:",{"_3162":64935,"_27851":64918,"_19309":108928,"_5":13254,"_25377":108891,"_2660":108929},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3162":64936,"_27851":64918,"_19309":108931,"_5":13254,"_25377":108891,"_2660":108932},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3162":64937,"_27851":64918,"_19309":108934,"_5":13254,"_25377":108891,"_2660":108935},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3162":64938,"_27851":64918,"_19309":108937,"_5":13254,"_25377":108891,"_2660":108938},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3162":64939,"_27851":64918,"_19309":108940,"_5":13254,"_25377":108895,"_2660":108941},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3162":64940,"_27851":64918,"_19309":108943,"_5":13254,"_25377":108895,"_2660":108944},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3162":64941,"_27851":64941,"_5":13585,"_2660":108946,"_28194":108947,"_19309":108948,"_25377":64941},"Configura y opera el DMS",[45228,107691,47616,108697,108872],[],{"_3162":64942,"_27851":64941,"_19309":108950,"_5":13254,"_25377":64941,"_2660":108951},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3162":64943,"_27851":64941,"_5":28191,"_19309":108953,"_25377":108954,"_2660":106357},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3162":64944,"_27851":64941,"_5":28191,"_19309":108956,"_25377":108957,"_2660":108958},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3162":64945,"_27851":64941,"_5":28191,"_19309":108960,"_25377":108961,"_2660":108962},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3162":64946,"_27851":64941,"_5":28191,"_19309":108964,"_25377":108965,"_2660":108966},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3162":64947,"_27851":64941,"_5":28191,"_19309":108968,"_25377":108969,"_2660":108970},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3162":64948,"_27851":64941,"_5":28191,"_19309":108972,"_25377":108973,"_2660":108974},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3162":64949,"_27851":64941,"_5":28191,"_19309":108976,"_25377":108977,"_2660":108978},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3162":64950,"_27851":64941,"_5":28191,"_19309":108980,"_25377":108981,"_2660":108982},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3162":64951,"_27851":64941,"_5":28191,"_19309":108984,"_25377":108985,"_2660":47911},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3162":64952,"_27851":64941,"_5":28191,"_19309":108987,"_25377":108988,"_2660":47915},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3162":64953,"_27851":64941,"_5":28191,"_19309":108990,"_25377":108991,"_2660":108992},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3162":64954,"_27851":64941,"_5":28191,"_19309":108994,"_25377":108995,"_2660":108996},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3162":64955,"_27851":64941,"_5":28191,"_19309":108998,"_25377":108999,"_2660":109000},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3162":64956,"_27851":64941,"_5":28191,"_19309":109002,"_25377":109003,"_2660":109004},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3162":64957,"_27851":64941,"_5":28191,"_19309":109006,"_25377":109007,"_2660":47935},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3162":64958,"_27851":64941,"_5":28191,"_19309":109009,"_25377":109010,"_2660":109011},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3162":64959,"_27851":64941,"_5":28191,"_19309":109013,"_25377":109014,"_2660":109015},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3162":64960,"_27851":64941,"_5":28191,"_19309":109017,"_25377":109018,"_2660":109019},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3162":64961,"_27851":64941,"_19309":109021,"_5":13254,"_25377":64941,"_2660":109022},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3162":64962,"_27851":64941,"_19309":109024,"_5":13254,"_25377":108954,"_2660":109025},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3162":64963,"_27851":64941,"_19309":109027,"_5":13254,"_25377":108954,"_2660":109028},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3162":64964,"_27851":64941,"_19309":109030,"_5":13254,"_25377":108961,"_2660":109031},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3162":64965,"_27851":64941,"_19309":109033,"_5":13254,"_25377":108965,"_2660":109034},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3162":64966,"_27851":64941,"_19309":109036,"_5":13254,"_25377":108969,"_2660":109037},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3162":64967,"_27851":64941,"_19309":109039,"_5":13254,"_25377":108973,"_2660":109040},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3162":64968,"_27851":64941,"_19309":109042,"_5":13254,"_25377":108977,"_2660":109043},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3162":64969,"_27851":64941,"_19309":109045,"_5":13254,"_25377":108985,"_2660":109046},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3162":64970,"_27851":64941,"_19309":109048,"_5":13254,"_25377":108985,"_2660":109049},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3162":64971,"_27851":64941,"_19309":109051,"_5":13254,"_25377":108988,"_2660":109052},[],"Campo de `settings.enrollment_settings`",{"_3162":64972,"_27851":64941,"_19309":109054,"_5":13254,"_25377":108988,"_2660":109055},[],"Decisión",{"_3162":64973,"_27851":64941,"_19309":109057,"_5":13254,"_25377":108988,"_2660":47986},[],{"_3162":64974,"_27851":64941,"_19309":109059,"_5":13254,"_25377":108988,"_2660":109060},[],"`EST_RFC7030` para estas operaciones.",{"_3162":64975,"_27851":64941,"_19309":109062,"_5":13254,"_25377":108988,"_2660":47992},[],{"_3162":64976,"_27851":64941,"_19309":109064,"_5":13254,"_25377":108988,"_2660":109065},[],"ID de la CA que firmará.",{"_3162":64977,"_27851":64941,"_19309":109067,"_5":13254,"_25377":108988,"_2660":47998},[],{"_3162":64978,"_27851":64941,"_19309":109069,"_5":13254,"_25377":108988,"_2660":109070},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3162":64979,"_27851":64941,"_19309":109072,"_5":13254,"_25377":108988,"_2660":48004},[],{"_3162":64980,"_27851":64941,"_19309":109074,"_5":13254,"_25377":108988,"_2660":109075},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3162":64981,"_27851":64941,"_19309":109077,"_5":13254,"_25377":108988,"_2660":48010},[],{"_3162":64982,"_27851":64941,"_19309":109079,"_5":13254,"_25377":108988,"_2660":109080},[],"Uno de los cuatro modos de autenticación.",{"_3162":64983,"_27851":64941,"_19309":109082,"_5":13254,"_25377":108988,"_2660":109083},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3162":64984,"_27851":64941,"_19309":109085,"_5":13254,"_25377":108991,"_2660":109086},[],"Los bloques son independientes:",{"_3162":64985,"_27851":64941,"_19309":109088,"_5":13254,"_25377":108991,"_2660":109089},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3162":64986,"_27851":64941,"_19309":109091,"_5":13254,"_25377":108991,"_2660":109092},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3162":64987,"_27851":64941,"_19309":109094,"_5":13254,"_25377":108991,"_2660":48028},[],{"_3162":64988,"_27851":64941,"_19309":109096,"_5":13254,"_25377":108991,"_2660":109097},[],"Control aplicado en la operación configurada",{"_3162":64989,"_27851":64941,"_19309":109099,"_5":13254,"_25377":108991,"_2660":48034},[],{"_3162":64990,"_27851":64941,"_19309":109101,"_5":13254,"_25377":108991,"_2660":109102},[],"Validación del certificado presentado.",{"_3162":64991,"_27851":64941,"_19309":109104,"_5":13254,"_25377":108991,"_2660":48040},[],{"_3162":64992,"_27851":64941,"_19309":109106,"_5":13254,"_25377":108991,"_2660":109107},[],"Autorización del webhook configurado.",{"_3162":64993,"_27851":64941,"_19309":109109,"_5":13254,"_25377":108991,"_2660":48046},[],{"_3162":64994,"_27851":64941,"_19309":109111,"_5":13254,"_25377":108991,"_2660":109112},[],"Validación del certificado y, después, aprobación del webhook.",{"_3162":64995,"_27851":64941,"_19309":109114,"_5":13254,"_25377":108991,"_2660":48052},[],{"_3162":64996,"_27851":64941,"_19309":109116,"_5":13254,"_25377":108991,"_2660":109117},[],"Sin autenticación del solicitante por el DMS.",{"_3162":64997,"_27851":64941,"_19309":109119,"_5":13254,"_25377":108991,"_2660":109120},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3162":64998,"_27851":64941,"_19309":109122,"_5":13254,"_25377":108991,"_2660":109123},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3162":64999,"_27851":64941,"_19309":109125,"_5":13254,"_25377":108991,"_2660":109126},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3162":65000,"_27851":64941,"_19309":109128,"_5":13254,"_25377":108991,"_2660":109129},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3162":65001,"_27851":64941,"_19309":109131,"_5":13254,"_25377":108995,"_2660":109132},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3162":65002,"_27851":64941,"_19309":109134,"_5":13254,"_25377":108995,"_2660":109135},[],"Campo de `external_webhook_settings`",{"_3162":65003,"_27851":64941,"_19309":109137,"_5":13254,"_25377":108995,"_2660":109055},[],{"_3162":65004,"_27851":64941,"_19309":109139,"_5":13254,"_25377":108995,"_2660":48078},[],{"_3162":65005,"_27851":64941,"_19309":109141,"_5":13254,"_25377":108995,"_2660":109142},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3162":65006,"_27851":64941,"_19309":109144,"_5":13254,"_25377":108995,"_2660":48084},[],{"_3162":65007,"_27851":64941,"_19309":109146,"_5":13254,"_25377":108995,"_2660":109147},[],"`POST` o `PUT`; `POST` por defecto.",{"_3162":65008,"_27851":64941,"_19309":109149,"_5":13254,"_25377":108995,"_2660":48090},[],{"_3162":65009,"_27851":64941,"_19309":109151,"_5":13254,"_25377":108995,"_2660":109152},[],"Etiqueta usada en los logs del servicio.",{"_3162":65010,"_27851":64941,"_19309":109154,"_5":13254,"_25377":108995,"_2660":48096},[],{"_3162":65011,"_27851":64941,"_19309":109156,"_5":13254,"_25377":108995,"_2660":109157},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3162":65012,"_27851":64941,"_19309":109159,"_5":13254,"_25377":108995,"_2660":48102},[],{"_3162":65013,"_27851":64941,"_19309":109161,"_5":13254,"_25377":108995,"_2660":109162},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3162":65014,"_27851":64941,"_19309":109164,"_5":13254,"_25377":108995,"_2660":48108},[],{"_3162":65015,"_27851":64941,"_19309":109166,"_5":13254,"_25377":108995,"_2660":109167},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3162":65016,"_27851":64941,"_19309":109169,"_5":13254,"_25377":108995,"_2660":48114},[],{"_3162":65017,"_27851":64941,"_19309":109171,"_5":13254,"_25377":108995,"_2660":109172},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3162":65018,"_27851":64941,"_19309":109174,"_5":13254,"_25377":108995,"_2660":48120},[],{"_3162":65019,"_27851":64941,"_19309":109176,"_5":13254,"_25377":108995,"_2660":109177},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3162":65020,"_27851":64941,"_19309":109179,"_5":13254,"_25377":108995,"_2660":48126},[],{"_3162":65021,"_27851":64941,"_19309":109181,"_5":13254,"_25377":108995,"_2660":109182},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3162":65022,"_27851":64941,"_19309":109184,"_5":13254,"_25377":108995,"_2660":48132},[],{"_3162":65023,"_27851":64941,"_19309":109186,"_5":13254,"_25377":108995,"_2660":109187},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3162":65024,"_27851":64941,"_19309":109189,"_5":13254,"_25377":108995,"_2660":109190},[],"Reglas de esa configuración:",{"_3162":65025,"_27851":64941,"_19309":109192,"_5":13254,"_25377":108995,"_2660":109193},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3162":65026,"_27851":64941,"_19309":109195,"_5":13254,"_25377":108995,"_2660":109196},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3162":65027,"_27851":64941,"_19309":109198,"_5":13254,"_25377":108995,"_2660":109199},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3162":65028,"_27851":64941,"_19309":109201,"_5":13254,"_25377":108995,"_2660":109202},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3162":65029,"_27851":64941,"_19309":109204,"_5":13254,"_25377":108995,"_2660":109205},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3162":65030,"_27851":64941,"_19309":109207,"_5":13254,"_25377":108995,"_2660":109208},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3162":65031,"_27851":64941,"_19309":109210,"_5":13254,"_25377":108995,"_2660":109211},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3162":65032,"_27851":64941,"_19309":109213,"_5":13254,"_25377":108995,"_2660":109214},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3162":65033,"_27851":64941,"_19309":109216,"_5":13254,"_25377":108995,"_2660":109217},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3162":65034,"_27851":64941,"_19309":109219,"_5":13254,"_25377":108999,"_2660":109220},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3162":65035,"_27851":64941,"_19309":109222,"_5":13254,"_25377":109003,"_2660":109223},[],"Campo de `settings.reenrollment_settings`",{"_3162":65036,"_27851":64941,"_19309":109225,"_5":13254,"_25377":109003,"_2660":109226},[],"Función",{"_3162":65037,"_27851":64941,"_19309":109228,"_5":13254,"_25377":109003,"_2660":48176},[],{"_3162":65038,"_27851":64941,"_19309":109230,"_5":13254,"_25377":109003,"_2660":109231},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3162":65039,"_27851":64941,"_19309":109233,"_5":13254,"_25377":109003,"_2660":48182},[],{"_3162":65040,"_27851":64941,"_19309":109235,"_5":13254,"_25377":109003,"_2660":109236},[],"Umbral operativo preventivo de monitorización.",{"_3162":65041,"_27851":64941,"_19309":109238,"_5":13254,"_25377":109003,"_2660":48188},[],{"_3162":65042,"_27851":64941,"_19309":109240,"_5":13254,"_25377":109003,"_2660":109241},[],"Umbral operativo crítico de monitorización.",{"_3162":65043,"_27851":64941,"_19309":109243,"_5":13254,"_25377":109003,"_2660":48194},[],{"_3162":65044,"_27851":64941,"_19309":109245,"_5":13254,"_25377":109003,"_2660":109246},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3162":65045,"_27851":64941,"_19309":109248,"_5":13254,"_25377":109003,"_2660":48200},[],{"_3162":65046,"_27851":64941,"_19309":109250,"_5":13254,"_25377":109003,"_2660":109251},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3162":65047,"_27851":64941,"_19309":109253,"_5":13254,"_25377":109003,"_2660":48206},[],{"_3162":65048,"_27851":64941,"_19309":109255,"_5":13254,"_25377":109003,"_2660":109256},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3162":65049,"_27851":64941,"_19309":109258,"_5":13254,"_25377":109003,"_2660":109259},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3162":65050,"_27851":64941,"_19309":109261,"_5":13254,"_25377":109007,"_2660":109262},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3162":65051,"_27851":64941,"_19309":109264,"_5":13254,"_25377":109010,"_2660":106721},[],{"_3162":65052,"_27851":64941,"_19309":109266,"_5":13254,"_25377":109010,"_2660":109267},[],"Qué publica",{"_3162":65053,"_27851":64941,"_19309":109269,"_5":13254,"_25377":109010,"_2660":48223},[],{"_3162":65054,"_27851":64941,"_19309":109271,"_5":13254,"_25377":109010,"_2660":109272},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3162":65055,"_27851":64941,"_19309":109274,"_5":13254,"_25377":109010,"_2660":48229},[],{"_3162":65056,"_27851":64941,"_19309":109276,"_5":13254,"_25377":109010,"_2660":109277},[],"Certificado de la CA emisora seleccionada.",{"_3162":65057,"_27851":64941,"_19309":109279,"_5":13254,"_25377":109010,"_2660":48235},[],{"_3162":65058,"_27851":64941,"_19309":109281,"_5":13254,"_25377":109010,"_2660":109282},[],"Certificados de las CAs elegidas explícitamente.",{"_3162":65059,"_27851":64941,"_19309":109284,"_5":13254,"_25377":109010,"_2660":109285},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3162":65060,"_27851":64941,"_19309":109287,"_5":13254,"_25377":109014,"_2660":109288},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_3162":65061,"_27851":64941,"_19309":109290,"_5":13254,"_25377":109014,"_2660":109291},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3162":65062,"_27851":64941,"_19309":109293,"_5":13254,"_25377":109014,"_2660":109294},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3162":65063,"_27851":64941,"_19309":109296,"_5":13254,"_25377":109018,"_2660":109297},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3162":65064,"_27851":65064,"_5":13585,"_2660":109299,"_28194":109300,"_19309":109301,"_25377":65064},"Integra el cliente EST",[45228,107691,47616,108697,108872],[],{"_3162":65065,"_27851":65064,"_19309":109303,"_5":13254,"_25377":65064,"_2660":109304},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3162":65066,"_27851":65064,"_5":28191,"_19309":109306,"_25377":109307,"_2660":106357},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3162":65067,"_27851":65064,"_5":28191,"_19309":109309,"_25377":109310,"_2660":109311},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3162":65068,"_27851":65064,"_5":28191,"_19309":109313,"_25377":109314,"_2660":109315},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3162":65069,"_27851":65064,"_5":28191,"_19309":109317,"_25377":109318,"_2660":109319},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3162":65070,"_27851":65064,"_5":28191,"_19309":109321,"_25377":109322,"_2660":109323},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3162":65071,"_27851":65064,"_5":28191,"_19309":109325,"_25377":109326,"_2660":109327},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3162":65072,"_27851":65064,"_19309":109329,"_5":13254,"_25377":65064,"_2660":109330},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3162":65073,"_27851":65064,"_19309":109332,"_5":13254,"_25377":109307,"_2660":109333},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3162":65074,"_27851":65064,"_19309":109335,"_5":13254,"_25377":109307,"_2660":109336},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3162":65075,"_27851":65064,"_19309":109338,"_5":13254,"_25377":109307,"_2660":109339},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3162":65076,"_27851":65064,"_19309":109341,"_5":13254,"_25377":109310,"_2660":109342},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3162":65077,"_27851":65064,"_19309":109344,"_5":13254,"_25377":109310,"_2660":109345},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3162":65078,"_27851":65064,"_19309":109347,"_5":13254,"_25377":109314,"_2660":109348},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3162":65079,"_27851":65064,"_19309":109350,"_5":13254,"_25377":109314,"_2660":109351},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3162":65080,"_27851":65064,"_19309":109353,"_5":13254,"_25377":109318,"_2660":109354},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3162":65081,"_27851":65064,"_19309":109356,"_5":13254,"_25377":109318,"_2660":109357},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3162":65082,"_27851":65064,"_19309":109359,"_5":13254,"_25377":109322,"_2660":109360},[],"Para el caso de una raíz que emite directamente:",{"_3162":65083,"_27851":65064,"_19309":109362,"_5":13254,"_25377":109322,"_2660":109363},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3162":65084,"_27851":65064,"_19309":109365,"_5":13254,"_25377":109322,"_2660":109366},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3162":65085,"_27851":65064,"_19309":109368,"_5":13254,"_25377":109326,"_2660":109369},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3162":65086,"_27851":65086,"_5":13585,"_2660":109371,"_28194":109372,"_19309":109373,"_25377":65086},"Referencia EST",[45228,107691,47616,108697,108872],[],{"_3162":65087,"_27851":65086,"_19309":109375,"_5":13254,"_25377":65086,"_2660":109376},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3162":65088,"_27851":65086,"_5":28191,"_19309":109378,"_25377":109379,"_2660":109380},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3162":65089,"_27851":65086,"_5":28191,"_19309":109382,"_25377":109383,"_2660":20990},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3162":65090,"_27851":65086,"_5":28191,"_19309":109385,"_25377":109386,"_2660":24068},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3162":65091,"_27851":65086,"_5":28191,"_19309":109388,"_25377":109389,"_2660":24075},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3162":65092,"_27851":65086,"_5":28191,"_19309":109391,"_25377":109392,"_2660":23420},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3162":65093,"_27851":65086,"_5":28191,"_19309":109394,"_25377":109395,"_2660":109396},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3162":65094,"_27851":65086,"_5":28191,"_19309":109398,"_25377":109399,"_2660":109400},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3162":65095,"_27851":65086,"_5":28191,"_19309":109402,"_25377":109403,"_2660":109404},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3162":65096,"_27851":65086,"_19309":109406,"_5":13254,"_25377":65086,"_2660":109407},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3162":65097,"_27851":65086,"_19309":109409,"_5":13254,"_25377":109379,"_2660":109410},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3162":65098,"_27851":65086,"_19309":109412,"_5":13254,"_25377":109379,"_2660":107482},[],{"_3162":65099,"_27851":65086,"_19309":109414,"_5":13254,"_25377":109379,"_2660":109415},[],"Método",{"_3162":65100,"_27851":65086,"_19309":109417,"_5":13254,"_25377":109379,"_2660":109418},[],"Autenticación y condición",{"_3162":65101,"_27851":65086,"_19309":109420,"_5":13254,"_25377":109379,"_2660":48378},[],{"_3162":65102,"_27851":65086,"_19309":109422,"_5":13254,"_25377":109379,"_2660":48381},[],{"_3162":65103,"_27851":65086,"_19309":109424,"_5":13254,"_25377":109379,"_2660":109425},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3162":65104,"_27851":65086,"_19309":109427,"_5":13254,"_25377":109379,"_2660":48387},[],{"_3162":65105,"_27851":65086,"_19309":109429,"_5":13254,"_25377":109379,"_2660":48390},[],{"_3162":65106,"_27851":65086,"_19309":109431,"_5":13254,"_25377":109379,"_2660":109432},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3162":65107,"_27851":65086,"_19309":109434,"_5":13254,"_25377":109379,"_2660":48396},[],{"_3162":65108,"_27851":65086,"_19309":109436,"_5":13254,"_25377":109379,"_2660":48390},[],{"_3162":65109,"_27851":65086,"_19309":109438,"_5":13254,"_25377":109379,"_2660":109439},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3162":65110,"_27851":65086,"_19309":109441,"_5":13254,"_25377":109379,"_2660":48404},[],{"_3162":65111,"_27851":65086,"_19309":109443,"_5":13254,"_25377":109379,"_2660":48390},[],{"_3162":65112,"_27851":65086,"_19309":109445,"_5":13254,"_25377":109379,"_2660":109446},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3162":65113,"_27851":65086,"_19309":109448,"_5":13254,"_25377":109379,"_2660":109449},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3162":65114,"_27851":65086,"_19309":109451,"_5":13254,"_25377":109383,"_2660":109452},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3162":65115,"_27851":65086,"_19309":109454,"_5":13254,"_25377":109383,"_2660":109455},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3162":65116,"_27851":65086,"_19309":109457,"_5":13254,"_25377":109386,"_2660":109458},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3162":65117,"_27851":65086,"_19309":109460,"_5":13254,"_25377":109386,"_2660":109461},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3162":65118,"_27851":65086,"_19309":109463,"_5":13254,"_25377":109389,"_2660":109464},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3162":65119,"_27851":65086,"_19309":109466,"_5":13254,"_25377":109389,"_2660":109467},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3162":65120,"_27851":65086,"_19309":109469,"_5":13254,"_25377":109392,"_2660":109470},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3162":65121,"_27851":65086,"_19309":109472,"_5":13254,"_25377":109392,"_2660":109473},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3162":65122,"_27851":65086,"_19309":109475,"_5":13254,"_25377":109395,"_2660":109476},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3162":65123,"_27851":65086,"_19309":109478,"_5":13254,"_25377":109395,"_2660":109479},[],"Parte",{"_3162":65124,"_27851":65086,"_19309":109481,"_5":13254,"_25377":109395,"_2660":109482},[],"Contenido tras decodificar su Base64",{"_3162":65125,"_27851":65086,"_19309":109484,"_5":13254,"_25377":109395,"_2660":48448},[],{"_3162":65126,"_27851":65086,"_19309":109486,"_5":13254,"_25377":109395,"_2660":109487},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3162":65127,"_27851":65086,"_19309":109489,"_5":13254,"_25377":109395,"_2660":48454},[],{"_3162":65128,"_27851":65086,"_19309":109491,"_5":13254,"_25377":109395,"_2660":109492},[],"PKCS#7 DER con el certificado emitido.",{"_3162":65129,"_27851":65086,"_19309":109494,"_5":13254,"_25377":109395,"_2660":109495},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3162":65130,"_27851":65086,"_19309":109497,"_5":13254,"_25377":109399,"_2660":109498},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3162":65131,"_27851":65086,"_19309":109500,"_5":13254,"_25377":109399,"_2660":109501},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3162":65132,"_27851":65086,"_19309":109503,"_5":13254,"_25377":109399,"_2660":109504},[],"Convierte y comprueba el resultado:",{"_3162":65133,"_27851":65086,"_19309":109506,"_5":13254,"_25377":109399,"_2660":109507},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3162":65134,"_27851":65086,"_19309":109509,"_5":13254,"_25377":109403,"_2660":109510},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3162":65135,"_27851":65086,"_19309":109512,"_5":13254,"_25377":109403,"_2660":109513},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3162":65136,"_27851":65136,"_5":13585,"_2660":108872,"_28194":109515,"_19309":109516,"_25377":65136},[45228,107691,47616,108697,108872],[],{"_3162":65137,"_27851":65136,"_19309":109518,"_5":13254,"_25377":65136,"_2660":109519},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3162":65138,"_27851":65136,"_5":28191,"_19309":109521,"_25377":109522,"_2660":109523},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3162":65139,"_27851":65136,"_5":28191,"_19309":109525,"_25377":109526,"_2660":109527},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3162":65140,"_27851":65136,"_5":28191,"_19309":109529,"_25377":109530,"_2660":109531},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3162":65141,"_27851":65136,"_5":28191,"_19309":109533,"_25377":109534,"_2660":109535},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3162":65142,"_27851":65136,"_19309":109537,"_5":13254,"_25377":65136,"_2660":109538},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3162":65143,"_27851":65136,"_19309":109540,"_5":13254,"_25377":109522,"_2660":109541},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3162":65144,"_27851":65136,"_19309":109543,"_5":13254,"_25377":109522,"_2660":109544},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3162":65145,"_27851":65136,"_19309":109546,"_5":13254,"_25377":109522,"_2660":109547},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3162":65146,"_27851":65136,"_19309":109549,"_5":13254,"_25377":109522,"_2660":109550},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3162":65147,"_27851":65136,"_19309":109552,"_5":13254,"_25377":109522,"_2660":109553},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3162":65148,"_27851":65136,"_19309":109555,"_5":13254,"_25377":109522,"_2660":109556},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3162":65149,"_27851":65136,"_19309":109558,"_5":13254,"_25377":109526,"_2660":109559},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3162":65150,"_27851":65136,"_19309":109561,"_5":13254,"_25377":109526,"_2660":109562},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3162":65151,"_27851":65136,"_19309":109564,"_5":13254,"_25377":109526,"_2660":109565},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3162":65152,"_27851":65136,"_19309":109567,"_5":13254,"_25377":109526,"_2660":109568},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3162":65153,"_27851":65136,"_19309":109570,"_5":13254,"_25377":109530,"_2660":109571},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3162":65154,"_27851":65136,"_19309":109573,"_5":13254,"_25377":109530,"_2660":109574},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3162":65155,"_27851":65136,"_19309":109576,"_5":13254,"_25377":109530,"_2660":109577},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3162":65156,"_27851":65136,"_19309":109579,"_5":13254,"_25377":109530,"_2660":109580},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3162":65157,"_27851":65136,"_19309":109582,"_5":13254,"_25377":109534,"_2660":109583},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3162":65158,"_27851":65136,"_19309":109585,"_5":13254,"_25377":109534,"_2660":109586},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3162":65159,"_27851":65159,"_5":13585,"_2660":109588,"_28194":109589,"_19309":109590,"_25377":65159},"Estrategias de aprovisionamiento",[45228,107691,47616,108697,108872],[],{"_3162":65160,"_27851":65159,"_19309":109592,"_5":13254,"_25377":65159,"_2660":109593},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3162":65161,"_27851":65159,"_5":28191,"_19309":109595,"_25377":109596,"_2660":109597},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3162":65162,"_27851":65159,"_5":28191,"_19309":109599,"_25377":109600,"_2660":109601},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3162":65163,"_27851":65159,"_5":28191,"_19309":109603,"_25377":109604,"_2660":109605},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3162":65164,"_27851":65159,"_5":28191,"_19309":109607,"_25377":109608,"_2660":109609},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3162":65165,"_27851":65159,"_5":28191,"_19309":109611,"_25377":109612,"_2660":109613},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3162":65166,"_27851":65159,"_19309":109615,"_5":13254,"_25377":65159,"_2660":109616},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3162":65167,"_27851":65159,"_19309":109618,"_5":13254,"_25377":109596,"_2660":109619},[],"Recorrido",{"_3162":65168,"_27851":65159,"_19309":109621,"_5":13254,"_25377":109596,"_2660":109622},[],"Cuándo existe el dispositivo",{"_3162":65169,"_27851":65159,"_19309":109624,"_5":13254,"_25377":109596,"_2660":109625},[],"Qué compruebas",{"_3162":65170,"_27851":65159,"_19309":109627,"_5":13254,"_25377":109596,"_2660":109628},[],"Asignación manual",{"_3162":65171,"_27851":65159,"_19309":109630,"_5":13254,"_25377":109596,"_2660":109631},[],"El operador lo crea antes de asociar un certificado.",{"_3162":65172,"_27851":65159,"_19309":109633,"_5":13254,"_25377":109596,"_2660":109634},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3162":65173,"_27851":65159,"_19309":109636,"_5":13254,"_25377":109596,"_2660":109637},[],"EST con `JITP`",{"_3162":65174,"_27851":65159,"_19309":109639,"_5":13254,"_25377":109596,"_2660":109640},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3162":65175,"_27851":65159,"_19309":109642,"_5":13254,"_25377":109596,"_2660":109643},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3162":65176,"_27851":65159,"_19309":109645,"_5":13254,"_25377":109596,"_2660":109646},[],"EST con `PRE_REGISTRATION`",{"_3162":65177,"_27851":65159,"_19309":109648,"_5":13254,"_25377":109596,"_2660":109649},[],"Debe existir antes de `/simpleenroll`.",{"_3162":65178,"_27851":65159,"_19309":109651,"_5":13254,"_25377":109596,"_2660":109652},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3162":65179,"_27851":65159,"_19309":109654,"_5":13254,"_25377":109596,"_2660":109655},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3162":65180,"_27851":65159,"_19309":109657,"_5":13254,"_25377":109596,"_2660":109658},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3162":65181,"_27851":65159,"_19309":109660,"_5":13254,"_25377":109600,"_2660":109661},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3162":65182,"_27851":65159,"_19309":109663,"_5":13254,"_25377":109600,"_2660":109664},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3162":65183,"_27851":65159,"_19309":109666,"_5":13254,"_25377":109600,"_2660":109667},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3162":65184,"_27851":65159,"_19309":109669,"_5":13254,"_25377":109604,"_2660":109670},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3162":65185,"_27851":65159,"_19309":109672,"_5":13254,"_25377":109604,"_2660":109673},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3162":65186,"_27851":65159,"_19309":109675,"_5":13254,"_25377":109604,"_2660":109676},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3162":65187,"_27851":65159,"_19309":109678,"_5":13254,"_25377":109604,"_2660":109679},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3162":65188,"_27851":65159,"_19309":109681,"_5":13254,"_25377":109604,"_2660":109682},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3162":65189,"_27851":65159,"_19309":109684,"_5":13254,"_25377":109604,"_2660":109685},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3162":65190,"_27851":65159,"_19309":109687,"_5":13254,"_25377":109608,"_2660":106721},[],{"_3162":65191,"_27851":65159,"_19309":109689,"_5":13254,"_25377":109608,"_2660":109690},[],"Material que atraviesa EST",{"_3162":65192,"_27851":65159,"_19309":109692,"_5":13254,"_25377":109608,"_2660":109693},[],"Clave generada por el dispositivo",{"_3162":65193,"_27851":65159,"_19309":109695,"_5":13254,"_25377":109608,"_2660":109696},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3162":65194,"_27851":65159,"_19309":109698,"_5":13254,"_25377":109608,"_2660":109699},[],"Clave ya disponible en el dispositivo",{"_3162":65195,"_27851":65159,"_19309":109701,"_5":13254,"_25377":109608,"_2660":109702},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3162":65196,"_27851":65159,"_19309":109704,"_5":13254,"_25377":109608,"_2660":47935},[],{"_3162":65197,"_27851":65159,"_19309":109706,"_5":13254,"_25377":109608,"_2660":109707},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3162":65198,"_27851":65159,"_19309":109709,"_5":13254,"_25377":109608,"_2660":109710},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3162":65199,"_27851":65159,"_19309":109712,"_5":13254,"_25377":109612,"_2660":109713},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3162":65200,"_27851":65200,"_5":13585,"_2660":109715,"_28194":109716,"_19309":109717,"_25377":65200},"Renovación y recuperación",[45228,107691,47616,108697,108872],[],{"_3162":65201,"_27851":65200,"_19309":109719,"_5":13254,"_25377":65200,"_2660":109720},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3162":65202,"_27851":65200,"_5":28191,"_19309":109722,"_25377":109723,"_2660":109724},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3162":65203,"_27851":65200,"_5":28191,"_19309":109726,"_25377":109727,"_2660":109728},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3162":65204,"_27851":65200,"_5":28191,"_19309":109730,"_25377":109731,"_2660":109732},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3162":65205,"_27851":65200,"_5":28191,"_19309":109734,"_25377":109735,"_2660":109736},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3162":65206,"_27851":65200,"_5":28191,"_19309":109738,"_25377":109739,"_2660":109740},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3162":65207,"_27851":65200,"_19309":109742,"_5":13254,"_25377":65200,"_2660":109743},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3162":65208,"_27851":65200,"_19309":109745,"_5":13254,"_25377":109723,"_2660":109746},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3162":65209,"_27851":65200,"_19309":109748,"_5":13254,"_25377":109723,"_2660":109749},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3162":65210,"_27851":65200,"_19309":109751,"_5":13254,"_25377":109723,"_2660":109752},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3162":65211,"_27851":65200,"_19309":109754,"_5":13254,"_25377":109723,"_2660":109755},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3162":65212,"_27851":65200,"_19309":109757,"_5":13254,"_25377":109727,"_2660":109758},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3162":65213,"_27851":65200,"_19309":109760,"_5":13254,"_25377":109727,"_2660":109761},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3162":65214,"_27851":65200,"_19309":109763,"_5":13254,"_25377":109731,"_2660":109764},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3162":65215,"_27851":65200,"_19309":109766,"_5":13254,"_25377":109731,"_2660":109767},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3162":65216,"_27851":65200,"_19309":109769,"_5":13254,"_25377":109731,"_2660":109770},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3162":65217,"_27851":65200,"_19309":109772,"_5":13254,"_25377":109735,"_2660":109773},[],"Situación",{"_3162":65218,"_27851":65200,"_19309":109775,"_5":13254,"_25377":109735,"_2660":109776},[],"Procedimiento",{"_3162":65219,"_27851":65200,"_19309":109778,"_5":13254,"_25377":109735,"_2660":109779},[],"Certificado vigente, fuera de ventana",{"_3162":65220,"_27851":65200,"_19309":109781,"_5":13254,"_25377":109735,"_2660":109782},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3162":65221,"_27851":65200,"_19309":109784,"_5":13254,"_25377":109735,"_2660":109785},[],"Certificado vencido, clave disponible",{"_3162":65222,"_27851":65200,"_19309":109787,"_5":13254,"_25377":109735,"_2660":109788},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3162":65223,"_27851":65200,"_19309":109790,"_5":13254,"_25377":109735,"_2660":109791},[],"Renovación por webhook o `NO_AUTH`",{"_3162":65224,"_27851":65200,"_19309":109793,"_5":13254,"_25377":109735,"_2660":109794},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3162":65225,"_27851":65200,"_19309":109796,"_5":13254,"_25377":109735,"_2660":109797},[],"Clave perdida o inaccesible",{"_3162":65226,"_27851":65200,"_19309":109799,"_5":13254,"_25377":109735,"_2660":109800},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3162":65227,"_27851":65200,"_19309":109802,"_5":13254,"_25377":109735,"_2660":109803},[],"Identidad actual revocada",{"_3162":65228,"_27851":65200,"_19309":109805,"_5":13254,"_25377":109735,"_2660":109806},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3162":65229,"_27851":65200,"_19309":109808,"_5":13254,"_25377":109735,"_2660":109809},[],"Dispositivo sin identidad",{"_3162":65230,"_27851":65200,"_19309":109811,"_5":13254,"_25377":109735,"_2660":109812},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3162":65231,"_27851":65200,"_19309":109814,"_5":13254,"_25377":109735,"_2660":109815},[],"Dispositivo retirado",{"_3162":65232,"_27851":65200,"_19309":109817,"_5":13254,"_25377":109735,"_2660":109818},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3162":65233,"_27851":65200,"_19309":109820,"_5":13254,"_25377":109735,"_2660":109821},[],"Timeout, HTTP 500 o fallo de instalación",{"_3162":65234,"_27851":65200,"_19309":109823,"_5":13254,"_25377":109735,"_2660":109824},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3162":65235,"_27851":65200,"_19309":109826,"_5":13254,"_25377":109739,"_2660":109827},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3162":65236,"_27851":65200,"_19309":109829,"_5":13254,"_25377":109739,"_2660":109830},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3162":65237,"_27851":65237,"_5":13585,"_2660":109832,"_28194":109833,"_19309":109834,"_25377":65237},"Diagnóstico de enrolamiento",[45228,107691,47616,108697,108872],[],{"_3162":65238,"_27851":65237,"_19309":109836,"_5":13254,"_25377":65237,"_2660":109837},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3162":65239,"_27851":65237,"_5":28191,"_19309":109839,"_25377":109840,"_2660":109841},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3162":65240,"_27851":65237,"_5":28191,"_19309":109843,"_25377":109844,"_2660":109845},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3162":65241,"_27851":65237,"_5":28191,"_19309":109847,"_25377":109848,"_2660":109404},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3162":65242,"_27851":65237,"_5":28191,"_19309":109850,"_25377":109851,"_2660":109852},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3162":65243,"_27851":65237,"_19309":109854,"_5":13254,"_25377":65237,"_2660":109855},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3162":65244,"_27851":65237,"_19309":109857,"_5":13254,"_25377":109844,"_2660":109858},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3162":65245,"_27851":65237,"_19309":109860,"_5":13254,"_25377":109844,"_2660":109861},[],"Síntoma o mensaje",{"_3162":65246,"_27851":65237,"_19309":109863,"_5":13254,"_25377":109844,"_2660":109864},[],"Qué revisar",{"_3162":65247,"_27851":65237,"_19309":109866,"_5":13254,"_25377":109844,"_2660":109867},[],"curl rechaza TLS, nombre o emisor",{"_3162":65248,"_27851":65237,"_19309":109869,"_5":13254,"_25377":109844,"_2660":109870},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3162":65249,"_27851":65237,"_19309":109872,"_5":13254,"_25377":109844,"_2660":109873},[],"404 o APS ausente",{"_3162":65250,"_27851":65237,"_19309":109875,"_5":13254,"_25377":109844,"_2660":109876},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3162":65251,"_27851":65237,"_19309":109878,"_5":13254,"_25377":109844,"_2660":109879},[],"400, error de CSR o formato",{"_3162":65252,"_27851":65237,"_19309":109881,"_5":13254,"_25377":109844,"_2660":109882},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3162":65253,"_27851":65237,"_19309":109884,"_5":13254,"_25377":109844,"_2660":109885},[],"Credencial ausente o certificado no válido",{"_3162":65254,"_27851":65237,"_19309":109887,"_5":13254,"_25377":109844,"_2660":109888},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3162":65255,"_27851":65237,"_19309":109890,"_5":13254,"_25377":109844,"_2660":109891},[],"Webhook deniega, expira o responde sin autorización",{"_3162":65256,"_27851":65237,"_19309":109893,"_5":13254,"_25377":109844,"_2660":109894},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3162":65257,"_27851":65237,"_19309":109896,"_5":13254,"_25377":109844,"_2660":48861},[],{"_3162":65258,"_27851":65237,"_19309":109898,"_5":13254,"_25377":109844,"_2660":109899},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3162":65259,"_27851":65237,"_19309":109901,"_5":13254,"_25377":109844,"_2660":48867},[],{"_3162":65260,"_27851":65237,"_19309":109903,"_5":13254,"_25377":109844,"_2660":109904},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3162":65261,"_27851":65237,"_19309":109906,"_5":13254,"_25377":109844,"_2660":48873},[],{"_3162":65262,"_27851":65237,"_19309":109908,"_5":13254,"_25377":109844,"_2660":109909},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3162":65263,"_27851":65237,"_19309":109911,"_5":13254,"_25377":109844,"_2660":48879},[],{"_3162":65264,"_27851":65237,"_19309":109913,"_5":13254,"_25377":109844,"_2660":109914},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3162":65265,"_27851":65237,"_19309":109916,"_5":13254,"_25377":109844,"_2660":48885},[],{"_3162":65266,"_27851":65237,"_19309":109918,"_5":13254,"_25377":109844,"_2660":109919},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3162":65267,"_27851":65237,"_19309":109921,"_5":13254,"_25377":109844,"_2660":109922},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3162":65268,"_27851":65237,"_19309":109924,"_5":13254,"_25377":109844,"_2660":109925},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3162":65269,"_27851":65237,"_19309":109927,"_5":13254,"_25377":109844,"_2660":109928},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3162":65270,"_27851":65237,"_19309":109930,"_5":13254,"_25377":109844,"_2660":109931},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3162":65271,"_27851":65237,"_19309":109933,"_5":13254,"_25377":109844,"_2660":48903},[],{"_3162":65272,"_27851":65237,"_19309":109935,"_5":13254,"_25377":109844,"_2660":109936},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3162":65273,"_27851":65237,"_19309":109938,"_5":13254,"_25377":109844,"_2660":48909},[],{"_3162":65274,"_27851":65237,"_19309":109940,"_5":13254,"_25377":109844,"_2660":109941},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3162":65275,"_27851":65237,"_19309":109943,"_5":13254,"_25377":109844,"_2660":109944},[],"DMS propietario distinto",{"_3162":65276,"_27851":65237,"_19309":109946,"_5":13254,"_25377":109844,"_2660":109947},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3162":65277,"_27851":65237,"_19309":109949,"_5":13254,"_25377":109844,"_2660":48921},[],{"_3162":65278,"_27851":65237,"_19309":109951,"_5":13254,"_25377":109844,"_2660":109952},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3162":65279,"_27851":65237,"_19309":109954,"_5":13254,"_25377":109844,"_2660":48927},[],{"_3162":65280,"_27851":65237,"_19309":109956,"_5":13254,"_25377":109844,"_2660":109957},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3162":65281,"_27851":65237,"_19309":109959,"_5":13254,"_25377":109844,"_2660":109960},[],"Certificado actual revocado",{"_3162":65282,"_27851":65237,"_19309":109962,"_5":13254,"_25377":109844,"_2660":109963},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3162":65283,"_27851":65237,"_19309":109965,"_5":13254,"_25377":109844,"_2660":109966},[],"Error de CA, perfil o firma",{"_3162":65284,"_27851":65237,"_19309":109968,"_5":13254,"_25377":109844,"_2660":109969},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3162":65285,"_27851":65237,"_19309":109971,"_5":13254,"_25377":109844,"_2660":109972},[],"HTTP 200 sin conexión del dispositivo",{"_3162":65286,"_27851":65237,"_19309":109974,"_5":13254,"_25377":109844,"_2660":109975},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3162":65287,"_27851":65237,"_19309":109977,"_5":13254,"_25377":109844,"_2660":109978},[],"Timeout o error después de emitir",{"_3162":65288,"_27851":65237,"_19309":109980,"_5":13254,"_25377":109844,"_2660":109981},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3162":65289,"_27851":65237,"_19309":109983,"_5":13254,"_25377":109848,"_2660":109984},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3162":65290,"_27851":65237,"_19309":109986,"_5":13254,"_25377":109848,"_2660":109987},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3162":65291,"_27851":65237,"_19309":109989,"_5":13254,"_25377":109851,"_2660":109990},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3162":65292,"_27851":65237,"_19309":109992,"_5":13254,"_25377":109851,"_2660":109993},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3162":65293,"_27851":65237,"_19309":109995,"_5":13254,"_25377":109851,"_2660":109996},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3162":65294,"_27851":65237,"_19309":109998,"_5":13254,"_25377":109851,"_2660":109999},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3162":65295,"_27851":65237,"_19309":110001,"_5":13254,"_25377":109851,"_2660":110002},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3162":65296,"_27851":65237,"_19309":110004,"_5":13254,"_25377":109851,"_2660":110005},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3162":65297,"_27851":65237,"_19309":110007,"_5":13254,"_25377":109851,"_2660":110008},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3162":65298,"_27851":65298,"_5":13585,"_2660":110010,"_28194":110011,"_19309":110012,"_25377":65298},"Distribución y actualización de confianza",[45228,107691,47616,108697,108872],[],{"_3162":65299,"_27851":65298,"_19309":110014,"_5":13254,"_25377":65298,"_2660":110015},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3162":65300,"_27851":65298,"_5":28191,"_19309":110017,"_25377":110018,"_2660":110019},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3162":65301,"_27851":65298,"_5":28191,"_19309":110021,"_25377":110022,"_2660":110023},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3162":65302,"_27851":65298,"_5":28191,"_19309":110025,"_25377":110026,"_2660":110027},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3162":65303,"_27851":65298,"_5":28191,"_19309":110029,"_25377":110030,"_2660":110031},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3162":65304,"_27851":65298,"_5":28191,"_19309":110033,"_25377":110034,"_2660":110035},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3162":65305,"_27851":65298,"_19309":110037,"_5":13254,"_25377":65298,"_2660":110038},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3162":65306,"_27851":65298,"_19309":110040,"_5":13254,"_25377":110018,"_2660":110041},[],"Relación",{"_3162":65307,"_27851":65298,"_19309":110043,"_5":13254,"_25377":110018,"_2660":110044},[],"Material que prepara el responsable",{"_3162":65308,"_27851":65298,"_19309":110046,"_5":13254,"_25377":110018,"_2660":110047},[],"Dispositivo → servidor EST",{"_3162":65309,"_27851":65298,"_19309":110049,"_5":13254,"_25377":110018,"_2660":110050},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3162":65310,"_27851":65298,"_19309":110052,"_5":13254,"_25377":110018,"_2660":110053},[],"DMS → solicitante",{"_3162":65311,"_27851":65298,"_19309":110055,"_5":13254,"_25377":110018,"_2660":110056},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3162":65312,"_27851":65298,"_19309":110058,"_5":13254,"_25377":110018,"_2660":110059},[],"Consumidor → dispositivo",{"_3162":65313,"_27851":65298,"_19309":110061,"_5":13254,"_25377":110018,"_2660":110062},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3162":65314,"_27851":65298,"_19309":110064,"_5":13254,"_25377":110018,"_2660":110065},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3162":65315,"_27851":65298,"_19309":110067,"_5":13254,"_25377":110022,"_2660":110068},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3162":65316,"_27851":65298,"_19309":110070,"_5":13254,"_25377":110022,"_2660":110071},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3162":65317,"_27851":65298,"_19309":110073,"_5":13254,"_25377":110026,"_2660":110074},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3162":65318,"_27851":65298,"_19309":110076,"_5":13254,"_25377":110026,"_2660":110077},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3162":65319,"_27851":65298,"_19309":110079,"_5":13254,"_25377":110026,"_2660":110080},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3162":65320,"_27851":65298,"_19309":110082,"_5":13254,"_25377":110026,"_2660":110083},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3162":65321,"_27851":65298,"_19309":110085,"_5":13254,"_25377":110026,"_2660":110086},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3162":65322,"_27851":65298,"_19309":110088,"_5":13254,"_25377":110026,"_2660":110089},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3162":65323,"_27851":65298,"_19309":110091,"_5":13254,"_25377":110030,"_2660":110092},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3162":65324,"_27851":65298,"_19309":110094,"_5":13254,"_25377":110030,"_2660":110095},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3162":65325,"_27851":65298,"_19309":110097,"_5":13254,"_25377":110030,"_2660":110098},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3162":65326,"_27851":65298,"_19309":110100,"_5":13254,"_25377":110034,"_2660":110101},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3162":65327,"_27851":65327,"_5":13585,"_2660":49076,"_28194":110103,"_19309":110105,"_25377":65327},[45228,107691,47616,108697,110104],"Integraciones",[],{"_3162":65328,"_27851":65327,"_19309":110107,"_5":13254,"_25377":65327,"_2660":110108},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3162":65329,"_27851":65327,"_5":28191,"_19309":110110,"_25377":110111,"_2660":110112},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3162":65330,"_27851":65327,"_5":28191,"_19309":110114,"_25377":110115,"_2660":110116},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3162":65331,"_27851":65327,"_5":28191,"_19309":110118,"_25377":110119,"_2660":110120},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3162":65332,"_27851":65327,"_5":28191,"_19309":110122,"_25377":110123,"_2660":110124},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3162":65333,"_27851":65327,"_5":28191,"_19309":110126,"_25377":110127,"_2660":110128},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3162":65334,"_27851":65327,"_5":28191,"_19309":110130,"_25377":110131,"_2660":110132},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3162":65335,"_27851":65327,"_5":28191,"_19309":110134,"_25377":110135,"_2660":49110},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3162":65336,"_27851":65327,"_5":28191,"_19309":110137,"_25377":110138,"_2660":49114},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3162":65337,"_27851":65327,"_5":28191,"_19309":110140,"_25377":110141,"_2660":110142},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3162":65338,"_27851":65327,"_5":28191,"_19309":110144,"_25377":110145,"_2660":110146},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3162":65339,"_27851":65327,"_5":28191,"_19309":110148,"_25377":110149,"_2660":110150},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3162":65340,"_27851":65327,"_5":28191,"_19309":110152,"_25377":110153,"_2660":110154},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3162":65341,"_27851":65327,"_5":28191,"_19309":110156,"_25377":110157,"_2660":110158},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3162":65342,"_27851":65327,"_5":28191,"_19309":110160,"_25377":110161,"_2660":110162},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3162":65343,"_27851":65327,"_5":28191,"_19309":110164,"_25377":110165,"_2660":110166},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3162":65344,"_27851":65327,"_5":28191,"_19309":110168,"_25377":110169,"_2660":110170},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3162":65345,"_27851":65327,"_5":28191,"_19309":110172,"_25377":110173,"_2660":110174},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3162":65346,"_27851":65327,"_5":28191,"_19309":110176,"_25377":110177,"_2660":110178},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3162":65347,"_27851":65327,"_5":28191,"_19309":110180,"_25377":110181,"_2660":110182},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3162":65348,"_27851":65327,"_5":28191,"_19309":110184,"_25377":110185,"_2660":110186},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3162":65349,"_27851":65327,"_19309":110188,"_5":13254,"_25377":65327,"_2660":110189},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3162":65350,"_27851":65327,"_19309":110191,"_5":13254,"_25377":65327,"_2660":110192},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3162":65351,"_27851":65327,"_19309":110194,"_5":13254,"_25377":65327,"_2660":110195},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3162":65352,"_27851":65327,"_19309":110197,"_5":13254,"_25377":110111,"_2660":110198},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3162":65353,"_27851":65327,"_19309":110200,"_5":13254,"_25377":110111,"_2660":110201},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3162":65354,"_27851":65327,"_19309":110203,"_5":13254,"_25377":110111,"_2660":110204},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3162":65355,"_27851":65327,"_19309":110206,"_5":13254,"_25377":110111,"_2660":110207},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3162":65356,"_27851":65327,"_19309":110209,"_5":13254,"_25377":110115,"_2660":110210},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3162":65357,"_27851":65327,"_19309":110212,"_5":13254,"_25377":110119,"_2660":110213},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3162":65358,"_27851":65327,"_19309":110215,"_5":13254,"_25377":110119,"_2660":110216},[],"Acción IAM",{"_3162":65359,"_27851":65327,"_19309":110218,"_5":13254,"_25377":110119,"_2660":106727},[],{"_3162":65360,"_27851":65327,"_19309":110220,"_5":13254,"_25377":110119,"_2660":49197},[],{"_3162":65361,"_27851":65327,"_19309":110222,"_5":13254,"_25377":110119,"_2660":110223},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3162":65362,"_27851":65327,"_19309":110225,"_5":13254,"_25377":110119,"_2660":49203},[],{"_3162":65363,"_27851":65327,"_19309":110227,"_5":13254,"_25377":110119,"_2660":110228},[],"Registrar la CA en AWS IoT",{"_3162":65364,"_27851":65327,"_19309":110230,"_5":13254,"_25377":110119,"_2660":49209},[],{"_3162":65365,"_27851":65327,"_19309":110232,"_5":13254,"_25377":110119,"_2660":110233},[],"Consultar el estado del registro de la CA",{"_3162":65366,"_27851":65327,"_19309":110235,"_5":13254,"_25377":110119,"_2660":49215},[],{"_3162":65367,"_27851":65327,"_19309":110237,"_5":13254,"_25377":110119,"_2660":110238},[],"Crear o actualizar Things en IoT Core",{"_3162":65368,"_27851":65327,"_19309":110240,"_5":13254,"_25377":110119,"_2660":49221},[],{"_3162":65369,"_27851":65327,"_19309":110242,"_5":13254,"_25377":110119,"_2660":110243},[],"Aprovisionar Things mediante plantilla",{"_3162":65370,"_27851":65327,"_19309":110245,"_5":13254,"_25377":110119,"_2660":49227},[],{"_3162":65371,"_27851":65327,"_19309":110247,"_5":13254,"_25377":110119,"_2660":110248},[],"Registrar certificados de dispositivo",{"_3162":65372,"_27851":65327,"_19309":110250,"_5":13254,"_25377":110119,"_2660":49233},[],{"_3162":65373,"_27851":65327,"_19309":110252,"_5":13254,"_25377":110119,"_2660":110253},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3162":65374,"_27851":65327,"_19309":110255,"_5":13254,"_25377":110119,"_2660":49239},[],{"_3162":65375,"_27851":65327,"_19309":110257,"_5":13254,"_25377":110119,"_2660":110258},[],"Crear y adjuntar políticas IoT",{"_3162":65376,"_27851":65327,"_19309":110260,"_5":13254,"_25377":110119,"_2660":49245},[],{"_3162":65377,"_27851":65327,"_19309":110262,"_5":13254,"_25377":110119,"_2660":110263},[],"Gestionar grupos de Things",{"_3162":65378,"_27851":65327,"_19309":110265,"_5":13254,"_25377":110119,"_2660":49251},[],{"_3162":65379,"_27851":65327,"_19309":110267,"_5":13254,"_25377":110119,"_2660":110268},[],"Crear plantillas JITP",{"_3162":65380,"_27851":65327,"_19309":110270,"_5":13254,"_25377":110119,"_2660":49257},[],{"_3162":65381,"_27851":65327,"_19309":110272,"_5":13254,"_25377":110119,"_2660":110273},[],"Leer y escribir el Device Shadow",{"_3162":65382,"_27851":65327,"_19309":110275,"_5":13254,"_25377":110119,"_2660":110276},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3162":65383,"_27851":65327,"_19309":110278,"_5":13254,"_25377":110123,"_2660":110279},[],"Parámetro",{"_3162":65384,"_27851":65327,"_19309":110281,"_5":13254,"_25377":110123,"_2660":110282},[],"Tipo",{"_3162":65385,"_27851":65327,"_19309":110284,"_5":13254,"_25377":110123,"_2660":110285},[],"Requerido",{"_3162":65386,"_27851":65327,"_19309":110287,"_5":13254,"_25377":110123,"_2660":110288},[],"Descripción",{"_3162":65387,"_27851":65327,"_19309":110290,"_5":13254,"_25377":110123,"_2660":49278},[],{"_3162":65388,"_27851":65327,"_19309":110292,"_5":13254,"_25377":110123,"_2660":23097},[],{"_3162":65389,"_27851":65327,"_19309":110294,"_5":13254,"_25377":110123,"_2660":110295},[],"Sí",{"_3162":65390,"_27851":65327,"_19309":110297,"_5":13254,"_25377":110123,"_2660":110298},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3162":65391,"_27851":65327,"_19309":110300,"_5":13254,"_25377":110123,"_2660":49289},[],{"_3162":65392,"_27851":65327,"_19309":110302,"_5":13254,"_25377":110123,"_2660":23097},[],{"_3162":65393,"_27851":65327,"_19309":110304,"_5":13254,"_25377":110123,"_2660":110295},[],{"_3162":65394,"_27851":65327,"_19309":110306,"_5":13254,"_25377":110123,"_2660":110307},[],"Región AWS donde opera el conector.",{"_3162":65395,"_27851":65327,"_19309":110309,"_5":13254,"_25377":110123,"_2660":49299},[],{"_3162":65396,"_27851":65327,"_19309":110311,"_5":13254,"_25377":110123,"_2660":23097},[],{"_3162":65397,"_27851":65327,"_19309":110313,"_5":13254,"_25377":110123,"_2660":110295},[],{"_3162":65398,"_27851":65327,"_19309":110315,"_5":13254,"_25377":110123,"_2660":110316},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3162":65399,"_27851":65327,"_19309":110318,"_5":13254,"_25377":110123,"_2660":49309},[],{"_3162":65400,"_27851":65327,"_19309":110320,"_5":13254,"_25377":110123,"_2660":23097},[],{"_3162":65401,"_27851":65327,"_19309":110322,"_5":13254,"_25377":110123,"_2660":110323},[],"Solo con `auth_method=static`",{"_3162":65402,"_27851":65327,"_19309":110325,"_5":13254,"_25377":110123,"_2660":110326},[],"Clave de acceso AWS.",{"_3162":65403,"_27851":65327,"_19309":110328,"_5":13254,"_25377":110123,"_2660":49320},[],{"_3162":65404,"_27851":65327,"_19309":110330,"_5":13254,"_25377":110123,"_2660":23097},[],{"_3162":65405,"_27851":65327,"_19309":110332,"_5":13254,"_25377":110123,"_2660":110323},[],{"_3162":65406,"_27851":65327,"_19309":110334,"_5":13254,"_25377":110123,"_2660":110335},[],"Clave secreta AWS.",{"_3162":65407,"_27851":65327,"_19309":110337,"_5":13254,"_25377":110123,"_2660":49330},[],{"_3162":65408,"_27851":65327,"_19309":110339,"_5":13254,"_25377":110123,"_2660":23097},[],{"_3162":65409,"_27851":65327,"_19309":110341,"_5":13254,"_25377":110123,"_2660":49335},[],{"_3162":65410,"_27851":65327,"_19309":110343,"_5":13254,"_25377":110123,"_2660":110344},[],"Token de sesión (con `auth_method=static`).",{"_3162":65411,"_27851":65327,"_19309":110346,"_5":13254,"_25377":110123,"_2660":49341},[],{"_3162":65412,"_27851":65327,"_19309":110348,"_5":13254,"_25377":110123,"_2660":23097},[],{"_3162":65413,"_27851":65327,"_19309":110350,"_5":13254,"_25377":110123,"_2660":110351},[],"Solo con `auth_method=role`",{"_3162":65414,"_27851":65327,"_19309":110353,"_5":13254,"_25377":110123,"_2660":110354},[],"ARN del rol a asumir.",{"_3162":65415,"_27851":65327,"_19309":110356,"_5":13254,"_25377":110123,"_2660":49352},[],{"_3162":65416,"_27851":65327,"_19309":110358,"_5":13254,"_25377":110123,"_2660":23097},[],{"_3162":65417,"_27851":65327,"_19309":110360,"_5":13254,"_25377":110123,"_2660":49335},[],{"_3162":65418,"_27851":65327,"_19309":110362,"_5":13254,"_25377":110123,"_2660":110363},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3162":65419,"_27851":65327,"_19309":110365,"_5":13254,"_25377":110123,"_2660":49362},[],{"_3162":65420,"_27851":65327,"_19309":110367,"_5":13254,"_25377":110123,"_2660":16274},[],{"_3162":65421,"_27851":65327,"_19309":110369,"_5":13254,"_25377":110123,"_2660":110295},[],{"_3162":65422,"_27851":65327,"_19309":110371,"_5":13254,"_25377":110123,"_2660":110372},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3162":65423,"_27851":65327,"_19309":110374,"_5":13254,"_25377":110123,"_2660":49372},[],{"_3162":65424,"_27851":65327,"_19309":110376,"_5":13254,"_25377":110123,"_2660":23097},[],{"_3162":65425,"_27851":65327,"_19309":110378,"_5":13254,"_25377":110123,"_2660":110295},[],{"_3162":65426,"_27851":65327,"_19309":110380,"_5":13254,"_25377":110123,"_2660":110381},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3162":65427,"_27851":65327,"_19309":110383,"_5":13254,"_25377":110123,"_2660":49382},[],{"_3162":65428,"_27851":65327,"_19309":110385,"_5":13254,"_25377":110123,"_2660":23097},[],{"_3162":65429,"_27851":65327,"_19309":110387,"_5":13254,"_25377":110123,"_2660":110295},[],{"_3162":65430,"_27851":65327,"_19309":110389,"_5":13254,"_25377":110123,"_2660":110390},[],"URL HTTP del Device Manager de Lamassu.",{"_3162":65431,"_27851":65327,"_19309":110392,"_5":13254,"_25377":110123,"_2660":49392},[],{"_3162":65432,"_27851":65327,"_19309":110394,"_5":13254,"_25377":110123,"_2660":23097},[],{"_3162":65433,"_27851":65327,"_19309":110396,"_5":13254,"_25377":110123,"_2660":110295},[],{"_3162":65434,"_27851":65327,"_19309":110398,"_5":13254,"_25377":110123,"_2660":110399},[],"URL HTTP del servicio de CA de Lamassu.",{"_3162":65435,"_27851":65327,"_19309":110401,"_5":13254,"_25377":110127,"_2660":110402},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3162":65436,"_27851":65327,"_19309":110404,"_5":13254,"_25377":110131,"_2660":110405},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3162":65437,"_27851":65327,"_19309":110407,"_5":13254,"_25377":110131,"_2660":110408},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3162":65438,"_27851":65327,"_19309":110410,"_5":13254,"_25377":110135,"_2660":110411},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3162":65439,"_27851":65327,"_19309":110413,"_5":13254,"_25377":110135,"_2660":110414},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3162":65440,"_27851":65327,"_19309":110416,"_5":13254,"_25377":110135,"_2660":110417},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3162":65441,"_27851":65327,"_19309":110419,"_5":13254,"_25377":110135,"_2660":110420},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3162":65442,"_27851":65327,"_19309":110422,"_5":13254,"_25377":110135,"_2660":110423},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3162":65443,"_27851":65327,"_19309":110425,"_5":13254,"_25377":110135,"_2660":110426},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3162":65444,"_27851":65327,"_19309":110428,"_5":13254,"_25377":110138,"_2660":110429},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3162":65445,"_27851":65327,"_19309":110431,"_5":13254,"_25377":110141,"_2660":110432},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3162":65446,"_27851":65327,"_19309":110434,"_5":13254,"_25377":110141,"_2660":110435},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3162":65447,"_27851":65327,"_19309":110437,"_5":13254,"_25377":110145,"_2660":110438},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3162":65448,"_27851":65327,"_19309":110440,"_5":13254,"_25377":110149,"_2660":110441},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3162":65449,"_27851":65327,"_19309":110443,"_5":13254,"_25377":110149,"_2660":110444},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3162":65450,"_27851":65327,"_19309":110446,"_5":13254,"_25377":110149,"_2660":110447},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3162":65451,"_27851":65327,"_19309":110449,"_5":13254,"_25377":110149,"_2660":110450},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3162":65452,"_27851":65327,"_19309":110452,"_5":13254,"_25377":110149,"_2660":110453},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3162":65453,"_27851":65327,"_19309":110455,"_5":13254,"_25377":110149,"_2660":110456},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3162":65454,"_27851":65327,"_19309":110458,"_5":13254,"_25377":110153,"_2660":110459},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3162":65455,"_27851":65327,"_19309":110461,"_5":13254,"_25377":110153,"_2660":110462},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3162":65456,"_27851":65327,"_19309":110464,"_5":13254,"_25377":110153,"_2660":110465},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3162":65457,"_27851":65327,"_19309":110467,"_5":13254,"_25377":110157,"_2660":110468},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3162":65458,"_27851":65327,"_19309":110470,"_5":13254,"_25377":110157,"_2660":110471},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3162":65459,"_27851":65327,"_19309":110473,"_5":13254,"_25377":110157,"_2660":110474},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3162":65460,"_27851":65327,"_19309":110476,"_5":13254,"_25377":110161,"_2660":110477},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3162":65461,"_27851":65327,"_19309":110479,"_5":13254,"_25377":110161,"_2660":110480},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3162":65462,"_27851":65327,"_19309":110482,"_5":13254,"_25377":110161,"_2660":110483},[],"Para que el flujo JITP funcione correctamente:",{"_3162":65463,"_27851":65327,"_19309":110485,"_5":13254,"_25377":110161,"_2660":110486},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3162":65464,"_27851":65327,"_19309":110488,"_5":13254,"_25377":110161,"_2660":110489},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3162":65465,"_27851":65327,"_19309":110491,"_5":13254,"_25377":110161,"_2660":110492},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3162":65466,"_27851":65327,"_19309":110494,"_5":13254,"_25377":110161,"_2660":110495},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3162":65467,"_27851":65327,"_19309":110497,"_5":13254,"_25377":110165,"_2660":110498},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3162":65468,"_27851":65327,"_19309":110500,"_5":13254,"_25377":110165,"_2660":110501},[],"Estado en Lamassu",{"_3162":65469,"_27851":65327,"_19309":110503,"_5":13254,"_25377":110165,"_2660":110504},[],"Razón de revocación",{"_3162":65470,"_27851":65327,"_19309":110506,"_5":13254,"_25377":110165,"_2660":110507},[],"Estado en AWS IoT Core",{"_3162":65471,"_27851":65327,"_19309":110509,"_5":13254,"_25377":110165,"_2660":49513},[],{"_3162":65472,"_27851":65327,"_19309":110511,"_5":13254,"_25377":110165,"_2660":110512},[],"Ninguna",{"_3162":65473,"_27851":65327,"_19309":110514,"_5":13254,"_25377":110165,"_2660":49519},[],{"_3162":65474,"_27851":65327,"_19309":110516,"_5":13254,"_25377":110165,"_2660":49522},[],{"_3162":65475,"_27851":65327,"_19309":110518,"_5":13254,"_25377":110165,"_2660":49525},[],{"_3162":65476,"_27851":65327,"_19309":110520,"_5":13254,"_25377":110165,"_2660":49528},[],{"_3162":65477,"_27851":65327,"_19309":110522,"_5":13254,"_25377":110165,"_2660":49522},[],{"_3162":65478,"_27851":65327,"_19309":110524,"_5":13254,"_25377":110165,"_2660":110525},[],"Cualquier otra razón",{"_3162":65479,"_27851":65327,"_19309":110527,"_5":13254,"_25377":110165,"_2660":49536},[],{"_3162":65480,"_27851":65327,"_19309":110529,"_5":13254,"_25377":110165,"_2660":110530},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3162":65481,"_27851":65327,"_19309":110532,"_5":13254,"_25377":110169,"_2660":110533},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3162":65482,"_27851":65327,"_19309":110535,"_5":13254,"_25377":110169,"_2660":110536},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3162":65483,"_27851":65327,"_19309":110538,"_5":13254,"_25377":110169,"_2660":110539},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3162":65484,"_27851":65327,"_19309":110541,"_5":13254,"_25377":110173,"_2660":110542},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3162":65485,"_27851":65327,"_19309":110544,"_5":13254,"_25377":110173,"_2660":110545},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3162":65486,"_27851":65327,"_19309":110547,"_5":13254,"_25377":110177,"_2660":110548},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3162":65487,"_27851":65327,"_19309":110550,"_5":13254,"_25377":110177,"_2660":110551},[],"Existen dos tipos de acciones:",{"_3162":65488,"_27851":65327,"_19309":110553,"_5":13254,"_25377":110177,"_2660":110554},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3162":65489,"_27851":65327,"_19309":110556,"_5":13254,"_25377":110177,"_2660":110557},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3162":65490,"_27851":65327,"_19309":110559,"_5":13254,"_25377":110177,"_2660":110560},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3162":65491,"_27851":65327,"_19309":110562,"_5":13254,"_25377":110181,"_2660":110563},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3162":65492,"_27851":65327,"_19309":110565,"_5":13254,"_25377":110181,"_2660":110566},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3162":65493,"_27851":65327,"_19309":110568,"_5":13254,"_25377":110181,"_2660":110569},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3162":65494,"_27851":65327,"_19309":110571,"_5":13254,"_25377":110185,"_2660":110572},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3162":65495,"_27851":65327,"_19309":110574,"_5":13254,"_25377":110185,"_2660":110575},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3162":65496,"_27851":65327,"_19309":110577,"_5":13254,"_25377":110185,"_2660":110578},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3162":65497,"_27851":65327,"_19309":110580,"_5":13254,"_25377":110185,"_2660":110581},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3162":65498,"_27851":65327,"_19309":110583,"_5":13254,"_25377":110185,"_2660":110584},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3162":65499,"_27851":65327,"_19309":110586,"_5":13254,"_25377":110185,"_2660":110587},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3162":65500,"_27851":65327,"_19309":110589,"_5":13254,"_25377":110185,"_2660":110590},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3162":65501,"_27851":65327,"_19309":110592,"_5":13254,"_25377":110185,"_2660":110593},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3162":65502,"_27851":65327,"_19309":110595,"_5":13254,"_25377":110185,"_2660":110596},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3162":65503,"_27851":65327,"_19309":110598,"_5":13254,"_25377":110185,"_2660":110599},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3162":65504,"_27851":65327,"_19309":110601,"_5":13254,"_25377":110185,"_2660":110602},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3162":65505,"_27851":65327,"_19309":110604,"_5":13254,"_25377":110185,"_2660":110605},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3162":65506,"_27851":65327,"_19309":110607,"_5":13254,"_25377":110185,"_2660":110608},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3162":65507,"_27851":65327,"_19309":110610,"_5":13254,"_25377":110185,"_2660":110611},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3162":65508,"_27851":65327,"_19309":110613,"_5":13254,"_25377":110185,"_2660":110614},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3162":65509,"_27851":65327,"_19309":110616,"_5":13254,"_25377":110185,"_2660":110617},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3162":65510,"_27851":65327,"_19309":110619,"_5":13254,"_25377":110185,"_2660":110620},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3162":65511,"_27851":65327,"_19309":110622,"_5":13254,"_25377":110185,"_2660":110623},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3162":65512,"_27851":65327,"_19309":110625,"_5":13254,"_25377":110185,"_2660":110626},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3162":65513,"_27851":65327,"_19309":110628,"_5":13254,"_25377":110185,"_2660":110629},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3162":65514,"_27851":65327,"_19309":110631,"_5":13254,"_25377":110185,"_2660":110632},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3162":65515,"_27851":65515,"_5":13585,"_2660":47616,"_28194":110634,"_19309":110635,"_25377":65515},[45228,107691,47616],[],{"_3162":65516,"_27851":65515,"_19309":110637,"_5":13254,"_25377":65515,"_2660":110638},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3162":65517,"_27851":65515,"_5":28191,"_19309":110640,"_25377":110641,"_2660":110642},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3162":65518,"_27851":65515,"_5":28191,"_19309":110644,"_25377":110645,"_2660":108697},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3162":65519,"_27851":65515,"_5":28191,"_19309":110647,"_25377":110648,"_2660":108872},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3162":65520,"_27851":65515,"_5":28191,"_19309":110650,"_25377":110651,"_2660":110104},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/overview#integraciones",{"_3162":65521,"_27851":65515,"_5":28191,"_19309":110653,"_25377":110654,"_2660":110655},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3162":65522,"_27851":65515,"_19309":110657,"_5":13254,"_25377":65515,"_2660":110658},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3162":65523,"_27851":65515,"_19309":110660,"_5":13254,"_25377":110641,"_2660":110661},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3162":65524,"_27851":65515,"_19309":110663,"_5":13254,"_25377":110641,"_2660":110664},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3162":65525,"_27851":65515,"_19309":110666,"_5":13254,"_25377":110645,"_2660":110667},[],"Recurso",{"_3162":65526,"_27851":65515,"_19309":110669,"_5":13254,"_25377":110645,"_2660":110670},[],"Qué representa",{"_3162":65527,"_27851":65515,"_19309":110672,"_5":13254,"_25377":110645,"_2660":110673},[],"**Dispositivo**",{"_3162":65528,"_27851":65515,"_19309":110675,"_5":13254,"_25377":110645,"_2660":110676},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3162":65529,"_27851":65515,"_19309":110678,"_5":13254,"_25377":110645,"_2660":110679},[],"**Identidad**",{"_3162":65530,"_27851":65515,"_19309":110681,"_5":13254,"_25377":110645,"_2660":110682},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3162":65531,"_27851":65515,"_19309":110684,"_5":13254,"_25377":110645,"_2660":49694},[],{"_3162":65532,"_27851":65515,"_19309":110686,"_5":13254,"_25377":110645,"_2660":110687},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3162":65533,"_27851":65515,"_19309":110689,"_5":13254,"_25377":110645,"_2660":110690},[],"**Flota**",{"_3162":65534,"_27851":65515,"_19309":110692,"_5":13254,"_25377":110645,"_2660":110693},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3162":65535,"_27851":65515,"_19309":110695,"_5":13254,"_25377":110645,"_2660":110696},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3162":65536,"_27851":65515,"_19309":110698,"_5":13254,"_25377":110645,"_2660":110699},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3162":65537,"_27851":65515,"_19309":110701,"_5":13254,"_25377":110648,"_2660":110702},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3162":65538,"_27851":65515,"_19309":110704,"_5":13254,"_25377":110648,"_2660":110705},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3162":65539,"_27851":65515,"_19309":110707,"_5":13254,"_25377":110648,"_2660":110708},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3162":65540,"_27851":65515,"_19309":110710,"_5":13254,"_25377":110648,"_2660":110711},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3162":65541,"_27851":65515,"_19309":110713,"_5":13254,"_25377":110648,"_2660":110714},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3162":65542,"_27851":65515,"_19309":110716,"_5":13254,"_25377":110648,"_2660":110717},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3162":65543,"_27851":65515,"_19309":110719,"_5":13254,"_25377":110648,"_2660":110720},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3162":65544,"_27851":65515,"_19309":110722,"_5":13254,"_25377":110648,"_2660":110723},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3162":65545,"_27851":65515,"_19309":110725,"_5":13254,"_25377":110651,"_2660":110726},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3162":65546,"_27851":65515,"_19309":110728,"_5":13254,"_25377":110651,"_2660":110729},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3162":65547,"_27851":65515,"_19309":110731,"_5":13254,"_25377":110654,"_2660":110732},[],"Participante",{"_3162":65548,"_27851":65515,"_19309":110734,"_5":13254,"_25377":110654,"_2660":110735},[],"Responsabilidad",{"_3162":65549,"_27851":65515,"_19309":110737,"_5":13254,"_25377":110654,"_2660":110738},[],"Administrador PKI",{"_3162":65550,"_27851":65515,"_19309":110740,"_5":13254,"_25377":110654,"_2660":110741},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3162":65551,"_27851":65515,"_19309":110743,"_5":13254,"_25377":110654,"_2660":110744},[],"Administrador del aprovisionamiento",{"_3162":65552,"_27851":65515,"_19309":110746,"_5":13254,"_25377":110654,"_2660":110747},[],"DMS, admisión, autenticación por operación e inventario.",{"_3162":65553,"_27851":65515,"_19309":110749,"_5":13254,"_25377":110654,"_2660":110750},[],"Integrador del dispositivo",{"_3162":65554,"_27851":65515,"_19309":110752,"_5":13254,"_25377":110654,"_2660":110753},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3162":65555,"_27851":65515,"_19309":110755,"_5":13254,"_25377":110654,"_2660":110756},[],"Integrador del consumidor",{"_3162":65556,"_27851":65515,"_19309":110758,"_5":13254,"_25377":110654,"_2660":110759},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3162":65557,"_27851":65515,"_19309":110761,"_5":13254,"_25377":110654,"_2660":110762},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3162":65558,"_27851":65558,"_5":13585,"_2660":110764,"_28194":110765,"_19309":110767,"_25377":65558},"Enrola y conecta tu primer dispositivo",[45228,107691,47616,110766],"Primeros pasos",[],{"_3162":65559,"_27851":65558,"_19309":110769,"_5":13254,"_25377":65558,"_2660":110770},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3162":65560,"_27851":65558,"_5":28191,"_19309":110772,"_25377":110773,"_2660":106357},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3162":65561,"_27851":65558,"_5":28191,"_19309":110775,"_25377":110776,"_2660":110777},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3162":65562,"_27851":65558,"_5":28191,"_19309":110779,"_25377":110780,"_2660":110781},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3162":65563,"_27851":65558,"_5":28191,"_19309":110783,"_25377":110784,"_2660":110785},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3162":65564,"_27851":65558,"_5":28191,"_19309":110787,"_25377":110788,"_2660":110789},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3162":65565,"_27851":65558,"_5":28191,"_19309":110791,"_25377":110792,"_2660":110793},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3162":65566,"_27851":65558,"_5":28191,"_19309":110795,"_25377":110796,"_2660":110797},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3162":65567,"_27851":65558,"_5":28191,"_19309":110799,"_25377":110800,"_2660":110801},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3162":65568,"_27851":65558,"_19309":110803,"_5":13254,"_25377":65558,"_2660":110804},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3162":65569,"_27851":65558,"_19309":110806,"_5":13254,"_25377":110773,"_2660":110807},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3162":65570,"_27851":65558,"_19309":110809,"_5":13254,"_25377":110773,"_2660":110810},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3162":65571,"_27851":65558,"_19309":110812,"_5":13254,"_25377":110773,"_2660":110813},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3162":65572,"_27851":65558,"_19309":110815,"_5":13254,"_25377":110773,"_2660":110816},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3162":65573,"_27851":65558,"_19309":110818,"_5":13254,"_25377":110773,"_2660":110819},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3162":65574,"_27851":65558,"_19309":110821,"_5":13254,"_25377":110776,"_2660":110822},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3162":65575,"_27851":65558,"_19309":110824,"_5":13254,"_25377":110776,"_2660":110825},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3162":65576,"_27851":65558,"_19309":110827,"_5":13254,"_25377":110780,"_2660":110828},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3162":65577,"_27851":65558,"_19309":110830,"_5":13254,"_25377":110780,"_2660":110831},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3162":65578,"_27851":65558,"_19309":110833,"_5":13254,"_25377":110780,"_2660":110834},[],"Ajuste",{"_3162":65579,"_27851":65558,"_19309":110836,"_5":13254,"_25377":110780,"_2660":110837},[],"Valor de evaluación",{"_3162":65580,"_27851":65558,"_19309":110839,"_5":13254,"_25377":110780,"_2660":49850},[],{"_3162":65581,"_27851":65558,"_19309":110841,"_5":13254,"_25377":110780,"_2660":110842},[],"Raíz emisora de `device-root.pem`.",{"_3162":65582,"_27851":65558,"_19309":110844,"_5":13254,"_25377":110780,"_2660":109000},[],{"_3162":65583,"_27851":65558,"_19309":110846,"_5":13254,"_25377":110780,"_2660":110847},[],"Perfil final de 1 hora que acabas de preparar.",{"_3162":65584,"_27851":65558,"_19309":110849,"_5":13254,"_25377":110780,"_2660":49861},[],{"_3162":65585,"_27851":65558,"_19309":110851,"_5":13254,"_25377":110780,"_2660":49864},[],{"_3162":65586,"_27851":65558,"_19309":110853,"_5":13254,"_25377":110780,"_2660":49867},[],{"_3162":65587,"_27851":65558,"_19309":110855,"_5":13254,"_25377":110780,"_2660":110856},[],"Habilitado.",{"_3162":65588,"_27851":65558,"_19309":110858,"_5":13254,"_25377":110780,"_2660":49873},[],{"_3162":65589,"_27851":65558,"_19309":110860,"_5":13254,"_25377":110780,"_2660":110861},[],"Deshabilitado; el ID debe ser nuevo.",{"_3162":65590,"_27851":65558,"_19309":110863,"_5":13254,"_25377":110780,"_2660":110864},[],"Autenticación inicial",{"_3162":65591,"_27851":65558,"_19309":110866,"_5":13254,"_25377":110780,"_2660":110867},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3162":65592,"_27851":65558,"_19309":110869,"_5":13254,"_25377":110780,"_2660":110870},[],"Autenticación de renovación",{"_3162":65593,"_27851":65558,"_19309":110872,"_5":13254,"_25377":110780,"_2660":110873},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3162":65594,"_27851":65558,"_19309":110875,"_5":13254,"_25377":110780,"_2660":49891},[],{"_3162":65595,"_27851":65558,"_19309":110877,"_5":13254,"_25377":110780,"_2660":110878},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3162":65596,"_27851":65558,"_19309":110880,"_5":13254,"_25377":110780,"_2660":49897},[],{"_3162":65597,"_27851":65558,"_19309":110882,"_5":13254,"_25377":110780,"_2660":110883},[],"1 hora.",{"_3162":65598,"_27851":65558,"_19309":110885,"_5":13254,"_25377":110780,"_2660":49903},[],{"_3162":65599,"_27851":65558,"_19309":110887,"_5":13254,"_25377":110780,"_2660":110888},[],"30 minutos / 10 minutos.",{"_3162":65600,"_27851":65558,"_19309":110890,"_5":13254,"_25377":110780,"_2660":49909},[],{"_3162":65601,"_27851":65558,"_19309":110892,"_5":13254,"_25377":110780,"_2660":110893},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3162":65602,"_27851":65558,"_19309":110895,"_5":13254,"_25377":110780,"_2660":47935},[],{"_3162":65603,"_27851":65558,"_19309":110897,"_5":13254,"_25377":110780,"_2660":110898},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3162":65604,"_27851":65558,"_19309":110900,"_5":13254,"_25377":110780,"_2660":49920},[],{"_3162":65605,"_27851":65558,"_19309":110902,"_5":13254,"_25377":110780,"_2660":110903},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3162":65606,"_27851":65558,"_19309":110905,"_5":13254,"_25377":110780,"_2660":110906},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3162":65607,"_27851":65558,"_19309":110908,"_5":13254,"_25377":110784,"_2660":110909},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3162":65608,"_27851":65558,"_19309":110911,"_5":13254,"_25377":110784,"_2660":110912},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3162":65609,"_27851":65558,"_19309":110914,"_5":13254,"_25377":110788,"_2660":110915},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3162":65610,"_27851":65558,"_19309":110917,"_5":13254,"_25377":110788,"_2660":110918},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3162":65611,"_27851":65558,"_19309":110920,"_5":13254,"_25377":110788,"_2660":110921},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3162":65612,"_27851":65558,"_19309":110923,"_5":13254,"_25377":110792,"_2660":110924},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3162":65613,"_27851":65558,"_19309":110926,"_5":13254,"_25377":110792,"_2660":110927},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3162":65614,"_27851":65558,"_19309":110929,"_5":13254,"_25377":110796,"_2660":110930},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3162":65615,"_27851":65558,"_19309":110932,"_5":13254,"_25377":110796,"_2660":110933},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3162":65616,"_27851":65558,"_19309":110935,"_5":13254,"_25377":110796,"_2660":110936},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3162":65617,"_27851":65558,"_19309":110938,"_5":13254,"_25377":110796,"_2660":110939},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3162":65618,"_27851":65558,"_19309":110941,"_5":13254,"_25377":110796,"_2660":110942},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3162":65619,"_27851":65558,"_19309":110944,"_5":13254,"_25377":110800,"_2660":110945},[],"Comprobación",{"_3162":65620,"_27851":65558,"_19309":110947,"_5":13254,"_25377":110800,"_2660":110948},[],"Resultado esperado",{"_3162":65621,"_27851":65558,"_19309":110950,"_5":13254,"_25377":110800,"_2660":110951},[],"Registro",{"_3162":65622,"_27851":65558,"_19309":110953,"_5":13254,"_25377":110800,"_2660":110954},[],"ID creado automáticamente y DMS correcto.",{"_3162":65623,"_27851":65558,"_19309":110956,"_5":13254,"_25377":110800,"_2660":110957},[],"Certificado",{"_3162":65624,"_27851":65558,"_19309":110959,"_5":13254,"_25377":110800,"_2660":110960},[],"CN, perfil, serie y clave verificados.",{"_3162":65625,"_27851":65558,"_19309":110962,"_5":13254,"_25377":110800,"_2660":110963},[],"Inventario",{"_3162":65626,"_27851":65558,"_19309":110965,"_5":13254,"_25377":110800,"_2660":110966},[],"Serie recibida visible como identidad actual y en el historial.",{"_3162":65627,"_27851":65558,"_19309":110968,"_5":13254,"_25377":110800,"_2660":110969},[],"Consumidor",{"_3162":65628,"_27851":65558,"_19309":110971,"_5":13254,"_25377":110800,"_2660":110972},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3162":65629,"_27851":65558,"_19309":110974,"_5":13254,"_25377":110800,"_2660":110975},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3162":65630,"_27851":65558,"_19309":110977,"_5":13254,"_25377":110800,"_2660":110978},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3162":65631,"_27851":65631,"_5":13585,"_2660":108714,"_28194":110980,"_19309":110981,"_25377":65631},[45228,107691,47616,110766],[],{"_3162":65632,"_27851":65631,"_19309":110983,"_5":13254,"_25377":65631,"_2660":110984},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3162":65633,"_27851":65631,"_5":28191,"_19309":110986,"_25377":110987,"_2660":106357},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3162":65634,"_27851":65631,"_5":28191,"_19309":110989,"_25377":110990,"_2660":110991},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3162":65635,"_27851":65631,"_5":28191,"_19309":110993,"_25377":110994,"_2660":110995},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3162":65636,"_27851":65631,"_5":28191,"_19309":110997,"_25377":110998,"_2660":110999},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3162":65637,"_27851":65631,"_5":28191,"_19309":111001,"_25377":111002,"_2660":111003},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3162":65638,"_27851":65631,"_5":28191,"_19309":111005,"_25377":111006,"_2660":111007},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3162":65639,"_27851":65631,"_5":28191,"_19309":111009,"_25377":111010,"_2660":110948},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3162":65640,"_27851":65631,"_5":28191,"_19309":111012,"_25377":111013,"_2660":111014},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3162":65641,"_27851":65631,"_5":28191,"_19309":111016,"_25377":111017,"_2660":111018},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3162":65642,"_27851":65631,"_19309":111020,"_5":13254,"_25377":65631,"_2660":111021},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3162":65643,"_27851":65631,"_19309":111023,"_5":13254,"_25377":65631,"_2660":111024},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3162":65644,"_27851":65631,"_19309":111026,"_5":13254,"_25377":110987,"_2660":111027},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3162":65645,"_27851":65631,"_19309":111029,"_5":13254,"_25377":110987,"_2660":111030},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3162":65646,"_27851":65631,"_19309":111032,"_5":13254,"_25377":110987,"_2660":111033},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3162":65647,"_27851":65631,"_19309":111035,"_5":13254,"_25377":110987,"_2660":111036},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3162":65648,"_27851":65631,"_19309":111038,"_5":13254,"_25377":110990,"_2660":111039},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3162":65649,"_27851":65631,"_19309":111041,"_5":13254,"_25377":110990,"_2660":111042},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3162":65650,"_27851":65631,"_19309":111044,"_5":13254,"_25377":110990,"_2660":111045},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3162":65651,"_27851":65631,"_19309":111047,"_5":13254,"_25377":110990,"_2660":111048},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3162":65652,"_27851":65631,"_19309":111050,"_5":13254,"_25377":110990,"_2660":111051},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3162":65653,"_27851":65631,"_19309":111053,"_5":13254,"_25377":110990,"_2660":111054},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3162":65654,"_27851":65631,"_19309":111056,"_5":13254,"_25377":110990,"_2660":111057},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3162":65655,"_27851":65631,"_19309":111059,"_5":13254,"_25377":110990,"_2660":111060},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3162":65656,"_27851":65631,"_19309":111062,"_5":13254,"_25377":110994,"_2660":111063},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3162":65657,"_27851":65631,"_19309":111065,"_5":13254,"_25377":110994,"_2660":50086},[],{"_3162":65658,"_27851":65631,"_19309":111067,"_5":13254,"_25377":110994,"_2660":111068},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3162":65659,"_27851":65631,"_19309":111070,"_5":13254,"_25377":110994,"_2660":111071},[],"**Icon** y **Tags**: clasificación opcional.",{"_3162":65660,"_27851":65631,"_19309":111073,"_5":13254,"_25377":110994,"_2660":111074},[],"Confirma el registro.",{"_3162":65661,"_27851":65631,"_19309":111076,"_5":13254,"_25377":110998,"_2660":111077},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3162":65662,"_27851":65631,"_19309":111079,"_5":13254,"_25377":110998,"_2660":111080},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3162":65663,"_27851":65631,"_19309":111082,"_5":13254,"_25377":111002,"_2660":111083},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3162":65664,"_27851":65631,"_19309":111085,"_5":13254,"_25377":111002,"_2660":111086},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3162":65665,"_27851":65631,"_19309":111088,"_5":13254,"_25377":111006,"_2660":111089},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3162":65666,"_27851":65631,"_19309":111091,"_5":13254,"_25377":111006,"_2660":111092},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3162":65667,"_27851":65631,"_19309":111094,"_5":13254,"_25377":111010,"_2660":110945},[],{"_3162":65668,"_27851":65631,"_19309":111096,"_5":13254,"_25377":111010,"_2660":111097},[],"Resultado",{"_3162":65669,"_27851":65631,"_19309":111099,"_5":13254,"_25377":111010,"_2660":111100},[],"Dispositivo",{"_3162":65670,"_27851":65631,"_19309":111102,"_5":13254,"_25377":111010,"_2660":111103},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3162":65671,"_27851":65631,"_19309":111105,"_5":13254,"_25377":111010,"_2660":111106},[],"Identidad actual",{"_3162":65672,"_27851":65631,"_19309":111108,"_5":13254,"_25377":111010,"_2660":111109},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3162":65673,"_27851":65631,"_19309":111111,"_5":13254,"_25377":111010,"_2660":111112},[],"Historial",{"_3162":65674,"_27851":65631,"_19309":111114,"_5":13254,"_25377":111010,"_2660":111115},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3162":65675,"_27851":65631,"_19309":111117,"_5":13254,"_25377":111010,"_2660":111118},[],"Clave y certificado",{"_3162":65676,"_27851":65631,"_19309":111120,"_5":13254,"_25377":111010,"_2660":111121},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3162":65677,"_27851":65631,"_19309":111123,"_5":13254,"_25377":111013,"_2660":111124},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3162":65678,"_27851":65631,"_19309":111126,"_5":13254,"_25377":111013,"_2660":111127},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3162":65679,"_27851":65631,"_19309":111129,"_5":13254,"_25377":111013,"_2660":111130},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3162":65680,"_27851":65631,"_19309":111132,"_5":13254,"_25377":111013,"_2660":111133},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3162":65681,"_27851":65631,"_19309":111135,"_5":13254,"_25377":111017,"_2660":111136},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3162":65682,"_27851":65631,"_19309":111138,"_5":13254,"_25377":111017,"_2660":111139},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3162":65683,"_27851":65631,"_19309":111141,"_5":13254,"_25377":111017,"_2660":111142},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3162":65684,"_27851":65684,"_5":13585,"_2660":111144,"_28194":111145,"_19309":111146,"_25377":65684},"Plataforma Lamassu IoT",[45228,107691],[],{"_3162":65685,"_27851":65684,"_19309":111148,"_5":13254,"_25377":65684,"_2660":111149},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3162":65686,"_27851":65684,"_5":28191,"_19309":111151,"_25377":111152,"_2660":110642},[],"/docs/pr-preview/pr-39/es/platform/overview#empieza-aquí",{"_3162":65687,"_27851":65684,"_5":28191,"_19309":111154,"_25377":111155,"_2660":111156},[],"/docs/pr-preview/pr-39/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3162":65688,"_27851":65684,"_5":28191,"_19309":111158,"_25377":111159,"_2660":111160},[],"/docs/pr-preview/pr-39/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3162":65689,"_27851":65684,"_5":28191,"_19309":111162,"_25377":111163,"_2660":111164},[],"/docs/pr-preview/pr-39/es/platform/overview#capacidades-principales","Capacidades principales",{"_3162":65690,"_27851":65684,"_5":28191,"_19309":111166,"_25377":111167,"_2660":111168},[],"/docs/pr-preview/pr-39/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3162":65691,"_27851":65684,"_5":28191,"_19309":111170,"_25377":111171,"_2660":111172},[],"/docs/pr-preview/pr-39/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3162":65692,"_27851":65684,"_5":28191,"_19309":111174,"_25377":111175,"_2660":111176},[],"/docs/pr-preview/pr-39/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3162":65693,"_27851":65684,"_5":28191,"_19309":111178,"_25377":111179,"_2660":111180},[],"/docs/pr-preview/pr-39/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3162":65694,"_27851":65684,"_5":28191,"_19309":111182,"_25377":111183,"_2660":111184},[],"/docs/pr-preview/pr-39/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3162":65695,"_27851":65684,"_5":28191,"_19309":111186,"_25377":111187,"_2660":111188},[],"/docs/pr-preview/pr-39/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3162":65696,"_27851":65684,"_5":28191,"_19309":111190,"_25377":111191,"_2660":111192},[],"/docs/pr-preview/pr-39/es/platform/overview#referencia-operativa","Referencia operativa",{"_3162":65697,"_27851":65684,"_19309":111194,"_5":13254,"_25377":65684,"_2660":111195},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3162":65698,"_27851":65684,"_19309":111197,"_5":13254,"_25377":111152,"_2660":111198},[],"Elige el resultado que necesitas obtener:",{"_3162":65699,"_27851":65684,"_19309":111200,"_5":13254,"_25377":111152,"_2660":111201},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3162":65700,"_27851":65684,"_19309":111203,"_5":13254,"_25377":111152,"_2660":111204},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3162":65701,"_27851":65684,"_19309":111206,"_5":13254,"_25377":111152,"_2660":111207},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3162":65702,"_27851":65684,"_19309":111209,"_5":13254,"_25377":111155,"_2660":111210},[],"Bloque",{"_3162":65703,"_27851":65684,"_19309":111212,"_5":13254,"_25377":111155,"_2660":111213},[],"Qué gestionas",{"_3162":65704,"_27851":65684,"_19309":111215,"_5":13254,"_25377":111155,"_2660":111216},[],"Punto de entrada",{"_3162":65705,"_27851":65684,"_19309":111218,"_5":13254,"_25377":111155,"_2660":50240},[],{"_3162":65706,"_27851":65684,"_19309":111220,"_5":13254,"_25377":111155,"_2660":111221},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3162":65707,"_27851":65684,"_19309":111223,"_5":13254,"_25377":111155,"_2660":111224},[],"Visión general de PKI",{"_3162":65708,"_27851":65684,"_19309":111226,"_5":13254,"_25377":111155,"_2660":50249},[],{"_3162":65709,"_27851":65684,"_19309":111228,"_5":13254,"_25377":111155,"_2660":111229},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3162":65710,"_27851":65684,"_19309":111231,"_5":13254,"_25377":111155,"_2660":111232},[],"Visión general de IoT Fleets",{"_3162":65711,"_27851":65684,"_19309":111234,"_5":13254,"_25377":111155,"_2660":111235},[],"**Administración**",{"_3162":65712,"_27851":65684,"_19309":111237,"_5":13254,"_25377":111155,"_2660":111238},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3162":65713,"_27851":65684,"_19309":111240,"_5":13254,"_25377":111155,"_2660":107689},[],{"_3162":65714,"_27851":65684,"_19309":111242,"_5":13254,"_25377":111155,"_2660":111243},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3162":65715,"_27851":65684,"_19309":111245,"_5":13254,"_25377":111159,"_2660":111246},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3162":65716,"_27851":65684,"_19309":111248,"_5":13254,"_25377":111159,"_2660":111249},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3162":65717,"_27851":65684,"_19309":111251,"_5":13254,"_25377":111159,"_2660":111252},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3162":65718,"_27851":65684,"_19309":111254,"_5":13254,"_25377":111159,"_2660":111255},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3162":65719,"_27851":65684,"_19309":111257,"_5":13254,"_25377":111159,"_2660":111258},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3162":65720,"_27851":65684,"_19309":111260,"_5":13254,"_25377":111159,"_2660":111261},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3162":65721,"_27851":65684,"_19309":111263,"_5":13254,"_25377":111167,"_2660":111264},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3162":65722,"_27851":65684,"_19309":111266,"_5":13254,"_25377":111171,"_2660":111267},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3162":65723,"_27851":65684,"_19309":111269,"_5":13254,"_25377":111175,"_2660":111270},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3162":65724,"_27851":65684,"_19309":111272,"_5":13254,"_25377":111179,"_2660":111273},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3162":65725,"_27851":65684,"_19309":111275,"_5":13254,"_25377":111183,"_2660":111276},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3162":65726,"_27851":65684,"_19309":111278,"_5":13254,"_25377":111187,"_2660":111279},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3162":65727,"_27851":65684,"_19309":111281,"_5":13254,"_25377":111191,"_2660":110735},[],{"_3162":65728,"_27851":65684,"_19309":111283,"_5":13254,"_25377":111191,"_2660":111284},[],"Qué prepara o comprueba",{"_3162":65729,"_27851":65684,"_19309":111286,"_5":13254,"_25377":111191,"_2660":110738},[],{"_3162":65730,"_27851":65684,"_19309":111288,"_5":13254,"_25377":111191,"_2660":111289},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3162":65731,"_27851":65684,"_19309":111291,"_5":13254,"_25377":111191,"_2660":111292},[],"Administrador de la flota",{"_3162":65732,"_27851":65684,"_19309":111294,"_5":13254,"_25377":111191,"_2660":111295},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3162":65733,"_27851":65684,"_19309":111297,"_5":13254,"_25377":111191,"_2660":110750},[],{"_3162":65734,"_27851":65684,"_19309":111299,"_5":13254,"_25377":111191,"_2660":111300},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3162":65735,"_27851":65684,"_19309":111302,"_5":13254,"_25377":111191,"_2660":110756},[],{"_3162":65736,"_27851":65684,"_19309":111304,"_5":13254,"_25377":111191,"_2660":111305},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3162":65737,"_27851":65684,"_19309":111307,"_5":13254,"_25377":111191,"_2660":111308},[],"Operador de infraestructura",{"_3162":65738,"_27851":65684,"_19309":111310,"_5":13254,"_25377":111191,"_2660":111311},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3162":65739,"_27851":65684,"_19309":111313,"_5":13254,"_25377":111191,"_2660":111314},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3162":65740,"_27851":65740,"_5":13585,"_2660":111316,"_28194":111317,"_19309":111319,"_25377":65740},"Jerarquía y rotación de CAs",[45228,107691,50341,111318],"Claves, autoridades y certificados",[],{"_3162":65741,"_27851":65740,"_19309":111321,"_5":13254,"_25377":65740,"_2660":111322},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3162":65742,"_27851":65740,"_5":28191,"_19309":111324,"_25377":111325,"_2660":111326},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3162":65743,"_27851":65740,"_5":28191,"_19309":111328,"_25377":111329,"_2660":111330},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3162":65744,"_27851":65740,"_5":28191,"_19309":111332,"_25377":111333,"_2660":111334},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3162":65745,"_27851":65740,"_5":28191,"_19309":111336,"_25377":111337,"_2660":111338},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3162":65746,"_27851":65740,"_5":28191,"_19309":111340,"_25377":111341,"_2660":111342},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3162":65747,"_27851":65740,"_5":28191,"_19309":111344,"_25377":111345,"_2660":111346},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3162":65748,"_27851":65740,"_5":28191,"_19309":111348,"_25377":111349,"_2660":111350},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3162":65749,"_27851":65740,"_5":28191,"_19309":111352,"_25377":111353,"_2660":111354},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3162":65750,"_27851":65740,"_5":28191,"_19309":111356,"_25377":111357,"_2660":111358},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3162":65751,"_27851":65740,"_5":28191,"_19309":111360,"_25377":111361,"_2660":111362},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3162":65752,"_27851":65740,"_5":28191,"_19309":111364,"_25377":111365,"_2660":111366},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3162":65753,"_27851":65740,"_5":28191,"_19309":111368,"_25377":111369,"_2660":111370},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3162":65754,"_27851":65740,"_19309":111372,"_5":13254,"_25377":65740,"_2660":111373},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3162":65755,"_27851":65740,"_19309":111375,"_5":13254,"_25377":65740,"_2660":111376},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3162":65756,"_27851":65740,"_19309":111378,"_5":13254,"_25377":111325,"_2660":111379},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3162":65757,"_27851":65740,"_19309":111381,"_5":13254,"_25377":111325,"_2660":111382},[],"entorno, como producción y preproducción;",{"_3162":65758,"_27851":65740,"_19309":111384,"_5":13254,"_25377":111325,"_2660":111385},[],"propietario o equipo operador;",{"_3162":65759,"_27851":65740,"_19309":111387,"_5":13254,"_25377":111325,"_2660":111388},[],"familia de dispositivos o proceso de fabricación;",{"_3162":65760,"_27851":65740,"_19309":111390,"_5":13254,"_25377":111325,"_2660":111391},[],"región o requisito regulatorio;",{"_3162":65761,"_27851":65740,"_19309":111393,"_5":13254,"_25377":111325,"_2660":111394},[],"motor criptográfico o política de clave;",{"_3162":65762,"_27851":65740,"_19309":111396,"_5":13254,"_25377":111325,"_2660":111397},[],"ventana de mantenimiento y ritmo de renovación.",{"_3162":65763,"_27851":65740,"_19309":111399,"_5":13254,"_25377":111325,"_2660":111400},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3162":65764,"_27851":65740,"_19309":111402,"_5":13254,"_25377":111325,"_2660":111403},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3162":65765,"_27851":65740,"_19309":111405,"_5":13254,"_25377":111329,"_2660":111406},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3162":65766,"_27851":65740,"_19309":111408,"_5":13254,"_25377":111329,"_2660":111409},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3162":65767,"_27851":65740,"_19309":111411,"_5":13254,"_25377":111329,"_2660":111412},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3162":65768,"_27851":65740,"_19309":111414,"_5":13254,"_25377":111333,"_2660":111415},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3162":65769,"_27851":65740,"_19309":111417,"_5":13254,"_25377":111333,"_2660":111418},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3162":65770,"_27851":65740,"_19309":111420,"_5":13254,"_25377":111333,"_2660":111421},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3162":65771,"_27851":65740,"_19309":111423,"_5":13254,"_25377":111333,"_2660":111424},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3162":65772,"_27851":65740,"_19309":111426,"_5":13254,"_25377":111341,"_2660":111427},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3162":65773,"_27851":65740,"_19309":111429,"_5":13254,"_25377":111345,"_2660":111430},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3162":65774,"_27851":65740,"_19309":111432,"_5":13254,"_25377":111349,"_2660":111433},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3162":65775,"_27851":65740,"_19309":111435,"_5":13254,"_25377":111353,"_2660":111436},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3162":65776,"_27851":65740,"_19309":111438,"_5":13254,"_25377":111357,"_2660":111439},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3162":65777,"_27851":65740,"_19309":111441,"_5":13254,"_25377":111361,"_2660":111442},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3162":65778,"_27851":65740,"_19309":111444,"_5":13254,"_25377":111365,"_2660":111445},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3162":65779,"_27851":65740,"_19309":111447,"_5":13254,"_25377":111365,"_2660":111448},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3162":65780,"_27851":65740,"_19309":111450,"_5":13254,"_25377":111365,"_2660":111451},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3162":65781,"_27851":65740,"_19309":111453,"_5":13254,"_25377":111365,"_2660":111454},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3162":65782,"_27851":65740,"_19309":111456,"_5":13254,"_25377":111369,"_2660":111457},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3162":65783,"_27851":65740,"_19309":111459,"_5":13254,"_25377":111369,"_2660":111460},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3162":65784,"_27851":65740,"_19309":111462,"_5":13254,"_25377":111369,"_2660":111463},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3162":65785,"_27851":65740,"_19309":111465,"_5":13254,"_25377":111369,"_2660":111466},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3162":65786,"_27851":65740,"_19309":111468,"_5":13254,"_25377":111369,"_2660":111469},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3162":65787,"_27851":65740,"_19309":111471,"_5":13254,"_25377":111369,"_2660":111472},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3162":65788,"_27851":65740,"_19309":111474,"_5":13254,"_25377":111369,"_2660":111475},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3162":65789,"_27851":65789,"_5":13585,"_2660":111477,"_28194":111478,"_19309":111479,"_25377":65789},"Autoridades de certificación",[45228,107691,50341,111318],[],{"_3162":65790,"_27851":65789,"_19309":111481,"_5":13254,"_25377":65789,"_2660":111482},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3162":65791,"_27851":65789,"_5":28191,"_19309":111484,"_25377":111485,"_2660":111486},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3162":65792,"_27851":65789,"_5":28191,"_19309":111488,"_25377":111489,"_2660":111490},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3162":65793,"_27851":65789,"_5":28191,"_19309":111492,"_25377":111493,"_2660":106357},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3162":65794,"_27851":65789,"_5":28191,"_19309":111495,"_25377":111496,"_2660":111497},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3162":65795,"_27851":65789,"_5":28191,"_19309":111499,"_25377":111500,"_2660":111501},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3162":65796,"_27851":65789,"_5":28191,"_19309":111503,"_25377":111504,"_2660":111505},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3162":65797,"_27851":65789,"_5":28191,"_19309":111507,"_25377":111508,"_2660":111509},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3162":65798,"_27851":65789,"_5":28191,"_19309":111511,"_25377":111512,"_2660":111513},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3162":65799,"_27851":65789,"_5":28191,"_19309":111515,"_25377":111516,"_2660":111517},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3162":65800,"_27851":65789,"_5":28191,"_19309":111519,"_25377":111520,"_2660":111521},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3162":65801,"_27851":65789,"_5":28191,"_19309":111523,"_25377":111524,"_2660":111525},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3162":65802,"_27851":65789,"_5":28191,"_19309":111527,"_25377":111528,"_2660":111529},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3162":65803,"_27851":65789,"_5":28191,"_19309":111531,"_25377":111532,"_2660":111533},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3162":65804,"_27851":65789,"_5":28191,"_19309":111535,"_25377":111536,"_2660":111537},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3162":65805,"_27851":65789,"_5":28191,"_19309":111539,"_25377":111540,"_2660":111541},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3162":65806,"_27851":65789,"_5":28191,"_19309":111543,"_25377":111544,"_2660":111545},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3162":65807,"_27851":65789,"_5":28191,"_19309":111547,"_25377":111548,"_2660":111549},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3162":65808,"_27851":65789,"_5":28191,"_19309":111551,"_25377":111552,"_2660":111553},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3162":65809,"_27851":65789,"_5":28191,"_19309":111555,"_25377":111556,"_2660":111557},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3162":65810,"_27851":65789,"_5":28191,"_19309":111559,"_25377":111560,"_2660":111561},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3162":65811,"_27851":65789,"_5":28191,"_19309":111563,"_25377":111564,"_2660":111565},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3162":65812,"_27851":65789,"_5":28191,"_19309":111567,"_25377":111568,"_2660":111569},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3162":65813,"_27851":65789,"_19309":111571,"_5":13254,"_25377":65789,"_2660":111572},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3162":65814,"_27851":65789,"_19309":111574,"_5":13254,"_25377":65789,"_2660":111575},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3162":65815,"_27851":65789,"_19309":111577,"_5":13254,"_25377":65789,"_2660":111578},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3162":65816,"_27851":65789,"_19309":111580,"_5":13254,"_25377":111485,"_2660":111581},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3162":65817,"_27851":65789,"_19309":111583,"_5":13254,"_25377":111485,"_2660":111584},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3162":65818,"_27851":65789,"_19309":111586,"_5":13254,"_25377":111485,"_2660":111587},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3162":65819,"_27851":65789,"_19309":111589,"_5":13254,"_25377":111485,"_2660":111590},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3162":65820,"_27851":65789,"_19309":111592,"_5":13254,"_25377":111485,"_2660":111593},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3162":65821,"_27851":65789,"_19309":111595,"_5":13254,"_25377":111493,"_2660":111596},[],"Decide si la CA será raíz o intermedia.",{"_3162":65822,"_27851":65789,"_19309":111598,"_5":13254,"_25377":111493,"_2660":111599},[],"Elige el motor que custodiará la clave.",{"_3162":65823,"_27851":65789,"_19309":111601,"_5":13254,"_25377":111493,"_2660":111602},[],"Define una validez superior a la de los certificados que emitirá.",{"_3162":65824,"_27851":65789,"_19309":111604,"_5":13254,"_25377":111493,"_2660":111605},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3162":65825,"_27851":65789,"_19309":111607,"_5":13254,"_25377":111496,"_2660":111608},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3162":65826,"_27851":65789,"_19309":111610,"_5":13254,"_25377":111500,"_2660":111611},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3162":65827,"_27851":65789,"_19309":111613,"_5":13254,"_25377":111500,"_2660":111614},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3162":65828,"_27851":65789,"_19309":111616,"_5":13254,"_25377":111504,"_2660":111617},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3162":65829,"_27851":65789,"_19309":111619,"_5":13254,"_25377":111508,"_2660":111620},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3162":65830,"_27851":65789,"_19309":111622,"_5":13254,"_25377":111508,"_2660":111623},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3162":65831,"_27851":65789,"_19309":111625,"_5":13254,"_25377":111508,"_2660":111626},[],"`ST`: estado o provincia.",{"_3162":65832,"_27851":65789,"_19309":111628,"_5":13254,"_25377":111508,"_2660":111629},[],"`L`: localidad.",{"_3162":65833,"_27851":65789,"_19309":111631,"_5":13254,"_25377":111508,"_2660":111632},[],"`O`: organización.",{"_3162":65834,"_27851":65789,"_19309":111634,"_5":13254,"_25377":111508,"_2660":111635},[],"`OU`: unidad organizativa.",{"_3162":65835,"_27851":65789,"_19309":111637,"_5":13254,"_25377":111508,"_2660":111638},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3162":65836,"_27851":65789,"_19309":111640,"_5":13254,"_25377":111512,"_2660":111641},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3162":65837,"_27851":65789,"_19309":111643,"_5":13254,"_25377":111512,"_2660":111644},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3162":65838,"_27851":65789,"_19309":111646,"_5":13254,"_25377":111516,"_2660":111647},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3162":65839,"_27851":65789,"_19309":111649,"_5":13254,"_25377":111516,"_2660":111650},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3162":65840,"_27851":65789,"_19309":111652,"_5":13254,"_25377":111520,"_2660":111653},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3162":65841,"_27851":65789,"_19309":111655,"_5":13254,"_25377":111520,"_2660":111656},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3162":65842,"_27851":65789,"_19309":111658,"_5":13254,"_25377":111524,"_2660":111659},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3162":65843,"_27851":65789,"_19309":111661,"_5":13254,"_25377":111528,"_2660":111662},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3162":65844,"_27851":65789,"_19309":111664,"_5":13254,"_25377":111532,"_2660":111665},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3162":65845,"_27851":65789,"_19309":111667,"_5":13254,"_25377":111536,"_2660":111668},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3162":65846,"_27851":65789,"_19309":111670,"_5":13254,"_25377":111540,"_2660":111671},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3162":65847,"_27851":65789,"_19309":111673,"_5":13254,"_25377":111540,"_2660":111674},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3162":65848,"_27851":65789,"_19309":111676,"_5":13254,"_25377":111544,"_2660":111677},[],"Abre una CA desde el inventario para consultar:",{"_3162":65849,"_27851":65789,"_19309":111679,"_5":13254,"_25377":111544,"_2660":111680},[],"Estado y periodo de validez.",{"_3162":65850,"_27851":65789,"_19309":111682,"_5":13254,"_25377":111544,"_2660":111683},[],"Certificado y cadena en formato PEM.",{"_3162":65851,"_27851":65789,"_19309":111685,"_5":13254,"_25377":111544,"_2660":111686},[],"Número de certificados activos, expirados y revocados.",{"_3162":65852,"_27851":65789,"_19309":111688,"_5":13254,"_25377":111544,"_2660":111689},[],"Certificados emitidos en **Issued Certificates**.",{"_3162":65853,"_27851":65789,"_19309":111691,"_5":13254,"_25377":111544,"_2660":111692},[],"CRL vinculada a la autoridad.",{"_3162":65854,"_27851":65789,"_19309":111694,"_5":13254,"_25377":111544,"_2660":111695},[],"Metadatos y motor criptográfico asociado.",{"_3162":65855,"_27851":65789,"_19309":111697,"_5":13254,"_25377":111544,"_2660":111698},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3162":65856,"_27851":65789,"_19309":111700,"_5":13254,"_25377":111548,"_2660":111701},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3162":65857,"_27851":65789,"_19309":111703,"_5":13254,"_25377":111548,"_2660":111704},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3162":65858,"_27851":65789,"_19309":111706,"_5":13254,"_25377":111548,"_2660":111707},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3162":65859,"_27851":65789,"_19309":111709,"_5":13254,"_25377":111548,"_2660":111710},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3162":65860,"_27851":65789,"_19309":111712,"_5":13254,"_25377":111552,"_2660":111713},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3162":65861,"_27851":65789,"_19309":111715,"_5":13254,"_25377":111556,"_2660":111716},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3162":65862,"_27851":65789,"_19309":111718,"_5":13254,"_25377":111560,"_2660":111719},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3162":65863,"_27851":65789,"_19309":111721,"_5":13254,"_25377":111564,"_2660":111722},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3162":65864,"_27851":65789,"_19309":111724,"_5":13254,"_25377":111568,"_2660":111725},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3162":65865,"_27851":65789,"_19309":111727,"_5":13254,"_25377":111568,"_2660":111728},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3162":65866,"_27851":65866,"_5":13585,"_2660":111730,"_28194":111731,"_19309":111732,"_25377":65866},"Perfiles de certificado",[45228,107691,50341,111318],[],{"_3162":65867,"_27851":65866,"_19309":111734,"_5":13254,"_25377":65866,"_2660":111735},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3162":65868,"_27851":65866,"_5":28191,"_19309":111737,"_25377":111738,"_2660":111739},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3162":65869,"_27851":65866,"_5":28191,"_19309":111741,"_25377":111742,"_2660":111743},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#validez","Validez",{"_3162":65870,"_27851":65866,"_5":28191,"_19309":111745,"_25377":111746,"_2660":111747},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3162":65871,"_27851":65866,"_5":28191,"_19309":111749,"_25377":111750,"_2660":111751},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3162":65872,"_27851":65866,"_5":28191,"_19309":111753,"_25377":111754,"_2660":111755},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3162":65873,"_27851":65866,"_5":28191,"_19309":111757,"_25377":111758,"_2660":111759},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3162":65874,"_27851":65866,"_5":28191,"_19309":111761,"_25377":111762,"_2660":111763},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3162":65875,"_27851":65866,"_5":28191,"_19309":111765,"_25377":111766,"_2660":111767},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3162":65876,"_27851":65866,"_5":28191,"_19309":111769,"_25377":111770,"_2660":111771},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3162":65877,"_27851":65866,"_5":28191,"_19309":111773,"_25377":111774,"_2660":111775},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3162":65878,"_27851":65866,"_5":28191,"_19309":111777,"_25377":111778,"_2660":111779},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3162":65879,"_27851":65866,"_5":28191,"_19309":111781,"_25377":111782,"_2660":111783},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3162":65880,"_27851":65866,"_5":28191,"_19309":111785,"_25377":111786,"_2660":111787},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3162":65881,"_27851":65866,"_5":28191,"_19309":111789,"_25377":111790,"_2660":111791},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3162":65882,"_27851":65866,"_5":28191,"_19309":111793,"_25377":111794,"_2660":111795},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3162":65883,"_27851":65866,"_5":28191,"_19309":111797,"_25377":111798,"_2660":111799},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3162":65884,"_27851":65866,"_19309":111801,"_5":13254,"_25377":65866,"_2660":111802},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3162":65885,"_27851":65866,"_19309":111804,"_5":13254,"_25377":65866,"_2660":111805},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3162":65886,"_27851":65866,"_19309":111807,"_5":13254,"_25377":111742,"_2660":111808},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3162":65887,"_27851":65866,"_19309":111810,"_5":13254,"_25377":111742,"_2660":111811},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3162":65888,"_27851":65866,"_19309":111813,"_5":13254,"_25377":111746,"_2660":111814},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3162":65889,"_27851":65866,"_19309":111816,"_5":13254,"_25377":111750,"_2660":111817},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3162":65890,"_27851":65866,"_19309":111819,"_5":13254,"_25377":111750,"_2660":111820},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3162":65891,"_27851":65866,"_19309":111822,"_5":13254,"_25377":111750,"_2660":111823},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3162":65892,"_27851":65866,"_19309":111825,"_5":13254,"_25377":111754,"_2660":111826},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3162":65893,"_27851":65866,"_19309":111828,"_5":13254,"_25377":111758,"_2660":111829},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3162":65894,"_27851":65866,"_19309":111831,"_5":13254,"_25377":111758,"_2660":111832},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3162":65895,"_27851":65866,"_19309":111834,"_5":13254,"_25377":111762,"_2660":111835},[],"La aplicación criptográfica puede:",{"_3162":65896,"_27851":65866,"_19309":111837,"_5":13254,"_25377":111762,"_2660":111838},[],"permitir o bloquear claves RSA;",{"_3162":65897,"_27851":65866,"_19309":111840,"_5":13254,"_25377":111762,"_2660":111841},[],"limitar los tamaños RSA admitidos;",{"_3162":65898,"_27851":65866,"_19309":111843,"_5":13254,"_25377":111762,"_2660":111844},[],"permitir o bloquear claves ECDSA;",{"_3162":65899,"_27851":65866,"_19309":111846,"_5":13254,"_25377":111762,"_2660":111847},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3162":65900,"_27851":65866,"_19309":111849,"_5":13254,"_25377":111762,"_2660":111850},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3162":65901,"_27851":65866,"_19309":111852,"_5":13254,"_25377":111766,"_2660":111853},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3162":65902,"_27851":65866,"_19309":111855,"_5":13254,"_25377":111766,"_2660":107482},[],{"_3162":65903,"_27851":65866,"_19309":111857,"_5":13254,"_25377":111766,"_2660":111858},[],"Primera opción",{"_3162":65904,"_27851":65866,"_19309":111860,"_5":13254,"_25377":111766,"_2660":111861},[],"Segunda opción",{"_3162":65905,"_27851":65866,"_19309":111863,"_5":13254,"_25377":111766,"_2660":111864},[],"Si no hay ninguna",{"_3162":65906,"_27851":65866,"_19309":111866,"_5":13254,"_25377":111766,"_2660":111867},[],"Firma directa con una CA",{"_3162":65907,"_27851":65866,"_19309":111869,"_5":13254,"_25377":111766,"_2660":111870},[],"`issuance_profile` incluido en la solicitud",{"_3162":65908,"_27851":65866,"_19309":111872,"_5":13254,"_25377":111766,"_2660":111873},[],"`issuance_profile_id` de la solicitud",{"_3162":65909,"_27851":65866,"_19309":111875,"_5":13254,"_25377":111766,"_2660":111876},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3162":65910,"_27851":65866,"_19309":111878,"_5":13254,"_25377":111766,"_2660":111879},[],"Emisión mediante DMS",{"_3162":65911,"_27851":65866,"_19309":111881,"_5":13254,"_25377":111766,"_2660":50906},[],{"_3162":65912,"_27851":65866,"_19309":111883,"_5":13254,"_25377":111766,"_2660":111884},[],"`settings.issuance_profile` incluido en el DMS",{"_3162":65913,"_27851":65866,"_19309":111886,"_5":13254,"_25377":111766,"_2660":111887},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3162":65914,"_27851":65866,"_19309":111889,"_5":13254,"_25377":111766,"_2660":111890},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3162":65915,"_27851":65866,"_19309":111892,"_5":13254,"_25377":111766,"_2660":111893},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3162":65916,"_27851":65866,"_19309":111895,"_5":13254,"_25377":111774,"_2660":111896},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3162":65917,"_27851":65866,"_19309":111898,"_5":13254,"_25377":111778,"_2660":111899},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3162":65918,"_27851":65866,"_19309":111901,"_5":13254,"_25377":111782,"_2660":111902},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3162":65919,"_27851":65866,"_19309":111904,"_5":13254,"_25377":111786,"_2660":111905},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3162":65920,"_27851":65866,"_19309":111907,"_5":13254,"_25377":111790,"_2660":111908},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3162":65921,"_27851":65866,"_19309":111910,"_5":13254,"_25377":111790,"_2660":111911},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3162":65922,"_27851":65866,"_19309":111913,"_5":13254,"_25377":111794,"_2660":111914},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3162":65923,"_27851":65866,"_19309":111916,"_5":13254,"_25377":111794,"_2660":111917},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3162":65924,"_27851":65866,"_19309":111919,"_5":13254,"_25377":111794,"_2660":111920},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3162":65925,"_27851":65866,"_19309":111922,"_5":13254,"_25377":111794,"_2660":111923},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3162":65926,"_27851":65866,"_19309":111925,"_5":13254,"_25377":111798,"_2660":111926},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3162":65927,"_27851":65866,"_19309":111928,"_5":13254,"_25377":111798,"_2660":111929},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3162":65928,"_27851":65928,"_5":13585,"_2660":111931,"_28194":111932,"_19309":111934,"_25377":65928},"Validación de certificados",[45228,107691,50341,111933],"Validación",[],{"_3162":65929,"_27851":65928,"_19309":111936,"_5":13254,"_25377":65928,"_2660":111937},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3162":65930,"_27851":65928,"_5":28191,"_19309":111939,"_25377":111940,"_2660":111941},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3162":65931,"_27851":65928,"_5":28191,"_19309":111943,"_25377":111944,"_2660":111945},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3162":65932,"_27851":65928,"_5":28191,"_19309":111947,"_25377":111948,"_2660":111949},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3162":65933,"_27851":65928,"_19309":111951,"_5":13254,"_25377":65928,"_2660":111952},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3162":65934,"_27851":65928,"_19309":111954,"_5":13254,"_25377":111940,"_2660":111955},[],"Verifica estos criterios juntos:",{"_3162":65935,"_27851":65928,"_19309":111957,"_5":13254,"_25377":111940,"_2660":110945},[],{"_3162":65936,"_27851":65928,"_19309":111959,"_5":13254,"_25377":111940,"_2660":111960},[],"Resultado necesario",{"_3162":65937,"_27851":65928,"_19309":111962,"_5":13254,"_25377":111940,"_2660":111963},[],"Cadena y firma",{"_3162":65938,"_27851":65928,"_19309":111965,"_5":13254,"_25377":111940,"_2660":111966},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3162":65939,"_27851":65928,"_19309":111968,"_5":13254,"_25377":111940,"_2660":111969},[],"Fechas",{"_3162":65940,"_27851":65928,"_19309":111971,"_5":13254,"_25377":111940,"_2660":111972},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3162":65941,"_27851":65928,"_19309":111974,"_5":13254,"_25377":111940,"_2660":107392},[],{"_3162":65942,"_27851":65928,"_19309":111976,"_5":13254,"_25377":111940,"_2660":111977},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3162":65943,"_27851":65928,"_19309":111979,"_5":13254,"_25377":111940,"_2660":111980},[],"Uso",{"_3162":65944,"_27851":65928,"_19309":111982,"_5":13254,"_25377":111940,"_2660":111983},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3162":65945,"_27851":65928,"_19309":111985,"_5":13254,"_25377":111940,"_2660":111986},[],"Revocación",{"_3162":65946,"_27851":65928,"_19309":111988,"_5":13254,"_25377":111940,"_2660":111989},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3162":65947,"_27851":65928,"_19309":111991,"_5":13254,"_25377":111940,"_2660":111992},[],"Autorización",{"_3162":65948,"_27851":65928,"_19309":111994,"_5":13254,"_25377":111940,"_2660":111995},[],"La aplicación permite la acción a esa identidad.",{"_3162":65949,"_27851":65928,"_19309":111997,"_5":13254,"_25377":111940,"_2660":111998},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3162":65950,"_27851":65928,"_19309":112000,"_5":13254,"_25377":111944,"_2660":112001},[],"Mecanismo",{"_3162":65951,"_27851":65928,"_19309":112003,"_5":13254,"_25377":111944,"_2660":112004},[],"Cuándo utilizarlo",{"_3162":65952,"_27851":65928,"_19309":112006,"_5":13254,"_25377":111944,"_2660":112007},[],"Qué debes mantener",{"_3162":65953,"_27851":65928,"_19309":112009,"_5":13254,"_25377":111944,"_2660":51034},[],{"_3162":65954,"_27851":65928,"_19309":112011,"_5":13254,"_25377":111944,"_2660":112012},[],"Consulta del estado de un certificado concreto.",{"_3162":65955,"_27851":65928,"_19309":112014,"_5":13254,"_25377":111944,"_2660":112015},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3162":65956,"_27851":65928,"_19309":112017,"_5":13254,"_25377":111944,"_2660":51043},[],{"_3162":65957,"_27851":65928,"_19309":112019,"_5":13254,"_25377":111944,"_2660":112020},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3162":65958,"_27851":65928,"_19309":112022,"_5":13254,"_25377":111944,"_2660":112023},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3162":65959,"_27851":65928,"_19309":112025,"_5":13254,"_25377":111944,"_2660":112026},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3162":65960,"_27851":65928,"_19309":112028,"_5":13254,"_25377":111944,"_2660":112029},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3162":65961,"_27851":65928,"_19309":112031,"_5":13254,"_25377":111948,"_2660":112032},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3162":65962,"_27851":65928,"_19309":112034,"_5":13254,"_25377":111948,"_2660":112035},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3162":65963,"_27851":65928,"_19309":112037,"_5":13254,"_25377":111948,"_2660":112038},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3162":65964,"_27851":65928,"_19309":112040,"_5":13254,"_25377":111948,"_2660":112041},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3162":65965,"_27851":65928,"_19309":112043,"_5":13254,"_25377":111948,"_2660":112044},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3162":65966,"_27851":65928,"_19309":112046,"_5":13254,"_25377":111948,"_2660":112047},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3162":65967,"_27851":65928,"_19309":112049,"_5":13254,"_25377":111948,"_2660":112050},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3162":65968,"_27851":65928,"_19309":112052,"_5":13254,"_25377":111948,"_2660":112053},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3162":65969,"_27851":65928,"_19309":112055,"_5":13254,"_25377":111948,"_2660":112056},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3162":65970,"_27851":65970,"_5":13585,"_2660":112058,"_28194":112059,"_19309":112060,"_25377":65970},"Certificados",[45228,107691,50341,111318],[],{"_3162":65971,"_27851":65970,"_19309":112062,"_5":13254,"_25377":65970,"_2660":112063},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3162":65972,"_27851":65970,"_5":28191,"_19309":112065,"_25377":112066,"_2660":112067},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3162":65973,"_27851":65970,"_5":28191,"_19309":112069,"_25377":112070,"_2660":112071},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3162":65974,"_27851":65970,"_5":28191,"_19309":112073,"_25377":112074,"_2660":112075},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3162":65975,"_27851":65970,"_5":28191,"_19309":112077,"_25377":112078,"_2660":112079},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3162":65976,"_27851":65970,"_5":28191,"_19309":112081,"_25377":112082,"_2660":112083},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3162":65977,"_27851":65970,"_5":28191,"_19309":112085,"_25377":112086,"_2660":112087},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3162":65978,"_27851":65970,"_5":28191,"_19309":112089,"_25377":112090,"_2660":112091},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3162":65979,"_27851":65970,"_5":28191,"_19309":112093,"_25377":112094,"_2660":112095},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3162":65980,"_27851":65970,"_5":28191,"_19309":112097,"_25377":112098,"_2660":112099},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#continúa","Continúa",{"_3162":65981,"_27851":65970,"_19309":112101,"_5":13254,"_25377":65970,"_2660":112102},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3162":65982,"_27851":65970,"_19309":112104,"_5":13254,"_25377":112066,"_2660":112105},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3162":65983,"_27851":65970,"_19309":112107,"_5":13254,"_25377":112066,"_2660":112108},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3162":65984,"_27851":65970,"_19309":112110,"_5":13254,"_25377":112070,"_2660":112111},[],"Descarga el PEM e inspecciónalo:",{"_3162":65985,"_27851":65970,"_19309":112113,"_5":13254,"_25377":112070,"_2660":112114},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3162":65986,"_27851":65970,"_19309":112116,"_5":13254,"_25377":112074,"_2660":112117},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3162":65987,"_27851":65970,"_19309":112119,"_5":13254,"_25377":112074,"_2660":112120},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3162":65988,"_27851":65970,"_19309":112122,"_5":13254,"_25377":112074,"_2660":112123},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3162":65989,"_27851":65970,"_19309":112125,"_5":13254,"_25377":112074,"_2660":112126},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3162":65990,"_27851":65970,"_19309":112128,"_5":13254,"_25377":112074,"_2660":112129},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3162":65991,"_27851":65970,"_19309":112131,"_5":13254,"_25377":112074,"_2660":112132},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3162":65992,"_27851":65970,"_19309":112134,"_5":13254,"_25377":112074,"_2660":112135},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3162":65993,"_27851":65970,"_19309":112137,"_5":13254,"_25377":112078,"_2660":112138},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3162":65994,"_27851":65970,"_19309":112140,"_5":13254,"_25377":112082,"_2660":112141},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3162":65995,"_27851":65970,"_19309":112143,"_5":13254,"_25377":112086,"_2660":112144},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3162":65996,"_27851":65970,"_19309":112146,"_5":13254,"_25377":112090,"_2660":112147},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3162":65997,"_27851":65970,"_19309":112149,"_5":13254,"_25377":112090,"_2660":112150},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3162":65998,"_27851":65970,"_19309":112152,"_5":13254,"_25377":112090,"_2660":112153},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3162":65999,"_27851":65970,"_19309":112155,"_5":13254,"_25377":112094,"_2660":112156},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3162":66000,"_27851":65970,"_19309":112158,"_5":13254,"_25377":112094,"_2660":112159},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3162":66001,"_27851":65970,"_19309":112161,"_5":13254,"_25377":112094,"_2660":112162},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3162":66002,"_27851":65970,"_19309":112164,"_5":13254,"_25377":112098,"_2660":112165},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3162":66003,"_27851":65970,"_19309":112167,"_5":13254,"_25377":112098,"_2660":112168},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3162":66004,"_27851":66004,"_5":13585,"_2660":112170,"_28194":112171,"_19309":112173,"_25377":66004},"Ciclo de vida de un certificado",[45228,107691,50341,112172],"Conceptos",[],{"_3162":66005,"_27851":66004,"_19309":112175,"_5":13254,"_25377":66004,"_2660":112176},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3162":66006,"_27851":66004,"_5":28191,"_19309":112178,"_25377":112179,"_2660":112180},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3162":66007,"_27851":66004,"_5":28191,"_19309":112182,"_25377":112183,"_2660":112184},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3162":66008,"_27851":66004,"_5":28191,"_19309":112186,"_25377":112187,"_2660":112188},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3162":66009,"_27851":66004,"_5":28191,"_19309":112190,"_25377":112191,"_2660":112192},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3162":66010,"_27851":66004,"_5":28191,"_19309":112194,"_25377":112195,"_2660":112196},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3162":66011,"_27851":66004,"_5":28191,"_19309":112198,"_25377":112199,"_2660":112200},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3162":66012,"_27851":66004,"_5":28191,"_19309":112202,"_25377":112203,"_2660":112204},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3162":66013,"_27851":66004,"_5":28191,"_19309":112206,"_25377":112207,"_2660":112208},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3162":66014,"_27851":66004,"_5":28191,"_19309":112210,"_25377":112211,"_2660":112212},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3162":66015,"_27851":66004,"_5":28191,"_19309":112214,"_25377":112215,"_2660":112216},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3162":66016,"_27851":66004,"_19309":112218,"_5":13254,"_25377":66004,"_2660":112219},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3162":66017,"_27851":66004,"_19309":112221,"_5":13254,"_25377":112183,"_2660":112222},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3162":66018,"_27851":66004,"_19309":112224,"_5":13254,"_25377":112187,"_2660":112225},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3162":66019,"_27851":66004,"_19309":112227,"_5":13254,"_25377":112191,"_2660":112228},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3162":66020,"_27851":66004,"_19309":112230,"_5":13254,"_25377":112195,"_2660":112231},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3162":66021,"_27851":66004,"_19309":112233,"_5":13254,"_25377":112199,"_2660":112234},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3162":66022,"_27851":66004,"_19309":112236,"_5":13254,"_25377":112203,"_2660":112237},[],"Lamassu persiste cuatro estados X.509:",{"_3162":66023,"_27851":66004,"_19309":112239,"_5":13254,"_25377":112203,"_2660":112240},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3162":66024,"_27851":66004,"_19309":112242,"_5":13254,"_25377":112203,"_2660":112243},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3162":66025,"_27851":66004,"_19309":112245,"_5":13254,"_25377":112203,"_2660":112246},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3162":66026,"_27851":66004,"_19309":112248,"_5":13254,"_25377":112203,"_2660":112249},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3162":66027,"_27851":66004,"_19309":112251,"_5":13254,"_25377":112203,"_2660":112252},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3162":66028,"_27851":66004,"_19309":112254,"_5":13254,"_25377":112207,"_2660":112255},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3162":66029,"_27851":66004,"_19309":112257,"_5":13254,"_25377":112207,"_2660":112258},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3162":66030,"_27851":66004,"_19309":112260,"_5":13254,"_25377":112207,"_2660":112261},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3162":66031,"_27851":66004,"_19309":112263,"_5":13254,"_25377":112211,"_2660":112264},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3162":66032,"_27851":66004,"_19309":112266,"_5":13254,"_25377":112211,"_2660":112267},[],"Antes de confirmar:",{"_3162":66033,"_27851":66004,"_19309":112269,"_5":13254,"_25377":112211,"_2660":112270},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3162":66034,"_27851":66004,"_19309":112272,"_5":13254,"_25377":112211,"_2660":112273},[],"Distribuye la nueva cadena de confianza.",{"_3162":66035,"_27851":66004,"_19309":112275,"_5":13254,"_25377":112211,"_2660":112276},[],"Reemite las identidades necesarias.",{"_3162":66036,"_27851":66004,"_19309":112278,"_5":13254,"_25377":112211,"_2660":112279},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3162":66037,"_27851":66004,"_19309":112281,"_5":13254,"_25377":112211,"_2660":112282},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3162":66038,"_27851":66004,"_19309":112284,"_5":13254,"_25377":112211,"_2660":112285},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3162":66039,"_27851":66004,"_19309":112287,"_5":13254,"_25377":112215,"_2660":112288},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3162":66040,"_27851":66004,"_19309":112290,"_5":13254,"_25377":112215,"_2660":112291},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3162":66041,"_27851":66004,"_19309":112293,"_5":13254,"_25377":112215,"_2660":112294},[],"Cambios de estado y razones de revocación.",{"_3162":66042,"_27851":66004,"_19309":112296,"_5":13254,"_25377":112215,"_2660":112297},[],"Publicación y vigencia de OCSP y CRLs.",{"_3162":66043,"_27851":66004,"_19309":112299,"_5":13254,"_25377":112215,"_2660":112300},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3162":66044,"_27851":66004,"_19309":112302,"_5":13254,"_25377":112215,"_2660":112303},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3162":66045,"_27851":66045,"_5":13585,"_2660":112305,"_28194":112306,"_19309":112307,"_25377":66045},"Modelo de confianza",[45228,107691,50341,112172],[],{"_3162":66046,"_27851":66045,"_19309":112309,"_5":13254,"_25377":66045,"_2660":112310},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3162":66047,"_27851":66045,"_5":28191,"_19309":112312,"_25377":112313,"_2660":112314},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3162":66048,"_27851":66045,"_5":28191,"_19309":112316,"_25377":112317,"_2660":112318},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3162":66049,"_27851":66045,"_5":28191,"_19309":112320,"_25377":112321,"_2660":112322},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3162":66050,"_27851":66045,"_5":28191,"_19309":112324,"_25377":112325,"_2660":112326},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3162":66051,"_27851":66045,"_5":28191,"_19309":112328,"_25377":112329,"_2660":112330},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3162":66052,"_27851":66045,"_5":28191,"_19309":112332,"_25377":112333,"_2660":112334},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3162":66053,"_27851":66045,"_5":28191,"_19309":112336,"_25377":112337,"_2660":112338},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3162":66054,"_27851":66045,"_5":28191,"_19309":112340,"_25377":112341,"_2660":112342},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3162":66055,"_27851":66045,"_5":28191,"_19309":112344,"_25377":112345,"_2660":112346},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3162":66056,"_27851":66045,"_5":28191,"_19309":112348,"_25377":112349,"_2660":112350},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3162":66057,"_27851":66045,"_19309":112352,"_5":13254,"_25377":66045,"_2660":112353},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3162":66058,"_27851":66045,"_19309":112355,"_5":13254,"_25377":112317,"_2660":112356},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3162":66059,"_27851":66045,"_19309":112358,"_5":13254,"_25377":112321,"_2660":112359},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3162":66060,"_27851":66045,"_19309":112361,"_5":13254,"_25377":112325,"_2660":112362},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3162":66061,"_27851":66045,"_19309":112364,"_5":13254,"_25377":112329,"_2660":112365},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3162":66062,"_27851":66045,"_19309":112367,"_5":13254,"_25377":112333,"_2660":112368},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3162":66063,"_27851":66045,"_19309":112370,"_5":13254,"_25377":112333,"_2660":112371},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3162":66064,"_27851":66045,"_19309":112373,"_5":13254,"_25377":112333,"_2660":112374},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3162":66065,"_27851":66045,"_19309":112376,"_5":13254,"_25377":112333,"_2660":112377},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3162":66066,"_27851":66045,"_19309":112379,"_5":13254,"_25377":112333,"_2660":112380},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3162":66067,"_27851":66045,"_19309":112382,"_5":13254,"_25377":112333,"_2660":112383},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3162":66068,"_27851":66045,"_19309":112385,"_5":13254,"_25377":112337,"_2660":112386},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3162":66069,"_27851":66045,"_19309":112388,"_5":13254,"_25377":112337,"_2660":112389},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3162":66070,"_27851":66045,"_19309":112391,"_5":13254,"_25377":112337,"_2660":112392},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3162":66071,"_27851":66045,"_19309":112394,"_5":13254,"_25377":112337,"_2660":112395},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3162":66072,"_27851":66045,"_19309":112397,"_5":13254,"_25377":112337,"_2660":112398},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3162":66073,"_27851":66045,"_19309":112400,"_5":13254,"_25377":112341,"_2660":112401},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3162":66074,"_27851":66045,"_19309":112403,"_5":13254,"_25377":112341,"_2660":112404},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3162":66075,"_27851":66045,"_19309":112406,"_5":13254,"_25377":112341,"_2660":112407},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3162":66076,"_27851":66045,"_19309":112409,"_5":13254,"_25377":112341,"_2660":112410},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3162":66077,"_27851":66045,"_19309":112412,"_5":13254,"_25377":112341,"_2660":112413},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3162":66078,"_27851":66045,"_19309":112415,"_5":13254,"_25377":112341,"_2660":112416},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3162":66079,"_27851":66045,"_19309":112418,"_5":13254,"_25377":112341,"_2660":112419},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3162":66080,"_27851":66045,"_19309":112421,"_5":13254,"_25377":112345,"_2660":112422},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3162":66081,"_27851":66045,"_19309":112424,"_5":13254,"_25377":112349,"_2660":112425},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3162":66082,"_27851":66045,"_19309":112427,"_5":13254,"_25377":112349,"_2660":112428},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3162":66083,"_27851":66045,"_19309":112430,"_5":13254,"_25377":112349,"_2660":112431},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3162":66084,"_27851":66045,"_19309":112433,"_5":13254,"_25377":112349,"_2660":112434},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3162":66085,"_27851":66045,"_19309":112436,"_5":13254,"_25377":112349,"_2660":112437},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3162":66086,"_27851":66045,"_19309":112439,"_5":13254,"_25377":112349,"_2660":112440},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3162":66087,"_27851":66045,"_19309":112442,"_5":13254,"_25377":112349,"_2660":112443},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3162":66088,"_27851":66088,"_5":13585,"_2660":112445,"_28194":112446,"_19309":112447,"_25377":66088},"Listas de revocación (CRL)",[45228,107691,50341,111933],[],{"_3162":66089,"_27851":66088,"_19309":112449,"_5":13254,"_25377":66088,"_2660":112450},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3162":66090,"_27851":66088,"_5":28191,"_19309":112452,"_25377":112453,"_2660":112454},[],"/docs/pr-preview/pr-39/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3162":66091,"_27851":66088,"_5":28191,"_19309":112456,"_25377":112457,"_2660":112458},[],"/docs/pr-preview/pr-39/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3162":66092,"_27851":66088,"_5":28191,"_19309":112460,"_25377":112461,"_2660":112462},[],"/docs/pr-preview/pr-39/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3162":66093,"_27851":66088,"_5":28191,"_19309":112464,"_25377":112465,"_2660":112466},[],"/docs/pr-preview/pr-39/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3162":66094,"_27851":66088,"_5":28191,"_19309":112468,"_25377":112469,"_2660":112470},[],"/docs/pr-preview/pr-39/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3162":66095,"_27851":66088,"_5":28191,"_19309":112472,"_25377":112473,"_2660":112474},[],"/docs/pr-preview/pr-39/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3162":66096,"_27851":66088,"_5":28191,"_19309":112476,"_25377":112477,"_2660":112478},[],"/docs/pr-preview/pr-39/es/platform/pki/crl#referencias","Referencias",{"_3162":66097,"_27851":66088,"_19309":112480,"_5":13254,"_25377":66088,"_2660":112481},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3162":66098,"_27851":66088,"_19309":112483,"_5":13254,"_25377":112453,"_2660":112484},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3162":66099,"_27851":66088,"_19309":112486,"_5":13254,"_25377":112453,"_2660":112487},[],"Campo de `crl_options`",{"_3162":66100,"_27851":66088,"_19309":112489,"_5":13254,"_25377":112453,"_2660":109226},[],{"_3162":66101,"_27851":66088,"_19309":112491,"_5":13254,"_25377":112453,"_2660":112492},[],"Valor inicial del backend",{"_3162":66102,"_27851":66088,"_19309":112494,"_5":13254,"_25377":112453,"_2660":51521},[],{"_3162":66103,"_27851":66088,"_19309":112496,"_5":13254,"_25377":112453,"_2660":112497},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3162":66104,"_27851":66088,"_19309":112499,"_5":13254,"_25377":112453,"_2660":112500},[],"7 días.",{"_3162":66105,"_27851":66088,"_19309":112502,"_5":13254,"_25377":112453,"_2660":51530},[],{"_3162":66106,"_27851":66088,"_19309":112504,"_5":13254,"_25377":112453,"_2660":112505},[],"Plazo desde la publicación que activa la renovación programada.",{"_3162":66107,"_27851":66088,"_19309":112507,"_5":13254,"_25377":112453,"_2660":112508},[],"6 días y 23 horas.",{"_3162":66108,"_27851":66088,"_19309":112510,"_5":13254,"_25377":112453,"_2660":51539},[],{"_3162":66109,"_27851":66088,"_19309":112512,"_5":13254,"_25377":112453,"_2660":112513},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3162":66110,"_27851":66088,"_19309":112515,"_5":13254,"_25377":112453,"_2660":51545},[],{"_3162":66111,"_27851":66088,"_19309":112517,"_5":13254,"_25377":112453,"_2660":51548},[],{"_3162":66112,"_27851":66088,"_19309":112519,"_5":13254,"_25377":112453,"_2660":112520},[],"Campo de configuración inicializado con el SKI de la CA.",{"_3162":66113,"_27851":66088,"_19309":112522,"_5":13254,"_25377":112453,"_2660":112523},[],"SKI de la CA.",{"_3162":66114,"_27851":66088,"_19309":112525,"_5":13254,"_25377":112453,"_2660":112526},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_3162":66115,"_27851":66088,"_19309":112528,"_5":13254,"_25377":112453,"_2660":112529},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3162":66116,"_27851":66088,"_19309":112531,"_5":13254,"_25377":112457,"_2660":112532},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_3162":66117,"_27851":66088,"_19309":112534,"_5":13254,"_25377":112457,"_2660":112535},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3162":66118,"_27851":66088,"_19309":112537,"_5":13254,"_25377":112457,"_2660":112538},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3162":66119,"_27851":66088,"_19309":112540,"_5":13254,"_25377":112461,"_2660":112541},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3162":66120,"_27851":66088,"_19309":112543,"_5":13254,"_25377":112461,"_2660":112544},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3162":66121,"_27851":66088,"_19309":112546,"_5":13254,"_25377":112465,"_2660":112547},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3162":66122,"_27851":66088,"_19309":112549,"_5":13254,"_25377":112465,"_2660":112550},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3162":66123,"_27851":66088,"_19309":112552,"_5":13254,"_25377":112465,"_2660":112553},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3162":66124,"_27851":66088,"_19309":112555,"_5":13254,"_25377":112465,"_2660":112556},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3162":66125,"_27851":66088,"_19309":112558,"_5":13254,"_25377":112465,"_2660":112559},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3162":66126,"_27851":66088,"_19309":112561,"_5":13254,"_25377":112469,"_2660":112562},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3162":66127,"_27851":66088,"_19309":112564,"_5":13254,"_25377":112469,"_2660":109415},[],{"_3162":66128,"_27851":66088,"_19309":112566,"_5":13254,"_25377":112469,"_2660":112567},[],"Path relativo",{"_3162":66129,"_27851":66088,"_19309":112569,"_5":13254,"_25377":112469,"_2660":107482},[],{"_3162":66130,"_27851":66088,"_19309":112571,"_5":13254,"_25377":112469,"_2660":51603},[],{"_3162":66131,"_27851":66088,"_19309":112573,"_5":13254,"_25377":112469,"_2660":51606},[],{"_3162":66132,"_27851":66088,"_19309":112575,"_5":13254,"_25377":112469,"_2660":112576},[],"Consultar `crl_options` y `latest_crl`.",{"_3162":66133,"_27851":66088,"_19309":112578,"_5":13254,"_25377":112469,"_2660":51612},[],{"_3162":66134,"_27851":66088,"_19309":112580,"_5":13254,"_25377":112469,"_2660":51606},[],{"_3162":66135,"_27851":66088,"_19309":112582,"_5":13254,"_25377":112469,"_2660":112583},[],"Sustituir la configuración de CRL.",{"_3162":66136,"_27851":66088,"_19309":112585,"_5":13254,"_25377":112469,"_2660":112586},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3162":66137,"_27851":66088,"_19309":112588,"_5":13254,"_25377":112469,"_2660":112589},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3162":66138,"_27851":66088,"_19309":112591,"_5":13254,"_25377":112473,"_2660":112592},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3162":66139,"_27851":66088,"_19309":112594,"_5":13254,"_25377":112477,"_2660":112595},[],"RFC 5280: perfil X.509 y CRL.",{"_3162":66140,"_27851":66088,"_19309":112597,"_5":13254,"_25377":112477,"_2660":51632},[],{"_3162":66141,"_27851":66088,"_19309":112599,"_5":13254,"_25377":112477,"_2660":51635},[],{"_3162":66142,"_27851":66088,"_19309":112601,"_5":13254,"_25377":112477,"_2660":112602},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3162":66143,"_27851":66088,"_19309":112604,"_5":13254,"_25377":112477,"_2660":112605},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3162":66144,"_27851":66144,"_5":13585,"_2660":112607,"_28194":112608,"_19309":112609,"_25377":66144},"Claves y motores criptográficos",[45228,107691,50341,111318],[],{"_3162":66145,"_27851":66144,"_19309":112611,"_5":13254,"_25377":66144,"_2660":112612},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3162":66146,"_27851":66144,"_5":28191,"_19309":112614,"_25377":112615,"_2660":112616},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3162":66147,"_27851":66144,"_5":28191,"_19309":112618,"_25377":112619,"_2660":112620},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3162":66148,"_27851":66144,"_5":28191,"_19309":112622,"_25377":112623,"_2660":51660},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#file-system",{"_3162":66149,"_27851":66144,"_5":28191,"_19309":112625,"_25377":112626,"_2660":51664},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#hashicorp-vault",{"_3162":66150,"_27851":66144,"_5":28191,"_19309":112628,"_25377":112629,"_2660":51668},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#aws-secrets-manager",{"_3162":66151,"_27851":66144,"_5":28191,"_19309":112631,"_25377":112632,"_2660":51672},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#aws-kms",{"_3162":66152,"_27851":66144,"_5":28191,"_19309":112634,"_25377":112635,"_2660":51676},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#pkcs11",{"_3162":66153,"_27851":66144,"_5":28191,"_19309":112637,"_25377":112638,"_2660":51680},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#azure-key-vault",{"_3162":66154,"_27851":66144,"_5":28191,"_19309":112640,"_25377":112641,"_2660":112642},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3162":66155,"_27851":66144,"_5":28191,"_19309":112644,"_25377":112645,"_2660":112646},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3162":66156,"_27851":66144,"_5":28191,"_19309":112648,"_25377":112649,"_2660":112650},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3162":66157,"_27851":66144,"_5":28191,"_19309":112652,"_25377":112653,"_2660":112654},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3162":66158,"_27851":66144,"_5":28191,"_19309":112656,"_25377":112657,"_2660":112658},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3162":66159,"_27851":66144,"_5":28191,"_19309":112660,"_25377":112661,"_2660":112662},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3162":66160,"_27851":66144,"_5":28191,"_19309":112664,"_25377":112665,"_2660":112666},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3162":66161,"_27851":66144,"_5":28191,"_19309":112668,"_25377":112669,"_2660":51712},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#sign",{"_3162":66162,"_27851":66144,"_5":28191,"_19309":112671,"_25377":112672,"_2660":51716},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#verify",{"_3162":66163,"_27851":66144,"_5":28191,"_19309":112674,"_25377":112675,"_2660":112676},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3162":66164,"_27851":66144,"_5":28191,"_19309":112678,"_25377":112679,"_2660":112680},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3162":66165,"_27851":66144,"_5":28191,"_19309":112682,"_25377":112683,"_2660":112684},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3162":66166,"_27851":66144,"_19309":112686,"_5":13254,"_25377":66144,"_2660":112687},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3162":66167,"_27851":66144,"_19309":112689,"_5":13254,"_25377":66144,"_2660":112690},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3162":66168,"_27851":66144,"_19309":112692,"_5":13254,"_25377":112615,"_2660":112693},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3162":66169,"_27851":66144,"_19309":112695,"_5":13254,"_25377":112615,"_2660":112696},[],"En la práctica, permite:",{"_3162":66170,"_27851":66144,"_19309":112698,"_5":13254,"_25377":112615,"_2660":112699},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3162":66171,"_27851":66144,"_19309":112701,"_5":13254,"_25377":112615,"_2660":112702},[],"Importar claves creadas externamente.",{"_3162":66172,"_27851":66144,"_19309":112704,"_5":13254,"_25377":112615,"_2660":112705},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3162":66173,"_27851":66144,"_19309":112707,"_5":13254,"_25377":112615,"_2660":112708},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3162":66174,"_27851":66144,"_19309":112710,"_5":13254,"_25377":112619,"_2660":112711},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3162":66175,"_27851":66144,"_19309":112713,"_5":13254,"_25377":112619,"_2660":112714},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3162":66176,"_27851":66144,"_19309":112716,"_5":13254,"_25377":112619,"_2660":112717},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3162":66177,"_27851":66144,"_19309":112719,"_5":13254,"_25377":112623,"_2660":112720},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3162":66178,"_27851":66144,"_19309":112722,"_5":13254,"_25377":112626,"_2660":112723},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3162":66179,"_27851":66144,"_19309":112725,"_5":13254,"_25377":112629,"_2660":112726},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3162":66180,"_27851":66144,"_19309":112728,"_5":13254,"_25377":112632,"_2660":112729},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3162":66181,"_27851":66144,"_19309":112731,"_5":13254,"_25377":112635,"_2660":112732},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3162":66182,"_27851":66144,"_19309":112734,"_5":13254,"_25377":112638,"_2660":112735},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3162":66183,"_27851":66144,"_19309":112737,"_5":13254,"_25377":112638,"_2660":112738},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3162":66184,"_27851":66144,"_19309":112740,"_5":13254,"_25377":112638,"_2660":112741},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3162":66185,"_27851":66144,"_19309":112743,"_5":13254,"_25377":112638,"_2660":112744},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3162":66186,"_27851":66144,"_19309":112746,"_5":13254,"_25377":112641,"_2660":112747},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3162":66187,"_27851":66144,"_19309":112749,"_5":13254,"_25377":112641,"_2660":112750},[],"La tabla incluye los siguientes campos:",{"_3162":66188,"_27851":66144,"_19309":112752,"_5":13254,"_25377":112641,"_2660":112753},[],"**Name**: nombre descriptivo de la clave.",{"_3162":66189,"_27851":66144,"_19309":112755,"_5":13254,"_25377":112641,"_2660":112756},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3162":66190,"_27851":66144,"_19309":112758,"_5":13254,"_25377":112641,"_2660":112759},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3162":66191,"_27851":66144,"_19309":112761,"_5":13254,"_25377":112641,"_2660":112762},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3162":66192,"_27851":66144,"_19309":112764,"_5":13254,"_25377":112641,"_2660":112765},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3162":66193,"_27851":66144,"_19309":112767,"_5":13254,"_25377":112641,"_2660":112768},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3162":66194,"_27851":66144,"_19309":112770,"_5":13254,"_25377":112641,"_2660":112771},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3162":66195,"_27851":66144,"_19309":112773,"_5":13254,"_25377":112641,"_2660":112774},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3162":66196,"_27851":66144,"_19309":112776,"_5":13254,"_25377":112641,"_2660":112777},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3162":66197,"_27851":66144,"_19309":112779,"_5":13254,"_25377":112641,"_2660":112780},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3162":66198,"_27851":66144,"_19309":112782,"_5":13254,"_25377":112641,"_2660":112783},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3162":66199,"_27851":66144,"_19309":112785,"_5":13254,"_25377":112641,"_2660":112786},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3162":66200,"_27851":66144,"_19309":112788,"_5":13254,"_25377":112641,"_2660":112789},[],"**Delete Key** para eliminar la clave del sistema.",{"_3162":66201,"_27851":66144,"_19309":112791,"_5":13254,"_25377":112645,"_2660":112792},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3162":66202,"_27851":66144,"_19309":112794,"_5":13254,"_25377":112649,"_2660":112795},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3162":66203,"_27851":66144,"_19309":112797,"_5":13254,"_25377":112649,"_2660":112798},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3162":66204,"_27851":66144,"_19309":112800,"_5":13254,"_25377":112649,"_2660":112801},[],"**Key Name**: nombre único y descriptivo.",{"_3162":66205,"_27851":66144,"_19309":112803,"_5":13254,"_25377":112649,"_2660":112804},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3162":66206,"_27851":66144,"_19309":112806,"_5":13254,"_25377":112649,"_2660":112807},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3162":66207,"_27851":66144,"_19309":112809,"_5":13254,"_25377":112649,"_2660":112810},[],"**Tags**: metadatos para clasificar la clave.",{"_3162":66208,"_27851":66144,"_19309":112812,"_5":13254,"_25377":112649,"_2660":112813},[],"**Metadata**: información adicional para usos avanzados.",{"_3162":66209,"_27851":66144,"_19309":112815,"_5":13254,"_25377":112653,"_2660":112816},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3162":66210,"_27851":66144,"_19309":112818,"_5":13254,"_25377":112653,"_2660":112819},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3162":66211,"_27851":66144,"_19309":112821,"_5":13254,"_25377":112653,"_2660":112822},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3162":66212,"_27851":66144,"_19309":112824,"_5":13254,"_25377":112653,"_2660":112825},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3162":66213,"_27851":66144,"_19309":112827,"_5":13254,"_25377":112653,"_2660":112828},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3162":66214,"_27851":66144,"_19309":112830,"_5":13254,"_25377":112653,"_2660":112831},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3162":66215,"_27851":66144,"_19309":112833,"_5":13254,"_25377":112653,"_2660":112834},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3162":66216,"_27851":66144,"_19309":112836,"_5":13254,"_25377":112653,"_2660":112837},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3162":66217,"_27851":66144,"_19309":112839,"_5":13254,"_25377":112653,"_2660":112840},[],"**Metadata**: información adicional opcional.",{"_3162":66218,"_27851":66144,"_19309":112842,"_5":13254,"_25377":112653,"_2660":112843},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3162":66219,"_27851":66144,"_19309":112845,"_5":13254,"_25377":112653,"_2660":112846},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3162":66220,"_27851":66144,"_19309":112848,"_5":13254,"_25377":112657,"_2660":112849},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3162":66221,"_27851":66144,"_19309":112851,"_5":13254,"_25377":112661,"_2660":112852},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3162":66222,"_27851":66144,"_19309":112854,"_5":13254,"_25377":112661,"_2660":112855},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3162":66223,"_27851":66144,"_19309":112857,"_5":13254,"_25377":112661,"_2660":112858},[],"**Key Name**: nombre descriptivo.",{"_3162":66224,"_27851":66144,"_19309":112860,"_5":13254,"_25377":112661,"_2660":112861},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3162":66225,"_27851":66144,"_19309":112863,"_5":13254,"_25377":112661,"_2660":112864},[],"**Tags**: etiquetas asociadas.",{"_3162":66226,"_27851":66144,"_19309":112866,"_5":13254,"_25377":112661,"_2660":112867},[],"**Aliases**: nombres alternativos.",{"_3162":66227,"_27851":66144,"_19309":112869,"_5":13254,"_25377":112661,"_2660":112870},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3162":66228,"_27851":66144,"_19309":112872,"_5":13254,"_25377":112661,"_2660":112873},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3162":66229,"_27851":66144,"_19309":112875,"_5":13254,"_25377":112661,"_2660":112876},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3162":66230,"_27851":66144,"_19309":112878,"_5":13254,"_25377":112661,"_2660":112879},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3162":66231,"_27851":66144,"_19309":112881,"_5":13254,"_25377":112665,"_2660":112882},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3162":66232,"_27851":66144,"_19309":112884,"_5":13254,"_25377":112665,"_2660":112885},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3162":66233,"_27851":66144,"_19309":112887,"_5":13254,"_25377":112665,"_2660":112888},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3162":66234,"_27851":66144,"_19309":112890,"_5":13254,"_25377":112669,"_2660":112891},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3162":66235,"_27851":66144,"_19309":112893,"_5":13254,"_25377":112669,"_2660":112894},[],"Campos principales:",{"_3162":66236,"_27851":66144,"_19309":112896,"_5":13254,"_25377":112669,"_2660":112897},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3162":66237,"_27851":66144,"_19309":112899,"_5":13254,"_25377":112669,"_2660":112900},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3162":66238,"_27851":66144,"_19309":112902,"_5":13254,"_25377":112669,"_2660":112903},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3162":66239,"_27851":66144,"_19309":112905,"_5":13254,"_25377":112669,"_2660":112906},[],"**Message**: contenido que se va a firmar.",{"_3162":66240,"_27851":66144,"_19309":112908,"_5":13254,"_25377":112669,"_2660":112909},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3162":66241,"_27851":66144,"_19309":112911,"_5":13254,"_25377":112672,"_2660":112912},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3162":66242,"_27851":66144,"_19309":112914,"_5":13254,"_25377":112672,"_2660":112894},[],{"_3162":66243,"_27851":66144,"_19309":112916,"_5":13254,"_25377":112672,"_2660":112917},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3162":66244,"_27851":66144,"_19309":112919,"_5":13254,"_25377":112672,"_2660":112920},[],"**Message Type**: `Raw` o `Digest`.",{"_3162":66245,"_27851":66144,"_19309":112922,"_5":13254,"_25377":112672,"_2660":112923},[],"**Payload Encoding**: codificación del mensaje.",{"_3162":66246,"_27851":66144,"_19309":112925,"_5":13254,"_25377":112672,"_2660":112926},[],"**Message**: mensaje original o hash.",{"_3162":66247,"_27851":66144,"_19309":112928,"_5":13254,"_25377":112672,"_2660":112929},[],"**Signature**: firma que se desea comprobar.",{"_3162":66248,"_27851":66144,"_19309":112931,"_5":13254,"_25377":112672,"_2660":112932},[],"**Result**: indicador del resultado de la validación.",{"_3162":66249,"_27851":66144,"_19309":112934,"_5":13254,"_25377":112675,"_2660":112935},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3162":66250,"_27851":66144,"_19309":112937,"_5":13254,"_25377":112675,"_2660":112938},[],"Este flujo es útil para:",{"_3162":66251,"_27851":66144,"_19309":112940,"_5":13254,"_25377":112675,"_2660":112941},[],"Solicitar certificados a una CA externa.",{"_3162":66252,"_27851":66144,"_19309":112943,"_5":13254,"_25377":112675,"_2660":112944},[],"Renovar una identidad manteniendo la misma clave.",{"_3162":66253,"_27851":66144,"_19309":112946,"_5":13254,"_25377":112675,"_2660":112947},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3162":66254,"_27851":66144,"_19309":112949,"_5":13254,"_25377":112675,"_2660":112950},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3162":66255,"_27851":66144,"_19309":112952,"_5":13254,"_25377":112675,"_2660":112953},[],"**Organization (O)**: organización o empresa.",{"_3162":66256,"_27851":66144,"_19309":112955,"_5":13254,"_25377":112675,"_2660":112956},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3162":66257,"_27851":66144,"_19309":112958,"_5":13254,"_25377":112675,"_2660":112959},[],"**Country (C)**: código de país de dos letras.",{"_3162":66258,"_27851":66144,"_19309":112961,"_5":13254,"_25377":112675,"_2660":112962},[],"**State / Province (ST)**: estado o provincia.",{"_3162":66259,"_27851":66144,"_19309":112964,"_5":13254,"_25377":112675,"_2660":112965},[],"**Locality (L)**: ciudad o localidad.",{"_3162":66260,"_27851":66144,"_19309":112967,"_5":13254,"_25377":112675,"_2660":112968},[],"**Email Address**: correo de contacto.",{"_3162":66261,"_27851":66144,"_19309":112970,"_5":13254,"_25377":112675,"_2660":112971},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3162":66262,"_27851":66144,"_19309":112973,"_5":13254,"_25377":112675,"_2660":112974},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3162":66263,"_27851":66144,"_19309":112976,"_5":13254,"_25377":112679,"_2660":112977},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3162":66264,"_27851":66144,"_19309":112979,"_5":13254,"_25377":112679,"_2660":52024},[],{"_3162":66265,"_27851":66144,"_19309":112981,"_5":13254,"_25377":112683,"_2660":112982},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3162":66266,"_27851":66266,"_5":13585,"_2660":112984,"_28194":112985,"_19309":112986,"_25377":66266},"Validación online con OCSP",[45228,107691,50341,111933],[],{"_3162":66267,"_27851":66266,"_19309":112988,"_5":13254,"_25377":66266,"_2660":112989},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3162":66268,"_27851":66266,"_5":28191,"_19309":112991,"_25377":112992,"_2660":112993},[],"/docs/pr-preview/pr-39/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3162":66269,"_27851":66266,"_5":28191,"_19309":112995,"_25377":112996,"_2660":112997},[],"/docs/pr-preview/pr-39/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3162":66270,"_27851":66266,"_5":28191,"_19309":112999,"_25377":113000,"_2660":113001},[],"/docs/pr-preview/pr-39/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3162":66271,"_27851":66266,"_5":28191,"_19309":113003,"_25377":113004,"_2660":113005},[],"/docs/pr-preview/pr-39/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3162":66272,"_27851":66266,"_5":28191,"_19309":113007,"_25377":113008,"_2660":113009},[],"/docs/pr-preview/pr-39/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3162":66273,"_27851":66266,"_5":28191,"_19309":113011,"_25377":113012,"_2660":112478},[],"/docs/pr-preview/pr-39/es/platform/pki/ocsp#referencias",{"_3162":66274,"_27851":66266,"_19309":113014,"_5":13254,"_25377":66266,"_2660":113015},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3162":66275,"_27851":66266,"_19309":113017,"_5":13254,"_25377":112992,"_2660":113018},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3162":66276,"_27851":66266,"_19309":113020,"_5":13254,"_25377":112992,"_2660":113021},[],"Estado del registro",{"_3162":66277,"_27851":66266,"_19309":113023,"_5":13254,"_25377":112992,"_2660":113024},[],"Respuesta firmada",{"_3162":66278,"_27851":66266,"_19309":113026,"_5":13254,"_25377":112992,"_2660":49519},[],{"_3162":66279,"_27851":66266,"_19309":113028,"_5":13254,"_25377":112992,"_2660":52074},[],{"_3162":66280,"_27851":66266,"_19309":113030,"_5":13254,"_25377":112992,"_2660":49536},[],{"_3162":66281,"_27851":66266,"_19309":113032,"_5":13254,"_25377":112992,"_2660":113033},[],"`Revoked`, con razón y fecha de revocación.",{"_3162":66282,"_27851":66266,"_19309":113035,"_5":13254,"_25377":112992,"_2660":113036},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3162":66283,"_27851":66266,"_19309":113038,"_5":13254,"_25377":112992,"_2660":113039},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3162":66284,"_27851":66266,"_19309":113041,"_5":13254,"_25377":112992,"_2660":113042},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3162":66285,"_27851":66266,"_19309":113044,"_5":13254,"_25377":112992,"_2660":113045},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3162":66286,"_27851":66266,"_19309":113047,"_5":13254,"_25377":112992,"_2660":113048},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3162":66287,"_27851":66266,"_19309":113050,"_5":13254,"_25377":112996,"_2660":113051},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3162":66288,"_27851":66266,"_19309":113053,"_5":13254,"_25377":112996,"_2660":113054},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3162":66289,"_27851":66266,"_19309":113056,"_5":13254,"_25377":113000,"_2660":113057},[],"El servicio acepta:",{"_3162":66290,"_27851":66266,"_19309":113059,"_5":13254,"_25377":113000,"_2660":109415},[],{"_3162":66291,"_27851":66266,"_19309":113061,"_5":13254,"_25377":113000,"_2660":113062},[],"Ruta del servicio VA",{"_3162":66292,"_27851":66266,"_19309":113064,"_5":13254,"_25377":113000,"_2660":113065},[],"Formato",{"_3162":66293,"_27851":66266,"_19309":113067,"_5":13254,"_25377":113000,"_2660":52114},[],{"_3162":66294,"_27851":66266,"_19309":113069,"_5":13254,"_25377":113000,"_2660":52117},[],{"_3162":66295,"_27851":66266,"_19309":113071,"_5":13254,"_25377":113000,"_2660":113072},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3162":66296,"_27851":66266,"_19309":113074,"_5":13254,"_25377":113000,"_2660":51603},[],{"_3162":66297,"_27851":66266,"_19309":113076,"_5":13254,"_25377":113000,"_2660":52125},[],{"_3162":66298,"_27851":66266,"_19309":113078,"_5":13254,"_25377":113000,"_2660":113079},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3162":66299,"_27851":66266,"_19309":113081,"_5":13254,"_25377":113000,"_2660":113082},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3162":66300,"_27851":66266,"_19309":113084,"_5":13254,"_25377":113004,"_2660":113085},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3162":66301,"_27851":66266,"_19309":113087,"_5":13254,"_25377":113004,"_2660":113088},[],"Genera la solicitud:",{"_3162":66302,"_27851":66266,"_19309":113090,"_5":13254,"_25377":113004,"_2660":113091},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3162":66303,"_27851":66266,"_19309":113093,"_5":13254,"_25377":113004,"_2660":113094},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3162":66304,"_27851":66266,"_19309":113096,"_5":13254,"_25377":113004,"_2660":113097},[],"Verifica el DER recibido:",{"_3162":66305,"_27851":66266,"_19309":113099,"_5":13254,"_25377":113004,"_2660":113100},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3162":66306,"_27851":66266,"_19309":113102,"_5":13254,"_25377":113008,"_2660":113103},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3162":66307,"_27851":66266,"_19309":113105,"_5":13254,"_25377":113008,"_2660":113106},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3162":66308,"_27851":66266,"_19309":113108,"_5":13254,"_25377":113012,"_2660":52158},[],{"_3162":66309,"_27851":66266,"_19309":113110,"_5":13254,"_25377":113012,"_2660":52161},[],{"_3162":66310,"_27851":66266,"_19309":113112,"_5":13254,"_25377":113012,"_2660":113113},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3162":66311,"_27851":66266,"_19309":113115,"_5":13254,"_25377":113012,"_2660":112605},[],{"_3162":66312,"_27851":66312,"_5":13585,"_2660":50341,"_28194":113117,"_19309":113118,"_25377":66312},[45228,107691,50341],[],{"_3162":66313,"_27851":66312,"_19309":113120,"_5":13254,"_25377":66312,"_2660":113121},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3162":66314,"_27851":66312,"_5":28191,"_19309":113123,"_25377":113124,"_2660":110642},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#empieza-aquí",{"_3162":66315,"_27851":66312,"_5":28191,"_19309":113126,"_25377":113127,"_2660":113128},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3162":66316,"_27851":66312,"_5":28191,"_19309":113130,"_25377":113131,"_2660":111164},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#capacidades-principales",{"_3162":66317,"_27851":66312,"_5":28191,"_19309":113133,"_25377":113134,"_2660":111168},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3162":66318,"_27851":66312,"_5":28191,"_19309":113136,"_25377":113137,"_2660":111172},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3162":66319,"_27851":66312,"_5":28191,"_19309":113139,"_25377":113140,"_2660":111176},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#emite-y-controla-certificados",{"_3162":66320,"_27851":66312,"_5":28191,"_19309":113142,"_25377":113143,"_2660":111184},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#publica-el-estado-de-validación",{"_3162":66321,"_27851":66312,"_5":28191,"_19309":113145,"_25377":113146,"_2660":113147},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3162":66322,"_27851":66312,"_5":28191,"_19309":113149,"_25377":113150,"_2660":112099},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#continúa",{"_3162":66323,"_27851":66312,"_19309":113152,"_5":13254,"_25377":66312,"_2660":113153},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3162":66324,"_27851":66312,"_19309":113155,"_5":13254,"_25377":113124,"_2660":113156},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3162":66325,"_27851":66312,"_19309":113158,"_5":13254,"_25377":113124,"_2660":113159},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3162":66326,"_27851":66312,"_19309":113161,"_5":13254,"_25377":113127,"_2660":113162},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3162":66327,"_27851":66312,"_19309":113164,"_5":13254,"_25377":113127,"_2660":113165},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3162":66328,"_27851":66312,"_19309":113167,"_5":13254,"_25377":113127,"_2660":113168},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3162":66329,"_27851":66312,"_19309":113170,"_5":13254,"_25377":113127,"_2660":113171},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3162":66330,"_27851":66312,"_19309":113173,"_5":13254,"_25377":113127,"_2660":113174},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3162":66331,"_27851":66312,"_19309":113176,"_5":13254,"_25377":113134,"_2660":113177},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3162":66332,"_27851":66312,"_19309":113179,"_5":13254,"_25377":113137,"_2660":113180},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3162":66333,"_27851":66312,"_19309":113182,"_5":13254,"_25377":113140,"_2660":113183},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3162":66334,"_27851":66312,"_19309":113185,"_5":13254,"_25377":113143,"_2660":113186},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3162":66335,"_27851":66312,"_19309":113188,"_5":13254,"_25377":113146,"_2660":113189},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3162":66336,"_27851":66312,"_19309":113191,"_5":13254,"_25377":113146,"_2660":113192},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3162":66337,"_27851":66312,"_19309":113194,"_5":13254,"_25377":113146,"_2660":113195},[],"su clave pública corresponda a la clave privada del cliente;",{"_3162":66338,"_27851":66312,"_19309":113197,"_5":13254,"_25377":113146,"_2660":113198},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3162":66339,"_27851":66312,"_19309":113200,"_5":13254,"_25377":113146,"_2660":113201},[],"sus fechas y usos permitan la operación;",{"_3162":66340,"_27851":66312,"_19309":113203,"_5":13254,"_25377":113146,"_2660":113204},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3162":66341,"_27851":66312,"_19309":113206,"_5":13254,"_25377":113146,"_2660":113207},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3162":66342,"_27851":66312,"_19309":113209,"_5":13254,"_25377":113150,"_2660":113210},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3162":66343,"_27851":66312,"_19309":113212,"_5":13254,"_25377":113150,"_2660":113213},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3162":66344,"_27851":66312,"_19309":113215,"_5":13254,"_25377":113150,"_2660":113216},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3162":66345,"_27851":66345,"_5":13585,"_2660":113218,"_28194":113219,"_19309":113220,"_25377":66345},"Crea tu primera CA",[45228,107691,50341,110766],[],{"_3162":66346,"_27851":66345,"_19309":113222,"_5":13254,"_25377":66345,"_2660":113223},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3162":66347,"_27851":66345,"_5":28191,"_19309":113225,"_25377":113226,"_2660":106357},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3162":66348,"_27851":66345,"_5":28191,"_19309":113228,"_25377":113229,"_2660":113230},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3162":66349,"_27851":66345,"_5":28191,"_19309":113232,"_25377":113233,"_2660":113234},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3162":66350,"_27851":66345,"_5":28191,"_19309":113236,"_25377":113237,"_2660":113238},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3162":66351,"_27851":66345,"_5":28191,"_19309":113240,"_25377":113241,"_2660":113242},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3162":66352,"_27851":66345,"_5":28191,"_19309":113244,"_25377":113245,"_2660":113246},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3162":66353,"_27851":66345,"_5":28191,"_19309":113248,"_25377":113249,"_2660":113250},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3162":66354,"_27851":66345,"_5":28191,"_19309":113252,"_25377":113253,"_2660":111014},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3162":66355,"_27851":66345,"_5":28191,"_19309":113255,"_25377":113256,"_2660":106381},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3162":66356,"_27851":66345,"_19309":113258,"_5":13254,"_25377":66345,"_2660":113259},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3162":66357,"_27851":66345,"_19309":113261,"_5":13254,"_25377":113226,"_2660":113262},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3162":66358,"_27851":66345,"_19309":113264,"_5":13254,"_25377":113226,"_2660":113265},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3162":66359,"_27851":66345,"_19309":113267,"_5":13254,"_25377":113226,"_2660":113268},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3162":66360,"_27851":66345,"_19309":113270,"_5":13254,"_25377":113226,"_2660":113271},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3162":66361,"_27851":66345,"_19309":113273,"_5":13254,"_25377":113229,"_2660":113274},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3162":66362,"_27851":66345,"_19309":113276,"_5":13254,"_25377":113229,"_2660":113277},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3162":66363,"_27851":66345,"_19309":113279,"_5":13254,"_25377":113233,"_2660":113280},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3162":66364,"_27851":66345,"_19309":113282,"_5":13254,"_25377":113233,"_2660":113283},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3162":66365,"_27851":66345,"_19309":113285,"_5":13254,"_25377":113237,"_2660":113286},[],"Selecciona **Root CA** y completa:",{"_3162":66366,"_27851":66345,"_19309":113288,"_5":13254,"_25377":113237,"_2660":52340},[],{"_3162":66367,"_27851":66345,"_19309":113290,"_5":13254,"_25377":113237,"_2660":113291},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3162":66368,"_27851":66345,"_19309":113293,"_5":13254,"_25377":113237,"_2660":113294},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3162":66369,"_27851":66345,"_19309":113296,"_5":13254,"_25377":113237,"_2660":113297},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3162":66370,"_27851":66345,"_19309":113299,"_5":13254,"_25377":113237,"_2660":113300},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3162":66371,"_27851":66345,"_19309":113302,"_5":13254,"_25377":113241,"_2660":113303},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3162":66372,"_27851":66345,"_19309":113305,"_5":13254,"_25377":113245,"_2660":113306},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3162":66373,"_27851":66345,"_19309":113308,"_5":13254,"_25377":113245,"_2660":113309},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3162":66374,"_27851":66345,"_19309":113311,"_5":13254,"_25377":113249,"_2660":113312},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3162":66375,"_27851":66345,"_19309":113314,"_5":13254,"_25377":113249,"_2660":113315},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3162":66376,"_27851":66345,"_19309":113317,"_5":13254,"_25377":113249,"_2660":113318},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3162":66377,"_27851":66345,"_19309":113320,"_5":13254,"_25377":113253,"_2660":113321},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3162":66378,"_27851":66345,"_19309":113323,"_5":13254,"_25377":113253,"_2660":113324},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3162":66379,"_27851":66345,"_19309":113326,"_5":13254,"_25377":113253,"_2660":113327},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3162":66380,"_27851":66345,"_19309":113329,"_5":13254,"_25377":113253,"_2660":113330},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3162":66381,"_27851":66345,"_19309":113332,"_5":13254,"_25377":113256,"_2660":113333},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3162":66382,"_27851":66382,"_5":13585,"_2660":113335,"_28194":113336,"_19309":113337,"_25377":66382},"Emite y verifica un certificado",[45228,107691,50341,110766],[],{"_3162":66383,"_27851":66382,"_19309":113339,"_5":13254,"_25377":66382,"_2660":113340},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3162":66384,"_27851":66382,"_5":28191,"_19309":113342,"_25377":113343,"_2660":106357},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3162":66385,"_27851":66382,"_5":28191,"_19309":113345,"_25377":113346,"_2660":113347},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3162":66386,"_27851":66382,"_5":28191,"_19309":113349,"_25377":113350,"_2660":113351},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3162":66387,"_27851":66382,"_5":28191,"_19309":113353,"_25377":113354,"_2660":113355},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3162":66388,"_27851":66382,"_5":28191,"_19309":113357,"_25377":113358,"_2660":113359},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3162":66389,"_27851":66382,"_5":28191,"_19309":113361,"_25377":113362,"_2660":113363},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3162":66390,"_27851":66382,"_5":28191,"_19309":113365,"_25377":113366,"_2660":113246},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3162":66391,"_27851":66382,"_5":28191,"_19309":113368,"_25377":113369,"_2660":113370},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3162":66392,"_27851":66382,"_5":28191,"_19309":113372,"_25377":113373,"_2660":113374},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3162":66393,"_27851":66382,"_5":28191,"_19309":113376,"_25377":113377,"_2660":113378},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3162":66394,"_27851":66382,"_5":28191,"_19309":113380,"_25377":113381,"_2660":111014},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3162":66395,"_27851":66382,"_5":28191,"_19309":113383,"_25377":113384,"_2660":106381},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3162":66396,"_27851":66382,"_19309":113386,"_5":13254,"_25377":66382,"_2660":113387},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3162":66397,"_27851":66382,"_19309":113389,"_5":13254,"_25377":113343,"_2660":113390},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3162":66398,"_27851":66382,"_19309":113392,"_5":13254,"_25377":113343,"_2660":113393},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3162":66399,"_27851":66382,"_19309":113395,"_5":13254,"_25377":113343,"_2660":113396},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3162":66400,"_27851":66382,"_19309":113398,"_5":13254,"_25377":113343,"_2660":113399},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3162":66401,"_27851":66382,"_19309":113401,"_5":13254,"_25377":113343,"_2660":113402},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3162":66402,"_27851":66382,"_19309":113404,"_5":13254,"_25377":113346,"_2660":113405},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3162":66403,"_27851":66382,"_19309":113407,"_5":13254,"_25377":113350,"_2660":113408},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3162":66404,"_27851":66382,"_19309":113410,"_5":13254,"_25377":113350,"_2660":113411},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3162":66405,"_27851":66382,"_19309":113413,"_5":13254,"_25377":113354,"_2660":113414},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3162":66406,"_27851":66382,"_19309":113416,"_5":13254,"_25377":113354,"_2660":113417},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3162":66407,"_27851":66382,"_19309":113419,"_5":13254,"_25377":113358,"_2660":113420},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3162":66408,"_27851":66382,"_19309":113422,"_5":13254,"_25377":113358,"_2660":113423},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3162":66409,"_27851":66382,"_19309":113425,"_5":13254,"_25377":113362,"_2660":113426},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3162":66410,"_27851":66382,"_19309":113428,"_5":13254,"_25377":113366,"_2660":113429},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3162":66411,"_27851":66382,"_19309":113431,"_5":13254,"_25377":113369,"_2660":113432},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3162":66412,"_27851":66382,"_19309":113434,"_5":13254,"_25377":113373,"_2660":113435},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3162":66413,"_27851":66382,"_19309":113437,"_5":13254,"_25377":113373,"_2660":113438},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3162":66414,"_27851":66382,"_19309":113440,"_5":13254,"_25377":113373,"_2660":113441},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3162":66415,"_27851":66382,"_19309":113443,"_5":13254,"_25377":113377,"_2660":113444},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3162":66416,"_27851":66382,"_19309":113446,"_5":13254,"_25377":113377,"_2660":113447},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3162":66417,"_27851":66382,"_19309":113449,"_5":13254,"_25377":113377,"_2660":113450},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3162":66418,"_27851":66382,"_19309":113452,"_5":13254,"_25377":113381,"_2660":111097},[],{"_3162":66419,"_27851":66382,"_19309":113454,"_5":13254,"_25377":113381,"_2660":109864},[],{"_3162":66420,"_27851":66382,"_19309":113456,"_5":13254,"_25377":113381,"_2660":113457},[],"La CA rechaza la emisión",{"_3162":66421,"_27851":66382,"_19309":113459,"_5":13254,"_25377":113381,"_2660":113460},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3162":66422,"_27851":66382,"_19309":113462,"_5":13254,"_25377":113381,"_2660":113463},[],"Sujeto o usos diferentes",{"_3162":66423,"_27851":66382,"_19309":113465,"_5":13254,"_25377":113381,"_2660":113466},[],"Perfil aplicado y valores solicitados.",{"_3162":66424,"_27851":66382,"_19309":113468,"_5":13254,"_25377":113381,"_2660":113469},[],"No se encuentra el emisor",{"_3162":66425,"_27851":66382,"_19309":113471,"_5":13254,"_25377":113381,"_2660":113472},[],"CA descargada y cadena intermedia necesaria.",{"_3162":66426,"_27851":66382,"_19309":113474,"_5":13254,"_25377":113381,"_2660":113475},[],"Falla la vigencia",{"_3162":66427,"_27851":66382,"_19309":113477,"_5":13254,"_25377":113381,"_2660":113478},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3162":66428,"_27851":66382,"_19309":113480,"_5":13254,"_25377":113381,"_2660":113481},[],"Los resúmenes de clave difieren",{"_3162":66429,"_27851":66382,"_19309":113483,"_5":13254,"_25377":113381,"_2660":113484},[],"Archivos de certificado y clave de la misma emisión.",{"_3162":66430,"_27851":66382,"_19309":113486,"_5":13254,"_25377":113381,"_2660":113487},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3162":66431,"_27851":66382,"_19309":113489,"_5":13254,"_25377":113384,"_2660":113490},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3162":66432,"_27851":66382,"_19309":113492,"_5":13254,"_25377":113384,"_2660":113493},[],"Gestionar certificados para inspección, estado y revocación.",{"_3162":66433,"_27851":66382,"_19309":113495,"_5":13254,"_25377":113384,"_2660":113496},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3162":66434,"_27851":66382,"_19309":113498,"_5":13254,"_25377":113384,"_2660":113499},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3162":66435,"_27851":66382,"_19309":113501,"_5":13254,"_25377":113384,"_2660":113502},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3162":66436,"_27851":66436,"_5":13585,"_2660":113504,"_28194":113505,"_19309":113506,"_25377":66436},"Primeros pasos de PKI",[45228,107691,50341,110766],[],{"_3162":66437,"_27851":66436,"_19309":113508,"_5":13254,"_25377":66436,"_2660":113509},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3162":66438,"_27851":66436,"_5":28191,"_19309":113511,"_25377":113512,"_2660":106357},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3162":66439,"_27851":66436,"_5":28191,"_19309":113514,"_25377":113515,"_2660":113516},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3162":66440,"_27851":66436,"_5":28191,"_19309":113518,"_25377":113519,"_2660":110948},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3162":66441,"_27851":66436,"_5":28191,"_19309":113521,"_25377":113522,"_2660":113523},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3162":66442,"_27851":66436,"_19309":113525,"_5":13254,"_25377":66436,"_2660":113526},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3162":66443,"_27851":66436,"_19309":113528,"_5":13254,"_25377":113512,"_2660":113529},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3162":66444,"_27851":66436,"_19309":113531,"_5":13254,"_25377":113512,"_2660":113532},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3162":66445,"_27851":66436,"_19309":113534,"_5":13254,"_25377":113512,"_2660":113535},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3162":66446,"_27851":66436,"_19309":113537,"_5":13254,"_25377":113512,"_2660":113538},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3162":66447,"_27851":66436,"_19309":113540,"_5":13254,"_25377":113512,"_2660":113541},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3162":66448,"_27851":66436,"_19309":113543,"_5":13254,"_25377":113515,"_2660":113544},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3162":66449,"_27851":66436,"_19309":113546,"_5":13254,"_25377":113515,"_2660":113547},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3162":66450,"_27851":66436,"_19309":113549,"_5":13254,"_25377":113515,"_2660":113550},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3162":66451,"_27851":66436,"_19309":113552,"_5":13254,"_25377":113515,"_2660":113553},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3162":66452,"_27851":66436,"_19309":113555,"_5":13254,"_25377":113519,"_2660":113556},[],"Archivo o recurso",{"_3162":66453,"_27851":66436,"_19309":113558,"_5":13254,"_25377":113519,"_2660":110945},[],{"_3162":66454,"_27851":66436,"_19309":113560,"_5":13254,"_25377":113519,"_2660":113561},[],"CA raíz activa y `ca.pem`",{"_3162":66455,"_27851":66436,"_19309":113563,"_5":13254,"_25377":113519,"_2660":113564},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3162":66456,"_27851":66436,"_19309":113566,"_5":13254,"_25377":113519,"_2660":113567},[],"Certificado final y `device.crt`",{"_3162":66457,"_27851":66436,"_19309":113569,"_5":13254,"_25377":113519,"_2660":113570},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3162":66458,"_27851":66436,"_19309":113572,"_5":13254,"_25377":113519,"_2660":113573},[],"Clave privada `device.key`",{"_3162":66459,"_27851":66436,"_19309":113575,"_5":13254,"_25377":113519,"_2660":113576},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3162":66460,"_27851":66436,"_19309":113578,"_5":13254,"_25377":113519,"_2660":113579},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3162":66461,"_27851":66436,"_19309":113581,"_5":13254,"_25377":113522,"_2660":113582},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3162":66462,"_27851":66436,"_19309":113584,"_5":13254,"_25377":113522,"_2660":113585},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3162":66463,"_27851":66436,"_19309":113587,"_5":13254,"_25377":113522,"_2660":113588},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3162":66464,"_27851":66464,"_5":13585,"_2660":113590,"_28194":113591,"_19309":113593,"_25377":66464},"Resolución de problemas PKI",[45228,107691,50341,113592],"Resolución de problemas",[],{"_3162":66465,"_27851":66464,"_19309":113595,"_5":13254,"_25377":66464,"_2660":113596},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3162":66466,"_27851":66464,"_5":28191,"_19309":113598,"_25377":113599,"_2660":113600},[],"/docs/pr-preview/pr-39/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3162":66467,"_27851":66464,"_5":28191,"_19309":113602,"_25377":113603,"_2660":113604},[],"/docs/pr-preview/pr-39/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3162":66468,"_27851":66464,"_5":28191,"_19309":113606,"_25377":113607,"_2660":113608},[],"/docs/pr-preview/pr-39/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3162":66469,"_27851":66464,"_19309":113610,"_5":13254,"_25377":66464,"_2660":113611},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3162":66470,"_27851":66464,"_19309":113613,"_5":13254,"_25377":66464,"_2660":113614},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3162":66471,"_27851":66464,"_19309":113616,"_5":13254,"_25377":113599,"_2660":110945},[],{"_3162":66472,"_27851":66464,"_19309":113618,"_5":13254,"_25377":113599,"_2660":109864},[],{"_3162":66473,"_27851":66464,"_19309":113620,"_5":13254,"_25377":113599,"_2660":106381},[],{"_3162":66474,"_27851":66464,"_19309":113622,"_5":13254,"_25377":113599,"_2660":52676},[],{"_3162":66475,"_27851":66464,"_19309":113624,"_5":13254,"_25377":113599,"_2660":113625},[],"Existe, está activa y sus fechas son utilizables.",{"_3162":66476,"_27851":66464,"_19309":113627,"_5":13254,"_25377":113599,"_2660":113628},[],"Autoridades.",{"_3162":66477,"_27851":66464,"_19309":113630,"_5":13254,"_25377":113599,"_2660":113631},[],"Clave",{"_3162":66478,"_27851":66464,"_19309":113633,"_5":13254,"_25377":113599,"_2660":113634},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3162":66479,"_27851":66464,"_19309":113636,"_5":13254,"_25377":113599,"_2660":113637},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3162":66480,"_27851":66464,"_19309":113639,"_5":13254,"_25377":113599,"_2660":52694},[],{"_3162":66481,"_27851":66464,"_19309":113641,"_5":13254,"_25377":113599,"_2660":113642},[],"PEM correcto y firma verificable.",{"_3162":66482,"_27851":66464,"_19309":113644,"_5":13254,"_25377":113599,"_2660":52700},[],{"_3162":66483,"_27851":66464,"_19309":113646,"_5":13254,"_25377":113599,"_2660":113647},[],"Perfil",{"_3162":66484,"_27851":66464,"_19309":113649,"_5":13254,"_25377":113599,"_2660":113650},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3162":66485,"_27851":66464,"_19309":113652,"_5":13254,"_25377":113599,"_2660":113653},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3162":66486,"_27851":66464,"_19309":113655,"_5":13254,"_25377":113599,"_2660":111097},[],{"_3162":66487,"_27851":66464,"_19309":113657,"_5":13254,"_25377":113599,"_2660":113658},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3162":66488,"_27851":66464,"_19309":113660,"_5":13254,"_25377":113599,"_2660":113661},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3162":66489,"_27851":66464,"_19309":113663,"_5":13254,"_25377":113599,"_2660":113664},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3162":66490,"_27851":66464,"_19309":113666,"_5":13254,"_25377":113599,"_2660":113667},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3162":66491,"_27851":66464,"_19309":113669,"_5":13254,"_25377":113603,"_2660":113670},[],"Revisa cada frontera por separado:",{"_3162":66492,"_27851":66464,"_19309":113672,"_5":13254,"_25377":113603,"_2660":113673},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3162":66493,"_27851":66464,"_19309":113675,"_5":13254,"_25377":113603,"_2660":113676},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3162":66494,"_27851":66464,"_19309":113678,"_5":13254,"_25377":113603,"_2660":113679},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3162":66495,"_27851":66464,"_19309":113681,"_5":13254,"_25377":113603,"_2660":113682},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3162":66496,"_27851":66464,"_19309":113684,"_5":13254,"_25377":113603,"_2660":113685},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3162":66497,"_27851":66464,"_19309":113687,"_5":13254,"_25377":113603,"_2660":113688},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3162":66498,"_27851":66464,"_19309":113690,"_5":13254,"_25377":113607,"_2660":113691},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3162":66499,"_27851":66464,"_19309":113693,"_5":13254,"_25377":113607,"_2660":113694},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3162":66500,"_27851":66500,"_5":13585,"_2660":113696,"_28194":113697,"_19309":113699,"_25377":66500},"3.8.0 a 4.0.0",[45228,113698],"Actualizaciones",[],{"_3162":66501,"_27851":66500,"_19309":113701,"_5":13254,"_25377":66500,"_2660":113702},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3162":66502,"_27851":66500,"_5":28191,"_19309":113704,"_25377":113705,"_2660":113706},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3162":66503,"_27851":66500,"_5":28191,"_19309":113708,"_25377":113709,"_2660":113710},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3162":66504,"_27851":66500,"_5":28191,"_19309":113712,"_25377":113713,"_2660":113714},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3162":66505,"_27851":66500,"_5":28191,"_19309":113716,"_25377":113717,"_2660":113718},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3162":66506,"_27851":66500,"_5":28191,"_19309":113720,"_25377":113721,"_2660":113722},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3162":66507,"_27851":66500,"_5":28191,"_19309":113724,"_25377":113725,"_2660":113726},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3162":66508,"_27851":66500,"_5":28191,"_19309":113728,"_25377":113729,"_2660":52786},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3162":66509,"_27851":66500,"_5":28191,"_19309":113731,"_25377":113732,"_2660":113733},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3162":66510,"_27851":66500,"_5":28191,"_19309":113735,"_25377":113736,"_2660":113737},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3162":66511,"_27851":66500,"_5":28191,"_19309":113739,"_25377":113740,"_2660":113741},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3162":66512,"_27851":66500,"_5":28191,"_19309":113743,"_25377":113744,"_2660":113745},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3162":66513,"_27851":66500,"_5":28191,"_19309":113747,"_25377":113748,"_2660":113749},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3162":66514,"_27851":66500,"_5":28191,"_19309":113751,"_25377":113752,"_2660":113753},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3162":66515,"_27851":66500,"_5":28191,"_19309":113755,"_25377":113756,"_2660":113757},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3162":66516,"_27851":66500,"_5":28191,"_19309":113759,"_25377":113760,"_2660":113761},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3162":66517,"_27851":66500,"_5":28191,"_19309":113763,"_25377":113764,"_2660":113765},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3162":66518,"_27851":66500,"_5":28191,"_19309":113767,"_25377":113768,"_2660":113769},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3162":66519,"_27851":66500,"_5":28191,"_19309":113771,"_25377":113772,"_2660":113773},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3162":66520,"_27851":66500,"_5":28191,"_19309":113775,"_25377":113776,"_2660":113777},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3162":66521,"_27851":66500,"_5":28191,"_19309":113779,"_25377":113780,"_2660":113781},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3162":66522,"_27851":66500,"_5":28191,"_19309":113783,"_25377":113784,"_2660":113785},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3162":66523,"_27851":66500,"_5":28191,"_19309":113787,"_25377":113788,"_2660":113789},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3162":66524,"_27851":66500,"_5":28191,"_19309":113791,"_25377":113792,"_2660":113793},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3162":66525,"_27851":66500,"_5":28191,"_19309":113795,"_25377":113796,"_2660":113797},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3162":66526,"_27851":66500,"_5":28191,"_19309":113799,"_25377":113800,"_2660":113801},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3162":66527,"_27851":66500,"_5":28191,"_19309":113803,"_25377":113804,"_2660":113805},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3162":66528,"_27851":66500,"_5":28191,"_19309":113807,"_25377":113808,"_2660":113809},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3162":66529,"_27851":66500,"_5":28191,"_19309":113811,"_25377":113812,"_2660":113813},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3162":66530,"_27851":66500,"_5":28191,"_19309":113815,"_25377":113816,"_2660":113817},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3162":66531,"_27851":66500,"_5":28191,"_19309":113819,"_25377":113820,"_2660":113821},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3162":66532,"_27851":66500,"_5":28191,"_19309":113823,"_25377":113824,"_2660":113825},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3162":66533,"_27851":66500,"_5":28191,"_19309":113827,"_25377":113828,"_2660":113829},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3162":66534,"_27851":66500,"_5":28191,"_19309":113831,"_25377":113832,"_2660":113833},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3162":66535,"_27851":66500,"_5":28191,"_19309":113835,"_25377":113836,"_2660":110186},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3162":66536,"_27851":66500,"_5":28191,"_19309":113838,"_25377":113839,"_2660":113840},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3162":66537,"_27851":66500,"_5":28191,"_19309":113842,"_25377":113843,"_2660":113844},[],"/docs/pr-preview/pr-39/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3162":66538,"_27851":66500,"_19309":113846,"_5":13254,"_25377":66500,"_2660":113847},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3162":66539,"_27851":66500,"_19309":113849,"_5":13254,"_25377":66500,"_2660":113850},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3162":66540,"_27851":66500,"_19309":113852,"_5":13254,"_25377":66500,"_2660":113853},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3162":66541,"_27851":66500,"_19309":113855,"_5":13254,"_25377":66500,"_2660":113856},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3162":66542,"_27851":66500,"_19309":113858,"_5":13254,"_25377":66500,"_2660":113859},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3162":66543,"_27851":66500,"_19309":113861,"_5":13254,"_25377":66500,"_2660":113862},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3162":66544,"_27851":66500,"_19309":113864,"_5":13254,"_25377":66500,"_2660":113865},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3162":66545,"_27851":66500,"_19309":113867,"_5":13254,"_25377":113709,"_2660":113868},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3162":66546,"_27851":66500,"_19309":113870,"_5":13254,"_25377":113709,"_2660":113871},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3162":66547,"_27851":66500,"_19309":113873,"_5":13254,"_25377":113713,"_2660":113874},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3162":66548,"_27851":66500,"_19309":113876,"_5":13254,"_25377":113713,"_2660":113877},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3162":66549,"_27851":66500,"_19309":113879,"_5":13254,"_25377":113717,"_2660":113880},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3162":66550,"_27851":66500,"_19309":113882,"_5":13254,"_25377":113721,"_2660":113883},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3162":66551,"_27851":66500,"_19309":113885,"_5":13254,"_25377":113721,"_2660":113886},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3162":66552,"_27851":66500,"_19309":113888,"_5":13254,"_25377":113721,"_2660":113889},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3162":66553,"_27851":66500,"_19309":113891,"_5":13254,"_25377":113721,"_2660":113892},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3162":66554,"_27851":66500,"_19309":113894,"_5":13254,"_25377":113721,"_2660":113895},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3162":66555,"_27851":66500,"_19309":113897,"_5":13254,"_25377":113725,"_2660":113898},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3162":66556,"_27851":66500,"_19309":113900,"_5":13254,"_25377":113725,"_2660":113901},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3162":66557,"_27851":66500,"_19309":113903,"_5":13254,"_25377":113725,"_2660":113904},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3162":66558,"_27851":66500,"_19309":113906,"_5":13254,"_25377":113725,"_2660":113907},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3162":66559,"_27851":66500,"_19309":113909,"_5":13254,"_25377":113725,"_2660":113910},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3162":66560,"_27851":66500,"_19309":113912,"_5":13254,"_25377":113729,"_2660":113913},[],"Cambio",{"_3162":66561,"_27851":66500,"_19309":113915,"_5":13254,"_25377":113729,"_2660":113916},[],"A quién afecta",{"_3162":66562,"_27851":66500,"_19309":113918,"_5":13254,"_25377":113729,"_2660":113919},[],"Gravedad",{"_3162":66563,"_27851":66500,"_19309":113921,"_5":13254,"_25377":113729,"_2660":113922},[],"Acción",{"_3162":66564,"_27851":66500,"_19309":113924,"_5":13254,"_25377":113729,"_2660":113737},[],{"_3162":66565,"_27851":66500,"_19309":113926,"_5":13254,"_25377":113729,"_2660":113927},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3162":66566,"_27851":66500,"_19309":113929,"_5":13254,"_25377":113729,"_2660":113930},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3162":66567,"_27851":66500,"_19309":113932,"_5":13254,"_25377":113729,"_2660":113933},[],"Copiar los datos a los volúmenes nuevos",{"_3162":66568,"_27851":66500,"_19309":113935,"_5":13254,"_25377":113729,"_2660":113741},[],{"_3162":66569,"_27851":66500,"_19309":113937,"_5":13254,"_25377":113729,"_2660":113938},[],"Todas las releases de Helm",{"_3162":66570,"_27851":66500,"_19309":113940,"_5":13254,"_25377":113729,"_2660":113941},[],"Alta: `helm upgrade` falla",{"_3162":66571,"_27851":66500,"_19309":113943,"_5":13254,"_25377":113729,"_2660":113944},[],"Eliminar o renombrar las claves heredadas",{"_3162":66572,"_27851":66500,"_19309":113946,"_5":13254,"_25377":113729,"_2660":113745},[],{"_3162":66573,"_27851":66500,"_19309":113948,"_5":13254,"_25377":113729,"_2660":113949},[],"Todos los despliegues",{"_3162":66574,"_27851":66500,"_19309":113951,"_5":13254,"_25377":113729,"_2660":113952},[],"Alta: sin principal de bootstrap no hay administrador",{"_3162":66575,"_27851":66500,"_19309":113954,"_5":13254,"_25377":113729,"_2660":113955},[],"Configurar `services.authz`",{"_3162":66576,"_27851":66500,"_19309":113957,"_5":13254,"_25377":113729,"_2660":113749},[],{"_3162":66577,"_27851":66500,"_19309":113959,"_5":13254,"_25377":113729,"_2660":113938},[],{"_3162":66578,"_27851":66500,"_19309":113961,"_5":13254,"_25377":113729,"_2660":113962},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3162":66579,"_27851":66500,"_19309":113964,"_5":13254,"_25377":113729,"_2660":113965},[],"Mover JWKS y roles a `services.authz`",{"_3162":66580,"_27851":66500,"_19309":113967,"_5":13254,"_25377":113729,"_2660":113769},[],{"_3162":66581,"_27851":66500,"_19309":113969,"_5":13254,"_25377":113729,"_2660":113970},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3162":66582,"_27851":66500,"_19309":113972,"_5":13254,"_25377":113729,"_2660":113973},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3162":66583,"_27851":66500,"_19309":113975,"_5":13254,"_25377":113729,"_2660":113976},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3162":66584,"_27851":66500,"_19309":113978,"_5":13254,"_25377":113729,"_2660":113773},[],{"_3162":66585,"_27851":66500,"_19309":113980,"_5":13254,"_25377":113729,"_2660":113981},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3162":66586,"_27851":66500,"_19309":113983,"_5":13254,"_25377":113729,"_2660":113984},[],"Alta: el backend ya no arranca con ellos",{"_3162":66587,"_27851":66500,"_19309":113986,"_5":13254,"_25377":113729,"_2660":113987},[],"Pasar a PostgreSQL antes de actualizar",{"_3162":66588,"_27851":66500,"_19309":113989,"_5":13254,"_25377":113729,"_2660":113990},[],"Webhooks con referencias a archivos",{"_3162":66589,"_27851":66500,"_19309":113992,"_5":13254,"_25377":113729,"_2660":113993},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3162":66590,"_27851":66500,"_19309":113995,"_5":13254,"_25377":113729,"_2660":113996},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3162":66591,"_27851":66500,"_19309":113998,"_5":13254,"_25377":113729,"_2660":113999},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3162":66592,"_27851":66500,"_19309":114001,"_5":13254,"_25377":113729,"_2660":113753},[],{"_3162":66593,"_27851":66500,"_19309":114003,"_5":13254,"_25377":113729,"_2660":114004},[],"Releases con identidades por servicio o material de claves montado",{"_3162":66594,"_27851":66500,"_19309":114006,"_5":13254,"_25377":113729,"_2660":114007},[],"Media: los servicios no pueden leer sus archivos",{"_3162":66595,"_27851":66500,"_19309":114009,"_5":13254,"_25377":113729,"_2660":114010},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3162":66596,"_27851":66500,"_19309":114012,"_5":13254,"_25377":113729,"_2660":113757},[],{"_3162":66597,"_27851":66500,"_19309":114014,"_5":13254,"_25377":113729,"_2660":114015},[],"Releases que definen `amqp.tls`",{"_3162":66598,"_27851":66500,"_19309":114017,"_5":13254,"_25377":113729,"_2660":114018},[],"Media: los clientes se conectan al puerto equivocado",{"_3162":66599,"_27851":66500,"_19309":114020,"_5":13254,"_25377":113729,"_2660":114021},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3162":66600,"_27851":66500,"_19309":114023,"_5":13254,"_25377":113729,"_2660":113777},[],{"_3162":66601,"_27851":66500,"_19309":114025,"_5":13254,"_25377":113729,"_2660":114026},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3162":66602,"_27851":66500,"_19309":114028,"_5":13254,"_25377":113729,"_2660":114029},[],"Media: las claves de CA quedan sin gestionar",{"_3162":66603,"_27851":66500,"_19309":114031,"_5":13254,"_25377":113729,"_2660":114032},[],"Ejecutar la migración de CA a KMS",{"_3162":66604,"_27851":66500,"_19309":114034,"_5":13254,"_25377":113729,"_2660":114035},[],"Verificación del certificado del receptor",{"_3162":66605,"_27851":66500,"_19309":114037,"_5":13254,"_25377":113729,"_2660":114038},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3162":66606,"_27851":66500,"_19309":114040,"_5":13254,"_25377":113729,"_2660":114041},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3162":66607,"_27851":66500,"_19309":114043,"_5":13254,"_25377":113729,"_2660":114044},[],"Poner `insecure_skip_verify` a `false`",{"_3162":66608,"_27851":66500,"_19309":114046,"_5":13254,"_25377":113729,"_2660":113789},[],{"_3162":66609,"_27851":66500,"_19309":114048,"_5":13254,"_25377":113729,"_2660":114049},[],"Scripts y consolas que editan DMS por API",{"_3162":66610,"_27851":66500,"_19309":114051,"_5":13254,"_25377":113729,"_2660":114052},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3162":66611,"_27851":66500,"_19309":114054,"_5":13254,"_25377":113729,"_2660":114055},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3162":66612,"_27851":66500,"_19309":114057,"_5":13254,"_25377":113729,"_2660":113805},[],{"_3162":66613,"_27851":66500,"_19309":114059,"_5":13254,"_25377":113729,"_2660":114060},[],"Consumidores que leen el campo `events` del dispositivo",{"_3162":66614,"_27851":66500,"_19309":114062,"_5":13254,"_25377":113729,"_2660":114063},[],"Media: el campo desaparece",{"_3162":66615,"_27851":66500,"_19309":114065,"_5":13254,"_25377":113729,"_2660":114066},[],"Usar los nuevos endpoints de eventos",{"_3162":66616,"_27851":66500,"_19309":114068,"_5":13254,"_25377":113729,"_2660":113761},[],{"_3162":66617,"_27851":66500,"_19309":114070,"_5":13254,"_25377":113729,"_2660":114071},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3162":66618,"_27851":66500,"_19309":114073,"_5":13254,"_25377":113729,"_2660":114074},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3162":66619,"_27851":66500,"_19309":114076,"_5":13254,"_25377":113729,"_2660":114077},[],"Actualizar el archivo de values",{"_3162":66620,"_27851":66500,"_19309":114079,"_5":13254,"_25377":113729,"_2660":113797},[],{"_3162":66621,"_27851":66500,"_19309":114081,"_5":13254,"_25377":113729,"_2660":114082},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3162":66622,"_27851":66500,"_19309":114084,"_5":13254,"_25377":113729,"_2660":114085},[],"Baja: prevalece el ID de la URL",{"_3162":66623,"_27851":66500,"_19309":114087,"_5":13254,"_25377":113729,"_2660":114088},[],"Enviar el ID en la URL",{"_3162":66624,"_27851":66500,"_19309":114090,"_5":13254,"_25377":113729,"_2660":113801},[],{"_3162":66625,"_27851":66500,"_19309":114092,"_5":13254,"_25377":113729,"_2660":114093},[],"Consumidores que comparan el `type` del certificado",{"_3162":66626,"_27851":66500,"_19309":114095,"_5":13254,"_25377":113729,"_2660":114096},[],"Baja: dos valores cambian de nombre",{"_3162":66627,"_27851":66500,"_19309":114098,"_5":13254,"_25377":113729,"_2660":114099},[],"Adaptar los consumidores",{"_3162":66628,"_27851":66500,"_19309":114101,"_5":13254,"_25377":113729,"_2660":113793},[],{"_3162":66629,"_27851":66500,"_19309":114103,"_5":13254,"_25377":113729,"_2660":114104},[],"Cualquier DMS",{"_3162":66630,"_27851":66500,"_19309":114106,"_5":13254,"_25377":113729,"_2660":114107},[],"Baja: solo informativo",{"_3162":66631,"_27851":66500,"_19309":114109,"_5":13254,"_25377":113729,"_2660":114110},[],"Revisar ambos bloques antes de editar",{"_3162":66632,"_27851":66500,"_19309":114112,"_5":13254,"_25377":113736,"_2660":114113},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3162":66633,"_27851":66500,"_19309":114115,"_5":13254,"_25377":113736,"_2660":114116},[],"El paso 4 de la guía de migración copia los datos.",{"_3162":66634,"_27851":66500,"_19309":114118,"_5":13254,"_25377":113740,"_2660":114119},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3162":66635,"_27851":66500,"_19309":114121,"_5":13254,"_25377":113744,"_2660":114122},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3162":66636,"_27851":66500,"_19309":114124,"_5":13254,"_25377":113748,"_2660":114125},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3162":66637,"_27851":66500,"_19309":114127,"_5":13254,"_25377":113752,"_2660":114128},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3162":66638,"_27851":66500,"_19309":114130,"_5":13254,"_25377":113752,"_2660":114131},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3162":66639,"_27851":66500,"_19309":114133,"_5":13254,"_25377":113756,"_2660":114134},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3162":66640,"_27851":66500,"_19309":114136,"_5":13254,"_25377":113760,"_2660":114137},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3162":66641,"_27851":66500,"_19309":114139,"_5":13254,"_25377":113760,"_2660":114140},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3162":66642,"_27851":66500,"_19309":114142,"_5":13254,"_25377":113760,"_2660":114143},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3162":66643,"_27851":66500,"_19309":114145,"_5":13254,"_25377":113760,"_2660":114146},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3162":66644,"_27851":66500,"_19309":114148,"_5":13254,"_25377":113760,"_2660":114149},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3162":66645,"_27851":66500,"_19309":114151,"_5":13254,"_25377":113760,"_2660":114152},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3162":66646,"_27851":66500,"_19309":114154,"_5":13254,"_25377":113768,"_2660":114155},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3162":66647,"_27851":66500,"_19309":114157,"_5":13254,"_25377":113768,"_2660":114158},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3162":66648,"_27851":66500,"_19309":114160,"_5":13254,"_25377":113768,"_2660":114161},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3162":66649,"_27851":66500,"_19309":114163,"_5":13254,"_25377":113768,"_2660":114164},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3162":66650,"_27851":66500,"_19309":114166,"_5":13254,"_25377":113768,"_2660":114167},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3162":66651,"_27851":66500,"_19309":114169,"_5":13254,"_25377":113772,"_2660":114170},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3162":66652,"_27851":66500,"_19309":114172,"_5":13254,"_25377":113776,"_2660":114173},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3162":66653,"_27851":66500,"_19309":114175,"_5":13254,"_25377":113776,"_2660":114176},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3162":66654,"_27851":66500,"_19309":114178,"_5":13254,"_25377":113776,"_2660":114179},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3162":66655,"_27851":66500,"_19309":114181,"_5":13254,"_25377":113776,"_2660":114182},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3162":66656,"_27851":66500,"_19309":114184,"_5":13254,"_25377":113776,"_2660":114185},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3162":66657,"_27851":66500,"_19309":114187,"_5":13254,"_25377":113776,"_2660":114188},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3162":66658,"_27851":66500,"_19309":114190,"_5":13254,"_25377":113784,"_2660":114191},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3162":66659,"_27851":66500,"_19309":114193,"_5":13254,"_25377":113784,"_2660":114194},[],"Campo en 3.8.0",{"_3162":66660,"_27851":66500,"_19309":114196,"_5":13254,"_25377":113784,"_2660":114197},[],"Campo en 4.0.0",{"_3162":66661,"_27851":66500,"_19309":114199,"_5":13254,"_25377":113784,"_2660":53257},[],{"_3162":66662,"_27851":66500,"_19309":114201,"_5":13254,"_25377":113784,"_2660":114202},[],"`insecure_skip_verify` (con el valor negado)",{"_3162":66663,"_27851":66500,"_19309":114204,"_5":13254,"_25377":113784,"_2660":53263},[],{"_3162":66664,"_27851":66500,"_19309":114206,"_5":13254,"_25377":113784,"_2660":53266},[],{"_3162":66665,"_27851":66500,"_19309":114208,"_5":13254,"_25377":113784,"_2660":53269},[],{"_3162":66666,"_27851":66500,"_19309":114210,"_5":13254,"_25377":113784,"_2660":53272},[],{"_3162":66667,"_27851":66500,"_19309":114212,"_5":13254,"_25377":113784,"_2660":53275},[],{"_3162":66668,"_27851":66500,"_19309":114214,"_5":13254,"_25377":113784,"_2660":53278},[],{"_3162":66669,"_27851":66500,"_19309":114216,"_5":13254,"_25377":113784,"_2660":114217},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3162":66670,"_27851":66500,"_19309":114219,"_5":13254,"_25377":113784,"_2660":114220},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3162":66671,"_27851":66500,"_19309":114222,"_5":13254,"_25377":113784,"_2660":114223},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3162":66672,"_27851":66500,"_19309":114225,"_5":13254,"_25377":113788,"_2660":114226},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3162":66673,"_27851":66500,"_19309":114228,"_5":13254,"_25377":113788,"_2660":114229},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3162":66674,"_27851":66500,"_19309":114231,"_5":13254,"_25377":113788,"_2660":114232},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3162":66675,"_27851":66500,"_19309":114234,"_5":13254,"_25377":113792,"_2660":114235},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3162":66676,"_27851":66500,"_19309":114237,"_5":13254,"_25377":113796,"_2660":114238},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3162":66677,"_27851":66500,"_19309":114240,"_5":13254,"_25377":113800,"_2660":114241},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3162":66678,"_27851":66500,"_19309":114243,"_5":13254,"_25377":113804,"_2660":114244},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3162":66679,"_27851":66500,"_19309":114246,"_5":13254,"_25377":113804,"_2660":114247},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3162":66680,"_27851":66500,"_19309":114249,"_5":13254,"_25377":113804,"_2660":114250},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3162":66681,"_27851":66500,"_19309":114252,"_5":13254,"_25377":113804,"_2660":114253},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3162":66682,"_27851":66500,"_19309":114255,"_5":13254,"_25377":113808,"_2660":114256},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3162":66683,"_27851":66500,"_19309":114258,"_5":13254,"_25377":113812,"_2660":114259},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3162":66684,"_27851":66500,"_19309":114261,"_5":13254,"_25377":113812,"_2660":114262},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3162":66685,"_27851":66500,"_19309":114264,"_5":13254,"_25377":113812,"_2660":114265},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3162":66686,"_27851":66500,"_19309":114267,"_5":13254,"_25377":113812,"_2660":114268},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3162":66687,"_27851":66500,"_19309":114270,"_5":13254,"_25377":113812,"_2660":114271},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3162":66688,"_27851":66500,"_19309":114273,"_5":13254,"_25377":113816,"_2660":114274},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3162":66689,"_27851":66500,"_19309":114276,"_5":13254,"_25377":113816,"_2660":114277},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3162":66690,"_27851":66500,"_19309":114279,"_5":13254,"_25377":113816,"_2660":114280},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3162":66691,"_27851":66500,"_19309":114282,"_5":13254,"_25377":113816,"_2660":114283},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3162":66692,"_27851":66500,"_19309":114285,"_5":13254,"_25377":113816,"_2660":114286},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3162":66693,"_27851":66500,"_19309":114288,"_5":13254,"_25377":113816,"_2660":114289},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3162":66694,"_27851":66500,"_19309":114291,"_5":13254,"_25377":113816,"_2660":114292},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3162":66695,"_27851":66500,"_19309":114294,"_5":13254,"_25377":113816,"_2660":114295},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3162":66696,"_27851":66500,"_19309":114297,"_5":13254,"_25377":113816,"_2660":114298},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3162":66697,"_27851":66500,"_19309":114300,"_5":13254,"_25377":113816,"_2660":114301},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3162":66698,"_27851":66500,"_19309":114303,"_5":13254,"_25377":113816,"_2660":114304},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3162":66699,"_27851":66500,"_19309":114306,"_5":13254,"_25377":113816,"_2660":114307},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3162":66700,"_27851":66500,"_19309":114309,"_5":13254,"_25377":113820,"_2660":114310},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3162":66701,"_27851":66500,"_19309":114312,"_5":13254,"_25377":113820,"_2660":114313},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3162":66702,"_27851":66500,"_19309":114315,"_5":13254,"_25377":113824,"_2660":114316},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3162":66703,"_27851":66500,"_19309":114318,"_5":13254,"_25377":113824,"_2660":114319},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3162":66704,"_27851":66500,"_19309":114321,"_5":13254,"_25377":113824,"_2660":114322},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3162":66705,"_27851":66500,"_19309":114324,"_5":13254,"_25377":113824,"_2660":114325},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3162":66706,"_27851":66500,"_19309":114327,"_5":13254,"_25377":113824,"_2660":114328},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3162":66707,"_27851":66500,"_19309":114330,"_5":13254,"_25377":113824,"_2660":114331},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3162":66708,"_27851":66500,"_19309":114333,"_5":13254,"_25377":113824,"_2660":114334},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3162":66709,"_27851":66500,"_19309":114336,"_5":13254,"_25377":113824,"_2660":114337},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3162":66710,"_27851":66500,"_19309":114339,"_5":13254,"_25377":113824,"_2660":114340},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3162":66711,"_27851":66500,"_19309":114342,"_5":13254,"_25377":113824,"_2660":114343},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3162":66712,"_27851":66500,"_19309":114345,"_5":13254,"_25377":113824,"_2660":114346},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3162":66713,"_27851":66500,"_19309":114348,"_5":13254,"_25377":113828,"_2660":114349},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3162":66714,"_27851":66500,"_19309":114351,"_5":13254,"_25377":113828,"_2660":114352},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3162":66715,"_27851":66500,"_19309":114354,"_5":13254,"_25377":113832,"_2660":114355},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3162":66716,"_27851":66500,"_19309":114357,"_5":13254,"_25377":113832,"_2660":114358},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3162":66717,"_27851":66500,"_19309":114360,"_5":13254,"_25377":113832,"_2660":114361},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3162":66718,"_27851":66500,"_19309":114363,"_5":13254,"_25377":113832,"_2660":114364},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3162":66719,"_27851":66500,"_19309":114366,"_5":13254,"_25377":113832,"_2660":114367},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3162":66720,"_27851":66500,"_19309":114369,"_5":13254,"_25377":113836,"_2660":114370},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3162":66721,"_27851":66500,"_19309":114372,"_5":13254,"_25377":113836,"_2660":114373},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3162":66722,"_27851":66500,"_19309":114375,"_5":13254,"_25377":113836,"_2660":114376},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3162":66723,"_27851":66500,"_19309":114378,"_5":13254,"_25377":113836,"_2660":114379},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3162":66724,"_27851":66500,"_19309":114381,"_5":13254,"_25377":113836,"_2660":114382},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3162":66725,"_27851":66500,"_19309":114384,"_5":13254,"_25377":113836,"_2660":114385},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3162":66726,"_27851":66500,"_19309":114387,"_5":13254,"_25377":113836,"_2660":114388},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3162":66727,"_27851":66500,"_19309":114390,"_5":13254,"_25377":113839,"_2660":114391},[],"Tras la actualización, comprueba en este orden:",{"_3162":66728,"_27851":66500,"_19309":114393,"_5":13254,"_25377":113839,"_2660":114394},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3162":66729,"_27851":66500,"_19309":114396,"_5":13254,"_25377":113839,"_2660":114397},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3162":66730,"_27851":66500,"_19309":114399,"_5":13254,"_25377":113839,"_2660":114400},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3162":66731,"_27851":66500,"_19309":114402,"_5":13254,"_25377":113839,"_2660":114403},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3162":66732,"_27851":66500,"_19309":114405,"_5":13254,"_25377":113839,"_2660":114406},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3162":66733,"_27851":66500,"_19309":114408,"_5":13254,"_25377":113839,"_2660":114409},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3162":66734,"_27851":66500,"_19309":114411,"_5":13254,"_25377":113839,"_2660":114412},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3162":66735,"_27851":66500,"_19309":114414,"_5":13254,"_25377":113839,"_2660":114415},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3162":66736,"_27851":66500,"_19309":114417,"_5":13254,"_25377":113839,"_2660":114418},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3162":66737,"_27851":66500,"_19309":114420,"_5":13254,"_25377":113839,"_2660":114421},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3162":66738,"_27851":66500,"_19309":114423,"_5":13254,"_25377":113839,"_2660":114424},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3162":66739,"_27851":66500,"_19309":114426,"_5":13254,"_25377":113839,"_2660":114427},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3162":66740,"_27851":66500,"_19309":114429,"_5":13254,"_25377":113839,"_2660":114430},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3162":66741,"_27851":66500,"_19309":114432,"_5":13254,"_25377":113839,"_2660":114433},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3162":66742,"_27851":66500,"_19309":114435,"_5":13254,"_25377":113843,"_2660":114436},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3162":66743,"_27851":66500,"_19309":114438,"_5":13254,"_25377":113843,"_2660":114439},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3162":66744,"_27851":66500,"_19309":114441,"_5":13254,"_25377":113843,"_2660":114442},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3162":66745,"_27851":66500,"_19309":114444,"_5":13254,"_25377":113843,"_2660":114445},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3162":66746,"_27851":66500,"_19309":114447,"_5":13254,"_25377":113843,"_2660":114448},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_53515":114450,"_53517":114451,"_53519":114452,"_53521":114453,"_16827":2682,"_64100":2682},"spanish",[2660,27851,5,25377],{"_2660":23097,"_27851":23097,"_5":23097,"_25377":23097},{"_2660":114454,"_27851":117097,"_5":119740,"_25377":122383},{"_4253":114455,"_53525":114456,"_5":23097},{"_13309":4216,"_13684":15931,"_13703":5109,"_11940":6587,"_13690":4309,"_18325":3776,"_13330":6087,"_13337":13110,"_26901":6384,"_27292":6933,"_27313":5319,"_26919":5661,"_31964":2769,"_27324":23737,"_27353":2709,"_31971":3272,"_31974":6298,"_31977":4370,"_31980":6322,"_27699":5985,"_31985":5432,"_31987":9028,"_27729":6408,"_13699":14518,"_31991":14563,"_31994":4158,"_31996":4365,"_27342":2867,"_27694":7618,"_27748":5538,"_32001":5595,"_32003":3049,"_32005":6419,"_32007":3299,"_32009":6337,"_32011":6871,"_32013":3124,"_32015":5967,"_27909":3028,"_26971":3456,"_32019":3669,"_32021":15765,"_26965":19432,"_32024":5236,"_32026":10358,"_32028":4308,"_32031":5884,"_27011":4688,"_32035":6998,"_26892":3800,"_32038":3361,"_26924":4238,"_32041":6385,"_32043":6344,"_32046":3334,"_13693":7791,"_32049":2899,"_32051":2750,"_32054":5468,"_32056":3339,"_32058":18771,"_32060":4637,"_32062":8325,"_18328":23427,"_32065":14520,"_32067":18784,"_26945":6420,"_27336":5052,"_32071":6332,"_32073":6539,