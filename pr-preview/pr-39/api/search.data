103271,"_33613":103274,"_33615":103278,"_33617":103281,"_33619":103284,"_33621":103287,"_33623":103290,"_33625":103293,"_33627":103296,"_33629":103299,"_33631":103302,"_33633":103305,"_33635":103308,"_33637":103311,"_33639":103313,"_33641":103316,"_33643":103319,"_33645":103322,"_33647":103325,"_33649":103328,"_33651":103331,"_33653":103334,"_33655":103337,"_33657":103340,"_33659":103343,"_33661":103348,"_33663":103351,"_33665":103355,"_33667":103359,"_33669":103363,"_33671":103366,"_33673":103369,"_33675":103371,"_33677":103373,"_33679":103375,"_33681":103377,"_33683":103380,"_33685":103383,"_33687":103386,"_33689":103389,"_33691":103392,"_33693":103394,"_33695":103397,"_33697":103399,"_33699":103402,"_33701":103405,"_33703":103408,"_33705":103410,"_33707":103413,"_33709":103416,"_33711":103419,"_33713":103422,"_33715":103425,"_33717":103428,"_33719":103431,"_33721":103434,"_33723":103437,"_33725":103440,"_33727":103443,"_33729":103446},{"_2868":57938,"_25194":57938,"_5":12321,"_2395":96151,"_25530":96152,"_17578":96155,"_23043":57938},"Despliega desde AWS Marketplace",[40934,96153,96154],"Despliegue","Otros modelos",[],{"_2868":57939,"_25194":57938,"_17578":96157,"_5":17474,"_23043":57938,"_2395":96158},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2868":57940,"_25194":57938,"_5":25527,"_17578":96160,"_23043":96161,"_2395":96162},[],"/docs/pr-preview/pr-39/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2868":57941,"_25194":57938,"_5":25527,"_17578":96164,"_23043":96165,"_2395":96166},[],"/docs/pr-preview/pr-39/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2868":57942,"_25194":57938,"_5":25527,"_17578":96168,"_23043":96169,"_2395":96170},[],"/docs/pr-preview/pr-39/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2868":57943,"_25194":57938,"_5":25527,"_17578":96172,"_23043":96173,"_2395":96174},[],"/docs/pr-preview/pr-39/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2868":57944,"_25194":57938,"_5":25527,"_17578":96176,"_23043":96177,"_2395":96178},[],"/docs/pr-preview/pr-39/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2868":57945,"_25194":57938,"_5":25527,"_17578":96180,"_23043":96181,"_2395":96182},[],"/docs/pr-preview/pr-39/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2868":57946,"_25194":57938,"_5":25527,"_17578":96184,"_23043":96185,"_2395":96186},[],"/docs/pr-preview/pr-39/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2868":57947,"_25194":57938,"_17578":96188,"_5":17474,"_23043":57938,"_2395":96189},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2868":57948,"_25194":57938,"_17578":96191,"_5":17474,"_23043":96161,"_2395":96192},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2868":57949,"_25194":57938,"_17578":96194,"_5":17474,"_23043":96161,"_2395":96195},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2868":57950,"_25194":57938,"_17578":96197,"_5":17474,"_23043":96161,"_2395":96198},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2868":57951,"_25194":57938,"_17578":96200,"_5":17474,"_23043":96165,"_2395":96201},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2868":57952,"_25194":57938,"_17578":96203,"_5":17474,"_23043":96165,"_2395":96204},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2868":57953,"_25194":57938,"_17578":96206,"_5":17474,"_23043":96165,"_2395":96207},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2868":57954,"_25194":57938,"_17578":96209,"_5":17474,"_23043":96169,"_2395":96210},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2868":57955,"_25194":57938,"_17578":96212,"_5":17474,"_23043":96173,"_2395":96213},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2868":57956,"_25194":57938,"_17578":96215,"_5":17474,"_23043":96177,"_2395":96216},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2868":57957,"_25194":57938,"_17578":96218,"_5":17474,"_23043":96181,"_2395":96219},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2868":57958,"_25194":57938,"_17578":96221,"_5":17474,"_23043":96185,"_2395":96222},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2868":57959,"_25194":57959,"_5":12321,"_2395":96224,"_25530":96225,"_17578":96226,"_23043":57959},"Despliega Lamassu",[40934,96153],[],{"_2868":57960,"_25194":57959,"_17578":96228,"_5":17474,"_23043":57959,"_2395":96229},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2868":57961,"_25194":57959,"_5":25527,"_17578":96231,"_23043":96232,"_2395":96233},[],"/docs/pr-preview/pr-39/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2868":57962,"_25194":57959,"_5":25527,"_17578":96235,"_23043":96236,"_2395":96237},[],"/docs/pr-preview/pr-39/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2868":57963,"_25194":57959,"_5":25527,"_17578":96239,"_23043":96240,"_2395":96241},[],"/docs/pr-preview/pr-39/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2868":57964,"_25194":57959,"_17578":96243,"_5":17474,"_23043":57959,"_2395":96244},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2868":57965,"_25194":57959,"_17578":96246,"_5":17474,"_23043":96232,"_2395":96247},[],"Modelo",{"_2868":57966,"_25194":57959,"_17578":96249,"_5":17474,"_23043":96232,"_2395":96250},[],"Recomendado para",{"_2868":57967,"_25194":57959,"_17578":96252,"_5":17474,"_23043":96232,"_2395":96253},[],"Quién opera la infraestructura",{"_2868":57968,"_25194":57959,"_17578":96255,"_5":17474,"_23043":96232,"_2395":96256},[],"Punto de partida",{"_2868":57969,"_25194":57959,"_17578":96258,"_5":17474,"_23043":96232,"_2395":41041},[],{"_2868":57970,"_25194":57959,"_17578":96260,"_5":17474,"_23043":96232,"_2395":96261},[],"Producción, entornos regulados y despliegues personalizados",{"_2868":57971,"_25194":57959,"_17578":96263,"_5":17474,"_23043":96232,"_2395":96264},[],"Tu equipo",{"_2868":57972,"_25194":57959,"_17578":96266,"_5":17474,"_23043":96232,"_2395":96267},[],"Helm o Fastlane",{"_2868":57973,"_25194":57959,"_17578":96269,"_5":17474,"_23043":96232,"_2395":41053},[],{"_2868":57974,"_25194":57959,"_17578":96271,"_5":17474,"_23043":96232,"_2395":96272},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2868":57975,"_25194":57959,"_17578":96274,"_5":17474,"_23043":96232,"_2395":96264},[],{"_2868":57976,"_25194":57959,"_17578":96276,"_5":17474,"_23043":96232,"_2395":96277},[],"Imagen preconfigurada en EC2",{"_2868":57977,"_25194":57959,"_17578":96279,"_5":17474,"_23043":96232,"_2395":41064},[],{"_2868":57978,"_25194":57959,"_17578":96281,"_5":17474,"_23043":96232,"_2395":96282},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2868":57979,"_25194":57959,"_17578":96284,"_5":17474,"_23043":96232,"_2395":41070},[],{"_2868":57980,"_25194":57959,"_17578":96286,"_5":17474,"_23043":96232,"_2395":96287},[],"Suscripción gestionada",{"_2868":57981,"_25194":57959,"_17578":96289,"_5":17474,"_23043":96232,"_2395":96290},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2868":57982,"_25194":57959,"_17578":96292,"_5":17474,"_23043":96232,"_2395":96293},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2868":57983,"_25194":57959,"_17578":96295,"_5":17474,"_23043":96232,"_2395":96296},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2868":57984,"_25194":57959,"_17578":96298,"_5":17474,"_23043":96236,"_2395":96299},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2868":57985,"_25194":57959,"_17578":96301,"_5":17474,"_23043":96240,"_2395":96302},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2868":57986,"_25194":57986,"_5":12321,"_2395":96304,"_25530":96305,"_17578":96306,"_23043":57986},"Utiliza Lamassu como SaaS",[40934,96153,96154],[],{"_2868":57987,"_25194":57986,"_17578":96308,"_5":17474,"_23043":57986,"_2395":96309},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2868":57988,"_25194":57986,"_5":25527,"_17578":96311,"_23043":96312,"_2395":96313},[],"/docs/pr-preview/pr-39/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2868":57989,"_25194":57986,"_5":25527,"_17578":96315,"_23043":96316,"_2395":96317},[],"/docs/pr-preview/pr-39/es/deployment/saas#planes","Planes",{"_2868":57990,"_25194":57986,"_5":25527,"_17578":96319,"_23043":96320,"_2395":96321},[],"/docs/pr-preview/pr-39/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2868":57991,"_25194":57986,"_17578":96323,"_5":17474,"_23043":57986,"_2395":96324},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2868":57992,"_25194":57986,"_17578":96326,"_5":17474,"_23043":96312,"_2395":96327},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2868":57993,"_25194":57986,"_17578":96329,"_5":17474,"_23043":96312,"_2395":96330},[],"Copias de seguridad automáticas.",{"_2868":57994,"_25194":57986,"_17578":96332,"_5":17474,"_23043":96312,"_2395":96333},[],"Actualizaciones de versión.",{"_2868":57995,"_25194":57986,"_17578":96335,"_5":17474,"_23043":96312,"_2395":96336},[],"Soporte técnico y SLA según el plan contratado.",{"_2868":57996,"_25194":57986,"_17578":96338,"_5":17474,"_23043":96316,"_2395":41125},[],{"_2868":57997,"_25194":57986,"_17578":96340,"_5":17474,"_23043":96316,"_2395":96341},[],"Dispositivos",{"_2868":57998,"_25194":57986,"_17578":96343,"_5":17474,"_23043":96316,"_2395":96344},[],"Soporte",{"_2868":57999,"_25194":57986,"_17578":96346,"_5":17474,"_23043":96316,"_2395":41134},[],{"_2868":58000,"_25194":57986,"_17578":96348,"_5":17474,"_23043":96316,"_2395":41137},[],{"_2868":58001,"_25194":57986,"_17578":96350,"_5":17474,"_23043":96316,"_2395":96351},[],"Hasta 1.000",{"_2868":58002,"_25194":57986,"_17578":96353,"_5":17474,"_23043":96316,"_2395":41143},[],{"_2868":58003,"_25194":57986,"_17578":96355,"_5":17474,"_23043":96316,"_2395":96356},[],"99,5 %",{"_2868":58004,"_25194":57986,"_17578":96358,"_5":17474,"_23043":96316,"_2395":41149},[],{"_2868":58005,"_25194":57986,"_17578":96360,"_5":17474,"_23043":96316,"_2395":96361},[],"Hasta 10.000",{"_2868":58006,"_25194":57986,"_17578":96363,"_5":17474,"_23043":96316,"_2395":96364},[],"Email y chat",{"_2868":58007,"_25194":57986,"_17578":96366,"_5":17474,"_23043":96316,"_2395":96367},[],"99,9 %",{"_2868":58008,"_25194":57986,"_17578":96369,"_5":17474,"_23043":96316,"_2395":41161},[],{"_2868":58009,"_25194":57986,"_17578":96371,"_5":17474,"_23043":96316,"_2395":96372},[],"Ilimitados",{"_2868":58010,"_25194":57986,"_17578":96374,"_5":17474,"_23043":96316,"_2395":96375},[],"Dedicado",{"_2868":58011,"_25194":57986,"_17578":96377,"_5":17474,"_23043":96316,"_2395":96378},[],"99,99 %",{"_2868":58012,"_25194":57986,"_17578":96380,"_5":17474,"_23043":96320,"_2395":96381},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2868":58013,"_25194":57986,"_17578":96383,"_5":17474,"_23043":96320,"_2395":96384},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2868":58014,"_25194":58014,"_5":12321,"_2395":41178,"_25530":96386,"_17578":96388,"_23043":58014},[40934,96153,96387],"Kubernetes autogestionado",[],{"_2868":58015,"_25194":58014,"_17578":96390,"_5":17474,"_23043":58014,"_2395":96391},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2868":58016,"_25194":58014,"_5":25527,"_17578":96393,"_23043":96394,"_2395":96395},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2868":58017,"_25194":58014,"_5":25527,"_17578":96397,"_23043":96398,"_2395":96399},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2868":58018,"_25194":58014,"_5":25527,"_17578":96401,"_23043":96402,"_2395":96403},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2868":58019,"_25194":58014,"_5":25527,"_17578":96405,"_23043":96406,"_2395":96407},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2868":58020,"_25194":58014,"_5":25527,"_17578":96409,"_23043":96410,"_2395":96411},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2868":58021,"_25194":58014,"_5":25527,"_17578":96413,"_23043":96414,"_2395":96415},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2868":58022,"_25194":58014,"_5":25527,"_17578":96417,"_23043":96418,"_2395":96419},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2868":58023,"_25194":58014,"_5":25527,"_17578":96421,"_23043":96422,"_2395":96423},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2868":58024,"_25194":58014,"_5":25527,"_17578":96425,"_23043":96426,"_2395":96427},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2868":58025,"_25194":58014,"_5":25527,"_17578":96429,"_23043":96430,"_2395":96431},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2868":58026,"_25194":58014,"_17578":96433,"_5":17474,"_23043":96394,"_2395":96434},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2868":58027,"_25194":58014,"_17578":96436,"_5":17474,"_23043":96394,"_2395":96437},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2868":58028,"_25194":58014,"_17578":96439,"_5":17474,"_23043":96398,"_2395":96440},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2868":58029,"_25194":58014,"_17578":96442,"_5":17474,"_23043":96398,"_2395":96443},[],"Fastlane instala o configura",{"_2868":58030,"_25194":58014,"_17578":96445,"_5":17474,"_23043":96398,"_2395":96446},[],"Tú sigues proporcionando",{"_2868":58031,"_25194":58014,"_17578":96448,"_5":17474,"_23043":96398,"_2395":96449},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2868":58032,"_25194":58014,"_17578":96451,"_5":17474,"_23043":96398,"_2395":96452},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2868":58033,"_25194":58014,"_17578":96454,"_5":17474,"_23043":96398,"_2395":96455},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2868":58034,"_25194":58014,"_17578":96457,"_5":17474,"_23043":96398,"_2395":96458},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2868":58035,"_25194":58014,"_17578":96460,"_5":17474,"_23043":96398,"_2395":96461},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2868":58036,"_25194":58014,"_17578":96463,"_5":17474,"_23043":96398,"_2395":96464},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2868":58037,"_25194":58014,"_17578":96466,"_5":17474,"_23043":96398,"_2395":96467},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2868":58038,"_25194":58014,"_17578":96469,"_5":17474,"_23043":96398,"_2395":96470},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2868":58039,"_25194":58014,"_17578":96472,"_5":17474,"_23043":96398,"_2395":96473},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2868":58040,"_25194":58014,"_17578":96475,"_5":17474,"_23043":96402,"_2395":96476},[],"Necesitas:",{"_2868":58041,"_25194":58014,"_17578":96478,"_5":17474,"_23043":96402,"_2395":96479},[],"un clúster Kubernetes existente",{"_2868":58042,"_25194":58014,"_17578":96481,"_5":17474,"_23043":96402,"_2395":96482},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2868":58043,"_25194":58014,"_17578":96484,"_5":17474,"_23043":96402,"_2395":41276},[],{"_2868":58044,"_25194":58014,"_17578":96486,"_5":17474,"_23043":96402,"_2395":19903},[],{"_2868":58045,"_25194":58014,"_17578":96488,"_5":17474,"_23043":96402,"_2395":96489},[],"`jq` solo si usas `--sample-data`",{"_2868":58046,"_25194":58014,"_17578":96491,"_5":17474,"_23043":96402,"_2395":96492},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2868":58047,"_25194":58014,"_17578":96494,"_5":17474,"_23043":96402,"_2395":96495},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2868":58048,"_25194":58014,"_17578":96497,"_5":17474,"_23043":96402,"_2395":96498},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2868":58049,"_25194":58014,"_17578":96500,"_5":17474,"_23043":96406,"_2395":96501},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2868":58050,"_25194":58014,"_17578":96503,"_5":17474,"_23043":96406,"_2395":96504},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2868":58051,"_25194":58014,"_17578":96506,"_5":17474,"_23043":96410,"_2395":96507},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2868":58052,"_25194":58014,"_17578":96509,"_5":17474,"_23043":96410,"_2395":96510},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2868":58053,"_25194":58014,"_17578":96512,"_5":17474,"_23043":96410,"_2395":96513},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2868":58054,"_25194":58014,"_17578":96515,"_5":17474,"_23043":96410,"_2395":96516},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2868":58055,"_25194":58014,"_17578":96518,"_5":17474,"_23043":96414,"_2395":96519},[],"Opción",{"_2868":58056,"_25194":58014,"_17578":96521,"_5":17474,"_23043":96414,"_2395":96522},[],"Valor predeterminado",{"_2868":58057,"_25194":58014,"_17578":96524,"_5":17474,"_23043":96414,"_2395":96525},[],"Propósito",{"_2868":58058,"_25194":58014,"_17578":96527,"_5":17474,"_23043":96414,"_2395":41320},[],{"_2868":58059,"_25194":58014,"_17578":96529,"_5":17474,"_23043":96414,"_2395":41323},[],{"_2868":58060,"_25194":58014,"_17578":96531,"_5":17474,"_23043":96414,"_2395":96532},[],"Muestra la ayuda",{"_2868":58061,"_25194":58014,"_17578":96534,"_5":17474,"_23043":96414,"_2395":41329},[],{"_2868":58062,"_25194":58014,"_17578":96536,"_5":17474,"_23043":96414,"_2395":96537},[],"contexto actual",{"_2868":58063,"_25194":58014,"_17578":96539,"_5":17474,"_23043":96414,"_2395":96540},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2868":58064,"_25194":58014,"_17578":96542,"_5":17474,"_23043":96414,"_2395":41338},[],{"_2868":58065,"_25194":58014,"_17578":96544,"_5":17474,"_23043":96414,"_2395":5374},[],{"_2868":58066,"_25194":58014,"_17578":96546,"_5":17474,"_23043":96414,"_2395":96547},[],"Omite prompts y genera credenciales para las dependencias",{"_2868":58067,"_25194":58014,"_17578":96549,"_5":17474,"_23043":96414,"_2395":41346},[],{"_2868":58068,"_25194":58014,"_17578":96551,"_5":17474,"_23043":96414,"_2395":41349},[],{"_2868":58069,"_25194":58014,"_17578":96553,"_5":17474,"_23043":96414,"_2395":96554},[],"Namespace de la instalación",{"_2868":58070,"_25194":58014,"_17578":96556,"_5":17474,"_23043":96414,"_2395":41355},[],{"_2868":58071,"_25194":58014,"_17578":96558,"_5":17474,"_23043":96414,"_2395":41358},[],{"_2868":58072,"_25194":58014,"_17578":96560,"_5":17474,"_23043":96414,"_2395":96561},[],"Dominio usado por la UI, OIDC y el certificado",{"_2868":58073,"_25194":58014,"_17578":96563,"_5":17474,"_23043":96414,"_2395":41364},[],{"_2868":58074,"_25194":58014,"_17578":96565,"_5":17474,"_23043":96414,"_2395":12547},[],{"_2868":58075,"_25194":58014,"_17578":96567,"_5":17474,"_23043":96414,"_2395":96568},[],"Versión del chart de Lamassu",{"_2868":58076,"_25194":58014,"_17578":96570,"_5":17474,"_23043":96414,"_2395":41372},[],{"_2868":58077,"_25194":58014,"_17578":96572,"_5":17474,"_23043":96414,"_2395":41375},[],{"_2868":58078,"_25194":58014,"_17578":96574,"_5":17474,"_23043":96414,"_2395":96575},[],"Puerto del listener HTTPS",{"_2868":58079,"_25194":58014,"_17578":96577,"_5":17474,"_23043":96414,"_2395":41381},[],{"_2868":58080,"_25194":58014,"_17578":96579,"_5":17474,"_23043":96414,"_2395":41384},[],{"_2868":58081,"_25194":58014,"_17578":96581,"_5":17474,"_23043":96414,"_2395":96582},[],"Puerto del listener HTTP",{"_2868":58082,"_25194":58014,"_17578":96584,"_5":17474,"_23043":96414,"_2395":41390},[],{"_2868":58083,"_25194":58014,"_17578":96586,"_5":17474,"_23043":96414,"_2395":41323},[],{"_2868":58084,"_25194":58014,"_17578":96588,"_5":17474,"_23043":96414,"_2395":96589},[],"Certificado PEM para TLS downstream",{"_2868":58085,"_25194":58014,"_17578":96591,"_5":17474,"_23043":96414,"_2395":41398},[],{"_2868":58086,"_25194":58014,"_17578":96593,"_5":17474,"_23043":96414,"_2395":41323},[],{"_2868":58087,"_25194":58014,"_17578":96595,"_5":17474,"_23043":96414,"_2395":96596},[],"Clave privada PEM para TLS downstream",{"_2868":58088,"_25194":58014,"_17578":96598,"_5":17474,"_23043":96414,"_2395":41406},[],{"_2868":58089,"_25194":58014,"_17578":96600,"_5":17474,"_23043":96414,"_2395":96601},[],"chart del repositorio",{"_2868":58090,"_25194":58014,"_17578":96603,"_5":17474,"_23043":96414,"_2395":96604},[],"Usa un chart local de Lamassu sin empaquetar",{"_2868":58091,"_25194":58014,"_17578":96606,"_5":17474,"_23043":96414,"_2395":41415},[],{"_2868":58092,"_25194":58014,"_17578":96608,"_5":17474,"_23043":96414,"_2395":96609},[],"detección automática",{"_2868":58093,"_25194":58014,"_17578":96611,"_5":17474,"_23043":96414,"_2395":96612},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2868":58094,"_25194":58014,"_17578":96614,"_5":17474,"_23043":96414,"_2395":41423},[],{"_2868":58095,"_25194":58014,"_17578":96616,"_5":17474,"_23043":96414,"_2395":5374},[],{"_2868":58096,"_25194":58014,"_17578":96618,"_5":17474,"_23043":96414,"_2395":96619},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2868":58097,"_25194":58014,"_17578":96621,"_5":17474,"_23043":96414,"_2395":41431},[],{"_2868":58098,"_25194":58014,"_17578":96623,"_5":17474,"_23043":96414,"_2395":5374},[],{"_2868":58099,"_25194":58014,"_17578":96625,"_5":17474,"_23043":96414,"_2395":96626},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2868":58100,"_25194":58014,"_17578":96628,"_5":17474,"_23043":96414,"_2395":41439},[],{"_2868":58101,"_25194":58014,"_17578":96630,"_5":17474,"_23043":96414,"_2395":5374},[],{"_2868":58102,"_25194":58014,"_17578":96632,"_5":17474,"_23043":96414,"_2395":96633},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2868":58103,"_25194":58014,"_17578":96635,"_5":17474,"_23043":96414,"_2395":41447},[],{"_2868":58104,"_25194":58014,"_17578":96637,"_5":17474,"_23043":96414,"_2395":41450},[],{"_2868":58105,"_25194":58014,"_17578":96639,"_5":17474,"_23043":96414,"_2395":96640},[],"Usa otro chart local de SoftHSM",{"_2868":58106,"_25194":58014,"_17578":96642,"_5":17474,"_23043":96414,"_2395":96643},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2868":58107,"_25194":58014,"_17578":96645,"_5":17474,"_23043":96418,"_2395":41459},[],{"_2868":58108,"_25194":58014,"_17578":96647,"_5":17474,"_23043":96418,"_2395":96648},[],"valida las herramientas locales y el clúster seleccionado",{"_2868":58109,"_25194":58014,"_17578":96650,"_5":17474,"_23043":96418,"_2395":96651},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2868":58110,"_25194":58014,"_17578":96653,"_5":17474,"_23043":96418,"_2395":96654},[],"crea el namespace",{"_2868":58111,"_25194":58014,"_17578":96656,"_5":17474,"_23043":96418,"_2395":96657},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2868":58112,"_25194":58014,"_17578":96659,"_5":17474,"_23043":96418,"_2395":96660},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2868":58113,"_25194":58014,"_17578":96662,"_5":17474,"_23043":96418,"_2395":96663},[],"instala RabbitMQ",{"_2868":58114,"_25194":58014,"_17578":96665,"_5":17474,"_23043":96418,"_2395":96666},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2868":58115,"_25194":58014,"_17578":96668,"_5":17474,"_23043":96418,"_2395":96669},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2868":58116,"_25194":58014,"_17578":96671,"_5":17474,"_23043":96418,"_2395":96672},[],"carga datos de ejemplo opcionalmente",{"_2868":58117,"_25194":58014,"_17578":96674,"_5":17474,"_23043":96418,"_2395":96675},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2868":58118,"_25194":58014,"_17578":96677,"_5":17474,"_23043":96422,"_2395":96678},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2868":58119,"_25194":58014,"_17578":96680,"_5":17474,"_23043":96422,"_2395":96681},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2868":58120,"_25194":58014,"_17578":96683,"_5":17474,"_23043":96426,"_2395":96684},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2868":58121,"_25194":58014,"_17578":96686,"_5":17474,"_23043":96426,"_2395":96687},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2868":58122,"_25194":58014,"_17578":96689,"_5":17474,"_23043":96426,"_2395":96690},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2868":58123,"_25194":58014,"_17578":96692,"_5":17474,"_23043":96430,"_2395":96693},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2868":58124,"_25194":58124,"_5":12321,"_2395":96695,"_25530":96696,"_17578":96697,"_23043":58124},"Instala con Helm",[40934,96153,96387],[],{"_2868":58125,"_25194":58124,"_17578":96699,"_5":17474,"_23043":58124,"_2395":96700},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2868":58126,"_25194":58124,"_5":25527,"_17578":96702,"_23043":96703,"_2395":96704},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2868":58127,"_25194":58124,"_5":25527,"_17578":96706,"_23043":96707,"_2395":96403},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2868":58128,"_25194":58124,"_5":25527,"_17578":96709,"_23043":96710,"_2395":96711},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2868":58129,"_25194":58124,"_5":25527,"_17578":96713,"_23043":96714,"_2395":96715},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2868":58130,"_25194":58124,"_5":25527,"_17578":96717,"_23043":96718,"_2395":96719},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2868":58131,"_25194":58124,"_5":25527,"_17578":96721,"_23043":96722,"_2395":96723},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2868":58132,"_25194":58124,"_5":25527,"_17578":96725,"_23043":96726,"_2395":96727},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2868":58133,"_25194":58124,"_5":25527,"_17578":96729,"_23043":96730,"_2395":96731},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2868":58134,"_25194":58124,"_5":25527,"_17578":96733,"_23043":96734,"_2395":96735},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2868":58135,"_25194":58124,"_17578":96737,"_5":17474,"_23043":96703,"_2395":96738},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2868":58136,"_25194":58124,"_17578":96740,"_5":17474,"_23043":96707,"_2395":96741},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2868":58137,"_25194":58124,"_17578":96743,"_5":17474,"_23043":96707,"_2395":96744},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2868":58138,"_25194":58124,"_17578":96746,"_5":17474,"_23043":96707,"_2395":96747},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2868":58139,"_25194":58124,"_17578":96749,"_5":17474,"_23043":96707,"_2395":96750},[],"un broker RabbitMQ accesible y sus credenciales",{"_2868":58140,"_25194":58124,"_17578":96752,"_5":17474,"_23043":96707,"_2395":96753},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2868":58141,"_25194":58124,"_17578":96755,"_5":17474,"_23043":96707,"_2395":96756},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2868":58142,"_25194":58124,"_17578":96758,"_5":17474,"_23043":96707,"_2395":96759},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2868":58143,"_25194":58124,"_17578":96761,"_5":17474,"_23043":96707,"_2395":96762},[],"una StorageClass y un diseño de tráfico externo",{"_2868":58144,"_25194":58124,"_17578":96764,"_5":17474,"_23043":96707,"_2395":96765},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2868":58145,"_25194":58124,"_17578":96767,"_5":17474,"_23043":96707,"_2395":96768},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2868":58146,"_25194":58124,"_17578":96770,"_5":17474,"_23043":96707,"_2395":96771},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2868":58147,"_25194":58124,"_17578":96773,"_5":17474,"_23043":96710,"_2395":96774},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2868":58148,"_25194":58124,"_17578":96776,"_5":17474,"_23043":96710,"_2395":96777},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2868":58149,"_25194":58124,"_17578":96779,"_5":17474,"_23043":96710,"_2395":96780},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2868":58150,"_25194":58124,"_17578":96782,"_5":17474,"_23043":96714,"_2395":96783},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2868":58151,"_25194":58124,"_17578":96785,"_5":17474,"_23043":96714,"_2395":96786},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2868":58152,"_25194":58124,"_17578":96788,"_5":17474,"_23043":96714,"_2395":96789},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2868":58153,"_25194":58124,"_17578":96791,"_5":17474,"_23043":96718,"_2395":96792},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2868":58154,"_25194":58124,"_17578":96794,"_5":17474,"_23043":96722,"_2395":96795},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2868":58155,"_25194":58124,"_17578":96797,"_5":17474,"_23043":96722,"_2395":96798},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2868":58156,"_25194":58124,"_17578":96800,"_5":17474,"_23043":96722,"_2395":96801},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2868":58157,"_25194":58124,"_17578":96803,"_5":17474,"_23043":96722,"_2395":96804},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2868":58158,"_25194":58124,"_17578":96806,"_5":17474,"_23043":96726,"_2395":96807},[],"Para instalar un checkout local:",{"_2868":58159,"_25194":58124,"_17578":96809,"_5":17474,"_23043":96730,"_2395":96810},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2868":58160,"_25194":58124,"_17578":96812,"_5":17474,"_23043":96730,"_2395":96813},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2868":58161,"_25194":58124,"_17578":96815,"_5":17474,"_23043":96734,"_2395":96816},[],"Antes de pasar a producción, revisa:",{"_2868":58162,"_25194":58124,"_17578":96818,"_5":17474,"_23043":96734,"_2395":96819},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2868":58163,"_25194":58124,"_17578":96821,"_5":17474,"_23043":96734,"_2395":96822},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2868":58164,"_25194":58124,"_17578":96824,"_5":17474,"_23043":96734,"_2395":96825},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2868":58165,"_25194":58124,"_17578":96827,"_5":17474,"_23043":96734,"_2395":96828},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2868":58166,"_25194":58124,"_17578":96830,"_5":17474,"_23043":96734,"_2395":96831},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2868":58167,"_25194":58124,"_17578":96833,"_5":17474,"_23043":96734,"_2395":96834},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2868":58168,"_25194":58124,"_17578":96836,"_5":17474,"_23043":96734,"_2395":96837},[],"SMTP, observabilidad y entrega de alertas",{"_2868":58169,"_25194":58124,"_17578":96839,"_5":17474,"_23043":96734,"_2395":96840},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2868":58170,"_25194":58124,"_17578":96842,"_5":17474,"_23043":96734,"_2395":96843},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2868":58171,"_25194":58171,"_5":12321,"_2395":96845,"_25530":96846,"_17578":96847,"_23043":58171},"Expón el Gateway",[40934,96153,96387],[],{"_2868":58172,"_25194":58171,"_17578":96849,"_5":17474,"_23043":58171,"_2395":96850},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2868":58173,"_25194":58171,"_5":25527,"_17578":96852,"_23043":96853,"_2395":96854},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2868":58174,"_25194":58171,"_5":25527,"_17578":96856,"_23043":96857,"_2395":96858},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2868":58175,"_25194":58171,"_5":25527,"_17578":96860,"_23043":96861,"_2395":96862},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2868":58176,"_25194":58171,"_5":25527,"_17578":96864,"_23043":96865,"_2395":41680},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#k3s",{"_2868":58177,"_25194":58171,"_5":25527,"_17578":96867,"_23043":96868,"_2395":96869},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2868":58178,"_25194":58171,"_5":25527,"_17578":96871,"_23043":96872,"_2395":96873},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2868":58179,"_25194":58171,"_5":25527,"_17578":96875,"_23043":96876,"_2395":96877},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2868":58180,"_25194":58171,"_5":25527,"_17578":96879,"_23043":96880,"_2395":96881},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2868":58181,"_25194":58171,"_5":25527,"_17578":96883,"_23043":96884,"_2395":96885},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2868":58182,"_25194":58171,"_17578":96887,"_5":17474,"_23043":96853,"_2395":96888},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2868":58183,"_25194":58171,"_17578":96890,"_5":17474,"_23043":96853,"_2395":96891},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2868":58184,"_25194":58171,"_17578":96893,"_5":17474,"_23043":96857,"_2395":96894},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2868":58185,"_25194":58171,"_17578":96896,"_5":17474,"_23043":96857,"_2395":96897},[],"Defínelo únicamente cuando:",{"_2868":58186,"_25194":58171,"_17578":96899,"_5":17474,"_23043":96857,"_2395":96900},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2868":58187,"_25194":58171,"_17578":96902,"_5":17474,"_23043":96857,"_2395":96903},[],"esa dirección está asignada a este Gateway",{"_2868":58188,"_25194":58171,"_17578":96905,"_5":17474,"_23043":96857,"_2395":96906},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2868":58189,"_25194":58171,"_17578":96908,"_5":17474,"_23043":96857,"_2395":96909},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2868":58190,"_25194":58171,"_17578":96911,"_5":17474,"_23043":96857,"_2395":96912},[],"No confundas estos valores:",{"_2868":58191,"_25194":58171,"_17578":96914,"_5":17474,"_23043":96857,"_2395":96915},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2868":58192,"_25194":58171,"_17578":96917,"_5":17474,"_23043":96857,"_2395":96918},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2868":58193,"_25194":58171,"_17578":96920,"_5":17474,"_23043":96857,"_2395":96921},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2868":58194,"_25194":58171,"_17578":96923,"_5":17474,"_23043":96861,"_2395":96924},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2868":58195,"_25194":58171,"_17578":96926,"_5":17474,"_23043":96861,"_2395":96927},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2868":58196,"_25194":58171,"_17578":96929,"_5":17474,"_23043":96865,"_2395":96930},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2868":58197,"_25194":58171,"_17578":96932,"_5":17474,"_23043":96865,"_2395":96933},[],"Para el diseño recomendado:",{"_2868":58198,"_25194":58171,"_17578":96935,"_5":17474,"_23043":96865,"_2395":96936},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2868":58199,"_25194":58171,"_17578":96938,"_5":17474,"_23043":96865,"_2395":96939},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2868":58200,"_25194":58171,"_17578":96941,"_5":17474,"_23043":96865,"_2395":96942},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2868":58201,"_25194":58171,"_17578":96944,"_5":17474,"_23043":96865,"_2395":96945},[],"Apunta DNS a la dirección accesible de la VM.",{"_2868":58202,"_25194":58171,"_17578":96947,"_5":17474,"_23043":96865,"_2395":96948},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2868":58203,"_25194":58171,"_17578":96950,"_5":17474,"_23043":96868,"_2395":96951},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2868":58204,"_25194":58171,"_17578":96953,"_5":17474,"_23043":96872,"_2395":96954},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2868":58205,"_25194":58171,"_17578":96956,"_5":17474,"_23043":96872,"_2395":96957},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2868":58206,"_25194":58171,"_17578":96959,"_5":17474,"_23043":96876,"_2395":96960},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2868":58207,"_25194":58171,"_17578":96962,"_5":17474,"_23043":96876,"_2395":96963},[],"Requisito",{"_2868":58208,"_25194":58171,"_17578":96965,"_5":17474,"_23043":96876,"_2395":96966},[],"Diseño recomendado",{"_2868":58209,"_25194":58171,"_17578":96968,"_5":17474,"_23043":96876,"_2395":96969},[],"Consecuencia",{"_2868":58210,"_25194":58171,"_17578":96971,"_5":17474,"_23043":96876,"_2395":96972},[],"Varias URL o servicios de Lamassu",{"_2868":58211,"_25194":58171,"_17578":96974,"_5":17474,"_23043":96876,"_2395":96975},[],"Un Gateway con varias rutas",{"_2868":58212,"_25194":58171,"_17578":96977,"_5":17474,"_23043":96876,"_2395":96978},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2868":58213,"_25194":58171,"_17578":96980,"_5":17474,"_23043":96876,"_2395":96981},[],"Gateways independientes e IP externas distintas",{"_2868":58214,"_25194":58171,"_17578":96983,"_5":17474,"_23043":96876,"_2395":96984},[],"Una VIP por Gateway",{"_2868":58215,"_25194":58171,"_17578":96986,"_5":17474,"_23043":96876,"_2395":96987},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2868":58216,"_25194":58171,"_17578":96989,"_5":17474,"_23043":96876,"_2395":96990},[],"Gateways independientes, un nodo y una IP",{"_2868":58217,"_25194":58171,"_17578":96992,"_5":17474,"_23043":96876,"_2395":96993},[],"Puertos externos diferentes",{"_2868":58218,"_25194":58171,"_17578":96995,"_5":17474,"_23043":96876,"_2395":96996},[],"Los clientes deben indicar puertos no estándar",{"_2868":58219,"_25194":58171,"_17578":96998,"_5":17474,"_23043":96876,"_2395":96999},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2868":58220,"_25194":58171,"_17578":97001,"_5":17474,"_23043":96876,"_2395":97002},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2868":58221,"_25194":58171,"_17578":97004,"_5":17474,"_23043":96876,"_2395":97005},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2868":58222,"_25194":58171,"_17578":97007,"_5":17474,"_23043":96876,"_2395":97008},[],"Recursos Gateway separados pero proxy compartido",{"_2868":58223,"_25194":58171,"_17578":97010,"_5":17474,"_23043":96876,"_2395":97011},[],"Modo merged Gateway de Envoy",{"_2868":58224,"_25194":58171,"_17578":97013,"_5":17474,"_23043":96876,"_2395":97014},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2868":58225,"_25194":58171,"_17578":97016,"_5":17474,"_23043":96876,"_2395":97017},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2868":58226,"_25194":58171,"_17578":97019,"_5":17474,"_23043":96876,"_2395":97020},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2868":58227,"_25194":58171,"_17578":97022,"_5":17474,"_23043":96876,"_2395":97023},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2868":58228,"_25194":58171,"_17578":97025,"_5":17474,"_23043":96876,"_2395":97026},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2868":58229,"_25194":58171,"_17578":97028,"_5":17474,"_23043":96880,"_2395":97029},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2868":58230,"_25194":58171,"_17578":97031,"_5":17474,"_23043":96880,"_2395":97032},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2868":58231,"_25194":58171,"_17578":97034,"_5":17474,"_23043":96880,"_2395":97035},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2868":58232,"_25194":58171,"_17578":97037,"_5":17474,"_23043":96880,"_2395":97038},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2868":58233,"_25194":58171,"_17578":97040,"_5":17474,"_23043":96880,"_2395":97041},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2868":58234,"_25194":58171,"_17578":97043,"_5":17474,"_23043":96884,"_2395":97044},[],"Comprueba, en orden:",{"_2868":58235,"_25194":58171,"_17578":97046,"_5":17474,"_23043":96884,"_2395":97047},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2868":58236,"_25194":58171,"_17578":97049,"_5":17474,"_23043":96884,"_2395":97050},[],"Su estado contiene la dirección esperada.",{"_2868":58237,"_25194":58171,"_17578":97052,"_5":17474,"_23043":96884,"_2395":97053},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2868":58238,"_25194":58171,"_17578":97055,"_5":17474,"_23043":96884,"_2395":97056},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2868":58239,"_25194":58171,"_17578":97058,"_5":17474,"_23043":96884,"_2395":97059},[],"DNS resuelve al endpoint accesible externamente.",{"_2868":58240,"_25194":58171,"_17578":97061,"_5":17474,"_23043":96884,"_2395":97062},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2868":58241,"_25194":58171,"_17578":97064,"_5":17474,"_23043":96884,"_2395":97065},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2868":58242,"_25194":58242,"_5":12321,"_2395":41041,"_25530":97067,"_17578":97068,"_23043":58242},[40934,96153,96387],[],{"_2868":58243,"_25194":58242,"_17578":97070,"_5":17474,"_23043":58242,"_2395":97071},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2868":58244,"_25194":58242,"_5":25527,"_17578":97073,"_23043":97074,"_2395":97075},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2868":58245,"_25194":58242,"_5":25527,"_17578":97077,"_23043":97078,"_2395":97079},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2868":58246,"_25194":58242,"_5":25527,"_17578":97081,"_23043":97082,"_2395":97083},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2868":58247,"_25194":58242,"_5":25527,"_17578":97085,"_23043":97086,"_2395":97087},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2868":58248,"_25194":58242,"_5":25527,"_17578":97089,"_23043":97090,"_2395":97091},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2868":58249,"_25194":58242,"_5":25527,"_17578":97093,"_23043":97094,"_2395":97095},[],"/docs/pr-preview/pr-39/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2868":58250,"_25194":58242,"_17578":97097,"_5":17474,"_23043":97074,"_2395":97098},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2868":58251,"_25194":58242,"_17578":97100,"_5":17474,"_23043":97078,"_2395":97101},[],"Flujo",{"_2868":58252,"_25194":58242,"_17578":97103,"_5":17474,"_23043":97078,"_2395":97104},[],"Úsalo para",{"_2868":58253,"_25194":58242,"_17578":97106,"_5":17474,"_23043":97078,"_2395":97107},[],"Qué instala",{"_2868":58254,"_25194":58242,"_17578":97109,"_5":17474,"_23043":97078,"_2395":41925},[],{"_2868":58255,"_25194":58242,"_17578":97111,"_5":17474,"_23043":97078,"_2395":97112},[],"Producción y entornos controlados",{"_2868":58256,"_25194":58242,"_17578":97114,"_5":17474,"_23043":97078,"_2395":97115},[],"Servicios de Lamassu y recursos de Gateway API",{"_2868":58257,"_25194":58242,"_17578":97117,"_5":17474,"_23043":97078,"_2395":41178},[],{"_2868":58258,"_25194":58242,"_17578":97119,"_5":17474,"_23043":97078,"_2395":97120},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2868":58259,"_25194":58242,"_17578":97122,"_5":17474,"_23043":97078,"_2395":97123},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2868":58260,"_25194":58242,"_17578":97125,"_5":17474,"_23043":97082,"_2395":97126},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2868":58261,"_25194":58242,"_17578":97128,"_5":17474,"_23043":97082,"_2395":97129},[],"Área",{"_2868":58262,"_25194":58242,"_17578":97131,"_5":17474,"_23043":97082,"_2395":97132},[],"El chart de Lamassu proporciona",{"_2868":58263,"_25194":58242,"_17578":97134,"_5":17474,"_23043":97082,"_2395":97135},[],"Tú proporcionas",{"_2868":58264,"_25194":58242,"_17578":97137,"_5":17474,"_23043":97082,"_2395":97138},[],"Aplicaciones Lamassu",{"_2868":58265,"_25194":58242,"_17578":97140,"_5":17474,"_23043":97082,"_2395":97141},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2868":58266,"_25194":58242,"_17578":97143,"_5":17474,"_23043":97082,"_2395":97144},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2868":58267,"_25194":58242,"_17578":97146,"_5":17474,"_23043":97082,"_2395":97147},[],"Datos PostgreSQL",{"_2868":58268,"_25194":58242,"_17578":97149,"_5":17474,"_23043":97082,"_2395":97150},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2868":58269,"_25194":58242,"_17578":97152,"_5":17474,"_23043":97082,"_2395":97153},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2868":58270,"_25194":58242,"_17578":97155,"_5":17474,"_23043":97082,"_2395":97156},[],"Mensajería",{"_2868":58271,"_25194":58242,"_17578":97158,"_5":17474,"_23043":97082,"_2395":97159},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2868":58272,"_25194":58242,"_17578":97161,"_5":17474,"_23043":97082,"_2395":97162},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2868":58273,"_25194":58242,"_17578":97164,"_5":17474,"_23043":97082,"_2395":97165},[],"Identidad",{"_2868":58274,"_25194":58242,"_17578":97167,"_5":17474,"_23043":97082,"_2395":97168},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2868":58275,"_25194":58242,"_17578":97170,"_5":17474,"_23043":97082,"_2395":97171},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2868":58276,"_25194":58242,"_17578":97173,"_5":17474,"_23043":97082,"_2395":97174},[],"Enrutamiento externo",{"_2868":58277,"_25194":58242,"_17578":97176,"_5":17474,"_23043":97082,"_2395":97177},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2868":58278,"_25194":58242,"_17578":97179,"_5":17474,"_23043":97082,"_2395":97180},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2868":58279,"_25194":58242,"_17578":97182,"_5":17474,"_23043":97082,"_2395":41999},[],{"_2868":58280,"_25194":58242,"_17578":97184,"_5":17474,"_23043":97082,"_2395":97185},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2868":58281,"_25194":58242,"_17578":97187,"_5":17474,"_23043":97082,"_2395":97188},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2868":58282,"_25194":58242,"_17578":97190,"_5":17474,"_23043":97082,"_2395":97191},[],"Datos persistentes de la aplicación",{"_2868":58283,"_25194":58242,"_17578":97193,"_5":17474,"_23043":97082,"_2395":97194},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2868":58284,"_25194":58242,"_17578":97196,"_5":17474,"_23043":97082,"_2395":97197},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2868":58285,"_25194":58242,"_17578":97199,"_5":17474,"_23043":97082,"_2395":97200},[],"Integraciones opcionales",{"_2868":58286,"_25194":58242,"_17578":97202,"_5":17474,"_23043":97082,"_2395":97203},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2868":58287,"_25194":58242,"_17578":97205,"_5":17474,"_23043":97082,"_2395":97206},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2868":58288,"_25194":58242,"_17578":97208,"_5":17474,"_23043":97082,"_2395":97209},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2868":58289,"_25194":58242,"_17578":97211,"_5":17474,"_23043":97082,"_2395":97212},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2868":58290,"_25194":58242,"_17578":97214,"_5":17474,"_23043":97086,"_2395":97215},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2868":58291,"_25194":58242,"_17578":97217,"_5":17474,"_23043":97086,"_2395":97218},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2868":58292,"_25194":58242,"_17578":97220,"_5":17474,"_23043":97090,"_2395":97221},[],"Kubernetes 1.24 o posterior",{"_2868":58293,"_25194":58242,"_17578":97223,"_5":17474,"_23043":97090,"_2395":97224},[],"Helm 3.2 o posterior",{"_2868":58294,"_25194":58242,"_17578":97226,"_5":17474,"_23043":97090,"_2395":97227},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2868":58295,"_25194":58242,"_17578":97229,"_5":17474,"_23043":97090,"_2395":97230},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2868":58296,"_25194":58242,"_17578":97232,"_5":17474,"_23043":97090,"_2395":97233},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2868":58297,"_25194":58242,"_17578":97235,"_5":17474,"_23043":97090,"_2395":97236},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2868":58298,"_25194":58242,"_17578":97238,"_5":17474,"_23043":97090,"_2395":97239},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2868":58299,"_25194":58242,"_17578":97241,"_5":17474,"_23043":97094,"_2395":97242},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2868":58300,"_25194":58242,"_17578":97244,"_5":17474,"_23043":97094,"_2395":97245},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2868":58301,"_25194":58242,"_17578":97247,"_5":17474,"_23043":97094,"_2395":97248},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2868":58302,"_25194":58302,"_5":12321,"_2395":97250,"_25530":97251,"_17578":97253,"_23043":58302},"Resolución de problemas de despliegue",[40934,96153,97252],"Operación",[],{"_2868":58303,"_25194":58302,"_17578":97255,"_5":17474,"_23043":58302,"_2395":97256},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2868":58304,"_25194":58302,"_5":25527,"_17578":97258,"_23043":97259,"_2395":97260},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2868":58305,"_25194":58302,"_5":25527,"_17578":97262,"_23043":97263,"_2395":97264},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2868":58306,"_25194":58302,"_5":25527,"_17578":97266,"_23043":97267,"_2395":97268},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2868":58307,"_25194":58302,"_5":25527,"_17578":97270,"_23043":97271,"_2395":97272},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2868":58308,"_25194":58302,"_5":25527,"_17578":97274,"_23043":97275,"_2395":97276},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2868":58309,"_25194":58302,"_5":25527,"_17578":97278,"_23043":97279,"_2395":97280},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2868":58310,"_25194":58302,"_5":25527,"_17578":97282,"_23043":97283,"_2395":97284},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2868":58311,"_25194":58302,"_5":25527,"_17578":97286,"_23043":97287,"_2395":97288},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2868":58312,"_25194":58302,"_5":25527,"_17578":97290,"_23043":97291,"_2395":97292},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2868":58313,"_25194":58302,"_5":25527,"_17578":97294,"_23043":97295,"_2395":97296},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2868":58314,"_25194":58302,"_5":25527,"_17578":97298,"_23043":97299,"_2395":97300},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2868":58315,"_25194":58302,"_5":25527,"_17578":97302,"_23043":97303,"_2395":97304},[],"/docs/pr-preview/pr-39/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2868":58316,"_25194":58302,"_17578":97306,"_5":17474,"_23043":58302,"_2395":97307},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2868":58317,"_25194":58302,"_17578":97309,"_5":17474,"_23043":97263,"_2395":97310},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2868":58318,"_25194":58302,"_17578":97312,"_5":17474,"_23043":97267,"_2395":97313},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2868":58319,"_25194":58302,"_17578":97315,"_5":17474,"_23043":97271,"_2395":97316},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2868":58320,"_25194":58302,"_17578":97318,"_5":17474,"_23043":97275,"_2395":97319},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2868":58321,"_25194":58302,"_17578":97321,"_5":17474,"_23043":97279,"_2395":97322},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2868":58322,"_25194":58302,"_17578":97324,"_5":17474,"_23043":97283,"_2395":97325},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2868":58323,"_25194":58302,"_17578":97327,"_5":17474,"_23043":97283,"_2395":97328},[],"Ejecuta también la prueba de conectividad del chart:",{"_2868":58324,"_25194":58302,"_17578":97330,"_5":17474,"_23043":97283,"_2395":97331},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2868":58325,"_25194":58302,"_17578":97333,"_5":17474,"_23043":97283,"_2395":97334},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2868":58326,"_25194":58302,"_17578":97336,"_5":17474,"_23043":97287,"_2395":97337},[],"Si recibes un 401:",{"_2868":58327,"_25194":58302,"_17578":97339,"_5":17474,"_23043":97287,"_2395":97340},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2868":58328,"_25194":58302,"_17578":97342,"_5":17474,"_23043":97287,"_2395":97343},[],"verifica emisor, audiencia y expiración del token;",{"_2868":58329,"_25194":58302,"_17578":97345,"_5":17474,"_23043":97287,"_2395":97346},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2868":58330,"_25194":58302,"_17578":97348,"_5":17474,"_23043":97287,"_2395":97349},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2868":58331,"_25194":58302,"_17578":97351,"_5":17474,"_23043":97287,"_2395":97352},[],"Si el login termina pero las APIs devuelven 403:",{"_2868":58332,"_25194":58302,"_17578":97354,"_5":17474,"_23043":97287,"_2395":97355},[],"inspecciona los claims reales del token;",{"_2868":58333,"_25194":58302,"_17578":97357,"_5":17474,"_23043":97287,"_2395":97358},[],"confirma que coinciden con un principal activo;",{"_2868":58334,"_25194":58302,"_17578":97360,"_5":17474,"_23043":97287,"_2395":97361},[],"revisa las políticas concedidas al principal;",{"_2868":58335,"_25194":58302,"_17578":97363,"_5":17474,"_23043":97287,"_2395":97364},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2868":58336,"_25194":58302,"_17578":97366,"_5":17474,"_23043":97287,"_2395":97367},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2868":58337,"_25194":58302,"_17578":97369,"_5":17474,"_23043":97291,"_2395":97370},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2868":58338,"_25194":58302,"_17578":97372,"_5":17474,"_23043":97291,"_2395":97373},[],"Localiza el pod y Service de authz.",{"_2868":58339,"_25194":58302,"_17578":97375,"_5":17474,"_23043":97291,"_2395":97376},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2868":58340,"_25194":58302,"_17578":97378,"_5":17474,"_23043":97291,"_2395":97379},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2868":58341,"_25194":58302,"_17578":97381,"_5":17474,"_23043":97291,"_2395":97382},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2868":58342,"_25194":58302,"_17578":97384,"_5":17474,"_23043":97291,"_2395":97385},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2868":58343,"_25194":58302,"_17578":97387,"_5":17474,"_23043":97295,"_2395":97388},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2868":58344,"_25194":58302,"_17578":97390,"_5":17474,"_23043":97295,"_2395":97391},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2868":58345,"_25194":58302,"_17578":97393,"_5":17474,"_23043":97295,"_2395":97394},[],"volumen persistente sin enlazar;",{"_2868":58346,"_25194":58302,"_17578":97396,"_5":17474,"_23043":97295,"_2395":97397},[],"imagen inaccesible o política de pull incorrecta;",{"_2868":58347,"_25194":58302,"_17578":97399,"_5":17474,"_23043":97295,"_2395":97400},[],"configuración inválida del motor criptográfico;",{"_2868":58348,"_25194":58302,"_17578":97402,"_5":17474,"_23043":97295,"_2395":97403},[],"límites de CPU o memoria demasiado bajos;",{"_2868":58349,"_25194":58302,"_17578":97405,"_5":17474,"_23043":97295,"_2395":97406},[],"migración previa incompleta.",{"_2868":58350,"_25194":58302,"_17578":97408,"_5":17474,"_23043":97295,"_2395":97409},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2868":58351,"_25194":58302,"_17578":97411,"_5":17474,"_23043":97295,"_2395":97412},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2868":58352,"_25194":58302,"_17578":97414,"_5":17474,"_23043":97299,"_2395":97415},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2868":58353,"_25194":58302,"_17578":97417,"_5":17474,"_23043":97299,"_2395":97418},[],"verifica que esté habilitado en el servicio emisor;",{"_2868":58354,"_25194":58302,"_17578":97420,"_5":17474,"_23043":97299,"_2395":97421},[],"comprueba conectividad y credenciales AMQP;",{"_2868":58355,"_25194":58302,"_17578":97423,"_5":17474,"_23043":97299,"_2395":97424},[],"revisa exchange, routing key, colas y consumidores;",{"_2868":58356,"_25194":58302,"_17578":97426,"_5":17474,"_23043":97299,"_2395":97427},[],"inspecciona dead-letter queues;",{"_2868":58357,"_25194":58302,"_17578":97429,"_5":17474,"_23043":97299,"_2395":97430},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2868":58358,"_25194":58302,"_17578":97432,"_5":17474,"_23043":97299,"_2395":97433},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2868":58359,"_25194":58302,"_17578":97435,"_5":17474,"_23043":97303,"_2395":97436},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2868":58360,"_25194":58302,"_17578":97438,"_5":17474,"_23043":97303,"_2395":97439},[],"Antes de cerrar una incidencia, guarda:",{"_2868":58361,"_25194":58302,"_17578":97441,"_5":17474,"_23043":97303,"_2395":97442},[],"causa confirmada;",{"_2868":58362,"_25194":58302,"_17578":97444,"_5":17474,"_23043":97303,"_2395":97445},[],"alcance temporal y recursos afectados;",{"_2868":58363,"_25194":58302,"_17578":97447,"_5":17474,"_23043":97303,"_2395":97448},[],"comandos o consultas utilizados;",{"_2868":58364,"_25194":58302,"_17578":97450,"_5":17474,"_23043":97303,"_2395":97451},[],"cambio aplicado y forma de revertirlo;",{"_2868":58365,"_25194":58302,"_17578":97453,"_5":17474,"_23043":97303,"_2395":97454},[],"validación desde un consumidor;",{"_2868":58366,"_25194":58302,"_17578":97456,"_5":17474,"_23043":97303,"_2395":97457},[],"acción preventiva y propietario.",{"_2868":58367,"_25194":58367,"_5":12321,"_2395":97459,"_25530":97460,"_17578":97463,"_23043":58367},"Control de acceso",[40934,97461,97462],"Plataforma","Administración",[],{"_2868":58368,"_25194":58367,"_17578":97465,"_5":17474,"_23043":58367,"_2395":97466},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2868":58369,"_25194":58367,"_5":25527,"_17578":97468,"_23043":97469,"_2395":97470},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2868":58370,"_25194":58367,"_5":25527,"_17578":97472,"_23043":97473,"_2395":97474},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2868":58371,"_25194":58367,"_5":25527,"_17578":97476,"_23043":97477,"_2395":97478},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2868":58372,"_25194":58367,"_5":25527,"_17578":97480,"_23043":97481,"_2395":97482},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2868":58373,"_25194":58367,"_5":25527,"_17578":97484,"_23043":97485,"_2395":97486},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2868":58374,"_25194":58367,"_5":25527,"_17578":97488,"_23043":97489,"_2395":97490},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2868":58375,"_25194":58367,"_5":25527,"_17578":97492,"_23043":97493,"_2395":97494},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2868":58376,"_25194":58367,"_5":25527,"_17578":97496,"_23043":97497,"_2395":97498},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2868":58377,"_25194":58367,"_5":25527,"_17578":97500,"_23043":97501,"_2395":97502},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2868":58378,"_25194":58367,"_5":25527,"_17578":97504,"_23043":97505,"_2395":97506},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2868":58379,"_25194":58367,"_5":25527,"_17578":97508,"_23043":97509,"_2395":97510},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2868":58380,"_25194":58367,"_5":25527,"_17578":97512,"_23043":97513,"_2395":97514},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2868":58381,"_25194":58367,"_5":25527,"_17578":97516,"_23043":97517,"_2395":97518},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2868":58382,"_25194":58367,"_5":25527,"_17578":97520,"_23043":97521,"_2395":97522},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2868":58383,"_25194":58367,"_5":25527,"_17578":97524,"_23043":97525,"_2395":97526},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2868":58384,"_25194":58367,"_5":25527,"_17578":97528,"_23043":97529,"_2395":96723},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2868":58385,"_25194":58367,"_5":25527,"_17578":97531,"_23043":97532,"_2395":97533},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2868":58386,"_25194":58367,"_5":25527,"_17578":97535,"_23043":97536,"_2395":97537},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2868":58387,"_25194":58367,"_5":25527,"_17578":97539,"_23043":97540,"_2395":97541},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2868":58388,"_25194":58367,"_5":25527,"_17578":97543,"_23043":97544,"_2395":97545},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2868":58389,"_25194":58367,"_5":25527,"_17578":97547,"_23043":97548,"_2395":97549},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2868":58390,"_25194":58367,"_5":25527,"_17578":97551,"_23043":97552,"_2395":97553},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2868":58391,"_25194":58367,"_5":25527,"_17578":97555,"_23043":97556,"_2395":97557},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2868":58392,"_25194":58367,"_5":25527,"_17578":97559,"_23043":97560,"_2395":97561},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2868":58393,"_25194":58367,"_5":25527,"_17578":97563,"_23043":97564,"_2395":97565},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2868":58394,"_25194":58367,"_5":25527,"_17578":97567,"_23043":97568,"_2395":97569},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2868":58395,"_25194":58367,"_5":25527,"_17578":97571,"_23043":97572,"_2395":97573},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2868":58396,"_25194":58367,"_5":25527,"_17578":97575,"_23043":97576,"_2395":97577},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2868":58397,"_25194":58367,"_5":25527,"_17578":97579,"_23043":97580,"_2395":97581},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2868":58398,"_25194":58367,"_5":25527,"_17578":97583,"_23043":97584,"_2395":97585},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2868":58399,"_25194":58367,"_5":25527,"_17578":97587,"_23043":97588,"_2395":97589},[],"/docs/pr-preview/pr-39/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2868":58400,"_25194":58367,"_17578":97591,"_5":17474,"_23043":58367,"_2395":97592},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2868":58401,"_25194":58367,"_17578":97594,"_5":17474,"_23043":58367,"_2395":97595},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2868":58402,"_25194":58367,"_17578":97597,"_5":17474,"_23043":58367,"_2395":97598},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2868":58403,"_25194":58367,"_17578":97600,"_5":17474,"_23043":97469,"_2395":97601},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2868":58404,"_25194":58367,"_17578":97603,"_5":17474,"_23043":97469,"_2395":97604},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2868":58405,"_25194":58367,"_17578":97606,"_5":17474,"_23043":97469,"_2395":97607},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2868":58406,"_25194":58367,"_17578":97609,"_5":17474,"_23043":97469,"_2395":97610},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2868":58407,"_25194":58367,"_17578":97612,"_5":17474,"_23043":97469,"_2395":97613},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2868":58408,"_25194":58367,"_17578":97615,"_5":17474,"_23043":97469,"_2395":97616},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2868":58409,"_25194":58367,"_17578":97618,"_5":17474,"_23043":97473,"_2395":97619},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2868":58410,"_25194":58367,"_17578":97621,"_5":17474,"_23043":97473,"_2395":97622},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2868":58411,"_25194":58367,"_17578":97624,"_5":17474,"_23043":97477,"_2395":97625},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2868":58412,"_25194":58367,"_17578":97627,"_5":17474,"_23043":97477,"_2395":97628},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2868":58413,"_25194":58367,"_17578":97630,"_5":17474,"_23043":97477,"_2395":97631},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2868":58414,"_25194":58367,"_17578":97633,"_5":17474,"_23043":97477,"_2395":97634},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2868":58415,"_25194":58367,"_17578":97636,"_5":17474,"_23043":97477,"_2395":97637},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2868":58416,"_25194":58367,"_17578":97639,"_5":17474,"_23043":97477,"_2395":97640},[],"Carga por separado las políticas concedidas a cada principal.",{"_2868":58417,"_25194":58367,"_17578":97642,"_5":17474,"_23043":97477,"_2395":97643},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2868":58418,"_25194":58367,"_17578":97645,"_5":17474,"_23043":97477,"_2395":97646},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2868":58419,"_25194":58367,"_17578":97648,"_5":17474,"_23043":97477,"_2395":97649},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2868":58420,"_25194":58367,"_17578":97651,"_5":17474,"_23043":97477,"_2395":97652},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2868":58421,"_25194":58367,"_17578":97654,"_5":17474,"_23043":97477,"_2395":97655},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2868":58422,"_25194":58367,"_17578":97657,"_5":17474,"_23043":97477,"_2395":97658},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2868":58423,"_25194":58367,"_17578":97660,"_5":17474,"_23043":97481,"_2395":97661},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2868":58424,"_25194":58367,"_17578":97663,"_5":17474,"_23043":97481,"_2395":97664},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2868":58425,"_25194":58367,"_17578":97666,"_5":17474,"_23043":97481,"_2395":97667},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2868":58426,"_25194":58367,"_17578":97669,"_5":17474,"_23043":97481,"_2395":97670},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2868":58427,"_25194":58367,"_17578":97672,"_5":17474,"_23043":97481,"_2395":97673},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2868":58428,"_25194":58367,"_17578":97675,"_5":17474,"_23043":97481,"_2395":97676},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2868":58429,"_25194":58367,"_17578":97678,"_5":17474,"_23043":97481,"_2395":97679},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2868":58430,"_25194":58367,"_17578":97681,"_5":17474,"_23043":97481,"_2395":97682},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2868":58431,"_25194":58367,"_17578":97684,"_5":17474,"_23043":97485,"_2395":97685},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2868":58432,"_25194":58367,"_17578":97687,"_5":17474,"_23043":97485,"_2395":97688},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2868":58433,"_25194":58367,"_17578":97690,"_5":17474,"_23043":97485,"_2395":97691},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2868":58434,"_25194":58367,"_17578":97693,"_5":17474,"_23043":97485,"_2395":97694},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2868":58435,"_25194":58367,"_17578":97696,"_5":17474,"_23043":97485,"_2395":97697},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2868":58436,"_25194":58367,"_17578":97699,"_5":17474,"_23043":97485,"_2395":97700},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2868":58437,"_25194":58367,"_17578":97702,"_5":17474,"_23043":97485,"_2395":97703},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2868":58438,"_25194":58367,"_17578":97705,"_5":17474,"_23043":97485,"_2395":97706},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2868":58439,"_25194":58367,"_17578":97708,"_5":17474,"_23043":97485,"_2395":97709},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2868":58440,"_25194":58367,"_17578":97711,"_5":17474,"_23043":97485,"_2395":97712},[],"Las acciones se dividen en dos grupos:",{"_2868":58441,"_25194":58367,"_17578":97714,"_5":17474,"_23043":97485,"_2395":97715},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2868":58442,"_25194":58367,"_17578":97717,"_5":17474,"_23043":97485,"_2395":97718},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2868":58443,"_25194":58367,"_17578":97720,"_5":17474,"_23043":97485,"_2395":97721},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2868":58444,"_25194":58367,"_17578":97723,"_5":17474,"_23043":97489,"_2395":97724},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2868":58445,"_25194":58367,"_17578":97726,"_5":17474,"_23043":97489,"_2395":97727},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2868":58446,"_25194":58367,"_17578":97729,"_5":17474,"_23043":97489,"_2395":97730},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2868":58447,"_25194":58367,"_17578":97732,"_5":17474,"_23043":97493,"_2395":97733},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2868":58448,"_25194":58367,"_17578":97735,"_5":17474,"_23043":97493,"_2395":97736},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2868":58449,"_25194":58367,"_17578":97738,"_5":17474,"_23043":97493,"_2395":97739},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2868":58450,"_25194":58367,"_17578":97741,"_5":17474,"_23043":97493,"_2395":97742},[],"Los operadores implementados son:",{"_2868":58451,"_25194":58367,"_17578":97744,"_5":17474,"_23043":97493,"_2395":97745},[],"`equals`, para igualdad exacta;",{"_2868":58452,"_25194":58367,"_17578":97747,"_5":17474,"_23043":97493,"_2395":97748},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2868":58453,"_25194":58367,"_17578":97750,"_5":17474,"_23043":97493,"_2395":97751},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2868":58454,"_25194":58367,"_17578":97753,"_5":17474,"_23043":97493,"_2395":97754},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2868":58455,"_25194":58367,"_17578":97756,"_5":17474,"_23043":97497,"_2395":97757},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2868":58456,"_25194":58367,"_17578":97759,"_5":17474,"_23043":97497,"_2395":97760},[],"Los modos disponibles son:",{"_2868":58457,"_25194":58367,"_17578":97762,"_5":17474,"_23043":97497,"_2395":97763},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2868":58458,"_25194":58367,"_17578":97765,"_5":17474,"_23043":97497,"_2395":97766},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2868":58459,"_25194":58367,"_17578":97768,"_5":17474,"_23043":97497,"_2395":97769},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2868":58460,"_25194":58367,"_17578":97771,"_5":17474,"_23043":97497,"_2395":97772},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2868":58461,"_25194":58367,"_17578":97774,"_5":17474,"_23043":97497,"_2395":97775},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2868":58462,"_25194":58367,"_17578":97777,"_5":17474,"_23043":97497,"_2395":97778},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2868":58463,"_25194":58367,"_17578":97780,"_5":17474,"_23043":97501,"_2395":97781},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2868":58464,"_25194":58367,"_17578":97783,"_5":17474,"_23043":97501,"_2395":97784},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2868":58465,"_25194":58367,"_17578":97786,"_5":17474,"_23043":97501,"_2395":97787},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2868":58466,"_25194":58367,"_17578":97789,"_5":17474,"_23043":97501,"_2395":97790},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2868":58467,"_25194":58367,"_17578":97792,"_5":17474,"_23043":97509,"_2395":97793},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2868":58468,"_25194":58367,"_17578":97795,"_5":17474,"_23043":97509,"_2395":97796},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2868":58469,"_25194":58367,"_17578":97798,"_5":17474,"_23043":97513,"_2395":97799},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2868":58470,"_25194":58367,"_17578":97801,"_5":17474,"_23043":97513,"_2395":97802},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2868":58471,"_25194":58367,"_17578":97804,"_5":17474,"_23043":97517,"_2395":97805},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2868":58472,"_25194":58367,"_17578":97807,"_5":17474,"_23043":97517,"_2395":97808},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2868":58473,"_25194":58367,"_17578":97810,"_5":17474,"_23043":97517,"_2395":97811},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2868":58474,"_25194":58367,"_17578":97813,"_5":17474,"_23043":97521,"_2395":97814},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2868":58475,"_25194":58367,"_17578":97816,"_5":17474,"_23043":97521,"_2395":97817},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2868":58476,"_25194":58367,"_17578":97819,"_5":17474,"_23043":97521,"_2395":97820},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2868":58477,"_25194":58367,"_17578":97822,"_5":17474,"_23043":97521,"_2395":97823},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2868":58478,"_25194":58367,"_17578":97825,"_5":17474,"_23043":97521,"_2395":97826},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2868":58479,"_25194":58367,"_17578":97828,"_5":17474,"_23043":97521,"_2395":97829},[],"Ten en cuenta que:",{"_2868":58480,"_25194":58367,"_17578":97831,"_5":17474,"_23043":97521,"_2395":97832},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2868":58481,"_25194":58367,"_17578":97834,"_5":17474,"_23043":97521,"_2395":97835},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2868":58482,"_25194":58367,"_17578":97837,"_5":17474,"_23043":97521,"_2395":97838},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2868":58483,"_25194":58367,"_17578":97840,"_5":17474,"_23043":97525,"_2395":97841},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2868":58484,"_25194":58367,"_17578":97843,"_5":17474,"_23043":97525,"_2395":97844},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2868":58485,"_25194":58367,"_17578":97846,"_5":17474,"_23043":97525,"_2395":97847},[],"acceso completo y de solo lectura a KMS;",{"_2868":58486,"_25194":58367,"_17578":97849,"_5":17474,"_23043":97525,"_2395":97850},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2868":58487,"_25194":58367,"_17578":97852,"_5":17474,"_23043":97525,"_2395":97853},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2868":58488,"_25194":58367,"_17578":97855,"_5":17474,"_23043":97525,"_2395":97856},[],"acceso a la interfaz;",{"_2868":58489,"_25194":58367,"_17578":97858,"_5":17474,"_23043":97525,"_2395":97859},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2868":58490,"_25194":58367,"_17578":97861,"_5":17474,"_23043":97525,"_2395":97862},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2868":58491,"_25194":58367,"_17578":97864,"_5":17474,"_23043":97525,"_2395":97865},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2868":58492,"_25194":58367,"_17578":97867,"_5":17474,"_23043":97529,"_2395":97868},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2868":58493,"_25194":58367,"_17578":97870,"_5":17474,"_23043":97529,"_2395":97871},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2868":58494,"_25194":58367,"_17578":97873,"_5":17474,"_23043":97529,"_2395":97874},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2868":58495,"_25194":58367,"_17578":97876,"_5":17474,"_23043":97532,"_2395":97877},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2868":58496,"_25194":58367,"_17578":97879,"_5":17474,"_23043":97536,"_2395":97880},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2868":58497,"_25194":58367,"_17578":97882,"_5":17474,"_23043":97540,"_2395":97883},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2868":58498,"_25194":58367,"_17578":97885,"_5":17474,"_23043":97544,"_2395":97886},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2868":58499,"_25194":58367,"_17578":97888,"_5":17474,"_23043":97548,"_2395":97889},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2868":58500,"_25194":58367,"_17578":97891,"_5":17474,"_23043":97552,"_2395":97892},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2868":58501,"_25194":58367,"_17578":97894,"_5":17474,"_23043":97552,"_2395":97895},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2868":58502,"_25194":58367,"_17578":97897,"_5":17474,"_23043":97556,"_2395":97898},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2868":58503,"_25194":58367,"_17578":97900,"_5":17474,"_23043":97556,"_2395":97901},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2868":58504,"_25194":58367,"_17578":97903,"_5":17474,"_23043":97556,"_2395":97904},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2868":58505,"_25194":58367,"_17578":97906,"_5":17474,"_23043":97556,"_2395":97907},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2868":58506,"_25194":58367,"_17578":97909,"_5":17474,"_23043":97556,"_2395":97910},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2868":58507,"_25194":58367,"_17578":97912,"_5":17474,"_23043":97556,"_2395":97913},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2868":58508,"_25194":58367,"_17578":97915,"_5":17474,"_23043":97556,"_2395":97916},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2868":58509,"_25194":58367,"_17578":97918,"_5":17474,"_23043":97556,"_2395":97919},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2868":58510,"_25194":58367,"_17578":97921,"_5":17474,"_23043":97560,"_2395":97922},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2868":58511,"_25194":58367,"_17578":97924,"_5":17474,"_23043":97560,"_2395":97925},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2868":58512,"_25194":58367,"_17578":97927,"_5":17474,"_23043":97560,"_2395":97928},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2868":58513,"_25194":58367,"_17578":97930,"_5":17474,"_23043":97564,"_2395":97931},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2868":58514,"_25194":58367,"_17578":97933,"_5":17474,"_23043":97564,"_2395":97934},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2868":58515,"_25194":58367,"_17578":97936,"_5":17474,"_23043":97564,"_2395":97937},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2868":58516,"_25194":58367,"_17578":97939,"_5":17474,"_23043":97564,"_2395":97940},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2868":58517,"_25194":58367,"_17578":97942,"_5":17474,"_23043":97564,"_2395":97943},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2868":58518,"_25194":58367,"_17578":97945,"_5":17474,"_23043":97564,"_2395":97946},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2868":58519,"_25194":58367,"_17578":97948,"_5":17474,"_23043":97564,"_2395":97949},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2868":58520,"_25194":58367,"_17578":97951,"_5":17474,"_23043":97564,"_2395":97952},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2868":58521,"_25194":58367,"_17578":97954,"_5":17474,"_23043":97572,"_2395":97955},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2868":58522,"_25194":58367,"_17578":97957,"_5":17474,"_23043":97576,"_2395":97958},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2868":58523,"_25194":58367,"_17578":97960,"_5":17474,"_23043":97576,"_2395":97961},[],"que exista un principal activo del tipo correcto;",{"_2868":58524,"_25194":58367,"_17578":97963,"_5":17474,"_23043":97576,"_2395":97964},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2868":58525,"_25194":58367,"_17578":97966,"_5":17474,"_23043":97576,"_2395":97967},[],"que todas las condiciones del principal se cumplan;",{"_2868":58526,"_25194":58367,"_17578":97969,"_5":17474,"_23043":97576,"_2395":97970},[],"que el principal tenga concedida la política esperada;",{"_2868":58527,"_25194":58367,"_17578":97972,"_5":17474,"_23043":97576,"_2395":97973},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2868":58528,"_25194":58367,"_17578":97975,"_5":17474,"_23043":97576,"_2395":97976},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2868":58529,"_25194":58367,"_17578":97978,"_5":17474,"_23043":97576,"_2395":97979},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2868":58530,"_25194":58367,"_17578":97981,"_5":17474,"_23043":97580,"_2395":97982},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2868":58531,"_25194":58367,"_17578":97984,"_5":17474,"_23043":97584,"_2395":97985},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2868":58532,"_25194":58367,"_17578":97987,"_5":17474,"_23043":97588,"_2395":97988},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2868":58533,"_25194":58367,"_17578":97990,"_5":17474,"_23043":97588,"_2395":97991},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2868":58534,"_25194":58534,"_5":12321,"_2395":97993,"_25530":97994,"_17578":97995,"_23043":58534},"Alertas y suscripciones",[40934,97461,97462],[],{"_2868":58535,"_25194":58534,"_17578":97997,"_5":17474,"_23043":58534,"_2395":97998},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2868":58536,"_25194":58534,"_5":25527,"_17578":98000,"_23043":98001,"_2395":98002},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2868":58537,"_25194":58534,"_5":25527,"_17578":98004,"_23043":98005,"_2395":98006},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2868":58538,"_25194":58534,"_5":25527,"_17578":98008,"_23043":98009,"_2395":98010},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2868":58539,"_25194":58534,"_5":25527,"_17578":98012,"_23043":98013,"_2395":98014},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2868":58540,"_25194":58534,"_5":25527,"_17578":98016,"_23043":98017,"_2395":98018},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2868":58541,"_25194":58534,"_5":25527,"_17578":98020,"_23043":98021,"_2395":98022},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2868":58542,"_25194":58534,"_5":25527,"_17578":98024,"_23043":98025,"_2395":98026},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2868":58543,"_25194":58534,"_5":25527,"_17578":98028,"_23043":98029,"_2395":98030},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_2868":58544,"_25194":58534,"_5":25527,"_17578":98032,"_23043":98033,"_2395":98034},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2868":58545,"_25194":58534,"_5":25527,"_17578":98036,"_23043":98037,"_2395":98038},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2868":58546,"_25194":58534,"_5":25527,"_17578":98040,"_23043":98041,"_2395":98042},[],"/docs/pr-preview/pr-39/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2868":58547,"_25194":58534,"_17578":98044,"_5":17474,"_23043":58534,"_2395":98045},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2868":58548,"_25194":58534,"_17578":98047,"_5":17474,"_23043":98001,"_2395":98048},[],"Un servicio publica un evento de dominio.",{"_2868":58549,"_25194":58534,"_17578":98050,"_5":17474,"_23043":98001,"_2395":98051},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2868":58550,"_25194":58534,"_17578":98053,"_5":17474,"_23043":98001,"_2395":98054},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2868":58551,"_25194":58534,"_17578":98056,"_5":17474,"_23043":98001,"_2395":98057},[],"Lamassu entrega el evento al canal configurado.",{"_2868":58552,"_25194":58534,"_17578":98059,"_5":17474,"_23043":98001,"_2395":98060},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2868":58553,"_25194":58534,"_17578":98062,"_5":17474,"_23043":98005,"_2395":98063},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2868":58554,"_25194":58534,"_17578":98065,"_5":17474,"_23043":98005,"_2395":98066},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2868":58555,"_25194":58534,"_17578":98068,"_5":17474,"_23043":98005,"_2395":98069},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2868":58556,"_25194":58534,"_17578":98071,"_5":17474,"_23043":98005,"_2395":98072},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2868":58557,"_25194":58534,"_17578":98074,"_5":17474,"_23043":98005,"_2395":98075},[],"`apikey_options` necesita `header` y `key`.",{"_2868":58558,"_25194":58534,"_17578":98077,"_5":17474,"_23043":98005,"_2395":98078},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2868":58559,"_25194":58534,"_17578":98080,"_5":17474,"_23043":98005,"_2395":98081},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2868":58560,"_25194":58534,"_17578":98083,"_5":17474,"_23043":98005,"_2395":98084},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2868":58561,"_25194":58534,"_17578":98086,"_5":17474,"_23043":98013,"_2395":98087},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2868":58562,"_25194":58534,"_17578":98089,"_5":17474,"_23043":98017,"_2395":98090},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2868":58563,"_25194":58534,"_17578":98092,"_5":17474,"_23043":98021,"_2395":98093},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2868":58564,"_25194":58534,"_17578":98095,"_5":17474,"_23043":98021,"_2395":98096},[],"**None** notifica todas las instancias del evento.",{"_2868":58565,"_25194":58534,"_17578":98098,"_5":17474,"_23043":98021,"_2395":98099},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2868":58566,"_25194":58534,"_17578":98101,"_5":17474,"_23043":98021,"_2395":98102},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2868":58567,"_25194":58534,"_17578":98104,"_5":17474,"_23043":98021,"_2395":98105},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2868":58568,"_25194":58534,"_17578":98107,"_5":17474,"_23043":98021,"_2395":98108},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2868":58569,"_25194":58534,"_17578":98110,"_5":17474,"_23043":98025,"_2395":98111},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2868":58570,"_25194":58534,"_17578":98113,"_5":17474,"_23043":98029,"_2395":98114},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_2868":58571,"_25194":58534,"_17578":98116,"_5":17474,"_23043":98029,"_2395":98117},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_2868":58572,"_25194":58534,"_17578":98119,"_5":17474,"_23043":98029,"_2395":98120},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_2868":58573,"_25194":58534,"_17578":98122,"_5":17474,"_23043":98029,"_2395":98123},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_2868":58574,"_25194":58534,"_17578":98125,"_5":17474,"_23043":98029,"_2395":98126},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_2868":58575,"_25194":58534,"_17578":98128,"_5":17474,"_23043":98029,"_2395":98129},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_2868":58576,"_25194":58534,"_17578":98131,"_5":17474,"_23043":98029,"_2395":98132},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_2868":58577,"_25194":58534,"_17578":98134,"_5":17474,"_23043":98029,"_2395":98135},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_2868":58578,"_25194":58534,"_17578":98137,"_5":17474,"_23043":98033,"_2395":98138},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2868":58579,"_25194":58534,"_17578":98140,"_5":17474,"_23043":98033,"_2395":98141},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2868":58580,"_25194":58534,"_17578":98143,"_5":17474,"_23043":98033,"_2395":98144},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2868":58581,"_25194":58534,"_17578":98146,"_5":17474,"_23043":98033,"_2395":98147},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2868":58582,"_25194":58534,"_17578":98149,"_5":17474,"_23043":98033,"_2395":98150},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2868":58583,"_25194":58534,"_17578":98152,"_5":17474,"_23043":98033,"_2395":98153},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2868":58584,"_25194":58534,"_17578":98155,"_5":17474,"_23043":98033,"_2395":98156},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2868":58585,"_25194":58534,"_17578":98158,"_5":17474,"_23043":98033,"_2395":98159},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2868":58586,"_25194":58534,"_17578":98161,"_5":17474,"_23043":98037,"_2395":98162},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2868":58587,"_25194":58534,"_17578":98164,"_5":17474,"_23043":98037,"_2395":98165},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_2868":58588,"_25194":58534,"_17578":98167,"_5":17474,"_23043":98041,"_2395":98168},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2868":58589,"_25194":58534,"_17578":98170,"_5":17474,"_23043":98041,"_2395":98171},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2868":58590,"_25194":58534,"_17578":98173,"_5":17474,"_23043":98041,"_2395":98174},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2868":58591,"_25194":58534,"_17578":98176,"_5":17474,"_23043":98041,"_2395":98177},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2868":58592,"_25194":58534,"_17578":98179,"_5":17474,"_23043":98041,"_2395":98180},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2868":58593,"_25194":58534,"_17578":98182,"_5":17474,"_23043":98041,"_2395":98183},[],"**Validación:** `va.role.crl.create`.",{"_2868":58594,"_25194":58534,"_17578":98185,"_5":17474,"_23043":98041,"_2395":98186},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2868":58595,"_25194":58534,"_17578":98188,"_5":17474,"_23043":98041,"_2395":98189},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2868":58596,"_25194":58596,"_5":12321,"_2395":98191,"_25530":98192,"_17578":98193,"_23043":58596},"Registros de auditoría",[40934,97461,97462],[],{"_2868":58597,"_25194":58596,"_17578":98195,"_5":17474,"_23043":58596,"_2395":98196},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2868":58598,"_25194":58596,"_5":25527,"_17578":98198,"_23043":98199,"_2395":98200},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2868":58599,"_25194":58596,"_5":25527,"_17578":98202,"_23043":98203,"_2395":98204},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2868":58600,"_25194":58596,"_5":25527,"_17578":98206,"_23043":98207,"_2395":98208},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2868":58601,"_25194":58596,"_5":25527,"_17578":98210,"_23043":98211,"_2395":98212},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2868":58602,"_25194":58596,"_5":25527,"_17578":98214,"_23043":98215,"_2395":98216},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2868":58603,"_25194":58596,"_5":25527,"_17578":98218,"_23043":98219,"_2395":98220},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2868":58604,"_25194":58596,"_5":25527,"_17578":98222,"_23043":98223,"_2395":98224},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2868":58605,"_25194":58596,"_5":25527,"_17578":98226,"_23043":98227,"_2395":98228},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2868":58606,"_25194":58596,"_5":25527,"_17578":98230,"_23043":98231,"_2395":98232},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2868":58607,"_25194":58596,"_5":25527,"_17578":98234,"_23043":98235,"_2395":98236},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2868":58608,"_25194":58596,"_5":25527,"_17578":98238,"_23043":98239,"_2395":98240},[],"/docs/pr-preview/pr-39/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2868":58609,"_25194":58596,"_17578":98242,"_5":17474,"_23043":58596,"_2395":98243},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2868":58610,"_25194":58596,"_17578":98245,"_5":17474,"_23043":98199,"_2395":98246},[],"El cuerpo de auditoría incluye:",{"_2868":58611,"_25194":58596,"_17578":98248,"_5":17474,"_23043":98199,"_2395":98249},[],"input: datos recibidos por la operación;",{"_2868":58612,"_25194":58596,"_17578":98251,"_5":17474,"_23043":98199,"_2395":98252},[],"has\\_error: indica si el servicio devolvió un error;",{"_2868":58613,"_25194":58596,"_17578":98254,"_5":17474,"_23043":98199,"_2395":98255},[],"output: resultado producido o mensaje de error;",{"_2868":58614,"_25194":58596,"_17578":98257,"_5":17474,"_23043":98199,"_2395":98258},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2868":58615,"_25194":58596,"_17578":98260,"_5":17474,"_23043":98199,"_2395":98261},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2868":58616,"_25194":58596,"_17578":98263,"_5":17474,"_23043":98199,"_2395":98264},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2868":58617,"_25194":58596,"_17578":98266,"_5":17474,"_23043":98203,"_2395":98267},[],"El backend aplica auditoría a mutaciones de:",{"_2868":58618,"_25194":58596,"_17578":98269,"_5":17474,"_23043":98203,"_2395":98270},[],"autoridades, certificados y perfiles de emisión;",{"_2868":58619,"_25194":58596,"_17578":98272,"_5":17474,"_23043":98203,"_2395":98273},[],"claves y motores KMS;",{"_2868":58620,"_25194":58596,"_17578":98275,"_5":17474,"_23043":98203,"_2395":98276},[],"dispositivos e identidades;",{"_2868":58621,"_25194":58596,"_17578":98278,"_5":17474,"_23043":98203,"_2395":98279},[],"DMS y operaciones de enrolamiento;",{"_2868":58622,"_25194":58596,"_17578":98281,"_5":17474,"_23043":98203,"_2395":98282},[],"funciones de validación y CRL;",{"_2868":58623,"_25194":58596,"_17578":98284,"_5":17474,"_23043":98203,"_2395":98285},[],"principales, políticas y concesiones de autorización.",{"_2868":58624,"_25194":58596,"_17578":98287,"_5":17474,"_23043":98203,"_2395":98288},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2868":58625,"_25194":58596,"_17578":98290,"_5":17474,"_23043":98207,"_2395":98291},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2868":58626,"_25194":58596,"_17578":98293,"_5":17474,"_23043":98207,"_2395":98294},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2868":58627,"_25194":58596,"_17578":98296,"_5":17474,"_23043":98207,"_2395":98297},[],"Diseña el consumidor para:",{"_2868":58628,"_25194":58596,"_17578":98299,"_5":17474,"_23043":98207,"_2395":98300},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2868":58629,"_25194":58596,"_17578":98302,"_5":17474,"_23043":98207,"_2395":98303},[],"conservar el CloudEvent completo sin modificar;",{"_2868":58630,"_25194":58596,"_17578":98305,"_5":17474,"_23043":98207,"_2395":98306},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2868":58631,"_25194":58596,"_17578":98308,"_5":17474,"_23043":98207,"_2395":98309},[],"cifrar en tránsito y en reposo;",{"_2868":58632,"_25194":58596,"_17578":98311,"_5":17474,"_23043":98207,"_2395":98312},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2868":58633,"_25194":58596,"_17578":98314,"_5":17474,"_23043":98207,"_2395":98315},[],"aplicar una política explícita de retención y legal hold;",{"_2868":58634,"_25194":58596,"_17578":98317,"_5":17474,"_23043":98207,"_2395":98318},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2868":58635,"_25194":58596,"_17578":98320,"_5":17474,"_23043":98211,"_2395":98321},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2868":58636,"_25194":58596,"_17578":98323,"_5":17474,"_23043":98211,"_2395":98324},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2868":58637,"_25194":58596,"_17578":98326,"_5":17474,"_23043":98219,"_2395":98327},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2868":58638,"_25194":58596,"_17578":98329,"_5":17474,"_23043":98223,"_2395":98330},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2868":58639,"_25194":58596,"_17578":98332,"_5":17474,"_23043":98227,"_2395":98333},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2868":58640,"_25194":58596,"_17578":98335,"_5":17474,"_23043":98231,"_2395":98336},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2868":58641,"_25194":58596,"_17578":98338,"_5":17474,"_23043":98235,"_2395":98339},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2868":58642,"_25194":58596,"_17578":98341,"_5":17474,"_23043":98239,"_2395":98342},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2868":58643,"_25194":58596,"_17578":98344,"_5":17474,"_23043":98239,"_2395":98345},[],"aparece un evento de auditoría correcto;",{"_2868":58644,"_25194":58596,"_17578":98347,"_5":17474,"_23043":98239,"_2395":98348},[],"el principal coincide con la identidad utilizada;",{"_2868":58645,"_25194":58596,"_17578":98350,"_5":17474,"_23043":98239,"_2395":98351},[],"el consumidor lo persiste una sola vez;",{"_2868":58646,"_25194":58596,"_17578":98353,"_5":17474,"_23043":98239,"_2395":98354},[],"puede recuperarse por recurso, actor y periodo;",{"_2868":58647,"_25194":58596,"_17578":98356,"_5":17474,"_23043":98239,"_2395":98357},[],"una interrupción del consumidor produce una alerta.",{"_2868":58648,"_25194":58596,"_17578":98359,"_5":17474,"_23043":98239,"_2395":98360},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2868":58649,"_25194":58649,"_5":12321,"_2395":98362,"_25530":98363,"_17578":98364,"_23043":58649},"Arquitectura de la plataforma",[40934,97461],[],{"_2868":58650,"_25194":58649,"_17578":98366,"_5":17474,"_23043":58649,"_2395":98367},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2868":58651,"_25194":58649,"_5":25527,"_17578":98369,"_23043":98370,"_2395":98371},[],"/docs/pr-preview/pr-39/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2868":58652,"_25194":58649,"_5":25527,"_17578":98373,"_23043":98374,"_2395":98375},[],"/docs/pr-preview/pr-39/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2868":58653,"_25194":58649,"_5":25527,"_17578":98377,"_23043":98378,"_2395":98379},[],"/docs/pr-preview/pr-39/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2868":58654,"_25194":58649,"_5":25527,"_17578":98381,"_23043":98382,"_2395":98383},[],"/docs/pr-preview/pr-39/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2868":58655,"_25194":58649,"_5":25527,"_17578":98385,"_23043":98386,"_2395":98387},[],"/docs/pr-preview/pr-39/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2868":58656,"_25194":58649,"_17578":98389,"_5":17474,"_23043":58649,"_2395":98390},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2868":58657,"_25194":58649,"_17578":98392,"_5":17474,"_23043":58649,"_2395":98393},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2868":58658,"_25194":58649,"_17578":98395,"_5":17474,"_23043":98370,"_2395":98396},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2868":58659,"_25194":58649,"_17578":98398,"_5":17474,"_23043":98374,"_2395":98399},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2868":58660,"_25194":58649,"_17578":98401,"_5":17474,"_23043":98378,"_2395":98402},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2868":58661,"_25194":58649,"_17578":98404,"_5":17474,"_23043":98382,"_2395":98405},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2868":58662,"_25194":58649,"_17578":98407,"_5":17474,"_23043":98386,"_2395":98408},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2868":58663,"_25194":58663,"_5":12321,"_2395":98410,"_25530":98411,"_17578":98412,"_23043":58663},"Cómo funciona Lamassu",[40934,97461],[],{"_2868":58664,"_25194":58663,"_17578":98414,"_5":17474,"_23043":58663,"_2395":98415},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2868":58665,"_25194":58663,"_5":25527,"_17578":98417,"_23043":98418,"_2395":98419},[],"/docs/pr-preview/pr-39/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2868":58666,"_25194":58663,"_5":25527,"_17578":98421,"_23043":98422,"_2395":98423},[],"/docs/pr-preview/pr-39/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2868":58667,"_25194":58663,"_17578":98425,"_5":17474,"_23043":58663,"_2395":98426},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2868":58668,"_25194":58663,"_17578":98428,"_5":17474,"_23043":98418,"_2395":98429},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2868":58669,"_25194":58663,"_17578":98431,"_5":17474,"_23043":98418,"_2395":98432},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2868":58670,"_25194":58663,"_17578":98434,"_5":17474,"_23043":98418,"_2395":98435},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2868":58671,"_25194":58663,"_17578":98437,"_5":17474,"_23043":98418,"_2395":98438},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2868":58672,"_25194":58663,"_17578":98440,"_5":17474,"_23043":98418,"_2395":98441},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2868":58673,"_25194":58663,"_17578":98443,"_5":17474,"_23043":98422,"_2395":98444},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2868":58674,"_25194":58663,"_17578":98446,"_5":17474,"_23043":98422,"_2395":98447},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2868":58675,"_25194":58663,"_17578":98449,"_5":17474,"_23043":98422,"_2395":98450},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2868":58676,"_25194":58663,"_17578":98452,"_5":17474,"_23043":98422,"_2395":98453},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2868":58677,"_25194":58663,"_17578":98455,"_5":17474,"_23043":98422,"_2395":98456},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2868":58678,"_25194":58663,"_17578":98458,"_5":17474,"_23043":98422,"_2395":98459},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2868":58679,"_25194":58663,"_17578":98461,"_5":17474,"_23043":98422,"_2395":98462},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2868":58680,"_25194":58680,"_5":12321,"_2395":98464,"_25530":98465,"_17578":98466,"_23043":58680},"Dispositivos e identidades",[40934,97461,43283,98464],[],{"_2868":58681,"_25194":58680,"_17578":98468,"_5":17474,"_23043":58680,"_2395":98469},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2868":58682,"_25194":58680,"_5":25527,"_17578":98471,"_23043":98472,"_2395":98473},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2868":58683,"_25194":58680,"_5":25527,"_17578":98475,"_23043":98476,"_2395":98477},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2868":58684,"_25194":58680,"_5":25527,"_17578":98479,"_23043":98480,"_2395":98481},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2868":58685,"_25194":58680,"_5":25527,"_17578":98483,"_23043":98484,"_2395":98485},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2868":58686,"_25194":58680,"_5":25527,"_17578":98487,"_23043":98488,"_2395":98489},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2868":58687,"_25194":58680,"_5":25527,"_17578":98491,"_23043":98492,"_2395":98493},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2868":58688,"_25194":58680,"_5":25527,"_17578":98495,"_23043":98496,"_2395":98497},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2868":58689,"_25194":58680,"_5":25527,"_17578":98499,"_23043":98500,"_2395":98501},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2868":58690,"_25194":58680,"_5":25527,"_17578":98503,"_23043":98504,"_2395":98505},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2868":58691,"_25194":58680,"_5":25527,"_17578":98507,"_23043":98508,"_2395":98509},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2868":58692,"_25194":58680,"_5":25527,"_17578":98511,"_23043":98512,"_2395":98513},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2868":58693,"_25194":58680,"_17578":98515,"_5":17474,"_23043":58680,"_2395":98516},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2868":58694,"_25194":58680,"_17578":98518,"_5":17474,"_23043":58680,"_2395":98519},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2868":58695,"_25194":58680,"_17578":98521,"_5":17474,"_23043":98472,"_2395":98522},[],"Vista operativa",{"_2868":58696,"_25194":58680,"_17578":98524,"_5":17474,"_23043":98472,"_2395":98525},[],"Interpretación",{"_2868":58697,"_25194":58680,"_17578":98527,"_5":17474,"_23043":98472,"_2395":43346},[],{"_2868":58698,"_25194":58680,"_17578":98529,"_5":17474,"_23043":98472,"_2395":98530},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2868":58699,"_25194":58680,"_17578":98532,"_5":17474,"_23043":98472,"_2395":43352},[],{"_2868":58700,"_25194":58680,"_17578":98534,"_5":17474,"_23043":98472,"_2395":98535},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2868":58701,"_25194":58680,"_17578":98537,"_5":17474,"_23043":98472,"_2395":43358},[],{"_2868":58702,"_25194":58680,"_17578":98539,"_5":17474,"_23043":98472,"_2395":98540},[],"La identidad está en la ventana operativa de renovación.",{"_2868":58703,"_25194":58680,"_17578":98542,"_5":17474,"_23043":98472,"_2395":43364},[],{"_2868":58704,"_25194":58680,"_17578":98544,"_5":17474,"_23043":98472,"_2395":98545},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2868":58705,"_25194":58680,"_17578":98547,"_5":17474,"_23043":98472,"_2395":43370},[],{"_2868":58706,"_25194":58680,"_17578":98549,"_5":17474,"_23043":98472,"_2395":98550},[],"La identidad ha vencido.",{"_2868":58707,"_25194":58680,"_17578":98552,"_5":17474,"_23043":98472,"_2395":43376},[],{"_2868":58708,"_25194":58680,"_17578":98554,"_5":17474,"_23043":98472,"_2395":98555},[],"La identidad está marcada como revocada.",{"_2868":58709,"_25194":58680,"_17578":98557,"_5":17474,"_23043":98472,"_2395":43382},[],{"_2868":58710,"_25194":58680,"_17578":98559,"_5":17474,"_23043":98472,"_2395":98560},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2868":58711,"_25194":58680,"_17578":98562,"_5":17474,"_23043":98472,"_2395":98563},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2868":58712,"_25194":58680,"_17578":98565,"_5":17474,"_23043":98476,"_2395":98566},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2868":58713,"_25194":58680,"_17578":98568,"_5":17474,"_23043":98476,"_2395":98569},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2868":58714,"_25194":58680,"_17578":98571,"_5":17474,"_23043":98476,"_2395":98572},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2868":58715,"_25194":58680,"_17578":98574,"_5":17474,"_23043":98476,"_2395":98575},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2868":58716,"_25194":58680,"_17578":98577,"_5":17474,"_23043":98480,"_2395":98578},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2868":58717,"_25194":58680,"_17578":98580,"_5":17474,"_23043":98484,"_2395":98581},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2868":58718,"_25194":58680,"_17578":98583,"_5":17474,"_23043":98488,"_2395":98584},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2868":58719,"_25194":58680,"_17578":98586,"_5":17474,"_23043":98492,"_2395":98587},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2868":58720,"_25194":58680,"_17578":98589,"_5":17474,"_23043":98496,"_2395":98590},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2868":58721,"_25194":58680,"_17578":98592,"_5":17474,"_23043":98496,"_2395":98593},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2868":58722,"_25194":58680,"_17578":98595,"_5":17474,"_23043":98500,"_2395":98596},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2868":58723,"_25194":58680,"_17578":98598,"_5":17474,"_23043":98500,"_2395":98599},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2868":58724,"_25194":58680,"_17578":98601,"_5":17474,"_23043":98500,"_2395":98602},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2868":58725,"_25194":58680,"_17578":98604,"_5":17474,"_23043":98500,"_2395":98605},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2868":58726,"_25194":58680,"_17578":98607,"_5":17474,"_23043":98500,"_2395":98608},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2868":58727,"_25194":58680,"_17578":98610,"_5":17474,"_23043":98500,"_2395":98611},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2868":58728,"_25194":58680,"_17578":98613,"_5":17474,"_23043":98504,"_2395":98614},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2868":58729,"_25194":58680,"_17578":98616,"_5":17474,"_23043":98504,"_2395":98617},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2868":58730,"_25194":58680,"_17578":98619,"_5":17474,"_23043":98508,"_2395":98620},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2868":58731,"_25194":58680,"_17578":98622,"_5":17474,"_23043":98508,"_2395":98623},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2868":58732,"_25194":58680,"_17578":98625,"_5":17474,"_23043":98508,"_2395":98626},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2868":58733,"_25194":58680,"_17578":98628,"_5":17474,"_23043":98508,"_2395":98629},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2868":58734,"_25194":58680,"_17578":98631,"_5":17474,"_23043":98512,"_2395":98632},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2868":58735,"_25194":58680,"_17578":98634,"_5":17474,"_23043":98512,"_2395":98635},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2868":58736,"_25194":58736,"_5":12321,"_2395":98637,"_25530":98638,"_17578":98640,"_23043":58736},"Identidad inicial y autenticación",[40934,97461,43283,98464,98639],"Enrolamiento con PKI",[],{"_2868":58737,"_25194":58736,"_17578":98642,"_5":17474,"_23043":58736,"_2395":98643},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2868":58738,"_25194":58736,"_5":25527,"_17578":98645,"_23043":98646,"_2395":98647},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2868":58739,"_25194":58736,"_5":25527,"_17578":98649,"_23043":98650,"_2395":98651},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2868":58740,"_25194":58736,"_5":25527,"_17578":98653,"_23043":98654,"_2395":98655},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2868":58741,"_25194":58736,"_5":25527,"_17578":98657,"_23043":98658,"_2395":98659},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2868":58742,"_25194":58736,"_5":25527,"_17578":98661,"_23043":98662,"_2395":98663},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2868":58743,"_25194":58736,"_17578":98665,"_5":17474,"_23043":58736,"_2395":98666},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2868":58744,"_25194":58736,"_17578":98668,"_5":17474,"_23043":98646,"_2395":98669},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2868":58745,"_25194":58736,"_17578":98671,"_5":17474,"_23043":98646,"_2395":98672},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2868":58746,"_25194":58736,"_17578":98674,"_5":17474,"_23043":98650,"_2395":98675},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2868":58747,"_25194":58736,"_17578":98677,"_5":17474,"_23043":98650,"_2395":98678},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2868":58748,"_25194":58736,"_17578":98680,"_5":17474,"_23043":98650,"_2395":98681},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2868":58749,"_25194":58736,"_17578":98683,"_5":17474,"_23043":98654,"_2395":98684},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2868":58750,"_25194":58736,"_17578":98686,"_5":17474,"_23043":98654,"_2395":98687},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2868":58751,"_25194":58736,"_17578":98689,"_5":17474,"_23043":98658,"_2395":98690},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2868":58752,"_25194":58736,"_17578":98692,"_5":17474,"_23043":98658,"_2395":98693},[],"Ejemplo de cuerpo:",{"_2868":58753,"_25194":58736,"_17578":98695,"_5":17474,"_23043":98658,"_2395":98696},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2868":58754,"_25194":58736,"_17578":98698,"_5":17474,"_23043":98658,"_2395":98699},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2868":58755,"_25194":58736,"_17578":98701,"_5":17474,"_23043":98658,"_2395":98702},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2868":58756,"_25194":58736,"_17578":98704,"_5":17474,"_23043":98658,"_2395":98705},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2868":58757,"_25194":58736,"_17578":98707,"_5":17474,"_23043":98662,"_2395":98708},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2868":58758,"_25194":58736,"_17578":98710,"_5":17474,"_23043":98662,"_2395":98711},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2868":58759,"_25194":58759,"_5":12321,"_2395":98713,"_25530":98714,"_17578":98715,"_23043":58759},"Configura y opera el DMS",[40934,97461,43283,98464,98639],[],{"_2868":58760,"_25194":58759,"_17578":98717,"_5":17474,"_23043":58759,"_2395":98718},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2868":58761,"_25194":58759,"_5":25527,"_17578":98720,"_23043":98721,"_2395":96162},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2868":58762,"_25194":58759,"_5":25527,"_17578":98723,"_23043":98724,"_2395":98725},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2868":58763,"_25194":58759,"_5":25527,"_17578":98727,"_23043":98728,"_2395":98729},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2868":58764,"_25194":58759,"_5":25527,"_17578":98731,"_23043":98732,"_2395":98733},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2868":58765,"_25194":58759,"_5":25527,"_17578":98735,"_23043":98736,"_2395":98737},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2868":58766,"_25194":58759,"_5":25527,"_17578":98739,"_23043":98740,"_2395":98741},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2868":58767,"_25194":58759,"_5":25527,"_17578":98743,"_23043":98744,"_2395":98745},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2868":58768,"_25194":58759,"_5":25527,"_17578":98747,"_23043":98748,"_2395":98749},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2868":58769,"_25194":58759,"_5":25527,"_17578":98751,"_23043":98752,"_2395":43578},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2868":58770,"_25194":58759,"_5":25527,"_17578":98754,"_23043":98755,"_2395":43582},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2868":58771,"_25194":58759,"_5":25527,"_17578":98757,"_23043":98758,"_2395":98759},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2868":58772,"_25194":58759,"_5":25527,"_17578":98761,"_23043":98762,"_2395":98763},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2868":58773,"_25194":58759,"_5":25527,"_17578":98765,"_23043":98766,"_2395":98767},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2868":58774,"_25194":58759,"_5":25527,"_17578":98769,"_23043":98770,"_2395":98771},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2868":58775,"_25194":58759,"_5":25527,"_17578":98773,"_23043":98774,"_2395":43602},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2868":58776,"_25194":58759,"_5":25527,"_17578":98776,"_23043":98777,"_2395":98778},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2868":58777,"_25194":58759,"_5":25527,"_17578":98780,"_23043":98781,"_2395":98782},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2868":58778,"_25194":58759,"_5":25527,"_17578":98784,"_23043":98785,"_2395":98786},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2868":58779,"_25194":58759,"_17578":98788,"_5":17474,"_23043":58759,"_2395":98789},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2868":58780,"_25194":58759,"_17578":98791,"_5":17474,"_23043":98721,"_2395":98792},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2868":58781,"_25194":58759,"_17578":98794,"_5":17474,"_23043":98721,"_2395":98795},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2868":58782,"_25194":58759,"_17578":98797,"_5":17474,"_23043":98728,"_2395":98798},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2868":58783,"_25194":58759,"_17578":98800,"_5":17474,"_23043":98732,"_2395":98801},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2868":58784,"_25194":58759,"_17578":98803,"_5":17474,"_23043":98736,"_2395":98804},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2868":58785,"_25194":58759,"_17578":98806,"_5":17474,"_23043":98740,"_2395":98807},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2868":58786,"_25194":58759,"_17578":98809,"_5":17474,"_23043":98744,"_2395":98810},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2868":58787,"_25194":58759,"_17578":98812,"_5":17474,"_23043":98752,"_2395":98813},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2868":58788,"_25194":58759,"_17578":98815,"_5":17474,"_23043":98752,"_2395":98816},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2868":58789,"_25194":58759,"_17578":98818,"_5":17474,"_23043":98755,"_2395":98819},[],"Campo de `settings.enrollment_settings`",{"_2868":58790,"_25194":58759,"_17578":98821,"_5":17474,"_23043":98755,"_2395":98822},[],"Decisión",{"_2868":58791,"_25194":58759,"_17578":98824,"_5":17474,"_23043":98755,"_2395":43653},[],{"_2868":58792,"_25194":58759,"_17578":98826,"_5":17474,"_23043":98755,"_2395":98827},[],"`EST_RFC7030` para estas operaciones.",{"_2868":58793,"_25194":58759,"_17578":98829,"_5":17474,"_23043":98755,"_2395":43659},[],{"_2868":58794,"_25194":58759,"_17578":98831,"_5":17474,"_23043":98755,"_2395":98832},[],"ID de la CA que firmará.",{"_2868":58795,"_25194":58759,"_17578":98834,"_5":17474,"_23043":98755,"_2395":43665},[],{"_2868":58796,"_25194":58759,"_17578":98836,"_5":17474,"_23043":98755,"_2395":98837},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2868":58797,"_25194":58759,"_17578":98839,"_5":17474,"_23043":98755,"_2395":43671},[],{"_2868":58798,"_25194":58759,"_17578":98841,"_5":17474,"_23043":98755,"_2395":98842},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2868":58799,"_25194":58759,"_17578":98844,"_5":17474,"_23043":98755,"_2395":43677},[],{"_2868":58800,"_25194":58759,"_17578":98846,"_5":17474,"_23043":98755,"_2395":98847},[],"Uno de los cuatro modos de autenticación.",{"_2868":58801,"_25194":58759,"_17578":98849,"_5":17474,"_23043":98755,"_2395":98850},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2868":58802,"_25194":58759,"_17578":98852,"_5":17474,"_23043":98758,"_2395":98853},[],"Los bloques son independientes:",{"_2868":58803,"_25194":58759,"_17578":98855,"_5":17474,"_23043":98758,"_2395":98856},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2868":58804,"_25194":58759,"_17578":98858,"_5":17474,"_23043":98758,"_2395":98859},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2868":58805,"_25194":58759,"_17578":98861,"_5":17474,"_23043":98758,"_2395":43695},[],{"_2868":58806,"_25194":58759,"_17578":98863,"_5":17474,"_23043":98758,"_2395":98864},[],"Control aplicado en la operación configurada",{"_2868":58807,"_25194":58759,"_17578":98866,"_5":17474,"_23043":98758,"_2395":43701},[],{"_2868":58808,"_25194":58759,"_17578":98868,"_5":17474,"_23043":98758,"_2395":98869},[],"Validación del certificado presentado.",{"_2868":58809,"_25194":58759,"_17578":98871,"_5":17474,"_23043":98758,"_2395":43707},[],{"_2868":58810,"_25194":58759,"_17578":98873,"_5":17474,"_23043":98758,"_2395":98874},[],"Autorización del webhook configurado.",{"_2868":58811,"_25194":58759,"_17578":98876,"_5":17474,"_23043":98758,"_2395":43713},[],{"_2868":58812,"_25194":58759,"_17578":98878,"_5":17474,"_23043":98758,"_2395":98879},[],"Validación del certificado y, después, aprobación del webhook.",{"_2868":58813,"_25194":58759,"_17578":98881,"_5":17474,"_23043":98758,"_2395":43719},[],{"_2868":58814,"_25194":58759,"_17578":98883,"_5":17474,"_23043":98758,"_2395":98884},[],"Sin autenticación del solicitante por el DMS.",{"_2868":58815,"_25194":58759,"_17578":98886,"_5":17474,"_23043":98758,"_2395":98887},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2868":58816,"_25194":58759,"_17578":98889,"_5":17474,"_23043":98758,"_2395":98890},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2868":58817,"_25194":58759,"_17578":98892,"_5":17474,"_23043":98758,"_2395":98893},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2868":58818,"_25194":58759,"_17578":98895,"_5":17474,"_23043":98758,"_2395":98896},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2868":58819,"_25194":58759,"_17578":98898,"_5":17474,"_23043":98762,"_2395":98899},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2868":58820,"_25194":58759,"_17578":98901,"_5":17474,"_23043":98762,"_2395":98902},[],"Campo de `external_webhook_settings`",{"_2868":58821,"_25194":58759,"_17578":98904,"_5":17474,"_23043":98762,"_2395":98822},[],{"_2868":58822,"_25194":58759,"_17578":98906,"_5":17474,"_23043":98762,"_2395":43745},[],{"_2868":58823,"_25194":58759,"_17578":98908,"_5":17474,"_23043":98762,"_2395":98909},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2868":58824,"_25194":58759,"_17578":98911,"_5":17474,"_23043":98762,"_2395":43751},[],{"_2868":58825,"_25194":58759,"_17578":98913,"_5":17474,"_23043":98762,"_2395":98914},[],"`POST` o `PUT`; `POST` por defecto.",{"_2868":58826,"_25194":58759,"_17578":98916,"_5":17474,"_23043":98762,"_2395":43757},[],{"_2868":58827,"_25194":58759,"_17578":98918,"_5":17474,"_23043":98762,"_2395":98919},[],"Etiqueta usada en los logs del servicio.",{"_2868":58828,"_25194":58759,"_17578":98921,"_5":17474,"_23043":98762,"_2395":43763},[],{"_2868":58829,"_25194":58759,"_17578":98923,"_5":17474,"_23043":98762,"_2395":98924},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2868":58830,"_25194":58759,"_17578":98926,"_5":17474,"_23043":98762,"_2395":43769},[],{"_2868":58831,"_25194":58759,"_17578":98928,"_5":17474,"_23043":98762,"_2395":98929},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_2868":58832,"_25194":58759,"_17578":98931,"_5":17474,"_23043":98762,"_2395":43775},[],{"_2868":58833,"_25194":58759,"_17578":98933,"_5":17474,"_23043":98762,"_2395":98934},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2868":58834,"_25194":58759,"_17578":98936,"_5":17474,"_23043":98762,"_2395":43781},[],{"_2868":58835,"_25194":58759,"_17578":98938,"_5":17474,"_23043":98762,"_2395":98939},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2868":58836,"_25194":58759,"_17578":98941,"_5":17474,"_23043":98762,"_2395":43787},[],{"_2868":58837,"_25194":58759,"_17578":98943,"_5":17474,"_23043":98762,"_2395":98944},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2868":58838,"_25194":58759,"_17578":98946,"_5":17474,"_23043":98762,"_2395":43793},[],{"_2868":58839,"_25194":58759,"_17578":98948,"_5":17474,"_23043":98762,"_2395":98949},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2868":58840,"_25194":58759,"_17578":98951,"_5":17474,"_23043":98762,"_2395":43799},[],{"_2868":58841,"_25194":58759,"_17578":98953,"_5":17474,"_23043":98762,"_2395":98954},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2868":58842,"_25194":58759,"_17578":98956,"_5":17474,"_23043":98762,"_2395":98957},[],"Reglas de esa configuración:",{"_2868":58843,"_25194":58759,"_17578":98959,"_5":17474,"_23043":98762,"_2395":98960},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2868":58844,"_25194":58759,"_17578":98962,"_5":17474,"_23043":98762,"_2395":98963},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2868":58845,"_25194":58759,"_17578":98965,"_5":17474,"_23043":98762,"_2395":98966},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2868":58846,"_25194":58759,"_17578":98968,"_5":17474,"_23043":98762,"_2395":98969},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2868":58847,"_25194":58759,"_17578":98971,"_5":17474,"_23043":98762,"_2395":98972},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2868":58848,"_25194":58759,"_17578":98974,"_5":17474,"_23043":98762,"_2395":98975},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2868":58849,"_25194":58759,"_17578":98977,"_5":17474,"_23043":98762,"_2395":98978},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_2868":58850,"_25194":58759,"_17578":98980,"_5":17474,"_23043":98762,"_2395":98981},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. La consola ya expone estos campos: abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en base64 de las configuraciones migradas, y almacena el material codificado en base64.",{"_2868":58851,"_25194":58759,"_17578":98983,"_5":17474,"_23043":98766,"_2395":98984},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2868":58852,"_25194":58759,"_17578":98986,"_5":17474,"_23043":98770,"_2395":98987},[],"Campo de `settings.reenrollment_settings`",{"_2868":58853,"_25194":58759,"_17578":98989,"_5":17474,"_23043":98770,"_2395":98990},[],"Función",{"_2868":58854,"_25194":58759,"_17578":98992,"_5":17474,"_23043":98770,"_2395":43840},[],{"_2868":58855,"_25194":58759,"_17578":98994,"_5":17474,"_23043":98770,"_2395":98995},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2868":58856,"_25194":58759,"_17578":98997,"_5":17474,"_23043":98770,"_2395":43846},[],{"_2868":58857,"_25194":58759,"_17578":98999,"_5":17474,"_23043":98770,"_2395":99000},[],"Umbral operativo preventivo de monitorización.",{"_2868":58858,"_25194":58759,"_17578":99002,"_5":17474,"_23043":98770,"_2395":43852},[],{"_2868":58859,"_25194":58759,"_17578":99004,"_5":17474,"_23043":98770,"_2395":99005},[],"Umbral operativo crítico de monitorización.",{"_2868":58860,"_25194":58759,"_17578":99007,"_5":17474,"_23043":98770,"_2395":43858},[],{"_2868":58861,"_25194":58759,"_17578":99009,"_5":17474,"_23043":98770,"_2395":99010},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2868":58862,"_25194":58759,"_17578":99012,"_5":17474,"_23043":98770,"_2395":43864},[],{"_2868":58863,"_25194":58759,"_17578":99014,"_5":17474,"_23043":98770,"_2395":99015},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2868":58864,"_25194":58759,"_17578":99017,"_5":17474,"_23043":98770,"_2395":43870},[],{"_2868":58865,"_25194":58759,"_17578":99019,"_5":17474,"_23043":98770,"_2395":99020},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2868":58866,"_25194":58759,"_17578":99022,"_5":17474,"_23043":98770,"_2395":99023},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2868":58867,"_25194":58759,"_17578":99025,"_5":17474,"_23043":98774,"_2395":99026},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2868":58868,"_25194":58759,"_17578":99028,"_5":17474,"_23043":98777,"_2395":96519},[],{"_2868":58869,"_25194":58759,"_17578":99030,"_5":17474,"_23043":98777,"_2395":99031},[],"Qué publica",{"_2868":58870,"_25194":58759,"_17578":99033,"_5":17474,"_23043":98777,"_2395":43887},[],{"_2868":58871,"_25194":58759,"_17578":99035,"_5":17474,"_23043":98777,"_2395":99036},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2868":58872,"_25194":58759,"_17578":99038,"_5":17474,"_23043":98777,"_2395":43893},[],{"_2868":58873,"_25194":58759,"_17578":99040,"_5":17474,"_23043":98777,"_2395":99041},[],"Certificado de la CA emisora seleccionada.",{"_2868":58874,"_25194":58759,"_17578":99043,"_5":17474,"_23043":98777,"_2395":43899},[],{"_2868":58875,"_25194":58759,"_17578":99045,"_5":17474,"_23043":98777,"_2395":99046},[],"Certificados de las CAs elegidas explícitamente.",{"_2868":58876,"_25194":58759,"_17578":99048,"_5":17474,"_23043":98777,"_2395":99049},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2868":58877,"_25194":58759,"_17578":99051,"_5":17474,"_23043":98781,"_2395":99052},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2868":58878,"_25194":58759,"_17578":99054,"_5":17474,"_23043":98781,"_2395":99055},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2868":58879,"_25194":58759,"_17578":99057,"_5":17474,"_23043":98781,"_2395":99058},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2868":58880,"_25194":58759,"_17578":99060,"_5":17474,"_23043":98785,"_2395":99061},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2868":58881,"_25194":58881,"_5":12321,"_2395":99063,"_25530":99064,"_17578":99065,"_23043":58881},"Integra el cliente EST",[40934,97461,43283,98464,98639],[],{"_2868":58882,"_25194":58881,"_17578":99067,"_5":17474,"_23043":58881,"_2395":99068},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2868":58883,"_25194":58881,"_5":25527,"_17578":99070,"_23043":99071,"_2395":96162},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2868":58884,"_25194":58881,"_5":25527,"_17578":99073,"_23043":99074,"_2395":99075},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2868":58885,"_25194":58881,"_5":25527,"_17578":99077,"_23043":99078,"_2395":99079},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2868":58886,"_25194":58881,"_5":25527,"_17578":99081,"_23043":99082,"_2395":99083},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2868":58887,"_25194":58881,"_5":25527,"_17578":99085,"_23043":99086,"_2395":99087},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2868":58888,"_25194":58881,"_5":25527,"_17578":99089,"_23043":99090,"_2395":99091},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2868":58889,"_25194":58881,"_17578":99093,"_5":17474,"_23043":58881,"_2395":99094},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2868":58890,"_25194":58881,"_17578":99096,"_5":17474,"_23043":99071,"_2395":99097},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2868":58891,"_25194":58881,"_17578":99099,"_5":17474,"_23043":99071,"_2395":99100},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2868":58892,"_25194":58881,"_17578":99102,"_5":17474,"_23043":99071,"_2395":99103},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2868":58893,"_25194":58881,"_17578":99105,"_5":17474,"_23043":99074,"_2395":99106},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2868":58894,"_25194":58881,"_17578":99108,"_5":17474,"_23043":99074,"_2395":99109},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2868":58895,"_25194":58881,"_17578":99111,"_5":17474,"_23043":99078,"_2395":99112},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2868":58896,"_25194":58881,"_17578":99114,"_5":17474,"_23043":99078,"_2395":99115},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2868":58897,"_25194":58881,"_17578":99117,"_5":17474,"_23043":99082,"_2395":99118},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2868":58898,"_25194":58881,"_17578":99120,"_5":17474,"_23043":99082,"_2395":99121},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2868":58899,"_25194":58881,"_17578":99123,"_5":17474,"_23043":99086,"_2395":99124},[],"Para el caso de una raíz que emite directamente:",{"_2868":58900,"_25194":58881,"_17578":99126,"_5":17474,"_23043":99086,"_2395":99127},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2868":58901,"_25194":58881,"_17578":99129,"_5":17474,"_23043":99086,"_2395":99130},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2868":58902,"_25194":58881,"_17578":99132,"_5":17474,"_23043":99090,"_2395":99133},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2868":58903,"_25194":58903,"_5":12321,"_2395":99135,"_25530":99136,"_17578":99137,"_23043":58903},"Referencia EST",[40934,97461,43283,98464,98639],[],{"_2868":58904,"_25194":58903,"_17578":99139,"_5":17474,"_23043":58903,"_2395":99140},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2868":58905,"_25194":58903,"_5":25527,"_17578":99142,"_23043":99143,"_2395":99144},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2868":58906,"_25194":58903,"_5":25527,"_17578":99146,"_23043":99147,"_2395":19097},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2868":58907,"_25194":58903,"_5":25527,"_17578":99149,"_23043":99150,"_2395":21866},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2868":58908,"_25194":58903,"_5":25527,"_17578":99152,"_23043":99153,"_2395":21873},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2868":58909,"_25194":58903,"_5":25527,"_17578":99155,"_23043":99156,"_2395":21243},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2868":58910,"_25194":58903,"_5":25527,"_17578":99158,"_23043":99159,"_2395":99160},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2868":58911,"_25194":58903,"_5":25527,"_17578":99162,"_23043":99163,"_2395":99164},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2868":58912,"_25194":58903,"_5":25527,"_17578":99166,"_23043":99167,"_2395":99168},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2868":58913,"_25194":58903,"_17578":99170,"_5":17474,"_23043":58903,"_2395":99171},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2868":58914,"_25194":58903,"_17578":99173,"_5":17474,"_23043":99143,"_2395":99174},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2868":58915,"_25194":58903,"_17578":99176,"_5":17474,"_23043":99143,"_2395":97252},[],{"_2868":58916,"_25194":58903,"_17578":99178,"_5":17474,"_23043":99143,"_2395":99179},[],"Método",{"_2868":58917,"_25194":58903,"_17578":99181,"_5":17474,"_23043":99143,"_2395":99182},[],"Autenticación y condición",{"_2868":58918,"_25194":58903,"_17578":99184,"_5":17474,"_23043":99143,"_2395":44042},[],{"_2868":58919,"_25194":58903,"_17578":99186,"_5":17474,"_23043":99143,"_2395":44045},[],{"_2868":58920,"_25194":58903,"_17578":99188,"_5":17474,"_23043":99143,"_2395":99189},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2868":58921,"_25194":58903,"_17578":99191,"_5":17474,"_23043":99143,"_2395":44051},[],{"_2868":58922,"_25194":58903,"_17578":99193,"_5":17474,"_23043":99143,"_2395":44054},[],{"_2868":58923,"_25194":58903,"_17578":99195,"_5":17474,"_23043":99143,"_2395":99196},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2868":58924,"_25194":58903,"_17578":99198,"_5":17474,"_23043":99143,"_2395":44060},[],{"_2868":58925,"_25194":58903,"_17578":99200,"_5":17474,"_23043":99143,"_2395":44054},[],{"_2868":58926,"_25194":58903,"_17578":99202,"_5":17474,"_23043":99143,"_2395":99203},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2868":58927,"_25194":58903,"_17578":99205,"_5":17474,"_23043":99143,"_2395":44068},[],{"_2868":58928,"_25194":58903,"_17578":99207,"_5":17474,"_23043":99143,"_2395":44054},[],{"_2868":58929,"_25194":58903,"_17578":99209,"_5":17474,"_23043":99143,"_2395":99210},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2868":58930,"_25194":58903,"_17578":99212,"_5":17474,"_23043":99143,"_2395":99213},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2868":58931,"_25194":58903,"_17578":99215,"_5":17474,"_23043":99147,"_2395":99216},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2868":58932,"_25194":58903,"_17578":99218,"_5":17474,"_23043":99147,"_2395":99219},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2868":58933,"_25194":58903,"_17578":99221,"_5":17474,"_23043":99150,"_2395":99222},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2868":58934,"_25194":58903,"_17578":99224,"_5":17474,"_23043":99150,"_2395":99225},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2868":58935,"_25194":58903,"_17578":99227,"_5":17474,"_23043":99153,"_2395":99228},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2868":58936,"_25194":58903,"_17578":99230,"_5":17474,"_23043":99153,"_2395":99231},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2868":58937,"_25194":58903,"_17578":99233,"_5":17474,"_23043":99156,"_2395":99234},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2868":58938,"_25194":58903,"_17578":99236,"_5":17474,"_23043":99156,"_2395":99237},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2868":58939,"_25194":58903,"_17578":99239,"_5":17474,"_23043":99159,"_2395":99240},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2868":58940,"_25194":58903,"_17578":99242,"_5":17474,"_23043":99159,"_2395":99243},[],"Parte",{"_2868":58941,"_25194":58903,"_17578":99245,"_5":17474,"_23043":99159,"_2395":99246},[],"Contenido tras decodificar su Base64",{"_2868":58942,"_25194":58903,"_17578":99248,"_5":17474,"_23043":99159,"_2395":44112},[],{"_2868":58943,"_25194":58903,"_17578":99250,"_5":17474,"_23043":99159,"_2395":99251},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2868":58944,"_25194":58903,"_17578":99253,"_5":17474,"_23043":99159,"_2395":44118},[],{"_2868":58945,"_25194":58903,"_17578":99255,"_5":17474,"_23043":99159,"_2395":99256},[],"PKCS#7 DER con el certificado emitido.",{"_2868":58946,"_25194":58903,"_17578":99258,"_5":17474,"_23043":99159,"_2395":99259},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2868":58947,"_25194":58903,"_17578":99261,"_5":17474,"_23043":99163,"_2395":99262},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2868":58948,"_25194":58903,"_17578":99264,"_5":17474,"_23043":99163,"_2395":99265},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2868":58949,"_25194":58903,"_17578":99267,"_5":17474,"_23043":99163,"_2395":99268},[],"Convierte y comprueba el resultado:",{"_2868":58950,"_25194":58903,"_17578":99270,"_5":17474,"_23043":99163,"_2395":99271},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2868":58951,"_25194":58903,"_17578":99273,"_5":17474,"_23043":99167,"_2395":99274},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2868":58952,"_25194":58903,"_17578":99276,"_5":17474,"_23043":99167,"_2395":99277},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2868":58953,"_25194":58953,"_5":12321,"_2395":98639,"_25530":99279,"_17578":99280,"_23043":58953},[40934,97461,43283,98464,98639],[],{"_2868":58954,"_25194":58953,"_17578":99282,"_5":17474,"_23043":58953,"_2395":99283},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2868":58955,"_25194":58953,"_5":25527,"_17578":99285,"_23043":99286,"_2395":99287},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2868":58956,"_25194":58953,"_5":25527,"_17578":99289,"_23043":99290,"_2395":99291},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2868":58957,"_25194":58953,"_5":25527,"_17578":99293,"_23043":99294,"_2395":99295},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2868":58958,"_25194":58953,"_5":25527,"_17578":99297,"_23043":99298,"_2395":99299},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2868":58959,"_25194":58953,"_17578":99301,"_5":17474,"_23043":58953,"_2395":99302},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2868":58960,"_25194":58953,"_17578":99304,"_5":17474,"_23043":99286,"_2395":99305},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2868":58961,"_25194":58953,"_17578":99307,"_5":17474,"_23043":99286,"_2395":99308},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2868":58962,"_25194":58953,"_17578":99310,"_5":17474,"_23043":99286,"_2395":99311},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2868":58963,"_25194":58953,"_17578":99313,"_5":17474,"_23043":99286,"_2395":99314},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2868":58964,"_25194":58953,"_17578":99316,"_5":17474,"_23043":99286,"_2395":99317},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2868":58965,"_25194":58953,"_17578":99319,"_5":17474,"_23043":99286,"_2395":99320},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2868":58966,"_25194":58953,"_17578":99322,"_5":17474,"_23043":99290,"_2395":99323},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2868":58967,"_25194":58953,"_17578":99325,"_5":17474,"_23043":99290,"_2395":99326},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2868":58968,"_25194":58953,"_17578":99328,"_5":17474,"_23043":99290,"_2395":99329},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2868":58969,"_25194":58953,"_17578":99331,"_5":17474,"_23043":99290,"_2395":99332},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2868":58970,"_25194":58953,"_17578":99334,"_5":17474,"_23043":99294,"_2395":99335},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2868":58971,"_25194":58953,"_17578":99337,"_5":17474,"_23043":99294,"_2395":99338},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2868":58972,"_25194":58953,"_17578":99340,"_5":17474,"_23043":99294,"_2395":99341},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2868":58973,"_25194":58953,"_17578":99343,"_5":17474,"_23043":99294,"_2395":99344},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2868":58974,"_25194":58953,"_17578":99346,"_5":17474,"_23043":99298,"_2395":99347},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2868":58975,"_25194":58953,"_17578":99349,"_5":17474,"_23043":99298,"_2395":99350},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2868":58976,"_25194":58976,"_5":12321,"_2395":99352,"_25530":99353,"_17578":99354,"_23043":58976},"Estrategias de aprovisionamiento",[40934,97461,43283,98464,98639],[],{"_2868":58977,"_25194":58976,"_17578":99356,"_5":17474,"_23043":58976,"_2395":99357},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2868":58978,"_25194":58976,"_5":25527,"_17578":99359,"_23043":99360,"_2395":99361},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2868":58979,"_25194":58976,"_5":25527,"_17578":99363,"_23043":99364,"_2395":99365},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2868":58980,"_25194":58976,"_5":25527,"_17578":99367,"_23043":99368,"_2395":99369},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2868":58981,"_25194":58976,"_5":25527,"_17578":99371,"_23043":99372,"_2395":99373},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2868":58982,"_25194":58976,"_5":25527,"_17578":99375,"_23043":99376,"_2395":99377},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2868":58983,"_25194":58976,"_17578":99379,"_5":17474,"_23043":58976,"_2395":99380},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2868":58984,"_25194":58976,"_17578":99382,"_5":17474,"_23043":99360,"_2395":99383},[],"Recorrido",{"_2868":58985,"_25194":58976,"_17578":99385,"_5":17474,"_23043":99360,"_2395":99386},[],"Cuándo existe el dispositivo",{"_2868":58986,"_25194":58976,"_17578":99388,"_5":17474,"_23043":99360,"_2395":99389},[],"Qué compruebas",{"_2868":58987,"_25194":58976,"_17578":99391,"_5":17474,"_23043":99360,"_2395":99392},[],"Asignación manual",{"_2868":58988,"_25194":58976,"_17578":99394,"_5":17474,"_23043":99360,"_2395":99395},[],"El operador lo crea antes de asociar un certificado.",{"_2868":58989,"_25194":58976,"_17578":99397,"_5":17474,"_23043":99360,"_2395":99398},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2868":58990,"_25194":58976,"_17578":99400,"_5":17474,"_23043":99360,"_2395":99401},[],"EST con `JITP`",{"_2868":58991,"_25194":58976,"_17578":99403,"_5":17474,"_23043":99360,"_2395":99404},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2868":58992,"_25194":58976,"_17578":99406,"_5":17474,"_23043":99360,"_2395":99407},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2868":58993,"_25194":58976,"_17578":99409,"_5":17474,"_23043":99360,"_2395":99410},[],"EST con `PRE_REGISTRATION`",{"_2868":58994,"_25194":58976,"_17578":99412,"_5":17474,"_23043":99360,"_2395":99413},[],"Debe existir antes de `/simpleenroll`.",{"_2868":58995,"_25194":58976,"_17578":99415,"_5":17474,"_23043":99360,"_2395":99416},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2868":58996,"_25194":58976,"_17578":99418,"_5":17474,"_23043":99360,"_2395":99419},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2868":58997,"_25194":58976,"_17578":99421,"_5":17474,"_23043":99360,"_2395":99422},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2868":58998,"_25194":58976,"_17578":99424,"_5":17474,"_23043":99364,"_2395":99425},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2868":58999,"_25194":58976,"_17578":99427,"_5":17474,"_23043":99364,"_2395":99428},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2868":59000,"_25194":58976,"_17578":99430,"_5":17474,"_23043":99364,"_2395":99431},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2868":59001,"_25194":58976,"_17578":99433,"_5":17474,"_23043":99368,"_2395":99434},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2868":59002,"_25194":58976,"_17578":99436,"_5":17474,"_23043":99368,"_2395":99437},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2868":59003,"_25194":58976,"_17578":99439,"_5":17474,"_23043":99368,"_2395":99440},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2868":59004,"_25194":58976,"_17578":99442,"_5":17474,"_23043":99368,"_2395":99443},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2868":59005,"_25194":58976,"_17578":99445,"_5":17474,"_23043":99368,"_2395":99446},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2868":59006,"_25194":58976,"_17578":99448,"_5":17474,"_23043":99368,"_2395":99449},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2868":59007,"_25194":58976,"_17578":99451,"_5":17474,"_23043":99372,"_2395":96519},[],{"_2868":59008,"_25194":58976,"_17578":99453,"_5":17474,"_23043":99372,"_2395":99454},[],"Material que atraviesa EST",{"_2868":59009,"_25194":58976,"_17578":99456,"_5":17474,"_23043":99372,"_2395":99457},[],"Clave generada por el dispositivo",{"_2868":59010,"_25194":58976,"_17578":99459,"_5":17474,"_23043":99372,"_2395":99460},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2868":59011,"_25194":58976,"_17578":99462,"_5":17474,"_23043":99372,"_2395":99463},[],"Clave ya disponible en el dispositivo",{"_2868":59012,"_25194":58976,"_17578":99465,"_5":17474,"_23043":99372,"_2395":99466},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2868":59013,"_25194":58976,"_17578":99468,"_5":17474,"_23043":99372,"_2395":43602},[],{"_2868":59014,"_25194":58976,"_17578":99470,"_5":17474,"_23043":99372,"_2395":99471},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2868":59015,"_25194":58976,"_17578":99473,"_5":17474,"_23043":99372,"_2395":99474},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2868":59016,"_25194":58976,"_17578":99476,"_5":17474,"_23043":99376,"_2395":99477},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2868":59017,"_25194":59017,"_5":12321,"_2395":99479,"_25530":99480,"_17578":99481,"_23043":59017},"Renovación y recuperación",[40934,97461,43283,98464,98639],[],{"_2868":59018,"_25194":59017,"_17578":99483,"_5":17474,"_23043":59017,"_2395":99484},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2868":59019,"_25194":59017,"_5":25527,"_17578":99486,"_23043":99487,"_2395":99488},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2868":59020,"_25194":59017,"_5":25527,"_17578":99490,"_23043":99491,"_2395":99492},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2868":59021,"_25194":59017,"_5":25527,"_17578":99494,"_23043":99495,"_2395":99496},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2868":59022,"_25194":59017,"_5":25527,"_17578":99498,"_23043":99499,"_2395":99500},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2868":59023,"_25194":59017,"_5":25527,"_17578":99502,"_23043":99503,"_2395":99504},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2868":59024,"_25194":59017,"_17578":99506,"_5":17474,"_23043":59017,"_2395":99507},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2868":59025,"_25194":59017,"_17578":99509,"_5":17474,"_23043":99487,"_2395":99510},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2868":59026,"_25194":59017,"_17578":99512,"_5":17474,"_23043":99487,"_2395":99513},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2868":59027,"_25194":59017,"_17578":99515,"_5":17474,"_23043":99487,"_2395":99516},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2868":59028,"_25194":59017,"_17578":99518,"_5":17474,"_23043":99487,"_2395":99519},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2868":59029,"_25194":59017,"_17578":99521,"_5":17474,"_23043":99491,"_2395":99522},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2868":59030,"_25194":59017,"_17578":99524,"_5":17474,"_23043":99491,"_2395":99525},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2868":59031,"_25194":59017,"_17578":99527,"_5":17474,"_23043":99495,"_2395":99528},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2868":59032,"_25194":59017,"_17578":99530,"_5":17474,"_23043":99495,"_2395":99531},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2868":59033,"_25194":59017,"_17578":99533,"_5":17474,"_23043":99495,"_2395":99534},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2868":59034,"_25194":59017,"_17578":99536,"_5":17474,"_23043":99499,"_2395":99537},[],"Situación",{"_2868":59035,"_25194":59017,"_17578":99539,"_5":17474,"_23043":99499,"_2395":99540},[],"Procedimiento",{"_2868":59036,"_25194":59017,"_17578":99542,"_5":17474,"_23043":99499,"_2395":99543},[],"Certificado vigente, fuera de ventana",{"_2868":59037,"_25194":59017,"_17578":99545,"_5":17474,"_23043":99499,"_2395":99546},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2868":59038,"_25194":59017,"_17578":99548,"_5":17474,"_23043":99499,"_2395":99549},[],"Certificado vencido, clave disponible",{"_2868":59039,"_25194":59017,"_17578":99551,"_5":17474,"_23043":99499,"_2395":99552},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2868":59040,"_25194":59017,"_17578":99554,"_5":17474,"_23043":99499,"_2395":99555},[],"Renovación por webhook o `NO_AUTH`",{"_2868":59041,"_25194":59017,"_17578":99557,"_5":17474,"_23043":99499,"_2395":99558},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2868":59042,"_25194":59017,"_17578":99560,"_5":17474,"_23043":99499,"_2395":99561},[],"Clave perdida o inaccesible",{"_2868":59043,"_25194":59017,"_17578":99563,"_5":17474,"_23043":99499,"_2395":99564},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2868":59044,"_25194":59017,"_17578":99566,"_5":17474,"_23043":99499,"_2395":99567},[],"Identidad actual revocada",{"_2868":59045,"_25194":59017,"_17578":99569,"_5":17474,"_23043":99499,"_2395":99570},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2868":59046,"_25194":59017,"_17578":99572,"_5":17474,"_23043":99499,"_2395":99573},[],"Dispositivo sin identidad",{"_2868":59047,"_25194":59017,"_17578":99575,"_5":17474,"_23043":99499,"_2395":99576},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2868":59048,"_25194":59017,"_17578":99578,"_5":17474,"_23043":99499,"_2395":99579},[],"Dispositivo retirado",{"_2868":59049,"_25194":59017,"_17578":99581,"_5":17474,"_23043":99499,"_2395":99582},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2868":59050,"_25194":59017,"_17578":99584,"_5":17474,"_23043":99499,"_2395":99585},[],"Timeout, HTTP 500 o fallo de instalación",{"_2868":59051,"_25194":59017,"_17578":99587,"_5":17474,"_23043":99499,"_2395":99588},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2868":59052,"_25194":59017,"_17578":99590,"_5":17474,"_23043":99503,"_2395":99591},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2868":59053,"_25194":59017,"_17578":99593,"_5":17474,"_23043":99503,"_2395":99594},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2868":59054,"_25194":59054,"_5":12321,"_2395":99596,"_25530":99597,"_17578":99598,"_23043":59054},"Diagnóstico de enrolamiento",[40934,97461,43283,98464,98639],[],{"_2868":59055,"_25194":59054,"_17578":99600,"_5":17474,"_23043":59054,"_2395":99601},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2868":59056,"_25194":59054,"_5":25527,"_17578":99603,"_23043":99604,"_2395":99605},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2868":59057,"_25194":59054,"_5":25527,"_17578":99607,"_23043":99608,"_2395":99609},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2868":59058,"_25194":59054,"_5":25527,"_17578":99611,"_23043":99612,"_2395":99168},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2868":59059,"_25194":59054,"_5":25527,"_17578":99614,"_23043":99615,"_2395":99616},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2868":59060,"_25194":59054,"_17578":99618,"_5":17474,"_23043":59054,"_2395":99619},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2868":59061,"_25194":59054,"_17578":99621,"_5":17474,"_23043":99608,"_2395":99622},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2868":59062,"_25194":59054,"_17578":99624,"_5":17474,"_23043":99608,"_2395":99625},[],"Síntoma o mensaje",{"_2868":59063,"_25194":59054,"_17578":99627,"_5":17474,"_23043":99608,"_2395":99628},[],"Qué revisar",{"_2868":59064,"_25194":59054,"_17578":99630,"_5":17474,"_23043":99608,"_2395":99631},[],"curl rechaza TLS, nombre o emisor",{"_2868":59065,"_25194":59054,"_17578":99633,"_5":17474,"_23043":99608,"_2395":99634},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2868":59066,"_25194":59054,"_17578":99636,"_5":17474,"_23043":99608,"_2395":99637},[],"404 o APS ausente",{"_2868":59067,"_25194":59054,"_17578":99639,"_5":17474,"_23043":99608,"_2395":99640},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2868":59068,"_25194":59054,"_17578":99642,"_5":17474,"_23043":99608,"_2395":99643},[],"400, error de CSR o formato",{"_2868":59069,"_25194":59054,"_17578":99645,"_5":17474,"_23043":99608,"_2395":99646},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2868":59070,"_25194":59054,"_17578":99648,"_5":17474,"_23043":99608,"_2395":99649},[],"Credencial ausente o certificado no válido",{"_2868":59071,"_25194":59054,"_17578":99651,"_5":17474,"_23043":99608,"_2395":99652},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2868":59072,"_25194":59054,"_17578":99654,"_5":17474,"_23043":99608,"_2395":99655},[],"Webhook deniega, expira o responde sin autorización",{"_2868":59073,"_25194":59054,"_17578":99657,"_5":17474,"_23043":99608,"_2395":99658},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2868":59074,"_25194":59054,"_17578":99660,"_5":17474,"_23043":99608,"_2395":44525},[],{"_2868":59075,"_25194":59054,"_17578":99662,"_5":17474,"_23043":99608,"_2395":99663},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2868":59076,"_25194":59054,"_17578":99665,"_5":17474,"_23043":99608,"_2395":44531},[],{"_2868":59077,"_25194":59054,"_17578":99667,"_5":17474,"_23043":99608,"_2395":99668},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2868":59078,"_25194":59054,"_17578":99670,"_5":17474,"_23043":99608,"_2395":44537},[],{"_2868":59079,"_25194":59054,"_17578":99672,"_5":17474,"_23043":99608,"_2395":99673},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el PEM como `cert_content` y `key_content`; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2868":59080,"_25194":59054,"_17578":99675,"_5":17474,"_23043":99608,"_2395":99676},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2868":59081,"_25194":59054,"_17578":99678,"_5":17474,"_23043":99608,"_2395":99679},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2868":59082,"_25194":59054,"_17578":99681,"_5":17474,"_23043":99608,"_2395":99682},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2868":59083,"_25194":59054,"_17578":99684,"_5":17474,"_23043":99608,"_2395":99685},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2868":59084,"_25194":59054,"_17578":99687,"_5":17474,"_23043":99608,"_2395":44555},[],{"_2868":59085,"_25194":59054,"_17578":99689,"_5":17474,"_23043":99608,"_2395":99690},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2868":59086,"_25194":59054,"_17578":99692,"_5":17474,"_23043":99608,"_2395":44561},[],{"_2868":59087,"_25194":59054,"_17578":99694,"_5":17474,"_23043":99608,"_2395":99695},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2868":59088,"_25194":59054,"_17578":99697,"_5":17474,"_23043":99608,"_2395":99698},[],"DMS propietario distinto",{"_2868":59089,"_25194":59054,"_17578":99700,"_5":17474,"_23043":99608,"_2395":99701},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2868":59090,"_25194":59054,"_17578":99703,"_5":17474,"_23043":99608,"_2395":44573},[],{"_2868":59091,"_25194":59054,"_17578":99705,"_5":17474,"_23043":99608,"_2395":99706},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2868":59092,"_25194":59054,"_17578":99708,"_5":17474,"_23043":99608,"_2395":44579},[],{"_2868":59093,"_25194":59054,"_17578":99710,"_5":17474,"_23043":99608,"_2395":99711},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2868":59094,"_25194":59054,"_17578":99713,"_5":17474,"_23043":99608,"_2395":99714},[],"Certificado actual revocado",{"_2868":59095,"_25194":59054,"_17578":99716,"_5":17474,"_23043":99608,"_2395":99717},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2868":59096,"_25194":59054,"_17578":99719,"_5":17474,"_23043":99608,"_2395":99720},[],"Error de CA, perfil o firma",{"_2868":59097,"_25194":59054,"_17578":99722,"_5":17474,"_23043":99608,"_2395":99723},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2868":59098,"_25194":59054,"_17578":99725,"_5":17474,"_23043":99608,"_2395":99726},[],"HTTP 200 sin conexión del dispositivo",{"_2868":59099,"_25194":59054,"_17578":99728,"_5":17474,"_23043":99608,"_2395":99729},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2868":59100,"_25194":59054,"_17578":99731,"_5":17474,"_23043":99608,"_2395":99732},[],"Timeout o error después de emitir",{"_2868":59101,"_25194":59054,"_17578":99734,"_5":17474,"_23043":99608,"_2395":99735},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2868":59102,"_25194":59054,"_17578":99737,"_5":17474,"_23043":99612,"_2395":99738},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2868":59103,"_25194":59054,"_17578":99740,"_5":17474,"_23043":99612,"_2395":99741},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2868":59104,"_25194":59054,"_17578":99743,"_5":17474,"_23043":99615,"_2395":99744},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2868":59105,"_25194":59054,"_17578":99746,"_5":17474,"_23043":99615,"_2395":99747},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2868":59106,"_25194":59054,"_17578":99749,"_5":17474,"_23043":99615,"_2395":99750},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2868":59107,"_25194":59054,"_17578":99752,"_5":17474,"_23043":99615,"_2395":99753},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2868":59108,"_25194":59054,"_17578":99755,"_5":17474,"_23043":99615,"_2395":99756},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2868":59109,"_25194":59054,"_17578":99758,"_5":17474,"_23043":99615,"_2395":99759},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2868":59110,"_25194":59054,"_17578":99761,"_5":17474,"_23043":99615,"_2395":99762},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2868":59111,"_25194":59111,"_5":12321,"_2395":99764,"_25530":99765,"_17578":99766,"_23043":59111},"Distribución y actualización de confianza",[40934,97461,43283,98464,98639],[],{"_2868":59112,"_25194":59111,"_17578":99768,"_5":17474,"_23043":59111,"_2395":99769},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2868":59113,"_25194":59111,"_5":25527,"_17578":99771,"_23043":99772,"_2395":99773},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2868":59114,"_25194":59111,"_5":25527,"_17578":99775,"_23043":99776,"_2395":99777},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2868":59115,"_25194":59111,"_5":25527,"_17578":99779,"_23043":99780,"_2395":99781},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2868":59116,"_25194":59111,"_5":25527,"_17578":99783,"_23043":99784,"_2395":99785},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2868":59117,"_25194":59111,"_5":25527,"_17578":99787,"_23043":99788,"_2395":99789},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2868":59118,"_25194":59111,"_17578":99791,"_5":17474,"_23043":59111,"_2395":99792},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2868":59119,"_25194":59111,"_17578":99794,"_5":17474,"_23043":99772,"_2395":99795},[],"Relación",{"_2868":59120,"_25194":59111,"_17578":99797,"_5":17474,"_23043":99772,"_2395":99798},[],"Material que prepara el responsable",{"_2868":59121,"_25194":59111,"_17578":99800,"_5":17474,"_23043":99772,"_2395":99801},[],"Dispositivo → servidor EST",{"_2868":59122,"_25194":59111,"_17578":99803,"_5":17474,"_23043":99772,"_2395":99804},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2868":59123,"_25194":59111,"_17578":99806,"_5":17474,"_23043":99772,"_2395":99807},[],"DMS → solicitante",{"_2868":59124,"_25194":59111,"_17578":99809,"_5":17474,"_23043":99772,"_2395":99810},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2868":59125,"_25194":59111,"_17578":99812,"_5":17474,"_23043":99772,"_2395":99813},[],"Consumidor → dispositivo",{"_2868":59126,"_25194":59111,"_17578":99815,"_5":17474,"_23043":99772,"_2395":99816},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2868":59127,"_25194":59111,"_17578":99818,"_5":17474,"_23043":99772,"_2395":99819},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2868":59128,"_25194":59111,"_17578":99821,"_5":17474,"_23043":99776,"_2395":99822},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2868":59129,"_25194":59111,"_17578":99824,"_5":17474,"_23043":99776,"_2395":99825},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2868":59130,"_25194":59111,"_17578":99827,"_5":17474,"_23043":99780,"_2395":99828},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2868":59131,"_25194":59111,"_17578":99830,"_5":17474,"_23043":99780,"_2395":99831},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2868":59132,"_25194":59111,"_17578":99833,"_5":17474,"_23043":99780,"_2395":99834},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2868":59133,"_25194":59111,"_17578":99836,"_5":17474,"_23043":99780,"_2395":99837},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2868":59134,"_25194":59111,"_17578":99839,"_5":17474,"_23043":99780,"_2395":99840},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2868":59135,"_25194":59111,"_17578":99842,"_5":17474,"_23043":99780,"_2395":99843},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2868":59136,"_25194":59111,"_17578":99845,"_5":17474,"_23043":99784,"_2395":99846},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2868":59137,"_25194":59111,"_17578":99848,"_5":17474,"_23043":99784,"_2395":99849},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2868":59138,"_25194":59111,"_17578":99851,"_5":17474,"_23043":99784,"_2395":99852},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2868":59139,"_25194":59111,"_17578":99854,"_5":17474,"_23043":99788,"_2395":99855},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2868":59140,"_25194":59140,"_5":12321,"_2395":44728,"_25530":99857,"_17578":99859,"_23043":59140},[40934,97461,43283,98464,99858],"Integraciones",[],{"_2868":59141,"_25194":59140,"_17578":99861,"_5":17474,"_23043":59140,"_2395":99862},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2868":59142,"_25194":59140,"_5":25527,"_17578":99864,"_23043":99865,"_2395":99866},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2868":59143,"_25194":59140,"_5":25527,"_17578":99868,"_23043":99869,"_2395":99870},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2868":59144,"_25194":59140,"_5":25527,"_17578":99872,"_23043":99873,"_2395":99874},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2868":59145,"_25194":59140,"_5":25527,"_17578":99876,"_23043":99877,"_2395":99878},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2868":59146,"_25194":59140,"_5":25527,"_17578":99880,"_23043":99881,"_2395":99882},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2868":59147,"_25194":59140,"_5":25527,"_17578":99884,"_23043":99885,"_2395":99886},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2868":59148,"_25194":59140,"_5":25527,"_17578":99888,"_23043":99889,"_2395":44762},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2868":59149,"_25194":59140,"_5":25527,"_17578":99891,"_23043":99892,"_2395":44766},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2868":59150,"_25194":59140,"_5":25527,"_17578":99894,"_23043":99895,"_2395":99896},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2868":59151,"_25194":59140,"_5":25527,"_17578":99898,"_23043":99899,"_2395":99900},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2868":59152,"_25194":59140,"_5":25527,"_17578":99902,"_23043":99903,"_2395":99904},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2868":59153,"_25194":59140,"_5":25527,"_17578":99906,"_23043":99907,"_2395":99908},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2868":59154,"_25194":59140,"_5":25527,"_17578":99910,"_23043":99911,"_2395":99912},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2868":59155,"_25194":59140,"_5":25527,"_17578":99914,"_23043":99915,"_2395":99916},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2868":59156,"_25194":59140,"_5":25527,"_17578":99918,"_23043":99919,"_2395":99920},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2868":59157,"_25194":59140,"_5":25527,"_17578":99922,"_23043":99923,"_2395":99924},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2868":59158,"_25194":59140,"_5":25527,"_17578":99926,"_23043":99927,"_2395":99928},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2868":59159,"_25194":59140,"_5":25527,"_17578":99930,"_23043":99931,"_2395":99932},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2868":59160,"_25194":59140,"_5":25527,"_17578":99934,"_23043":99935,"_2395":99936},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2868":59161,"_25194":59140,"_5":25527,"_17578":99938,"_23043":99939,"_2395":99940},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2868":59162,"_25194":59140,"_17578":99942,"_5":17474,"_23043":59140,"_2395":99943},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2868":59163,"_25194":59140,"_17578":99945,"_5":17474,"_23043":59140,"_2395":99946},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2868":59164,"_25194":59140,"_17578":99948,"_5":17474,"_23043":59140,"_2395":99949},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2868":59165,"_25194":59140,"_17578":99951,"_5":17474,"_23043":99865,"_2395":99952},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2868":59166,"_25194":59140,"_17578":99954,"_5":17474,"_23043":99865,"_2395":99955},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2868":59167,"_25194":59140,"_17578":99957,"_5":17474,"_23043":99865,"_2395":99958},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2868":59168,"_25194":59140,"_17578":99960,"_5":17474,"_23043":99865,"_2395":99961},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2868":59169,"_25194":59140,"_17578":99963,"_5":17474,"_23043":99869,"_2395":99964},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2868":59170,"_25194":59140,"_17578":99966,"_5":17474,"_23043":99873,"_2395":99967},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2868":59171,"_25194":59140,"_17578":99969,"_5":17474,"_23043":99873,"_2395":99970},[],"Acción IAM",{"_2868":59172,"_25194":59140,"_17578":99972,"_5":17474,"_23043":99873,"_2395":96525},[],{"_2868":59173,"_25194":59140,"_17578":99974,"_5":17474,"_23043":99873,"_2395":44849},[],{"_2868":59174,"_25194":59140,"_17578":99976,"_5":17474,"_23043":99873,"_2395":99977},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2868":59175,"_25194":59140,"_17578":99979,"_5":17474,"_23043":99873,"_2395":44855},[],{"_2868":59176,"_25194":59140,"_17578":99981,"_5":17474,"_23043":99873,"_2395":99982},[],"Registrar la CA en AWS IoT",{"_2868":59177,"_25194":59140,"_17578":99984,"_5":17474,"_23043":99873,"_2395":44861},[],{"_2868":59178,"_25194":59140,"_17578":99986,"_5":17474,"_23043":99873,"_2395":99987},[],"Consultar el estado del registro de la CA",{"_2868":59179,"_25194":59140,"_17578":99989,"_5":17474,"_23043":99873,"_2395":44867},[],{"_2868":59180,"_25194":59140,"_17578":99991,"_5":17474,"_23043":99873,"_2395":99992},[],"Crear o actualizar Things en IoT Core",{"_2868":59181,"_25194":59140,"_17578":99994,"_5":17474,"_23043":99873,"_2395":44873},[],{"_2868":59182,"_25194":59140,"_17578":99996,"_5":17474,"_23043":99873,"_2395":99997},[],"Aprovisionar Things mediante plantilla",{"_2868":59183,"_25194":59140,"_17578":99999,"_5":17474,"_23043":99873,"_2395":44879},[],{"_2868":59184,"_25194":59140,"_17578":100001,"_5":17474,"_23043":99873,"_2395":100002},[],"Registrar certificados de dispositivo",{"_2868":59185,"_25194":59140,"_17578":100004,"_5":17474,"_23043":99873,"_2395":44885},[],{"_2868":59186,"_25194":59140,"_17578":100006,"_5":17474,"_23043":99873,"_2395":100007},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2868":59187,"_25194":59140,"_17578":100009,"_5":17474,"_23043":99873,"_2395":44891},[],{"_2868":59188,"_25194":59140,"_17578":100011,"_5":17474,"_23043":99873,"_2395":100012},[],"Crear y adjuntar políticas IoT",{"_2868":59189,"_25194":59140,"_17578":100014,"_5":17474,"_23043":99873,"_2395":44897},[],{"_2868":59190,"_25194":59140,"_17578":100016,"_5":17474,"_23043":99873,"_2395":100017},[],"Gestionar grupos de Things",{"_2868":59191,"_25194":59140,"_17578":100019,"_5":17474,"_23043":99873,"_2395":44903},[],{"_2868":59192,"_25194":59140,"_17578":100021,"_5":17474,"_23043":99873,"_2395":100022},[],"Crear plantillas JITP",{"_2868":59193,"_25194":59140,"_17578":100024,"_5":17474,"_23043":99873,"_2395":44909},[],{"_2868":59194,"_25194":59140,"_17578":100026,"_5":17474,"_23043":99873,"_2395":100027},[],"Leer y escribir el Device Shadow",{"_2868":59195,"_25194":59140,"_17578":100029,"_5":17474,"_23043":99873,"_2395":100030},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2868":59196,"_25194":59140,"_17578":100032,"_5":17474,"_23043":99877,"_2395":100033},[],"Parámetro",{"_2868":59197,"_25194":59140,"_17578":100035,"_5":17474,"_23043":99877,"_2395":100036},[],"Tipo",{"_2868":59198,"_25194":59140,"_17578":100038,"_5":17474,"_23043":99877,"_2395":100039},[],"Requerido",{"_2868":59199,"_25194":59140,"_17578":100041,"_5":17474,"_23043":99877,"_2395":100042},[],"Descripción",{"_2868":59200,"_25194":59140,"_17578":100044,"_5":17474,"_23043":99877,"_2395":44930},[],{"_2868":59201,"_25194":59140,"_17578":100046,"_5":17474,"_23043":99877,"_2395":20987},[],{"_2868":59202,"_25194":59140,"_17578":100048,"_5":17474,"_23043":99877,"_2395":100049},[],"Sí",{"_2868":59203,"_25194":59140,"_17578":100051,"_5":17474,"_23043":99877,"_2395":100052},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2868":59204,"_25194":59140,"_17578":100054,"_5":17474,"_23043":99877,"_2395":44941},[],{"_2868":59205,"_25194":59140,"_17578":100056,"_5":17474,"_23043":99877,"_2395":20987},[],{"_2868":59206,"_25194":59140,"_17578":100058,"_5":17474,"_23043":99877,"_2395":100049},[],{"_2868":59207,"_25194":59140,"_17578":100060,"_5":17474,"_23043":99877,"_2395":100061},[],"Región AWS donde opera el conector.",{"_2868":59208,"_25194":59140,"_17578":100063,"_5":17474,"_23043":99877,"_2395":44951},[],{"_2868":59209,"_25194":59140,"_17578":100065,"_5":17474,"_23043":99877,"_2395":20987},[],{"_2868":59210,"_25194":59140,"_17578":100067,"_5":17474,"_23043":99877,"_2395":100049},[],{"_2868":59211,"_25194":59140,"_17578":100069,"_5":17474,"_23043":99877,"_2395":100070},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2868":59212,"_25194":59140,"_17578":100072,"_5":17474,"_23043":99877,"_2395":44961},[],{"_2868":59213,"_25194":59140,"_17578":100074,"_5":17474,"_23043":99877,"_2395":20987},[],{"_2868":59214,"_25194":59140,"_17578":100076,"_5":17474,"_23043":99877,"_2395":100077},[],"Solo con `auth_method=static`",{"_2868":59215,"_25194":59140,"_17578":100079,"_5":17474,"_23043":99877,"_2395":100080},[],"Clave de acceso AWS.",{"_2868":59216,"_25194":59140,"_17578":100082,"_5":17474,"_23043":99877,"_2395":44972},[],{"_2868":59217,"_25194":59140,"_17578":100084,"_5":17474,"_23043":99877,"_2395":20987},[],{"_2868":59218,"_25194":59140,"_17578":100086,"_5":17474,"_23043":99877,"_2395":100077},[],{"_2868":59219,"_25194":59140,"_17578":100088,"_5":17474,"_23043":99877,"_2395":100089},[],"Clave secreta AWS.",{"_2868":59220,"_25194":59140,"_17578":100091,"_5":17474,"_23043":99877,"_2395":44982},[],{"_2868":59221,"_25194":59140,"_17578":100093,"_5":17474,"_23043":99877,"_2395":20987},[],{"_2868":59222,"_25194":59140,"_17578":100095,"_5":17474,"_23043":99877,"_2395":44987},[],{"_2868":59223,"_25194":59140,"_17578":100097,"_5":17474,"_23043":99877,"_2395":100098},[],"Token de sesión (con `auth_method=static`).",{"_2868":59224,"_25194":59140,"_17578":100100,"_5":17474,"_23043":99877,"_2395":44993},[],{"_2868":59225,"_25194":59140,"_17578":100102,"_5":17474,"_23043":99877,"_2395":20987},[],{"_2868":59226,"_25194":59140,"_17578":100104,"_5":17474,"_23043":99877,"_2395":100105},[],"Solo con `auth_method=role`",{"_2868":59227,"_25194":59140,"_17578":100107,"_5":17474,"_23043":99877,"_2395":100108},[],"ARN del rol a asumir.",{"_2868":59228,"_25194":59140,"_17578":100110,"_5":17474,"_23043":99877,"_2395":45004},[],{"_2868":59229,"_25194":59140,"_17578":100112,"_5":17474,"_23043":99877,"_2395":20987},[],{"_2868":59230,"_25194":59140,"_17578":100114,"_5":17474,"_23043":99877,"_2395":44987},[],{"_2868":59231,"_25194":59140,"_17578":100116,"_5":17474,"_23043":99877,"_2395":100117},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2868":59232,"_25194":59140,"_17578":100119,"_5":17474,"_23043":99877,"_2395":45014},[],{"_2868":59233,"_25194":59140,"_17578":100121,"_5":17474,"_23043":99877,"_2395":14753},[],{"_2868":59234,"_25194":59140,"_17578":100123,"_5":17474,"_23043":99877,"_2395":100049},[],{"_2868":59235,"_25194":59140,"_17578":100125,"_5":17474,"_23043":99877,"_2395":100126},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2868":59236,"_25194":59140,"_17578":100128,"_5":17474,"_23043":99877,"_2395":45024},[],{"_2868":59237,"_25194":59140,"_17578":100130,"_5":17474,"_23043":99877,"_2395":20987},[],{"_2868":59238,"_25194":59140,"_17578":100132,"_5":17474,"_23043":99877,"_2395":100049},[],{"_2868":59239,"_25194":59140,"_17578":100134,"_5":17474,"_23043":99877,"_2395":100135},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2868":59240,"_25194":59140,"_17578":100137,"_5":17474,"_23043":99877,"_2395":45034},[],{"_2868":59241,"_25194":59140,"_17578":100139,"_5":17474,"_23043":99877,"_2395":20987},[],{"_2868":59242,"_25194":59140,"_17578":100141,"_5":17474,"_23043":99877,"_2395":100049},[],{"_2868":59243,"_25194":59140,"_17578":100143,"_5":17474,"_23043":99877,"_2395":100144},[],"URL HTTP del Device Manager de Lamassu.",{"_2868":59244,"_25194":59140,"_17578":100146,"_5":17474,"_23043":99877,"_2395":45044},[],{"_2868":59245,"_25194":59140,"_17578":100148,"_5":17474,"_23043":99877,"_2395":20987},[],{"_2868":59246,"_25194":59140,"_17578":100150,"_5":17474,"_23043":99877,"_2395":100049},[],{"_2868":59247,"_25194":59140,"_17578":100152,"_5":17474,"_23043":99877,"_2395":100153},[],"URL HTTP del servicio de CA de Lamassu.",{"_2868":59248,"_25194":59140,"_17578":100155,"_5":17474,"_23043":99881,"_2395":100156},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2868":59249,"_25194":59140,"_17578":100158,"_5":17474,"_23043":99885,"_2395":100159},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2868":59250,"_25194":59140,"_17578":100161,"_5":17474,"_23043":99885,"_2395":100162},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2868":59251,"_25194":59140,"_17578":100164,"_5":17474,"_23043":99889,"_2395":100165},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2868":59252,"_25194":59140,"_17578":100167,"_5":17474,"_23043":99889,"_2395":100168},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2868":59253,"_25194":59140,"_17578":100170,"_5":17474,"_23043":99889,"_2395":100171},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2868":59254,"_25194":59140,"_17578":100173,"_5":17474,"_23043":99889,"_2395":100174},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2868":59255,"_25194":59140,"_17578":100176,"_5":17474,"_23043":99889,"_2395":100177},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2868":59256,"_25194":59140,"_17578":100179,"_5":17474,"_23043":99889,"_2395":100180},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2868":59257,"_25194":59140,"_17578":100182,"_5":17474,"_23043":99892,"_2395":100183},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2868":59258,"_25194":59140,"_17578":100185,"_5":17474,"_23043":99895,"_2395":100186},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2868":59259,"_25194":59140,"_17578":100188,"_5":17474,"_23043":99895,"_2395":100189},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2868":59260,"_25194":59140,"_17578":100191,"_5":17474,"_23043":99899,"_2395":100192},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2868":59261,"_25194":59140,"_17578":100194,"_5":17474,"_23043":99903,"_2395":100195},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2868":59262,"_25194":59140,"_17578":100197,"_5":17474,"_23043":99903,"_2395":100198},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2868":59263,"_25194":59140,"_17578":100200,"_5":17474,"_23043":99903,"_2395":100201},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2868":59264,"_25194":59140,"_17578":100203,"_5":17474,"_23043":99903,"_2395":100204},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2868":59265,"_25194":59140,"_17578":100206,"_5":17474,"_23043":99903,"_2395":100207},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2868":59266,"_25194":59140,"_17578":100209,"_5":17474,"_23043":99903,"_2395":100210},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2868":59267,"_25194":59140,"_17578":100212,"_5":17474,"_23043":99907,"_2395":100213},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2868":59268,"_25194":59140,"_17578":100215,"_5":17474,"_23043":99907,"_2395":100216},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2868":59269,"_25194":59140,"_17578":100218,"_5":17474,"_23043":99907,"_2395":100219},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2868":59270,"_25194":59140,"_17578":100221,"_5":17474,"_23043":99911,"_2395":100222},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2868":59271,"_25194":59140,"_17578":100224,"_5":17474,"_23043":99911,"_2395":100225},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2868":59272,"_25194":59140,"_17578":100227,"_5":17474,"_23043":99911,"_2395":100228},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2868":59273,"_25194":59140,"_17578":100230,"_5":17474,"_23043":99915,"_2395":100231},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2868":59274,"_25194":59140,"_17578":100233,"_5":17474,"_23043":99915,"_2395":100234},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2868":59275,"_25194":59140,"_17578":100236,"_5":17474,"_23043":99915,"_2395":100237},[],"Para que el flujo JITP funcione correctamente:",{"_2868":59276,"_25194":59140,"_17578":100239,"_5":17474,"_23043":99915,"_2395":100240},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2868":59277,"_25194":59140,"_17578":100242,"_5":17474,"_23043":99915,"_2395":100243},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2868":59278,"_25194":59140,"_17578":100245,"_5":17474,"_23043":99915,"_2395":100246},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2868":59279,"_25194":59140,"_17578":100248,"_5":17474,"_23043":99915,"_2395":100249},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2868":59280,"_25194":59140,"_17578":100251,"_5":17474,"_23043":99919,"_2395":100252},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2868":59281,"_25194":59140,"_17578":100254,"_5":17474,"_23043":99919,"_2395":100255},[],"Estado en Lamassu",{"_2868":59282,"_25194":59140,"_17578":100257,"_5":17474,"_23043":99919,"_2395":100258},[],"Razón de revocación",{"_2868":59283,"_25194":59140,"_17578":100260,"_5":17474,"_23043":99919,"_2395":100261},[],"Estado en AWS IoT Core",{"_2868":59284,"_25194":59140,"_17578":100263,"_5":17474,"_23043":99919,"_2395":45165},[],{"_2868":59285,"_25194":59140,"_17578":100265,"_5":17474,"_23043":99919,"_2395":100266},[],"Ninguna",{"_2868":59286,"_25194":59140,"_17578":100268,"_5":17474,"_23043":99919,"_2395":45171},[],{"_2868":59287,"_25194":59140,"_17578":100270,"_5":17474,"_23043":99919,"_2395":45174},[],{"_2868":59288,"_25194":59140,"_17578":100272,"_5":17474,"_23043":99919,"_2395":45177},[],{"_2868":59289,"_25194":59140,"_17578":100274,"_5":17474,"_23043":99919,"_2395":45180},[],{"_2868":59290,"_25194":59140,"_17578":100276,"_5":17474,"_23043":99919,"_2395":45174},[],{"_2868":59291,"_25194":59140,"_17578":100278,"_5":17474,"_23043":99919,"_2395":100279},[],"Cualquier otra razón",{"_2868":59292,"_25194":59140,"_17578":100281,"_5":17474,"_23043":99919,"_2395":45188},[],{"_2868":59293,"_25194":59140,"_17578":100283,"_5":17474,"_23043":99919,"_2395":100284},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2868":59294,"_25194":59140,"_17578":100286,"_5":17474,"_23043":99923,"_2395":100287},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2868":59295,"_25194":59140,"_17578":100289,"_5":17474,"_23043":99923,"_2395":100290},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2868":59296,"_25194":59140,"_17578":100292,"_5":17474,"_23043":99923,"_2395":100293},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2868":59297,"_25194":59140,"_17578":100295,"_5":17474,"_23043":99927,"_2395":100296},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2868":59298,"_25194":59140,"_17578":100298,"_5":17474,"_23043":99927,"_2395":100299},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2868":59299,"_25194":59140,"_17578":100301,"_5":17474,"_23043":99931,"_2395":100302},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2868":59300,"_25194":59140,"_17578":100304,"_5":17474,"_23043":99931,"_2395":100305},[],"Existen dos tipos de acciones:",{"_2868":59301,"_25194":59140,"_17578":100307,"_5":17474,"_23043":99931,"_2395":100308},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2868":59302,"_25194":59140,"_17578":100310,"_5":17474,"_23043":99931,"_2395":100311},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2868":59303,"_25194":59140,"_17578":100313,"_5":17474,"_23043":99931,"_2395":100314},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2868":59304,"_25194":59140,"_17578":100316,"_5":17474,"_23043":99935,"_2395":100317},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2868":59305,"_25194":59140,"_17578":100319,"_5":17474,"_23043":99935,"_2395":100320},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2868":59306,"_25194":59140,"_17578":100322,"_5":17474,"_23043":99935,"_2395":100323},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2868":59307,"_25194":59140,"_17578":100325,"_5":17474,"_23043":99939,"_2395":100326},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2868":59308,"_25194":59140,"_17578":100328,"_5":17474,"_23043":99939,"_2395":100329},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2868":59309,"_25194":59140,"_17578":100331,"_5":17474,"_23043":99939,"_2395":100332},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2868":59310,"_25194":59140,"_17578":100334,"_5":17474,"_23043":99939,"_2395":100335},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2868":59311,"_25194":59140,"_17578":100337,"_5":17474,"_23043":99939,"_2395":100338},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2868":59312,"_25194":59140,"_17578":100340,"_5":17474,"_23043":99939,"_2395":100341},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2868":59313,"_25194":59140,"_17578":100343,"_5":17474,"_23043":99939,"_2395":100344},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2868":59314,"_25194":59140,"_17578":100346,"_5":17474,"_23043":99939,"_2395":100347},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2868":59315,"_25194":59140,"_17578":100349,"_5":17474,"_23043":99939,"_2395":100350},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2868":59316,"_25194":59140,"_17578":100352,"_5":17474,"_23043":99939,"_2395":100353},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2868":59317,"_25194":59140,"_17578":100355,"_5":17474,"_23043":99939,"_2395":100356},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2868":59318,"_25194":59140,"_17578":100358,"_5":17474,"_23043":99939,"_2395":100359},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2868":59319,"_25194":59140,"_17578":100361,"_5":17474,"_23043":99939,"_2395":100362},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2868":59320,"_25194":59140,"_17578":100364,"_5":17474,"_23043":99939,"_2395":100365},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2868":59321,"_25194":59140,"_17578":100367,"_5":17474,"_23043":99939,"_2395":100368},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2868":59322,"_25194":59140,"_17578":100370,"_5":17474,"_23043":99939,"_2395":100371},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2868":59323,"_25194":59140,"_17578":100373,"_5":17474,"_23043":99939,"_2395":100374},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2868":59324,"_25194":59140,"_17578":100376,"_5":17474,"_23043":99939,"_2395":100377},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2868":59325,"_25194":59140,"_17578":100379,"_5":17474,"_23043":99939,"_2395":100380},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2868":59326,"_25194":59140,"_17578":100382,"_5":17474,"_23043":99939,"_2395":100383},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2868":59327,"_25194":59140,"_17578":100385,"_5":17474,"_23043":99939,"_2395":100386},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2868":59328,"_25194":59328,"_5":12321,"_2395":43283,"_25530":100388,"_17578":100389,"_23043":59328},[40934,97461,43283],[],{"_2868":59329,"_25194":59328,"_17578":100391,"_5":17474,"_23043":59328,"_2395":100392},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2868":59330,"_25194":59328,"_5":25527,"_17578":100394,"_23043":100395,"_2395":100396},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2868":59331,"_25194":59328,"_5":25527,"_17578":100398,"_23043":100399,"_2395":98464},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2868":59332,"_25194":59328,"_5":25527,"_17578":100401,"_23043":100402,"_2395":98639},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2868":59333,"_25194":59328,"_5":25527,"_17578":100404,"_23043":100405,"_2395":99858},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/overview#integraciones",{"_2868":59334,"_25194":59328,"_5":25527,"_17578":100407,"_23043":100408,"_2395":100409},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2868":59335,"_25194":59328,"_17578":100411,"_5":17474,"_23043":59328,"_2395":100412},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2868":59336,"_25194":59328,"_17578":100414,"_5":17474,"_23043":100395,"_2395":100415},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2868":59337,"_25194":59328,"_17578":100417,"_5":17474,"_23043":100395,"_2395":100418},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2868":59338,"_25194":59328,"_17578":100420,"_5":17474,"_23043":100399,"_2395":100421},[],"Recurso",{"_2868":59339,"_25194":59328,"_17578":100423,"_5":17474,"_23043":100399,"_2395":100424},[],"Qué representa",{"_2868":59340,"_25194":59328,"_17578":100426,"_5":17474,"_23043":100399,"_2395":100427},[],"**Dispositivo**",{"_2868":59341,"_25194":59328,"_17578":100429,"_5":17474,"_23043":100399,"_2395":100430},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2868":59342,"_25194":59328,"_17578":100432,"_5":17474,"_23043":100399,"_2395":100433},[],"**Identidad**",{"_2868":59343,"_25194":59328,"_17578":100435,"_5":17474,"_23043":100399,"_2395":100436},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2868":59344,"_25194":59328,"_17578":100438,"_5":17474,"_23043":100399,"_2395":45346},[],{"_2868":59345,"_25194":59328,"_17578":100440,"_5":17474,"_23043":100399,"_2395":100441},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2868":59346,"_25194":59328,"_17578":100443,"_5":17474,"_23043":100399,"_2395":100444},[],"**Flota**",{"_2868":59347,"_25194":59328,"_17578":100446,"_5":17474,"_23043":100399,"_2395":100447},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2868":59348,"_25194":59328,"_17578":100449,"_5":17474,"_23043":100399,"_2395":100450},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2868":59349,"_25194":59328,"_17578":100452,"_5":17474,"_23043":100399,"_2395":100453},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2868":59350,"_25194":59328,"_17578":100455,"_5":17474,"_23043":100402,"_2395":100456},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2868":59351,"_25194":59328,"_17578":100458,"_5":17474,"_23043":100402,"_2395":100459},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2868":59352,"_25194":59328,"_17578":100461,"_5":17474,"_23043":100402,"_2395":100462},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2868":59353,"_25194":59328,"_17578":100464,"_5":17474,"_23043":100402,"_2395":100465},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2868":59354,"_25194":59328,"_17578":100467,"_5":17474,"_23043":100402,"_2395":100468},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2868":59355,"_25194":59328,"_17578":100470,"_5":17474,"_23043":100402,"_2395":100471},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2868":59356,"_25194":59328,"_17578":100473,"_5":17474,"_23043":100402,"_2395":100474},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2868":59357,"_25194":59328,"_17578":100476,"_5":17474,"_23043":100402,"_2395":100477},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2868":59358,"_25194":59328,"_17578":100479,"_5":17474,"_23043":100405,"_2395":100480},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2868":59359,"_25194":59328,"_17578":100482,"_5":17474,"_23043":100405,"_2395":100483},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2868":59360,"_25194":59328,"_17578":100485,"_5":17474,"_23043":100408,"_2395":100486},[],"Participante",{"_2868":59361,"_25194":59328,"_17578":100488,"_5":17474,"_23043":100408,"_2395":100489},[],"Responsabilidad",{"_2868":59362,"_25194":59328,"_17578":100491,"_5":17474,"_23043":100408,"_2395":100492},[],"Administrador PKI",{"_2868":59363,"_25194":59328,"_17578":100494,"_5":17474,"_23043":100408,"_2395":100495},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2868":59364,"_25194":59328,"_17578":100497,"_5":17474,"_23043":100408,"_2395":100498},[],"Administrador del aprovisionamiento",{"_2868":59365,"_25194":59328,"_17578":100500,"_5":17474,"_23043":100408,"_2395":100501},[],"DMS, admisión, autenticación por operación e inventario.",{"_2868":59366,"_25194":59328,"_17578":100503,"_5":17474,"_23043":100408,"_2395":100504},[],"Integrador del dispositivo",{"_2868":59367,"_25194":59328,"_17578":100506,"_5":17474,"_23043":100408,"_2395":100507},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2868":59368,"_25194":59328,"_17578":100509,"_5":17474,"_23043":100408,"_2395":100510},[],"Integrador del consumidor",{"_2868":59369,"_25194":59328,"_17578":100512,"_5":17474,"_23043":100408,"_2395":100513},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2868":59370,"_25194":59328,"_17578":100515,"_5":17474,"_23043":100408,"_2395":100516},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2868":59371,"_25194":59371,"_5":12321,"_2395":100518,"_25530":100519,"_17578":100521,"_23043":59371},"Enrola y conecta tu primer dispositivo",[40934,97461,43283,100520],"Primeros pasos",[],{"_2868":59372,"_25194":59371,"_17578":100523,"_5":17474,"_23043":59371,"_2395":100524},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2868":59373,"_25194":59371,"_5":25527,"_17578":100526,"_23043":100527,"_2395":96162},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2868":59374,"_25194":59371,"_5":25527,"_17578":100529,"_23043":100530,"_2395":100531},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2868":59375,"_25194":59371,"_5":25527,"_17578":100533,"_23043":100534,"_2395":100535},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2868":59376,"_25194":59371,"_5":25527,"_17578":100537,"_23043":100538,"_2395":100539},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2868":59377,"_25194":59371,"_5":25527,"_17578":100541,"_23043":100542,"_2395":100543},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2868":59378,"_25194":59371,"_5":25527,"_17578":100545,"_23043":100546,"_2395":100547},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2868":59379,"_25194":59371,"_5":25527,"_17578":100549,"_23043":100550,"_2395":100551},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2868":59380,"_25194":59371,"_5":25527,"_17578":100553,"_23043":100554,"_2395":100555},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2868":59381,"_25194":59371,"_17578":100557,"_5":17474,"_23043":59371,"_2395":100558},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2868":59382,"_25194":59371,"_17578":100560,"_5":17474,"_23043":100527,"_2395":100561},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2868":59383,"_25194":59371,"_17578":100563,"_5":17474,"_23043":100527,"_2395":100564},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2868":59384,"_25194":59371,"_17578":100566,"_5":17474,"_23043":100527,"_2395":100567},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2868":59385,"_25194":59371,"_17578":100569,"_5":17474,"_23043":100527,"_2395":100570},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2868":59386,"_25194":59371,"_17578":100572,"_5":17474,"_23043":100527,"_2395":100573},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2868":59387,"_25194":59371,"_17578":100575,"_5":17474,"_23043":100530,"_2395":100576},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2868":59388,"_25194":59371,"_17578":100578,"_5":17474,"_23043":100530,"_2395":100579},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2868":59389,"_25194":59371,"_17578":100581,"_5":17474,"_23043":100534,"_2395":100582},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2868":59390,"_25194":59371,"_17578":100584,"_5":17474,"_23043":100534,"_2395":100585},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2868":59391,"_25194":59371,"_17578":100587,"_5":17474,"_23043":100534,"_2395":100588},[],"Ajuste",{"_2868":59392,"_25194":59371,"_17578":100590,"_5":17474,"_23043":100534,"_2395":100591},[],"Valor de evaluación",{"_2868":59393,"_25194":59371,"_17578":100593,"_5":17474,"_23043":100534,"_2395":45502},[],{"_2868":59394,"_25194":59371,"_17578":100595,"_5":17474,"_23043":100534,"_2395":100596},[],"Raíz emisora de `device-root.pem`.",{"_2868":59395,"_25194":59371,"_17578":100598,"_5":17474,"_23043":100534,"_2395":98767},[],{"_2868":59396,"_25194":59371,"_17578":100600,"_5":17474,"_23043":100534,"_2395":100601},[],"Perfil final de 1 hora que acabas de preparar.",{"_2868":59397,"_25194":59371,"_17578":100603,"_5":17474,"_23043":100534,"_2395":45513},[],{"_2868":59398,"_25194":59371,"_17578":100605,"_5":17474,"_23043":100534,"_2395":45516},[],{"_2868":59399,"_25194":59371,"_17578":100607,"_5":17474,"_23043":100534,"_2395":45519},[],{"_2868":59400,"_25194":59371,"_17578":100609,"_5":17474,"_23043":100534,"_2395":100610},[],"Habilitado.",{"_2868":59401,"_25194":59371,"_17578":100612,"_5":17474,"_23043":100534,"_2395":45525},[],{"_2868":59402,"_25194":59371,"_17578":100614,"_5":17474,"_23043":100534,"_2395":100615},[],"Deshabilitado; el ID debe ser nuevo.",{"_2868":59403,"_25194":59371,"_17578":100617,"_5":17474,"_23043":100534,"_2395":100618},[],"Autenticación inicial",{"_2868":59404,"_25194":59371,"_17578":100620,"_5":17474,"_23043":100534,"_2395":100621},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2868":59405,"_25194":59371,"_17578":100623,"_5":17474,"_23043":100534,"_2395":100624},[],"Autenticación de renovación",{"_2868":59406,"_25194":59371,"_17578":100626,"_5":17474,"_23043":100534,"_2395":100627},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2868":59407,"_25194":59371,"_17578":100629,"_5":17474,"_23043":100534,"_2395":45543},[],{"_2868":59408,"_25194":59371,"_17578":100631,"_5":17474,"_23043":100534,"_2395":100632},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2868":59409,"_25194":59371,"_17578":100634,"_5":17474,"_23043":100534,"_2395":45549},[],{"_2868":59410,"_25194":59371,"_17578":100636,"_5":17474,"_23043":100534,"_2395":100637},[],"1 hora.",{"_2868":59411,"_25194":59371,"_17578":100639,"_5":17474,"_23043":100534,"_2395":45555},[],{"_2868":59412,"_25194":59371,"_17578":100641,"_5":17474,"_23043":100534,"_2395":100642},[],"30 minutos / 10 minutos.",{"_2868":59413,"_25194":59371,"_17578":100644,"_5":17474,"_23043":100534,"_2395":45561},[],{"_2868":59414,"_25194":59371,"_17578":100646,"_5":17474,"_23043":100534,"_2395":100647},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2868":59415,"_25194":59371,"_17578":100649,"_5":17474,"_23043":100534,"_2395":43602},[],{"_2868":59416,"_25194":59371,"_17578":100651,"_5":17474,"_23043":100534,"_2395":100652},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2868":59417,"_25194":59371,"_17578":100654,"_5":17474,"_23043":100534,"_2395":45572},[],{"_2868":59418,"_25194":59371,"_17578":100656,"_5":17474,"_23043":100534,"_2395":100657},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2868":59419,"_25194":59371,"_17578":100659,"_5":17474,"_23043":100534,"_2395":100660},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2868":59420,"_25194":59371,"_17578":100662,"_5":17474,"_23043":100538,"_2395":100663},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2868":59421,"_25194":59371,"_17578":100665,"_5":17474,"_23043":100538,"_2395":100666},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2868":59422,"_25194":59371,"_17578":100668,"_5":17474,"_23043":100542,"_2395":100669},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2868":59423,"_25194":59371,"_17578":100671,"_5":17474,"_23043":100542,"_2395":100672},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2868":59424,"_25194":59371,"_17578":100674,"_5":17474,"_23043":100542,"_2395":100675},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2868":59425,"_25194":59371,"_17578":100677,"_5":17474,"_23043":100546,"_2395":100678},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2868":59426,"_25194":59371,"_17578":100680,"_5":17474,"_23043":100546,"_2395":100681},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2868":59427,"_25194":59371,"_17578":100683,"_5":17474,"_23043":100550,"_2395":100684},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2868":59428,"_25194":59371,"_17578":100686,"_5":17474,"_23043":100550,"_2395":100687},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2868":59429,"_25194":59371,"_17578":100689,"_5":17474,"_23043":100550,"_2395":100690},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2868":59430,"_25194":59371,"_17578":100692,"_5":17474,"_23043":100550,"_2395":100693},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2868":59431,"_25194":59371,"_17578":100695,"_5":17474,"_23043":100550,"_2395":100696},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2868":59432,"_25194":59371,"_17578":100698,"_5":17474,"_23043":100554,"_2395":100699},[],"Comprobación",{"_2868":59433,"_25194":59371,"_17578":100701,"_5":17474,"_23043":100554,"_2395":100702},[],"Resultado esperado",{"_2868":59434,"_25194":59371,"_17578":100704,"_5":17474,"_23043":100554,"_2395":100705},[],"Registro",{"_2868":59435,"_25194":59371,"_17578":100707,"_5":17474,"_23043":100554,"_2395":100708},[],"ID creado automáticamente y DMS correcto.",{"_2868":59436,"_25194":59371,"_17578":100710,"_5":17474,"_23043":100554,"_2395":100711},[],"Certificado",{"_2868":59437,"_25194":59371,"_17578":100713,"_5":17474,"_23043":100554,"_2395":100714},[],"CN, perfil, serie y clave verificados.",{"_2868":59438,"_25194":59371,"_17578":100716,"_5":17474,"_23043":100554,"_2395":100717},[],"Inventario",{"_2868":59439,"_25194":59371,"_17578":100719,"_5":17474,"_23043":100554,"_2395":100720},[],"Serie recibida visible como identidad actual y en el historial.",{"_2868":59440,"_25194":59371,"_17578":100722,"_5":17474,"_23043":100554,"_2395":100723},[],"Consumidor",{"_2868":59441,"_25194":59371,"_17578":100725,"_5":17474,"_23043":100554,"_2395":100726},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2868":59442,"_25194":59371,"_17578":100728,"_5":17474,"_23043":100554,"_2395":100729},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2868":59443,"_25194":59371,"_17578":100731,"_5":17474,"_23043":100554,"_2395":100732},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2868":59444,"_25194":59444,"_5":12321,"_2395":98481,"_25530":100734,"_17578":100735,"_23043":59444},[40934,97461,43283,100520],[],{"_2868":59445,"_25194":59444,"_17578":100737,"_5":17474,"_23043":59444,"_2395":100738},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2868":59446,"_25194":59444,"_5":25527,"_17578":100740,"_23043":100741,"_2395":96162},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2868":59447,"_25194":59444,"_5":25527,"_17578":100743,"_23043":100744,"_2395":100745},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2868":59448,"_25194":59444,"_5":25527,"_17578":100747,"_23043":100748,"_2395":100749},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2868":59449,"_25194":59444,"_5":25527,"_17578":100751,"_23043":100752,"_2395":100753},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2868":59450,"_25194":59444,"_5":25527,"_17578":100755,"_23043":100756,"_2395":100757},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2868":59451,"_25194":59444,"_5":25527,"_17578":100759,"_23043":100760,"_2395":100761},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2868":59452,"_25194":59444,"_5":25527,"_17578":100763,"_23043":100764,"_2395":100702},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2868":59453,"_25194":59444,"_5":25527,"_17578":100766,"_23043":100767,"_2395":100768},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2868":59454,"_25194":59444,"_5":25527,"_17578":100770,"_23043":100771,"_2395":100772},[],"/docs/pr-preview/pr-39/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2868":59455,"_25194":59444,"_17578":100774,"_5":17474,"_23043":59444,"_2395":100775},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2868":59456,"_25194":59444,"_17578":100777,"_5":17474,"_23043":59444,"_2395":100778},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2868":59457,"_25194":59444,"_17578":100780,"_5":17474,"_23043":100741,"_2395":100781},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2868":59458,"_25194":59444,"_17578":100783,"_5":17474,"_23043":100741,"_2395":100784},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2868":59459,"_25194":59444,"_17578":100786,"_5":17474,"_23043":100741,"_2395":100787},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2868":59460,"_25194":59444,"_17578":100789,"_5":17474,"_23043":100741,"_2395":100790},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2868":59461,"_25194":59444,"_17578":100792,"_5":17474,"_23043":100744,"_2395":100793},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2868":59462,"_25194":59444,"_17578":100795,"_5":17474,"_23043":100744,"_2395":100796},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2868":59463,"_25194":59444,"_17578":100798,"_5":17474,"_23043":100744,"_2395":100799},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2868":59464,"_25194":59444,"_17578":100801,"_5":17474,"_23043":100744,"_2395":100802},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2868":59465,"_25194":59444,"_17578":100804,"_5":17474,"_23043":100744,"_2395":100805},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2868":59466,"_25194":59444,"_17578":100807,"_5":17474,"_23043":100744,"_2395":100808},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2868":59467,"_25194":59444,"_17578":100810,"_5":17474,"_23043":100744,"_2395":100811},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2868":59468,"_25194":59444,"_17578":100813,"_5":17474,"_23043":100744,"_2395":100814},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2868":59469,"_25194":59444,"_17578":100816,"_5":17474,"_23043":100748,"_2395":100817},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2868":59470,"_25194":59444,"_17578":100819,"_5":17474,"_23043":100748,"_2395":45738},[],{"_2868":59471,"_25194":59444,"_17578":100821,"_5":17474,"_23043":100748,"_2395":100822},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2868":59472,"_25194":59444,"_17578":100824,"_5":17474,"_23043":100748,"_2395":100825},[],"**Icon** y **Tags**: clasificación opcional.",{"_2868":59473,"_25194":59444,"_17578":100827,"_5":17474,"_23043":100748,"_2395":100828},[],"Confirma el registro.",{"_2868":59474,"_25194":59444,"_17578":100830,"_5":17474,"_23043":100752,"_2395":100831},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2868":59475,"_25194":59444,"_17578":100833,"_5":17474,"_23043":100752,"_2395":100834},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2868":59476,"_25194":59444,"_17578":100836,"_5":17474,"_23043":100756,"_2395":100837},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2868":59477,"_25194":59444,"_17578":100839,"_5":17474,"_23043":100756,"_2395":100840},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2868":59478,"_25194":59444,"_17578":100842,"_5":17474,"_23043":100760,"_2395":100843},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2868":59479,"_25194":59444,"_17578":100845,"_5":17474,"_23043":100760,"_2395":100846},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2868":59480,"_25194":59444,"_17578":100848,"_5":17474,"_23043":100764,"_2395":100699},[],{"_2868":59481,"_25194":59444,"_17578":100850,"_5":17474,"_23043":100764,"_2395":100851},[],"Resultado",{"_2868":59482,"_25194":59444,"_17578":100853,"_5":17474,"_23043":100764,"_2395":100854},[],"Dispositivo",{"_2868":59483,"_25194":59444,"_17578":100856,"_5":17474,"_23043":100764,"_2395":100857},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2868":59484,"_25194":59444,"_17578":100859,"_5":17474,"_23043":100764,"_2395":100860},[],"Identidad actual",{"_2868":59485,"_25194":59444,"_17578":100862,"_5":17474,"_23043":100764,"_2395":100863},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2868":59486,"_25194":59444,"_17578":100865,"_5":17474,"_23043":100764,"_2395":100866},[],"Historial",{"_2868":59487,"_25194":59444,"_17578":100868,"_5":17474,"_23043":100764,"_2395":100869},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2868":59488,"_25194":59444,"_17578":100871,"_5":17474,"_23043":100764,"_2395":100872},[],"Clave y certificado",{"_2868":59489,"_25194":59444,"_17578":100874,"_5":17474,"_23043":100764,"_2395":100875},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2868":59490,"_25194":59444,"_17578":100877,"_5":17474,"_23043":100767,"_2395":100878},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2868":59491,"_25194":59444,"_17578":100880,"_5":17474,"_23043":100767,"_2395":100881},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2868":59492,"_25194":59444,"_17578":100883,"_5":17474,"_23043":100767,"_2395":100884},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2868":59493,"_25194":59444,"_17578":100886,"_5":17474,"_23043":100767,"_2395":100887},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2868":59494,"_25194":59444,"_17578":100889,"_5":17474,"_23043":100771,"_2395":100890},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2868":59495,"_25194":59444,"_17578":100892,"_5":17474,"_23043":100771,"_2395":100893},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2868":59496,"_25194":59444,"_17578":100895,"_5":17474,"_23043":100771,"_2395":100896},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2868":59497,"_25194":59497,"_5":12321,"_2395":100898,"_25530":100899,"_17578":100900,"_23043":59497},"Plataforma Lamassu IoT",[40934,97461],[],{"_2868":59498,"_25194":59497,"_17578":100902,"_5":17474,"_23043":59497,"_2395":100903},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2868":59499,"_25194":59497,"_5":25527,"_17578":100905,"_23043":100906,"_2395":100396},[],"/docs/pr-preview/pr-39/es/platform/overview#empieza-aquí",{"_2868":59500,"_25194":59497,"_5":25527,"_17578":100908,"_23043":100909,"_2395":100910},[],"/docs/pr-preview/pr-39/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2868":59501,"_25194":59497,"_5":25527,"_17578":100912,"_23043":100913,"_2395":100914},[],"/docs/pr-preview/pr-39/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2868":59502,"_25194":59497,"_5":25527,"_17578":100916,"_23043":100917,"_2395":100918},[],"/docs/pr-preview/pr-39/es/platform/overview#capacidades-principales","Capacidades principales",{"_2868":59503,"_25194":59497,"_5":25527,"_17578":100920,"_23043":100921,"_2395":100922},[],"/docs/pr-preview/pr-39/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2868":59504,"_25194":59497,"_5":25527,"_17578":100924,"_23043":100925,"_2395":100926},[],"/docs/pr-preview/pr-39/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2868":59505,"_25194":59497,"_5":25527,"_17578":100928,"_23043":100929,"_2395":100930},[],"/docs/pr-preview/pr-39/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2868":59506,"_25194":59497,"_5":25527,"_17578":100932,"_23043":100933,"_2395":100934},[],"/docs/pr-preview/pr-39/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2868":59507,"_25194":59497,"_5":25527,"_17578":100936,"_23043":100937,"_2395":100938},[],"/docs/pr-preview/pr-39/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2868":59508,"_25194":59497,"_5":25527,"_17578":100940,"_23043":100941,"_2395":100942},[],"/docs/pr-preview/pr-39/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2868":59509,"_25194":59497,"_5":25527,"_17578":100944,"_23043":100945,"_2395":100946},[],"/docs/pr-preview/pr-39/es/platform/overview#referencia-operativa","Referencia operativa",{"_2868":59510,"_25194":59497,"_17578":100948,"_5":17474,"_23043":59497,"_2395":100949},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2868":59511,"_25194":59497,"_17578":100951,"_5":17474,"_23043":100906,"_2395":100952},[],"Elige el resultado que necesitas obtener:",{"_2868":59512,"_25194":59497,"_17578":100954,"_5":17474,"_23043":100906,"_2395":100955},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2868":59513,"_25194":59497,"_17578":100957,"_5":17474,"_23043":100906,"_2395":100958},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2868":59514,"_25194":59497,"_17578":100960,"_5":17474,"_23043":100906,"_2395":100961},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2868":59515,"_25194":59497,"_17578":100963,"_5":17474,"_23043":100909,"_2395":100964},[],"Bloque",{"_2868":59516,"_25194":59497,"_17578":100966,"_5":17474,"_23043":100909,"_2395":100967},[],"Qué gestionas",{"_2868":59517,"_25194":59497,"_17578":100969,"_5":17474,"_23043":100909,"_2395":100970},[],"Punto de entrada",{"_2868":59518,"_25194":59497,"_17578":100972,"_5":17474,"_23043":100909,"_2395":45892},[],{"_2868":59519,"_25194":59497,"_17578":100974,"_5":17474,"_23043":100909,"_2395":100975},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2868":59520,"_25194":59497,"_17578":100977,"_5":17474,"_23043":100909,"_2395":100978},[],"Visión general de PKI",{"_2868":59521,"_25194":59497,"_17578":100980,"_5":17474,"_23043":100909,"_2395":45901},[],{"_2868":59522,"_25194":59497,"_17578":100982,"_5":17474,"_23043":100909,"_2395":100983},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2868":59523,"_25194":59497,"_17578":100985,"_5":17474,"_23043":100909,"_2395":100986},[],"Visión general de IoT Fleets",{"_2868":59524,"_25194":59497,"_17578":100988,"_5":17474,"_23043":100909,"_2395":100989},[],"**Administración**",{"_2868":59525,"_25194":59497,"_17578":100991,"_5":17474,"_23043":100909,"_2395":100992},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2868":59526,"_25194":59497,"_17578":100994,"_5":17474,"_23043":100909,"_2395":97459},[],{"_2868":59527,"_25194":59497,"_17578":100996,"_5":17474,"_23043":100909,"_2395":100997},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2868":59528,"_25194":59497,"_17578":100999,"_5":17474,"_23043":100913,"_2395":101000},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2868":59529,"_25194":59497,"_17578":101002,"_5":17474,"_23043":100913,"_2395":101003},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2868":59530,"_25194":59497,"_17578":101005,"_5":17474,"_23043":100913,"_2395":101006},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2868":59531,"_25194":59497,"_17578":101008,"_5":17474,"_23043":100913,"_2395":101009},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2868":59532,"_25194":59497,"_17578":101011,"_5":17474,"_23043":100913,"_2395":101012},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2868":59533,"_25194":59497,"_17578":101014,"_5":17474,"_23043":100913,"_2395":101015},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2868":59534,"_25194":59497,"_17578":101017,"_5":17474,"_23043":100921,"_2395":101018},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2868":59535,"_25194":59497,"_17578":101020,"_5":17474,"_23043":100925,"_2395":101021},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2868":59536,"_25194":59497,"_17578":101023,"_5":17474,"_23043":100929,"_2395":101024},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2868":59537,"_25194":59497,"_17578":101026,"_5":17474,"_23043":100933,"_2395":101027},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2868":59538,"_25194":59497,"_17578":101029,"_5":17474,"_23043":100937,"_2395":101030},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2868":59539,"_25194":59497,"_17578":101032,"_5":17474,"_23043":100941,"_2395":101033},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2868":59540,"_25194":59497,"_17578":101035,"_5":17474,"_23043":100945,"_2395":100489},[],{"_2868":59541,"_25194":59497,"_17578":101037,"_5":17474,"_23043":100945,"_2395":101038},[],"Qué prepara o comprueba",{"_2868":59542,"_25194":59497,"_17578":101040,"_5":17474,"_23043":100945,"_2395":100492},[],{"_2868":59543,"_25194":59497,"_17578":101042,"_5":17474,"_23043":100945,"_2395":101043},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2868":59544,"_25194":59497,"_17578":101045,"_5":17474,"_23043":100945,"_2395":101046},[],"Administrador de la flota",{"_2868":59545,"_25194":59497,"_17578":101048,"_5":17474,"_23043":100945,"_2395":101049},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2868":59546,"_25194":59497,"_17578":101051,"_5":17474,"_23043":100945,"_2395":100504},[],{"_2868":59547,"_25194":59497,"_17578":101053,"_5":17474,"_23043":100945,"_2395":101054},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2868":59548,"_25194":59497,"_17578":101056,"_5":17474,"_23043":100945,"_2395":100510},[],{"_2868":59549,"_25194":59497,"_17578":101058,"_5":17474,"_23043":100945,"_2395":101059},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2868":59550,"_25194":59497,"_17578":101061,"_5":17474,"_23043":100945,"_2395":101062},[],"Operador de infraestructura",{"_2868":59551,"_25194":59497,"_17578":101064,"_5":17474,"_23043":100945,"_2395":101065},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2868":59552,"_25194":59497,"_17578":101067,"_5":17474,"_23043":100945,"_2395":101068},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2868":59553,"_25194":59553,"_5":12321,"_2395":101070,"_25530":101071,"_17578":101073,"_23043":59553},"Jerarquía y rotación de CAs",[40934,97461,45993,101072],"Claves, autoridades y certificados",[],{"_2868":59554,"_25194":59553,"_17578":101075,"_5":17474,"_23043":59553,"_2395":101076},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2868":59555,"_25194":59553,"_5":25527,"_17578":101078,"_23043":101079,"_2395":101080},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2868":59556,"_25194":59553,"_5":25527,"_17578":101082,"_23043":101083,"_2395":101084},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2868":59557,"_25194":59553,"_5":25527,"_17578":101086,"_23043":101087,"_2395":101088},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2868":59558,"_25194":59553,"_5":25527,"_17578":101090,"_23043":101091,"_2395":101092},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2868":59559,"_25194":59553,"_5":25527,"_17578":101094,"_23043":101095,"_2395":101096},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2868":59560,"_25194":59553,"_5":25527,"_17578":101098,"_23043":101099,"_2395":101100},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2868":59561,"_25194":59553,"_5":25527,"_17578":101102,"_23043":101103,"_2395":101104},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2868":59562,"_25194":59553,"_5":25527,"_17578":101106,"_23043":101107,"_2395":101108},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2868":59563,"_25194":59553,"_5":25527,"_17578":101110,"_23043":101111,"_2395":101112},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2868":59564,"_25194":59553,"_5":25527,"_17578":101114,"_23043":101115,"_2395":101116},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2868":59565,"_25194":59553,"_5":25527,"_17578":101118,"_23043":101119,"_2395":101120},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2868":59566,"_25194":59553,"_5":25527,"_17578":101122,"_23043":101123,"_2395":101124},[],"/docs/pr-preview/pr-39/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2868":59567,"_25194":59553,"_17578":101126,"_5":17474,"_23043":59553,"_2395":101127},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2868":59568,"_25194":59553,"_17578":101129,"_5":17474,"_23043":59553,"_2395":101130},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2868":59569,"_25194":59553,"_17578":101132,"_5":17474,"_23043":101079,"_2395":101133},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2868":59570,"_25194":59553,"_17578":101135,"_5":17474,"_23043":101079,"_2395":101136},[],"entorno, como producción y preproducción;",{"_2868":59571,"_25194":59553,"_17578":101138,"_5":17474,"_23043":101079,"_2395":101139},[],"propietario o equipo operador;",{"_2868":59572,"_25194":59553,"_17578":101141,"_5":17474,"_23043":101079,"_2395":101142},[],"familia de dispositivos o proceso de fabricación;",{"_2868":59573,"_25194":59553,"_17578":101144,"_5":17474,"_23043":101079,"_2395":101145},[],"región o requisito regulatorio;",{"_2868":59574,"_25194":59553,"_17578":101147,"_5":17474,"_23043":101079,"_2395":101148},[],"motor criptográfico o política de clave;",{"_2868":59575,"_25194":59553,"_17578":101150,"_5":17474,"_23043":101079,"_2395":101151},[],"ventana de mantenimiento y ritmo de renovación.",{"_2868":59576,"_25194":59553,"_17578":101153,"_5":17474,"_23043":101079,"_2395":101154},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2868":59577,"_25194":59553,"_17578":101156,"_5":17474,"_23043":101079,"_2395":101157},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2868":59578,"_25194":59553,"_17578":101159,"_5":17474,"_23043":101083,"_2395":101160},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2868":59579,"_25194":59553,"_17578":101162,"_5":17474,"_23043":101083,"_2395":101163},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2868":59580,"_25194":59553,"_17578":101165,"_5":17474,"_23043":101083,"_2395":101166},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2868":59581,"_25194":59553,"_17578":101168,"_5":17474,"_23043":101087,"_2395":101169},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2868":59582,"_25194":59553,"_17578":101171,"_5":17474,"_23043":101087,"_2395":101172},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2868":59583,"_25194":59553,"_17578":101174,"_5":17474,"_23043":101087,"_2395":101175},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2868":59584,"_25194":59553,"_17578":101177,"_5":17474,"_23043":101087,"_2395":101178},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2868":59585,"_25194":59553,"_17578":101180,"_5":17474,"_23043":101095,"_2395":101181},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2868":59586,"_25194":59553,"_17578":101183,"_5":17474,"_23043":101099,"_2395":101184},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2868":59587,"_25194":59553,"_17578":101186,"_5":17474,"_23043":101103,"_2395":101187},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2868":59588,"_25194":59553,"_17578":101189,"_5":17474,"_23043":101107,"_2395":101190},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2868":59589,"_25194":59553,"_17578":101192,"_5":17474,"_23043":101111,"_2395":101193},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2868":59590,"_25194":59553,"_17578":101195,"_5":17474,"_23043":101115,"_2395":101196},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2868":59591,"_25194":59553,"_17578":101198,"_5":17474,"_23043":101119,"_2395":101199},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2868":59592,"_25194":59553,"_17578":101201,"_5":17474,"_23043":101119,"_2395":101202},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2868":59593,"_25194":59553,"_17578":101204,"_5":17474,"_23043":101119,"_2395":101205},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2868":59594,"_25194":59553,"_17578":101207,"_5":17474,"_23043":101119,"_2395":101208},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2868":59595,"_25194":59553,"_17578":101210,"_5":17474,"_23043":101123,"_2395":101211},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2868":59596,"_25194":59553,"_17578":101213,"_5":17474,"_23043":101123,"_2395":101214},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2868":59597,"_25194":59553,"_17578":101216,"_5":17474,"_23043":101123,"_2395":101217},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2868":59598,"_25194":59553,"_17578":101219,"_5":17474,"_23043":101123,"_2395":101220},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2868":59599,"_25194":59553,"_17578":101222,"_5":17474,"_23043":101123,"_2395":101223},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2868":59600,"_25194":59553,"_17578":101225,"_5":17474,"_23043":101123,"_2395":101226},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2868":59601,"_25194":59553,"_17578":101228,"_5":17474,"_23043":101123,"_2395":101229},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2868":59602,"_25194":59602,"_5":12321,"_2395":101231,"_25530":101232,"_17578":101233,"_23043":59602},"Autoridades de certificación",[40934,97461,45993,101072],[],{"_2868":59603,"_25194":59602,"_17578":101235,"_5":17474,"_23043":59602,"_2395":101236},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2868":59604,"_25194":59602,"_5":25527,"_17578":101238,"_23043":101239,"_2395":101240},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2868":59605,"_25194":59602,"_5":25527,"_17578":101242,"_23043":101243,"_2395":101244},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2868":59606,"_25194":59602,"_5":25527,"_17578":101246,"_23043":101247,"_2395":96162},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2868":59607,"_25194":59602,"_5":25527,"_17578":101249,"_23043":101250,"_2395":101251},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2868":59608,"_25194":59602,"_5":25527,"_17578":101253,"_23043":101254,"_2395":101255},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2868":59609,"_25194":59602,"_5":25527,"_17578":101257,"_23043":101258,"_2395":101259},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2868":59610,"_25194":59602,"_5":25527,"_17578":101261,"_23043":101262,"_2395":101263},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2868":59611,"_25194":59602,"_5":25527,"_17578":101265,"_23043":101266,"_2395":101267},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2868":59612,"_25194":59602,"_5":25527,"_17578":101269,"_23043":101270,"_2395":101271},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2868":59613,"_25194":59602,"_5":25527,"_17578":101273,"_23043":101274,"_2395":101275},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2868":59614,"_25194":59602,"_5":25527,"_17578":101277,"_23043":101278,"_2395":101279},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2868":59615,"_25194":59602,"_5":25527,"_17578":101281,"_23043":101282,"_2395":101283},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2868":59616,"_25194":59602,"_5":25527,"_17578":101285,"_23043":101286,"_2395":101287},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2868":59617,"_25194":59602,"_5":25527,"_17578":101289,"_23043":101290,"_2395":101291},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2868":59618,"_25194":59602,"_5":25527,"_17578":101293,"_23043":101294,"_2395":101295},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2868":59619,"_25194":59602,"_5":25527,"_17578":101297,"_23043":101298,"_2395":101299},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2868":59620,"_25194":59602,"_5":25527,"_17578":101301,"_23043":101302,"_2395":101303},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2868":59621,"_25194":59602,"_5":25527,"_17578":101305,"_23043":101306,"_2395":101307},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2868":59622,"_25194":59602,"_5":25527,"_17578":101309,"_23043":101310,"_2395":101311},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2868":59623,"_25194":59602,"_5":25527,"_17578":101313,"_23043":101314,"_2395":101315},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2868":59624,"_25194":59602,"_5":25527,"_17578":101317,"_23043":101318,"_2395":101319},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2868":59625,"_25194":59602,"_5":25527,"_17578":101321,"_23043":101322,"_2395":101323},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2868":59626,"_25194":59602,"_17578":101325,"_5":17474,"_23043":59602,"_2395":101326},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2868":59627,"_25194":59602,"_17578":101328,"_5":17474,"_23043":59602,"_2395":101329},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2868":59628,"_25194":59602,"_17578":101331,"_5":17474,"_23043":59602,"_2395":101332},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2868":59629,"_25194":59602,"_17578":101334,"_5":17474,"_23043":101239,"_2395":101335},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2868":59630,"_25194":59602,"_17578":101337,"_5":17474,"_23043":101239,"_2395":101338},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2868":59631,"_25194":59602,"_17578":101340,"_5":17474,"_23043":101239,"_2395":101341},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2868":59632,"_25194":59602,"_17578":101343,"_5":17474,"_23043":101239,"_2395":101344},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2868":59633,"_25194":59602,"_17578":101346,"_5":17474,"_23043":101239,"_2395":101347},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2868":59634,"_25194":59602,"_17578":101349,"_5":17474,"_23043":101247,"_2395":101350},[],"Decide si la CA será raíz o intermedia.",{"_2868":59635,"_25194":59602,"_17578":101352,"_5":17474,"_23043":101247,"_2395":101353},[],"Elige el motor que custodiará la clave.",{"_2868":59636,"_25194":59602,"_17578":101355,"_5":17474,"_23043":101247,"_2395":101356},[],"Define una validez superior a la de los certificados que emitirá.",{"_2868":59637,"_25194":59602,"_17578":101358,"_5":17474,"_23043":101247,"_2395":101359},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2868":59638,"_25194":59602,"_17578":101361,"_5":17474,"_23043":101250,"_2395":101362},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2868":59639,"_25194":59602,"_17578":101364,"_5":17474,"_23043":101254,"_2395":101365},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2868":59640,"_25194":59602,"_17578":101367,"_5":17474,"_23043":101254,"_2395":101368},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2868":59641,"_25194":59602,"_17578":101370,"_5":17474,"_23043":101258,"_2395":101371},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2868":59642,"_25194":59602,"_17578":101373,"_5":17474,"_23043":101262,"_2395":101374},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2868":59643,"_25194":59602,"_17578":101376,"_5":17474,"_23043":101262,"_2395":101377},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2868":59644,"_25194":59602,"_17578":101379,"_5":17474,"_23043":101262,"_2395":101380},[],"`ST`: estado o provincia.",{"_2868":59645,"_25194":59602,"_17578":101382,"_5":17474,"_23043":101262,"_2395":101383},[],"`L`: localidad.",{"_2868":59646,"_25194":59602,"_17578":101385,"_5":17474,"_23043":101262,"_2395":101386},[],"`O`: organización.",{"_2868":59647,"_25194":59602,"_17578":101388,"_5":17474,"_23043":101262,"_2395":101389},[],"`OU`: unidad organizativa.",{"_2868":59648,"_25194":59602,"_17578":101391,"_5":17474,"_23043":101262,"_2395":101392},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2868":59649,"_25194":59602,"_17578":101394,"_5":17474,"_23043":101266,"_2395":101395},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2868":59650,"_25194":59602,"_17578":101397,"_5":17474,"_23043":101266,"_2395":101398},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2868":59651,"_25194":59602,"_17578":101400,"_5":17474,"_23043":101270,"_2395":101401},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2868":59652,"_25194":59602,"_17578":101403,"_5":17474,"_23043":101270,"_2395":101404},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2868":59653,"_25194":59602,"_17578":101406,"_5":17474,"_23043":101274,"_2395":101407},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2868":59654,"_25194":59602,"_17578":101409,"_5":17474,"_23043":101274,"_2395":101410},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2868":59655,"_25194":59602,"_17578":101412,"_5":17474,"_23043":101278,"_2395":101413},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2868":59656,"_25194":59602,"_17578":101415,"_5":17474,"_23043":101282,"_2395":101416},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2868":59657,"_25194":59602,"_17578":101418,"_5":17474,"_23043":101286,"_2395":101419},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2868":59658,"_25194":59602,"_17578":101421,"_5":17474,"_23043":101290,"_2395":101422},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2868":59659,"_25194":59602,"_17578":101424,"_5":17474,"_23043":101294,"_2395":101425},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2868":59660,"_25194":59602,"_17578":101427,"_5":17474,"_23043":101294,"_2395":101428},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2868":59661,"_25194":59602,"_17578":101430,"_5":17474,"_23043":101298,"_2395":101431},[],"Abre una CA desde el inventario para consultar:",{"_2868":59662,"_25194":59602,"_17578":101433,"_5":17474,"_23043":101298,"_2395":101434},[],"Estado y periodo de validez.",{"_2868":59663,"_25194":59602,"_17578":101436,"_5":17474,"_23043":101298,"_2395":101437},[],"Certificado y cadena en formato PEM.",{"_2868":59664,"_25194":59602,"_17578":101439,"_5":17474,"_23043":101298,"_2395":101440},[],"Número de certificados activos, expirados y revocados.",{"_2868":59665,"_25194":59602,"_17578":101442,"_5":17474,"_23043":101298,"_2395":101443},[],"Certificados emitidos en **Issued Certificates**.",{"_2868":59666,"_25194":59602,"_17578":101445,"_5":17474,"_23043":101298,"_2395":101446},[],"CRL vinculada a la autoridad.",{"_2868":59667,"_25194":59602,"_17578":101448,"_5":17474,"_23043":101298,"_2395":101449},[],"Metadatos y motor criptográfico asociado.",{"_2868":59668,"_25194":59602,"_17578":101451,"_5":17474,"_23043":101298,"_2395":101452},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2868":59669,"_25194":59602,"_17578":101454,"_5":17474,"_23043":101302,"_2395":101455},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2868":59670,"_25194":59602,"_17578":101457,"_5":17474,"_23043":101302,"_2395":101458},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2868":59671,"_25194":59602,"_17578":101460,"_5":17474,"_23043":101302,"_2395":101461},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2868":59672,"_25194":59602,"_17578":101463,"_5":17474,"_23043":101302,"_2395":101464},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2868":59673,"_25194":59602,"_17578":101466,"_5":17474,"_23043":101306,"_2395":101467},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2868":59674,"_25194":59602,"_17578":101469,"_5":17474,"_23043":101310,"_2395":101470},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2868":59675,"_25194":59602,"_17578":101472,"_5":17474,"_23043":101314,"_2395":101473},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2868":59676,"_25194":59602,"_17578":101475,"_5":17474,"_23043":101318,"_2395":101476},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2868":59677,"_25194":59602,"_17578":101478,"_5":17474,"_23043":101322,"_2395":101479},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2868":59678,"_25194":59602,"_17578":101481,"_5":17474,"_23043":101322,"_2395":101482},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2868":59679,"_25194":59679,"_5":12321,"_2395":101484,"_25530":101485,"_17578":101486,"_23043":59679},"Perfiles de certificado",[40934,97461,45993,101072],[],{"_2868":59680,"_25194":59679,"_17578":101488,"_5":17474,"_23043":59679,"_2395":101489},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2868":59681,"_25194":59679,"_5":25527,"_17578":101491,"_23043":101492,"_2395":101493},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2868":59682,"_25194":59679,"_5":25527,"_17578":101495,"_23043":101496,"_2395":101497},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#validez","Validez",{"_2868":59683,"_25194":59679,"_5":25527,"_17578":101499,"_23043":101500,"_2395":101501},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2868":59684,"_25194":59679,"_5":25527,"_17578":101503,"_23043":101504,"_2395":101505},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2868":59685,"_25194":59679,"_5":25527,"_17578":101507,"_23043":101508,"_2395":101509},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2868":59686,"_25194":59679,"_5":25527,"_17578":101511,"_23043":101512,"_2395":101513},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2868":59687,"_25194":59679,"_5":25527,"_17578":101515,"_23043":101516,"_2395":101517},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2868":59688,"_25194":59679,"_5":25527,"_17578":101519,"_23043":101520,"_2395":101521},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2868":59689,"_25194":59679,"_5":25527,"_17578":101523,"_23043":101524,"_2395":101525},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2868":59690,"_25194":59679,"_5":25527,"_17578":101527,"_23043":101528,"_2395":101529},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2868":59691,"_25194":59679,"_5":25527,"_17578":101531,"_23043":101532,"_2395":101533},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2868":59692,"_25194":59679,"_5":25527,"_17578":101535,"_23043":101536,"_2395":101537},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2868":59693,"_25194":59679,"_5":25527,"_17578":101539,"_23043":101540,"_2395":101541},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2868":59694,"_25194":59679,"_5":25527,"_17578":101543,"_23043":101544,"_2395":101545},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2868":59695,"_25194":59679,"_5":25527,"_17578":101547,"_23043":101548,"_2395":101549},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2868":59696,"_25194":59679,"_5":25527,"_17578":101551,"_23043":101552,"_2395":101553},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2868":59697,"_25194":59679,"_17578":101555,"_5":17474,"_23043":59679,"_2395":101556},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2868":59698,"_25194":59679,"_17578":101558,"_5":17474,"_23043":59679,"_2395":101559},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2868":59699,"_25194":59679,"_17578":101561,"_5":17474,"_23043":101496,"_2395":101562},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2868":59700,"_25194":59679,"_17578":101564,"_5":17474,"_23043":101496,"_2395":101565},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2868":59701,"_25194":59679,"_17578":101567,"_5":17474,"_23043":101500,"_2395":101568},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2868":59702,"_25194":59679,"_17578":101570,"_5":17474,"_23043":101504,"_2395":101571},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2868":59703,"_25194":59679,"_17578":101573,"_5":17474,"_23043":101504,"_2395":101574},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2868":59704,"_25194":59679,"_17578":101576,"_5":17474,"_23043":101504,"_2395":101577},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2868":59705,"_25194":59679,"_17578":101579,"_5":17474,"_23043":101508,"_2395":101580},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2868":59706,"_25194":59679,"_17578":101582,"_5":17474,"_23043":101512,"_2395":101583},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2868":59707,"_25194":59679,"_17578":101585,"_5":17474,"_23043":101512,"_2395":101586},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2868":59708,"_25194":59679,"_17578":101588,"_5":17474,"_23043":101516,"_2395":101589},[],"La aplicación criptográfica puede:",{"_2868":59709,"_25194":59679,"_17578":101591,"_5":17474,"_23043":101516,"_2395":101592},[],"permitir o bloquear claves RSA;",{"_2868":59710,"_25194":59679,"_17578":101594,"_5":17474,"_23043":101516,"_2395":101595},[],"limitar los tamaños RSA admitidos;",{"_2868":59711,"_25194":59679,"_17578":101597,"_5":17474,"_23043":101516,"_2395":101598},[],"permitir o bloquear claves ECDSA;",{"_2868":59712,"_25194":59679,"_17578":101600,"_5":17474,"_23043":101516,"_2395":101601},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2868":59713,"_25194":59679,"_17578":101603,"_5":17474,"_23043":101516,"_2395":101604},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2868":59714,"_25194":59679,"_17578":101606,"_5":17474,"_23043":101520,"_2395":101607},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2868":59715,"_25194":59679,"_17578":101609,"_5":17474,"_23043":101520,"_2395":97252},[],{"_2868":59716,"_25194":59679,"_17578":101611,"_5":17474,"_23043":101520,"_2395":101612},[],"Primera opción",{"_2868":59717,"_25194":59679,"_17578":101614,"_5":17474,"_23043":101520,"_2395":101615},[],"Segunda opción",{"_2868":59718,"_25194":59679,"_17578":101617,"_5":17474,"_23043":101520,"_2395":101618},[],"Si no hay ninguna",{"_2868":59719,"_25194":59679,"_17578":101620,"_5":17474,"_23043":101520,"_2395":101621},[],"Firma directa con una CA",{"_2868":59720,"_25194":59679,"_17578":101623,"_5":17474,"_23043":101520,"_2395":101624},[],"`issuance_profile` incluido en la solicitud",{"_2868":59721,"_25194":59679,"_17578":101626,"_5":17474,"_23043":101520,"_2395":101627},[],"`issuance_profile_id` de la solicitud",{"_2868":59722,"_25194":59679,"_17578":101629,"_5":17474,"_23043":101520,"_2395":101630},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2868":59723,"_25194":59679,"_17578":101632,"_5":17474,"_23043":101520,"_2395":101633},[],"Emisión mediante DMS",{"_2868":59724,"_25194":59679,"_17578":101635,"_5":17474,"_23043":101520,"_2395":46558},[],{"_2868":59725,"_25194":59679,"_17578":101637,"_5":17474,"_23043":101520,"_2395":101638},[],"`settings.issuance_profile` incluido en el DMS",{"_2868":59726,"_25194":59679,"_17578":101640,"_5":17474,"_23043":101520,"_2395":101641},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2868":59727,"_25194":59679,"_17578":101643,"_5":17474,"_23043":101520,"_2395":101644},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2868":59728,"_25194":59679,"_17578":101646,"_5":17474,"_23043":101520,"_2395":101647},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2868":59729,"_25194":59679,"_17578":101649,"_5":17474,"_23043":101528,"_2395":101650},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2868":59730,"_25194":59679,"_17578":101652,"_5":17474,"_23043":101532,"_2395":101653},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2868":59731,"_25194":59679,"_17578":101655,"_5":17474,"_23043":101536,"_2395":101656},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2868":59732,"_25194":59679,"_17578":101658,"_5":17474,"_23043":101540,"_2395":101659},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2868":59733,"_25194":59679,"_17578":101661,"_5":17474,"_23043":101544,"_2395":101662},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2868":59734,"_25194":59679,"_17578":101664,"_5":17474,"_23043":101544,"_2395":101665},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2868":59735,"_25194":59679,"_17578":101667,"_5":17474,"_23043":101548,"_2395":101668},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2868":59736,"_25194":59679,"_17578":101670,"_5":17474,"_23043":101548,"_2395":101671},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2868":59737,"_25194":59679,"_17578":101673,"_5":17474,"_23043":101548,"_2395":101674},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2868":59738,"_25194":59679,"_17578":101676,"_5":17474,"_23043":101548,"_2395":101677},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2868":59739,"_25194":59679,"_17578":101679,"_5":17474,"_23043":101552,"_2395":101680},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2868":59740,"_25194":59679,"_17578":101682,"_5":17474,"_23043":101552,"_2395":101683},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2868":59741,"_25194":59741,"_5":12321,"_2395":101685,"_25530":101686,"_17578":101688,"_23043":59741},"Validación de certificados",[40934,97461,45993,101687],"Validación",[],{"_2868":59742,"_25194":59741,"_17578":101690,"_5":17474,"_23043":59741,"_2395":101691},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2868":59743,"_25194":59741,"_5":25527,"_17578":101693,"_23043":101694,"_2395":101695},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2868":59744,"_25194":59741,"_5":25527,"_17578":101697,"_23043":101698,"_2395":101699},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2868":59745,"_25194":59741,"_5":25527,"_17578":101701,"_23043":101702,"_2395":101703},[],"/docs/pr-preview/pr-39/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2868":59746,"_25194":59741,"_17578":101705,"_5":17474,"_23043":59741,"_2395":101706},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2868":59747,"_25194":59741,"_17578":101708,"_5":17474,"_23043":101694,"_2395":101709},[],"Verifica estos criterios juntos:",{"_2868":59748,"_25194":59741,"_17578":101711,"_5":17474,"_23043":101694,"_2395":100699},[],{"_2868":59749,"_25194":59741,"_17578":101713,"_5":17474,"_23043":101694,"_2395":101714},[],"Resultado necesario",{"_2868":59750,"_25194":59741,"_17578":101716,"_5":17474,"_23043":101694,"_2395":101717},[],"Cadena y firma",{"_2868":59751,"_25194":59741,"_17578":101719,"_5":17474,"_23043":101694,"_2395":101720},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2868":59752,"_25194":59741,"_17578":101722,"_5":17474,"_23043":101694,"_2395":101723},[],"Fechas",{"_2868":59753,"_25194":59741,"_17578":101725,"_5":17474,"_23043":101694,"_2395":101726},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2868":59754,"_25194":59741,"_17578":101728,"_5":17474,"_23043":101694,"_2395":97165},[],{"_2868":59755,"_25194":59741,"_17578":101730,"_5":17474,"_23043":101694,"_2395":101731},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2868":59756,"_25194":59741,"_17578":101733,"_5":17474,"_23043":101694,"_2395":101734},[],"Uso",{"_2868":59757,"_25194":59741,"_17578":101736,"_5":17474,"_23043":101694,"_2395":101737},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2868":59758,"_25194":59741,"_17578":101739,"_5":17474,"_23043":101694,"_2395":101740},[],"Revocación",{"_2868":59759,"_25194":59741,"_17578":101742,"_5":17474,"_23043":101694,"_2395":101743},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2868":59760,"_25194":59741,"_17578":101745,"_5":17474,"_23043":101694,"_2395":101746},[],"Autorización",{"_2868":59761,"_25194":59741,"_17578":101748,"_5":17474,"_23043":101694,"_2395":101749},[],"La aplicación permite la acción a esa identidad.",{"_2868":59762,"_25194":59741,"_17578":101751,"_5":17474,"_23043":101694,"_2395":101752},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2868":59763,"_25194":59741,"_17578":101754,"_5":17474,"_23043":101698,"_2395":101755},[],"Mecanismo",{"_2868":59764,"_25194":59741,"_17578":101757,"_5":17474,"_23043":101698,"_2395":101758},[],"Cuándo utilizarlo",{"_2868":59765,"_25194":59741,"_17578":101760,"_5":17474,"_23043":101698,"_2395":101761},[],"Qué debes mantener",{"_2868":59766,"_25194":59741,"_17578":101763,"_5":17474,"_23043":101698,"_2395":46686},[],{"_2868":59767,"_25194":59741,"_17578":101765,"_5":17474,"_23043":101698,"_2395":101766},[],"Consulta del estado de un certificado concreto.",{"_2868":59768,"_25194":59741,"_17578":101768,"_5":17474,"_23043":101698,"_2395":101769},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2868":59769,"_25194":59741,"_17578":101771,"_5":17474,"_23043":101698,"_2395":46695},[],{"_2868":59770,"_25194":59741,"_17578":101773,"_5":17474,"_23043":101698,"_2395":101774},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2868":59771,"_25194":59741,"_17578":101776,"_5":17474,"_23043":101698,"_2395":101777},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2868":59772,"_25194":59741,"_17578":101779,"_5":17474,"_23043":101698,"_2395":101780},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2868":59773,"_25194":59741,"_17578":101782,"_5":17474,"_23043":101698,"_2395":101783},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2868":59774,"_25194":59741,"_17578":101785,"_5":17474,"_23043":101702,"_2395":101786},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2868":59775,"_25194":59741,"_17578":101788,"_5":17474,"_23043":101702,"_2395":101789},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2868":59776,"_25194":59741,"_17578":101791,"_5":17474,"_23043":101702,"_2395":101792},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2868":59777,"_25194":59741,"_17578":101794,"_5":17474,"_23043":101702,"_2395":101795},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2868":59778,"_25194":59741,"_17578":101797,"_5":17474,"_23043":101702,"_2395":101798},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2868":59779,"_25194":59741,"_17578":101800,"_5":17474,"_23043":101702,"_2395":101801},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2868":59780,"_25194":59741,"_17578":101803,"_5":17474,"_23043":101702,"_2395":101804},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2868":59781,"_25194":59741,"_17578":101806,"_5":17474,"_23043":101702,"_2395":101807},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2868":59782,"_25194":59741,"_17578":101809,"_5":17474,"_23043":101702,"_2395":101810},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2868":59783,"_25194":59783,"_5":12321,"_2395":101812,"_25530":101813,"_17578":101814,"_23043":59783},"Certificados",[40934,97461,45993,101072],[],{"_2868":59784,"_25194":59783,"_17578":101816,"_5":17474,"_23043":59783,"_2395":101817},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2868":59785,"_25194":59783,"_5":25527,"_17578":101819,"_23043":101820,"_2395":101821},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2868":59786,"_25194":59783,"_5":25527,"_17578":101823,"_23043":101824,"_2395":101825},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2868":59787,"_25194":59783,"_5":25527,"_17578":101827,"_23043":101828,"_2395":101829},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2868":59788,"_25194":59783,"_5":25527,"_17578":101831,"_23043":101832,"_2395":101833},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2868":59789,"_25194":59783,"_5":25527,"_17578":101835,"_23043":101836,"_2395":101837},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2868":59790,"_25194":59783,"_5":25527,"_17578":101839,"_23043":101840,"_2395":101841},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2868":59791,"_25194":59783,"_5":25527,"_17578":101843,"_23043":101844,"_2395":101845},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2868":59792,"_25194":59783,"_5":25527,"_17578":101847,"_23043":101848,"_2395":101849},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2868":59793,"_25194":59783,"_5":25527,"_17578":101851,"_23043":101852,"_2395":101853},[],"/docs/pr-preview/pr-39/es/platform/pki/certificates#continúa","Continúa",{"_2868":59794,"_25194":59783,"_17578":101855,"_5":17474,"_23043":59783,"_2395":101856},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2868":59795,"_25194":59783,"_17578":101858,"_5":17474,"_23043":101820,"_2395":101859},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2868":59796,"_25194":59783,"_17578":101861,"_5":17474,"_23043":101820,"_2395":101862},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2868":59797,"_25194":59783,"_17578":101864,"_5":17474,"_23043":101824,"_2395":101865},[],"Descarga el PEM e inspecciónalo:",{"_2868":59798,"_25194":59783,"_17578":101867,"_5":17474,"_23043":101824,"_2395":101868},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2868":59799,"_25194":59783,"_17578":101870,"_5":17474,"_23043":101828,"_2395":101871},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2868":59800,"_25194":59783,"_17578":101873,"_5":17474,"_23043":101828,"_2395":101874},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2868":59801,"_25194":59783,"_17578":101876,"_5":17474,"_23043":101828,"_2395":101877},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2868":59802,"_25194":59783,"_17578":101879,"_5":17474,"_23043":101828,"_2395":101880},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2868":59803,"_25194":59783,"_17578":101882,"_5":17474,"_23043":101828,"_2395":101883},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2868":59804,"_25194":59783,"_17578":101885,"_5":17474,"_23043":101828,"_2395":101886},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2868":59805,"_25194":59783,"_17578":101888,"_5":17474,"_23043":101828,"_2395":101889},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2868":59806,"_25194":59783,"_17578":101891,"_5":17474,"_23043":101832,"_2395":101892},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2868":59807,"_25194":59783,"_17578":101894,"_5":17474,"_23043":101836,"_2395":101895},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2868":59808,"_25194":59783,"_17578":101897,"_5":17474,"_23043":101840,"_2395":101898},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2868":59809,"_25194":59783,"_17578":101900,"_5":17474,"_23043":101844,"_2395":101901},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2868":59810,"_25194":59783,"_17578":101903,"_5":17474,"_23043":101844,"_2395":101904},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2868":59811,"_25194":59783,"_17578":101906,"_5":17474,"_23043":101844,"_2395":101907},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2868":59812,"_25194":59783,"_17578":101909,"_5":17474,"_23043":101848,"_2395":101910},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2868":59813,"_25194":59783,"_17578":101912,"_5":17474,"_23043":101848,"_2395":101913},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2868":59814,"_25194":59783,"_17578":101915,"_5":17474,"_23043":101848,"_2395":101916},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2868":59815,"_25194":59783,"_17578":101918,"_5":17474,"_23043":101852,"_2395":101919},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2868":59816,"_25194":59783,"_17578":101921,"_5":17474,"_23043":101852,"_2395":101922},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2868":59817,"_25194":59817,"_5":12321,"_2395":101924,"_25530":101925,"_17578":101927,"_23043":59817},"Ciclo de vida de un certificado",[40934,97461,45993,101926],"Conceptos",[],{"_2868":59818,"_25194":59817,"_17578":101929,"_5":17474,"_23043":59817,"_2395":101930},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2868":59819,"_25194":59817,"_5":25527,"_17578":101932,"_23043":101933,"_2395":101934},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2868":59820,"_25194":59817,"_5":25527,"_17578":101936,"_23043":101937,"_2395":101938},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2868":59821,"_25194":59817,"_5":25527,"_17578":101940,"_23043":101941,"_2395":101942},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2868":59822,"_25194":59817,"_5":25527,"_17578":101944,"_23043":101945,"_2395":101946},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2868":59823,"_25194":59817,"_5":25527,"_17578":101948,"_23043":101949,"_2395":101950},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2868":59824,"_25194":59817,"_5":25527,"_17578":101952,"_23043":101953,"_2395":101954},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2868":59825,"_25194":59817,"_5":25527,"_17578":101956,"_23043":101957,"_2395":101958},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2868":59826,"_25194":59817,"_5":25527,"_17578":101960,"_23043":101961,"_2395":101962},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2868":59827,"_25194":59817,"_5":25527,"_17578":101964,"_23043":101965,"_2395":101966},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2868":59828,"_25194":59817,"_5":25527,"_17578":101968,"_23043":101969,"_2395":101970},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2868":59829,"_25194":59817,"_17578":101972,"_5":17474,"_23043":59817,"_2395":101973},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2868":59830,"_25194":59817,"_17578":101975,"_5":17474,"_23043":101937,"_2395":101976},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2868":59831,"_25194":59817,"_17578":101978,"_5":17474,"_23043":101941,"_2395":101979},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2868":59832,"_25194":59817,"_17578":101981,"_5":17474,"_23043":101945,"_2395":101982},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2868":59833,"_25194":59817,"_17578":101984,"_5":17474,"_23043":101949,"_2395":101985},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2868":59834,"_25194":59817,"_17578":101987,"_5":17474,"_23043":101953,"_2395":101988},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2868":59835,"_25194":59817,"_17578":101990,"_5":17474,"_23043":101957,"_2395":101991},[],"Lamassu persiste cuatro estados X.509:",{"_2868":59836,"_25194":59817,"_17578":101993,"_5":17474,"_23043":101957,"_2395":101994},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2868":59837,"_25194":59817,"_17578":101996,"_5":17474,"_23043":101957,"_2395":101997},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2868":59838,"_25194":59817,"_17578":101999,"_5":17474,"_23043":101957,"_2395":102000},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2868":59839,"_25194":59817,"_17578":102002,"_5":17474,"_23043":101957,"_2395":102003},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2868":59840,"_25194":59817,"_17578":102005,"_5":17474,"_23043":101957,"_2395":102006},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2868":59841,"_25194":59817,"_17578":102008,"_5":17474,"_23043":101961,"_2395":102009},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2868":59842,"_25194":59817,"_17578":102011,"_5":17474,"_23043":101961,"_2395":102012},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2868":59843,"_25194":59817,"_17578":102014,"_5":17474,"_23043":101961,"_2395":102015},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2868":59844,"_25194":59817,"_17578":102017,"_5":17474,"_23043":101965,"_2395":102018},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2868":59845,"_25194":59817,"_17578":102020,"_5":17474,"_23043":101965,"_2395":102021},[],"Antes de confirmar:",{"_2868":59846,"_25194":59817,"_17578":102023,"_5":17474,"_23043":101965,"_2395":102024},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2868":59847,"_25194":59817,"_17578":102026,"_5":17474,"_23043":101965,"_2395":102027},[],"Distribuye la nueva cadena de confianza.",{"_2868":59848,"_25194":59817,"_17578":102029,"_5":17474,"_23043":101965,"_2395":102030},[],"Reemite las identidades necesarias.",{"_2868":59849,"_25194":59817,"_17578":102032,"_5":17474,"_23043":101965,"_2395":102033},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2868":59850,"_25194":59817,"_17578":102035,"_5":17474,"_23043":101965,"_2395":102036},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2868":59851,"_25194":59817,"_17578":102038,"_5":17474,"_23043":101965,"_2395":102039},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2868":59852,"_25194":59817,"_17578":102041,"_5":17474,"_23043":101969,"_2395":102042},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2868":59853,"_25194":59817,"_17578":102044,"_5":17474,"_23043":101969,"_2395":102045},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2868":59854,"_25194":59817,"_17578":102047,"_5":17474,"_23043":101969,"_2395":102048},[],"Cambios de estado y razones de revocación.",{"_2868":59855,"_25194":59817,"_17578":102050,"_5":17474,"_23043":101969,"_2395":102051},[],"Publicación y vigencia de OCSP y CRLs.",{"_2868":59856,"_25194":59817,"_17578":102053,"_5":17474,"_23043":101969,"_2395":102054},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2868":59857,"_25194":59817,"_17578":102056,"_5":17474,"_23043":101969,"_2395":102057},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2868":59858,"_25194":59858,"_5":12321,"_2395":102059,"_25530":102060,"_17578":102061,"_23043":59858},"Modelo de confianza",[40934,97461,45993,101926],[],{"_2868":59859,"_25194":59858,"_17578":102063,"_5":17474,"_23043":59858,"_2395":102064},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2868":59860,"_25194":59858,"_5":25527,"_17578":102066,"_23043":102067,"_2395":102068},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2868":59861,"_25194":59858,"_5":25527,"_17578":102070,"_23043":102071,"_2395":102072},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2868":59862,"_25194":59858,"_5":25527,"_17578":102074,"_23043":102075,"_2395":102076},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2868":59863,"_25194":59858,"_5":25527,"_17578":102078,"_23043":102079,"_2395":102080},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2868":59864,"_25194":59858,"_5":25527,"_17578":102082,"_23043":102083,"_2395":102084},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2868":59865,"_25194":59858,"_5":25527,"_17578":102086,"_23043":102087,"_2395":102088},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2868":59866,"_25194":59858,"_5":25527,"_17578":102090,"_23043":102091,"_2395":102092},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2868":59867,"_25194":59858,"_5":25527,"_17578":102094,"_23043":102095,"_2395":102096},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2868":59868,"_25194":59858,"_5":25527,"_17578":102098,"_23043":102099,"_2395":102100},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2868":59869,"_25194":59858,"_5":25527,"_17578":102102,"_23043":102103,"_2395":102104},[],"/docs/pr-preview/pr-39/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2868":59870,"_25194":59858,"_17578":102106,"_5":17474,"_23043":59858,"_2395":102107},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2868":59871,"_25194":59858,"_17578":102109,"_5":17474,"_23043":102071,"_2395":102110},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2868":59872,"_25194":59858,"_17578":102112,"_5":17474,"_23043":102075,"_2395":102113},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2868":59873,"_25194":59858,"_17578":102115,"_5":17474,"_23043":102079,"_2395":102116},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2868":59874,"_25194":59858,"_17578":102118,"_5":17474,"_23043":102083,"_2395":102119},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2868":59875,"_25194":59858,"_17578":102121,"_5":17474,"_23043":102087,"_2395":102122},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2868":59876,"_25194":59858,"_17578":102124,"_5":17474,"_23043":102087,"_2395":102125},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2868":59877,"_25194":59858,"_17578":102127,"_5":17474,"_23043":102087,"_2395":102128},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2868":59878,"_25194":59858,"_17578":102130,"_5":17474,"_23043":102087,"_2395":102131},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2868":59879,"_25194":59858,"_17578":102133,"_5":17474,"_23043":102087,"_2395":102134},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2868":59880,"_25194":59858,"_17578":102136,"_5":17474,"_23043":102087,"_2395":102137},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2868":59881,"_25194":59858,"_17578":102139,"_5":17474,"_23043":102091,"_2395":102140},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2868":59882,"_25194":59858,"_17578":102142,"_5":17474,"_23043":102091,"_2395":102143},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2868":59883,"_25194":59858,"_17578":102145,"_5":17474,"_23043":102091,"_2395":102146},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2868":59884,"_25194":59858,"_17578":102148,"_5":17474,"_23043":102091,"_2395":102149},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2868":59885,"_25194":59858,"_17578":102151,"_5":17474,"_23043":102091,"_2395":102152},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2868":59886,"_25194":59858,"_17578":102154,"_5":17474,"_23043":102095,"_2395":102155},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2868":59887,"_25194":59858,"_17578":102157,"_5":17474,"_23043":102095,"_2395":102158},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2868":59888,"_25194":59858,"_17578":102160,"_5":17474,"_23043":102095,"_2395":102161},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2868":59889,"_25194":59858,"_17578":102163,"_5":17474,"_23043":102095,"_2395":102164},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2868":59890,"_25194":59858,"_17578":102166,"_5":17474,"_23043":102095,"_2395":102167},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2868":59891,"_25194":59858,"_17578":102169,"_5":17474,"_23043":102095,"_2395":102170},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2868":59892,"_25194":59858,"_17578":102172,"_5":17474,"_23043":102095,"_2395":102173},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2868":59893,"_25194":59858,"_17578":102175,"_5":17474,"_23043":102099,"_2395":102176},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2868":59894,"_25194":59858,"_17578":102178,"_5":17474,"_23043":102103,"_2395":102179},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2868":59895,"_25194":59858,"_17578":102181,"_5":17474,"_23043":102103,"_2395":102182},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2868":59896,"_25194":59858,"_17578":102184,"_5":17474,"_23043":102103,"_2395":102185},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2868":59897,"_25194":59858,"_17578":102187,"_5":17474,"_23043":102103,"_2395":102188},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2868":59898,"_25194":59858,"_17578":102190,"_5":17474,"_23043":102103,"_2395":102191},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2868":59899,"_25194":59858,"_17578":102193,"_5":17474,"_23043":102103,"_2395":102194},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2868":59900,"_25194":59858,"_17578":102196,"_5":17474,"_23043":102103,"_2395":102197},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2868":59901,"_25194":59901,"_5":12321,"_2395":102199,"_25530":102200,"_17578":102201,"_23043":59901},"Listas de revocación (CRL)",[40934,97461,45993,101687],[],{"_2868":59902,"_25194":59901,"_17578":102203,"_5":17474,"_23043":59901,"_2395":102204},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2868":59903,"_25194":59901,"_5":25527,"_17578":102206,"_23043":102207,"_2395":102208},[],"/docs/pr-preview/pr-39/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2868":59904,"_25194":59901,"_5":25527,"_17578":102210,"_23043":102211,"_2395":102212},[],"/docs/pr-preview/pr-39/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2868":59905,"_25194":59901,"_5":25527,"_17578":102214,"_23043":102215,"_2395":102216},[],"/docs/pr-preview/pr-39/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2868":59906,"_25194":59901,"_5":25527,"_17578":102218,"_23043":102219,"_2395":102220},[],"/docs/pr-preview/pr-39/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2868":59907,"_25194":59901,"_5":25527,"_17578":102222,"_23043":102223,"_2395":102224},[],"/docs/pr-preview/pr-39/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2868":59908,"_25194":59901,"_5":25527,"_17578":102226,"_23043":102227,"_2395":102228},[],"/docs/pr-preview/pr-39/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2868":59909,"_25194":59901,"_5":25527,"_17578":102230,"_23043":102231,"_2395":102232},[],"/docs/pr-preview/pr-39/es/platform/pki/crl#referencias","Referencias",{"_2868":59910,"_25194":59901,"_17578":102234,"_5":17474,"_23043":59901,"_2395":102235},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2868":59911,"_25194":59901,"_17578":102237,"_5":17474,"_23043":102207,"_2395":102238},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2868":59912,"_25194":59901,"_17578":102240,"_5":17474,"_23043":102207,"_2395":102241},[],"Campo de `crl_options`",{"_2868":59913,"_25194":59901,"_17578":102243,"_5":17474,"_23043":102207,"_2395":98990},[],{"_2868":59914,"_25194":59901,"_17578":102245,"_5":17474,"_23043":102207,"_2395":102246},[],"Valor inicial del backend",{"_2868":59915,"_25194":59901,"_17578":102248,"_5":17474,"_23043":102207,"_2395":47173},[],{"_2868":59916,"_25194":59901,"_17578":102250,"_5":17474,"_23043":102207,"_2395":102251},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2868":59917,"_25194":59901,"_17578":102253,"_5":17474,"_23043":102207,"_2395":102254},[],"7 días.",{"_2868":59918,"_25194":59901,"_17578":102256,"_5":17474,"_23043":102207,"_2395":47182},[],{"_2868":59919,"_25194":59901,"_17578":102258,"_5":17474,"_23043":102207,"_2395":102259},[],"Plazo desde la publicación que activa la renovación programada.",{"_2868":59920,"_25194":59901,"_17578":102261,"_5":17474,"_23043":102207,"_2395":102262},[],"6 días y 23 horas.",{"_2868":59921,"_25194":59901,"_17578":102264,"_5":17474,"_23043":102207,"_2395":47191},[],{"_2868":59922,"_25194":59901,"_17578":102266,"_5":17474,"_23043":102207,"_2395":102267},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2868":59923,"_25194":59901,"_17578":102269,"_5":17474,"_23043":102207,"_2395":47197},[],{"_2868":59924,"_25194":59901,"_17578":102271,"_5":17474,"_23043":102207,"_2395":47200},[],{"_2868":59925,"_25194":59901,"_17578":102273,"_5":17474,"_23043":102207,"_2395":102274},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2868":59926,"_25194":59901,"_17578":102276,"_5":17474,"_23043":102207,"_2395":102277},[],"SKI de la CA.",{"_2868":59927,"_25194":59901,"_17578":102279,"_5":17474,"_23043":102207,"_2395":102280},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2868":59928,"_25194":59901,"_17578":102282,"_5":17474,"_23043":102207,"_2395":102283},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2868":59929,"_25194":59901,"_17578":102285,"_5":17474,"_23043":102211,"_2395":102286},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2868":59930,"_25194":59901,"_17578":102288,"_5":17474,"_23043":102211,"_2395":102289},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2868":59931,"_25194":59901,"_17578":102291,"_5":17474,"_23043":102211,"_2395":102292},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2868":59932,"_25194":59901,"_17578":102294,"_5":17474,"_23043":102215,"_2395":102295},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2868":59933,"_25194":59901,"_17578":102297,"_5":17474,"_23043":102215,"_2395":102298},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2868":59934,"_25194":59901,"_17578":102300,"_5":17474,"_23043":102219,"_2395":102301},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2868":59935,"_25194":59901,"_17578":102303,"_5":17474,"_23043":102219,"_2395":102304},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2868":59936,"_25194":59901,"_17578":102306,"_5":17474,"_23043":102219,"_2395":102307},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2868":59937,"_25194":59901,"_17578":102309,"_5":17474,"_23043":102219,"_2395":102310},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2868":59938,"_25194":59901,"_17578":102312,"_5":17474,"_23043":102219,"_2395":102313},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2868":59939,"_25194":59901,"_17578":102315,"_5":17474,"_23043":102223,"_2395":102316},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2868":59940,"_25194":59901,"_17578":102318,"_5":17474,"_23043":102223,"_2395":99179},[],{"_2868":59941,"_25194":59901,"_17578":102320,"_5":17474,"_23043":102223,"_2395":102321},[],"Path relativo",{"_2868":59942,"_25194":59901,"_17578":102323,"_5":17474,"_23043":102223,"_2395":97252},[],{"_2868":59943,"_25194":59901,"_17578":102325,"_5":17474,"_23043":102223,"_2395":47255},[],{"_2868":59944,"_25194":59901,"_17578":102327,"_5":17474,"_23043":102223,"_2395":47258},[],{"_2868":59945,"_25194":59901,"_17578":102329,"_5":17474,"_23043":102223,"_2395":102330},[],"Consultar `crl_options` y `latest_crl`.",{"_2868":59946,"_25194":59901,"_17578":102332,"_5":17474,"_23043":102223,"_2395":47264},[],{"_2868":59947,"_25194":59901,"_17578":102334,"_5":17474,"_23043":102223,"_2395":47258},[],{"_2868":59948,"_25194":59901,"_17578":102336,"_5":17474,"_23043":102223,"_2395":102337},[],"Sustituir la configuración de CRL.",{"_2868":59949,"_25194":59901,"_17578":102339,"_5":17474,"_23043":102223,"_2395":102340},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2868":59950,"_25194":59901,"_17578":102342,"_5":17474,"_23043":102223,"_2395":102343},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2868":59951,"_25194":59901,"_17578":102345,"_5":17474,"_23043":102227,"_2395":102346},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2868":59952,"_25194":59901,"_17578":102348,"_5":17474,"_23043":102231,"_2395":102349},[],"RFC 5280: perfil X.509 y CRL.",{"_2868":59953,"_25194":59901,"_17578":102351,"_5":17474,"_23043":102231,"_2395":47284},[],{"_2868":59954,"_25194":59901,"_17578":102353,"_5":17474,"_23043":102231,"_2395":47287},[],{"_2868":59955,"_25194":59901,"_17578":102355,"_5":17474,"_23043":102231,"_2395":102356},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2868":59956,"_25194":59901,"_17578":102358,"_5":17474,"_23043":102231,"_2395":102359},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2868":59957,"_25194":59957,"_5":12321,"_2395":102361,"_25530":102362,"_17578":102363,"_23043":59957},"Claves y motores criptográficos",[40934,97461,45993,101072],[],{"_2868":59958,"_25194":59957,"_17578":102365,"_5":17474,"_23043":59957,"_2395":102366},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2868":59959,"_25194":59957,"_5":25527,"_17578":102368,"_23043":102369,"_2395":102370},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2868":59960,"_25194":59957,"_5":25527,"_17578":102372,"_23043":102373,"_2395":102374},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2868":59961,"_25194":59957,"_5":25527,"_17578":102376,"_23043":102377,"_2395":47312},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#file-system",{"_2868":59962,"_25194":59957,"_5":25527,"_17578":102379,"_23043":102380,"_2395":47316},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#hashicorp-vault",{"_2868":59963,"_25194":59957,"_5":25527,"_17578":102382,"_23043":102383,"_2395":47320},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#aws-secrets-manager",{"_2868":59964,"_25194":59957,"_5":25527,"_17578":102385,"_23043":102386,"_2395":47324},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#aws-kms",{"_2868":59965,"_25194":59957,"_5":25527,"_17578":102388,"_23043":102389,"_2395":47328},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#pkcs11",{"_2868":59966,"_25194":59957,"_5":25527,"_17578":102391,"_23043":102392,"_2395":47332},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#azure-key-vault",{"_2868":59967,"_25194":59957,"_5":25527,"_17578":102394,"_23043":102395,"_2395":102396},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2868":59968,"_25194":59957,"_5":25527,"_17578":102398,"_23043":102399,"_2395":102400},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2868":59969,"_25194":59957,"_5":25527,"_17578":102402,"_23043":102403,"_2395":102404},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2868":59970,"_25194":59957,"_5":25527,"_17578":102406,"_23043":102407,"_2395":102408},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2868":59971,"_25194":59957,"_5":25527,"_17578":102410,"_23043":102411,"_2395":102412},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2868":59972,"_25194":59957,"_5":25527,"_17578":102414,"_23043":102415,"_2395":102416},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2868":59973,"_25194":59957,"_5":25527,"_17578":102418,"_23043":102419,"_2395":102420},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2868":59974,"_25194":59957,"_5":25527,"_17578":102422,"_23043":102423,"_2395":47364},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#sign",{"_2868":59975,"_25194":59957,"_5":25527,"_17578":102425,"_23043":102426,"_2395":47368},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#verify",{"_2868":59976,"_25194":59957,"_5":25527,"_17578":102428,"_23043":102429,"_2395":102430},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2868":59977,"_25194":59957,"_5":25527,"_17578":102432,"_23043":102433,"_2395":102434},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2868":59978,"_25194":59957,"_5":25527,"_17578":102436,"_23043":102437,"_2395":102438},[],"/docs/pr-preview/pr-39/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2868":59979,"_25194":59957,"_17578":102440,"_5":17474,"_23043":59957,"_2395":102441},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2868":59980,"_25194":59957,"_17578":102443,"_5":17474,"_23043":59957,"_2395":102444},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2868":59981,"_25194":59957,"_17578":102446,"_5":17474,"_23043":102369,"_2395":102447},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2868":59982,"_25194":59957,"_17578":102449,"_5":17474,"_23043":102369,"_2395":102450},[],"En la práctica, permite:",{"_2868":59983,"_25194":59957,"_17578":102452,"_5":17474,"_23043":102369,"_2395":102453},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2868":59984,"_25194":59957,"_17578":102455,"_5":17474,"_23043":102369,"_2395":102456},[],"Importar claves creadas externamente.",{"_2868":59985,"_25194":59957,"_17578":102458,"_5":17474,"_23043":102369,"_2395":102459},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2868":59986,"_25194":59957,"_17578":102461,"_5":17474,"_23043":102369,"_2395":102462},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2868":59987,"_25194":59957,"_17578":102464,"_5":17474,"_23043":102373,"_2395":102465},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2868":59988,"_25194":59957,"_17578":102467,"_5":17474,"_23043":102373,"_2395":102468},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2868":59989,"_25194":59957,"_17578":102470,"_5":17474,"_23043":102373,"_2395":102471},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2868":59990,"_25194":59957,"_17578":102473,"_5":17474,"_23043":102377,"_2395":102474},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2868":59991,"_25194":59957,"_17578":102476,"_5":17474,"_23043":102380,"_2395":102477},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2868":59992,"_25194":59957,"_17578":102479,"_5":17474,"_23043":102383,"_2395":102480},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2868":59993,"_25194":59957,"_17578":102482,"_5":17474,"_23043":102386,"_2395":102483},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2868":59994,"_25194":59957,"_17578":102485,"_5":17474,"_23043":102389,"_2395":102486},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2868":59995,"_25194":59957,"_17578":102488,"_5":17474,"_23043":102392,"_2395":102489},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2868":59996,"_25194":59957,"_17578":102491,"_5":17474,"_23043":102392,"_2395":102492},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2868":59997,"_25194":59957,"_17578":102494,"_5":17474,"_23043":102392,"_2395":102495},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2868":59998,"_25194":59957,"_17578":102497,"_5":17474,"_23043":102392,"_2395":102498},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2868":59999,"_25194":59957,"_17578":102500,"_5":17474,"_23043":102395,"_2395":102501},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2868":60000,"_25194":59957,"_17578":102503,"_5":17474,"_23043":102395,"_2395":102504},[],"La tabla incluye los siguientes campos:",{"_2868":60001,"_25194":59957,"_17578":102506,"_5":17474,"_23043":102395,"_2395":102507},[],"**Name**: nombre descriptivo de la clave.",{"_2868":60002,"_25194":59957,"_17578":102509,"_5":17474,"_23043":102395,"_2395":102510},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2868":60003,"_25194":59957,"_17578":102512,"_5":17474,"_23043":102395,"_2395":102513},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2868":60004,"_25194":59957,"_17578":102515,"_5":17474,"_23043":102395,"_2395":102516},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2868":60005,"_25194":59957,"_17578":102518,"_5":17474,"_23043":102395,"_2395":102519},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2868":60006,"_25194":59957,"_17578":102521,"_5":17474,"_23043":102395,"_2395":102522},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2868":60007,"_25194":59957,"_17578":102524,"_5":17474,"_23043":102395,"_2395":102525},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2868":60008,"_25194":59957,"_17578":102527,"_5":17474,"_23043":102395,"_2395":102528},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2868":60009,"_25194":59957,"_17578":102530,"_5":17474,"_23043":102395,"_2395":102531},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2868":60010,"_25194":59957,"_17578":102533,"_5":17474,"_23043":102395,"_2395":102534},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2868":60011,"_25194":59957,"_17578":102536,"_5":17474,"_23043":102395,"_2395":102537},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2868":60012,"_25194":59957,"_17578":102539,"_5":17474,"_23043":102395,"_2395":102540},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2868":60013,"_25194":59957,"_17578":102542,"_5":17474,"_23043":102395,"_2395":102543},[],"**Delete Key** para eliminar la clave del sistema.",{"_2868":60014,"_25194":59957,"_17578":102545,"_5":17474,"_23043":102399,"_2395":102546},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2868":60015,"_25194":59957,"_17578":102548,"_5":17474,"_23043":102403,"_2395":102549},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2868":60016,"_25194":59957,"_17578":102551,"_5":17474,"_23043":102403,"_2395":102552},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2868":60017,"_25194":59957,"_17578":102554,"_5":17474,"_23043":102403,"_2395":102555},[],"**Key Name**: nombre único y descriptivo.",{"_2868":60018,"_25194":59957,"_17578":102557,"_5":17474,"_23043":102403,"_2395":102558},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2868":60019,"_25194":59957,"_17578":102560,"_5":17474,"_23043":102403,"_2395":102561},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2868":60020,"_25194":59957,"_17578":102563,"_5":17474,"_23043":102403,"_2395":102564},[],"**Tags**: metadatos para clasificar la clave.",{"_2868":60021,"_25194":59957,"_17578":102566,"_5":17474,"_23043":102403,"_2395":102567},[],"**Metadata**: información adicional para usos avanzados.",{"_2868":60022,"_25194":59957,"_17578":102569,"_5":17474,"_23043":102407,"_2395":102570},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2868":60023,"_25194":59957,"_17578":102572,"_5":17474,"_23043":102407,"_2395":102573},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2868":60024,"_25194":59957,"_17578":102575,"_5":17474,"_23043":102407,"_2395":102576},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2868":60025,"_25194":59957,"_17578":102578,"_5":17474,"_23043":102407,"_2395":102579},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2868":60026,"_25194":59957,"_17578":102581,"_5":17474,"_23043":102407,"_2395":102582},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2868":60027,"_25194":59957,"_17578":102584,"_5":17474,"_23043":102407,"_2395":102585},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2868":60028,"_25194":59957,"_17578":102587,"_5":17474,"_23043":102407,"_2395":102588},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2868":60029,"_25194":59957,"_17578":102590,"_5":17474,"_23043":102407,"_2395":102591},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2868":60030,"_25194":59957,"_17578":102593,"_5":17474,"_23043":102407,"_2395":102594},[],"**Metadata**: información adicional opcional.",{"_2868":60031,"_25194":59957,"_17578":102596,"_5":17474,"_23043":102407,"_2395":102597},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2868":60032,"_25194":59957,"_17578":102599,"_5":17474,"_23043":102407,"_2395":102600},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2868":60033,"_25194":59957,"_17578":102602,"_5":17474,"_23043":102411,"_2395":102603},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2868":60034,"_25194":59957,"_17578":102605,"_5":17474,"_23043":102415,"_2395":102606},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2868":60035,"_25194":59957,"_17578":102608,"_5":17474,"_23043":102415,"_2395":102609},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2868":60036,"_25194":59957,"_17578":102611,"_5":17474,"_23043":102415,"_2395":102612},[],"**Key Name**: nombre descriptivo.",{"_2868":60037,"_25194":59957,"_17578":102614,"_5":17474,"_23043":102415,"_2395":102615},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2868":60038,"_25194":59957,"_17578":102617,"_5":17474,"_23043":102415,"_2395":102618},[],"**Tags**: etiquetas asociadas.",{"_2868":60039,"_25194":59957,"_17578":102620,"_5":17474,"_23043":102415,"_2395":102621},[],"**Aliases**: nombres alternativos.",{"_2868":60040,"_25194":59957,"_17578":102623,"_5":17474,"_23043":102415,"_2395":102624},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2868":60041,"_25194":59957,"_17578":102626,"_5":17474,"_23043":102415,"_2395":102627},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2868":60042,"_25194":59957,"_17578":102629,"_5":17474,"_23043":102415,"_2395":102630},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2868":60043,"_25194":59957,"_17578":102632,"_5":17474,"_23043":102415,"_2395":102633},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2868":60044,"_25194":59957,"_17578":102635,"_5":17474,"_23043":102419,"_2395":102636},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2868":60045,"_25194":59957,"_17578":102638,"_5":17474,"_23043":102419,"_2395":102639},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2868":60046,"_25194":59957,"_17578":102641,"_5":17474,"_23043":102419,"_2395":102642},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2868":60047,"_25194":59957,"_17578":102644,"_5":17474,"_23043":102423,"_2395":102645},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2868":60048,"_25194":59957,"_17578":102647,"_5":17474,"_23043":102423,"_2395":102648},[],"Campos principales:",{"_2868":60049,"_25194":59957,"_17578":102650,"_5":17474,"_23043":102423,"_2395":102651},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2868":60050,"_25194":59957,"_17578":102653,"_5":17474,"_23043":102423,"_2395":102654},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2868":60051,"_25194":59957,"_17578":102656,"_5":17474,"_23043":102423,"_2395":102657},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2868":60052,"_25194":59957,"_17578":102659,"_5":17474,"_23043":102423,"_2395":102660},[],"**Message**: contenido que se va a firmar.",{"_2868":60053,"_25194":59957,"_17578":102662,"_5":17474,"_23043":102423,"_2395":102663},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2868":60054,"_25194":59957,"_17578":102665,"_5":17474,"_23043":102426,"_2395":102666},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2868":60055,"_25194":59957,"_17578":102668,"_5":17474,"_23043":102426,"_2395":102648},[],{"_2868":60056,"_25194":59957,"_17578":102670,"_5":17474,"_23043":102426,"_2395":102671},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2868":60057,"_25194":59957,"_17578":102673,"_5":17474,"_23043":102426,"_2395":102674},[],"**Message Type**: `Raw` o `Digest`.",{"_2868":60058,"_25194":59957,"_17578":102676,"_5":17474,"_23043":102426,"_2395":102677},[],"**Payload Encoding**: codificación del mensaje.",{"_2868":60059,"_25194":59957,"_17578":102679,"_5":17474,"_23043":102426,"_2395":102680},[],"**Message**: mensaje original o hash.",{"_2868":60060,"_25194":59957,"_17578":102682,"_5":17474,"_23043":102426,"_2395":102683},[],"**Signature**: firma que se desea comprobar.",{"_2868":60061,"_25194":59957,"_17578":102685,"_5":17474,"_23043":102426,"_2395":102686},[],"**Result**: indicador del resultado de la validación.",{"_2868":60062,"_25194":59957,"_17578":102688,"_5":17474,"_23043":102429,"_2395":102689},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2868":60063,"_25194":59957,"_17578":102691,"_5":17474,"_23043":102429,"_2395":102692},[],"Este flujo es útil para:",{"_2868":60064,"_25194":59957,"_17578":102694,"_5":17474,"_23043":102429,"_2395":102695},[],"Solicitar certificados a una CA externa.",{"_2868":60065,"_25194":59957,"_17578":102697,"_5":17474,"_23043":102429,"_2395":102698},[],"Renovar una identidad manteniendo la misma clave.",{"_2868":60066,"_25194":59957,"_17578":102700,"_5":17474,"_23043":102429,"_2395":102701},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2868":60067,"_25194":59957,"_17578":102703,"_5":17474,"_23043":102429,"_2395":102704},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2868":60068,"_25194":59957,"_17578":102706,"_5":17474,"_23043":102429,"_2395":102707},[],"**Organization (O)**: organización o empresa.",{"_2868":60069,"_25194":59957,"_17578":102709,"_5":17474,"_23043":102429,"_2395":102710},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2868":60070,"_25194":59957,"_17578":102712,"_5":17474,"_23043":102429,"_2395":102713},[],"**Country (C)**: código de país de dos letras.",{"_2868":60071,"_25194":59957,"_17578":102715,"_5":17474,"_23043":102429,"_2395":102716},[],"**State / Province (ST)**: estado o provincia.",{"_2868":60072,"_25194":59957,"_17578":102718,"_5":17474,"_23043":102429,"_2395":102719},[],"**Locality (L)**: ciudad o localidad.",{"_2868":60073,"_25194":59957,"_17578":102721,"_5":17474,"_23043":102429,"_2395":102722},[],"**Email Address**: correo de contacto.",{"_2868":60074,"_25194":59957,"_17578":102724,"_5":17474,"_23043":102429,"_2395":102725},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2868":60075,"_25194":59957,"_17578":102727,"_5":17474,"_23043":102429,"_2395":102728},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2868":60076,"_25194":59957,"_17578":102730,"_5":17474,"_23043":102433,"_2395":102731},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2868":60077,"_25194":59957,"_17578":102733,"_5":17474,"_23043":102433,"_2395":47676},[],{"_2868":60078,"_25194":59957,"_17578":102735,"_5":17474,"_23043":102437,"_2395":102736},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2868":60079,"_25194":60079,"_5":12321,"_2395":102738,"_25530":102739,"_17578":102740,"_23043":60079},"Validación online con OCSP",[40934,97461,45993,101687],[],{"_2868":60080,"_25194":60079,"_17578":102742,"_5":17474,"_23043":60079,"_2395":102743},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2868":60081,"_25194":60079,"_5":25527,"_17578":102745,"_23043":102746,"_2395":102747},[],"/docs/pr-preview/pr-39/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2868":60082,"_25194":60079,"_5":25527,"_17578":102749,"_23043":102750,"_2395":102751},[],"/docs/pr-preview/pr-39/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2868":60083,"_25194":60079,"_5":25527,"_17578":102753,"_23043":102754,"_2395":102755},[],"/docs/pr-preview/pr-39/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2868":60084,"_25194":60079,"_5":25527,"_17578":102757,"_23043":102758,"_2395":102759},[],"/docs/pr-preview/pr-39/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2868":60085,"_25194":60079,"_5":25527,"_17578":102761,"_23043":102762,"_2395":102763},[],"/docs/pr-preview/pr-39/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2868":60086,"_25194":60079,"_5":25527,"_17578":102765,"_23043":102766,"_2395":102232},[],"/docs/pr-preview/pr-39/es/platform/pki/ocsp#referencias",{"_2868":60087,"_25194":60079,"_17578":102768,"_5":17474,"_23043":60079,"_2395":102769},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2868":60088,"_25194":60079,"_17578":102771,"_5":17474,"_23043":102746,"_2395":102772},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2868":60089,"_25194":60079,"_17578":102774,"_5":17474,"_23043":102746,"_2395":102775},[],"Estado del registro",{"_2868":60090,"_25194":60079,"_17578":102777,"_5":17474,"_23043":102746,"_2395":102778},[],"Respuesta firmada",{"_2868":60091,"_25194":60079,"_17578":102780,"_5":17474,"_23043":102746,"_2395":45171},[],{"_2868":60092,"_25194":60079,"_17578":102782,"_5":17474,"_23043":102746,"_2395":47726},[],{"_2868":60093,"_25194":60079,"_17578":102784,"_5":17474,"_23043":102746,"_2395":45188},[],{"_2868":60094,"_25194":60079,"_17578":102786,"_5":17474,"_23043":102746,"_2395":102787},[],"`Revoked`, con razón y fecha de revocación.",{"_2868":60095,"_25194":60079,"_17578":102789,"_5":17474,"_23043":102746,"_2395":102790},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2868":60096,"_25194":60079,"_17578":102792,"_5":17474,"_23043":102746,"_2395":102793},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2868":60097,"_25194":60079,"_17578":102795,"_5":17474,"_23043":102746,"_2395":102796},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2868":60098,"_25194":60079,"_17578":102798,"_5":17474,"_23043":102746,"_2395":102799},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2868":60099,"_25194":60079,"_17578":102801,"_5":17474,"_23043":102746,"_2395":102802},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2868":60100,"_25194":60079,"_17578":102804,"_5":17474,"_23043":102750,"_2395":102805},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2868":60101,"_25194":60079,"_17578":102807,"_5":17474,"_23043":102750,"_2395":102808},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2868":60102,"_25194":60079,"_17578":102810,"_5":17474,"_23043":102754,"_2395":102811},[],"El servicio acepta:",{"_2868":60103,"_25194":60079,"_17578":102813,"_5":17474,"_23043":102754,"_2395":99179},[],{"_2868":60104,"_25194":60079,"_17578":102815,"_5":17474,"_23043":102754,"_2395":102816},[],"Ruta del servicio VA",{"_2868":60105,"_25194":60079,"_17578":102818,"_5":17474,"_23043":102754,"_2395":102819},[],"Formato",{"_2868":60106,"_25194":60079,"_17578":102821,"_5":17474,"_23043":102754,"_2395":47766},[],{"_2868":60107,"_25194":60079,"_17578":102823,"_5":17474,"_23043":102754,"_2395":47769},[],{"_2868":60108,"_25194":60079,"_17578":102825,"_5":17474,"_23043":102754,"_2395":102826},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2868":60109,"_25194":60079,"_17578":102828,"_5":17474,"_23043":102754,"_2395":47255},[],{"_2868":60110,"_25194":60079,"_17578":102830,"_5":17474,"_23043":102754,"_2395":47777},[],{"_2868":60111,"_25194":60079,"_17578":102832,"_5":17474,"_23043":102754,"_2395":102833},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2868":60112,"_25194":60079,"_17578":102835,"_5":17474,"_23043":102754,"_2395":102836},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2868":60113,"_25194":60079,"_17578":102838,"_5":17474,"_23043":102758,"_2395":102839},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2868":60114,"_25194":60079,"_17578":102841,"_5":17474,"_23043":102758,"_2395":102842},[],"Genera la solicitud:",{"_2868":60115,"_25194":60079,"_17578":102844,"_5":17474,"_23043":102758,"_2395":102845},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2868":60116,"_25194":60079,"_17578":102847,"_5":17474,"_23043":102758,"_2395":102848},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2868":60117,"_25194":60079,"_17578":102850,"_5":17474,"_23043":102758,"_2395":102851},[],"Verifica el DER recibido:",{"_2868":60118,"_25194":60079,"_17578":102853,"_5":17474,"_23043":102758,"_2395":102854},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2868":60119,"_25194":60079,"_17578":102856,"_5":17474,"_23043":102762,"_2395":102857},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2868":60120,"_25194":60079,"_17578":102859,"_5":17474,"_23043":102762,"_2395":102860},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2868":60121,"_25194":60079,"_17578":102862,"_5":17474,"_23043":102766,"_2395":47810},[],{"_2868":60122,"_25194":60079,"_17578":102864,"_5":17474,"_23043":102766,"_2395":47813},[],{"_2868":60123,"_25194":60079,"_17578":102866,"_5":17474,"_23043":102766,"_2395":102867},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2868":60124,"_25194":60079,"_17578":102869,"_5":17474,"_23043":102766,"_2395":102359},[],{"_2868":60125,"_25194":60125,"_5":12321,"_2395":45993,"_25530":102871,"_17578":102872,"_23043":60125},[40934,97461,45993],[],{"_2868":60126,"_25194":60125,"_17578":102874,"_5":17474,"_23043":60125,"_2395":102875},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2868":60127,"_25194":60125,"_5":25527,"_17578":102877,"_23043":102878,"_2395":100396},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#empieza-aquí",{"_2868":60128,"_25194":60125,"_5":25527,"_17578":102880,"_23043":102881,"_2395":102882},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2868":60129,"_25194":60125,"_5":25527,"_17578":102884,"_23043":102885,"_2395":100918},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#capacidades-principales",{"_2868":60130,"_25194":60125,"_5":25527,"_17578":102887,"_23043":102888,"_2395":100922},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2868":60131,"_25194":60125,"_5":25527,"_17578":102890,"_23043":102891,"_2395":100926},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2868":60132,"_25194":60125,"_5":25527,"_17578":102893,"_23043":102894,"_2395":100930},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#emite-y-controla-certificados",{"_2868":60133,"_25194":60125,"_5":25527,"_17578":102896,"_23043":102897,"_2395":100938},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#publica-el-estado-de-validación",{"_2868":60134,"_25194":60125,"_5":25527,"_17578":102899,"_23043":102900,"_2395":102901},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2868":60135,"_25194":60125,"_5":25527,"_17578":102903,"_23043":102904,"_2395":101853},[],"/docs/pr-preview/pr-39/es/platform/pki/overview#continúa",{"_2868":60136,"_25194":60125,"_17578":102906,"_5":17474,"_23043":60125,"_2395":102907},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2868":60137,"_25194":60125,"_17578":102909,"_5":17474,"_23043":102878,"_2395":102910},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2868":60138,"_25194":60125,"_17578":102912,"_5":17474,"_23043":102878,"_2395":102913},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2868":60139,"_25194":60125,"_17578":102915,"_5":17474,"_23043":102881,"_2395":102916},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2868":60140,"_25194":60125,"_17578":102918,"_5":17474,"_23043":102881,"_2395":102919},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2868":60141,"_25194":60125,"_17578":102921,"_5":17474,"_23043":102881,"_2395":102922},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2868":60142,"_25194":60125,"_17578":102924,"_5":17474,"_23043":102881,"_2395":102925},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2868":60143,"_25194":60125,"_17578":102927,"_5":17474,"_23043":102881,"_2395":102928},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2868":60144,"_25194":60125,"_17578":102930,"_5":17474,"_23043":102888,"_2395":102931},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2868":60145,"_25194":60125,"_17578":102933,"_5":17474,"_23043":102891,"_2395":102934},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2868":60146,"_25194":60125,"_17578":102936,"_5":17474,"_23043":102894,"_2395":102937},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2868":60147,"_25194":60125,"_17578":102939,"_5":17474,"_23043":102897,"_2395":102940},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2868":60148,"_25194":60125,"_17578":102942,"_5":17474,"_23043":102900,"_2395":102943},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2868":60149,"_25194":60125,"_17578":102945,"_5":17474,"_23043":102900,"_2395":102946},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2868":60150,"_25194":60125,"_17578":102948,"_5":17474,"_23043":102900,"_2395":102949},[],"su clave pública corresponda a la clave privada del cliente;",{"_2868":60151,"_25194":60125,"_17578":102951,"_5":17474,"_23043":102900,"_2395":102952},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2868":60152,"_25194":60125,"_17578":102954,"_5":17474,"_23043":102900,"_2395":102955},[],"sus fechas y usos permitan la operación;",{"_2868":60153,"_25194":60125,"_17578":102957,"_5":17474,"_23043":102900,"_2395":102958},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2868":60154,"_25194":60125,"_17578":102960,"_5":17474,"_23043":102900,"_2395":102961},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2868":60155,"_25194":60125,"_17578":102963,"_5":17474,"_23043":102904,"_2395":102964},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2868":60156,"_25194":60125,"_17578":102966,"_5":17474,"_23043":102904,"_2395":102967},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2868":60157,"_25194":60125,"_17578":102969,"_5":17474,"_23043":102904,"_2395":102970},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2868":60158,"_25194":60158,"_5":12321,"_2395":102972,"_25530":102973,"_17578":102974,"_23043":60158},"Crea tu primera CA",[40934,97461,45993,100520],[],{"_2868":60159,"_25194":60158,"_17578":102976,"_5":17474,"_23043":60158,"_2395":102977},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2868":60160,"_25194":60158,"_5":25527,"_17578":102979,"_23043":102980,"_2395":96162},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2868":60161,"_25194":60158,"_5":25527,"_17578":102982,"_23043":102983,"_2395":102984},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2868":60162,"_25194":60158,"_5":25527,"_17578":102986,"_23043":102987,"_2395":102988},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2868":60163,"_25194":60158,"_5":25527,"_17578":102990,"_23043":102991,"_2395":102992},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2868":60164,"_25194":60158,"_5":25527,"_17578":102994,"_23043":102995,"_2395":102996},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2868":60165,"_25194":60158,"_5":25527,"_17578":102998,"_23043":102999,"_2395":103000},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2868":60166,"_25194":60158,"_5":25527,"_17578":103002,"_23043":103003,"_2395":103004},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2868":60167,"_25194":60158,"_5":25527,"_17578":103006,"_23043":103007,"_2395":100768},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2868":60168,"_25194":60158,"_5":25527,"_17578":103009,"_23043":103010,"_2395":96186},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2868":60169,"_25194":60158,"_17578":103012,"_5":17474,"_23043":60158,"_2395":103013},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2868":60170,"_25194":60158,"_17578":103015,"_5":17474,"_23043":102980,"_2395":103016},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2868":60171,"_25194":60158,"_17578":103018,"_5":17474,"_23043":102980,"_2395":103019},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2868":60172,"_25194":60158,"_17578":103021,"_5":17474,"_23043":102980,"_2395":103022},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2868":60173,"_25194":60158,"_17578":103024,"_5":17474,"_23043":102980,"_2395":103025},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2868":60174,"_25194":60158,"_17578":103027,"_5":17474,"_23043":102983,"_2395":103028},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2868":60175,"_25194":60158,"_17578":103030,"_5":17474,"_23043":102983,"_2395":103031},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2868":60176,"_25194":60158,"_17578":103033,"_5":17474,"_23043":102987,"_2395":103034},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2868":60177,"_25194":60158,"_17578":103036,"_5":17474,"_23043":102987,"_2395":103037},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2868":60178,"_25194":60158,"_17578":103039,"_5":17474,"_23043":102991,"_2395":103040},[],"Selecciona **Root CA** y completa:",{"_2868":60179,"_25194":60158,"_17578":103042,"_5":17474,"_23043":102991,"_2395":47992},[],{"_2868":60180,"_25194":60158,"_17578":103044,"_5":17474,"_23043":102991,"_2395":103045},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2868":60181,"_25194":60158,"_17578":103047,"_5":17474,"_23043":102991,"_2395":103048},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2868":60182,"_25194":60158,"_17578":103050,"_5":17474,"_23043":102991,"_2395":103051},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2868":60183,"_25194":60158,"_17578":103053,"_5":17474,"_23043":102991,"_2395":103054},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2868":60184,"_25194":60158,"_17578":103056,"_5":17474,"_23043":102995,"_2395":103057},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2868":60185,"_25194":60158,"_17578":103059,"_5":17474,"_23043":102999,"_2395":103060},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2868":60186,"_25194":60158,"_17578":103062,"_5":17474,"_23043":102999,"_2395":103063},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2868":60187,"_25194":60158,"_17578":103065,"_5":17474,"_23043":103003,"_2395":103066},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2868":60188,"_25194":60158,"_17578":103068,"_5":17474,"_23043":103003,"_2395":103069},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2868":60189,"_25194":60158,"_17578":103071,"_5":17474,"_23043":103003,"_2395":103072},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2868":60190,"_25194":60158,"_17578":103074,"_5":17474,"_23043":103007,"_2395":103075},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2868":60191,"_25194":60158,"_17578":103077,"_5":17474,"_23043":103007,"_2395":103078},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2868":60192,"_25194":60158,"_17578":103080,"_5":17474,"_23043":103007,"_2395":103081},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2868":60193,"_25194":60158,"_17578":103083,"_5":17474,"_23043":103007,"_2395":103084},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2868":60194,"_25194":60158,"_17578":103086,"_5":17474,"_23043":103010,"_2395":103087},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2868":60195,"_25194":60195,"_5":12321,"_2395":103089,"_25530":103090,"_17578":103091,"_23043":60195},"Emite y verifica un certificado",[40934,97461,45993,100520],[],{"_2868":60196,"_25194":60195,"_17578":103093,"_5":17474,"_23043":60195,"_2395":103094},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2868":60197,"_25194":60195,"_5":25527,"_17578":103096,"_23043":103097,"_2395":96162},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2868":60198,"_25194":60195,"_5":25527,"_17578":103099,"_23043":103100,"_2395":103101},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2868":60199,"_25194":60195,"_5":25527,"_17578":103103,"_23043":103104,"_2395":103105},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2868":60200,"_25194":60195,"_5":25527,"_17578":103107,"_23043":103108,"_2395":103109},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2868":60201,"_25194":60195,"_5":25527,"_17578":103111,"_23043":103112,"_2395":103113},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2868":60202,"_25194":60195,"_5":25527,"_17578":103115,"_23043":103116,"_2395":103117},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2868":60203,"_25194":60195,"_5":25527,"_17578":103119,"_23043":103120,"_2395":103000},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2868":60204,"_25194":60195,"_5":25527,"_17578":103122,"_23043":103123,"_2395":103124},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2868":60205,"_25194":60195,"_5":25527,"_17578":103126,"_23043":103127,"_2395":103128},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2868":60206,"_25194":60195,"_5":25527,"_17578":103130,"_23043":103131,"_2395":103132},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2868":60207,"_25194":60195,"_5":25527,"_17578":103134,"_23043":103135,"_2395":100768},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2868":60208,"_25194":60195,"_5":25527,"_17578":103137,"_23043":103138,"_2395":96186},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2868":60209,"_25194":60195,"_17578":103140,"_5":17474,"_23043":60195,"_2395":103141},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2868":60210,"_25194":60195,"_17578":103143,"_5":17474,"_23043":103097,"_2395":103144},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2868":60211,"_25194":60195,"_17578":103146,"_5":17474,"_23043":103097,"_2395":103147},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2868":60212,"_25194":60195,"_17578":103149,"_5":17474,"_23043":103097,"_2395":103150},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2868":60213,"_25194":60195,"_17578":103152,"_5":17474,"_23043":103097,"_2395":103153},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2868":60214,"_25194":60195,"_17578":103155,"_5":17474,"_23043":103097,"_2395":103156},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2868":60215,"_25194":60195,"_17578":103158,"_5":17474,"_23043":103100,"_2395":103159},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2868":60216,"_25194":60195,"_17578":103161,"_5":17474,"_23043":103104,"_2395":103162},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2868":60217,"_25194":60195,"_17578":103164,"_5":17474,"_23043":103104,"_2395":103165},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2868":60218,"_25194":60195,"_17578":103167,"_5":17474,"_23043":103108,"_2395":103168},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2868":60219,"_25194":60195,"_17578":103170,"_5":17474,"_23043":103108,"_2395":103171},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2868":60220,"_25194":60195,"_17578":103173,"_5":17474,"_23043":103112,"_2395":103174},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2868":60221,"_25194":60195,"_17578":103176,"_5":17474,"_23043":103112,"_2395":103177},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2868":60222,"_25194":60195,"_17578":103179,"_5":17474,"_23043":103116,"_2395":103180},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2868":60223,"_25194":60195,"_17578":103182,"_5":17474,"_23043":103120,"_2395":103183},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2868":60224,"_25194":60195,"_17578":103185,"_5":17474,"_23043":103123,"_2395":103186},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2868":60225,"_25194":60195,"_17578":103188,"_5":17474,"_23043":103127,"_2395":103189},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2868":60226,"_25194":60195,"_17578":103191,"_5":17474,"_23043":103127,"_2395":103192},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2868":60227,"_25194":60195,"_17578":103194,"_5":17474,"_23043":103127,"_2395":103195},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2868":60228,"_25194":60195,"_17578":103197,"_5":17474,"_23043":103131,"_2395":103198},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2868":60229,"_25194":60195,"_17578":103200,"_5":17474,"_23043":103131,"_2395":103201},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2868":60230,"_25194":60195,"_17578":103203,"_5":17474,"_23043":103131,"_2395":103204},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2868":60231,"_25194":60195,"_17578":103206,"_5":17474,"_23043":103135,"_2395":100851},[],{"_2868":60232,"_25194":60195,"_17578":103208,"_5":17474,"_23043":103135,"_2395":99628},[],{"_2868":60233,"_25194":60195,"_17578":103210,"_5":17474,"_23043":103135,"_2395":103211},[],"La CA rechaza la emisión",{"_2868":60234,"_25194":60195,"_17578":103213,"_5":17474,"_23043":103135,"_2395":103214},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2868":60235,"_25194":60195,"_17578":103216,"_5":17474,"_23043":103135,"_2395":103217},[],"Sujeto o usos diferentes",{"_2868":60236,"_25194":60195,"_17578":103219,"_5":17474,"_23043":103135,"_2395":103220},[],"Perfil aplicado y valores solicitados.",{"_2868":60237,"_25194":60195,"_17578":103222,"_5":17474,"_23043":103135,"_2395":103223},[],"No se encuentra el emisor",{"_2868":60238,"_25194":60195,"_17578":103225,"_5":17474,"_23043":103135,"_2395":103226},[],"CA descargada y cadena intermedia necesaria.",{"_2868":60239,"_25194":60195,"_17578":103228,"_5":17474,"_23043":103135,"_2395":103229},[],"Falla la vigencia",{"_2868":60240,"_25194":60195,"_17578":103231,"_5":17474,"_23043":103135,"_2395":103232},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2868":60241,"_25194":60195,"_17578":103234,"_5":17474,"_23043":103135,"_2395":103235},[],"Los resúmenes de clave difieren",{"_2868":60242,"_25194":60195,"_17578":103237,"_5":17474,"_23043":103135,"_2395":103238},[],"Archivos de certificado y clave de la misma emisión.",{"_2868":60243,"_25194":60195,"_17578":103240,"_5":17474,"_23043":103135,"_2395":103241},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2868":60244,"_25194":60195,"_17578":103243,"_5":17474,"_23043":103138,"_2395":103244},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2868":60245,"_25194":60195,"_17578":103246,"_5":17474,"_23043":103138,"_2395":103247},[],"Gestionar certificados para inspección, estado y revocación.",{"_2868":60246,"_25194":60195,"_17578":103249,"_5":17474,"_23043":103138,"_2395":103250},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2868":60247,"_25194":60195,"_17578":103252,"_5":17474,"_23043":103138,"_2395":103253},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2868":60248,"_25194":60195,"_17578":103255,"_5":17474,"_23043":103138,"_2395":103256},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2868":60249,"_25194":60249,"_5":12321,"_2395":103258,"_25530":103259,"_17578":103260,"_23043":60249},"Primeros pasos de PKI",[40934,97461,45993,100520],[],{"_2868":60250,"_25194":60249,"_17578":103262,"_5":17474,"_23043":60249,"_2395":103263},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2868":60251,"_25194":60249,"_5":25527,"_17578":103265,"_23043":103266,"_2395":96162},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2868":60252,"_25194":60249,"_5":25527,"_17578":103268,"_23043":103269,"_2395":103270},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2868":60253,"_25194":60249,"_5":25527,"_17578":103272,"_23043":103273,"_2395":100702},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2868":60254,"_25194":60249,"_5":25527,"_17578":103275,"_23043":103276,"_2395":103277},[],"/docs/pr-preview/pr-39/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2868":60255,"_25194":60249,"_17578":103279,"_5":17474,"_23043":60249,"_2395":103280},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2868":60256,"_25194":60249,"_17578":103282,"_5":17474,"_23043":103266,"_2395":103283},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2868":60257,"_25194":60249,"_17578":103285,"_5":17474,"_23043":103266,"_2395":103286},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2868":60258,"_25194":60249,"_17578":103288,"_5":17474,"_23043":103266,"_2395":103289},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2868":60259,"_25194":60249,"_17578":103291,"_5":17474,"_23043":103266,"_2395":103292},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2868":60260,"_25194":60249,"_17578":103294,"_5":17474,"_23043":103266,"_2395":103295},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2868":60261,"_25194":60249,"_17578":103297,"_5":17474,"_23043":103269,"_2395":103298},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2868":60262,"_25194":60249,"_17578":103300,"_5":17474,"_23043":103269,"_2395":103301},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2868":60263,"_25194":60249,"_17578":103303,"_5":17474,"_23043":103269,"_2395":103304},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2868":60264,"_25194":60249,"_17578":103306,"_5":17474,"_23043":103269,"_2395":103307},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2868":60265,"_25194":60249,"_17578":103309,"_5":17474,"_23043":103273,"_2395":103310},[],"Archivo o recurso",{"_2868":60266,"_25194":60249,"_17578":103312,"_5":17474,"_23043":103273,"_2395":100699},[],{"_2868":60267,"_25194":60249,"_17578":103314,"_5":17474,"_23043":103273,"_2395":103315},[],"CA raíz activa y `ca.pem`",{"_2868":60268,"_25194":60249,"_17578":103317,"_5":17474,"_23043":103273,"_2395":103318},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2868":60269,"_25194":60249,"_17578":103320,"_5":17474,"_23043":103273,"_2395":103321},[],"Certificado final y `device.crt`",{"_2868":60270,"_25194":60249,"_17578":103323,"_5":17474,"_23043":103273,"_2395":103324},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2868":60271,"_25194":60249,"_17578":103326,"_5":17474,"_23043":103273,"_2395":103327},[],"Clave privada `device.key`",{"_2868":60272,"_25194":60249,"_17578":103329,"_5":17474,"_23043":103273,"_2395":103330},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2868":60273,"_25194":60249,"_17578":103332,"_5":17474,"_23043":103273,"_2395":103333},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2868":60274,"_25194":60249,"_17578":103335,"_5":17474,"_23043":103276,"_2395":103336},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2868":60275,"_25194":60249,"_17578":103338,"_5":17474,"_23043":103276,"_2395":103339},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2868":60276,"_25194":60249,"_17578":103341,"_5":17474,"_23043":103276,"_2395":103342},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2868":60277,"_25194":60277,"_5":12321,"_2395":103344,"_25530":103345,"_17578":103347,"_23043":60277},"Resolución de problemas PKI",[40934,97461,45993,103346],"Resolución de problemas",[],{"_2868":60278,"_25194":60277,"_17578":103349,"_5":17474,"_23043":60277,"_2395":103350},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2868":60279,"_25194":60277,"_5":25527,"_17578":103352,"_23043":103353,"_2395":103354},[],"/docs/pr-preview/pr-39/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2868":60280,"_25194":60277,"_5":25527,"_17578":103356,"_23043":103357,"_2395":103358},[],"/docs/pr-preview/pr-39/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2868":60281,"_25194":60277,"_5":25527,"_17578":103360,"_23043":103361,"_2395":103362},[],"/docs/pr-preview/pr-39/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2868":60282,"_25194":60277,"_17578":103364,"_5":17474,"_23043":60277,"_2395":103365},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2868":60283,"_25194":60277,"_17578":103367,"_5":17474,"_23043":60277,"_2395":103368},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2868":60284,"_25194":60277,"_17578":103370,"_5":17474,"_23043":103353,"_2395":100699},[],{"_2868":60285,"_25194":60277,"_17578":103372,"_5":17474,"_23043":103353,"_2395":99628},[],{"_2868":60286,"_25194":60277,"_17578":103374,"_5":17474,"_23043":103353,"_2395":96186},[],{"_2868":60287,"_25194":60277,"_17578":103376,"_5":17474,"_23043":103353,"_2395":48328},[],{"_2868":60288,"_25194":60277,"_17578":103378,"_5":17474,"_23043":103353,"_2395":103379},[],"Existe, está activa y sus fechas son utilizables.",{"_2868":60289,"_25194":60277,"_17578":103381,"_5":17474,"_23043":103353,"_2395":103382},[],"Autoridades.",{"_2868":60290,"_25194":60277,"_17578":103384,"_5":17474,"_23043":103353,"_2395":103385},[],"Clave",{"_2868":60291,"_25194":60277,"_17578":103387,"_5":17474,"_23043":103353,"_2395":103388},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2868":60292,"_25194":60277,"_17578":103390,"_5":17474,"_23043":103353,"_2395":103391},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2868":60293,"_25194":60277,"_17578":103393,"_5":17474,"_23043":103353,"_2395":48346},[],{"_2868":60294,"_25194":60277,"_17578":103395,"_5":17474,"_23043":103353,"_2395":103396},[],"PEM correcto y firma verificable.",{"_2868":60295,"_25194":60277,"_17578":103398,"_5":17474,"_23043":103353,"_2395":48352},[],{"_2868":60296,"_25194":60277,"_17578":103400,"_5":17474,"_23043":103353,"_2395":103401},[],"Perfil",{"_2868":60297,"_25194":60277,"_17578":103403,"_5":17474,"_23043":103353,"_2395":103404},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2868":60298,"_25194":60277,"_17578":103406,"_5":17474,"_23043":103353,"_2395":103407},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2868":60299,"_25194":60277,"_17578":103409,"_5":17474,"_23043":103353,"_2395":100851},[],{"_2868":60300,"_25194":60277,"_17578":103411,"_5":17474,"_23043":103353,"_2395":103412},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2868":60301,"_25194":60277,"_17578":103414,"_5":17474,"_23043":103353,"_2395":103415},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2868":60302,"_25194":60277,"_17578":103417,"_5":17474,"_23043":103353,"_2395":103418},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2868":60303,"_25194":60277,"_17578":103420,"_5":17474,"_23043":103353,"_2395":103421},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2868":60304,"_25194":60277,"_17578":103423,"_5":17474,"_23043":103357,"_2395":103424},[],"Revisa cada frontera por separado:",{"_2868":60305,"_25194":60277,"_17578":103426,"_5":17474,"_23043":103357,"_2395":103427},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2868":60306,"_25194":60277,"_17578":103429,"_5":17474,"_23043":103357,"_2395":103430},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2868":60307,"_25194":60277,"_17578":103432,"_5":17474,"_23043":103357,"_2395":103433},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2868":60308,"_25194":60277,"_17578":103435,"_5":17474,"_23043":103357,"_2395":103436},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2868":60309,"_25194":60277,"_17578":103438,"_5":17474,"_23043":103357,"_2395":103439},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2868":60310,"_25194":60277,"_17578":103441,"_5":17474,"_23043":103357,"_2395":103442},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2868":60311,"_25194":60277,"_17578":103444,"_5":17474,"_23043":103361,"_2395":103445},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2868":60312,"_25194":60277,"_17578":103447,"_5":17474,"_23043":103361,"_2395":103448},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_48406":103450,"_48408":103451,"_48410":103452,"_48412":103453,"_15264":2417,"_57931":2417},"spanish",[2395,25194,5,23043],{"_2395":20987,"_25194":20987,"_5":20987,"_23043":20987},{"_2395":103454,"_25194":105832,"_5":108210,"_23043":11058