33581":48172,"_33583":48175,"_33585":48178,"_33587":48181,"_33589":48184,"_33591":48187,"_33593":48190,"_33595":48193,"_33597":48196,"_33599":48199,"_33601":48202,"_33603":48205,"_33605":48208,"_33607":48212,"_33609":48215,"_33611":48218,"_33613":48222,"_33615":48225,"_33617":48229,"_33619":48232,"_33621":48235,"_33623":48238,"_33625":48241,"_33627":48244,"_33629":48247,"_33631":48250,"_33633":48253,"_33635":48256,"_33637":48259,"_33639":48262,"_33641":48264,"_33643":48267,"_33645":48270,"_33647":48273,"_33649":48276,"_33651":48279,"_33653":48282,"_33655":48285,"_33657":48288,"_33659":48291,"_33661":48294,"_33663":48298,"_33665":48301,"_33667":48305,"_33669":48309,"_33671":48313,"_33673":48316,"_33675":48319,"_33677":48321,"_33679":48324,"_33681":48326,"_33683":48329,"_33685":48332,"_33687":48335,"_33689":48338,"_33691":48341,"_33693":48344,"_33695":48347,"_33697":48350,"_33699":48353,"_33701":48356,"_33703":48359,"_33705":48362,"_33707":48364,"_33709":48367,"_33711":48370,"_33713":48373,"_33715":48376,"_33717":48379,"_33719":48382,"_33721":48385,"_33723":48388,"_33725":48391,"_33727":48394,"_33729":48397,"_33731":48400},{"_2868":15,"_25194":15,"_5":12321,"_2395":40932,"_25530":40933,"_17578":40937,"_23043":15},"Deploy from AWS Marketplace",[40934,40935,40936],"Docs","Deployment","Other models",[],{"_2868":16,"_25194":15,"_17578":40939,"_5":17474,"_23043":15,"_2395":40940},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2868":17,"_25194":15,"_5":25527,"_17578":40942,"_23043":40943,"_2395":40944},[],"/docs/pr-preview/pr-39/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2868":18,"_25194":15,"_5":25527,"_17578":40946,"_23043":40947,"_2395":40948},[],"/docs/pr-preview/pr-39/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2868":19,"_25194":15,"_5":25527,"_17578":40950,"_23043":40951,"_2395":40952},[],"/docs/pr-preview/pr-39/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2868":20,"_25194":15,"_5":25527,"_17578":40954,"_23043":40955,"_2395":40956},[],"/docs/pr-preview/pr-39/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2868":21,"_25194":15,"_5":25527,"_17578":40958,"_23043":40959,"_2395":40960},[],"/docs/pr-preview/pr-39/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2868":22,"_25194":15,"_5":25527,"_17578":40962,"_23043":40963,"_2395":40964},[],"/docs/pr-preview/pr-39/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2868":23,"_25194":15,"_5":25527,"_17578":40966,"_23043":40967,"_2395":40968},[],"/docs/pr-preview/pr-39/deployment/aws-marketplace#next-step","Next step",{"_2868":24,"_25194":15,"_17578":40970,"_5":17474,"_23043":15,"_2395":40971},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2868":25,"_25194":15,"_17578":40973,"_5":17474,"_23043":40943,"_2395":40974},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2868":26,"_25194":15,"_17578":40976,"_5":17474,"_23043":40943,"_2395":40977},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2868":27,"_25194":15,"_17578":40979,"_5":17474,"_23043":40943,"_2395":40980},[],"A security group allowing the necessary endpoints.",{"_2868":28,"_25194":15,"_17578":40982,"_5":17474,"_23043":40947,"_2395":40983},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2868":29,"_25194":15,"_17578":40985,"_5":17474,"_23043":40947,"_2395":40986},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2868":30,"_25194":15,"_17578":40988,"_5":17474,"_23043":40947,"_2395":40989},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2868":31,"_25194":15,"_17578":40991,"_5":17474,"_23043":40951,"_2395":40992},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2868":32,"_25194":15,"_17578":40994,"_5":17474,"_23043":40955,"_2395":40995},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2868":33,"_25194":15,"_17578":40997,"_5":17474,"_23043":40959,"_2395":40998},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2868":34,"_25194":15,"_17578":41000,"_5":17474,"_23043":40963,"_2395":41001},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2868":35,"_25194":15,"_17578":41003,"_5":17474,"_23043":40967,"_2395":41004},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2868":36,"_25194":36,"_5":12321,"_2395":41006,"_25530":41007,"_17578":41008,"_23043":36},"Deploy Lamassu",[40934,40935],[],{"_2868":37,"_25194":36,"_17578":41010,"_5":17474,"_23043":36,"_2395":41011},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2868":38,"_25194":36,"_5":25527,"_17578":41013,"_23043":41014,"_2395":41015},[],"/docs/pr-preview/pr-39/deployment/overview#choose-a-model","Choose a model",{"_2868":39,"_25194":36,"_5":25527,"_17578":41017,"_23043":41018,"_2395":41019},[],"/docs/pr-preview/pr-39/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2868":40,"_25194":36,"_5":25527,"_17578":41021,"_23043":41022,"_2395":41023},[],"/docs/pr-preview/pr-39/deployment/overview#after-deployment","After deployment",{"_2868":41,"_25194":36,"_17578":41025,"_5":17474,"_23043":36,"_2395":41026},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2868":42,"_25194":36,"_17578":41028,"_5":17474,"_23043":41014,"_2395":41029},[],"Model",{"_2868":43,"_25194":36,"_17578":41031,"_5":17474,"_23043":41014,"_2395":41032},[],"Recommended for",{"_2868":44,"_25194":36,"_17578":41034,"_5":17474,"_23043":41014,"_2395":41035},[],"Who operates the infrastructure",{"_2868":45,"_25194":36,"_17578":41037,"_5":17474,"_23043":41014,"_2395":41038},[],"Starting point",{"_2868":46,"_25194":36,"_17578":41040,"_5":17474,"_23043":41014,"_2395":41041},[],"Kubernetes self-managed",{"_2868":47,"_25194":36,"_17578":41043,"_5":17474,"_23043":41014,"_2395":41044},[],"Production, regulated environments and custom deployments",{"_2868":48,"_25194":36,"_17578":41046,"_5":17474,"_23043":41014,"_2395":41047},[],"Your team",{"_2868":49,"_25194":36,"_17578":41049,"_5":17474,"_23043":41014,"_2395":41050},[],"Helm or Fastlane",{"_2868":50,"_25194":36,"_17578":41052,"_5":17474,"_23043":41014,"_2395":41053},[],"AWS Marketplace",{"_2868":51,"_25194":36,"_17578":41055,"_5":17474,"_23043":41014,"_2395":41056},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2868":52,"_25194":36,"_17578":41058,"_5":17474,"_23043":41014,"_2395":41047},[],{"_2868":53,"_25194":36,"_17578":41060,"_5":17474,"_23043":41014,"_2395":41061},[],"Preconfigured image on EC2",{"_2868":54,"_25194":36,"_17578":41063,"_5":17474,"_23043":41014,"_2395":41064},[],"SaaS",{"_2868":55,"_25194":36,"_17578":41066,"_5":17474,"_23043":41014,"_2395":41067},[],"Teams that want to use the platform without operating it",{"_2868":56,"_25194":36,"_17578":41069,"_5":17474,"_23043":41014,"_2395":41070},[],"Lamassu",{"_2868":57,"_25194":36,"_17578":41072,"_5":17474,"_23043":41014,"_2395":41073},[],"Managed subscription",{"_2868":58,"_25194":36,"_17578":41075,"_5":17474,"_23043":41014,"_2395":41076},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2868":59,"_25194":36,"_17578":41078,"_5":17474,"_23043":41014,"_2395":41079},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2868":60,"_25194":36,"_17578":41081,"_5":17474,"_23043":41014,"_2395":41082},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2868":61,"_25194":36,"_17578":41084,"_5":17474,"_23043":41018,"_2395":41085},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2868":62,"_25194":36,"_17578":41087,"_5":17474,"_23043":41022,"_2395":41088},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2868":63,"_25194":63,"_5":12321,"_2395":41090,"_25530":41091,"_17578":41092,"_23043":63},"Use Lamassu as SaaS",[40934,40935,40936],[],{"_2868":64,"_25194":63,"_17578":41094,"_5":17474,"_23043":63,"_2395":41095},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2868":65,"_25194":63,"_5":25527,"_17578":41097,"_23043":41098,"_2395":41099},[],"/docs/pr-preview/pr-39/deployment/saas#what-the-service-manages","What the service manages",{"_2868":66,"_25194":63,"_5":25527,"_17578":41101,"_23043":41102,"_2395":41103},[],"/docs/pr-preview/pr-39/deployment/saas#plans","Plans",{"_2868":67,"_25194":63,"_5":25527,"_17578":41105,"_23043":41106,"_2395":41107},[],"/docs/pr-preview/pr-39/deployment/saas#request-access","Request access",{"_2868":68,"_25194":63,"_17578":41109,"_5":17474,"_23043":63,"_2395":41110},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2868":69,"_25194":63,"_17578":41112,"_5":17474,"_23043":41098,"_2395":41113},[],"Platform availability and maintenance.",{"_2868":70,"_25194":63,"_17578":41115,"_5":17474,"_23043":41098,"_2395":41116},[],"Automatic backups.",{"_2868":71,"_25194":63,"_17578":41118,"_5":17474,"_23043":41098,"_2395":41119},[],"Version upgrades.",{"_2868":72,"_25194":63,"_17578":41121,"_5":17474,"_23043":41098,"_2395":41122},[],"Technical support and SLA according to your plan.",{"_2868":73,"_25194":63,"_17578":41124,"_5":17474,"_23043":41102,"_2395":41125},[],"Plan",{"_2868":74,"_25194":63,"_17578":41127,"_5":17474,"_23043":41102,"_2395":41128},[],"Devices",{"_2868":75,"_25194":63,"_17578":41130,"_5":17474,"_23043":41102,"_2395":41131},[],"Support",{"_2868":76,"_25194":63,"_17578":41133,"_5":17474,"_23043":41102,"_2395":41134},[],"SLA",{"_2868":77,"_25194":63,"_17578":41136,"_5":17474,"_23043":41102,"_2395":41137},[],"Starter",{"_2868":78,"_25194":63,"_17578":41139,"_5":17474,"_23043":41102,"_2395":41140},[],"Up to 1,000",{"_2868":79,"_25194":63,"_17578":41142,"_5":17474,"_23043":41102,"_2395":41143},[],"Email",{"_2868":80,"_25194":63,"_17578":41145,"_5":17474,"_23043":41102,"_2395":41146},[],"99.5 %",{"_2868":81,"_25194":63,"_17578":41148,"_5":17474,"_23043":41102,"_2395":41149},[],"Professional",{"_2868":82,"_25194":63,"_17578":41151,"_5":17474,"_23043":41102,"_2395":41152},[],"Up to 10,000",{"_2868":83,"_25194":63,"_17578":41154,"_5":17474,"_23043":41102,"_2395":41155},[],"Email and chat",{"_2868":84,"_25194":63,"_17578":41157,"_5":17474,"_23043":41102,"_2395":41158},[],"99.9 %",{"_2868":85,"_25194":63,"_17578":41160,"_5":17474,"_23043":41102,"_2395":41161},[],"Enterprise",{"_2868":86,"_25194":63,"_17578":41163,"_5":17474,"_23043":41102,"_2395":41164},[],"Unlimited",{"_2868":87,"_25194":63,"_17578":41166,"_5":17474,"_23043":41102,"_2395":41167},[],"Dedicated",{"_2868":88,"_25194":63,"_17578":41169,"_5":17474,"_23043":41102,"_2395":41170},[],"99.99 %",{"_2868":89,"_25194":63,"_17578":41172,"_5":17474,"_23043":41106,"_2395":41173},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2868":90,"_25194":63,"_17578":41175,"_5":17474,"_23043":41106,"_2395":41176},[],"When you receive your instance's credentials, continue with Get started.",{"_2868":91,"_25194":91,"_5":12321,"_2395":41178,"_25530":41179,"_17578":41180,"_23043":91},"Fastlane",[40934,40935,41041],[],{"_2868":92,"_25194":91,"_17578":41182,"_5":17474,"_23043":91,"_2395":41183},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2868":93,"_25194":91,"_5":25527,"_17578":41185,"_23043":41186,"_2395":41187},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2868":94,"_25194":91,"_5":25527,"_17578":41189,"_23043":41190,"_2395":41191},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2868":95,"_25194":91,"_5":25527,"_17578":41193,"_23043":41194,"_2395":40944},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#before-you-begin",{"_2868":96,"_25194":91,"_5":25527,"_17578":41196,"_23043":41197,"_2395":41198},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2868":97,"_25194":91,"_5":25527,"_17578":41200,"_23043":41201,"_2395":41202},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2868":98,"_25194":91,"_5":25527,"_17578":41204,"_23043":41205,"_2395":41206},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2868":99,"_25194":91,"_5":25527,"_17578":41208,"_23043":41209,"_2395":41210},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2868":100,"_25194":91,"_5":25527,"_17578":41212,"_23043":41213,"_2395":41214},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2868":101,"_25194":91,"_5":25527,"_17578":41216,"_23043":41217,"_2395":41218},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2868":102,"_25194":91,"_5":25527,"_17578":41220,"_23043":41221,"_2395":41222},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2868":103,"_25194":91,"_17578":41224,"_5":17474,"_23043":41186,"_2395":41225},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2868":104,"_25194":91,"_17578":41227,"_5":17474,"_23043":41186,"_2395":41228},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2868":105,"_25194":91,"_17578":41230,"_5":17474,"_23043":41190,"_2395":41231},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2868":106,"_25194":91,"_17578":41233,"_5":17474,"_23043":41190,"_2395":41234},[],"Fastlane installs or configures",{"_2868":107,"_25194":91,"_17578":41236,"_5":17474,"_23043":41190,"_2395":41237},[],"You still provide",{"_2868":108,"_25194":91,"_17578":41239,"_5":17474,"_23043":41190,"_2395":41240},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2868":109,"_25194":91,"_17578":41242,"_5":17474,"_23043":41190,"_2395":41243},[],"The Kubernetes cluster, nodes and persistent storage",{"_2868":110,"_25194":91,"_17578":41245,"_5":17474,"_23043":41190,"_2395":41246},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2868":111,"_25194":91,"_17578":41248,"_5":17474,"_23043":41190,"_2395":41249},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2868":112,"_25194":91,"_17578":41251,"_5":17474,"_23043":41190,"_2395":41252},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2868":113,"_25194":91,"_17578":41254,"_5":17474,"_23043":41190,"_2395":41255},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2868":114,"_25194":91,"_17578":41257,"_5":17474,"_23043":41190,"_2395":41258},[],"Optional observability and lab HSM components",{"_2868":115,"_25194":91,"_17578":41260,"_5":17474,"_23043":41190,"_2395":41261},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2868":116,"_25194":91,"_17578":41263,"_5":17474,"_23043":41190,"_2395":41264},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2868":117,"_25194":91,"_17578":41266,"_5":17474,"_23043":41194,"_2395":41267},[],"You need:",{"_2868":118,"_25194":91,"_17578":41269,"_5":17474,"_23043":41194,"_2395":41270},[],"an existing Kubernetes cluster",{"_2868":119,"_25194":91,"_17578":41272,"_5":17474,"_23043":41194,"_2395":41273},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2868":120,"_25194":91,"_17578":41275,"_5":17474,"_23043":41194,"_2395":41276},[],"`yq`",{"_2868":121,"_25194":91,"_17578":41278,"_5":17474,"_23043":41194,"_2395":19903},[],{"_2868":122,"_25194":91,"_17578":41280,"_5":17474,"_23043":41194,"_2395":41281},[],"`jq` only when using `--sample-data`",{"_2868":123,"_25194":91,"_17578":41283,"_5":17474,"_23043":41194,"_2395":41284},[],"free external ports 80 and 443 on a single-node K3s host",{"_2868":124,"_25194":91,"_17578":41286,"_5":17474,"_23043":41194,"_2395":41287},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2868":125,"_25194":91,"_17578":41289,"_5":17474,"_23043":41194,"_2395":41290},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2868":126,"_25194":91,"_17578":41292,"_5":17474,"_23043":41197,"_2395":41293},[],"Run the script from a clone of the Helm repository:",{"_2868":127,"_25194":91,"_17578":41295,"_5":17474,"_23043":41197,"_2395":41296},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2868":128,"_25194":91,"_17578":41298,"_5":17474,"_23043":41201,"_2395":41299},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2868":129,"_25194":91,"_17578":41301,"_5":17474,"_23043":41201,"_2395":41302},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2868":130,"_25194":91,"_17578":41304,"_5":17474,"_23043":41201,"_2395":41305},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2868":131,"_25194":91,"_17578":41307,"_5":17474,"_23043":41201,"_2395":41308},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2868":132,"_25194":91,"_17578":41310,"_5":17474,"_23043":41205,"_2395":41311},[],"Option",{"_2868":133,"_25194":91,"_17578":41313,"_5":17474,"_23043":41205,"_2395":41314},[],"Default",{"_2868":134,"_25194":91,"_17578":41316,"_5":17474,"_23043":41205,"_2395":41317},[],"Purpose",{"_2868":135,"_25194":91,"_17578":41319,"_5":17474,"_23043":41205,"_2395":41320},[],"`-h`, `--help`",{"_2868":136,"_25194":91,"_17578":41322,"_5":17474,"_23043":41205,"_2395":41323},[],"—",{"_2868":137,"_25194":91,"_17578":41325,"_5":17474,"_23043":41205,"_2395":41326},[],"Show help",{"_2868":138,"_25194":91,"_17578":41328,"_5":17474,"_23043":41205,"_2395":41329},[],"`-c`, `--context`",{"_2868":139,"_25194":91,"_17578":41331,"_5":17474,"_23043":41205,"_2395":41332},[],"current context",{"_2868":140,"_25194":91,"_17578":41334,"_5":17474,"_23043":41205,"_2395":41335},[],"Select the kubeconfig context for kubectl and Helm",{"_2868":141,"_25194":91,"_17578":41337,"_5":17474,"_23043":41205,"_2395":41338},[],"`-n`, `--non-interactive`",{"_2868":142,"_25194":91,"_17578":41340,"_5":17474,"_23043":41205,"_2395":5374},[],{"_2868":143,"_25194":91,"_17578":41342,"_5":17474,"_23043":41205,"_2395":41343},[],"Skip prompts and generate dependency credentials",{"_2868":144,"_25194":91,"_17578":41345,"_5":17474,"_23043":41205,"_2395":41346},[],"`-ns`, `--namespace`",{"_2868":145,"_25194":91,"_17578":41348,"_5":17474,"_23043":41205,"_2395":41349},[],"`lamassu-dev`",{"_2868":146,"_25194":91,"_17578":41351,"_5":17474,"_23043":41205,"_2395":41352},[],"Namespace for the installation",{"_2868":147,"_25194":91,"_17578":41354,"_5":17474,"_23043":41205,"_2395":41355},[],"`-d`, `--domain`",{"_2868":148,"_25194":91,"_17578":41357,"_5":17474,"_23043":41205,"_2395":41358},[],"`dev.lamassu.io`",{"_2868":149,"_25194":91,"_17578":41360,"_5":17474,"_23043":41205,"_2395":41361},[],"Domain used by the UI, OIDC and certificate",{"_2868":150,"_25194":91,"_17578":41363,"_5":17474,"_23043":41205,"_2395":41364},[],"`-v`, `--version`",{"_2868":151,"_25194":91,"_17578":41366,"_5":17474,"_23043":41205,"_2395":12547},[],{"_2868":152,"_25194":91,"_17578":41368,"_5":17474,"_23043":41205,"_2395":41369},[],"Lamassu chart version",{"_2868":153,"_25194":91,"_17578":41371,"_5":17474,"_23043":41205,"_2395":41372},[],"`--https-port`",{"_2868":154,"_25194":91,"_17578":41374,"_5":17474,"_23043":41205,"_2395":41375},[],"`443`",{"_2868":155,"_25194":91,"_17578":41377,"_5":17474,"_23043":41205,"_2395":41378},[],"Gateway HTTPS listener port",{"_2868":156,"_25194":91,"_17578":41380,"_5":17474,"_23043":41205,"_2395":41381},[],"`--http-port`",{"_2868":157,"_25194":91,"_17578":41383,"_5":17474,"_23043":41205,"_2395":41384},[],"`80`",{"_2868":158,"_25194":91,"_17578":41386,"_5":17474,"_23043":41205,"_2395":41387},[],"Gateway HTTP listener port",{"_2868":159,"_25194":91,"_17578":41389,"_5":17474,"_23043":41205,"_2395":41390},[],"`--tls-crt`",{"_2868":160,"_25194":91,"_17578":41392,"_5":17474,"_23043":41205,"_2395":41323},[],{"_2868":161,"_25194":91,"_17578":41394,"_5":17474,"_23043":41205,"_2395":41395},[],"PEM certificate for downstream TLS",{"_2868":162,"_25194":91,"_17578":41397,"_5":17474,"_23043":41205,"_2395":41398},[],"`--tls-key`",{"_2868":163,"_25194":91,"_17578":41400,"_5":17474,"_23043":41205,"_2395":41323},[],{"_2868":164,"_25194":91,"_17578":41402,"_5":17474,"_23043":41205,"_2395":41403},[],"PEM private key for downstream TLS",{"_2868":165,"_25194":91,"_17578":41405,"_5":17474,"_23043":41205,"_2395":41406},[],"`-l`, `--local-chart-path`",{"_2868":166,"_25194":91,"_17578":41408,"_5":17474,"_23043":41205,"_2395":41409},[],"repository chart",{"_2868":167,"_25194":91,"_17578":41411,"_5":17474,"_23043":41205,"_2395":41412},[],"Use an unpacked local Lamassu chart",{"_2868":168,"_25194":91,"_17578":41414,"_5":17474,"_23043":41205,"_2395":41415},[],"`-ip`, `--gateway-ip`",{"_2868":169,"_25194":91,"_17578":41417,"_5":17474,"_23043":41205,"_2395":7280},[],{"_2868":170,"_25194":91,"_17578":41419,"_5":17474,"_23043":41205,"_2395":41420},[],"Override the address written to `gateway.addresses`",{"_2868":171,"_25194":91,"_17578":41422,"_5":17474,"_23043":41205,"_2395":41423},[],"`--otel`",{"_2868":172,"_25194":91,"_17578":41425,"_5":17474,"_23043":41205,"_2395":5374},[],{"_2868":173,"_25194":91,"_17578":41427,"_5":17474,"_23043":41205,"_2395":41428},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2868":174,"_25194":91,"_17578":41430,"_5":17474,"_23043":41205,"_2395":41431},[],"`--sample-data`",{"_2868":175,"_25194":91,"_17578":41433,"_5":17474,"_23043":41205,"_2395":5374},[],{"_2868":176,"_25194":91,"_17578":41435,"_5":17474,"_23043":41205,"_2395":41436},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2868":177,"_25194":91,"_17578":41438,"_5":17474,"_23043":41205,"_2395":41439},[],"`--with-hsm`",{"_2868":178,"_25194":91,"_17578":41441,"_5":17474,"_23043":41205,"_2395":5374},[],{"_2868":179,"_25194":91,"_17578":41443,"_5":17474,"_23043":41205,"_2395":41444},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2868":180,"_25194":91,"_17578":41446,"_5":17474,"_23043":41205,"_2395":41447},[],"`--softhsm-chart-path`",{"_2868":181,"_25194":91,"_17578":41449,"_5":17474,"_23043":41205,"_2395":41450},[],"`./charts/softhsm`",{"_2868":182,"_25194":91,"_17578":41452,"_5":17474,"_23043":41205,"_2395":41453},[],"Use a different local SoftHSM chart",{"_2868":183,"_25194":91,"_17578":41455,"_5":17474,"_23043":41205,"_2395":41456},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2868":184,"_25194":91,"_17578":41458,"_5":17474,"_23043":41209,"_2395":41459},[],"Fastlane:",{"_2868":185,"_25194":91,"_17578":41461,"_5":17474,"_23043":41209,"_2395":41462},[],"validates local tools and the selected cluster",{"_2868":186,"_25194":91,"_17578":41464,"_5":17474,"_23043":41209,"_2395":41465},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2868":187,"_25194":91,"_17578":41467,"_5":17474,"_23043":41209,"_2395":41468},[],"creates the namespace",{"_2868":188,"_25194":91,"_17578":41470,"_5":17474,"_23043":41209,"_2395":41471},[],"installs PostgreSQL and creates the required databases",{"_2868":189,"_25194":91,"_17578":41473,"_5":17474,"_23043":41209,"_2395":41474},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2868":190,"_25194":91,"_17578":41476,"_5":17474,"_23043":41209,"_2395":41477},[],"installs RabbitMQ",{"_2868":191,"_25194":91,"_17578":41479,"_5":17474,"_23043":41209,"_2395":41480},[],"optionally installs observability and lab HSM components",{"_2868":192,"_25194":91,"_17578":41482,"_5":17474,"_23043":41209,"_2395":41483},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2868":193,"_25194":91,"_17578":41485,"_5":17474,"_23043":41209,"_2395":41486},[],"optionally loads sample data",{"_2868":194,"_25194":91,"_17578":41488,"_5":17474,"_23043":41209,"_2395":41489},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2868":195,"_25194":91,"_17578":41491,"_5":17474,"_23043":41213,"_2395":41492},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2868":196,"_25194":91,"_17578":41494,"_5":17474,"_23043":41213,"_2395":41495},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2868":197,"_25194":91,"_17578":41497,"_5":17474,"_23043":41217,"_2395":41498},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2868":198,"_25194":91,"_17578":41500,"_5":17474,"_23043":41217,"_2395":41501},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2868":199,"_25194":91,"_17578":41503,"_5":17474,"_23043":41217,"_2395":41504},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2868":200,"_25194":91,"_17578":41506,"_5":17474,"_23043":41221,"_2395":41507},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2868":201,"_25194":201,"_5":12321,"_2395":41509,"_25530":41510,"_17578":41511,"_23043":201},"Install with Helm",[40934,40935,41041],[],{"_2868":202,"_25194":201,"_17578":41513,"_5":17474,"_23043":201,"_2395":41514},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2868":203,"_25194":201,"_5":25527,"_17578":41516,"_23043":41517,"_2395":41518},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2868":204,"_25194":201,"_5":25527,"_17578":41520,"_23043":41521,"_2395":40944},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#before-you-begin",{"_2868":205,"_25194":201,"_5":25527,"_17578":41523,"_23043":41524,"_2395":41525},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2868":206,"_25194":201,"_5":25527,"_17578":41527,"_23043":41528,"_2395":41529},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2868":207,"_25194":201,"_5":25527,"_17578":41531,"_23043":41532,"_2395":41533},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2868":208,"_25194":201,"_5":25527,"_17578":41535,"_23043":41536,"_2395":41537},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2868":209,"_25194":201,"_5":25527,"_17578":41539,"_23043":41540,"_2395":41541},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2868":210,"_25194":201,"_5":25527,"_17578":41543,"_23043":41544,"_2395":41545},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2868":211,"_25194":201,"_5":25527,"_17578":41547,"_23043":41548,"_2395":41549},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2868":212,"_25194":201,"_17578":41551,"_5":17474,"_23043":41517,"_2395":41552},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2868":213,"_25194":201,"_17578":41554,"_5":17474,"_23043":41521,"_2395":41555},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2868":214,"_25194":201,"_17578":41557,"_5":17474,"_23043":41521,"_2395":41558},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2868":215,"_25194":201,"_17578":41560,"_5":17474,"_23043":41521,"_2395":41561},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2868":216,"_25194":201,"_17578":41563,"_5":17474,"_23043":41521,"_2395":41564},[],"a reachable RabbitMQ broker and credentials",{"_2868":217,"_25194":201,"_17578":41566,"_5":17474,"_23043":41521,"_2395":41567},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2868":218,"_25194":201,"_17578":41569,"_5":17474,"_23043":41521,"_2395":41570},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2868":219,"_25194":201,"_17578":41572,"_5":17474,"_23043":41521,"_2395":41573},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2868":220,"_25194":201,"_17578":41575,"_5":17474,"_23043":41521,"_2395":41576},[],"a StorageClass and an external traffic design",{"_2868":221,"_25194":201,"_17578":41578,"_5":17474,"_23043":41521,"_2395":41579},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2868":222,"_25194":201,"_17578":41581,"_5":17474,"_23043":41521,"_2395":41582},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2868":223,"_25194":201,"_17578":41584,"_5":17474,"_23043":41521,"_2395":41585},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2868":224,"_25194":201,"_17578":41587,"_5":17474,"_23043":41524,"_2395":41588},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2868":225,"_25194":201,"_17578":41590,"_5":17474,"_23043":41524,"_2395":41591},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2868":226,"_25194":201,"_17578":41593,"_5":17474,"_23043":41524,"_2395":41594},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2868":227,"_25194":201,"_17578":41596,"_5":17474,"_23043":41528,"_2395":41597},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2868":228,"_25194":201,"_17578":41599,"_5":17474,"_23043":41528,"_2395":41600},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2868":229,"_25194":201,"_17578":41602,"_5":17474,"_23043":41528,"_2395":41603},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2868":230,"_25194":201,"_17578":41605,"_5":17474,"_23043":41532,"_2395":41606},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2868":231,"_25194":201,"_17578":41608,"_5":17474,"_23043":41536,"_2395":41609},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2868":232,"_25194":201,"_17578":41611,"_5":17474,"_23043":41536,"_2395":41612},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2868":233,"_25194":201,"_17578":41614,"_5":17474,"_23043":41536,"_2395":41615},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2868":234,"_25194":201,"_17578":41617,"_5":17474,"_23043":41536,"_2395":41618},[],"See Access control for the principal and policy model.",{"_2868":235,"_25194":201,"_17578":41620,"_5":17474,"_23043":41540,"_2395":41621},[],"To install a local checkout instead:",{"_2868":236,"_25194":201,"_17578":41623,"_5":17474,"_23043":41544,"_2395":41624},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2868":237,"_25194":201,"_17578":41626,"_5":17474,"_23043":41544,"_2395":41627},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2868":238,"_25194":201,"_17578":41629,"_5":17474,"_23043":41548,"_2395":41630},[],"Before going live, review:",{"_2868":239,"_25194":201,"_17578":41632,"_5":17474,"_23043":41548,"_2395":41633},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2868":240,"_25194":201,"_17578":41635,"_5":17474,"_23043":41548,"_2395":41636},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2868":241,"_25194":201,"_17578":41638,"_5":17474,"_23043":41548,"_2395":41639},[],"shared VA storage before increasing VA replicas",{"_2868":242,"_25194":201,"_17578":41641,"_5":17474,"_23043":41548,"_2395":41642},[],"managed OIDC roles and removal of evaluation credentials",{"_2868":243,"_25194":201,"_17578":41644,"_5":17474,"_23043":41548,"_2395":41645},[],"a trusted TLS issuer or externally managed certificate",{"_2868":244,"_25194":201,"_17578":41647,"_5":17474,"_23043":41548,"_2395":41648},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2868":245,"_25194":201,"_17578":41650,"_5":17474,"_23043":41548,"_2395":41651},[],"SMTP, observability and alert delivery",{"_2868":246,"_25194":201,"_17578":41653,"_5":17474,"_23043":41548,"_2395":41654},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2868":247,"_25194":201,"_17578":41656,"_5":17474,"_23043":41548,"_2395":41657},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2868":248,"_25194":248,"_5":12321,"_2395":41659,"_25530":41660,"_17578":41661,"_23043":248},"Expose the Gateway",[40934,40935,41041],[],{"_2868":249,"_25194":248,"_17578":41663,"_5":17474,"_23043":248,"_2395":41664},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2868":250,"_25194":248,"_5":25527,"_17578":41666,"_23043":41667,"_2395":41668},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2868":251,"_25194":248,"_5":25527,"_17578":41670,"_23043":41671,"_2395":41672},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2868":252,"_25194":248,"_5":25527,"_17578":41674,"_23043":41675,"_2395":41676},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2868":253,"_25194":248,"_5":25527,"_17578":41678,"_23043":41679,"_2395":41680},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#k3s","K3s",{"_2868":254,"_25194":248,"_5":25527,"_17578":41682,"_23043":41683,"_2395":41684},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2868":255,"_25194":248,"_5":25527,"_17578":41686,"_23043":41687,"_2395":41688},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2868":256,"_25194":248,"_5":25527,"_17578":41690,"_23043":41691,"_2395":41692},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2868":257,"_25194":248,"_5":25527,"_17578":41694,"_23043":41695,"_2395":41696},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2868":258,"_25194":248,"_5":25527,"_17578":41698,"_23043":41699,"_2395":41700},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2868":259,"_25194":248,"_17578":41702,"_5":17474,"_23043":41667,"_2395":41703},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2868":260,"_25194":248,"_17578":41705,"_5":17474,"_23043":41667,"_2395":41706},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2868":261,"_25194":248,"_17578":41708,"_5":17474,"_23043":41671,"_2395":41709},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2868":262,"_25194":248,"_17578":41711,"_5":17474,"_23043":41671,"_2395":41712},[],"Set it only when:",{"_2868":263,"_25194":248,"_17578":41714,"_5":17474,"_23043":41671,"_2395":41715},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2868":264,"_25194":248,"_17578":41717,"_5":17474,"_23043":41671,"_2395":41718},[],"that address is allocated to this Gateway",{"_2868":265,"_25194":248,"_17578":41720,"_5":17474,"_23043":41671,"_2395":41721},[],"the surrounding network already routes traffic for it to the cluster",{"_2868":266,"_25194":248,"_17578":41723,"_5":17474,"_23043":41671,"_2395":41724},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2868":267,"_25194":248,"_17578":41726,"_5":17474,"_23043":41671,"_2395":41727},[],"Keep these two settings separate:",{"_2868":268,"_25194":248,"_17578":41729,"_5":17474,"_23043":41671,"_2395":41730},[],"`gateway.addresses` requests an address for the Gateway.",{"_2868":269,"_25194":248,"_17578":41732,"_5":17474,"_23043":41671,"_2395":41733},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2868":270,"_25194":248,"_17578":41735,"_5":17474,"_23043":41671,"_2395":41736},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2868":271,"_25194":248,"_17578":41738,"_5":17474,"_23043":41675,"_2395":41739},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2868":272,"_25194":248,"_17578":41741,"_5":17474,"_23043":41675,"_2395":41742},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2868":273,"_25194":248,"_17578":41744,"_5":17474,"_23043":41679,"_2395":41745},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2868":274,"_25194":248,"_17578":41747,"_5":17474,"_23043":41679,"_2395":41748},[],"For the recommended design:",{"_2868":275,"_25194":248,"_17578":41750,"_5":17474,"_23043":41679,"_2395":41751},[],"Use only one externally exposed Lamassu Gateway.",{"_2868":276,"_25194":248,"_17578":41753,"_5":17474,"_23043":41679,"_2395":41754},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2868":277,"_25194":248,"_17578":41756,"_5":17474,"_23043":41679,"_2395":41757},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2868":278,"_25194":248,"_17578":41759,"_5":17474,"_23043":41679,"_2395":41760},[],"Point DNS at the VM's reachable address.",{"_2868":279,"_25194":248,"_17578":41762,"_5":17474,"_23043":41679,"_2395":41763},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2868":280,"_25194":248,"_17578":41765,"_5":17474,"_23043":41683,"_2395":41766},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2868":281,"_25194":248,"_17578":41768,"_5":17474,"_23043":41687,"_2395":41769},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2868":282,"_25194":248,"_17578":41771,"_5":17474,"_23043":41687,"_2395":41772},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2868":283,"_25194":248,"_17578":41774,"_5":17474,"_23043":41691,"_2395":41775},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2868":284,"_25194":248,"_17578":41777,"_5":17474,"_23043":41691,"_2395":41778},[],"Requirement",{"_2868":285,"_25194":248,"_17578":41780,"_5":17474,"_23043":41691,"_2395":41781},[],"Recommended design",{"_2868":286,"_25194":248,"_17578":41783,"_5":17474,"_23043":41691,"_2395":41784},[],"Consequence",{"_2868":287,"_25194":248,"_17578":41786,"_5":17474,"_23043":41691,"_2395":41787},[],"Several Lamassu URLs or services",{"_2868":288,"_25194":248,"_17578":41789,"_5":17474,"_23043":41691,"_2395":41790},[],"One Gateway with multiple routes",{"_2868":289,"_25194":248,"_17578":41792,"_5":17474,"_23043":41691,"_2395":41793},[],"One IP and one proxy fleet; this is the chart default",{"_2868":290,"_25194":248,"_17578":41795,"_5":17474,"_23043":41691,"_2395":41796},[],"Independent Gateways and separate external IPs",{"_2868":291,"_25194":248,"_17578":41798,"_5":17474,"_23043":41691,"_2395":41799},[],"One VIP per Gateway",{"_2868":292,"_25194":248,"_17578":41801,"_5":17474,"_23043":41691,"_2395":41802},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2868":293,"_25194":248,"_17578":41804,"_5":17474,"_23043":41691,"_2395":41805},[],"Independent Gateways on one node and one IP",{"_2868":294,"_25194":248,"_17578":41807,"_5":17474,"_23043":41691,"_2395":41808},[],"Use different external ports",{"_2868":295,"_25194":248,"_17578":41810,"_5":17474,"_23043":41691,"_2395":41811},[],"Clients must include non-standard ports",{"_2868":296,"_25194":248,"_17578":41813,"_5":17474,"_23043":41691,"_2395":41814},[],"Separate TLS/mTLS termination behind one IP",{"_2868":297,"_25194":248,"_17578":41816,"_5":17474,"_23043":41691,"_2395":41817},[],"Front-door SNI routing to internal Gateways",{"_2868":298,"_25194":248,"_17578":41819,"_5":17474,"_23043":41691,"_2395":41820},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2868":299,"_25194":248,"_17578":41822,"_5":17474,"_23043":41691,"_2395":41823},[],"Separate Gateway resources but shared proxy infrastructure",{"_2868":300,"_25194":248,"_17578":41825,"_5":17474,"_23043":41691,"_2395":41826},[],"Envoy merged-Gateway mode",{"_2868":301,"_25194":248,"_17578":41828,"_5":17474,"_23043":41691,"_2395":41829},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2868":302,"_25194":248,"_17578":41831,"_5":17474,"_23043":41691,"_2395":41832},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2868":303,"_25194":248,"_17578":41834,"_5":17474,"_23043":41691,"_2395":41835},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2868":304,"_25194":248,"_17578":41837,"_5":17474,"_23043":41691,"_2395":41838},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2868":305,"_25194":248,"_17578":41840,"_5":17474,"_23043":41691,"_2395":41841},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2868":306,"_25194":248,"_17578":41843,"_5":17474,"_23043":41695,"_2395":41844},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2868":307,"_25194":248,"_17578":41846,"_5":17474,"_23043":41695,"_2395":41847},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2868":308,"_25194":248,"_17578":41849,"_5":17474,"_23043":41695,"_2395":41850},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2868":309,"_25194":248,"_17578":41852,"_5":17474,"_23043":41695,"_2395":41853},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2868":310,"_25194":248,"_17578":41855,"_5":17474,"_23043":41695,"_2395":41856},[],"If none of those are possible, use different external ports or change the external network design.",{"_2868":311,"_25194":248,"_17578":41858,"_5":17474,"_23043":41699,"_2395":41859},[],"Check, in order:",{"_2868":312,"_25194":248,"_17578":41861,"_5":17474,"_23043":41699,"_2395":41862},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2868":313,"_25194":248,"_17578":41864,"_5":17474,"_23043":41699,"_2395":41865},[],"Its status contains the expected address.",{"_2868":314,"_25194":248,"_17578":41867,"_5":17474,"_23043":41699,"_2395":41868},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2868":315,"_25194":248,"_17578":41870,"_5":17474,"_23043":41699,"_2395":41871},[],"Port 443 reaches that address from the client network.",{"_2868":316,"_25194":248,"_17578":41873,"_5":17474,"_23043":41699,"_2395":41874},[],"DNS resolves to the externally reachable endpoint.",{"_2868":317,"_25194":248,"_17578":41876,"_5":17474,"_23043":41699,"_2395":41877},[],"The certificate contains the DNS name or IP used by the client.",{"_2868":318,"_25194":248,"_17578":41879,"_5":17474,"_23043":41699,"_2395":41880},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2868":319,"_25194":319,"_5":12321,"_2395":41041,"_25530":41882,"_17578":41883,"_23043":319},[40934,40935,41041],[],{"_2868":320,"_25194":319,"_17578":41885,"_5":17474,"_23043":319,"_2395":41886},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2868":321,"_25194":319,"_5":25527,"_17578":41888,"_23043":41889,"_2395":41890},[],"/docs/pr-preview/pr-39/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2868":322,"_25194":319,"_5":25527,"_17578":41892,"_23043":41893,"_2395":41894},[],"/docs/pr-preview/pr-39/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2868":323,"_25194":319,"_5":25527,"_17578":41896,"_23043":41897,"_2395":41898},[],"/docs/pr-preview/pr-39/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2868":324,"_25194":319,"_5":25527,"_17578":41900,"_23043":41901,"_2395":41902},[],"/docs/pr-preview/pr-39/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2868":325,"_25194":319,"_5":25527,"_17578":41904,"_23043":41905,"_2395":41906},[],"/docs/pr-preview/pr-39/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2868":326,"_25194":319,"_5":25527,"_17578":41908,"_23043":41909,"_2395":41910},[],"/docs/pr-preview/pr-39/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2868":327,"_25194":319,"_17578":41912,"_5":17474,"_23043":41889,"_2395":41913},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2868":328,"_25194":319,"_17578":41915,"_5":17474,"_23043":41893,"_2395":41916},[],"Workflow",{"_2868":329,"_25194":319,"_17578":41918,"_5":17474,"_23043":41893,"_2395":41919},[],"Use it for",{"_2868":330,"_25194":319,"_17578":41921,"_5":17474,"_23043":41893,"_2395":41922},[],"What it installs",{"_2868":331,"_25194":319,"_17578":41924,"_5":17474,"_23043":41893,"_2395":41925},[],"Helm",{"_2868":332,"_25194":319,"_17578":41927,"_5":17474,"_23043":41893,"_2395":41928},[],"Production and controlled environments",{"_2868":333,"_25194":319,"_17578":41930,"_5":17474,"_23043":41893,"_2395":41931},[],"Lamassu services and Gateway API resources",{"_2868":334,"_25194":319,"_17578":41933,"_5":17474,"_23043":41893,"_2395":41178},[],{"_2868":335,"_25194":319,"_17578":41935,"_5":17474,"_23043":41893,"_2395":41936},[],"Evaluation, demos, CI and small lab clusters",{"_2868":336,"_25194":319,"_17578":41938,"_5":17474,"_23043":41893,"_2395":41939},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2868":337,"_25194":319,"_17578":41941,"_5":17474,"_23043":41897,"_2395":41942},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2868":338,"_25194":319,"_17578":41944,"_5":17474,"_23043":41897,"_2395":41945},[],"Area",{"_2868":339,"_25194":319,"_17578":41947,"_5":17474,"_23043":41897,"_2395":41948},[],"The Lamassu chart provides",{"_2868":340,"_25194":319,"_17578":41950,"_5":17474,"_23043":41897,"_2395":41951},[],"You provide",{"_2868":341,"_25194":319,"_17578":41953,"_5":17474,"_23043":41897,"_2395":41954},[],"Lamassu applications",{"_2868":342,"_25194":319,"_17578":41956,"_5":17474,"_23043":41897,"_2395":41957},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2868":343,"_25194":319,"_17578":41959,"_5":17474,"_23043":41897,"_2395":41960},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2868":344,"_25194":319,"_17578":41962,"_5":17474,"_23043":41897,"_2395":41963},[],"PostgreSQL data",{"_2868":345,"_25194":319,"_17578":41965,"_5":17474,"_23043":41897,"_2395":41966},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2868":346,"_25194":319,"_17578":41968,"_5":17474,"_23043":41897,"_2395":41969},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2868":347,"_25194":319,"_17578":41971,"_5":17474,"_23043":41897,"_2395":41972},[],"Messaging",{"_2868":348,"_25194":319,"_17578":41974,"_5":17474,"_23043":41897,"_2395":41975},[],"RabbitMQ connection configuration for the Lamassu services",{"_2868":349,"_25194":319,"_17578":41977,"_5":17474,"_23043":41897,"_2395":41978},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2868":350,"_25194":319,"_17578":41980,"_5":17474,"_23043":41897,"_2395":41981},[],"Identity",{"_2868":351,"_25194":319,"_17578":41983,"_5":17474,"_23043":41897,"_2395":41984},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2868":352,"_25194":319,"_17578":41986,"_5":17474,"_23043":41897,"_2395":41987},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2868":353,"_25194":319,"_17578":41989,"_5":17474,"_23043":41897,"_2395":41990},[],"External routing",{"_2868":354,"_25194":319,"_17578":41992,"_5":17474,"_23043":41897,"_2395":41993},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2868":355,"_25194":319,"_17578":41995,"_5":17474,"_23043":41897,"_2395":41996},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2868":356,"_25194":319,"_17578":41998,"_5":17474,"_23043":41897,"_2395":41999},[],"TLS",{"_2868":357,"_25194":319,"_17578":42001,"_5":17474,"_23043":41897,"_2395":42002},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2868":358,"_25194":319,"_17578":42004,"_5":17474,"_23043":41897,"_2395":42005},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2868":359,"_25194":319,"_17578":42007,"_5":17474,"_23043":41897,"_2395":42008},[],"Persistent application data",{"_2868":360,"_25194":319,"_17578":42010,"_5":17474,"_23043":41897,"_2395":42011},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2868":361,"_25194":319,"_17578":42013,"_5":17474,"_23043":41897,"_2395":42014},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2868":362,"_25194":319,"_17578":42016,"_5":17474,"_23043":41897,"_2395":42017},[],"Optional integrations",{"_2868":363,"_25194":319,"_17578":42019,"_5":17474,"_23043":41897,"_2395":42020},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2868":364,"_25194":319,"_17578":42022,"_5":17474,"_23043":41897,"_2395":42023},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2868":365,"_25194":319,"_17578":42025,"_5":17474,"_23043":41897,"_2395":42026},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2868":366,"_25194":319,"_17578":42028,"_5":17474,"_23043":41897,"_2395":42029},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2868":367,"_25194":319,"_17578":42031,"_5":17474,"_23043":41901,"_2395":42032},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2868":368,"_25194":319,"_17578":42034,"_5":17474,"_23043":41901,"_2395":42035},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2868":369,"_25194":319,"_17578":42037,"_5":17474,"_23043":41905,"_2395":42038},[],"Kubernetes 1.24 or newer",{"_2868":370,"_25194":319,"_17578":42040,"_5":17474,"_23043":41905,"_2395":42041},[],"Helm 3.2 or newer",{"_2868":371,"_25194":319,"_17578":42043,"_5":17474,"_23043":41905,"_2395":42044},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2868":372,"_25194":319,"_17578":42046,"_5":17474,"_23043":41905,"_2395":42047},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2868":373,"_25194":319,"_17578":42049,"_5":17474,"_23043":41905,"_2395":42050},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2868":374,"_25194":319,"_17578":42052,"_5":17474,"_23043":41905,"_2395":42053},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2868":375,"_25194":319,"_17578":42055,"_5":17474,"_23043":41905,"_2395":42056},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2868":376,"_25194":319,"_17578":42058,"_5":17474,"_23043":41909,"_2395":42059},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2868":377,"_25194":319,"_17578":42061,"_5":17474,"_23043":41909,"_2395":42062},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2868":378,"_25194":319,"_17578":42064,"_5":17474,"_23043":41909,"_2395":42065},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2868":379,"_25194":379,"_5":12321,"_2395":42067,"_25530":42068,"_17578":42070,"_23043":379},"Deployment troubleshooting",[40934,40935,42069],"Operations",[],{"_2868":380,"_25194":379,"_17578":42072,"_5":17474,"_23043":379,"_2395":42073},[],"Diagnose access, service health and infrastructure dependencies.",{"_2868":381,"_25194":379,"_5":25527,"_17578":42075,"_23043":42076,"_2395":42077},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2868":382,"_25194":379,"_5":25527,"_17578":42079,"_23043":42080,"_2395":42081},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2868":383,"_25194":379,"_5":25527,"_17578":42083,"_23043":42084,"_2395":42085},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2868":384,"_25194":379,"_5":25527,"_17578":42087,"_23043":42088,"_2395":42089},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2868":385,"_25194":379,"_5":25527,"_17578":42091,"_23043":42092,"_2395":42093},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2868":386,"_25194":379,"_5":25527,"_17578":42095,"_23043":42096,"_2395":42097},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2868":387,"_25194":379,"_5":25527,"_17578":42099,"_23043":42100,"_2395":42101},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2868":388,"_25194":379,"_5":25527,"_17578":42103,"_23043":42104,"_2395":42105},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2868":389,"_25194":379,"_5":25527,"_17578":42107,"_23043":42108,"_2395":42109},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2868":390,"_25194":379,"_5":25527,"_17578":42111,"_23043":42112,"_2395":42113},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2868":391,"_25194":379,"_5":25527,"_17578":42115,"_23043":42116,"_2395":42117},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2868":392,"_25194":379,"_5":25527,"_17578":42119,"_23043":42120,"_2395":42121},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#observability","Observability",{"_2868":393,"_25194":379,"_17578":42123,"_5":17474,"_23043":379,"_2395":42124},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2868":394,"_25194":379,"_17578":42126,"_5":17474,"_23043":42080,"_2395":42127},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2868":395,"_25194":379,"_17578":42129,"_5":17474,"_23043":42084,"_2395":42130},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2868":396,"_25194":379,"_17578":42132,"_5":17474,"_23043":42088,"_2395":42133},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2868":397,"_25194":379,"_17578":42135,"_5":17474,"_23043":42092,"_2395":42136},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2868":398,"_25194":379,"_17578":42138,"_5":17474,"_23043":42096,"_2395":42139},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2868":399,"_25194":379,"_17578":42141,"_5":17474,"_23043":42100,"_2395":42142},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2868":400,"_25194":379,"_17578":42144,"_5":17474,"_23043":42100,"_2395":42145},[],"Also run the chart's connectivity test:",{"_2868":401,"_25194":379,"_17578":42147,"_5":17474,"_23043":42100,"_2395":42148},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2868":402,"_25194":379,"_17578":42150,"_5":17474,"_23043":42100,"_2395":42151},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2868":403,"_25194":379,"_17578":42153,"_5":17474,"_23043":42104,"_2395":42154},[],"If you receive a 401:",{"_2868":404,"_25194":379,"_17578":42156,"_5":17474,"_23043":42104,"_2395":42157},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2868":405,"_25194":379,"_17578":42159,"_5":17474,"_23043":42104,"_2395":42160},[],"verify issuer, audience and expiration of the token;",{"_2868":406,"_25194":379,"_17578":42162,"_5":17474,"_23043":42104,"_2395":42163},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2868":407,"_25194":379,"_17578":42165,"_5":17474,"_23043":42104,"_2395":42166},[],"check that the provider's public and internal routes point to the same realm.",{"_2868":408,"_25194":379,"_17578":42168,"_5":17474,"_23043":42104,"_2395":42169},[],"If login succeeds but the APIs return 403:",{"_2868":409,"_25194":379,"_17578":42171,"_5":17474,"_23043":42104,"_2395":42172},[],"inspect the token's real claims;",{"_2868":410,"_25194":379,"_17578":42174,"_5":17474,"_23043":42104,"_2395":42175},[],"confirm they match an active principal;",{"_2868":411,"_25194":379,"_17578":42177,"_5":17474,"_23043":42104,"_2395":42178},[],"review the policies granted to that principal;",{"_2868":412,"_25194":379,"_17578":42180,"_5":17474,"_23043":42104,"_2395":42181},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2868":413,"_25194":379,"_17578":42183,"_5":17474,"_23043":42104,"_2395":42184},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2868":414,"_25194":379,"_17578":42186,"_5":17474,"_23043":42108,"_2395":42187},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2868":415,"_25194":379,"_17578":42189,"_5":17474,"_23043":42108,"_2395":42190},[],"Locate the authz pod and Service.",{"_2868":416,"_25194":379,"_17578":42192,"_5":17474,"_23043":42108,"_2395":42193},[],"Check /health, logs and its database connection.",{"_2868":417,"_25194":379,"_17578":42195,"_5":17474,"_23043":42108,"_2395":42196},[],"Verify the DNS and port configured in externalAuthorization.",{"_2868":418,"_25194":379,"_17578":42198,"_5":17474,"_23043":42108,"_2395":42199},[],"Check the check route is /v1/ext\\_authz/check.",{"_2868":419,"_25194":379,"_17578":42201,"_5":17474,"_23043":42108,"_2395":42202},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2868":420,"_25194":379,"_17578":42204,"_5":17474,"_23043":42112,"_2395":42205},[],"Review kubectl describe pod first. Common causes are:",{"_2868":421,"_25194":379,"_17578":42207,"_5":17474,"_23043":42112,"_2395":42208},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2868":422,"_25194":379,"_17578":42210,"_5":17474,"_23043":42112,"_2395":42211},[],"unbound persistent volume;",{"_2868":423,"_25194":379,"_17578":42213,"_5":17474,"_23043":42112,"_2395":42214},[],"inaccessible image or incorrect pull policy;",{"_2868":424,"_25194":379,"_17578":42216,"_5":17474,"_23043":42112,"_2395":42217},[],"invalid cryptographic engine configuration;",{"_2868":425,"_25194":379,"_17578":42219,"_5":17474,"_23043":42112,"_2395":42220},[],"CPU or memory limits set too low;",{"_2868":426,"_25194":379,"_17578":42222,"_5":17474,"_23043":42112,"_2395":42223},[],"an incomplete prior migration.",{"_2868":427,"_25194":379,"_17578":42225,"_5":17474,"_23043":42112,"_2395":42226},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2868":428,"_25194":379,"_17578":42228,"_5":17474,"_23043":42112,"_2395":42229},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2868":429,"_25194":379,"_17578":42231,"_5":17474,"_23043":42116,"_2395":42232},[],"Domain and audit events depend on the bus publisher:",{"_2868":430,"_25194":379,"_17578":42234,"_5":17474,"_23043":42116,"_2395":42235},[],"verify it is enabled in the emitting service;",{"_2868":431,"_25194":379,"_17578":42237,"_5":17474,"_23043":42116,"_2395":42238},[],"check AMQP connectivity and credentials;",{"_2868":432,"_25194":379,"_17578":42240,"_5":17474,"_23043":42116,"_2395":42241},[],"review exchange, routing key, queues and consumers;",{"_2868":433,"_25194":379,"_17578":42243,"_5":17474,"_23043":42116,"_2395":42244},[],"inspect dead-letter queues;",{"_2868":434,"_25194":379,"_17578":42246,"_5":17474,"_23043":42116,"_2395":42247},[],"alert on orphan durable queues and backlog growth.",{"_2868":435,"_25194":379,"_17578":42249,"_5":17474,"_23043":42116,"_2395":42250},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2868":436,"_25194":379,"_17578":42252,"_5":17474,"_23043":42120,"_2395":42253},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2868":437,"_25194":379,"_17578":42255,"_5":17474,"_23043":42120,"_2395":42256},[],"Before closing an incident, record:",{"_2868":438,"_25194":379,"_17578":42258,"_5":17474,"_23043":42120,"_2395":42259},[],"the confirmed cause;",{"_2868":439,"_25194":379,"_17578":42261,"_5":17474,"_23043":42120,"_2395":42262},[],"the time scope and affected resources;",{"_2868":440,"_25194":379,"_17578":42264,"_5":17474,"_23043":42120,"_2395":42265},[],"the commands or queries used;",{"_2868":441,"_25194":379,"_17578":42267,"_5":17474,"_23043":42120,"_2395":42268},[],"the applied change and how to revert it;",{"_2868":442,"_25194":379,"_17578":42270,"_5":17474,"_23043":42120,"_2395":42271},[],"validation from a consumer;",{"_2868":443,"_25194":379,"_17578":42273,"_5":17474,"_23043":42120,"_2395":42274},[],"the preventive action and its owner.",{"_2868":444,"_25194":444,"_5":12321,"_2395":42276,"_25530":42277,"_17578":42280,"_23043":444},"Access control",[40934,42278,42279],"Platform","Administration",[],{"_2868":445,"_25194":444,"_17578":42282,"_5":17474,"_23043":444,"_2395":42283},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2868":446,"_25194":444,"_5":25527,"_17578":42285,"_23043":42286,"_2395":42287},[],"/docs/pr-preview/pr-39/platform/administration/access-control#essential-concepts","Essential concepts",{"_2868":447,"_25194":444,"_5":25527,"_17578":42289,"_23043":42290,"_2395":42291},[],"/docs/pr-preview/pr-39/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2868":448,"_25194":444,"_5":25527,"_17578":42293,"_23043":42294,"_2395":42295},[],"/docs/pr-preview/pr-39/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2868":449,"_25194":444,"_5":25527,"_17578":42297,"_23043":42298,"_2395":42299},[],"/docs/pr-preview/pr-39/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2868":450,"_25194":444,"_5":25527,"_17578":42301,"_23043":42302,"_2395":42303},[],"/docs/pr-preview/pr-39/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2868":451,"_25194":444,"_5":25527,"_17578":42305,"_23043":42306,"_2395":42307},[],"/docs/pr-preview/pr-39/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2868":452,"_25194":444,"_5":25527,"_17578":42309,"_23043":42310,"_2395":42311},[],"/docs/pr-preview/pr-39/platform/administration/access-control#oidc-principals","OIDC principals",{"_2868":453,"_25194":444,"_5":25527,"_17578":42313,"_23043":42314,"_2395":42315},[],"/docs/pr-preview/pr-39/platform/administration/access-control#x509-principals","X.509 principals",{"_2868":454,"_25194":444,"_5":25527,"_17578":42317,"_23043":42318,"_2395":42319},[],"/docs/pr-preview/pr-39/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2868":455,"_25194":444,"_5":25527,"_17578":42321,"_23043":42322,"_2395":42323},[],"/docs/pr-preview/pr-39/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2868":456,"_25194":444,"_5":25527,"_17578":42325,"_23043":42326,"_2395":42327},[],"/docs/pr-preview/pr-39/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2868":457,"_25194":444,"_5":25527,"_17578":42329,"_23043":42330,"_2395":42331},[],"/docs/pr-preview/pr-39/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2868":458,"_25194":444,"_5":25527,"_17578":42333,"_23043":42334,"_2395":42335},[],"/docs/pr-preview/pr-39/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2868":459,"_25194":444,"_5":25527,"_17578":42337,"_23043":42338,"_2395":42339},[],"/docs/pr-preview/pr-39/platform/administration/access-control#http-rules","HTTP rules",{"_2868":460,"_25194":444,"_5":25527,"_17578":42341,"_23043":42342,"_2395":42343},[],"/docs/pr-preview/pr-39/platform/administration/access-control#included-policies","Included policies",{"_2868":461,"_25194":444,"_5":25527,"_17578":42345,"_23043":42346,"_2395":41537},[],"/docs/pr-preview/pr-39/platform/administration/access-control#provision-the-first-administrator",{"_2868":462,"_25194":444,"_5":25527,"_17578":42348,"_23043":42349,"_2395":42350},[],"/docs/pr-preview/pr-39/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2868":463,"_25194":444,"_5":25527,"_17578":42352,"_23043":42353,"_2395":42354},[],"/docs/pr-preview/pr-39/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2868":464,"_25194":444,"_5":25527,"_17578":42356,"_23043":42357,"_2395":42358},[],"/docs/pr-preview/pr-39/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2868":465,"_25194":444,"_5":25527,"_17578":42360,"_23043":42361,"_2395":42362},[],"/docs/pr-preview/pr-39/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2868":466,"_25194":444,"_5":25527,"_17578":42364,"_23043":42365,"_2395":42366},[],"/docs/pr-preview/pr-39/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2868":467,"_25194":444,"_5":25527,"_17578":42368,"_23043":42369,"_2395":42370},[],"/docs/pr-preview/pr-39/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2868":468,"_25194":444,"_5":25527,"_17578":42372,"_23043":42373,"_2395":42374},[],"/docs/pr-preview/pr-39/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2868":469,"_25194":444,"_5":25527,"_17578":42376,"_23043":42377,"_2395":42378},[],"/docs/pr-preview/pr-39/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2868":470,"_25194":444,"_5":25527,"_17578":42380,"_23043":42381,"_2395":42382},[],"/docs/pr-preview/pr-39/platform/administration/access-control#operational-checklist","Operational checklist",{"_2868":471,"_25194":444,"_5":25527,"_17578":42384,"_23043":42385,"_2395":42386},[],"/docs/pr-preview/pr-39/platform/administration/access-control#diagnostics","Diagnostics",{"_2868":472,"_25194":444,"_5":25527,"_17578":42388,"_23043":42389,"_2395":42390},[],"/docs/pr-preview/pr-39/platform/administration/access-control#the-response-is-401","The response is 401",{"_2868":473,"_25194":444,"_5":25527,"_17578":42392,"_23043":42393,"_2395":42394},[],"/docs/pr-preview/pr-39/platform/administration/access-control#the-response-is-403","The response is 403",{"_2868":474,"_25194":444,"_5":25527,"_17578":42396,"_23043":42397,"_2395":42398},[],"/docs/pr-preview/pr-39/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2868":475,"_25194":444,"_5":25527,"_17578":42400,"_23043":42401,"_2395":42402},[],"/docs/pr-preview/pr-39/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2868":476,"_25194":444,"_5":25527,"_17578":42404,"_23043":42405,"_2395":42406},[],"/docs/pr-preview/pr-39/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2868":477,"_25194":444,"_17578":42408,"_5":17474,"_23043":444,"_2395":42409},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2868":478,"_25194":444,"_17578":42411,"_5":17474,"_23043":444,"_2395":42412},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2868":479,"_25194":444,"_17578":42414,"_5":17474,"_23043":444,"_2395":42415},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2868":480,"_25194":444,"_17578":42417,"_5":17474,"_23043":42286,"_2395":42418},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2868":481,"_25194":444,"_17578":42420,"_5":17474,"_23043":42286,"_2395":42421},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2868":482,"_25194":444,"_17578":42423,"_5":17474,"_23043":42286,"_2395":42424},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2868":483,"_25194":444,"_17578":42426,"_5":17474,"_23043":42286,"_2395":42427},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2868":484,"_25194":444,"_17578":42429,"_5":17474,"_23043":42286,"_2395":42430},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2868":485,"_25194":444,"_17578":42432,"_5":17474,"_23043":42286,"_2395":42433},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2868":486,"_25194":444,"_17578":42435,"_5":17474,"_23043":42290,"_2395":42436},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2868":487,"_25194":444,"_17578":42438,"_5":17474,"_23043":42290,"_2395":42439},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2868":488,"_25194":444,"_17578":42441,"_5":17474,"_23043":42294,"_2395":42442},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2868":489,"_25194":444,"_17578":42444,"_5":17474,"_23043":42294,"_2395":42445},[],"The decision is made **before forwarding the request to the service**:",{"_2868":490,"_25194":444,"_17578":42447,"_5":17474,"_23043":42294,"_2395":42448},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2868":491,"_25194":444,"_17578":42450,"_5":17474,"_23043":42294,"_2395":42451},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2868":492,"_25194":444,"_17578":42453,"_5":17474,"_23043":42294,"_2395":42454},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2868":493,"_25194":444,"_17578":42456,"_5":17474,"_23043":42294,"_2395":42457},[],"It separately loads the policies granted to each principal.",{"_2868":494,"_25194":444,"_17578":42459,"_5":17474,"_23043":42294,"_2395":42460},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2868":495,"_25194":444,"_17578":42462,"_5":17474,"_23043":42294,"_2395":42463},[],"`authz` looks for an HTTP rule granting that action.",{"_2868":496,"_25194":444,"_17578":42465,"_5":17474,"_23043":42294,"_2395":42466},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2868":497,"_25194":444,"_17578":42468,"_5":17474,"_23043":42294,"_2395":42469},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2868":498,"_25194":444,"_17578":42471,"_5":17474,"_23043":42294,"_2395":42472},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_2868":499,"_25194":444,"_17578":42474,"_5":17474,"_23043":42294,"_2395":42475},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2868":500,"_25194":444,"_17578":42477,"_5":17474,"_23043":42298,"_2395":42478},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2868":501,"_25194":444,"_17578":42480,"_5":17474,"_23043":42298,"_2395":42481},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2868":502,"_25194":444,"_17578":42483,"_5":17474,"_23043":42298,"_2395":42484},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2868":503,"_25194":444,"_17578":42486,"_5":17474,"_23043":42298,"_2395":42487},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2868":504,"_25194":444,"_17578":42489,"_5":17474,"_23043":42298,"_2395":42490},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2868":505,"_25194":444,"_17578":42492,"_5":17474,"_23043":42298,"_2395":42493},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2868":506,"_25194":444,"_17578":42495,"_5":17474,"_23043":42298,"_2395":42496},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2868":507,"_25194":444,"_17578":42498,"_5":17474,"_23043":42298,"_2395":42499},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2868":508,"_25194":444,"_17578":42501,"_5":17474,"_23043":42302,"_2395":42502},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2868":509,"_25194":444,"_17578":42504,"_5":17474,"_23043":42302,"_2395":42505},[],"The decision is made with the domain operation context:",{"_2868":510,"_25194":444,"_17578":42507,"_5":17474,"_23043":42302,"_2395":42508},[],"The middleware extracts the credential and resolves the matching principals.",{"_2868":511,"_25194":444,"_17578":42510,"_5":17474,"_23043":42302,"_2395":42511},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2868":512,"_25194":444,"_17578":42513,"_5":17474,"_23043":42302,"_2395":42514},[],"`authz` gathers the entity rules of the granted policies.",{"_2868":513,"_25194":444,"_17578":42516,"_5":17474,"_23043":42302,"_2395":42517},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2868":514,"_25194":444,"_17578":42519,"_5":17474,"_23043":42302,"_2395":42520},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2868":515,"_25194":444,"_17578":42522,"_5":17474,"_23043":42302,"_2395":42523},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2868":516,"_25194":444,"_17578":42525,"_5":17474,"_23043":42302,"_2395":42526},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2868":517,"_25194":444,"_17578":42528,"_5":17474,"_23043":42302,"_2395":42529},[],"Actions fall into two groups:",{"_2868":518,"_25194":444,"_17578":42531,"_5":17474,"_23043":42302,"_2395":42532},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2868":519,"_25194":444,"_17578":42534,"_5":17474,"_23043":42302,"_2395":42535},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2868":520,"_25194":444,"_17578":42537,"_5":17474,"_23043":42302,"_2395":42538},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2868":521,"_25194":444,"_17578":42540,"_5":17474,"_23043":42306,"_2395":42541},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2868":522,"_25194":444,"_17578":42543,"_5":17474,"_23043":42306,"_2395":42544},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2868":523,"_25194":444,"_17578":42546,"_5":17474,"_23043":42306,"_2395":42547},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2868":524,"_25194":444,"_17578":42549,"_5":17474,"_23043":42310,"_2395":42550},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2868":525,"_25194":444,"_17578":42552,"_5":17474,"_23043":42310,"_2395":42553},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2868":526,"_25194":444,"_17578":42555,"_5":17474,"_23043":42310,"_2395":42556},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2868":527,"_25194":444,"_17578":42558,"_5":17474,"_23043":42310,"_2395":42559},[],"The implemented operators are:",{"_2868":528,"_25194":444,"_17578":42561,"_5":17474,"_23043":42310,"_2395":42562},[],"`equals`, for exact equality;",{"_2868":529,"_25194":444,"_17578":42564,"_5":17474,"_23043":42310,"_2395":42565},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2868":530,"_25194":444,"_17578":42567,"_5":17474,"_23043":42310,"_2395":42568},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2868":531,"_25194":444,"_17578":42570,"_5":17474,"_23043":42310,"_2395":42571},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2868":532,"_25194":444,"_17578":42573,"_5":17474,"_23043":42314,"_2395":42574},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2868":533,"_25194":444,"_17578":42576,"_5":17474,"_23043":42314,"_2395":42577},[],"The available modes are:",{"_2868":534,"_25194":444,"_17578":42579,"_5":17474,"_23043":42314,"_2395":42580},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2868":535,"_25194":444,"_17578":42582,"_5":17474,"_23043":42314,"_2395":42583},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2868":536,"_25194":444,"_17578":42585,"_5":17474,"_23043":42314,"_2395":42586},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2868":537,"_25194":444,"_17578":42588,"_5":17474,"_23043":42314,"_2395":42589},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2868":538,"_25194":444,"_17578":42591,"_5":17474,"_23043":42314,"_2395":42592},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2868":539,"_25194":444,"_17578":42594,"_5":17474,"_23043":42314,"_2395":42595},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2868":540,"_25194":444,"_17578":42597,"_5":17474,"_23043":42318,"_2395":42598},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2868":541,"_25194":444,"_17578":42600,"_5":17474,"_23043":42318,"_2395":42601},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2868":542,"_25194":444,"_17578":42603,"_5":17474,"_23043":42318,"_2395":42604},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2868":543,"_25194":444,"_17578":42606,"_5":17474,"_23043":42318,"_2395":42607},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2868":544,"_25194":444,"_17578":42609,"_5":17474,"_23043":42326,"_2395":42610},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2868":545,"_25194":444,"_17578":42612,"_5":17474,"_23043":42326,"_2395":42613},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2868":546,"_25194":444,"_17578":42615,"_5":17474,"_23043":42330,"_2395":42616},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2868":547,"_25194":444,"_17578":42618,"_5":17474,"_23043":42330,"_2395":42619},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2868":548,"_25194":444,"_17578":42621,"_5":17474,"_23043":42334,"_2395":42622},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2868":549,"_25194":444,"_17578":42624,"_5":17474,"_23043":42334,"_2395":42625},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2868":550,"_25194":444,"_17578":42627,"_5":17474,"_23043":42334,"_2395":42628},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2868":551,"_25194":444,"_17578":42630,"_5":17474,"_23043":42338,"_2395":42631},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2868":552,"_25194":444,"_17578":42633,"_5":17474,"_23043":42338,"_2395":42634},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2868":553,"_25194":444,"_17578":42636,"_5":17474,"_23043":42338,"_2395":42637},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2868":554,"_25194":444,"_17578":42639,"_5":17474,"_23043":42338,"_2395":42640},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2868":555,"_25194":444,"_17578":42642,"_5":17474,"_23043":42338,"_2395":42643},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2868":556,"_25194":444,"_17578":42645,"_5":17474,"_23043":42338,"_2395":42646},[],"Note that:",{"_2868":557,"_25194":444,"_17578":42648,"_5":17474,"_23043":42338,"_2395":42649},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2868":558,"_25194":444,"_17578":42651,"_5":17474,"_23043":42338,"_2395":42652},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2868":559,"_25194":444,"_17578":42654,"_5":17474,"_23043":42338,"_2395":42655},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2868":560,"_25194":444,"_17578":42657,"_5":17474,"_23043":42342,"_2395":42658},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2868":561,"_25194":444,"_17578":42660,"_5":17474,"_23043":42342,"_2395":42661},[],"full and read-only access to certificates and authorities;",{"_2868":562,"_25194":444,"_17578":42663,"_5":17474,"_23043":42342,"_2395":42664},[],"full and read-only access to the KMS;",{"_2868":563,"_25194":444,"_17578":42666,"_5":17474,"_23043":42342,"_2395":42667},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2868":564,"_25194":444,"_17578":42669,"_5":17474,"_23043":42342,"_2395":42670},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2868":565,"_25194":444,"_17578":42672,"_5":17474,"_23043":42342,"_2395":42673},[],"console access;",{"_2868":566,"_25194":444,"_17578":42675,"_5":17474,"_23043":42342,"_2395":42676},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2868":567,"_25194":444,"_17578":42678,"_5":17474,"_23043":42342,"_2395":42679},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2868":568,"_25194":444,"_17578":42681,"_5":17474,"_23043":42342,"_2395":42682},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2868":569,"_25194":444,"_17578":42684,"_5":17474,"_23043":42346,"_2395":42685},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2868":570,"_25194":444,"_17578":42687,"_5":17474,"_23043":42346,"_2395":42688},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2868":571,"_25194":444,"_17578":42690,"_5":17474,"_23043":42346,"_2395":42691},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2868":572,"_25194":444,"_17578":42693,"_5":17474,"_23043":42349,"_2395":42694},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2868":573,"_25194":444,"_17578":42696,"_5":17474,"_23043":42353,"_2395":42697},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2868":574,"_25194":444,"_17578":42699,"_5":17474,"_23043":42357,"_2395":42700},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2868":575,"_25194":444,"_17578":42702,"_5":17474,"_23043":42361,"_2395":42703},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2868":576,"_25194":444,"_17578":42705,"_5":17474,"_23043":42365,"_2395":42706},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2868":577,"_25194":444,"_17578":42708,"_5":17474,"_23043":42369,"_2395":42709},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2868":578,"_25194":444,"_17578":42711,"_5":17474,"_23043":42369,"_2395":42712},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2868":579,"_25194":444,"_17578":42714,"_5":17474,"_23043":42373,"_2395":42715},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2868":580,"_25194":444,"_17578":42717,"_5":17474,"_23043":42373,"_2395":42718},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2868":581,"_25194":444,"_17578":42720,"_5":17474,"_23043":42373,"_2395":42721},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2868":582,"_25194":444,"_17578":42723,"_5":17474,"_23043":42373,"_2395":42724},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2868":583,"_25194":444,"_17578":42726,"_5":17474,"_23043":42373,"_2395":42727},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2868":584,"_25194":444,"_17578":42729,"_5":17474,"_23043":42373,"_2395":42730},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2868":585,"_25194":444,"_17578":42732,"_5":17474,"_23043":42373,"_2395":42733},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2868":586,"_25194":444,"_17578":42735,"_5":17474,"_23043":42373,"_2395":42736},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2868":587,"_25194":444,"_17578":42738,"_5":17474,"_23043":42377,"_2395":42739},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2868":588,"_25194":444,"_17578":42741,"_5":17474,"_23043":42377,"_2395":42742},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2868":589,"_25194":444,"_17578":42744,"_5":17474,"_23043":42377,"_2395":42745},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2868":590,"_25194":444,"_17578":42747,"_5":17474,"_23043":42381,"_2395":42748},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2868":591,"_25194":444,"_17578":42750,"_5":17474,"_23043":42381,"_2395":42751},[],"Use groups or stable roles for people and independent identities for automations.",{"_2868":592,"_25194":444,"_17578":42753,"_5":17474,"_23043":42381,"_2395":42754},[],"Keep at least two recovery administrators and test their access periodically.",{"_2868":593,"_25194":444,"_17578":42756,"_5":17474,"_23043":42381,"_2395":42757},[],"Review active principals, their matches and their grants after IdP changes.",{"_2868":594,"_25194":444,"_17578":42759,"_5":17474,"_23043":42381,"_2395":42760},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2868":595,"_25194":444,"_17578":42762,"_5":17474,"_23043":42381,"_2395":42763},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2868":596,"_25194":444,"_17578":42765,"_5":17474,"_23043":42381,"_2395":42766},[],"Always test one allowed and one denied operation for each role.",{"_2868":597,"_25194":444,"_17578":42768,"_5":17474,"_23043":42381,"_2395":42769},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2868":598,"_25194":444,"_17578":42771,"_5":17474,"_23043":42389,"_2395":42772},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2868":599,"_25194":444,"_17578":42774,"_5":17474,"_23043":42393,"_2395":42775},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2868":600,"_25194":444,"_17578":42777,"_5":17474,"_23043":42393,"_2395":42778},[],"that an active principal of the correct type exists;",{"_2868":601,"_25194":444,"_17578":42780,"_5":17474,"_23043":42393,"_2395":42781},[],"that the claim paths and values match the real token exactly;",{"_2868":602,"_25194":444,"_17578":42783,"_5":17474,"_23043":42393,"_2395":42784},[],"that all of the principal's conditions hold;",{"_2868":603,"_25194":444,"_17578":42786,"_5":17474,"_23043":42393,"_2395":42787},[],"that the principal has the expected policy granted;",{"_2868":604,"_25194":444,"_17578":42789,"_5":17474,"_23043":42393,"_2395":42790},[],"that the policy includes the action and the requested resource type or route;",{"_2868":605,"_25194":444,"_17578":42792,"_5":17474,"_23043":42393,"_2395":42793},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2868":606,"_25194":444,"_17578":42795,"_5":17474,"_23043":42393,"_2395":42796},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2868":607,"_25194":444,"_17578":42798,"_5":17474,"_23043":42397,"_2395":42799},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2868":608,"_25194":444,"_17578":42801,"_5":17474,"_23043":42401,"_2395":42802},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2868":609,"_25194":444,"_17578":42804,"_5":17474,"_23043":42405,"_2395":42805},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2868":610,"_25194":444,"_17578":42807,"_5":17474,"_23043":42405,"_2395":42808},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2868":611,"_25194":611,"_5":12321,"_2395":42810,"_25530":42811,"_17578":42812,"_23043":611},"Alerts and subscriptions",[40934,42278,42279],[],{"_2868":612,"_25194":611,"_17578":42814,"_5":17474,"_23043":611,"_2395":42815},[],"Send PKI events to people and external systems.",{"_2868":613,"_25194":611,"_5":25527,"_17578":42817,"_23043":42818,"_2395":42819},[],"/docs/pr-preview/pr-39/platform/administration/alerts#how-it-works","How it works",{"_2868":614,"_25194":611,"_5":25527,"_17578":42821,"_23043":42822,"_2395":42823},[],"/docs/pr-preview/pr-39/platform/administration/alerts#available-channels","Available channels",{"_2868":615,"_25194":611,"_5":25527,"_17578":42825,"_23043":42826,"_2395":42827},[],"/docs/pr-preview/pr-39/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2868":616,"_25194":611,"_5":25527,"_17578":42829,"_23043":42830,"_2395":42831},[],"/docs/pr-preview/pr-39/platform/administration/alerts#choose-the-event","Choose the event",{"_2868":617,"_25194":611,"_5":25527,"_17578":42833,"_23043":42834,"_2395":42835},[],"/docs/pr-preview/pr-39/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2868":618,"_25194":611,"_5":25527,"_17578":42837,"_23043":42838,"_2395":42839},[],"/docs/pr-preview/pr-39/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2868":619,"_25194":611,"_5":25527,"_17578":42841,"_23043":42842,"_2395":42843},[],"/docs/pr-preview/pr-39/platform/administration/alerts#review-and-activate","Review and activate",{"_2868":620,"_25194":611,"_5":25527,"_17578":42845,"_23043":42846,"_2395":42847},[],"/docs/pr-preview/pr-39/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_2868":621,"_25194":611,"_5":25527,"_17578":42849,"_23043":42850,"_2395":42851},[],"/docs/pr-preview/pr-39/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_2868":622,"_25194":611,"_5":25527,"_17578":42853,"_23043":42854,"_2395":42855},[],"/docs/pr-preview/pr-39/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2868":623,"_25194":611,"_5":25527,"_17578":42857,"_23043":42858,"_2395":42859},[],"/docs/pr-preview/pr-39/platform/administration/alerts#event-families","Event families",{"_2868":624,"_25194":611,"_17578":42861,"_5":17474,"_23043":611,"_2395":42862},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2868":625,"_25194":611,"_17578":42864,"_5":17474,"_23043":42818,"_2395":42865},[],"A service publishes a domain event.",{"_2868":626,"_25194":611,"_17578":42867,"_5":17474,"_23043":42818,"_2395":42868},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2868":627,"_25194":611,"_17578":42870,"_5":17474,"_23043":42818,"_2395":42871},[],"Each subscription's filter decides whether it should be notified.",{"_2868":628,"_25194":611,"_17578":42873,"_5":17474,"_23043":42818,"_2395":42874},[],"Lamassu delivers the event to the configured channel.",{"_2868":629,"_25194":611,"_17578":42876,"_5":17474,"_23043":42818,"_2395":42877},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2868":630,"_25194":611,"_17578":42879,"_5":17474,"_23043":42822,"_2395":42880},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_2868":631,"_25194":611,"_17578":42882,"_5":17474,"_23043":42822,"_2395":42883},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2868":632,"_25194":611,"_17578":42885,"_5":17474,"_23043":42822,"_2395":42886},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2868":633,"_25194":611,"_17578":42888,"_5":17474,"_23043":42822,"_2395":42889},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_2868":634,"_25194":611,"_17578":42891,"_5":17474,"_23043":42822,"_2395":42892},[],"`apikey_options` requires `header` and `key`.",{"_2868":635,"_25194":611,"_17578":42894,"_5":17474,"_23043":42822,"_2395":42895},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2868":636,"_25194":611,"_17578":42897,"_5":17474,"_23043":42822,"_2395":42898},[],"`mtls_options` requires the inline PEM `cert_content` and `key_content`; values that reference files on the server are rejected.",{"_2868":637,"_25194":611,"_17578":42900,"_5":17474,"_23043":42822,"_2395":42901},[],"The alerts API reference documents the full `http_client` schema.",{"_2868":638,"_25194":611,"_17578":42903,"_5":17474,"_23043":42830,"_2395":42904},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2868":639,"_25194":611,"_17578":42906,"_5":17474,"_23043":42834,"_2395":42907},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2868":640,"_25194":611,"_17578":42909,"_5":17474,"_23043":42838,"_2395":42910},[],"Add a filter if you don't want to receive every instance of the event.",{"_2868":641,"_25194":611,"_17578":42912,"_5":17474,"_23043":42838,"_2395":42913},[],"**None** notifies all instances of the event.",{"_2868":642,"_25194":611,"_17578":42915,"_5":17474,"_23043":42838,"_2395":42916},[],"**JSON Path** evaluates one or more specific fields.",{"_2868":643,"_25194":611,"_17578":42918,"_5":17474,"_23043":42838,"_2395":42919},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2868":644,"_25194":611,"_17578":42921,"_5":17474,"_23043":42838,"_2395":42922},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_2868":645,"_25194":611,"_17578":42924,"_5":17474,"_23043":42838,"_2395":42925},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2868":646,"_25194":611,"_17578":42927,"_5":17474,"_23043":42842,"_2395":42928},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2868":647,"_25194":611,"_17578":42930,"_5":17474,"_23043":42846,"_2395":42931},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_2868":648,"_25194":611,"_17578":42933,"_5":17474,"_23043":42846,"_2395":42934},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_2868":649,"_25194":611,"_17578":42936,"_5":17474,"_23043":42846,"_2395":42937},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_2868":650,"_25194":611,"_17578":42939,"_5":17474,"_23043":42846,"_2395":42940},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_2868":651,"_25194":611,"_17578":42942,"_5":17474,"_23043":42846,"_2395":42943},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_2868":652,"_25194":611,"_17578":42945,"_5":17474,"_23043":42846,"_2395":42946},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_2868":653,"_25194":611,"_17578":42948,"_5":17474,"_23043":42846,"_2395":42949},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_2868":654,"_25194":611,"_17578":42951,"_5":17474,"_23043":42846,"_2395":42952},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_2868":655,"_25194":611,"_17578":42954,"_5":17474,"_23043":42850,"_2395":42955},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_2868":656,"_25194":611,"_17578":42957,"_5":17474,"_23043":42850,"_2395":42958},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_2868":657,"_25194":611,"_17578":42960,"_5":17474,"_23043":42850,"_2395":42961},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_2868":658,"_25194":611,"_17578":42963,"_5":17474,"_23043":42850,"_2395":42964},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_2868":659,"_25194":611,"_17578":42966,"_5":17474,"_23043":42850,"_2395":42967},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_2868":660,"_25194":611,"_17578":42969,"_5":17474,"_23043":42850,"_2395":42970},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_2868":661,"_25194":611,"_17578":42972,"_5":17474,"_23043":42850,"_2395":42973},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_2868":662,"_25194":611,"_17578":42975,"_5":17474,"_23043":42850,"_2395":42976},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_2868":663,"_25194":611,"_17578":42978,"_5":17474,"_23043":42854,"_2395":42979},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2868":664,"_25194":611,"_17578":42981,"_5":17474,"_23043":42854,"_2395":42982},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_2868":665,"_25194":611,"_17578":42984,"_5":17474,"_23043":42858,"_2395":42985},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2868":666,"_25194":611,"_17578":42987,"_5":17474,"_23043":42858,"_2395":42988},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2868":667,"_25194":611,"_17578":42990,"_5":17474,"_23043":42858,"_2395":42991},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_2868":668,"_25194":611,"_17578":42993,"_5":17474,"_23043":42858,"_2395":42994},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2868":669,"_25194":611,"_17578":42996,"_5":17474,"_23043":42858,"_2395":42997},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2868":670,"_25194":611,"_17578":42999,"_5":17474,"_23043":42858,"_2395":43000},[],"**Validation:** `va.role.crl.create`.",{"_2868":671,"_25194":611,"_17578":43002,"_5":17474,"_23043":42858,"_2395":43003},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_2868":672,"_25194":611,"_17578":43005,"_5":17474,"_23043":42858,"_2395":43006},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2868":673,"_25194":673,"_5":12321,"_2395":43008,"_25530":43009,"_17578":43010,"_23043":673},"Audit logs",[40934,42278,42279],[],{"_2868":674,"_25194":673,"_17578":43012,"_5":17474,"_23043":673,"_2395":43013},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2868":675,"_25194":673,"_5":25527,"_17578":43015,"_23043":43016,"_2395":43017},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2868":676,"_25194":673,"_5":25527,"_17578":43019,"_23043":43020,"_2395":43021},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#coverage","Coverage",{"_2868":677,"_25194":673,"_5":25527,"_17578":43023,"_23043":43024,"_2395":43025},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2868":678,"_25194":673,"_5":25527,"_17578":43027,"_23043":43028,"_2395":43029},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2868":679,"_25194":673,"_5":25527,"_17578":43031,"_23043":43032,"_2395":43033},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2868":680,"_25194":673,"_5":25527,"_17578":43035,"_23043":43036,"_2395":43037},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2868":681,"_25194":673,"_5":25527,"_17578":43039,"_23043":43040,"_2395":43041},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2868":682,"_25194":673,"_5":25527,"_17578":43043,"_23043":43044,"_2395":43045},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2868":683,"_25194":673,"_5":25527,"_17578":43047,"_23043":43048,"_2395":43049},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2868":684,"_25194":673,"_5":25527,"_17578":43051,"_23043":43052,"_2395":43053},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2868":685,"_25194":673,"_5":25527,"_17578":43055,"_23043":43056,"_2395":43057},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2868":686,"_25194":673,"_17578":43059,"_5":17474,"_23043":673,"_2395":43060},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2868":687,"_25194":673,"_17578":43062,"_5":17474,"_23043":43016,"_2395":43063},[],"The audit body includes:",{"_2868":688,"_25194":673,"_17578":43065,"_5":17474,"_23043":43016,"_2395":43066},[],"input: data received by the operation;",{"_2868":689,"_25194":673,"_17578":43068,"_5":17474,"_23043":43016,"_2395":43069},[],"has\\_error: whether the service returned an error;",{"_2868":690,"_25194":673,"_17578":43071,"_5":17474,"_23043":43016,"_2395":43072},[],"output: produced result or error message;",{"_2868":691,"_25194":673,"_17578":43074,"_5":17474,"_23043":43016,"_2395":43075},[],"principals: identifiers of the principals that matched the request.",{"_2868":692,"_25194":673,"_17578":43077,"_5":17474,"_23043":43016,"_2395":43078},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2868":693,"_25194":673,"_17578":43080,"_5":17474,"_23043":43016,"_2395":43081},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2868":694,"_25194":673,"_17578":43083,"_5":17474,"_23043":43020,"_2395":43084},[],"The backend applies auditing to mutations of:",{"_2868":695,"_25194":673,"_17578":43086,"_5":17474,"_23043":43020,"_2395":43087},[],"authorities, certificates and issuance profiles;",{"_2868":696,"_25194":673,"_17578":43089,"_5":17474,"_23043":43020,"_2395":43090},[],"keys and KMS engines;",{"_2868":697,"_25194":673,"_17578":43092,"_5":17474,"_23043":43020,"_2395":43093},[],"devices and identities;",{"_2868":698,"_25194":673,"_17578":43095,"_5":17474,"_23043":43020,"_2395":43096},[],"DMSs and enrollment operations;",{"_2868":699,"_25194":673,"_17578":43098,"_5":17474,"_23043":43020,"_2395":43099},[],"validation functions and CRL;",{"_2868":700,"_25194":673,"_17578":43101,"_5":17474,"_23043":43020,"_2395":43102},[],"principals, policies and authorization grants.",{"_2868":701,"_25194":673,"_17578":43104,"_5":17474,"_23043":43020,"_2395":43105},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2868":702,"_25194":673,"_17578":43107,"_5":17474,"_23043":43024,"_2395":43108},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2868":703,"_25194":673,"_17578":43110,"_5":17474,"_23043":43024,"_2395":43111},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2868":704,"_25194":673,"_17578":43113,"_5":17474,"_23043":43024,"_2395":43114},[],"Design the consumer to:",{"_2868":705,"_25194":673,"_17578":43116,"_5":17474,"_23043":43024,"_2395":43117},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2868":706,"_25194":673,"_17578":43119,"_5":17474,"_23043":43024,"_2395":43120},[],"keep the complete CloudEvent unmodified;",{"_2868":707,"_25194":673,"_17578":43122,"_5":17474,"_23043":43024,"_2395":43123},[],"record the ingestion time and detect duplicates by ID;",{"_2868":708,"_25194":673,"_17578":43125,"_5":17474,"_23043":43024,"_2395":43126},[],"encrypt in transit and at rest;",{"_2868":709,"_25194":673,"_17578":43128,"_5":17474,"_23043":43024,"_2395":43129},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2868":710,"_25194":673,"_17578":43131,"_5":17474,"_23043":43024,"_2395":43132},[],"apply an explicit retention and legal hold policy;",{"_2868":711,"_25194":673,"_17578":43134,"_5":17474,"_23043":43024,"_2395":43135},[],"alert if it stops consuming or the pending queue grows.",{"_2868":712,"_25194":673,"_17578":43137,"_5":17474,"_23043":43028,"_2395":43138},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2868":713,"_25194":673,"_17578":43140,"_5":17474,"_23043":43028,"_2395":43141},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2868":714,"_25194":673,"_17578":43143,"_5":17474,"_23043":43036,"_2395":43144},[],"Start from the reported time and normalize every source to UTC.",{"_2868":715,"_25194":673,"_17578":43146,"_5":17474,"_23043":43040,"_2395":43147},[],"Filter by event type, service source and resource identifier.",{"_2868":716,"_25194":673,"_17578":43149,"_5":17474,"_23043":43044,"_2395":43150},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2868":717,"_25194":673,"_17578":43152,"_5":17474,"_23043":43048,"_2395":43153},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2868":718,"_25194":673,"_17578":43155,"_5":17474,"_23043":43052,"_2395":43156},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2868":719,"_25194":673,"_17578":43158,"_5":17474,"_23043":43056,"_2395":43159},[],"Generate a controlled mutation in a test environment and check that:",{"_2868":720,"_25194":673,"_17578":43161,"_5":17474,"_23043":43056,"_2395":43162},[],"a successful audit event appears;",{"_2868":721,"_25194":673,"_17578":43164,"_5":17474,"_23043":43056,"_2395":43165},[],"the principal matches the identity used;",{"_2868":722,"_25194":673,"_17578":43167,"_5":17474,"_23043":43056,"_2395":43168},[],"the consumer persists it exactly once;",{"_2868":723,"_25194":673,"_17578":43170,"_5":17474,"_23043":43056,"_2395":43171},[],"it can be retrieved by resource, actor and period;",{"_2868":724,"_25194":673,"_17578":43173,"_5":17474,"_23043":43056,"_2395":43174},[],"a consumer outage raises an alert.",{"_2868":725,"_25194":673,"_17578":43176,"_5":17474,"_23043":43056,"_2395":43177},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2868":726,"_25194":726,"_5":12321,"_2395":43179,"_25530":43180,"_17578":43181,"_23043":726},"Platform architecture",[40934,42278],[],{"_2868":727,"_25194":726,"_17578":43183,"_5":17474,"_23043":726,"_2395":43184},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2868":728,"_25194":726,"_5":25527,"_17578":43186,"_23043":43187,"_2395":43188},[],"/docs/pr-preview/pr-39/platform/concepts/architecture#control-plane","Control plane",{"_2868":729,"_25194":726,"_5":25527,"_17578":43190,"_23043":43191,"_2395":43192},[],"/docs/pr-preview/pr-39/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2868":730,"_25194":726,"_5":25527,"_17578":43194,"_23043":43195,"_2395":43196},[],"/docs/pr-preview/pr-39/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2868":731,"_25194":726,"_5":25527,"_17578":43198,"_23043":43199,"_2395":43200},[],"/docs/pr-preview/pr-39/platform/concepts/architecture#status-and-validation","Status and validation",{"_2868":732,"_25194":726,"_5":25527,"_17578":43202,"_23043":43203,"_2395":43204},[],"/docs/pr-preview/pr-39/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2868":733,"_25194":726,"_17578":43206,"_5":17474,"_23043":726,"_2395":43207},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2868":734,"_25194":726,"_17578":43209,"_5":17474,"_23043":726,"_2395":43210},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2868":735,"_25194":726,"_17578":43212,"_5":17474,"_23043":43187,"_2395":43213},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2868":736,"_25194":726,"_17578":43215,"_5":17474,"_23043":43191,"_2395":43216},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2868":737,"_25194":726,"_17578":43218,"_5":17474,"_23043":43195,"_2395":43219},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2868":738,"_25194":726,"_17578":43221,"_5":17474,"_23043":43199,"_2395":43222},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2868":739,"_25194":726,"_17578":43224,"_5":17474,"_23043":43203,"_2395":43225},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2868":740,"_25194":740,"_5":12321,"_2395":43227,"_25530":43228,"_17578":43229,"_23043":740},"How Lamassu works",[40934,42278],[],{"_2868":741,"_25194":740,"_17578":43231,"_5":17474,"_23043":740,"_2395":43232},[],"The mental model of trust, keys, certificates and devices.",{"_2868":742,"_25194":740,"_5":25527,"_17578":43234,"_23043":43235,"_2395":43236},[],"/docs/pr-preview/pr-39/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2868":743,"_25194":740,"_5":25527,"_17578":43238,"_23043":43239,"_2395":43240},[],"/docs/pr-preview/pr-39/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2868":744,"_25194":740,"_17578":43242,"_5":17474,"_23043":740,"_2395":43243},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2868":745,"_25194":740,"_17578":43245,"_5":17474,"_23043":43235,"_2395":43246},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2868":746,"_25194":740,"_17578":43248,"_5":17474,"_23043":43235,"_2395":43249},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2868":747,"_25194":740,"_17578":43251,"_5":17474,"_23043":43235,"_2395":43252},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2868":748,"_25194":740,"_17578":43254,"_5":17474,"_23043":43235,"_2395":43255},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2868":749,"_25194":740,"_17578":43257,"_5":17474,"_23043":43235,"_2395":43258},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2868":750,"_25194":740,"_17578":43260,"_5":17474,"_23043":43239,"_2395":43261},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2868":751,"_25194":740,"_17578":43263,"_5":17474,"_23043":43239,"_2395":43264},[],"A DMS relates that CA to an enrollment policy.",{"_2868":752,"_25194":740,"_17578":43266,"_5":17474,"_23043":43239,"_2395":43267},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2868":753,"_25194":740,"_17578":43269,"_5":17474,"_23043":43239,"_2395":43270},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2868":754,"_25194":740,"_17578":43272,"_5":17474,"_23043":43239,"_2395":43273},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2868":755,"_25194":740,"_17578":43275,"_5":17474,"_23043":43239,"_2395":43276},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2868":756,"_25194":740,"_17578":43278,"_5":17474,"_23043":43239,"_2395":43279},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2868":757,"_25194":757,"_5":12321,"_2395":43281,"_25530":43282,"_17578":43284,"_23043":757},"Devices and identities",[40934,42278,43283,43281],"IoT Fleets",[],{"_2868":758,"_25194":757,"_17578":43286,"_5":17474,"_23043":757,"_2395":43287},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2868":759,"_25194":757,"_5":25527,"_17578":43289,"_23043":43290,"_2395":43291},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#device-states","Device states",{"_2868":760,"_25194":757,"_5":25527,"_17578":43293,"_23043":43294,"_2395":43295},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2868":761,"_25194":757,"_5":25527,"_17578":43297,"_23043":43298,"_2395":43299},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2868":762,"_25194":757,"_5":25527,"_17578":43301,"_23043":43302,"_2395":43303},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2868":763,"_25194":757,"_5":25527,"_17578":43305,"_23043":43306,"_2395":43307},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2868":764,"_25194":757,"_5":25527,"_17578":43309,"_23043":43310,"_2395":43311},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2868":765,"_25194":757,"_5":25527,"_17578":43313,"_23043":43314,"_2395":43315},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2868":766,"_25194":757,"_5":25527,"_17578":43317,"_23043":43318,"_2395":43319},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2868":767,"_25194":757,"_5":25527,"_17578":43321,"_23043":43322,"_2395":43323},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2868":768,"_25194":757,"_5":25527,"_17578":43325,"_23043":43326,"_2395":43327},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2868":769,"_25194":757,"_5":25527,"_17578":43329,"_23043":43330,"_2395":43331},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2868":770,"_25194":757,"_17578":43333,"_5":17474,"_23043":757,"_2395":43334},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2868":771,"_25194":757,"_17578":43336,"_5":17474,"_23043":757,"_2395":43337},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2868":772,"_25194":757,"_17578":43339,"_5":17474,"_23043":43290,"_2395":43340},[],"Operational view",{"_2868":773,"_25194":757,"_17578":43342,"_5":17474,"_23043":43290,"_2395":43343},[],"Meaning",{"_2868":774,"_25194":757,"_17578":43345,"_5":17474,"_23043":43290,"_2395":43346},[],"**No Identity**",{"_2868":775,"_25194":757,"_17578":43348,"_5":17474,"_23043":43290,"_2395":43349},[],"A record exists without an associated identity.",{"_2868":776,"_25194":757,"_17578":43351,"_5":17474,"_23043":43290,"_2395":43352},[],"**Active**",{"_2868":777,"_25194":757,"_17578":43354,"_5":17474,"_23043":43290,"_2395":43355},[],"The slot is active; also check certificate dates, status and usages.",{"_2868":778,"_25194":757,"_17578":43357,"_5":17474,"_23043":43290,"_2395":43358},[],"**Renewal Pending**",{"_2868":779,"_25194":757,"_17578":43360,"_5":17474,"_23043":43290,"_2395":43361},[],"The identity is in the operational renewal window.",{"_2868":780,"_25194":757,"_17578":43363,"_5":17474,"_23043":43290,"_2395":43364},[],"**Expiring Soon**",{"_2868":781,"_25194":757,"_17578":43366,"_5":17474,"_23043":43290,"_2395":43367},[],"Expiration is approaching according to configured thresholds.",{"_2868":782,"_25194":757,"_17578":43369,"_5":17474,"_23043":43290,"_2395":43370},[],"**Expired**",{"_2868":783,"_25194":757,"_17578":43372,"_5":17474,"_23043":43290,"_2395":43373},[],"The identity has expired.",{"_2868":784,"_25194":757,"_17578":43375,"_5":17474,"_23043":43290,"_2395":43376},[],"**Revoked**",{"_2868":785,"_25194":757,"_17578":43378,"_5":17474,"_23043":43290,"_2395":43379},[],"The identity is marked revoked.",{"_2868":786,"_25194":757,"_17578":43381,"_5":17474,"_23043":43290,"_2395":43382},[],"**Decommissioned**",{"_2868":787,"_25194":757,"_17578":43384,"_5":17474,"_23043":43290,"_2395":43385},[],"The record is retired and ordinary updates do not restore operation.",{"_2868":788,"_25194":757,"_17578":43387,"_5":17474,"_23043":43290,"_2395":43388},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2868":789,"_25194":757,"_17578":43390,"_5":17474,"_23043":43294,"_2395":43391},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2868":790,"_25194":757,"_17578":43393,"_5":17474,"_23043":43294,"_2395":43394},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2868":791,"_25194":757,"_17578":43396,"_5":17474,"_23043":43294,"_2395":43397},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2868":792,"_25194":757,"_17578":43399,"_5":17474,"_23043":43294,"_2395":43400},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2868":793,"_25194":757,"_17578":43402,"_5":17474,"_23043":43298,"_2395":43403},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2868":794,"_25194":757,"_17578":43405,"_5":17474,"_23043":43302,"_2395":43406},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2868":795,"_25194":757,"_17578":43408,"_5":17474,"_23043":43306,"_2395":43409},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2868":796,"_25194":757,"_17578":43411,"_5":17474,"_23043":43310,"_2395":43412},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2868":797,"_25194":757,"_17578":43414,"_5":17474,"_23043":43314,"_2395":43415},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2868":798,"_25194":757,"_17578":43417,"_5":17474,"_23043":43314,"_2395":43418},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2868":799,"_25194":757,"_17578":43420,"_5":17474,"_23043":43318,"_2395":43421},[],"From **No Identity**, use **Assign Identity**:",{"_2868":800,"_25194":757,"_17578":43423,"_5":17474,"_23043":43318,"_2395":43424},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2868":801,"_25194":757,"_17578":43426,"_5":17474,"_23043":43318,"_2395":43427},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2868":802,"_25194":757,"_17578":43429,"_5":17474,"_23043":43318,"_2395":43430},[],"Confirm and read the serial, active version and history again.",{"_2868":803,"_25194":757,"_17578":43432,"_5":17474,"_23043":43318,"_2395":43433},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2868":804,"_25194":757,"_17578":43435,"_5":17474,"_23043":43318,"_2395":43436},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2868":805,"_25194":757,"_17578":43438,"_5":17474,"_23043":43322,"_2395":43439},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2868":806,"_25194":757,"_17578":43441,"_5":17474,"_23043":43322,"_2395":43442},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2868":807,"_25194":757,"_17578":43444,"_5":17474,"_23043":43326,"_2395":43445},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2868":808,"_25194":757,"_17578":43447,"_5":17474,"_23043":43326,"_2395":43448},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2868":809,"_25194":757,"_17578":43450,"_5":17474,"_23043":43326,"_2395":43451},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2868":810,"_25194":757,"_17578":43453,"_5":17474,"_23043":43326,"_2395":43454},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2868":811,"_25194":757,"_17578":43456,"_5":17474,"_23043":43330,"_2395":43457},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2868":812,"_25194":757,"_17578":43459,"_5":17474,"_23043":43330,"_2395":43460},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2868":813,"_25194":813,"_5":12321,"_2395":43462,"_25530":43463,"_17578":43465,"_23043":813},"Bootstrap identity and authentication",[40934,42278,43283,43281,43464],"Enrollment with PKI",[],{"_2868":814,"_25194":813,"_17578":43467,"_5":17474,"_23043":813,"_2395":43468},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2868":815,"_25194":813,"_5":25527,"_17578":43470,"_23043":43471,"_2395":43472},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2868":816,"_25194":813,"_5":25527,"_17578":43474,"_23043":43475,"_2395":43476},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2868":817,"_25194":813,"_5":25527,"_17578":43478,"_23043":43479,"_2395":43480},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2868":818,"_25194":813,"_5":25527,"_17578":43482,"_23043":43483,"_2395":43484},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2868":819,"_25194":813,"_5":25527,"_17578":43486,"_23043":43487,"_2395":43488},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2868":820,"_25194":813,"_17578":43490,"_5":17474,"_23043":813,"_2395":43491},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2868":821,"_25194":813,"_17578":43493,"_5":17474,"_23043":43471,"_2395":43494},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2868":822,"_25194":813,"_17578":43496,"_5":17474,"_23043":43471,"_2395":43497},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2868":823,"_25194":813,"_17578":43499,"_5":17474,"_23043":43475,"_2395":43500},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2868":824,"_25194":813,"_17578":43502,"_5":17474,"_23043":43475,"_2395":43503},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2868":825,"_25194":813,"_17578":43505,"_5":17474,"_23043":43475,"_2395":43506},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2868":826,"_25194":813,"_17578":43508,"_5":17474,"_23043":43479,"_2395":43509},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2868":827,"_25194":813,"_17578":43511,"_5":17474,"_23043":43479,"_2395":43512},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2868":828,"_25194":813,"_17578":43514,"_5":17474,"_23043":43483,"_2395":43515},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_2868":829,"_25194":813,"_17578":43517,"_5":17474,"_23043":43483,"_2395":43518},[],"Example body:",{"_2868":830,"_25194":813,"_17578":43520,"_5":17474,"_23043":43483,"_2395":43521},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2868":831,"_25194":813,"_17578":43523,"_5":17474,"_23043":43483,"_2395":43524},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2868":832,"_25194":813,"_17578":43526,"_5":17474,"_23043":43483,"_2395":43527},[],"Continuation requires a successful HTTP response and JSON:",{"_2868":833,"_25194":813,"_17578":43529,"_5":17474,"_23043":43483,"_2395":43530},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2868":834,"_25194":813,"_17578":43532,"_5":17474,"_23043":43487,"_2395":43533},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2868":835,"_25194":813,"_17578":43535,"_5":17474,"_23043":43487,"_2395":43536},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2868":836,"_25194":836,"_5":12321,"_2395":43538,"_25530":43539,"_17578":43540,"_23043":836},"Configure and operate the DMS",[40934,42278,43283,43281,43464],[],{"_2868":837,"_25194":836,"_17578":43542,"_5":17474,"_23043":836,"_2395":43543},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2868":838,"_25194":836,"_5":25527,"_17578":43545,"_23043":43546,"_2395":40944},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2868":839,"_25194":836,"_5":25527,"_17578":43548,"_23043":43549,"_2395":43550},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2868":840,"_25194":836,"_5":25527,"_17578":43552,"_23043":43553,"_2395":43554},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2868":841,"_25194":836,"_5":25527,"_17578":43556,"_23043":43557,"_2395":43558},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2868":842,"_25194":836,"_5":25527,"_17578":43560,"_23043":43561,"_2395":43562},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2868":843,"_25194":836,"_5":25527,"_17578":43564,"_23043":43565,"_2395":43566},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2868":844,"_25194":836,"_5":25527,"_17578":43568,"_23043":43569,"_2395":43570},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2868":845,"_25194":836,"_5":25527,"_17578":43572,"_23043":43573,"_2395":43574},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2868":846,"_25194":836,"_5":25527,"_17578":43576,"_23043":43577,"_2395":43578},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2868":847,"_25194":836,"_5":25527,"_17578":43580,"_23043":43581,"_2395":43582},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2868":848,"_25194":836,"_5":25527,"_17578":43584,"_23043":43585,"_2395":43586},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2868":849,"_25194":836,"_5":25527,"_17578":43588,"_23043":43589,"_2395":43590},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_2868":850,"_25194":836,"_5":25527,"_17578":43592,"_23043":43593,"_2395":43594},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2868":851,"_25194":836,"_5":25527,"_17578":43596,"_23043":43597,"_2395":43598},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2868":852,"_25194":836,"_5":25527,"_17578":43600,"_23043":43601,"_2395":43602},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2868":853,"_25194":836,"_5":25527,"_17578":43604,"_23043":43605,"_2395":43606},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2868":854,"_25194":836,"_5":25527,"_17578":43608,"_23043":43609,"_2395":43610},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2868":855,"_25194":836,"_5":25527,"_17578":43612,"_23043":43613,"_2395":43614},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2868":856,"_25194":836,"_17578":43616,"_5":17474,"_23043":836,"_2395":43617},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2868":857,"_25194":836,"_17578":43619,"_5":17474,"_23043":43546,"_2395":43620},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2868":858,"_25194":836,"_17578":43622,"_5":17474,"_23043":43546,"_2395":43623},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2868":859,"_25194":836,"_17578":43625,"_5":17474,"_23043":43553,"_2395":43626},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2868":860,"_25194":836,"_17578":43628,"_5":17474,"_23043":43557,"_2395":43629},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2868":861,"_25194":836,"_17578":43631,"_5":17474,"_23043":43561,"_2395":43632},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2868":862,"_25194":836,"_17578":43634,"_5":17474,"_23043":43565,"_2395":43635},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2868":863,"_25194":836,"_17578":43637,"_5":17474,"_23043":43569,"_2395":43638},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2868":864,"_25194":836,"_17578":43640,"_5":17474,"_23043":43577,"_2395":43641},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2868":865,"_25194":836,"_17578":43643,"_5":17474,"_23043":43577,"_2395":43644},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2868":866,"_25194":836,"_17578":43646,"_5":17474,"_23043":43581,"_2395":43647},[],"`settings.enrollment_settings` field",{"_2868":867,"_25194":836,"_17578":43649,"_5":17474,"_23043":43581,"_2395":43650},[],"Decision",{"_2868":868,"_25194":836,"_17578":43652,"_5":17474,"_23043":43581,"_2395":43653},[],"`protocol`",{"_2868":869,"_25194":836,"_17578":43655,"_5":17474,"_23043":43581,"_2395":43656},[],"`EST_RFC7030` for these operations.",{"_2868":870,"_25194":836,"_17578":43658,"_5":17474,"_23043":43581,"_2395":43659},[],"`enrollment_ca`",{"_2868":871,"_25194":836,"_17578":43661,"_5":17474,"_23043":43581,"_2395":43662},[],"ID of the signing CA.",{"_2868":872,"_25194":836,"_17578":43664,"_5":17474,"_23043":43581,"_2395":43665},[],"`verify_csr_signature`",{"_2868":873,"_25194":836,"_17578":43667,"_5":17474,"_23043":43581,"_2395":43668},[],"Keep `true` to verify CSR key possession.",{"_2868":874,"_25194":836,"_17578":43670,"_5":17474,"_23043":43581,"_2395":43671},[],"`enable_replaceable_enrollment`",{"_2868":875,"_25194":836,"_17578":43673,"_5":17474,"_23043":43581,"_2395":43674},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2868":876,"_25194":836,"_17578":43676,"_5":17474,"_23043":43581,"_2395":43677},[],"`est_rfc7030_settings.auth_mode`",{"_2868":877,"_25194":836,"_17578":43679,"_5":17474,"_23043":43581,"_2395":43680},[],"One of the four authentication modes.",{"_2868":878,"_25194":836,"_17578":43682,"_5":17474,"_23043":43581,"_2395":43683},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2868":879,"_25194":836,"_17578":43685,"_5":17474,"_23043":43585,"_2395":43686},[],"The blocks are independent:",{"_2868":880,"_25194":836,"_17578":43688,"_5":17474,"_23043":43585,"_2395":43689},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2868":881,"_25194":836,"_17578":43691,"_5":17474,"_23043":43585,"_2395":43692},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2868":882,"_25194":836,"_17578":43694,"_5":17474,"_23043":43585,"_2395":43695},[],"`auth_mode`",{"_2868":883,"_25194":836,"_17578":43697,"_5":17474,"_23043":43585,"_2395":43698},[],"Control applied in the configured operation",{"_2868":884,"_25194":836,"_17578":43700,"_5":17474,"_23043":43585,"_2395":43701},[],"`CLIENT_CERTIFICATE`",{"_2868":885,"_25194":836,"_17578":43703,"_5":17474,"_23043":43585,"_2395":43704},[],"Presented certificate validation.",{"_2868":886,"_25194":836,"_17578":43706,"_5":17474,"_23043":43585,"_2395":43707},[],"`EXTERNAL_WEBHOOK`",{"_2868":887,"_25194":836,"_17578":43709,"_5":17474,"_23043":43585,"_2395":43710},[],"Configured webhook authorization.",{"_2868":888,"_25194":836,"_17578":43712,"_5":17474,"_23043":43585,"_2395":43713},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2868":889,"_25194":836,"_17578":43715,"_5":17474,"_23043":43585,"_2395":43716},[],"Certificate validation followed by webhook approval.",{"_2868":890,"_25194":836,"_17578":43718,"_5":17474,"_23043":43585,"_2395":43719},[],"`NO_AUTH`",{"_2868":891,"_25194":836,"_17578":43721,"_5":17474,"_23043":43585,"_2395":43722},[],"No DMS requester authentication.",{"_2868":892,"_25194":836,"_17578":43724,"_5":17474,"_23043":43585,"_2395":43725},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2868":893,"_25194":836,"_17578":43727,"_5":17474,"_23043":43585,"_2395":43728},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2868":894,"_25194":836,"_17578":43730,"_5":17474,"_23043":43585,"_2395":43731},[],"For certificate re-enrollment, the validator uses the enrollment CA, then `additional_validation_cas`, and `enable_expired_renewal`. Do not assume copying initial `validation_cas` changes those issuers.",{"_2868":895,"_25194":836,"_17578":43733,"_5":17474,"_23043":43585,"_2395":43734},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2868":896,"_25194":836,"_17578":43736,"_5":17474,"_23043":43589,"_2395":43737},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_2868":897,"_25194":836,"_17578":43739,"_5":17474,"_23043":43589,"_2395":43740},[],"`external_webhook_settings` field",{"_2868":898,"_25194":836,"_17578":43742,"_5":17474,"_23043":43589,"_2395":43650},[],{"_2868":899,"_25194":836,"_17578":43744,"_5":17474,"_23043":43589,"_2395":43745},[],"`url`",{"_2868":900,"_25194":836,"_17578":43747,"_5":17474,"_23043":43589,"_2395":43748},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_2868":901,"_25194":836,"_17578":43750,"_5":17474,"_23043":43589,"_2395":43751},[],"`method`",{"_2868":902,"_25194":836,"_17578":43753,"_5":17474,"_23043":43589,"_2395":43754},[],"`POST` or `PUT`; `POST` by default.",{"_2868":903,"_25194":836,"_17578":43756,"_5":17474,"_23043":43589,"_2395":43757},[],"`name`",{"_2868":904,"_25194":836,"_17578":43759,"_5":17474,"_23043":43589,"_2395":43760},[],"Label used in service logs.",{"_2868":905,"_25194":836,"_17578":43762,"_5":17474,"_23043":43589,"_2395":43763},[],"`config.auth_mode`",{"_2868":906,"_25194":836,"_17578":43765,"_5":17474,"_23043":43589,"_2395":43766},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_2868":907,"_25194":836,"_17578":43768,"_5":17474,"_23043":43589,"_2395":43769},[],"`config.log_level`",{"_2868":908,"_25194":836,"_17578":43771,"_5":17474,"_23043":43589,"_2395":43772},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_2868":909,"_25194":836,"_17578":43774,"_5":17474,"_23043":43589,"_2395":43775},[],"`config.apikey_options`",{"_2868":910,"_25194":836,"_17578":43777,"_5":17474,"_23043":43589,"_2395":43778},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_2868":911,"_25194":836,"_17578":43780,"_5":17474,"_23043":43589,"_2395":43781},[],"`config.jwt_options`",{"_2868":912,"_25194":836,"_17578":43783,"_5":17474,"_23043":43589,"_2395":43784},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2868":913,"_25194":836,"_17578":43786,"_5":17474,"_23043":43589,"_2395":43787},[],"`config.mtls_options`",{"_2868":914,"_25194":836,"_17578":43789,"_5":17474,"_23043":43589,"_2395":43790},[],"Required for `mtls`: `cert_content` and `key_content` as inline PEM.",{"_2868":915,"_25194":836,"_17578":43792,"_5":17474,"_23043":43589,"_2395":43793},[],"`config.insecure_skip_verify`",{"_2868":916,"_25194":836,"_17578":43795,"_5":17474,"_23043":43589,"_2395":43796},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_2868":917,"_25194":836,"_17578":43798,"_5":17474,"_23043":43589,"_2395":43799},[],"`config.call_timeout`",{"_2868":918,"_25194":836,"_17578":43801,"_5":17474,"_23043":43589,"_2395":43802},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_2868":919,"_25194":836,"_17578":43804,"_5":17474,"_23043":43589,"_2395":43805},[],"Rules for that configuration:",{"_2868":920,"_25194":836,"_17578":43807,"_5":17474,"_23043":43589,"_2395":43808},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so supply the PEM as `mtls_options.cert_content` and `key_content`.",{"_2868":921,"_25194":836,"_17578":43810,"_5":17474,"_23043":43589,"_2395":43811},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_2868":922,"_25194":836,"_17578":43813,"_5":17474,"_23043":43589,"_2395":43814},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_2868":923,"_25194":836,"_17578":43816,"_5":17474,"_23043":43589,"_2395":43817},[],"The API ignores the legacy fields `validate_server_cert`, `apikey`, `oidc` and `mtls`. A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` that still carries only the legacy option fields (`apikey`, `oidc`, `mtls`) fails validation with 400; only legacy `noauth` bodies are accepted, and their credentials are dropped.",{"_2868":924,"_25194":836,"_17578":43819,"_5":17474,"_23043":43589,"_2395":43820},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_2868":925,"_25194":836,"_17578":43822,"_5":17474,"_23043":43589,"_2395":43823},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_2868":926,"_25194":836,"_17578":43825,"_5":17474,"_23043":43589,"_2395":43826},[],"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_2868":927,"_25194":836,"_17578":43828,"_5":17474,"_23043":43589,"_2395":43829},[],"Migration `20261021120000` rewrites every stored webhook config into this layout: `validate_server_cert` becomes the negated `insecure_skip_verify` (a config where `validate_server_cert` was false keeps skipping verification), `oidc` becomes `jwt_options`, `apikey` becomes `apikey_options` and `mtls` becomes `mtls_options`. When both the legacy certificate and key are PEM, they move into `mtls_options.cert_content` and `key_content` and need no action. Otherwise, including a mixed config (PEM certificate, file-path key), both values become `mtls_options.cert_file` and `key_file`. Delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are re-entered as PEM content, or the leftover file fields are removed if the webhook does not use mTLS. The console now exposes these fields: open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and base64-encoded PEM from migrated configurations and stores the material base64-encoded.",{"_2868":928,"_25194":836,"_17578":43831,"_5":17474,"_23043":43593,"_2395":43832},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2868":929,"_25194":836,"_17578":43834,"_5":17474,"_23043":43597,"_2395":43835},[],"`settings.reenrollment_settings` field",{"_2868":930,"_25194":836,"_17578":43837,"_5":17474,"_23043":43597,"_2395":41317},[],{"_2868":931,"_25194":836,"_17578":43839,"_5":17474,"_23043":43597,"_2395":43840},[],"`reenrollment_delta`",{"_2868":932,"_25194":836,"_17578":43842,"_5":17474,"_23043":43597,"_2395":43843},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2868":933,"_25194":836,"_17578":43845,"_5":17474,"_23043":43597,"_2395":43846},[],"`preventive_delta`",{"_2868":934,"_25194":836,"_17578":43848,"_5":17474,"_23043":43597,"_2395":43849},[],"Preventive operational monitoring threshold.",{"_2868":935,"_25194":836,"_17578":43851,"_5":17474,"_23043":43597,"_2395":43852},[],"`critical_delta`",{"_2868":936,"_25194":836,"_17578":43854,"_5":17474,"_23043":43597,"_2395":43855},[],"Critical operational monitoring threshold.",{"_2868":937,"_25194":836,"_17578":43857,"_5":17474,"_23043":43597,"_2395":43858},[],"`enable_expired_renewal`",{"_2868":938,"_25194":836,"_17578":43860,"_5":17474,"_23043":43597,"_2395":43861},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2868":939,"_25194":836,"_17578":43863,"_5":17474,"_23043":43597,"_2395":43864},[],"`additional_validation_cas`",{"_2868":940,"_25194":836,"_17578":43866,"_5":17474,"_23043":43597,"_2395":43867},[],"Additional mTLS credential issuers during migration.",{"_2868":941,"_25194":836,"_17578":43869,"_5":17474,"_23043":43597,"_2395":43870},[],"`revoke_on_reenrollment`",{"_2868":942,"_25194":836,"_17578":43872,"_5":17474,"_23043":43597,"_2395":43873},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2868":943,"_25194":836,"_17578":43875,"_5":17474,"_23043":43597,"_2395":43876},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2868":944,"_25194":836,"_17578":43878,"_5":17474,"_23043":43601,"_2395":43879},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2868":945,"_25194":836,"_17578":43881,"_5":17474,"_23043":43605,"_2395":41311},[],{"_2868":946,"_25194":836,"_17578":43883,"_5":17474,"_23043":43605,"_2395":43884},[],"Published material",{"_2868":947,"_25194":836,"_17578":43886,"_5":17474,"_23043":43605,"_2395":43887},[],"**Include Lamassu System CA**",{"_2868":948,"_25194":836,"_17578":43889,"_5":17474,"_23043":43605,"_2395":43890},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2868":949,"_25194":836,"_17578":43892,"_5":17474,"_23043":43605,"_2395":43893},[],"**Include Enrollment CA**",{"_2868":950,"_25194":836,"_17578":43895,"_5":17474,"_23043":43605,"_2395":43896},[],"Selected issuing CA certificate.",{"_2868":951,"_25194":836,"_17578":43898,"_5":17474,"_23043":43605,"_2395":43899},[],"**Managed CAs**",{"_2868":952,"_25194":836,"_17578":43901,"_5":17474,"_23043":43605,"_2395":43902},[],"Explicitly selected CA certificates.",{"_2868":953,"_25194":836,"_17578":43904,"_5":17474,"_23043":43605,"_2395":43905},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2868":954,"_25194":836,"_17578":43907,"_5":17474,"_23043":43609,"_2395":43908},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2868":955,"_25194":836,"_17578":43910,"_5":17474,"_23043":43609,"_2395":43911},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2868":956,"_25194":836,"_17578":43913,"_5":17474,"_23043":43609,"_2395":43914},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2868":957,"_25194":836,"_17578":43916,"_5":17474,"_23043":43613,"_2395":43917},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2868":958,"_25194":958,"_5":12321,"_2395":43919,"_25530":43920,"_17578":43921,"_23043":958},"Integrate the EST client",[40934,42278,43283,43281,43464],[],{"_2868":959,"_25194":958,"_17578":43923,"_5":17474,"_23043":958,"_2395":43924},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2868":960,"_25194":958,"_5":25527,"_17578":43926,"_23043":43927,"_2395":40944},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2868":961,"_25194":958,"_5":25527,"_17578":43929,"_23043":43930,"_2395":43931},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2868":962,"_25194":958,"_5":25527,"_17578":43933,"_23043":43934,"_2395":43935},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2868":963,"_25194":958,"_5":25527,"_17578":43937,"_23043":43938,"_2395":43939},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2868":964,"_25194":958,"_5":25527,"_17578":43941,"_23043":43942,"_2395":43943},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2868":965,"_25194":958,"_5":25527,"_17578":43945,"_23043":43946,"_2395":43947},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2868":966,"_25194":958,"_17578":43949,"_5":17474,"_23043":958,"_2395":43950},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2868":967,"_25194":958,"_17578":43952,"_5":17474,"_23043":43927,"_2395":43953},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2868":968,"_25194":958,"_17578":43955,"_5":17474,"_23043":43927,"_2395":43956},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2868":969,"_25194":958,"_17578":43958,"_5":17474,"_23043":43927,"_2395":43959},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2868":970,"_25194":958,"_17578":43961,"_5":17474,"_23043":43930,"_2395":43962},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2868":971,"_25194":958,"_17578":43964,"_5":17474,"_23043":43930,"_2395":43965},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2868":972,"_25194":958,"_17578":43967,"_5":17474,"_23043":43934,"_2395":43968},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2868":973,"_25194":958,"_17578":43970,"_5":17474,"_23043":43934,"_2395":43971},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2868":974,"_25194":958,"_17578":43973,"_5":17474,"_23043":43938,"_2395":43974},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2868":975,"_25194":958,"_17578":43976,"_5":17474,"_23043":43938,"_2395":43977},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2868":976,"_25194":958,"_17578":43979,"_5":17474,"_23043":43942,"_2395":43980},[],"For a root that issues directly:",{"_2868":977,"_25194":958,"_17578":43982,"_5":17474,"_23043":43942,"_2395":43983},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2868":978,"_25194":958,"_17578":43985,"_5":17474,"_23043":43942,"_2395":43986},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2868":979,"_25194":958,"_17578":43988,"_5":17474,"_23043":43946,"_2395":43989},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2868":980,"_25194":980,"_5":12321,"_2395":43991,"_25530":43992,"_17578":43993,"_23043":980},"EST reference",[40934,42278,43283,43281,43464],[],{"_2868":981,"_25194":980,"_17578":43995,"_5":17474,"_23043":980,"_2395":43996},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2868":982,"_25194":980,"_5":25527,"_17578":43998,"_23043":43999,"_2395":44000},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2868":983,"_25194":980,"_5":25527,"_17578":44002,"_23043":44003,"_2395":19097},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2868":984,"_25194":980,"_5":25527,"_17578":44005,"_23043":44006,"_2395":21866},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2868":985,"_25194":980,"_5":25527,"_17578":44008,"_23043":44009,"_2395":21873},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2868":986,"_25194":980,"_5":25527,"_17578":44011,"_23043":44012,"_2395":21243},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2868":987,"_25194":980,"_5":25527,"_17578":44014,"_23043":44015,"_2395":44016},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2868":988,"_25194":980,"_5":25527,"_17578":44018,"_23043":44019,"_2395":44020},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2868":989,"_25194":980,"_5":25527,"_17578":44022,"_23043":44023,"_2395":44024},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2868":990,"_25194":980,"_17578":44026,"_5":17474,"_23043":980,"_2395":44027},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2868":991,"_25194":980,"_17578":44029,"_5":17474,"_23043":43999,"_2395":44030},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2868":992,"_25194":980,"_17578":44032,"_5":17474,"_23043":43999,"_2395":44033},[],"Operation",{"_2868":993,"_25194":980,"_17578":44035,"_5":17474,"_23043":43999,"_2395":44036},[],"Method",{"_2868":994,"_25194":980,"_17578":44038,"_5":17474,"_23043":43999,"_2395":44039},[],"Authentication and condition",{"_2868":995,"_25194":980,"_17578":44041,"_5":17474,"_23043":43999,"_2395":44042},[],"`/cacerts`",{"_2868":996,"_25194":980,"_17578":44044,"_5":17474,"_23043":43999,"_2395":44045},[],"GET",{"_2868":997,"_25194":980,"_17578":44047,"_5":17474,"_23043":43999,"_2395":44048},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2868":998,"_25194":980,"_17578":44050,"_5":17474,"_23043":43999,"_2395":44051},[],"`/simpleenroll`",{"_2868":999,"_25194":980,"_17578":44053,"_5":17474,"_23043":43999,"_2395":44054},[],"POST",{"_2868":1000,"_25194":980,"_17578":44056,"_5":17474,"_23043":43999,"_2395":44057},[],"Initial authentication and DMS registration/replacement policy.",{"_2868":1001,"_25194":980,"_17578":44059,"_5":17474,"_23043":43999,"_2395":44060},[],"`/simplereenroll`",{"_2868":1002,"_25194":980,"_17578":44062,"_5":17474,"_23043":43999,"_2395":44054},[],{"_2868":1003,"_25194":980,"_17578":44064,"_5":17474,"_23043":43999,"_2395":44065},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2868":1004,"_25194":980,"_17578":44067,"_5":17474,"_23043":43999,"_2395":44068},[],"`/serverkeygen`",{"_2868":1005,"_25194":980,"_17578":44070,"_5":17474,"_23043":43999,"_2395":44054},[],{"_2868":1006,"_25194":980,"_17578":44072,"_5":17474,"_23043":43999,"_2395":44073},[],"Initial authentication and admission; server generation enabled.",{"_2868":1007,"_25194":980,"_17578":44075,"_5":17474,"_23043":43999,"_2395":44076},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2868":1008,"_25194":980,"_17578":44078,"_5":17474,"_23043":44003,"_2395":44079},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2868":1009,"_25194":980,"_17578":44081,"_5":17474,"_23043":44003,"_2395":44082},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2868":1010,"_25194":980,"_17578":44084,"_5":17474,"_23043":44006,"_2395":44085},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2868":1011,"_25194":980,"_17578":44087,"_5":17474,"_23043":44006,"_2395":44088},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2868":1012,"_25194":980,"_17578":44090,"_5":17474,"_23043":44009,"_2395":44091},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2868":1013,"_25194":980,"_17578":44093,"_5":17474,"_23043":44009,"_2395":44094},[],"The enrollment CA or an additional CA validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2868":1014,"_25194":980,"_17578":44096,"_5":17474,"_23043":44012,"_2395":44097},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2868":1015,"_25194":980,"_17578":44099,"_5":17474,"_23043":44012,"_2395":44100},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2868":1016,"_25194":980,"_17578":44102,"_5":17474,"_23043":44015,"_2395":44103},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2868":1017,"_25194":980,"_17578":44105,"_5":17474,"_23043":44015,"_2395":44106},[],"Part",{"_2868":1018,"_25194":980,"_17578":44108,"_5":17474,"_23043":44015,"_2395":44109},[],"Content after decoding its Base64",{"_2868":1019,"_25194":980,"_17578":44111,"_5":17474,"_23043":44015,"_2395":44112},[],"`application/pkcs8`",{"_2868":1020,"_25194":980,"_17578":44114,"_5":17474,"_23043":44015,"_2395":44115},[],"Unencrypted DER PKCS#8 private key.",{"_2868":1021,"_25194":980,"_17578":44117,"_5":17474,"_23043":44015,"_2395":44118},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2868":1022,"_25194":980,"_17578":44120,"_5":17474,"_23043":44015,"_2395":44121},[],"DER PKCS#7 containing the issued certificate.",{"_2868":1023,"_25194":980,"_17578":44123,"_5":17474,"_23043":44015,"_2395":44124},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2868":1024,"_25194":980,"_17578":44126,"_5":17474,"_23043":44019,"_2395":44127},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2868":1025,"_25194":980,"_17578":44129,"_5":17474,"_23043":44019,"_2395":44130},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2868":1026,"_25194":980,"_17578":44132,"_5":17474,"_23043":44019,"_2395":44133},[],"Convert and check the result:",{"_2868":1027,"_25194":980,"_17578":44135,"_5":17474,"_23043":44019,"_2395":44136},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2868":1028,"_25194":980,"_17578":44138,"_5":17474,"_23043":44023,"_2395":44139},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2868":1029,"_25194":980,"_17578":44141,"_5":17474,"_23043":44023,"_2395":44142},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2868":1030,"_25194":1030,"_5":12321,"_2395":43464,"_25530":44144,"_17578":44145,"_23043":1030},[40934,42278,43283,43281,43464],[],{"_2868":1031,"_25194":1030,"_17578":44147,"_5":17474,"_23043":1030,"_2395":44148},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2868":1032,"_25194":1030,"_5":25527,"_17578":44150,"_23043":44151,"_2395":44152},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2868":1033,"_25194":1030,"_5":25527,"_17578":44154,"_23043":44155,"_2395":44156},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2868":1034,"_25194":1030,"_5":25527,"_17578":44158,"_23043":44159,"_2395":44160},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2868":1035,"_25194":1030,"_5":25527,"_17578":44162,"_23043":44163,"_2395":44164},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2868":1036,"_25194":1030,"_17578":44166,"_5":17474,"_23043":1030,"_2395":44167},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2868":1037,"_25194":1030,"_17578":44169,"_5":17474,"_23043":44151,"_2395":44170},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2868":1038,"_25194":1030,"_17578":44172,"_5":17474,"_23043":44151,"_2395":44173},[],"The integrator installs initial EST server trust and an admission credential.",{"_2868":1039,"_25194":1030,"_17578":44175,"_5":17474,"_23043":44151,"_2395":44176},[],"The client requests an identity for its `Device ID` through EST.",{"_2868":1040,"_25194":1030,"_17578":44178,"_5":17474,"_23043":44151,"_2395":44179},[],"Certificate, device binding and key/certificate installation are checked.",{"_2868":1041,"_25194":1030,"_17578":44181,"_5":17474,"_23043":44151,"_2395":44182},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2868":1042,"_25194":1030,"_17578":44184,"_5":17474,"_23043":44151,"_2395":44185},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2868":1043,"_25194":1030,"_17578":44187,"_5":17474,"_23043":44155,"_2395":44188},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2868":1044,"_25194":1030,"_17578":44190,"_5":17474,"_23043":44155,"_2395":44191},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2868":1045,"_25194":1030,"_17578":44193,"_5":17474,"_23043":44155,"_2395":44194},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2868":1046,"_25194":1030,"_17578":44196,"_5":17474,"_23043":44155,"_2395":44197},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2868":1047,"_25194":1030,"_17578":44199,"_5":17474,"_23043":44159,"_2395":44200},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2868":1048,"_25194":1030,"_17578":44202,"_5":17474,"_23043":44159,"_2395":44203},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2868":1049,"_25194":1030,"_17578":44205,"_5":17474,"_23043":44159,"_2395":44206},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2868":1050,"_25194":1030,"_17578":44208,"_5":17474,"_23043":44159,"_2395":44209},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2868":1051,"_25194":1030,"_17578":44211,"_5":17474,"_23043":44163,"_2395":44212},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract and migrations, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2868":1052,"_25194":1030,"_17578":44214,"_5":17474,"_23043":44163,"_2395":44215},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2868":1053,"_25194":1053,"_5":12321,"_2395":44217,"_25530":44218,"_17578":44219,"_23043":1053},"Provisioning strategies",[40934,42278,43283,43281,43464],[],{"_2868":1054,"_25194":1053,"_17578":44221,"_5":17474,"_23043":1053,"_2395":44222},[],"Choose device registration, identity authorization and key generation.",{"_2868":1055,"_25194":1053,"_5":25527,"_17578":44224,"_23043":44225,"_2395":44226},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2868":1056,"_25194":1053,"_5":25527,"_17578":44228,"_23043":44229,"_2395":44230},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2868":1057,"_25194":1053,"_5":25527,"_17578":44232,"_23043":44233,"_2395":44234},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2868":1058,"_25194":1053,"_5":25527,"_17578":44236,"_23043":44237,"_2395":44238},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2868":1059,"_25194":1053,"_5":25527,"_17578":44240,"_23043":44241,"_2395":44242},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2868":1060,"_25194":1053,"_17578":44244,"_5":17474,"_23043":1053,"_2395":44245},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2868":1061,"_25194":1053,"_17578":44247,"_5":17474,"_23043":44225,"_2395":44248},[],"Path",{"_2868":1062,"_25194":1053,"_17578":44250,"_5":17474,"_23043":44225,"_2395":44251},[],"When the device exists",{"_2868":1063,"_25194":1053,"_17578":44253,"_5":17474,"_23043":44225,"_2395":44254},[],"What to check",{"_2868":1064,"_25194":1053,"_17578":44256,"_5":17474,"_23043":44225,"_2395":44257},[],"Manual assignment",{"_2868":1065,"_25194":1053,"_17578":44259,"_5":17474,"_23043":44225,"_2395":44260},[],"An operator creates it before associating a certificate.",{"_2868":1066,"_25194":1053,"_17578":44262,"_5":17474,"_23043":44225,"_2395":44263},[],"ID, owning DMS, certificate CN and bound serial.",{"_2868":1067,"_25194":1053,"_17578":44265,"_5":17474,"_23043":44225,"_2395":44266},[],"EST with `JITP`",{"_2868":1068,"_25194":1053,"_17578":44268,"_5":17474,"_23043":44225,"_2395":44269},[],"Created for an unknown CN during `/simpleenroll`.",{"_2868":1069,"_25194":1053,"_17578":44271,"_5":17474,"_23043":44225,"_2395":44272},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2868":1070,"_25194":1053,"_17578":44274,"_5":17474,"_23043":44225,"_2395":44275},[],"EST with `PRE_REGISTRATION`",{"_2868":1071,"_25194":1053,"_17578":44277,"_5":17474,"_23043":44225,"_2395":44278},[],"Must exist before `/simpleenroll`.",{"_2868":1072,"_25194":1053,"_17578":44280,"_5":17474,"_23043":44225,"_2395":44281},[],"Approved record, same DMS and replacement conditions for your version.",{"_2868":1073,"_25194":1053,"_17578":44283,"_5":17474,"_23043":44225,"_2395":44284},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2868":1074,"_25194":1053,"_17578":44286,"_5":17474,"_23043":44225,"_2395":44287},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2868":1075,"_25194":1053,"_17578":44289,"_5":17474,"_23043":44229,"_2395":44290},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2868":1076,"_25194":1053,"_17578":44292,"_5":17474,"_23043":44229,"_2395":44293},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2868":1077,"_25194":1053,"_17578":44295,"_5":17474,"_23043":44229,"_2395":44296},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2868":1078,"_25194":1053,"_17578":44298,"_5":17474,"_23043":44233,"_2395":44299},[],"Decide initial enrollment and re-enrollment separately:",{"_2868":1079,"_25194":1053,"_17578":44301,"_5":17474,"_23043":44233,"_2395":44302},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2868":1080,"_25194":1053,"_17578":44304,"_5":17474,"_23043":44233,"_2395":44305},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2868":1081,"_25194":1053,"_17578":44307,"_5":17474,"_23043":44233,"_2395":44308},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2868":1082,"_25194":1053,"_17578":44310,"_5":17474,"_23043":44233,"_2395":44311},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2868":1083,"_25194":1053,"_17578":44313,"_5":17474,"_23043":44233,"_2395":44314},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2868":1084,"_25194":1053,"_17578":44316,"_5":17474,"_23043":44237,"_2395":41311},[],{"_2868":1085,"_25194":1053,"_17578":44318,"_5":17474,"_23043":44237,"_2395":44319},[],"Material crossing EST",{"_2868":1086,"_25194":1053,"_17578":44321,"_5":17474,"_23043":44237,"_2395":44322},[],"Device-generated key",{"_2868":1087,"_25194":1053,"_17578":44324,"_5":17474,"_23043":44237,"_2395":44325},[],"Public CSR and certificate; the key stays on the client.",{"_2868":1088,"_25194":1053,"_17578":44327,"_5":17474,"_23043":44237,"_2395":44328},[],"Existing device key",{"_2868":1089,"_25194":1053,"_17578":44330,"_5":17474,"_23043":44237,"_2395":44331},[],"CSR signed with that key and a new certificate.",{"_2868":1090,"_25194":1053,"_17578":44333,"_5":17474,"_23043":44237,"_2395":43602},[],{"_2868":1091,"_25194":1053,"_17578":44335,"_5":17474,"_23043":44237,"_2395":44336},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2868":1092,"_25194":1053,"_17578":44338,"_5":17474,"_23043":44237,"_2395":44339},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2868":1093,"_25194":1053,"_17578":44341,"_5":17474,"_23043":44241,"_2395":44342},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2868":1094,"_25194":1094,"_5":12321,"_2395":44344,"_25530":44345,"_17578":44346,"_23043":1094},"Renewal and recovery",[40934,42278,43283,43281,43464],[],{"_2868":1095,"_25194":1094,"_17578":44348,"_5":17474,"_23043":1094,"_2395":44349},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2868":1096,"_25194":1094,"_5":25527,"_17578":44351,"_23043":44352,"_2395":44353},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2868":1097,"_25194":1094,"_5":25527,"_17578":44355,"_23043":44356,"_2395":44357},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2868":1098,"_25194":1094,"_5":25527,"_17578":44359,"_23043":44360,"_2395":44361},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2868":1099,"_25194":1094,"_5":25527,"_17578":44363,"_23043":44364,"_2395":44365},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2868":1100,"_25194":1094,"_5":25527,"_17578":44367,"_23043":44368,"_2395":44369},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2868":1101,"_25194":1094,"_17578":44371,"_5":17474,"_23043":1094,"_2395":44372},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2868":1102,"_25194":1094,"_17578":44374,"_5":17474,"_23043":44352,"_2395":44375},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2868":1103,"_25194":1094,"_17578":44377,"_5":17474,"_23043":44352,"_2395":44378},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2868":1104,"_25194":1094,"_17578":44380,"_5":17474,"_23043":44352,"_2395":44381},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2868":1105,"_25194":1094,"_17578":44383,"_5":17474,"_23043":44352,"_2395":44384},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2868":1106,"_25194":1094,"_17578":44386,"_5":17474,"_23043":44356,"_2395":44387},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2868":1107,"_25194":1094,"_17578":44389,"_5":17474,"_23043":44356,"_2395":44390},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2868":1108,"_25194":1094,"_17578":44392,"_5":17474,"_23043":44360,"_2395":44393},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2868":1109,"_25194":1094,"_17578":44395,"_5":17474,"_23043":44360,"_2395":44396},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2868":1110,"_25194":1094,"_17578":44398,"_5":17474,"_23043":44360,"_2395":44399},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2868":1111,"_25194":1094,"_17578":44401,"_5":17474,"_23043":44364,"_2395":44402},[],"Situation",{"_2868":1112,"_25194":1094,"_17578":44404,"_5":17474,"_23043":44364,"_2395":44405},[],"Procedure",{"_2868":1113,"_25194":1094,"_17578":44407,"_5":17474,"_23043":44364,"_2395":44408},[],"Valid certificate, outside the window",{"_2868":1114,"_25194":1094,"_17578":44410,"_5":17474,"_23043":44364,"_2395":44411},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2868":1115,"_25194":1094,"_17578":44413,"_5":17474,"_23043":44364,"_2395":44414},[],"Expired certificate, key available",{"_2868":1116,"_25194":1094,"_17578":44416,"_5":17474,"_23043":44364,"_2395":44417},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2868":1117,"_25194":1094,"_17578":44419,"_5":17474,"_23043":44364,"_2395":44420},[],"Renewal through webhook or `NO_AUTH`",{"_2868":1118,"_25194":1094,"_17578":44422,"_5":17474,"_23043":44364,"_2395":44423},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2868":1119,"_25194":1094,"_17578":44425,"_5":17474,"_23043":44364,"_2395":44426},[],"Lost or inaccessible key",{"_2868":1120,"_25194":1094,"_17578":44428,"_5":17474,"_23043":44364,"_2395":44429},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2868":1121,"_25194":1094,"_17578":44431,"_5":17474,"_23043":44364,"_2395":44432},[],"Current identity revoked",{"_2868":1122,"_25194":1094,"_17578":44434,"_5":17474,"_23043":44364,"_2395":44435},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2868":1123,"_25194":1094,"_17578":44437,"_5":17474,"_23043":44364,"_2395":44438},[],"Device without an identity",{"_2868":1124,"_25194":1094,"_17578":44440,"_5":17474,"_23043":44364,"_2395":44441},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2868":1125,"_25194":1094,"_17578":44443,"_5":17474,"_23043":44364,"_2395":44444},[],"Retired device",{"_2868":1126,"_25194":1094,"_17578":44446,"_5":17474,"_23043":44364,"_2395":44447},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2868":1127,"_25194":1094,"_17578":44449,"_5":17474,"_23043":44364,"_2395":44450},[],"Timeout, HTTP 500 or installation failure",{"_2868":1128,"_25194":1094,"_17578":44452,"_5":17474,"_23043":44364,"_2395":44453},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2868":1129,"_25194":1094,"_17578":44455,"_5":17474,"_23043":44368,"_2395":44456},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2868":1130,"_25194":1094,"_17578":44458,"_5":17474,"_23043":44368,"_2395":44459},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2868":1131,"_25194":1131,"_5":12321,"_2395":44461,"_25530":44462,"_17578":44463,"_23043":1131},"Enrollment troubleshooting",[40934,42278,43283,43281,43464],[],{"_2868":1132,"_25194":1131,"_17578":44465,"_5":17474,"_23043":1131,"_2395":44466},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2868":1133,"_25194":1131,"_5":25527,"_17578":44468,"_23043":44469,"_2395":44470},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2868":1134,"_25194":1131,"_5":25527,"_17578":44472,"_23043":44473,"_2395":44474},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2868":1135,"_25194":1131,"_5":25527,"_17578":44476,"_23043":44477,"_2395":44024},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2868":1136,"_25194":1131,"_5":25527,"_17578":44479,"_23043":44480,"_2395":44481},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2868":1137,"_25194":1131,"_17578":44483,"_5":17474,"_23043":1131,"_2395":44484},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2868":1138,"_25194":1131,"_17578":44486,"_5":17474,"_23043":44473,"_2395":44487},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2868":1139,"_25194":1131,"_17578":44489,"_5":17474,"_23043":44473,"_2395":44490},[],"Symptom or message",{"_2868":1140,"_25194":1131,"_17578":44492,"_5":17474,"_23043":44473,"_2395":44254},[],{"_2868":1141,"_25194":1131,"_17578":44494,"_5":17474,"_23043":44473,"_2395":44495},[],"curl rejects TLS, name or issuer",{"_2868":1142,"_25194":1131,"_17578":44497,"_5":17474,"_23043":44473,"_2395":44498},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2868":1143,"_25194":1131,"_17578":44500,"_5":17474,"_23043":44473,"_2395":44501},[],"404 or missing APS",{"_2868":1144,"_25194":1131,"_17578":44503,"_5":17474,"_23043":44473,"_2395":44504},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2868":1145,"_25194":1131,"_17578":44506,"_5":17474,"_23043":44473,"_2395":44507},[],"400, CSR or format error",{"_2868":1146,"_25194":1131,"_17578":44509,"_5":17474,"_23043":44473,"_2395":44510},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2868":1147,"_25194":1131,"_17578":44512,"_5":17474,"_23043":44473,"_2395":44513},[],"Missing credential or invalid certificate",{"_2868":1148,"_25194":1131,"_17578":44515,"_5":17474,"_23043":44473,"_2395":44516},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2868":1149,"_25194":1131,"_17578":44518,"_5":17474,"_23043":44473,"_2395":44519},[],"Webhook denies, times out or responds without authorization",{"_2868":1150,"_25194":1131,"_17578":44521,"_5":17474,"_23043":44473,"_2395":44522},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2868":1151,"_25194":1131,"_17578":44524,"_5":17474,"_23043":44473,"_2395":44525},[],"`unexpected status code: <n>: redirects are not followed`",{"_2868":1152,"_25194":1131,"_17578":44527,"_5":17474,"_23043":44473,"_2395":44528},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_2868":1153,"_25194":1131,"_17578":44530,"_5":17474,"_23043":44473,"_2395":44531},[],"`webhook response exceeds 1048576 bytes`",{"_2868":1154,"_25194":1131,"_17578":44533,"_5":17474,"_23043":44473,"_2395":44534},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_2868":1155,"_25194":1131,"_17578":44536,"_5":17474,"_23043":44473,"_2395":44537},[],"`webhook config must not reference files`",{"_2868":1156,"_25194":1131,"_17578":44539,"_5":17474,"_23043":44473,"_2395":44540},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the PEM as `cert_content` and `key_content`; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the upgrade note in DMS.",{"_2868":1157,"_25194":1131,"_17578":44542,"_5":17474,"_23043":44473,"_2395":44543},[],"400 `struct validation error` creating or updating a DMS",{"_2868":1158,"_25194":1131,"_17578":44545,"_5":17474,"_23043":44473,"_2395":44546},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_2868":1159,"_25194":1131,"_17578":44548,"_5":17474,"_23043":44473,"_2395":44549},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_2868":1160,"_25194":1131,"_17578":44551,"_5":17474,"_23043":44473,"_2395":44552},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_2868":1161,"_25194":1131,"_17578":44554,"_5":17474,"_23043":44473,"_2395":44555},[],"`device not preregistered`",{"_2868":1162,"_25194":1131,"_17578":44557,"_5":17474,"_23043":44473,"_2395":44558},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2868":1163,"_25194":1131,"_17578":44560,"_5":17474,"_23043":44473,"_2395":44561},[],"`forbiddenNewEnrollment`",{"_2868":1164,"_25194":1131,"_17578":44563,"_5":17474,"_23043":44473,"_2395":44564},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2868":1165,"_25194":1131,"_17578":44566,"_5":17474,"_23043":44473,"_2395":44567},[],"Different owning DMS",{"_2868":1166,"_25194":1131,"_17578":44569,"_5":17474,"_23043":44473,"_2395":44570},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2868":1167,"_25194":1131,"_17578":44572,"_5":17474,"_23043":44473,"_2395":44573},[],"`invalid RawSubject bytes`",{"_2868":1168,"_25194":1131,"_17578":44575,"_5":17474,"_23043":44473,"_2395":44576},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2868":1169,"_25194":1131,"_17578":44578,"_5":17474,"_23043":44473,"_2395":44579},[],"`invalid reenroll window`",{"_2868":1170,"_25194":1131,"_17578":44581,"_5":17474,"_23043":44473,"_2395":44582},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2868":1171,"_25194":1131,"_17578":44584,"_5":17474,"_23043":44473,"_2395":44585},[],"Current certificate revoked",{"_2868":1172,"_25194":1131,"_17578":44587,"_5":17474,"_23043":44473,"_2395":44588},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2868":1173,"_25194":1131,"_17578":44590,"_5":17474,"_23043":44473,"_2395":44591},[],"CA, profile or signing error",{"_2868":1174,"_25194":1131,"_17578":44593,"_5":17474,"_23043":44473,"_2395":44594},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2868":1175,"_25194":1131,"_17578":44596,"_5":17474,"_23043":44473,"_2395":44597},[],"HTTP 200 without a device connection",{"_2868":1176,"_25194":1131,"_17578":44599,"_5":17474,"_23043":44473,"_2395":44600},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2868":1177,"_25194":1131,"_17578":44602,"_5":17474,"_23043":44473,"_2395":44603},[],"Timeout or error after issuance",{"_2868":1178,"_25194":1131,"_17578":44605,"_5":17474,"_23043":44473,"_2395":44606},[],"New certificates, current slot and previous identity's state before retrying.",{"_2868":1179,"_25194":1131,"_17578":44608,"_5":17474,"_23043":44477,"_2395":44609},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode after migration and Gateway behavior with expired certificates and the bootstrap CA.",{"_2868":1180,"_25194":1131,"_17578":44611,"_5":17474,"_23043":44477,"_2395":44612},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2868":1181,"_25194":1131,"_17578":44614,"_5":17474,"_23043":44480,"_2395":44615},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2868":1182,"_25194":1131,"_17578":44617,"_5":17474,"_23043":44480,"_2395":44618},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2868":1183,"_25194":1131,"_17578":44620,"_5":17474,"_23043":44480,"_2395":44621},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2868":1184,"_25194":1131,"_17578":44623,"_5":17474,"_23043":44480,"_2395":44624},[],"Make one request, save headers/body and query the device and certificates.",{"_2868":1185,"_25194":1131,"_17578":44626,"_5":17474,"_23043":44480,"_2395":44627},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2868":1186,"_25194":1131,"_17578":44629,"_5":17474,"_23043":44480,"_2395":44630},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2868":1187,"_25194":1131,"_17578":44632,"_5":17474,"_23043":44480,"_2395":44633},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2868":1188,"_25194":1188,"_5":12321,"_2395":44635,"_25530":44636,"_17578":44637,"_23043":1188},"Trust distribution and updates",[40934,42278,43283,43281,43464],[],{"_2868":1189,"_25194":1188,"_17578":44639,"_5":17474,"_23043":1188,"_2395":44640},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2868":1190,"_25194":1188,"_5":25527,"_17578":44642,"_23043":44643,"_2395":44644},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2868":1191,"_25194":1188,"_5":25527,"_17578":44646,"_23043":44647,"_2395":44648},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2868":1192,"_25194":1188,"_5":25527,"_17578":44650,"_23043":44651,"_2395":44652},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2868":1193,"_25194":1188,"_5":25527,"_17578":44654,"_23043":44655,"_2395":44656},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2868":1194,"_25194":1188,"_5":25527,"_17578":44658,"_23043":44659,"_2395":44660},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2868":1195,"_25194":1188,"_17578":44662,"_5":17474,"_23043":1188,"_2395":44663},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2868":1196,"_25194":1188,"_17578":44665,"_5":17474,"_23043":44643,"_2395":44666},[],"Relationship",{"_2868":1197,"_25194":1188,"_17578":44668,"_5":17474,"_23043":44643,"_2395":44669},[],"Material prepared by its owner",{"_2868":1198,"_25194":1188,"_17578":44671,"_5":17474,"_23043":44643,"_2395":44672},[],"Device → EST server",{"_2868":1199,"_25194":1188,"_17578":44674,"_5":17474,"_23043":44643,"_2395":44675},[],"Previously verified server root, chain or pin and TLS name.",{"_2868":1200,"_25194":1188,"_17578":44677,"_5":17474,"_23043":44643,"_2395":44678},[],"DMS → requester",{"_2868":1201,"_25194":1188,"_17578":44680,"_5":17474,"_23043":44643,"_2395":44681},[],"CAs and rules authorizing initial or renewal credentials.",{"_2868":1202,"_25194":1188,"_17578":44683,"_5":17474,"_23043":44643,"_2395":44684},[],"Consumer → device",{"_2868":1203,"_25194":1188,"_17578":44686,"_5":17474,"_23043":44643,"_2395":44687},[],"Operational identity roots, intermediates, validation and permissions.",{"_2868":1204,"_25194":1188,"_17578":44689,"_5":17474,"_23043":44643,"_2395":44690},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2868":1205,"_25194":1188,"_17578":44692,"_5":17474,"_23043":44647,"_2395":44693},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2868":1206,"_25194":1188,"_17578":44695,"_5":17474,"_23043":44647,"_2395":44696},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2868":1207,"_25194":1188,"_17578":44698,"_5":17474,"_23043":44651,"_2395":44699},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2868":1208,"_25194":1188,"_17578":44701,"_5":17474,"_23043":44651,"_2395":44702},[],"Select policy-approved roots as anchors.",{"_2868":1209,"_25194":1188,"_17578":44704,"_5":17474,"_23043":44651,"_2395":44705},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2868":1210,"_25194":1188,"_17578":44707,"_5":17474,"_23043":44651,"_2395":44708},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2868":1211,"_25194":1188,"_17578":44710,"_5":17474,"_23043":44651,"_2395":44711},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2868":1212,"_25194":1188,"_17578":44713,"_5":17474,"_23043":44651,"_2395":44714},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2868":1213,"_25194":1188,"_17578":44716,"_5":17474,"_23043":44655,"_2395":44717},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2868":1214,"_25194":1188,"_17578":44719,"_5":17474,"_23043":44655,"_2395":44720},[],"In the DMS, separate distributed CAs from `additional_validation_cas`, used for re-enrollment credentials. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2868":1215,"_25194":1188,"_17578":44722,"_5":17474,"_23043":44655,"_2395":44723},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2868":1216,"_25194":1188,"_17578":44725,"_5":17474,"_23043":44659,"_2395":44726},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2868":1217,"_25194":1217,"_5":12321,"_2395":44728,"_25530":44729,"_17578":44731,"_23043":1217},"AWS IoT Core",[40934,42278,43283,43281,44730],"Integrations",[],{"_2868":1218,"_25194":1217,"_17578":44733,"_5":17474,"_23043":1217,"_2395":44734},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2868":1219,"_25194":1217,"_5":25527,"_17578":44736,"_23043":44737,"_2395":44738},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2868":1220,"_25194":1217,"_5":25527,"_17578":44740,"_23043":44741,"_2395":44742},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2868":1221,"_25194":1217,"_5":25527,"_17578":44744,"_23043":44745,"_2395":44746},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2868":1222,"_25194":1217,"_5":25527,"_17578":44748,"_23043":44749,"_2395":44750},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2868":1223,"_25194":1217,"_5":25527,"_17578":44752,"_23043":44753,"_2395":44754},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2868":1224,"_25194":1217,"_5":25527,"_17578":44756,"_23043":44757,"_2395":44758},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2868":1225,"_25194":1217,"_5":25527,"_17578":44760,"_23043":44761,"_2395":44762},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2868":1226,"_25194":1217,"_5":25527,"_17578":44764,"_23043":44765,"_2395":44766},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2868":1227,"_25194":1217,"_5":25527,"_17578":44768,"_23043":44769,"_2395":44770},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2868":1228,"_25194":1217,"_5":25527,"_17578":44772,"_23043":44773,"_2395":44774},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2868":1229,"_25194":1217,"_5":25527,"_17578":44776,"_23043":44777,"_2395":44778},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2868":1230,"_25194":1217,"_5":25527,"_17578":44780,"_23043":44781,"_2395":44782},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2868":1231,"_25194":1217,"_5":25527,"_17578":44784,"_23043":44785,"_2395":44786},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2868":1232,"_25194":1217,"_5":25527,"_17578":44788,"_23043":44789,"_2395":44790},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2868":1233,"_25194":1217,"_5":25527,"_17578":44792,"_23043":44793,"_2395":44794},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2868":1234,"_25194":1217,"_5":25527,"_17578":44796,"_23043":44797,"_2395":44798},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2868":1235,"_25194":1217,"_5":25527,"_17578":44800,"_23043":44801,"_2395":44802},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2868":1236,"_25194":1217,"_5":25527,"_17578":44804,"_23043":44805,"_2395":44806},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2868":1237,"_25194":1217,"_5":25527,"_17578":44808,"_23043":44809,"_2395":44810},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2868":1238,"_25194":1217,"_5":25527,"_17578":44812,"_23043":44813,"_2395":44814},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2868":1239,"_25194":1217,"_17578":44816,"_5":17474,"_23043":1217,"_2395":44817},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2868":1240,"_25194":1217,"_17578":44819,"_5":17474,"_23043":1217,"_2395":44820},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2868":1241,"_25194":1217,"_17578":44822,"_5":17474,"_23043":1217,"_2395":44823},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2868":1242,"_25194":1217,"_17578":44825,"_5":17474,"_23043":44737,"_2395":44826},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2868":1243,"_25194":1217,"_17578":44828,"_5":17474,"_23043":44737,"_2395":44829},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2868":1244,"_25194":1217,"_17578":44831,"_5":17474,"_23043":44737,"_2395":44832},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2868":1245,"_25194":1217,"_17578":44834,"_5":17474,"_23043":44737,"_2395":44835},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2868":1246,"_25194":1217,"_17578":44837,"_5":17474,"_23043":44741,"_2395":44838},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2868":1247,"_25194":1217,"_17578":44840,"_5":17474,"_23043":44745,"_2395":44841},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2868":1248,"_25194":1217,"_17578":44843,"_5":17474,"_23043":44745,"_2395":44844},[],"IAM action",{"_2868":1249,"_25194":1217,"_17578":44846,"_5":17474,"_23043":44745,"_2395":41317},[],{"_2868":1250,"_25194":1217,"_17578":44848,"_5":17474,"_23043":44745,"_2395":44849},[],"`iot:GetRegistrationCode`",{"_2868":1251,"_25194":1217,"_17578":44851,"_5":17474,"_23043":44745,"_2395":44852},[],"Obtain the verification code for CA registration in the Primary Account",{"_2868":1252,"_25194":1217,"_17578":44854,"_5":17474,"_23043":44745,"_2395":44855},[],"`iot:RegisterCACertificate`",{"_2868":1253,"_25194":1217,"_17578":44857,"_5":17474,"_23043":44745,"_2395":44858},[],"Register the CA in AWS IoT",{"_2868":1254,"_25194":1217,"_17578":44860,"_5":17474,"_23043":44745,"_2395":44861},[],"`iot:DescribeCACertificate`",{"_2868":1255,"_25194":1217,"_17578":44863,"_5":17474,"_23043":44745,"_2395":44864},[],"Check the CA registration status",{"_2868":1256,"_25194":1217,"_17578":44866,"_5":17474,"_23043":44745,"_2395":44867},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2868":1257,"_25194":1217,"_17578":44869,"_5":17474,"_23043":44745,"_2395":44870},[],"Create or update Things in IoT Core",{"_2868":1258,"_25194":1217,"_17578":44872,"_5":17474,"_23043":44745,"_2395":44873},[],"`iot:RegisterThing`",{"_2868":1259,"_25194":1217,"_17578":44875,"_5":17474,"_23043":44745,"_2395":44876},[],"Provision Things through a template",{"_2868":1260,"_25194":1217,"_17578":44878,"_5":17474,"_23043":44745,"_2395":44879},[],"`iot:RegisterCertificate`",{"_2868":1261,"_25194":1217,"_17578":44881,"_5":17474,"_23043":44745,"_2395":44882},[],"Register device certificates",{"_2868":1262,"_25194":1217,"_17578":44884,"_5":17474,"_23043":44745,"_2395":44885},[],"`iot:UpdateCertificate`",{"_2868":1263,"_25194":1217,"_17578":44887,"_5":17474,"_23043":44745,"_2395":44888},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2868":1264,"_25194":1217,"_17578":44890,"_5":17474,"_23043":44745,"_2395":44891},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2868":1265,"_25194":1217,"_17578":44893,"_5":17474,"_23043":44745,"_2395":44894},[],"Create and attach IoT policies",{"_2868":1266,"_25194":1217,"_17578":44896,"_5":17474,"_23043":44745,"_2395":44897},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2868":1267,"_25194":1217,"_17578":44899,"_5":17474,"_23043":44745,"_2395":44900},[],"Manage Thing groups",{"_2868":1268,"_25194":1217,"_17578":44902,"_5":17474,"_23043":44745,"_2395":44903},[],"`iot:CreateProvisioningTemplate`",{"_2868":1269,"_25194":1217,"_17578":44905,"_5":17474,"_23043":44745,"_2395":44906},[],"Create JITP templates",{"_2868":1270,"_25194":1217,"_17578":44908,"_5":17474,"_23043":44745,"_2395":44909},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2868":1271,"_25194":1217,"_17578":44911,"_5":17474,"_23043":44745,"_2395":44912},[],"Read and write the Device Shadow",{"_2868":1272,"_25194":1217,"_17578":44914,"_5":17474,"_23043":44745,"_2395":44915},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2868":1273,"_25194":1217,"_17578":44917,"_5":17474,"_23043":44749,"_2395":44918},[],"Parameter",{"_2868":1274,"_25194":1217,"_17578":44920,"_5":17474,"_23043":44749,"_2395":44921},[],"Type",{"_2868":1275,"_25194":1217,"_17578":44923,"_5":17474,"_23043":44749,"_2395":44924},[],"Required",{"_2868":1276,"_25194":1217,"_17578":44926,"_5":17474,"_23043":44749,"_2395":44927},[],"Description",{"_2868":1277,"_25194":1217,"_17578":44929,"_5":17474,"_23043":44749,"_2395":44930},[],"`connector_id`",{"_2868":1278,"_25194":1217,"_17578":44932,"_5":17474,"_23043":44749,"_2395":20987},[],{"_2868":1279,"_25194":1217,"_17578":44934,"_5":17474,"_23043":44749,"_2395":44935},[],"Yes",{"_2868":1280,"_25194":1217,"_17578":44937,"_5":17474,"_23043":44749,"_2395":44938},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2868":1281,"_25194":1217,"_17578":44940,"_5":17474,"_23043":44749,"_2395":44941},[],"`aws_config.region`",{"_2868":1282,"_25194":1217,"_17578":44943,"_5":17474,"_23043":44749,"_2395":20987},[],{"_2868":1283,"_25194":1217,"_17578":44945,"_5":17474,"_23043":44749,"_2395":44935},[],{"_2868":1284,"_25194":1217,"_17578":44947,"_5":17474,"_23043":44749,"_2395":44948},[],"AWS region where the connector operates.",{"_2868":1285,"_25194":1217,"_17578":44950,"_5":17474,"_23043":44749,"_2395":44951},[],"`aws_config.auth_method`",{"_2868":1286,"_25194":1217,"_17578":44953,"_5":17474,"_23043":44749,"_2395":20987},[],{"_2868":1287,"_25194":1217,"_17578":44955,"_5":17474,"_23043":44749,"_2395":44935},[],{"_2868":1288,"_25194":1217,"_17578":44957,"_5":17474,"_23043":44749,"_2395":44958},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2868":1289,"_25194":1217,"_17578":44960,"_5":17474,"_23043":44749,"_2395":44961},[],"`aws_config.access_key_id`",{"_2868":1290,"_25194":1217,"_17578":44963,"_5":17474,"_23043":44749,"_2395":20987},[],{"_2868":1291,"_25194":1217,"_17578":44965,"_5":17474,"_23043":44749,"_2395":44966},[],"Only with `auth_method=static`",{"_2868":1292,"_25194":1217,"_17578":44968,"_5":17474,"_23043":44749,"_2395":44969},[],"AWS access key.",{"_2868":1293,"_25194":1217,"_17578":44971,"_5":17474,"_23043":44749,"_2395":44972},[],"`aws_config.secret_access_key`",{"_2868":1294,"_25194":1217,"_17578":44974,"_5":17474,"_23043":44749,"_2395":20987},[],{"_2868":1295,"_25194":1217,"_17578":44976,"_5":17474,"_23043":44749,"_2395":44966},[],{"_2868":1296,"_25194":1217,"_17578":44978,"_5":17474,"_23043":44749,"_2395":44979},[],"AWS secret key.",{"_2868":1297,"_25194":1217,"_17578":44981,"_5":17474,"_23043":44749,"_2395":44982},[],"`aws_config.session_token`",{"_2868":1298,"_25194":1217,"_17578":44984,"_5":17474,"_23043":44749,"_2395":20987},[],{"_2868":1299,"_25194":1217,"_17578":44986,"_5":17474,"_23043":44749,"_2395":44987},[],"No",{"_2868":1300,"_25194":1217,"_17578":44989,"_5":17474,"_23043":44749,"_2395":44990},[],"Session token (with `auth_method=static`).",{"_2868":1301,"_25194":1217,"_17578":44992,"_5":17474,"_23043":44749,"_2395":44993},[],"`aws_config.role_arn`",{"_2868":1302,"_25194":1217,"_17578":44995,"_5":17474,"_23043":44749,"_2395":20987},[],{"_2868":1303,"_25194":1217,"_17578":44997,"_5":17474,"_23043":44749,"_2395":44998},[],"Only with `auth_method=role`",{"_2868":1304,"_25194":1217,"_17578":45000,"_5":17474,"_23043":44749,"_2395":45001},[],"ARN of the role to assume.",{"_2868":1305,"_25194":1217,"_17578":45003,"_5":17474,"_23043":44749,"_2395":45004},[],"`aws_config.endpoint_url`",{"_2868":1306,"_25194":1217,"_17578":45006,"_5":17474,"_23043":44749,"_2395":20987},[],{"_2868":1307,"_25194":1217,"_17578":45008,"_5":17474,"_23043":44749,"_2395":44987},[],{"_2868":1308,"_25194":1217,"_17578":45010,"_5":17474,"_23043":44749,"_2395":45011},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2868":1309,"_25194":1217,"_17578":45013,"_5":17474,"_23043":44749,"_2395":45014},[],"`subscriber_event_bus`",{"_2868":1310,"_25194":1217,"_17578":45016,"_5":17474,"_23043":44749,"_2395":14742},[],{"_2868":1311,"_25194":1217,"_17578":45018,"_5":17474,"_23043":44749,"_2395":44935},[],{"_2868":1312,"_25194":1217,"_17578":45020,"_5":17474,"_23043":44749,"_2395":45021},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2868":1313,"_25194":1217,"_17578":45023,"_5":17474,"_23043":44749,"_2395":45024},[],"`dms_manager_client`",{"_2868":1314,"_25194":1217,"_17578":45026,"_5":17474,"_23043":44749,"_2395":20987},[],{"_2868":1315,"_25194":1217,"_17578":45028,"_5":17474,"_23043":44749,"_2395":44935},[],{"_2868":1316,"_25194":1217,"_17578":45030,"_5":17474,"_23043":44749,"_2395":45031},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2868":1317,"_25194":1217,"_17578":45033,"_5":17474,"_23043":44749,"_2395":45034},[],"`device_manager_client`",{"_2868":1318,"_25194":1217,"_17578":45036,"_5":17474,"_23043":44749,"_2395":20987},[],{"_2868":1319,"_25194":1217,"_17578":45038,"_5":17474,"_23043":44749,"_2395":44935},[],{"_2868":1320,"_25194":1217,"_17578":45040,"_5":17474,"_23043":44749,"_2395":45041},[],"HTTP URL of Lamassu's Device Manager.",{"_2868":1321,"_25194":1217,"_17578":45043,"_5":17474,"_23043":44749,"_2395":45044},[],"`ca_client`",{"_2868":1322,"_25194":1217,"_17578":45046,"_5":17474,"_23043":44749,"_2395":20987},[],{"_2868":1323,"_25194":1217,"_17578":45048,"_5":17474,"_23043":44749,"_2395":44935},[],{"_2868":1324,"_25194":1217,"_17578":45050,"_5":17474,"_23043":44749,"_2395":45051},[],"HTTP URL of Lamassu's CA service.",{"_2868":1325,"_25194":1217,"_17578":45053,"_5":17474,"_23043":44753,"_2395":45054},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2868":1326,"_25194":1217,"_17578":45056,"_5":17474,"_23043":44757,"_2395":45057},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2868":1327,"_25194":1217,"_17578":45059,"_5":17474,"_23043":44757,"_2395":45060},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2868":1328,"_25194":1217,"_17578":45062,"_5":17474,"_23043":44761,"_2395":45063},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2868":1329,"_25194":1217,"_17578":45065,"_5":17474,"_23043":44761,"_2395":45066},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2868":1330,"_25194":1217,"_17578":45068,"_5":17474,"_23043":44761,"_2395":45069},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2868":1331,"_25194":1217,"_17578":45071,"_5":17474,"_23043":44761,"_2395":45072},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2868":1332,"_25194":1217,"_17578":45074,"_5":17474,"_23043":44761,"_2395":45075},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2868":1333,"_25194":1217,"_17578":45077,"_5":17474,"_23043":44761,"_2395":45078},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2868":1334,"_25194":1217,"_17578":45080,"_5":17474,"_23043":44765,"_2395":45081},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2868":1335,"_25194":1217,"_17578":45083,"_5":17474,"_23043":44769,"_2395":45084},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2868":1336,"_25194":1217,"_17578":45086,"_5":17474,"_23043":44769,"_2395":45087},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2868":1337,"_25194":1217,"_17578":45089,"_5":17474,"_23043":44773,"_2395":45090},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2868":1338,"_25194":1217,"_17578":45092,"_5":17474,"_23043":44777,"_2395":45093},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2868":1339,"_25194":1217,"_17578":45095,"_5":17474,"_23043":44777,"_2395":45096},[],"Creates or updates the IoT policies configured in the DMS.",{"_2868":1340,"_25194":1217,"_17578":45098,"_5":17474,"_23043":44777,"_2395":45099},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2868":1341,"_25194":1217,"_17578":45101,"_5":17474,"_23043":44777,"_2395":45102},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2868":1342,"_25194":1217,"_17578":45104,"_5":17474,"_23043":44777,"_2395":45105},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2868":1343,"_25194":1217,"_17578":45107,"_5":17474,"_23043":44777,"_2395":45108},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2868":1344,"_25194":1217,"_17578":45110,"_5":17474,"_23043":44777,"_2395":45111},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2868":1345,"_25194":1217,"_17578":45113,"_5":17474,"_23043":44781,"_2395":45114},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2868":1346,"_25194":1217,"_17578":45116,"_5":17474,"_23043":44781,"_2395":45117},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2868":1347,"_25194":1217,"_17578":45119,"_5":17474,"_23043":44781,"_2395":45120},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2868":1348,"_25194":1217,"_17578":45122,"_5":17474,"_23043":44785,"_2395":45123},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2868":1349,"_25194":1217,"_17578":45125,"_5":17474,"_23043":44785,"_2395":45126},[],"The full flow from the device's perspective is:",{"_2868":1350,"_25194":1217,"_17578":45128,"_5":17474,"_23043":44785,"_2395":45129},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2868":1351,"_25194":1217,"_17578":45131,"_5":17474,"_23043":44789,"_2395":45132},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2868":1352,"_25194":1217,"_17578":45134,"_5":17474,"_23043":44789,"_2395":45135},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2868":1353,"_25194":1217,"_17578":45137,"_5":17474,"_23043":44789,"_2395":45138},[],"For the JITP flow to work correctly:",{"_2868":1354,"_25194":1217,"_17578":45140,"_5":17474,"_23043":44789,"_2395":45141},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2868":1355,"_25194":1217,"_17578":45143,"_5":17474,"_23043":44789,"_2395":45144},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2868":1356,"_25194":1217,"_17578":45146,"_5":17474,"_23043":44789,"_2395":45147},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2868":1357,"_25194":1217,"_17578":45149,"_5":17474,"_23043":44789,"_2395":45150},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2868":1358,"_25194":1217,"_17578":45152,"_5":17474,"_23043":44793,"_2395":45153},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2868":1359,"_25194":1217,"_17578":45155,"_5":17474,"_23043":44793,"_2395":45156},[],"Status in Lamassu",{"_2868":1360,"_25194":1217,"_17578":45158,"_5":17474,"_23043":44793,"_2395":45159},[],"Revocation reason",{"_2868":1361,"_25194":1217,"_17578":45161,"_5":17474,"_23043":44793,"_2395":45162},[],"Status in AWS IoT Core",{"_2868":1362,"_25194":1217,"_17578":45164,"_5":17474,"_23043":44793,"_2395":45165},[],"`Active`",{"_2868":1363,"_25194":1217,"_17578":45167,"_5":17474,"_23043":44793,"_2395":45168},[],"None",{"_2868":1364,"_25194":1217,"_17578":45170,"_5":17474,"_23043":44793,"_2395":45171},[],"`ACTIVE`",{"_2868":1365,"_25194":1217,"_17578":45173,"_5":17474,"_23043":44793,"_2395":45174},[],"`Revoked`",{"_2868":1366,"_25194":1217,"_17578":45176,"_5":17474,"_23043":44793,"_2395":45177},[],"`certificateHold`",{"_2868":1367,"_25194":1217,"_17578":45179,"_5":17474,"_23043":44793,"_2395":45180},[],"`INACTIVE`",{"_2868":1368,"_25194":1217,"_17578":45182,"_5":17474,"_23043":44793,"_2395":45174},[],{"_2868":1369,"_25194":1217,"_17578":45184,"_5":17474,"_23043":44793,"_2395":45185},[],"Any other reason",{"_2868":1370,"_25194":1217,"_17578":45187,"_5":17474,"_23043":44793,"_2395":45188},[],"`REVOKED`",{"_2868":1371,"_25194":1217,"_17578":45190,"_5":17474,"_23043":44793,"_2395":45191},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2868":1372,"_25194":1217,"_17578":45193,"_5":17474,"_23043":44797,"_2395":45194},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2868":1373,"_25194":1217,"_17578":45196,"_5":17474,"_23043":44797,"_2395":45197},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2868":1374,"_25194":1217,"_17578":45199,"_5":17474,"_23043":44797,"_2395":45200},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2868":1375,"_25194":1217,"_17578":45202,"_5":17474,"_23043":44801,"_2395":45203},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2868":1376,"_25194":1217,"_17578":45205,"_5":17474,"_23043":44801,"_2395":45206},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2868":1377,"_25194":1217,"_17578":45208,"_5":17474,"_23043":44805,"_2395":45209},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2868":1378,"_25194":1217,"_17578":45211,"_5":17474,"_23043":44805,"_2395":45212},[],"There are two action types:",{"_2868":1379,"_25194":1217,"_17578":45214,"_5":17474,"_23043":44805,"_2395":45215},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2868":1380,"_25194":1217,"_17578":45217,"_5":17474,"_23043":44805,"_2395":45218},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2868":1381,"_25194":1217,"_17578":45220,"_5":17474,"_23043":44805,"_2395":45221},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2868":1382,"_25194":1217,"_17578":45223,"_5":17474,"_23043":44809,"_2395":45224},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2868":1383,"_25194":1217,"_17578":45226,"_5":17474,"_23043":44809,"_2395":45227},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2868":1384,"_25194":1217,"_17578":45229,"_5":17474,"_23043":44809,"_2395":45230},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2868":1385,"_25194":1217,"_17578":45232,"_5":17474,"_23043":44813,"_2395":45233},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2868":1386,"_25194":1217,"_17578":45235,"_5":17474,"_23043":44813,"_2395":45236},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2868":1387,"_25194":1217,"_17578":45238,"_5":17474,"_23043":44813,"_2395":45239},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2868":1388,"_25194":1217,"_17578":45241,"_5":17474,"_23043":44813,"_2395":45242},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2868":1389,"_25194":1217,"_17578":45244,"_5":17474,"_23043":44813,"_2395":45245},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2868":1390,"_25194":1217,"_17578":45247,"_5":17474,"_23043":44813,"_2395":45248},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2868":1391,"_25194":1217,"_17578":45250,"_5":17474,"_23043":44813,"_2395":45251},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2868":1392,"_25194":1217,"_17578":45253,"_5":17474,"_23043":44813,"_2395":45254},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2868":1393,"_25194":1217,"_17578":45256,"_5":17474,"_23043":44813,"_2395":45257},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2868":1394,"_25194":1217,"_17578":45259,"_5":17474,"_23043":44813,"_2395":45260},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2868":1395,"_25194":1217,"_17578":45262,"_5":17474,"_23043":44813,"_2395":45263},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2868":1396,"_25194":1217,"_17578":45265,"_5":17474,"_23043":44813,"_2395":45266},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2868":1397,"_25194":1217,"_17578":45268,"_5":17474,"_23043":44813,"_2395":45269},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2868":1398,"_25194":1217,"_17578":45271,"_5":17474,"_23043":44813,"_2395":45272},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2868":1399,"_25194":1217,"_17578":45274,"_5":17474,"_23043":44813,"_2395":45275},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2868":1400,"_25194":1217,"_17578":45277,"_5":17474,"_23043":44813,"_2395":45278},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2868":1401,"_25194":1217,"_17578":45280,"_5":17474,"_23043":44813,"_2395":45281},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2868":1402,"_25194":1217,"_17578":45283,"_5":17474,"_23043":44813,"_2395":45284},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2868":1403,"_25194":1217,"_17578":45286,"_5":17474,"_23043":44813,"_2395":45287},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2868":1404,"_25194":1217,"_17578":45289,"_5":17474,"_23043":44813,"_2395":45290},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2868":1405,"_25194":1217,"_17578":45292,"_5":17474,"_23043":44813,"_2395":45293},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2868":1406,"_25194":1406,"_5":12321,"_2395":43283,"_25530":45295,"_17578":45296,"_23043":1406},[40934,42278,43283],[],{"_2868":1407,"_25194":1406,"_17578":45298,"_5":17474,"_23043":1406,"_2395":45299},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2868":1408,"_25194":1406,"_5":25527,"_17578":45301,"_23043":45302,"_2395":45303},[],"/docs/pr-preview/pr-39/platform/iot-fleets/overview#start-here","Start here",{"_2868":1409,"_25194":1406,"_5":25527,"_17578":45305,"_23043":45306,"_2395":43281},[],"/docs/pr-preview/pr-39/platform/iot-fleets/overview#devices-and-identities",{"_2868":1410,"_25194":1406,"_5":25527,"_17578":45308,"_23043":45309,"_2395":43464},[],"/docs/pr-preview/pr-39/platform/iot-fleets/overview#enrollment-with-pki",{"_2868":1411,"_25194":1406,"_5":25527,"_17578":45311,"_23043":45312,"_2395":44730},[],"/docs/pr-preview/pr-39/platform/iot-fleets/overview#integrations",{"_2868":1412,"_25194":1406,"_5":25527,"_17578":45314,"_23043":45315,"_2395":45316},[],"/docs/pr-preview/pr-39/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2868":1413,"_25194":1406,"_17578":45318,"_5":17474,"_23043":1406,"_2395":45319},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2868":1414,"_25194":1406,"_17578":45321,"_5":17474,"_23043":45302,"_2395":45322},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2868":1415,"_25194":1406,"_17578":45324,"_5":17474,"_23043":45302,"_2395":45325},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2868":1416,"_25194":1406,"_17578":45327,"_5":17474,"_23043":45306,"_2395":45328},[],"Resource",{"_2868":1417,"_25194":1406,"_17578":45330,"_5":17474,"_23043":45306,"_2395":45331},[],"What it represents",{"_2868":1418,"_25194":1406,"_17578":45333,"_5":17474,"_23043":45306,"_2395":45334},[],"**Device**",{"_2868":1419,"_25194":1406,"_17578":45336,"_5":17474,"_23043":45306,"_2395":45337},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2868":1420,"_25194":1406,"_17578":45339,"_5":17474,"_23043":45306,"_2395":45340},[],"**Identity**",{"_2868":1421,"_25194":1406,"_17578":45342,"_5":17474,"_23043":45306,"_2395":45343},[],"The device's association with its certificates: an active version and a history.",{"_2868":1422,"_25194":1406,"_17578":45345,"_5":17474,"_23043":45306,"_2395":45346},[],"**DMS**",{"_2868":1423,"_25194":1406,"_17578":45348,"_5":17474,"_23043":45306,"_2395":45349},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2868":1424,"_25194":1406,"_17578":45351,"_5":17474,"_23043":45306,"_2395":45352},[],"**Fleet**",{"_2868":1425,"_25194":1406,"_17578":45354,"_5":17474,"_23043":45306,"_2395":45355},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2868":1426,"_25194":1406,"_17578":45357,"_5":17474,"_23043":45306,"_2395":45358},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2868":1427,"_25194":1406,"_17578":45360,"_5":17474,"_23043":45306,"_2395":45361},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2868":1428,"_25194":1406,"_17578":45363,"_5":17474,"_23043":45309,"_2395":45364},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2868":1429,"_25194":1406,"_17578":45366,"_5":17474,"_23043":45309,"_2395":45367},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2868":1430,"_25194":1406,"_17578":45369,"_5":17474,"_23043":45309,"_2395":45370},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2868":1431,"_25194":1406,"_17578":45372,"_5":17474,"_23043":45309,"_2395":45373},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2868":1432,"_25194":1406,"_17578":45375,"_5":17474,"_23043":45309,"_2395":45376},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2868":1433,"_25194":1406,"_17578":45378,"_5":17474,"_23043":45309,"_2395":45379},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2868":1434,"_25194":1406,"_17578":45381,"_5":17474,"_23043":45309,"_2395":45382},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2868":1435,"_25194":1406,"_17578":45384,"_5":17474,"_23043":45309,"_2395":45385},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2868":1436,"_25194":1406,"_17578":45387,"_5":17474,"_23043":45312,"_2395":45388},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2868":1437,"_25194":1406,"_17578":45390,"_5":17474,"_23043":45312,"_2395":45391},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2868":1438,"_25194":1406,"_17578":45393,"_5":17474,"_23043":45315,"_2395":45394},[],"Participant",{"_2868":1439,"_25194":1406,"_17578":45396,"_5":17474,"_23043":45315,"_2395":45397},[],"Responsibility",{"_2868":1440,"_25194":1406,"_17578":45399,"_5":17474,"_23043":45315,"_2395":45400},[],"PKI administrator",{"_2868":1441,"_25194":1406,"_17578":45402,"_5":17474,"_23043":45315,"_2395":45403},[],"CA, issuance profile, chain and revocation publication.",{"_2868":1442,"_25194":1406,"_17578":45405,"_5":17474,"_23043":45315,"_2395":45406},[],"Provisioning administrator",{"_2868":1443,"_25194":1406,"_17578":45408,"_5":17474,"_23043":45315,"_2395":45409},[],"DMS, admission, authentication per operation and inventory.",{"_2868":1444,"_25194":1406,"_17578":45411,"_5":17474,"_23043":45315,"_2395":45412},[],"Device integrator",{"_2868":1445,"_25194":1406,"_17578":45414,"_5":17474,"_23043":45315,"_2395":45415},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2868":1446,"_25194":1406,"_17578":45417,"_5":17474,"_23043":45315,"_2395":45418},[],"Consumer integrator",{"_2868":1447,"_25194":1406,"_17578":45420,"_5":17474,"_23043":45315,"_2395":45421},[],"Trusted issuers, validation and device permissions in the destination.",{"_2868":1448,"_25194":1406,"_17578":45423,"_5":17474,"_23043":45315,"_2395":45424},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2868":1449,"_25194":1449,"_5":12321,"_2395":45426,"_25530":45427,"_17578":45429,"_23043":1449},"Enroll and connect your first device",[40934,42278,43283,45428],"Getting started",[],{"_2868":1450,"_25194":1449,"_17578":45431,"_5":17474,"_23043":1449,"_2395":45432},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2868":1451,"_25194":1449,"_5":25527,"_17578":45434,"_23043":45435,"_2395":40944},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2868":1452,"_25194":1449,"_5":25527,"_17578":45437,"_23043":45438,"_2395":45439},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2868":1453,"_25194":1449,"_5":25527,"_17578":45441,"_23043":45442,"_2395":45443},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2868":1454,"_25194":1449,"_5":25527,"_17578":45445,"_23043":45446,"_2395":45447},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2868":1455,"_25194":1449,"_5":25527,"_17578":45449,"_23043":45450,"_2395":45451},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2868":1456,"_25194":1449,"_5":25527,"_17578":45453,"_23043":45454,"_2395":45455},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2868":1457,"_25194":1449,"_5":25527,"_17578":45457,"_23043":45458,"_2395":45459},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2868":1458,"_25194":1449,"_5":25527,"_17578":45461,"_23043":45462,"_2395":45463},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2868":1459,"_25194":1449,"_17578":45465,"_5":17474,"_23043":1449,"_2395":45466},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2868":1460,"_25194":1449,"_17578":45468,"_5":17474,"_23043":45435,"_2395":45469},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2868":1461,"_25194":1449,"_17578":45471,"_5":17474,"_23043":45435,"_2395":45472},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2868":1462,"_25194":1449,"_17578":45474,"_5":17474,"_23043":45435,"_2395":45475},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2868":1463,"_25194":1449,"_17578":45477,"_5":17474,"_23043":45435,"_2395":45478},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2868":1464,"_25194":1449,"_17578":45480,"_5":17474,"_23043":45435,"_2395":45481},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2868":1465,"_25194":1449,"_17578":45483,"_5":17474,"_23043":45438,"_2395":45484},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2868":1466,"_25194":1449,"_17578":45486,"_5":17474,"_23043":45438,"_2395":45487},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2868":1467,"_25194":1449,"_17578":45489,"_5":17474,"_23043":45442,"_2395":45490},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2868":1468,"_25194":1449,"_17578":45492,"_5":17474,"_23043":45442,"_2395":45493},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2868":1469,"_25194":1449,"_17578":45495,"_5":17474,"_23043":45442,"_2395":45496},[],"Setting",{"_2868":1470,"_25194":1449,"_17578":45498,"_5":17474,"_23043":45442,"_2395":45499},[],"Evaluation value",{"_2868":1471,"_25194":1449,"_17578":45501,"_5":17474,"_23043":45442,"_2395":45502},[],"Enrollment CA",{"_2868":1472,"_25194":1449,"_17578":45504,"_5":17474,"_23043":45442,"_2395":45505},[],"Issuing root from `device-root.pem`.",{"_2868":1473,"_25194":1449,"_17578":45507,"_5":17474,"_23043":45442,"_2395":43594},[],{"_2868":1474,"_25194":1449,"_17578":45509,"_5":17474,"_23043":45442,"_2395":45510},[],"The 1-hour leaf profile you just prepared.",{"_2868":1475,"_25194":1449,"_17578":45512,"_5":17474,"_23043":45442,"_2395":45513},[],"Protocol / Registration Mode",{"_2868":1476,"_25194":1449,"_17578":45515,"_5":17474,"_23043":45442,"_2395":45516},[],"`EST_RFC7030` / `JITP`.",{"_2868":1477,"_25194":1449,"_17578":45518,"_5":17474,"_23043":45442,"_2395":45519},[],"Verify CSR Signature",{"_2868":1478,"_25194":1449,"_17578":45521,"_5":17474,"_23043":45442,"_2395":45522},[],"Enabled.",{"_2868":1479,"_25194":1449,"_17578":45524,"_5":17474,"_23043":45442,"_2395":45525},[],"Enable Replaceable Enrollment",{"_2868":1480,"_25194":1449,"_17578":45527,"_5":17474,"_23043":45442,"_2395":45528},[],"Disabled; the ID must be new.",{"_2868":1481,"_25194":1449,"_17578":45530,"_5":17474,"_23043":45442,"_2395":45531},[],"Initial authentication",{"_2868":1482,"_25194":1449,"_17578":45533,"_5":17474,"_23043":45442,"_2395":45534},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2868":1483,"_25194":1449,"_17578":45536,"_5":17474,"_23043":45442,"_2395":45537},[],"Renewal authentication",{"_2868":1484,"_25194":1449,"_17578":45539,"_5":17474,"_23043":45442,"_2395":45540},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2868":1485,"_25194":1449,"_17578":45542,"_5":17474,"_23043":45442,"_2395":45543},[],"Additional Validation CAs / Enable Expired Renewal",{"_2868":1486,"_25194":1449,"_17578":45545,"_5":17474,"_23043":45442,"_2395":45546},[],"Empty list for this direct issuance / disabled.",{"_2868":1487,"_25194":1449,"_17578":45548,"_5":17474,"_23043":45442,"_2395":45549},[],"Re-enrollment Delta",{"_2868":1488,"_25194":1449,"_17578":45551,"_5":17474,"_23043":45442,"_2395":45552},[],"1 hour.",{"_2868":1489,"_25194":1449,"_17578":45554,"_5":17474,"_23043":45442,"_2395":45555},[],"Preventive / Critical Delta",{"_2868":1490,"_25194":1449,"_17578":45557,"_5":17474,"_23043":45442,"_2395":45558},[],"30 minutes / 10 minutes.",{"_2868":1491,"_25194":1449,"_17578":45560,"_5":17474,"_23043":45442,"_2395":45561},[],"Revoke on Re-enrollment",{"_2868":1492,"_25194":1449,"_17578":45563,"_5":17474,"_23043":45442,"_2395":45564},[],"Disabled to test the successor before retiring the previous identity.",{"_2868":1493,"_25194":1449,"_17578":45566,"_5":17474,"_23043":45442,"_2395":43602},[],{"_2868":1494,"_25194":1449,"_17578":45568,"_5":17474,"_23043":45442,"_2395":45569},[],"Disabled; the operational key is generated in the client.",{"_2868":1495,"_25194":1449,"_17578":45571,"_5":17474,"_23043":45442,"_2395":45572},[],"CA Distribution",{"_2868":1496,"_25194":1449,"_17578":45574,"_5":17474,"_23043":45442,"_2395":45575},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2868":1497,"_25194":1449,"_17578":45577,"_5":17474,"_23043":45442,"_2395":45578},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2868":1498,"_25194":1449,"_17578":45580,"_5":17474,"_23043":45446,"_2395":45581},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2868":1499,"_25194":1449,"_17578":45583,"_5":17474,"_23043":45446,"_2395":45584},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2868":1500,"_25194":1449,"_17578":45586,"_5":17474,"_23043":45450,"_2395":45587},[],"Generate a new key and CSR with the selected identifier:",{"_2868":1501,"_25194":1449,"_17578":45589,"_5":17474,"_23043":45450,"_2395":45590},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2868":1502,"_25194":1449,"_17578":45592,"_5":17474,"_23043":45450,"_2395":45593},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2868":1503,"_25194":1449,"_17578":45595,"_5":17474,"_23043":45454,"_2395":45596},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2868":1504,"_25194":1449,"_17578":45598,"_5":17474,"_23043":45454,"_2395":45599},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2868":1505,"_25194":1449,"_17578":45601,"_5":17474,"_23043":45458,"_2395":45602},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2868":1506,"_25194":1449,"_17578":45604,"_5":17474,"_23043":45458,"_2395":45605},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2868":1507,"_25194":1449,"_17578":45607,"_5":17474,"_23043":45458,"_2395":45608},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2868":1508,"_25194":1449,"_17578":45610,"_5":17474,"_23043":45458,"_2395":45611},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2868":1509,"_25194":1449,"_17578":45613,"_5":17474,"_23043":45458,"_2395":45614},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2868":1510,"_25194":1449,"_17578":45616,"_5":17474,"_23043":45462,"_2395":45617},[],"Check",{"_2868":1511,"_25194":1449,"_17578":45619,"_5":17474,"_23043":45462,"_2395":45620},[],"Expected result",{"_2868":1512,"_25194":1449,"_17578":45622,"_5":17474,"_23043":45462,"_2395":45623},[],"Registration",{"_2868":1513,"_25194":1449,"_17578":45625,"_5":17474,"_23043":45462,"_2395":45626},[],"ID created automatically and correct DMS.",{"_2868":1514,"_25194":1449,"_17578":45628,"_5":17474,"_23043":45462,"_2395":45629},[],"Certificate",{"_2868":1515,"_25194":1449,"_17578":45631,"_5":17474,"_23043":45462,"_2395":45632},[],"CN, profile, serial and key verified.",{"_2868":1516,"_25194":1449,"_17578":45634,"_5":17474,"_23043":45462,"_2395":45635},[],"Inventory",{"_2868":1517,"_25194":1449,"_17578":45637,"_5":17474,"_23043":45462,"_2395":45638},[],"Received serial visible as the current identity and in history.",{"_2868":1518,"_25194":1449,"_17578":45640,"_5":17474,"_23043":45462,"_2395":45641},[],"Consumer",{"_2868":1519,"_25194":1449,"_17578":45643,"_5":17474,"_23043":45462,"_2395":45644},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2868":1520,"_25194":1449,"_17578":45646,"_5":17474,"_23043":45462,"_2395":45647},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2868":1521,"_25194":1449,"_17578":45649,"_5":17474,"_23043":45462,"_2395":45650},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2868":1522,"_25194":1522,"_5":12321,"_2395":43299,"_25530":45652,"_17578":45653,"_23043":1522},[40934,42278,43283,45428],[],{"_2868":1523,"_25194":1522,"_17578":45655,"_5":17474,"_23043":1522,"_2395":45656},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2868":1524,"_25194":1522,"_5":25527,"_17578":45658,"_23043":45659,"_2395":40944},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2868":1525,"_25194":1522,"_5":25527,"_17578":45661,"_23043":45662,"_2395":45663},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2868":1526,"_25194":1522,"_5":25527,"_17578":45665,"_23043":45666,"_2395":45667},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2868":1527,"_25194":1522,"_5":25527,"_17578":45669,"_23043":45670,"_2395":45671},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2868":1528,"_25194":1522,"_5":25527,"_17578":45673,"_23043":45674,"_2395":45675},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2868":1529,"_25194":1522,"_5":25527,"_17578":45677,"_23043":45678,"_2395":45679},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2868":1530,"_25194":1522,"_5":25527,"_17578":45681,"_23043":45682,"_2395":45620},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2868":1531,"_25194":1522,"_5":25527,"_17578":45684,"_23043":45685,"_2395":45686},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2868":1532,"_25194":1522,"_5":25527,"_17578":45688,"_23043":45689,"_2395":45690},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2868":1533,"_25194":1522,"_17578":45692,"_5":17474,"_23043":1522,"_2395":45693},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2868":1534,"_25194":1522,"_17578":45695,"_5":17474,"_23043":1522,"_2395":45696},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2868":1535,"_25194":1522,"_17578":45698,"_5":17474,"_23043":45659,"_2395":45699},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2868":1536,"_25194":1522,"_17578":45701,"_5":17474,"_23043":45659,"_2395":45702},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2868":1537,"_25194":1522,"_17578":45704,"_5":17474,"_23043":45659,"_2395":45705},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2868":1538,"_25194":1522,"_17578":45707,"_5":17474,"_23043":45659,"_2395":45708},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2868":1539,"_25194":1522,"_17578":45710,"_5":17474,"_23043":45662,"_2395":45711},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2868":1540,"_25194":1522,"_17578":45713,"_5":17474,"_23043":45662,"_2395":45714},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2868":1541,"_25194":1522,"_17578":45716,"_5":17474,"_23043":45662,"_2395":45717},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2868":1542,"_25194":1522,"_17578":45719,"_5":17474,"_23043":45662,"_2395":45720},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2868":1543,"_25194":1522,"_17578":45722,"_5":17474,"_23043":45662,"_2395":45723},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2868":1544,"_25194":1522,"_17578":45725,"_5":17474,"_23043":45662,"_2395":45726},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2868":1545,"_25194":1522,"_17578":45728,"_5":17474,"_23043":45662,"_2395":45729},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2868":1546,"_25194":1522,"_17578":45731,"_5":17474,"_23043":45662,"_2395":45732},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2868":1547,"_25194":1522,"_17578":45734,"_5":17474,"_23043":45666,"_2395":45735},[],"Open **Managed Devices** and the registration action. Complete:",{"_2868":1548,"_25194":1522,"_17578":45737,"_5":17474,"_23043":45666,"_2395":45738},[],"**Device ID**: `device-001`.",{"_2868":1549,"_25194":1522,"_17578":45740,"_5":17474,"_23043":45666,"_2395":45741},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2868":1550,"_25194":1522,"_17578":45743,"_5":17474,"_23043":45666,"_2395":45744},[],"**Icon** and **Tags**: optional classification.",{"_2868":1551,"_25194":1522,"_17578":45746,"_5":17474,"_23043":45666,"_2395":45747},[],"Confirm registration.",{"_2868":1552,"_25194":1522,"_17578":45749,"_5":17474,"_23043":45670,"_2395":45750},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2868":1553,"_25194":1522,"_17578":45752,"_5":17474,"_23043":45670,"_2395":45753},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2868":1554,"_25194":1522,"_17578":45755,"_5":17474,"_23043":45674,"_2395":45756},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2868":1555,"_25194":1522,"_17578":45758,"_5":17474,"_23043":45674,"_2395":45759},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2868":1556,"_25194":1522,"_17578":45761,"_5":17474,"_23043":45678,"_2395":45762},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2868":1557,"_25194":1522,"_17578":45764,"_5":17474,"_23043":45678,"_2395":45765},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2868":1558,"_25194":1522,"_17578":45767,"_5":17474,"_23043":45682,"_2395":45617},[],{"_2868":1559,"_25194":1522,"_17578":45769,"_5":17474,"_23043":45682,"_2395":45770},[],"Result",{"_2868":1560,"_25194":1522,"_17578":45772,"_5":17474,"_23043":45682,"_2395":45773},[],"Device",{"_2868":1561,"_25194":1522,"_17578":45775,"_5":17474,"_23043":45682,"_2395":45776},[],"`device-001` appears in inventory with the expected DMS.",{"_2868":1562,"_25194":1522,"_17578":45778,"_5":17474,"_23043":45682,"_2395":45779},[],"Current identity",{"_2868":1563,"_25194":1522,"_17578":45781,"_5":17474,"_23043":45682,"_2395":45782},[],"The associated certificate matches the one you verified in PKI.",{"_2868":1564,"_25194":1522,"_17578":45784,"_5":17474,"_23043":45682,"_2395":45785},[],"History",{"_2868":1565,"_25194":1522,"_17578":45787,"_5":17474,"_23043":45682,"_2395":45788},[],"The associated issuance appears with its serial number and dates.",{"_2868":1566,"_25194":1522,"_17578":45790,"_5":17474,"_23043":45682,"_2395":45791},[],"Key and certificate",{"_2868":1567,"_25194":1522,"_17578":45793,"_5":17474,"_23043":45682,"_2395":45794},[],"You have the verified pair ready to install on the device.",{"_2868":1568,"_25194":1522,"_17578":45796,"_5":17474,"_23043":45685,"_2395":45797},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2868":1569,"_25194":1522,"_17578":45799,"_5":17474,"_23043":45685,"_2395":45800},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2868":1570,"_25194":1522,"_17578":45802,"_5":17474,"_23043":45685,"_2395":45803},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2868":1571,"_25194":1522,"_17578":45805,"_5":17474,"_23043":45685,"_2395":45806},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2868":1572,"_25194":1522,"_17578":45808,"_5":17474,"_23043":45689,"_2395":45809},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2868":1573,"_25194":1522,"_17578":45811,"_5":17474,"_23043":45689,"_2395":45812},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2868":1574,"_25194":1522,"_17578":45814,"_5":17474,"_23043":45689,"_2395":45815},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2868":1575,"_25194":1575,"_5":12321,"_2395":45817,"_25530":45818,"_17578":45819,"_23043":1575},"Lamassu IoT Platform",[40934,42278],[],{"_2868":1576,"_25194":1575,"_17578":45821,"_5":17474,"_23043":1575,"_2395":45822},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2868":1577,"_25194":1575,"_5":25527,"_17578":45824,"_23043":45825,"_2395":45303},[],"/docs/pr-preview/pr-39/platform/overview#start-here",{"_2868":1578,"_25194":1575,"_5":25527,"_17578":45827,"_23043":45828,"_2395":45829},[],"/docs/pr-preview/pr-39/platform/overview#choose-your-path","Choose your path",{"_2868":1579,"_25194":1575,"_5":25527,"_17578":45831,"_23043":45832,"_2395":45833},[],"/docs/pr-preview/pr-39/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2868":1580,"_25194":1575,"_5":25527,"_17578":45835,"_23043":45836,"_2395":45837},[],"/docs/pr-preview/pr-39/platform/overview#core-capabilities","Core capabilities",{"_2868":1581,"_25194":1575,"_5":25527,"_17578":45839,"_23043":45840,"_2395":45841},[],"/docs/pr-preview/pr-39/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2868":1582,"_25194":1575,"_5":25527,"_17578":45843,"_23043":45844,"_2395":45845},[],"/docs/pr-preview/pr-39/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2868":1583,"_25194":1575,"_5":25527,"_17578":45847,"_23043":45848,"_2395":45849},[],"/docs/pr-preview/pr-39/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2868":1584,"_25194":1575,"_5":25527,"_17578":45851,"_23043":45852,"_2395":45853},[],"/docs/pr-preview/pr-39/platform/overview#automate-device-identities","Automate device identities",{"_2868":1585,"_25194":1575,"_5":25527,"_17578":45855,"_23043":45856,"_2395":45857},[],"/docs/pr-preview/pr-39/platform/overview#publish-validation-status","Publish validation status",{"_2868":1586,"_25194":1575,"_5":25527,"_17578":45859,"_23043":45860,"_2395":45861},[],"/docs/pr-preview/pr-39/platform/overview#react-to-events","React to events",{"_2868":1587,"_25194":1575,"_5":25527,"_17578":45863,"_23043":45864,"_2395":45865},[],"/docs/pr-preview/pr-39/platform/overview#operational-reference","Operational reference",{"_2868":1588,"_25194":1575,"_17578":45867,"_5":17474,"_23043":1575,"_2395":45868},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2868":1589,"_25194":1575,"_17578":45870,"_5":17474,"_23043":45825,"_2395":45871},[],"Choose the result you need:",{"_2868":1590,"_25194":1575,"_17578":45873,"_5":17474,"_23043":45825,"_2395":45874},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2868":1591,"_25194":1575,"_17578":45876,"_5":17474,"_23043":45825,"_2395":45877},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2868":1592,"_25194":1575,"_17578":45879,"_5":17474,"_23043":45825,"_2395":45880},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2868":1593,"_25194":1575,"_17578":45882,"_5":17474,"_23043":45828,"_2395":45883},[],"Section",{"_2868":1594,"_25194":1575,"_17578":45885,"_5":17474,"_23043":45828,"_2395":45886},[],"What you manage",{"_2868":1595,"_25194":1575,"_17578":45888,"_5":17474,"_23043":45828,"_2395":45889},[],"Entry point",{"_2868":1596,"_25194":1575,"_17578":45891,"_5":17474,"_23043":45828,"_2395":45892},[],"**PKI**",{"_2868":1597,"_25194":1575,"_17578":45894,"_5":17474,"_23043":45828,"_2395":45895},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2868":1598,"_25194":1575,"_17578":45897,"_5":17474,"_23043":45828,"_2395":45898},[],"PKI overview",{"_2868":1599,"_25194":1575,"_17578":45900,"_5":17474,"_23043":45828,"_2395":45901},[],"**IoT Fleets**",{"_2868":1600,"_25194":1575,"_17578":45903,"_5":17474,"_23043":45828,"_2395":45904},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2868":1601,"_25194":1575,"_17578":45906,"_5":17474,"_23043":45828,"_2395":45907},[],"IoT Fleets overview",{"_2868":1602,"_25194":1575,"_17578":45909,"_5":17474,"_23043":45828,"_2395":45910},[],"**Administration**",{"_2868":1603,"_25194":1575,"_17578":45912,"_5":17474,"_23043":45828,"_2395":45913},[],"Operator permissions, audit and event subscriptions.",{"_2868":1604,"_25194":1575,"_17578":45915,"_5":17474,"_23043":45828,"_2395":42276},[],{"_2868":1605,"_25194":1575,"_17578":45917,"_5":17474,"_23043":45828,"_2395":45918},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2868":1606,"_25194":1575,"_17578":45920,"_5":17474,"_23043":45832,"_2395":45921},[],"An identity's journey connects four responsibilities:",{"_2868":1607,"_25194":1575,"_17578":45923,"_5":17474,"_23043":45832,"_2395":45924},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2868":1608,"_25194":1575,"_17578":45926,"_5":17474,"_23043":45832,"_2395":45927},[],"The provisioning administrator configures the DMS and initial trust.",{"_2868":1609,"_25194":1575,"_17578":45929,"_5":17474,"_23043":45832,"_2395":45930},[],"The device client requests a certificate and installs it with the matching key.",{"_2868":1610,"_25194":1575,"_17578":45932,"_5":17474,"_23043":45832,"_2395":45933},[],"The consumer validates the identity and applies its access permissions.",{"_2868":1611,"_25194":1575,"_17578":45935,"_5":17474,"_23043":45832,"_2395":45936},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2868":1612,"_25194":1575,"_17578":45938,"_5":17474,"_23043":45840,"_2395":45939},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2868":1613,"_25194":1575,"_17578":45941,"_5":17474,"_23043":45844,"_2395":45942},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2868":1614,"_25194":1575,"_17578":45944,"_5":17474,"_23043":45848,"_2395":45945},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2868":1615,"_25194":1575,"_17578":45947,"_5":17474,"_23043":45852,"_2395":45948},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2868":1616,"_25194":1575,"_17578":45950,"_5":17474,"_23043":45856,"_2395":45951},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2868":1617,"_25194":1575,"_17578":45953,"_5":17474,"_23043":45860,"_2395":45954},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2868":1618,"_25194":1575,"_17578":45956,"_5":17474,"_23043":45864,"_2395":45397},[],{"_2868":1619,"_25194":1575,"_17578":45958,"_5":17474,"_23043":45864,"_2395":45959},[],"What it prepares or checks",{"_2868":1620,"_25194":1575,"_17578":45961,"_5":17474,"_23043":45864,"_2395":45400},[],{"_2868":1621,"_25194":1575,"_17578":45963,"_5":17474,"_23043":45864,"_2395":45964},[],"Key custody, CA hierarchy, profiles and validation.",{"_2868":1622,"_25194":1575,"_17578":45966,"_5":17474,"_23043":45864,"_2395":45967},[],"Fleet administrator",{"_2868":1623,"_25194":1575,"_17578":45969,"_5":17474,"_23043":45864,"_2395":45970},[],"DMS, device admission, renewal policy and inventory.",{"_2868":1624,"_25194":1575,"_17578":45972,"_5":17474,"_23043":45864,"_2395":45412},[],{"_2868":1625,"_25194":1575,"_17578":45974,"_5":17474,"_23043":45864,"_2395":45975},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2868":1626,"_25194":1575,"_17578":45977,"_5":17474,"_23043":45864,"_2395":45418},[],{"_2868":1627,"_25194":1575,"_17578":45979,"_5":17474,"_23043":45864,"_2395":45980},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2868":1628,"_25194":1575,"_17578":45982,"_5":17474,"_23043":45864,"_2395":45983},[],"Infrastructure operator",{"_2868":1629,"_25194":1575,"_17578":45985,"_5":17474,"_23043":45864,"_2395":45986},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2868":1630,"_25194":1575,"_17578":45988,"_5":17474,"_23043":45864,"_2395":45989},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2868":1631,"_25194":1631,"_5":12321,"_2395":45991,"_25530":45992,"_17578":45995,"_23043":1631},"CA hierarchy and rotation",[40934,42278,45993,45994],"PKI","Keys, authorities and certificates",[],{"_2868":1632,"_25194":1631,"_17578":45997,"_5":17474,"_23043":1631,"_2395":45998},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2868":1633,"_25194":1631,"_5":25527,"_17578":46000,"_23043":46001,"_2395":46002},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2868":1634,"_25194":1631,"_5":25527,"_17578":46004,"_23043":46005,"_2395":46006},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2868":1635,"_25194":1631,"_5":25527,"_17578":46008,"_23043":46009,"_2395":46010},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2868":1636,"_25194":1631,"_5":25527,"_17578":46012,"_23043":46013,"_2395":46014},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2868":1637,"_25194":1631,"_5":25527,"_17578":46016,"_23043":46017,"_2395":46018},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2868":1638,"_25194":1631,"_5":25527,"_17578":46020,"_23043":46021,"_2395":46022},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2868":1639,"_25194":1631,"_5":25527,"_17578":46024,"_23043":46025,"_2395":46026},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2868":1640,"_25194":1631,"_5":25527,"_17578":46028,"_23043":46029,"_2395":46030},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2868":1641,"_25194":1631,"_5":25527,"_17578":46032,"_23043":46033,"_2395":46034},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2868":1642,"_25194":1631,"_5":25527,"_17578":46036,"_23043":46037,"_2395":46038},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2868":1643,"_25194":1631,"_5":25527,"_17578":46040,"_23043":46041,"_2395":46042},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2868":1644,"_25194":1631,"_5":25527,"_17578":46044,"_23043":46045,"_2395":46046},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2868":1645,"_25194":1631,"_17578":46048,"_5":17474,"_23043":1631,"_2395":46049},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2868":1646,"_25194":1631,"_17578":46051,"_5":17474,"_23043":1631,"_2395":46052},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2868":1647,"_25194":1631,"_17578":46054,"_5":17474,"_23043":46001,"_2395":46055},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2868":1648,"_25194":1631,"_17578":46057,"_5":17474,"_23043":46001,"_2395":46058},[],"environment, such as production and preproduction;",{"_2868":1649,"_25194":1631,"_17578":46060,"_5":17474,"_23043":46001,"_2395":46061},[],"owner or operating team;",{"_2868":1650,"_25194":1631,"_17578":46063,"_5":17474,"_23043":46001,"_2395":46064},[],"device family or manufacturing process;",{"_2868":1651,"_25194":1631,"_17578":46066,"_5":17474,"_23043":46001,"_2395":46067},[],"region or regulatory requirement;",{"_2868":1652,"_25194":1631,"_17578":46069,"_5":17474,"_23043":46001,"_2395":46070},[],"cryptographic engine or key policy;",{"_2868":1653,"_25194":1631,"_17578":46072,"_5":17474,"_23043":46001,"_2395":46073},[],"maintenance window and renewal cadence.",{"_2868":1654,"_25194":1631,"_17578":46075,"_5":17474,"_23043":46001,"_2395":46076},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2868":1655,"_25194":1631,"_17578":46078,"_5":17474,"_23043":46001,"_2395":46079},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2868":1656,"_25194":1631,"_17578":46081,"_5":17474,"_23043":46005,"_2395":46082},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2868":1657,"_25194":1631,"_17578":46084,"_5":17474,"_23043":46005,"_2395":46085},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2868":1658,"_25194":1631,"_17578":46087,"_5":17474,"_23043":46005,"_2395":46088},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2868":1659,"_25194":1631,"_17578":46090,"_5":17474,"_23043":46009,"_2395":46091},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2868":1660,"_25194":1631,"_17578":46093,"_5":17474,"_23043":46009,"_2395":46094},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2868":1661,"_25194":1631,"_17578":46096,"_5":17474,"_23043":46009,"_2395":46097},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2868":1662,"_25194":1631,"_17578":46099,"_5":17474,"_23043":46009,"_2395":46100},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2868":1663,"_25194":1631,"_17578":46102,"_5":17474,"_23043":46017,"_2395":46103},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2868":1664,"_25194":1631,"_17578":46105,"_5":17474,"_23043":46021,"_2395":46106},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2868":1665,"_25194":1631,"_17578":46108,"_5":17474,"_23043":46025,"_2395":46109},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2868":1666,"_25194":1631,"_17578":46111,"_5":17474,"_23043":46029,"_2395":46112},[],"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment.",{"_2868":1667,"_25194":1631,"_17578":46114,"_5":17474,"_23043":46033,"_2395":46115},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2868":1668,"_25194":1631,"_17578":46117,"_5":17474,"_23043":46037,"_2395":46118},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2868":1669,"_25194":1631,"_17578":46120,"_5":17474,"_23043":46041,"_2395":46121},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2868":1670,"_25194":1631,"_17578":46123,"_5":17474,"_23043":46041,"_2395":46124},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2868":1671,"_25194":1631,"_17578":46126,"_5":17474,"_23043":46041,"_2395":46127},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2868":1672,"_25194":1631,"_17578":46129,"_5":17474,"_23043":46041,"_2395":46130},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2868":1673,"_25194":1631,"_17578":46132,"_5":17474,"_23043":46045,"_2395":46133},[],"The new chain ends in an anchor installed by the consumer.",{"_2868":1674,"_25194":1631,"_17578":46135,"_5":17474,"_23043":46045,"_2395":46136},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2868":1675,"_25194":1631,"_17578":46138,"_5":17474,"_23043":46045,"_2395":46139},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2868":1676,"_25194":1631,"_17578":46141,"_5":17474,"_23043":46045,"_2395":46142},[],"Re-enrollment accepts the old identity during the planned period.",{"_2868":1677,"_25194":1631,"_17578":46144,"_5":17474,"_23043":46045,"_2395":46145},[],"OCSP and CRL respond for the authorities that remain active.",{"_2868":1678,"_25194":1631,"_17578":46147,"_5":17474,"_23043":46045,"_2395":46148},[],"No DMS is left accidentally issuing from the old CA.",{"_2868":1679,"_25194":1631,"_17578":46150,"_5":17474,"_23043":46045,"_2395":46151},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2868":1680,"_25194":1680,"_5":12321,"_2395":46153,"_25530":46154,"_17578":46155,"_23043":1680},"Certification authorities",[40934,42278,45993,45994],[],{"_2868":1681,"_25194":1680,"_17578":46157,"_5":17474,"_23043":1680,"_2395":46158},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2868":1682,"_25194":1680,"_5":25527,"_17578":46160,"_23043":46161,"_2395":46162},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2868":1683,"_25194":1680,"_5":25527,"_17578":46164,"_23043":46165,"_2395":46166},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2868":1684,"_25194":1680,"_5":25527,"_17578":46168,"_23043":46169,"_2395":40944},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#before-you-begin",{"_2868":1685,"_25194":1680,"_5":25527,"_17578":46171,"_23043":46172,"_2395":46173},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2868":1686,"_25194":1680,"_5":25527,"_17578":46175,"_23043":46176,"_2395":46177},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2868":1687,"_25194":1680,"_5":25527,"_17578":46179,"_23043":46180,"_2395":46181},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2868":1688,"_25194":1680,"_5":25527,"_17578":46183,"_23043":46184,"_2395":46185},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2868":1689,"_25194":1680,"_5":25527,"_17578":46187,"_23043":46188,"_2395":46189},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2868":1690,"_25194":1680,"_5":25527,"_17578":46191,"_23043":46192,"_2395":46193},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2868":1691,"_25194":1680,"_5":25527,"_17578":46195,"_23043":46196,"_2395":46197},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2868":1692,"_25194":1680,"_5":25527,"_17578":46199,"_23043":46200,"_2395":46201},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2868":1693,"_25194":1680,"_5":25527,"_17578":46203,"_23043":46204,"_2395":46205},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2868":1694,"_25194":1680,"_5":25527,"_17578":46207,"_23043":46208,"_2395":46209},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2868":1695,"_25194":1680,"_5":25527,"_17578":46211,"_23043":46212,"_2395":46213},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2868":1696,"_25194":1680,"_5":25527,"_17578":46215,"_23043":46216,"_2395":46217},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2868":1697,"_25194":1680,"_5":25527,"_17578":46219,"_23043":46220,"_2395":46221},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2868":1698,"_25194":1680,"_5":25527,"_17578":46223,"_23043":46224,"_2395":46225},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2868":1699,"_25194":1680,"_5":25527,"_17578":46227,"_23043":46228,"_2395":46229},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2868":1700,"_25194":1680,"_5":25527,"_17578":46231,"_23043":46232,"_2395":46233},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2868":1701,"_25194":1680,"_5":25527,"_17578":46235,"_23043":46236,"_2395":46237},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2868":1702,"_25194":1680,"_5":25527,"_17578":46239,"_23043":46240,"_2395":46241},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2868":1703,"_25194":1680,"_5":25527,"_17578":46243,"_23043":46244,"_2395":46245},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2868":1704,"_25194":1680,"_17578":46247,"_5":17474,"_23043":1680,"_2395":46248},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2868":1705,"_25194":1680,"_17578":46250,"_5":17474,"_23043":1680,"_2395":46251},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2868":1706,"_25194":1680,"_17578":46253,"_5":17474,"_23043":1680,"_2395":46254},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2868":1707,"_25194":1680,"_17578":46256,"_5":17474,"_23043":46161,"_2395":46257},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2868":1708,"_25194":1680,"_17578":46259,"_5":17474,"_23043":46161,"_2395":46260},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2868":1709,"_25194":1680,"_17578":46262,"_5":17474,"_23043":46161,"_2395":46263},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2868":1710,"_25194":1680,"_17578":46265,"_5":17474,"_23043":46161,"_2395":46266},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2868":1711,"_25194":1680,"_17578":46268,"_5":17474,"_23043":46161,"_2395":46269},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2868":1712,"_25194":1680,"_17578":46271,"_5":17474,"_23043":46169,"_2395":46272},[],"Decide whether the CA will be a root or an intermediate.",{"_2868":1713,"_25194":1680,"_17578":46274,"_5":17474,"_23043":46169,"_2395":46275},[],"Choose the engine that will keep the key.",{"_2868":1714,"_25194":1680,"_17578":46277,"_5":17474,"_23043":46169,"_2395":46278},[],"Define a validity longer than that of the certificates it will issue.",{"_2868":1715,"_25194":1680,"_17578":46280,"_5":17474,"_23043":46169,"_2395":46281},[],"For an intermediate CA, make sure the parent CA is active.",{"_2868":1716,"_25194":1680,"_17578":46283,"_5":17474,"_23043":46172,"_2395":46284},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2868":1717,"_25194":1680,"_17578":46286,"_5":17474,"_23043":46176,"_2395":46287},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2868":1718,"_25194":1680,"_17578":46289,"_5":17474,"_23043":46176,"_2395":46290},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2868":1719,"_25194":1680,"_17578":46292,"_5":17474,"_23043":46180,"_2395":46293},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2868":1720,"_25194":1680,"_17578":46295,"_5":17474,"_23043":46184,"_2395":46296},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2868":1721,"_25194":1680,"_17578":46298,"_5":17474,"_23043":46184,"_2395":46299},[],"`C`: two-letter ISO 3166-1 country code.",{"_2868":1722,"_25194":1680,"_17578":46301,"_5":17474,"_23043":46184,"_2395":46302},[],"`ST`: state or province.",{"_2868":1723,"_25194":1680,"_17578":46304,"_5":17474,"_23043":46184,"_2395":46305},[],"`L`: locality.",{"_2868":1724,"_25194":1680,"_17578":46307,"_5":17474,"_23043":46184,"_2395":46308},[],"`O`: organization.",{"_2868":1725,"_25194":1680,"_17578":46310,"_5":17474,"_23043":46184,"_2395":46311},[],"`OU`: organizational unit.",{"_2868":1726,"_25194":1680,"_17578":46313,"_5":17474,"_23043":46184,"_2395":46314},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2868":1727,"_25194":1680,"_17578":46316,"_5":17474,"_23043":46188,"_2395":46317},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2868":1728,"_25194":1680,"_17578":46319,"_5":17474,"_23043":46188,"_2395":46320},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2868":1729,"_25194":1680,"_17578":46322,"_5":17474,"_23043":46192,"_2395":46323},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2868":1730,"_25194":1680,"_17578":46325,"_5":17474,"_23043":46192,"_2395":46326},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2868":1731,"_25194":1680,"_17578":46328,"_5":17474,"_23043":46196,"_2395":46329},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2868":1732,"_25194":1680,"_17578":46331,"_5":17474,"_23043":46196,"_2395":46332},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2868":1733,"_25194":1680,"_17578":46334,"_5":17474,"_23043":46200,"_2395":46335},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2868":1734,"_25194":1680,"_17578":46337,"_5":17474,"_23043":46204,"_2395":46338},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2868":1735,"_25194":1680,"_17578":46340,"_5":17474,"_23043":46208,"_2395":46341},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2868":1736,"_25194":1680,"_17578":46343,"_5":17474,"_23043":46212,"_2395":46344},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2868":1737,"_25194":1680,"_17578":46346,"_5":17474,"_23043":46216,"_2395":46347},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2868":1738,"_25194":1680,"_17578":46349,"_5":17474,"_23043":46216,"_2395":46350},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2868":1739,"_25194":1680,"_17578":46352,"_5":17474,"_23043":46220,"_2395":46353},[],"Open a CA from the inventory to review:",{"_2868":1740,"_25194":1680,"_17578":46355,"_5":17474,"_23043":46220,"_2395":46356},[],"Status and validity period.",{"_2868":1741,"_25194":1680,"_17578":46358,"_5":17474,"_23043":46220,"_2395":46359},[],"Certificate and chain in PEM format.",{"_2868":1742,"_25194":1680,"_17578":46361,"_5":17474,"_23043":46220,"_2395":46362},[],"Number of active, expired and revoked certificates.",{"_2868":1743,"_25194":1680,"_17578":46364,"_5":17474,"_23043":46220,"_2395":46365},[],"Certificates issued in **Issued Certificates**.",{"_2868":1744,"_25194":1680,"_17578":46367,"_5":17474,"_23043":46220,"_2395":46368},[],"The CRL linked to the authority.",{"_2868":1745,"_25194":1680,"_17578":46370,"_5":17474,"_23043":46220,"_2395":46371},[],"Metadata and the associated cryptographic engine.",{"_2868":1746,"_25194":1680,"_17578":46373,"_5":17474,"_23043":46220,"_2395":46374},[],"You can filter the inventory by name, status and CA type.",{"_2868":1747,"_25194":1680,"_17578":46376,"_5":17474,"_23043":46224,"_2395":46377},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2868":1748,"_25194":1680,"_17578":46379,"_5":17474,"_23043":46224,"_2395":46380},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2868":1749,"_25194":1680,"_17578":46382,"_5":17474,"_23043":46224,"_2395":46383},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2868":1750,"_25194":1680,"_17578":46385,"_5":17474,"_23043":46224,"_2395":46386},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2868":1751,"_25194":1680,"_17578":46388,"_5":17474,"_23043":46228,"_2395":46389},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2868":1752,"_25194":1680,"_17578":46391,"_5":17474,"_23043":46232,"_2395":46392},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2868":1753,"_25194":1680,"_17578":46394,"_5":17474,"_23043":46236,"_2395":46395},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2868":1754,"_25194":1680,"_17578":46397,"_5":17474,"_23043":46240,"_2395":46398},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2868":1755,"_25194":1680,"_17578":46400,"_5":17474,"_23043":46244,"_2395":46401},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2868":1756,"_25194":1680,"_17578":46403,"_5":17474,"_23043":46244,"_2395":46404},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2868":1757,"_25194":1757,"_5":12321,"_2395":46406,"_25530":46407,"_17578":46408,"_23043":1757},"Certificate profiles",[40934,42278,45993,45994],[],{"_2868":1758,"_25194":1757,"_17578":46410,"_5":17474,"_23043":1757,"_2395":46411},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2868":1759,"_25194":1757,"_5":25527,"_17578":46413,"_23043":46414,"_2395":46415},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2868":1760,"_25194":1757,"_5":25527,"_17578":46417,"_23043":46418,"_2395":46419},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#validity","Validity",{"_2868":1761,"_25194":1757,"_5":25527,"_17578":46421,"_23043":46422,"_2395":46423},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2868":1762,"_25194":1757,"_5":25527,"_17578":46425,"_23043":46426,"_2395":46427},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2868":1763,"_25194":1757,"_5":25527,"_17578":46429,"_23043":46430,"_2395":46431},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#subject","Subject",{"_2868":1764,"_25194":1757,"_5":25527,"_17578":46433,"_23043":46434,"_2395":46435},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2868":1765,"_25194":1757,"_5":25527,"_17578":46437,"_23043":46438,"_2395":46439},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2868":1766,"_25194":1757,"_5":25527,"_17578":46441,"_23043":46442,"_2395":46443},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2868":1767,"_25194":1757,"_5":25527,"_17578":46445,"_23043":46446,"_2395":46447},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2868":1768,"_25194":1757,"_5":25527,"_17578":46449,"_23043":46450,"_2395":46451},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2868":1769,"_25194":1757,"_5":25527,"_17578":46453,"_23043":46454,"_2395":46455},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2868":1770,"_25194":1757,"_5":25527,"_17578":46457,"_23043":46458,"_2395":46459},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2868":1771,"_25194":1757,"_5":25527,"_17578":46461,"_23043":46462,"_2395":46463},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2868":1772,"_25194":1757,"_5":25527,"_17578":46465,"_23043":46466,"_2395":46467},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2868":1773,"_25194":1757,"_5":25527,"_17578":46469,"_23043":46470,"_2395":46471},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#design-examples","Design examples",{"_2868":1774,"_25194":1757,"_5":25527,"_17578":46473,"_23043":46474,"_2395":46475},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2868":1775,"_25194":1757,"_17578":46477,"_5":17474,"_23043":1757,"_2395":46478},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2868":1776,"_25194":1757,"_17578":46480,"_5":17474,"_23043":1757,"_2395":46481},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2868":1777,"_25194":1757,"_17578":46483,"_5":17474,"_23043":46418,"_2395":46484},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2868":1778,"_25194":1757,"_17578":46486,"_5":17474,"_23043":46418,"_2395":46487},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2868":1779,"_25194":1757,"_17578":46489,"_5":17474,"_23043":46422,"_2395":46490},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2868":1780,"_25194":1757,"_17578":46492,"_5":17474,"_23043":46426,"_2395":46493},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2868":1781,"_25194":1757,"_17578":46495,"_5":17474,"_23043":46426,"_2395":46496},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2868":1782,"_25194":1757,"_17578":46498,"_5":17474,"_23043":46426,"_2395":46499},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2868":1783,"_25194":1757,"_17578":46501,"_5":17474,"_23043":46430,"_2395":46502},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2868":1784,"_25194":1757,"_17578":46504,"_5":17474,"_23043":46434,"_2395":46505},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2868":1785,"_25194":1757,"_17578":46507,"_5":17474,"_23043":46434,"_2395":46508},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2868":1786,"_25194":1757,"_17578":46510,"_5":17474,"_23043":46438,"_2395":46511},[],"The cryptographic enforcement can:",{"_2868":1787,"_25194":1757,"_17578":46513,"_5":17474,"_23043":46438,"_2395":46514},[],"allow or block RSA keys;",{"_2868":1788,"_25194":1757,"_17578":46516,"_5":17474,"_23043":46438,"_2395":46517},[],"limit the supported RSA sizes;",{"_2868":1789,"_25194":1757,"_17578":46519,"_5":17474,"_23043":46438,"_2395":46520},[],"allow or block ECDSA keys;",{"_2868":1790,"_25194":1757,"_17578":46522,"_5":17474,"_23043":46438,"_2395":46523},[],"limit the supported ECDSA sizes or curves.",{"_2868":1791,"_25194":1757,"_17578":46525,"_5":17474,"_23043":46438,"_2395":46526},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2868":1792,"_25194":1757,"_17578":46528,"_5":17474,"_23043":46442,"_2395":46529},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2868":1793,"_25194":1757,"_17578":46531,"_5":17474,"_23043":46442,"_2395":44033},[],{"_2868":1794,"_25194":1757,"_17578":46533,"_5":17474,"_23043":46442,"_2395":46534},[],"First choice",{"_2868":1795,"_25194":1757,"_17578":46536,"_5":17474,"_23043":46442,"_2395":46537},[],"Second choice",{"_2868":1796,"_25194":1757,"_17578":46539,"_5":17474,"_23043":46442,"_2395":46540},[],"If neither is supplied",{"_2868":1797,"_25194":1757,"_17578":46542,"_5":17474,"_23043":46442,"_2395":46543},[],"Direct signing with a CA",{"_2868":1798,"_25194":1757,"_17578":46545,"_5":17474,"_23043":46442,"_2395":46546},[],"`issuance_profile` embedded in the request",{"_2868":1799,"_25194":1757,"_17578":46548,"_5":17474,"_23043":46442,"_2395":46549},[],"Request `issuance_profile_id`",{"_2868":1800,"_25194":1757,"_17578":46551,"_5":17474,"_23043":46442,"_2395":46552},[],"CA default profile (`profile_id`).",{"_2868":1801,"_25194":1757,"_17578":46554,"_5":17474,"_23043":46442,"_2395":46555},[],"Issuance through a DMS",{"_2868":1802,"_25194":1757,"_17578":46557,"_5":17474,"_23043":46442,"_2395":46558},[],"`settings.issuance_profile_id`",{"_2868":1803,"_25194":1757,"_17578":46560,"_5":17474,"_23043":46442,"_2395":46561},[],"`settings.issuance_profile` embedded in the DMS",{"_2868":1804,"_25194":1757,"_17578":46563,"_5":17474,"_23043":46442,"_2395":46564},[],"Enrollment CA default profile.",{"_2868":1805,"_25194":1757,"_17578":46566,"_5":17474,"_23043":46442,"_2395":46567},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2868":1806,"_25194":1757,"_17578":46569,"_5":17474,"_23043":46442,"_2395":46570},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2868":1807,"_25194":1757,"_17578":46572,"_5":17474,"_23043":46450,"_2395":46573},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2868":1808,"_25194":1757,"_17578":46575,"_5":17474,"_23043":46454,"_2395":46576},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2868":1809,"_25194":1757,"_17578":46578,"_5":17474,"_23043":46458,"_2395":46579},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2868":1810,"_25194":1757,"_17578":46581,"_5":17474,"_23043":46462,"_2395":46582},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2868":1811,"_25194":1757,"_17578":46584,"_5":17474,"_23043":46466,"_2395":46585},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2868":1812,"_25194":1757,"_17578":46587,"_5":17474,"_23043":46466,"_2395":46588},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2868":1813,"_25194":1757,"_17578":46590,"_5":17474,"_23043":46470,"_2395":46591},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2868":1814,"_25194":1757,"_17578":46593,"_5":17474,"_23043":46470,"_2395":46594},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2868":1815,"_25194":1757,"_17578":46596,"_5":17474,"_23043":46470,"_2395":46597},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2868":1816,"_25194":1757,"_17578":46599,"_5":17474,"_23043":46470,"_2395":46600},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2868":1817,"_25194":1757,"_17578":46602,"_5":17474,"_23043":46474,"_2395":46603},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2868":1818,"_25194":1757,"_17578":46605,"_5":17474,"_23043":46474,"_2395":46606},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2868":1819,"_25194":1819,"_5":12321,"_2395":46608,"_25530":46609,"_17578":46611,"_23043":1819},"Certificate validation",[40934,42278,45993,46610],"Validation",[],{"_2868":1820,"_25194":1819,"_17578":46613,"_5":17474,"_23043":1819,"_2395":46614},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2868":1821,"_25194":1819,"_5":25527,"_17578":46616,"_23043":46617,"_2395":46618},[],"/docs/pr-preview/pr-39/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2868":1822,"_25194":1819,"_5":25527,"_17578":46620,"_23043":46621,"_2395":46622},[],"/docs/pr-preview/pr-39/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2868":1823,"_25194":1819,"_5":25527,"_17578":46624,"_23043":46625,"_2395":46626},[],"/docs/pr-preview/pr-39/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2868":1824,"_25194":1819,"_17578":46628,"_5":17474,"_23043":1819,"_2395":46629},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2868":1825,"_25194":1819,"_17578":46631,"_5":17474,"_23043":46617,"_2395":46632},[],"Verify these criteria together:",{"_2868":1826,"_25194":1819,"_17578":46634,"_5":17474,"_23043":46617,"_2395":45617},[],{"_2868":1827,"_25194":1819,"_17578":46636,"_5":17474,"_23043":46617,"_2395":46637},[],"Required result",{"_2868":1828,"_25194":1819,"_17578":46639,"_5":17474,"_23043":46617,"_2395":46640},[],"Chain and signature",{"_2868":1829,"_25194":1819,"_17578":46642,"_5":17474,"_23043":46617,"_2395":46643},[],"Valid chain to a root deliberately installed in the consumer.",{"_2868":1830,"_25194":1819,"_17578":46645,"_5":17474,"_23043":46617,"_2395":46646},[],"Dates",{"_2868":1831,"_25194":1819,"_17578":46648,"_5":17474,"_23043":46617,"_2395":46649},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2868":1832,"_25194":1819,"_17578":46651,"_5":17474,"_23043":46617,"_2395":41981},[],{"_2868":1833,"_25194":1819,"_17578":46653,"_5":17474,"_23043":46617,"_2395":46654},[],"Name, SAN or identifier matches the expected peer.",{"_2868":1834,"_25194":1819,"_17578":46656,"_5":17474,"_23043":46617,"_2395":41317},[],{"_2868":1835,"_25194":1819,"_17578":46658,"_5":17474,"_23043":46617,"_2395":46659},[],"KU, EKU and constraints permit the specific operation.",{"_2868":1836,"_25194":1819,"_17578":46661,"_5":17474,"_23043":46617,"_2395":46662},[],"Revocation",{"_2868":1837,"_25194":1819,"_17578":46664,"_5":17474,"_23043":46617,"_2395":46665},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2868":1838,"_25194":1819,"_17578":46667,"_5":17474,"_23043":46617,"_2395":46668},[],"Authorization",{"_2868":1839,"_25194":1819,"_17578":46670,"_5":17474,"_23043":46617,"_2395":46671},[],"The application permits that identity to perform the action.",{"_2868":1840,"_25194":1819,"_17578":46673,"_5":17474,"_23043":46617,"_2395":46674},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2868":1841,"_25194":1819,"_17578":46676,"_5":17474,"_23043":46621,"_2395":46677},[],"Mechanism",{"_2868":1842,"_25194":1819,"_17578":46679,"_5":17474,"_23043":46621,"_2395":46680},[],"When to use it",{"_2868":1843,"_25194":1819,"_17578":46682,"_5":17474,"_23043":46621,"_2395":46683},[],"What you must maintain",{"_2868":1844,"_25194":1819,"_17578":46685,"_5":17474,"_23043":46621,"_2395":46686},[],"OCSP",{"_2868":1845,"_25194":1819,"_17578":46688,"_5":17474,"_23043":46621,"_2395":46689},[],"Status query for a specific certificate.",{"_2868":1846,"_25194":1819,"_17578":46691,"_5":17474,"_23043":46621,"_2395":46692},[],"Responder access, signature verification and cache/freshness policy.",{"_2868":1847,"_25194":1819,"_17578":46694,"_5":17474,"_23043":46621,"_2395":46695},[],"CRL",{"_2868":1848,"_25194":1819,"_17578":46697,"_5":17474,"_23043":46621,"_2395":46698},[],"Local checks for many certificates or offline operation.",{"_2868":1849,"_25194":1819,"_17578":46700,"_5":17474,"_23043":46621,"_2395":46701},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2868":1850,"_25194":1819,"_17578":46703,"_5":17474,"_23043":46621,"_2395":46704},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2868":1851,"_25194":1819,"_17578":46706,"_5":17474,"_23043":46621,"_2395":46707},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2868":1852,"_25194":1819,"_17578":46709,"_5":17474,"_23043":46625,"_2395":46710},[],"Accept a current, authorized certificate with a known chain.",{"_2868":1853,"_25194":1819,"_17578":46712,"_5":17474,"_23043":46625,"_2395":46713},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2868":1854,"_25194":1819,"_17578":46715,"_5":17474,"_23043":46625,"_2395":46716},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2868":1855,"_25194":1819,"_17578":46718,"_5":17474,"_23043":46625,"_2395":46719},[],"Check that a new connection with that identity is rejected.",{"_2868":1856,"_25194":1819,"_17578":46721,"_5":17474,"_23043":46625,"_2395":46722},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2868":1857,"_25194":1819,"_17578":46724,"_5":17474,"_23043":46625,"_2395":46725},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2868":1858,"_25194":1819,"_17578":46727,"_5":17474,"_23043":46625,"_2395":46728},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2868":1859,"_25194":1819,"_17578":46730,"_5":17474,"_23043":46625,"_2395":46731},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2868":1860,"_25194":1819,"_17578":46733,"_5":17474,"_23043":46625,"_2395":46734},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2868":1861,"_25194":1861,"_5":12321,"_2395":46736,"_25530":46737,"_17578":46738,"_23043":1861},"Certificates",[40934,42278,45993,45994],[],{"_2868":1862,"_25194":1861,"_17578":46740,"_5":17474,"_23043":1861,"_2395":46741},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2868":1863,"_25194":1861,"_5":25527,"_17578":46743,"_23043":46744,"_2395":46745},[],"/docs/pr-preview/pr-39/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2868":1864,"_25194":1861,"_5":25527,"_17578":46747,"_23043":46748,"_2395":46749},[],"/docs/pr-preview/pr-39/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2868":1865,"_25194":1861,"_5":25527,"_17578":46751,"_23043":46752,"_2395":46753},[],"/docs/pr-preview/pr-39/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2868":1866,"_25194":1861,"_5":25527,"_17578":46755,"_23043":46756,"_2395":46757},[],"/docs/pr-preview/pr-39/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2868":1867,"_25194":1861,"_5":25527,"_17578":46759,"_23043":46760,"_2395":46761},[],"/docs/pr-preview/pr-39/platform/pki/certificates#open-the-action","Open the action",{"_2868":1868,"_25194":1861,"_5":25527,"_17578":46763,"_23043":46764,"_2395":46765},[],"/docs/pr-preview/pr-39/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2868":1869,"_25194":1861,"_5":25527,"_17578":46767,"_23043":46768,"_2395":46769},[],"/docs/pr-preview/pr-39/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2868":1870,"_25194":1861,"_5":25527,"_17578":46771,"_23043":46772,"_2395":46773},[],"/docs/pr-preview/pr-39/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2868":1871,"_25194":1861,"_5":25527,"_17578":46775,"_23043":46776,"_2395":46777},[],"/docs/pr-preview/pr-39/platform/pki/certificates#continue","Continue",{"_2868":1872,"_25194":1861,"_17578":46779,"_5":17474,"_23043":1861,"_2395":46780},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2868":1873,"_25194":1861,"_17578":46782,"_5":17474,"_23043":46744,"_2395":46783},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2868":1874,"_25194":1861,"_17578":46785,"_5":17474,"_23043":46744,"_2395":46786},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2868":1875,"_25194":1861,"_17578":46788,"_5":17474,"_23043":46748,"_2395":46789},[],"Download the PEM and inspect it:",{"_2868":1876,"_25194":1861,"_17578":46791,"_5":17474,"_23043":46748,"_2395":46792},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2868":1877,"_25194":1861,"_17578":46794,"_5":17474,"_23043":46752,"_2395":46795},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2868":1878,"_25194":1861,"_17578":46797,"_5":17474,"_23043":46752,"_2395":46798},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2868":1879,"_25194":1861,"_17578":46800,"_5":17474,"_23043":46752,"_2395":46801},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2868":1880,"_25194":1861,"_17578":46803,"_5":17474,"_23043":46752,"_2395":46804},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2868":1881,"_25194":1861,"_17578":46806,"_5":17474,"_23043":46752,"_2395":46807},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2868":1882,"_25194":1861,"_17578":46809,"_5":17474,"_23043":46752,"_2395":46810},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2868":1883,"_25194":1861,"_17578":46812,"_5":17474,"_23043":46752,"_2395":46813},[],"For browser key generation, follow Issue your first certificate.",{"_2868":1884,"_25194":1861,"_17578":46815,"_5":17474,"_23043":46756,"_2395":46816},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2868":1885,"_25194":1861,"_17578":46818,"_5":17474,"_23043":46760,"_2395":46819},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2868":1886,"_25194":1861,"_17578":46821,"_5":17474,"_23043":46764,"_2395":46822},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2868":1887,"_25194":1861,"_17578":46824,"_5":17474,"_23043":46768,"_2395":46825},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2868":1888,"_25194":1861,"_17578":46827,"_5":17474,"_23043":46768,"_2395":46828},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2868":1889,"_25194":1861,"_17578":46830,"_5":17474,"_23043":46768,"_2395":46831},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2868":1890,"_25194":1861,"_17578":46833,"_5":17474,"_23043":46772,"_2395":46834},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2868":1891,"_25194":1861,"_17578":46836,"_5":17474,"_23043":46772,"_2395":46837},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2868":1892,"_25194":1861,"_17578":46839,"_5":17474,"_23043":46772,"_2395":46840},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2868":1893,"_25194":1861,"_17578":46842,"_5":17474,"_23043":46776,"_2395":46843},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2868":1894,"_25194":1861,"_17578":46845,"_5":17474,"_23043":46776,"_2395":46846},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2868":1895,"_25194":1895,"_5":12321,"_2395":46848,"_25530":46849,"_17578":46851,"_23043":1895},"Certificate lifecycle",[40934,42278,45993,46850],"Concepts",[],{"_2868":1896,"_25194":1895,"_17578":46853,"_5":17474,"_23043":1895,"_2395":46854},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2868":1897,"_25194":1895,"_5":25527,"_17578":46856,"_23043":46857,"_2395":46858},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2868":1898,"_25194":1895,"_5":25527,"_17578":46860,"_23043":46861,"_2395":46862},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2868":1899,"_25194":1895,"_5":25527,"_17578":46864,"_23043":46865,"_2395":46866},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2868":1900,"_25194":1895,"_5":25527,"_17578":46868,"_23043":46869,"_2395":46870},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2868":1901,"_25194":1895,"_5":25527,"_17578":46872,"_23043":46873,"_2395":46874},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2868":1902,"_25194":1895,"_5":25527,"_17578":46876,"_23043":46877,"_2395":46878},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2868":1903,"_25194":1895,"_5":25527,"_17578":46880,"_23043":46881,"_2395":46882},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2868":1904,"_25194":1895,"_5":25527,"_17578":46884,"_23043":46885,"_2395":46886},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2868":1905,"_25194":1895,"_5":25527,"_17578":46888,"_23043":46889,"_2395":46890},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2868":1906,"_25194":1895,"_5":25527,"_17578":46892,"_23043":46893,"_2395":46894},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2868":1907,"_25194":1895,"_17578":46896,"_5":17474,"_23043":1895,"_2395":46897},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2868":1908,"_25194":1895,"_17578":46899,"_5":17474,"_23043":46861,"_2395":46900},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2868":1909,"_25194":1895,"_17578":46902,"_5":17474,"_23043":46865,"_2395":46903},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2868":1910,"_25194":1895,"_17578":46905,"_5":17474,"_23043":46869,"_2395":46906},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2868":1911,"_25194":1895,"_17578":46908,"_5":17474,"_23043":46873,"_2395":46909},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2868":1912,"_25194":1895,"_17578":46911,"_5":17474,"_23043":46877,"_2395":46912},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2868":1913,"_25194":1895,"_17578":46914,"_5":17474,"_23043":46881,"_2395":46915},[],"Lamassu persists four X.509 states:",{"_2868":1914,"_25194":1895,"_17578":46917,"_5":17474,"_23043":46881,"_2395":46918},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2868":1915,"_25194":1895,"_17578":46920,"_5":17474,"_23043":46881,"_2395":46921},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2868":1916,"_25194":1895,"_17578":46923,"_5":17474,"_23043":46881,"_2395":46924},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2868":1917,"_25194":1895,"_17578":46926,"_5":17474,"_23043":46881,"_2395":46927},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2868":1918,"_25194":1895,"_17578":46929,"_5":17474,"_23043":46881,"_2395":46930},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2868":1919,"_25194":1895,"_17578":46932,"_5":17474,"_23043":46885,"_2395":46933},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2868":1920,"_25194":1895,"_17578":46935,"_5":17474,"_23043":46885,"_2395":46936},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2868":1921,"_25194":1895,"_17578":46938,"_5":17474,"_23043":46885,"_2395":46939},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2868":1922,"_25194":1895,"_17578":46941,"_5":17474,"_23043":46889,"_2395":46942},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2868":1923,"_25194":1895,"_17578":46944,"_5":17474,"_23043":46889,"_2395":46945},[],"Before confirming:",{"_2868":1924,"_25194":1895,"_17578":46947,"_5":17474,"_23043":46889,"_2395":46948},[],"Identify DMSs, devices and services that trust that chain.",{"_2868":1925,"_25194":1895,"_17578":46950,"_5":17474,"_23043":46889,"_2395":46951},[],"Distribute the new chain of trust.",{"_2868":1926,"_25194":1895,"_17578":46953,"_5":17474,"_23043":46889,"_2395":46954},[],"Reissue the necessary identities.",{"_2868":1927,"_25194":1895,"_17578":46956,"_5":17474,"_23043":46889,"_2395":46957},[],"Check OCSP and CRL from a real consumer.",{"_2868":1928,"_25194":1895,"_17578":46959,"_5":17474,"_23043":46889,"_2395":46960},[],"Revoke the old CA once no legitimate traffic remains.",{"_2868":1929,"_25194":1895,"_17578":46962,"_5":17474,"_23043":46889,"_2395":46963},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2868":1930,"_25194":1895,"_17578":46965,"_5":17474,"_23043":46893,"_2395":46966},[],"Certificates entering the preventive or critical renewal window.",{"_2868":1931,"_25194":1895,"_17578":46968,"_5":17474,"_23043":46893,"_2395":46969},[],"Repeated enrollment or re-enrollment failures.",{"_2868":1932,"_25194":1895,"_17578":46971,"_5":17474,"_23043":46893,"_2395":46972},[],"Status changes and revocation reasons.",{"_2868":1933,"_25194":1895,"_17578":46974,"_5":17474,"_23043":46893,"_2395":46975},[],"OCSP and CRL publication and validity.",{"_2868":1934,"_25194":1895,"_17578":46977,"_5":17474,"_23043":46893,"_2395":46978},[],"Dependencies still presenting a replaced certificate.",{"_2868":1935,"_25194":1895,"_17578":46980,"_5":17474,"_23043":46893,"_2395":46981},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2868":1936,"_25194":1936,"_5":12321,"_2395":46983,"_25530":46984,"_17578":46985,"_23043":1936},"Trust model",[40934,42278,45993,46850],[],{"_2868":1937,"_25194":1936,"_17578":46987,"_5":17474,"_23043":1936,"_2395":46988},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2868":1938,"_25194":1936,"_5":25527,"_17578":46990,"_23043":46991,"_2395":46992},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2868":1939,"_25194":1936,"_5":25527,"_17578":46994,"_23043":46995,"_2395":46996},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2868":1940,"_25194":1936,"_5":25527,"_17578":46998,"_23043":46999,"_2395":47000},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2868":1941,"_25194":1936,"_5":25527,"_17578":47002,"_23043":47003,"_2395":47004},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2868":1942,"_25194":1936,"_5":25527,"_17578":47006,"_23043":47007,"_2395":47008},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2868":1943,"_25194":1936,"_5":25527,"_17578":47010,"_23043":47011,"_2395":47012},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2868":1944,"_25194":1936,"_5":25527,"_17578":47014,"_23043":47015,"_2395":47016},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2868":1945,"_25194":1936,"_5":25527,"_17578":47018,"_23043":47019,"_2395":47020},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2868":1946,"_25194":1936,"_5":25527,"_17578":47022,"_23043":47023,"_2395":47024},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2868":1947,"_25194":1936,"_5":25527,"_17578":47026,"_23043":47027,"_2395":47028},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2868":1948,"_25194":1936,"_17578":47030,"_5":17474,"_23043":1936,"_2395":47031},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2868":1949,"_25194":1936,"_17578":47033,"_5":17474,"_23043":46995,"_2395":47034},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2868":1950,"_25194":1936,"_17578":47036,"_5":17474,"_23043":46999,"_2395":47037},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2868":1951,"_25194":1936,"_17578":47039,"_5":17474,"_23043":47003,"_2395":47040},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2868":1952,"_25194":1936,"_17578":47042,"_5":17474,"_23043":47007,"_2395":47043},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2868":1953,"_25194":1936,"_17578":47045,"_5":17474,"_23043":47011,"_2395":47046},[],"The device proves it can enroll according to the DMS policy.",{"_2868":1954,"_25194":1936,"_17578":47048,"_5":17474,"_23043":47011,"_2395":47049},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2868":1955,"_25194":1936,"_17578":47051,"_5":17474,"_23043":47011,"_2395":47052},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2868":1956,"_25194":1936,"_17578":47054,"_5":17474,"_23043":47011,"_2395":47055},[],"The device installs the certificate and the chain it needs.",{"_2868":1957,"_25194":1936,"_17578":47057,"_5":17474,"_23043":47011,"_2395":47058},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2868":1958,"_25194":1936,"_17578":47060,"_5":17474,"_23043":47011,"_2395":47061},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2868":1959,"_25194":1936,"_17578":47063,"_5":17474,"_23043":47015,"_2395":47064},[],"A DMS relates three sets that are worth designing separately:",{"_2868":1960,"_25194":1936,"_17578":47066,"_5":17474,"_23043":47015,"_2395":47067},[],"**Enrollment CA:** signs the new identities.",{"_2868":1961,"_25194":1936,"_17578":47069,"_5":17474,"_23043":47015,"_2395":47070},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs.",{"_2868":1962,"_25194":1936,"_17578":47072,"_5":17474,"_23043":47015,"_2395":47073},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2868":1963,"_25194":1936,"_17578":47075,"_5":17474,"_23043":47015,"_2395":47076},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2868":1964,"_25194":1936,"_17578":47078,"_5":17474,"_23043":47019,"_2395":47079},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2868":1965,"_25194":1936,"_17578":47081,"_5":17474,"_23043":47019,"_2395":47082},[],"that the current date is between `Not Before` and `Not After`;",{"_2868":1966,"_25194":1936,"_17578":47084,"_5":17474,"_23043":47019,"_2395":47085},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2868":1967,"_25194":1936,"_17578":47087,"_5":17474,"_23043":47019,"_2395":47088},[],"that names, SANs and subject match the expected identity;",{"_2868":1968,"_25194":1936,"_17578":47090,"_5":17474,"_23043":47019,"_2395":47091},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2868":1969,"_25194":1936,"_17578":47093,"_5":17474,"_23043":47019,"_2395":47094},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2868":1970,"_25194":1936,"_17578":47096,"_5":17474,"_23043":47019,"_2395":47097},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2868":1971,"_25194":1936,"_17578":47099,"_5":17474,"_23043":47023,"_2395":47100},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2868":1972,"_25194":1936,"_17578":47102,"_5":17474,"_23043":47027,"_2395":47103},[],"Keep the root out of daily operations, or with very restricted access.",{"_2868":1973,"_25194":1936,"_17578":47105,"_5":17474,"_23043":47027,"_2395":47106},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2868":1974,"_25194":1936,"_17578":47108,"_5":17474,"_23043":47027,"_2395":47109},[],"Assign explicit profiles to every use case.",{"_2868":1975,"_25194":1936,"_17578":47111,"_5":17474,"_23043":47027,"_2395":47112},[],"Distribute the new trust before starting a rotation.",{"_2868":1976,"_25194":1936,"_17578":47114,"_5":17474,"_23043":47027,"_2395":47115},[],"Keep enough overlap to renew a disconnected fleet.",{"_2868":1977,"_25194":1936,"_17578":47117,"_5":17474,"_23043":47027,"_2395":47118},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2868":1978,"_25194":1936,"_17578":47120,"_5":17474,"_23043":47027,"_2395":47121},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2868":1979,"_25194":1979,"_5":12321,"_2395":47123,"_25530":47124,"_17578":47125,"_23043":1979},"Revocation lists (CRL)",[40934,42278,45993,46610],[],{"_2868":1980,"_25194":1979,"_17578":47127,"_5":17474,"_23043":1979,"_2395":47128},[],"Generate and distribute signed lists to validate certificates offline.",{"_2868":1981,"_25194":1979,"_5":25527,"_17578":47130,"_23043":47131,"_2395":47132},[],"/docs/pr-preview/pr-39/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2868":1982,"_25194":1979,"_5":25527,"_17578":47134,"_23043":47135,"_2395":47136},[],"/docs/pr-preview/pr-39/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2868":1983,"_25194":1979,"_5":25527,"_17578":47138,"_23043":47139,"_2395":47140},[],"/docs/pr-preview/pr-39/platform/pki/crl#crl-contents","CRL contents",{"_2868":1984,"_25194":1979,"_5":25527,"_17578":47142,"_23043":47143,"_2395":47144},[],"/docs/pr-preview/pr-39/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2868":1985,"_25194":1979,"_5":25527,"_17578":47146,"_23043":47147,"_2395":47148},[],"/docs/pr-preview/pr-39/platform/pki/crl#va-role-management-api","VA role management API",{"_2868":1986,"_25194":1979,"_5":25527,"_17578":47150,"_23043":47151,"_2395":47152},[],"/docs/pr-preview/pr-39/platform/pki/crl#from-the-interface","From the interface",{"_2868":1987,"_25194":1979,"_5":25527,"_17578":47154,"_23043":47155,"_2395":47156},[],"/docs/pr-preview/pr-39/platform/pki/crl#references","References",{"_2868":1988,"_25194":1979,"_17578":47158,"_5":17474,"_23043":1979,"_2395":47159},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2868":1989,"_25194":1979,"_17578":47161,"_5":17474,"_23043":47131,"_2395":47162},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2868":1990,"_25194":1979,"_17578":47164,"_5":17474,"_23043":47131,"_2395":47165},[],"`crl_options` field",{"_2868":1991,"_25194":1979,"_17578":47167,"_5":17474,"_23043":47131,"_2395":41317},[],{"_2868":1992,"_25194":1979,"_17578":47169,"_5":17474,"_23043":47131,"_2395":47170},[],"Backend initial value",{"_2868":1993,"_25194":1979,"_17578":47172,"_5":17474,"_23043":47131,"_2395":47173},[],"`validity`",{"_2868":1994,"_25194":1979,"_17578":47175,"_5":17474,"_23043":47131,"_2395":47176},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2868":1995,"_25194":1979,"_17578":47178,"_5":17474,"_23043":47131,"_2395":47179},[],"7 days.",{"_2868":1996,"_25194":1979,"_17578":47181,"_5":17474,"_23043":47131,"_2395":47182},[],"`refresh_interval`",{"_2868":1997,"_25194":1979,"_17578":47184,"_5":17474,"_23043":47131,"_2395":47185},[],"Time since publication that triggers scheduled renewal.",{"_2868":1998,"_25194":1979,"_17578":47187,"_5":17474,"_23043":47131,"_2395":47188},[],"6 days and 23 hours.",{"_2868":1999,"_25194":1979,"_17578":47190,"_5":17474,"_23043":47131,"_2395":47191},[],"`regenerate_on_revoke`",{"_2868":2000,"_25194":1979,"_17578":47193,"_5":17474,"_23043":47131,"_2395":47194},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2868":2001,"_25194":1979,"_17578":47196,"_5":17474,"_23043":47131,"_2395":47197},[],"`true`.",{"_2868":2002,"_25194":1979,"_17578":47199,"_5":17474,"_23043":47131,"_2395":47200},[],"`subject_key_id_signer`",{"_2868":2003,"_25194":1979,"_17578":47202,"_5":17474,"_23043":47131,"_2395":47203},[],"Configuration field initialized with the CA’s SKI.",{"_2868":2004,"_25194":1979,"_17578":47205,"_5":17474,"_23043":47131,"_2395":47206},[],"CA SKI.",{"_2868":2005,"_25194":1979,"_17578":47208,"_5":17474,"_23043":47131,"_2395":47209},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2868":2006,"_25194":1979,"_17578":47211,"_5":17474,"_23043":47131,"_2395":47212},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2868":2007,"_25194":1979,"_17578":47214,"_5":17474,"_23043":47135,"_2395":47215},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2868":2008,"_25194":1979,"_17578":47217,"_5":17474,"_23043":47135,"_2395":47218},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2868":2009,"_25194":1979,"_17578":47220,"_5":17474,"_23043":47135,"_2395":47221},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2868":2010,"_25194":1979,"_17578":47223,"_5":17474,"_23043":47139,"_2395":47224},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2868":2011,"_25194":1979,"_17578":47226,"_5":17474,"_23043":47139,"_2395":47227},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2868":2012,"_25194":1979,"_17578":47229,"_5":17474,"_23043":47143,"_2395":47230},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2868":2013,"_25194":1979,"_17578":47232,"_5":17474,"_23043":47143,"_2395":47233},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2868":2014,"_25194":1979,"_17578":47235,"_5":17474,"_23043":47143,"_2395":47236},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2868":2015,"_25194":1979,"_17578":47238,"_5":17474,"_23043":47143,"_2395":47239},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2868":2016,"_25194":1979,"_17578":47241,"_5":17474,"_23043":47143,"_2395":47242},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2868":2017,"_25194":1979,"_17578":47244,"_5":17474,"_23043":47147,"_2395":47245},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2868":2018,"_25194":1979,"_17578":47247,"_5":17474,"_23043":47147,"_2395":44036},[],{"_2868":2019,"_25194":1979,"_17578":47249,"_5":17474,"_23043":47147,"_2395":47250},[],"Relative path",{"_2868":2020,"_25194":1979,"_17578":47252,"_5":17474,"_23043":47147,"_2395":44033},[],{"_2868":2021,"_25194":1979,"_17578":47254,"_5":17474,"_23043":47147,"_2395":47255},[],"`GET`",{"_2868":2022,"_25194":1979,"_17578":47257,"_5":17474,"_23043":47147,"_2395":47258},[],"`/v1/roles/{ca-ski}`",{"_2868":2023,"_25194":1979,"_17578":47260,"_5":17474,"_23043":47147,"_2395":47261},[],"Read `crl_options` and `latest_crl`.",{"_2868":2024,"_25194":1979,"_17578":47263,"_5":17474,"_23043":47147,"_2395":47264},[],"`PUT`",{"_2868":2025,"_25194":1979,"_17578":47266,"_5":17474,"_23043":47147,"_2395":47258},[],{"_2868":2026,"_25194":1979,"_17578":47268,"_5":17474,"_23043":47147,"_2395":47269},[],"Replace CRL configuration.",{"_2868":2027,"_25194":1979,"_17578":47271,"_5":17474,"_23043":47147,"_2395":47272},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2868":2028,"_25194":1979,"_17578":47274,"_5":17474,"_23043":47147,"_2395":47275},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2868":2029,"_25194":1979,"_17578":47277,"_5":17474,"_23043":47151,"_2395":47278},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2868":2030,"_25194":1979,"_17578":47280,"_5":17474,"_23043":47155,"_2395":47281},[],"RFC 5280: X.509 and CRL profile.",{"_2868":2031,"_25194":1979,"_17578":47283,"_5":17474,"_23043":47155,"_2395":47284},[],"OpenSSL: openssl-crl.",{"_2868":2032,"_25194":1979,"_17578":47286,"_5":17474,"_23043":47155,"_2395":47287},[],"OpenSSL: openssl-verify.",{"_2868":2033,"_25194":1979,"_17578":47289,"_5":17474,"_23043":47155,"_2395":47290},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2868":2034,"_25194":1979,"_17578":47292,"_5":17474,"_23043":47155,"_2395":47293},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2868":2035,"_25194":2035,"_5":12321,"_2395":47295,"_25530":47296,"_17578":47297,"_23043":2035},"Keys and cryptographic engines",[40934,42278,45993,45994],[],{"_2868":2036,"_25194":2035,"_17578":47299,"_5":17474,"_23043":2035,"_2395":47300},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2868":2037,"_25194":2035,"_5":25527,"_17578":47302,"_23043":47303,"_2395":47304},[],"/docs/pr-preview/pr-39/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2868":2038,"_25194":2035,"_5":25527,"_17578":47306,"_23043":47307,"_2395":47308},[],"/docs/pr-preview/pr-39/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2868":2039,"_25194":2035,"_5":25527,"_17578":47310,"_23043":47311,"_2395":47312},[],"/docs/pr-preview/pr-39/platform/pki/key-management#file-system","File System",{"_2868":2040,"_25194":2035,"_5":25527,"_17578":47314,"_23043":47315,"_2395":47316},[],"/docs/pr-preview/pr-39/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2868":2041,"_25194":2035,"_5":25527,"_17578":47318,"_23043":47319,"_2395":47320},[],"/docs/pr-preview/pr-39/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2868":2042,"_25194":2035,"_5":25527,"_17578":47322,"_23043":47323,"_2395":47324},[],"/docs/pr-preview/pr-39/platform/pki/key-management#aws-kms","AWS KMS",{"_2868":2043,"_25194":2035,"_5":25527,"_17578":47326,"_23043":47327,"_2395":47328},[],"/docs/pr-preview/pr-39/platform/pki/key-management#pkcs11","PKCS#11",{"_2868":2044,"_25194":2035,"_5":25527,"_17578":47330,"_23043":47331,"_2395":47332},[],"/docs/pr-preview/pr-39/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2868":2045,"_25194":2035,"_5":25527,"_17578":47334,"_23043":47335,"_2395":47336},[],"/docs/pr-preview/pr-39/platform/pki/key-management#key-inventory","Key inventory",{"_2868":2046,"_25194":2035,"_5":25527,"_17578":47338,"_23043":47339,"_2395":47340},[],"/docs/pr-preview/pr-39/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2868":2047,"_25194":2035,"_5":25527,"_17578":47342,"_23043":47343,"_2395":47344},[],"/docs/pr-preview/pr-39/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2868":2048,"_25194":2035,"_5":25527,"_17578":47346,"_23043":47347,"_2395":47348},[],"/docs/pr-preview/pr-39/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2868":2049,"_25194":2035,"_5":25527,"_17578":47350,"_23043":47351,"_2395":47352},[],"/docs/pr-preview/pr-39/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2868":2050,"_25194":2035,"_5":25527,"_17578":47354,"_23043":47355,"_2395":47356},[],"/docs/pr-preview/pr-39/platform/pki/key-management#view-details","View details",{"_2868":2051,"_25194":2035,"_5":25527,"_17578":47358,"_23043":47359,"_2395":47360},[],"/docs/pr-preview/pr-39/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2868":2052,"_25194":2035,"_5":25527,"_17578":47362,"_23043":47363,"_2395":47364},[],"/docs/pr-preview/pr-39/platform/pki/key-management#sign","Sign",{"_2868":2053,"_25194":2035,"_5":25527,"_17578":47366,"_23043":47367,"_2395":47368},[],"/docs/pr-preview/pr-39/platform/pki/key-management#verify","Verify",{"_2868":2054,"_25194":2035,"_5":25527,"_17578":47370,"_23043":47371,"_2395":47372},[],"/docs/pr-preview/pr-39/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2868":2055,"_25194":2035,"_5":25527,"_17578":47374,"_23043":47375,"_2395":47376},[],"/docs/pr-preview/pr-39/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2868":2056,"_25194":2035,"_5":25527,"_17578":47378,"_23043":47379,"_2395":47380},[],"/docs/pr-preview/pr-39/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2868":2057,"_25194":2035,"_17578":47382,"_5":17474,"_23043":2035,"_2395":47383},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2868":2058,"_25194":2035,"_17578":47385,"_5":17474,"_23043":2035,"_2395":47386},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2868":2059,"_25194":2035,"_17578":47388,"_5":17474,"_23043":47303,"_2395":47389},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2868":2060,"_25194":2035,"_17578":47391,"_5":17474,"_23043":47303,"_2395":47392},[],"In practice, it lets you:",{"_2868":2061,"_25194":2035,"_17578":47394,"_5":17474,"_23043":47303,"_2395":47395},[],"Generate new key pairs from Lamassu IoT.",{"_2868":2062,"_25194":2035,"_17578":47397,"_5":17474,"_23043":47303,"_2395":47398},[],"Import keys created externally.",{"_2868":2063,"_25194":2035,"_17578":47400,"_5":17474,"_23043":47303,"_2395":47401},[],"Delegate custody and cryptographic operations to external engines.",{"_2868":2064,"_25194":2035,"_17578":47403,"_5":17474,"_23043":47303,"_2395":47404},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2868":2065,"_25194":2035,"_17578":47406,"_5":17474,"_23043":47307,"_2395":47407},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2868":2066,"_25194":2035,"_17578":47409,"_5":17474,"_23043":47307,"_2395":47410},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2868":2067,"_25194":2035,"_17578":47412,"_5":17474,"_23043":47307,"_2395":47413},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2868":2068,"_25194":2035,"_17578":47415,"_5":17474,"_23043":47311,"_2395":47416},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2868":2069,"_25194":2035,"_17578":47418,"_5":17474,"_23043":47315,"_2395":47419},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2868":2070,"_25194":2035,"_17578":47421,"_5":17474,"_23043":47319,"_2395":47422},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2868":2071,"_25194":2035,"_17578":47424,"_5":17474,"_23043":47323,"_2395":47425},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2868":2072,"_25194":2035,"_17578":47427,"_5":17474,"_23043":47327,"_2395":47428},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2868":2073,"_25194":2035,"_17578":47430,"_5":17474,"_23043":47331,"_2395":47431},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2868":2074,"_25194":2035,"_17578":47433,"_5":17474,"_23043":47331,"_2395":47434},[],"Lamassu shows the enabled engines in the console.",{"_2868":2075,"_25194":2035,"_17578":47436,"_5":17474,"_23043":47331,"_2395":47437},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2868":2076,"_25194":2035,"_17578":47439,"_5":17474,"_23043":47331,"_2395":47440},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2868":2077,"_25194":2035,"_17578":47442,"_5":17474,"_23043":47335,"_2395":47443},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2868":2078,"_25194":2035,"_17578":47445,"_5":17474,"_23043":47335,"_2395":47446},[],"The table includes the following fields:",{"_2868":2079,"_25194":2035,"_17578":47448,"_5":17474,"_23043":47335,"_2395":47449},[],"**Name**: descriptive name of the key.",{"_2868":2080,"_25194":2035,"_17578":47451,"_5":17474,"_23043":47335,"_2395":47452},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2868":2081,"_25194":2035,"_17578":47454,"_5":17474,"_23043":47335,"_2395":47455},[],"**Strength**: visual indicator of cryptographic strength.",{"_2868":2082,"_25194":2035,"_17578":47457,"_5":17474,"_23043":47335,"_2395":47458},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2868":2083,"_25194":2035,"_17578":47460,"_5":17474,"_23043":47335,"_2395":47461},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2868":2084,"_25194":2035,"_17578":47463,"_5":17474,"_23043":47335,"_2395":47464},[],"**Aliases**: alternative names associated with the key.",{"_2868":2085,"_25194":2035,"_17578":47466,"_5":17474,"_23043":47335,"_2395":47467},[],"**Tags**: labels for classification and search.",{"_2868":2086,"_25194":2035,"_17578":47469,"_5":17474,"_23043":47335,"_2395":47470},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2868":2087,"_25194":2035,"_17578":47472,"_5":17474,"_23043":47335,"_2395":47473},[],"From this view you also reach the most common actions:",{"_2868":2088,"_25194":2035,"_17578":47475,"_5":17474,"_23043":47335,"_2395":47476},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2868":2089,"_25194":2035,"_17578":47478,"_5":17474,"_23043":47335,"_2395":47479},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2868":2090,"_25194":2035,"_17578":47481,"_5":17474,"_23043":47335,"_2395":47482},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2868":2091,"_25194":2035,"_17578":47484,"_5":17474,"_23043":47335,"_2395":47485},[],"**Delete Key** to remove the key from the system.",{"_2868":2092,"_25194":2035,"_17578":47487,"_5":17474,"_23043":47339,"_2395":47488},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2868":2093,"_25194":2035,"_17578":47490,"_5":17474,"_23043":47343,"_2395":47491},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2868":2094,"_25194":2035,"_17578":47493,"_5":17474,"_23043":47343,"_2395":47494},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2868":2095,"_25194":2035,"_17578":47496,"_5":17474,"_23043":47343,"_2395":47497},[],"**Key Name**: unique and descriptive name.",{"_2868":2096,"_25194":2035,"_17578":47499,"_5":17474,"_23043":47343,"_2395":47500},[],"**Crypto Engine**: engine that will keep the key.",{"_2868":2097,"_25194":2035,"_17578":47502,"_5":17474,"_23043":47343,"_2395":47503},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2868":2098,"_25194":2035,"_17578":47505,"_5":17474,"_23043":47343,"_2395":47506},[],"**Tags**: metadata to classify the key.",{"_2868":2099,"_25194":2035,"_17578":47508,"_5":17474,"_23043":47343,"_2395":47509},[],"**Metadata**: additional information for advanced uses.",{"_2868":2100,"_25194":2035,"_17578":47511,"_5":17474,"_23043":47347,"_2395":47512},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2868":2101,"_25194":2035,"_17578":47514,"_5":17474,"_23043":47347,"_2395":47515},[],"When you have an exportable private key and the destination engine supports import.",{"_2868":2102,"_25194":2035,"_17578":47517,"_5":17474,"_23043":47347,"_2395":47518},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2868":2103,"_25194":2035,"_17578":47520,"_5":17474,"_23043":47347,"_2395":47521},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2868":2104,"_25194":2035,"_17578":47523,"_5":17474,"_23043":47347,"_2395":47524},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2868":2105,"_25194":2035,"_17578":47526,"_5":17474,"_23043":47347,"_2395":47527},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2868":2106,"_25194":2035,"_17578":47529,"_5":17474,"_23043":47347,"_2395":47530},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2868":2107,"_25194":2035,"_17578":47532,"_5":17474,"_23043":47347,"_2395":47533},[],"**Tags**: labels for organization and search.",{"_2868":2108,"_25194":2035,"_17578":47535,"_5":17474,"_23043":47347,"_2395":47536},[],"**Metadata**: additional optional information.",{"_2868":2109,"_25194":2035,"_17578":47538,"_5":17474,"_23043":47347,"_2395":47539},[],"**Private Key (PEM)**: private key in PEM format.",{"_2868":2110,"_25194":2035,"_17578":47541,"_5":17474,"_23043":47347,"_2395":47542},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2868":2111,"_25194":2035,"_17578":47544,"_5":17474,"_23043":47351,"_2395":47545},[],"Each registered key has a detail view and several operational actions.",{"_2868":2112,"_25194":2035,"_17578":47547,"_5":17474,"_23043":47355,"_2395":47548},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2868":2113,"_25194":2035,"_17578":47550,"_5":17474,"_23043":47355,"_2395":47551},[],"The **Overview** tab shows, among others, these fields:",{"_2868":2114,"_25194":2035,"_17578":47553,"_5":17474,"_23043":47355,"_2395":47554},[],"**Key Name**: descriptive name.",{"_2868":2115,"_25194":2035,"_17578":47556,"_5":17474,"_23043":47355,"_2395":47557},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2868":2116,"_25194":2035,"_17578":47559,"_5":17474,"_23043":47355,"_2395":47560},[],"**Tags**: associated labels.",{"_2868":2117,"_25194":2035,"_17578":47562,"_5":17474,"_23043":47355,"_2395":47563},[],"**Aliases**: alternative names.",{"_2868":2118,"_25194":2035,"_17578":47565,"_5":17474,"_23043":47355,"_2395":47566},[],"**Crypto Engine**: engine where the key resides.",{"_2868":2119,"_25194":2035,"_17578":47568,"_5":17474,"_23043":47355,"_2395":47569},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2868":2120,"_25194":2035,"_17578":47571,"_5":17474,"_23043":47355,"_2395":47572},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2868":2121,"_25194":2035,"_17578":47574,"_5":17474,"_23043":47355,"_2395":47575},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2868":2122,"_25194":2035,"_17578":47577,"_5":17474,"_23043":47359,"_2395":47578},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2868":2123,"_25194":2035,"_17578":47580,"_5":17474,"_23043":47359,"_2395":47581},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2868":2124,"_25194":2035,"_17578":47583,"_5":17474,"_23043":47359,"_2395":47584},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2868":2125,"_25194":2035,"_17578":47586,"_5":17474,"_23043":47363,"_2395":47587},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2868":2126,"_25194":2035,"_17578":47589,"_5":17474,"_23043":47363,"_2395":47590},[],"Main fields:",{"_2868":2127,"_25194":2035,"_17578":47592,"_5":17474,"_23043":47363,"_2395":47593},[],"**Algorithm**: signing algorithm available for the key type.",{"_2868":2128,"_25194":2035,"_17578":47595,"_5":17474,"_23043":47363,"_2395":47596},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2868":2129,"_25194":2035,"_17578":47598,"_5":17474,"_23043":47363,"_2395":47599},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2868":2130,"_25194":2035,"_17578":47601,"_5":17474,"_23043":47363,"_2395":47602},[],"**Message**: content to sign.",{"_2868":2131,"_25194":2035,"_17578":47604,"_5":17474,"_23043":47363,"_2395":47605},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2868":2132,"_25194":2035,"_17578":47607,"_5":17474,"_23043":47367,"_2395":47608},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2868":2133,"_25194":2035,"_17578":47610,"_5":17474,"_23043":47367,"_2395":47590},[],{"_2868":2134,"_25194":2035,"_17578":47612,"_5":17474,"_23043":47367,"_2395":47613},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2868":2135,"_25194":2035,"_17578":47615,"_5":17474,"_23043":47367,"_2395":47616},[],"**Message Type**: `Raw` or `Digest`.",{"_2868":2136,"_25194":2035,"_17578":47618,"_5":17474,"_23043":47367,"_2395":47619},[],"**Payload Encoding**: encoding of the message.",{"_2868":2137,"_25194":2035,"_17578":47621,"_5":17474,"_23043":47367,"_2395":47622},[],"**Message**: original message or hash.",{"_2868":2138,"_25194":2035,"_17578":47624,"_5":17474,"_23043":47367,"_2395":47625},[],"**Signature**: signature to check.",{"_2868":2139,"_25194":2035,"_17578":47627,"_5":17474,"_23043":47367,"_2395":47628},[],"**Result**: indicator of the validation result.",{"_2868":2140,"_25194":2035,"_17578":47630,"_5":17474,"_23043":47371,"_2395":47631},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2868":2141,"_25194":2035,"_17578":47633,"_5":17474,"_23043":47371,"_2395":47634},[],"This flow is useful for:",{"_2868":2142,"_25194":2035,"_17578":47636,"_5":17474,"_23043":47371,"_2395":47637},[],"Requesting certificates from an external CA.",{"_2868":2143,"_25194":2035,"_17578":47639,"_5":17474,"_23043":47371,"_2395":47640},[],"Renewing an identity while keeping the same key.",{"_2868":2144,"_25194":2035,"_17578":47642,"_5":17474,"_23043":47371,"_2395":47643},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2868":2145,"_25194":2035,"_17578":47645,"_5":17474,"_23043":47371,"_2395":47646},[],"**Common Name (CN)**: main name of the identity.",{"_2868":2146,"_25194":2035,"_17578":47648,"_5":17474,"_23043":47371,"_2395":47649},[],"**Organization (O)**: organization or company.",{"_2868":2147,"_25194":2035,"_17578":47651,"_5":17474,"_23043":47371,"_2395":47652},[],"**Organizational Unit (OU)**: department or unit.",{"_2868":2148,"_25194":2035,"_17578":47654,"_5":17474,"_23043":47371,"_2395":47655},[],"**Country (C)**: two-letter country code.",{"_2868":2149,"_25194":2035,"_17578":47657,"_5":17474,"_23043":47371,"_2395":47658},[],"**State / Province (ST)**: state or province.",{"_2868":2150,"_25194":2035,"_17578":47660,"_5":17474,"_23043":47371,"_2395":47661},[],"**Locality (L)**: city or locality.",{"_2868":2151,"_25194":2035,"_17578":47663,"_5":17474,"_23043":47371,"_2395":47664},[],"**Email Address**: contact email.",{"_2868":2152,"_25194":2035,"_17578":47666,"_5":17474,"_23043":47371,"_2395":47667},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2868":2153,"_25194":2035,"_17578":47669,"_5":17474,"_23043":47371,"_2395":47670},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2868":2154,"_25194":2035,"_17578":47672,"_5":17474,"_23043":47375,"_2395":47673},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2868":2155,"_25194":2035,"_17578":47675,"_5":17474,"_23043":47375,"_2395":47676},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2868":2156,"_25194":2035,"_17578":47678,"_5":17474,"_23043":47379,"_2395":47679},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2868":2157,"_25194":2157,"_5":12321,"_2395":47681,"_25530":47682,"_17578":47683,"_23043":2157},"Online validation with OCSP",[40934,42278,45993,46610],[],{"_2868":2158,"_25194":2157,"_17578":47685,"_5":17474,"_23043":2157,"_2395":47686},[],"Query signed status and verify the responder’s response.",{"_2868":2159,"_25194":2157,"_5":25527,"_17578":47688,"_23043":47689,"_2395":47690},[],"/docs/pr-preview/pr-39/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2868":2160,"_25194":2157,"_5":25527,"_17578":47692,"_23043":47693,"_2395":47694},[],"/docs/pr-preview/pr-39/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2868":2161,"_25194":2157,"_5":25527,"_17578":47696,"_23043":47697,"_2395":47698},[],"/docs/pr-preview/pr-39/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2868":2162,"_25194":2157,"_5":25527,"_17578":47700,"_23043":47701,"_2395":47702},[],"/docs/pr-preview/pr-39/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2868":2163,"_25194":2157,"_5":25527,"_17578":47704,"_23043":47705,"_2395":47706},[],"/docs/pr-preview/pr-39/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2868":2164,"_25194":2157,"_5":25527,"_17578":47708,"_23043":47709,"_2395":47156},[],"/docs/pr-preview/pr-39/platform/pki/ocsp#references",{"_2868":2165,"_25194":2157,"_17578":47711,"_5":17474,"_23043":2157,"_2395":47712},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2868":2166,"_25194":2157,"_17578":47714,"_5":17474,"_23043":47689,"_2395":47715},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2868":2167,"_25194":2157,"_17578":47717,"_5":17474,"_23043":47689,"_2395":47718},[],"Record status",{"_2868":2168,"_25194":2157,"_17578":47720,"_5":17474,"_23043":47689,"_2395":47721},[],"Signed response",{"_2868":2169,"_25194":2157,"_17578":47723,"_5":17474,"_23043":47689,"_2395":45171},[],{"_2868":2170,"_25194":2157,"_17578":47725,"_5":17474,"_23043":47689,"_2395":47726},[],"`Good`.",{"_2868":2171,"_25194":2157,"_17578":47728,"_5":17474,"_23043":47689,"_2395":45188},[],{"_2868":2172,"_25194":2157,"_17578":47730,"_5":17474,"_23043":47689,"_2395":47731},[],"`Revoked`, with revocation reason and timestamp.",{"_2868":2173,"_25194":2157,"_17578":47733,"_5":17474,"_23043":47689,"_2395":47734},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2868":2174,"_25194":2157,"_17578":47736,"_5":17474,"_23043":47689,"_2395":47737},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2868":2175,"_25194":2157,"_17578":47739,"_5":17474,"_23043":47689,"_2395":47740},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2868":2176,"_25194":2157,"_17578":47742,"_5":17474,"_23043":47689,"_2395":47743},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2868":2177,"_25194":2157,"_17578":47745,"_5":17474,"_23043":47689,"_2395":47746},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2868":2178,"_25194":2157,"_17578":47748,"_5":17474,"_23043":47693,"_2395":47749},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2868":2179,"_25194":2157,"_17578":47751,"_5":17474,"_23043":47693,"_2395":47752},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2868":2180,"_25194":2157,"_17578":47754,"_5":17474,"_23043":47697,"_2395":47755},[],"The service accepts:",{"_2868":2181,"_25194":2157,"_17578":47757,"_5":17474,"_23043":47697,"_2395":44036},[],{"_2868":2182,"_25194":2157,"_17578":47759,"_5":17474,"_23043":47697,"_2395":47760},[],"VA service path",{"_2868":2183,"_25194":2157,"_17578":47762,"_5":17474,"_23043":47697,"_2395":47763},[],"Format",{"_2868":2184,"_25194":2157,"_17578":47765,"_5":17474,"_23043":47697,"_2395":47766},[],"`POST`",{"_2868":2185,"_25194":2157,"_17578":47768,"_5":17474,"_23043":47697,"_2395":47769},[],"`/ocsp`",{"_2868":2186,"_25194":2157,"_17578":47771,"_5":17474,"_23043":47697,"_2395":47772},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2868":2187,"_25194":2157,"_17578":47774,"_5":17474,"_23043":47697,"_2395":47255},[],{"_2868":2188,"_25194":2157,"_17578":47776,"_5":17474,"_23043":47697,"_2395":47777},[],"`/ocsp/{ocsp_request}`",{"_2868":2189,"_25194":2157,"_17578":47779,"_5":17474,"_23043":47697,"_2395":47780},[],"DER request encoded using padded URL Base64.",{"_2868":2190,"_25194":2157,"_17578":47782,"_5":17474,"_23043":47697,"_2395":47783},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2868":2191,"_25194":2157,"_17578":47785,"_5":17474,"_23043":47701,"_2395":47786},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2868":2192,"_25194":2157,"_17578":47788,"_5":17474,"_23043":47701,"_2395":47789},[],"Generate the request:",{"_2868":2193,"_25194":2157,"_17578":47791,"_5":17474,"_23043":47701,"_2395":47792},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2868":2194,"_25194":2157,"_17578":47794,"_5":17474,"_23043":47701,"_2395":47795},[],"Replace the example URL with the inspected endpoint:",{"_2868":2195,"_25194":2157,"_17578":47797,"_5":17474,"_23043":47701,"_2395":47798},[],"Verify the returned DER:",{"_2868":2196,"_25194":2157,"_17578":47800,"_5":17474,"_23043":47701,"_2395":47801},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2868":2197,"_25194":2157,"_17578":47803,"_5":17474,"_23043":47705,"_2395":47804},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2868":2198,"_25194":2157,"_17578":47806,"_5":17474,"_23043":47705,"_2395":47807},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2868":2199,"_25194":2157,"_17578":47809,"_5":17474,"_23043":47709,"_2395":47810},[],"RFC 6960: OCSP.",{"_2868":2200,"_25194":2157,"_17578":47812,"_5":17474,"_23043":47709,"_2395":47813},[],"OpenSSL: openssl-ocsp.",{"_2868":2201,"_25194":2157,"_17578":47815,"_5":17474,"_23043":47709,"_2395":47816},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2868":2202,"_25194":2157,"_17578":47818,"_5":17474,"_23043":47709,"_2395":47293},[],{"_2868":2203,"_25194":2203,"_5":12321,"_2395":45993,"_25530":47820,"_17578":47821,"_23043":2203},[40934,42278,45993],[],{"_2868":2204,"_25194":2203,"_17578":47823,"_5":17474,"_23043":2203,"_2395":47824},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2868":2205,"_25194":2203,"_5":25527,"_17578":47826,"_23043":47827,"_2395":45303},[],"/docs/pr-preview/pr-39/platform/pki/overview#start-here",{"_2868":2206,"_25194":2203,"_5":25527,"_17578":47829,"_23043":47830,"_2395":47831},[],"/docs/pr-preview/pr-39/platform/pki/overview#what-you-need","What you need",{"_2868":2207,"_25194":2203,"_5":25527,"_17578":47833,"_23043":47834,"_2395":45837},[],"/docs/pr-preview/pr-39/platform/pki/overview#core-capabilities",{"_2868":2208,"_25194":2203,"_5":25527,"_17578":47836,"_23043":47837,"_2395":45841},[],"/docs/pr-preview/pr-39/platform/pki/overview#build-your-trust-hierarchy",{"_2868":2209,"_25194":2203,"_5":25527,"_17578":47839,"_23043":47840,"_2395":45845},[],"/docs/pr-preview/pr-39/platform/pki/overview#protect-cryptographic-keys",{"_2868":2210,"_25194":2203,"_5":25527,"_17578":47842,"_23043":47843,"_2395":45849},[],"/docs/pr-preview/pr-39/platform/pki/overview#issue-and-control-certificates",{"_2868":2211,"_25194":2203,"_5":25527,"_17578":47845,"_23043":47846,"_2395":45857},[],"/docs/pr-preview/pr-39/platform/pki/overview#publish-validation-status",{"_2868":2212,"_25194":2203,"_5":25527,"_17578":47848,"_23043":47849,"_2395":47850},[],"/docs/pr-preview/pr-39/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2868":2213,"_25194":2203,"_5":25527,"_17578":47852,"_23043":47853,"_2395":46777},[],"/docs/pr-preview/pr-39/platform/pki/overview#continue",{"_2868":2214,"_25194":2203,"_17578":47855,"_5":17474,"_23043":2203,"_2395":47856},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2868":2215,"_25194":2203,"_17578":47858,"_5":17474,"_23043":47827,"_2395":47859},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2868":2216,"_25194":2203,"_17578":47861,"_5":17474,"_23043":47827,"_2395":47862},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2868":2217,"_25194":2203,"_17578":47864,"_5":17474,"_23043":47830,"_2395":47865},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2868":2218,"_25194":2203,"_17578":47867,"_5":17474,"_23043":47830,"_2395":47868},[],"An available cryptographic engine to keep the authority's key.",{"_2868":2219,"_25194":2203,"_17578":47870,"_5":17474,"_23043":47830,"_2395":47871},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2868":2220,"_25194":2203,"_17578":47873,"_5":17474,"_23043":47830,"_2395":47874},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2868":2221,"_25194":2203,"_17578":47876,"_5":17474,"_23043":47830,"_2395":47877},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2868":2222,"_25194":2203,"_17578":47879,"_5":17474,"_23043":47837,"_2395":47880},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2868":2223,"_25194":2203,"_17578":47882,"_5":17474,"_23043":47840,"_2395":47883},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2868":2224,"_25194":2203,"_17578":47885,"_5":17474,"_23043":47843,"_2395":47886},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2868":2225,"_25194":2203,"_17578":47888,"_5":17474,"_23043":47846,"_2395":47889},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2868":2226,"_25194":2203,"_17578":47891,"_5":17474,"_23043":47849,"_2395":47892},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2868":2227,"_25194":2203,"_17578":47894,"_5":17474,"_23043":47849,"_2395":47895},[],"its subject and extensions identify the expected client;",{"_2868":2228,"_25194":2203,"_17578":47897,"_5":17474,"_23043":47849,"_2395":47898},[],"its public key matches the client's private key;",{"_2868":2229,"_25194":2203,"_17578":47900,"_5":17474,"_23043":47849,"_2395":47901},[],"its chain reaches a root trusted by the consumer;",{"_2868":2230,"_25194":2203,"_17578":47903,"_5":17474,"_23043":47849,"_2395":47904},[],"its dates and usages allow the operation;",{"_2868":2231,"_25194":2203,"_17578":47906,"_5":17474,"_23043":47849,"_2395":47907},[],"the consumer applies revocation checks and authorization.",{"_2868":2232,"_25194":2203,"_17578":47909,"_5":17474,"_23043":47849,"_2395":47910},[],"The issuance path includes the first independent checks.",{"_2868":2233,"_25194":2203,"_17578":47912,"_5":17474,"_23043":47853,"_2395":47913},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2868":2234,"_25194":2203,"_17578":47915,"_5":17474,"_23043":47853,"_2395":47916},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2868":2235,"_25194":2203,"_17578":47918,"_5":17474,"_23043":47853,"_2395":47919},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2868":2236,"_25194":2236,"_5":12321,"_2395":47921,"_25530":47922,"_17578":47923,"_23043":2236},"Create your first CA",[40934,42278,45993,45428],[],{"_2868":2237,"_25194":2236,"_17578":47925,"_5":17474,"_23043":2236,"_2395":47926},[],"Create an evaluation root and check its certificate before issuing.",{"_2868":2238,"_25194":2236,"_5":25527,"_17578":47928,"_23043":47929,"_2395":40944},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2868":2239,"_25194":2236,"_5":25527,"_17578":47931,"_23043":47932,"_2395":47933},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2868":2240,"_25194":2236,"_5":25527,"_17578":47935,"_23043":47936,"_2395":47937},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2868":2241,"_25194":2236,"_5":25527,"_17578":47939,"_23043":47940,"_2395":47941},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2868":2242,"_25194":2236,"_5":25527,"_17578":47943,"_23043":47944,"_2395":47945},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2868":2243,"_25194":2236,"_5":25527,"_17578":47947,"_23043":47948,"_2395":47949},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2868":2244,"_25194":2236,"_5":25527,"_17578":47951,"_23043":47952,"_2395":47953},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2868":2245,"_25194":2236,"_5":25527,"_17578":47955,"_23043":47956,"_2395":45686},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2868":2246,"_25194":2236,"_5":25527,"_17578":47958,"_23043":47959,"_2395":40968},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2868":2247,"_25194":2236,"_17578":47961,"_5":17474,"_23043":2236,"_2395":47962},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2868":2248,"_25194":2236,"_17578":47964,"_5":17474,"_23043":47929,"_2395":47965},[],"Console access and permission to create keys and authorities.",{"_2868":2249,"_25194":2236,"_17578":47967,"_5":17474,"_23043":47929,"_2395":47968},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2868":2250,"_25194":2236,"_17578":47970,"_5":17474,"_23043":47929,"_2395":47971},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2868":2251,"_25194":2236,"_17578":47973,"_5":17474,"_23043":47929,"_2395":47974},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2868":2252,"_25194":2236,"_17578":47976,"_5":17474,"_23043":47932,"_2395":47977},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2868":2253,"_25194":2236,"_17578":47979,"_5":17474,"_23043":47932,"_2395":47980},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2868":2254,"_25194":2236,"_17578":47982,"_5":17474,"_23043":47936,"_2395":47983},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2868":2255,"_25194":2236,"_17578":47985,"_5":17474,"_23043":47936,"_2395":47986},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2868":2256,"_25194":2236,"_17578":47988,"_5":17474,"_23043":47940,"_2395":47989},[],"Select **Root CA** and complete:",{"_2868":2257,"_25194":2236,"_17578":47991,"_5":17474,"_23043":47940,"_2395":47992},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2868":2258,"_25194":2236,"_17578":47994,"_5":17474,"_23043":47940,"_2395":47995},[],"**Subject**: organization and country details for your evaluation.",{"_2868":2259,"_25194":2236,"_17578":47997,"_5":17474,"_23043":47940,"_2395":47998},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2868":2260,"_25194":2236,"_17578":48000,"_5":17474,"_23043":47940,"_2395":48001},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2868":2261,"_25194":2236,"_17578":48003,"_5":17474,"_23043":47940,"_2395":48004},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2868":2262,"_25194":2236,"_17578":48006,"_5":17474,"_23043":47944,"_2395":48007},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2868":2263,"_25194":2236,"_17578":48009,"_5":17474,"_23043":47948,"_2395":48010},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2868":2264,"_25194":2236,"_17578":48012,"_5":17474,"_23043":47948,"_2395":48013},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2868":2265,"_25194":2236,"_17578":48015,"_5":17474,"_23043":47952,"_2395":48016},[],"Run from the directory where you saved `ca.pem`:",{"_2868":2266,"_25194":2236,"_17578":48018,"_5":17474,"_23043":47952,"_2395":48019},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2868":2267,"_25194":2236,"_17578":48021,"_5":17474,"_23043":47952,"_2395":48022},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2868":2268,"_25194":2236,"_17578":48024,"_5":17474,"_23043":47956,"_2395":48025},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2868":2269,"_25194":2236,"_17578":48027,"_5":17474,"_23043":47956,"_2395":48028},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2868":2270,"_25194":2236,"_17578":48030,"_5":17474,"_23043":47956,"_2395":48031},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2868":2271,"_25194":2236,"_17578":48033,"_5":17474,"_23043":47956,"_2395":48034},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2868":2272,"_25194":2236,"_17578":48036,"_5":17474,"_23043":47959,"_2395":48037},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2868":2273,"_25194":2273,"_5":12321,"_2395":48039,"_25530":48040,"_17578":48041,"_23043":2273},"Issue and verify a certificate",[40934,42278,45993,45428],[],{"_2868":2274,"_25194":2273,"_17578":48043,"_5":17474,"_23043":2273,"_2395":48044},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2868":2275,"_25194":2273,"_5":25527,"_17578":48046,"_23043":48047,"_2395":40944},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2868":2276,"_25194":2273,"_5":25527,"_17578":48049,"_23043":48050,"_2395":48051},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2868":2277,"_25194":2273,"_5":25527,"_17578":48053,"_23043":48054,"_2395":48055},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2868":2278,"_25194":2273,"_5":25527,"_17578":48057,"_23043":48058,"_2395":48059},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2868":2279,"_25194":2273,"_5":25527,"_17578":48061,"_23043":48062,"_2395":48063},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2868":2280,"_25194":2273,"_5":25527,"_17578":48065,"_23043":48066,"_2395":48067},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2868":2281,"_25194":2273,"_5":25527,"_17578":48069,"_23043":48070,"_2395":47949},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2868":2282,"_25194":2273,"_5":25527,"_17578":48072,"_23043":48073,"_2395":48074},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2868":2283,"_25194":2273,"_5":25527,"_17578":48076,"_23043":48077,"_2395":48078},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2868":2284,"_25194":2273,"_5":25527,"_17578":48080,"_23043":48081,"_2395":48082},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2868":2285,"_25194":2273,"_5":25527,"_17578":48084,"_23043":48085,"_2395":45686},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2868":2286,"_25194":2273,"_5":25527,"_17578":48087,"_23043":48088,"_2395":40968},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#next-step",{"_2868":2287,"_25194":2273,"_17578":48090,"_5":17474,"_23043":2273,"_2395":48091},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2868":2288,"_25194":2273,"_17578":48093,"_5":17474,"_23043":48047,"_2395":48094},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2868":2289,"_25194":2273,"_17578":48096,"_5":17474,"_23043":48047,"_2395":48097},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2868":2290,"_25194":2273,"_17578":48099,"_5":17474,"_23043":48047,"_2395":48100},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2868":2291,"_25194":2273,"_17578":48102,"_5":17474,"_23043":48047,"_2395":48103},[],"A client identifier: here we use `device-001`.",{"_2868":2292,"_25194":2273,"_17578":48105,"_5":17474,"_23043":48047,"_2395":48106},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2868":2293,"_25194":2273,"_17578":48108,"_5":17474,"_23043":48050,"_2395":48109},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2868":2294,"_25194":2273,"_17578":48111,"_5":17474,"_23043":48054,"_2395":48112},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2868":2295,"_25194":2273,"_17578":48114,"_5":17474,"_23043":48054,"_2395":48115},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2868":2296,"_25194":2273,"_17578":48117,"_5":17474,"_23043":48058,"_2395":48118},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2868":2297,"_25194":2273,"_17578":48120,"_5":17474,"_23043":48058,"_2395":48121},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2868":2298,"_25194":2273,"_17578":48123,"_5":17474,"_23043":48062,"_2395":48124},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2868":2299,"_25194":2273,"_17578":48126,"_5":17474,"_23043":48062,"_2395":48127},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2868":2300,"_25194":2273,"_17578":48129,"_5":17474,"_23043":48066,"_2395":48130},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2868":2301,"_25194":2273,"_17578":48132,"_5":17474,"_23043":48070,"_2395":48133},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2868":2302,"_25194":2273,"_17578":48135,"_5":17474,"_23043":48073,"_2395":48136},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2868":2303,"_25194":2273,"_17578":48138,"_5":17474,"_23043":48077,"_2395":48139},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2868":2304,"_25194":2273,"_17578":48141,"_5":17474,"_23043":48077,"_2395":48142},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2868":2305,"_25194":2273,"_17578":48144,"_5":17474,"_23043":48077,"_2395":48145},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2868":2306,"_25194":2273,"_17578":48147,"_5":17474,"_23043":48081,"_2395":48148},[],"In Bash, compare the two public-key digests:",{"_2868":2307,"_25194":2273,"_17578":48150,"_5":17474,"_23043":48081,"_2395":48151},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2868":2308,"_25194":2273,"_17578":48153,"_5":17474,"_23043":48081,"_2395":48154},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2868":2309,"_25194":2273,"_17578":48156,"_5":17474,"_23043":48085,"_2395":45770},[],{"_2868":2310,"_25194":2273,"_17578":48158,"_5":17474,"_23043":48085,"_2395":48159},[],"What to review",{"_2868":2311,"_25194":2273,"_17578":48161,"_5":17474,"_23043":48085,"_2395":48162},[],"The CA rejects issuance",{"_2868":2312,"_25194":2273,"_17578":48164,"_5":17474,"_23043":48085,"_2395":48165},[],"Permissions, CA state and key, algorithm and profile.",{"_2868":2313,"_25194":2273,"_17578":48167,"_5":17474,"_23043":48085,"_2395":48168},[],"Different subject or usages",{"_2868":2314,"_25194":2273,"_17578":48170,"_5":17474,"_23043":48085,"_2395":48171},[],"Applied profile and requested values.",{"_2868":2315,"_25194":2273,"_17578":48173,"_5":17474,"_23043":48085,"_2395":48174},[],"Issuer cannot be found",{"_2868":2316,"_25194":2273,"_17578":48176,"_5":17474,"_23043":48085,"_2395":48177},[],"Downloaded CA and required intermediate chain.",{"_2868":2317,"_25194":2273,"_17578":48179,"_5":17474,"_23043":48085,"_2395":48180},[],"Validity fails",{"_2868":2318,"_25194":2273,"_17578":48182,"_5":17474,"_23043":48085,"_2395":48183},[],"Certificate and CA dates, and the computer's clock.",{"_2868":2319,"_25194":2273,"_17578":48185,"_5":17474,"_23043":48085,"_2395":48186},[],"Public-key digests differ",{"_2868":2320,"_25194":2273,"_17578":48188,"_5":17474,"_23043":48085,"_2395":48189},[],"Certificate and key files from the same issuance.",{"_2868":2321,"_25194":2273,"_17578":48191,"_5":17474,"_23043":48085,"_2395":48192},[],"See PKI diagnostics to narrow an issuance failure.",{"_2868":2322,"_25194":2273,"_17578":48194,"_5":17474,"_23043":48088,"_2395":48195},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2868":2323,"_25194":2273,"_17578":48197,"_5":17474,"_23043":48088,"_2395":48198},[],"Manage certificates for inspection, status and revocation.",{"_2868":2324,"_25194":2273,"_17578":48200,"_5":17474,"_23043":48088,"_2395":48201},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2868":2325,"_25194":2273,"_17578":48203,"_5":17474,"_23043":48088,"_2395":48204},[],"Prepare EST for the device to request its next identities.",{"_2868":2326,"_25194":2273,"_17578":48206,"_5":17474,"_23043":48088,"_2395":48207},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2868":2327,"_25194":2327,"_5":12321,"_2395":48209,"_25530":48210,"_17578":48211,"_23043":2327},"PKI getting started",[40934,42278,45993,45428],[],{"_2868":2328,"_25194":2327,"_17578":48213,"_5":17474,"_23043":2327,"_2395":48214},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2868":2329,"_25194":2327,"_5":25527,"_17578":48216,"_23043":48217,"_2395":40944},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/overview#before-you-begin",{"_2868":2330,"_25194":2327,"_5":25527,"_17578":48219,"_23043":48220,"_2395":48221},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2868":2331,"_25194":2327,"_5":25527,"_17578":48223,"_23043":48224,"_2395":45620},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/overview#expected-result",{"_2868":2332,"_25194":2327,"_5":25527,"_17578":48226,"_23043":48227,"_2395":48228},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2868":2333,"_25194":2327,"_17578":48230,"_5":17474,"_23043":2327,"_2395":48231},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2868":2334,"_25194":2327,"_17578":48233,"_5":17474,"_23043":48217,"_2395":48234},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2868":2335,"_25194":2327,"_17578":48236,"_5":17474,"_23043":48217,"_2395":48237},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2868":2336,"_25194":2327,"_17578":48239,"_5":17474,"_23043":48217,"_2395":48240},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2868":2337,"_25194":2327,"_17578":48242,"_5":17474,"_23043":48217,"_2395":48243},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2868":2338,"_25194":2327,"_17578":48245,"_5":17474,"_23043":48217,"_2395":48246},[],"A working directory with restricted access for the downloaded key.",{"_2868":2339,"_25194":2327,"_17578":48248,"_5":17474,"_23043":48220,"_2395":48249},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2868":2340,"_25194":2327,"_17578":48251,"_5":17474,"_23043":48220,"_2395":48252},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2868":2341,"_25194":2327,"_17578":48254,"_5":17474,"_23043":48220,"_2395":48255},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2868":2342,"_25194":2327,"_17578":48257,"_5":17474,"_23043":48220,"_2395":48258},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2868":2343,"_25194":2327,"_17578":48260,"_5":17474,"_23043":48224,"_2395":48261},[],"File or resource",{"_2868":2344,"_25194":2327,"_17578":48263,"_5":17474,"_23043":48224,"_2395":45617},[],{"_2868":2345,"_25194":2327,"_17578":48265,"_5":17474,"_23043":48224,"_2395":48266},[],"Active root CA and `ca.pem`",{"_2868":2346,"_25194":2327,"_17578":48268,"_5":17474,"_23043":48224,"_2395":48269},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2868":2347,"_25194":2327,"_17578":48271,"_5":17474,"_23043":48224,"_2395":48272},[],"End-entity certificate and `device.crt`",{"_2868":2348,"_25194":2327,"_17578":48274,"_5":17474,"_23043":48224,"_2395":48275},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2868":2349,"_25194":2327,"_17578":48277,"_5":17474,"_23043":48224,"_2395":48278},[],"Private key `device.key`",{"_2868":2350,"_25194":2327,"_17578":48280,"_5":17474,"_23043":48224,"_2395":48281},[],"Its public key matches the one included in `device.crt`.",{"_2868":2351,"_25194":2327,"_17578":48283,"_5":17474,"_23043":48224,"_2395":48284},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2868":2352,"_25194":2327,"_17578":48286,"_5":17474,"_23043":48227,"_2395":48287},[],"To operate certificates, continue with Certificates and Validation.",{"_2868":2353,"_25194":2327,"_17578":48289,"_5":17474,"_23043":48227,"_2395":48290},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2868":2354,"_25194":2327,"_17578":48292,"_5":17474,"_23043":48227,"_2395":48293},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2868":2355,"_25194":2355,"_5":12321,"_2395":48295,"_25530":48296,"_17578":48297,"_23043":2355},"PKI troubleshooting",[40934,42278,45993,44814],[],{"_2868":2356,"_25194":2355,"_17578":48299,"_5":17474,"_23043":2355,"_2395":48300},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2868":2357,"_25194":2355,"_5":25527,"_17578":48302,"_23043":48303,"_2395":48304},[],"/docs/pr-preview/pr-39/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2868":2358,"_25194":2355,"_5":25527,"_17578":48306,"_23043":48307,"_2395":48308},[],"/docs/pr-preview/pr-39/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2868":2359,"_25194":2355,"_5":25527,"_17578":48310,"_23043":48311,"_2395":48312},[],"/docs/pr-preview/pr-39/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2868":2360,"_25194":2355,"_17578":48314,"_5":17474,"_23043":2355,"_2395":48315},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2868":2361,"_25194":2355,"_17578":48317,"_5":17474,"_23043":2355,"_2395":48318},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2868":2362,"_25194":2355,"_17578":48320,"_5":17474,"_23043":48303,"_2395":45617},[],{"_2868":2363,"_25194":2355,"_17578":48322,"_5":17474,"_23043":48303,"_2395":48323},[],"What to inspect",{"_2868":2364,"_25194":2355,"_17578":48325,"_5":17474,"_23043":48303,"_2395":40968},[],{"_2868":2365,"_25194":2355,"_17578":48327,"_5":17474,"_23043":48303,"_2395":48328},[],"CA",{"_2868":2366,"_25194":2355,"_17578":48330,"_5":17474,"_23043":48303,"_2395":48331},[],"Exists, is active and has usable dates.",{"_2868":2367,"_25194":2355,"_17578":48333,"_5":17474,"_23043":48303,"_2395":48334},[],"Authorities.",{"_2868":2368,"_25194":2355,"_17578":48336,"_5":17474,"_23043":48303,"_2395":48337},[],"Key",{"_2868":2369,"_25194":2355,"_17578":48339,"_5":17474,"_23043":48303,"_2395":48340},[],"The record has a usable private key and the engine can sign.",{"_2868":2370,"_25194":2355,"_17578":48342,"_5":17474,"_23043":48303,"_2395":48343},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2868":2371,"_25194":2355,"_17578":48345,"_5":17474,"_23043":48303,"_2395":48346},[],"CSR",{"_2868":2372,"_25194":2355,"_17578":48348,"_5":17474,"_23043":48303,"_2395":48349},[],"Correct PEM and verifiable signature.",{"_2868":2373,"_25194":2355,"_17578":48351,"_5":17474,"_23043":48303,"_2395":48352},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2868":2374,"_25194":2355,"_17578":48354,"_5":17474,"_23043":48303,"_2395":48355},[],"Profile",{"_2868":2375,"_25194":2355,"_17578":48357,"_5":17474,"_23043":48303,"_2395":48358},[],"Selected source, existing ID, allowed algorithm and size.",{"_2868":2376,"_25194":2355,"_17578":48360,"_5":17474,"_23043":48303,"_2395":48361},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2868":2377,"_25194":2355,"_17578":48363,"_5":17474,"_23043":48303,"_2395":45770},[],{"_2868":2378,"_25194":2355,"_17578":48365,"_5":17474,"_23043":48303,"_2395":48366},[],"Appropriate subject, SAN, usages and dates.",{"_2868":2379,"_25194":2355,"_17578":48368,"_5":17474,"_23043":48303,"_2395":48369},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2868":2380,"_25194":2355,"_17578":48371,"_5":17474,"_23043":48303,"_2395":48372},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2868":2381,"_25194":2355,"_17578":48374,"_5":17474,"_23043":48303,"_2395":48375},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2868":2382,"_25194":2355,"_17578":48377,"_5":17474,"_23043":48307,"_2395":48378},[],"Check each boundary independently:",{"_2868":2383,"_25194":2355,"_17578":48380,"_5":17474,"_23043":48307,"_2395":48381},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2868":2384,"_25194":2355,"_17578":48383,"_5":17474,"_23043":48307,"_2395":48384},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2868":2385,"_25194":2355,"_17578":48386,"_5":17474,"_23043":48307,"_2395":48387},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2868":2386,"_25194":2355,"_17578":48389,"_5":17474,"_23043":48307,"_2395":48390},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2868":2387,"_25194":2355,"_17578":48392,"_5":17474,"_23043":48307,"_2395":48393},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2868":2388,"_25194":2355,"_17578":48395,"_5":17474,"_23043":48307,"_2395":48396},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2868":2389,"_25194":2355,"_17578":48398,"_5":17474,"_23043":48311,"_2395":48399},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2868":2390,"_25194":2355,"_17578":48401,"_5":17474,"_23043":48311,"_2395":48402},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.","count","sorting",{"_48406":48407,"_48408":48409,"_48410":48411,"_48412":48413,"_15264":2417,"_57931":2417},"language","english","sortableProperties",[2395,25194,5,23043],"sortablePropertiesWithTypes",{"_2395":20987,"_25194":20987,"_5":20987,"_23043":20987},"sorts",{"_2395":48414,"_25194":50794,"_5":53173,"_23043":55552},{"_3854":48415,"_48416":48417,"_5":20987},{"_12061":4234,"_12409":8790,"_12416":6060,"_24403":13112,"_23970":18094,"_16682":2632,"_12082":3856,"_12089":4153,"_24365":2741,"_24715":6322,"_24736":14048,"_24378":5911,"_28998":3441,"_24747":7838,"_29003":24900,"_29006":3248,"_29009":5398,"_29012":16334,"_29015":3365,"_25047":3839,"_29020":4784,"_29022":3793,"_25095":6245,"_25037":5335,"_29026":2704,"_25063":2816,"_29030":7187,"_24765":13542,"_25042":6297,"_25108":3129,"_29035":3957,"_29037":9513,"_29039":2473,"_29041":3074,"_29043":5193,"_29045":5704,"_29047":7417,"_29049":4481,"_25252":11676,"_24416":13940,"_29053":4946,"_29055":2715,"_24410":2733,"_29058":4631,"_29060":5689,"_29062":5691,"_29065":16935,"_24446":4533,"_29069":16936,"_24356":9508,"_29072":10338,"_24383":5737,"_29075":14587,"_29077":2723,"_29080":16774,"_25090":4899,"_29083":2927,"_29085":3081,"_29088":2857,"_29090":4235,"_29092":5758,"_29094":5511,"_29096":6178,"_16685":6338,"_29099":3047,"_29101":4777,"_29103":2474,"_24759":6068,"_29106":2663,"_29108":6222,"_29110":21248,"_29112":4037,"_29114":15278,"_29116":7530,"_29118":2639,"_25180":4058,"_24786":2463,"_29122":6233,"_29124":3922,"_24394":2929,"_29127":6232,"_29129":6358,"_29131":2829,"_25123":5345,"_29134":9423,"_29136":2795,"_29138":15210,"_29140":4183,"_29142":2671,"_24492":4530,"_29147":9749,"_24753":2670,"_29150":5632,"_29152":2470,"_29154":13696,"_29156":3821,"_29158":4084,"_29160":13536,"_24486":3672,"_24720":4930,"_29164":13277,"_29166":19155,"_29169":4964,"_29171":3811,"_29173":4337,"_29175":17636,"_29177":6159,"_29179":8267,"_29182":626